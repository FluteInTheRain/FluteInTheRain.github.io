---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { getPublishedPosts, usedCategories } from '../../utils/blog';
const posts = await getPublishedPosts();
---
<Layout title="Blog" description="Technical write-ups on backend engineering, payments, messaging, and AI-powered search.">
  <Nav />
  <main class="section">
    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1 class="section-title">Writing</h1>
      <p class="section-sub">Notes on the engineering problems I run into and how I solve them.</p>
      <CategoryNav categories={usedCategories(posts)} />
      {posts.length > 0
        ? <div class="post-grid post-grid-list">{posts.map((p) => <PostCard post={p} />)}</div>
        : <p class="section-sub">First posts are on the way. Check back soon.</p>}
      <p class="post-rss"><a href="/rss.xml">RSS feed</a></p>
    </div>
  </main>
  <Footer />
</Layout>
