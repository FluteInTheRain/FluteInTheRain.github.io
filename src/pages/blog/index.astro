---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import T from '../../components/T.astro';
import { ui } from '../../data/content';
import { getPublishedPosts, usedCategories } from '../../utils/blog';
import SeriesCard from '../../components/series/SeriesCard.astro';
import { SERIES_IDS } from '../../data/series';
import { getSeriesView } from '../../utils/series';
const posts = await getPublishedPosts();
const seriesViews = (await Promise.all(SERIES_IDS.map(getSeriesView))).filter((v) => v.publishedCount > 0);
---
<Layout title="Blog" description="Technical write-ups on backend engineering, payments, messaging, and AI-powered search.">
  <Nav />
  <main class="section">
    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1 class="section-title"><T en={ui.blogTitle.en} vi={ui.blogTitle.vi} /></h1>
      <p class="section-sub"><T en={ui.latestSub.en} vi={ui.latestSub.vi} /></p>
      <CategoryNav categories={usedCategories(posts)} />
      {seriesViews.length > 0 && <div class="series-shelf">{seriesViews.map((v) => <SeriesCard view={v} />)}</div>}
      {posts.length > 0
        ? <div class="post-grid">{posts.map((p) => <PostCard post={p} headingLevel={2} />)}</div>
        : <p class="section-sub"><T en={ui.blogEmpty.en} vi={ui.blogEmpty.vi} /></p>}
      <p class="post-rss"><a href="/rss.xml"><T en={ui.rssFeed.en} vi={ui.rssFeed.vi} /></a></p>
    </div>
  </main>
  <Footer />
</Layout>
