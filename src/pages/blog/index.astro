---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import SeriesCard from '../../components/series/SeriesCard.astro';
import IndexIntro from '../../components/blog/IndexIntro.astro';
import FeaturedPost from '../../components/blog/FeaturedPost.astro';
import AlsoNew from '../../components/blog/AlsoNew.astro';
import TopicSection from '../../components/blog/TopicSection.astro';
import ArchiveList from '../../components/blog/ArchiveList.astro';
import T from '../../components/T.astro';
import { ui } from '../../data/content';
import { CATEGORY_IDS, type CategoryId } from '../../data/categories';
import { getPublishedPosts, usedCategories, readingTime } from '../../utils/blog';
import { buildIndexLayout, formatHours } from '../../utils/blog-index';
import { SERIES_IDS } from '../../data/series';
import { getSeriesView, getSeriesNav } from '../../utils/series';

const posts = await getPublishedPosts();
const seriesViews = (await Promise.all(SERIES_IDS.map(getSeriesView))).filter((v) => v.publishedCount > 0);
const layout = buildIndexLayout(
  posts.map((post) => ({ id: post.id, date: post.data.date, category: post.data.category as string, featured: post.data.featured, post })),
  CATEGORY_IDS,
);
const featured = layout.featured?.post ?? null;
const nav = featured ? await getSeriesNav(featured.id) : null;
const part = nav ? { n: nav.current.n, m: nav.view.parts.length } : null;
const counts: Record<string, number> = {};
for (const p of posts) counts[p.data.category] = (counts[p.data.category] ?? 0) + 1;
const totalMinutes = posts.reduce((sum, p) => sum + readingTime(p.body), 0);
const stats = [
  { value: String(posts.length), label: ui.statPosts },
  { value: String(seriesViews.length), label: ui.statSeries },
  { value: formatHours(totalMinutes), label: ui.statReading },
];
---
<Layout title="Blog" description="Technical write-ups on backend engineering, payments, messaging, and AI-powered search.">
  <Nav />
  <main class="section blog-index">
    <div class="container">
      {posts.length === 0 ? (
        <>
          <IndexIntro title={ui.blogTitle} />
          <p class="section-sub"><T en={ui.blogEmpty.en} vi={ui.blogEmpty.vi} /></p>
        </>
      ) : (
        <>
          <IndexIntro title={ui.blogTitle} stats={stats} />
          <div class="index-filter">
            <CategoryNav categories={usedCategories(posts)} counts={counts} />
          </div>
          <div data-index-sections>
            {featured && (
              <div class="feature-row">
                <FeaturedPost post={featured} part={part} />
                <AlsoNew posts={layout.alsoNew.map((x) => x.post)} />
              </div>
            )}
            {seriesViews.length > 0 && (
              <section class="index-section" aria-labelledby="series-title">
                <div class="index-head">
                  <h2 id="series-title" class="index-head-title"><T en={ui.bookSeries.en} vi={ui.bookSeries.vi} /></h2>
                  <span class="index-head-hint"><T en={ui.bookSeriesHint.en} vi={ui.bookSeriesHint.vi} /></span>
                </div>
                <div class="series-shelf">{seriesViews.map((v) => <SeriesCard view={v} />)}</div>
              </section>
            )}
            {layout.topics.map((t) => (
              <TopicSection category={t.category as CategoryId} total={t.total} posts={t.posts.map((x) => x.post)} />
            ))}
          </div>
          <ArchiveList posts={layout.archive.map((x) => x.post)} />
        </>
      )}
      <p class="post-rss"><a href="/rss.xml"><T en={ui.rssFeed.en} vi={ui.rssFeed.vi} /></a></p>
    </div>
  </main>
  <Footer />
</Layout>
