---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import T from '../../../components/T.astro';
import SeriesCover from '../../../components/series/SeriesCover.astro';
import SeriesMap from '../../../components/series/SeriesMap.astro';
import SeriesContents from '../../../components/series/SeriesContents.astro';
import { ui } from '../../../data/content';
import { SERIES_IDS } from '../../../data/series';
import { getSeriesView } from '../../../utils/series';

export function getStaticPaths() {
  return SERIES_IDS.map((id) => ({ params: { id } }));
}

const view = await getSeriesView(Astro.params.id!);
const { series } = view;
---
<Layout title={series.title.en} description={series.tagline.en}>
  <Nav />
  <main>
    <div class="container ssp-back"><a class="post-back" href="/blog/"><T en={ui.allPostsBack.en} vi={ui.allPostsBack.vi} /></a></div>
    <SeriesCover view={view} />
    <section class="ssp-sec">
      <div class="container">
        <h2 class="ssp-h2"><T en="Reading map" vi="Sơ đồ đọc" /></h2>
        <p class="ssp-sub"><T en="Pick the path that matches your problem. Arrows show which part builds on which." vi="Chọn lộ trình hợp với vấn đề của bạn. Mũi tên cho biết bài nào dựa trên bài nào." /></p>
        <SeriesMap view={view} />
      </div>
    </section>
    <section class="ssp-sec">
      <div class="container">
        <h2 class="ssp-h2"><T en="Contents" vi="Mục lục" /></h2>
        <SeriesContents view={view} />
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .ssp-back { padding-top: 20px; padding-bottom: 16px; }
  .ssp-sec { padding: 48px 0 16px; }
  .ssp-sec:last-of-type { padding-bottom: 80px; }
  .ssp-h2 { margin: 0 0 8px; font-size: 28px; font-weight: 700; letter-spacing: -0.01em; color: var(--text); }
  .ssp-sub { margin: 0 0 20px; font-size: 16px; color: var(--text-muted); max-width: 65ch; }
</style>
