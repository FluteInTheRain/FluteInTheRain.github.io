---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import content from '../../data/content';
import { CATEGORY_LABELS } from '../../data/categories';
import { getPublishedPosts, formatDate, readingTime, categoryUrl } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, date, updated, tags, category } = post.data;
const categoryLabel = CATEGORY_LABELS[category];
const { Content } = await render(post);
const site = Astro.site!;
const url = new URL(Astro.url.pathname, site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  mainEntityOfPage: url,
  image: new URL('/assets/og-image.png', site).href,
  articleSection: categoryLabel,
  keywords: tags.join(', '),
  author: { '@type': 'Person', name: content.person.name, url: site.href },
};
---
<Layout title={title} description={description} type="article" publishedTime={date.toISOString()} jsonLd={jsonLd}>
  <Nav />
  <main class="section">
    <div class="container post-container">
      <a class="post-back" href="/blog/">&larr; All posts</a>
      <article>
        <header class="post-header">
          <p class="post-category"><a href={categoryUrl(category)}>{categoryLabel}</a></p>
          <p class="post-meta">
            <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingTime(post.body)} min read
            {updated && <> · Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
          </p>
          <h1 class="post-title">{title}</h1>
          {tags.length > 0 && <div class="project-tags">{tags.map((t: string) => <span class="tag">{t}</span>)}</div>}
        </header>
        <div class="prose"><Content /></div>
      </article>
    </div>
  </main>
  <Footer />
  <script>
    import '../../scripts/copy-code.ts';
  </script>
</Layout>
