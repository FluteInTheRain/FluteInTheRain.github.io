---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import T from '../../components/T.astro';
import content, { ui } from '../../data/content';
import { CATEGORY_LABELS, CATEGORY_LABELS_VI } from '../../data/categories';
import { getPublishedPosts, formatDate, formatDateVi, readingTime, categoryUrl } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, title_vi, description, description_vi, date, updated, tags, category, sources } = post.data;
const categoryLabel = CATEGORY_LABELS[category];
const categoryLabelVi = CATEGORY_LABELS_VI[category];
const { Content, headings } = await render(post);
// Filter strictly to H2 for a clean, concise, high-level table of contents
const tocHeadings = headings.filter((h) => h.depth === 2);
const cleanTocTitle = (text: string) => {
  let clean = text.replace(/<[^>]+>/g, '').trim();
  if (clean.includes(':')) {
    clean = clean.split(':')[0].trim();
  } else if (clean.includes('—')) {
    clean = clean.split('—')[0].trim();
  }
  return clean;
};
const site = Astro.site!;
const url = new URL(Astro.url.pathname, site).href;
const mins = readingTime(post.body);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  mainEntityOfPage: url,
  image: new URL('/assets/og-image.png', site).href,
  articleSection: categoryLabel,
  keywords: tags.join(', '),
  author: { '@type': 'Person', name: content.person.name, url: site.href },
};
---
<Layout title={title} description={description} type="article" publishedTime={date.toISOString()} jsonLd={jsonLd}>
  <div id="reading-progress" class="reading-progress-bar" aria-hidden="true"></div>
  <Nav />
  <main class="section post-section">
    <div class="post-layout-container">
      <div class="post-main-column">
        <a class="post-back" href="/blog/"><T en={ui.allPostsBack.en} vi={ui.allPostsBack.vi} /></a>
        <article>
          <header class="post-header">
            <div class="post-header-top">
              <span class="post-category-badge">
                <a href={categoryUrl(category)}><T en={categoryLabel} vi={categoryLabelVi} /></a>
              </span>
              <span class="post-header-meta">
                <time datetime={date.toISOString()}><T en={formatDate(date)} vi={formatDateVi(date)} /></time>
                <span class="meta-dot">·</span>
                <span>{mins} <T en={ui.minRead.en} vi={ui.minRead.vi} /></span>
                {updated && (
                  <> <span class="meta-dot">·</span> <span class="meta-updated"><T en="Updated" vi="Cập nhật" /> <time datetime={updated.toISOString()}><T en={formatDate(updated)} vi={formatDateVi(updated)} /></time></span></>
                )}
              </span>
            </div>

            <h1 class="post-title"><T en={title} vi={title_vi} /></h1>
            {description && <p class="post-deck"><T en={description} vi={description_vi} /></p>}

            {tags.length > 0 && <div class="project-tags post-tags">{tags.map((t: string) => <span class="tag">{t}</span>)}</div>}
          </header>

          <div class="prose"><Content /></div>

          {sources.length > 0 && (
            <section class="post-sources" aria-labelledby="post-references">
              <h2 id="post-references"><T en={ui.references.en} vi={ui.references.vi} /></h2>
              <ul role="list">
                {sources.map((s) => (
                  <li>
                    <cite>{s.url ? <a href={s.url} rel="noopener">{s.title}</a> : s.title}</cite>
                    {s.author && <> — {s.author}</>}
                    {s.chapters && <> ({s.chapters})</>}
                  </li>
                ))}
              </ul>
            </section>
          )}
        </article>
      </div>

      {tocHeadings.length > 0 && (
        <aside class="post-toc-sidebar" aria-label="Table of contents">
          <div class="post-toc-inner">
            <div class="toc-header">
              <span class="toc-indicator"></span>
              <T en="On this page" vi="Mục lục bài viết" />
            </div>
            <nav class="toc-nav">
              <ul class="toc-list" role="list">
                {tocHeadings.map((h) => (
                  <li class="toc-item">
                    <a href={`#${h.slug}`} class="toc-link" data-slug={h.slug} title={h.text}>
                      {cleanTocTitle(h.text)}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </aside>
      )}
    </div>
  </main>
  <Footer />
  <script>
    import '../../scripts/copy-code.ts';
    import '../../scripts/post-enhancements.ts';
  </script>
</Layout>
