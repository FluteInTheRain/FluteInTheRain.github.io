---
// /blog/<post>/quiz/: the review quiz of a post. Content: src/data/quiz/<post>/set-NN.json.
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import T from '../../../components/T.astro';
import QuizSet from '../../../components/quiz/QuizSet.astro';
import QuizSummary from '../../../components/quiz/QuizSummary.astro';
import { getPublishedPosts } from '../../../utils/blog';
import { headingSlugPairs } from '../../../utils/quiz';
import { hasQuiz, loadQuizSets, questionCount } from '../../../data/quiz';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.filter((p) => hasQuiz(p.id)).map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, title_vi } = post.data;
const sets = loadQuizSets(post.id);
const total = questionCount(sets);
const slugPairs = headingSlugPairs(post.body ?? '');
let offset = 0;
const offsets = sets.map((s) => { const o = offset; offset += s.questions.length; return o; });
---
<Layout
  title={`Review quiz: ${title}`}
  description={`${total} multiple-choice questions to review "${title}".`}
>
  <Nav />
  <main class="section post-section">
    <div class="quiz" data-quiz data-post={post.id} data-total={total}>
      <a class="post-back" href={`/blog/${post.id}/`}><T en="← Back to the post" vi="← Về bài viết" /></a>

      <header class="quiz-head">
        <p class="quiz-kicker"><T en="Review quiz" vi="Bài ôn tập" /></p>
        <h1 class="quiz-title"><T en={title} vi={title_vi} /></h1>
        <p class="quiz-lede">
          <T
            en={`${total} questions in ${sets.length} short cases. Each case gives you a situation, then asks about it from easy to hard. You get the answer and the reasoning right after each question.`}
            vi={`${total} câu trong ${sets.length} tình huống ngắn. Mỗi tình huống đưa ra một bối cảnh rồi hỏi từ dễ đến khó. Bạn có đáp án và lời giải ngay sau mỗi câu.`}
          />
        </p>
        <div class="quiz-progress" data-progress hidden>
          <div class="quiz-progress-track"><span class="quiz-progress-bar" data-progress-bar></span></div>
          <span class="quiz-progress-text"><span data-progress-done>0</span> / {total}</span>
        </div>
        <nav class="quiz-sets-nav" data-sets-nav hidden aria-label="Cases">
          {sets.map((s, i) => (
            <button type="button" class="quiz-set-chip" data-goto-set={s.id} title={s.title.en}>{i + 1}</button>
          ))}
        </nav>
      </header>

      {sets.map((set, i) => (
        <QuizSet set={set} index={i + 1} total={sets.length} offset={offsets[i]} postSlug={post.id} slugPairs={slugPairs} />
      ))}

      <QuizSummary />
    </div>
  </main>
  <Footer />
  <script>
    import '../../../scripts/quiz.ts';
  </script>
</Layout>
