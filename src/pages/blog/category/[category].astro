---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/PostCard.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import T from '../../../components/T.astro';
import { CATEGORY_LABELS_VI, type CategoryId } from '../../../data/categories';
import { getPublishedPosts, usedCategories } from '../../../utils/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return usedCategories(posts).map((c) => ({
    params: { category: c.id },
    props: {
      id: c.id,
      label: c.label,
      labelVi: c.labelVi,
      posts: posts.filter((p) => p.data.category === c.id),
      categories: usedCategories(posts),
    },
  }));
}

const { id, label, labelVi, posts, categories } = Astro.props;
const viLabel = labelVi ?? CATEGORY_LABELS_VI[id as CategoryId];
---
<Layout title={`${label} articles`} description={`Posts about ${label.toLowerCase()} from Khang Nguyen's engineering blog.`}>
  <Nav />
  <main class="section">
    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1 class="section-title"><T en={label} vi={viLabel} /></h1>
      <CategoryNav categories={categories} active={id} />
      <div class="post-grid post-grid-list">{posts.map((p: any) => <PostCard post={p} headingLevel={2} />)}</div>
    </div>
  </main>
  <Footer />
</Layout>
