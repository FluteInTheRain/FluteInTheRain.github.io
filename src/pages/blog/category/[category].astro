---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/PostCard.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import { CATEGORY_LABELS } from '../../../data/categories';
import { getPublishedPosts, usedCategories } from '../../../utils/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return usedCategories(posts).map((c) => ({
    params: { category: c.id },
    props: { id: c.id, label: c.label, posts: posts.filter((p) => p.data.category === c.id), categories: usedCategories(posts) },
  }));
}

const { id, label, posts, categories } = Astro.props;
---
<Layout title={`${label} articles`} description={`Posts about ${label.toLowerCase()} from Khang Nguyen's engineering blog.`}>
  <Nav />
  <main class="section">
    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1 class="section-title">{label}</h1>
      <CategoryNav categories={categories} active={id} />
      <div class="post-grid post-grid-list">{posts.map((p: any) => <PostCard post={p} />)}</div>
    </div>
  </main>
  <Footer />
</Layout>
