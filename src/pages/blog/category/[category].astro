---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/PostCard.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import IndexIntro from '../../../components/blog/IndexIntro.astro';
import { CATEGORY_LABELS_VI, type CategoryId } from '../../../data/categories';
import { getPublishedPosts, usedCategories } from '../../../utils/blog';
import SeriesCard from '../../../components/series/SeriesCard.astro';
import { SERIES_IDS } from '../../../data/series';
import { getSeriesView } from '../../../utils/series';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return usedCategories(posts).map((c) => ({
    params: { category: c.id },
    props: {
      id: c.id,
      label: c.label,
      labelVi: c.labelVi,
      posts: posts.filter((p) => p.data.category === c.id),
      categories: usedCategories(posts),
      counts: Object.fromEntries(usedCategories(posts).map((u) => [u.id, posts.filter((p) => p.data.category === u.id).length])),
    },
  }));
}

const { id, label, labelVi, posts, categories, counts } = Astro.props;
const viLabel = labelVi ?? CATEGORY_LABELS_VI[id as CategoryId];
// a series belongs on this page when any of its published parts is in this category
const ids = new Set(posts.map((p: any) => p.id));
const seriesViews = (await Promise.all(SERIES_IDS.map(getSeriesView))).filter((v) => v.parts.some((p) => p.published && ids.has(p.part.slug)));
---
<Layout title={`${label} articles`} description={`Posts about ${label.toLowerCase()} from Khang Nguyen's engineering blog.`}>
  <Nav />
  <main class="section blog-index">
    <div class="container">
      <IndexIntro title={{ en: label, vi: viLabel }} lede={false} />
      <div class="index-filter">
        <CategoryNav categories={categories} active={id} counts={counts} />
      </div>
      {seriesViews.length > 0 && <div class="series-shelf">{seriesViews.map((v) => <SeriesCard view={v} />)}</div>}
      <div class="post-grid">{posts.map((p: any) => <PostCard post={p} headingLevel={2} />)}</div>
    </div>
  </main>
  <Footer />
</Layout>
