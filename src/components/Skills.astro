---
import content from '../data/content';
const s = content.skills;
const ai = s.aiWorkflow;
---
<section class="section alt-bg" id="skills">
  <div class="container">
    <p class="eyebrow">{s.eyebrow}</p>
    <h2 class="section-title">{s.heading}</h2>
    <p class="section-sub">{s.subheading}</p>
    <div class="skills-grid">
      {s.groups.map((g: any) => (
        <div class="card skill-card">
          <p class="skill-cat"><span class="skill-cat-dot"></span>{g.category}</p>
          <div class="skill-tags">{g.items.map((i: string) => <span class="tag">{i}</span>)}</div>
        </div>
      ))}
    </div>
    <div class="card ai-card">
      <div class="ai-card-skills">
        <p class="skill-cat"><span class="skill-cat-dot"></span>{ai.category}</p>
        <div class="skill-tags">{ai.items.map((i) => <span class="tag">{i}</span>)}</div>
      </div>
      <div class="ai-card-workflow">
        <h3 class="ai-card-heading">{ai.heading}</h3>
        <ol class="ai-steps">{ai.steps.map((step) => <li>{step}</li>)}</ol>
      </div>
    </div>
  </div>
</section>
