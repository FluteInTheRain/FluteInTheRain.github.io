---
import content from '../data/content';
const s = content.skills;
---
<section class="section alt-bg" id="skills">
  <div class="container">
    <p class="eyebrow">{s.eyebrow}</p>
    <h2 class="section-title">{s.heading}</h2>
    <p class="section-sub">{s.subheading}</p>
    <div class="skills-grid">
      {s.groups.map((g: any) => (
        <div class="card skill-card">
          <p class="skill-cat"><span class="skill-cat-dot"></span>{g.category}</p>
          <div class="skill-tags">{g.items.map((i: string) => <span class="tag">{i}</span>)}</div>
        </div>
      ))}
    </div>
  </div>
</section>
