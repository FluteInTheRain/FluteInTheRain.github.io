---
import content, { contentVi } from '../data/content';
import T from './T.astro';
const s = content.skills;
const sVi = contentVi.skills;
---
<section class="section alt-bg" id="skills">
  <div class="container">
    <p class="eyebrow"><T en={s.eyebrow} vi={sVi.eyebrow} /></p>
    <h2 class="section-title"><T en={s.heading} vi={sVi.heading} /></h2>
    <p class="section-sub"><T en={s.subheading} vi={sVi.subheading} /></p>
    <div class="skills-grid">
      {s.groups.map((g: any, gi: number) => {
        const gVi: any = sVi.groups[gi] ?? {};
        return (
          <div class="card skill-card">
            <p class="skill-cat"><span class="skill-cat-dot"></span><T en={g.category} vi={gVi.category} /></p>
            <div class="skill-tags">
              {g.items.map((item: string, ii: number) => (
                <span class="tag"><T en={item} vi={gVi.items?.[ii]} /></span>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
