---
import content, { contentVi } from '../data/content';
import Icon from './Icon.astro';
import T from './T.astro';
const { person, hero } = content;
const { hero: heroVi } = contentVi;
const abs = (u: string) => (/^(\/|https?:|mailto:|#)/.test(u) ? u : '/' + u);
const avatar = person.avatar ? abs(person.avatar) : '';
const cv = hero.ctaPrimary;
---
<section class="hero">
  <div class="container hero-grid">
    <div>
      <h1 class="hero-heading"><T en={hero.heading} vi={heroVi.heading} /></h1>
      <p class="hero-role"><T en={hero.role} vi={heroVi.role} /></p>
      <p class="hero-focus"><T en={hero.focus} vi={heroVi.focus} /></p>
      <p class="hero-bio"><T en={hero.bio} vi={heroVi.bio} /></p>
      <dl class="hero-stats">
        {hero.stats.map((s, i) => (
          <div class="hero-stat">
            <dt><T en={s.value} vi={heroVi.stats[i]?.value} /></dt>
            <dd><T en={s.label} vi={heroVi.stats[i]?.label} /></dd>
          </div>
        ))}
      </dl>
      <div class="hero-cta-row">
        <a class="btn btn-primary" href={abs(cv.href)} target="_blank" rel="noopener" download={cv.filename || undefined}>
          <T en={cv.label} vi={heroVi.ctaPrimary.label} />
        </a>
        <a class="btn btn-outline" href={`mailto:${person.email}`}>
          <T en={hero.ctaSecondary.label} vi={heroVi.ctaSecondary.label} />
        </a>
      </div>
      <div class="hero-socials">
        {hero.socials.map((s) => (
          <a class={`icon-btn brand-${s.icon}`} href={s.url} target="_blank" rel="noopener" aria-label={s.icon}><Icon name={s.icon} size={17} /></a>
        ))}
      </div>
    </div>
    <div class="hero-avatar-wrap">
      <div class="hero-avatar">
        {avatar
          ? <img src={avatar} alt={person.name} width="800" height="964" fetchpriority="high" loading="eager" decoding="async" />
          : <span>{person.initials}</span>}
      </div>
    </div>
  </div>
</section>
<div class="gradient-bar"></div>
