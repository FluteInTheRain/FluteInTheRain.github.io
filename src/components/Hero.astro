---
import content from '../data/content';
import Icon from './Icon.astro';
const { person, hero } = content;
const abs = (u: string) => (/^(\/|https?:|mailto:|#)/.test(u) ? u : '/' + u);
const avatar = person.avatar ? abs(person.avatar) : '';
const sec = hero.ctaSecondary as { href: string; label: string; filename?: string };
---
<section class="hero">
  <div class="container hero-grid">
    <div>
      <h1 class="hero-heading">{hero.heading}</h1>
      <p class="hero-bio">{hero.bio}</p>
      <div class="hero-cta-row">
        <a class="btn btn-primary" href={`mailto:${person.email}`}>{hero.ctaPrimary.label}</a>
        <a class="btn btn-outline" href={abs(sec.href)} target="_blank" rel="noopener" download={sec.filename || undefined}>{sec.label}</a>
      </div>
      <div class="hero-socials">
        {hero.socials.map((s) => (
          <a class={`icon-btn brand-${s.icon}`} href={s.url} target="_blank" rel="noopener" aria-label={s.icon}><Icon name={s.icon} size={17} /></a>
        ))}
      </div>
    </div>
    <div class="hero-avatar-wrap">
      <div class="hero-avatar">
        {avatar
          ? <img src={avatar} alt={person.name} width="800" height="964" fetchpriority="high" loading="eager" decoding="async" />
          : <span>{person.initials}</span>}
      </div>
    </div>
  </div>
</section>
<div class="gradient-bar"></div>
