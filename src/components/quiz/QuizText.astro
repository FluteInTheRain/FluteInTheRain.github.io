---
// Bilingual text where `code` between backticks is shown as a formula or code span.
// Same output as T.astro (one span per language), so the site's language toggle works unchanged.
interface Props { en: string; vi: string }
const { en, vi } = Astro.props;
const parts = (s: string) => s.split(/`([^`]+)`/);
---
<span data-lang-en>{parts(en).map((p, i) => (i % 2 ? <code class="quiz-formula">{p}</code> : p))}</span><span data-lang-vi>{parts(vi).map((p, i) => (i % 2 ? <code class="quiz-formula">{p}</code> : p))}</span>
