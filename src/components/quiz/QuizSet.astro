---
import T from '../T.astro';
import QuizText from './QuizText.astro';
import QuizMedia from './QuizMedia.astro';
import QuizQuestion from './QuizQuestion.astro';
import type { QuizSet } from '../../data/quiz/types';

interface Props {
  set: QuizSet;
  /** 1-based position of the set, and how many sets there are */
  index: number;
  total: number;
  /** number of questions before this set */
  offset: number;
  postSlug: string;
  slugPairs: Record<string, string>;
}
const { set, index, total, offset, postSlug, slugPairs } = Astro.props;
---
<section class="quiz-set" id={set.id} data-set={set.id} data-index={index}>
  <header class="quiz-set-head">
    <p class="quiz-set-kicker"><T en={`Case ${index} of ${total}`} vi={`Tình huống ${index}/${total}`} /></p>
    <h2 class="quiz-set-title"><T en={set.title.en} vi={set.title.vi} /></h2>
  </header>

  {set.context.media && set.context.media.length > 0 && (
    <div class="quiz-set-media">{set.context.media.map((m) => <QuizMedia media={m} />)}</div>
  )}

  <div class="quiz-set-body">
    <aside class="quiz-context" aria-label="Scenario">
      <div class="quiz-text"><QuizText en={set.context.text.en} vi={set.context.text.vi} /></div>
      {set.context.illustrative && (
        <p class="quiz-illustrative">
          <T en="The numbers in this case are made up for the exercise." vi="Các con số trong tình huống này là số minh họa." />
        </p>
      )}
    </aside>

    <div class="quiz-questions">
      <nav class="quiz-q-nav" data-q-nav hidden aria-label="Questions of this case">
        <button type="button" class="quiz-q-arrow" data-q-prev aria-label="Previous question">‹</button>
        {set.questions.map((q, i) => (
          <button type="button" class="quiz-q-chip" data-goto-q={q.id}>{offset + i + 1}</button>
        ))}
        <button type="button" class="quiz-q-arrow" data-q-next aria-label="Next question">›</button>
      </nav>
      {set.questions.map((q, i) => (
        <QuizQuestion q={q} n={offset + i + 1} postSlug={postSlug} slugPairs={slugPairs} />
      ))}
    </div>
  </div>
</section>
