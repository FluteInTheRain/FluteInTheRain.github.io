---
// Shown by the script after the last question. Hidden (and empty of meaning) without JavaScript.
import T from '../T.astro';
import { LEVELS, LEVEL_LABELS } from '../../data/quiz/labels';
---
<section class="quiz-summary" data-summary hidden aria-live="polite">
  <h2 class="quiz-summary-title"><T en="Your result" vi="Kết quả của bạn" /></h2>
  <p class="quiz-summary-score"><strong data-score-right>0</strong> / <span data-score-total>0</span></p>
  <table class="quiz-summary-table">
    <thead>
      <tr>
        <th scope="col"><T en="Level" vi="Tầng" /></th>
        <th scope="col"><T en="Right" vi="Đúng" /></th>
      </tr>
    </thead>
    <tbody>
      {LEVELS.map((l) => (
        <tr data-level-row={l}>
          <th scope="row"><T en={LEVEL_LABELS[l].en} vi={LEVEL_LABELS[l].vi} /></th>
          <td data-level-score>0 / 0</td>
        </tr>
      ))}
    </tbody>
  </table>
  <div class="quiz-summary-actions">
    <button type="button" class="quiz-btn" data-retry-wrong><T en="Retry the wrong ones" vi="Làm lại các câu sai" /></button>
    <button type="button" class="quiz-btn quiz-btn-quiet" data-reset><T en="Start over" vi="Làm lại từ đầu" /></button>
  </div>
</section>
