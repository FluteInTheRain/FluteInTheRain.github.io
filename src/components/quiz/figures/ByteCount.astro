---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 04 (encoding): a writer and a reader share a three-field schema; the byte ruler is empty on purpose.
// It shows the setting only (no byte counts, no encoded results), so it never gives an answer away.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids, so the EN and VI copies cannot clash.

const W = 580;
const H = 372;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const card = { x: 10, y: 44, w: 270, h: 118 };
const fields = [
  { n: '1', name: 'sensor_id', en: 'whole number', vi: 'số nguyên' },
  { n: '2', name: 'celsius', en: 'whole number', vi: 'số nguyên' },
  { n: '3', name: 'room', en: 'text', vi: 'văn bản' },
].map((f, i) => ({ ...f, y: card.y + 58 + i * 26 }));

const cells = 16;
const cw = 34;
const cx0 = 18;
const cy = 214;

const chips = [
  { x: 10, en1: 'JSON', vi1: 'JSON', en2: 'text', vi2: 'văn bản' },
  { x: 203, en1: 'Protocol Buffers', vi1: 'Protocol Buffers', en2: 'binary, with a schema', vi2: 'nhị phân, có schema' },
  { x: 396, en1: 'Avro', vi1: 'Avro', en2: 'binary, with a schema', vi2: 'nhị phân, có schema' },
];
const a1 = arrow(372, 96, 508, 96);
---
<div class="qbc">
  <div>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A writer and a reader share a schema of three fields. One reading is written as bytes, and a ruler of empty byte cells waits to be filled.">
      <text x="10" y="26" class="qbc-h">
        <tspan data-lang-en>One reading, written as bytes</tspan>
        <tspan data-lang-vi>Một bản ghi, ghi thành byte</tspan>
      </text>

      <g class="qbc-box">
        <rect x={card.x} y={card.y} width={card.w} height={card.h} rx="8" />
      </g>
      <text x={card.x + 14} y={card.y + 26} class="qbc-name">
        <tspan data-lang-en>Schema both sides know</tspan>
        <tspan data-lang-vi>Schema mà hai bên cùng biết</tspan>
      </text>
      <line x1={card.x + 14} x2={card.x + card.w - 14} y1={card.y + 36} y2={card.y + 36} class="qbc-axis" />
      {fields.map((f) => (
        <g>
          <text x={card.x + 14} y={f.y} class="qbc-num">{f.n}</text>
          <text x={card.x + 38} y={f.y} class="qbc-name">{f.name}</text>
          <text x={card.x + 148} y={f.y} class="qbc-sub">
            <tspan data-lang-en>{f.en}</tspan>
            <tspan data-lang-vi>{f.vi}</tspan>
          </text>
        </g>
      ))}

      <DiagramIcon name="server" x={340} y={96} size={30} />
      <text x={340} y={138} text-anchor="middle" class="qbc-sub">
        <tspan data-lang-en>Writer</tspan>
        <tspan data-lang-vi>Bên ghi</tspan>
      </text>
      <g class="qbc-arrow"><path d={a1.line} /><polygon points={a1.head} /></g>
      <text x="440" y="84" text-anchor="middle" class="qbc-sub">
        <tspan data-lang-en>bytes</tspan>
        <tspan data-lang-vi>byte</tspan>
      </text>
      <DiagramIcon name="db" x={540} y={96} size={30} />
      <text x={540} y={138} text-anchor="middle" class="qbc-sub">
        <tspan data-lang-en>Reader</tspan>
        <tspan data-lang-vi>Bên đọc</tspan>
      </text>

      <text x="10" y="196" class="qbc-note">
        <tspan data-lang-en>Each cell is one byte (8 bits):</tspan>
        <tspan data-lang-vi>Mỗi ô là một byte (8 bit):</tspan>
      </text>
      {Array.from({ length: cells }).map((_, i) => (
        <rect x={cx0 + i * cw - 8} y={cy - 12} width={cw - 4} height="26" rx="3" class="qbc-cell" />
      ))}
      <text x="10" y="262" class="qbc-sub">
        <tspan data-lang-en>How many cells one reading fills depends on the format.</tspan>
        <tspan data-lang-vi>Một bản ghi chiếm bao nhiêu ô còn tuỳ định dạng.</tspan>
      </text>

      {chips.map((c) => (
        <g>
          <g class="qbc-box"><rect x={c.x} y="288" width="174" height="64" rx="8" /></g>
          <text x={c.x + 14} y="314" class="qbc-name">
            <tspan data-lang-en>{c.en1}</tspan>
            <tspan data-lang-vi>{c.vi1}</tspan>
          </text>
          <text x={c.x + 14} y="336" class="qbc-sub">
            <tspan data-lang-en>{c.en2}</tspan>
            <tspan data-lang-vi>{c.vi2}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
</div>

<style>
  .qbc { width: 100%; }
  .qbc svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qbc text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qbc .qbc-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qbc .qbc-name { font-weight: 700; fill: var(--text); }
  .qbc .qbc-sub { fill: var(--text-muted); }
  .qbc .qbc-num { font-weight: 700; fill: var(--act-2); }
  .qbc .qbc-note { fill: var(--text); }
  .qbc-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qbc-cell { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .qbc-axis { stroke: var(--border); stroke-width: 1.5; }
  .qbc-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .qbc-arrow polygon { fill: var(--text-muted); }
</style>
