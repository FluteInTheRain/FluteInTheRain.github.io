---
// Quiz figure for Post 4 set 05: T+2 calendar with a public holiday on Friday.
---
<div class="qfig-sbq04wk">
  <svg viewBox="0 0 580 190" role="img" aria-label="Calendar week showing a Wednesday 10:00 AM buy, Thursday T+1, Friday National Holiday (exchange closed), Saturday-Sunday weekend (closed), and Monday morning open.">
    <text x="16" y="24" class="qfig-h">
      <tspan data-lang-en>Trading calendar: Wednesday buy before a Friday holiday</tspan>
      <tspan data-lang-vi>Lịch giao dịch: mua sáng thứ Tư trước ngày nghỉ lễ thứ Sáu</tspan>
    </text>

    {[
      { x: 16, d: 'Wed / T4', s: 'Buy 10:00 (T)', red: false },
      { x: 126, d: 'Thu / T5', s: 'Open (T+1)', red: false },
      { x: 236, d: 'Fri / T6', s: 'Holiday (Closed)', red: true },
      { x: 346, d: 'Sat–Sun', s: 'Weekend', red: true },
      { x: 456, d: 'Mon / T2', s: 'Open (?)', red: false },
    ].map((c) => (
      <g>
        <rect x={c.x} y="46" width="102" height="110" rx="8" class={c.red ? 'qfig-card-red' : 'qfig-card'} />
        <text x={c.x + 51} y="82" text-anchor="middle" class={c.red ? 'qfig-t qfig-red' : 'qfig-t'}>{c.d}</text>
        <text x={c.x + 51} y="122" text-anchor="middle" class="qfig-m">{c.s}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-sbq04wk { margin: 0; width: 100%; }
  .qfig-sbq04wk svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-sbq04wk text { font-size: 12.5px; fill: var(--text-body); }
  .qfig-sbq04wk .qfig-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-sbq04wk .qfig-t { font-weight: 700; fill: var(--text); }
  .qfig-sbq04wk .qfig-m { fill: var(--text-muted); font-size: 11.5px; }
  .qfig-sbq04wk .qfig-red { fill: var(--red); }
  .qfig-sbq04wk .qfig-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-sbq04wk .qfig-card-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
</style>
