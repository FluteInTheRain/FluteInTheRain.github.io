---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for trade-offs set 01: checkout and the month-end report both hit one orders table.
// Shows how many rows each kind of query touches and how wide one row is. It does not say what to do.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
function headR(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 5} ${x - 9},${y + 5}`;
}
function headL(x: number, y: number) {
  return `${x},${y} ${x + 9},${y - 5} ${x + 9},${y + 5}`;
}
const cols = [
  { x: 0, w: 80, en: 'id', vi: 'id', b: 8 },
  { x: 84, w: 96, en: 'store_id', vi: 'store_id', b: 4 },
  { x: 184, w: 104, en: 'order_date', vi: 'order_date', b: 8 },
  { x: 292, w: 88, en: 'amount', vi: 'amount', b: 8 },
];
---
<div class="qfig-scan">
  <svg viewBox="0 0 580 350" role="img" aria-label="Checkout queries each touch one row of the orders table, while the month-end report touches 200 million rows. The table has 50 columns and each row is 420 bytes wide.">
    <text x="0" y="20" class="qfig-scan-h">
      <tspan data-lang-en>Month-end on the orders table</tspan>
      <tspan data-lang-vi>Cuối tháng trên bảng orders</tspan>
    </text>

    <!-- checkout -->
    <DiagramIcon name="users" x="4" y="36" size="28" />
    <text x="40" y="58" class="qfig-scan-lane">
      <tspan data-lang-en>Checkout</tspan>
      <tspan data-lang-vi>Thanh toán</tspan>
    </text>
    <rect x="0" y="80" width="160" height="46" rx="6" class="qfig-scan-box" />
    <text x="10" y="99" class="qfig-scan-t">
      <tspan data-lang-en>Load order 1042</tspan>
      <tspan data-lang-vi>Lấy đơn 1042</tspan>
    </text>
    <text x="10" y="117" class="qfig-scan-m">
      <tspan data-lang-en>touches 1 row</tspan>
      <tspan data-lang-vi>đụng 1 dòng</tspan>
    </text>
    <rect x="0" y="136" width="160" height="46" rx="6" class="qfig-scan-box" />
    <text x="10" y="155" class="qfig-scan-t">
      <tspan data-lang-en>Set status to paid</tspan>
      <tspan data-lang-vi>Đổi sang đã trả</tspan>
    </text>
    <text x="10" y="173" class="qfig-scan-m">
      <tspan data-lang-en>touches 1 row</tspan>
      <tspan data-lang-vi>đụng 1 dòng</tspan>
    </text>
    <line x1="160" x2="186" y1="103" y2="103" class="qfig-scan-thin" />
    <polygon points={headR(195, 103)} class="qfig-scan-thinhead" />
    <line x1="160" x2="186" y1="159" y2="159" class="qfig-scan-thin" />
    <polygon points={headR(195, 159)} class="qfig-scan-thinhead" />

    <!-- finance -->
    <DiagramIcon name="laptop" x="390" y="36" size="28" />
    <text x="426" y="58" class="qfig-scan-lane">
      <tspan data-lang-en>Finance</tspan>
      <tspan data-lang-vi>Phòng tài chính</tspan>
    </text>
    <rect x="390" y="80" width="190" height="102" rx="6" class="qfig-scan-hot" />
    <text x="400" y="102" class="qfig-scan-t">
      <tspan data-lang-en>Revenue per store</tspan>
      <tspan data-lang-vi>Doanh thu từng cửa hàng</tspan>
    </text>
    <text x="400" y="120" class="qfig-scan-t">
      <tspan data-lang-en>per month, 3 years</tspan>
      <tspan data-lang-vi>theo tháng, 3 năm</tspan>
    </text>
    <text x="400" y="162" class="qfig-scan-m">
      <tspan data-lang-en>touches 200 million rows</tspan>
      <tspan data-lang-vi>đụng 200 triệu dòng</tspan>
    </text>
    <line x1="390" x2="364" y1="131" y2="131" class="qfig-scan-heavy" />
    <polygon points={headL(355, 131)} class="qfig-scan-heavyhead" />

    <!-- table -->
    <rect x="195" y="66" width="160" height="130" rx="8" class="qfig-scan-card" />
    <DiagramIcon name="postgres" x="255" y="74" size="40" />
    <text x="275" y="140" text-anchor="middle" class="qfig-scan-lane">
      <tspan data-lang-en>Orders table</tspan>
      <tspan data-lang-vi>Bảng orders</tspan>
    </text>
    <text x="275" y="159" text-anchor="middle" class="qfig-scan-m">
      <tspan data-lang-en>50 columns</tspan>
      <tspan data-lang-vi>50 cột</tspan>
    </text>
    <text x="275" y="177" text-anchor="middle" class="qfig-scan-m">
      <tspan data-lang-en>200 million rows</tspan>
      <tspan data-lang-vi>200 triệu dòng</tspan>
    </text>

    <!-- one row -->
    <line x1="0" x2="580" y1="214" y2="214" class="qfig-scan-rule" />
    <text x="0" y="238" class="qfig-scan-lane">
      <tspan data-lang-en>One order row, as stored (not to scale)</tspan>
      <tspan data-lang-vi>Một dòng order khi lưu (không theo tỉ lệ)</tspan>
    </text>
    {cols.map((c) => (
      <g>
        <rect x={c.x} y="250" width={c.w} height="46" rx="5" class="qfig-scan-box" />
        <text x={c.x + c.w / 2} y="269" text-anchor="middle" class="qfig-scan-t">{c.en}</text>
        <text x={c.x + c.w / 2} y="287" text-anchor="middle" class="qfig-scan-m">
          <tspan data-lang-en>{c.b} bytes</tspan>
          <tspan data-lang-vi>{c.b} byte</tspan>
        </text>
      </g>
    ))}
    <rect x="384" y="250" width="196" height="46" rx="5" class="qfig-scan-box" />
    <text x="482" y="269" text-anchor="middle" class="qfig-scan-t">
      <tspan data-lang-en>46 other columns</tspan>
      <tspan data-lang-vi>46 cột khác</tspan>
    </text>
    <text x="482" y="287" text-anchor="middle" class="qfig-scan-m">
      <tspan data-lang-en>392 bytes together</tspan>
      <tspan data-lang-vi>tổng cộng 392 byte</tspan>
    </text>
    <text x="0" y="322" class="qfig-scan-m">
      <tspan data-lang-en>The report needs store_id, order_date and amount. A row is 420 bytes wide.</tspan>
      <tspan data-lang-vi>Báo cáo cần store_id, order_date và amount. Mỗi dòng rộng 420 byte.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-scan { margin: 0; width: 100%; }
  .qfig-scan svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-scan text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-scan .qfig-scan-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-scan .qfig-scan-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-scan .qfig-scan-t { font-weight: 600; fill: var(--text); }
  .qfig-scan .qfig-scan-m { fill: var(--text-muted); }
  .qfig-scan-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-scan-card { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-scan-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .qfig-scan-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-scan-thin { stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-scan-thinhead { fill: var(--text-muted); }
  .qfig-scan-heavy { stroke: var(--red); stroke-width: 5; }
  .qfig-scan-heavyhead { fill: var(--red); }
</style>
