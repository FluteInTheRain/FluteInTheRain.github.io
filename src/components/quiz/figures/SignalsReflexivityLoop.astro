---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 05: the reflexivity loop, in Soros's framing — beliefs move prices, prices then
// confirm or strengthen the beliefs. The inner ring is the forward loop; the outer
// branch is the same loop in reverse when prices break (margin calls).
const nodes = [
  { x: 290, y: 96, en: 'A belief spreads:\n"the price will rise"', vi: 'Một niềm tin lan ra:\n"giá sẽ tăng"' },
  { x: 448, y: 200, en: 'Buyers act on it', vi: 'Người mua hành động theo nó' },
  { x: 290, y: 306, en: 'Prices rise', vi: 'Giá tăng' },
  { x: 132, y: 200, en: 'The rise confirms\nthe belief', vi: 'Cú tăng xác nhận\nniềm tin' },
];
const arcs = [
  { d: 'M 372 106 A 130 130 0 0 1 452 168', mid: [428, 118] },
  { d: 'M 452 236 A 130 130 0 0 1 372 298', mid: [452, 276] },
  { d: 'M 208 298 A 130 130 0 0 1 128 236', mid: [128, 278] },
  { d: 'M 128 168 A 130 130 0 0 1 208 106', mid: [126, 116] },
];
---
<div class="qrl">
  <svg viewBox="0 0 580 420" role="img" aria-hidden="true">
    <DiagramIcon name="users" x={22} y={20} size={22} />
    <text x="44" y="25" class="qrl-h">
      <tspan data-lang-en>Reflexivity: a loop no photo dataset has</tspan>
      <tspan data-lang-vi>Reflexivity: một vòng lặp mà không dataset ảnh nào có</tspan>
    </text>

    {arcs.map((a, i) => (
      <g class="qrl-loop">
        <path d={a.d} />
        <polygon
          points={`${a.mid[0]},${a.mid[1]} ${a.mid[0] - 5},${a.mid[1] - 9} ${a.mid[0] + 5},${a.mid[1] - 9}`}
          transform={`rotate(${90 + i * 90} ${a.mid[0]} ${a.mid[1]})`}
        />
      </g>
    ))}

    {nodes.map((n) => (
      <g>
        <rect x={n.x - 92} y={n.y - 30} width="184" height="60" rx="10" class="qrl-node" />
        <text x={n.x} y={n.y - 8} text-anchor="middle" class="qrl-strong">
          <tspan data-lang-en>{n.en.split('\n')[0]}</tspan>
          <tspan data-lang-vi>{n.vi.split('\n')[0]}</tspan>
        </text>
        <text x={n.x} y={n.y + 14} text-anchor="middle" class="qrl-strong">
          <tspan data-lang-en>{n.en.split('\n')[1]}</tspan>
          <tspan data-lang-vi>{n.vi.split('\n')[1]}</tspan>
        </text>
      </g>
    ))}

    <rect x="20" y="352" width="540" height="56" rx="10" class="qrl-note" />
    <text x="36" y="374" class="qrl-bad">
      <tspan data-lang-en>Running in reverse when prices break: margin calls force selling → lower prices → more margin calls.</tspan>
      <tspan data-lang-vi>Chạy ngược khi giá gãy: call margin ép bán → giá thấp hơn → thêm call margin.</tspan>
    </text>
    <text x="36" y="394" class="qrl-label">
      <tspan data-lang-en>Beliefs move prices; prices then confirm or strengthen those beliefs (Soros).</tspan>
      <tspan data-lang-vi>Niềm tin đẩy giá; giá rồi xác nhận hoặc củng cố chính niềm tin đó (Soros).</tspan>
    </text>
  </svg>
</div>

<style>
  .qrl {
    margin: 0;
    width: 100%;
  }
  .qrl svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qrl text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qrl .qrl-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qrl .qrl-strong {
    font-size: 13.5px;
    font-weight: 600;
    fill: var(--text);
  }
  .qrl .qrl-label {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qrl-node {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .qrl-loop path {
    fill: none;
    stroke: var(--act-2);
    stroke-width: 2;
  }
  .qrl-loop polygon {
    fill: var(--act-2);
  }
  .qrl .qrl-bad {
    fill: var(--red);
    font-weight: 700;
    font-size: 12.5px;
  }
  .qrl-note {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
</style>
