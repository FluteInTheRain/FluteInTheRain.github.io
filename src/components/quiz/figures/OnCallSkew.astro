---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 07 (transactions): the on-call roster (three shifts, two doctors each) and the order in which
// Chen's and Dara's transactions interleave in shift #42. Shows the setup only, never the outcome.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 384;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const shifts = [
  { n: 41, a: 'Ana', b: 'Bo', hot: false },
  { n: 42, a: 'Chen', b: 'Dara', hot: true },
  { n: 43, a: 'Eli', b: 'Fay', hot: false },
].map((s, i) => ({ ...s, x: 10 + i * 192 }));
const cardW = 176;
const cardY = 62;
const cardH = 96;

// lanes: 6 time slots
const laneX = 62;
const slotW = 86;
const boxW = 78;
const lanes = [
  {
    y: 214,
    en: 'Chen',
    vi: 'Chen',
    steps: [
      { slot: 0, en: 'Check', vi: 'Kiểm tra' },
      { slot: 2, en: 'Update', vi: 'Cập nhật' },
      { slot: 3, en: 'Commit', vi: 'Commit' },
    ],
  },
  {
    y: 262,
    en: 'Dara',
    vi: 'Dara',
    steps: [
      { slot: 1, en: 'Check', vi: 'Kiểm tra' },
      { slot: 4, en: 'Update', vi: 'Cập nhật' },
      { slot: 5, en: 'Commit', vi: 'Commit' },
    ],
  },
];
const axis = arrow(laneX, 312, W - 8, 312);
const down = arrow(shifts[1].x + cardW / 2, cardY + cardH + 2, shifts[1].x + cardW / 2, 188);
---
<div class="oc">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A hospital roster with three shifts of two doctors each, and the order in which two doctors' transactions in shift 42 check, update and commit.">
    <text x="10" y="26" class="oc-h">
      <tspan data-lang-en>Rule: every shift keeps one doctor on call</tspan>
      <tspan data-lang-vi>Luật: mỗi ca luôn có ít nhất một bác sĩ trực</tspan>
    </text>
    <DiagramIcon name="shield" x={W - 22} y={22} size={22} />

    {shifts.map((s) => (
      <g>
        <rect x={s.x} y={cardY} width={cardW} height={cardH} rx="8" class={s.hot ? 'oc-card is-hot' : 'oc-card'} />
        <text x={s.x + 12} y={cardY + 24} class="oc-name">
          <tspan data-lang-en>Shift #{s.n}</tspan>
          <tspan data-lang-vi>Ca #{s.n}</tspan>
        </text>
        {[s.a, s.b].map((d, j) => (
          <g>
            <DiagramIcon name="user" x={s.x + 24} y={cardY + 49 + j * 28} size={20} />
            <text x={s.x + 42} y={cardY + 54 + j * 28} class="oc-name">{d}</text>
            <rect x={s.x + 94} y={cardY + 38 + j * 28} width="76" height="22" rx="11" class="oc-chip" />
            <text x={s.x + 132} y={cardY + 54 + j * 28} text-anchor="middle" class="oc-sub">
              <tspan data-lang-en>on call</tspan>
              <tspan data-lang-vi>đang trực</tspan>
            </text>
          </g>
        ))}
      </g>
    ))}

    <g class="oc-arrow"><path d={down.line} /><polygon points={down.head} /></g>
    <text x={shifts[1].x + cardW / 2 + 12} y="180" class="oc-sub">
      <tspan data-lang-en>both click "go off call" together</tspan>
      <tspan data-lang-vi>cùng bấm "nghỉ trực" một lúc</tspan>
    </text>

    {lanes.map((l) => (
      <g>
        <text x="10" y={l.y + 5} class="oc-name">
          <tspan data-lang-en>{l.en}</tspan>
          <tspan data-lang-vi>{l.vi}</tspan>
        </text>
        <line x1={laneX} x2={W - 8} y1={l.y} y2={l.y} class="oc-lane" />
        {l.steps.map((st) => (
          <g>
            <rect x={laneX + st.slot * slotW + 4} y={l.y - 15} width={boxW} height="30" rx="6" class="oc-step" />
            <text x={laneX + st.slot * slotW + 4 + boxW / 2} y={l.y + 5} text-anchor="middle" class="oc-step-t">
              <tspan data-lang-en>{st.en}</tspan>
              <tspan data-lang-vi>{st.vi}</tspan>
            </text>
          </g>
        ))}
      </g>
    ))}

    <g class="oc-arrow"><path d={axis.line} /><polygon points={axis.head} /></g>
    <text x={laneX} y="334" class="oc-sub">
      <tspan data-lang-en>time</tspan>
      <tspan data-lang-vi>thời gian</tspan>
    </text>
    <text x="10" y="364" class="oc-note">
      <tspan data-lang-en>Each transaction reads from the snapshot taken at its first read.</tspan>
      <tspan data-lang-vi>Mỗi giao dịch đọc từ snapshot lấy ở lần đọc đầu tiên.</tspan>
    </text>
  </svg>
</div>

<style>
  .oc { width: 100%; }
  .oc svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .oc text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .oc .oc-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .oc .oc-name { font-weight: 700; fill: var(--text); }
  .oc .oc-sub { font-size: 13px; fill: var(--text-muted); }
  .oc .oc-note { fill: var(--text); }
  .oc .oc-step-t { font-size: 13px; font-weight: 700; fill: var(--text); }
  .oc-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .oc-card.is-hot { stroke: var(--text); stroke-width: 2; }
  .oc-chip { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1; }
  .oc-lane { stroke: var(--border); stroke-width: 1.5; stroke-dasharray: 4 4; }
  .oc-step { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .oc-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .oc-arrow polygon { fill: var(--text-muted); }
</style>
