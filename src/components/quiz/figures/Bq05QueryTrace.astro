---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-database-access-layer set 05: the statements one list request sends to the database.
// Row A is the single list query, row B is a comb of 200 thin ticks (one per case), each tick one round trip.
// It shows the shape of the traffic, not a total time. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const x0 = 30;
const x1 = 550;
const ticks = Array.from({ length: 200 }, (_, i) => x0 + 2 + i * ((x1 - x0 - 4) / 199));
---
<div class="qfig-bqqt">
  <svg viewBox="0 0 580 236" role="img" aria-label="Two rows of database statements for one request: a single list query, then a dense comb of 200 thin ticks, one evidence query per case, each tick a separate round trip of 2 ms.">
    <text x="0" y="22" class="qfig-bqqt-h">
      <tspan data-lang-en>What one request sends to the database</tspan>
      <tspan data-lang-vi>Một request gửi gì tới database</tspan>
    </text>

    <text x={x0} y="60" class="qfig-bqqt-t">SELECT … FROM cases LIMIT 200</text>
    <rect x={x0} y="68" width="5" height="26" rx="1.5" class="qfig-bqqt-one" />
    <text x={x0 + 16} y="86" class="qfig-bqqt-m">
      <tspan data-lang-en>1 query: the list</tspan>
      <tspan data-lang-vi>1 query: danh sách</tspan>
    </text>

    <line x1="0" x2="580" y1="112" y2="112" class="qfig-bqqt-rule" />

    <text x={x0} y="136" class="qfig-bqqt-t">SELECT … FROM evidence WHERE case_id = ?</text>
    {ticks.map((x) => (
      <rect x={x} y="146" width="1.2" height="26" class="qfig-bqqt-many" />
    ))}
    <text x={x0} y="192" class="qfig-bqqt-m">
      <tspan data-lang-en>200 queries: one per case, each with its own round trip</tspan>
      <tspan data-lang-vi>200 query: mỗi case một query, mỗi query một lượt đi về riêng</tspan>
    </text>

    <line x1="0" x2="580" y1="206" y2="206" class="qfig-bqqt-rule" />
    <DiagramIcon name={'network' as any} x={16} y={222} size={20} />
    <text x="34" y="227" class="qfig-bqqt-t">
      <tspan data-lang-en>Round trip to the database: 2 ms per query</tspan>
      <tspan data-lang-vi>Một lượt đi về tới database: 2 ms mỗi query</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-bqqt { margin: 0; width: 100%; }
  .qfig-bqqt svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-bqqt text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bqqt .qfig-bqqt-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-bqqt .qfig-bqqt-t { font-weight: 600; fill: var(--text); }
  .qfig-bqqt .qfig-bqqt-m { fill: var(--text-muted); }
  .qfig-bqqt-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-bqqt-one { fill: var(--gold); }
  .qfig-bqqt-many { fill: var(--red); }
</style>
