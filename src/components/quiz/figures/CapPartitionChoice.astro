---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for consensus set 03: two ticketing regions (DC-West 65% majority, DC-East 35% minority)
// separated by a WAN link (20-60 ms healthy one-way delay) cut by a fiber break, plus two endpoints.
// Inline SVG, site tokens only, no <marker>/<defs>/ids. Shows scenario inputs only, never answers.
---
<div class="qfig-cpc">
  <svg viewBox="0 0 580 392" role="img" aria-label="Two regions connected by a WAN link: DC-West is the majority side with 65% of traffic, and DC-East is the minority side with 35% of traffic. Healthy one-way delay is 20 to 60 ms, and a fiber cut isolates DC-East. Below, two endpoints run on the platform: POST /seats/claim for a unique seat_id and POST /points/award for promo loyalty points.">
    <text x="0" y="22" class="qfig-cpc-h">
      <tspan data-lang-en>Two regions split across a WAN link</tspan>
      <tspan data-lang-vi>Hai vùng bị chia cắt qua đường WAN</tspan>
    </text>

    <!-- DC-West (majority) -->
    <rect x="0" y="46" width="204" height="148" rx="8" class="qfig-cpc-box" />
    <DiagramIcon name="cloud" x={26} y={72} size={24} />
    <text x="46" y="77" class="qfig-cpc-t">DC-West</text>
    <text x="14" y="104" class="qfig-cpc-g">
      <tspan data-lang-en>majority side</tspan>
      <tspan data-lang-vi>phe đa số</tspan>
    </text>
    <text x="14" y="124" class="qfig-cpc-m">
      <tspan data-lang-en>65% of user traffic</tspan>
      <tspan data-lang-vi>65% lưu lượng</tspan>
    </text>
    <DiagramIcon name="users" x={26} y={162} size={22} />
    <text x="44" y="167" class="qfig-cpc-m">
      <tspan data-lang-en>regional clients</tspan>
      <tspan data-lang-vi>client trong vùng</tspan>
    </text>

    <!-- DC-East (minority) -->
    <rect x="376" y="46" width="204" height="148" rx="8" class="qfig-cpc-box" />
    <DiagramIcon name="cloud" x={402} y={72} size={24} />
    <text x="422" y="77" class="qfig-cpc-t">DC-East</text>
    <text x="390" y="104" class="qfig-cpc-t">
      <tspan data-lang-en>minority side</tspan>
      <tspan data-lang-vi>phe thiểu số</tspan>
    </text>
    <text x="390" y="124" class="qfig-cpc-m">
      <tspan data-lang-en>35% of user traffic</tspan>
      <tspan data-lang-vi>35% lưu lượng</tspan>
    </text>
    <DiagramIcon name="users" x={402} y={162} size={22} />
    <text x="420" y="167" class="qfig-cpc-m">
      <tspan data-lang-en>regional clients</tspan>
      <tspan data-lang-vi>client trong vùng</tspan>
    </text>

    <!-- WAN link + fiber cut -->
    <text x="290" y="64" text-anchor="middle" class="qfig-cpc-m">
      <tspan data-lang-en>Healthy 1-way delay</tspan>
      <tspan data-lang-vi>Trễ 1 chiều khi ổn</tspan>
    </text>
    <text x="290" y="84" text-anchor="middle" class="qfig-cpc-t">20 ms – 60 ms</text>
    <line x1="208" x2="282" y1="114" y2="114" class="qfig-cpc-link" />
    <line x1="298" x2="372" y1="114" y2="114" class="qfig-cpc-link" />
    <line x1="290" x2="290" y1="96" y2="132" class="qfig-cpc-cut" />
    <text x="290" y="154" text-anchor="middle" class="qfig-cpc-r">
      <tspan data-lang-en>fiber cut</tspan>
      <tspan data-lang-vi>đứt cáp quang</tspan>
    </text>
    <text x="290" y="174" text-anchor="middle" class="qfig-cpc-m">
      <tspan data-lang-en>regions isolated</tspan>
      <tspan data-lang-vi>hai vùng tách rời</tspan>
    </text>

    <!-- Endpoints -->
    <line x1="0" x2="580" y1="214" y2="214" class="qfig-cpc-rule" />
    <text x="0" y="240" class="qfig-cpc-t">
      <tspan data-lang-en>Two endpoints serving users</tspan>
      <tspan data-lang-vi>Hai endpoint phục vụ người dùng</tspan>
    </text>

    <rect x="0" y="256" width="280" height="102" rx="8" class="qfig-cpc-box" />
    <DiagramIcon name="key" x={26} y={282} size={22} />
    <text x="44" y="287" class="qfig-cpc-t">POST /seats/claim</text>
    <text x="14" y="314" class="qfig-cpc-b">
      <tspan data-lang-en>Assigns unique seat_id</tspan>
      <tspan data-lang-vi>Cấp mã seat_id duy nhất</tspan>
    </text>
    <text x="14" y="336" class="qfig-cpc-m">
      <tspan data-lang-en>Same seat cannot sell twice</tspan>
      <tspan data-lang-vi>Không được bán trùng một ghế</tspan>
    </text>

    <rect x="300" y="256" width="280" height="102" rx="8" class="qfig-cpc-box" />
    <DiagramIcon name="receipt" x={326} y={282} size={22} />
    <text x="344" y="287" class="qfig-cpc-t">POST /points/award</text>
    <text x="314" y="314" class="qfig-cpc-b">
      <tspan data-lang-en>Credits promo loyalty points</tspan>
      <tspan data-lang-vi>Cộng điểm thưởng khuyến mãi</tspan>
    </text>
    <text x="314" y="336" class="qfig-cpc-m">
      <tspan data-lang-en>Duplicate credits adjustable later</tspan>
      <tspan data-lang-vi>Cộng trùng có thể chỉnh lại sau</tspan>
    </text>

    <text x="0" y="382" class="qfig-cpc-m">
      <tspan data-lang-en>Both endpoints see healthy WAN delays and rare fiber cuts.</tspan>
      <tspan data-lang-vi>Cả hai endpoint đều gặp trễ WAN thường ngày lẫn đứt cáp hiếm gặp.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-cpc { margin: 0; width: 100%; }
  .qfig-cpc svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-cpc text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-cpc .qfig-cpc-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-cpc .qfig-cpc-t { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .qfig-cpc .qfig-cpc-b { fill: var(--text-body); }
  .qfig-cpc .qfig-cpc-m { fill: var(--text-muted); }
  .qfig-cpc .qfig-cpc-g { font-size: 14.5px; font-weight: 700; fill: var(--gold); }
  .qfig-cpc .qfig-cpc-r { font-size: 14.5px; font-weight: 700; fill: var(--red); }
  .qfig-cpc-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .qfig-cpc-link { stroke: var(--text-muted); stroke-width: 1.8; stroke-dasharray: 5 4; }
  .qfig-cpc-cut { stroke: var(--red); stroke-width: 3; }
  .qfig-cpc-rule { stroke: var(--border); stroke-width: 1; }
</style>
