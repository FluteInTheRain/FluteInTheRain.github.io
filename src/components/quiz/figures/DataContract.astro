---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 02: a data contract — the written agreement between producer and consumer
// on columns, units, revision rules and delivery times (post §1).
const clauses = [
  { en: 'columns and types', vi: 'cột và kiểu dữ liệu' },
  { en: 'units for every number', vi: 'đơn vị cho mọi con số' },
  { en: 'revision rules', vi: 'quy tắc sửa số' },
  { en: 'delivery times', vi: 'thời gian giao' },
  { en: 'what "missing" means', vi: '"thiếu dữ liệu" nghĩa là gì' },
];
const W = 580;
const H = 400;
const cx = 290;
---
<div class="qdc">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <text x="290" y="28" text-anchor="middle" class="qdc-h">
      <tspan data-lang-en>The agreement both sides sign before any data flows</tspan>
      <tspan data-lang-vi>Thỏa thuận hai bên ký trước khi dữ liệu chảy</tspan>
    </text>

    <rect x="16" y="52" width="190" height="120" rx="10" class="qdc-box" />
    <DiagramIcon name="server" x={36} y={70} size={20} />
    <text x="64" y="85" class="qdc-strong">
      <tspan data-lang-en>Data provider</tspan>
      <tspan data-lang-vi>Bên cấp dữ liệu</tspan>
    </text>
    <text x="34" y="112" class="qdc-muted">
      <tspan data-lang-en>ships the files</tspan>
      <tspan data-lang-vi>giao các file</tspan>
    </text>
    <text x="34" y="134" class="qdc-muted">
      <tspan data-lang-en>changes things quietly</tspan>
      <tspan data-lang-vi>hay đổi thứ âm thầm</tspan>
    </text>
    <text x="34" y="156" class="qdc-bad">
      <tspan data-lang-en>(VND → thousands of VND)</tspan>
      <tspan data-lang-vi>(VND → nghìn VND)</tspan>
    </text>

    <rect x="374" y="52" width="190" height="120" rx="10" class="qdc-box" />
    <DiagramIcon name="model" x={394} y={70} size={20} />
    <text x="422" y="85" class="qdc-strong">
      <tspan data-lang-en>Consumer</tspan>
      <tspan data-lang-vi>Bên dùng dữ liệu</tspan>
    </text>
    <text x="392" y="112" class="qdc-muted">
      <tspan data-lang-en>builds the models</tspan>
      <tspan data-lang-vi>dựng các mô hình</tspan>
    </text>
    <text x="392" y="134" class="qdc-muted">
      <tspan data-lang-en>wants zero surprises</tspan>
      <tspan data-lang-vi>muốn không bị bất ngờ</tspan>
    </text>
    <text x="392" y="156" class="qdc-ok">
      <tspan data-lang-en>(fixes written once)</tspan>
      <tspan data-lang-vi>(viết bản vá một lần)</tspan>
    </text>

    <line x1="206" x2="258" y1="112" y2="112" class="qdc-link" />
    <line x1="322" x2="374" y1="112" y2="112" class="qdc-link" />
    <circle cx={cx} cy="112" r="34" class="qdc-seal" />
    <DiagramIcon name="key" x={cx - 11} y={88} size={20} />
    <text x={cx} y="126" text-anchor="middle" class="qdc-sealtext">
      <tspan data-lang-en>contract</tspan>
      <tspan data-lang-vi>hợp đồng</tspan>
    </text>

    <text x="24" y="206" class="qdc-strong">
      <tspan data-lang-en>Agreed in writing, in advance:</tspan>
      <tspan data-lang-vi>Thống nhất bằng văn bản, từ trước:</tspan>
    </text>
    {clauses.map((c, i) => {
      const col = i % 2;
      const row = Math.floor(i / 2);
      const x = 24 + col * 280;
      const y = 236 + row * 40;
      return (
        <g>
          <rect x={x} y={y - 20} width="264" height="30" rx="6" class="qdc-clause" />
          <text x={x + 14} y={y} class="qdc-clausetext">
            <tspan data-lang-en>{c.en}</tspan>
            <tspan data-lang-vi>{c.vi}</tspan>
          </text>
        </g>
      );
    })}
    <text x="24" y="376" class="qdc-muted">
      <tspan data-lang-en>Result: the consumer never gets surprised by the producer.</tspan>
      <tspan data-lang-vi>Kết quả: bên dùng không bao giờ bị bên cấp làm bất ngờ.</tspan>
    </text>
  </svg>
</div>

<style>
  .qdc {
    margin: 0;
    width: 100%;
  }
  .qdc svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qdc text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .qdc .qdc-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qdc .qdc-strong {
    font-size: 14px;
    font-weight: 600;
    fill: var(--text);
  }
  .qdc .qdc-muted {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .qdc .qdc-bad {
    font-size: 13px;
    font-weight: 600;
    fill: var(--red);
  }
  .qdc .qdc-ok {
    font-size: 13px;
    font-weight: 600;
    fill: var(--act-2);
  }
  .qdc .qdc-box {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .qdc .qdc-clause {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .qdc .qdc-clausetext {
    font-size: 13.5px;
    fill: var(--text);
  }
  .qdc .qdc-link {
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .qdc .qdc-seal {
    fill: var(--bg);
    stroke: var(--gold);
    stroke-width: 2;
  }
  .qdc .qdc-sealtext {
    font-size: 12px;
    font-weight: 700;
    fill: var(--gold-icon);
  }
</style>
