---
// Quiz figure for go-slices-maps-strings set 01: one slice header over a backing array of six cells.
// It shows len, cap and which cells are inside len; it does not say what indexing does.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
---
<div class="qfig-gq03lc">
  <svg viewBox="0 0 580 270" role="img" aria-label="A slice header with ptr, len 4 and cap 6, pointing at the first of six cells in a backing array. Cells 0 to 3 hold 0, 0, 0, 7 and are inside len. Cells 4 and 5 are unused room up to cap.">
    <text x="0" y="20" class="qfig-gq03lc-h">
      <tspan data-lang-en>One slice header over one backing array</tspan>
      <tspan data-lang-vi>Một slice header trên một mảng nền</tspan>
    </text>

    <text x="20" y="52" class="qfig-gq03lc-t">t</text>
    <rect x="20" y="62" width="240" height="40" rx="6" class="qfig-gq03lc-cell" />
    <line x1="100" x2="100" y1="62" y2="102" class="qfig-gq03lc-sep" />
    <line x1="180" x2="180" y1="62" y2="102" class="qfig-gq03lc-sep" />
    <text x="60" y="87" text-anchor="middle" class="qfig-gq03lc-m">ptr</text>
    <text x="140" y="87" text-anchor="middle" class="qfig-gq03lc-m">len 4</text>
    <text x="220" y="87" text-anchor="middle" class="qfig-gq03lc-m">cap 6</text>

    <line x1="60" x2="60" y1="102" y2="148" class="qfig-gq03lc-arrow" />
    <polyline points="54,140 60,150 66,140" class="qfig-gq03lc-arrowhead" />

    <rect x="20" y="152" width="320" height="48" rx="4" class="qfig-gq03lc-in" />
    <rect x="340" y="152" width="160" height="48" rx="4" class="qfig-gq03lc-spare" />
    <line x1="100" x2="100" y1="152" y2="200" class="qfig-gq03lc-sep" />
    <line x1="180" x2="180" y1="152" y2="200" class="qfig-gq03lc-sep" />
    <line x1="260" x2="260" y1="152" y2="200" class="qfig-gq03lc-sep" />
    <line x1="340" x2="340" y1="152" y2="200" class="qfig-gq03lc-sep" />
    <line x1="420" x2="420" y1="152" y2="200" class="qfig-gq03lc-sep" />

    <text x="60" y="182" text-anchor="middle" class="qfig-gq03lc-m">0</text>
    <text x="140" y="182" text-anchor="middle" class="qfig-gq03lc-m">0</text>
    <text x="220" y="182" text-anchor="middle" class="qfig-gq03lc-m">0</text>
    <text x="300" y="182" text-anchor="middle" class="qfig-gq03lc-m">7</text>
    <text x="380" y="182" text-anchor="middle" class="qfig-gq03lc-m">?</text>
    <text x="460" y="182" text-anchor="middle" class="qfig-gq03lc-m">?</text>

    <text x="60" y="218" text-anchor="middle" class="qfig-gq03lc-i">[0]</text>
    <text x="140" y="218" text-anchor="middle" class="qfig-gq03lc-i">[1]</text>
    <text x="220" y="218" text-anchor="middle" class="qfig-gq03lc-i">[2]</text>
    <text x="300" y="218" text-anchor="middle" class="qfig-gq03lc-i">[3]</text>
    <text x="380" y="218" text-anchor="middle" class="qfig-gq03lc-i">[4]</text>
    <text x="460" y="218" text-anchor="middle" class="qfig-gq03lc-i">[5]</text>

    <text x="180" y="246" text-anchor="middle" class="qfig-gq03lc-b">
      <tspan data-lang-en>cells 0 to 3: counted by len</tspan>
      <tspan data-lang-vi>ô 0 đến 3: len đếm tới</tspan>
    </text>
    <text x="420" y="246" text-anchor="middle" class="qfig-gq03lc-b">
      <tspan data-lang-en>cells 4 and 5: room up to cap</tspan>
      <tspan data-lang-vi>ô 4 và 5: chỗ trống tới cap</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq03lc { margin: 0; width: 100%; }
  .qfig-gq03lc svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq03lc text { font-size: 13px; fill: var(--text-body); }
  .qfig-gq03lc .qfig-gq03lc-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq03lc .qfig-gq03lc-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq03lc .qfig-gq03lc-m { font-family: 'JetBrains Mono', ui-monospace, monospace; fill: var(--text); }
  .qfig-gq03lc .qfig-gq03lc-i { font-family: 'JetBrains Mono', ui-monospace, monospace; fill: var(--text-muted); }
  .qfig-gq03lc .qfig-gq03lc-b { fill: var(--text-body); }
  .qfig-gq03lc-cell { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-gq03lc-in { fill: var(--bg-alt); stroke: var(--act-3); stroke-width: 2; }
  .qfig-gq03lc-spare { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .qfig-gq03lc-sep { stroke: var(--border); stroke-width: 1.5; }
  .qfig-gq03lc-arrow { stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-gq03lc-arrowhead { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
</style>
