---
// Set 01: ten made-up stocks ranked by book-to-market with next-month returns (same numbers as the post's first figure).
const rows = [['AAA', 1.8, 3.1], ['BBB', 1.45, 1.9], ['CCC', 1.2, 2.4], ['DDD', 0.95, 0.6], ['EEE', 0.8, 1.1], ['FFF', 0.7, -0.4], ['GGG', 0.55, 0.8], ['HHH', 0.42, -1.2], ['III', 0.3, 0.2], ['JJJ', 0.2, -2.3]] as [string, number, number][];
---
<div class="q6a">
  <svg viewBox="0 0 580 340" role="img" aria-hidden="true">
    <text x="20" y="24" class="h"><tspan data-lang-en>Ten stocks, sorted by book-to-market</tspan><tspan data-lang-vi>Mười cổ phiếu, xếp theo book-to-market</tspan></text>
    <text x="150" y="48" class="m"><tspan data-lang-en>book-to-market</tspan><tspan data-lang-vi>book-to-market</tspan></text>
    <text x="400" y="48" class="m"><tspan data-lang-en>next-month return (%)</tspan><tspan data-lang-vi>lợi nhuận tháng sau (%)</tspan></text>
    {rows.map(([s, b, r], i) => (
      <g>
        <rect x="14" y={56 + i * 27} width="552" height="25" rx="4" class={i < 3 ? 'top' : i > 6 ? 'bot' : 'mid'} />
        <text x="24" y={73 + i * 27} class="s">{s}</text>
        <text x="150" y={73 + i * 27} class="n">{b.toFixed(2)}</text>
        <text x="400" y={73 + i * 27} class="n">{(r > 0 ? '+' : '−') + Math.abs(r).toFixed(1)}</text>
      </g>
    ))}
  </svg>
</div>
<style>
  .q6a svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .q6a text { font-size: 13px; fill: var(--text-body); }
  .q6a .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q6a .m { fill: var(--text-muted); font-size: 12px; }
  .q6a .s { font-weight: 700; fill: var(--text); }
  .q6a .n { fill: var(--text); }
  .q6a .top { fill: var(--gold-tint-bg); }
  .q6a .bot { fill: var(--red-tint-bg); }
  .q6a .mid { fill: var(--bg-alt); }
</style>
