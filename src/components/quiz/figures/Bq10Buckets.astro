---
// Quiz figure for backend-observability set 05: the cumulative bucket counts a /metrics scrape returns for one
// route (requests with a duration up to each upper bound), drawn as a staircase of bars. It shows the raw
// scrape, not the per-bucket counts or any percentile. Inline SVG, site tokens only, no ids.
const bars = [
  { en: 'le 0.01', vi: 'le 0.01', n: 0 },
  { en: 'le 0.05', vi: 'le 0.05', n: 120 },
  { en: 'le 0.1', vi: 'le 0.1', n: 180 },
  { en: 'le 0.25', vi: 'le 0.25', n: 180 },
  { en: 'le 0.5', vi: 'le 0.5', n: 180 },
  { en: 'le 1.0', vi: 'le 1.0', n: 180 },
  { en: 'le 2.5', vi: 'le 2.5', n: 200 },
];
const x0 = 40;
const step = 73;
const bw = 52;
const base = 196;
const top = 50;
const maxN = 200;
const sy = (n: number) => base - (n / maxN) * (base - top);
---
<div class="qfig-bq10bk">
  <svg viewBox="0 0 580 270" role="img" aria-label="A staircase of cumulative bucket counts from one scrape: 0 up to 0.01 s, 120 up to 0.05 s, 180 up to 0.1 s and stays 180 through 1.0 s, then 200 up to 2.5 s.">
    <text x="0" y="22" class="qfig-bq10bk-h">
      <tspan data-lang-en>Requests with a duration up to each bound, in seconds</tspan>
      <tspan data-lang-vi>Số request có thời lượng tới từng ngưỡng, tính bằng giây</tspan>
    </text>
    <line x1="30" x2="570" y1={sy(200)} y2={sy(200)} class="qfig-bq10bk-limit" />
    <line x1="30" x2="570" y1={base} y2={base} class="qfig-bq10bk-axis" />
    {bars.map((b, i) => (
      <g>
        {b.n > 0 && <rect x={x0 + i * step} y={sy(b.n)} width={bw} height={base - sy(b.n)} rx="3" class="qfig-bq10bk-bar" />}
        <text x={x0 + i * step + bw / 2} y={b.n > 0 ? sy(b.n) - 7 : base - 7} text-anchor="middle" class="qfig-bq10bk-t">{b.n}</text>
        <text x={x0 + i * step + bw / 2} y={base + 20} text-anchor="middle" class="qfig-bq10bk-m">{b.en}</text>
      </g>
    ))}
    <text x="0" y="250" class="qfig-bq10bk-m">
      <tspan data-lang-en>200 requests in all, total time of all of them: 30.0 s</tspan>
      <tspan data-lang-vi>Tổng cộng 200 request, tổng thời gian của tất cả: 30,0 s</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-bq10bk { margin: 0; width: 100%; }
  .qfig-bq10bk svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-bq10bk text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bq10bk .qfig-bq10bk-h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-bq10bk .qfig-bq10bk-m { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-bq10bk .qfig-bq10bk-t { font-weight: 700; fill: var(--text); }
  .qfig-bq10bk-axis { stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-bq10bk-limit { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .qfig-bq10bk-bar { fill: var(--gold); }
</style>
