---
// 100 independent random series (numpy default_rng(11)); histogram of the 4,950 pairwise correlations, bins of 0.05 from -0.6.
const b60 = [0,0,0,3,11,36,89,178,309,488,616,767,735,648,475,297,160,94,35,6,3,0,0,0];
const b250 = [0,0,0,0,0,0,0,4,43,221,819,1430,1366,785,233,45,4,0,0,0,0,0,0,0];
const P = [{ x0: 20, d: b60, en: '60 days', vi: '60 ngày' }, { x0: 310, d: b250, en: '250 days', vi: '250 ngày' }];
const PW = 250, PH = 100, PY = 44, bw = PW / 24;
---
<div class="q11s">
  <svg viewBox="0 0 580 190" role="img" aria-hidden="true">
    <text x="20" y="20" class="q11s-h"><tspan data-lang-en>Correlations among 100 unrelated random series</tspan><tspan data-lang-vi>Tương quan giữa 100 chuỗi ngẫu nhiên không liên quan</tspan></text>
    {P.map((p) => (
      <g>
        <text x={p.x0} y={PY - 6} class="q11s-p"><tspan data-lang-en>{p.en}</tspan><tspan data-lang-vi>{p.vi}</tspan></text>
        <line x1={p.x0} y1={PY + PH} x2={p.x0 + PW} y2={PY + PH} class="q11s-a" />
        {p.d.map((c, i) => c > 0 ? <rect x={p.x0 + i * bw + 0.5} y={PY + PH - (c / 1430) * PH} width={bw - 1} height={(c / 1430) * PH} class={Math.abs(-0.6 + i * 0.05 + 0.025) > 0.2 ? 'q11s-b q11s-o' : 'q11s-b'} /> : null)}
        {[-0.6, -0.2, 0, 0.2, 0.6].map((r) => <text x={p.x0 + ((r + 0.6) / 1.2) * PW} y={PY + PH + 15} text-anchor="middle" class="q11s-t">{r}</text>)}
      </g>
    ))}
    <text x="20" y="178" class="q11s-s"><tspan data-lang-en>Red bars: pairs beyond ±0.2. True correlation is zero in both panels.</tspan><tspan data-lang-vi>Cột đỏ: các cặp vượt ±0,2. Tương quan thật bằng không ở cả hai khung.</tspan></text>
  </svg>
</div>
<style>
  .q11s { margin: 0; width: 100%; }
  .q11s svg { display: block; width: 100%; height: auto; }
  .q11s text { font-size: 12.5px; fill: var(--text-body); }
  .q11s .q11s-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q11s .q11s-p { font-size: 13px; font-weight: 700; fill: var(--text); }
  .q11s .q11s-t { font-size: 11px; fill: var(--text-muted); }
  .q11s .q11s-s { font-size: 12px; fill: var(--text-muted); }
  .q11s-a { stroke: var(--border); stroke-width: 1.2; }
  .q11s-b { fill: var(--text-faint); opacity: 0.55; }
  .q11s-o { fill: var(--red); opacity: 1; }
</style>
