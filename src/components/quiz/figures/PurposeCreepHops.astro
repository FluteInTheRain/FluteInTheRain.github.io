---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for ethics set 07: the path of one car's location data, five hops from the car to an insurer.
// The first hop is the car, the second an ingest service, the third a partner endpoint; hops 4 and 5 follow the
// FTC's account of GM and OnStar. It only shows where the data goes. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const rowH = 54;
const gap = 16;
const top = 44;
const rowW = 388;
const hops = [
  { icon: 'car', en: 'Car', vi: 'Xe', den: 'A point every 3 s while driving', dvi: 'Cứ 3 giây một điểm khi đang lái' },
  { icon: 'server', en: 'Ingest service', vi: 'Dịch vụ ingest', den: 'Logs every point and keeps the stream', dvi: 'Ghi log mọi điểm và giữ cả luồng' },
  { icon: 'link', en: 'Partner endpoint', vi: 'Endpoint của đối tác', den: 'Receives the stream as it arrives', dvi: 'Nhận luồng ngay khi dữ liệu tới' },
  { icon: 'file', en: 'Consumer reporting agency', vi: 'Công ty báo cáo người tiêu dùng', den: 'Holds driver reports', dvi: 'Giữ các báo cáo về tài xế' },
  { icon: 'shield', en: 'Insurer', vi: 'Hãng bảo hiểm', den: 'Sets rates or denies cover', dvi: 'Định phí hoặc từ chối bảo hiểm' },
];
const y = (i: number) => top + i * (rowH + gap);
function down(x: number, yy: number) {
  return `${x},${yy + 7} ${x - 5},${yy - 1} ${x + 5},${yy - 1}`;
}
const bx = rowW + 14;
---
<div class="qfig-hop">
  <svg viewBox="0 0 580 392" role="img" aria-label="A car's location data passes through five hops: the car, an ingest service, a partner endpoint, a consumer reporting agency and an insurer.">
    <text x="0" y="22" class="qfig-hop-h">
      <tspan data-lang-en>One car's data, hop by hop</tspan>
      <tspan data-lang-vi>Dữ liệu của một chiếc xe, từng chặng</tspan>
    </text>

    {hops.map((h, i) => (
      <g>
        <rect x="0" y={y(i)} width={rowW} height={rowH} rx="8" class="qfig-hop-row" />
        <DiagramIcon name={h.icon as any} x="30" y={y(i) + rowH / 2} size={26} />
        <text x="60" y={y(i) + 23} class="qfig-hop-n">
          <tspan data-lang-en>{h.en}</tspan>
          <tspan data-lang-vi>{h.vi}</tspan>
        </text>
        <text x="60" y={y(i) + 43} class="qfig-hop-d">
          <tspan data-lang-en>{h.den}</tspan>
          <tspan data-lang-vi>{h.dvi}</tspan>
        </text>
        <text x={rowW - 12} y={y(i) + 23} text-anchor="end" class="qfig-hop-k">{i + 1}</text>
        {i < hops.length - 1 && (
          <g>
            <line x1="30" x2="30" y1={y(i) + rowH} y2={y(i) + rowH + gap - 6} class="qfig-hop-flow" />
            <polygon points={down(30, y(i) + rowH + gap - 6)} class="qfig-hop-head" />
          </g>
        )}
      </g>
    ))}

    <!-- right-hand brackets -->
    <line x1={bx} x2={bx} y1={y(0) + 4} y2={y(1) + rowH - 4} class="qfig-hop-br qfig-hop-br-gold" />
    <text x={bx + 12} y={(y(0) + y(1) + rowH) / 2 - 4} class="qfig-hop-t">
      <tspan data-lang-en>Weekly score</tspan>
      <tspan data-lang-vi>Điểm lái xe</tspan>
    </text>
    <text x={bx + 12} y={(y(0) + y(1) + rowH) / 2 + 14} class="qfig-hop-t">
      <tspan data-lang-en>shown to the driver</tspan>
      <tspan data-lang-vi>hằng tuần cho tài xế</tspan>
    </text>

    <line x1={bx} x2={bx} y1={y(3) + 4} y2={y(4) + rowH - 4} class="qfig-hop-br qfig-hop-br-muted" />
    <text x={bx + 12} y={(y(3) + y(4) + rowH) / 2 - 4} class="qfig-hop-m">
      <tspan data-lang-en>As the FTC</tspan>
      <tspan data-lang-vi>Theo FTC mô tả</tspan>
    </text>
    <text x={bx + 12} y={(y(3) + y(4) + rowH) / 2 + 14} class="qfig-hop-m">
      <tspan data-lang-en>describes GM</tspan>
      <tspan data-lang-vi>về GM</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-hop { margin: 0; width: 100%; }
  .qfig-hop svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-hop text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-hop .qfig-hop-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-hop .qfig-hop-n { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-hop .qfig-hop-d { fill: var(--text-body); }
  .qfig-hop .qfig-hop-k { font-size: 15px; font-weight: 700; fill: var(--text-muted); }
  .qfig-hop .qfig-hop-t { font-weight: 600; fill: var(--text); }
  .qfig-hop .qfig-hop-m { fill: var(--text-muted); }
  .qfig-hop-row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-hop-flow { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-hop-head { fill: var(--text-muted); }
  .qfig-hop-br { stroke-width: 3; stroke-linecap: round; }
  .qfig-hop-br-gold { stroke: var(--gold); }
  .qfig-hop-br-muted { stroke: var(--text-muted); }
</style>
