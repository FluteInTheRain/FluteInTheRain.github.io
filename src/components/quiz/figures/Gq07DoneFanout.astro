---
// Quiz figure for the Go goroutines quiz (post 07), set 02: the shape of the program in s02q4. One goroutine
// performs one send on a channel and three workers each have a select with a receive case on that same
// channel. It draws no timing and no verdict.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const workers = [1, 2, 3];
---
<div class="qfig-gq07df">
  <svg viewBox="0 0 580 250" role="img" aria-label="One main goroutine on the left performs a single send, done <- true, on a channel of bool named done. Three worker goroutines on the right each run a loop with a select that has a receive case on done and a default case with a 10 ms sleep.">
    <text x="0" y="18" class="qfig-gq07df-h">
      <tspan data-lang-en>One send, three selects on the same channel</tspan>
      <tspan data-lang-vi>Một lệnh gửi, ba select trên cùng một channel</tspan>
    </text>

    <text x="20" y="58" class="qfig-gq07df-m">main</text>
    <rect x="20" y="66" width="150" height="40" rx="6" class="qfig-gq07df-box" />
    <text x="32" y="91" class="qfig-gq07df-c">done &lt;- true</text>
    <text x="20" y="126" class="qfig-gq07df-m">
      <tspan data-lang-en>one send</tspan>
      <tspan data-lang-vi>một lệnh gửi</tspan>
    </text>

    <rect x="200" y="96" width="130" height="52" rx="26" class="qfig-gq07df-chan" />
    <text x="265" y="118" text-anchor="middle" class="qfig-gq07df-c">done</text>
    <text x="265" y="136" text-anchor="middle" class="qfig-gq07df-m">chan bool</text>
    <line x1="170" x2="200" y1="86" y2="115" class="qfig-gq07df-line" />

    {workers.map((n, i) => (
      <g>
        <text x="360" y={46 + i * 66} class="qfig-gq07df-m">
          <tspan data-lang-en>worker {n}</tspan>
          <tspan data-lang-vi>worker {n}</tspan>
        </text>
        <rect x="360" y={54 + i * 66} width="200" height="40" rx="6" class="qfig-gq07df-box" />
        <text x="372" y={79 + i * 66} class="qfig-gq07df-c">case &lt;-done</text>
        <line x1="330" x2="360" y1="122" y2={74 + i * 66} class="qfig-gq07df-line" />
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-gq07df { margin: 0; width: 100%; }
  .qfig-gq07df svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq07df text { font-size: 13px; fill: var(--text-body); }
  .qfig-gq07df .qfig-gq07df-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq07df .qfig-gq07df-m { fill: var(--text-muted); }
  .qfig-gq07df .qfig-gq07df-c { font-family: var(--font-mono, monospace); fill: var(--text); }
  .qfig-gq07df-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-gq07df-chan { fill: var(--bg); stroke: var(--act-3); stroke-width: 2; }
  .qfig-gq07df-line { stroke: var(--border); stroke-width: 2; }
</style>
