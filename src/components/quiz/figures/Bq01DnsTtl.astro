---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend request-lifecycle set 06: a smaller version of a DNS outage. The name servers become
// unreachable at 100 s while the web servers keep running; one resolver looked the name up at 0 s with TTL 300 s.
// It marks no expiry time and no verdict. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const X0 = 150, X1 = 556, MAX = 400;
const px = (s: number) => X0 + (s * (X1 - X0)) / MAX;
const ticks = [0, 100, 200, 300, 400];
const AX = 222;
---
<div class="qfig-bq01dt">
  <svg viewBox="0 0 580 262" role="img" aria-label="A timeline from 0 to 400 seconds with three lanes: the name servers are reachable until 100 seconds and unreachable after, the web servers keep running the whole time, and one resolver looks the name up at 0 seconds with a TTL of 300 seconds.">
    <text x="0" y="20" class="qfig-bq01dt-h">
      <tspan data-lang-en>Only the name servers disappear</tspan>
      <tspan data-lang-vi>Chỉ các name server biến mất</tspan>
    </text>

    {[
      { y: 62, icon: 'network', en: 'Name servers', vi: 'Name server' },
      { y: 112, icon: 'server', en: 'Web servers', vi: 'Web server' },
      { y: 162, icon: 'laptop', en: 'Resolver', vi: 'Resolver' },
    ].map((l) => (
      <g>
        <DiagramIcon name={l.icon as any} x="14" y={l.y + 6} size={24} />
        <text x="38" y={l.y + 10} class="qfig-bq01dt-lane">
          <tspan data-lang-en>{l.en}</tspan>
          <tspan data-lang-vi>{l.vi}</tspan>
        </text>
      </g>
    ))}

    <rect x={px(0)} y="52" width={px(100) - px(0)} height="22" rx="4" class="qfig-bq01dt-ok" />
    <text x={px(0) + 8} y="67" class="qfig-bq01dt-t">
      <tspan data-lang-en>reachable</tspan>
      <tspan data-lang-vi>truy cập được</tspan>
    </text>
    <rect x={px(100)} y="52" width={px(400) - px(100)} height="22" rx="4" class="qfig-bq01dt-bad" />
    <text x={px(100) + 8} y="67" class="qfig-bq01dt-t">
      <tspan data-lang-en>unreachable</tspan>
      <tspan data-lang-vi>không truy cập được</tspan>
    </text>

    <rect x={px(0)} y="102" width={px(400) - px(0)} height="22" rx="4" class="qfig-bq01dt-ok" />
    <text x={px(100) + 8} y="117" class="qfig-bq01dt-t">
      <tspan data-lang-en>running the whole time</tspan>
      <tspan data-lang-vi>chạy suốt thời gian này</tspan>
    </text>

    <line x1={px(100)} x2={px(100)} y1="40" y2={AX} class="qfig-bq01dt-cut" />
    <text x={px(100) + 6} y="146" class="qfig-bq01dt-bad-t">
      <tspan data-lang-en>name servers vanish</tspan>
      <tspan data-lang-vi>name server biến mất</tspan>
    </text>

    <line x1={px(0)} x2={px(0)} y1="150" y2={AX} class="qfig-bq01dt-stem" />
    <circle cx={px(0)} cy="162" r="6" class="qfig-bq01dt-dot" />
    <line x1={px(0) + 8} x2={px(100) + 4} y1="162" y2="162" class="qfig-bq01dt-stem" />
    <text x={px(100) + 10} y="166" class="qfig-bq01dt-t">
      <tspan data-lang-en>looks up the name, TTL 300 s</tspan>
      <tspan data-lang-vi>tra tên, TTL 300 s</tspan>
    </text>

    <line x1={X0} x2={X1} y1={AX} y2={AX} class="qfig-bq01dt-axis" />
    {ticks.map((s) => (
      <g>
        <line x1={px(s)} x2={px(s)} y1={AX - 4} y2={AX + 4} class="qfig-bq01dt-axis" />
        <text x={px(s)} y={AX + 22} text-anchor={s === 400 ? 'end' : 'middle'} class="qfig-bq01dt-m">{s} s</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-bq01dt { margin: 0; width: 100%; }
  .qfig-bq01dt svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-bq01dt text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bq01dt .qfig-bq01dt-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-bq01dt .qfig-bq01dt-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-bq01dt .qfig-bq01dt-t { font-weight: 600; fill: var(--text); }
  .qfig-bq01dt .qfig-bq01dt-m { fill: var(--text-muted); }
  .qfig-bq01dt .qfig-bq01dt-bad-t { font-weight: 700; fill: var(--red); }
  .qfig-bq01dt-ok { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .qfig-bq01dt-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-bq01dt-cut { stroke: var(--red); stroke-width: 2; stroke-dasharray: 5 4; }
  .qfig-bq01dt-stem { stroke: var(--border); stroke-width: 1.5; stroke-dasharray: 4 4; }
  .qfig-bq01dt-dot { fill: var(--text); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-bq01dt-axis { stroke: var(--text-muted); stroke-width: 2; }
</style>
