---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for set 07: 12 dated API versions on a timeline, three accounts pinned at versions 1, 6 and 12,
// each calling the API with its own pinned date. Shows only the scenario's inputs, no answer.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 7 * Math.cos(a)} ${y2 - 7 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const x0 = 20;
const step = 540 / 11;
const axisY = 96;
const vx = (v: number) => x0 + (v - 1) * step;
const versions = Array.from({ length: 12 }, (_, i) => i + 1);
const years = [
  { v: 1, y: '2022' },
  { v: 5, y: '2023' },
  { v: 9, y: '2024' },
];
const accounts = [
  { name: 'A', v: 1, date: '2022-01-01', bx: 0 },
  { name: 'B', v: 6, date: '2023-04-01', bx: 195 },
  { name: 'C', v: 12, date: '2024-10-01', bx: 390 },
];
const bw = 190;
const by = 160;
const bh = 78;
const sy = 312;
---
<div class="qfig-apiv">
  <svg viewBox="0 0 580 430" role="img" aria-label="Twelve dated API versions on a timeline, one every three months. Accounts A, B and C are pinned at versions 1, 6 and 12 and each calls the payments API with its pinned date.">
    <text x="0" y="22" class="qfig-apiv-h">
      <tspan data-lang-en>12 dated versions, one every 3 months</tspan>
      <tspan data-lang-vi>12 phiên bản theo ngày, cứ 3 tháng một bản</tspan>
    </text>

    <line x1={x0} x2={vx(12)} y1={axisY} y2={axisY} class="qfig-apiv-axis" />
    {versions.map((v) => {
      const pinned = accounts.some((a) => a.v === v);
      return (
        <g>
          <circle cx={vx(v)} cy={axisY} r={pinned ? 8 : 5} class={pinned ? 'qfig-apiv-dot-pin' : 'qfig-apiv-dot'} />
          <text x={vx(v)} y={axisY - 18} text-anchor="middle" class="qfig-apiv-v">v{v}</text>
        </g>
      );
    })}
    {years.map((yr) => (
      <text x={vx(yr.v) + 6} y={axisY + 26} class="qfig-apiv-m">{yr.y}</text>
    ))}

    {accounts.map((a) => {
      const cx = a.bx + bw / 2;
      const ar = arrow(cx, by + bh + 2, cx, sy - 2);
      return (
        <g>
          <line x1={vx(a.v)} x2={vx(a.v)} y1={axisY + 9} y2={by} class="qfig-apiv-pin" />
          <g class="qfig-apiv-acct">
            <rect x={a.bx} y={by} width={bw} height={bh} rx="8" />
          </g>
          <DiagramIcon name="laptop" x={a.bx + 28} y={by + 28} size={28} />
          <text x={a.bx + 52} y={by + 34} class="qfig-apiv-t">
            <tspan data-lang-en>Account {a.name}</tspan>
            <tspan data-lang-vi>Tài khoản {a.name}</tspan>
          </text>
          <text x={a.bx + 14} y={by + 64} class="qfig-apiv-n">
            <tspan data-lang-en>Pinned: {a.date}</tspan>
            <tspan data-lang-vi>Ghim: {a.date}</tspan>
          </text>
          <g class="qfig-apiv-go"><path d={ar.line} /><polygon points={ar.head} /></g>
        </g>
      );
    })}

    <g class="qfig-apiv-api">
      <rect x="0" y={sy} width="580" height="76" rx="8" />
    </g>
    <DiagramIcon name="server" x="32" y={sy + 38} size={30} />
    <text x="62" y={sy + 32} class="qfig-apiv-t">
      <tspan data-lang-en>Payments API, current version: v12</tspan>
      <tspan data-lang-vi>API thanh toán, phiên bản hiện tại: v12</tspan>
    </text>
    <text x="62" y={sy + 56} class="qfig-apiv-m">
      <tspan data-lang-en>Each call carries the date its account is pinned to.</tspan>
      <tspan data-lang-vi>Mỗi lần gọi mang theo ngày mà tài khoản đã ghim.</tspan>
    </text>

    <text x="0" y="416" class="qfig-apiv-m">
      <tspan data-lang-en>Large dot and gold line: the version an account is pinned to.</tspan>
      <tspan data-lang-vi>Chấm lớn và đường vàng: phiên bản mà tài khoản đã ghim.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-apiv { margin: 0; width: 100%; }
  .qfig-apiv svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-apiv text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-apiv .qfig-apiv-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-apiv .qfig-apiv-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-apiv .qfig-apiv-n { font-size: 15px; font-weight: 600; fill: var(--text); }
  .qfig-apiv .qfig-apiv-v { font-size: 13px; fill: var(--text-muted); }
  .qfig-apiv .qfig-apiv-m { fill: var(--text-muted); }
  .qfig-apiv-axis { stroke: var(--border); stroke-width: 2; }
  .qfig-apiv-dot { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.6; }
  .qfig-apiv-dot-pin { fill: var(--gold); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-apiv-pin { stroke: var(--gold); stroke-width: 1.8; }
  .qfig-apiv-acct rect { fill: var(--bg-alt); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-apiv-go path { stroke: var(--gold); stroke-width: 1.8; fill: none; }
  .qfig-apiv-go polygon { fill: var(--gold); }
  .qfig-apiv-api rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
</style>
