---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for unbundling set 03: one event log feeds two views. The old view reads at the live end
// and keeps serving; the new view replays from offset 0. A router sends 99% / 1% of reads.
// It shows no catch-up time. Inline SVG, site tokens only, no <marker>/<defs>/ids.
function down(x: number, y: number) {
  return `${x},${y} ${x - 4.5},${y - 9} ${x + 4.5},${y - 9}`;
}
function up(x: number, y: number) {
  return `${x},${y} ${x - 4.5},${y + 9} ${x + 4.5},${y + 9}`;
}
const segs = [104, 476];
---
<div class="qfig-dvc">
  <svg viewBox="0 0 580 372" role="img" aria-label="One log of 1.2 billion events feeds two views: the old view reads at the live end and serves 99% of reads, the new view replays from offset 0 at 50,000 events per second and serves 1%.">
    <text x="0" y="22" class="qfig-dvc-h">
      <tspan data-lang-en>One log, two views side by side</tspan>
      <tspan data-lang-vi>Một log, hai khung nhìn chạy song song</tspan>
    </text>

    <!-- the log -->
    <rect x="20" y="42" width="540" height="40" rx="6" class="qfig-dvc-log" />
    {segs.map((x) => <line x1={x} x2={x} y1="42" y2="82" class="qfig-dvc-cell" />)}
    <text x="290" y="67" text-anchor="middle" class="qfig-dvc-t">
      <tspan data-lang-en>Log: 1.2 billion order events</tspan>
      <tspan data-lang-vi>Log: 1,2 tỷ sự kiện đơn hàng</tspan>
    </text>
    <text x="20" y="102" class="qfig-dvc-m">
      <tspan data-lang-en>offset 0</tspan>
      <tspan data-lang-vi>offset 0</tspan>
    </text>
    <text x="560" y="102" text-anchor="end" class="qfig-dvc-m">
      <tspan data-lang-en>live end: +2,000 events/s</tspan>
      <tspan data-lang-vi>đầu log mới nhất: +2.000 sự kiện/giây</tspan>
    </text>

    <!-- arrows from the log to the views -->
    <line x1="90" x2="90" y1="110" y2="146" class="qfig-dvc-new-line" />
    <polygon points={down(90, 156)} class="qfig-dvc-new-head" />
    <line x1="490" x2="490" y1="110" y2="146" class="qfig-dvc-old-line" />
    <polygon points={down(490, 156)} class="qfig-dvc-old-head" />

    <!-- new view -->
    <rect x="20" y="158" width="270" height="108" rx="10" class="qfig-dvc-new" />
    <DiagramIcon name="db" x="46" y="188" size={28} />
    <text x="72" y="187" class="qfig-dvc-lane">
      <tspan data-lang-en>New view</tspan>
      <tspan data-lang-vi>Khung nhìn mới</tspan>
    </text>
    <text x="36" y="216" class="qfig-dvc-t">
      <tspan data-lang-en>New schema</tspan>
      <tspan data-lang-vi>Schema mới</tspan>
    </text>
    <text x="36" y="238" class="qfig-dvc-t">
      <tspan data-lang-en>Replays from offset 0</tspan>
      <tspan data-lang-vi>Phát lại từ offset 0</tspan>
    </text>
    <text x="36" y="258" class="qfig-dvc-m">
      <tspan data-lang-en>50,000 events/s</tspan>
      <tspan data-lang-vi>50.000 sự kiện/giây</tspan>
    </text>

    <!-- old view -->
    <rect x="310" y="158" width="250" height="108" rx="10" class="qfig-dvc-old" />
    <DiagramIcon name="db" x="336" y="188" size={28} />
    <text x="362" y="187" class="qfig-dvc-lane">
      <tspan data-lang-en>Old view</tspan>
      <tspan data-lang-vi>Khung nhìn cũ</tspan>
    </text>
    <text x="326" y="216" class="qfig-dvc-t">
      <tspan data-lang-en>Old schema</tspan>
      <tspan data-lang-vi>Schema cũ</tspan>
    </text>
    <text x="326" y="238" class="qfig-dvc-t">
      <tspan data-lang-en>Keeps serving users</tspan>
      <tspan data-lang-vi>Vẫn phục vụ người dùng</tspan>
    </text>
    <text x="326" y="258" class="qfig-dvc-m">
      <tspan data-lang-en>reads the live end</tspan>
      <tspan data-lang-vi>đọc ở đầu log mới nhất</tspan>
    </text>

    <!-- reads from users back up to the views -->
    <polygon points={up(90, 272)} class="qfig-dvc-new-head" />
    <line x1="90" x2="90" y1="281" y2="306" class="qfig-dvc-new-line" />
    <line x1="90" x2="250" y1="306" y2="306" class="qfig-dvc-new-line" />
    <polygon points={up(490, 272)} class="qfig-dvc-old-head" />
    <line x1="490" x2="490" y1="281" y2="306" class="qfig-dvc-old-line" />
    <line x1="330" x2="490" y1="306" y2="306" class="qfig-dvc-old-line" />

    <text x="96" y="296" class="qfig-dvc-t">
      <tspan data-lang-en>1% of reads</tspan>
      <tspan data-lang-vi>1% lượt đọc</tspan>
    </text>
    <text x="482" y="296" text-anchor="end" class="qfig-dvc-t">
      <tspan data-lang-en>99% of reads</tspan>
      <tspan data-lang-vi>99% lượt đọc</tspan>
    </text>

    <!-- router -->
    <rect x="250" y="288" width="80" height="36" rx="8" class="qfig-dvc-router" />
    <text x="290" y="311" text-anchor="middle" class="qfig-dvc-t">
      <tspan data-lang-en>Router</tspan>
      <tspan data-lang-vi>Router</tspan>
    </text>
    <line x1="290" x2="290" y1="324" y2="338" class="qfig-dvc-axis" />
    <DiagramIcon name="laptop" x="290" y="352" size={26} />
  </svg>
</div>

<style>
  .qfig-dvc { margin: 0; width: 100%; }
  .qfig-dvc svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-dvc text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-dvc .qfig-dvc-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-dvc .qfig-dvc-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-dvc .qfig-dvc-t { font-weight: 600; fill: var(--text); }
  .qfig-dvc .qfig-dvc-m { fill: var(--text-muted); }
  .qfig-dvc-log { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-dvc-cell { stroke: var(--border); stroke-width: 1; }
  .qfig-dvc-new { fill: var(--bg-alt); stroke: var(--act-2); stroke-width: 2; }
  .qfig-dvc-old { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 2; }
  .qfig-dvc-router { fill: var(--bg); stroke: var(--border); stroke-width: 1.5; }
  .qfig-dvc-new-line { stroke: var(--act-2); stroke-width: 2; fill: none; stroke-dasharray: 6 4; }
  .qfig-dvc-new-head { fill: var(--act-2); }
  .qfig-dvc-old-line { stroke: var(--gold); stroke-width: 2.5; fill: none; }
  .qfig-dvc-old-head { fill: var(--gold); }
  .qfig-dvc-axis { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
