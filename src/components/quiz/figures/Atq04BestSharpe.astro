---
// Quiz figure for the best-of-N set. Zero-edge strategies, 5 years daily; mean best annual Sharpe of N tries and
// share of runs reaching Sharpe 1.0 (numpy, seed 20261128): N=10: 0.69 / 13%; N=45: 0.98 / 43%; N=250: 1.26 / 96%.
const rows = [{ n: 10, sr: 0.69, p: '13%' }, { n: 45, sr: 0.98, p: '43%' }, { n: 250, sr: 1.26, p: '96%' }];
const SC = 220;
---
<div class="qfig-atq04bs">
  <svg viewBox="0 0 580 190" role="img" aria-label="Three horizontal bars, the average best annual Sharpe among N strategies with zero edge over five years: 0.69 for 10 tries, 0.98 for 45 and 1.26 for 250. A dashed line marks a Sharpe of 1.0. The share of runs that reach 1.0 is 13 percent, 43 percent and 96 percent.">
    <text x="20" y="18" class="qfig-atq04bs-h">
      <tspan data-lang-en>Best Sharpe among N strategies with no edge (5 years)</tspan>
      <tspan data-lang-vi>Sharpe tốt nhất trong N chiến lược không có lợi thế (5 năm)</tspan>
    </text>
    <line x1={110 + SC} x2={110 + SC} y1="30" y2="150" class="qfig-atq04bs-ref" />
    <text x={110 + SC} y="168" text-anchor="middle" class="qfig-atq04bs-sub">Sharpe 1.0</text>
    {rows.map((r, i) => (
      <g>
        <text x="100" y={62 + i * 38} text-anchor="end" class="qfig-atq04bs-n">
          <tspan data-lang-en>{r.n} tries</tspan>
          <tspan data-lang-vi>{r.n} lần thử</tspan>
        </text>
        <rect x="110" y={46 + i * 38} width={r.sr * SC} height="24" rx="3" class={`qfig-atq04bs-bar ${r.n === 45 ? 'is-key' : ''}`} />
        <text x="400" y={63 + i * 38} class="qfig-atq04bs-v">{r.sr.toFixed(2)}  ·  {r.p}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-atq04bs svg { display: block; width: 100%; height: auto; max-width: 580px; margin: 0 auto; }
  .qfig-atq04bs text { font-size: 12.5px; fill: var(--text-body); }
  .qfig-atq04bs .qfig-atq04bs-h { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-atq04bs .qfig-atq04bs-n { font-weight: 600; fill: var(--text); }
  .qfig-atq04bs .qfig-atq04bs-v { font-weight: 700; fill: var(--text); }
  .qfig-atq04bs .qfig-atq04bs-sub { fill: var(--text-muted); }
  .qfig-atq04bs-bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-atq04bs-bar.is-key { fill: var(--red-tint-bg); stroke: var(--red); }
  .qfig-atq04bs-ref { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 4; }
</style>
