---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 07 (post 11): one locust user. Each request gets a fast 503 (about 5 ms), then a 0.05-0.15 s pause,
// then the next request. The 503 says Retry-After: 1, shown as a dashed 1 s bar. Axis to scale: 0 to 1 s.
const x0 = 190;
const pxPerS = 350;
const xAt = (s: number) => x0 + s * pxPerS;
// start of each request (s): pauses of 0.05-0.15 s between them
const starts = [0, 0.1, 0.24, 0.34, 0.47, 0.57, 0.7, 0.8, 0.93];
const yUser = 140;
const yAxis = 206;
---
<div class="bq11ul">
  <svg viewBox="0 0 580 262" role="img" aria-hidden="true">
    <DiagramIcon name="laptop" x={26} y={yUser} size={24} />
    <text x="48" y={yUser + 5} class="ul-lane">
      <tspan data-lang-en>One locust user</tspan>
      <tspan data-lang-vi>Một user locust</tspan>
    </text>

    <rect x={xAt(0)} y="54" width={xAt(1) - xAt(0)} height="26" rx="4" class="ul-retry" />
    <text x={xAt(0) + 10} y="72" class="ul-in">
      <tspan data-lang-en>Retry-After: 1 s</tspan>
      <tspan data-lang-vi>Retry-After: 1 s</tspan>
    </text>

    <line x1={xAt(0)} x2={xAt(1)} y1={yUser} y2={yUser} class="ul-wire" />
    {starts.map((s) => (
      <g>
        <line x1={xAt(s)} x2={xAt(s)} y1={yUser - 22} y2={yUser + 22} class="ul-req" />
        <rect x={xAt(s)} y={yUser - 8} width="6" height="16" class="ul-503" />
      </g>
    ))}
    <text x={xAt(0.0)} y={yUser + 44} class="ul-note">
      <tspan data-lang-en>request, then a fast 503</tspan>
      <tspan data-lang-vi>request, rồi một 503 trả về nhanh</tspan>
    </text>
    <text x={xAt(0.1) + 4} y={yUser - 34} class="ul-note">
      <tspan data-lang-en>pause 0.05 to 0.15 s</tspan>
      <tspan data-lang-vi>nghỉ 0,05 đến 0,15 s</tspan>
    </text>

    <line x1={xAt(0)} x2={xAt(1)} y1={yAxis} y2={yAxis} class="ul-axis" />
    <g class="ul-tick">
      <line x1={xAt(0)} x2={xAt(0)} y1={yAxis - 5} y2={yAxis + 5} />
      <line x1={xAt(0.5)} x2={xAt(0.5)} y1={yAxis - 5} y2={yAxis + 5} />
      <line x1={xAt(1)} x2={xAt(1)} y1={yAxis - 5} y2={yAxis + 5} />
    </g>
    <text x={xAt(0)} y={yAxis + 22} text-anchor="middle" class="ul-num">0 s</text>
    <text x={xAt(0.5)} y={yAxis + 22} text-anchor="middle" class="ul-num"><tspan data-lang-en>0.5 s</tspan><tspan data-lang-vi>0,5 s</tspan></text>
    <text x={xAt(1)} y={yAxis + 22} text-anchor="middle" class="ul-num">1 s</text>
  </svg>
</div>

<style>
  .bq11ul { margin: 0; width: 100%; }
  .bq11ul svg { display: block; width: 100%; min-width: 360px; height: auto; }
  .bq11ul text { font-size: 13px; fill: var(--text-body); }
  .bq11ul .ul-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .bq11ul .ul-note { fill: var(--text-muted); }
  .bq11ul .ul-in { font-weight: 600; fill: var(--text); }
  .bq11ul .ul-num { font-variant-numeric: tabular-nums; fill: var(--text-muted); }
  .bq11ul .ul-retry { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .bq11ul .ul-wire { stroke: var(--border); stroke-width: 2; }
  .bq11ul .ul-req { stroke: var(--text-muted); stroke-width: 1.5; }
  .bq11ul .ul-503 { fill: var(--red); }
  .bq11ul .ul-axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .bq11ul .ul-tick line { stroke: var(--text-muted); stroke-width: 1.5; }
</style>
