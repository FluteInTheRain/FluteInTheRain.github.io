---
// Quiz figure for the Go context quiz (post 08), set 01: the call chain of the post's example
// and the two times involved (deadline, query duration). States the setup only.
const boxes = [
  { x: 0, a: 'main', b: '150 ms timeout' },
  { x: 150, a: 'handle', b: 'takes ctx' },
  { x: 300, a: 'loadUser', b: 'takes ctx' },
  { x: 450, a: 'queryDB', b: 'takes ctx' },
];
---
<div class="qfig-gq08cc">
  <svg viewBox="0 0 580 210" role="img" aria-label="Call chain main, handle, loadUser, queryDB, each passing the same ctx to the next. Below, a time bar from 0 to 400 ms with a mark at 150 ms.">
    <text x="0" y="20" class="qfig-gq08cc-h">
      <tspan data-lang-en>Call chain and two times</tspan>
      <tspan data-lang-vi>Chuỗi gọi hàm và hai mốc thời gian</tspan>
    </text>
    {boxes.map((b) => (
      <g>
        <rect x={b.x} y="36" width="130" height="52" rx="6" class="qfig-gq08cc-box" />
        <text x={b.x + 65} y="58" text-anchor="middle" class="qfig-gq08cc-c">{b.a}</text>
        <text x={b.x + 65} y="78" text-anchor="middle" class="qfig-gq08cc-m">{b.b}</text>
      </g>
    ))}
    {[130, 280, 430].map((x) => (
      <g>
        <line x1={x} x2={x + 14} y1="62" y2="62" class="qfig-gq08cc-arrow" />
        <polygon points={`${x + 20},62 ${x + 12},57 ${x + 12},67`} class="qfig-gq08cc-head" />
      </g>
    ))}
    <text x="0" y="128" class="qfig-gq08cc-m">
      <tspan data-lang-en>Time from the start of the call</tspan>
      <tspan data-lang-vi>Thời gian từ lúc bắt đầu lời gọi</tspan>
    </text>
    <rect x="0" y="140" width="560" height="14" rx="3" class="qfig-gq08cc-box" />
    <rect x="0" y="140" width="210" height="14" rx="3" class="qfig-gq08cc-fill" />
    <line x1="210" x2="210" y1="134" y2="162" class="qfig-gq08cc-mark" />
    <text x="0" y="180" class="qfig-gq08cc-c">0</text>
    <text x="210" y="180" text-anchor="middle" class="qfig-gq08cc-c">150 ms</text>
    <text x="560" y="180" text-anchor="end" class="qfig-gq08cc-c">400 ms</text>
    <text x="0" y="202" class="qfig-gq08cc-m">
      <tspan data-lang-en>150 ms: the timeout set in main. 400 ms: how long the query takes on its own.</tspan>
      <tspan data-lang-vi>150 ms: timeout đặt trong main. 400 ms: thời gian truy vấn tự chạy.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq08cc { margin: 0; width: 100%; }
  .qfig-gq08cc svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq08cc text { font-size: 13px; fill: var(--text-body); }
  .qfig-gq08cc .qfig-gq08cc-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq08cc .qfig-gq08cc-m { fill: var(--text-muted); }
  .qfig-gq08cc .qfig-gq08cc-c { font-family: var(--font-mono, monospace); fill: var(--text); }
  .qfig-gq08cc-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-gq08cc-fill { fill: var(--act-3); opacity: 0.55; }
  .qfig-gq08cc-mark { stroke: var(--act-3); stroke-width: 2.5; }
  .qfig-gq08cc-arrow { stroke: var(--act-3); stroke-width: 2; }
  .qfig-gq08cc-head { fill: var(--act-3); }
</style>
