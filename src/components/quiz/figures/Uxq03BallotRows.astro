---
// Quiz figure for the spacing post: the butterfly ballot as a schematic (two name columns, one hole column).
---
<div class="qfig-uxq03ballotrows">
  <svg viewBox="0 0 600 250" role="img" aria-label="Schematic of a butterfly ballot: left page names Bush, Gore, Candidate 5 at rows 1, 3, 5; right page names Buchanan, Candidate 4 at rows 2, 4; holes numbered 1 to 5 in one centre column.">
<rect x="20" y="14" width="230" height="222" rx="6" class="box" />
<rect x="350" y="14" width="230" height="222" rx="6" class="box" />
<text x="135" y="30" text-anchor="middle" class="m"><tspan data-lang-en>Left page</tspan><tspan data-lang-vi>Trang trái</tspan></text>
<text x="465" y="30" text-anchor="middle" class="m"><tspan data-lang-en>Right page</tspan><tspan data-lang-vi>Trang phải</tspan></text>
<circle cx="300" cy="50" r="9" class="hole" />
<text x="300" y="54.5" text-anchor="middle" class="m">1</text>
<circle cx="300" cy="90" r="9" class="hole" />
<text x="300" y="94.5" text-anchor="middle" class="m">2</text>
<circle cx="300" cy="130" r="9" class="hole" />
<text x="300" y="134.5" text-anchor="middle" class="m">3</text>
<circle cx="300" cy="170" r="9" class="hole" />
<text x="300" y="174.5" text-anchor="middle" class="m">4</text>
<circle cx="300" cy="210" r="9" class="hole" />
<text x="300" y="214.5" text-anchor="middle" class="m">5</text>
<text x="34" y="54.5" class="lab">Bush</text>
<line x1="150" y1="50" x2="285" y2="50" class="ln" />
<text x="34" y="134.5" class="lab">Gore</text>
<line x1="150" y1="130" x2="285" y2="130" class="ln" />
<text x="34" y="214.5" class="lab">Candidate 5</text>
<line x1="150" y1="210" x2="285" y2="210" class="ln" />
<text x="566" y="94.5" text-anchor="end" class="lab">Buchanan</text>
<line x1="440" y1="90" x2="315" y2="90" class="ln" />
<text x="566" y="174.5" text-anchor="end" class="lab">Candidate 4</text>
<line x1="440" y1="170" x2="315" y2="170" class="ln" />
  </svg>
</div>

<style>
  .qfig-uxq03ballotrows { margin: 0; width: 100%; }
  .qfig-uxq03ballotrows svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq03ballotrows text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq03ballotrows .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-uxq03ballotrows .m { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-uxq03ballotrows .ln { stroke: var(--text-muted); stroke-width: 1.4; fill: none; }
  .qfig-uxq03ballotrows .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq03ballotrows .fld { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-uxq03ballotrows .lab { fill: var(--text); font-weight: 600; }
  .qfig-uxq03ballotrows .hole { fill: var(--bg); stroke: var(--text); stroke-width: 1.6; }
  .qfig-uxq03ballotrows .gap { fill: var(--gold); opacity: 0.22; }
  .qfig-uxq03ballotrows .bar { fill: var(--text-faint); opacity: 0.5; }
  .qfig-uxq03ballotrows .bar2 { fill: var(--text-faint); opacity: 0.28; }
</style>
