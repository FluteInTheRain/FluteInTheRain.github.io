---
// Quiz figure for set 02: one neuron with its weights and bias, inputs shown, no output value.
const rows = [
  { y: 62, en: 'momentum', vi: 'đà tăng', v: '0.8', w: '0.9' },
  { y: 112, en: 'volume change', vi: 'thay đổi khối lượng', v: '-0.3', w: '0.4' },
  { y: 162, en: 'volatility', vi: 'biến động', v: '0.5', w: '-0.7' },
];
---
<div class="qfig-atq14n">
  <svg viewBox="0 0 580 210" role="img" aria-label="A neuron with three inputs: momentum 0.8, volume change -0.3 and volatility 0.5, weights 0.9, 0.4 and -0.7, a bias of 0.1 and a ReLU after the sum.">
    <text x="0" y="20" class="h">
      <tspan data-lang-en>The neuron</tspan>
      <tspan data-lang-vi>Nơ-ron đang xét</tspan>
    </text>
    {rows.map((r) => (
      <g>
        <rect x="0" y={r.y - 20} width="190" height="40" rx="5" class="box" />
        <text x="10" y={r.y - 3} class="lab">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <text x="10" y={r.y + 13} class="val">{r.v}</text>
        <line x1="192" y1={r.y} x2="300" y2="112" class="wire" />
        <text x="228" y={r.y + (112 - r.y) * 0.3 - 6} class="w">× {r.w}</text>
      </g>
    ))}
    <circle cx="332" cy="112" r="32" class="node" />
    <text x="332" y="108" text-anchor="middle" class="val">Σ + 0.1</text>
    <text x="332" y="126" text-anchor="middle" class="lab">bias</text>
    <line x1="366" y1="112" x2="420" y2="112" class="wire" />
    <rect x="424" y="86" width="140" height="52" rx="5" class="box" />
    <text x="494" y="108" text-anchor="middle" class="val">ReLU</text>
    <text x="494" y="126" text-anchor="middle" class="lab">max(0, sum)</text>
  </svg>
</div>

<style>
  .qfig-atq14n svg { display: block; width: 100%; height: auto; max-width: 580px; margin: 0 auto; }
  .qfig-atq14n text { font-size: 12.5px; fill: var(--text-body); }
  .qfig-atq14n .h { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-atq14n .lab { font-size: 12px; font-weight: 600; fill: var(--text-muted); }
  .qfig-atq14n .val { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-atq14n .w { font-size: 12.5px; font-weight: 700; fill: var(--text); }
  .qfig-atq14n .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-atq14n .node { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-atq14n .wire { stroke: var(--text-muted); stroke-width: 1.2; }
</style>
