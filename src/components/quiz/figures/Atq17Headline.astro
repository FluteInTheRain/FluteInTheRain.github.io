---
// Quiz figure for financial NLP set 02: the 1919 headline split into eight tokens, PIG and IRON side by side,
// $34 marked as a price. Inline SVG, site tokens only, no ids.
const toks = ['BIRMINGHAM', 'QUOTES', '$34', 'AS', 'BASIS', 'FOR', 'PIG', 'IRON'];
const widths = toks.map((t) => Math.max(40, t.length * 9 + 22));
let x = 10;
const boxes = toks.map((t, i) => { const b = { t, x, w: widths[i] }; x += widths[i] + 8; return b; });
---
<div class="qfig-atq17h">
  <svg viewBox="0 0 640 170" role="img" aria-label="The headline BIRMINGHAM QUOTES $34 AS BASIS FOR PIG IRON split on spaces into boxes. The box $34 is marked as a price, and the boxes PIG and IRON sit side by side as two separate tokens.">
    <text x="10" y="22" class="qfig-atq17h-h">
      <tspan data-lang-en>The headline, split on spaces</tspan>
      <tspan data-lang-vi>Tiêu đề, tách theo dấu cách</tspan>
    </text>
    {boxes.map((b) => (
      <g>
        <rect x={b.x} y="44" width={b.w} height="38" rx="6" class={`qfig-atq17h-box ${b.t === '$34' ? 'is-price' : ''} ${b.t === 'PIG' || b.t === 'IRON' ? 'is-pair' : ''}`} />
        <text x={b.x + b.w / 2} y="68" text-anchor="middle" class="qfig-atq17h-t">{b.t}</text>
      </g>
    ))}
    <text x={boxes[2].x + boxes[2].w / 2} y="104" text-anchor="middle" class="qfig-atq17h-s">
      <tspan data-lang-en>a price</tspan>
      <tspan data-lang-vi>một mức giá</tspan>
    </text>
    <text x={(boxes[6].x + boxes[7].x + boxes[7].w) / 2} y="104" text-anchor="middle" class="qfig-atq17h-s">
      <tspan data-lang-en>one commodity, two tokens</tspan>
      <tspan data-lang-vi>một mặt hàng, hai token</tspan>
    </text>
    <text x="10" y="150" class="qfig-atq17h-s">
      <tspan data-lang-en>Bag of words: a count per token, no order.</tspan>
      <tspan data-lang-vi>Túi từ: một số đếm cho mỗi token, không có thứ tự.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-atq17h svg { display: block; width: 100%; height: auto; }
  .qfig-atq17h text { font-size: 13px; fill: var(--text-body); }
  .qfig-atq17h .qfig-atq17h-h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-atq17h .qfig-atq17h-t { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qfig-atq17h .qfig-atq17h-s { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-atq17h-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-atq17h-box.is-price { fill: var(--gold-tint-bg); stroke: var(--gold-icon); }
  .qfig-atq17h-box.is-pair { fill: var(--red-tint-bg); stroke: var(--red); }
</style>
