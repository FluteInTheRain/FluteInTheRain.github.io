---
// Quiz figure for the Go optimization-patterns quiz, set 04: the input "12\n345\n6789\n10\n" laid out byte by byte,
// with the first 10 bytes marked as the buffer window. It names the bytes and the window only, not what is carried over.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const text = ['1', '2', '\n', '3', '4', '5', '\n', '6', '7', '8', '9', '\n', '1', '0', '\n'];
const X0 = 14, W = 36, Y = 70, H = 34;
const cx = (i: number) => X0 + i * W;
---
<div class="qfig-gq19cw">
  <svg viewBox="0 0 580 190" role="img" aria-label="The 15 bytes of the input 12, 345, 6789, 10, each line ending in a newline, drawn as numbered cells 0 to 14, with the first 10 cells bracketed as the first buffer window.">
    <text x="0" y="20" class="qfig-gq19cw-h">
      <tspan data-lang-en>Input bytes and a 10-byte buffer</tspan>
      <tspan data-lang-vi>Các byte đầu vào và buffer 10 byte</tspan>
    </text>

    {text.map((c, i) => (
      <g>
        <text x={cx(i) + W / 2} y={Y - 8} text-anchor="middle" class="qfig-gq19cw-i">{i}</text>
        <rect x={cx(i)} y={Y} width={W} height={H} class={c === '\n' ? 'qfig-gq19cw-nl' : 'qfig-gq19cw-cell'} />
        <text x={cx(i) + W / 2} y={Y + 22} text-anchor="middle" class="qfig-gq19cw-c">{c === '\n' ? '\\n' : c}</text>
      </g>
    ))}

    <path d={`M ${cx(0)} ${Y + H + 10} v 8 H ${cx(10)} v -8`} class="qfig-gq19cw-brace" />
    <text x={(cx(0) + cx(10)) / 2} y={Y + H + 42} text-anchor="middle" class="qfig-gq19cw-m">
      <tspan data-lang-en>first Read: buffer of 10 bytes, bytes 0 to 9</tspan>
      <tspan data-lang-vi>Read đầu tiên: buffer 10 byte, byte 0 đến 9</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq19cw { margin: 0; width: 100%; }
  .qfig-gq19cw svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq19cw text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq19cw .qfig-gq19cw-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq19cw .qfig-gq19cw-c { font-family: var(--font-mono, monospace); font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq19cw .qfig-gq19cw-i { fill: var(--text-muted); }
  .qfig-gq19cw .qfig-gq19cw-m { fill: var(--text-muted); }
  .qfig-gq19cw-cell { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-gq19cw-nl { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .qfig-gq19cw-brace { fill: none; stroke: var(--act-3); stroke-width: 2; }
</style>
