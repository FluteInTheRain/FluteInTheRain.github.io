---
// Quiz figure (ai-trading-sequence-models set 05): what is left of day 1 after t steps for a factor of 0.9 and 0.97.
const steps = [10, 20, 50, 100];
const X0 = 70;
const BW = 120;
const bar = (v: number) => v * 200;
---
<div class="qfig-p15d">
  <svg viewBox="0 0 580 270" role="img" aria-label="Bars of the share of day 1 left: after 10 steps 35 percent for factor 0.9 and 74 percent for 0.97; after 20 steps 12 and 54; after 50 steps 0.5 and 22; after 100 steps 0.003 and 5 percent.">
    <text x="0" y="20" class="qfig-p15d-h"><tspan data-lang-en>What is left of day 1 after t steps</tspan><tspan data-lang-vi>Còn lại bao nhiêu của ngày 1 sau t bước</tspan></text>
    {steps.map((t, i) => (
      <g>
        <rect x={X0 + i * 125} y={220 - bar(Math.pow(0.9, t))} width="48" height={Math.max(bar(Math.pow(0.9, t)), 1.5)} class="qfig-p15d-a" />
        <rect x={X0 + i * 125 + 52} y={220 - bar(Math.pow(0.97, t))} width="48" height={bar(Math.pow(0.97, t))} class="qfig-p15d-f" />
        <text x={X0 + i * 125 + 50} y="242" text-anchor="middle" class="qfig-p15d-x"><tspan data-lang-en>{`${t} steps`}</tspan><tspan data-lang-vi>{`${t} bước`}</tspan></text>
        <text x={X0 + i * 125 + 24} y={212 - bar(Math.pow(0.9, t))} text-anchor="middle" class="qfig-p15d-v">{`${(Math.pow(0.9, t) * 100).toFixed(Math.pow(0.9, t) * 100 < 0.1 ? 3 : Math.pow(0.9, t) * 100 < 1 ? 1 : 0)}%`}</text>
        <text x={X0 + i * 125 + 76} y={212 - bar(Math.pow(0.97, t))} text-anchor="middle" class="qfig-p15d-v">{`${(Math.pow(0.97, t) * 100).toFixed(0)}%`}</text>
      </g>
    ))}
    <line x1="60" y1="220" x2="560" y2="220" class="qfig-p15d-axis" />
    <rect x="70" y="256" width="10" height="10" class="qfig-p15d-a" />
    <text x="86" y="266" class="qfig-p15d-s"><tspan data-lang-en>factor 0.9 per step</tspan><tspan data-lang-vi>hệ số 0,9 mỗi bước</tspan></text>
    <rect x="260" y="256" width="10" height="10" class="qfig-p15d-f" />
    <text x="276" y="266" class="qfig-p15d-s"><tspan data-lang-en>forget gate 0.97</tspan><tspan data-lang-vi>cổng quên 0,97</tspan></text>
  </svg>
</div>

<style>
  .qfig-p15d { margin: 0; width: 100%; }
  .qfig-p15d svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-p15d text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-p15d .qfig-p15d-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-p15d .qfig-p15d-v { font-size: 12px; fill: var(--text); font-weight: 700; }
  .qfig-p15d .qfig-p15d-x, .qfig-p15d .qfig-p15d-s { fill: var(--text-muted); }
  .qfig-p15d-a { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; }
  .qfig-p15d-f { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.3; }
  .qfig-p15d-axis { stroke: var(--text-muted); stroke-width: 1.2; }
</style>
