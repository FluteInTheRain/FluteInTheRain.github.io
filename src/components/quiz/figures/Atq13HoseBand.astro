---
// Set 05: HOSE price band and tick table for a stock with reference price 25,000 dong (HOSE guide, Feb 2026, sections 5-7).
const W = 580;
const H = 330;
const rows = [
  { en: 'below 10,000', vi: 'dưới 10.000', t: '10' },
  { en: '10,000 to 49,950', vi: '10.000 tới 49.950', t: '50' },
  { en: '50,000 and above', vi: '50.000 trở lên', t: '100' },
];
---
<div class="qs13h">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <text x="12" y="24" class="h">
      <tspan data-lang-en>A normal session, reference price 25,000 dong</tspan>
      <tspan data-lang-vi>Một phiên thông thường, giá tham chiếu 25.000 đồng</tspan>
    </text>
    <line x1="60" x2="520" y1="80" y2="80" class="axis" />
    <line x1="60" x2="60" y1="70" y2="90" class="axis" />
    <line x1="290" x2="290" y1="66" y2="94" class="axis" />
    <line x1="520" x2="520" y1="70" y2="90" class="axis" />
    <text x="60" y="58" text-anchor="middle" class="s">
      <tspan data-lang-en>floor</tspan>
      <tspan data-lang-vi>giá sàn</tspan>
    </text>
    <text x="290" y="54" text-anchor="middle" class="s">
      <tspan data-lang-en>reference</tspan>
      <tspan data-lang-vi>tham chiếu</tspan>
    </text>
    <text x="520" y="58" text-anchor="middle" class="s">
      <tspan data-lang-en>ceiling</tspan>
      <tspan data-lang-vi>giá trần</tspan>
    </text>
    <text x="290" y="116" text-anchor="middle" class="l">25,000</text>
    <text x="60" y="116" text-anchor="middle" class="l">? </text>
    <text x="520" y="116" text-anchor="middle" class="l">? </text>
    <text x="290" y="142" text-anchor="middle" class="s">
      <tspan data-lang-en>band: ±7% of the reference price</tspan>
      <tspan data-lang-vi>biên độ: ±7% giá tham chiếu</tspan>
    </text>

    <text x="12" y="190" class="h">
      <tspan data-lang-en>Tick size (price step)</tspan>
      <tspan data-lang-vi>Bước giá</tspan>
    </text>
    {rows.map((r, i) => (
      <g>
        <rect x="12" y={202 + i * 36} width="556" height="30" rx="6" class="row" />
        <text x="26" y={222 + i * 36} class="l">
          <tspan data-lang-en>price {r.en}</tspan>
          <tspan data-lang-vi>giá {r.vi}</tspan>
        </text>
        <text x="556" y={222 + i * 36} text-anchor="end" class="l">
          <tspan data-lang-en>{r.t} dong</tspan>
          <tspan data-lang-vi>{r.t} đồng</tspan>
        </text>
      </g>
    ))}
  </svg>
</div>
<style>
  .qs13h { margin: 0; width: 100%; }
  .qs13h svg { display: block; width: 100%; height: auto; }
  .qs13h .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qs13h .s { font-size: 12.5px; fill: var(--text-muted); }
  .qs13h .l { font-size: 14px; font-weight: 700; fill: var(--text); font-variant-numeric: tabular-nums; }
  .qs13h .axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .qs13h .row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
</style>
