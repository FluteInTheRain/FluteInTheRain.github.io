---
// Say a model's training text ends in mid-2024; a backtest on 2022-2023 sits inside it, a test from mid-2024 sits after it.
const L = 40, R = 560, y0 = 2020, y1 = 2026;
const X = (y: number) => L + ((y - y0) / (y1 - y0)) * (R - L);
const cut = 2024.5;
---
<div class="qfig-atq22o">
  <svg viewBox="0 0 580 210" role="img" aria-label="Timeline 2020 to 2026. Training text runs to mid-2024. A backtest on 2022 to 2023 lies inside it. A test from mid-2024 lies after the cutoff.">
    <text x="20" y="18" class="h"><tspan data-lang-en>Training text against test dates</tspan><tspan data-lang-vi>Văn bản huấn luyện so với ngày kiểm tra</tspan></text>
    <rect x={X(2020)} y="40" width={X(cut) - X(2020)} height="26" rx="3" class="bar" />
    <text x={X(2020) + 8} y="57" class="in"><tspan data-lang-en>training text</tspan><tspan data-lang-vi>văn bản huấn luyện</tspan></text>
    <rect x={X(2022)} y="84" width={X(2024) - X(2022)} height="26" rx="3" class="bar bad" />
    <text x={X(2022) + 8} y="101" class="in2"><tspan data-lang-en>backtest 2022-2023</tspan><tspan data-lang-vi>backtest 2022-2023</tspan></text>
    <rect x={X(cut)} y="128" width={X(2026) - X(cut)} height="26" rx="3" class="bar ok" />
    <text x={X(cut) - 8} y="146" text-anchor="end" class="s"><tspan data-lang-en>test from mid-2024</tspan><tspan data-lang-vi>kiểm tra từ giữa 2024</tspan></text>
    <line x1={X(cut)} x2={X(cut)} y1="32" y2="164" class="cut" />
    {[2020, 2022, 2024, 2026].map((y) => (<text x={X(y)} y="186" text-anchor="middle" class="s">{y}</text>))}
  </svg>
</div>

<style>
  .qfig-atq22o svg { display: block; width: 100%; height: auto; max-width: 580px; margin: 0 auto; }
  .qfig-atq22o text { font-size: 12.5px; fill: var(--text-body); }
  .qfig-atq22o .h { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-atq22o .s { fill: var(--text-muted); }
  .qfig-atq22o .in { fill: var(--bg); font-weight: 700; }
  .qfig-atq22o .in2 { fill: var(--text); font-weight: 700; }
  .qfig-atq22o .bar { fill: var(--text-faint); }
  .qfig-atq22o .bar.bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .qfig-atq22o .bar.ok { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.4; }
  .qfig-atq22o .cut { stroke: var(--text); stroke-dasharray: 4 4; stroke-width: 1.4; }
</style>
