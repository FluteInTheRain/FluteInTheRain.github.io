---
// Quiz figure for Post 6 (depth and shadows): three cards, three shadow recipes, same size and fill.
const FILT = [
  { id: 'u06c-a', layers: [{ y: 10, b: 25, s: 0, o: 0.2 }] },
  { id: 'u06c-b', layers: [{ y: 10, b: 22, s: -6, o: 0.2 }, { y: 1, b: 3, s: 0, o: 0.32 }] },
  { id: 'u06c-c', layers: [{ y: 1, b: 2, s: 0, o: 0.32 }] },
];
const cards = [
  { x: 24, id: 'u06c-a', n: 'A', l1: '0 10px 25px', l2: 'rgb(0 0 0 / 0.20)', l3: '' },
  { x: 214, id: 'u06c-b', n: 'B', l1: '0 10px 22px -6px', l2: '+ 0 1px 3px', l3: 'rgb(0 0 0 / 0.20 + 0.32)' },
  { x: 404, id: 'u06c-c', n: 'C', l1: '0 1px 2px', l2: 'rgb(0 0 0 / 0.32)', l3: '' },
];
---
<div class="qfig-uxq06twopart">
  <svg viewBox="0 0 600 236" role="img" aria-label="Three identical white cards on an off-white page with different shadows. Card A has one wide shadow, 0 10px 25px at 20 percent black. Card B has a wide shadow with negative spread plus a tight 0 1px 3px shadow. Card C has only a tight 0 1px 2px shadow.">
    <defs>
      {FILT.map((d) => (
        <filter id={d.id} x="-35%" y="-35%" width="170%" height="210%" color-interpolation-filters="sRGB">
          {d.layers.map((l, k) => (
            <>
              {l.s ? <feMorphology in="SourceAlpha" operator="erode" radius={Math.abs(l.s)} result={`e${k}`} /> : null}
              <feGaussianBlur in={l.s ? `e${k}` : 'SourceAlpha'} stdDeviation={l.b / 2} result={`b${k}`} />
              <feOffset in={`b${k}`} dx="0" dy={l.y} result={`o${k}`} />
              <feFlood style={`flood-color: var(--band-bg); flood-opacity: ${l.o}`} result={`f${k}`} />
              <feComposite in={`f${k}`} in2={`o${k}`} operator="in" result={`s${k}`} />
            </>
          ))}
          <feMerge>
            {d.layers.map((_, k) => <feMergeNode in={`s${k}`} />)}
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      ))}
    </defs>
    <rect x="8" y="8" width="584" height="220" rx="10" class="page" />
    {cards.map((c) => (
      <>
        <rect x={c.x + 12} y="34" width="152" height="108" rx="9" class="card" filter={`url(#${c.id})`} />
        <text x={c.x + 28} y="62" class="h">{c.n}</text>
        <line x1={c.x + 28} y1="84" x2={c.x + 120} y2="84" class="bar" />
        <line x1={c.x + 28} y1="102" x2={c.x + 90} y2="102" class="bar" />
        <text x={c.x + 12} y="178" class="m">{c.l1}</text>
        <text x={c.x + 12} y="196" class="m">{c.l2}</text>
        {c.l3 ? <text x={c.x + 12} y="214" class="m">{c.l3}</text> : null}
      </>
    ))}
  </svg>
</div>

<style>
  .qfig-uxq06twopart { margin: 0; width: 100%; }
  .qfig-uxq06twopart svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq06twopart text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq06twopart .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-uxq06twopart .m { fill: var(--text-muted); font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11.5px; }
  .qfig-uxq06twopart .page { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq06twopart .card { fill: var(--card-bg); stroke: var(--border); stroke-width: 0.8; }
  .qfig-uxq06twopart .bar { stroke: var(--border); stroke-width: 5; stroke-linecap: round; }
</style>
