---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 07: the limit-up queue. Illustrative: reference 24,500 -> HOSE ceiling 26,200;
// 40,000 shares queued ahead of your 500-share buy; sellers served in arrival order.
const W = 580;
const H = 430;
const qAhead = 40000;
const qYou = 500;
const barX = 30;
const barY = 176;
const barH = 40;
const barW = 470;
const wAhead = (qAhead / (qAhead + qYou)) * barW;
const wYou = barW - wAhead;
const aheadSegs = [12000, 15000, 13000];
---
<div class="qlq">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <DiagramIcon name="hourglass" x={18} y={16} size={22} />
    <text x="40" y="21" class="qlq-h">
      <tspan data-lang-en>Pinned at the ceiling: 26,200 today</tspan>
      <tspan data-lang-vi>Đứng trần: 26.200 hôm nay</tspan>
    </text>

    <line x1="30" x2="550" y1="72" y2="72" class="qlq-edge" />
    <text x="30" y="62" class="qlq-edge-t">
      <tspan data-lang-en>ceiling 26,200 — nothing can print above it</tspan>
      <tspan data-lang-vi>giá trần 26.200 — không lệnh nào khớp trên mức này</tspan>
    </text>

    <text x="30" y="120" class="qlq-strong">
      <tspan data-lang-en>Buy orders waiting at 26,200, in arrival order</tspan>
      <tspan data-lang-vi>Các lệnh mua chờ ở 26.200, theo thứ tự đến</tspan>
    </text>
    <g>
      {aheadSegs.map((s, i) => {
        const x = barX + aheadSegs.slice(0, i).reduce((a, b) => a + (b / (qAhead + qYou)) * barW, 0);
        const w = (s / (qAhead + qYou)) * barW;
        return <rect x={x} y={barY} width={w - 2} height={barH} rx="4" class="qlq-seg" />;
      })}
      <rect x={barX + wAhead + 2} y={barY} width={wYou - 2} height={barH} rx="4" class="qlq-you" />
      <text x={barX + 10} y={barY + 26} class="qlq-inbar">
        <tspan data-lang-en>40,000 shares queued before you…</tspan>
        <tspan data-lang-vi>40.000 cp xếp trước lệnh của bạn…</tspan>
      </text>
      <text x={barX + wAhead - 10} y={barY + 62} text-anchor="end" class="qlq-you-t">
        <tspan data-lang-en>your 500, last in line</tspan>
        <tspan data-lang-vi>500 cp của bạn, cuối hàng</tspan>
      </text>
    </g>

    <g class="qlq-arrow">
      <path d="M 470 128 L 470 164" />
      <polygon points="470,172 465,162 475,162" />
    </g>
    <text x="486" y="150" class="qlq-note">
      <tspan data-lang-en>sellers arrive…</tspan>
      <tspan data-lang-vi>lệnh bán đến…</tspan>
    </text>
    <text x="30" y="252" class="qlq-note">
      <tspan data-lang-en>Sellers who are willing to trade at 26,200 get filled first, in arrival order —</tspan>
      <tspan data-lang-vi>Ai chịu bán ở 26.200 sẽ được khớp trước, theo thứ tự đến —</tspan>
    </text>
    <text x="30" y="272" class="qlq-note">
      <tspan data-lang-en>if nobody sells, the queue only grows and your order sits.</tspan>
      <tspan data-lang-vi>nếu không ai bán, hàng đợi chỉ phình ra còn lệnh của bạn nằm im.</tspan>
    </text>

    <line x1="30" x2="550" y1="330" y2="330" class="qlq-rule" />
    <text x="30" y="356" class="qlq-tick">
      <tspan data-lang-en>Reference for today: 24,500 (yesterday's close). Floor, far below: 22,800.</tspan>
      <tspan data-lang-vi>Tham chiếu hôm nay: 24.500 (đóng cửa hôm trước). Giá sàn, xa phía dưới: 22.800.</tspan>
    </text>
    <text x="30" y="382" class="qlq-tick">
      <tspan data-lang-en>Liquidity at the ceiling: you can only trade while someone is willing to sell.</tspan>
      <tspan data-lang-vi>Thanh khoản tại giá trần: chỉ giao dịch được khi còn người chịu bán.</tspan>
    </text>
    <text x="30" y="408" class="qlq-tick">
      <tspan data-lang-en>Numbers are illustrative.</tspan>
      <tspan data-lang-vi>Các con số chỉ mang tính minh hoạ.</tspan>
    </text>
  </svg>
</div>

<style>
  .qlq {
    margin: 0;
    width: 100%;
  }
  .qlq svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qlq text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qlq .qlq-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qlq .qlq-edge {
    stroke: var(--act-0);
    stroke-width: 2;
  }
  .qlq .qlq-edge-t {
    font-size: 13px;
    font-weight: 700;
    fill: var(--act-0);
  }
  .qlq .qlq-strong {
    font-size: 14px;
    font-weight: 600;
    fill: var(--text);
  }
  .qlq .qlq-seg {
    fill: var(--gold);
    opacity: 0.45;
    stroke: var(--gold);
    stroke-width: 1;
  }
  .qlq .qlq-you {
    fill: var(--act-2);
    opacity: 0.5;
    stroke: var(--act-2);
    stroke-width: 1;
  }
  .qlq .qlq-inbar {
    font-size: 13px;
    font-weight: 700;
    fill: var(--text);
  }
  .qlq .qlq-you-t {
    font-size: 12.5px;
    font-weight: 700;
    fill: var(--act-2);
  }
  .qlq .qlq-note {
    font-size: 13px;
  }
  .qlq .qlq-tick {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qlq .qlq-arrow path {
    fill: none;
    stroke: var(--act-0);
    stroke-width: 1.5;
  }
  .qlq .qlq-arrow polygon {
    fill: var(--act-0);
  }
  .qlq .qlq-rule {
    stroke: var(--border);
    stroke-width: 1.2;
  }
</style>
