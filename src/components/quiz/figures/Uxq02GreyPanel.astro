---
// Quiz figure for Post 2: three blue panels with the same white headline and three ways to quiet the sub-line.
// The panel colours are the subject of the question, so they are real colours and do not follow the site theme.
const stripes = [14, 36, 58, 80, 102, 124, 146];
const subs = [
  { fill: '#9aa0a6', op: 1 },
  { fill: '#ffffff', op: 0.55 },
  { fill: '#c3d4f7', op: 1 },
];
const xs = [8, 208, 408];
---
<div class="qfig-uxq02greypanel">
  <svg viewBox="0 0 600 150" role="img" aria-label="Three blue panels 2754b8 with faint vertical stripes, each with the white headline Payment received. The sub-line is grey 9aa0a6 on panel 1, white at 55 percent opacity on panel 2, and light blue c3d4f7 on panel 3.">
    {xs.map((x, i) => (
      <g>
        <rect x={x} y="6" width="184" height="96" rx="9" style="fill:#2754b8" />
        {stripes.map((s) => (<rect x={x + s} y="6" width="8" height="96" style="fill:#3563c6" />))}
        <text x={x + 14} y="42" class="head"><tspan data-lang-en>Payment received</tspan><tspan data-lang-vi>Đã nhận thanh toán</tspan></text>
        <text x={x + 14} y="68" class="sub" style={`fill:${subs[i].fill};opacity:${subs[i].op}`}>Invoice #2087 · 14 Nov</text>
        <text x={x + 14} y="88" class="sub" style={`fill:${subs[i].fill};opacity:${subs[i].op}`}><tspan data-lang-en>Paid by card ending 4421</tspan><tspan data-lang-vi>Trả bằng thẻ đuôi 4421</tspan></text>
        <text x={x + 92} y="134" text-anchor="middle" class="num">{i + 1}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-uxq02greypanel { margin: 0; width: 100%; }
  .qfig-uxq02greypanel svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq02greypanel .head { font-size: 15px; font-weight: 700; fill: #ffffff; }
  .qfig-uxq02greypanel .sub { font-size: 13px; font-variant-numeric: tabular-nums; }
  .qfig-uxq02greypanel .num { font-size: 16px; font-weight: 700; fill: var(--text); }
</style>
