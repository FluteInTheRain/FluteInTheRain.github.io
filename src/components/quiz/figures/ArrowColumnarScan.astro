---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for batch processing set 06: 200 GB Parquet layout across 5 row groups and
// 30 columns (80% pruned, 3 columns selected) plus Pandas/Pickle vs Daft/Ray Data + Arrow paths.
// Never prints computed scan byte counts or zero-copy definitions.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.

const W = 580;
const H = 396;

function arrowR(x1: number, x2: number, y: number) {
  return {
    line: `M ${x1} ${y} L ${x2 - 8} ${y}`,
    head: `${x2},${y} ${x2 - 9},${y - 4.5} ${x2 - 9},${y + 4.5}`,
  };
}

const aTop1 = arrowR(164, 200, 282);
const aTop2 = arrowR(396, 432, 282);
const aBot1 = arrowR(164, 200, 350);
const aBot2 = arrowR(396, 432, 350);

const cols = [
  { x: 152, w: 44, label: 'c1' },
  { x: 200, w: 44, label: 'c2' },
  { x: 248, w: 44, label: 'c3' },
];
const prunedY = [82, 104, 126, 148];
---
<div class="qfig-acs">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: a 200 GB Parquet dataset divided into 5 row groups and 30 columns, where 80 percent of row groups are pruned and 3 columns are projected. Bottom: Pandas with iterrows and Pickle or JSON compared with Daft or Ray Data sending Arrow batches to PyTorch.">
    <text x="0" y="22" class="qfig-acs-h">
      <tspan data-lang-en>200 GB Parquet layout and worker data paths</tspan>
      <tspan data-lang-vi>Cấu trúc Parquet 200 GB và hai luồng worker</tspan>
    </text>

    <!-- Section 1: Parquet grid -->
    <text x="0" y="50" class="qfig-acs-sub">
      <tspan data-lang-en>1. Parquet files: 5 row groups × 30 equal-width columns</tspan>
      <tspan data-lang-vi>1. File Parquet: 5 row group × 30 cột rộng bằng nhau</tspan>
    </text>

    {cols.map((c) => (
      <text x={c.x + c.w / 2} y="74" text-anchor="middle" class="qfig-acs-t">{c.label}</text>
    ))}
    <text x="439" y="74" text-anchor="middle" class="qfig-acs-m">
      <tspan data-lang-en>27 other columns</tspan>
      <tspan data-lang-vi>27 cột khác</tspan>
    </text>

    <text x="0" y="118" class="qfig-acs-t">RG 1–4 (80%)</text>
    <text x="0" y="137" class="qfig-acs-m">
      <tspan data-lang-en>pruned by min/max</tspan>
      <tspan data-lang-vi>loại theo min/max</tspan>
    </text>

    {prunedY.map((ry) => (
      <g>
        {cols.map((c) => (
          <rect x={c.x} y={ry} width={c.w} height="18" rx="3" class="qfig-acs-pruned" />
        ))}
        <rect x="298" y={ry} width="282" height="18" rx="3" class="qfig-acs-pruned" />
      </g>
    ))}

    <text x="0" y="185" class="qfig-acs-goldt">RG 5 (20%)</text>
    <text x="0" y="201" class="qfig-acs-m">
      <tspan data-lang-en>matches WHERE</tspan>
      <tspan data-lang-vi>khớp WHERE</tspan>
    </text>
    {cols.map((c) => (
      <rect x={c.x} y="174" width={c.w} height="24" rx="4" class="qfig-acs-kept" />
    ))}
    <rect x="298" y="174" width="282" height="24" rx="4" class="qfig-acs-skipcol" />

    <!-- Divider -->
    <line x1="0" x2={W} y1="214" y2="214" class="qfig-acs-rule" />

    <!-- Section 2: Worker paths -->
    <text x="0" y="238" class="qfig-acs-sub">
      <tspan data-lang-en>2. Passing features from readers to PyTorch workers</tspan>
      <tspan data-lang-vi>2. Đẩy dữ liệu từ bước đọc sang worker PyTorch</tspan>
    </text>

    <!-- Path A: Pandas + Pickle -->
    <rect x="0" y="256" width="164" height="52" rx="6" class="qfig-acs-box" />
    <DiagramIcon name="file" x={22} y={282} size={20} />
    <text x="38" y="277" class="qfig-acs-t">Pandas (1 node)</text>
    <text x="38" y="296" class="qfig-acs-m">.iterrows()</text>

    <path d={aTop1.line} class="qfig-acs-redline" />
    <polygon points={aTop1.head} class="qfig-acs-redhead" />

    <rect x="202" y="256" width="194" height="52" rx="6" class="qfig-acs-hotbox" />
    <DiagramIcon name="warning" x={222} y={282} size={20} />
    <text x="240" y="277" class="qfig-acs-t">Pickle / JSON</text>
    <text x="240" y="296" class="qfig-acs-m">
      <tspan data-lang-en>row serialization</tspan>
      <tspan data-lang-vi>tuần tự hoá từng dòng</tspan>
    </text>

    <path d={aTop2.line} class="qfig-acs-redline" />
    <polygon points={aTop2.head} class="qfig-acs-redhead" />

    <rect x="434" y="256" width="146" height="52" rx="6" class="qfig-acs-box" />
    <DiagramIcon name="model" x={454} y={282} size={20} />
    <text x="472" y="277" class="qfig-acs-t">PyTorch</text>
    <text x="472" y="296" class="qfig-acs-m">
      <tspan data-lang-en>workers</tspan>
      <tspan data-lang-vi>worker</tspan>
    </text>

    <!-- Path B: Daft / Ray Data + Arrow -->
    <rect x="0" y="324" width="164" height="52" rx="6" class="qfig-acs-box" />
    <DiagramIcon name="worker" x={22} y={350} size={20} />
    <text x="38" y="345" class="qfig-acs-t">Daft / Ray Data</text>
    <text x="38" y="364" class="qfig-acs-m">Rust &amp; Ray</text>

    <path d={aBot1.line} class="qfig-acs-goldline" />
    <polygon points={aBot1.head} class="qfig-acs-goldhead" />

    <rect x="202" y="324" width="194" height="52" rx="6" class="qfig-acs-goldbox" />
    <DiagramIcon name="parallel" x={222} y={350} size={20} />
    <text x="240" y="345" class="qfig-acs-t">Apache Arrow</text>
    <text x="240" y="364" class="qfig-acs-m">
      <tspan data-lang-en>columnar batches</tspan>
      <tspan data-lang-vi>lô theo cột</tspan>
    </text>

    <path d={aBot2.line} class="qfig-acs-goldline" />
    <polygon points={aBot2.head} class="qfig-acs-goldhead" />

    <rect x="434" y="324" width="146" height="52" rx="6" class="qfig-acs-box" />
    <DiagramIcon name="model" x={454} y={350} size={20} />
    <text x="472" y="345" class="qfig-acs-t">PyTorch</text>
    <text x="472" y="364" class="qfig-acs-m">
      <tspan data-lang-en>tensor batches</tspan>
      <tspan data-lang-vi>lô tensor</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-acs { margin: 0; width: 100%; }
  .qfig-acs svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-acs text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-acs .qfig-acs-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-acs .qfig-acs-sub { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .qfig-acs .qfig-acs-t { font-weight: 600; fill: var(--text); }
  .qfig-acs .qfig-acs-goldt { font-weight: 700; fill: var(--gold-icon); }
  .qfig-acs .qfig-acs-m { fill: var(--text-muted); }
  .qfig-acs-pruned { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; stroke-dasharray: 4 3; }
  .qfig-acs-skipcol { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-acs-kept { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .qfig-acs-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-acs-hotbox { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .qfig-acs-goldbox { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-acs-redline { stroke: var(--red); stroke-width: 2.2; fill: none; }
  .qfig-acs-redhead { fill: var(--red); }
  .qfig-acs-goldline { stroke: var(--gold); stroke-width: 2; fill: none; }
  .qfig-acs-goldhead { fill: var(--gold); }
  .qfig-acs-rule { stroke: var(--border); stroke-width: 1; }
</style>
