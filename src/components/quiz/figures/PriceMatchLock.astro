---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for ethics set 06: two petrol stations, each priced by a rule that reads the rival's price
// every 5 minutes. The owners never talk to each other. Shows only the setup, not what the rules produce.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
function left(x: number, y: number) {
  return `${x},${y} ${x + 10},${y - 5} ${x + 10},${y + 5}`;
}
function right(x: number, y: number) {
  return `${x},${y} ${x - 10},${y - 5} ${x - 10},${y + 5}`;
}
---
<div class="qfig-pml">
  <svg viewBox="0 0 580 300" role="img" aria-label="Two petrol stations across one road. Each has a repricing rule that reads the other station's price every 5 minutes. The two owners never contact each other.">
    <text x="0" y="22" class="qfig-pml-h">
      <tspan data-lang-en>Two stations, two rules, no owner contact</tspan>
      <tspan data-lang-vi>Hai trạm, hai quy tắc, chủ không liên lạc</tspan>
    </text>

    <!-- station A -->
    <rect x="6" y="44" width="210" height="130" rx="10" class="qfig-pml-card" />
    <DiagramIcon name="model" x="20" y="58" size={30} />
    <text x="60" y="78" class="qfig-pml-lane">
      <tspan data-lang-en>Station A rule</tspan>
      <tspan data-lang-vi>Quy tắc trạm A</tspan>
    </text>
    <text x="20" y="112" class="qfig-pml-t">
      <tspan data-lang-en>Matches any rise</tspan>
      <tspan data-lang-vi>Theo mọi đợt tăng</tspan>
    </text>
    <text x="20" y="134" class="qfig-pml-t">
      <tspan data-lang-en>Undercuts nothing</tspan>
      <tspan data-lang-vi>Không bán rẻ hơn</tspan>
    </text>
    <text x="20" y="160" class="qfig-pml-m">
      <tspan data-lang-en>10 cents per litre margin</tspan>
      <tspan data-lang-vi>Lãi 10 cent mỗi lít</tspan>
    </text>

    <!-- station B -->
    <rect x="364" y="44" width="210" height="130" rx="10" class="qfig-pml-card" />
    <DiagramIcon name="model" x="378" y="58" size={30} />
    <text x="418" y="78" class="qfig-pml-lane">
      <tspan data-lang-en>Station B rule</tspan>
      <tspan data-lang-vi>Quy tắc trạm B</tspan>
    </text>
    <text x="378" y="112" class="qfig-pml-t">
      <tspan data-lang-en>A similar rule</tspan>
      <tspan data-lang-vi>Một quy tắc tương tự</tspan>
    </text>
    <text x="378" y="160" class="qfig-pml-m">
      <tspan data-lang-en>10 cents per litre margin</tspan>
      <tspan data-lang-vi>Lãi 10 cent mỗi lít</tspan>
    </text>

    <!-- price reads -->
    <line x1="228" x2="352" y1="84" y2="84" class="qfig-pml-flow" />
    <polygon points={left(218, 84)} class="qfig-pml-head" />
    <text x="290" y="72" text-anchor="middle" class="qfig-pml-m">
      <tspan data-lang-en>A reads B's price</tspan>
      <tspan data-lang-vi>A đọc giá của B</tspan>
    </text>
    <line x1="228" x2="352" y1="140" y2="140" class="qfig-pml-flow" />
    <polygon points={right(362, 140)} class="qfig-pml-head" />
    <text x="290" y="162" text-anchor="middle" class="qfig-pml-m">
      <tspan data-lang-en>B reads A's price</tspan>
      <tspan data-lang-vi>B đọc giá của A</tspan>
    </text>
    <text x="290" y="112" text-anchor="middle" class="qfig-pml-t">
      <tspan data-lang-en>every 5 min</tspan>
      <tspan data-lang-vi>mỗi 5 phút</tspan>
    </text>

    <!-- owners -->
    <line x1="111" x2="111" y1="174" y2="214" class="qfig-pml-rule" />
    <line x1="469" x2="469" y1="174" y2="214" class="qfig-pml-rule" />
    <DiagramIcon name="user" x="96" y="216" size={30} />
    <DiagramIcon name="user" x="454" y="216" size={30} />
    <text x="111" y="268" text-anchor="middle" class="qfig-pml-lane">
      <tspan data-lang-en>Owner A</tspan>
      <tspan data-lang-vi>Chủ trạm A</tspan>
    </text>
    <text x="469" y="268" text-anchor="middle" class="qfig-pml-lane">
      <tspan data-lang-en>Owner B</tspan>
      <tspan data-lang-vi>Chủ trạm B</tspan>
    </text>
    <line x1="146" x2="434" y1="231" y2="231" class="qfig-pml-none" />
    <text x="290" y="222" text-anchor="middle" class="qfig-pml-m">
      <tspan data-lang-en>no call, no message</tspan>
      <tspan data-lang-vi>không gọi, không nhắn</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-pml { margin: 0; width: 100%; }
  .qfig-pml svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-pml text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-pml .qfig-pml-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-pml .qfig-pml-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-pml .qfig-pml-t { font-weight: 600; fill: var(--text); }
  .qfig-pml .qfig-pml-m { fill: var(--text-muted); }
  .qfig-pml-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-pml-flow { stroke: var(--gold); stroke-width: 2.4; }
  .qfig-pml-head { fill: var(--gold); }
  .qfig-pml-rule { stroke: var(--border); stroke-width: 1.5; }
  .qfig-pml-none { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
</style>
