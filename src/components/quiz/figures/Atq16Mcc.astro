---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 07: Briola, Bartolucci & Aste (2025), section 7.1, average MCC by tick group and horizon.
const hs = ['H10', 'H50', 'H100'];
const g = [
  { cls: 'bid', v: [0.29, 0.36, 0.26], en: 'large tick', vi: 'bước lớn' },
  { cls: 'mid', v: [0.13, 0.085, 0.036], en: 'medium', vi: 'bước vừa' },
  { cls: 'ask', v: [0.11, 0.04, 0.01], en: 'small', vi: 'bước nhỏ' },
];
const BASE = 232, SC = 440;
---
<div class="q16">
  <svg viewBox="0 0 580 290" role="img" aria-hidden="true">
    <DiagramIcon name="model" x={22} y={20} size={22} />
    <text x="44" y="25" class="t-h"><tspan data-lang-en>Average MCC by tick group</tspan><tspan data-lang-vi>MCC trung bình theo nhóm bước giá</tspan></text>
    {g.map((x, i) => (
      <g>
        <rect x={300 + i * 92} y="12" width="12" height="12" rx="2" class={x.cls} />
        <text x={316 + i * 92} y="23" class="t-s"><tspan data-lang-en>{x.en}</tspan><tspan data-lang-vi>{x.vi}</tspan></text>
      </g>
    ))}
    <line x1="50" x2="560" y1={BASE} y2={BASE} class="axis" />
    {[0.1, 0.2, 0.3].map((t) => (
      <g>
        <line x1="50" x2="560" y1={BASE - t * SC} y2={BASE - t * SC} class="grid" />
        <text x="44" y={BASE - t * SC + 4} text-anchor="end" class="t-s"><tspan data-lang-en>{t.toFixed(1)}</tspan><tspan data-lang-vi>{t.toFixed(1).replace('.', ',')}</tspan></text>
      </g>
    ))}
    {hs.map((h, hi) => (
      <g>
        <text x={110 + hi * 170} y={BASE + 22} text-anchor="middle" class="t-b">{h}</text>
        {g.map((x, gi) => (
          <g>
            <rect x={64 + hi * 170 + gi * 38} y={BASE - x.v[hi] * SC} width="32" height={x.v[hi] * SC} rx="2" class={x.cls} />
            <text x={80 + hi * 170 + gi * 38} y={BASE - x.v[hi] * SC - 5} text-anchor="middle" class="t-s"><tspan data-lang-en>{String(x.v[hi])}</tspan><tspan data-lang-vi>{String(x.v[hi]).replace('.', ',')}</tspan></text>
          </g>
        ))}
      </g>
    ))}
    <text x="50" y="282" class="t-s"><tspan data-lang-en>H = number of book updates ahead. 0 means random guessing.</tspan><tspan data-lang-vi>H = số lần cập nhật sổ lệnh phía trước. 0 nghĩa là đoán bừa.</tspan></text>
  </svg>
</div>

<style>
  .q16 { margin: 0; width: 100%; }
  .q16 svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .q16 text { font-size: 13px; fill: var(--text-body); }
  .q16 .t-h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .q16 .t-s { font-size: 12px; fill: var(--text-muted); }
  .q16 .t-b { font-size: 13px; font-weight: 600; fill: var(--text); }
  .q16 .t-gold { font-weight: 700; fill: var(--gold-icon); }
  .q16 .ask { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; }
  .q16 .bid { fill: color-mix(in srgb, var(--act-2) 16%, var(--bg)); stroke: var(--act-2); stroke-width: 1.3; }
  .q16 .mid { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.3; }
  .q16 .empty { fill: none; stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .q16 .midline { stroke: var(--gold); stroke-width: 1.6; stroke-dasharray: 6 4; fill: none; }
  .q16 .axis { stroke: var(--border); stroke-width: 1.4; }
  .q16 .grid { stroke: var(--border); stroke-width: 1; stroke-dasharray: 3 4; }
  .q16 .path { stroke: var(--text); stroke-width: 2; fill: none; }
</style>
