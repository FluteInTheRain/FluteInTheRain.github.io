---
// Quiz figure for go-memory-data-types-slices-maps-strings: measured HeapAlloc (MiB, after two runtime.GC calls) of two maps.
// 300,000 inserts then 297,000 deletes (3,000 entries left); values are [128]byte inline or *[128]byte. Go 1.27.1, Apple M2.
// Neutral drawing: names the stages and the numbers only. Inline SVG, site tokens only.
const rows = [
  { y: 66, key: 'a', en: 'inline values: after 300,000 inserts', vi: 'giá trị inline: sau 300.000 lần chèn', v: 72.2 },
  { y: 118, key: 'a', en: 'inline values: after 297,000 deletes', vi: 'giá trị inline: sau 297.000 lần delete', v: 72.2 },
  { y: 170, key: 'a', en: 'inline values: copied into a new map', vi: 'giá trị inline: chép sang map mới', v: 0.7 },
  { y: 232, key: 'b', en: 'pointer values: after 300,000 inserts', vi: 'giá trị con trỏ: sau 300.000 lần chèn', v: 45.8 },
  { y: 284, key: 'b', en: 'pointer values: after 297,000 deletes', vi: 'giá trị con trỏ: sau 297.000 lần delete', v: 9.6 },
];
const scale = 4.6;
---
<div class="qfig-g11b">
  <svg viewBox="0 0 580 322" role="img" aria-label="Five horizontal bars of HeapAlloc in MiB: inline-value map after inserts 72.2, after deletes 72.2, copied into a new map 0.7; pointer-value map after inserts 45.8, after deletes 9.6.">
    <text x="0" y="22" class="qfig-g11b-h">
      <tspan data-lang-en>HeapAlloc in MiB after runtime.GC, 3,000 entries left</tspan>
      <tspan data-lang-vi>HeapAlloc (MiB) sau runtime.GC, còn 3.000 entry</tspan>
    </text>
    {rows.map((r) => (
      <g>
        <text x="0" y={r.y - 8} class="qfig-g11b-m">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <rect x="0" y={r.y} width="540" height="22" rx="4" class="qfig-g11b-track" />
        <rect x="0" y={r.y} width={Math.max(3, r.v * scale)} height="22" rx="4" class={r.key === 'a' ? 'qfig-g11b-a' : 'qfig-g11b-b'} />
        <text x={Math.max(3, r.v * scale) + 8} y={r.y + 16} class="qfig-g11b-t">{r.v.toFixed(1)}</text>
      </g>
    ))}
  </svg>
</div>
<style>
  .qfig-g11b { margin: 0; width: 100%; }
  .qfig-g11b svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-g11b text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-g11b .qfig-g11b-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-g11b .qfig-g11b-t { font-weight: 700; fill: var(--text); }
  .qfig-g11b .qfig-g11b-m { fill: var(--text-muted); font-size: 13px; }
  .qfig-g11b-track { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-g11b-a { fill: var(--gold); }
  .qfig-g11b-b { fill: var(--red); }
</style>
