---
// Quiz figure for the typography post: a 26px title next to a 13px date, two alignments.
---
<div class="qfig-uxq04baselinerows">
  <svg viewBox="0 0 600 190" role="img" aria-label="Two rows with the title Invoice #1042 at 26 pixels and the text Paid on Oct 14 at 13 pixels. In row P the small text floats near the middle of the title. In row Q it sits on the same baseline as the title.">
    <text x="20" y="22" class="h"><tspan data-lang-en>Row P</tspan><tspan data-lang-vi>Hàng P</tspan></text>
    <rect x="20" y="32" width="560" height="56" rx="8" class="card" />
    <line x1="30" y1="68" x2="570" y2="68" class="ln" />
    <text x="36" y="68" style="font-size:26px;font-weight:700" class="t">Invoice #1042</text>
    <text x="224" y="58" style="font-size:13px">Paid on Oct 14</text>
    <text x="20" y="116" class="h"><tspan data-lang-en>Row Q</tspan><tspan data-lang-vi>Hàng Q</tspan></text>
    <rect x="20" y="126" width="560" height="56" rx="8" class="card" />
    <line x1="30" y1="162" x2="570" y2="162" class="ln" />
    <text x="36" y="162" style="font-size:26px;font-weight:700" class="t">Invoice #1042</text>
    <text x="224" y="162" style="font-size:13px">Paid on Oct 14</text>
  </svg>
</div>

<style>
  .qfig-uxq04baselinerows { margin: 0; width: 100%; }
  .qfig-uxq04baselinerows svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq04baselinerows text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq04baselinerows .h { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qfig-uxq04baselinerows .m { fill: var(--text-muted); font-size: 12px; }
  .qfig-uxq04baselinerows .t { fill: var(--text); }
  .qfig-uxq04baselinerows .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq04baselinerows .ln { stroke: var(--text-muted); stroke-width: 1; stroke-dasharray: 4 3; fill: none; }
  .qfig-uxq04baselinerows .lna { stroke: var(--accent); stroke-width: 1.2; fill: none; }
  .qfig-uxq04baselinerows .tag { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
</style>
