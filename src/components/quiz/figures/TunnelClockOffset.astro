---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for stream set 06: two clock lanes. The phone clock shows the tap and the send, with the offline
// stretch between them in red; the server clock shows when the batch was received. Timestamps only, no derived values.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const x0 = 160; // left end of both axes (minute 0 of each axis)
const ppm = 62; // pixels per minute
const mx = (min: number) => x0 + min * ppm;
const eventX = mx(0 + 40 / 60); // phone axis starts 10:00
const sendX = mx(5 + 25 / 60); // phone axis: 10:05:25
const recvX = mx(5 + 25 / 60); // server axis starts 10:05, so 10:10:25 sits at 5 min 25 s
const phoneY = 105;
const srvY = 225;
const phoneTicks = ['10:00', '10:01', '10:02', '10:03', '10:04', '10:05', '10:06'];
const srvTicks = ['10:05', '10:06', '10:07', '10:08', '10:09', '10:10', '10:11'];
function head(x: number, y: number) {
  return `${x},${y} ${x - 4.5},${y - 9} ${x + 4.5},${y - 9}`;
}
---
<div class="qfig-tun">
  <svg viewBox="0 0 580 275" role="img" aria-label="Two clock lanes: the phone clock stamps the tap at 10:00:40 and the send at 10:05:25, with the stretch between them offline in a tunnel; the server clock stamps the batch as received at 10:10:25.">
    <text x="0" y="22" class="qfig-tun-h">
      <tspan data-lang-en>One tap, three stamps on two clocks</tspan>
      <tspan data-lang-vi>Một lần chạm, ba mốc giờ trên hai đồng hồ</tspan>
    </text>

    <!-- phone lane -->
    <DiagramIcon name="phone" x="10" y={phoneY - 36} size={26} />
    <text x="42" y={phoneY - 18} class="qfig-tun-lane">
      <tspan data-lang-en>Phone clock</tspan>
      <tspan data-lang-vi>Đồng hồ điện thoại</tspan>
    </text>

    <rect x={eventX} y={phoneY - 20} width={sendX - eventX} height="46" rx="6" class="qfig-tun-off" />
    <text x={(eventX + sendX) / 2} y={phoneY + 18} text-anchor="middle" class="qfig-tun-offt">
      <tspan data-lang-en>No signal: the tap waits on the phone</tspan>
      <tspan data-lang-vi>Mất sóng: lần chạm nằm chờ trong máy</tspan>
    </text>

    <line x1={x0} x2={mx(6)} y1={phoneY} y2={phoneY} class="qfig-tun-axis" />
    {phoneTicks.map((t, i) => (
      <g>
        <line x1={mx(i)} x2={mx(i)} y1={phoneY} y2={phoneY + 28} class="qfig-tun-tick" />
        <text x={mx(i)} y={phoneY + 46} text-anchor="middle" class="qfig-tun-m">{t}</text>
      </g>
    ))}
    <circle cx={eventX} cy={phoneY} r="6.5" class="qfig-tun-dot" />
    <circle cx={sendX} cy={phoneY} r="6.5" class="qfig-tun-dot" />
    <text x={eventX - 6} y={phoneY - 30} class="qfig-tun-t">
      <tspan data-lang-en>Tap, stamped 10:00:40</tspan>
      <tspan data-lang-vi>Chạm, ghi 10:00:40</tspan>
    </text>
    <text x={sendX + 24} y={phoneY - 30} text-anchor="end" class="qfig-tun-t">
      <tspan data-lang-en>Sent, stamped 10:05:25</tspan>
      <tspan data-lang-vi>Gửi, ghi 10:05:25</tspan>
    </text>

    <!-- hand-off to the server -->
    <line x1={sendX} x2={sendX} y1={phoneY + 8} y2={srvY - 18} class="qfig-tun-link" />
    <polygon points={head(sendX, srvY - 8)} class="qfig-tun-linkhead" />
    <text x={sendX - 10} y="183" text-anchor="end" class="qfig-tun-m">
      <tspan data-lang-en>upload takes almost no time</tspan>
      <tspan data-lang-vi>tải lên gần như không tốn thời gian</tspan>
    </text>

    <!-- server lane -->
    <DiagramIcon name="server" x="10" y={srvY - 36} size={26} />
    <text x="42" y={srvY - 18} class="qfig-tun-lane">
      <tspan data-lang-en>Server clock</tspan>
      <tspan data-lang-vi>Đồng hồ server</tspan>
    </text>
    <line x1={x0} x2={mx(6)} y1={srvY} y2={srvY} class="qfig-tun-axis" />
    {srvTicks.map((t, i) => (
      <g>
        <line x1={mx(i)} x2={mx(i)} y1={srvY} y2={srvY + 6} class="qfig-tun-tick" />
        <text x={mx(i)} y={srvY + 24} text-anchor="middle" class="qfig-tun-m">{t}</text>
      </g>
    ))}
    <circle cx={recvX} cy={srvY} r="6.5" class="qfig-tun-dot2" />
    <text x={recvX - 12} y={srvY - 12} text-anchor="end" class="qfig-tun-t">
      <tspan data-lang-en>Received, stamped 10:10:25</tspan>
      <tspan data-lang-vi>Nhận, ghi 10:10:25</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-tun { margin: 0; width: 100%; }
  .qfig-tun svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-tun text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-tun .qfig-tun-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-tun .qfig-tun-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-tun .qfig-tun-t { font-weight: 600; fill: var(--text); }
  .qfig-tun .qfig-tun-m { font-size: 13px; fill: var(--text-muted); }
  .qfig-tun .qfig-tun-offt { font-size: 13px; font-weight: 600; fill: var(--red); }
  .qfig-tun-off { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
  .qfig-tun-axis { stroke: var(--text-muted); stroke-width: 1.6; }
  .qfig-tun-tick { stroke: var(--border); stroke-width: 1; }
  .qfig-tun-dot { fill: var(--text); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-tun-dot2 { fill: var(--gold); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-tun-link { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .qfig-tun-linkhead { fill: var(--text-muted); }
</style>
