---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 05 (post 11): 60 clients, 5 slots, no limit. 55 clients wait (11 per row x 5 rows), 5 are inside a slot.
// Shows the situation only. Plain inline SVG, site tokens only, no markers/defs.
const rows = [0, 1, 2, 3, 4];
const cols = Array.from({ length: 11 }, (_, j) => j);
const rowY = (i: number) => 66 + i * 34;
---
<div class="bq11sq">
  <svg viewBox="0 0 580 270" role="img" aria-hidden="true">
    <DiagramIcon name="laptop" x={40} y={rowY(2)} size={30} />
    <text x="40" y={rowY(2) + 36} text-anchor="middle" class="sq-strong">
      <tspan data-lang-en>60 clients</tspan>
      <tspan data-lang-vi>60 client</tspan>
    </text>

    <text x="84" y="30" class="sq-note">
      <tspan data-lang-en>55 waiting for a free slot</tspan>
      <tspan data-lang-vi>55 đang chờ slot trống</tspan>
    </text>
    {rows.map((i) => cols.map((j) => <circle cx={92 + j * 22} cy={rowY(i)} r="7" class="sq-wait" />))}

    <polygon points="352,132 366,124 366,140" class="sq-head" />
    <line x1="338" x2="360" y1="132" y2="132" class="sq-line" />

    <text x="384" y="30" class="sq-strong">
      <tspan data-lang-en>5 slots, 100 ms per job</tspan>
      <tspan data-lang-vi>5 slot, 100 ms mỗi job</tspan>
    </text>
    {rows.map((i) => (
      <g>
        <rect x="384" y={rowY(i) - 14} width="170" height="28" rx="5" class="sq-slot" />
        <circle cx="402" cy={rowY(i)} r="7" class="sq-run" />
        <text x="420" y={rowY(i) + 5} class="sq-in">
          <tspan data-lang-en>job running</tspan>
          <tspan data-lang-vi>job đang chạy</tspan>
        </text>
      </g>
    ))}

    <text x="290" y="252" text-anchor="middle" class="sq-note">
      <tspan data-lang-en>No limit: every request waits for a free slot</tspan>
      <tspan data-lang-vi>Không có giới hạn: request nào cũng chờ một slot trống</tspan>
    </text>
  </svg>
</div>

<style>
  .bq11sq { margin: 0; width: 100%; }
  .bq11sq svg { display: block; width: 100%; min-width: 360px; height: auto; }
  .bq11sq text { font-size: 13px; fill: var(--text-body); }
  .bq11sq .sq-strong { font-weight: 700; fill: var(--text); font-size: 14px; }
  .bq11sq .sq-note { fill: var(--text-muted); }
  .bq11sq .sq-in { fill: var(--text); }
  .bq11sq .sq-wait { fill: var(--text-muted); opacity: 0.55; }
  .bq11sq .sq-slot { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .bq11sq .sq-run { fill: var(--gold); }
  .bq11sq .sq-line { stroke: var(--text-muted); stroke-width: 2; }
  .bq11sq .sq-head { fill: var(--text-muted); }
</style>
