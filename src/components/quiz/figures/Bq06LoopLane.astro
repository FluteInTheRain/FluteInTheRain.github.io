---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-async-concurrency-workers set 01: the one event loop thread as a single lane.
// Request 1 holds the lane with time.sleep(0.5) from 0 to 0.5 s; requests 2 and 3 arrive at 0.1 s and 0.2 s.
// It stops there: it does not draw when requests 2 and 3 run. Inline SVG, site tokens only.
const x0 = 40;
const px = 440; // pixels per second
const tx = (s: number) => x0 + s * px;
const laneY = 150;
const axisY = 238;
const ticks = [0, 0.25, 0.5, 0.75, 1];
function down(x: number, y: number) {
  return `${x},${y} ${x - 4.5},${y - 9} ${x + 4.5},${y - 9}`;
}
const arrivals = [
  { t: 0, y: 34, en: 'Request 1 arrives', vi: 'Request 1 tới' },
  { t: 0.1, y: 52, en: 'Request 2 arrives', vi: 'Request 2 tới' },
  { t: 0.2, y: 70, en: 'Request 3 arrives', vi: 'Request 3 tới' },
];
---
<div class="qfig-bqll">
  <svg viewBox="0 0 580 270" role="img" aria-label="A time axis from 0 to 1 second with one lane for the event loop thread. Request 1 holds the lane with time.sleep(0.5) from 0 to 0.5 seconds. Requests 2 and 3 arrive at 0.1 and 0.2 seconds.">
    {arrivals.map((a) => (
      <g>
        <line x1={tx(a.t)} x2={tx(a.t)} y1={a.y + 6} y2={laneY - 22} class="qfig-bqll-drop" />
        <polygon points={down(tx(a.t), laneY - 22)} class="qfig-bqll-head" />
        <text x={tx(a.t) + 8} y={a.y + 4} class="qfig-bqll-t">
          <tspan data-lang-en>{a.en}</tspan>
          <tspan data-lang-vi>{a.vi}</tspan>
        </text>
      </g>
    ))}

    <DiagramIcon name={'server' as any} x={40} y={laneY + 58} size={20} />
    <text x={58} y={laneY + 63} class="qfig-bqll-lane">
      <tspan data-lang-en>Event loop: one thread, one lane</tspan>
      <tspan data-lang-vi>Event loop: một thread, một làn</tspan>
    </text>

    <rect x={tx(0)} y={laneY - 20} width={tx(1) - tx(0)} height="40" rx="5" class="qfig-bqll-lane-bg" />
    <rect x={tx(0)} y={laneY - 20} width={tx(0.5) - tx(0)} height="40" rx="5" class="qfig-bqll-busy" />
    <text x={tx(0) + 10} y={laneY + 5} class="qfig-bqll-t">
      <tspan data-lang-en>Request 1: time.sleep(0.5)</tspan>
      <tspan data-lang-vi>Request 1: time.sleep(0.5)</tspan>
    </text>

    <line x1={tx(0)} x2={tx(1)} y1={axisY} y2={axisY} class="qfig-bqll-axis" />
    {ticks.map((s) => (
      <g>
        <line x1={tx(s)} x2={tx(s)} y1={axisY} y2={axisY + 5} class="qfig-bqll-axis" />
        <text x={tx(s)} y={axisY + 21} text-anchor="middle" class="qfig-bqll-m">{s}</text>
      </g>
    ))}
    <text x={tx(1) + 14} y={axisY + 21} class="qfig-bqll-m">
      <tspan data-lang-en>s</tspan>
      <tspan data-lang-vi>giây</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-bqll { margin: 0; width: 100%; }
  .qfig-bqll svg { display: block; width: 100%; min-width: 340px; height: auto; }
  .qfig-bqll text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bqll .qfig-bqll-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-bqll .qfig-bqll-t { font-weight: 600; fill: var(--text); }
  .qfig-bqll .qfig-bqll-m { fill: var(--text-muted); }
  .qfig-bqll-drop { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .qfig-bqll-head { fill: var(--text-muted); }
  .qfig-bqll-lane-bg { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-bqll-busy { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .qfig-bqll-axis { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
