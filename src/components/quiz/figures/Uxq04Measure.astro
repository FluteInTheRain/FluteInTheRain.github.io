---
// Quiz figure for the typography post: the same paragraph at three line lengths.
---
<div class="qfig-uxq04measure">
  <svg viewBox="0 0 600 230" role="img" aria-label="Three text blocks drawn as grey lines: 28 characters per line, 66 characters per line and 112 characters per line.">
    <line x1="20" y1="8" x2="20" y2="222" class="ln" />
    <rect x="20" y="24" width="112" height="6" rx="3" class="bar" />
    <rect x="20" y="37" width="112" height="6" rx="3" class="bar" />
    <rect x="20" y="50" width="112" height="6" rx="3" class="bar" />
    <rect x="20" y="63" width="67" height="6" rx="3" class="bar" />
    <text x="148" y="48" class="h"><tspan data-lang-en>Block P: 28 characters per line</tspan><tspan data-lang-vi>Khối P: 28 ký tự mỗi dòng</tspan></text>
    <rect x="20" y="94" width="264" height="6" rx="3" class="bar" />
    <rect x="20" y="107" width="264" height="6" rx="3" class="bar" />
    <rect x="20" y="120" width="264" height="6" rx="3" class="bar" />
    <rect x="20" y="133" width="158" height="6" rx="3" class="bar" />
    <text x="300" y="118" class="h"><tspan data-lang-en>Block Q: 66 chars</tspan><tspan data-lang-vi>Khối Q: 66 ký tự</tspan></text>
    <rect x="20" y="164" width="448" height="6" rx="3" class="bar" />
    <rect x="20" y="177" width="448" height="6" rx="3" class="bar" />
    <rect x="20" y="190" width="448" height="6" rx="3" class="bar" />
    <rect x="20" y="203" width="268" height="6" rx="3" class="bar" />
    <text x="484" y="188" class="h"><tspan data-lang-en>Block R: 112 chars</tspan><tspan data-lang-vi>Khối R: 112 ký tự</tspan></text>
  </svg>
</div>

<style>
  .qfig-uxq04measure { margin: 0; width: 100%; }
  .qfig-uxq04measure svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq04measure text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq04measure .h { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qfig-uxq04measure .m { fill: var(--text-muted); font-size: 12px; }
  .qfig-uxq04measure .t { fill: var(--text); }
  .qfig-uxq04measure .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq04measure .bar { fill: var(--text-muted); opacity: 0.55; }
  .qfig-uxq04measure .ln { stroke: var(--text-muted); stroke-width: 1; stroke-dasharray: 4 3; fill: none; }
  .qfig-uxq04measure .lna { stroke: var(--accent); stroke-width: 1.2; stroke-dasharray: 4 3; fill: none; }
</style>
