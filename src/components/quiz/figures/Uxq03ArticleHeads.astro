---
// Quiz figure for the spacing post: two article snippets, heading gaps shaded.
---
<div class="qfig-uxq03articleheads">
  <svg viewBox="0 0 600 280" role="img" aria-label="Two article snippets at real pixel sizes: three lines of paragraph text, a section heading, then more text. Article A has 16px above and 16px below the heading. Article B has 40px above and 12px below. The gaps are shaded.">
<rect x="20" y="10" width="270" height="260" rx="6" class="box" />
<text x="34" y="32" class="h"><tspan data-lang-en>Article A</tspan><tspan data-lang-vi>Article A</tspan></text>
<rect x="34" y="48" width="242" height="7" rx="3" class="bar" />
<rect x="34" y="62" width="242" height="7" rx="3" class="bar" />
<rect x="34" y="76" width="170" height="7" rx="3" class="bar" />
<rect x="34" y="83" width="242" height="16" class="gap" />
<text x="34" y="113" class="lab"><tspan data-lang-en>Spacing scale</tspan><tspan data-lang-vi>Thang khoảng cách</tspan></text>
<rect x="34" y="117" width="242" height="16" class="gap" />
<rect x="34" y="133" width="242" height="7" rx="3" class="bar" />
<rect x="34" y="147" width="242" height="7" rx="3" class="bar" />
<rect x="34" y="161" width="120" height="7" rx="3" class="bar" />
<text x="34" y="258" class="m"><tspan data-lang-en>above heading: 16px, below: 16px</tspan><tspan data-lang-vi>phía trên tiêu đề: 16px, phía dưới: 16px</tspan></text>
<rect x="310" y="10" width="270" height="260" rx="6" class="box" />
<text x="324" y="32" class="h"><tspan data-lang-en>Article B</tspan><tspan data-lang-vi>Article B</tspan></text>
<rect x="324" y="48" width="242" height="7" rx="3" class="bar" />
<rect x="324" y="62" width="242" height="7" rx="3" class="bar" />
<rect x="324" y="76" width="170" height="7" rx="3" class="bar" />
<rect x="324" y="83" width="242" height="40" class="gap" />
<text x="324" y="137" class="lab"><tspan data-lang-en>Spacing scale</tspan><tspan data-lang-vi>Thang khoảng cách</tspan></text>
<rect x="324" y="141" width="242" height="12" class="gap" />
<rect x="324" y="153" width="242" height="7" rx="3" class="bar" />
<rect x="324" y="167" width="242" height="7" rx="3" class="bar" />
<rect x="324" y="181" width="120" height="7" rx="3" class="bar" />
<text x="324" y="258" class="m"><tspan data-lang-en>above heading: 40px, below: 12px</tspan><tspan data-lang-vi>phía trên tiêu đề: 40px, phía dưới: 12px</tspan></text>
  </svg>
</div>

<style>
  .qfig-uxq03articleheads { margin: 0; width: 100%; }
  .qfig-uxq03articleheads svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq03articleheads text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq03articleheads .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-uxq03articleheads .m { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-uxq03articleheads .ln { stroke: var(--text-muted); stroke-width: 1.4; fill: none; }
  .qfig-uxq03articleheads .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq03articleheads .fld { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-uxq03articleheads .lab { fill: var(--text); font-weight: 600; }
  .qfig-uxq03articleheads .gap { fill: var(--gold); opacity: 0.35; }
  .qfig-uxq03articleheads .bar { fill: var(--text-faint); opacity: 0.55; }
  .qfig-uxq03articleheads .ico { fill: var(--text-muted); opacity: 0.7; }
</style>
