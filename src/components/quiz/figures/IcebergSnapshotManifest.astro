---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for batch set 07: Apache Iceberg snapshot metadata hierarchy on Amazon S3.
// Shows the Catalog atomic pointer, metadata.json with clean s1 and bad s2, the manifest list,
// 50 manifest files (1,000 Parquet files each) with per-file min/max bounds, and two racing writers.
// Does not compute or reveal pruning counts or rollback answers. Inline SVG, site tokens only, no ids.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const catToMeta = arrow(216, 68, 256, 68);
const metaToS1 = arrow(370, 96, 260, 124);
const metaToS2 = arrow(440, 96, 466, 124);
const writersToCat = arrow(84, 124, 84, 98);
const s2ToMlist = arrow(466, 180, 466, 208);
const mlistToM1 = arrow(290, 262, 96, 288);
const mlistToM2 = arrow(375, 262, 288, 288);
const mlistToM50 = arrow(485, 262, 488, 288);
const m1ToS3 = arrow(96, 352, 96, 378);
const m2ToS3 = arrow(288, 352, 288, 378);
const m50ToS3 = arrow(488, 352, 488, 378);

const manifests = [
  { x: 10, w: 172, n: '#1' },
  { x: 202, w: 172, n: '#2' },
  { x: 406, w: 164, n: '#50' },
];
---
<div class="qfig-ism">
  <svg viewBox="0 0 580 462" role="img" aria-label="Iceberg snapshot tree for the orders table on S3: an atomic Catalog pointer points to metadata.json (v2), which tracks yesterday's clean snapshot s1 and today's corrupted snapshot s2. Snapshot s2 points to a manifest list tracking 50 manifest files of 1,000 Parquet files each, with per-file min/max bounds for order_date and customer_id over 50,000 Parquet files on S3.">
    <text x="0" y="22" class="qfig-ism-h">
      <tspan data-lang-en>Iceberg snapshot tree for orders on S3</tspan>
      <tspan data-lang-vi>Cây snapshot Iceberg cho bảng orders trên S3</tspan>
    </text>

    <!-- Catalog -->
    <rect x="10" y="40" width="206" height="56" rx="8" class="qfig-ism-gold" />
    <DiagramIcon name="link" x={32} y={68} size={22} />
    <text x="50" y="62" class="qfig-ism-t">
      <tspan data-lang-en>Catalog pointer</tspan>
      <tspan data-lang-vi>Con trỏ Catalog</tspan>
    </text>
    <text x="50" y="81" class="qfig-ism-m">
      <tspan data-lang-en>atomic swap → v2 (s2)</tspan>
      <tspan data-lang-vi>tráo nguyên tử → v2 (s2)</tspan>
    </text>

    <!-- metadata.json -->
    <rect x="258" y="40" width="312" height="56" rx="8" class="qfig-ism-box" />
    <DiagramIcon name="doc" x={280} y={68} size={22} />
    <text x="298" y="62" class="qfig-ism-t">metadata.json (v2)</text>
    <text x="298" y="81" class="qfig-ism-m">
      <tspan data-lang-en>schema, snapshots [s1, s2]</tspan>
      <tspan data-lang-vi>schema, danh sách [s1, s2]</tspan>
    </text>

    <g class="qfig-ism-arr"><path d={catToMeta.line} /><polygon points={catToMeta.head} /></g>

    <!-- Racing writers -->
    <rect x="10" y="124" width="148" height="56" rx="8" class="qfig-ism-dash" />
    <DiagramIcon name="worker" x={30} y={152} size={20} />
    <text x="46" y="147" class="qfig-ism-t">
      <tspan data-lang-en>Writers A &amp; B</tspan>
      <tspan data-lang-vi>Writer A &amp; B</tspan>
    </text>
    <text x="46" y="166" class="qfig-ism-m">
      <tspan data-lang-en>race for s3</tspan>
      <tspan data-lang-vi>đua commit s3</tspan>
    </text>
    <g class="qfig-ism-arr-dash"><path d={writersToCat.line} /><polygon points={writersToCat.head} /></g>

    <!-- s1 clean -->
    <rect x="176" y="124" width="166" height="56" rx="8" class="qfig-ism-gold" />
    <DiagramIcon name="backup" x={198} y={152} size={20} />
    <text x="214" y="147" class="qfig-ism-t">
      <tspan data-lang-en>s1 (yesterday)</tspan>
      <tspan data-lang-vi>s1 (hôm qua)</tspan>
    </text>
    <text x="214" y="166" class="qfig-ism-m">
      <tspan data-lang-en>clean pricing rows</tspan>
      <tspan data-lang-vi>cột giá bình thường</tspan>
    </text>

    <!-- s2 bad -->
    <rect x="362" y="124" width="208" height="56" rx="8" class="qfig-ism-hot" />
    <DiagramIcon name="warning" x={384} y={152} size={20} />
    <text x="400" y="147" class="qfig-ism-badt">
      <tspan data-lang-en>s2 (current)</tspan>
      <tspan data-lang-vi>s2 (hiện tại)</tspan>
    </text>
    <text x="400" y="166" class="qfig-ism-m">
      <tspan data-lang-en>bad deploy: wrong prices</tspan>
      <tspan data-lang-vi>deploy lỗi: sai cột giá</tspan>
    </text>

    <g class="qfig-ism-arr"><path d={metaToS1.line} /><polygon points={metaToS1.head} /></g>
    <g class="qfig-ism-arr"><path d={metaToS2.line} /><polygon points={metaToS2.head} /></g>

    <!-- Manifest list -->
    <rect x="176" y="208" width="394" height="54" rx="8" class="qfig-ism-box" />
    <DiagramIcon name="file" x={198} y={235} size={22} />
    <text x="216" y="230" class="qfig-ism-t">
      <tspan data-lang-en>s2 manifest list (1 file)</tspan>
      <tspan data-lang-vi>manifest list của s2 (1 file)</tspan>
    </text>
    <text x="216" y="249" class="qfig-ism-m">
      <tspan data-lang-en>50 manifests • order_date bounds</tspan>
      <tspan data-lang-vi>50 manifest • cận theo order_date</tspan>
    </text>
    <g class="qfig-ism-arr"><path d={s2ToMlist.line} /><polygon points={s2ToMlist.head} /></g>

    <!-- Manifest files -->
    <g class="qfig-ism-arr"><path d={mlistToM1.line} /><polygon points={mlistToM1.head} /></g>
    <g class="qfig-ism-arr"><path d={mlistToM2.line} /><polygon points={mlistToM2.head} /></g>
    <g class="qfig-ism-arr"><path d={mlistToM50.line} /><polygon points={mlistToM50.head} /></g>

    {manifests.map((m) => (
      <g>
        <rect x={m.x} y="288" width={m.w} height="64" rx="8" class="qfig-ism-box" />
        <text x={m.x + 12} y="309" class="qfig-ism-t">Manifest {m.n}</text>
        <text x={m.x + 12} y="327" class="qfig-ism-m">
          <tspan data-lang-en>1,000 Parquet files</tspan>
          <tspan data-lang-vi>1.000 file Parquet</tspan>
        </text>
        <text x={m.x + 12} y="344" class="qfig-ism-s">
          <tspan data-lang-en>min/max per file</tspan>
          <tspan data-lang-vi>cận min/max từng file</tspan>
        </text>
      </g>
    ))}
    <text x="390" y="324" text-anchor="middle" class="qfig-ism-t">…</text>

    <g class="qfig-ism-arr"><path d={m1ToS3.line} /><polygon points={m1ToS3.head} /></g>
    <g class="qfig-ism-arr"><path d={m2ToS3.line} /><polygon points={m2ToS3.head} /></g>
    <g class="qfig-ism-arr"><path d={m50ToS3.line} /><polygon points={m50ToS3.head} /></g>

    <!-- S3 data files -->
    <rect x="10" y="378" width="560" height="52" rx="8" class="qfig-ism-box" />
    <DiagramIcon name="s3" x={34} y={404} size={24} />
    <text x="54" y="400" class="qfig-ism-t">
      <tspan data-lang-en>S3: 50,000 immutable Parquet data files</tspan>
      <tspan data-lang-vi>S3: 50.000 file dữ liệu Parquet bất biến</tspan>
    </text>
    <text x="54" y="419" class="qfig-ism-m">
      <tspan data-lang-en>Each file tracks order_date and customer_id min/max in its manifest</tspan>
      <tspan data-lang-vi>Mỗi file có cận min/max của order_date và customer_id trong manifest</tspan>
    </text>

    <text x="0" y="454" class="qfig-ism-s">
      <tspan data-lang-en>Query filter: WHERE order_date = '2026-11-18' AND customer_id = 42</tspan>
      <tspan data-lang-vi>Truy vấn lọc: WHERE order_date = '2026-11-18' AND customer_id = 42</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-ism { margin: 0; width: 100%; }
  .qfig-ism svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-ism text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-ism .qfig-ism-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-ism .qfig-ism-t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-ism .qfig-ism-badt { font-size: 14px; font-weight: 700; fill: var(--red); }
  .qfig-ism .qfig-ism-m { font-size: 13px; fill: var(--text-muted); }
  .qfig-ism .qfig-ism-s { font-size: 12.5px; fill: var(--text-muted); }
  .qfig-ism-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .qfig-ism-dash { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; stroke-dasharray: 4 3; }
  .qfig-ism-gold { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-ism-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .qfig-ism-arr path { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-ism-arr polygon { fill: var(--text-muted); }
  .qfig-ism-arr-dash path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; stroke-dasharray: 4 3; }
  .qfig-ism-arr-dash polygon { fill: var(--text-muted); }
</style>
