---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 04: HOSE's order types — LO, MTL, MOK, MAK, as the post's Concepts list them.
const W = 580;
const H = 424;
const cards = [
  {
    x: 16,
    y: 56,
    icon: 'receipt',
    name: 'LO',
    en: ['Limit order — waits in the book', 'at your price'],
    vi: ['Lệnh giới hạn — nằm chờ trong sổ', 'ở giá của bạn'],
  },
  {
    x: 296,
    y: 56,
    icon: 'stopwatch',
    name: 'MTL',
    en: ['Market with limit — fills now,', 'never above your limit'],
    vi: ['Thị trường có giới hạn — khớp ngay,', 'không vượt giá tối đa'],
  },
  {
    x: 16,
    y: 196,
    icon: 'ok',
    name: 'MOK',
    en: ['All-or-nothing — fills fully', 'or cancels'],
    vi: ['Khớp hết hoặc huỷ —', 'không đủ thì huỷ cả lệnh'],
  },
  {
    x: 296,
    y: 196,
    icon: 'fail',
    name: 'MAK',
    en: ['Fill-what-you-can — partial fill,', 'the rest cancels'],
    vi: ['Khớp được bao nhiêu hay bấy nhiêu —', 'phần thiếu huỷ'],
  },
];
---
<div class="qot">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <DiagramIcon name="receipt" x={18} y={16} size={22} />
    <text x="40" y="21" class="qot-h">
      <tspan data-lang-en>Four ways to place the same wish: "buy"</tspan>
      <tspan data-lang-vi>Bốn cách đặt cùng một mong muốn: "mua"</tspan>
    </text>
    {cards.map((c) => (
      <g>
        <rect x={c.x} y={c.y} width="268" height="112" rx="10" />
        <DiagramIcon name={c.icon} x={c.x + 14} y={c.y + 12} size={20} />
        <text x={c.x + 44} y={c.y + 27} class="qot-name">{c.name}</text>
        <text x={c.x + 14} y={c.y + 54} class="qot-text">
          <tspan data-lang-en>{c.en[0]}</tspan>
          <tspan data-lang-vi>{c.vi[0]}</tspan>
        </text>
        <text x={c.x + 14} y={c.y + 74} class="qot-text">
          <tspan data-lang-en>{c.en[1]}</tspan>
          <tspan data-lang-vi>{c.vi[1]}</tspan>
        </text>
      </g>
    ))}
    <text x="16" y="330" class="qot-note">
      <tspan data-lang-en>A limit order can match at your price or better. The market family</tspan>
      <tspan data-lang-vi>Lệnh giới hạn có thể khớp ở giá của bạn hoặc tốt hơn. Nhóm lệnh</tspan>
    </text>
    <text x="16" y="352" class="qot-note">
      <tspan data-lang-en>(MTL · MOK · MAK) wants the trade now and lets the book decide the price.</tspan>
      <tspan data-lang-vi>thị trường (MTL · MOK · MAK) muốn khớp ngay và để sổ lệnh định giá.</tspan>
    </text>
    <text x="16" y="384" class="qot-tick">
      <tspan data-lang-en>HOSE rules: MTL carries a price limit; MOK and MAK do not.</tspan>
      <tspan data-lang-vi>Quy định HOSE: MTL có giá tối đa; MOK và MAK thì không.</tspan>
    </text>
  </svg>
</div>

<style>
  .qot {
    margin: 0;
    width: 100%;
  }
  .qot svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qot text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qot .qot-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qot g rect {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .qot .qot-name {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .qot .qot-text {
    font-size: 13px;
  }
  .qot .qot-note {
    font-size: 13.5px;
    fill: var(--text-body);
  }
  .qot .qot-tick {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
</style>
