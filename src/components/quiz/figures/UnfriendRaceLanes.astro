---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 02 (unbundling): two services log to different shards; the worker sees the post before the unfriend.
// Shows the mechanism and the scenario numbers only, never a fix or a computed result.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 380;
const y1 = 84;
const y2 = 160;
const xEnd = 424;

function arrowHead(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 5} ${x - 9},${y + 5}`;
}
function downHead(x: number, y: number) {
  return `${x},${y} ${x - 5},${y - 9} ${x + 5},${y - 9}`;
}
---
<div class="ur">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two services write to different log shards. Alice's unfriend event is slow to reach the notification worker, her post arrives first, and the worker joins it with a stale friend list.">
    <text x="10" y="24" class="ur-h">
      <tspan data-lang-en>Two shards, no order between them</tspan>
      <tspan data-lang-vi>Hai shard, không có thứ tự giữa chúng</tspan>
    </text>

    <!-- lane 1: friendships -->
    <DiagramIcon name="db" x={22} y={y1 - 8} size={22} />
    <text x="42" y={y1 - 4} class="ur-name">
      <tspan data-lang-en>Friendships</tspan>
      <tspan data-lang-vi>Bạn bè</tspan>
    </text>
    <text x="42" y={y1 + 14} class="ur-sub">
      <tspan data-lang-en>log shard 1</tspan>
      <tspan data-lang-vi>log shard 1</tspan>
    </text>
    <path d={`M 150 ${y1} L ${xEnd - 8} ${y1}`} class="ur-lane" />
    <polygon points={arrowHead(xEnd, y1)} class="ur-head" />
    <circle cx="255" cy={y1} r="7" class="ur-dot" />
    <text x="255" y={y1 - 16} text-anchor="middle" class="ur-ev">
      <tspan data-lang-en>1. Alice unfriends Bob</tspan>
      <tspan data-lang-vi>1. Alice hủy kết bạn Bob</tspan>
    </text>
    <DiagramIcon name="hourglass" x={330} y={y1} size={22} />
    <text x={xEnd} y={y1 + 28} text-anchor="end" class="ur-late">
      <tspan data-lang-en>reaches the worker second</tspan>
      <tspan data-lang-vi>tới worker thứ hai</tspan>
    </text>

    <!-- lane 2: messages -->
    <DiagramIcon name="db" x={22} y={y2 - 8} size={22} />
    <text x="42" y={y2 - 4} class="ur-name">
      <tspan data-lang-en>Messages</tspan>
      <tspan data-lang-vi>Tin nhắn</tspan>
    </text>
    <text x="42" y={y2 + 14} class="ur-sub">
      <tspan data-lang-en>log shard 3</tspan>
      <tspan data-lang-vi>log shard 3</tspan>
    </text>
    <path d={`M 150 ${y2} L ${xEnd - 8} ${y2}`} class="ur-lane" />
    <polygon points={arrowHead(xEnd, y2)} class="ur-head" />
    <circle cx="290" cy={y2} r="7" class="ur-dot" />
    <text x="290" y={y2 - 16} text-anchor="middle" class="ur-ev">
      <tspan data-lang-en>2. Alice posts</tspan>
      <tspan data-lang-vi>2. Alice đăng bài</tspan>
    </text>
    <text x={xEnd} y={y2 + 28} text-anchor="end" class="ur-late">
      <tspan data-lang-en>reaches the worker first</tspan>
      <tspan data-lang-vi>tới worker trước</tspan>
    </text>

    <!-- worker -->
    <g class="ur-box">
      <rect x="440" y="52" width="130" height="138" rx="8" />
    </g>
    <DiagramIcon name="worker" x={505} y={80} size={26} />
    <text x="505" y="112" text-anchor="middle" class="ur-name">
      <tspan data-lang-en>Notification</tspan>
      <tspan data-lang-vi>Worker gửi</tspan>
    </text>
    <text x="505" y="130" text-anchor="middle" class="ur-name">
      <tspan data-lang-en>worker</tspan>
      <tspan data-lang-vi>thông báo</tspan>
    </text>
    <text x="505" y="156" text-anchor="middle" class="ur-sub">
      <tspan data-lang-en>joins post with</tspan>
      <tspan data-lang-vi>join bài đăng với</tspan>
    </text>
    <text x="505" y="174" text-anchor="middle" class="ur-sub">
      <tspan data-lang-en>friend data</tspan>
      <tspan data-lang-vi>dữ liệu bạn bè</tspan>
    </text>

    <!-- outcome -->
    <path d="M 505 190 L 505 226" class="ur-bad-line" />
    <polygon points={downHead(505, 236)} class="ur-bad-head" />
    <g class="ur-bad">
      <rect x="200" y="238" width="370" height="76" rx="8" />
    </g>
    <DiagramIcon name="warning" x={228} y={262} size={24} />
    <text x="250" y="262" class="ur-bad-t">
      <tspan data-lang-en>Friend data is stale: Bob is still a friend</tspan>
      <tspan data-lang-vi>Dữ liệu bạn bè cũ: Bob vẫn là bạn</tspan>
    </text>
    <DiagramIcon name="fail" x={228} y={292} size={24} />
    <text x="250" y="297" class="ur-bad-t">
      <tspan data-lang-en>Bob gets the private post by email</tspan>
      <tspan data-lang-vi>Bob nhận bài riêng tư qua email</tspan>
    </text>

    <!-- load note -->
    <text x="10" y="342" class="ur-note">
      <tspan data-lang-en>Load: 130,000 events/s. One log leader: 40,000 events/s.</tspan>
      <tspan data-lang-vi>Tải: 130.000 sự kiện/s. Một leader của log: 40.000 sự kiện/s.</tspan>
    </text>
    <text x="10" y="366" class="ur-sub">
      <tspan data-lang-en>No order is defined between events in different shards.</tspan>
      <tspan data-lang-vi>Sự kiện ở hai shard khác nhau không có thứ tự xác định.</tspan>
    </text>
  </svg>
</div>

<style>
  .ur { width: 100%; }
  .ur svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .ur text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .ur .ur-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ur .ur-name { font-weight: 700; fill: var(--text); }
  .ur .ur-sub { fill: var(--text-muted); }
  .ur .ur-ev { font-weight: 700; fill: var(--text); }
  .ur .ur-late { fill: var(--text-muted); }
  .ur .ur-note { fill: var(--text); }
  .ur-lane { fill: none; stroke: var(--text-muted); stroke-width: 2; }
  .ur-head { fill: var(--text-muted); }
  .ur-dot { fill: var(--act-2); stroke: var(--bg); stroke-width: 2; }
  .ur-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .ur-bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .ur .ur-bad-t { fill: var(--red); font-weight: 700; }
  .ur-bad-line { fill: none; stroke: var(--red); stroke-width: 2; }
  .ur-bad-head { fill: var(--red); }
</style>
