---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 03 (stream processing): an orders topic keyed by user_id, three of its partitions drawn as lanes
// of records with offsets, one slow record in P1, and the consumers of one group reading the lanes.
// Shows the setup only (no results). Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 316;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const trackX = 148;
const boxX = (i: number) => trackX + 6 + i * 46;
const lanes = [
  { name: 'P0', y: 100, recs: [['u12'], ['u58'], ['u12'], ['u77'], ['u40']] },
  { name: 'P1', y: 152, recs: [['u31'], ['u64', 'slow'], ['u31', 'wait'], ['u90', 'wait'], ['u64', 'wait']] },
  { name: 'P2', y: 204, recs: [['u05'], ['u23'], ['u05'], ['u88'], ['u23']] },
];
const svc = { x: 8, y: 106, w: 82, h: 92 };
const grp = { x: 436, y: 44, w: 136, h: 208 };
---
<div class="qp">
  <div>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Records keyed by user_id spread over partitions P0, P1 and P2 of a topic, each with offsets 0 to 4; one record in P1 is slow and the records behind it wait; each lane is read by one consumer of group billing.">
      <text x="10" y="26" class="qp-h">
        <tspan data-lang-en>Topic orders: 12 partitions, key = user_id</tspan>
        <tspan data-lang-vi>Topic orders: 12 partition, key = user_id</tspan>
      </text>

      <g class="qp-box">
        <rect x={svc.x} y={svc.y} width={svc.w} height={svc.h} rx="8" />
        <DiagramIcon name="server" x={svc.x + svc.w / 2} y={svc.y + 24} size={22} />
        <text x={svc.x + svc.w / 2} y={svc.y + 58} text-anchor="middle" class="qp-name">
          <tspan data-lang-en>Orders</tspan>
          <tspan data-lang-vi>Đơn hàng</tspan>
        </text>
        <text x={svc.x + svc.w / 2} y={svc.y + 78} text-anchor="middle" class="qp-sub">key: user_id</text>
      </g>

      <text x={trackX + 6} y="56" class="qp-sub">offset</text>
      {[0, 1, 2, 3, 4].map((i) => (
        <text x={boxX(i) + 20} y="71" text-anchor="middle" class="qp-num">{i}</text>
      ))}

      {lanes.map((l) => {
        const a = arrow(svc.x + svc.w, svc.y + svc.h / 2, 114, l.y);
        const c = arrow(trackX + 6 + 5 * 46 - 6, l.y, grp.x + 12, l.y);
        return (
          <g>
            <g class="qp-arrow"><path d={a.line} /><polygon points={a.head} /></g>
            <text x="120" y={l.y + 5} class="qp-name">{l.name}</text>
            <rect x={trackX} y={l.y - 22} width="242" height="44" rx="6" class="qp-track" />
            {l.recs.map((r, i) => (
              <g>
                <rect x={boxX(i)} y={l.y - 14} width="40" height="28" rx="4"
                  class={r[1] === 'slow' ? 'qp-rec is-slow' : r[1] === 'wait' ? 'qp-rec is-wait' : 'qp-rec'} />
                <text x={boxX(i) + 20} y={l.y + 5} text-anchor="middle"
                  class={r[1] === 'slow' ? 'qp-key is-slow' : 'qp-key'}>{r[0]}</text>
              </g>
            ))}
            <g class="qp-arrow"><path d={c.line} /><polygon points={c.head} /></g>
            <DiagramIcon name="worker" x={grp.x + 34} y={l.y} size={22} />
            <text x={grp.x + 54} y={l.y + 5} class="qp-sub">
              <tspan data-lang-en>consumer</tspan>
              <tspan data-lang-vi>consumer</tspan>
            </text>
          </g>
        );
      })}

      <text x="120" y="250" class="qp-sub">P3 – P11</text>
      <rect x={trackX} y="234" width="242" height="26" rx="6" class="qp-track is-dim" />
      <text x={trackX + 121} y="252" text-anchor="middle" class="qp-sub">
        <tspan data-lang-en>9 more partitions, not drawn</tspan>
        <tspan data-lang-vi>9 partition nữa, không vẽ</tspan>
      </text>

      <rect x={grp.x} y={grp.y} width={grp.w} height={grp.h} rx="8" class="qp-group" />
      <text x={grp.x + grp.w / 2} y={grp.y + 24} text-anchor="middle" class="qp-name">
        <tspan data-lang-en>Group billing</tspan>
        <tspan data-lang-vi>Group billing</tspan>
      </text>
      <text x={grp.x + grp.w / 2} y={grp.y + grp.h - 12} text-anchor="middle" class="qp-sub">
        <tspan data-lang-en>20 consumers</tspan>
        <tspan data-lang-vi>20 consumer</tspan>
      </text>

      <rect x="10" y="282" width="22" height="16" rx="3" class="qp-rec is-slow" />
      <text x="40" y="295" class="qp-sub">
        <tspan data-lang-en>slow record, 30 s</tspan>
        <tspan data-lang-vi>record chậm, 30 giây</tspan>
      </text>
      <rect x="226" y="282" width="22" height="16" rx="3" class="qp-rec is-wait" />
      <text x="256" y="295" class="qp-sub">
        <tspan data-lang-en>queued behind it</tspan>
        <tspan data-lang-vi>xếp hàng phía sau nó</tspan>
      </text>
    </svg>
  </div>
</div>

<style>
  .qp { width: 100%; }
  .qp svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qp text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qp .qp-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qp .qp-name { font-weight: 700; fill: var(--text); }
  .qp .qp-sub, .qp .qp-num { font-size: 13px; fill: var(--text-muted); }
  .qp .qp-key { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qp .qp-key.is-slow { fill: var(--red); }
  .qp-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qp-track { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qp-track.is-dim { stroke-dasharray: 5 4; fill: transparent; }
  .qp-group { fill: none; stroke: var(--gold); stroke-width: 1.5; }
  .qp-rec { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1; }
  .qp-rec.is-slow { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .qp-rec.is-wait { fill: var(--red-tint-bg); stroke: var(--border); stroke-dasharray: 3 3; }
  .qp-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .qp-arrow polygon { fill: var(--text-muted); }
</style>
