<style>
   .qfig-sbq10floordays { margin: 0; width: 100%; }
   .qfig-sbq10floordays svg { display: block; width: 100%; min-width: 320px; height: auto; }
   .qfig-sbq10floordays text { font-size: 12.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
   .qfig-sbq10floordays .h { font-size: 15px; font-weight: 700; fill: var(--text); }
   .qfig-sbq10floordays .b { font-weight: 700; fill: var(--text); }
   .qfig-sbq10floordays .m { fill: var(--text-muted); }
   .qfig-sbq10floordays .red { fill: var(--red); font-weight: 700; }
   .qfig-sbq10floordays .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
   .qfig-sbq10floordays .card-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
   .qfig-sbq10floordays .bar-red { fill: var(--red); }
   .qfig-sbq10floordays .bar-mut { fill: var(--text-faint); }
   .qfig-sbq10floordays .ln { stroke: var(--border); stroke-width: 1.2; }
</style>
