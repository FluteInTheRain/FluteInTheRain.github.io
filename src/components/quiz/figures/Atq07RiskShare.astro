---
// Quiz figure for ai-trading-portfolio set 05: money share versus risk share of three stocks (volatility 10%, 20%, 40%,
// pairwise correlation 0.3, a third of the money in each). Risk shares 9.5 / 23.8 / 66.7 from numpy (see set-05 verifiedBy).
const names = ['A  (10%)', 'B  (20%)', 'C  (40%)'];
const money = [33.3, 33.3, 33.3];
const risk = [9.5, 23.8, 66.7];
const sx = (v: number) => v * 4.2;
---
<div class="qfig-q07b">
  <svg viewBox="0 0 580 250" role="img" aria-label="For stocks A, B and C, a grey bar of 33.3 percent of the money each, and a bar of their share of risk: 9.5 percent for A, 23.8 percent for B and 66.7 percent for C.">
    <text x="0" y="20" class="h"><tspan data-lang-en>Share of money and share of risk</tspan><tspan data-lang-vi>Phần tiền và phần rủi ro</tspan></text>
    {names.map((n, i) => (
      <g>
        <text x="0" y={62 + i * 60} class="lab">{n}</text>
        <rect x="90" y={44 + i * 60} width={sx(money[i])} height="16" rx="3" class="grey" />
        <text x={90 + sx(money[i]) + 8} y={57 + i * 60} class="m">{money[i]}% <tspan data-lang-en>money</tspan><tspan data-lang-vi>tiền</tspan></text>
        <rect x="90" y={64 + i * 60} width={sx(risk[i])} height="16" rx="3" class={i === 2 ? 'redf' : 'gold'} />
        <text x={90 + sx(risk[i]) + 8} y={77 + i * 60} class={i === 2 ? 'num red' : 'num'}>{risk[i]}% <tspan data-lang-en>risk</tspan><tspan data-lang-vi>rủi ro</tspan></text>
      </g>
    ))}
    <text x="0" y="238" class="m"><tspan data-lang-en>Annual volatility in brackets; every pair has correlation 0.3.</tspan><tspan data-lang-vi>Độ biến động hằng năm trong ngoặc; mỗi cặp có tương quan 0,3.</tspan></text>
  </svg>
</div>

<style>
  .qfig-q07b { margin: 0; width: 100%; }
  .qfig-q07b svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .qfig-q07b text { font-size: 13px; fill: var(--text-body); }
  .qfig-q07b .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-q07b .m { font-size: 12px; fill: var(--text-muted); }
  .qfig-q07b .lab { font-weight: 600; fill: var(--text); }
  .qfig-q07b .num { font-weight: 700; fill: var(--text); }
  .qfig-q07b .num.red { fill: var(--red); }
  .qfig-q07b .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-q07b .gold { fill: var(--gold); }
  .qfig-q07b .grey { fill: var(--text-muted); opacity: 0.55; }
  .qfig-q07b .redf { fill: var(--red); }
  .qfig-q07b .grid { stroke: var(--border); stroke-width: 1; }
</style>
