---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for consensus set 04: accounts (Shard A) and photos (Shard B) stamped by separate local
// NTP clocks with no causality token passed, plus a stranger's MVCC snapshot read at ts = 360 ms.
// Inline SVG, site tokens only, no <marker>/<defs>/ids. Shows inputs only, never computed ts_B or window width.
function head(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`;
}
---
<div class="qfig-cpl">
  <svg viewBox="0 0 580 368" role="img" aria-label="Laptop updates account = private on Shard A at real time 400 ms where NTP lag is 0 ms. Phone uploads a private photo on Shard B at real time 450 ms where NTP lags 130 ms, with no causality token passed between them. Below, a stranger runs an MVCC snapshot read at ts = 360 ms.">
    <text x="0" y="22" class="qfig-cpl-h">
      <tspan data-lang-en>Two shards using local NTP clocks</tspan>
      <tspan data-lang-vi>Hai shard dùng đồng hồ NTP cục bộ</tspan>
    </text>

    <!-- Row 1: Laptop -> Shard A -->
    <rect x="0" y="48" width="174" height="68" rx="8" class="qfig-cpl-box" />
    <DiagramIcon name="laptop" x={26} y={72} size={22} />
    <text x="44" y="77" class="qfig-cpl-t">
      <tspan data-lang-en>Laptop</tspan>
      <tspan data-lang-vi>Laptop</tspan>
    </text>
    <text x="12" y="102" class="qfig-cpl-b">
      <tspan data-lang-en>1. account = private</tspan>
      <tspan data-lang-vi>1. account = private</tspan>
    </text>

    <path d="M 176 82 L 216 82" class="qfig-cpl-flow" />
    <polygon points={head(224, 82)} class="qfig-cpl-flowh" />

    <rect x="226" y="48" width="354" height="68" rx="8" class="qfig-cpl-box" />
    <DiagramIcon name="db" x={252} y={72} size={22} />
    <text x="270" y="77" class="qfig-cpl-t">
      <tspan data-lang-en>Shard A (accounts)</tspan>
      <tspan data-lang-vi>Shard A (tài khoản)</tspan>
    </text>
    <text x="240" y="102" class="qfig-cpl-m">
      <tspan data-lang-en>t_real = 400 ms · NTP lag = 0 ms</tspan>
      <tspan data-lang-vi>t_real = 400 ms · NTP lệch = 0 ms</tspan>
    </text>

    <!-- No causality token -->
    <text x="0" y="138" class="qfig-cpl-r">
      <tspan data-lang-en>✕ no causality token passed between laptop, phone, or shards</tspan>
      <tspan data-lang-vi>✕ không truyền token nhân quả giữa laptop, điện thoại hay hai shard</tspan>
    </text>

    <!-- Row 2: Phone -> Shard B -->
    <rect x="0" y="154" width="174" height="68" rx="8" class="qfig-cpl-box" />
    <DiagramIcon name="phone" x={26} y={178} size={22} />
    <text x="44" y="183" class="qfig-cpl-t">
      <tspan data-lang-en>Phone</tspan>
      <tspan data-lang-vi>Điện thoại</tspan>
    </text>
    <text x="12" y="208" class="qfig-cpl-b">
      <tspan data-lang-en>2. upload photo</tspan>
      <tspan data-lang-vi>2. đăng ảnh</tspan>
    </text>

    <path d="M 176 188 L 216 188" class="qfig-cpl-flow" />
    <polygon points={head(224, 188)} class="qfig-cpl-flowh" />

    <rect x="226" y="154" width="354" height="68" rx="8" class="qfig-cpl-badbox" />
    <DiagramIcon name="db" x={252} y={178} size={22} />
    <text x="270" y="183" class="qfig-cpl-t">
      <tspan data-lang-en>Shard B (photos)</tspan>
      <tspan data-lang-vi>Shard B (ảnh)</tspan>
    </text>
    <text x="240" y="208" class="qfig-cpl-r">
      <tspan data-lang-en>t_real = 450 ms · NTP lags 130 ms</tspan>
      <tspan data-lang-vi>t_real = 450 ms · NTP chậm 130 ms</tspan>
    </text>

    <!-- MVCC snapshot read -->
    <line x1="0" x2="580" y1="242" y2="242" class="qfig-cpl-rule" />
    <rect x="0" y="258" width="580" height="96" rx="8" class="qfig-cpl-box" />
    <DiagramIcon name="user" x={28} y={286} size={24} />
    <text x="48" y="291" class="qfig-cpl-t">
      <tspan data-lang-en>Stranger runs MVCC snapshot read at ts = 360 ms</tspan>
      <tspan data-lang-vi>Người lạ đọc snapshot MVCC tại ts = 360 ms</tspan>
    </text>
    <text x="16" y="318" class="qfig-cpl-b">
      <tspan data-lang-en>Visible: row versions stamped ts &lt;= 360 ms</tspan>
      <tspan data-lang-vi>Hiển thị: bản ghi đóng dấu ts &lt;= 360 ms</tspan>
    </text>
    <text x="16" y="340" class="qfig-cpl-m">
      <tspan data-lang-en>Hidden: row versions stamped ts &gt; 360 ms</tspan>
      <tspan data-lang-vi>Ẩn: bản ghi đóng dấu ts &gt; 360 ms</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-cpl { margin: 0; width: 100%; }
  .qfig-cpl svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-cpl text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-cpl .qfig-cpl-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-cpl .qfig-cpl-t { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .qfig-cpl .qfig-cpl-b { fill: var(--text-body); }
  .qfig-cpl .qfig-cpl-m { fill: var(--text-muted); }
  .qfig-cpl .qfig-cpl-r { font-weight: 600; fill: var(--red); }
  .qfig-cpl-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .qfig-cpl-badbox { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .qfig-cpl-flow { stroke: var(--text-muted); stroke-width: 1.8; fill: none; }
  .qfig-cpl-flowh { fill: var(--text-muted); }
  .qfig-cpl-rule { stroke: var(--border); stroke-width: 1; }
</style>
