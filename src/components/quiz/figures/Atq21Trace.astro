---
// Set 01: an agent trace. One search returns five chunks; the final answer's figure (1,150) is in none of them.
const chunks = [
  ['12', 'Retail segment revenue: 400'],
  ['13', 'Wholesale segment revenue: 380'],
  ['40', 'Online segment revenue: 315'],
  ['41', 'Note 7: see the segment table'],
  ['77', 'Page header: Annual report 2024'],
];
---
<div class="q21t">
  <svg viewBox="0 0 580 300" role="img" aria-hidden="true">
    <text x="20" y="24" class="h"><tspan data-lang-en>Trace of one run</tspan><tspan data-lang-vi>Vết chạy của một lượt</tspan></text>
    <text x="20" y="50" class="c">step 1  search_filings("group revenue 2024")</text>
    <text x="20" y="70" class="m"><tspan data-lang-en>returns 5 chunks:</tspan><tspan data-lang-vi>trả về 5 đoạn:</tspan></text>
    {chunks.map(([id, t], i) => (
      <g>
        <rect x="30" y={80 + i * 28} width="520" height="24" rx="4" class="r" />
        <text x="40" y={97 + i * 28} class="c">#{id}</text>
        <text x="86" y={97 + i * 28} class="s">{t}</text>
      </g>
    ))}
    <text x="20" y="250" class="c">step 2  answer</text>
    <rect x="30" y="258" width="520" height="30" rx="4" class="r is-red" />
    <text x="40" y="278" class="s"><tspan data-lang-en>"Group revenue was 1,150 billion dong."</tspan><tspan data-lang-vi>"Doanh thu hợp nhất là 1.150 tỉ đồng."</tspan></text>
  </svg>
</div>
<style>
  .q21t svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .q21t text { font-size: 13px; fill: var(--text-body); }
  .q21t .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .q21t .c { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; fill: var(--text); }
  .q21t .m { font-size: 12px; fill: var(--text-muted); }
  .q21t .s { font-size: 13px; fill: var(--text); }
  .q21t .r { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.1; }
  .q21t .r.is-red { fill: var(--red-tint-bg); stroke: var(--red); }
</style>
