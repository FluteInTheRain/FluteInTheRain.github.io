---
// Set 03: monthly rows, each with a 6-month forward label that starts the month after the row.
const X0 = 72, CW = 36, Y0 = 56, RH = 26;
const rows = [0, 1, 2, 3, 4, 5, 6];
const cols = 13;
---
<div class="aq2">
  <svg viewBox="0 0 580 270" aria-hidden="true">
    <text x="10" y="20" class="h">
      <tspan data-lang-en>Row k: features at month k, label = months k+1 to k+6</tspan>
      <tspan data-lang-vi>Dòng k: feature tại tháng k, nhãn = tháng k+1 tới k+6</tspan>
    </text>
    {Array.from({ length: cols }, (_, i) => (
      <g>
        <line x1={X0 + i * CW} y1={Y0 - 8} x2={X0 + i * CW} y2={Y0 + rows.length * RH} class="grid" />
        <text x={X0 + i * CW + CW / 2} y={Y0 - 12} text-anchor="middle" class="m">{i + 1}</text>
      </g>
    ))}
    <line x1={X0 + cols * CW} y1={Y0 - 8} x2={X0 + cols * CW} y2={Y0 + rows.length * RH} class="grid" />
    {rows.map((t) => (
      <g>
        <text x={X0 - 8} y={Y0 + t * RH + 17} text-anchor="end" class={t === 0 ? 'v' : ''}>
          <tspan data-lang-en>{`Row ${t + 1}`}</tspan>
          <tspan data-lang-vi>{`Dòng ${t + 1}`}</tspan>
        </text>
        <circle cx={X0 + t * CW + CW / 2} cy={Y0 + t * RH + 12} r="3.5" class="pt" />
        <rect x={X0 + (t + 1) * CW + 2} y={Y0 + t * RH + 4} width={6 * CW - 4} height="16" rx="3" class={t === 0 ? 'lbl first' : 'lbl'} />
      </g>
    ))}
    <text x="10" y="260" class="m">
      <tspan data-lang-en>Column numbers are months. Dot: the month the row's features are known.</tspan>
      <tspan data-lang-vi>Số cột là tháng. Chấm: tháng mà feature của dòng đó được biết.</tspan>
    </text>
  </svg>
</div>

<style>
  .aq2 { margin: 0; width: 100%; }
  .aq2 svg { display: block; width: 100%; height: auto; }
  .aq2 text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .aq2 .h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .aq2 .m { font-size: 12px; fill: var(--text-muted); }
  .aq2 .v { font-weight: 700; fill: var(--text); }
  .aq2 .grid { stroke: var(--border); stroke-width: 1; }
  .aq2 .pt { fill: var(--text); }
  .aq2 .lbl { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.1; }
  .aq2 .lbl.first { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
</style>
