---
// Quiz figure for ai-trading-portfolio set 06: a 2x position (50 own, 50 borrowed) after 0..4 limit-down sessions of 7%.
// Values 100, 93, 86.5, 80.4, 74.8; ratios 50.0, 46.2, 42.2, 37.8, 33.2 percent; the call line is 35 percent.
const steps = Array.from({ length: 5 }, (_, k) => { const a = 100 * Math.pow(0.93, k); return { k, a, r: ((a - 50) / a) * 100 }; });
const sy = (r: number) => 190 - ((r - 25) / 30) * 140;
---
<div class="qfig-q07d">
  <svg viewBox="0 0 580 250" role="img" aria-label="Equity ratio of a 2x position after zero to four limit-down sessions: 50.0, 46.2, 42.2, 37.8 and 33.2 percent. A dashed line at 35 percent is crossed on the fourth session.">
    <text x="0" y="20" class="h"><tspan data-lang-en>Equity ratio after each limit-down session</tspan><tspan data-lang-vi>Tỷ lệ vốn tự có sau mỗi phiên giảm sàn</tspan></text>
    {[30, 40, 50].map((r) => (
      <g><line x1="50" x2="560" y1={sy(r)} y2={sy(r)} class="grid" /><text x="42" y={sy(r) + 4} text-anchor="end" class="m">{r}%</text></g>
    ))}
    <line x1="50" x2="560" y1={sy(35)} y2={sy(35)} stroke="var(--red)" stroke-width="1.6" stroke-dasharray="5 4" />
    <text x="556" y={sy(35) - 6} text-anchor="end" class="m" style="fill: var(--red)"><tspan data-lang-en>35% maintenance</tspan><tspan data-lang-vi>duy trì 35%</tspan></text>
    {steps.map((s) => (
      <g>
        <rect x={80 + s.k * 96} y={sy(s.r)} width="56" height={190 - sy(s.r)} rx="3" class={s.r < 35 ? 'redf' : 'gold'} />
        <text x={108 + s.k * 96} y={sy(s.r) - 6} text-anchor="middle" class="num">{s.r.toFixed(1)}%</text>
        <text x={108 + s.k * 96} y="212" text-anchor="middle" class="m">{s.a.toFixed(1)}</text>
        <text x={108 + s.k * 96} y="230" text-anchor="middle" class="m"><tspan data-lang-en>session {s.k}</tspan><tspan data-lang-vi>phiên {s.k}</tspan></text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-q07d { margin: 0; width: 100%; }
  .qfig-q07d svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .qfig-q07d text { font-size: 13px; fill: var(--text-body); }
  .qfig-q07d .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-q07d .m { font-size: 12px; fill: var(--text-muted); }
  .qfig-q07d .lab { font-weight: 600; fill: var(--text); }
  .qfig-q07d .num { font-weight: 700; fill: var(--text); }
  .qfig-q07d .num.red { fill: var(--red); }
  .qfig-q07d .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-q07d .gold { fill: var(--gold); }
  .qfig-q07d .grey { fill: var(--text-muted); opacity: 0.55; }
  .qfig-q07d .redf { fill: var(--red); }
  .qfig-q07d .grid { stroke: var(--border); stroke-width: 1; }
</style>
