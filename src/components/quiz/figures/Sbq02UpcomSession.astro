---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for venues post set 05: UPCoM intraday trades showing morning bulk vs late print.
---
<div class="qfig-sbq02up">
  <svg viewBox="0 0 580 230" role="img" aria-label="UPCoM session tape: 8,000 shares matched at 20,000 VND between 09:30 and 14:30, plus 2,000 shares matched at 22,500 VND at 14:55.">
    <text x="16" y="24" class="qfig-h">
      <tspan data-lang-en>UPCoM session tape for ticker XYZ</tspan>
      <tspan data-lang-vi>Nhật ký khớp lệnh mã XYZ trên UPCoM</tspan>
    </text>

    <rect x="16" y="44" width="262" height="106" rx="8" class="qfig-card" />
    <DiagramIcon name="clock" x={44} y={72} size={22} />
    <text x="64" y="77" class="qfig-t">09:30 – 14:30</text>
    <text x="30" y="106" class="qfig-b">
      <tspan data-lang-en>8,000 shares @ 20,000 VND</tspan>
      <tspan data-lang-vi>8.000 CP @ 20.000 đồng</tspan>
    </text>
    <text x="30" y="130" class="qfig-m">
      <tspan data-lang-en>80% of daily volume</tspan>
      <tspan data-lang-vi>80% khối lượng cả ngày</tspan>
    </text>

    <rect x="302" y="44" width="262" height="106" rx="8" class="qfig-card-red" />
    <DiagramIcon name="chart" x={330} y={72} size={22} />
    <text x="350" y="77" class="qfig-t qfig-red">14:55</text>
    <text x="316" y="106" class="qfig-b">
      <tspan data-lang-en>2,000 shares @ 22,500 VND</tspan>
      <tspan data-lang-vi>2.000 CP @ 22.500 đồng</tspan>
    </text>
    <text x="316" y="130" class="qfig-m">
      <tspan data-lang-en>Last trade shown at close</tspan>
      <tspan data-lang-vi>Giá khớp cuối lúc đóng cửa</tspan>
    </text>

    <rect x="16" y="166" width="548" height="48" rx="8" class="qfig-card" />
    <text x="30" y="195" class="qfig-t">
      <tspan data-lang-en>Total matched: 10,000 shares · UPCoM tick size: 100 VND</tspan>
      <tspan data-lang-vi>Tổng khớp: 10.000 cổ phiếu · Bước giá UPCoM: 100 đồng</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-sbq02up { margin: 0; width: 100%; }
  .qfig-sbq02up svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-sbq02up text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-sbq02up .qfig-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-sbq02up .qfig-t { font-weight: 700; fill: var(--text); }
  .qfig-sbq02up .qfig-b { fill: var(--text-body); }
  .qfig-sbq02up .qfig-m { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-sbq02up .qfig-red { fill: var(--red); }
  .qfig-sbq02up .qfig-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-sbq02up .qfig-card-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
</style>
