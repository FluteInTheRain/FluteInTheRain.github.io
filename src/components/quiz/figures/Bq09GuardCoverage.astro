---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-testing-strategy set 06: which rule of the guarded routes each existing test asserts.
// Rows are the rules, columns are the three tests, the last column says whether any test asserts the rule.
// It shows the suite as it is, not what to add. Inline SVG, site tokens only, no ids.
const rules = [
  { en: 'No token: 401', vi: 'Không có token: 401', hit: [true, false, false] },
  { en: 'Expired token: 401', vi: 'Token hết hạn: 401', hit: [false, false, false] },
  { en: 'Missing scope: 403', vi: 'Thiếu scope: 403', hit: [false, false, false] },
  { en: 'Someone else’s case: 404', vi: 'Case của người khác: 404', hit: [false, true, true] },
];
const cols = [
  { a: { en: 'Test 1', vi: 'Test 1' }, b: { en: 'no token sent', vi: 'không gửi token' } },
  { a: { en: 'Test 2', vi: 'Test 2' }, b: { en: 'own case, as bob', vi: 'case của bob' } },
  { a: { en: 'Test 3', vi: 'Test 3' }, b: { en: 'other case, as bob', vi: 'case người khác' } },
];
const cx = [270, 355, 440];
const y0 = 76;
const gap = 44;
---
<div class="qfig-bq9gc">
  <svg viewBox="0 0 580 270" role="img" aria-label="A grid of four rules of the guarded routes against three tests. Test 1 asserts the no-token rule; tests 2 and 3 assert the other-user rule; the last column says whether any test asserts each rule.">
    <text x="0" y="22" class="qfig-bq9gc-h">
      <tspan data-lang-en>Rule of the guarded routes</tspan>
      <tspan data-lang-vi>Luật của các route có guard</tspan>
    </text>
    {cols.map((c, i) => (
      <g>
        <text x={cx[i]} y="22" text-anchor="middle" class="qfig-bq9gc-h">
          <tspan data-lang-en>{c.a.en}</tspan>
          <tspan data-lang-vi>{c.a.vi}</tspan>
        </text>
        <text x={cx[i]} y="40" text-anchor="middle" class="qfig-bq9gc-m">
          <tspan data-lang-en>{c.b.en}</tspan>
          <tspan data-lang-vi>{c.b.vi}</tspan>
        </text>
      </g>
    ))}
    <text x="540" y="22" text-anchor="middle" class="qfig-bq9gc-h">
      <tspan data-lang-en>Any test?</tspan>
      <tspan data-lang-vi>Có test?</tspan>
    </text>
    {rules.map((r, j) => {
      const y = y0 + j * gap;
      const any = r.hit.some(Boolean);
      return (
        <g>
          <line x1="0" x2="580" y1={y + 22} y2={y + 22} class="qfig-bq9gc-rule" />
          <text x="0" y={y + 5} class="qfig-bq9gc-lane">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          {r.hit.map((h, i) => (
            h ? <DiagramIcon name="ok" x={cx[i]} y={y} size={22} /> : <rect x={cx[i] - 9} y={y - 9} width="18" height="18" rx="4" class="qfig-bq9gc-empty" />
          ))}
          <text x="540" y={y + 5} text-anchor="middle" class={any ? 'qfig-bq9gc-t' : 'qfig-bq9gc-redt'}>
            <tspan data-lang-en>{any ? 'yes' : 'no'}</tspan>
            <tspan data-lang-vi>{any ? 'có' : 'không'}</tspan>
          </text>
        </g>
      );
    })}
  </svg>
</div>

<style>
  .qfig-bq9gc { margin: 0; width: 100%; }
  .qfig-bq9gc svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-bq9gc text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bq9gc .qfig-bq9gc-h { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qfig-bq9gc .qfig-bq9gc-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-bq9gc .qfig-bq9gc-m { fill: var(--text-muted); font-size: 11.5px; }
  .qfig-bq9gc .qfig-bq9gc-t { font-weight: 700; fill: var(--text); }
  .qfig-bq9gc .qfig-bq9gc-redt { font-weight: 700; fill: var(--red); }
  .qfig-bq9gc-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-bq9gc-empty { fill: none; stroke: var(--text-muted); opacity: 0.55; stroke-width: 1.2; stroke-dasharray: 3 3; }
</style>
