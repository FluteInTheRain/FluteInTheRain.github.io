---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for ethics set 05: a lender's quarter. 10,000 applicants go through a model; approved loans
// get a repayment outcome recorded, refused ones never do. Shows only the inputs, not the overall default rate.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
function head(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`;
}
---
<div class="qfig-slg">
  <svg viewBox="0 0 580 350" role="img" aria-label="Ten thousand applicants go through a model. The 4,000 approved loans get a repayment outcome recorded, 160 defaults. The 6,000 refused applicants have no outcome recorded, although their true default rate would be 10 percent.">
    <rect x="0" y="125" width="130" height="64" rx="8" class="qfig-slg-box" />
    <text x="65" y="153" text-anchor="middle" class="qfig-slg-b">
      <tspan data-lang-en>10,000</tspan>
      <tspan data-lang-vi>10.000</tspan>
    </text>
    <text x="65" y="173" text-anchor="middle" class="qfig-slg-m">
      <tspan data-lang-en>applicants</tspan>
      <tspan data-lang-vi>hồ sơ vay</tspan>
    </text>

    <line x1="130" x2="142" y1="157" y2="157" class="qfig-slg-line" />
    <polygon points={head(150, 157)} class="qfig-slg-head" />
    <DiagramIcon name="server" x="168" y="157" size={32} />
    <line x1="186" x2="244" y1="157" y2="157" class="qfig-slg-line" />
    <text x="168" y="192" text-anchor="middle" class="qfig-slg-m">
      <tspan data-lang-en>Model + cutoff</tspan>
      <tspan data-lang-vi>Model + ngưỡng</tspan>
    </text>

    <!-- approved branch -->
    <path d="M 244 157 L 244 66 L 249 66" class="qfig-slg-ok-line" />
    <polygon points={head(258, 66)} class="qfig-slg-ok-head" />
    <rect x="260" y="22" width="320" height="88" rx="8" class="qfig-slg-ok" />
    <text x="276" y="48" class="qfig-slg-b">
      <tspan data-lang-en>Approved: 4,000</tspan>
      <tspan data-lang-vi>Được duyệt: 4.000</tspan>
    </text>
    <text x="276" y="72" class="qfig-slg-t">
      <tspan data-lang-en>Repayment is recorded</tspan>
      <tspan data-lang-vi>Có ghi lại kết quả trả nợ</tspan>
    </text>
    <text x="276" y="95" class="qfig-slg-t">
      <tspan data-lang-en>160 defaults seen (4%)</tspan>
      <tspan data-lang-vi>Thấy 160 ca vỡ nợ (4%)</tspan>
    </text>

    <rect x="260" y="124" width="320" height="34" rx="6" class="qfig-slg-chip" />
    <text x="276" y="146" class="qfig-slg-t">
      <tspan data-lang-en>Next quarter's labels come from these rows</tspan>
      <tspan data-lang-vi>Nhãn quý sau lấy từ các dòng này</tspan>
    </text>

    <!-- refused branch -->
    <path d="M 244 157 L 244 238 L 249 238" class="qfig-slg-bad-line" />
    <polygon points={head(258, 238)} class="qfig-slg-bad-head" />
    <rect x="260" y="188" width="320" height="100" rx="8" class="qfig-slg-bad" />
    <text x="276" y="214" class="qfig-slg-b">
      <tspan data-lang-en>Refused: 6,000</tspan>
      <tspan data-lang-vi>Bị từ chối: 6.000</tspan>
    </text>
    <text x="276" y="238" class="qfig-slg-t">
      <tspan data-lang-en>No repayment is ever recorded</tspan>
      <tspan data-lang-vi>Không bao giờ có kết quả trả nợ</tspan>
    </text>
    <text x="276" y="262" class="qfig-slg-t">
      <tspan data-lang-en>True default would be 10% (600), unseen</tspan>
      <tspan data-lang-vi>Thực tế vỡ nợ sẽ là 10% (600), không thấy</tspan>
    </text>

    <DiagramIcon name="warning" x="14" y="315" size={26} />
    <text x="34" y="320" class="qfig-slg-t">
      <tspan data-lang-en>Employers screen by score: refused applicants lose job offers</tspan>
      <tspan data-lang-vi>Nhà tuyển dụng lọc theo điểm: người bị từ chối mất cơ hội việc làm</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-slg { margin: 0; width: 100%; }
  .qfig-slg svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-slg text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-slg .qfig-slg-b { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-slg .qfig-slg-t { font-weight: 600; fill: var(--text); }
  .qfig-slg .qfig-slg-m { fill: var(--text-muted); }
  .qfig-slg-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-slg-line { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-slg-head { fill: var(--text-muted); }
  .qfig-slg-ok { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.8; }
  .qfig-slg-ok-line { stroke: var(--gold); stroke-width: 2; fill: none; }
  .qfig-slg-ok-head { fill: var(--gold); }
  .qfig-slg-chip { fill: var(--bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-slg-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; stroke-dasharray: 6 4; }
  .qfig-slg-bad-line { stroke: var(--red); stroke-width: 2; fill: none; }
  .qfig-slg-bad-head { fill: var(--red); }
</style>
