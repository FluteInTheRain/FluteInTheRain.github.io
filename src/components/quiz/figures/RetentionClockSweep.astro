---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for ethics set 08: where events of each age sit after the nightly soft-delete job.
// Three lanes (events table, immutable log, backups) over an age axis: today, 30 days, older.
// Shows only the storage layout, no totals and no ratio. Inline SVG, site tokens only, no ids.
const x0 = 176;
const x30 = 304;
const x1 = 566;
const lanes = [
  { y: 92, icon: 'db', en: 'Events table', vi: 'Bảng events' },
  { y: 172, icon: 'log', en: 'Immutable log', vi: 'Log bất biến' },
  { y: 252, icon: 'backup', en: 'Backups', vi: 'Backup' },
];
const h = 46;
function head(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`;
}
---
<div class="qfig-ret">
  <svg viewBox="0 0 580 350" role="img" aria-label="Three storage lanes over event age. The events table has the last 30 days visible and older rows with deleted_at set. The immutable log and the backups cover every age.">
    <text x="0" y="22" class="qfig-ret-h">
      <tspan data-lang-en>Where events of each age sit after the nightly job</tspan>
      <tspan data-lang-vi>Event mỗi độ tuổi nằm ở đâu sau job ban đêm</tspan>
    </text>

    <text x={x0} y="52" class="qfig-ret-m">
      <tspan data-lang-en>newest</tspan>
      <tspan data-lang-vi>mới nhất</tspan>
    </text>
    <text x={x1} y="52" text-anchor="end" class="qfig-ret-m">
      <tspan data-lang-en>oldest</tspan>
      <tspan data-lang-vi>cũ nhất</tspan>
    </text>

    {lanes.map((l) => (
      <g>
        <line x1="0" x2="580" y1={l.y + h / 2 + 18} y2={l.y + h / 2 + 18} class="qfig-ret-rule" />
        <DiagramIcon name={l.icon as any} x="18" y={l.y + h / 2} size={26} />
        <text x="44" y={l.y + h / 2 + 5} class="qfig-ret-lane">
          <tspan data-lang-en>{l.en}</tspan>
          <tspan data-lang-vi>{l.vi}</tspan>
        </text>
      </g>
    ))}

    <!-- 30 day marker -->
    <line x1={x30 + 2} x2={x30 + 2} y1="60" y2="308" class="qfig-ret-cut" />

    <!-- events table -->
    <rect x={x0} y={lanes[0].y} width={x30 - x0} height={h} rx="6" class="qfig-ret-live" />
    <text x={(x0 + x30) / 2} y={lanes[0].y + h / 2 + 5} text-anchor="middle" class="qfig-ret-t">
      <tspan data-lang-en>Last 30 days</tspan>
      <tspan data-lang-vi>30 ngày gần nhất</tspan>
    </text>
    <rect x={x30 + 4} y={lanes[0].y} width={x1 - x30 - 4} height={h} rx="6" class="qfig-ret-old" />
    <text x={(x30 + x1) / 2 + 2} y={lanes[0].y + h / 2 + 5} text-anchor="middle" class="qfig-ret-t">
      <tspan data-lang-en>Rows with deleted_at set</tspan>
      <tspan data-lang-vi>Dòng đã gắn deleted_at</tspan>
    </text>

    <!-- log -->
    <rect x={x0} y={lanes[1].y} width={x1 - x0} height={h} rx="6" class="qfig-ret-full" />
    <text x={(x0 + x1) / 2} y={lanes[1].y + h / 2 + 5} text-anchor="middle" class="qfig-ret-t">
      <tspan data-lang-en>Every raw event, append only</tspan>
      <tspan data-lang-vi>Mọi event thô, chỉ ghi thêm</tspan>
    </text>

    <!-- backups -->
    <rect x={x0} y={lanes[2].y} width={x1 - x0} height={h} rx="6" class="qfig-ret-full" />
    <text x={(x0 + x1) / 2} y={lanes[2].y + h / 2 + 5} text-anchor="middle" class="qfig-ret-t">
      <tspan data-lang-en>Copies of the table and the log</tspan>
      <tspan data-lang-vi>Bản sao của bảng và của log</tspan>
    </text>

    <!-- nightly job -->
    <path d={`M ${x30 + 2} 336 L ${x1 - 8} 336`} class="qfig-ret-flow" />
    <polygon points={head(x1, 336)} class="qfig-ret-flowhead" />
    <text x={x30 + 12} y="322" class="qfig-ret-m">
      <tspan data-lang-en>Nightly job sets deleted_at on these</tspan>
      <tspan data-lang-vi>Job ban đêm gắn deleted_at cho phần này</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-ret { margin: 0; width: 100%; }
  .qfig-ret svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-ret text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-ret .qfig-ret-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-ret .qfig-ret-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-ret .qfig-ret-t { font-size: 13px; font-weight: 600; fill: var(--text); }
  .qfig-ret .qfig-ret-m { font-size: 13px; fill: var(--text-muted); }
  .qfig-ret-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-ret-live { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-ret-old { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .qfig-ret-full { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-ret-cut { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .qfig-ret-flow { stroke: var(--text-muted); stroke-width: 1.6; fill: none; }
  .qfig-ret-flowhead { fill: var(--text-muted); }
</style>
