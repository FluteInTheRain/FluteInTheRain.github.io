---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for set 03: one customer document as it is today (one card field) and as planned
// (a list of cards), plus the five consumers that read the card field and how each reaches the data.
// Inline SVG, site tokens only, no <marker>/<defs>. Shows only the scenario's inputs, no result.
const readers = [
  { icon: 'laptop', en: 'Web checkout', vi: 'Web checkout', viaEn: 'through the API', viaVi: 'qua API', direct: false },
  { icon: 'phone', en: 'Mobile app, old versions', vi: 'App mobile, bản cũ', viaEn: 'through the API', viaVi: 'qua API', direct: false },
  { icon: 'cloud', en: 'Partner API', vi: 'Partner API', viaEn: 'through the API', viaVi: 'qua API', direct: false },
  { icon: 'clock', en: 'Nightly invoicing job', vi: 'Job lập hoá đơn mỗi đêm', viaEn: 'straight from the database', viaVi: 'thẳng từ database', direct: true },
  { icon: 'shield', en: 'Fraud service', vi: 'Fraud service', viaEn: 'straight from the database', viaVi: 'thẳng từ database', direct: true },
] as const;
const top = 214;
const rowH = 46;
---
<div class="qfig-fta">
  <svg viewBox="0 0 580 480" role="img" aria-label="A customer document with one card field, next to the planned version with a list of cards. Below, five consumers read the card field: three through the API and two straight from the database.">
    <text x="0" y="22" class="qfig-fta-h">
      <tspan data-lang-en>One document per customer</tspan>
      <tspan data-lang-vi>Mỗi khách một document</tspan>
    </text>

    <g class="qfig-fta-doc">
      <rect x="0" y="40" width="240" height="124" rx="8" />
      <text x="14" y="64" class="qfig-fta-t">
        <tspan data-lang-en>Today</tspan>
        <tspan data-lang-vi>Hiện tại</tspan>
      </text>
      <DiagramIcon name="db" x="212" y="62" size={24} />
      <text x="14" y="92">customer: 1042</text>
      <text x="14" y="116">card: {'{'} last4: 4242 {'}'}</text>
      <text x="14" y="146" class="qfig-fta-m">
        <tspan data-lang-en>One value</tspan>
        <tspan data-lang-vi>Một giá trị</tspan>
      </text>
    </g>

    <path d="M 252 102 L 318 102" class="qfig-fta-arrow" />
    <polygon points="328,102 317,96 317,108" class="qfig-fta-head" />

    <g class="qfig-fta-doc qfig-fta-plan">
      <rect x="340" y="40" width="240" height="124" rx="8" />
      <text x="354" y="64" class="qfig-fta-t">
        <tspan data-lang-en>Planned</tspan>
        <tspan data-lang-vi>Dự định</tspan>
      </text>
      <DiagramIcon name="db" x="552" y="62" size={24} />
      <text x="354" y="92">customer: 1042</text>
      <text x="354" y="116">cards: [ {'{'} 4242 {'}'}, {'{'} 1881 {'}'} ]</text>
      <text x="354" y="146" class="qfig-fta-m">
        <tspan data-lang-en>A list of values</tspan>
        <tspan data-lang-vi>Một danh sách giá trị</tspan>
      </text>
    </g>

    <line x1="0" x2="580" y1="184" y2="184" class="qfig-fta-rule" />
    <text x="0" y="206" class="qfig-fta-h">
      <tspan data-lang-en>Five consumers read the card field today</tspan>
      <tspan data-lang-vi>Năm consumer đang đọc trường card</tspan>
    </text>

    {readers.map((r, i) => {
      const y = top + 10 + i * rowH;
      return (
        <g class="qfig-fta-row">
          <rect x="0" y={y} width="580" height={rowH - 8} rx="7" />
          <DiagramIcon name={r.icon} x="26" y={y + (rowH - 8) / 2} size={24} />
          <text x="56" y={y + 24} class="qfig-fta-n">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          <text x="566" y={y + 24} text-anchor="end" class="qfig-fta-m">
            <tspan data-lang-en>{r.viaEn}</tspan>
            <tspan data-lang-vi>{r.viaVi}</tspan>
          </text>
        </g>
      );
    })}

    <text x="0" y="472" class="qfig-fta-m">
      <tspan data-lang-en>Old app versions stay in use for weeks.</tspan>
      <tspan data-lang-vi>Các bản app cũ vẫn dùng thêm nhiều tuần.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-fta { margin: 0; width: 100%; }
  .qfig-fta svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-fta text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-fta .qfig-fta-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-fta .qfig-fta-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-fta .qfig-fta-n { font-size: 15px; font-weight: 600; fill: var(--text); }
  .qfig-fta .qfig-fta-m { fill: var(--text-muted); }
  .qfig-fta-doc rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-fta-plan rect { stroke: var(--act-2); stroke-width: 1.8; }
  .qfig-fta-arrow { stroke: var(--text-muted); stroke-width: 2; fill: none; }
  .qfig-fta-head { fill: var(--text-muted); }
  .qfig-fta-rule { stroke: var(--border); }
  .qfig-fta-row rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
</style>
