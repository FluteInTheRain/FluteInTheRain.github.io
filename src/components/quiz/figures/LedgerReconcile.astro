---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for unbundling set 08: an airline flight (180 seats, 189 tickets at $240, 0.92 show-up chance)
// whose sales go into an event log, from which a seat map and a revenue ledger are built a little behind it.
// It does not show any check, apology or computed result. Inline SVG, site tokens only, no <marker>/<defs>/ids.
function head(x: number, y: number) {
  return `${x},${y} ${x - 10},${y - 5} ${x - 10},${y + 5}`;
}
const tiles = [
  { x: 0, big: '180', en: 'seats', vi: 'ghế' },
  { x: 202, big: '189', en: 'tickets sold at $240', vi: 'vé bán giá $240' },
  { x: 404, big: '0.92', bigVi: '0,92', en: 'chance each holder shows up', vi: 'xác suất mỗi người đến' },
];
const rows = [
  { y: 168, en: 'Sale 1 · $240', vi: 'Lần bán 1 · $240' },
  { y: 194, en: 'Sale 2 · $240', vi: 'Lần bán 2 · $240' },
  { y: 220, en: 'Sale 3 · $240', vi: 'Lần bán 3 · $240' },
  { y: 268, en: 'Sale 189 · $240', vi: 'Lần bán 189 · $240' },
];
---
<div class="qfig-led">
  <svg viewBox="0 0 580 340" role="img" aria-label="A flight with 180 seats and 189 tickets sold at $240 feeds a log of sale events, from which a seat map and a revenue ledger are built.">
    <text x="0" y="20" class="qfig-led-h">
      <tspan data-lang-en>One flight, one log, two views</tspan>
      <tspan data-lang-vi>Một chuyến bay, một log, hai view</tspan>
    </text>

    {tiles.map((t) => (
      <g>
        <rect x={t.x} y="34" width="176" height="64" rx="8" class="qfig-led-tile" />
        <text x={t.x + 88} y="62" text-anchor="middle" class="qfig-led-big"><tspan data-lang-en>{t.big}</tspan><tspan data-lang-vi>{t.bigVi ?? t.big}</tspan></text>
        <text x={t.x + 88} y="85" text-anchor="middle" class="qfig-led-m">
          <tspan data-lang-en>{t.en}</tspan>
          <tspan data-lang-vi>{t.vi}</tspan>
        </text>
      </g>
    ))}

    <!-- log -->
    <rect x="0" y="116" width="250" height="200" rx="10" class="qfig-led-panel" />
    <DiagramIcon name="log" x="26" y="140" size="26" />
    <text x="50" y="145" class="qfig-led-lane">
      <tspan data-lang-en>Event log</tspan>
      <tspan data-lang-vi>Event log</tspan>
    </text>
    {rows.map((r) => (
      <g>
        <rect x="16" y={r.y - 14} width="218" height="22" rx="5" class="qfig-led-row" />
        <text x="28" y={r.y + 2} class="qfig-led-t">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
      </g>
    ))}
    <text x="125" y="250" text-anchor="middle" class="qfig-led-m">…</text>

    <!-- arrows -->
    <path d="M 250 170 L 316 170" class="qfig-led-flow" />
    <polygon points={head(330, 170)} class="qfig-led-flowhead" />
    <path d="M 250 262 L 316 262" class="qfig-led-flow" />
    <polygon points={head(330, 262)} class="qfig-led-flowhead" />

    <!-- seat map -->
    <rect x="340" y="132" width="240" height="76" rx="10" class="qfig-led-panel" />
    <DiagramIcon name="eye" x="372" y="170" size="28" />
    <text x="400" y="164" class="qfig-led-lane">
      <tspan data-lang-en>Seat map</tspan>
      <tspan data-lang-vi>Seat map</tspan>
    </text>
    <text x="400" y="187" class="qfig-led-t">
      <tspan data-lang-en>Which seats are free</tspan>
      <tspan data-lang-vi>Ghế nào còn trống</tspan>
    </text>

    <!-- ledger -->
    <rect x="340" y="224" width="240" height="76" rx="10" class="qfig-led-panel" />
    <DiagramIcon name="receipt" x="372" y="262" size="28" />
    <text x="400" y="256" class="qfig-led-lane">
      <tspan data-lang-en>Ledger</tspan>
      <tspan data-lang-vi>Ledger</tspan>
    </text>
    <text x="400" y="279" class="qfig-led-t">
      <tspan data-lang-en>Revenue: $45,360</tspan>
      <tspan data-lang-vi>Doanh thu: $45.360</tspan>
    </text>

    <text x="460" y="326" text-anchor="middle" class="qfig-led-m">
      <tspan data-lang-en>Both views trail the log slightly</tspan>
      <tspan data-lang-vi>Cả hai view hơi trễ so với log</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-led { margin: 0; width: 100%; }
  .qfig-led svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-led text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-led .qfig-led-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-led .qfig-led-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-led .qfig-led-big { font-size: 24px; font-weight: 700; fill: var(--text); }
  .qfig-led .qfig-led-t { font-weight: 600; fill: var(--text); }
  .qfig-led .qfig-led-m { font-size: 13px; fill: var(--text-muted); }
  .qfig-led-tile { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-led-panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-led-row { fill: var(--bg); stroke: var(--border); stroke-width: 1; }
  .qfig-led-flow { stroke: var(--gold); stroke-width: 2.2; fill: none; }
  .qfig-led-flowhead { fill: var(--gold); }
</style>
