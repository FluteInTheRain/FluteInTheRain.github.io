---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for distributed systems set 04: top compares Cloudflare's Jan 1, 2017 leap-second backward step
// and a quartz crystal drifting at 200 ppm while NTP stalls for 12 hours (0.05% max slew);
// bottom traces two causally ordered LWW writes across skewed clocks (+2 ms vs -3 ms) arriving at Replica 2.
// Shows only scenario inputs, never computed drift/slew time or the LWW winner.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.

const W = 580;
const H = 408;

function arrow(x1: number, y1: number, x2: number, y2: number, head = 8) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - head * Math.cos(a - 0.45), y2 - head * Math.sin(a - 0.45)];
  const p2 = [x2 - head * Math.cos(a + 0.45), y2 - head * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - (head - 2) * Math.cos(a)} ${y2 - (head - 2) * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const causalArrow = arrow(118, 294, 118, 326, 7);
const toRep1 = arrow(332, 260, 396, 286, 8);
const toRep3 = arrow(332, 360, 396, 334, 8);
---
<div class="qfig-cds">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: Cloudflare's January 1, 2017 1-second backward leap step in pre-1.9 Go time.Now() next to a quartz clock running 200 ppm fast during a 12-hour NTP stall with a 0.05% slew cap. Bottom: Client A writes x = 1 on Node 1 (+2 ms fast, stamped 42.004 s), then Client B reads x = 1 and writes x = 2 on Node 3 (-3 ms slow, stamped 42.003 s), both reaching Replica 2 under Last-Write-Wins.">
    <text x="0" y="20" class="qfig-cds-h">
      <tspan data-lang-en>Wall-clock jumps and quartz drift inputs</tspan>
      <tspan data-lang-vi>Nhảy giờ thực và thông số trôi thạch anh</tspan>
    </text>

    <!-- Top left: Cloudflare 2017 -->
    <rect x="0" y="34" width="282" height="114" rx="7" class="qfig-cds-hot" />
    <DiagramIcon name="cloudflare" x={22} y={56} size={22} />
    <text x="40" y="61" class="qfig-cds-t">
      <tspan data-lang-en>Cloudflare · Jan 1, 2017</tspan>
      <tspan data-lang-vi>Cloudflare · 1/1/2017</tspan>
    </text>
    <text x="12" y="84" class="qfig-cds-b">
      <tspan data-lang-en>00:00 UTC: 1 s leap step back</tspan>
      <tspan data-lang-vi>00:00 UTC: giây nhuận lùi 1 giây</tspan>
    </text>
    <text x="12" y="104" class="qfig-cds-b">
      <tspan data-lang-en>Pre-1.9 Go time.Now() -&gt; rand.Int63n()</tspan>
      <tspan data-lang-vi>Go &lt;1.9: time.Now() -&gt; rand.Int63n()</tspan>
    </text>
    <text x="12" y="126" class="qfig-cds-m">
      <tspan data-lang-en>~0.2% DNS · &lt;1% HTTP · 102 DCs (06:45)</tspan>
      <tspan data-lang-vi>~0,2% DNS · &lt;1% HTTP · 102 DC (06:45)</tspan>
    </text>

    <!-- Top right: Quartz drift + NTP slew -->
    <rect x="298" y="34" width="282" height="114" rx="7" class="qfig-cds-box" />
    <DiagramIcon name="clock" x={320} y={56} size={22} />
    <text x="338" y="61" class="qfig-cds-t">
      <tspan data-lang-en>Quartz drift + NTP slew</tspan>
      <tspan data-lang-vi>Trôi thạch anh + chỉnh tốc NTP</tspan>
    </text>
    <text x="310" y="84" class="qfig-cds-b">
      <tspan data-lang-en>Quartz oscillator: 200 ppm fast</tspan>
      <tspan data-lang-vi>Thạch anh: chạy nhanh 200 ppm</tspan>
    </text>
    <text x="310" y="104" class="qfig-cds-b">
      <tspan data-lang-en>NTP stalled: 12 hours (43,200 s)</tspan>
      <tspan data-lang-vi>NTP ngắt đồng bộ: 12 giờ (43.200 giây)</tspan>
    </text>
    <text x="310" y="126" class="qfig-cds-m">
      <tspan data-lang-en>NTP slew limit: max 0.05% rate</tspan>
      <tspan data-lang-vi>Ngưỡng chỉnh tốc NTP: tối đa 0,05%</tspan>
    </text>

    <line x1="0" x2={W} y1="168" y2="168" class="qfig-cds-rule" />

    <!-- Bottom: LWW across skewed nodes -->
    <text x="0" y="192" class="qfig-cds-h">
      <tspan data-lang-en>LWW trace across skewed nodes</tspan>
      <tspan data-lang-vi>Luồng ghi LWW khi hai node lệch đồng hồ</tspan>
    </text>
    <text x="0" y="210" class="qfig-cds-m">
      <tspan data-lang-en>Client B reads x = 1 from Node 1 before writing x = 2 to Node 3</tspan>
      <tspan data-lang-vi>Client B đọc x = 1 từ Node 1 rồi mới ghi x = 2 vào Node 3</tspan>
    </text>

    <!-- Node 1 -->
    <rect x="0" y="226" width="332" height="66" rx="7" class="qfig-cds-box" />
    <DiagramIcon name="server" x={22} y={248} size={22} />
    <text x="40" y="253" class="qfig-cds-t">Node 1</text>
    <rect x="108" y="236" width="106" height="22" rx="5" class="qfig-cds-chip" />
    <text x="161" y="251" text-anchor="middle" class="qfig-cds-red">
      <tspan data-lang-en>+2 ms fast</tspan>
      <tspan data-lang-vi>nhanh +2 ms</tspan>
    </text>
    <text x="12" y="278" class="qfig-cds-b">
      <tspan data-lang-en>Client A writes x = 1 · stamp 42.004 s</tspan>
      <tspan data-lang-vi>Client A ghi x = 1 · dấu giờ 42,004 s</tspan>
    </text>

    <!-- Causal arrow -->
    <g class="qfig-cds-goldarrow"><path d={causalArrow.line} /><polygon points={causalArrow.head} /></g>
    <text x="130" y="314" class="qfig-cds-goldt">
      <tspan data-lang-en>causal order: B reads x = 1 first</tspan>
      <tspan data-lang-vi>nhân quả: B đọc x = 1 trước</tspan>
    </text>

    <!-- Node 3 -->
    <rect x="0" y="328" width="332" height="66" rx="7" class="qfig-cds-box" />
    <DiagramIcon name="server" x={22} y={350} size={22} />
    <text x="40" y="355" class="qfig-cds-t">Node 3</text>
    <rect x="108" y="338" width="106" height="22" rx="5" class="qfig-cds-chip" />
    <text x="161" y="353" text-anchor="middle" class="qfig-cds-red">
      <tspan data-lang-en>-3 ms slow</tspan>
      <tspan data-lang-vi>chậm -3 ms</tspan>
    </text>
    <text x="12" y="380" class="qfig-cds-b">
      <tspan data-lang-en>Client B writes x = 2 · stamp 42.003 s</tspan>
      <tspan data-lang-vi>Client B ghi x = 2 · dấu giờ 42,003 s</tspan>
    </text>

    <!-- Arrows to Replica 2 -->
    <g class="qfig-cds-arrow"><path d={toRep1.line} /><polygon points={toRep1.head} /></g>
    <g class="qfig-cds-arrow"><path d={toRep3.line} /><polygon points={toRep3.head} /></g>

    <!-- Replica 2 -->
    <rect x="398" y="242" width="182" height="136" rx="8" class="qfig-cds-box" />
    <DiagramIcon name="db" x={489} y={272} size={28} />
    <text x="489" y="304" text-anchor="middle" class="qfig-cds-t">Replica 2</text>
    <text x="489" y="326" text-anchor="middle" class="qfig-cds-m">
      <tspan data-lang-en>LWW: keeps larger ts</tspan>
      <tspan data-lang-vi>LWW: giữ dấu giờ lớn hơn</tspan>
    </text>
    <rect x="424" y="340" width="130" height="26" rx="5" class="qfig-cds-qbox" />
    <text x="489" y="357" text-anchor="middle" class="qfig-cds-t">
      <tspan data-lang-en>Kept value: ?</tspan>
      <tspan data-lang-vi>Giá trị giữ lại: ?</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-cds { margin: 0; width: 100%; }
  .qfig-cds svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-cds text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-cds .qfig-cds-h { font-size: 15.5px; font-weight: 700; fill: var(--text); }
  .qfig-cds .qfig-cds-t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-cds .qfig-cds-b { font-size: 12.5px; font-weight: 600; fill: var(--text); }
  .qfig-cds .qfig-cds-m { font-size: 12px; fill: var(--text-muted); }
  .qfig-cds .qfig-cds-red { font-size: 12px; font-weight: 700; fill: var(--red); }
  .qfig-cds .qfig-cds-goldt { font-size: 12.5px; font-weight: 700; fill: var(--gold-icon); }
  .qfig-cds-rule { stroke: var(--border); stroke-width: 1.2; }
  .qfig-cds-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-cds-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-cds-chip { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
  .qfig-cds-qbox { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-cds-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.6; }
  .qfig-cds-arrow polygon { fill: var(--text-muted); }
  .qfig-cds-goldarrow path { fill: none; stroke: var(--gold-icon); stroke-width: 1.8; }
  .qfig-cds-goldarrow polygon { fill: var(--gold-icon); }
</style>
