---
// Quiz figure for the images post quiz (Uxq07).
---
<div class="qfig-uxq07edgebleed">
  <svg viewBox="0 0 600 240" role="img" aria-label="Three product cards. Left: a white-backdrop photo on a white card with no visible edge. Middle: the same photo with a faint inner ring. Right: a dark photo on the same white card.">
    <rect x="0.6" y="0.6" width="598.8" height="238.8" fill="#ffffff" stroke="var(--border)" stroke-width="1.2" />
    <rect x="20" y="20" width="170" height="150" fill="#ffffff" />
    <rect x="36" y="34" width="138" height="118" fill="#ffffff" />
    <g transform="translate(105 93)" fill="none" stroke="#8a8f98" stroke-width="2"><rect x="-34" y="-20" width="68" height="44" rx="6" /><circle cx="0" cy="2" r="14" /><rect x="-12" y="-28" width="24" height="8" rx="2" /></g>
    <text x="105" y="200" text-anchor="middle" class="m"><tspan data-lang-en>No ring</tspan><tspan data-lang-vi>Không viền</tspan></text>
    <rect x="215" y="20" width="170" height="150" fill="#ffffff" />
    <rect x="231" y="34" width="138" height="118" fill="#ffffff" stroke="#000000" stroke-opacity="0.1" stroke-width="2" />
    <g transform="translate(300 93)" fill="none" stroke="#8a8f98" stroke-width="2"><rect x="-34" y="-20" width="68" height="44" rx="6" /><circle cx="0" cy="2" r="14" /><rect x="-12" y="-28" width="24" height="8" rx="2" /></g>
    <text x="300" y="200" text-anchor="middle" class="m"><tspan data-lang-en>Inner ring</tspan><tspan data-lang-vi>Viền chìm</tspan></text>
    <rect x="410" y="20" width="170" height="150" fill="#ffffff" />
    <rect x="426" y="34" width="138" height="118" fill="#1a1a1a" />
    <g transform="translate(495 93)" fill="none" stroke="#c8ccd2" stroke-width="2"><rect x="-34" y="-20" width="68" height="44" rx="6" /><circle cx="0" cy="2" r="14" /><rect x="-12" y="-28" width="24" height="8" rx="2" /></g>
    <text x="495" y="200" text-anchor="middle" class="m"><tspan data-lang-en>Dark photo</tspan><tspan data-lang-vi>Ảnh tối</tspan></text>
  </svg>
</div>

<style>
  .qfig-uxq07edgebleed { margin: 0; width: 100%; }
  .qfig-uxq07edgebleed svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq07edgebleed text { font-size: 13.5px; fill: var(--text-body); }
  .qfig-uxq07edgebleed .h { font-weight: 700; fill: var(--text); }
  .qfig-uxq07edgebleed .m { fill: var(--text-muted); font-size: 13px; }
  .qfig-uxq07edgebleed .mono { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; fill: var(--text-muted); }
  .qfig-uxq07edgebleed .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq07edgebleed .bar { fill: var(--border); }
  .qfig-uxq07edgebleed .ln { stroke: var(--text-muted); stroke-width: 1.4; fill: none; }
  .qfig-uxq07edgebleed .acc { stroke: var(--red); stroke-width: 2; fill: none; }
  .qfig-uxq07edgebleed .accf { fill: var(--red); }
  .qfig-uxq07edgebleed .dash { stroke: var(--red); stroke-width: 2; stroke-dasharray: 6 4; fill: none; }
  .qfig-uxq07edgebleed .ico { stroke: var(--text); fill: none; stroke-linecap: round; stroke-linejoin: round; }
</style>
