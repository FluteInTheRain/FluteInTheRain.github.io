---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for set 08: a refund workflow recorded in a history (timer, charge back, publish),
// and the topic it publishes to, with a schema registry and three consumers.
// Inline SVG, site tokens only, no <marker>/<defs>. Shows only the scenario's inputs, no answers.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 7 * Math.cos(a)} ${y2 - 7 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const steps = [
  { x: 0, icon: 'clock', en: 'Timer', vi: 'Timer', den: '24 hours', dvi: '24 giờ' },
  { x: 205, icon: 'card', en: 'Charge back', vi: 'Trừ thẻ lại', den: 'activity', dvi: 'activity' },
  { x: 410, icon: 'mail', en: 'Publish', vi: 'Publish', den: 'RefundIssued', dvi: 'RefundIssued' },
];
const sw = 170;
const sy = 60;
const sh = 74;
const stepArrows = [arrow(sw + 2, sy + sh / 2, 205 - 3, sy + sh / 2), arrow(205 + sw + 2, sy + sh / 2, 410 - 3, sy + sh / 2)];
const cons = [
  { x: 0, icon: 'db', en: 'Ledger', vi: 'Ledger' },
  { x: 205, icon: 'mail', en: 'Email', vi: 'Email' },
  { x: 410, icon: 'chart', en: 'Analytics', vi: 'Analytics' },
];
const topicY = 330;
const consY = 420;
const cxs = [85, 290, 495];
const toCons = cxs.map((cx) => arrow(290, topicY + 52, cx, consY - 3));
const toTopic = arrow(290, 262, 290, topicY - 3);
---
<div class="qfig-rb">
  <svg viewBox="0 0 580 500" role="img" aria-label="A refund workflow history with three recorded steps: a 24 hour timer, a charge back, and a published message. 2,000 runs are waiting at the timer. Below, the message goes to the refunds topic, guarded by a schema registry, and three services read it.">
    <text x="0" y="22" class="qfig-rb-h">
      <tspan data-lang-en>History of one refund, in order</tspan>
      <tspan data-lang-vi>Lịch sử của một khoản hoàn, theo thứ tự</tspan>
    </text>

    {steps.map((s, i) => (
      <g class="qfig-rb-step">
        <rect x={s.x} y={sy} width={sw} height={sh} rx="8" />
        <text x={s.x + 12} y={sy + 22} class="qfig-rb-n">{i + 1}</text>
        <DiagramIcon name={s.icon} x={s.x + 40} y={sy + 38} size={26} />
        <text x={s.x + 62} y={sy + 34} class="qfig-rb-t">
          <tspan data-lang-en>{s.en}</tspan>
          <tspan data-lang-vi>{s.vi}</tspan>
        </text>
        <text x={s.x + 62} y={sy + 56} class="qfig-rb-m">
          <tspan data-lang-en>{s.den}</tspan>
          <tspan data-lang-vi>{s.dvi}</tspan>
        </text>
      </g>
    ))}
    {stepArrows.map((a) => (
      <g class="qfig-rb-go"><path d={a.line} /><polygon points={a.head} /></g>
    ))}

    <g class="qfig-rb-wait">
      <rect x="0" y="158" width="290" height="34" rx="17" />
      <DiagramIcon name="hourglass" x="24" y="175" size={22} />
      <text x="46" y="180">
        <tspan data-lang-en>2,000 runs waiting at step 1</tspan>
        <tspan data-lang-vi>2.000 lần chạy đang chờ ở bước 1</tspan>
      </text>
    </g>

    <g class="qfig-rb-note">
      <DiagramIcon name="worker" x="20" y="226" size={26} />
      <text x="44" y="224">
        <tspan data-lang-en>After a crash or a deploy, the worker runs the code again</tspan>
        <tspan data-lang-vi>Sau sự cố hoặc deploy, worker chạy lại code</tspan>
      </text>
      <text x="44" y="244">
        <tspan data-lang-en>from the start and reads this history.</tspan>
        <tspan data-lang-vi>từ đầu và đọc lịch sử này.</tspan>
      </text>
    </g>

    <g class="qfig-rb-go"><path d={toTopic.line} /><polygon points={toTopic.head} /></g>
    <line x1="0" x2="580" y1="285" y2="285" class="qfig-rb-rule" />
    <text x="0" y="312" class="qfig-rb-h">
      <tspan data-lang-en>The message on its way</tspan>
      <tspan data-lang-vi>Message trên đường đi</tspan>
    </text>

    <g class="qfig-rb-topic">
      <rect x="110" y={topicY} width="360" height="52" rx="8" />
      <DiagramIcon name="kafka" x="140" y={topicY + 26} size={28} />
      <text x="166" y={topicY + 24} class="qfig-rb-t">
        <tspan data-lang-en>Topic refunds</tspan>
        <tspan data-lang-vi>Topic refunds</tspan>
      </text>
      <text x="166" y={topicY + 42} class="qfig-rb-m">
        <tspan data-lang-en>keeps messages for months</tspan>
        <tspan data-lang-vi>giữ message nhiều tháng</tspan>
      </text>
    </g>
    <g class="qfig-rb-reg">
      <rect x="350" y={topicY - 20} width="230" height="26" rx="13" />
      <DiagramIcon name="shield" x="366" y={topicY - 7} size={18} />
      <text x="380" y={topicY - 3}>
        <tspan data-lang-en>Schema registry checks</tspan>
        <tspan data-lang-vi>Schema registry kiểm tra</tspan>
      </text>
    </g>

    {toCons.map((a) => (
      <g class="qfig-rb-go"><path d={a.line} /><polygon points={a.head} /></g>
    ))}
    {cons.map((c) => (
      <g class="qfig-rb-cons">
        <rect x={c.x} y={consY} width={sw} height="56" rx="8" />
        <DiagramIcon name={c.icon} x={c.x + 28} y={consY + 28} size={26} />
        <text x={c.x + 54} y={consY + 33} class="qfig-rb-t">
          <tspan data-lang-en>{c.en}</tspan>
          <tspan data-lang-vi>{c.vi}</tspan>
        </text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-rb { margin: 0; width: 100%; }
  .qfig-rb svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-rb text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-rb .qfig-rb-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-rb .qfig-rb-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-rb .qfig-rb-n { font-size: 15px; font-weight: 700; fill: var(--text-muted); }
  .qfig-rb .qfig-rb-m { fill: var(--text-muted); }
  .qfig-rb-step rect, .qfig-rb-cons rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-rb-go path { stroke: var(--act-2); stroke-width: 1.8; fill: none; }
  .qfig-rb-go polygon { fill: var(--act-2); }
  .qfig-rb-wait rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-rb .qfig-rb-wait text { font-weight: 600; fill: var(--text); }
  .qfig-rb-rule { stroke: var(--border); }
  .qfig-rb-topic rect { fill: var(--bg-alt); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-rb-reg rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-rb .qfig-rb-reg text { font-size: 13px; font-weight: 600; fill: var(--text); }
</style>
