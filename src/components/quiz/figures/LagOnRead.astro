---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for replication set 01: a time axis (0 to 5 s) with four lanes: the phone, the leader,
// follower 1 and follower 2. Shows when each replica applied the saved change and when the phone reloaded.
// It does not say which replica served the reload. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const x0 = 170; // time 0
const px = 80; // pixels per second
const tx = (s: number) => x0 + s * px;
const lanes = { phone: 66, leader: 136, f1: 206, f2: 276 };
const axisY = 322;
const ticks = [0, 1, 2, 3, 4, 5];
const reloadX = tx(0.3);
const f1X = tx(0.1);
const f2X = tx(4);
function head(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`;
}
---
<div class="qfig-lag">
  <svg viewBox="0 0 580 350" role="img" aria-label="A time axis from 0 to 5 seconds with four lanes: the phone saves a new name at 0 s and reloads at 0.3 s; the leader stores it at once; follower 1 applies it at 0.1 s; follower 2 applies it at 4 s.">
    <text x="0" y="22" class="qfig-lag-h">
      <tspan data-lang-en>One save, as each machine sees it</tspan>
      <tspan data-lang-vi>Một lần lưu, nhìn từ từng máy</tspan>
    </text>

    <line x1={reloadX} x2={reloadX} y1="40" y2={axisY} class="qfig-lag-reload" />

    {[
      { y: lanes.phone, icon: 'phone', en: 'Phone', vi: 'Điện thoại' },
      { y: lanes.leader, icon: 'server', en: 'Leader', vi: 'Leader' },
      { y: lanes.f1, icon: 'server', en: 'Follower 1', vi: 'Follower 1' },
      { y: lanes.f2, icon: 'server', en: 'Follower 2', vi: 'Follower 2' },
    ].map((l) => (
      <g>
        <line x1="0" x2="580" y1={l.y + 30} y2={l.y + 30} class="qfig-lag-rule" />
        <DiagramIcon name={l.icon as any} x="18" y={l.y} size={26} />
        <text x="44" y={l.y + 5} class="qfig-lag-lane">
          <tspan data-lang-en>{l.en}</tspan>
          <tspan data-lang-vi>{l.vi}</tspan>
        </text>
      </g>
    ))}

    <!-- phone -->
    <circle cx={tx(0)} cy={lanes.phone} r="6" class="qfig-lag-dot" />
    <text x={tx(0) + 6} y={lanes.phone - 14} text-anchor="end" class="qfig-lag-t">
      <tspan data-lang-en>Saves the new name</tspan>
      <tspan data-lang-vi>Lưu tên mới</tspan>
    </text>
    <circle cx={reloadX} cy={lanes.phone} r="6" class="qfig-lag-dot2" />
    <text x={reloadX + 12} y={lanes.phone + 21} class="qfig-lag-t">
      <tspan data-lang-en>Reloads the profile at 0.3 s</tspan>
      <tspan data-lang-vi>Tải lại hồ sơ lúc 0,3 giây</tspan>
    </text>

    <!-- leader -->
    <circle cx={tx(0)} cy={lanes.leader} r="6" class="qfig-lag-dot" />
    <text x={reloadX + 12} y={lanes.leader + 5} class="qfig-lag-t">
      <tspan data-lang-en>Stores it, replies "saved" at once</tspan>
      <tspan data-lang-vi>Lưu xong, báo "saved" ngay</tspan>
    </text>

    <!-- follower 1 -->
    <circle cx={f1X} cy={lanes.f1} r="6" class="qfig-lag-dot" />
    <text x={reloadX + 12} y={lanes.f1 + 5} class="qfig-lag-t">
      <tspan data-lang-en>Applies the change at 0.1 s</tspan>
      <tspan data-lang-vi>Áp dụng thay đổi lúc 0,1 giây</tspan>
    </text>

    <!-- follower 2 -->
    <path d={`M ${tx(0) + 7} ${lanes.f2} L ${f2X - 8} ${lanes.f2}`} class="qfig-lag-flow" />
    <polygon points={head(f2X - 7, lanes.f2)} class="qfig-lag-flowhead" />
    <circle cx={f2X} cy={lanes.f2} r="6" class="qfig-lag-dot" />
    <text x={(tx(0) + f2X) / 2} y={lanes.f2 - 12} text-anchor="middle" class="qfig-lag-m">
      <tspan data-lang-en>change still on its way</tspan>
      <tspan data-lang-vi>thay đổi vẫn đang trên đường tới</tspan>
    </text>
    <text x={f2X} y={lanes.f2 + 22} text-anchor="middle" class="qfig-lag-t">
      <tspan data-lang-en>Applies it at 4 s</tspan>
      <tspan data-lang-vi>Áp dụng lúc 4 giây</tspan>
    </text>

    <!-- axis -->
    <line x1={tx(0)} x2={tx(5)} y1={axisY} y2={axisY} class="qfig-lag-axis" />
    {ticks.map((s) => (
      <g>
        <line x1={tx(s)} x2={tx(s)} y1={axisY} y2={axisY + 5} class="qfig-lag-axis" />
        <text x={tx(s)} y={axisY + 21} text-anchor="middle" class="qfig-lag-m">{s}</text>
      </g>
    ))}
    <text x={tx(5) + 14} y={axisY + 21} class="qfig-lag-m">
      <tspan data-lang-en>s</tspan>
      <tspan data-lang-vi>giây</tspan>
    </text>
    <text x="0" y={axisY + 21} class="qfig-lag-m">
      <tspan data-lang-en>Time since the save</tspan>
      <tspan data-lang-vi>Thời gian từ lúc lưu</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-lag { margin: 0; width: 100%; }
  .qfig-lag svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-lag text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-lag .qfig-lag-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-lag .qfig-lag-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-lag .qfig-lag-t { font-weight: 600; fill: var(--text); }
  .qfig-lag .qfig-lag-m { fill: var(--text-muted); }
  .qfig-lag-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-lag-reload { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .qfig-lag-dot { fill: var(--gold); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-lag-dot2 { fill: var(--bg); stroke: var(--text); stroke-width: 2; }
  .qfig-lag-flow { stroke: var(--gold); stroke-width: 2; fill: none; }
  .qfig-lag-flowhead { fill: var(--gold); }
  .qfig-lag-axis { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
