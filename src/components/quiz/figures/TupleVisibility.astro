---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 04 (transactions): the stock table with inserted_by / deleted_by, the status of each txid,
// and the reader (transaction 50) with the list of transactions that were open when it began.
// Shows only the inputs of the scenario, never which rows are visible. Inline SVG, site tokens, no ids.
const rows = [
  { id: 'r1', item: 'shirt', qty: '12', ins: '38', del: '44' },
  { id: 'r2', item: 'shirt', qty: '10', ins: '44', del: '46' },
  { id: 'r3', item: 'shirt', qty: '7', ins: '46', del: '' },
  { id: 'r4', item: 'mug', qty: '30', ins: '40', del: '43' },
  { id: 'r5', item: 'mug', qty: '25', ins: '43', del: '' },
  { id: 'r6', item: 'hat', qty: '5', ins: '47', del: '51' },
  { id: 'r7', item: 'hat', qty: '4', ins: '51', del: '' },
];
const top = 34;
const rh = 28;
const cx = { id: 14, item: 70, qty: 190, ins: 290, del: 430 };
const tEnd = top + rh * (rows.length + 1);
const groups = [
  { label: 'Committed', vi: 'Đã commit', ids: ['38', '40', '44', '47'], cls: 'c' },
  { label: 'Aborted', vi: 'Đã abort', ids: ['43'], cls: 'a' },
  { label: 'Still open when 50 began', vi: 'Còn đang chạy khi 50 bắt đầu', ids: ['46', '48'], cls: 'o' },
  { label: 'Started after 50, committed', vi: 'Bắt đầu sau 50, đã commit', ids: ['51'], cls: 'c' },
];
const gy = tEnd + 62;
const gh = 34;
const H = gy + gh * groups.length + 44;
---
<div class="qfig-tv">
  <svg viewBox={`0 0 580 ${H}`} role="img" aria-label="Table stock with seven row versions and their inserted_by and deleted_by txids, the status of each transaction, and transaction 50 as the reader.">
    <DiagramIcon name="db" x="14" y="12" size={22} />
    <text x="36" y="18" class="qfig-tv-h">
      <tspan data-lang-en>Table stock: every version of every row</tspan>
      <tspan data-lang-vi>Bảng stock: mọi phiên bản của mỗi dòng</tspan>
    </text>

    <rect x="0" y={top} width="580" height={rh} class="qfig-tv-head" />
    <text x={cx.id} y={top + 19} class="qfig-tv-th"><tspan data-lang-en>row</tspan><tspan data-lang-vi>dòng</tspan></text>
    <text x={cx.item} y={top + 19} class="qfig-tv-th">item</text>
    <text x={cx.qty} y={top + 19} class="qfig-tv-th">qty</text>
    <text x={cx.ins} y={top + 19} class="qfig-tv-th">inserted_by</text>
    <text x={cx.del} y={top + 19} class="qfig-tv-th">deleted_by</text>

    {rows.map((r, i) => {
      const y = top + rh * (i + 1);
      return (
        <g>
          <rect x="0" y={y} width="580" height={rh} class={i % 2 ? 'qfig-tv-r1' : 'qfig-tv-r0'} />
          <text x={cx.id} y={y + 19} class="qfig-tv-m">{r.id}</text>
          <text x={cx.item} y={y + 19}>{r.item}</text>
          <text x={cx.qty} y={y + 19}>{r.qty}</text>
          <text x={cx.ins} y={y + 19} class={r.ins === '43' ? 'qfig-tv-bad' : ''}>{r.ins}</text>
          {r.del
            ? <text x={cx.del} y={y + 19} class={r.del === '43' ? 'qfig-tv-bad' : ''}>{r.del}</text>
            : <text x={cx.del} y={y + 19} class="qfig-tv-m">null</text>}
        </g>
      );
    })}
    <rect x="0" y={top} width="580" height={rh * (rows.length + 1)} rx="6" class="qfig-tv-frame" />

    <text x="0" y={gy - 14} class="qfig-tv-h">
      <tspan data-lang-en>Status of each txid</tspan>
      <tspan data-lang-vi>Trạng thái của từng txid</tspan>
    </text>
    {groups.map((g, i) => {
      const y = gy + gh * i;
      return (
        <g>
          <text x="0" y={y + 21}>
            <tspan data-lang-en>{g.label}</tspan>
            <tspan data-lang-vi>{g.vi}</tspan>
          </text>
          {g.ids.map((id, j) => (
            <g>
              <rect x={330 + j * 56} y={y + 3} width="46" height="26" rx="13" class={`qfig-tv-chip qfig-tv-chip-${g.cls}`} />
              <text x={330 + j * 56 + 23} y={y + 21} text-anchor="middle" class="qfig-tv-chip-t">{id}</text>
            </g>
          ))}
        </g>
      );
    })}

    <rect x="0" y={gy + gh * groups.length + 4} width="580" height="34" rx="8" class="qfig-tv-reader" />
    <DiagramIcon name="laptop" x="22" y={gy + gh * groups.length + 21} size={22} />
    <text x="46" y={gy + gh * groups.length + 26} class="qfig-tv-rt">
      <tspan data-lang-en>Reader: txid 50, started with 46 and 48 open</tspan>
      <tspan data-lang-vi>Người đọc: txid 50, bắt đầu khi 46 và 48 đang mở</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-tv { margin: 0; width: 100%; }
  .qfig-tv svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-tv text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-tv .qfig-tv-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-tv .qfig-tv-th { font-weight: 700; fill: var(--text); }
  .qfig-tv .qfig-tv-m { fill: var(--text-muted); }
  .qfig-tv .qfig-tv-bad { fill: var(--red); font-weight: 700; }
  .qfig-tv-head { fill: var(--bg-alt); }
  .qfig-tv-r0 { fill: var(--bg); }
  .qfig-tv-r1 { fill: var(--bg-alt); opacity: 0.55; }
  .qfig-tv-frame { fill: none; stroke: var(--border); stroke-width: 1.4; }
  .qfig-tv-chip { stroke-width: 1.5; }
  .qfig-tv-chip-c { fill: var(--bg-alt); stroke: var(--text-muted); }
  .qfig-tv-chip-a { fill: var(--red-tint-bg); stroke: var(--red); }
  .qfig-tv-chip-o { fill: var(--bg); stroke: var(--text-muted); stroke-dasharray: 4 3; }
  .qfig-tv .qfig-tv-chip-t { font-weight: 700; fill: var(--text); }
  .qfig-tv-reader { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-tv .qfig-tv-rt { font-weight: 700; fill: var(--text); }
</style>
