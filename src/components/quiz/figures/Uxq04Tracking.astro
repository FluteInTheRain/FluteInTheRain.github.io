---
// Quiz figure for the typography post: letter-spacing on a headline and on an all-caps tag.
---
<div class="qfig-uxq04tracking">
  <svg viewBox="0 0 600 250" role="img" aria-label="Four samples. Headline 1 at 40 pixels with letter-spacing 0, headline 2 at 40 pixels with minus 0.025em, tag 3 at 12 pixels all caps with 0, tag 4 at 12 pixels all caps with plus 0.08em.">
    <text x="20" y="22" class="h"><tspan data-lang-en>Sample 1: 40px, letter-spacing 0</tspan><tspan data-lang-vi>Mẫu 1: 40px, letter-spacing 0</tspan></text>
    <text x="20" y="64" style="font-size:40px;font-weight:700;letter-spacing:0" class="t">Quarterly report</text>
    <text x="20" y="96" class="h"><tspan data-lang-en>Sample 2: 40px, letter-spacing -0.025em</tspan><tspan data-lang-vi>Mẫu 2: 40px, letter-spacing -0.025em</tspan></text>
    <text x="20" y="138" style="font-size:40px;font-weight:700;letter-spacing:-0.025em" class="t">Quarterly report</text>
    <text x="20" y="170" class="h"><tspan data-lang-en>Sample 3: 12px caps, letter-spacing 0</tspan><tspan data-lang-vi>Mẫu 3: 12px chữ hoa, letter-spacing 0</tspan></text>
    <rect x="20" y="180" width="170" height="26" rx="13" class="tag" />
    <text x="34" y="198" style="font-size:12px;font-weight:700;letter-spacing:0" class="t">STATUS ACTIVE</text>
    <text x="320" y="170" class="h"><tspan data-lang-en>Sample 4: 12px caps, +0.08em</tspan><tspan data-lang-vi>Mẫu 4: 12px chữ hoa, +0.08em</tspan></text>
    <rect x="320" y="180" width="190" height="26" rx="13" class="tag" />
    <text x="334" y="198" style="font-size:12px;font-weight:700;letter-spacing:0.08em" class="t">STATUS ACTIVE</text>
  </svg>
</div>

<style>
  .qfig-uxq04tracking { margin: 0; width: 100%; }
  .qfig-uxq04tracking svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq04tracking text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq04tracking .h { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qfig-uxq04tracking .m { fill: var(--text-muted); font-size: 12px; }
  .qfig-uxq04tracking .t { fill: var(--text); }
  .qfig-uxq04tracking .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq04tracking .ln { stroke: var(--text-muted); stroke-width: 1; stroke-dasharray: 4 3; fill: none; }
  .qfig-uxq04tracking .lna { stroke: var(--accent); stroke-width: 1.2; fill: none; }
  .qfig-uxq04tracking .tag { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
</style>
