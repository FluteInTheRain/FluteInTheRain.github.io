---
// Set 04: four made-up scores for the inputs of HPG and the softmax weights they become.
// softmax([2.0, 0.5, -1.0, 0.0]) = [0.710, 0.158, 0.035, 0.096]
const names = ['HPG (itself)', 'HSG', 'NKG', 'BID'];
const vals = ['3.0', '2.4', '2.8', '-0.2'];
const sc = ['2.0', '0.5', '-1.0', '0.0'];
const w = [0.710, 0.158, 0.035, 0.096];
---
<div class="qg18">
  <svg viewBox="0 0 580 230" role="img" aria-hidden="true">
    <text x="20" y="24" class="h">
      <tspan data-lang-en>Inputs to HPG: value, score, attention weight</tspan>
      <tspan data-lang-vi>Đầu vào của HPG: giá trị, điểm, trọng số attention</tspan>
    </text>
    <text x="20" y="52" class="muted">
      <tspan data-lang-en>input</tspan>
      <tspan data-lang-vi>đầu vào</tspan>
    </text>
    <text x="140" y="52" class="muted">
      <tspan data-lang-en>value</tspan>
      <tspan data-lang-vi>giá trị</tspan>
    </text>
    <text x="206" y="52" class="muted">
      <tspan data-lang-en>score</tspan>
      <tspan data-lang-vi>điểm</tspan>
    </text>
    <text x="280" y="52" class="muted">
      <tspan data-lang-en>weight</tspan>
      <tspan data-lang-vi>trọng số</tspan>
    </text>
    {names.map((n, i) => (
      <g>
        <text x="20" y={84 + i * 36} class="lab">
          <tspan data-lang-en>{n}</tspan>
          <tspan data-lang-vi>{n.replace('itself', 'chính nó')}</tspan>
        </text>
        <text x="140" y={84 + i * 36}>
          <tspan data-lang-en>{vals[i]}</tspan>
          <tspan data-lang-vi>{vals[i].replace('.', ',')}</tspan>
        </text>
        <text x="206" y={84 + i * 36}>
          <tspan data-lang-en>{sc[i]}</tspan>
          <tspan data-lang-vi>{sc[i].replace('.', ',')}</tspan>
        </text>
        <rect x="280" y={72 + i * 36} width={w[i] * 220} height="14" rx="2" class="bar" />
        <text x={288 + w[i] * 220} y={84 + i * 36}>
          <tspan data-lang-en>{w[i].toFixed(3)}</tspan>
          <tspan data-lang-vi>{w[i].toFixed(3).replace('.', ',')}</tspan>
        </text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qg18 { margin: 0; width: 100%; }
  .qg18 svg { display: block; width: 100%; height: auto; }
  .qg18 text { font-size: 12.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qg18 .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qg18 .lab { fill: var(--text); font-weight: 600; }
  .qg18 .muted { fill: var(--text-muted); font-size: 11.5px; font-weight: 600; }
  .qg18 .bar { fill: var(--gold); }
</style>
