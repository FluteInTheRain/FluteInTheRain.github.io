---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 01: "stock data" is not one table — it is at least four, and they differ
// in arrival frequency and in whether they can change after the fact (post §1).
const rows = [
  {
    icon: 'log',
    en: 'Ticks — every matched trade',
    vi: 'Tick — từng lệnh khớp',
    arrEn: 'arrives: continuously, in real time',
    arrVi: 'về: liên tục, theo thời gian thực',
    chEn: 'never changes afterwards',
    chVi: 'không bị đổi lại sau này',
    bad: false,
  },
  {
    icon: 'chart',
    en: 'Candles (OHLCV) — one per bar',
    vi: 'Nến (OHLCV) — mỗi bar một dòng',
    arrEn: 'arrives: once per bar, usually a day',
    arrVi: 'về: mỗi bar một lần, thường mỗi ngày',
    chEn: 'a summary — inherits what the summariser kept',
    chVi: 'bản tóm tắt — thừa hưởng thứ người tóm tắt giữ lại',
    bad: false,
  },
  {
    icon: 'file',
    en: 'Fundamentals — revenue, profit, debt',
    vi: 'Số liệu tài chính — doanh thu, lợi nhuận, nợ',
    arrEn: 'arrives: quarterly, weeks after the period',
    arrVi: 'về: mỗi quý, trễ vài tuần sau kỳ báo cáo',
    chEn: 'can be restated later',
    chVi: 'có thể bị soát xét lại sau',
    bad: true,
  },
  {
    icon: 'warning',
    en: 'Corporate actions — splits, dividends',
    vi: 'Sự kiện doanh nghiệp — chia tách, cổ tức',
    arrEn: 'arrives: rare events, unannounced in advance',
    arrVi: 'về: sự kiện hiếm, không báo trước được',
    chEn: 'rewrites prices you already have',
    chVi: 'viết lại giá mà bạn đã có sẵn',
    bad: true,
  },
];
const W = 580;
const H = 512;
const rowY = 84;
const rowH = 100;
---
<div class="qdfs">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <DiagramIcon name="folder" x={22} y={20} size={22} />
    <text x="44" y="25" class="qdfs-h">
      <tspan data-lang-en>One zip of "stock data" opens into four files</tspan>
      <tspan data-lang-vi>Một file "dữ liệu chứng khoán" mở ra thành bốn file</tspan>
    </text>

    {rows.map((r, i) => {
      const y = rowY + i * rowH;
      return (
        <g>
          <rect x="14" y={y} width="552" height={rowH - 12} rx="8" class="qdfs-row" />
          <DiagramIcon name={r.icon} x={30} y={y + 18} size={20} />
          <text x="60" y={y + 30} class="qdfs-name">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          <text x="60" y={y + 56} class="qdfs-muted">
            <tspan data-lang-en>{r.arrEn}</tspan>
            <tspan data-lang-vi>{r.arrVi}</tspan>
          </text>
          <text x="60" y={y + 78} class={r.bad ? 'qdfs-bad' : 'qdfs-ok'}>
            <tspan data-lang-en>{r.bad ? '✕ ' : '✓ '}{r.chEn}</tspan>
            <tspan data-lang-vi>{r.bad ? '✕ ' : '✓ '}{r.chVi}</tspan>
          </text>
        </g>
      );
    })}

    <text x="14" y={rowY + 4 * rowH + 6} class="qdfs-muted">
      <tspan data-lang-en>They differ in arrival frequency, cost, and whether they can change later.</tspan>
      <tspan data-lang-vi>Chúng khác nhau ở tần suất, giá thành, và việc có bị đổi lại sau này.</tspan>
    </text>
  </svg>
</div>

<style>
  .qdfs {
    margin: 0;
    width: 100%;
  }
  .qdfs svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qdfs text {
    font-size: 14px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qdfs .qdfs-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qdfs .qdfs-name {
    font-size: 15px;
    font-weight: 600;
    fill: var(--text);
  }
  .qdfs .qdfs-muted {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .qdfs .qdfs-ok {
    font-size: 13px;
    font-weight: 600;
    fill: var(--act-2);
  }
  .qdfs .qdfs-bad {
    font-size: 13px;
    font-weight: 600;
    fill: var(--red);
  }
  .qdfs .qdfs-row {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.2;
  }
</style>
