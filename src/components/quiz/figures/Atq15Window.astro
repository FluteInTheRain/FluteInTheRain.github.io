---
// Quiz figure (ai-trading-sequence-models set 02): ten prices, two windows of four days shifted by one day.
const N = 10;
const X0 = 20;
const W = 52;
const prices = [41, 43, 42, 45, 44, 47, 46, 48, 47, 50];
const y = (p: number) => 120 - (p - 40) * 8;
---
<div class="qfig-p15w">
  <svg viewBox="0 0 580 230" role="img" aria-label="Ten daily prices as cells. Window 1 covers days 1 to 4 and window 2 covers days 2 to 5; the days 2, 3 and 4 are inside both windows.">
    <text x="0" y="20" class="qfig-p15w-h"><tspan data-lang-en>Two windows of 4 days, one day apart</tspan><tspan data-lang-vi>Hai cửa sổ 4 ngày, lệch nhau một ngày</tspan></text>
    {prices.map((p, i) => (
      <g>
        <rect x={X0 + i * W} y="150" width={W - 4} height="34" rx="4" class={i >= 1 && i <= 3 ? 'qfig-p15w-both' : i === 0 || i === 4 ? 'qfig-p15w-one' : 'qfig-p15w-out'} />
        <text x={X0 + i * W + (W - 4) / 2} y="172" text-anchor="middle" class="qfig-p15w-n">{p}</text>
        <text x={X0 + i * W + (W - 4) / 2} y="204" text-anchor="middle" class="qfig-p15w-d"><tspan data-lang-en>{`d${i + 1}`}</tspan><tspan data-lang-vi>{`n${i + 1}`}</tspan></text>
      </g>
    ))}
    <polyline points={prices.map((p, i) => `${X0 + i * W + (W - 4) / 2},${y(p)}`).join(' ')} class="qfig-p15w-line" />
    <path d={`M${X0 - 2},140 h${4 * W} v-84 h${-4 * W} z`} class="qfig-p15w-w1" />
    <path d={`M${X0 + W - 2},146 h${4 * W} v-96 h${-4 * W} z`} class="qfig-p15w-w2" />
    <text x={X0 + 6} y="46" class="qfig-p15w-l"><tspan data-lang-en>window 1</tspan><tspan data-lang-vi>cửa sổ 1</tspan></text>
    <text x={X0 + 5 * W} y="46" class="qfig-p15w-l2"><tspan data-lang-en>window 2</tspan><tspan data-lang-vi>cửa sổ 2</tspan></text>
  </svg>
</div>

<style>
  .qfig-p15w { margin: 0; width: 100%; }
  .qfig-p15w svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-p15w text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-p15w .qfig-p15w-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-p15w .qfig-p15w-n { fill: var(--text); font-weight: 700; }
  .qfig-p15w .qfig-p15w-d { fill: var(--text-muted); }
  .qfig-p15w .qfig-p15w-l { fill: var(--gold-icon); font-weight: 700; }
  .qfig-p15w .qfig-p15w-l2 { fill: var(--text-muted); font-weight: 700; }
  .qfig-p15w-both { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.4; }
  .qfig-p15w-one { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-p15w-out { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-p15w-line { fill: none; stroke: var(--text); stroke-width: 2; stroke-linejoin: round; }
  .qfig-p15w-w1 { fill: none; stroke: var(--gold-icon); stroke-width: 1.6; }
  .qfig-p15w-w2 { fill: none; stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
</style>
