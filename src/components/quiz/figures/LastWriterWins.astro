---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for set 06: two regional leaders accept three edits on a timeline, each change takes 1 s to cross,
// and the Singapore clock runs 2.0 s ahead. Inline SVG, site tokens only, no <marker>/<defs>.
// Shows only the scenario's inputs (real times, lag, clock offset), never the stamps or the final values.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 7 * Math.cos(a)} ${y2 - 7 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const X = (t: number) => 130 + 120 * t;
const fraY = 92;
const sinY = 212;
const axisY = 300;
const sends = [
  { t0: 1.0, from: fraY, to: sinY },
  { t0: 1.4, from: sinY, to: fraY },
  { t0: 2.0, from: fraY, to: sinY },
].map((s) => ({ ...s, ...arrow(X(s.t0), s.from + (s.to > s.from ? 8 : -8), X(s.t0 + 1), s.to + (s.to > s.from ? -8 : 8)) }));
const ticks = [0, 1, 2, 3];
---
<div class="qfig-lww">
  <svg viewBox="0 0 580 350" role="img" aria-label="A timeline of 3 seconds with a Frankfurt lane and a Singapore lane. Frankfurt edits the title at 1.0 seconds and the price at 2.0 seconds. Singapore edits the price at 1.4 seconds and its clock runs 2.0 seconds ahead. Each change takes 1 second to cross.">
    <text x="0" y="20" class="qfig-lww-h">
      <tspan data-lang-en>Two leaders, one product, real time</tspan>
      <tspan data-lang-vi>Hai leader, một sản phẩm, giờ thực</tspan>
    </text>

    <line x1="130" x2="560" y1={fraY} y2={fraY} class="qfig-lww-lane" />
    <line x1="130" x2="560" y1={sinY} y2={sinY} class="qfig-lww-lane" />

    <DiagramIcon name="server" x="18" y={fraY - 6} size={28} />
    <text x="38" y={fraY - 2} class="qfig-lww-t">
      <tspan data-lang-en>Frankfurt</tspan>
      <tspan data-lang-vi>Frankfurt</tspan>
    </text>
    <text x="0" y={fraY + 26} class="qfig-lww-m">
      <tspan data-lang-en>Clock exact</tspan>
      <tspan data-lang-vi>Đồng hồ chính xác</tspan>
    </text>

    <DiagramIcon name="server" x="18" y={sinY - 6} size={28} />
    <text x="38" y={sinY - 2} class="qfig-lww-t">
      <tspan data-lang-en>Singapore</tspan>
      <tspan data-lang-vi>Singapore</tspan>
    </text>
    <rect x="0" y={sinY + 14} width="136" height="28" rx="6" class="qfig-lww-chip" />
    <text x="8" y={sinY + 33} class="qfig-lww-chipt">
      <tspan data-lang-en>Clock +2.0 s</tspan>
      <tspan data-lang-vi>Đồng hồ +2,0 giây</tspan>
    </text>

    {sends.map((s) => (
      <g class="qfig-lww-send"><path d={s.line} /><polygon points={s.head} /></g>
    ))}

    <g>
      <circle cx={X(1.0)} cy={fraY} r="7" class="qfig-lww-dot" />
      <text x={X(1.0)} y={fraY - 16} text-anchor="middle" class="qfig-lww-ev">
        <tspan data-lang-en>1.0 s: title</tspan>
        <tspan data-lang-vi>1,0 giây: title</tspan>
      </text>
      <circle cx={X(2.0)} cy={fraY} r="7" class="qfig-lww-dot" />
      <text x={X(2.0)} y={fraY - 16} text-anchor="middle" class="qfig-lww-ev">
        <tspan data-lang-en>2.0 s: price 45</tspan>
        <tspan data-lang-vi>2,0 giây: price 45</tspan>
      </text>
      <circle cx={X(1.4)} cy={sinY} r="7" class="qfig-lww-dot" />
      <text x={X(1.4)} y={sinY + 28} text-anchor="middle" class="qfig-lww-ev">
        <tspan data-lang-en>1.4 s: price 35</tspan>
        <tspan data-lang-vi>1,4 giây: price 35</tspan>
      </text>
    </g>

    <text x="130" y="46" class="qfig-lww-m">
      <tspan data-lang-en>Dashed arrow: a change takes 1 s to cross</tspan>
      <tspan data-lang-vi>Mũi tên đứt: một thay đổi mất 1 giây để sang</tspan>
    </text>

    <line x1="130" x2="560" y1={axisY} y2={axisY} class="qfig-lww-axis" />
    {ticks.map((t) => (
      <g>
        <line x1={X(t)} x2={X(t)} y1={axisY} y2={axisY + 6} class="qfig-lww-axis" />
        <text x={X(t)} y={axisY + 22} text-anchor="middle" class="qfig-lww-m">
          <tspan data-lang-en>{t} s</tspan>
          <tspan data-lang-vi>{t} giây</tspan>
        </text>
      </g>
    ))}
    <text x="0" y={axisY + 4} class="qfig-lww-m">
      <tspan data-lang-en>After 12:00:00</tspan>
      <tspan data-lang-vi>Sau 12:00:00</tspan>
    </text>
    <text x="0" y="344" class="qfig-lww-m">
      <tspan data-lang-en>Start: title "Linen shirt", price 40</tspan>
      <tspan data-lang-vi>Ban đầu: title "Linen shirt", price 40</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-lww { margin: 0; width: 100%; }
  .qfig-lww svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-lww text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-lww .qfig-lww-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-lww .qfig-lww-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-lww .qfig-lww-ev { font-weight: 600; fill: var(--text); }
  .qfig-lww .qfig-lww-m { fill: var(--text-muted); }
  .qfig-lww-lane { stroke: var(--border); stroke-width: 3; }
  .qfig-lww-axis { stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-lww-dot { fill: var(--bg-alt); stroke: var(--text); stroke-width: 2.2; }
  .qfig-lww-send path { stroke: var(--text-muted); stroke-width: 1.6; fill: none; stroke-dasharray: 5 4; }
  .qfig-lww-send polygon { fill: var(--text-muted); }
  .qfig-lww-chip { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .qfig-lww .qfig-lww-chipt { font-weight: 700; fill: var(--red); }
</style>
