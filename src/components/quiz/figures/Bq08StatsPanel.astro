---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-caching set 07: four samples of GET /jobs/stats taken 5 minutes apart, It shows the readings only, not their cause. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const rows = [
  { t: '10:00', q: 3, p: 1, d: 0, x: 0 },
  { t: '10:05', q: 5, p: 1, d: 0, x: 0 },
  { t: '10:10', q: 8, p: 1, d: 0, x: 0 },
  { t: '10:15', q: 12, p: 1, d: 0, x: 0 },
];
const cols = [
  { x: 70, k: 'time', en: 'time', vi: 'giờ' },
  { x: 190, k: 'q', en: 'queued', vi: 'queued' },
  { x: 310, k: 'p', en: 'processing', vi: 'processing' },
  { x: 420, k: 'd', en: 'delayed', vi: 'delayed' },
  { x: 510, k: 'x', en: 'dead', vi: 'dead' },
];
const top = 96;
const rh = 34;
---
<div class="qfig-sp">
  <svg viewBox="0 0 580 270" role="img" aria-label="Four readings of the job stats taken at 10:00, 10:05, 10:10 and 10:15: queued grows from 3 to 12, processing stays at 1, delayed and dead stay at 0.">
    <DiagramIcon name="chart" x={10} y={10} size={28} />
    <text x="48" y="30" class="qfig-sp-h">
      <tspan data-lang-en>GET /jobs/stats, every 5 minutes</tspan>
      <tspan data-lang-vi>GET /jobs/stats, mỗi 5 phút</tspan>
    </text>
    <text x="10" y="56" class="qfig-sp-m">
      <tspan data-lang-en>One job takes about 2 seconds. One worker is meant to run.</tspan>
      <tspan data-lang-vi>Một job mất khoảng 2 giây. Lẽ ra có một worker đang chạy.</tspan>
    </text>

    <rect x="10" y="68" width="560" height="30" rx="6" class="qfig-sp-head" />
    {cols.map((c) => (
      <text x={c.x} y="88" text-anchor="middle" class="qfig-sp-th">
        <tspan data-lang-en>{c.en}</tspan>
        <tspan data-lang-vi>{c.vi}</tspan>
      </text>
    ))}
    {rows.map((r, i) => (
      <g>
        <line x1="10" x2="570" y1={top + 8 + i * rh} y2={top + 8 + i * rh} class="qfig-sp-rule" />
        <text x="70" y={top + 32 + i * rh - 5} text-anchor="middle" class="qfig-sp-v">{r.t}</text>
        <text x="190" y={top + 32 + i * rh - 5} text-anchor="middle" class="qfig-sp-v">{r.q}</text>
        <text x="310" y={top + 32 + i * rh - 5} text-anchor="middle" class="qfig-sp-v">{r.p}</text>
        <text x="420" y={top + 32 + i * rh - 5} text-anchor="middle" class="qfig-sp-v">{r.d}</text>
        <text x="510" y={top + 32 + i * rh - 5} text-anchor="middle" class="qfig-sp-v">{r.x}</text>
      </g>
    ))}
    <line x1="10" x2="570" y1={top + 8 + 4 * rh} y2={top + 8 + 4 * rh} class="qfig-sp-rule" />
  </svg>
</div>

<style>
  .qfig-sp { margin: 0; width: 100%; }
  .qfig-sp svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-sp text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-sp .qfig-sp-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-sp .qfig-sp-m { fill: var(--text-muted); }
  .qfig-sp .qfig-sp-th { font-size: 13px; font-weight: 700; fill: var(--text-muted); }
  .qfig-sp .qfig-sp-v { font-size: 16px; font-weight: 600; fill: var(--text); }
  .qfig-sp-head { fill: var(--bg-alt); }
  .qfig-sp-rule { stroke: var(--border); stroke-width: 1; }
</style>
