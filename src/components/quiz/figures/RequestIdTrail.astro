---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for unbundling set 07: one payment request id (req-7f9a) on every hop from the phone to Shard B.
// The reply to the phone is lost and the phone sends a retry. It does not show how the system recovers.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const nodes = [
  { x: 58, icon: 'phone', en: 'Phone', vi: 'Điện thoại', chip: true },
  { x: 172, icon: 'server', en: 'Payments API', vi: 'API thanh toán', chip: true },
  { x: 286, icon: 'log', en: 'Shard A log', vi: 'Log Shard A', chip: true },
  { x: 400, icon: 'worker', en: 'Processor', vi: 'Processor', chip: true },
  { x: 514, icon: 'db', en: 'Shard B', vi: 'Shard B', chip: true },
];
const y = 120;
const head = (x: number, yy: number, dir = 1) => `${x},${yy} ${x - 9 * dir},${yy - 4.5} ${x - 9 * dir},${yy + 4.5}`;
const headDown = (x: number, yy: number) => `${x},${yy} ${x - 4.5},${yy - 9} ${x + 4.5},${yy - 9}`;
---
<div class="qfig-rid">
  <svg viewBox="0 0 580 300" role="img" aria-label="A request named req-7f9a goes from the phone to the API, Shard A's log, a processor and Shard B; the reply to the phone is lost and the phone sends a retry.">
    <text x="0" y="20" class="qfig-rid-h">
      <tspan data-lang-en>One payment, hop by hop</tspan>
      <tspan data-lang-vi>Một khoản thanh toán, qua từng chặng</tspan>
    </text>

    <!-- retry arc above phone and API -->
    <path d={`M ${nodes[0].x} ${y - 24} L ${nodes[0].x} 62 L ${nodes[1].x} 62 L ${nodes[1].x} ${y - 32}`} class="qfig-rid-retry" />
    <polygon points={headDown(nodes[1].x, y - 24)} class="qfig-rid-retryhead" />
    <text x={(nodes[0].x + nodes[1].x) / 2} y="52" text-anchor="middle" class="qfig-rid-t">
      <tspan data-lang-en>Retry</tspan>
      <tspan data-lang-vi>Retry</tspan>
    </text>

    <!-- forward arrows -->
    <line x1="80" x2="141" y1={y - 8} y2={y - 8} class="qfig-rid-flow" />
    <polygon points={head(150, y - 8)} class="qfig-rid-flowhead" />
    <text x="115" y={y - 16} text-anchor="middle" class="qfig-rid-m">POST</text>
    {[1, 2, 3].map((i) => (
      <g>
        <line x1={nodes[i].x + 24} x2={nodes[i + 1].x - 33} y1={y} y2={y} class="qfig-rid-ok" />
        <polygon points={head(nodes[i + 1].x - 24, y)} class="qfig-rid-okhead" />
      </g>
    ))}

    <!-- lost reply -->
    <line x1="142" x2="88" y1={y + 14} y2={y + 14} class="qfig-rid-lost" />
    <text x="115" y={y + 6 + 0} text-anchor="middle" class="qfig-rid-x">×</text>

    {nodes.map((n) => (
      <g>
        <DiagramIcon name={n.icon as any} x={n.x} y={y} size={30} />
        <text x={n.x} y={y + 56} text-anchor="middle" class="qfig-rid-lane">
          <tspan data-lang-en>{n.en}</tspan>
          <tspan data-lang-vi>{n.vi}</tspan>
        </text>
        <rect x={n.x - 44} y={y + 64} width="88" height="26" rx="13" class="qfig-rid-chip" />
        <text x={n.x} y={y + 82} text-anchor="middle" class="qfig-rid-chiptxt">req-7f9a</text>
      </g>
    ))}

    <text x="115" y={y + 34} text-anchor="middle" class="qfig-rid-bad">
      <tspan data-lang-en>reply lost</tspan>
      <tspan data-lang-vi>mất phản hồi</tspan>
    </text>

    <!-- notes under the hops -->
    <text x={nodes[0].x} y="238" text-anchor="middle" class="qfig-rid-m">
      <tspan data-lang-en>× 10,000 phones</tspan>
      <tspan data-lang-vi>× 10.000 điện thoại</tspan>
    </text>
    <text x={nodes[2].x} y="238" text-anchor="middle" class="qfig-rid-m">
      <tspan data-lang-en>acct 4321: −$11</tspan>
      <tspan data-lang-vi>TK 4321: −$11</tspan>
    </text>
    <text x={nodes[2].x} y="258" text-anchor="middle" class="qfig-rid-t">
      <tspan data-lang-en>append = commit</tspan>
      <tspan data-lang-vi>append = commit</tspan>
    </text>
    <text x={nodes[3].x} y="238" text-anchor="middle" class="qfig-rid-m">
      <tspan data-lang-en>reads in order</tspan>
      <tspan data-lang-vi>đọc theo thứ tự</tspan>
    </text>
    <text x={nodes[4].x} y="238" text-anchor="middle" class="qfig-rid-m">
      <tspan data-lang-en>acct 1234: +$11</tspan>
      <tspan data-lang-vi>TK 1234: +$11</tspan>
    </text>
    <text x={nodes[4].x} y="258" text-anchor="middle" class="qfig-rid-t">seen_ids</text>
  </svg>
</div>

<style>
  .qfig-rid { margin: 0; width: 100%; }
  .qfig-rid svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-rid text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-rid .qfig-rid-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-rid .qfig-rid-lane { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qfig-rid .qfig-rid-t { font-weight: 600; fill: var(--text); }
  .qfig-rid .qfig-rid-m { fill: var(--text-muted); }
  .qfig-rid .qfig-rid-bad { font-weight: 600; fill: var(--red); }
  .qfig-rid .qfig-rid-x { font-size: 18px; font-weight: 700; fill: var(--red); }
  .qfig-rid .qfig-rid-chiptxt { font-weight: 600; fill: var(--text); }
  .qfig-rid-chip { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-rid-flow { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-rid-flowhead { fill: var(--text-muted); }
  .qfig-rid-ok { stroke: var(--gold); stroke-width: 2; }
  .qfig-rid-okhead { fill: var(--gold); }
  .qfig-rid-lost { stroke: var(--red); stroke-width: 2; stroke-dasharray: 5 4; }
  .qfig-rid-retry { stroke: var(--text-muted); stroke-width: 2; stroke-dasharray: 5 4; fill: none; }
  .qfig-rid-retryhead { fill: var(--text-muted); }
</style>
