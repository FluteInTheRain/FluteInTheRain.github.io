---
// Quiz figure for the post "Design before prompting": a spacing scale (4, 8, 16, 24 px) against values found in generated CSS.
const ox = 36, k = 18; // px to svg units
const x = (v: number) => ox + v * k;
const scale = [4, 8, 16, 24];
const found = [6, 12, 16, 18, 24];
const ticks = [0, 4, 8, 12, 16, 20, 24, 28];
---
<div class="qfig-uxq01spacingruler">
  <svg viewBox="0 0 570 220" role="img" aria-label="A ruler from 0 to 28 pixels. Scale stops at 4, 8, 16 and 24 pixels. Values found in generated CSS at 6, 12, 16, 18 and 24 pixels.">
    <text x={ox} y="22" class="h"><tspan data-lang-en>Values found in the generated CSS (px)</tspan><tspan data-lang-vi>Giá trị tìm thấy trong CSS do AI sinh (px)</tspan></text>
    {found.map((v) => (<g><line x1={x(v)} y1="34" x2={x(v)} y2="96" class="fl" /><circle cx={x(v)} cy="34" r="13" class="dot" /><text x={x(v)} y="39" class="n" text-anchor="middle">{v}</text></g>))}
    <line x1={ox} y1="100" x2={x(28)} y2="100" class="ln" />
    {ticks.map((v) => (<g><line x1={x(v)} y1="96" x2={x(v)} y2="106" class="ln" /><text x={x(v)} y="122" class="m" text-anchor="middle">{v}</text></g>))}
    <text x={ox} y="158" class="h"><tspan data-lang-en>Team spacing scale (px)</tspan><tspan data-lang-vi>Thang khoảng cách của team (px)</tspan></text>
    {scale.map((v) => (<g><rect x={x(v) - 9} y="168" width="18" height="34" rx="3" class="st" /><text x={x(v)} y="190" class="sn" text-anchor="middle">{v}</text></g>))}
  </svg>
</div>

<style>
  .qfig-uxq01spacingruler { margin: 0; width: 100%; }
  .qfig-uxq01spacingruler svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq01spacingruler text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-uxq01spacingruler .h { font-weight: 700; fill: var(--text); }
  .qfig-uxq01spacingruler .m { fill: var(--text-muted); }
  .qfig-uxq01spacingruler .n { fill: var(--bg); font-weight: 700; font-size: 12px; }
  .qfig-uxq01spacingruler .sn { fill: var(--bg); font-weight: 700; font-size: 11px; }
  .qfig-uxq01spacingruler .ln { stroke: var(--text-muted); stroke-width: 1.6; fill: none; }
  .qfig-uxq01spacingruler .fl { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 3 3; }
  .qfig-uxq01spacingruler .dot { fill: var(--text-muted); }
  .qfig-uxq01spacingruler .st { fill: var(--text); }
</style>
