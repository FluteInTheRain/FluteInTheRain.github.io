---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 05: one Postgres table "listings" split into ordinary typed columns (stable, queried fields)
// and one jsonb column (attributes that differ by category). Shows the layout only, no results.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const W = 580;
const H = 262;
const x0 = 10;
const cols = [
  { name: 'id', w: 40, v: ['101', '102', '103'] },
  { name: 'seller_id', w: 82, v: ['7', '7', '31'] },
  { name: 'price_cents', w: 102, v: ['4500', '129900', '6200'] },
  { name: 'status', w: 56, v: ['live', 'live', 'live'] },
];
let cx = x0;
const placed = cols.map((c) => { const o = { ...c, x: cx }; cx += c.w; return o; });
const jx = cx + 8;
const jw = W - 10 - jx;
const hy = 98;
const rh = 34;
const rows = [
  '{ "size": 42, "color": "red" }',
  '{ "ram_gb": 16, "cpu": "M3" }',
  '{ "size": 38, "brand": "Tern" }',
];
---
<div class="qj">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A listings table with ordinary typed columns and one jsonb column for category-specific attributes.">
    <DiagramIcon name="postgres" x={26} y={26} size={30} />
    <text x="52" y="31" class="qj-h">
      <tspan data-lang-en>Table listings: 2,000,000 rows</tspan>
      <tspan data-lang-vi>Bảng listings: 2.000.000 dòng</tspan>
    </text>

    <g>
      <rect x={x0} y="52" width={cx - x0} height="22" rx="4" class="qj-tag-col" />
      <text x={x0 + (cx - x0) / 2} y="68" text-anchor="middle" class="qj-tag">
        <tspan data-lang-en>Ordinary columns: typed, checked</tspan>
        <tspan data-lang-vi>Cột thường: có kiểu, được kiểm tra</tspan>
      </text>
      <rect x={jx} y="52" width={jw} height="22" rx="4" class="qj-tag-json" />
      <text x={jx + jw / 2} y="68" text-anchor="middle" class="qj-tag">
        <tspan data-lang-en>One jsonb column: free-form</tspan>
        <tspan data-lang-vi>Một cột jsonb: tự do</tspan>
      </text>
    </g>

    {placed.map((c) => (
      <g>
        <rect x={c.x} y={hy} width={c.w} height={rh} class="qj-head qj-head-col" />
        <text x={c.x + c.w / 2} y={hy + 22} text-anchor="middle" class="qj-name">{c.name}</text>
        {c.v.map((v, i) => (
          <g>
            <rect x={c.x} y={hy + rh * (i + 1)} width={c.w} height={rh} class="qj-cell" />
            <text x={c.x + c.w / 2} y={hy + rh * (i + 1) + 22} text-anchor="middle" class="qj-val">{v}</text>
          </g>
        ))}
      </g>
    ))}

    <rect x={jx} y={hy} width={jw} height={rh} class="qj-head qj-head-json" />
    <text x={jx + jw / 2} y={hy + 22} text-anchor="middle" class="qj-name">attrs</text>
    {rows.map((r, i) => (
      <g>
        <rect x={jx} y={hy + rh * (i + 1)} width={jw} height={rh} class="qj-cell qj-cell-json" />
        <text x={jx + 12} y={hy + rh * (i + 1) + 22} class="qj-val">{r}</text>
      </g>
    ))}

    <text x={x0} y={hy + rh * 4 + 26} class="qj-note">
      <tspan data-lang-en>Shoes carry size and color. Laptops carry ram_gb and cpu.</tspan>
      <tspan data-lang-vi>Giày có size và color. Laptop có ram_gb và cpu.</tspan>
    </text>
  </svg>
</div>

<style>
  .qj { width: 100%; }
  .qj svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qj text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qj .qj-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qj .qj-tag { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qj .qj-name { font-weight: 700; fill: var(--text); }
  .qj .qj-val { fill: var(--text-body); }
  .qj .qj-note { fill: var(--text-muted); }
  .qj-tag-col { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.2; }
  .qj-tag-json { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 5 3; }
  .qj-head { stroke: var(--border); stroke-width: 1; }
  .qj-head-col { fill: var(--gold-tint-bg); }
  .qj-head-json { fill: var(--bg-alt); }
  .qj-cell { fill: var(--bg); stroke: var(--border); stroke-width: 1; }
  .qj-cell-json { fill: var(--bg-alt); }
</style>
