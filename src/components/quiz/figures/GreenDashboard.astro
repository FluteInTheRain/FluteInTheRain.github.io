---
// A dashboard tile (mean latency, green) next to a histogram of the same 100 checkout requests.
// Numbers match set-01: 94 x 40 ms, 4 x 200 ms, 2 x 2,000 ms; mean = 85.6 ms.
const bins = [
  { en: '0-100', vi: '0-100', n: 94 },
  { en: '100-500', vi: '100-500', n: 4 },
  { en: '500-1,000', vi: '500-1.000', n: 0 },
  { en: '1,000-2,500', vi: '1.000-2.500', n: 2 },
];
const W = 760;
const H = 300;
const baseY = 250;
const maxH = 170;
const x0 = 330;
const slot = 100;
const barW = 62;
---
<figure class="qfig-green">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A green dashboard tile showing mean latency 85.6 ms next to a histogram of 100 requests: 94 in the 0 to 100 ms bin, 4 in 100 to 500, none in 500 to 1,000 and 2 in 1,000 to 2,500.">
    <g class="qfig-green-tile">
      <rect x="16" y="30" width="270" height="200" rx="12" />
      <text x="34" y="62" class="qfig-green-cap">
        <tspan data-lang-en>Checkout · mean latency</tspan>
        <tspan data-lang-vi>Checkout · độ trễ trung bình</tspan>
      </text>
      <text x="34" y="132" class="qfig-green-big">85.6 ms</text>
      <circle cx="46" cy="170" r="7" class="qfig-green-dot" />
      <text x="62" y="175" class="qfig-green-ok">
        <tspan data-lang-en>Green (under 100 ms)</tspan>
        <tspan data-lang-vi>Xanh (dưới 100 ms)</tspan>
      </text>
      <text x="34" y="208" class="qfig-green-sub">
        <tspan data-lang-en>Last 100 requests</tspan>
        <tspan data-lang-vi>100 request gần nhất</tspan>
      </text>
    </g>

    <text x={x0 - 20} y="22" class="qfig-green-cap">
      <tspan data-lang-en>Same 100 requests, counted by time</tspan>
      <tspan data-lang-vi>Cùng 100 request, đếm theo thời gian</tspan>
    </text>
    <line x1={x0 - 20} x2={x0 + slot * bins.length + 10} y1={baseY} y2={baseY} class="qfig-green-axis" />
    {bins.map((b, i) => {
      const h = (b.n / 94) * maxH;
      const x = x0 + i * slot + (slot - barW) / 2;
      return (
        <g>
          {b.n > 0 && <rect x={x} y={baseY - h} width={barW} height={h} rx="3" class={i === 0 ? 'qfig-green-bar' : 'qfig-green-bar is-slow'} />}
          <text x={x + barW / 2} y={baseY - h - 8} text-anchor="middle" class={i === 0 ? 'qfig-green-n' : 'qfig-green-n is-slow'}>{b.n}</text>
          <text x={x + barW / 2} y={baseY + 20} text-anchor="middle" class="qfig-green-tick">
            <tspan data-lang-en>{b.en}</tspan>
            <tspan data-lang-vi>{b.vi}</tspan>
          </text>
        </g>
      );
    })}
    <text x={x0 + (slot * bins.length) / 2 - 10} y={baseY + 44} text-anchor="middle" class="qfig-green-sub">
      <tspan data-lang-en>Request time (ms)</tspan>
      <tspan data-lang-vi>Thời gian request (ms)</tspan>
    </text>
  </svg>
</figure>

<style>
  .qfig-green {
    margin: 0;
    width: 100%;
  }
  .qfig-green svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .qfig-green text {
    font-size: 16px;
    fill: var(--text-body);
  }
  .qfig-green .qfig-green-tile rect {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .qfig-green .qfig-green-cap {
    font-weight: 700;
    fill: var(--text);
  }
  .qfig-green .qfig-green-big {
    font-size: 48px;
    font-weight: 700;
    fill: var(--act-2);
  }
  .qfig-green .qfig-green-dot {
    fill: var(--act-2);
  }
  .qfig-green .qfig-green-ok {
    fill: var(--act-2);
    font-weight: 700;
  }
  .qfig-green .qfig-green-sub {
    fill: var(--text-muted);
  }
  .qfig-green .qfig-green-axis {
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .qfig-green .qfig-green-bar {
    fill: var(--act-2);
  }
  .qfig-green .qfig-green-bar.is-slow {
    fill: var(--red);
  }
  .qfig-green .qfig-green-n {
    font-weight: 700;
    fill: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .qfig-green .qfig-green-n.is-slow {
    fill: var(--red);
  }
  .qfig-green .qfig-green-tick {
    fill: var(--text-muted);
    font-size: 14px;
  }
</style>
