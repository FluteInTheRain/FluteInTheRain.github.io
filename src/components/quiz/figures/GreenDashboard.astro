---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 01: a green "mean latency" tile above the 100 requests behind it.
// Numbers match the scenario: 94 x 40 ms, 4 x 200 ms, 2 x 2,000 ms; mean = 85.6 ms.
// Plain inline SVG, site tokens only, no <marker>/<defs>. It never shows a percentile.
const bins = [
  { en: 'about 40 ms', vi: 'khoảng 40 ms', n: 94, slow: false },
  { en: 'about 200 ms', vi: 'khoảng 200 ms', n: 4, slow: true },
  { en: 'about 2,000 ms', vi: 'khoảng 2.000 ms', n: 2, slow: true },
];
const W = 580;
const H = 476;
const baseY = 414;
const maxH = 105;
const x0 = 30;
const slot = 170;
const barW = 80;
---
<div class="qgd">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <DiagramIcon name="laptop" x={22} y={20} size={22} />
    <text x="44" y="25" class="qgd-h">
      <tspan data-lang-en>What the team sees</tspan>
      <tspan data-lang-vi>Nhóm nhìn thấy gì</tspan>
    </text>
    <g class="qgd-tile">
      <rect x="10" y="40" width="560" height="148" rx="10" />
      <text x="28" y="68" class="qgd-strong">
        <tspan data-lang-en>Checkout: mean latency</tspan>
        <tspan data-lang-vi>Checkout: độ trễ trung bình</tspan>
      </text>
      <text x="28" y="120" class="qgd-big">
        <tspan data-lang-en>85.6 ms</tspan>
        <tspan data-lang-vi>85,6 ms</tspan>
      </text>
      <circle cx="298" cy="98" r="7" class="qgd-dot" />
      <text x="313" y="103" class="qgd-strong">
        <tspan data-lang-en>Green: under 100 ms</tspan>
        <tspan data-lang-vi>Xanh: dưới 100 ms</tspan>
      </text>
      <line x1="28" x2="552" y1="136" y2="136" class="qgd-rule" />
      <text x="28" y="160" class="qgd-muted">
        <tspan data-lang-en>(94 × 40 + 4 × 200 + 2 × 2,000) ÷ 100</tspan>
        <tspan data-lang-vi>(94 × 40 + 4 × 200 + 2 × 2.000) ÷ 100</tspan>
      </text>
      <text x="28" y="179" class="qgd-muted">
        <tspan data-lang-en>One number for the last 100 requests</tspan>
        <tspan data-lang-vi>Một con số cho 100 request gần nhất</tspan>
      </text>
    </g>

    <g class="qgd-arrow">
      <path d="M 290 194 L 290 226" />
      <polygon points="290,236 285,226 295,226" />
    </g>
    <text x="304" y="220" class="qgd-muted">
      <tspan data-lang-en>the same 100 requests</tspan>
      <tspan data-lang-vi>cùng 100 request đó</tspan>
    </text>

    <DiagramIcon name="chart" x={22} y={262} size={22} />
    <text x="44" y="267" class="qgd-h">
      <tspan data-lang-en>Counted by how long each took</tspan>
      <tspan data-lang-vi>Đếm theo thời gian mỗi request mất</tspan>
    </text>
    <line x1="14" x2="566" y1={baseY} y2={baseY} class="qgd-axis" />
    {bins.map((b, i) => {
      const h = Math.max(4, (b.n / 94) * maxH);
      const x = x0 + i * slot + (slot - barW) / 2;
      return (
        <g>
          <rect x={x} y={baseY - h} width={barW} height={h} rx="3" class={b.slow ? 'qgd-bar is-slow' : 'qgd-bar'} />
          <text x={x + barW / 2} y={baseY - h - 8} text-anchor="middle" class={b.slow ? 'qgd-n is-slow' : 'qgd-n'}>{b.n}</text>
          <text x={x + barW / 2} y={baseY + 22} text-anchor="middle" class="qgd-tick">
            <tspan data-lang-en>{b.en}</tspan>
            <tspan data-lang-vi>{b.vi}</tspan>
          </text>
        </g>
      );
    })}
    <text x="14" y={baseY + 48} class="qgd-muted">
      <tspan data-lang-en>Number of requests</tspan>
      <tspan data-lang-vi>Số request</tspan>
    </text>
    <text x="440" y="340" text-anchor="middle" class="qgd-bad">
      <tspan data-lang-en>6 of 100 users wait</tspan>
      <tspan data-lang-vi>6 trên 100 người phải chờ</tspan>
    </text>
    <text x="440" y="360" text-anchor="middle" class="qgd-bad">
      <tspan data-lang-en>5 to 50 times longer</tspan>
      <tspan data-lang-vi>lâu hơn 5 đến 50 lần</tspan>
    </text>
  </svg>
</div>

<style>
  .qgd {
    margin: 0;
    width: 100%;
  }
  .qgd svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qgd text {
    font-size: 14px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qgd .qgd-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qgd .qgd-strong {
    font-size: 15px;
    font-weight: 600;
    fill: var(--text);
  }
  .qgd .qgd-muted,
  .qgd .qgd-tick {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .qgd .qgd-big {
    font-size: 48px;
    font-weight: 700;
    fill: var(--text);
  }
  .qgd-tile rect {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .qgd-dot {
    fill: var(--act-2);
  }
  .qgd-rule {
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .qgd-axis {
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .qgd-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .qgd-arrow polygon {
    fill: var(--text-muted);
  }
  .qgd-bar {
    fill: var(--gold);
  }
  .qgd-bar.is-slow {
    fill: var(--red);
  }
  .qgd .qgd-n {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qgd .qgd-n.is-slow,
  .qgd .qgd-bad {
    fill: var(--red);
    font-weight: 700;
  }
</style>
