---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-caching set 05: 1,000 jobs whose first attempt fails together at t = 0 and whose retries are
// scheduled by plain exponential backoff (1 s, 2 s, 4 s), so every job retries at the same instants.
// It shows when attempts happen, not what to change. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const x0 = 40;
const px = 62; // pixels per second
const tx = (s: number) => x0 + s * px;
const attempts = [
  { s: 0, n: 1 },
  { s: 1, n: 2 },
  { s: 3, n: 3 },
  { s: 7, n: 4 },
];
const axisY = 196;
const ticks = [0, 1, 2, 3, 4, 5, 6, 7, 8];
---
<div class="qfig-rw">
  <svg viewBox="0 0 580 244" role="img" aria-label="A time axis from 0 to 8 seconds: 1,000 jobs make attempt 1 at 0 s, and then all 1,000 make attempt 2 at 1 s, attempt 3 at 3 s and attempt 4 at 7 s, each as one tall block of simultaneous attempts.">
    <DiagramIcon name="worker" x={10} y={8} size={28} />
    <text x="48" y="28" class="qfig-rw-h">
      <tspan data-lang-en>1,000 jobs, same schedule</tspan>
      <tspan data-lang-vi>1.000 job, cùng một lịch</tspan>
    </text>
    {attempts.map((a) => (
      <g>
        <rect x={tx(a.s) - 9} y="70" width="18" height="100" rx="3" class="qfig-rw-bar" />
        <text x={tx(a.s)} y="58" text-anchor="middle" class="qfig-rw-t">
          <tspan data-lang-en>try {a.n}</tspan>
          <tspan data-lang-vi>lần {a.n}</tspan>
        </text>
      </g>
    ))}
    <text x={(tx(0) + tx(1)) / 2 + 4} y="124" text-anchor="middle" class="qfig-rw-m">+1</text>
    <text x={(tx(1) + tx(3)) / 2} y="124" text-anchor="middle" class="qfig-rw-m">+2</text>
    <text x={(tx(3) + tx(7)) / 2} y="124" text-anchor="middle" class="qfig-rw-m">+4</text>
    <line x1={tx(0)} x2={tx(8)} y1={axisY} y2={axisY} class="qfig-rw-axis" />
    {ticks.map((s) => (
      <g>
        <line x1={tx(s)} x2={tx(s)} y1={axisY} y2={axisY + 5} class="qfig-rw-axis" />
        <text x={tx(s)} y={axisY + 21} text-anchor="middle" class="qfig-rw-m">{s}</text>
      </g>
    ))}
    <text x={tx(8) + 14} y={axisY + 21} class="qfig-rw-m">
      <tspan data-lang-en>s</tspan>
      <tspan data-lang-vi>giây</tspan>
    </text>
    <text x="10" y="238" class="qfig-rw-m">
      <tspan data-lang-en>Each block is all 1,000 jobs attempting at once</tspan>
      <tspan data-lang-vi>Mỗi khối là cả 1.000 job cùng thử một lúc</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-rw { margin: 0; width: 100%; }
  .qfig-rw svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-rw text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-rw .qfig-rw-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-rw .qfig-rw-t { font-weight: 700; fill: var(--text); }
  .qfig-rw .qfig-rw-m { fill: var(--text-muted); }
  .qfig-rw-bar { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .qfig-rw-axis { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
