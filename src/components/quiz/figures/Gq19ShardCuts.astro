---
// Quiz figure for the Go optimization-patterns quiz, set 06: the same 15-byte input "12\n345\n6789\n10\n" with two
// marks at byte 5 and byte 10 (size 15 divided by 3 workers = 5 bytes each). It shows where the marks fall, not where a
// worker should start or what it reads.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const text = ['1', '2', '\n', '3', '4', '5', '\n', '6', '7', '8', '9', '\n', '1', '0', '\n'];
const X0 = 14, W = 36, Y = 70, H = 34;
const cx = (i: number) => X0 + i * W;
const marks = [5, 10];
---
<div class="qfig-gq19sc">
  <svg viewBox="0 0 580 190" role="img" aria-label="The 15 bytes of the input 12, 345, 6789, 10, each line ending in a newline, as numbered cells 0 to 14, with dashed marks before byte 5 and before byte 10.">
    <text x="0" y="20" class="qfig-gq19sc-h">
      <tspan data-lang-en>Input bytes and two marks at size / 3</tspan>
      <tspan data-lang-vi>Các byte đầu vào và hai mốc tại size / 3</tspan>
    </text>

    {text.map((c, i) => (
      <g>
        <text x={cx(i) + W / 2} y={Y - 8} text-anchor="middle" class="qfig-gq19sc-i">{i}</text>
        <rect x={cx(i)} y={Y} width={W} height={H} class={c === '\n' ? 'qfig-gq19sc-nl' : 'qfig-gq19sc-cell'} />
        <text x={cx(i) + W / 2} y={Y + 22} text-anchor="middle" class="qfig-gq19sc-c">{c === '\n' ? '\\n' : c}</text>
      </g>
    ))}

    {marks.map((m) => (
      <g>
        <line x1={cx(m)} x2={cx(m)} y1={Y - 4} y2={Y + H + 14} class="qfig-gq19sc-mark" />
        <text x={cx(m)} y={Y + H + 34} text-anchor="middle" class="qfig-gq19sc-m">
          <tspan data-lang-en>mark at byte {m}</tspan>
          <tspan data-lang-vi>mốc tại byte {m}</tspan>
        </text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-gq19sc { margin: 0; width: 100%; }
  .qfig-gq19sc svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq19sc text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq19sc .qfig-gq19sc-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq19sc .qfig-gq19sc-c { font-family: var(--font-mono, monospace); font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq19sc .qfig-gq19sc-i { fill: var(--text-muted); }
  .qfig-gq19sc .qfig-gq19sc-m { fill: var(--text); font-weight: 700; }
  .qfig-gq19sc-cell { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-gq19sc-nl { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .qfig-gq19sc-mark { stroke: var(--act-3); stroke-width: 2.5; stroke-dasharray: 5 3; }
</style>
