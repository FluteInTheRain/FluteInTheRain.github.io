---
// Quiz figure for backend-observability set 01: three overlapping requests, each with the moments it printed,
// next to the nine lines the terminal shows in the order they were printed. Lines carry no request id.
// Inline SVG, site tokens only, no ids.
const x0 = 56;
const px = 1.05; // pixels per ms
const lanes = [
  { en: 'Request A', vi: 'Request A', y: 78, start: 0, end: 200, dots: [0, 120, 200] },
  { en: 'Request B', vi: 'Request B', y: 142, start: 30, end: 140, dots: [30, 90, 140] },
  { en: 'Request C', vi: 'Request C', y: 206, start: 60, end: 260, dots: [60, 150, 260] },
];
const lines = ['closing case', 'closing case', 'closing case', 'rule check passed', 'rule check passed', 'done', 'rule check passed', 'done', 'done'];
const tx = (ms: number) => x0 + ms * px;
const ticks = [0, 100, 200, 300];
---
<div class="qfig-bq10ov">
  <svg viewBox="0 0 580 270" role="img" aria-label="Three requests drawn as lanes on a time axis from 0 to 300 milliseconds, each with three print moments, and beside them the nine terminal lines in print order, none of which carries a request id.">
    <text x="0" y="22" class="qfig-bq10ov-h">
      <tspan data-lang-en>When each request printed (ms)</tspan>
      <tspan data-lang-vi>Lúc mỗi request in ra (ms)</tspan>
    </text>
    <text x="430" y="22" class="qfig-bq10ov-h">
      <tspan data-lang-en>Terminal, in order</tspan>
      <tspan data-lang-vi>Terminal, theo thứ tự</tspan>
    </text>
    {lanes.map((l) => (
      <g>
        <text x="0" y={l.y - 14} class="qfig-bq10ov-lane">
          <tspan data-lang-en>{l.en}</tspan>
          <tspan data-lang-vi>{l.vi}</tspan>
        </text>
        <line x1={tx(l.start)} x2={tx(l.end)} y1={l.y} y2={l.y} class="qfig-bq10ov-bar" />
        {l.dots.map((d) => (
          <g>
            <circle cx={tx(d)} cy={l.y} r="6" class="qfig-bq10ov-dot" />
            <text x={tx(d)} y={l.y + 24} text-anchor="middle" class="qfig-bq10ov-m">{d}</text>
          </g>
        ))}
      </g>
    ))}
    <line x1={tx(0)} x2={tx(300)} y1="250" y2="250" class="qfig-bq10ov-axis" />
    {ticks.map((t) => (
      <g>
        <line x1={tx(t)} x2={tx(t)} y1="250" y2="255" class="qfig-bq10ov-axis" />
        <text x={tx(t)} y="268" text-anchor="middle" class="qfig-bq10ov-m">{t}</text>
      </g>
    ))}
    {lines.map((s, i) => (
      <g>
        <text x="430" y={48 + i * 22} class="qfig-bq10ov-m">{i + 1}</text>
        <text x="448" y={48 + i * 22} class="qfig-bq10ov-t">{s}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-bq10ov { margin: 0; width: 100%; }
  .qfig-bq10ov svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-bq10ov text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bq10ov .qfig-bq10ov-h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-bq10ov .qfig-bq10ov-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-bq10ov .qfig-bq10ov-m { fill: var(--text-muted); font-size: 12px; }
  .qfig-bq10ov .qfig-bq10ov-t { fill: var(--text); }
  .qfig-bq10ov-bar { stroke: var(--border); stroke-width: 4; stroke-linecap: round; }
  .qfig-bq10ov-dot { fill: var(--gold); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-bq10ov-axis { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
