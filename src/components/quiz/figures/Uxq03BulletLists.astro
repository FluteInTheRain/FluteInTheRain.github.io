---
// Quiz figure for the spacing post: two bullet lists, gap between items shaded.
---
<div class="qfig-uxq03bulletlists">
  <svg viewBox="0 0 600 250" role="img" aria-label="Two bulleted lists with three items each, every item wrapping onto two lines. List A: lines are 18px apart inside an item and the next item starts 18px after the last line. List B: lines are 18px apart inside an item and the next item starts 37px after the last line. The extra gaps are shaded.">
<rect x="20" y="10" width="270" height="230" rx="6" class="box" />
<text x="34" y="32" class="h"><tspan data-lang-en>List A</tspan><tspan data-lang-vi>List A</tspan></text>
<circle cx="40" cy="54" r="3.5" class="ico" />
<rect x="54" y="50" width="220" height="7" rx="3" class="bar" />
<rect x="54" y="68" width="150" height="7" rx="3" class="bar" />
<rect x="54" y="75" width="220" height="11" class="gap" />
<circle cx="40" cy="90" r="3.5" class="ico" />
<rect x="54" y="86" width="220" height="7" rx="3" class="bar" />
<rect x="54" y="104" width="190" height="7" rx="3" class="bar" />
<rect x="54" y="111" width="220" height="11" class="gap" />
<circle cx="40" cy="126" r="3.5" class="ico" />
<rect x="54" y="122" width="220" height="7" rx="3" class="bar" />
<rect x="54" y="140" width="150" height="7" rx="3" class="bar" />
<text x="34" y="222" class="m"><tspan data-lang-en>line pitch 18px, item pitch 18px</tspan><tspan data-lang-vi>khoảng dòng 18px, khoảng giữa các mục 18px</tspan></text>
<rect x="310" y="10" width="270" height="230" rx="6" class="box" />
<text x="324" y="32" class="h"><tspan data-lang-en>List B</tspan><tspan data-lang-vi>List B</tspan></text>
<circle cx="330" cy="54" r="3.5" class="ico" />
<rect x="344" y="50" width="220" height="7" rx="3" class="bar" />
<rect x="344" y="68" width="150" height="7" rx="3" class="bar" />
<rect x="344" y="75" width="220" height="30" class="gap" />
<circle cx="330" cy="109" r="3.5" class="ico" />
<rect x="344" y="105" width="220" height="7" rx="3" class="bar" />
<rect x="344" y="123" width="190" height="7" rx="3" class="bar" />
<rect x="344" y="130" width="220" height="30" class="gap" />
<circle cx="330" cy="164" r="3.5" class="ico" />
<rect x="344" y="160" width="220" height="7" rx="3" class="bar" />
<rect x="344" y="178" width="150" height="7" rx="3" class="bar" />
<text x="324" y="222" class="m"><tspan data-lang-en>line pitch 18px, item pitch 37px</tspan><tspan data-lang-vi>khoảng dòng 18px, khoảng giữa các mục 37px</tspan></text>
  </svg>
</div>

<style>
  .qfig-uxq03bulletlists { margin: 0; width: 100%; }
  .qfig-uxq03bulletlists svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq03bulletlists text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq03bulletlists .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-uxq03bulletlists .m { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-uxq03bulletlists .ln { stroke: var(--text-muted); stroke-width: 1.4; fill: none; }
  .qfig-uxq03bulletlists .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq03bulletlists .fld { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-uxq03bulletlists .lab { fill: var(--text); font-weight: 600; }
  .qfig-uxq03bulletlists .gap { fill: var(--gold); opacity: 0.35; }
  .qfig-uxq03bulletlists .bar { fill: var(--text-faint); opacity: 0.55; }
  .qfig-uxq03bulletlists .ico { fill: var(--text-muted); opacity: 0.7; }
</style>
