---
// Quiz figure for the Backtest post: FoldMap. Inline SVG, site tokens only, no ids.
---
<div class="qfig-atq12-foldmap">
  <svg viewBox="0 0 580 248" role="img" aria-label="Walk-forward folds 1, 2, 3 and 14 on 2,520 days. Each fold trains on all earlier days and tests on the next 126. A red bracket spans all 14 test windows.">
<text x="10" y="20" class="h"><tspan data-lang-en>Walk-forward on 2,520 days</tspan><tspan data-lang-vi>Walk-forward trên 2.520 ngày</tspan></text>
<text x="10" y="64" class="b"><tspan data-lang-en>Fold 1</tspan><tspan data-lang-vi>Lần 1</tspan></text>
<rect x="110.0" y="44" width="135.0" height="26" rx="3" class="box" />
<rect x="245.0" y="44" width="22.5" height="26" rx="3" class="goldf" />
<text x="10" y="104" class="b"><tspan data-lang-en>Fold 2</tspan><tspan data-lang-vi>Lần 2</tspan></text>
<rect x="110.0" y="84" width="157.5" height="26" rx="3" class="box" />
<rect x="267.5" y="84" width="22.5" height="26" rx="3" class="goldf" />
<text x="10" y="144" class="b"><tspan data-lang-en>Fold 3</tspan><tspan data-lang-vi>Lần 3</tspan></text>
<rect x="110.0" y="124" width="180.0" height="26" rx="3" class="box" />
<rect x="290.0" y="124" width="22.5" height="26" rx="3" class="goldf" />
<text x="110" y="162"><tspan data-lang-en>⋮</tspan><tspan data-lang-vi>⋮</tspan></text>
<text x="10" y="184" class="b"><tspan data-lang-en>Fold 14</tspan><tspan data-lang-vi>Lần 14</tspan></text>
<rect x="110.0" y="164" width="427.5" height="26" rx="3" class="box" />
<rect x="537.5" y="164" width="22.5" height="26" rx="3" class="goldf" />
<path d="M 245.0 206 L 245.0 214 L 560.0 214 L 560.0 206" class="redl" />
<text x="402.5" y="236" class="t13 redt" text-anchor="middle"><tspan data-lang-en>all 14 test windows</tspan><tspan data-lang-vi>cả 14 cửa sổ test</tspan></text>
  </svg>
</div>

<style>
  .qfig-atq12-foldmap { margin: 2em 0; width: 100%; }
  .qfig-atq12-foldmap-scroll { overflow-x: auto; }
  .qfig-atq12-foldmap svg { display: block; width: 100%;  height: auto; font-variant-numeric: tabular-nums; }
  .qfig-atq12-foldmap text { font-size: 14px; fill: var(--text-body); }
  .qfig-atq12-foldmap .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-atq12-foldmap .s { font-size: 13px; fill: var(--text-muted); }
  .qfig-atq12-foldmap .t13 { font-size: 13px; }
  .qfig-atq12-foldmap .b { font-weight: 700; fill: var(--text); }
  .qfig-atq12-foldmap .redt { fill: var(--red); font-weight: 700; }
  .qfig-atq12-foldmap .goldt { fill: var(--gold-icon); font-weight: 700; }
  .qfig-atq12-foldmap .box { fill: var(--bg-alt); stroke: var(--border); }
  .qfig-atq12-foldmap .okb { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .qfig-atq12-foldmap .badb { fill: var(--red-tint-bg); stroke: var(--red); }
  .qfig-atq12-foldmap .ln { stroke: var(--text-muted); stroke-width: 1.4; fill: none; }
  .qfig-atq12-foldmap .arrf { fill: var(--text-muted); }
  .qfig-atq12-foldmap .ax { stroke: var(--border); stroke-width: 1.2; fill: none; }
  .qfig-atq12-foldmap .grid { stroke: var(--border); stroke-width: 1; stroke-dasharray: 3 4; fill: none; }
  .qfig-atq12-foldmap .redl { stroke: var(--red); stroke-width: 2; fill: none; }
  .qfig-atq12-foldmap .goldl { stroke: var(--gold); stroke-width: 2; fill: none; }
  .qfig-atq12-foldmap .mutl { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; fill: none; }
  .qfig-atq12-foldmap .redf { fill: var(--red); }
  .qfig-atq12-foldmap .goldf { fill: var(--gold); }
  .qfig-atq12-foldmap .mutf { fill: var(--text-faint); }
  .qfig-atq12-foldmap .hole { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-atq12-foldmap figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
