---
// Set 03: one buy. Decision 100.00, order arrives at 100.03, average fill 100.13 (prices are the set's own assumption).
const W = 580;
const H = 250;
const y = (v: number) => 200 - (v - 100.0) * 1000; // 100.00 -> 200, 100.13 -> 70
---
<div class="qs13s">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <text x="12" y="24" class="h">
      <tspan data-lang-en>One buy order, prices per share</tspan>
      <tspan data-lang-vi>Một lệnh mua, giá mỗi cổ phiếu</tspan>
    </text>
    <line x1="30" x2="540" y1="214" y2="214" class="axis" />
    <text x="540" y="234" text-anchor="end" class="s">
      <tspan data-lang-en>time</tspan>
      <tspan data-lang-vi>thời gian</tspan>
    </text>
    <line x1="60" x2="400" y1={y(100.0)} y2={y(100.0)} class="ref" />
    <circle cx="60" cy={y(100.0)} r="6" class="dot" />
    <text x="74" y={y(100.0) + 20} class="l">
      <tspan data-lang-en>decision: 100.00</tspan>
      <tspan data-lang-vi>quyết định: 100,00</tspan>
    </text>
    <circle cx="200" cy={y(100.03)} r="6" class="dot" />
    <text x="212" y={y(100.03) + 4} class="l">
      <tspan data-lang-en>order reaches market: 100.03</tspan>
      <tspan data-lang-vi>lệnh tới sàn: 100,03</tspan>
    </text>
    <circle cx="400" cy={y(100.13)} r="6" class="dot hot" />
    <text x="400" y={y(100.13) - 14} text-anchor="middle" class="l hotl">
      <tspan data-lang-en>average fill: 100.13</tspan>
      <tspan data-lang-vi>giá khớp trung bình: 100,13</tspan>
    </text>
    <line x1="400" x2="400" y1={y(100.0)} y2={y(100.13)} class="ref hotline" />
  </svg>
</div>
<style>
  .qs13s { margin: 0; width: 100%; }
  .qs13s svg { display: block; width: 100%; height: auto; }
  .qs13s .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qs13s .s { font-size: 12.5px; fill: var(--text-muted); }
  .qs13s .l { font-size: 13px; font-weight: 600; fill: var(--text); }
  .qs13s .hotl { fill: var(--red); }
  .qs13s .axis { stroke: var(--border); stroke-width: 1.5; }
  .qs13s .ref { stroke: var(--text-muted); stroke-width: 1; stroke-dasharray: 4 3; }
  .qs13s .hotline { stroke: var(--red); }
  .qs13s .dot { fill: var(--text); }
  .qs13s .dot.hot { fill: var(--red); }
</style>
