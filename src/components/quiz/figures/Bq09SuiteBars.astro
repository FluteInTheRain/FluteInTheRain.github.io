---
// Quiz figure for backend-testing-strategy set 01: one CI suite shown as three layers, each with a bar for how
// many tests it holds and a bar for the seconds it takes in total. Inline SVG, site tokens only, no ids.
const rows = [
  { en: 'Unit', vi: 'Unit', n: 30, s: 0.3, one: '0.01 s' },
  { en: 'API', vi: 'API', n: 20, s: 0.4, one: '0.02 s' },
  { en: 'End-to-end', vi: 'End-to-end', n: 120, s: 600, one: '5 s' },
];
const nMax = 120;
const sMax = 600;
const cw = 150; // width of the count bar column
const sw = 150; // width of the seconds bar column
const cx = 118;
const sx = 400;
const y0 = 74;
const gap = 62;
---
<div class="qfig-bq9sb">
  <svg viewBox="0 0 580 280" role="img" aria-label="Three rows for the unit, API and end-to-end layers of one suite, each with a bar for the number of tests and a bar for the total seconds the layer takes.">
    <text x={cx} y="26" class="qfig-bq9sb-h">
      <tspan data-lang-en>Tests in the layer</tspan>
      <tspan data-lang-vi>Số test trong tầng</tspan>
    </text>
    <text x={sx - 40} y="26" class="qfig-bq9sb-h">
      <tspan data-lang-en>Seconds for the whole layer</tspan>
      <tspan data-lang-vi>Số giây của cả tầng</tspan>
    </text>
    {rows.map((r, i) => {
      const y = y0 + i * gap;
      const bad = i === 2;
      return (
        <g>
          <line x1="0" x2="580" y1={y + 38} y2={y + 38} class="qfig-bq9sb-rule" />
          <text x="0" y={y + 14} class="qfig-bq9sb-lane">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          <text x="0" y={y + 32} class="qfig-bq9sb-m">
            <tspan data-lang-en>{r.one} each</tspan>
            <tspan data-lang-vi>{r.one} mỗi test</tspan>
          </text>
          <rect x={cx} y={y} width={Math.max(3, (r.n / nMax) * cw)} height="22" rx="3" class="qfig-bq9sb-bar" />
          <text x={cx + Math.max(3, (r.n / nMax) * cw) + 8} y={y + 16} class="qfig-bq9sb-t">{r.n}</text>
          <rect x={sx - 40} y={y} width={Math.max(3, (r.s / sMax) * sw)} height="22" rx="3" class={bad ? 'qfig-bq9sb-bar2 qfig-bq9sb-red' : 'qfig-bq9sb-bar2'} />
          <text x={sx - 40 + Math.max(3, (r.s / sMax) * sw) + 8} y={y + 16} class="qfig-bq9sb-t">{r.s} s</text>
        </g>
      );
    })}
  </svg>
</div>

<style>
  .qfig-bq9sb { margin: 0; width: 100%; }
  .qfig-bq9sb svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-bq9sb text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bq9sb .qfig-bq9sb-h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-bq9sb .qfig-bq9sb-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-bq9sb .qfig-bq9sb-t { font-weight: 700; fill: var(--text); }
  .qfig-bq9sb .qfig-bq9sb-m { fill: var(--text-muted); font-size: 13px; }
  .qfig-bq9sb-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-bq9sb-bar { fill: var(--gold); }
  .qfig-bq9sb-bar2 { fill: var(--gold); }
  .qfig-bq9sb-red { fill: var(--red); }
</style>
