---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 03: the toy graph of the post: eight tickers, made-up one-day returns in percent, nine edges.
const nodes: [string, number, number, string][] = [
  ['HPG', 90, 70, '3.0'], ['HSG', 190, 40, '2.4'], ['NKG', 190, 120, '2.8'],
  ['BID', 300, 70, '-0.2'], ['VCB', 400, 70, '-0.4'], ['CTG', 400, 150, '0.1'],
  ['FPT', 300, 190, '1.2'], ['MWG', 190, 200, '-1.5'],
];
const edges = [[0, 1], [0, 2], [1, 2], [3, 4], [3, 5], [4, 5], [6, 7], [0, 3], [6, 4]];
---
<div class="qg18">
  <svg viewBox="0 0 580 280" role="img" aria-hidden="true">
    <DiagramIcon name="network" x={22} y={20} size={20} />
    <text x="42" y="25" class="h">
      <tspan data-lang-en>Toy graph, one-day returns in percent</tspan>
      <tspan data-lang-vi>Graph mẫu, lợi suất một ngày tính bằng phần trăm</tspan>
    </text>
    {edges.map(([a, b]) => (
      <line x1={nodes[a][1] + 40} y1={nodes[a][2] + 30} x2={nodes[b][1] + 40} y2={nodes[b][2] + 30} class="edge" />
    ))}
    {nodes.map((n) => (
      <g>
        <circle cx={n[1] + 40} cy={n[2] + 30} r="22" class="node" />
        <text x={n[1] + 40} y={n[2] + 27} text-anchor="middle" class="nl">{n[0]}</text>
        <text x={n[1] + 40} y={n[2] + 41} text-anchor="middle" class="nv">{n[3]}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qg18 { margin: 0; width: 100%; }
  .qg18 svg { display: block; width: 100%; height: auto; }
  .qg18 text { font-size: 12.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qg18 .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qg18 .nl { font-size: 10.5px; font-weight: 700; fill: var(--text); }
  .qg18 .nv { font-size: 11.5px; fill: var(--text-body); }
  .qg18 .edge { stroke: var(--text-muted); stroke-width: 1.8; }
  .qg18 .node { fill: var(--card-bg); stroke: var(--text-muted); stroke-width: 1.6; }
</style>
