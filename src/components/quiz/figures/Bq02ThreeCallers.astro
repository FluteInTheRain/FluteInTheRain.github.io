---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend REST set 07: three callers of one v1 endpoint, each with a different release rhythm.
// It shows who calls what and how each ships; it draws no rename and no verdict. Inline SVG, site tokens only,
// no <marker>/<defs>/ids.
const callers = [
  { icon: 'laptop', y: 44, en: 'Web app', vi: 'Web app', ne: 'Deploys together with the server', nv: 'Deploy cùng lúc với server' },
  { icon: 'phone', y: 112, en: 'Mobile app 3.2', vi: 'Mobile app 3.2', ne: 'Old versions stay installed for months', nv: 'Bản cũ còn nằm trên máy nhiều tháng' },
  { icon: 'cloud', y: 180, en: 'Partner integration', vi: 'Tích hợp của đối tác', ne: "Another company's code, own schedule", nv: 'Code của công ty khác, lịch riêng' },
];
const right = (x: number, y: number) => `${x},${y} ${x - 10},${y - 5} ${x - 10},${y + 5}`;
---
<div class="qfig-bq02tc">
  <svg viewBox="0 0 580 262" role="img" aria-label="Three callers of GET /v1/cases/3, each reading the title field: a web app that deploys together with the server, a mobile app 3.2 whose old versions stay installed for months, and a partner integration run by another company on its own schedule.">
    <text x="0" y="20" class="qfig-bq02tc-h">
      <tspan data-lang-en>Three callers of one endpoint</tspan>
      <tspan data-lang-vi>Ba bên gọi cùng một endpoint</tspan>
    </text>

    {callers.map((c) => (
      <g>
        <rect x="0" y={c.y} width="346" height="58" rx="8" class="qfig-bq02tc-card" />
        <DiagramIcon name={c.icon as any} x="14" y={c.y + 29} size={30} />
        <text x="58" y={c.y + 24} class="qfig-bq02tc-t">
          <tspan data-lang-en>{c.en}</tspan>
          <tspan data-lang-vi>{c.vi}</tspan>
        </text>
        <text x="58" y={c.y + 44} class="qfig-bq02tc-m">
          <tspan data-lang-en>{c.ne}</tspan>
          <tspan data-lang-vi>{c.nv}</tspan>
        </text>
        <line x1="346" x2="398" y1={c.y + 29} y2="138" class="qfig-bq02tc-flow" />
      </g>
    ))}
    <polygon points={right(406, 138)} class="qfig-bq02tc-head" />

    <rect x="408" y="62" width="172" height="152" rx="8" class="qfig-bq02tc-server" />
    <DiagramIcon name="server" x="424" y="86" size={28} />
    <text x="446" y="92" class="qfig-bq02tc-t">clue.api</text>
    <text x="420" y="124" class="qfig-bq02tc-b">GET /v1/cases/3</text>
    <text x="420" y="148" class="qfig-bq02tc-m">case_id</text>
    <text x="420" y="166" class="qfig-bq02tc-t">title</text>
    <text x="420" y="184" class="qfig-bq02tc-m">priority</text>
    <text x="290" y="250" text-anchor="middle" class="qfig-bq02tc-m">
      <tspan data-lang-en>all three read the title field of the response</tspan>
      <tspan data-lang-vi>cả ba đều đọc trường title của response</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-bq02tc { margin: 0; width: 100%; }
  .qfig-bq02tc svg { display: block; width: 100%; min-width: 340px; height: auto; }
  .qfig-bq02tc text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bq02tc .qfig-bq02tc-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-bq02tc .qfig-bq02tc-t { font-weight: 700; fill: var(--text); }
  .qfig-bq02tc .qfig-bq02tc-m { fill: var(--text-muted); }
  .qfig-bq02tc .qfig-bq02tc-b { fill: var(--text-body); }
  .qfig-bq02tc-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-bq02tc-server { fill: var(--bg-alt); stroke: var(--act-2); stroke-width: 1.5; }
  .qfig-bq02tc-flow { stroke: var(--text-muted); stroke-width: 2; fill: none; }
  .qfig-bq02tc-head { fill: var(--text-muted); }
</style>
