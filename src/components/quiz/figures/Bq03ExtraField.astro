---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-validation-schemas set 07: a profile update body carries three keys, but the model declares
// only two fields. The third key has no field to land in. Shows the mismatch only, not what the framework does with it.
// Inline SVG, site tokens only, no <marker>/<defs/ids.
const sent = [
  { y: 78, name: 'display_name', ok: true },
  { y: 112, name: 'bio', ok: true },
  { y: 146, name: 'is_admin', ok: false },
];
const declared = [
  { y: 78, name: 'display_name' },
  { y: 112, name: 'bio' },
];
function head(x: number, y: number) { return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`; }
---
<div class="qfig-exf">
  <svg viewBox="0 0 580 200" role="img" aria-label="The JSON body of a profile update carries the keys display_name, bio and is_admin, while the model ProfileIn declares only display_name and bio.">
    <text x="0" y="22" class="qfig-exf-h">
      <tspan data-lang-en>Three keys sent, two fields declared</tspan>
      <tspan data-lang-vi>Gửi ba key, khai báo hai field</tspan>
    </text>

    <rect x="0" y="40" width="210" height="140" rx="10" class="qfig-exf-box" />
    <text x="12" y="62" class="qfig-exf-t">
      <tspan data-lang-en>PUT /profile body</tspan>
      <tspan data-lang-vi>Body của PUT /profile</tspan>
    </text>
    {sent.map((k) => (
      <text x="16" y={k.y + 12} class={k.ok ? 'qfig-exf-f' : 'qfig-exf-bad'}>{k.name}</text>
    ))}

    <rect x="370" y="40" width="210" height="140" rx="10" class="qfig-exf-box" />
    <text x="382" y="62" class="qfig-exf-t">
      <tspan data-lang-en>Model ProfileIn</tspan>
      <tspan data-lang-vi>Model ProfileIn</tspan>
    </text>
    {declared.map((k) => (
      <text x="386" y={k.y + 12} class="qfig-exf-f">{k.name}</text>
    ))}

    {declared.map((k) => (
      <g>
        <line x1="214" x2="358" y1={k.y + 6} y2={k.y + 6} class="qfig-exf-arrow" />
        <polygon points={head(366, k.y + 6)} class="qfig-exf-head" />
      </g>
    ))}
    <line x1="214" x2="296" y1="152" y2="152" class="qfig-exf-miss" />
    <text x="304" y="157" class="qfig-exf-bad">?</text>
  </svg>
</div>

<style>
  .qfig-exf { margin: 0; width: 100%; }
  .qfig-exf svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-exf text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-exf .qfig-exf-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-exf .qfig-exf-t { font-weight: 700; fill: var(--text); }
  .qfig-exf .qfig-exf-f { font-size: 15px; fill: var(--text-body); }
  .qfig-exf .qfig-exf-bad { font-size: 15px; font-weight: 700; fill: var(--red); }
  .qfig-exf-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-exf-arrow { stroke: var(--gold); stroke-width: 2; }
  .qfig-exf-head { fill: var(--gold); }
  .qfig-exf-miss { stroke: var(--red); stroke-width: 2; stroke-dasharray: 6 4; }
</style>
