---
// Quiz figure for the Go hardware post, set 01: four latency steps on a log scale.
// Values come from the post's table. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const X0 = 176, W = 290;
// bar length follows log10(nanoseconds): 1 ns -> 0, 10 ns, 90 ns, 1 ms
const len = (ns: number) => 8 + (Math.log10(ns) / 6.2) * W;
const rows = [
  { ns: 1, t: '~1 ns', en: 'L1 cache hit', vi: 'Trúng L1 cache' },
  { ns: 10, t: '~4-15 ns', en: 'L2 or L3 hit', vi: 'Trúng L2 hoặc L3' },
  { ns: 90, t: '~80-100 ns', en: 'Main DRAM miss', vi: 'Trượt DRAM' },
  { ns: 1000000, t: '~0.5-2 ms', en: 'Same-AZ network call', vi: 'Cuộc gọi mạng cùng AZ' },
];
---
<div class="qfig-gq16ll">
  <svg viewBox="0 0 580 250" role="img" aria-label="Four latency steps on a logarithmic scale: L1 hit, L2 or L3 hit, main DRAM miss and a same-AZ network call, each with its approximate time.">
    <text x="0" y="20" class="qfig-gq16ll-h">
      <tspan data-lang-en>Approximate latency, log scale</tspan>
      <tspan data-lang-vi>Độ trễ xấp xỉ, thang log</tspan>
    </text>
    {rows.map((r, i) => (
      <g>
        <text x="0" y={66 + i * 46} class="qfig-gq16ll-l">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <rect x={X0} y={46 + i * 46} width={len(r.ns)} height="26" rx="4" class="qfig-gq16ll-bar" />
        <text x={X0 + len(r.ns) + 8} y={66 + i * 46} class="qfig-gq16ll-v">{r.t}</text>
      </g>
    ))}
    <line x1={X0} x2={X0} y1="38" y2="232" class="qfig-gq16ll-axis" />
  </svg>
</div>

<style>
  .qfig-gq16ll { margin: 0; width: 100%; }
  .qfig-gq16ll svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq16ll text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq16ll .qfig-gq16ll-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq16ll .qfig-gq16ll-l { fill: var(--text); font-weight: 600; }
  .qfig-gq16ll .qfig-gq16ll-v { fill: var(--text-muted); }
  .qfig-gq16ll-bar { fill: var(--act-3); opacity: 0.75; }
  .qfig-gq16ll-axis { stroke: var(--text-muted); stroke-width: 1.5; }
</style>
