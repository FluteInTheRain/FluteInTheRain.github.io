---
// Set 08: TradingAgents (arXiv 2412.20138) Table 1 values for three stocks and the test window.
const rows = [['AAPL', '26.62%', '8.21'], ['GOOGL', '24.36%', '6.39'], ['AMZN', '23.21%', '5.60']];
---
<div class="q21g">
  <svg viewBox="0 0 580 190" role="img" aria-hidden="true">
    <text x="20" y="24" class="h"><tspan data-lang-en>TradingAgents, Table 1</tspan><tspan data-lang-vi>TradingAgents, Bảng 1</tspan></text>
    <text x="200" y="52" text-anchor="end" class="m"><tspan data-lang-en>cumulative return</tspan><tspan data-lang-vi>lợi suất tích lũy</tspan></text>
    <text x="320" y="52" text-anchor="end" class="m">Sharpe</text>
    {rows.map(([n, r, s], i) => (
      <g>
        <rect x="20" y={60 + i * 28} width="320" height="24" rx="4" class="r" />
        <text x="30" y={77 + i * 28} class="n">{n}</text>
        <text x="200" y={77 + i * 28} text-anchor="end" class="s">{r}</text>
        <text x="320" y={77 + i * 28} text-anchor="end" class="n">{s}</text>
      </g>
    ))}
    <text x="20" y="170" class="m"><tspan data-lang-en>Test window: 1 January to 29 March 2024.</tspan><tspan data-lang-vi>Cửa sổ test: 1/1 đến 29/3/2024.</tspan></text>
  </svg>
</div>
<style>
  .q21g svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .q21g text { font-size: 13px; fill: var(--text-body); }
  .q21g .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .q21g .m { font-size: 12px; fill: var(--text-muted); }
  .q21g .n { font-weight: 700; fill: var(--text); }
  .q21g .s { fill: var(--text); }
  .q21g .r { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.1; }
</style>
