---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 07: corporate actions — HSG's 1.5-for-1 bonus issue (record date 31 May
// 2016) in an unadjusted series versus an adjusted one. Illustrative prices
// chosen to match the ratio, as in the post (post §4): raw 42,000 → 28,100;
// adjusted 28,000 → 28,100.
const pts = [
  { x: 120, raw: 42000, adj: 28000, en: '29 May', vi: '29/5' },
  { x: 320, raw: 28100, adj: 28100, en: '31 May', vi: '31/5' },
  { x: 520, raw: 28600, adj: 28600, en: '1 Jun', vi: '1/6' },
];
const W = 580;
const H = 470;
const plotTop = 96;
const plotBottom = 360;
const minP = 26000;
const maxP = 44000;
const py = (p: number) => plotBottom - ((p - minP) / (maxP - minP)) * (plotBottom - plotTop);
const line = (key: 'raw' | 'adj') => pts.map((p, i) => `${i ? 'L' : ''}${p.x},${py(p[key])}`).join(' ');
---
<div class="qdsc">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <DiagramIcon name="warning" x={22} y={20} size={22} />
    <text x="44" y="25" class="qdsc-h">
      <tspan data-lang-en>The −33% day that never happened</tspan>
      <tspan data-lang-vi>Ngày −33% chưa từng xảy ra</tspan>
    </text>
    <text x="44" y="46" class="qdsc-sub">
      <tspan data-lang-en>HSG, 1.5-for-1 bonus issue, record date 31 May 2016 (illustrative prices)</tspan>
      <tspan data-lang-vi>HSG, thưởng 1.5:1, ngày chốt quyền 31/5/2016 (giá minh hoạ)</tspan>
    </text>

    <line x1="70" x2="540" y1={plotBottom} y2={plotBottom} class="qdsc-axis" />
    <line x1="320" x2="320" y1={plotTop - 14} y2={plotBottom} class="qdsc-event" />
    {pts.map((p) => (
      <text x={p.x} y={plotBottom + 22} text-anchor="middle" class="qdsc-tick">
        <tspan data-lang-en>{p.en}</tspan>
        <tspan data-lang-vi>{p.vi}</tspan>
      </text>
    ))}
    <text x="320" y={plotTop - 22} text-anchor="middle" class="qdsc-eventlabel">
      <tspan data-lang-en>bonus issue: 1,000 shares → 1,500 shares</tspan>
      <tspan data-lang-vi>phát hành thưởng: 1.000 cổ → 1.500 cổ</tspan>
    </text>

    <polyline points={line('raw')} class="qdsc-rawline" />
    <polyline points={line('adj')} class="qdsc-adjline" />
    {pts.map((p) => (
      <g>
        <circle cx={p.x} cy={py(p.raw)} r="4.5" class="qdsc-rawdot" />
        <circle cx={p.x} cy={py(p.adj)} r="4.5" class="qdsc-adjdot" />
      </g>
    ))}
    <text x="128" y={py(42000) - 10} class="qdsc-rawlabel">42,000</text>
    <text x="112" y={py(28000) - 10} class="qdsc-adjlabel">28,000</text>

    <rect x="352" y="118" width="180" height="96" rx="8" class="qdsc-notebox" />
    <text x="366" y="142" class="qdsc-rawlabel">
      <tspan data-lang-en>raw: a "−33% crash"</tspan>
      <tspan data-lang-vi>thô: "sập −33%"</tspan>
    </text>
    <text x="366" y="166" class="qdsc-adjlabel">
      <tspan data-lang-en>adjusted: +0.4%</tspan>
      <tspan data-lang-vi>điều chỉnh: +0,4%</tspan>
    </text>
    <text x="366" y="192" class="qdsc-muted">
      <tspan data-lang-en>a normal day, in truth</tspan>
      <tspan data-lang-vi>thực ra là ngày bình thường</tspan>
    </text>

    <g class="qdsc-legend">
      <line x1="80" x2="112" y1="416" y2="416" class="qdsc-rawline" />
      <text x="120" y="420" class="qdsc-legendtext">
        <tspan data-lang-en>unadjusted (raw) close</tspan>
        <tspan data-lang-vi>giá đóng cửa chưa điều chỉnh</tspan>
      </text>
      <line x1="330" x2="362" y1="416" y2="416" class="qdsc-adjline" />
      <text x="370" y="420" class="qdsc-legendtext">
        <tspan data-lang-en>adjusted close</tspan>
        <tspan data-lang-vi>giá đã điều chỉnh</tspan>
      </text>
    </g>
    <text x="70" y="452" class="qdsc-muted">
      <tspan data-lang-en>Nothing was lost — but the raw price column invents a crash every time.</tspan>
      <tspan data-lang-vi>Chẳng mất gì cả — nhưng cột giá thô tự chế ra một cú sập mỗi lần.</tspan>
    </text>
  </svg>
</div>

<style>
  .qdsc {
    margin: 0;
    width: 100%;
  }
  .qdsc svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qdsc text {
    font-size: 13px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qdsc .qdsc-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qdsc .qdsc-sub {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qdsc .qdsc-axis {
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .qdsc .qdsc-event {
    stroke: var(--text-muted);
    stroke-width: 1.2;
    stroke-dasharray: 6 4;
  }
  .qdsc .qdsc-eventlabel {
    font-size: 12.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .qdsc .qdsc-tick {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qdsc .qdsc-rawline {
    stroke: var(--red);
    stroke-width: 2.2;
    fill: none;
  }
  .qdsc .qdsc-adjline {
    stroke: var(--act-2);
    stroke-width: 2.2;
    fill: none;
  }
  .qdsc .qdsc-rawdot {
    fill: var(--red);
  }
  .qdsc .qdsc-adjdot {
    fill: var(--act-2);
  }
  .qdsc .qdsc-rawlabel {
    font-size: 12.5px;
    font-weight: 700;
    fill: var(--red);
  }
  .qdsc .qdsc-adjlabel {
    font-size: 12.5px;
    font-weight: 700;
    fill: var(--act-2);
  }
  .qdsc .qdsc-muted {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qdsc .qdsc-legendtext {
    font-size: 12.5px;
    fill: var(--text-body);
  }
  .qdsc .qdsc-notebox {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.2;
  }
</style>
