---
// Quiz figure (ai-trading-sequence-models set 04): HOSE band around a 60,000 VND reference, ticks of 100 VND.
const rows = [
  { y: 60, p: '64,200', pv: '64.200', t: 'ceiling', tv: 'giá trần' },
  { y: 110, p: '60,000', pv: '60.000', t: 'reference', tv: 'giá tham chiếu' },
  { y: 160, p: '55,800', pv: '55.800', t: 'floor', tv: 'giá sàn' },
];
---
<div class="qfig-p15b">
  <svg viewBox="0 0 580 220" role="img" aria-label="A price ladder: ceiling 64,200 VND, reference 60,000 VND, floor 55,800 VND. Between the reference and each end there are 42 ticks of 100 VND, which is 4,200 VND or 7 percent.">
    <text x="0" y="20" class="qfig-p15b-h"><tspan data-lang-en>FPT at 60,000 VND: a ±7% band</tspan><tspan data-lang-vi>FPT ở 60.000 đồng: biên độ ±7%</tspan></text>
    <line x1="150" y1="50" x2="150" y2="170" class="qfig-p15b-axis" />
    {rows.map((r) => (
      <g>
        <line x1="136" y1={r.y} x2="164" y2={r.y} class="qfig-p15b-tick" />
        <text x="124" y={r.y + 5} text-anchor="end" class="qfig-p15b-p"><tspan data-lang-en>{r.p}</tspan><tspan data-lang-vi>{r.pv}</tspan></text>
        <text x="176" y={r.y + 5} class="qfig-p15b-t"><tspan data-lang-en>{r.t}</tspan><tspan data-lang-vi>{r.tv}</tspan></text>
      </g>
    ))}
    <text x="330" y="88" class="qfig-p15b-n"><tspan data-lang-en>42 ticks of 100 VND (4,200 VND)</tspan><tspan data-lang-vi>42 bước giá 100 đồng (4.200 đồng)</tspan></text>
    <text x="330" y="138" class="qfig-p15b-n"><tspan data-lang-en>42 ticks of 100 VND (4,200 VND)</tspan><tspan data-lang-vi>42 bước giá 100 đồng (4.200 đồng)</tspan></text>
    <text x="0" y="205" class="qfig-p15b-s"><tspan data-lang-en>Say FPT trades at 60,000 VND. Tick: 100 VND from 50,000.</tspan><tspan data-lang-vi>Giả sử FPT giao dịch ở 60.000 đồng. Bước giá: 100 đồng từ 50.000.</tspan></text>
  </svg>
</div>

<style>
  .qfig-p15b { margin: 0; width: 100%; }
  .qfig-p15b svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-p15b text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-p15b .qfig-p15b-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-p15b .qfig-p15b-p { font-weight: 700; fill: var(--text); }
  .qfig-p15b .qfig-p15b-t { fill: var(--text-muted); }
  .qfig-p15b .qfig-p15b-n { fill: var(--gold-icon); font-weight: 600; font-size: 13px; }
  .qfig-p15b .qfig-p15b-s { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-p15b-axis { stroke: var(--border); stroke-width: 6; stroke-linecap: round; }
  .qfig-p15b-tick { stroke: var(--text-muted); stroke-width: 2; }
</style>
