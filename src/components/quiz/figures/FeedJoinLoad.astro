---
// Quiz figure for set 04: the read path of a social feed.
//  1. fan-out on read: client -> JOIN query -> database, at 300,000 reads per second;
//  2. precomputed inbox: client -> one inbox list, filled when a post is written (5,000 per second).
// Plain inline SVG, site tokens only, no markers or defs.

const W = 600;
const H = 440;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 9;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const top = 52;
const bot = 262;
const bh = 64;
const c = { x: 10, w: 120 };
const m = { x: 225, w: 150 };
const d = { x: 470, w: 120 };
const a1 = arrow(c.x + c.w, top + bh / 2, m.x, top + bh / 2);
const a2 = arrow(m.x + m.w, top + bh / 2, d.x, top + bh / 2);
const b1 = arrow(c.x + c.w, bot + bh / 2, m.x, bot + bh / 2);
const b2 = arrow(m.x + m.w, bot + bh / 2, d.x, bot + bh / 2);
const w1 = arrow(d.x + d.w / 2, bot + bh + 52, d.x + d.w / 2, bot + bh + 4);
---
<figure class="qfig-feed">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: each timeline read runs a JOIN on the database, 300,000 times per second, and response time rises from milliseconds to seconds. Bottom: each read fetches one precomputed inbox list, and 5,000 posts per second are copied into follower inboxes.">
    <text x="10" y="26" class="qfig-feed-h">
      <tspan data-lang-en>1. Compute on read</tspan>
      <tspan data-lang-vi>1. Tính lúc đọc</tspan>
    </text>

    <g class="qfig-feed-box"><rect x={c.x} y={top} width={c.w} height={bh} rx="8" /></g>
    <text x={c.x + c.w / 2} y={top + 38} text-anchor="middle" class="qfig-feed-name">
      <tspan data-lang-en>Client</tspan>
      <tspan data-lang-vi>Client</tspan>
    </text>
    <g class="qfig-feed-arrow is-red"><path d={a1.line} /><polygon points={a1.head} /></g>
    <text x={(c.x + c.w + m.x) / 2} y={top + 20} text-anchor="middle" class="qfig-feed-hot">
      <tspan data-lang-en>300,000/s</tspan>
      <tspan data-lang-vi>300.000/s</tspan>
    </text>

    <g class="qfig-feed-box is-warn"><rect x={m.x} y={top} width={m.w} height={bh} rx="8" /></g>
    <text x={m.x + m.w / 2} y={top + 28} text-anchor="middle" class="qfig-feed-name">
      <tspan data-lang-en>JOIN query</tspan>
      <tspan data-lang-vi>Truy vấn JOIN</tspan>
    </text>
    <text x={m.x + m.w / 2} y={top + 49} text-anchor="middle" class="qfig-feed-sub">follows + tweets</text>
    <text x={m.x + m.w / 2} y={top + bh + 24} text-anchor="middle" class="qfig-feed-sub">
      <tspan data-lang-en>~1,200 rows per read</tspan>
      <tspan data-lang-vi>~1.200 dòng mỗi lần đọc</tspan>
    </text>

    <g class="qfig-feed-arrow is-red"><path d={a2.line} /><polygon points={a2.head} /></g>
    <g class="qfig-feed-box is-bad"><rect x={d.x} y={top} width={d.w} height={bh} rx="8" /></g>
    <text x={d.x + d.w / 2} y={top + 38} text-anchor="middle" class="qfig-feed-name">
      <tspan data-lang-en>Database</tspan>
      <tspan data-lang-vi>Database</tspan>
    </text>
    <text x={d.x + d.w / 2} y={top + bh + 24} text-anchor="middle" class="qfig-feed-bad">
      <tspan data-lang-en>ms → seconds</tspan>
      <tspan data-lang-vi>ms → hàng giây</tspan>
    </text>

    <line x1="10" x2={W - 10} y1="188" y2="188" class="qfig-feed-rule" />

    <text x="10" y="236" class="qfig-feed-h">
      <tspan data-lang-en>2. Precompute the inbox</tspan>
      <tspan data-lang-vi>2. Tính sẵn hộp thư</tspan>
    </text>

    <g class="qfig-feed-box"><rect x={c.x} y={bot} width={c.w} height={bh} rx="8" /></g>
    <text x={c.x + c.w / 2} y={bot + 38} text-anchor="middle" class="qfig-feed-name">
      <tspan data-lang-en>Client</tspan>
      <tspan data-lang-vi>Client</tspan>
    </text>
    <g class="qfig-feed-arrow"><path d={b1.line} /><polygon points={b1.head} /></g>
    <text x={(c.x + c.w + m.x) / 2} y={bot + 20} text-anchor="middle" class="qfig-feed-sub">
      <tspan data-lang-en>300,000/s</tspan>
      <tspan data-lang-vi>300.000/s</tspan>
    </text>

    <g class="qfig-feed-box is-good"><rect x={m.x} y={bot} width={m.w} height={bh} rx="8" /></g>
    <text x={m.x + m.w / 2} y={bot + 28} text-anchor="middle" class="qfig-feed-name">
      <tspan data-lang-en>Read 1 list</tspan>
      <tspan data-lang-vi>Đọc 1 danh sách</tspan>
    </text>
    <text x={m.x + m.w / 2} y={bot + 49} text-anchor="middle" class="qfig-feed-sub">
      <tspan data-lang-en>ready-made inbox</tspan>
      <tspan data-lang-vi>hộp thư có sẵn</tspan>
    </text>

    <g class="qfig-feed-arrow"><path d={b2.line} /><polygon points={b2.head} /></g>
    <g class="qfig-feed-box is-good"><rect x={d.x} y={bot} width={d.w} height={bh} rx="8" /></g>
    <text x={d.x + d.w / 2} y={bot + 38} text-anchor="middle" class="qfig-feed-name">
      <tspan data-lang-en>Inbox store</tspan>
      <tspan data-lang-vi>Kho hộp thư</tspan>
    </text>

    <g class="qfig-feed-arrow"><path d={w1.line} /><polygon points={w1.head} /></g>
    <text x={d.x + d.w / 2 - 14} y={bot + bh + 72} text-anchor="end" class="qfig-feed-sub">
      <tspan data-lang-en>5,000 posts/s, copied to each follower's inbox</tspan>
      <tspan data-lang-vi>5.000 bài/s, sao chép vào hộp thư từng follower</tspan>
    </text>
  </svg>
</figure>

<style>
  .qfig-feed {
    margin: 1.5em 0;
    width: 100%;
  }
  .qfig-feed svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qfig-feed text {
    font-size: 15px;
    fill: var(--text-body);
  }
  .qfig-feed .qfig-feed-h {
    font-size: 17px;
    font-weight: 700;
    fill: var(--text);
  }
  .qfig-feed .qfig-feed-name {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .qfig-feed .qfig-feed-sub {
    fill: var(--text-muted);
  }
  .qfig-feed .qfig-feed-hot,
  .qfig-feed .qfig-feed-bad {
    font-weight: 700;
    fill: var(--red);
  }
  .qfig-feed-box rect {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .qfig-feed-box.is-warn rect {
    fill: var(--gold-tint-bg);
    stroke: var(--gold);
  }
  .qfig-feed-box.is-bad rect {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 2;
  }
  .qfig-feed-box.is-good rect {
    stroke: var(--act-2);
    stroke-width: 2;
  }
  .qfig-feed-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2;
  }
  .qfig-feed-arrow polygon {
    fill: var(--text-muted);
  }
  .qfig-feed-arrow.is-red path {
    stroke: var(--red);
    stroke-width: 3;
  }
  .qfig-feed-arrow.is-red polygon {
    fill: var(--red);
  }
  .qfig-feed-rule {
    stroke: var(--border);
    stroke-width: 1;
  }
</style>
