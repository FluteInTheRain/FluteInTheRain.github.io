---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 04: fan-out on read. Every timeline read runs one JOIN; the figure shows what one read touches
// and the database's row budget, but not the total load or the overload factor (the questions ask for those).
// Plain inline SVG, site tokens, no <marker>/<defs>.

const W = 580;
const H = 410;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 9;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 7 * Math.cos(a)} ${y2 - 7 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const card = { x: 10, y: 150, w: 330, h: 190 };
const followRows = Array.from({ length: 5 });
const tweetRows = Array.from({ length: 5 });
---
<div class="qj">
  <div>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Every timeline read sends one JOIN query to the database: one read touches 200 follow rows and 1,000 tweet rows, while the database can touch 40,000,000 rows per second.">
      <text x="10" y="26" class="qj-h">
        <tspan data-lang-en>Fan-out on read: every read runs a JOIN</tspan>
        <tspan data-lang-vi>Fan-out on read: mỗi lần đọc chạy một câu JOIN</tspan>
      </text>

      <DiagramIcon name="phone" x={32} y={78} size={30} />
      <DiagramIcon name="laptop" x={76} y={78} size={30} />
      <text x="108" y="72" class="qj-name">
        <tspan data-lang-en>Users</tspan>
        <tspan data-lang-vi>Người dùng</tspan>
      </text>
      <text x="108" y="94" class="qj-sub"><tspan class="qj-big" data-lang-en>300,000</tspan><tspan class="qj-big" data-lang-vi>300.000</tspan>
        <tspan data-lang-en> timeline reads per second</tspan>
        <tspan data-lang-vi> lượt đọc timeline mỗi giây</tspan>
      </text>

      {(() => { const a = arrow(54, 110, 54, card.y - 4); return <g class="qj-arrow is-heavy"><path d={a.line} /><polygon points={a.head} /></g>; })()}
      <text x="70" y="136" class="qj-sub">
        <tspan data-lang-en>1 query per read</tspan>
        <tspan data-lang-vi>1 câu truy vấn mỗi lần đọc</tspan>
      </text>

      <g class="qj-card"><rect x={card.x} y={card.y} width={card.w} height={card.h} rx="10" /></g>
      <text x={card.x + 14} y={card.y + 26} class="qj-name">
        <tspan data-lang-en>What one read touches</tspan>
        <tspan data-lang-vi>Một lần đọc chạm vào những gì</tspan>
      </text>

      <text x={card.x + 14} y={card.y + 54} class="qj-code">follows</text>
      {followRows.map((_, i) => <rect x={card.x + 84 + i * 14} y={card.y + 42} width="10" height="14" rx="2" class="qj-row" />)}
      <text x={card.x + 164} y={card.y + 54} class="qj-num">
        <tspan data-lang-en>… 200 follow rows</tspan>
        <tspan data-lang-vi>… 200 dòng follow</tspan>
      </text>

      <text x={card.x + 14} y={card.y + 82} class="qj-sub">
        <tspan data-lang-en>200 accounts × 5 latest posts each</tspan>
        <tspan data-lang-vi>200 tài khoản × 5 bài mới nhất mỗi tài khoản</tspan>
      </text>
      <text x={card.x + 14} y={card.y + 108} class="qj-code">tweets</text>
      {tweetRows.map((_, i) => <rect x={card.x + 84 + i * 14} y={card.y + 96} width="10" height="14" rx="2" class="qj-row" />)}
      <text x={card.x + 164} y={card.y + 108} class="qj-num">
        <tspan data-lang-en>… 1,000 tweet rows</tspan>
        <tspan data-lang-vi>… 1.000 dòng tweet</tspan>
      </text>

      <line x1={card.x + 14} x2={card.x + card.w - 14} y1={card.y + 128} y2={card.y + 128} class="qj-rule" />
      <text x={card.x + 14} y={card.y + 154} class="qj-name">
        <tspan data-lang-en>JOIN, then sort by time</tspan>
        <tspan data-lang-vi>JOIN, rồi sắp xếp theo thời gian</tspan>
      </text>
      <text x={card.x + 14} y={card.y + 176} class="qj-sub">
        <tspan data-lang-en>Runs again on every read.</tspan>
        <tspan data-lang-vi>Chạy lại ở mỗi lần đọc.</tspan>
      </text>

      {(() => { const a = arrow(card.x + card.w + 2, 245, 370, 245); return <g class="qj-arrow is-heavy"><path d={a.line} /><polygon points={a.head} /></g>; })()}

      <g class="qj-db"><rect x="374" y="150" width="196" height="190" rx="10" /></g>
      <DiagramIcon name="db" x={402} y={178} size={28} />
      <text x="426" y="184" class="qj-name">Database</text>
      <text x="388" y="218" class="qj-sub">
        <tspan data-lang-en>can touch about</tspan>
        <tspan data-lang-vi>chạm được khoảng</tspan>
      </text>
      <text x="388" y="242" class="qj-big"><tspan data-lang-en>40,000,000</tspan><tspan data-lang-vi>40.000.000</tspan></text>
      <text x="388" y="262" class="qj-sub">
        <tspan data-lang-en>rows per second</tspan>
        <tspan data-lang-vi>dòng mỗi giây</tspan>
      </text>
      <line x1="388" x2="556" y1="278" y2="278" class="qj-rule" />
      <text x="388" y="302" class="qj-bad">
        <tspan data-lang-en>Buffer pool thrashing</tspan>
        <tspan data-lang-vi>Buffer pool bị thrashing</tspan>
      </text>
      <text x="388" y="324" class="qj-bad">
        <tspan data-lang-en>Disk IOPS used up</tspan>
        <tspan data-lang-vi>IOPS của đĩa cạn</tspan>
      </text>

      <DiagramIcon name="users" x={392} y={384} size={26} />
      {(() => { const a = arrow(392, 366, 392, 346); return <g class="qj-arrow"><path d={a.line} /><polygon points={a.head} /></g>; })()}
      <text x="416" y="380" class="qj-sub">
        <tspan data-lang-en>5,000 new posts</tspan>
        <tspan data-lang-vi>5.000 bài đăng mới</tspan>
      </text>
      <text x="416" y="398" class="qj-sub">
        <tspan data-lang-en>per second (writes)</tspan>
        <tspan data-lang-vi>mỗi giây (ghi)</tspan>
      </text>
    </svg>
  </div>
</div>

<style>
  .qj { width: 100%; }
    .qj svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qj text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qj .qj-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qj .qj-name { font-weight: 700; fill: var(--text); }
  .qj .qj-big { font-size: 20px; font-weight: 700; fill: var(--text); }
  .qj .qj-sub { fill: var(--text-muted); }
  .qj .qj-num { fill: var(--text); font-weight: 600; }
  .qj .qj-code { font-weight: 700; fill: var(--text-muted); }
  .qj .qj-bad { fill: var(--red); font-weight: 700; }
  .qj-card rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qj-db rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qj-row { fill: var(--gold); }
  .qj-rule { stroke: var(--border); stroke-width: 1.2; }
  .qj-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .qj-arrow polygon { fill: var(--text-muted); }
  .qj-arrow.is-heavy path { stroke-width: 4; }
</style>
