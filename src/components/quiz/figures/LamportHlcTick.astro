---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for consensus set 05: two nodes (acct and photo) starting at Lamport 0 and HLC (0, 0),
// showing the physical clock inputs and causality token transfer across Events 1-3 without showing the computed stamps.
// Plain inline SVG, site tokens only, no SVG markers, defs, or ids.

const W = 580;
const H = 356;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const msgArr = arrow(252, 148, 276, 188);
const localArr = arrow(374, 232, 396, 232);
---
<div class="qfig-lht">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two nodes acct and photo start at Lamport 0 and HLC (0, 0). Event 1 on acct has physicalClock 500 ms and sends a causality token to photo. Event 2 on photo receives the token at physicalClock 380 ms. Event 3 on photo runs locally at physicalClock 381 ms. Output timestamps are marked with question marks.">
    <text x="10" y="22" class="qfig-lht-h">
      <tspan data-lang-en>Event trace on acct and photo (clocks start at 0)</tspan>
      <tspan data-lang-vi>Chuỗi sự kiện trên acct và photo (đồng hồ đầu bằng 0)</tspan>
    </text>
    <text x="10" y="42" class="qfig-lht-m">
      <tspan data-lang-en>Inputs only: both start at Lamport = 0 and HLC = (0, 0).</tspan>
      <tspan data-lang-vi>Chỉ nêu đầu vào: cả hai bắt đầu ở Lamport = 0 và HLC = (0, 0).</tspan>
    </text>

    <!-- Lane 1: acct -->
    <line x1="138" x2="570" y1="106" y2="106" class="qfig-lht-lane-line" />
    <rect x="10" y="72" width="128" height="68" rx="8" class="qfig-lht-node" />
    <DiagramIcon name="server" x={30} y={96} size={22} />
    <text x="48" y="101" class="qfig-lht-name">acct</text>
    <text x="20" y="125" class="qfig-lht-sub">Lamport 0 · (0, 0)</text>

    <!-- Event 1 -->
    <rect x="156" y="64" width="192" height="84" rx="8" class="qfig-lht-ev is-cause" />
    <text x="168" y="85" class="qfig-lht-t">
      <tspan data-lang-en>Event 1: local write</tspan>
      <tspan data-lang-vi>Sự kiện 1: ghi cục bộ</tspan>
    </text>
    <text x="168" y="108" class="qfig-lht-pt">physicalClock = 500 ms</text>
    <text x="168" y="132" class="qfig-lht-q">Lamport: ? · HLC: ?</text>

    <!-- Causal token arrow -->
    <path d={msgArr.line} class="qfig-lht-flow" />
    <polygon points={msgArr.head} class="qfig-lht-flowhead" />
    <DiagramIcon name="key" x={294} y={168} size={18} />
    <text x="308" y="173" class="qfig-lht-tok">
      <tspan data-lang-en>sends causality token</tspan>
      <tspan data-lang-vi>gửi causality token</tspan>
    </text>

    <!-- Lane 2: photo -->
    <line x1="138" x2="570" y1="232" y2="232" class="qfig-lht-lane-line" />
    <rect x="10" y="198" width="128" height="68" rx="8" class="qfig-lht-node" />
    <DiagramIcon name="server" x={30} y={222} size={22} />
    <text x="48" y="227" class="qfig-lht-name">photo</text>
    <text x="20" y="251" class="qfig-lht-sub">Lamport 0 · (0, 0)</text>

    <!-- Event 2 -->
    <rect x="184" y="190" width="190" height="84" rx="8" class="qfig-lht-ev is-cause" />
    <text x="196" y="211" class="qfig-lht-t">
      <tspan data-lang-en>Event 2: receive + write</tspan>
      <tspan data-lang-vi>Sự kiện 2: nhận + ghi</tspan>
    </text>
    <text x="196" y="234" class="qfig-lht-pt is-lag">physicalClock = 380 ms</text>
    <text x="196" y="258" class="qfig-lht-q">Lamport: ? · HLC: ?</text>

    <!-- Arrow E2 -> E3 -->
    <path d={localArr.line} class="qfig-lht-arr" />
    <polygon points={localArr.head} class="qfig-lht-arrhead" />

    <!-- Event 3 -->
    <rect x="396" y="190" width="176" height="84" rx="8" class="qfig-lht-ev" />
    <text x="408" y="211" class="qfig-lht-t">
      <tspan data-lang-en>Event 3: local write</tspan>
      <tspan data-lang-vi>Sự kiện 3: ghi cục bộ</tspan>
    </text>
    <text x="408" y="234" class="qfig-lht-pt is-lag">physicalClock = 381 ms</text>
    <text x="408" y="258" class="qfig-lht-q">Lamport: ? · HLC: ?</text>

    <!-- Legend -->
    <line x1="10" x2="570" y1="292" y2="292" class="qfig-lht-rule" />
    <rect x="10" y="308" width="13" height="13" rx="3" class="qfig-lht-swatch-gold" />
    <text x="30" y="319" class="qfig-lht-m">
      <tspan data-lang-en>Gold: causal path (Event 1 passes token to Event 2)</tspan>
      <tspan data-lang-vi>Vàng: luồng nhân quả (Sự kiện 1 truyền token sang Sự kiện 2)</tspan>
    </text>
    <rect x="10" y="332" width="13" height="13" rx="3" class="qfig-lht-swatch-red" />
    <text x="30" y="343" class="qfig-lht-m">
      <tspan data-lang-en>Red: photo's physical clock lags behind acct's 500 ms</tspan>
      <tspan data-lang-vi>Đỏ: đồng hồ vật lý của photo chậm hơn mốc 500 ms của acct</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-lht { margin: 0; width: 100%; }
  .qfig-lht svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-lht text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-lht .qfig-lht-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-lht .qfig-lht-name { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-lht .qfig-lht-t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-lht .qfig-lht-sub { font-size: 12.5px; fill: var(--text-muted); }
  .qfig-lht .qfig-lht-m { font-size: 13px; fill: var(--text-muted); }
  .qfig-lht .qfig-lht-pt { font-size: 13px; font-weight: 600; fill: var(--text); }
  .qfig-lht .qfig-lht-pt.is-lag { fill: var(--red); }
  .qfig-lht .qfig-lht-q { font-size: 13px; font-weight: 700; fill: var(--text-muted); }
  .qfig-lht .qfig-lht-tok { font-size: 13px; font-weight: 600; fill: var(--text); }
  .qfig-lht-lane-line { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .qfig-lht-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-lht-node { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-lht-ev { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-lht-ev.is-cause { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-lht-flow { fill: none; stroke: var(--gold); stroke-width: 2.2; }
  .qfig-lht-flowhead { fill: var(--gold); }
  .qfig-lht-arr { fill: none; stroke: var(--text-muted); stroke-width: 1.6; }
  .qfig-lht-arrhead { fill: var(--text-muted); }
  .qfig-lht-swatch-gold { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-lht-swatch-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
</style>
