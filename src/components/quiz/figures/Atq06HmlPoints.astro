---
// Set 03: the HML index (100 at end of 1962) at three year-ends, Ken French data library.
const pts = [['2006', 1086.2], ['2020', 479.9], ['2025', 681.1]] as [string, number][];
---
<div class="q6c">
  <svg viewBox="0 0 580 270" role="img" aria-hidden="true">
    <text x="20" y="24" class="h"><tspan data-lang-en>Value factor (HML): index at year-end, 100 at end of 1962</tspan><tspan data-lang-vi>Factor value (HML): chỉ số cuối năm, 100 vào cuối 1962</tspan></text>
    {pts.map(([y, v], i) => (
      <g>
        <rect x="120" y={52 + i * 62} width={v / 1086.2 * 340} height="40" rx="4" class={i === 1 ? 'b red' : 'b'} />
        <text x="20" y={78 + i * 62} class="s">{y}</text>
        <text x={120 + v / 1086.2 * 340 + 10} y={78 + i * 62} class="n">{v.toFixed(1)}</text>
      </g>
    ))}
    <text x="20" y="255" class="m"><tspan data-lang-en>Monthly returns compounded from the Ken French file.</tspan><tspan data-lang-vi>Lợi nhuận tháng cộng dồn từ file của Ken French.</tspan></text>
  </svg>
</div>
<style>
  .q6c svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .q6c text { font-size: 13px; fill: var(--text-body); }
  .q6c .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .q6c .m { fill: var(--text-muted); font-size: 12px; }
  .q6c .s { font-weight: 700; fill: var(--text); }
  .q6c .n { font-weight: 700; fill: var(--text); }
  .q6c .b { fill: var(--text-faint); }
  .q6c .b.red { fill: var(--red); }
</style>
