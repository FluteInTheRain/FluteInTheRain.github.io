---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for storage set 05: three order IDs of each kind, a B-tree whose leaf pages are sorted from
// the smallest to the largest key, and a bar comparing page cache size with index size.
// Inline SVG, site tokens only, no <marker>/<defs>. Shows only the scenario's inputs: it does not draw
// where any key lands and does not state a miss share or a read count.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
}
const v4 = ['9f2c41e7…', '17ae93b0…', 'c04b5d62…'];
const ulid = ['01JD4K8Q3F…', '01JD4K8Q3G…', '01JD4K8Q7B…'];
const chipW = 176;
const chipX = [0, 202, 404];
const leafW = 56;
const leafGap = 16;
const leafX = Array.from({ length: 8 }, (_, i) => i * (leafW + leafGap));
const rootX = 240;
const rootW = 100;
const leafTop = 306;
const barW = 560;
const cacheW = barW / 8;
---
<div class="qfig-kl">
  <svg viewBox="0 0 580 590" role="img" aria-label="Three order IDs of each kind, a B-tree whose leaf pages run from the smallest keys to the largest, and a bar comparing the 8 GiB page cache with the 64 GiB index.">
    <text x="0" y="22" class="qfig-kl-h">
      <tspan data-lang-en>Order IDs of three orders placed a moment apart</tspan>
      <tspan data-lang-vi>Order ID của ba đơn đặt cách nhau một lúc ngắn</tspan>
    </text>

    <text x="0" y="52" class="qfig-kl-m">
      <tspan data-lang-en>UUIDv4: random bits all the way</tspan>
      <tspan data-lang-vi>UUIDv4: toàn bit ngẫu nhiên</tspan>
    </text>
    {v4.map((s, i) => (
      <g class="qfig-kl-chip">
        <rect x={chipX[i]} y="60" width={chipW} height="32" rx="6" />
        <text x={chipX[i] + chipW / 2} y="81" text-anchor="middle">{s}</text>
      </g>
    ))}

    <text x="0" y="122" class="qfig-kl-m">
      <tspan data-lang-en>ULID: a timestamp first, then random bits</tspan>
      <tspan data-lang-vi>ULID: mốc thời gian trước, rồi bit ngẫu nhiên</tspan>
    </text>
    {ulid.map((s, i) => (
      <g class="qfig-kl-chip">
        <rect x={chipX[i]} y="130" width={chipW} height="32" rx="6" />
        <text x={chipX[i] + chipW / 2} y="151" text-anchor="middle">{s}</text>
      </g>
    ))}

    <line x1="0" x2="580" y1="184" y2="184" class="qfig-kl-rule" />

    <DiagramIcon name="db" x="12" y="206" size={22} />
    <text x="30" y="212" class="qfig-kl-h">
      <tspan data-lang-en>The primary key index, a B-tree</tspan>
      <tspan data-lang-vi>Index của khoá chính, một B-tree</tspan>
    </text>

    <g class="qfig-kl-root">
      <rect x={rootX} y="230" width={rootW} height="32" rx="6" />
      <text x={rootX + rootW / 2} y="251" text-anchor="middle">
        <tspan data-lang-en>Root page</tspan>
        <tspan data-lang-vi>Trang gốc</tspan>
      </text>
    </g>
    {leafX.map((x) => (
      <path d={`M ${rootX + rootW / 2} 262 L ${x + leafW / 2} ${leafTop}`} class="qfig-kl-link" />
    ))}
    {leafX.map((x, i) => (
      <g class="qfig-kl-leaf">
        <rect x={x} y={leafTop} width={leafW} height="44" rx="6" />
        <text x={x + leafW / 2} y={leafTop + 27} text-anchor="middle">
          <tspan data-lang-en>Leaf {i + 1}</tspan>
          <tspan data-lang-vi>Lá {i + 1}</tspan>
        </text>
      </g>
    ))}

    <text x="0" y="378" class="qfig-kl-m">
      <tspan data-lang-en>Smallest keys</tspan>
      <tspan data-lang-vi>Khoá nhỏ nhất</tspan>
    </text>
    <text x="580" y="378" text-anchor="end" class="qfig-kl-m">
      <tspan data-lang-en>Largest keys</tspan>
      <tspan data-lang-vi>Khoá lớn nhất</tspan>
    </text>
    <path d="M 150 373 L 424 373" class="qfig-kl-axis" />
    <polygon points={arrow(150, 373, 440, 373)} class="qfig-kl-axis-head" />
    <text x="290" y="400" text-anchor="middle" class="qfig-kl-m">
      <tspan data-lang-en>Each leaf page is 16 KiB and holds a range of keys.</tspan>
      <tspan data-lang-vi>Mỗi trang lá 16 KiB, giữ một khoảng khoá.</tspan>
    </text>

    <line x1="0" x2="580" y1="420" y2="420" class="qfig-kl-rule" />

    <DiagramIcon name="disk" x="12" y="442" size={22} />
    <text x="30" y="448" class="qfig-kl-h">
      <tspan data-lang-en>Index size against page cache</tspan>
      <tspan data-lang-vi>Kích thước index so với page cache</tspan>
    </text>
    <rect x="0" y="466" width={barW} height="28" rx="5" class="qfig-kl-track" />
    <rect x="0" y="466" width={cacheW} height="28" rx="5" class="qfig-kl-cache" />
    <text x="0" y="522" class="qfig-kl-gold">
      <tspan data-lang-en>Gold: page cache, 8 GiB in memory</tspan>
      <tspan data-lang-vi>Vàng: page cache, 8 GiB trong RAM</tspan>
    </text>
    <text x="0" y="544" class="qfig-kl-m">
      <tspan data-lang-en>Whole bar: the fully grown index, 64 GiB</tspan>
      <tspan data-lang-vi>Cả thanh: index đã lớn hết cỡ, 64 GiB</tspan>
    </text>
    <text x="0" y="574" class="qfig-kl-b">
      <tspan data-lang-en>New orders: 2,000 per second, one insert each</tspan>
      <tspan data-lang-vi>Đơn mới: 2.000 mỗi giây, mỗi đơn một insert</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-kl { margin: 0; width: 100%; }
  .qfig-kl svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-kl text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-kl .qfig-kl-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-kl .qfig-kl-m { fill: var(--text-muted); }
  .qfig-kl .qfig-kl-b { font-weight: 700; fill: var(--text); }
  .qfig-kl .qfig-kl-gold { font-weight: 600; fill: var(--text); }
  .qfig-kl-chip rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-kl .qfig-kl-chip text { font-size: 15px; font-weight: 600; fill: var(--text); }
  .qfig-kl-rule { stroke: var(--border); }
  .qfig-kl-root rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.6; }
  .qfig-kl .qfig-kl-root text { font-weight: 700; fill: var(--text); }
  .qfig-kl-link { stroke: var(--border); stroke-width: 1.6; fill: none; }
  .qfig-kl-leaf rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-kl .qfig-kl-leaf text { font-size: 13px; font-weight: 600; fill: var(--text); }
  .qfig-kl-axis { stroke: var(--text-muted); stroke-width: 1.6; fill: none; }
  .qfig-kl-axis-head { fill: var(--text-muted); }
  .qfig-kl-track { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-kl-cache { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.8; }
</style>
