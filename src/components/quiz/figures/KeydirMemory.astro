---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 02: a Bitcask-style store. The keydir sits in RAM, data files and hint files sit on disk.
// Shows the layout and the scenario numbers only, never a size or a time result.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 376;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const keys = ['user:1001', 'user:1002', 'user:1003'];
const keyY = [116, 156, 196];
const files = [
  { en: 'Data file 1', vi: 'Data file 1', y: 84 },
  { en: 'Data file 2', vi: 'Data file 2', y: 146 },
  { en: 'Data file 3 (active)', vi: 'Data file 3 (đang ghi)', y: 208 },
];
const target = [0, 1, 2]; // which file each sample key points at
const ramR = 262; // right edge of the keydir rows
---
<div class="qk">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A server with 16 GiB of RAM holds the keydir, whose rows point into data files and hint files on a 600 MB/s disk.">
    <text x="10" y="26" class="qk-h">
      <tspan data-lang-en>Index in RAM, data on disk</tspan>
      <tspan data-lang-vi>Index trong RAM, dữ liệu trên đĩa</tspan>
    </text>

    <g class="qk-box">
      <rect x="10" y="44" width="262" height="240" rx="8" />
    </g>
    <DiagramIcon name="server" x={32} y={64} size={20} />
    <text x="50" y="69" class="qk-name">
      <tspan data-lang-en>RAM, 16 GiB</tspan>
      <tspan data-lang-vi>RAM, 16 GiB</tspan>
    </text>
    <text x="24" y="96" class="qk-sub">
      <tspan data-lang-en>keydir, one row per key</tspan>
      <tspan data-lang-vi>keydir, mỗi khoá một dòng</tspan>
    </text>
    {keys.map((k, i) => (
      <g>
        <rect x="24" y={keyY[i] - 14} width={ramR - 24 - 14} height="26" rx="4" class="qk-row" />
        <text x="34" y={keyY[i] + 4} class="qk-key">{k}</text>
      </g>
    ))}
    <text x="34" y="236" class="qk-sub">
      <tspan data-lang-en>... 200 million rows</tspan>
      <tspan data-lang-vi>... 200 triệu dòng</tspan>
    </text>

    <g class="qk-box">
      <rect x="326" y="44" width="244" height="240" rx="8" />
    </g>
    <DiagramIcon name="disk" x={348} y={64} size={20} />
    <text x="366" y="69" class="qk-name">
      <tspan data-lang-en>Disk, 600 MB/s</tspan>
      <tspan data-lang-vi>Đĩa, 600 MB/s</tspan>
    </text>

    {files.map((f, i) => (
      <g>
        <DiagramIcon name="file" x={348} y={f.y + 12} size={16} />
        <text x="364" y={f.y + 17} class="qk-fname">
          <tspan data-lang-en>{f.en}</tspan>
          <tspan data-lang-vi>{f.vi}</tspan>
        </text>
        <rect x="364" y={f.y + 26} width="190" height="12" rx="3" class="qk-data" />
        <text x="364" y={f.y + 54} class="qk-sub">
          <tspan data-lang-en>hint file: keys and positions</tspan>
          <tspan data-lang-vi>hint file: khoá và vị trí</tspan>
        </text>
      </g>
    ))}

    {keys.map((k, i) => {
      const a = arrow(ramR - 14, keyY[i], 320, files[target[i]].y + 32);
      return <g class="qk-arrow"><path d={a.line} /><polygon points={a.head} /></g>;
    })}

    <text x="10" y="318" class="qk-note">
      <tspan data-lang-en>200 million keys. Key 36 bytes, value 500 bytes,</tspan>
      <tspan data-lang-vi>200 triệu khoá. Khoá 36 byte, giá trị 500 byte,</tspan>
    </text>
    <text x="10" y="340" class="qk-note">
      <tspan data-lang-en>40 bytes of bookkeeping per keydir entry.</tspan>
      <tspan data-lang-vi>mỗi entry keydir có thêm 40 byte quản lý.</tspan>
    </text>
    <text x="10" y="362" class="qk-sub">
      <tspan data-lang-en>Values live only in the data files.</tspan>
      <tspan data-lang-vi>Giá trị chỉ nằm trong các data file.</tspan>
    </text>
  </svg>
</div>

<style>
  .qk { width: 100%; }
  .qk svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qk text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qk .qk-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qk .qk-name { font-weight: 700; fill: var(--text); }
  .qk .qk-fname { fill: var(--text); }
  .qk .qk-sub { fill: var(--text-muted); }
  .qk .qk-note { fill: var(--text); }
  .qk .qk-key { fill: var(--text); font-weight: 600; }
  .qk-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qk-row { fill: var(--bg); stroke: var(--border); stroke-width: 1; }
  .qk-data { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1; }
  .qk-arrow path { fill: none; stroke: var(--gold); stroke-width: 1.4; }
  .qk-arrow polygon { fill: var(--gold); }
</style>
