---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 02 (sharding): an orders table cut into 8 key ranges, sorted by (order_date, order_id).
// Shows the layout and the two read patterns only, no write numbers per shard, so it gives no answer away.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 330;
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const x0 = 10;
const cw = 70; // shard width incl. gap
const shards = Array.from({ length: 8 }, (_, i) => ({ n: i + 1, x: x0 + i * cw }));
const axis = arrow(x0 + 4, 172, x0 + 8 * cw - 8, 172);
---
<div class="tr">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="An orders table cut into 8 key ranges sorted by order date, oldest on the left and today on the right, with a date report and a customer history query below.">
    <text x="10" y="26" class="tr-h">
      <tspan data-lang-en>Orders table: 8 ranges of the sorted key</tspan>
      <tspan data-lang-vi>Bảng đơn hàng: 8 dải của khoá đã sắp xếp</tspan>
    </text>

    <DiagramIcon name="shopify" x={30} y={58} size={26} />
    <text x="52" y="63" class="tr-name">
      <tspan data-lang-en>Shop: 4,000 writes/s, almost all dated today</tspan>
      <tspan data-lang-vi>Shop: 4.000 lệnh ghi/giây, gần như đều mang ngày hôm nay</tspan>
    </text>

    {shards.map((s) => (
      <g>
        <rect x={s.x} y="92" width={cw - 8} height="64" rx="8" class="tr-box" />
        <DiagramIcon name="db" x={s.x + (cw - 8) / 2} y={116} size={22} />
        <text x={s.x + (cw - 8) / 2} y="148" text-anchor="middle" class="tr-sub">Shard {s.n}</text>
      </g>
    ))}

    <g class="tr-arrow"><path d={axis.line} /><polygon points={axis.head} /></g>
    <text x={x0 + 4} y="194" class="tr-sub">
      <tspan data-lang-en>oldest dates</tspan>
      <tspan data-lang-vi>ngày cũ nhất</tspan>
    </text>
    <text x={x0 + 8 * cw - 8} y="194" text-anchor="end" class="tr-today">
      <tspan data-lang-en>newest: today</tspan>
      <tspan data-lang-vi>mới nhất: hôm nay</tspan>
    </text>
    <text x={x0 + 4 * cw - 4} y="194" text-anchor="middle" class="tr-sub">
      <tspan data-lang-en>sorted by (order_date, order_id)</tspan>
      <tspan data-lang-vi>sắp xếp theo (order_date, order_id)</tspan>
    </text>

    <g class="tr-q">
      <rect x="10" y="222" width="270" height="86" rx="8" />
      <DiagramIcon name="chart" x={32} y={244} size={20} />
      <text x="50" y="249" class="tr-name">
        <tspan data-lang-en>Date report</tspan>
        <tspan data-lang-vi>Báo cáo theo ngày</tspan>
      </text>
      <text x="24" y="276" class="tr-sub">order_date BETWEEN ...</text>
      <text x="24" y="296" class="tr-sub">
        <tspan data-lang-en>asks for a run of dates</tspan>
        <tspan data-lang-vi>hỏi một dải ngày liên tiếp</tspan>
      </text>
    </g>
    <g class="tr-q">
      <rect x="300" y="222" width="270" height="86" rx="8" />
      <DiagramIcon name="user" x={322} y={244} size={20} />
      <text x="340" y="249" class="tr-name">
        <tspan data-lang-en>Customer history</tspan>
        <tspan data-lang-vi>Lịch sử khách hàng</tspan>
      </text>
      <text x="314" y="276" class="tr-sub">customer_id = 4821</text>
      <text x="314" y="296" class="tr-sub">
        <tspan data-lang-en>orders from many different days</tspan>
        <tspan data-lang-vi>đơn của nhiều ngày khác nhau</tspan>
      </text>
    </g>
  </svg>
</div>

<style>
  .tr { width: 100%; }
  .tr svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .tr text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .tr .tr-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .tr .tr-name { font-weight: 700; fill: var(--text); }
  .tr .tr-sub { fill: var(--text-muted); font-size: 13px; }
  .tr .tr-today { fill: var(--text); font-weight: 700; font-size: 13px; }
  .tr-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .tr-q rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .tr-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .tr-arrow polygon { fill: var(--text-muted); }
</style>
