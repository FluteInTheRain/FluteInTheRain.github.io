---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 03 (encoding): an order ID travels from a Go service, through JSON text, into a JavaScript number.
// Shows the path and how the two number types are laid out; it never shows the value the browser ends up with.
// Plain inline SVG, site tokens, no <marker>/<defs>, so the EN and VI copies cannot clash.

const W = 580;
const H = 392;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const bar = { x: 10, w: 560 };
// 64 bits drawn as one bar; the float layout splits it 1 / 11 / 52 (widths proportional)
const unit = bar.w / 64;
const sign = unit * 1;
const expo = unit * 11;
const frac = unit * 52;
const a1 = arrow(290, 122, 290, 150);
const a2 = arrow(290, 214, 290, 242);
---
<div class="rid">
  <div>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="An order ID leaves a Go service as a 64-bit integer, travels as plain JSON text, and is read by JavaScript into a 64-bit number laid out in three parts.">
      <text x="10" y="26" class="rid-h">
        <tspan data-lang-en>The path of one order ID</tspan>
        <tspan data-lang-vi>Đường đi của một ID đơn hàng</tspan>
      </text>

      <!-- Stage 1: Go service -->
      <DiagramIcon name="server" x={26} y={50} size={24} />
      <text x="50" y="55" class="rid-name">
        <tspan data-lang-en>Order service (Go)</tspan>
        <tspan data-lang-vi>Order service (Go)</tspan>
      </text>
      <text x="570" y="55" text-anchor="end" class="rid-sub">
        <tspan data-lang-en>stores the ID as int64</tspan>
        <tspan data-lang-vi>lưu ID dạng int64</tspan>
      </text>
      <rect x={bar.x} y="68" width={bar.w} height="26" rx="3" class="rid-int" />
      <text x={bar.x + bar.w / 2} y="86" text-anchor="middle" class="rid-num">1234567890123456789</text>
      <text x={bar.x} y="114" class="rid-sub">
        <tspan data-lang-en>64 bits, all used for the whole number</tspan>
        <tspan data-lang-vi>64 bit, dùng hết cho số nguyên</tspan>
      </text>

      <g class="rid-arrow"><path d={a1.line} /><polygon points={a1.head} /></g>

      <!-- Stage 2: JSON text -->
      <rect x="10" y="156" width="560" height="58" rx="8" class="rid-box" />
      <text x="24" y="180" class="rid-name">
        <tspan data-lang-en>On the wire: plain JSON text</tspan>
        <tspan data-lang-vi>Trên đường truyền: chữ JSON thuần</tspan>
      </text>
      <text x="24" y="202" class="rid-num">{`{"id": 1234567890123456789}`}</text>
      <text x="560" y="202" text-anchor="end" class="rid-sub">
        <tspan data-lang-en>a number, no size stated</tspan>
        <tspan data-lang-vi>một số, không nói cỡ</tspan>
      </text>

      <g class="rid-arrow"><path d={a2.line} /><polygon points={a2.head} /></g>

      <!-- Stage 3: browser -->
      <DiagramIcon name="laptop" x={26} y={264} size={24} />
      <text x="50" y="269" class="rid-name">
        <tspan data-lang-en>Browser (JavaScript)</tspan>
        <tspan data-lang-vi>Trình duyệt (JavaScript)</tspan>
      </text>
      <text x="570" y="269" text-anchor="end" class="rid-sub">JSON.parse</text>
      <rect x={bar.x} y="282" width={sign} height="26" class="rid-sign" />
      <rect x={bar.x + sign} y="282" width={expo} height="26" class="rid-exp" />
      <rect x={bar.x + sign + expo} y="282" width={frac} height="26" class="rid-frac" />
      <rect x={bar.x} y="282" width={bar.w} height="26" rx="3" class="rid-outline" />
      <text x={bar.x + sign / 2} y="328" text-anchor="middle" class="rid-sub">1</text>
      <text x={bar.x + sign + expo / 2} y="328" text-anchor="middle" class="rid-sub">11</text>
      <text x={bar.x + sign + expo + frac / 2} y="328" text-anchor="middle" class="rid-sub">52</text>
      <text x={bar.x + sign + expo / 2} y="348" text-anchor="middle" class="rid-sub">
        <tspan data-lang-en>exponent</tspan>
        <tspan data-lang-vi>số mũ</tspan>
      </text>
      <text x={bar.x + sign + expo + frac / 2} y="348" text-anchor="middle" class="rid-sub">
        <tspan data-lang-en>fraction (the digits)</tspan>
        <tspan data-lang-vi>phần định trị (các chữ số)</tspan>
      </text>
      <text x="10" y="378" class="rid-note">
        <tspan data-lang-en>Also 64 bits, but split in three parts. Both sides call the ID a number.</tspan>
        <tspan data-lang-vi>Cũng 64 bit nhưng chia ba phần. Cả hai bên đều gọi ID là một số.</tspan>
      </text>
    </svg>
  </div>
</div>

<style>
  .rid { width: 100%; }
  .rid svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .rid text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .rid .rid-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .rid .rid-name { font-weight: 700; fill: var(--text); }
  .rid .rid-sub { fill: var(--text-muted); }
  .rid .rid-num { fill: var(--text); font-weight: 700; }
  .rid .rid-note { fill: var(--text); }
  .rid-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .rid-int { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .rid-sign { fill: var(--bg-alt); }
  .rid-exp { fill: var(--gold-tint-bg); }
  .rid-frac { fill: var(--red-tint-bg); }
  .rid-outline { fill: none; stroke: var(--text-muted); stroke-width: 1.2; }
  .rid-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .rid-arrow polygon { fill: var(--text-muted); }
</style>
