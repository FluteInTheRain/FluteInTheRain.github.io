---
// Quiz figure for the images post quiz (Uxq07).
---
<div class="qfig-uxq07iconscale">
  <svg viewBox="0 0 600 250" role="img" aria-label="Two feature cards. Left: a bell icon scaled up to 64px with a thick outline. Right: the same icon at 24px with a thin outline inside a 64px tinted circle.">
    <rect x="30" y="10" width="250" height="190" rx="10" class="card" />
    <g transform="translate(124.7 40) scale(2.6667)" class="ico" style="stroke-width:1.5"><path d="M6 16V11a6 6 0 1 1 12 0v5l1.5 2h-15L6 16z M10 20a2 2 0 0 0 4 0" /></g>
    <rect x="80" y="125" width="150" height="10" rx="3" class="bar" />
    <rect x="100" y="145" width="110" height="8" rx="3" class="bar" />
    <text x="155" y="225" text-anchor="middle" class="m"><tspan data-lang-en>Left: icon set to 64px</tspan><tspan data-lang-vi>Trái: icon đặt ở 64px</tspan></text>
    <rect x="320" y="10" width="250" height="190" rx="10" class="card" />
    <circle cx="445" cy="72" r="32" class="accf" fill-opacity="0.18" />
    <g transform="translate(433 60)" class="ico" style="stroke-width:1.5"><path d="M6 16V11a6 6 0 1 1 12 0v5l1.5 2h-15L6 16z M10 20a2 2 0 0 0 4 0" /></g>
    <rect x="370" y="125" width="150" height="10" rx="3" class="bar" />
    <rect x="390" y="145" width="110" height="8" rx="3" class="bar" />
    <text x="445" y="225" text-anchor="middle" class="m"><tspan data-lang-en>Right: 24px icon in a 64px circle</tspan><tspan data-lang-vi>Phải: icon 24px trong vòng tròn 64px</tspan></text>
  </svg>
</div>

<style>
  .qfig-uxq07iconscale { margin: 0; width: 100%; }
  .qfig-uxq07iconscale svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq07iconscale text { font-size: 13.5px; fill: var(--text-body); }
  .qfig-uxq07iconscale .h { font-weight: 700; fill: var(--text); }
  .qfig-uxq07iconscale .m { fill: var(--text-muted); font-size: 13px; }
  .qfig-uxq07iconscale .mono { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; fill: var(--text-muted); }
  .qfig-uxq07iconscale .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq07iconscale .bar { fill: var(--border); }
  .qfig-uxq07iconscale .ln { stroke: var(--text-muted); stroke-width: 1.4; fill: none; }
  .qfig-uxq07iconscale .acc { stroke: var(--red); stroke-width: 2; fill: none; }
  .qfig-uxq07iconscale .accf { fill: var(--red); }
  .qfig-uxq07iconscale .dash { stroke: var(--red); stroke-width: 2; stroke-dasharray: 6 4; fill: none; }
  .qfig-uxq07iconscale .ico { stroke: var(--text); fill: none; stroke-linecap: round; stroke-linejoin: round; }
</style>
