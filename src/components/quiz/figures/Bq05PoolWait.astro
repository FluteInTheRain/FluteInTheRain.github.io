---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-database-access-layer set 01: five requests at t = 0 against a pool of three connections.
// Requests 1-3 hold a connection for 4 s (the partner call); requests 4-5 wait, with a marked 2 s pool_timeout line.
// The figure stops at the line: it does not say what happens to the waiters. Inline SVG, site tokens only.
const x0 = 168;
const px = 96; // pixels per second
const tx = (s: number) => x0 + s * px;
const rowY = [74, 118, 162, 206, 250];
const axisY = 286;
const ticks = [0, 1, 2, 3, 4];
function head(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`;
}
---
<div class="qfig-bqpw">
  <svg viewBox="0 0 580 312" role="img" aria-label="A time axis from 0 to 4 seconds with five request lanes: requests 1 to 3 each hold a connection the whole 4 seconds, while requests 4 and 5 wait with dashed lines running up to a marked 2 s pool_timeout line.">
    <text x="0" y="22" class="qfig-bqpw-h">
      <tspan data-lang-en>Five requests, a pool of three</tspan>
      <tspan data-lang-vi>Năm request, pool có ba connection</tspan>
    </text>

    <line x1={tx(2)} x2={tx(2)} y1="38" y2={axisY} class="qfig-bqpw-limit" />
    <text x={tx(2) + 8} y="50" class="qfig-bqpw-lim">
      <tspan data-lang-en>pool_timeout: 2 s</tspan>
      <tspan data-lang-vi>pool_timeout: 2 s</tspan>
    </text>

    {rowY.map((y, i) => (
      <g>
        <line x1="0" x2="580" y1={y + 22} y2={y + 22} class="qfig-bqpw-rule" />
        <DiagramIcon name={(i < 3 ? 'db' : 'hourglass') as any} x={22} y={y} size={24} />
        <text x="46" y={y + 5} class="qfig-bqpw-lane">
          <tspan data-lang-en>Request {i + 1}</tspan>
          <tspan data-lang-vi>Request {i + 1}</tspan>
        </text>
      </g>
    ))}

    {[0, 1, 2].map((i) => (
      <g>
        <rect x={tx(0)} y={rowY[i] - 13} width={tx(4) - tx(0)} height="26" rx="5" class="qfig-bqpw-hold" />
        <text x={tx(4) - 10} y={rowY[i] + 5} text-anchor="end" class="qfig-bqpw-t">
          <tspan data-lang-en>Holds a connection, 4 s</tspan>
          <tspan data-lang-vi>Giữ connection, 4 s</tspan>
        </text>
      </g>
    ))}

    {[3, 4].map((i) => (
      <g>
        <circle cx={tx(0)} cy={rowY[i]} r="5" class="qfig-bqpw-dot" />
        <path d={`M ${tx(0) + 8} ${rowY[i]} L ${tx(2) - 14} ${rowY[i]}`} class="qfig-bqpw-wait" />
        <polygon points={head(tx(2) - 4, rowY[i])} class="qfig-bqpw-waithead" />
        <text x={tx(0) + 14} y={rowY[i] - 10} class="qfig-bqpw-t">
          <tspan data-lang-en>Waits for a connection</tspan>
          <tspan data-lang-vi>Chờ connection</tspan>
        </text>
      </g>
    ))}

    <line x1={tx(0)} x2={tx(4)} y1={axisY} y2={axisY} class="qfig-bqpw-axis" />
    {ticks.map((s) => (
      <g>
        <line x1={tx(s)} x2={tx(s)} y1={axisY} y2={axisY + 5} class="qfig-bqpw-axis" />
        <text x={tx(s)} y={axisY + 21} text-anchor="middle" class="qfig-bqpw-m">{s}</text>
      </g>
    ))}
    <text x={tx(4) + 12} y={axisY + 21} class="qfig-bqpw-m">
      <tspan data-lang-en>s</tspan>
      <tspan data-lang-vi>giây</tspan>
    </text>
    <text x="0" y={axisY + 21} class="qfig-bqpw-m">
      <tspan data-lang-en>Time since arrival</tspan>
      <tspan data-lang-vi>Thời gian từ lúc tới</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-bqpw { margin: 0; width: 100%; }
  .qfig-bqpw svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-bqpw text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bqpw .qfig-bqpw-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-bqpw .qfig-bqpw-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-bqpw .qfig-bqpw-t { font-weight: 600; fill: var(--text); }
  .qfig-bqpw .qfig-bqpw-m { fill: var(--text-muted); }
  .qfig-bqpw .qfig-bqpw-lim { font-weight: 700; fill: var(--red); }
  .qfig-bqpw-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-bqpw-limit { stroke: var(--red); stroke-width: 1.6; stroke-dasharray: 5 4; }
  .qfig-bqpw-hold { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-bqpw-dot { fill: var(--bg); stroke: var(--text); stroke-width: 2; }
  .qfig-bqpw-wait { stroke: var(--red); stroke-width: 2; stroke-dasharray: 6 4; fill: none; }
  .qfig-bqpw-waithead { fill: var(--red); }
  .qfig-bqpw-axis { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
