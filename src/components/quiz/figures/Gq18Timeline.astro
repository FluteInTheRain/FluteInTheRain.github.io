---
// Quiz figure for go-profiling set 07: one goroutine over 100 ms, running segments and waiting segments.
// Durations only, no verdict. Inline SVG, site tokens only.
const X0 = 20, K = 5.6, Y = 64, H = 34;
const segs = [
  { a: 0, b: 4, run: true }, { a: 4, b: 44, run: false }, { a: 44, b: 48, run: true },
  { a: 48, b: 96, run: false }, { a: 96, b: 100, run: true },
];
const px = (ms: number) => X0 + ms * K;
---
<div class="qfig-gq18tl">
  <svg viewBox="0 0 600 190" role="img" aria-label="Timeline of one goroutine over 100 milliseconds: three short running segments of 4 ms and two waiting segments of 40 ms and 48 ms.">
    <text x="10" y="20" class="qfig-gq18tl-h">
      <tspan data-lang-en>One goroutine, 100 ms of wall-clock time</tspan>
      <tspan data-lang-vi>Một goroutine, 100 ms thời gian thực</tspan>
    </text>
    {segs.map((s) => (
      <g>
        <rect x={px(s.a)} y={Y} width={(s.b - s.a) * K} height={H} class={s.run ? 'qfig-gq18tl-run' : 'qfig-gq18tl-wait'} />
        <text x={px((s.a + s.b) / 2)} y={Y + H + 20} text-anchor="middle" class="qfig-gq18tl-m">{s.b - s.a}</text>
      </g>
    ))}
    <text x={px(0)} y={Y - 8} class="qfig-gq18tl-m">0 ms</text>
    <text x={px(100)} y={Y - 8} text-anchor="end" class="qfig-gq18tl-m">100 ms</text>

    <rect x="20" y="136" width="18" height="14" class="qfig-gq18tl-run" />
    <text x="46" y="148" class="qfig-gq18tl-t">
      <tspan data-lang-en>running on a CPU (ms)</tspan>
      <tspan data-lang-vi>đang chạy trên CPU (ms)</tspan>
    </text>
    <rect x="20" y="160" width="18" height="14" class="qfig-gq18tl-wait" />
    <text x="46" y="172" class="qfig-gq18tl-t">
      <tspan data-lang-en>waiting for a response (ms)</tspan>
      <tspan data-lang-vi>đang chờ phản hồi (ms)</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq18tl { margin: 0; width: 100%; }
  .qfig-gq18tl svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq18tl text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq18tl .qfig-gq18tl-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq18tl .qfig-gq18tl-m { fill: var(--text-muted); }
  .qfig-gq18tl .qfig-gq18tl-t { fill: var(--text); }
  .qfig-gq18tl-run { fill: var(--act-3); stroke: var(--border); stroke-width: 1; }
  .qfig-gq18tl-wait { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
</style>
