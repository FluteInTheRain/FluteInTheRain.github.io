---
// Quiz figure for go-efficiency-workflow-raer-tfbo-hardware-memory set 05: three measured runs of GET /todos
// (1,000 / 10,000 / 100,000 todos) with the RAER numbers (5 ms p99, 200 KB per request) as dashed lines.
// Values are the post's own run: p99 352 us, 3.06 ms, 32.3 ms; memory 86 KB, 1,027 KB, 15,438 KB. Log scale. Inline SVG, site tokens only.
const x0 = 124;
const w = 300;
const sizes = ['1,000', '10,000', '100,000'];
const panels = [
  {
    key: 'p99', top: 40, min: 2, max: 5, // log10 of microseconds: 100 us .. 100,000 us
    vals: [352, 3060, 32300], labels: ['352 µs', '3.06 ms', '32.3 ms'], limit: 5000,
    en: 'p99 latency (log scale)', vi: 'Độ trễ p99 (thang log)',
    limEn: 'RAER: 5 ms', limVi: 'RAER: 5 ms',
  },
  {
    key: 'mem', top: 190, min: 1, max: 5, // log10 of KB: 10 KB .. 100,000 KB
    vals: [86, 1027, 15438], labels: ['86 KB', '1,027 KB', '15,438 KB'], limit: 200,
    en: 'Memory allocated per request (log scale)', vi: 'Bộ nhớ cấp phát mỗi request (thang log)',
    limEn: 'RAER: 200 KB', limVi: 'RAER: 200 KB',
  },
];
const px = (p: (typeof panels)[number], v: number) => x0 + ((Math.log10(v) - p.min) / (p.max - p.min)) * w;
---
<div class="qfig-gq15br">
  <svg viewBox="0 0 560 330" role="img" aria-label="Two small bar charts on a log scale for GET /todos with 1,000, 10,000 and 100,000 todos. Top: p99 latency of 352 microseconds, 3.06 milliseconds and 32.3 milliseconds, with a dashed line at 5 milliseconds. Bottom: memory allocated per request of 86, 1,027 and 15,438 kilobytes, with a dashed line at 200 kilobytes.">
    {panels.map((p) => (
      <g>
        <text x="0" y={p.top - 14} class="qfig-gq15br-h">
          <tspan data-lang-en>{p.en}</tspan>
          <tspan data-lang-vi>{p.vi}</tspan>
        </text>
        {sizes.map((s, i) => (
          <g>
            <text x="0" y={p.top + 18 + i * 32} class="qfig-gq15br-lane">
              <tspan data-lang-en>{s} todos</tspan>
              <tspan data-lang-vi>{s} todo</tspan>
            </text>
            <rect x={x0} y={p.top + i * 32} width={px(p, p.vals[i]) - x0} height="24" rx="4" class="qfig-gq15br-bar" />
            <text x={px(p, p.vals[i]) + 8} y={p.top + 18 + i * 32} class="qfig-gq15br-t">{p.labels[i]}</text>
          </g>
        ))}
        <line x1={px(p, p.limit)} x2={px(p, p.limit)} y1={p.top - 4} y2={p.top + 98} class="qfig-gq15br-limit" />
        <text x={px(p, p.limit) + 6} y={p.top + 114} class="qfig-gq15br-lim">
          <tspan data-lang-en>{p.limEn}</tspan>
          <tspan data-lang-vi>{p.limVi}</tspan>
        </text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-gq15br { margin: 0; width: 100%; }
  .qfig-gq15br svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq15br text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq15br .qfig-gq15br-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq15br .qfig-gq15br-lane { font-weight: 700; fill: var(--text); }
  .qfig-gq15br .qfig-gq15br-t { font-weight: 600; fill: var(--text); }
  .qfig-gq15br .qfig-gq15br-lim { font-weight: 700; fill: var(--red); }
  .qfig-gq15br-bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-gq15br-limit { stroke: var(--red); stroke-width: 1.6; stroke-dasharray: 5 4; }
</style>
