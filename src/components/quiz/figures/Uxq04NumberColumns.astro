<style>
  .qfig-uxq04numbercolumns { margin: 0; width: 100%; }
  .qfig-uxq04numbercolumns svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq04numbercolumns text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq04numbercolumns .h { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qfig-uxq04numbercolumns .m { fill: var(--text-muted); font-size: 12px; }
  .qfig-uxq04numbercolumns .t { fill: var(--text); }
  .qfig-uxq04numbercolumns .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq04numbercolumns .ln { stroke: var(--text-muted); stroke-width: 1; stroke-dasharray: 4 3; fill: none; }
  .qfig-uxq04numbercolumns .lna { stroke: var(--act-3); stroke-width: 1.2; fill: none; }
  .qfig-uxq04numbercolumns .tag { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
</style>
