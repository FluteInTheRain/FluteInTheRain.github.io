---
// Quiz figure (post 20, Alpha): shows only the scenario's inputs, no answer. Inline SVG, site tokens only.
---
<div class="qfig-atq20split">
  <svg viewBox="0 0 560 160" role="img" aria-label="A timeline of the first trial: training 1929 to 1933, selection 1934 to 1935, test 1936 to 1995.">
<text x="0" y="20" class="h"><tspan data-lang-en>One trial: train, select, test</tspan><tspan data-lang-vi>Một lần chạy: huấn luyện, chọn lọc, kiểm tra</tspan></text>
<rect x="20" y="70" width="40" height="34" rx="3" class="okb" />
<rect x="60" y="70" width="16" height="34" rx="3" class="box" />
<rect x="76" y="70" width="480" height="34" rx="3" class="badb" />
<line x1="40" y1="48" x2="40" y2="70" class="mut" />
<text x="20" y="42" class="s"><tspan data-lang-en>Training 1929 to 1933</tspan><tspan data-lang-vi>Huấn luyện 1929 đến 1933</tspan></text>
<line x1="68" y1="124" x2="68" y2="104" class="mut" />
<text x="60" y="142" class="s"><tspan data-lang-en>Selection 1934 to 1935</tspan><tspan data-lang-vi>Chọn lọc 1934 đến 1935</tspan></text>
<text x="310" y="92" class="b" text-anchor="middle"><tspan data-lang-en>Test 1936 to 1995</tspan><tspan data-lang-vi>Kiểm tra 1936 đến 1995</tspan></text>
  </svg>
</div>

<style>
  .qfig-atq20split { margin: 0.5em 0; width: 100%; }
  .qfig-atq20split svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .qfig-atq20split text { font-size: 13px; fill: var(--text-body); }
  .qfig-atq20split .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-atq20split .s { font-size: 12px; fill: var(--text-muted); }
  .qfig-atq20split .b { font-weight: 700; fill: var(--text); }
  .qfig-atq20split .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-atq20split .okb { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .qfig-atq20split .badb { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-atq20split .ax { stroke: var(--border); stroke-width: 1.2; fill: none; }
  .qfig-atq20split .grid { stroke: var(--border); stroke-width: 1; stroke-dasharray: 3 4; fill: none; }
  .qfig-atq20split .mut { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 4 3; fill: none; }
  .qfig-atq20split .st { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .qfig-atq20split .gd { fill: var(--gold); } .qfig-atq20split .rd { fill: var(--red); }
</style>