---
// Quiz figure, set 04: stock D waterfall (exact Shapley, 8-stock background; same numbers as the post).
const W = 580;
const H = 340;
const base = -0.066;
const feats = [
  { en: '12-month momentum', vi: 'Momentum 12 tháng', v: 0.549 },
  { en: '6-month momentum', vi: 'Momentum 6 tháng', v: 0.178 },
  { en: 'value', vi: 'value', v: 0.446 },
  { en: 'volatility', vi: 'biến động', v: 0.016 },
  { en: 'size', vi: 'quy mô', v: 0.417 },
];
const X0 = 232, S = 165;
const px = (v: number) => X0 + v * S;
let cum = base;
const rows = feats.map((f, i) => { const a = cum; cum += f.v; return { ...f, a, b: cum, y: 64 + (i + 1) * 34 }; });
const f = (n: number) => (n >= 0 ? '+' : '-') + Math.abs(n).toFixed(3);
const fv = (n: number) => f(n).replace('.', ',');
---
<div class="qd9w">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <text x="16" y="24" class="h">
      <tspan data-lang-en>Stock D: average, five pushes, score</tspan>
      <tspan data-lang-vi>Cổ phiếu D: mức trung bình, năm cú đẩy, điểm</tspan>
    </text>
    <line x1={px(0)} x2={px(0)} y1="44" y2="296" class="zero" />
    <text x="16" y={64 + 22} class="lab">
      <tspan data-lang-en>average score</tspan>
      <tspan data-lang-vi>điểm trung bình</tspan>
    </text>
    <rect x={px(base)} y={64 + 8} width={px(0) - px(base)} height="16" class="bar is-base" />
    <text x={px(0) + 6} y={64 + 21} class="val">
      <tspan data-lang-en>-0.066</tspan>
      <tspan data-lang-vi>-0,066</tspan>
    </text>
    {rows.map((r) => (
      <g>
        <text x="16" y={r.y + 22} class="lab">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <rect x={px(r.a)} y={r.y + 8} width={Math.max(2, px(r.b) - px(r.a))} height="16" class="bar is-up" />
        <text x={px(r.b) + 6} y={r.y + 21} class="val">
          <tspan data-lang-en>{f(r.v)}</tspan>
          <tspan data-lang-vi>{fv(r.v)}</tspan>
        </text>
      </g>
    ))}
    <text x="16" y={64 + 6 * 34 + 22} class="lab b">
      <tspan data-lang-en>score for D</tspan>
      <tspan data-lang-vi>điểm của D</tspan>
    </text>
    <rect x={px(0)} y={64 + 6 * 34 + 8} width={px(1.54) - px(0)} height="16" class="bar is-final" />
    <text x={px(1.54) + 6} y={64 + 6 * 34 + 21} class="val">
      <tspan data-lang-en>1.540</tspan>
      <tspan data-lang-vi>1,540</tspan>
    </text>
  </svg>
</div>

<style>
  .qd9w { margin: 0; width: 100%; }
  .qd9w svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .qd9w text { font-size: 13px; fill: var(--text-body); }
  .qd9w .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qd9w .lab { fill: var(--text); }
  .qd9w .lab.b { font-weight: 700; }
  .qd9w .val { font-size: 12.5px; font-weight: 700; fill: var(--text); }
  .qd9w .zero { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .qd9w .bar.is-base { fill: var(--text-faint); }
  .qd9w .bar.is-up { fill: var(--gold); }
  .qd9w .bar.is-final { fill: var(--act-2); }
</style>
