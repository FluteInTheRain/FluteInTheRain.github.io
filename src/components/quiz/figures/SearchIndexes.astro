---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 08: grep reads everything for each query; a trigram index looks up short lists first.
// Inputs match the scenario (1,200 GB, 64 cores, 0.6 GB/s per core). The trigram example uses
// the word "cache" and the lists from the post, so no question answer is drawn here.
// Plain inline SVG, site tokens only, no markers/defs (the page renders each figure twice).
const W = 580;
const H = 484;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

// panel A (grep)
const aTop = 10;
const aH = 152;
const aMid = aTop + 74;
const aIn = arrow(150, aMid, 238, aMid);
const aOut = arrow(352, aMid, 398, aMid);

// panel B (trigram index)
const bTop = 178;
const bH = 296;
const rows = [
  { gram: 'cac', ids: [3, 8, 41, 97] },
  { gram: 'ach', ids: [3, 8, 12, 41] },
  { gram: 'che', ids: [3, 8, 41, 63] },
];
const hit = new Set([3, 8, 41]);
const rowY = (i: number) => bTop + 82 + i * 36;
const cellX = (j: number) => 170 + j * 52;
const down = arrow(300, bTop + 212, 300, bTop + 242);
---
<div class="srx">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <!-- panel A: grep -->
    <rect x="8" y={aTop} width={W - 16} height={aH} rx="8" class="srx-panel is-bad" />
    <text x="22" y={aTop + 28} class="srx-title">
      <tspan data-lang-en>Option 1: run grep on every query</tspan>
      <tspan data-lang-vi>Cách 1: chạy grep cho mỗi truy vấn</tspan>
    </text>
    <DiagramIcon name="folder" x={60} y={aMid} size={34} />
    <text x="60" y={aMid + 38} text-anchor="middle" class="srx-num">1,200 GB</text>
    <text x="60" y={aMid + 54} text-anchor="middle" class="srx-note">
      <tspan data-lang-en>all the code</tspan>
      <tspan data-lang-vi>toàn bộ code</tspan>
    </text>
    <g class="srx-arrow is-bad"><path d={aIn.line} /><polygon points={aIn.head} /></g>
    <DiagramIcon name="server" x={295} y={aMid - 14} size={34} />
    <text x="295" y={aMid + 26} text-anchor="middle" class="srx-strong">
      <tspan data-lang-en>64 cores</tspan>
      <tspan data-lang-vi>64 nhân</tspan>
    </text>
    <text x="295" y={aMid + 44} text-anchor="middle" class="srx-note">
      <tspan data-lang-en>0.6 GB/s each</tspan>
      <tspan data-lang-vi>0,6 GB/s mỗi nhân</tspan>
    </text>
    <g class="srx-arrow is-bad"><path d={aOut.line} /><polygon points={aOut.head} /></g>
    <text x="408" y={aMid - 6} class="srx-strong is-red">
      <tspan data-lang-en>Reads all of it</tspan>
      <tspan data-lang-vi>Đọc hết tất cả</tspan>
    </text>
    <text x="408" y={aMid + 14} class="srx-note">
      <tspan data-lang-en>for one query</tspan>
      <tspan data-lang-vi>cho một truy vấn</tspan>
    </text>

    <!-- panel B: trigram index -->
    <rect x="8" y={bTop} width={W - 16} height={bH} rx="8" class="srx-panel is-good" />
    <text x="22" y={bTop + 28} class="srx-title">
      <tspan data-lang-en>Option 2: look up trigrams first</tspan>
      <tspan data-lang-vi>Cách 2: tra trigram trước</tspan>
    </text>
    <text x="22" y={bTop + 50} class="srx-note">
      <tspan data-lang-en>Example search: cache, which has three trigrams</tspan>
      <tspan data-lang-vi>Ví dụ tìm cache, gồm ba trigram</tspan>
    </text>
    <DiagramIcon name="index" x={36} y={bTop + 118} size={30} />
    <text x="36" y={bTop + 150} text-anchor="middle" class="srx-note">
      <tspan data-lang-en>index</tspan>
      <tspan data-lang-vi>index</tspan>
    </text>

    {rows.map((r, i) => (
      <g>
        <text x="76" y={rowY(i) + 5} class="srx-gram">{r.gram}</text>
        <text x="122" y={rowY(i) + 5} class="srx-note">→</text>
        {r.ids.map((id, j) => (
          <g>
            <rect x={cellX(j)} y={rowY(i) - 14} width="44" height="28" rx="5" class={hit.has(id) ? 'srx-chip is-hit' : 'srx-chip'} />
            <text x={cellX(j) + 22} y={rowY(i) + 5} text-anchor="middle" class={hit.has(id) ? 'srx-chip-num is-hit' : 'srx-chip-num'}>{id}</text>
          </g>
        ))}
        <text x={cellX(4) - 2} y={rowY(i) + 5} class="srx-note">…</text>
      </g>
    ))}
    <text x="410" y={rowY(0) + 5} class="srx-note">
      <tspan data-lang-en>one list of</tspan>
      <tspan data-lang-vi>mỗi danh sách là</tspan>
    </text>
    <text x="410" y={rowY(1) + 5} class="srx-note">
      <tspan data-lang-en>document ids</tspan>
      <tspan data-lang-vi>các id tài liệu</tspan>
    </text>
    <text x="410" y={rowY(2) + 5} class="srx-note">
      <tspan data-lang-en>per trigram</tspan>
      <tspan data-lang-vi>cho mỗi trigram</tspan>
    </text>

    <text x="76" y={bTop + 198} class="srx-strong">
      <tspan data-lang-en>Keep ids that are in every list</tspan>
      <tspan data-lang-vi>Giữ các id có trong mọi danh sách</tspan>
    </text>
    <g class="srx-arrow is-good"><path d={down.line} /><polygon points={down.head} /></g>
    <DiagramIcon name="file" x={76} y={bTop + 268} size={26} />
    <text x="100" y={bTop + 273} class="srx-strong">
      <tspan data-lang-en>Open only those few documents and check them</tspan>
      <tspan data-lang-vi>Chỉ mở vài tài liệu đó ra kiểm tra</tspan>
    </text>
  </svg>
</div>

<style>
  .srx { margin: 0; width: 100%; }
  .srx svg { display: block; width: 100%; min-width: 360px; height: auto; }
  .srx text { font-size: 13px; fill: var(--text-body); }
  .srx .srx-title { font-size: 15px; font-weight: 700; fill: var(--text); }
  .srx .srx-strong { font-weight: 700; fill: var(--text); }
  .srx .srx-strong.is-red { fill: var(--red); }
  .srx .srx-note { fill: var(--text-muted); }
  .srx .srx-num { font-variant-numeric: tabular-nums; font-weight: 700; fill: var(--text); }
  .srx .srx-gram { font-weight: 700; fill: var(--text); letter-spacing: 0.04em; }
  .srx .srx-panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .srx .srx-panel.is-bad { stroke: var(--red); }
  .srx .srx-panel.is-good { stroke: var(--gold); }
  .srx .srx-chip { fill: var(--bg); stroke: var(--border); stroke-width: 1.5; }
  .srx .srx-chip.is-hit { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .srx .srx-chip-num { font-variant-numeric: tabular-nums; fill: var(--text-muted); }
  .srx .srx-chip-num.is-hit { font-weight: 700; fill: var(--text); }
  .srx .srx-arrow path { fill: none; stroke-width: 2.5; }
  .srx .srx-arrow.is-bad path { stroke: var(--red); }
  .srx .srx-arrow.is-bad polygon { fill: var(--red); }
  .srx .srx-arrow.is-good path { stroke: var(--gold-icon); }
  .srx .srx-arrow.is-good polygon { fill: var(--gold-icon); }
</style>
