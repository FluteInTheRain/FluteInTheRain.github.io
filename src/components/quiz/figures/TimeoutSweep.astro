---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for distributed systems set 03: shared cloud cluster RTT trace (25 ms calm, 60 ms p99,
// 240 ms noisy-neighbor burst for 2 s) and 6-node cluster at 1,400/2,000 req/s each with QoS off.
// Shows only scenario inputs, never computed survivor load or cascading-failure outcomes.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.

const W = 580;
const H = 432;

// Top RTT plot bounds
const plotL = 52;
const plotR = 556;
const plotTop = 64;
const plotBot = 186;
const maxMs = 310;
const tx = (s: number) => plotL + (s / 3) * (plotR - plotL);
const py = (ms: number) => plotBot - (ms / maxMs) * (plotBot - plotTop);

// Deterministic RTT curve: 25 ms baseline with a 60 ms p99 ripple at 0.25 s, then a 240 ms burst from 0.6 s to 2.6 s
const points: [number, number][] = [
  [0.0, 25], [0.15, 24], [0.25, 60], [0.35, 26], [0.5, 25],
  [0.58, 32], [0.62, 236], [0.85, 242], [1.15, 238], [1.45, 244],
  [1.75, 239], [2.05, 241], [2.35, 237], [2.58, 240], [2.64, 29],
  [2.8, 25], [3.0, 25],
];
const rttPath = points
  .map(([s, ms], i) => `${i === 0 ? 'M' : 'L'} ${tx(s).toFixed(1)} ${py(ms).toFixed(1)}`)
  .join(' ');

function arrow(x1: number, y1: number, x2: number, y2: number, head = 8) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - head * Math.cos(a - 0.45), y2 - head * Math.sin(a - 0.45)];
  const p2 = [x2 - head * Math.cos(a + 0.45), y2 - head * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - (head - 2) * Math.cos(a)} ${y2 - (head - 2) * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const nodes = [
  { id: 'N1', x: 232, y: 254, rtt: '25 ms', hot: false },
  { id: 'N2', x: 408, y: 254, rtt: '25 ms', hot: false },
  { id: 'N3', x: 232, y: 306, rtt: '25 ms', hot: false },
  { id: 'N4', x: 408, y: 306, rtt: '25 ms', hot: false },
  { id: 'N5', x: 232, y: 358, rtt: '240 ms', hot: true },
  { id: 'N6', x: 408, y: 358, rtt: '240 ms', hot: true },
];

const inArrow = arrow(102, 286, 128, 286);
const swOut = [276, 328, 380].map((ny) => arrow(206, 286, 230, ny, 7));
---
<div class="qfig-tsw">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: a 3-second RTT chart showing calm 25 ms RTT with 60 ms p99, a 240 ms noisy-neighbor burst lasting 2 seconds, a 100 ms candidate fixed timeout line, and a 5,000 ms candidate noted off-scale above. Bottom: 8,400 req/s enters a shared switch with QoS disabled across 6 nodes each running 1,400 of 2,000 req/s capacity, with 2 nodes experiencing the 240 ms burst.">
    <text x="0" y="20" class="qfig-tsw-h">
      <tspan data-lang-en>Shared cloud RTT under a 2 s burst</tspan>
      <tspan data-lang-vi>Độ trễ khứ hồi trên cloud trong đợt nghẽn 2 giây</tspan>
    </text>
    <text x="0" y="38" class="qfig-tsw-m">
      <tspan data-lang-en>Calm RTT 25 ms (p99 60 ms) · Candidate timeouts: 100 ms vs. 5,000 ms</tspan>
      <tspan data-lang-vi>Lúc êm 25 ms (p99 60 ms) · Hai mức timeout: 100 ms và 5.000 ms</tspan>
    </text>

    <text x={plotR} y="56" text-anchor="end" class="qfig-tsw-m">
      <tspan data-lang-en>↑ 5,000 ms candidate sits off-scale above</tspan>
      <tspan data-lang-vi>↑ Mức 5.000 ms nằm vượt xa phía trên</tspan>
    </text>

    {[0, 100, 240].map((ms) => (
      <g>
        <line x1={plotL} x2={plotR} y1={py(ms)} y2={py(ms)} class="qfig-tsw-grid" />
        <text x={plotL - 8} y={py(ms) + 4} text-anchor="end" class="qfig-tsw-tick">{ms}</text>
      </g>
    ))}
    <text x={plotL - 8} y={plotTop - 4} text-anchor="end" class="qfig-tsw-tick">ms</text>

    <rect x={tx(0.6)} y={plotTop} width={tx(2.6) - tx(0.6)} height={plotBot - plotTop} class="qfig-tsw-zone" />
    <text x={tx(1.6)} y={plotTop + 13} text-anchor="middle" class="qfig-tsw-red">
      <tspan data-lang-en>Noisy-neighbor burst: 240 ms for 2 s</tspan>
      <tspan data-lang-vi>Hàng xóm ồn ào: 240 ms trong 2 giây</tspan>
    </text>

    <line x1={plotL} x2={plotR} y1={py(100)} y2={py(100)} class="qfig-tsw-to" />
    <text x={tx(1.6)} y={py(100) - 6} text-anchor="middle" class="qfig-tsw-red">
      <tspan data-lang-en>100 ms fixed timeout</tspan>
      <tspan data-lang-vi>Timeout cố định 100 ms</tspan>
    </text>

    <path d={rttPath} class="qfig-tsw-rtt" />

    <line x1={plotL} x2={plotR} y1={plotBot} y2={plotBot} class="qfig-tsw-axis" />
    {[0, 1, 2, 3].map((s) => (
      <g>
        <line x1={tx(s)} x2={tx(s)} y1={plotBot} y2={plotBot + 5} class="qfig-tsw-axis" />
        <text x={tx(s)} y={plotBot + 19} text-anchor="middle" class="qfig-tsw-tick">
          <tspan data-lang-en>{s} s</tspan>
          <tspan data-lang-vi>{s} giây</tspan>
        </text>
      </g>
    ))}

    <line x1="0" x2={W} y1="220" y2="220" class="qfig-tsw-rule" />

    <text x="0" y="242" class="qfig-tsw-h">
      <tspan data-lang-en>6-node cluster (QoS like L4S and Linux tc off)</tspan>
      <tspan data-lang-vi>Cụm 6 node (tắt QoS như L4S và Linux tc)</tspan>
    </text>

    <DiagramIcon name="users" x={18} y={286} size={24} />
    <text x="36" y="282" class="qfig-tsw-t">
      <tspan data-lang-en>8,400 req/s</tspan>
      <tspan data-lang-vi>8.400 req/s</tspan>
    </text>
    <text x="36" y="299" class="qfig-tsw-m">
      <tspan data-lang-en>total load</tspan>
      <tspan data-lang-vi>tổng tải</tspan>
    </text>
    <g class="qfig-tsw-arrow"><path d={inArrow.line} /><polygon points={inArrow.head} /></g>

    <rect x="130" y="256" width="76" height="60" rx="7" class="qfig-tsw-box" />
    <DiagramIcon name="network" x={168} y={276} size={22} />
    <text x="168" y="305" text-anchor="middle" class="qfig-tsw-sm">
      <tspan data-lang-en>Switch</tspan>
      <tspan data-lang-vi>Switch</tspan>
    </text>

    {swOut.map((a) => (
      <g class="qfig-tsw-arrow"><path d={a.line} /><polygon points={a.head} /></g>
    ))}

    {nodes.map((n) => (
      <g>
        <rect x={n.x} y={n.y} width="170" height="44" rx="6" class={n.hot ? 'qfig-tsw-hot' : 'qfig-tsw-box'} />
        <DiagramIcon name={n.hot ? 'warning' : 'server'} x={n.x + 18} y={n.y + 13} size={15} />
        <text x={n.x + 32} y={n.y + 19} class={n.hot ? 'qfig-tsw-red' : 'qfig-tsw-t'}>
          {n.id} · {n.rtt}
        </text>
        <text x={n.x + 12} y={n.y + 36} class="qfig-tsw-m">
          <tspan data-lang-en>1,400 / 2,000 req/s (70%)</tspan>
          <tspan data-lang-vi>1.400 / 2.000 req/s (70%)</tspan>
        </text>
      </g>
    ))}

    <DiagramIcon name="phone" x={14} y={356} size={20} />
    <text x="30" y="352" class="qfig-tsw-sm">
      <tspan data-lang-en>VoIP audio shares link</tspan>
      <tspan data-lang-vi>VoIP dùng chung mạng</tspan>
    </text>
    <text x="30" y="369" class="qfig-tsw-m">
      <tspan data-lang-en>150 ms frame cutoff</tspan>
      <tspan data-lang-vi>hạn khung thoại 150 ms</tspan>
    </text>
    <text x="0" y="422" class="qfig-tsw-m">
      <tspan data-lang-en>Each node handles 1,400 req/s out of 2,000 req/s capacity (70% load).</tspan>
      <tspan data-lang-vi>Mỗi node chạy 1.400 req/s trên công suất 2.000 req/s (70% tải).</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-tsw { margin: 0; width: 100%; }
  .qfig-tsw svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-tsw text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-tsw .qfig-tsw-h { font-size: 15.5px; font-weight: 700; fill: var(--text); }
  .qfig-tsw .qfig-tsw-t { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-tsw .qfig-tsw-sm { font-size: 12.5px; font-weight: 600; fill: var(--text); }
  .qfig-tsw .qfig-tsw-m { font-size: 12px; fill: var(--text-muted); }
  .qfig-tsw .qfig-tsw-tick { font-size: 12px; fill: var(--text-muted); }
  .qfig-tsw .qfig-tsw-red { font-size: 12.5px; font-weight: 700; fill: var(--red); }
  .qfig-tsw-grid { stroke: var(--border); stroke-width: 1; }
  .qfig-tsw-rule { stroke: var(--border); stroke-width: 1.2; }
  .qfig-tsw-axis { stroke: var(--text-muted); stroke-width: 1.3; }
  .qfig-tsw-zone { fill: var(--red-tint-bg); opacity: 0.75; }
  .qfig-tsw-to { stroke: var(--red); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .qfig-tsw-rtt { fill: none; stroke: var(--text); stroke-width: 2.2; stroke-linejoin: round; }
  .qfig-tsw-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-tsw-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .qfig-tsw-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-tsw-arrow polygon { fill: var(--text-muted); }
</style>
