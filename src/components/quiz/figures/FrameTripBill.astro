---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 07 (trade-offs post): one second of one stream in the first, serverless version of a video monitor.
// Shows counts and unit prices only (no totals), so it never gives an answer away.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids, so the EN and VI copies cannot clash.

const W = 580;
const H = 384;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const conv = { x: 76, y: 112, w: 116, h: 56 };
const s3 = { x: 276, y: 96, w: 92, h: 88 };
const dets = [0, 1, 2].map((i) => ({ x: 448, y: 70 + i * 52, w: 124, h: 40, n: i + 1 }));
const midY = 140;
const orch = { x: 10, y: 244, w: 560, h: 58 };
const stops = [conv.x + conv.w / 2, s3.x + s3.w / 2, dets[0].x + dets[0].w / 2];
---
<div class="qft">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="One second of one stream in the first version: a converter writes 10 frames to S3, three detectors each read all 10 frames, and a workflow service makes 4 state transitions.">
    <text x="10" y="26" class="qft-h">
      <tspan data-lang-en>One second of one stream</tspan>
      <tspan data-lang-vi>Một giây của một luồng</tspan>
    </text>

    <DiagramIcon name="stream" x={28} y={midY} size={28} />
    <text x="28" y={midY + 36} text-anchor="middle" class="qft-sub">
      <tspan data-lang-en>Stream</tspan>
      <tspan data-lang-vi>Luồng</tspan>
    </text>
    {(() => { const a = arrow(50, midY, conv.x - 2, midY); return <g class="qft-arrow"><path d={a.line} /><polygon points={a.head} /></g>; })()}

    <g class="qft-box">
      <rect x={conv.x} y={conv.y} width={conv.w} height={conv.h} rx="8" />
      <text x={conv.x + conv.w / 2} y={conv.y + 24} text-anchor="middle" class="qft-name">
        <tspan data-lang-en>Converter</tspan>
        <tspan data-lang-vi>Bộ chuyển đổi</tspan>
      </text>
      <text x={conv.x + conv.w / 2} y={conv.y + 44} text-anchor="middle" class="qft-sub">
        <tspan data-lang-en>10 frames</tspan>
        <tspan data-lang-vi>10 khung hình</tspan>
      </text>
    </g>

    {(() => { const a = arrow(conv.x + conv.w, midY, s3.x - 2, midY); return <g class="qft-arrow is-trip"><path d={a.line} /><polygon points={a.head} /></g>; })()}
    <text x={(conv.x + conv.w + s3.x) / 2} y={midY - 10} text-anchor="middle" class="qft-trip">
      <tspan data-lang-en>10 writes</tspan>
      <tspan data-lang-vi>10 lần ghi</tspan>
    </text>

    <g class="qft-box">
      <rect x={s3.x} y={s3.y} width={s3.w} height={s3.h} rx="8" />
      <DiagramIcon name="s3" x={s3.x + s3.w / 2} y={s3.y + 28} size={30} />
      <text x={s3.x + s3.w / 2} y={s3.y + 68} text-anchor="middle" class="qft-name">S3</text>
    </g>

    {dets.map((d) => {
      const a = arrow(s3.x + s3.w, midY, d.x - 2, d.y + d.h / 2);
      return (
        <g>
          <g class="qft-arrow is-trip"><path d={a.line} /><polygon points={a.head} /></g>
          <g class="qft-box">
            <rect x={d.x} y={d.y} width={d.w} height={d.h} rx="8" />
            <text x={d.x + 10} y={d.y + 17} class="qft-name">
              <tspan data-lang-en>Detector {d.n}</tspan>
              <tspan data-lang-vi>Detector {d.n}</tspan>
            </text>
            <text x={d.x + 10} y={d.y + 33} class="qft-trip">
              <tspan data-lang-en>10 reads</tspan>
              <tspan data-lang-vi>10 lần đọc</tspan>
            </text>
          </g>
        </g>
      );
    })}

    {stops.map((x) => (
      <line x1={x} x2={x} y1={x === stops[2] ? dets[2].y + dets[2].h + 4 : (x === stops[0] ? conv.y + conv.h + 4 : s3.y + s3.h + 4)} y2={orch.y - 4} class="qft-link" />
    ))}

    <g class="qft-box is-orch">
      <rect x={orch.x} y={orch.y} width={orch.w} height={orch.h} rx="8" />
      <DiagramIcon name="sync" x={orch.x + 26} y={orch.y + orch.h / 2} size={24} />
      <text x={orch.x + 52} y={orch.y + 24} class="qft-name">
        <tspan data-lang-en>Workflow service (Step Functions)</tspan>
        <tspan data-lang-vi>Dịch vụ workflow (Step Functions)</tspan>
      </text>
      <text x={orch.x + 52} y={orch.y + 44} class="qft-trip">
        <tspan data-lang-en>4 state transitions per second</tspan>
        <tspan data-lang-vi>4 lần chuyển trạng thái mỗi giây</tspan>
      </text>
    </g>

    <text x="10" y="334" class="qft-note">
      <tspan data-lang-en>Price: transition $0.000025, write $0.000005, read $0.0000004</tspan>
      <tspan data-lang-vi>Giá: chuyển trạng thái 0,000025 USD, ghi 0,000005 USD, đọc 0,0000004 USD</tspan>
    </text>
    <text x="10" y="358" class="qft-note">
      <tspan data-lang-en>Account limit: 1,500 transitions per second</tspan>
      <tspan data-lang-vi>Giới hạn tài khoản: 1.500 lần chuyển trạng thái mỗi giây</tspan>
    </text>
  </svg>
</div>

<style>
  .qft { margin: 0; width: 100%; }
  .qft svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qft text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qft .qft-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qft .qft-name { font-weight: 700; fill: var(--text); }
  .qft .qft-sub { fill: var(--text-muted); }
  .qft .qft-trip { fill: var(--red); font-weight: 600; }
  .qft .qft-note { fill: var(--text); }
  .qft-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qft-box.is-orch rect { fill: var(--red-tint-bg); stroke: var(--red); }
  .qft-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .qft-arrow polygon { fill: var(--text-muted); }
  .qft-arrow.is-trip path { stroke: var(--red); }
  .qft-arrow.is-trip polygon { fill: var(--red); }
  .qft-link { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 5 4; }
</style>
