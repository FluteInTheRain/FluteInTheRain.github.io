---
// Quiz figure for go-http-service-net-http-json-middleware set 04: a seconds axis after SIGTERM with the three durations in play.
// It places the numbers on one axis; it does not say what happens to the request.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
---
<div class="qfig-gq10t">
  <svg viewBox="0 0 580 270" role="img" aria-label="A time axis from 0 to 12 seconds after SIGTERM. One request needs 8 seconds of work. The docker stop wait is 5 seconds. The Shutdown context deadline is 10 seconds.">
    <text x="0" y="20" class="qfig-gq10t-h">
      <tspan data-lang-en>Seconds after SIGTERM arrives</tspan>
      <tspan data-lang-vi>Số giây sau khi SIGTERM tới</tspan>
    </text>

    <line x1="30" x2="550" y1="200" y2="200" class="qfig-gq10t-ax" />
    <line x1="30" x2="30" y1="194" y2="206" class="qfig-gq10t-ax" />
    <line x1="160" x2="160" y1="194" y2="206" class="qfig-gq10t-ax" />
    <line x1="290" x2="290" y1="194" y2="206" class="qfig-gq10t-ax" />
    <line x1="420" x2="420" y1="194" y2="206" class="qfig-gq10t-ax" />
    <line x1="550" x2="550" y1="194" y2="206" class="qfig-gq10t-ax" />
    <text x="30" y="226" text-anchor="middle" class="qfig-gq10t-m">0s</text>
    <text x="160" y="226" text-anchor="middle" class="qfig-gq10t-m">3s</text>
    <text x="290" y="226" text-anchor="middle" class="qfig-gq10t-m">6s</text>
    <text x="420" y="226" text-anchor="middle" class="qfig-gq10t-m">9s</text>
    <text x="550" y="226" text-anchor="middle" class="qfig-gq10t-m">12s</text>

    <text x="30" y="58" class="qfig-gq10t-t">
      <tspan data-lang-en>One request: 8 seconds of work left</tspan>
      <tspan data-lang-vi>Một request: còn 8 giây xử lý</tspan>
    </text>
    <rect x="30" y="68" width="347" height="26" rx="5" class="qfig-gq10t-req" />

    <line x1="30" x2="30" y1="104" y2="200" class="qfig-gq10t-mk" />
    <text x="38" y="120" class="qfig-gq10t-b">SIGTERM</text>

    <line x1="247" x2="247" y1="104" y2="200" class="qfig-gq10t-mk" />
    <text x="255" y="120" class="qfig-gq10t-b">
      <tspan data-lang-en>docker stop -t 5: 5s</tspan>
      <tspan data-lang-vi>docker stop -t 5: 5 giây</tspan>
    </text>

    <line x1="463" x2="463" y1="140" y2="200" class="qfig-gq10t-mk" />
    <text x="455" y="156" text-anchor="end" class="qfig-gq10t-b">
      <tspan data-lang-en>Shutdown context: 10s</tspan>
      <tspan data-lang-vi>context Shutdown: 10 giây</tspan>
    </text>

    <text x="30" y="258" class="qfig-gq10t-n">
      <tspan data-lang-en>Request bar ends at 8s; the two marks sit at 5s and 10s.</tspan>
      <tspan data-lang-vi>Thanh request kết thúc ở 8 giây; hai vạch nằm ở 5 và 10 giây.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq10t { margin: 0; width: 100%; }
  .qfig-gq10t svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq10t text { font-size: 13px; fill: var(--text-body); }
  .qfig-gq10t .qfig-gq10t-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq10t .qfig-gq10t-t { font-weight: 700; fill: var(--text); }
  .qfig-gq10t .qfig-gq10t-m { font-family: 'JetBrains Mono', ui-monospace, monospace; fill: var(--text-muted); }
  .qfig-gq10t .qfig-gq10t-b { fill: var(--text); }
  .qfig-gq10t .qfig-gq10t-n { fill: var(--text-muted); }
  .qfig-gq10t-ax { stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-gq10t-mk { stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .qfig-gq10t-req { fill: var(--bg-alt); stroke: var(--act-3); stroke-width: 2; }
</style>
