---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for trade-offs set 02: the app writes one order to Postgres, then to a search index.
// The index write fails for order 1042; a small ledger shows what each store holds afterwards.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
function head(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`;
}
const rows = [
  { id: '1041', y: 252, ok: true },
  { id: '1042', y: 290, ok: false },
  { id: '1043', y: 328, ok: true },
];
---
<div class="qfig-dw">
  <svg viewBox="0 0 580 360" role="img" aria-label="An order service sends order 1042 to Postgres, which commits it, and then to a search index, where the write times out. A table lists orders 1041 to 1043: all three are in Postgres, and 1042 is missing from the search index.">
    <text x="0" y="22" class="qfig-dw-h">
      <tspan data-lang-en>One request, two writes</tspan>
      <tspan data-lang-vi>Một request, hai lần ghi</tspan>
    </text>

    <DiagramIcon name="server" x="52" y="104" size={30} />
    <text x="52" y="142" text-anchor="middle" class="qfig-dw-m">
      <tspan data-lang-en>Order service</tspan>
      <tspan data-lang-vi>Order service</tspan>
    </text>

    <!-- write 1 -->
    <path d="M 82 104 L 110 104 L 110 70 L 224 70" class="qfig-dw-ok" />
    <polygon points={head(232, 70)} class="qfig-dw-okhead" />
    <text x="124" y="60" class="qfig-dw-m">
      <tspan data-lang-en>write 1</tspan>
      <tspan data-lang-vi>ghi lần 1</tspan>
    </text>
    <DiagramIcon name="postgres" x="262" y="70" size={32} />
    <text x="292" y="64" class="qfig-dw-t">
      <tspan data-lang-en>Postgres</tspan>
      <tspan data-lang-vi>Postgres</tspan>
    </text>
    <text x="292" y="83" class="qfig-dw-b">
      <tspan data-lang-en>commits order 1042</tspan>
      <tspan data-lang-vi>commit đơn 1042</tspan>
    </text>

    <!-- write 2 -->
    <path d="M 110 104 L 110 148 L 224 148" class="qfig-dw-bad" />
    <polygon points={head(232, 148)} class="qfig-dw-badhead" />
    <text x="124" y="138" class="qfig-dw-m">
      <tspan data-lang-en>write 2</tspan>
      <tspan data-lang-vi>ghi lần 2</tspan>
    </text>
    <DiagramIcon name="elasticsearch" x="262" y="148" size={32} />
    <text x="292" y="142" class="qfig-dw-t">
      <tspan data-lang-en>Search index</tspan>
      <tspan data-lang-vi>Search index</tspan>
    </text>
    <text x="292" y="161" class="qfig-dw-r">
      <tspan data-lang-en>write times out</tspan>
      <tspan data-lang-vi>lần ghi bị timeout</tspan>
    </text>

    <!-- ledger -->
    <text x="0" y="196" class="qfig-dw-t">
      <tspan data-lang-en>What each store holds afterwards</tspan>
      <tspan data-lang-vi>Mỗi kho có gì sau đó</tspan>
    </text>
    <text x="14" y="220" class="qfig-dw-m">
      <tspan data-lang-en>Order</tspan>
      <tspan data-lang-vi>Đơn</tspan>
    </text>
    <text x="144" y="220" class="qfig-dw-m">
      <tspan data-lang-en>In Postgres</tspan>
      <tspan data-lang-vi>Trong Postgres</tspan>
    </text>
    <text x="374" y="220" class="qfig-dw-m">
      <tspan data-lang-en>In the search index</tspan>
      <tspan data-lang-vi>Trong search index</tspan>
    </text>
    {rows.map((r) => (
      <g>
        <rect x="0" y={r.y - 18} width="124" height="32" rx="4" class="qfig-dw-cell" />
        <text x="14" y={r.y + 4} class="qfig-dw-t">{r.id}</text>
        <rect x="130" y={r.y - 18} width="230" height="32" rx="4" class="qfig-dw-cell" />
        <text x="144" y={r.y + 4} class="qfig-dw-b">
          <tspan data-lang-en>saved</tspan>
          <tspan data-lang-vi>đã lưu</tspan>
        </text>
        <rect x="366" y={r.y - 18} width="214" height="32" rx="4" class={r.ok ? 'qfig-dw-cell' : 'qfig-dw-cellbad'} />
        <text x="380" y={r.y + 4} class={r.ok ? 'qfig-dw-b' : 'qfig-dw-r'}>
          {r.ok ? (
            <>
              <tspan data-lang-en>indexed</tspan>
              <tspan data-lang-vi>đã index</tspan>
            </>
          ) : (
            <>
              <tspan data-lang-en>missing</tspan>
              <tspan data-lang-vi>không có</tspan>
            </>
          )}
        </text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-dw { margin: 0; width: 100%; }
  .qfig-dw svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-dw text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-dw .qfig-dw-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-dw .qfig-dw-t { font-weight: 700; fill: var(--text); }
  .qfig-dw .qfig-dw-m { fill: var(--text-muted); }
  .qfig-dw .qfig-dw-r { font-weight: 700; fill: var(--red); }
  .qfig-dw-ok { stroke: var(--gold); stroke-width: 2; fill: none; }
  .qfig-dw-okhead { fill: var(--gold); }
  .qfig-dw-bad { stroke: var(--red); stroke-width: 2; fill: none; stroke-dasharray: 6 4; }
  .qfig-dw-badhead { fill: var(--red); }
  .qfig-dw-cell { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-dw-cellbad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
</style>
