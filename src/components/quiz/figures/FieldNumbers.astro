---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for set 05: the Order message with its three field numbers, the events already in a log,
// and two services that read them at different upgrade stages.
// Inline SVG, site tokens only, no <marker>/<defs>. Shows only the scenario's inputs, never an answer.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 7 * Math.cos(a)} ${y2 - 7 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const fields = [
  { tag: 1, name: 'customer_id', type: 'string', ex: '"c-1042"' },
  { tag: 2, name: 'amount_cents', type: 'int32', ex: '4999' },
  { tag: 3, name: 'coupon', type: 'string', ex: '"SAVE10"' },
];
const events = [
  { x: 56, en: 'Last month', vi: 'Tháng trước' },
  { x: 229, en: 'Last week', vi: 'Tuần trước' },
  { x: 402, en: 'Today', vi: 'Hôm nay' },
];
const a1 = arrow(142, 253, 142, 304);
const a2 = arrow(438, 253, 438, 304);
---
<div class="qfig-fn">
  <svg viewBox="0 0 580 430" role="img" aria-label="The Order message has three fields numbered 1, 2 and 3. Below it, a log holds events written last month, last week and today, and two services read them: one already upgraded, one not yet.">
    <text x="0" y="22" class="qfig-fn-h">
      <tspan data-lang-en>Order message and its field numbers</tspan>
      <tspan data-lang-vi>Message Order và số hiệu các trường</tspan>
    </text>

    {fields.map((f, i) => (
      <g>
        <rect x="0" y={38 + i * 40} width="580" height="34" rx="7" class="qfig-fn-row" />
        <circle cx="24" cy={55 + i * 40} r="12" class="qfig-fn-tag" />
        <text x="24" y={60 + i * 40} class="qfig-fn-tagn" text-anchor="middle">{f.tag}</text>
        <text x="50" y={60 + i * 40} class="qfig-fn-name">{f.name}</text>
        <text x="236" y={60 + i * 40} class="qfig-fn-m">{f.type}</text>
        <text x="350" y={60 + i * 40} class="qfig-fn-m">
          <tspan data-lang-en>e.g. {f.ex}</tspan>
          <tspan data-lang-vi>vd {f.ex}</tspan>
        </text>
      </g>
    ))}

    <text x="0" y="190" class="qfig-fn-h">
      <tspan data-lang-en>Events already stored in the log</tspan>
      <tspan data-lang-vi>Các event đã nằm trong log</tspan>
    </text>
    <DiagramIcon name="log" x="22" y="226" size={30} />
    {events.map((e) => (
      <g>
        <rect x={e.x} y="204" width="165" height="48" rx="8" class="qfig-fn-ev" />
        <text x={e.x + 12} y="224" class="qfig-fn-t">
          <tspan data-lang-en>{e.en}</tspan>
          <tspan data-lang-vi>{e.vi}</tspan>
        </text>
        <text x={e.x + 12} y="243" class="qfig-fn-m">
          <tspan data-lang-en>tags 1, 2, 3</tspan>
          <tspan data-lang-vi>tag 1, 2, 3</tspan>
        </text>
      </g>
    ))}

    <g class="qfig-fn-go"><path d={a1.line} /><polygon points={a1.head} /></g>
    <g class="qfig-fn-go"><path d={a2.line} /><polygon points={a2.head} /></g>

    <g>
      <rect x="0" y="310" width="284" height="64" rx="8" class="qfig-fn-svc" />
      <DiagramIcon name="server" x="28" y="342" size={28} />
      <text x="56" y="336" class="qfig-fn-t">
        <tspan data-lang-en>Service A</tspan>
        <tspan data-lang-vi>Service A</tspan>
      </text>
      <text x="56" y="358" class="qfig-fn-m">
        <tspan data-lang-en>already upgraded today</tspan>
        <tspan data-lang-vi>đã nâng cấp hôm nay</tspan>
      </text>
    </g>
    <g>
      <rect x="296" y="310" width="284" height="64" rx="8" class="qfig-fn-svc" />
      <DiagramIcon name="server" x="324" y="342" size={28} />
      <text x="352" y="336" class="qfig-fn-t">
        <tspan data-lang-en>Service B</tspan>
        <tspan data-lang-vi>Service B</tspan>
      </text>
      <text x="352" y="358" class="qfig-fn-m">
        <tspan data-lang-en>not upgraded yet</tspan>
        <tspan data-lang-vi>chưa nâng cấp</tspan>
      </text>
    </g>

    <text x="0" y="404" class="qfig-fn-m">
      <tspan data-lang-en>A rollout takes days. Events stay in the log for months.</tspan>
      <tspan data-lang-vi>Một đợt rollout kéo dài nhiều ngày. Event nằm trong log nhiều tháng.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-fn { margin: 0; width: 100%; }
  .qfig-fn svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-fn text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-fn .qfig-fn-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-fn .qfig-fn-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-fn .qfig-fn-name { font-size: 15px; font-weight: 600; fill: var(--text); }
  .qfig-fn .qfig-fn-m { fill: var(--text-muted); }
  .qfig-fn-row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-fn-tag { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-fn .qfig-fn-tagn { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-fn-ev { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-fn-svc { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-fn-go path { stroke: var(--text-muted); stroke-width: 1.8; fill: none; }
  .qfig-fn-go polygon { fill: var(--text-muted); }
</style>
