---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for venues post set 02: custody separation when Broker A shuts down.
---
<div class="qfig-sbq02cc">
  <svg viewBox="0 0 580 230" role="img" aria-label="Diagram showing Investor connected to Broker A (suspended), while VSDC holds 1,000 FPT shares under the investor's ID and Bank X holds segregated cash.">
    <text x="16" y="24" class="qfig-h">
      <tspan data-lang-en>Where each asset actually sits when Broker A halts</tspan>
      <tspan data-lang-vi>Tài sản thật sự nằm đâu khi CTCK A ngừng hoạt động</tspan>
    </text>

    <rect x="16" y="48" width="160" height="84" rx="8" class="qfig-card-red" />
    <DiagramIcon name="warning" x={42} y={76} size={24} />
    <text x="64" y="81" class="qfig-t qfig-red">
      <tspan data-lang-en>Broker A</tspan>
      <tspan data-lang-vi>CTCK A</tspan>
    </text>
    <text x="30" y="110" class="qfig-m">
      <tspan data-lang-en>App offline</tspan>
      <tspan data-lang-vi>App ngừng chạy</tspan>
    </text>

    <line x1="184" y1="74" x2="254" y2="74" class="qfig-ln" />
    <polygon points="262,74 252,69 252,79" class="qfig-hd" />

    <line x1="184" y1="168" x2="254" y2="168" class="qfig-ln" />
    <polygon points="262,168 252,163 252,173" class="qfig-hd" />
    <line x1="96" y1="132" x2="96" y2="168" class="qfig-dash" />
    <line x1="96" y1="168" x2="184" y2="168" class="qfig-dash" />

    <rect x="270" y="42" width="294" height="72" rx="8" class="qfig-card" />
    <DiagramIcon name="shield" x={298} y={78} size={26} />
    <text x="324" y="72" class="qfig-t">
      <tspan data-lang-en>VSDC registry (under your ID)</tspan>
      <tspan data-lang-vi>Sổ gốc VSDC (theo CCCD của bạn)</tspan>
    </text>
    <text x="324" y="96" class="qfig-b">
      <tspan data-lang-en>1,000 FPT shares intact</tspan>
      <tspan data-lang-vi>1.000 CP FPT còn nguyên</tspan>
    </text>

    <rect x="270" y="132" width="294" height="72" rx="8" class="qfig-card" />
    <DiagramIcon name="bank" x={298} y={168} size={26} />
    <text x="324" y="162" class="qfig-t">
      <tspan data-lang-en>Segregated bank account</tspan>
      <tspan data-lang-vi>Tài khoản ngân hàng tách biệt</tspan>
    </text>
    <text x="324" y="186" class="qfig-b">
      <tspan data-lang-en>15,000,000 VND idle cash</tspan>
      <tspan data-lang-vi>15.000.000 đồng tiền nhàn rỗi</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-sbq02cc { margin: 0; width: 100%; }
  .qfig-sbq02cc svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-sbq02cc text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-sbq02cc .qfig-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-sbq02cc .qfig-t { font-weight: 700; fill: var(--text); }
  .qfig-sbq02cc .qfig-b { fill: var(--text-body); }
  .qfig-sbq02cc .qfig-m { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-sbq02cc .qfig-red { fill: var(--red); }
  .qfig-sbq02cc .qfig-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-sbq02cc .qfig-card-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .qfig-sbq02cc .qfig-ln { stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-sbq02cc .qfig-dash { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .qfig-sbq02cc .qfig-hd { fill: var(--text-muted); }
</style>
