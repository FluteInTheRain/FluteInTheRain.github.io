---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for encoding set 02: two writers put job bytes on one queue, one worker decodes them.
// Inline SVG, site tokens only, no <marker>/<defs>/ids. It shows who can write and what the worker holds;
// it does not say what the decode step does.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 10 * Math.cos(a - 0.45), y2 - 10 * Math.sin(a - 0.45)];
  const p2 = [x2 - 10 * Math.cos(a + 0.45), y2 - 10 * Math.sin(a + 0.45)];
  return `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
}
---
<div class="qfig-ub">
  <svg viewBox="0 0 580 330" role="img" aria-label="Two writers put job bytes on one Redis queue: our web API and a retry upload page open to any customer. A worker reads the queue and decodes each job, and it holds the database password and cloud keys.">
    <text x="0" y="22" class="qfig-ub-h">
      <tspan data-lang-en>Who writes to the queue, and who reads it</tspan>
      <tspan data-lang-vi>Ai ghi vào queue, và ai đọc nó</tspan>
    </text>

    <g class="qfig-ub-box">
      <rect x="0" y="52" width="204" height="64" rx="8" />
    </g>
    <DiagramIcon name="server" x="26" y="84" size={26} />
    <text x="50" y="80" class="qfig-ub-b">
      <tspan data-lang-en>Our web API</tspan>
      <tspan data-lang-vi>Web API của ta</tspan>
    </text>
    <text x="50" y="100" class="qfig-ub-m">
      <tspan data-lang-en>Writes its own jobs</tspan>
      <tspan data-lang-vi>Ghi job của chính nó</tspan>
    </text>

    <g class="qfig-ub-box qfig-ub-bad">
      <rect x="0" y="160" width="204" height="76" rx="8" />
    </g>
    <DiagramIcon name="laptop" x="26" y="198" size={26} />
    <text x="50" y="188" class="qfig-ub-b">
      <tspan data-lang-en>Retry upload page</tspan>
      <tspan data-lang-vi>Trang tải lên để retry</tspan>
    </text>
    <text x="50" y="208" class="qfig-ub-m">
      <tspan data-lang-en>Open to any customer</tspan>
      <tspan data-lang-vi>Ai cũng dùng được</tspan>
    </text>
    <text x="50" y="226" class="qfig-ub-m">
      <tspan data-lang-en>Bytes go in unchanged</tspan>
      <tspan data-lang-vi>Byte đi vào nguyên vẹn</tspan>
    </text>

    <path d="M 204 84 L 238 128" class="qfig-ub-line" />
    <polygon points={arrow(204, 84, 238, 128)} class="qfig-ub-head" />
    <path d="M 204 198 L 238 158" class="qfig-ub-line qfig-ub-line-bad" />
    <polygon points={arrow(204, 198, 238, 158)} class="qfig-ub-head qfig-ub-head-bad" />

    <g class="qfig-ub-box">
      <rect x="238" y="108" width="126" height="70" rx="8" />
    </g>
    <DiagramIcon name="redis" x="262" y="134" size={26} />
    <text x="286" y="139" class="qfig-ub-b">
      <tspan data-lang-en>Queue</tspan>
      <tspan data-lang-vi>Queue</tspan>
    </text>
    <text x="301" y="164" text-anchor="middle" class="qfig-ub-m">
      <tspan data-lang-en>Redis, job bytes</tspan>
      <tspan data-lang-vi>Redis, byte job</tspan>
    </text>

    <path d="M 364 143 L 394 143" class="qfig-ub-line" />
    <polygon points={arrow(364, 143, 394, 143)} class="qfig-ub-head" />

    <g class="qfig-ub-box">
      <rect x="394" y="90" width="186" height="106" rx="8" />
    </g>
    <DiagramIcon name="worker" x="420" y="118" size={26} />
    <text x="444" y="115" class="qfig-ub-b">
      <tspan data-lang-en>Worker pool</tspan>
      <tspan data-lang-vi>Pool worker</tspan>
    </text>
    <text x="444" y="135" class="qfig-ub-m">
      <tspan data-lang-en>Pulls a job, then</tspan>
      <tspan data-lang-vi>Lấy job, rồi gọi</tspan>
    </text>
    <text x="406" y="170" class="qfig-ub-b">pickle.loads(job)</text>

    <path d="M 487 196 L 487 244" class="qfig-ub-line" />
    <polygon points={arrow(487, 196, 487, 244)} class="qfig-ub-head" />

    <g class="qfig-ub-box">
      <rect x="394" y="246" width="186" height="68" rx="8" />
    </g>
    <DiagramIcon name="key" x="420" y="280" size={26} />
    <text x="444" y="274" class="qfig-ub-b">
      <tspan data-lang-en>The worker holds</tspan>
      <tspan data-lang-vi>Worker đang giữ</tspan>
    </text>
    <text x="444" y="294" class="qfig-ub-m">
      <tspan data-lang-en>Database password,</tspan>
      <tspan data-lang-vi>Mật khẩu database,</tspan>
    </text>
    <text x="444" y="310" class="qfig-ub-m">
      <tspan data-lang-en>cloud storage keys</tspan>
      <tspan data-lang-vi>key cloud storage</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-ub { margin: 0; width: 100%; }
  .qfig-ub svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-ub text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-ub .qfig-ub-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-ub .qfig-ub-b { font-weight: 700; fill: var(--text); }
  .qfig-ub .qfig-ub-m { fill: var(--text-muted); }
  .qfig-ub-box rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.6; }
  .qfig-ub-bad rect { fill: var(--red-tint-bg); stroke: var(--red); }
  .qfig-ub-line { stroke: var(--text-muted); stroke-width: 1.8; fill: none; }
  .qfig-ub-head { fill: var(--text-muted); }
  .qfig-ub-line-bad { stroke: var(--red); }
  .qfig-ub-head-bad { fill: var(--red); }
</style>
