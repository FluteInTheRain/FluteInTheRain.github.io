---
// Quiz figure for the images post quiz (Uxq07).
---
<div class="qfig-uxq07textonphoto">
  <svg viewBox="0 0 600 200" role="img" aria-label="A photo split into a bright cloud half and a dark slope half, with the white headline Summer collection crossing both halves.">
    <rect x="10" y="10" width="290" height="140" fill="#e8eef5" />
    <rect x="300" y="10" width="290" height="140" fill="#2b3a2d" />
    <path d="M300 150 L370 100 L430 130 L500 80 L590 140 L590 150 Z" fill="#1c271d" />
    <rect x="10" y="10" width="580" height="140" fill="none" class="ln" />
    <text x="60" y="95" style="font-size:34px;fill:#ffffff;font-weight:400;">Summer collection</text>
    <text x="10" y="178" class="m"><tspan data-lang-en>Cloud side</tspan><tspan data-lang-vi>Phía mây</tspan></text>
    <text x="590" y="178" text-anchor="end" class="m"><tspan data-lang-en>Slope side</tspan><tspan data-lang-vi>Phía sườn núi</tspan></text>
  </svg>
</div>

<style>
  .qfig-uxq07textonphoto { margin: 0; width: 100%; }
  .qfig-uxq07textonphoto svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq07textonphoto text { font-size: 13.5px; fill: var(--text-body); }
  .qfig-uxq07textonphoto .h { font-weight: 700; fill: var(--text); }
  .qfig-uxq07textonphoto .m { fill: var(--text-muted); font-size: 13px; }
  .qfig-uxq07textonphoto .mono { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; fill: var(--text-muted); }
  .qfig-uxq07textonphoto .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq07textonphoto .bar { fill: var(--border); }
  .qfig-uxq07textonphoto .ln { stroke: var(--text-muted); stroke-width: 1.4; fill: none; }
  .qfig-uxq07textonphoto .acc { stroke: var(--red); stroke-width: 2; fill: none; }
  .qfig-uxq07textonphoto .accf { fill: var(--red); }
  .qfig-uxq07textonphoto .dash { stroke: var(--red); stroke-width: 2; stroke-dasharray: 6 4; fill: none; }
  .qfig-uxq07textonphoto .ico { stroke: var(--text); fill: none; stroke-linecap: round; stroke-linejoin: round; }
</style>
