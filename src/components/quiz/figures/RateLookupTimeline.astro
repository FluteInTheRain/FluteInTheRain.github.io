---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for unbundling set 05. Top: two ways checkout can get a euro-to-dollar rate (a call per
// purchase, or a local table fed by a rate stream). Bottom: a timeline with the rate stream (1.08 last
// month, 1.12 today), the 2,500 purchases placed last month, and the replay run today.
// It shows the scenario only, not any computed result. Inline SVG, site tokens only, no <marker>/<defs>/ids.
function head(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`;
}
const lastX = 110;
const todayX = 470;
const purchases = Array.from({ length: 8 }, (_, i) => 70 + i * 9);
---
<div class="qfig-rate">
  <svg viewBox="0 0 580 350" role="img" aria-label="Two ways to get an exchange rate: a call to the rate service for every purchase, or a local rate table fed by a rate stream. Below, a timeline: the rate is 1.08 last month and 1.12 today, and 2,500 purchases placed last month are replayed today.">
    <text x="0" y="20" class="qfig-rate-h">
      <tspan data-lang-en>Where checkout gets the euro rate</tspan>
      <tspan data-lang-vi>Checkout lấy tỷ giá euro từ đâu</tspan>
    </text>

    <!-- way 1: a call per purchase -->
    <DiagramIcon name="server" x={16} y={60} size={26} />
    <text x="40" y="65" class="qfig-rate-lane">Checkout</text>
    <line x1="126" x2="193" y1="60" y2="60" class="qfig-rate-callline" />
    <polygon points={head(201, 60)} class="qfig-rate-callhead" />
    <text x="160" y="48" text-anchor="middle" class="qfig-rate-m">
      <tspan data-lang-en>call per purchase</tspan>
      <tspan data-lang-vi>gọi mỗi đơn</tspan>
    </text>
    <DiagramIcon name="cloud" x={224} y={60} size={26} />
    <text x="248" y="65" class="qfig-rate-lane">
      <tspan data-lang-en>Rate service</tspan>
      <tspan data-lang-vi>Dịch vụ tỷ giá</tspan>
    </text>
    <DiagramIcon name="clock" x={392} y={60} size={24} />
    <text x="414" y="65" class="qfig-rate-bad">
      <tspan data-lang-en>waits for the reply</tspan>
      <tspan data-lang-vi>chờ phản hồi</tspan>
    </text>

    <!-- way 2: a local table fed by a stream -->
    <rect x="0" y="100" width="104" height="36" rx="8" class="qfig-rate-pill" />
    <text x="52" y="123" text-anchor="middle" class="qfig-rate-t">
      <tspan data-lang-en>Rate stream</tspan>
      <tspan data-lang-vi>Stream tỷ giá</tspan>
    </text>
    <line x1="106" x2="150" y1="118" y2="118" class="qfig-rate-flow" />
    <polygon points={head(158, 118)} class="qfig-rate-flowhead" />
    <rect x="162" y="100" width="190" height="36" rx="8" class="qfig-rate-pill" />
    <DiagramIcon name="db" x={182} y={118} size={22} />
    <text x="204" y="123" class="qfig-rate-t">
      <tspan data-lang-en>Local rate table</tspan>
      <tspan data-lang-vi>Bảng tỷ giá cục bộ</tspan>
    </text>
    <text x="368" y="123" class="qfig-rate-m">
      <tspan data-lang-en>no call per purchase</tspan>
      <tspan data-lang-vi>không gọi mỗi đơn</tspan>
    </text>

    <line x1="0" x2="580" y1="158" y2="158" class="qfig-rate-rule" />

    <!-- timeline -->
    <text x="0" y="182" class="qfig-rate-m">
      <tspan data-lang-en>Rate, dollars per euro</tspan>
      <tspan data-lang-vi>Tỷ giá, đô la mỗi euro</tspan>
    </text>
    <line x1={lastX} x2={todayX} y1="214" y2="214" class="qfig-rate-flow" />
    <circle cx={lastX} cy="214" r="6" class="qfig-rate-dot" />
    <circle cx={todayX} cy="214" r="6" class="qfig-rate-dot" />
    <text x={lastX} y="200" text-anchor="middle" class="qfig-rate-t"><tspan data-lang-en>1.08</tspan><tspan data-lang-vi>1,08</tspan></text>
    <text x={todayX} y="200" text-anchor="middle" class="qfig-rate-t"><tspan data-lang-en>1.12</tspan><tspan data-lang-vi>1,12</tspan></text>

    <text x="0" y="248" class="qfig-rate-m">
      <tspan data-lang-en>Purchases</tspan>
      <tspan data-lang-vi>Đơn mua</tspan>
    </text>
    {purchases.map((x) => <rect x={x} y="256" width="6" height="18" rx="1.5" class="qfig-rate-buy" />)}
    <text x="154" y="270" class="qfig-rate-t">
      <tspan data-lang-en>2,500 purchases of €40</tspan>
      <tspan data-lang-vi>2.500 đơn, mỗi đơn 40 €</tspan>
    </text>

    <line x1={todayX} x2={todayX} y1="224" y2="316" class="qfig-rate-today" />
    <line x1={lastX} x2={todayX - 12} y1="296" y2="296" class="qfig-rate-replay" />
    <polygon points={head(todayX - 4, 296)} class="qfig-rate-replayhead" />
    <text x={(lastX + todayX) / 2} y="288" text-anchor="middle" class="qfig-rate-m">
      <tspan data-lang-en>replayed from the log a month later</tspan>
      <tspan data-lang-vi>chạy lại từ log một tháng sau</tspan>
    </text>

    <line x1="40" x2="540" y1="316" y2="316" class="qfig-rate-axis" />
    <line x1={lastX} x2={lastX} y1="316" y2="322" class="qfig-rate-axis" />
    <line x1={todayX} x2={todayX} y1="316" y2="322" class="qfig-rate-axis" />
    <text x={lastX} y="340" text-anchor="middle" class="qfig-rate-m">
      <tspan data-lang-en>Last month</tspan>
      <tspan data-lang-vi>Tháng trước</tspan>
    </text>
    <text x={todayX} y="340" text-anchor="middle" class="qfig-rate-m">
      <tspan data-lang-en>Today</tspan>
      <tspan data-lang-vi>Hôm nay</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-rate { margin: 0; width: 100%; }
  .qfig-rate svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-rate text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-rate .qfig-rate-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-rate .qfig-rate-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-rate .qfig-rate-t { font-weight: 600; fill: var(--text); }
  .qfig-rate .qfig-rate-m { font-size: 13px; fill: var(--text-muted); }
  .qfig-rate .qfig-rate-bad { font-weight: 700; fill: var(--red); }
  .qfig-rate-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-rate-callline { stroke: var(--red); stroke-width: 2; }
  .qfig-rate-callhead { fill: var(--red); }
  .qfig-rate-pill { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .qfig-rate-flow { stroke: var(--gold); stroke-width: 2; fill: none; }
  .qfig-rate-flowhead { fill: var(--gold); }
  .qfig-rate-dot { fill: var(--gold); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-rate-buy { fill: var(--act-2); }
  .qfig-rate-today { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .qfig-rate-replay { stroke: var(--text); stroke-width: 1.6; stroke-dasharray: 5 4; }
  .qfig-rate-replayhead { fill: var(--text); }
  .qfig-rate-axis { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
