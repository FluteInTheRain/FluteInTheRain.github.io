---
// Quiz figure for go-production set 06: a pool capped at two connections, two callers holding one each,
// a third caller waiting with a 200 ms deadline. It shows the state only, not who is at fault.
// Inline SVG, site tokens only.
const X0 = 150, X1 = 540;
const px = (ms: number) => X0 + (ms * (X1 - X0)) / 200;
const rows = [
  { y: 64, en: 'connection 1', vi: 'connection 1', note_en: 'in use by caller A', note_vi: 'caller A đang dùng' },
  { y: 108, en: 'connection 2', vi: 'connection 2', note_en: 'in use by caller B', note_vi: 'caller B đang dùng' },
];
const axisY = 196;
---
<div class="qfig-gq14pq">
  <svg viewBox="0 0 580 250" role="img" aria-label="A pool capped at two connections over 200 milliseconds. Connection 1 and connection 2 are each in use for the whole time. Caller C waits in a queue until its 200 millisecond deadline.">
    <text x="0" y="20" class="qfig-gq14pq-h">
      <tspan data-lang-en>SetMaxOpenConns(2), three callers</tspan>
      <tspan data-lang-vi>SetMaxOpenConns(2), ba caller</tspan>
    </text>

    {rows.map((r) => (
      <g>
        <text x="0" y={r.y + 14} class="qfig-gq14pq-l">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <rect x={px(0)} y={r.y} width={px(200) - px(0)} height="22" rx="3" class="qfig-gq14pq-use" />
        <text x={px(0) + 10} y={r.y + 16} class="qfig-gq14pq-in">
          <tspan data-lang-en>{r.note_en}</tspan>
          <tspan data-lang-vi>{r.note_vi}</tspan>
        </text>
      </g>
    ))}

    <text x="0" y="158" class="qfig-gq14pq-l">
      <tspan data-lang-en>caller C</tspan>
      <tspan data-lang-vi>caller C</tspan>
    </text>
    <rect x={px(0)} y="144" width={px(200) - px(0)} height="22" rx="3" class="qfig-gq14pq-wait" />
    <text x={px(0) + 10} y="160" class="qfig-gq14pq-l2">
      <tspan data-lang-en>waiting in the queue</tspan>
      <tspan data-lang-vi>đang xếp hàng chờ</tspan>
    </text>

    <line x1={px(200)} x2={px(200)} y1="40" y2={axisY} class="qfig-gq14pq-mark" />
    <line x1={X0} x2={X1} y1={axisY} y2={axisY} class="qfig-gq14pq-axis" />
    <text x={px(0)} y={axisY + 20} text-anchor="middle" class="qfig-gq14pq-m">0 ms</text>
    <text x={px(200)} y={axisY + 20} text-anchor="end" class="qfig-gq14pq-t">
      <tspan data-lang-en>200 ms: context deadline</tspan>
      <tspan data-lang-vi>200 ms: hạn của context</tspan>
    </text>
    <text x="0" y="242" class="qfig-gq14pq-m">open=2 inUse=2 waitCount=1</text>
  </svg>
</div>

<style>
  .qfig-gq14pq { margin: 0; width: 100%; }
  .qfig-gq14pq svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq14pq text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq14pq .qfig-gq14pq-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq14pq .qfig-gq14pq-t { font-weight: 700; fill: var(--text); }
  .qfig-gq14pq .qfig-gq14pq-m { fill: var(--text-muted); }
  .qfig-gq14pq .qfig-gq14pq-in { fill: var(--bg); font-weight: 700; }
  .qfig-gq14pq .qfig-gq14pq-l2 { fill: var(--text-body); }
  .qfig-gq14pq-use { fill: var(--act-3); opacity: 0.9; }
  .qfig-gq14pq-wait { fill: none; stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 5 3; }
  .qfig-gq14pq-axis { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-gq14pq-mark { stroke: var(--text); stroke-width: 1.5; stroke-dasharray: 5 3; }
</style>
