---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 02: the same three racks (one copy of a shard in each), two events.
//  1. one disk fails, the other two copies keep serving;
//  2. one update ships to every rack and all three copies crash together.
// Plain inline SVG, site tokens only, no <marker>/<defs>.
const W = 580;
const H = 506;
const rackW = 176;
const rackH = 82;
const racks = [14, 15, 16];
const rackX = [10, 202, 394];
const panels = [
  { top: 0, bad: [true, false, false] },
  { top: 256, bad: [true, true, true] },
];
// Arrow as a line plus a plain triangle.
function down(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
---
<div class="qdr">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
      {panels.map((p, pi) => {
        const srcY = p.top + 54;
        const rackY = p.top + 124;
        return (
          <g>
            <text x="10" y={p.top + 22} class="qdr-h">
              {pi === 0 ? (
                <>
                  <tspan data-lang-en>1. At 02:10, one disk fails</tspan>
                  <tspan data-lang-vi>1. Lúc 02:10, một ổ đĩa hỏng</tspan>
                </>
              ) : (
                <>
                  <tspan data-lang-en>2. Fourteen days later, one update goes to every rack</tspan>
                  <tspan data-lang-vi>2. Mười bốn ngày sau, một bản cập nhật đi vào mọi rack</tspan>
                </>
              )}
            </text>
            <DiagramIcon name={pi === 0 ? 'users' : 'package'} x={290} y={srcY} size={26} />
            <text x="290" y={srcY + 34} text-anchor="middle" class="qdr-strong">
              {pi === 0 ? (
                <>
                  <tspan data-lang-en>Users read the shard</tspan>
                  <tspan data-lang-vi>Người dùng đọc shard</tspan>
                </>
              ) : (
                <>
                  <tspan data-lang-en>Storage update 2.8, same minute</tspan>
                  <tspan data-lang-vi>Bản cập nhật storage 2.8, cùng một phút</tspan>
                </>
              )}
            </text>
            {racks.map((r, i) => {
              const bad = p.bad[i];
              const cx = rackX[i] + rackW / 2;
              const a = down(290, srcY + 44, cx, rackY - 4);
              const cls = pi === 1 ? 'qdr-arrow is-red' : bad ? 'qdr-arrow is-cut' : 'qdr-arrow is-ok';
              return (
                <g>
                  <g class={cls}>
                    <path d={a.line} />
                    {!(pi === 0 && bad) && <polygon points={a.head} />}
                  </g>
                  <g class={bad ? 'qdr-rack is-bad' : 'qdr-rack'}>
                    <rect x={rackX[i]} y={rackY} width={rackW} height={rackH} rx="8" />
                    <DiagramIcon name="disk" x={rackX[i] + 26} y={rackY + 30} size={24} />
                    <text x={rackX[i] + 52} y={rackY + 28} class="qdr-strong">
                      <tspan data-lang-en>Rack {r}</tspan>
                      <tspan data-lang-vi>Rack {r}</tspan>
                    </text>
                    <text x={rackX[i] + 52} y={rackY + 47} class="qdr-muted">
                      <tspan data-lang-en>copy {i + 1} of 3</tspan>
                      <tspan data-lang-vi>bản sao {i + 1} trên 3</tspan>
                    </text>
                    <text x={rackX[i] + rackW / 2} y={rackY + 70} text-anchor="middle" class={bad ? 'qdr-state is-bad' : 'qdr-state'}>
                      {pi === 0 ? (
                        bad ? (
                          <>
                            <tspan data-lang-en>✕ read errors</tspan>
                            <tspan data-lang-vi>✕ lỗi đọc</tspan>
                          </>
                        ) : (
                          <>
                            <tspan data-lang-en>✓ serving reads</tspan>
                            <tspan data-lang-vi>✓ vẫn phục vụ</tspan>
                          </>
                        )
                      ) : (
                        <>
                          <tspan data-lang-en>✕ process crashed</tspan>
                          <tspan data-lang-vi>✕ tiến trình sập</tspan>
                        </>
                      )}
                    </text>
                  </g>
                </g>
              );
            })}
            <text x="290" y={p.top + 236} text-anchor="middle" class={pi === 0 ? 'qdr-verdict' : 'qdr-verdict is-bad'}>
              {pi === 0 ? (
                <>
                  <tspan data-lang-en>2 of 3 copies still serve: users notice nothing</tspan>
                  <tspan data-lang-vi>Còn 2 trên 3 bản sao phục vụ: người dùng không thấy gì</tspan>
                </>
              ) : (
                <>
                  <tspan data-lang-en>0 of 3 copies serve: users get errors until rollback</tspan>
                  <tspan data-lang-vi>0 trên 3 bản sao phục vụ: người dùng nhận lỗi đến khi rollback</tspan>
                </>
              )}
            </text>
          </g>
        );
      })}
      <line x1="10" x2={W - 10} y1="248" y2="248" class="qdr-rule" />
    </svg>
</div>

<style>
  .qdr {
    margin: 0;
    width: 100%;
  }
  .qdr svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qdr text {
    font-size: 14px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qdr .qdr-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qdr .qdr-strong {
    font-size: 14px;
    font-weight: 600;
    fill: var(--text);
  }
  .qdr .qdr-muted {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .qdr-rack rect:first-child {
    fill: var(--bg-alt);
    stroke: var(--gold);
    stroke-width: 1.8;
  }
  .qdr-rack.is-bad rect:first-child {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-dasharray: 5 4;
  }
  .qdr .qdr-state {
    font-size: 13px;
    font-weight: 700;
    fill: var(--text);
  }
  .qdr .qdr-state.is-bad,
  .qdr .qdr-verdict.is-bad {
    fill: var(--red);
  }
  .qdr .qdr-verdict {
    font-size: 14px;
    font-weight: 700;
    fill: var(--text);
  }
  .qdr-arrow path {
    fill: none;
    stroke-width: 1.8;
  }
  .qdr-arrow.is-ok path {
    stroke: var(--gold);
  }
  .qdr-arrow.is-ok polygon {
    fill: var(--gold);
  }
  .qdr-arrow.is-red path {
    stroke: var(--red);
  }
  .qdr-arrow.is-red polygon {
    fill: var(--red);
  }
  .qdr-arrow.is-cut path {
    stroke: var(--red);
    stroke-dasharray: 3 4;
    opacity: 0.6;
  }
  .qdr-rule {
    stroke: var(--border);
  }
</style>
