---
// Quiz figure for set 02 "Disk in rack 14".
// Two events on the same three racks (one copy of a shard in each):
//  1. one disk returns read errors, the other two copies keep serving;
//  2. one update ships to every rack and all three copies crash together.
// Plain inline SVG with site tokens only; no <marker>/<defs>.

const W = 560;
const H = 392;
const rackW = 168;
const rackH = 100;
const gap = 12;
const x0 = 4;
const racks = [14, 15, 16];

type State = 'ok' | 'bad';
const panels: { top: number; states: State[] }[] = [
  { top: 0, states: ['bad', 'ok', 'ok'] },
  { top: 204, states: ['bad', 'bad', 'bad'] },
];
---

<figure class="qfig-rack">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    {panels.map((p, pi) => (
      <g>
        <text x="4" y={p.top + 22} class="qfig-rack-h">
          {pi === 0 ? (
            <>
              <tspan data-lang-en>Event 1 · 02:10 · one disk fails</tspan>
              <tspan data-lang-vi>Sự kiện 1 · 02:10 · một ổ đĩa hỏng</tspan>
            </>
          ) : (
            <>
              <tspan data-lang-en>Event 2 · 14 days later · update on all racks</tspan>
              <tspan data-lang-vi>Sự kiện 2 · 14 ngày sau · bản cập nhật lên mọi rack</tspan>
            </>
          )}
        </text>
        {racks.map((r, i) => {
          const x = x0 + i * (rackW + gap);
          const y = p.top + 36;
          const bad = p.states[i] === 'bad';
          return (
            <g class={bad ? 'qfig-rack-unit is-bad' : 'qfig-rack-unit'}>
              <rect x={x} y={y} width={rackW} height={rackH} rx="6" class="qfig-rack-frame" />
              <text x={x + rackW / 2} y={y + 24} text-anchor="middle" class="qfig-rack-name">
                <tspan data-lang-en>Rack {r}</tspan>
                <tspan data-lang-vi>Rack {r}</tspan>
              </text>
              <rect x={x + 18} y={y + 36} width={rackW - 36} height="26" rx="4" class="qfig-rack-disk" />
              <text x={x + rackW / 2} y={y + 54} text-anchor="middle" class="qfig-rack-copy">
                <tspan data-lang-en>copy {i + 1} of 3</tspan>
                <tspan data-lang-vi>bản sao {i + 1}/3</tspan>
              </text>
              <text x={x + rackW / 2} y={y + 88} text-anchor="middle" class={bad ? 'qfig-rack-state is-bad' : 'qfig-rack-state is-ok'}>
                {pi === 0 ? (
                  bad ? (
                    <>
                      <tspan data-lang-en>✕ read errors</tspan>
                      <tspan data-lang-vi>✕ lỗi đọc</tspan>
                    </>
                  ) : (
                    <>
                      <tspan data-lang-en>✓ serving</tspan>
                      <tspan data-lang-vi>✓ đang phục vụ</tspan>
                    </>
                  )
                ) : (
                  <>
                    <tspan data-lang-en>✕ crashed</tspan>
                    <tspan data-lang-vi>✕ bị sập</tspan>
                  </>
                )}
              </text>
            </g>
          );
        })}
        <text x="4" y={p.top + 170} class={pi === 0 ? 'qfig-rack-verdict is-ok' : 'qfig-rack-verdict is-bad'}>
          {pi === 0 ? (
            <>
              <tspan data-lang-en>✓ Users see nothing: 2 of 3 copies serve.</tspan>
              <tspan data-lang-vi>✓ Người dùng không thấy gì: 2/3 bản sao vẫn phục vụ.</tspan>
            </>
          ) : (
            <>
              <tspan data-lang-en>✕ Users get errors: 0 of 3 copies serve.</tspan>
              <tspan data-lang-vi>✕ Người dùng nhận lỗi: 0/3 bản sao phục vụ.</tspan>
            </>
          )}
        </text>
      </g>
    ))}
    <line x1="4" x2={W - 4} y1="190" y2="190" class="qfig-rack-rule" />
  </svg>
</figure>

<style>
  .qfig-rack {
    margin: 0;
    width: 100%;
  }
  .qfig-rack svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .qfig-rack text {
    font-size: 15px;
    fill: var(--text-body);
  }
  .qfig-rack .qfig-rack-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .qfig-rack-frame {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .qfig-rack-unit.is-bad .qfig-rack-frame {
    stroke: var(--red);
  }
  .qfig-rack .qfig-rack-name {
    font-weight: 700;
    fill: var(--text);
  }
  .qfig-rack-disk {
    fill: var(--bg-alt);
    stroke: var(--act-2);
    stroke-width: 1.6;
  }
  .qfig-rack-unit.is-bad .qfig-rack-disk {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-dasharray: 4 3;
  }
  .qfig-rack .qfig-rack-copy {
    font-size: 14px;
    fill: var(--text);
  }
  .qfig-rack .qfig-rack-state {
    font-size: 14px;
    font-weight: 700;
  }
  .qfig-rack .qfig-rack-state.is-ok {
    fill: var(--act-2);
  }
  .qfig-rack .qfig-rack-state.is-bad {
    fill: var(--red);
  }
  .qfig-rack .qfig-rack-verdict {
    font-size: 15px;
    font-weight: 700;
  }
  .qfig-rack .qfig-rack-verdict.is-ok {
    fill: var(--act-2);
  }
  .qfig-rack .qfig-rack-verdict.is-bad {
    fill: var(--red);
  }
  .qfig-rack-rule {
    stroke: var(--border);
  }
</style>
