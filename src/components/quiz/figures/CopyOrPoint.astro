---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 02: the same post list stored two ways. Left: each post points to the author by id.
// Right: each post carries a copy of the author's name. Shows the structure and the read path only,
// never a cost or a result. Plain inline SVG, site tokens, no <marker>/<defs>.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 8 * Math.cos(a - 0.45), y2 - 8 * Math.sin(a - 0.45)];
  const p2 = [x2 - 8 * Math.cos(a + 0.45), y2 - 8 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const rowsY = [62, 94, 126];
const arrows = rowsY.map((y) => arrow(165, y + 14, 193, 108));
---
<div class="qcp">
  <svg viewBox="0 0 580 290" role="img" aria-label="The same post list stored two ways: posts that point to the author by id, and posts that each carry a copy of the author's name.">
    <text x="10" y="28" class="qcp-h">
      <tspan data-lang-en>Point to it</tspan>
      <tspan data-lang-vi>Trỏ tới</tspan>
    </text>
    <text x="310" y="28" class="qcp-h">
      <tspan data-lang-en>Copy it</tspan>
      <tspan data-lang-vi>Chép ra</tspan>
    </text>
    <line x1="290" x2="290" y1="12" y2="270" class="qcp-split" />

    <text x="15" y="54" class="qcp-sub">posts</text>
    {rowsY.map((y, i) => (
      <g>
        <rect x="15" y={y} width="150" height="28" rx="5" class="qcp-row" />
        <text x="23" y={y + 19} class="qcp-name">post {i + 1}</text>
        <text x="77" y={y + 19} class="qcp-cell">author_id 7</text>
      </g>
    ))}
    <text x="15" y="176" class="qcp-sub">
      <tspan data-lang-en>… many more posts</tspan>
      <tspan data-lang-vi>… còn nhiều bài khác</tspan>
    </text>

    <text x="195" y="54" class="qcp-sub">users</text>
    <rect x="195" y="94" width="82" height="28" rx="5" class="qcp-row qcp-one" />
    <text x="203" y="113" class="qcp-name">7 · Mira</text>
    {arrows.map((a) => (
      <g class="qcp-arrow"><path d={a.line} /><polygon points={a.head} /></g>
    ))}
    <text x="172" y="146" class="qcp-sub">
      <tspan data-lang-en>one row per user</tspan>
      <tspan data-lang-vi>mỗi user 1 dòng</tspan>
    </text>

    <text x="315" y="54" class="qcp-sub">posts</text>
    {rowsY.map((y, i) => (
      <g>
        <rect x="315" y={y} width="255" height="28" rx="5" class="qcp-row" />
        <text x="323" y={y + 19} class="qcp-name">post {i + 1}</text>
        <text x="377" y={y + 19} class="qcp-cell">author_id 7</text>
        <text x="468" y={y + 19} class="qcp-name">Mira</text>
      </g>
    ))}
    <text x="315" y="176" class="qcp-sub">
      <tspan data-lang-en>… many more posts, each with its own copy</tspan>
      <tspan data-lang-vi>… còn nhiều bài khác, mỗi bài một bản sao</tspan>
    </text>

    <line x1="10" x2="570" y1="196" y2="196" class="qcp-split" />

    <DiagramIcon name="laptop" x={32} y={236} size={26} />
    <text x="60" y="231" class="qcp-note">
      <tspan data-lang-en>Show the post list:</tspan>
      <tspan data-lang-vi>Hiện danh sách bài:</tspan>
    </text>
    <text x="60" y="251" class="qcp-note">
      <tspan data-lang-en>read posts, then look up users</tspan>
      <tspan data-lang-vi>đọc posts, rồi tra users</tspan>
    </text>

    <DiagramIcon name="laptop" x={332} y={236} size={26} />
    <text x="360" y="231" class="qcp-note">
      <tspan data-lang-en>Show the post list:</tspan>
      <tspan data-lang-vi>Hiện danh sách bài:</tspan>
    </text>
    <text x="360" y="251" class="qcp-note">
      <tspan data-lang-en>read posts only</tspan>
      <tspan data-lang-vi>chỉ đọc posts</tspan>
    </text>
  </svg>
</div>

<style>
  .qcp { width: 100%; }
  .qcp svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qcp text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qcp .qcp-h { font-size: 17px; font-weight: 700; fill: var(--text); }
  .qcp .qcp-sub { font-size: 13px; fill: var(--text-muted); }
  .qcp .qcp-name { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qcp .qcp-cell { font-size: 13px; fill: var(--text-body); }
  .qcp .qcp-note { font-size: 14px; fill: var(--text); }
  .qcp-row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qcp-one { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .qcp-arrow path { fill: none; stroke: var(--gold); stroke-width: 1.6; }
  .qcp-arrow polygon { fill: var(--gold); }
  .qcp-split { stroke: var(--border); stroke-width: 1.2; }
</style>
