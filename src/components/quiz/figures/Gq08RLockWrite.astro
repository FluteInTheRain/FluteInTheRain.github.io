---
// Quiz figure for the Go context/mutex quiz (post 08), set 03: two Add calls and the shared map.
// States the steps of the code in the question only.
const gs = [
  { y: 40, n: 'A' },
  { y: 124, n: 'B' },
];
---
<div class="qfig-gq08rw">
  <svg viewBox="0 0 580 230" role="img" aria-label="Two goroutines each call Add on the same Cache. Each takes c.mu.RLock, then writes to the shared map c.balances.">
    <text x="0" y="20" class="qfig-gq08rw-h">
      <tspan data-lang-en>Two Add calls on one Cache</tspan>
      <tspan data-lang-vi>Hai lần gọi Add trên cùng một Cache</tspan>
    </text>
    {gs.map((g) => (
      <g>
        <text x="0" y={g.y + 14} class="qfig-gq08rw-m">
          <tspan data-lang-en>Goroutine {g.n}</tspan>
          <tspan data-lang-vi>Goroutine {g.n}</tspan>
        </text>
        <rect x="120" y={g.y} width="190" height="30" rx="6" class="qfig-gq08rw-box" />
        <text x="132" y={g.y + 20} class="qfig-gq08rw-code">c.mu.RLock()</text>
        <rect x="120" y={g.y + 38} width="190" height="30" rx="6" class="qfig-gq08rw-box" />
        <text x="132" y={g.y + 58} class="qfig-gq08rw-code">c.balances[k] = v</text>
        <line x1="310" x2="396" y1={g.y + 53} y2="110" class="qfig-gq08rw-arrow" />
      </g>
    ))}
    <rect x="400" y="80" width="170" height="60" rx="8" class="qfig-gq08rw-box" />
    <text x="485" y="106" text-anchor="middle" class="qfig-gq08rw-code">c.balances</text>
    <text x="485" y="126" text-anchor="middle" class="qfig-gq08rw-m">
      <tspan data-lang-en>one shared map</tspan>
      <tspan data-lang-vi>một map dùng chung</tspan>
    </text>
    <text x="0" y="214" class="qfig-gq08rw-m">
      <tspan data-lang-en>Arrows: the write each goroutine makes to the map.</tspan>
      <tspan data-lang-vi>Mũi tên: lần ghi vào map của mỗi goroutine.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq08rw { margin: 0; width: 100%; }
  .qfig-gq08rw svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq08rw text { font-size: 13px; fill: var(--text-body); }
  .qfig-gq08rw .qfig-gq08rw-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq08rw .qfig-gq08rw-m { fill: var(--text-muted); }
  .qfig-gq08rw .qfig-gq08rw-code { font-family: var(--font-mono, monospace); fill: var(--text); }
  .qfig-gq08rw-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-gq08rw-arrow { stroke: var(--act-3); stroke-width: 2; }
</style>
