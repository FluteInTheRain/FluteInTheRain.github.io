---
// Quiz figure for the fifty-lags set: 50 lags of simulated pure noise (numpy default_rng(4)): 3 bars beyond +-1.96
// (lags 16, 30, 49), none beyond 3.29.
const T = [-0.65, -0.17, 1.66, 0.66, -1.64, -0.01, -0.62, 0.15, -1.61, 0.24, 0.24, 1.58, 0.32, 0.51, -1.49, 2.25, -1.92, 1.1, -0.33, -0.88, -0.66, -0.67, 0.38, -0.11, 1.48, -1.83, -0.0, -0.89, 0.78, -2.12, -0.34, 0.21, -1.48, 0.99, 0.18, 1.01, 0.96, -0.98, -0.8, -0.2, 0.75, 0.85, -0.71, -0.61, -0.8, -0.58, -0.24, -0.13, 2.06, -0.51];
const X0 = 46, X1 = 570, YZ = 100, SC = 20;
const bw = (X1 - X0) / 50;
const y = (v: number) => YZ - v * SC;
---
<div class="qfig-atq04nb">
  <svg viewBox="0 0 580 232" role="img" aria-label="Fifty bars of t-statistics for 50 lags of simulated noise. Three bars at lags 16, 30 and 49 cross the dashed 1.96 lines; none crosses 3.29.">
    <text x="20" y="16" class="qfig-atq04nb-h">
      <tspan data-lang-en>t-statistics of 50 lags, simulated pure noise</tspan>
      <tspan data-lang-vi>t-statistic của 50 độ trễ, nhiễu thuần mô phỏng</tspan>
    </text>
    {[1.96, -1.96].map((v) => <line x1={X0} x2={X1} y1={y(v)} y2={y(v)} class="qfig-atq04nb-ref" />)}
    {[3.29, -3.29].map((v) => <line x1={X0} x2={X1} y1={y(v)} y2={y(v)} class="qfig-atq04nb-hur" />)}
    <line x1={X0} x2={X1} y1={YZ} y2={YZ} class="qfig-atq04nb-axis" />
    {T.map((v, i) => (
      <rect x={X0 + i * bw + 1} y={v >= 0 ? y(v) : YZ} width={bw - 2} height={Math.max(1, Math.abs(v) * SC)} class={`qfig-atq04nb-bar ${Math.abs(v) > 1.96 ? 'is-hit' : ''}`} />
    ))}
    <text x="40" y={y(1.96) + 4} text-anchor="end" class="qfig-atq04nb-t">1.96</text>
    <text x="40" y={y(3.29) + 4} text-anchor="end" class="qfig-atq04nb-t is-red">3.29</text>
    <text x="40" y={y(-1.96) + 4} text-anchor="end" class="qfig-atq04nb-t">−1.96</text>
    <text x="40" y={y(-3.29) + 4} text-anchor="end" class="qfig-atq04nb-t is-red">−3.29</text>
    <text x="308" y="190" text-anchor="middle" class="qfig-atq04nb-t">
      <tspan data-lang-en>lags 1 to 50 (weeks)</tspan>
      <tspan data-lang-vi>độ trễ 1 đến 50 (tuần)</tspan>
    </text>
    <text x="308" y="214" text-anchor="middle" class="qfig-atq04nb-n">
      <tspan data-lang-en>3 bars cross 1.96, none crosses 3.29</tspan>
      <tspan data-lang-vi>3 cột vượt 1,96, không cột nào vượt 3,29</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-atq04nb svg { display: block; width: 100%; height: auto; max-width: 580px; margin: 0 auto; }
  .qfig-atq04nb text { font-size: 12.5px; fill: var(--text-body); }
  .qfig-atq04nb .qfig-atq04nb-h { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-atq04nb .qfig-atq04nb-n { font-weight: 700; fill: var(--text); }
  .qfig-atq04nb .qfig-atq04nb-t { fill: var(--text-muted); }
  .qfig-atq04nb .qfig-atq04nb-t.is-red { fill: var(--red); }
  .qfig-atq04nb-bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1; }
  .qfig-atq04nb-bar.is-hit { fill: var(--red-tint-bg); stroke: var(--red); }
  .qfig-atq04nb-axis { stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-atq04nb-ref { stroke: var(--text-muted); stroke-width: 1.1; stroke-dasharray: 4 4; }
  .qfig-atq04nb-hur { stroke: var(--red); stroke-width: 1.3; }
</style>
