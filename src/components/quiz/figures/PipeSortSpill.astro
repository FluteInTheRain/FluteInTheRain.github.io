---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for batch processing set 01: 107 MiB NGINX log (1,000,000 lines) inside a 128 MiB cgroup cap.
// Shows peak RAM at 500 vs 1,000,000 unique URLs and the storage layout of Python defaultdict vs sort -S 8M | uniq -c.
// Inline SVG, CSS tokens only, no <marker>/<defs>/ids. Never states computed ratios or run counts.

const barX = 160;
const pxPerMiB = 1.35;
const capMiB = 128;
const capX = barX + capMiB * pxPerMiB;

const bars = [
  {
    groupEn: '500 unique URLs',
    groupVi: '500 URL riêng biệt',
    gy: 66,
    rows: [
      { label: 'Python defaultdict', mib: 14.2, enVal: '14.2 MiB (0.51 s)', viVal: '14,2 MiB (0,51 giây)', kind: 'neutral', y: 76 },
      { label: 'sort -S 8M | uniq -c', mib: 17.7, enVal: '17.7 MiB (4.53 s)', viVal: '17,7 MiB (4,53 giây)', kind: 'gold', y: 102 },
    ],
  },
  {
    groupEn: '1,000,000 unique URLs',
    groupVi: '1.000.000 URL riêng biệt',
    gy: 142,
    rows: [
      { label: 'Python defaultdict', mib: 191.6, enVal: '191.6 MiB (1.14 s)', viVal: '191,6 MiB (1,14 giây)', kind: 'red', y: 152 },
      { label: 'sort -S 8M | uniq -c', mib: 13.8, enVal: '13.8 MiB (3.00 s)', viVal: '13,8 MiB (3,00 giây)', kind: 'gold', y: 178 },
    ],
  },
];

function arrowR(x1: number, y: number, x2: number) {
  return {
    line: `M ${x1} ${y} L ${x2 - 6} ${y}`,
    head: `${x2},${y} ${x2 - 8},${y - 4.5} ${x2 - 8},${y + 4.5}`,
  };
}

function arrowV(x: number, y1: number, y2: number) {
  const dir = y2 > y1 ? 1 : -1;
  return {
    line: `M ${x} ${y1} L ${x} ${y2 - dir * 5}`,
    head: `${x},${y2} ${x - 4},${y2 - dir * 7} ${x + 4},${y2 - dir * 7}`,
  };
}

const aPy = arrowR(104, 279, 132);
const aCat = arrowR(104, 349, 118);
const aAwk = arrowR(198, 349, 212);
const aPipe = arrowR(360, 349, 398);
const aSpillDown = arrowV(274, 374, 396);
const aSpillUp = arrowV(302, 396, 374);
---
<div class="qfig-pss">
  <svg viewBox="0 0 580 442" role="img" aria-label="Peak memory bars for a 107 MiB log inside a 128 MiB container cap at 500 vs 1,000,000 unique URLs, above the memory layout of Python defaultdict and the sort -S 8M | uniq -c disk-spill pipe.">
    <text x="0" y="22" class="qfig-pss-h">
      <tspan data-lang-en>107 MiB NGINX log inside a 128 MiB container</tspan>
      <tspan data-lang-vi>File NGINX log 107 MiB trong container 128 MiB</tspan>
    </text>

    <line x1={capX} x2={capX} y1="54" y2="204" class="qfig-pss-cap" />
    <text x={capX} y="46" text-anchor="middle" class="qfig-pss-cap-t">
      <tspan data-lang-en>128 MiB cgroup cap</tspan>
      <tspan data-lang-vi>Trần cgroup 128 MiB</tspan>
    </text>

    {bars.map((g) => (
      <g>
        <text x="0" y={g.gy} class="qfig-pss-sub">
          <tspan data-lang-en>{g.groupEn}</tspan>
          <tspan data-lang-vi>{g.groupVi}</tspan>
        </text>
        {g.rows.map((r) => {
          const w = r.mib * pxPerMiB;
          const barClass =
            r.kind === 'red' ? 'qfig-pss-bar is-red' : r.kind === 'gold' ? 'qfig-pss-bar is-gold' : 'qfig-pss-bar';
          return (
            <g>
              <text x="0" y={r.y + 15} class="qfig-pss-label">{r.label}</text>
              <rect x={barX} y={r.y} width={w} height="20" rx="3" class={barClass} />
              <text x={barX + w + 7} y={r.y + 15} class={r.kind === 'red' ? 'qfig-pss-val is-red' : 'qfig-pss-val'}>
                <tspan data-lang-en>{r.enVal}</tspan>
                <tspan data-lang-vi>{r.viVal}</tspan>
              </text>
            </g>
          );
        })}
      </g>
    ))}

    <line x1="0" x2="580" y1="218" y2="218" class="qfig-pss-rule" />

    <text x="0" y="240" class="qfig-pss-lane">
      <tspan data-lang-en>How each approach stores distinct URLs</tspan>
      <tspan data-lang-vi>Cách mỗi hướng lưu các URL riêng biệt</tspan>
    </text>

    <!-- Python path -->
    <rect x="0" y="254" width="104" height="50" rx="6" class="qfig-pss-box" />
    <DiagramIcon name="file" x={18} y={279} size={20} />
    <text x="33" y="275" class="qfig-pss-t">access.log</text>
    <text x="33" y="293" class="qfig-pss-m">107 MiB</text>

    <g class="qfig-pss-arr"><path d={aPy.line} /><polygon points={aPy.head} /></g>

    <rect x="134" y="254" width="446" height="50" rx="6" class="qfig-pss-hot" />
    <DiagramIcon name="heap" x={158} y={279} size={24} />
    <text x="178" y="275" class="qfig-pss-t">
      <tspan data-lang-en>Python defaultdict: 1 hash entry per unique URL in RAM</tspan>
      <tspan data-lang-vi>Python defaultdict: 1 mục băm mỗi URL riêng trong RAM</tspan>
    </text>
    <text x="178" y="294" class="qfig-pss-m">
      <tspan data-lang-en>500 keys -&gt; 14.2 MiB   |   1M keys -&gt; 191.6 MiB</tspan>
      <tspan data-lang-vi>500 khoá -&gt; 14,2 MiB   |   1 triệu khoá -&gt; 191,6 MiB</tspan>
    </text>

    <!-- Unix pipe path -->
    <rect x="0" y="324" width="104" height="50" rx="6" class="qfig-pss-box" />
    <DiagramIcon name="file" x={18} y={349} size={20} />
    <text x="33" y="345" class="qfig-pss-t">access.log</text>
    <text x="33" y="363" class="qfig-pss-m">107 MiB</text>

    <g class="qfig-pss-arr"><path d={aCat.line} /><polygon points={aCat.head} /></g>

    <rect x="120" y="324" width="78" height="50" rx="6" class="qfig-pss-box" />
    <DiagramIcon name="worker" x={136} y={349} size={18} />
    <text x="154" y="345" class="qfig-pss-t">awk</text>
    <text x="154" y="363" class="qfig-pss-m">$7</text>

    <g class="qfig-pss-arr"><path d={aAwk.line} /><polygon points={aAwk.head} /></g>

    <rect x="214" y="324" width="144" height="50" rx="6" class="qfig-pss-safe" />
    <DiagramIcon name="worker" x={232} y={349} size={20} />
    <text x="252" y="345" class="qfig-pss-t">sort -S 8M</text>
    <text x="252" y="363" class="qfig-pss-m">
      <tspan data-lang-en>8 MiB RAM cap</tspan>
      <tspan data-lang-vi>trần RAM 8 MiB</tspan>
    </text>

    <!-- Pipe ring buffer tube -->
    <line x1="358" x2="400" y1="341" y2="341" class="qfig-pss-tube" />
    <line x1="358" x2="400" y1="357" y2="357" class="qfig-pss-tube" />
    <g class="qfig-pss-arr-gold"><path d={aPipe.line} /><polygon points={aPipe.head} /></g>
    <text x="379" y="335" text-anchor="middle" class="qfig-pss-m">pipe</text>

    <rect x="400" y="324" width="180" height="50" rx="6" class="qfig-pss-safe" />
    <DiagramIcon name="worker" x={420} y={349} size={20} />
    <text x="438" y="345" class="qfig-pss-t">uniq -c</text>
    <text x="438" y="363" class="qfig-pss-m">
      <tspan data-lang-en>1 adjacent counter</tspan>
      <tspan data-lang-vi>1 bộ đếm kề nhau</tspan>
    </text>

    <!-- Spill to disk loop -->
    <g class="qfig-pss-arr-gold"><path d={aSpillDown.line} /><polygon points={aSpillDown.head} /></g>
    <g class="qfig-pss-arr-gold"><path d={aSpillUp.line} /><polygon points={aSpillUp.head} /></g>
    <rect x="194" y="396" width="188" height="38" rx="6" class="qfig-pss-safe" />
    <DiagramIcon name="disk" x={216} y={415} size={20} />
    <text x="233" y="420" class="qfig-pss-t">
      <tspan data-lang-en>sorted runs on disk</tspan>
      <tspan data-lang-vi>các run trên đĩa</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-pss { margin: 0; width: 100%; }
  .qfig-pss svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-pss text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-pss .qfig-pss-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-pss .qfig-pss-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-pss .qfig-pss-sub { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-pss .qfig-pss-label { fill: var(--text-body); }
  .qfig-pss .qfig-pss-t { font-weight: 600; fill: var(--text); }
  .qfig-pss .qfig-pss-m { fill: var(--text-muted); }
  .qfig-pss .qfig-pss-val { fill: var(--text-muted); }
  .qfig-pss .qfig-pss-val.is-red { fill: var(--red); font-weight: 700; }
  .qfig-pss-cap { stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .qfig-pss .qfig-pss-cap-t { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-pss-bar { fill: var(--text-muted); }
  .qfig-pss-bar.is-gold { fill: var(--gold); }
  .qfig-pss-bar.is-red { fill: var(--red); }
  .qfig-pss-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-pss-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .qfig-pss-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; stroke-dasharray: 5 3; }
  .qfig-pss-safe { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-pss-tube { stroke: var(--gold); stroke-width: 1.5; }
  .qfig-pss-arr path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-pss-arr polygon { fill: var(--text-muted); }
  .qfig-pss-arr-gold path { fill: none; stroke: var(--gold-icon); stroke-width: 1.5; }
  .qfig-pss-arr-gold polygon { fill: var(--gold-icon); }
</style>
