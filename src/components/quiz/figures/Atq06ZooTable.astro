---
// Set 06: pure-noise factors, two-sided normal approximation (python run recorded in the post's demo).
const rows = [['20', '0.91', '61%', '0.05', '5%'], ['100', '4.55', '99%', '0.27', '24%'], ['400', '18.2', '100%', '1.08', '66%']];
---
<div class="q6d">
  <svg viewBox="0 0 580 230" role="img" aria-hidden="true">
    <text x="20" y="24" class="h"><tspan data-lang-en>N pure-noise factors tried, passing bar t &gt; 2 or t &gt; 3</tspan><tspan data-lang-vi>N factor nhiễu đã thử, vượt ngưỡng t &gt; 2 hoặc t &gt; 3</tspan></text>
    <text x="20" y="56" class="m">N</text>
    <text x="120" y="56" class="m"><tspan data-lang-en>t &gt; 2: avg passes</tspan><tspan data-lang-vi>t &gt; 2: số vượt TB</tspan></text>
    <text x="260" y="56" class="m"><tspan data-lang-en>at least one</tspan><tspan data-lang-vi>ít nhất một</tspan></text>
    <text x="360" y="56" class="m"><tspan data-lang-en>t &gt; 3: avg passes</tspan><tspan data-lang-vi>t &gt; 3: số vượt TB</tspan></text>
    <text x="500" y="56" class="m"><tspan data-lang-en>at least one</tspan><tspan data-lang-vi>ít nhất một</tspan></text>
    {rows.map((r, i) => (
      <g>
        <rect x="14" y={66 + i * 44} width="552" height="38" rx="4" class="r" />
        {[20, 140, 275, 380, 515].map((x, k) => (<text x={x} y={90 + i * 44} class={k === 0 ? 's' : 'n'}>{r[k]}</text>))}
      </g>
    ))}
  </svg>
</div>
<style>
  .q6d svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .q6d text { font-size: 13px; fill: var(--text-body); }
  .q6d .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .q6d .m { fill: var(--text-muted); font-size: 11.5px; }
  .q6d .s { font-weight: 700; fill: var(--text); }
  .q6d .n { fill: var(--text); font-weight: 600; }
  .q6d .r { fill: var(--bg-alt); stroke: var(--border); }
</style>
