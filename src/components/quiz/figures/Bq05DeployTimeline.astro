---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-database-access-layer set 06: two deploy days. Day 1 builds the table with create_all.
// Day 2 the model gains a `priority` column and startup runs create_all again. It shows model and table side by side
// and stops before the first INSERT; it does not say what the table ends up with. Inline SVG, site tokens only.
const colA = 20;
const colB = 312;
const chipW = 76;
const gap = 8;
const chipX = (base: number, i: number) => base + i * (chipW + gap);
const day1 = ['case_id', 'title'];
const day2 = ['case_id', 'title', 'priority'];
const yModel = 102;
const yTable = 188;
---
<div class="qfig-bqdt">
  <svg viewBox="0 0 580 300" role="img" aria-label="Two deploy days side by side. Day 1: the model and the table both have case_id and title. Day 2: the model gains a priority column and startup runs create_all again, while the table holds 12,000 rows.">
    <text x="0" y="22" class="qfig-bqdt-h">
      <tspan data-lang-en>Two deploys, one model change</tspan>
      <tspan data-lang-vi>Hai lần deploy, một thay đổi của model</tspan>
    </text>

    <text x={colA} y="56" class="qfig-bqdt-day">
      <tspan data-lang-en>Day 1: first deploy</tspan>
      <tspan data-lang-vi>Ngày 1: deploy đầu tiên</tspan>
    </text>
    <text x={colB} y="56" class="qfig-bqdt-day">
      <tspan data-lang-en>Day 2: model changed</tspan>
      <tspan data-lang-vi>Ngày 2: model đã đổi</tspan>
    </text>
    <line x1="296" x2="296" y1="40" y2="236" class="qfig-bqdt-rule" />

    <DiagramIcon name={'file' as any} x={colA + 8} y={yModel - 22} size={18} />
    <text x={colA + 24} y={yModel - 17} class="qfig-bqdt-lane">
      <tspan data-lang-en>Model in code</tspan>
      <tspan data-lang-vi>Model trong code</tspan>
    </text>
    <DiagramIcon name={'file' as any} x={colB + 8} y={yModel - 22} size={18} />
    <text x={colB + 24} y={yModel - 17} class="qfig-bqdt-lane">
      <tspan data-lang-en>Model in code</tspan>
      <tspan data-lang-vi>Model trong code</tspan>
    </text>
    {day1.map((c, i) => (
      <g>
        <rect x={chipX(colA, i)} y={yModel} width={chipW} height="30" rx="5" class="qfig-bqdt-chip" />
        <text x={chipX(colA, i) + chipW / 2} y={yModel + 20} text-anchor="middle" class="qfig-bqdt-t">{c}</text>
      </g>
    ))}
    {day2.map((c, i) => (
      <g>
        <rect x={chipX(colB, i)} y={yModel} width={chipW} height="30" rx="5" class={c === 'priority' ? 'qfig-bqdt-new' : 'qfig-bqdt-chip'} />
        <text x={chipX(colB, i) + chipW / 2} y={yModel + 20} text-anchor="middle" class="qfig-bqdt-t">{c}</text>
      </g>
    ))}

    <DiagramIcon name={'db' as any} x={colA + 8} y={yTable - 22} size={18} />
    <text x={colA + 24} y={yTable - 17} class="qfig-bqdt-lane">
      <tspan data-lang-en>Table in the database</tspan>
      <tspan data-lang-vi>Bảng trong database</tspan>
    </text>
    <DiagramIcon name={'db' as any} x={colB + 8} y={yTable - 22} size={18} />
    <text x={colB + 24} y={yTable - 17} class="qfig-bqdt-lane">
      <tspan data-lang-en>Table in the database</tspan>
      <tspan data-lang-vi>Bảng trong database</tspan>
    </text>
    {day1.map((c, i) => (
      <g>
        <rect x={chipX(colA, i)} y={yTable} width={chipW} height="30" rx="5" class="qfig-bqdt-chip" />
        <text x={chipX(colA, i) + chipW / 2} y={yTable + 20} text-anchor="middle" class="qfig-bqdt-t">{c}</text>
      </g>
    ))}
    {day1.map((c, i) => (
      <g>
        <rect x={chipX(colB, i)} y={yTable} width={chipW} height="30" rx="5" class="qfig-bqdt-chip" />
        <text x={chipX(colB, i) + chipW / 2} y={yTable + 20} text-anchor="middle" class="qfig-bqdt-t">{c}</text>
      </g>
    ))}
    <text x={colA} y={yTable + 52} class="qfig-bqdt-m">
      <tspan data-lang-en>create_all builds the table</tspan>
      <tspan data-lang-vi>create_all tạo bảng</tspan>
    </text>
    <text x={colB} y={yTable + 52} class="qfig-bqdt-m">
      <tspan data-lang-en>12,000 rows already in it</tspan>
      <tspan data-lang-vi>12.000 dòng đã nằm trong đó</tspan>
    </text>

    <line x1="0" x2="580" y1="256" y2="256" class="qfig-bqdt-rule" />
    <DiagramIcon name={'server' as any} x={16} y={278} size={20} />
    <text x="34" y="283" class="qfig-bqdt-t">
      <tspan data-lang-en>Day 2 startup runs create_all again, then the first request sets priority</tspan>
      <tspan data-lang-vi>Ngày 2 lúc khởi động chạy lại create_all, rồi request đầu tiên đặt priority</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-bqdt { margin: 0; width: 100%; }
  .qfig-bqdt svg { display: block; width: 100%; min-width: 340px; height: auto; }
  .qfig-bqdt text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bqdt .qfig-bqdt-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-bqdt .qfig-bqdt-day { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-bqdt .qfig-bqdt-lane { font-weight: 700; fill: var(--text); }
  .qfig-bqdt .qfig-bqdt-t { font-weight: 600; fill: var(--text); }
  .qfig-bqdt .qfig-bqdt-m { fill: var(--text-muted); }
  .qfig-bqdt-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-bqdt-chip { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-bqdt-new { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 2; }
</style>
