---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-observability set 03: one request across two services, with the request_id each
// service logged. The id changes at the second hop. It does not say why. Inline SVG, site tokens only, no ids.
function head(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`;
}
const boxes = [
  { x: 10, icon: 'laptop', en: 'curl', vi: 'curl', idEn: 'sent X-Request-ID', idVi: 'gửi X-Request-ID', logged: 'demo-7f3a' },
  { x: 210, icon: 'server', en: 'clue-api', vi: 'clue-api', idEn: 'logged request_id', idVi: 'ghi request_id', logged: 'demo-7f3a' },
  { x: 410, icon: 'server', en: 'evidence-lab', vi: 'evidence-lab', idEn: 'logged request_id', idVi: 'ghi request_id', logged: '5c1e0b9d' },
];
const w = 160;
---
<div class="qfig-bq10ih">
  <svg viewBox="0 0 580 210" role="img" aria-label="A request goes from curl to clue-api to evidence-lab. curl sent the id demo-7f3a and clue-api logged demo-7f3a, but evidence-lab logged a different id, 5c1e0b9d.">
    {boxes.map((b, i) => (
      <g>
        <rect x={b.x} y="34" width={w} height="130" rx="8" class={i === 2 ? 'qfig-bq10ih-box qfig-bq10ih-redbox' : 'qfig-bq10ih-box'} />
        <DiagramIcon name={b.icon as any} x={b.x + 26} y={62} size={26} />
        <text x={b.x + 50} y="68" class="qfig-bq10ih-lane">
          <tspan data-lang-en>{b.en}</tspan>
          <tspan data-lang-vi>{b.vi}</tspan>
        </text>
        <text x={b.x + 14} y="112" class="qfig-bq10ih-m">
          <tspan data-lang-en>{b.idEn}</tspan>
          <tspan data-lang-vi>{b.idVi}</tspan>
        </text>
        {b.logged && (
          <text x={b.x + 14} y="140" class={i === 2 ? 'qfig-bq10ih-redt' : 'qfig-bq10ih-t'}>{b.logged}</text>
        )}
      </g>
    ))}
    {[177, 377].map((x) => (
      <g>
        <line x1={x} x2={x + 15} y1="99" y2="99" class="qfig-bq10ih-arrow" />
        <polygon points={head(x + 24, 99)} class="qfig-bq10ih-arrowhead" />
      </g>
    ))}
    <text x="10" y="196" class="qfig-bq10ih-m">
      <tspan data-lang-en>Three hops of one request, and the id each log line carries</tspan>
      <tspan data-lang-vi>Ba chặng của một request, và id mà mỗi dòng log mang</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-bq10ih { margin: 0; width: 100%; }
  .qfig-bq10ih svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-bq10ih text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bq10ih .qfig-bq10ih-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-bq10ih .qfig-bq10ih-m { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-bq10ih .qfig-bq10ih-t { font-weight: 700; fill: var(--text); font-size: 17px; }
  .qfig-bq10ih .qfig-bq10ih-redt { font-weight: 700; fill: var(--red); font-size: 17px; }
  .qfig-bq10ih-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-bq10ih-redbox { fill: var(--red-tint-bg); stroke: var(--red); }
  .qfig-bq10ih-arrow { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-bq10ih-arrowhead { fill: var(--text-muted); }
</style>
