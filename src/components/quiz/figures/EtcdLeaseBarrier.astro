---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for consensus set 08: Jepsen's etcd 3.4.3 lease lock failure under worker pauses,
// plus platform scale metrics (4 TB orders, 20,000 lookups/s, 200 workers).
// Does not reveal fencing tokens (revision), Txn version checks, observers, or Serializable reads.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.

const x0 = 175; // t = 0 s
const px = 74;  // pixels per second
const tx = (s: number) => x0 + s * px;
const ticks = [0, 1, 2, 3, 4, 5];

const lanes = {
  workerA: 98,
  etcd: 158,
  workerB: 218,
  store: 280,
};
const axisY = 320;

function headDown(x: number, y: number) {
  return `${x},${y} ${x - 4.5},${y - 8} ${x + 4.5},${y - 8}`;
}

const pauseStart = tx(0.55); // ~216
const pauseEnd = tx(3.75);   // ~452
const lockBx = tx(2.3);      // ~345
const writeBx = tx(2.9);     // ~390
const writeAx = tx(4.45);    // ~504
---
<div class="qfig-elb">
  <svg viewBox="0 0 580 404" role="img" aria-label="A 0 to 5 second timeline of the Jepsen etcd 3.4.3 lock incident. Worker A acquires a 2-second lease at 0 s and pauses. At 2 s the lease expires. Worker B gets the lock and writes to shared storage at 2.9 s. Worker A resumes at 4.45 s and overwrites Worker B's acknowledged update. Below: platform load of 4 TB orders, 20,000 lookups per second, and 200 workers.">
    <text x="0" y="22" class="qfig-elb-h">
      <tspan data-lang-en>etcd 3.4.3 lock under a 5-second pause cycle</tspan>
      <tspan data-lang-vi>Khoá etcd 3.4.3 dưới chu kỳ tạm dừng 5 giây</tspan>
    </text>
    <text x="0" y="42" class="qfig-elb-m">
      <tspan data-lang-en>5 concurrent processes, 2 s lease TTL (~18% acknowledged updates lost)</tspan>
      <tspan data-lang-vi>5 tiến trình song song, lease TTL 2 giây (mất ~18% cập nhật đã xác nhận)</tspan>
    </text>

    {/* 2s TTL expiry line */}
    <line x1={tx(2)} x2={tx(2)} y1="68" y2={axisY} class="qfig-elb-ttl" />
    <text x={tx(2)} y="62" text-anchor="middle" class="qfig-elb-ttl-t">
      <tspan data-lang-en>2 s lease TTL expires</tspan>
      <tspan data-lang-vi>TTL 2 s hết hạn</tspan>
    </text>

    {/* Lanes */}
    {[
      { y: lanes.workerA, icon: 'worker', en: 'Worker A', vi: 'Worker A' },
      { y: lanes.etcd, icon: 'etcd', en: 'etcd 3.4.3', vi: 'etcd 3.4.3' },
      { y: lanes.workerB, icon: 'worker', en: 'Worker B', vi: 'Worker B' },
      { y: lanes.store, icon: 'db', en: 'Shared storage', vi: 'Kho dữ liệu' },
    ].map((l) => (
      <g>
        <line x1="0" x2="580" y1={l.y + 28} y2={l.y + 28} class="qfig-elb-rule" />
        <DiagramIcon name={l.icon as any} x={18} y={l.y} size={22} />
        <text x="36" y={l.y + 5} class="qfig-elb-lane">
          <tspan data-lang-en>{l.en}</tspan>
          <tspan data-lang-vi>{l.vi}</tspan>
        </text>
      </g>
    ))}

    {/* Worker A */}
    <circle cx={tx(0)} cy={lanes.workerA} r="5.5" class="qfig-elb-dot" />
    <text x={tx(0)} y={lanes.workerA - 12} text-anchor="middle" class="qfig-elb-t">
      <tspan data-lang-en>Locks</tspan>
      <tspan data-lang-vi>Lấy khoá</tspan>
    </text>
    <rect x={pauseStart} y={lanes.workerA - 12} width={pauseEnd - pauseStart} height="24" rx="5" class="qfig-elb-pause" />
    <text x={(pauseStart + pauseEnd) / 2} y={lanes.workerA + 5} text-anchor="middle" class="qfig-elb-redt">
      <tspan data-lang-en>Process paused</tspan>
      <tspan data-lang-vi>Tiến trình tạm dừng</tspan>
    </text>
    <circle cx={writeAx} cy={lanes.workerA} r="5.5" class="qfig-elb-dot-bad" />
    <text x={writeAx} y={lanes.workerA - 12} text-anchor="middle" class="qfig-elb-redt">
      <tspan data-lang-en>Resumes</tspan>
      <tspan data-lang-vi>Tỉnh lại</tspan>
    </text>
    <line x1={writeAx} x2={writeAx} y1={lanes.workerA + 7} y2={lanes.store - 22} class="qfig-elb-arrow-bad" />
    <polygon points={headDown(writeAx, lanes.store - 15)} class="qfig-elb-head-bad" />

    {/* etcd 3.4.3 */}
    <rect x={tx(0)} y={lanes.etcd - 12} width={tx(2) - tx(0)} height="24" rx="5" class="qfig-elb-okbox" />
    <text x={(tx(0) + tx(2)) / 2} y={lanes.etcd + 5} text-anchor="middle" class="qfig-elb-t">
      <tspan data-lang-en>Lease A active</tspan>
      <tspan data-lang-vi>Lease A còn hạn</tspan>
    </text>
    <rect x={tx(2.15)} y={lanes.etcd - 12} width={tx(4.05) - tx(2.15)} height="24" rx="5" class="qfig-elb-okbox" />
    <text x={(tx(2.15) + tx(4.05)) / 2} y={lanes.etcd + 5} text-anchor="middle" class="qfig-elb-t">
      <tspan data-lang-en>Grants lock to B</tspan>
      <tspan data-lang-vi>Cấp khoá cho B</tspan>
    </text>

    {/* Worker B */}
    <line x1={lockBx} x2={writeBx} y1={lanes.workerB} y2={lanes.workerB} class="qfig-elb-arrow-ok" />
    <circle cx={lockBx} cy={lanes.workerB} r="5.5" class="qfig-elb-dot" />
    <circle cx={writeBx} cy={lanes.workerB} r="4.5" class="qfig-elb-dot" />
    <text x={lockBx + 10} y={lanes.workerB - 11} class="qfig-elb-t">
      <tspan data-lang-en>Gets lock &amp; writes</tspan>
      <tspan data-lang-vi>Giữ khoá &amp; ghi</tspan>
    </text>
    <line x1={writeBx} x2={writeBx} y1={lanes.workerB + 5} y2={lanes.store - 22} class="qfig-elb-arrow-ok" />
    <polygon points={headDown(writeBx, lanes.store - 15)} class="qfig-elb-head-ok" />

    {/* Shared storage */}
    <rect x={writeBx - 55} y={lanes.store - 14} width="110" height="28" rx="5" class="qfig-elb-okbox" />
    <text x={writeBx} y={lanes.store + 5} text-anchor="middle" class="qfig-elb-t">
      <tspan data-lang-en>Saves B (ACK)</tspan>
      <tspan data-lang-vi>Lưu B (ACK)</tspan>
    </text>
    <rect x={writeAx - 45} y={lanes.store - 14} width="116" height="28" rx="5" class="qfig-elb-badbox" />
    <text x={writeAx + 13} y={lanes.store + 5} text-anchor="middle" class="qfig-elb-redt">
      <tspan data-lang-en>A overwrites B</tspan>
      <tspan data-lang-vi>A ghi đè B</tspan>
    </text>

    {/* Time axis */}
    <line x1={tx(0)} x2={tx(5)} y1={axisY} y2={axisY} class="qfig-elb-axis" />
    {ticks.map((s) => (
      <g>
        <line x1={tx(s)} x2={tx(s)} y1={axisY} y2={axisY + 5} class="qfig-elb-axis" />
        <text x={tx(s)} y={axisY + 20} text-anchor="middle" class="qfig-elb-m">{s}</text>
      </g>
    ))}
    <text x="0" y={axisY + 20} class="qfig-elb-m">
      <tspan data-lang-en>Time (s)</tspan>
      <tspan data-lang-vi>Thời gian (giây)</tspan>
    </text>

    {/* Platform workload footer */}
    <line x1="0" x2="580" y1="352" y2="352" class="qfig-elb-rule" />
    <text x="0" y="374" class="qfig-elb-foot">
      <tspan data-lang-en>Platform load: 4 TB orders · 20,000 discovery lookups/s · 200 workers</tspan>
      <tspan data-lang-vi>Tải nền tảng: 4 TB đơn hàng · 20.000 tra cứu/giây · 200 worker</tspan>
    </text>
    <text x="0" y="394" class="qfig-elb-m">
      <tspan data-lang-en>3-node etcd cluster · 1, 2, 3 s TTLs also broke mutual exclusion</tspan>
      <tspan data-lang-vi>Cụm etcd 3 node · các TTL 1, 2, 3 giây đều hỏng loại trừ lẫn nhau</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-elb { margin: 0; width: 100%; }
  .qfig-elb svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-elb text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-elb .qfig-elb-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-elb .qfig-elb-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-elb .qfig-elb-t { font-weight: 600; fill: var(--text); }
  .qfig-elb .qfig-elb-m { fill: var(--text-muted); }
  .qfig-elb .qfig-elb-foot { font-size: 13.5px; font-weight: 600; fill: var(--text); }
  .qfig-elb .qfig-elb-redt { font-weight: 600; fill: var(--red); }
  .qfig-elb .qfig-elb-ttl-t { font-weight: 600; fill: var(--red); }
  .qfig-elb-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-elb-axis { stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-elb-ttl { stroke: var(--red); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .qfig-elb-dot { fill: var(--gold); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-elb-dot-bad { fill: var(--red); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-elb-pause { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; stroke-dasharray: 4 3; }
  .qfig-elb-okbox { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-elb-badbox { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-elb-arrow-ok { stroke: var(--gold); stroke-width: 1.8; }
  .qfig-elb-head-ok { fill: var(--gold); }
  .qfig-elb-arrow-bad { stroke: var(--red); stroke-width: 1.8; stroke-dasharray: 4 3; }
  .qfig-elb-head-bad { fill: var(--red); }
</style>
