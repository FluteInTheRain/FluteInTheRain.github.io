---
// Quiz figure for financial NLP set 07: three toy headline vectors from one point.
const OX = 90, OY = 200, S = 44;
const v = [
  { id: 'A', x: 3, y: 1, en: 'A: Bank profit rises', vi: 'A: Lợi nhuận ngân hàng tăng', c: 'a' },
  { id: 'B', x: 2, y: 2, en: 'B: Lender earnings climb', vi: 'B: Thu nhập nhà cho vay tăng', c: 'b' },
  { id: 'C', x: -1, y: 3, en: 'C: Steelmaker probe opens', vi: 'C: Thanh tra nhà sản xuất thép', c: 'c' },
];
---
<div class="qfig-atq17c">
  <svg viewBox="0 0 640 230" role="img" aria-label="Three arrows from one point. A is Bank profit rises at (3, 1), B is Lender earnings climb at (2, 2), and C is Steelmaker probe opens at (minus 1, 3).">
    <line x1="10" y1={OY} x2="400" y2={OY} class="qfig-atq17c-axis" />
    <line x1={OX} y1={OY + 6} x2={OX} y2="20" class="qfig-atq17c-axis" />
    {v.map((a) => (
      <g>
        <line x1={OX} y1={OY} x2={OX + a.x * S} y2={OY - a.y * S} class={`qfig-atq17c-vec is-${a.c}`} />
        <circle cx={OX + a.x * S} cy={OY - a.y * S} r="4.5" class={`qfig-atq17c-pt is-${a.c}`} />
        <text x={OX + a.x * S + 10} y={OY - a.y * S + 4} class="qfig-atq17c-l">
          <tspan data-lang-en>{a.en}</tspan>
          <tspan data-lang-vi>{a.vi}</tspan>
        </text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-atq17c svg { display: block; width: 100%; height: auto; }
  .qfig-atq17c text { font-size: 13px; fill: var(--text-body); }
  .qfig-atq17c .qfig-atq17c-l { font-size: 12.5px; font-weight: 600; fill: var(--text); }
  .qfig-atq17c .qfig-atq17c-s { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-atq17c-axis { stroke: var(--border); stroke-width: 1.2; }
  .qfig-atq17c-vec { stroke-width: 2.2; }
  .qfig-atq17c-vec.is-a, .qfig-atq17c-pt.is-a { stroke: var(--gold-icon); fill: var(--gold-icon); }
  .qfig-atq17c-vec.is-b, .qfig-atq17c-pt.is-b { stroke: var(--text); fill: var(--text); }
  .qfig-atq17c-vec.is-c, .qfig-atq17c-pt.is-c { stroke: var(--red); fill: var(--red); }
</style>
