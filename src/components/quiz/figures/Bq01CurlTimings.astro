---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend request-lifecycle set 01: five cumulative curl -w marks on one time axis,
// plus the access-log line as a separate note. It shows no stage lengths and no verdict.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const X0 = 24, X1 = 556, MAX = 511;
const px = (ms: number) => X0 + (ms * (X1 - X0)) / MAX;
const marks = [
  { n: 1, ms: 310, y: 100, v: '0.310', key: 'time_namelookup', en: 'name resolved', vi: 'tra tên xong' },
  { n: 2, ms: 372, y: 100, v: '0.372', key: 'time_connect', en: 'TCP connected', vi: 'TCP đã kết nối' },
  { n: 3, ms: 442, y: 100, v: '0.442', key: 'time_appconnect', en: 'TLS done', vi: 'TLS xong' },
  { n: 4, ms: 508, y: 74, v: '0.508', key: 'time_starttransfer', en: 'first byte back', vi: 'byte đầu tiên về tới' },
  { n: 5, ms: 511, y: 48, v: '0.511', key: 'time_total', en: 'last byte back', vi: 'byte cuối cùng về tới' },
];
const AX = 134;
---
<div class="qfig-bq01ct">
  <svg viewBox="0 0 580 290" role="img" aria-label="Five curl timing marks on a time axis from 0 to 511 milliseconds, and a note that the access log says the endpoint took 4 milliseconds.">
    <text x="0" y="20" class="qfig-bq01ct-h">
      <tspan data-lang-en>One curl run, counted from the start</tspan>
      <tspan data-lang-vi>Một lần chạy curl, tính từ lúc bắt đầu</tspan>
    </text>

    <line x1={X0} x2={X1} y1={AX} y2={AX} class="qfig-bq01ct-axis" />
    <line x1={X0} x2={X0} y1={AX - 5} y2={AX + 5} class="qfig-bq01ct-axis" />
    <line x1={X1} x2={X1} y1={AX - 5} y2={AX + 5} class="qfig-bq01ct-axis" />
    <text x={X0} y={AX + 22} text-anchor="middle" class="qfig-bq01ct-m">0 ms</text>
    <text x={X1} y={AX + 22} text-anchor="end" class="qfig-bq01ct-m">511 ms</text>

    {marks.map((m) => (
      <g>
        <line x1={px(m.ms)} x2={px(m.ms)} y1={m.y + 9} y2={AX} class="qfig-bq01ct-stem" />
        <circle cx={px(m.ms)} cy={AX} r="3.5" class="qfig-bq01ct-dot" />
        <circle cx={px(m.ms)} cy={m.y} r="9" class="qfig-bq01ct-badge" />
        <text x={px(m.ms)} y={m.y + 4.5} text-anchor="middle" class="qfig-bq01ct-n">{m.n}</text>
      </g>
    ))}

    {marks.map((m, i) => (
      <g>
        <circle cx="34" cy={176 + i * 24 - 4} r="9" class="qfig-bq01ct-badge" />
        <text x="34" y={176 + i * 24} text-anchor="middle" class="qfig-bq01ct-n">{m.n}</text>
        <text x="54" y={176 + i * 24} class="qfig-bq01ct-t">{m.v} s</text>
        <text x="110" y={176 + i * 24} class="qfig-bq01ct-b">
          <tspan data-lang-en>{m.key} · {m.en}</tspan>
          <tspan data-lang-vi>{m.key} · {m.vi}</tspan>
        </text>
      </g>
    ))}

    <rect x="366" y="164" width="190" height="82" rx="8" class="qfig-bq01ct-card" />
    <DiagramIcon name="log" x="384" y="188" size={26} />
    <text x="410" y="186" class="qfig-bq01ct-t">
      <tspan data-lang-en>Server access log</tspan>
      <tspan data-lang-vi>Access log của server</tspan>
    </text>
    <text x="380" y="214" class="qfig-bq01ct-b">GET /cases/42</text>
    <text x="380" y="234" class="qfig-bq01ct-b">
      <tspan data-lang-en>endpoint took 4 ms</tspan>
      <tspan data-lang-vi>endpoint mất 4 ms</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-bq01ct { margin: 0; width: 100%; }
  .qfig-bq01ct svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-bq01ct text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bq01ct .qfig-bq01ct-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-bq01ct .qfig-bq01ct-t { font-weight: 700; fill: var(--text); }
  .qfig-bq01ct .qfig-bq01ct-b { fill: var(--text-body); }
  .qfig-bq01ct .qfig-bq01ct-m { fill: var(--text-muted); }
  .qfig-bq01ct .qfig-bq01ct-n { font-size: 12px; font-weight: 700; fill: var(--text); }
  .qfig-bq01ct-axis { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-bq01ct-stem { stroke: var(--border); stroke-width: 1.5; }
  .qfig-bq01ct-dot { fill: var(--text); }
  .qfig-bq01ct-badge { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-bq01ct-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
</style>
