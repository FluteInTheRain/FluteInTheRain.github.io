---
// Quiz figure (ai-trading-sequence-models set 03): width of the data through DeepLOB's first layers.
const maps = [
  { w: 40, x: 10, label: '100 × 40' },
  { w: 20, x: 205, label: '100 × 20' },
  { w: 10, x: 335, label: '100 × 10' },
  { w: 1, x: 440, label: '100 × 1' },
];
const S = 3.6;
---
<div class="qfig-p15c">
  <svg viewBox="0 0 580 230" role="img" aria-label="Four boxes of equal height 100 and decreasing width: 40, then 20, then 10, then 1 column, joined by arrows labelled 1 by 2 stride 2, 1 by 2 stride 2, and 1 by 10.">
    <text x="0" y="20" class="qfig-p15c-h"><tspan data-lang-en>The columns shrink, the 100 time steps stay</tspan><tspan data-lang-vi>Số cột co lại, 100 bước thời gian giữ nguyên</tspan></text>
    {maps.map((m) => (
      <g>
        <rect x={m.x} y="50" width={Math.max(m.w * S, 5)} height="120" class="qfig-p15c-map" />
        <text x={m.x + Math.max(m.w * S, 5) / 2} y="192" text-anchor="middle" class="qfig-p15c-d">{m.label}</text>
      </g>
    ))}
    <text x="180" y="100" text-anchor="middle" class="qfig-p15c-o">1×2</text>
    <text x="180" y="114" text-anchor="middle" class="qfig-p15c-o">stride 2</text>
    <polygon points="160,122 174,122 174,118 186,126 174,134 174,130 160,130" class="qfig-p15c-a" />
    <text x="306" y="100" text-anchor="middle" class="qfig-p15c-o">1×2</text>
    <text x="306" y="114" text-anchor="middle" class="qfig-p15c-o">stride 2</text>
    <polygon points="286,122 300,122 300,118 312,126 300,134 300,130 286,130" class="qfig-p15c-a" />
    <text x="404" y="114" text-anchor="middle" class="qfig-p15c-o">1×10</text>
    <polygon points="378,122 394,122 394,118 406,126 394,134 394,130 378,130" class="qfig-p15c-a" />
  </svg>
</div>

<style>
  .qfig-p15c { margin: 0; width: 100%; }
  .qfig-p15c svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-p15c text { font-size: 13px; fill: var(--text-body); }
  .qfig-p15c .qfig-p15c-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-p15c .qfig-p15c-d { font-weight: 700; fill: var(--text); }
  .qfig-p15c .qfig-p15c-o { font-size: 12px; fill: var(--text-muted); }
  .qfig-p15c-map { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.4; }
  .qfig-p15c-a { fill: var(--text-muted); }
</style>
