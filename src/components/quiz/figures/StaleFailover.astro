---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for replication set 03: a leader and two followers drawn as write logs on a time axis,
// each follower missing the last seconds of the leader's log, plus the failover timeout strip.
// Inline SVG, site tokens only, no <marker>/<defs>/ids. Shows only the scenario's inputs, never a lost-write count.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 7 * Math.cos(a)} ${y2 - 7 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const bx = 150;
const bw = 420;
const perSec = 12;
const rows = [
  { y: 52, icon: 'server', en: 'Leader', vi: 'Leader', subEn: '250 writes per second', subVi: '250 lần ghi mỗi giây', lag: 0 },
  { y: 128, icon: 'server', en: 'Follower A', vi: 'Follower A', subEn: 'same data center', subVi: 'cùng data center', lag: 2 },
  { y: 204, icon: 'server', en: 'Follower B', vi: 'Follower B', subEn: 'other region', subVi: 'region khác', lag: 8 },
];
const ty = 330;
const tl = arrow(bx, ty, bx + bw, ty);
---
<div class="qfig-sf">
  <svg viewBox="0 0 580 424" role="img" aria-label="A leader and two followers drawn as write logs. Follower A is missing the last 2 seconds of the leader's log and follower B the last 8 seconds. Below, a 30 second timeout runs from the moment the leader stops answering until failover starts.">
    <text x="0" y="22" class="qfig-sf-h">
      <tspan data-lang-en>Orders database, asynchronous replication</tspan>
      <tspan data-lang-vi>Database đơn hàng, sao chép bất đồng bộ</tspan>
    </text>

    {rows.map((r) => {
      const copied = bw - r.lag * perSec;
      return (
        <g>
          <DiagramIcon name={r.icon as 'server'} x="22" y={r.y + 30} size={26} />
          <text x="50" y={r.y + 28} class="qfig-sf-n">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          <text x="50" y={r.y + 48} class="qfig-sf-m">
            <tspan data-lang-en>{r.subEn}</tspan>
            <tspan data-lang-vi>{r.subVi}</tspan>
          </text>
          <rect x={bx} y={r.y + 8} width={bw} height="28" rx="4" class="qfig-sf-track" />
          <rect x={bx} y={r.y + 8} width={copied} height="28" rx="4" class="qfig-sf-log" />
          {r.lag > 0 && (
            <g>
              <rect x={bx + copied} y={r.y + 8} width={r.lag * perSec} height="28" class="qfig-sf-gap" />
              <text x={bx + bw} y={r.y + 58} text-anchor="end" class="qfig-sf-lag">
                <tspan data-lang-en>{r.lag} s behind the leader's log</tspan>
                <tspan data-lang-vi>Chậm hơn log của leader {r.lag} giây</tspan>
              </text>
            </g>
          )}
        </g>
      );
    })}

    <g class="qfig-sf-crash">
      <line x1={bx + bw} x2={bx + bw} y1="46" y2="98" />
      <text x={bx + bw} y="112" text-anchor="end">
        <tspan data-lang-en>Leader crashes</tspan>
        <tspan data-lang-vi>Leader sập</tspan>
      </text>
    </g>

    <line x1="0" x2="580" y1="282" y2="282" class="qfig-sf-rule" />
    <text x="0" y="308" class="qfig-sf-h">
      <tspan data-lang-en>Then the failover tool waits</tspan>
      <tspan data-lang-vi>Sau đó công cụ failover chờ</tspan>
    </text>
    <path d={tl.line} class="qfig-sf-axis" />
    <polygon points={tl.head} class="qfig-sf-axish" />
    <circle cx={bx} cy={ty} r="6" class="qfig-sf-dot" />
    <circle cx={bx + bw - 14} cy={ty} r="6" class="qfig-sf-dot" />
    <DiagramIcon name="clock" x={bx + 210} y={ty - 2} size={22} />
    <text x={bx} y={ty + 30} class="qfig-sf-t">
      <tspan data-lang-en>Leader stops answering</tspan>
      <tspan data-lang-vi>Leader ngừng trả lời</tspan>
    </text>
    <text x={bx + bw} y={ty + 30} text-anchor="end" class="qfig-sf-t">
      <tspan data-lang-en>Failover starts</tspan>
      <tspan data-lang-vi>Failover bắt đầu</tspan>
    </text>
    <text x={bx + 210} y={ty + 52} text-anchor="middle" class="qfig-sf-m">
      <tspan data-lang-en>timeout: 30 s</tspan>
      <tspan data-lang-vi>timeout: 30 giây</tspan>
    </text>
    <text x="0" y="414" class="qfig-sf-m">
      <tspan data-lang-en>Bars: each node's write log. Solid part is what that node holds.</tspan>
      <tspan data-lang-vi>Thanh: log ghi của mỗi node. Phần đặc là thứ node đó đang giữ.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-sf { margin: 0; width: 100%; }
  .qfig-sf svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-sf text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-sf .qfig-sf-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-sf .qfig-sf-n { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-sf .qfig-sf-t { font-weight: 600; fill: var(--text); }
  .qfig-sf .qfig-sf-m { fill: var(--text-muted); }
  .qfig-sf-track { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-sf-log { fill: var(--act-2); opacity: 0.85; }
  .qfig-sf-gap { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; stroke-dasharray: 5 3; }
  .qfig-sf .qfig-sf-lag { font-weight: 600; fill: var(--red); }
  .qfig-sf-crash line { stroke: var(--red); stroke-width: 2.5; }
  .qfig-sf .qfig-sf-crash text { fill: var(--red); font-weight: 700; }
  .qfig-sf-rule { stroke: var(--border); }
  .qfig-sf-axis { stroke: var(--gold); stroke-width: 2; fill: none; }
  .qfig-sf-axish { fill: var(--gold); }
  .qfig-sf-dot { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 2; }
</style>
