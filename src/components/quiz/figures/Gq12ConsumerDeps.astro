---
// Quiz figure for go-abstractions-interfaces-generics-errors set 03: three packages, who imports whom, and which methods each side uses.
// It shows structure only; it does not say where an interface should be declared. Inline SVG, site tokens only, no <marker>/<defs>/ids.
---
<div class="qfig-gq12cd">
  <svg viewBox="0 0 580 300" role="img" aria-label="Package store has six methods. Package billing imports store and calls only Get. Package reporting imports store and calls only ListAll.">
    <text x="0" y="20" class="qfig-gq12cd-h">
      <tspan data-lang-en>One package, two callers</tspan>
      <tspan data-lang-vi>Một package, hai nơi gọi</tspan>
    </text>

    <rect x="170" y="36" width="240" height="132" rx="8" class="qfig-gq12cd-box" />
    <text x="290" y="60" text-anchor="middle" class="qfig-gq12cd-t">package store</text>
    <text x="290" y="84" text-anchor="middle" class="qfig-gq12cd-c">Get  ListAll  Create</text>
    <text x="290" y="106" text-anchor="middle" class="qfig-gq12cd-c">Update  Delete  Close</text>
    <text x="290" y="136" text-anchor="middle" class="qfig-gq12cd-m">
      <tspan data-lang-en>6 methods on *Store</tspan>
      <tspan data-lang-vi>6 method trên *Store</tspan>
    </text>

    <line x1="110" x2="110" y1="214" y2="176" class="qfig-gq12cd-line" />
    <line x1="110" x2="230" y1="176" y2="176" class="qfig-gq12cd-line" />
    <line x1="230" x2="230" y1="176" y2="172" class="qfig-gq12cd-line" />
    <polygon points="230,168 225,177 235,177" class="qfig-gq12cd-head" />
    <line x1="470" x2="470" y1="214" y2="176" class="qfig-gq12cd-line" />
    <line x1="470" x2="350" y1="176" y2="176" class="qfig-gq12cd-line" />
    <line x1="350" x2="350" y1="176" y2="172" class="qfig-gq12cd-line" />
    <polygon points="350,168 345,177 355,177" class="qfig-gq12cd-head" />
    <text x="290" y="194" text-anchor="middle" class="qfig-gq12cd-m">imports</text>

    <rect x="20" y="214" width="180" height="70" rx="8" class="qfig-gq12cd-box" />
    <text x="110" y="240" text-anchor="middle" class="qfig-gq12cd-t">package billing</text>
    <text x="110" y="264" text-anchor="middle" class="qfig-gq12cd-c">
      <tspan data-lang-en>calls Get</tspan>
      <tspan data-lang-vi>gọi Get</tspan>
    </text>

    <rect x="380" y="214" width="180" height="70" rx="8" class="qfig-gq12cd-box" />
    <text x="470" y="240" text-anchor="middle" class="qfig-gq12cd-t">package reporting</text>
    <text x="470" y="264" text-anchor="middle" class="qfig-gq12cd-c">
      <tspan data-lang-en>calls ListAll</tspan>
      <tspan data-lang-vi>gọi ListAll</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq12cd { margin: 0; width: 100%; }
  .qfig-gq12cd svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq12cd text { font-size: 13px; fill: var(--text-body); }
  .qfig-gq12cd .qfig-gq12cd-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq12cd .qfig-gq12cd-t { font-weight: 700; fill: var(--text); }
  .qfig-gq12cd .qfig-gq12cd-m { fill: var(--text-muted); }
  .qfig-gq12cd .qfig-gq12cd-c { font-family: 'JetBrains Mono', ui-monospace, monospace; fill: var(--text-body); }
  .qfig-gq12cd-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-gq12cd-line { stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-gq12cd-head { fill: var(--text-muted); }
</style>
