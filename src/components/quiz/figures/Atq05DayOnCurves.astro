---
// Quiz figure, set 01: the 24 Feb 2020 return (-3.41%) against a calm bell (sd 0.64%) and a turbulent bell (sd 1.93%).
const x0 = 20, x1 = 560, base = 200, lo = -6, hi = 6;
const X = (v: number) => x0 + ((v - lo) / (hi - lo)) * (x1 - x0);
const pdf = (v: number, s: number) => Math.exp(-0.5 * (v / s) ** 2) / (s * Math.sqrt(2 * Math.PI));
const scale = 130 / pdf(0, 0.64);
const path = (s: number) => Array.from({ length: 181 }, (_, i) => { const v = lo + (i / 180) * (hi - lo); return `${i ? 'L' : 'M'} ${X(v).toFixed(1)} ${(base - pdf(v, s) * scale).toFixed(1)}`; }).join(' ');
---
<div class="qfig-atq05a">
  <svg viewBox="0 0 580 262" role="img" aria-label="Two bell curves of daily returns: a tall narrow calm one with a spread of 0.64 percent and a low wide turbulent one with a spread of 1.93 percent. A dashed marker at minus 3.41 percent lies far out on the calm curve and inside the turbulent one.">
    <text x="0" y="20" class="h">
      <tspan data-lang-en>One day, two yardsticks</tspan>
      <tspan data-lang-vi>Một ngày, hai thước đo</tspan>
    </text>
    <path d={path(1.93)} class="t" />
    <path d={path(0.64)} class="c" />
    <line x1={x0} y1={base} x2={x1} y2={base} class="axis" />
    {[-6, -4, -2, 0, 2, 4, 6].map((t) => (
      <text x={X(t)} y={base + 18} text-anchor="middle" class="m">{t}%</text>
    ))}
    <line x1={X(-3.41)} y1="44" x2={X(-3.41)} y2={base} class="mark" />
    <text x={X(-3.41) + 6} y="58" class="r">
      <tspan data-lang-en>24 Feb 2020: −3.41%</tspan>
      <tspan data-lang-vi>24/2/2020: −3,41%</tspan>
    </text>
    <text x={X(0.9)} y="56" class="gc">
      <tspan data-lang-en>calm: spread 0.64%</tspan>
      <tspan data-lang-vi>yên: độ rộng 0,64%</tspan>
    </text>
    <text x={X(2.3)} y="150" class="rt">
      <tspan data-lang-en>turbulent: spread 1.93%</tspan>
      <tspan data-lang-vi>hỗn loạn: độ rộng 1,93%</tspan>
    </text>
  </svg>
</div>
<style>
  .qfig-atq05a { margin: 0; width: 100%; }
  .qfig-atq05a svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-atq05a text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-atq05a .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-atq05a .m { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-atq05a .r { font-weight: 700; fill: var(--red); }
  .qfig-atq05a .gc { font-weight: 700; fill: var(--gold-icon); }
  .qfig-atq05a .rt { font-weight: 700; fill: var(--red); }
  .qfig-atq05a .axis { stroke: var(--border); stroke-width: 1.3; }
  .qfig-atq05a .mark { stroke: var(--red); stroke-width: 1.6; stroke-dasharray: 5 4; }
  .qfig-atq05a .c { fill: none; stroke: var(--gold); stroke-width: 2.2; }
  .qfig-atq05a .t { fill: none; stroke: var(--red); stroke-width: 2.2; }
</style>
