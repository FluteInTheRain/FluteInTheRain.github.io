---
// Quiz figure for financial NLP set 04: headline 3 of the post's demo, scored by three toy lists.
// Generic list -2 (default, risk), finance list -2 (default, delisting), finance + negation +2.
const rows = [
  { en: 'Generic list', vi: 'Bộ phổ thông', score: '−2', cls: 'neg', toks: [['default', 'neg'], ['risk', 'neg']] },
  { en: 'Finance list', vi: 'Bộ tài chính', score: '−2', cls: 'neg', toks: [['default', 'neg'], ['delisting', 'neg']] },
  { en: 'Finance list + negation', vi: 'Bộ tài chính + phủ định', score: '+2', cls: 'pos', toks: [['default', 'flip'], ['delisting', 'flip']] },
];
const words = ['Firm', 'does', 'not', 'default', 'on', 'bond,', 'no', 'delisting', 'risk'];
---
<div class="qfig-atq17l">
  <svg viewBox="0 0 640 250" role="img" aria-label="Headline 3, Firm does not default on bond, no delisting risk, scored three ways. The generic list scores minus 2 because default and risk count as negative. The finance list scores minus 2 because default and delisting count as negative. The finance list with negation scores plus 2 because not and no flip the sign of default and delisting.">
    <text x="10" y="22" class="qfig-atq17l-h">"Firm does not default on bond, no delisting risk"</text>
    {rows.map((r, i) => (
      <g>
        <rect x="10" y={40 + i * 66} width="620" height="56" rx="8" class="qfig-atq17l-row" />
        <text x="22" y={64 + i * 66} class="qfig-atq17l-t">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <text x="610" y={70 + i * 66} text-anchor="end" class={`qfig-atq17l-sc is-${r.cls}`}>{r.score}</text>
        <text x="22" y={86 + i * 66} class="qfig-atq17l-s">
          <tspan data-lang-en>{r.toks.map((k) => k[0] + (k[1] === 'flip' ? ' (flipped)' : '')).join(', ')} counted</tspan>
          <tspan data-lang-vi>đã tính: {r.toks.map((k) => k[0] + (k[1] === 'flip' ? ' (đảo dấu)' : '')).join(', ')}</tspan>
        </text>
      </g>
    ))}
    <text x="10" y="244" class="qfig-atq17l-s">
      <tspan data-lang-en>Score = positive words minus negative words. Toy lists written for the post.</tspan>
      <tspan data-lang-vi>Điểm = số từ tích cực trừ số từ tiêu cực. Bộ từ đồ chơi viết riêng cho bài.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-atq17l svg { display: block; width: 100%; height: auto; }
  .qfig-atq17l text { font-size: 13px; fill: var(--text-body); }
  .qfig-atq17l .qfig-atq17l-h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-atq17l .qfig-atq17l-t { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-atq17l .qfig-atq17l-s { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-atq17l .qfig-atq17l-sc { font-size: 22px; font-weight: 700; }
  .qfig-atq17l .qfig-atq17l-sc.is-neg { fill: var(--red); }
  .qfig-atq17l .qfig-atq17l-sc.is-pos { fill: var(--gold-icon); }
  .qfig-atq17l-row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
</style>
