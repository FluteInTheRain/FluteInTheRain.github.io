---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 04 (storage engines): the LSM write path into level 0, the L0 file limits, and compaction below.
// Shows the mechanism and the scenario's state only (14 files now); no computed result and no answer.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids, so the EN and VI copies cannot clash.

const W = 580;
const H = 384;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const x0 = 10;
const pitch = 15.5;
const cellW = 13.5;
const rowY = 166;
const rowH = 34;
const cells = Array.from({ length: 36 }, (_, i) => ({
  x: x0 + i * pitch,
  state: i < 4 ? 'ok' : i < 14 ? 'bad' : 'empty',
}));
const limX = (n: number) => x0 + n * pitch - 1;

const a1 = arrow(48, 68, 84, 68);
const a2 = arrow(246, 68, 258, 68);
const a3 = arrow(327, 92, 327, 156);
const a4 = arrow(40, 262, 40, 290);
const levels = [
  { n: 'L1', w: 60, y: 292 },
  { n: 'L2', w: 120, y: 320 },
  { n: 'L3', w: 240, y: 348 },
];
---
<div class="cb">
  <div>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Writes enter the log and memtable, flush into a growing row of level-0 files marked with the compaction, slowdown and stop limits, and compaction merges them down into bigger levels.">
      <text x="10" y="26" class="cb-h">
        <tspan data-lang-en>From one write to a pile of L0 files</tspan>
        <tspan data-lang-vi>Từ một lần ghi tới đống file L0</tspan>
      </text>

      <DiagramIcon name="car" x={28} y={68} size={26} />
      <text x="28" y="106" text-anchor="middle" class="cb-sub"><tspan data-lang-en>20 MB/s</tspan><tspan data-lang-vi>20 MB/s</tspan></text>
      <g class="cb-arrow"><path d={a1.line} /><polygon points={a1.head} /></g>

      <g class="cb-box">
        <rect x="88" y="46" width="158" height="44" rx="8" />
        <DiagramIcon name="log" x={110} y={68} size={20} />
        <text x="130" y="73" class="cb-name"><tspan data-lang-en>Write-ahead log</tspan><tspan data-lang-vi>Write-ahead log</tspan></text>
      </g>
      <g class="cb-arrow"><path d={a2.line} /><polygon points={a2.head} /></g>
      <g class="cb-box">
        <rect x="262" y="46" width="130" height="44" rx="8" />
        <DiagramIcon name="db" x={284} y={68} size={20} />
        <text x="304" y="73" class="cb-name">Memtable</text>
      </g>

      <g class="cb-arrow"><path d={a3.line} /><polygon points={a3.head} /></g>
      <text x="340" y="128" class="cb-sub">
        <tspan data-lang-en>Flush: one new file each time</tspan>
        <tspan data-lang-vi>Flush: mỗi lần một file mới</tspan>
      </text>

      <text x="10" y="156" class="cb-name"><tspan data-lang-en>Level 0 (L0)</tspan><tspan data-lang-vi>Level 0 (L0)</tspan></text>
      <text x="570" y="156" text-anchor="end" class="cb-name is-bad">
        <tspan data-lang-en>14 files now, rising</tspan>
        <tspan data-lang-vi>Hiện 14 file, đang tăng</tspan>
      </text>

      {cells.map((c) => (
        <rect x={c.x} y={rowY} width={cellW} height={rowH} rx="2" class={`cb-cell is-${c.state}`} />
      ))}

      <line x1={limX(4)} x2={limX(4)} y1={rowY - 2} y2="214" class="cb-lim is-ok" />
      <line x1={limX(20)} x2={limX(20)} y1={rowY - 2} y2="214" class="cb-lim is-bad" />
      <line x1={limX(36)} x2={limX(36)} y1={rowY - 2} y2="214" class="cb-lim is-bad" />

      <text x={limX(4) + 4} y="230" class="cb-num"><tspan data-lang-en>4 files</tspan><tspan data-lang-vi>4 file</tspan></text>
      <text x={limX(4) + 4} y="248" class="cb-sub"><tspan data-lang-en>compaction starts</tspan><tspan data-lang-vi>compaction bắt đầu</tspan></text>
      <text x={limX(20)} y="230" text-anchor="middle" class="cb-num is-bad"><tspan data-lang-en>20 files</tspan><tspan data-lang-vi>20 file</tspan></text>
      <text x={limX(20)} y="248" text-anchor="middle" class="cb-sub"><tspan data-lang-en>writes slow down</tspan><tspan data-lang-vi>ghi chậm lại</tspan></text>
      <text x={limX(36)} y="230" text-anchor="end" class="cb-num is-bad"><tspan data-lang-en>36 files</tspan><tspan data-lang-vi>36 file</tspan></text>
      <text x={limX(36)} y="248" text-anchor="end" class="cb-sub"><tspan data-lang-en>writes stop</tspan><tspan data-lang-vi>ghi dừng hẳn</tspan></text>

      <g class="cb-arrow"><path d={a4.line} /><polygon points={a4.head} /></g>
      <text x="54" y="278" class="cb-name">
        <tspan data-lang-en>Compaction merges L0 into L1, then down</tspan>
        <tspan data-lang-vi>Compaction trộn L0 vào L1, rồi xuống tiếp</tspan>
      </text>

      {levels.map((l) => (
        <g>
          <rect x="10" y={l.y} width={l.w} height="22" rx="4" class="cb-level" />
          <text x="18" y={l.y + 16} class="cb-name">{l.n}</text>
        </g>
      ))}
      <text x="280" y="308" class="cb-sub">
        <tspan data-lang-en>Each level is 10 times bigger</tspan>
        <tspan data-lang-vi>Mỗi tầng lớn gấp 10 lần tầng trên</tspan>
      </text>
      <text x="280" y="364" class="cb-sub">
        <tspan data-lang-en>Disk writes about 500 MB/s in total</tspan>
        <tspan data-lang-vi>Đĩa ghi tổng cộng khoảng 500 MB/s</tspan>
      </text>
    </svg>
  </div>
</div>

<style>
  .cb { width: 100%; }
  .cb svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .cb text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .cb .cb-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .cb .cb-name { font-weight: 700; fill: var(--text); }
  .cb .cb-name.is-bad, .cb .cb-num.is-bad { fill: var(--red); }
  .cb .cb-num { font-weight: 700; fill: var(--text); }
  .cb .cb-sub { fill: var(--text-muted); }
  .cb-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .cb-level { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .cb-cell.is-empty { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .cb-cell.is-ok { fill: var(--gold); }
  .cb-cell.is-bad { fill: var(--red); }
  .cb-lim { stroke-width: 1.5; stroke-dasharray: 4 3; }
  .cb-lim.is-ok { stroke: var(--gold); }
  .cb-lim.is-bad { stroke: var(--red); }
  .cb-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .cb-arrow polygon { fill: var(--text-muted); }
</style>
