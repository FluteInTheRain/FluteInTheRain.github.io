---
// Quiz figure for the typography post: two cards with their real font sizes.
---
<div class="qfig-uxq04scalecards">
  <svg viewBox="0 0 600 210" role="img" aria-label="Two small cards. Card P uses sizes 17, 15.5, 15 and 14.5 pixels. Card Q uses 24, 16 and 12 pixels.">
    <text x="20" y="22" class="h"><tspan data-lang-en>Card P</tspan><tspan data-lang-vi>Thẻ P</tspan></text>
    <rect x="20" y="32" width="270" height="164" rx="8" class="card" />
    <text x="36" y="66" style="font-size:17px;font-weight:700" class="t">Team plan</text>
    <text x="36" y="92" style="font-size:15.5px">Billed monthly</text>
    <text x="36" y="116" style="font-size:15px">Up to 10 seats, shared inbox</text>
    <text x="36" y="140" style="font-size:14.5px">Cancel any time</text>
    <text x="36" y="180" class="m">17 / 15.5 / 15 / 14.5 px</text>
    <text x="310" y="22" class="h"><tspan data-lang-en>Card Q</tspan><tspan data-lang-vi>Thẻ Q</tspan></text>
    <rect x="310" y="32" width="270" height="164" rx="8" class="card" />
    <text x="326" y="70" style="font-size:24px;font-weight:700" class="t">Team plan</text>
    <text x="326" y="102" style="font-size:16px">Up to 10 seats, shared inbox</text>
    <text x="326" y="128" style="font-size:12px">Billed monthly. Cancel any time</text>
    <text x="326" y="180" class="m">24 / 16 / 12 px</text>
  </svg>
</div>

<style>
  .qfig-uxq04scalecards { margin: 0; width: 100%; }
  .qfig-uxq04scalecards svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq04scalecards text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq04scalecards .h { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qfig-uxq04scalecards .m { fill: var(--text-muted); font-size: 12px; }
  .qfig-uxq04scalecards .t { fill: var(--text); }
  .qfig-uxq04scalecards .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq04scalecards .bar { fill: var(--text-muted); opacity: 0.55; }
  .qfig-uxq04scalecards .ln { stroke: var(--text-muted); stroke-width: 1; stroke-dasharray: 4 3; fill: none; }
  .qfig-uxq04scalecards .lna { stroke: var(--accent); stroke-width: 1.2; stroke-dasharray: 4 3; fill: none; }
</style>
