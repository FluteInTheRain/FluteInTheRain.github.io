---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-async-concurrency-workers set 07: the event loop thread busy from 0 to 10 s with ten
// blocking requests, and the platform's probe windows (sent at 1, 3, 5, 7, 9 s, each allowed 1 s to answer).
// It marks neither failures nor the restart. Inline SVG, site tokens only.
const x0 = 24;
const px = 44; // pixels per second
const tx = (s: number) => x0 + s * px;
const loopY = 62;
const probeY = 150;
const axisY = 214;
const probes = [1, 3, 5, 7, 9];
const ticks = [0, 2, 4, 6, 8, 10];
---
<div class="qfig-bqpt">
  <svg viewBox="0 0 580 246" role="img" aria-label="A time axis from 0 to 12 seconds. The event loop thread is busy from 0 to 10 seconds with ten blocking requests of 1 second each. The platform sends a health probe at 1, 3, 5, 7 and 9 seconds, and each probe is allowed 1 second to answer.">
    <DiagramIcon name={'server' as any} x={x0 + 10} y={loopY - 24} size={20} />
    <text x={x0 + 28} y={loopY - 19} class="qfig-bqpt-lane">
      <tspan data-lang-en>Event loop thread</tspan>
      <tspan data-lang-vi>Thread của event loop</tspan>
    </text>
    <rect x={tx(0)} y={loopY - 10} width={tx(10) - tx(0)} height="34" rx="5" class="qfig-bqpt-busy" />
    <text x={tx(0) + 10} y={loopY + 12} class="qfig-bqpt-t">
      <tspan data-lang-en>10 requests, time.sleep(1) each</tspan>
      <tspan data-lang-vi>10 request, mỗi cái time.sleep(1)</tspan>
    </text>

    <DiagramIcon name={'stopwatch' as any} x={x0 + 10} y={probeY - 28} size={20} />
    <text x={x0 + 28} y={probeY - 23} class="qfig-bqpt-lane">
      <tspan data-lang-en>Platform probe: GET /health</tspan>
      <tspan data-lang-vi>Probe của platform: GET /health</tspan>
    </text>
    {probes.map((p) => (
      <g>
        <rect x={tx(p)} y={probeY - 10} width={tx(1) - tx(0)} height="26" rx="4" class="qfig-bqpt-win" />
        <line x1={tx(p)} x2={tx(p)} y1={probeY - 16} y2={probeY + 22} class="qfig-bqpt-sent" />
        <text x={tx(p) + (tx(1) - tx(0)) / 2} y={probeY + 8} text-anchor="middle" class="qfig-bqpt-m">1 s</text>
      </g>
    ))}
    <text x={tx(1)} y={probeY + 42} class="qfig-bqpt-m">
      <tspan data-lang-en>Sent every 2 s; each gets 1 s to answer</tspan>
      <tspan data-lang-vi>Gửi mỗi 2 s; mỗi probe có 1 s để trả lời</tspan>
    </text>

    <line x1={tx(0)} x2={tx(12)} y1={axisY} y2={axisY} class="qfig-bqpt-axis" />
    {ticks.map((s) => (
      <g>
        <line x1={tx(s)} x2={tx(s)} y1={axisY} y2={axisY + 5} class="qfig-bqpt-axis" />
        <text x={tx(s)} y={axisY + 21} text-anchor="middle" class="qfig-bqpt-m">{s}</text>
      </g>
    ))}
    <text x={tx(12)} y={axisY + 21} text-anchor="end" class="qfig-bqpt-m">
      <tspan data-lang-en>s</tspan>
      <tspan data-lang-vi>giây</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-bqpt { margin: 0; width: 100%; }
  .qfig-bqpt svg { display: block; width: 100%; min-width: 340px; height: auto; }
  .qfig-bqpt text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bqpt .qfig-bqpt-lane { font-weight: 700; fill: var(--text); }
  .qfig-bqpt .qfig-bqpt-t { font-weight: 600; fill: var(--text); }
  .qfig-bqpt .qfig-bqpt-m { font-size: 13px; fill: var(--text-muted); }
  .qfig-bqpt-busy { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .qfig-bqpt-win { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-bqpt-sent { stroke: var(--text); stroke-width: 2; }
  .qfig-bqpt-axis { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
