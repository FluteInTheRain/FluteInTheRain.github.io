---
// Quiz figure for the Go interview post, set 06: three Allow() calls on a limiter with a refill rate of 2 tokens per
// second and a burst of 3, after the burst was spent. It shows the calls and the clock only, never the results.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const X0 = 60, X1 = 540, MAX = 500;
const px = (ms: number) => X0 + (ms * (X1 - X0)) / MAX;
const calls = [0, 250, 500];
---
<div class="qfig-gq20tt">
  <svg viewBox="0 0 580 200" role="img" aria-label="A timeline from 0 to 500 milliseconds with three Allow() calls, at 0, 250 and 500 milliseconds. The limiter has a refill rate of 2 tokens per second and a bucket of 3, and the bucket is empty at 0 milliseconds.">
    <text x="0" y="20" class="qfig-gq20tt-h">
      <tspan data-lang-en>Limiter: 2 tokens per second, bucket of 3</tspan>
      <tspan data-lang-vi>Limiter: 2 token mỗi giây, bucket 3 token</tspan>
    </text>

    <rect x={X0} y="40" width="150" height="28" rx="6" class="qfig-gq20tt-box" />
    <text x={X0 + 10} y="59" class="qfig-gq20tt-t">
      <tspan data-lang-en>3 tokens spent</tspan>
      <tspan data-lang-vi>Đã dùng 3 token</tspan>
    </text>

    <line x1={X0} x2={X1} y1="120" y2="120" class="qfig-gq20tt-axis" />
    {calls.map((ms, i) => (
      <g>
        <line x1={px(ms)} x2={px(ms)} y1="84" y2="120" class="qfig-gq20tt-drop" />
        <circle cx={px(ms)} cy="84" r="11" class="qfig-gq20tt-badge" />
        <text x={px(ms)} y="88.5" text-anchor="middle" class="qfig-gq20tt-n">{i + 1}</text>
        <line x1={px(ms)} x2={px(ms)} y1="116" y2="124" class="qfig-gq20tt-axis" />
        <text x={px(ms)} y="146" text-anchor={ms === 0 ? 'start' : ms === MAX ? 'end' : 'middle'} class="qfig-gq20tt-m">{ms} ms</text>
      </g>
    ))}
    <text x={X0} y="178" class="qfig-gq20tt-m">
      <tspan data-lang-en>Numbered circles: the three Allow() calls</tspan>
      <tspan data-lang-vi>Vòng tròn đánh số: ba lời gọi Allow()</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq20tt { margin: 0; width: 100%; }
  .qfig-gq20tt svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq20tt text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq20tt .qfig-gq20tt-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq20tt .qfig-gq20tt-t { font-weight: 700; fill: var(--text); }
  .qfig-gq20tt .qfig-gq20tt-m { fill: var(--text-muted); }
  .qfig-gq20tt .qfig-gq20tt-n { font-size: 12px; font-weight: 700; fill: var(--text); }
  .qfig-gq20tt-axis { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-gq20tt-drop { stroke: var(--border); stroke-width: 1.5; stroke-dasharray: 4 4; }
  .qfig-gq20tt-badge { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-gq20tt-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
</style>
