---
// Set 04: solved action values (bp) for the two-regime toy market (python3 quizcheck.py / q4.py, 2,000 sweeps, cost 5 bp, gamma 0.9).
const W = 580;
const H = 270;
const rows = [
  { en: 'Up, flat', vi: 'Tăng, đứng ngoài', f: '49.8', l: '58.4', best: 'l' },
  { en: 'Up, long', vi: 'Tăng, đang giữ', f: '44.8', l: '63.4', best: 'l' },
  { en: 'Down, flat', vi: 'Giảm, đứng ngoài', f: '27.6', l: '9.0', best: 'f' },
  { en: 'Down, long', vi: 'Giảm, đang giữ', f: '22.6', l: '14.0', best: 'f' },
];
const vi = (s: string) => s.replace('.', ',');
---
<div class="q19t">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <text x="14" y="24" class="q19t-h"><tspan data-lang-en>Action values in bp, after 2,000 sweeps</tspan><tspan data-lang-vi>Giá trị hành động (bp) sau 2.000 lượt cập nhật</tspan></text>
    <text x="14" y="52" class="q19t-c"><tspan data-lang-en>State (regime, position held)</tspan><tspan data-lang-vi>State (regime, vị thế đang giữ)</tspan></text>
    <text x="400" y="52" class="q19t-c" text-anchor="end"><tspan data-lang-en>Q(flat)</tspan><tspan data-lang-vi>Q(đứng ngoài)</tspan></text>
    <text x="548" y="52" class="q19t-c" text-anchor="end"><tspan data-lang-en>Q(long)</tspan><tspan data-lang-vi>Q(giữ)</tspan></text>
    {rows.map((r, i) => (
      <g>
        <rect x="14" y={62 + i * 48} width="552" height="40" rx="6" class="q19t-row" />
        <text x="26" y={88 + i * 48} class="q19t-l"><tspan data-lang-en>{r.en}</tspan><tspan data-lang-vi>{r.vi}</tspan></text>
        <rect x={r.best === 'f' ? 320 : 462} y={68 + i * 48} width={r.best === 'f' ? 82 : 88} height="28" rx="5" class="q19t-win" />
        <text x="394" y={88 + i * 48} text-anchor="end" class={r.best === 'f' ? 'q19t-n b' : 'q19t-n'}><tspan data-lang-en>{r.f}</tspan><tspan data-lang-vi>{vi(r.f)}</tspan></text>
        <text x="544" y={88 + i * 48} text-anchor="end" class={r.best === 'l' ? 'q19t-n b' : 'q19t-n'}><tspan data-lang-en>{r.l}</tspan><tspan data-lang-vi>{vi(r.l)}</tspan></text>
      </g>
    ))}
    <text x="14" y="262" class="q19t-c"><tspan data-lang-en>Highlighted: the larger value in each row.</tspan><tspan data-lang-vi>Tô nền: giá trị lớn hơn trong mỗi dòng.</tspan></text>
  </svg>
</div>
<style>
  .q19t { margin: 0; width: 100%; }
  .q19t svg { display: block; width: 100%; height: auto; }
  .q19t text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .q19t .q19t-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q19t .q19t-c { font-size: 12.5px; font-weight: 600; fill: var(--text-muted); }
  .q19t .q19t-l { font-weight: 600; fill: var(--text); }
  .q19t .q19t-n { font-size: 15px; fill: var(--text-muted); }
  .q19t .q19t-n.b { font-weight: 700; fill: var(--text); }
  .q19t .q19t-row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.1; }
  .q19t .q19t-win { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.2; }
</style>
