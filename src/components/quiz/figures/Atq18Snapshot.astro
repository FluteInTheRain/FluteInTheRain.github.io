---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 07: Feng et al. (2019), section 4: train 2013-2015 (756 days), validate 2016 (252), test 2017 up to 8 Dec (237);
// the Wikidata dump behind the Wiki relations is dated 5 Jan 2018.
const X0 = 30;
const X1 = 550;
const gx = (t: number) => X0 + ((t - 2013) / 5.3) * (X1 - X0);
---
<div class="qg18">
  <svg viewBox="0 0 580 200" role="img" aria-hidden="true">
    <text x="20" y="24" class="h">
      <tspan data-lang-en>When each piece of the study was made</tspan>
      <tspan data-lang-vi>Từng phần của nghiên cứu ứng với thời điểm nào</tspan>
    </text>
    <rect x={gx(2013)} y="60" width={gx(2016) - gx(2013)} height="30" rx="3" class="s tr" />
    <rect x={gx(2016)} y="60" width={gx(2017) - gx(2016)} height="30" rx="3" class="s va" />
    <rect x={gx(2017)} y="60" width={gx(2017.93) - gx(2017)} height="30" rx="3" class="s te" />
    <text x={(gx(2013) + gx(2016)) / 2} y="80" text-anchor="middle" class="lab">train</text>
    <text x={(gx(2016) + gx(2017)) / 2} y="80" text-anchor="middle" class="lab">validate</text>
    <text x={(gx(2017) + gx(2017.93)) / 2} y="80" text-anchor="middle" class="lab">test</text>
    <line x1={X0} x2={X1} y1="106" y2="106" class="axis" />
    {[2013, 2014, 2015, 2016, 2017, 2018].map((y) => (
      <g>
        <line x1={gx(y)} x2={gx(y)} y1="102" y2="110" class="axis" />
        <text x={gx(y)} y="126" text-anchor="middle" class="muted">{y}</text>
      </g>
    ))}
    <line x1={gx(2018.01)} x2={gx(2018.01)} y1="46" y2="106" class="dump" />
    <DiagramIcon name="warning" x={gx(2018.01)} y={38} size={18} />
    <text x={gx(2018.01) - 10} y="158" text-anchor="end" class="warn">
      <tspan data-lang-en>Wikidata dump: 5 Jan 2018</tspan>
      <tspan data-lang-vi>Bản dump Wikidata: 5/1/2018</tspan>
    </text>
  </svg>
</div>

<style>
  .qg18 { margin: 0; width: 100%; }
  .qg18 svg { display: block; width: 100%; height: auto; }
  .qg18 text { font-size: 12.5px; fill: var(--text-body); }
  .qg18 .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qg18 .lab { font-weight: 700; fill: var(--text); }
  .qg18 .muted { fill: var(--text-muted); font-size: 11.5px; }
  .qg18 .warn { fill: var(--red); font-weight: 700; }
  .qg18 .axis { stroke: var(--text-faint); }
  .qg18 .s { stroke: var(--border); fill: var(--bg-alt); }
  .qg18 .s.va { fill: var(--gold-tint-bg); }
  .qg18 .s.te { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 2; }
  .qg18 .dump { stroke: var(--red); stroke-width: 2.2; stroke-dasharray: 5 4; }
</style>
