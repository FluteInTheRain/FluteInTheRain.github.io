---
// Quiz figure for go-observability set 07: latency percentiles and runtime counters of one loopback load run
// against the Todo service (numbers from the post's terminal output). Inline SVG, site tokens only, no <marker>/<defs>/ids.
const X0 = 70, W = 400, MAX = 900;
const bars = [
  { k: 'p50', v: 131, y: 62 },
  { k: 'p95', v: 653, y: 100 },
  { k: 'p99', v: 898, y: 138 },
];
const w = (v: number) => (v * W) / MAX;
---
<div class="qfig-gq17ls">
  <svg viewBox="0 0 580 270" role="img" aria-label="Three bars for p50 131, p95 653 and p99 898 microseconds, and three runtime counters from the same run.">
    <text x="0" y="22" class="qfig-gq17ls-h">
      <tspan data-lang-en>One load run: 4,000 requests, 8 workers (µs)</tspan>
      <tspan data-lang-vi>Một lần chạy tải: 4.000 request, 8 worker (µs)</tspan>
    </text>
    {bars.map((b) => (
      <g>
        <text x="0" y={b.y + 5} class="qfig-gq17ls-k">{b.k}</text>
        <rect x={X0} y={b.y - 14} width={w(b.v)} height="26" rx="4" class="qfig-gq17ls-bar" />
        <text x={X0 + w(b.v) + 8} y={b.y + 5} class="qfig-gq17ls-v">{b.v}</text>
      </g>
    ))}
    <line x1={X0} x2={X0} y1="40" y2="154" class="qfig-gq17ls-axis" />
    <rect x="0" y="176" width="580" height="82" rx="8" class="qfig-gq17ls-card" />
    <text x="14" y="200" class="qfig-gq17ls-b">gc_cycles = <tspan class="qfig-gq17ls-v">95</tspan></text>
    <text x="14" y="224" class="qfig-gq17ls-b">heap_objects = <tspan class="qfig-gq17ls-v">1377 KiB</tspan></text>
    <text x="14" y="248" class="qfig-gq17ls-b">heap_inuse = <tspan class="qfig-gq17ls-v">3704 KiB</tspan></text>
  </svg>
</div>

<style>
  .qfig-gq17ls { margin: 0; width: 100%; }
  .qfig-gq17ls svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq17ls text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq17ls .qfig-gq17ls-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq17ls .qfig-gq17ls-k { font-weight: 700; fill: var(--text); }
  .qfig-gq17ls .qfig-gq17ls-v { font-weight: 700; fill: var(--text); }
  .qfig-gq17ls-bar { fill: var(--act-3); }
  .qfig-gq17ls-axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-gq17ls-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
</style>
