---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 03: a gateway fans out to 80 backends in parallel; the page is ready only when the slowest call returns.
// Shows the mechanism only (no probability results), so it never gives an answer away.
// Plain inline SVG, site tokens, no <marker>/<defs>, so the EN and VI copies cannot clash.

const W = 580;
const H = 392;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const gw = { x: 10, y: 128, w: 120, h: 72 };
const tx = 300; // timeline origin (0 ms)
const tw = 270; // width for 1,000 ms
const fastW = (20 / 1000) * tw; // 20 ms
const rows = [
  { en: 'Price', vi: 'Giá', slow: false },
  { en: 'Stock', vi: 'Tồn kho', slow: false },
  { en: 'Reviews', vi: 'Đánh giá', slow: false },
  { en: 'Suggestions', vi: 'Gợi ý', slow: true },
  { en: 'Ads', vi: 'Quảng cáo', slow: false },
].map((r, i) => ({ ...r, y: 82 + i * 36 }));
const moreY = 82 + 5 * 36;
const gwMid = gw.y + gw.h / 2;
---
<div class="qh">
  <div>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A gateway calls 80 backends in parallel. Most answer in about 20 ms, one takes 1 second, and the page is ready only when that slowest call returns.">
      <text x="10" y="26" class="qh-h">
        <tspan data-lang-en>One page waits for 80 backend calls</tspan>
        <tspan data-lang-vi>Một trang phải chờ 80 lời gọi backend</tspan>
      </text>

      <DiagramIcon name="laptop" x={70} y={70} size={28} />
      <g class="qh-box">
        <rect x={gw.x} y={gw.y} width={gw.w} height={gw.h} rx="8" />
        <DiagramIcon name="server" x={gw.x + 22} y={gw.y + 24} size={20} />
        <text x={gw.x + 40} y={gw.y + 29} class="qh-name">Gateway</text>
        <text x={gw.x + gw.w / 2} y={gw.y + 56} text-anchor="middle" class="qh-sub">
          <tspan data-lang-en>80 at once</tspan>
          <tspan data-lang-vi>80 cùng lúc</tspan>
        </text>
      </g>
      {(() => { const a = arrow(70, 88, 70, gw.y - 2); return <g class="qh-arrow"><path d={a.line} /><polygon points={a.head} /></g>; })()}

      {rows.map((r) => {
        const a = arrow(gw.x + gw.w, gwMid, 154, r.y);
        const bw = r.slow ? tw : fastW;
        return (
          <g>
            <g class="qh-arrow"><path d={a.line} /><polygon points={a.head} /></g>
            <DiagramIcon name="server" x={170} y={r.y} size={18} />
            <text x={186} y={r.y + 5} class={r.slow ? 'qh-name is-slow' : 'qh-name'}>
              <tspan data-lang-en>{r.en}</tspan>
              <tspan data-lang-vi>{r.vi}</tspan>
            </text>
            <rect x={tx} y={r.y - 8} width={tw} height="16" rx="3" class="qh-track" />
            <rect x={tx} y={r.y - 8} width={bw} height="16" rx="3" class={r.slow ? 'qh-bar is-slow' : 'qh-bar'} />
            {r.slow ? (
              <text x={tx + tw - 8} y={r.y + 5} text-anchor="end" class="qh-bar-label">
                <tspan data-lang-en>1,000 ms, slow</tspan>
                <tspan data-lang-vi>1.000 ms, chậm</tspan>
              </text>
            ) : (
              <text x={tx + fastW + 8} y={r.y + 5} class="qh-num">20 ms</text>
            )}
          </g>
        );
      })}
      {(() => { const a = arrow(gw.x + gw.w, gwMid, 154, moreY); return <g class="qh-arrow"><path d={a.line} /><polygon points={a.head} /></g>; })()}
      <text x={186} y={moreY + 5} class="qh-sub">
        <tspan data-lang-en>74 more</tspan>
        <tspan data-lang-vi>74 khác</tspan>
      </text>
      <text x={tx + 8} y={moreY + 5} class="qh-sub">
        <tspan data-lang-en>mostly about 20 ms each</tspan>
        <tspan data-lang-vi>phần lớn khoảng 20 ms</tspan>
      </text>

      <line x1={tx + tw} x2={tx + tw} y1="56" y2="288" class="qh-ready" />
      <text x={tx + tw} y="46" text-anchor="end" class="qh-ready-t">
        <tspan data-lang-en>Page ready: slowest call returns</tspan>
        <tspan data-lang-vi>Trang xong khi lời gọi chậm nhất về</tspan>
      </text>

      <line x1={tx} x2={tx + tw} y1="300" y2="300" class="qh-axis" />
      <text x={tx} y="320" text-anchor="middle" class="qh-num">0</text>
      <text x={tx + tw} y="320" text-anchor="end" class="qh-num"><tspan data-lang-en>1,000 ms</tspan><tspan data-lang-vi>1.000 ms</tspan></text>

      <text x="10" y="352" class="qh-note">
        <tspan data-lang-en>Each call is slow with probability p = 0.005</tspan>
        <tspan data-lang-vi>Mỗi lời gọi chậm với xác suất p = 0,005</tspan>
      </text>
      <text x="10" y="374" class="qh-note">
        <tspan data-lang-en>(1 in 200), independently of the others.</tspan>
        <tspan data-lang-vi>(1 trên 200), độc lập với các lời gọi khác.</tspan>
      </text>
    </svg>
  </div>
</div>

<style>
  .qh { width: 100%; }
    .qh svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qh text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qh .qh-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qh .qh-name { font-weight: 700; fill: var(--text); }
  .qh .qh-name.is-slow { fill: var(--red); }
  .qh .qh-sub, .qh .qh-num { fill: var(--text-muted); }
  .qh .qh-note { font-size: 14px; fill: var(--text); }
  .qh-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qh-track { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qh-bar { fill: var(--gold); }
  .qh-bar.is-slow { fill: var(--red); }
  .qh .qh-bar-label { fill: var(--bg); font-weight: 700; }
  .qh-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .qh-arrow polygon { fill: var(--text-muted); }
  .qh-ready { stroke: var(--red); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .qh .qh-ready-t { fill: var(--red); font-weight: 700; }
  .qh-axis { stroke: var(--border); stroke-width: 1.5; }
</style>
