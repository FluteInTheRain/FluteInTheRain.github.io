---
// Figure for quiz set 03: a gateway fans out to 80 backends, one of them slow,
// and a strip shows how the chance of a slow page grows with N when each call is slow 0.5% of the time.
// Numbers: 1 - 0.995^N for N = 1, 10, 80, 300 (computed with python3).
const W = 520;
const H = 452;

const cols = 10;
const rows = 8;
const gx = 170;
const gy = 48;
const cw = 32;
const ch = 24;
const slow = new Set([3 * cols + 6]); // one slow backend in this sample page
const cells = Array.from({ length: cols * rows }, (_, i) => ({
  x: gx + (i % cols) * cw,
  y: gy + Math.floor(i / cols) * ch,
  slow: slow.has(i),
}));

const bars = [
  { n: 1, pct: 0.5 },
  { n: 10, pct: 4.9 },
  { n: 80, pct: 33.0 },
  { n: 300, pct: 77.8 },
];
const bx = 64;
const bw = 380;
const by0 = 330;
const bgap = 30;
---

<svg class="qfig-hundred" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Gateway fans out to 80 backends; chance of a slow page grows with N">
  <text x="20" y="26" class="qfig-hundred-h">
    <tspan data-lang-en>One page, 80 parallel calls</tspan>
    <tspan data-lang-vi>Một trang, 80 lời gọi song song</tspan>
  </text>

  <g class="qfig-hundred-box">
    <rect x="20" y="108" width="100" height="44" rx="8" />
    <text x="70" y="136" text-anchor="middle" class="qfig-hundred-t">
      <tspan data-lang-en>Gateway</tspan>
      <tspan data-lang-vi>Gateway</tspan>
    </text>
  </g>
  <path d="M120 130 L156 130" class="qfig-hundred-line" />
  <polygon points="164,130 154,125 154,135" class="qfig-hundred-head" />

  {cells.map((c) => (
    <rect x={c.x} y={c.y} width={cw - 6} height={ch - 5} rx="4" class={c.slow ? 'qfig-hundred-cell is-slow' : 'qfig-hundred-cell'} />
  ))}

  <g>
    <rect x="20" y="252" width="16" height="13" rx="3" class="qfig-hundred-cell" />
    <text x="44" y="263" class="qfig-hundred-sub">
      <tspan data-lang-en>fast call, about 20 ms</tspan>
      <tspan data-lang-vi>lời gọi nhanh, khoảng 20 ms</tspan>
    </text>
    <rect x="270" y="252" width="16" height="13" rx="3" class="qfig-hundred-cell is-slow" />
    <text x="294" y="263" class="qfig-hundred-sub">
      <tspan data-lang-en>slow call, 1 s</tspan>
      <tspan data-lang-vi>lời gọi chậm, 1 s</tspan>
    </text>
  </g>

  <line x1="20" x2={W - 20} y1="282" y2="282" class="qfig-hundred-rule" />
  <text x="20" y="306" class="qfig-hundred-h">
    <tspan data-lang-en>Chance of a slow page (each call slow 0.5%)</tspan>
    <tspan data-lang-vi>Xác suất trang chậm (mỗi lời gọi chậm 0,5%)</tspan>
  </text>

  {bars.map((b, i) => {
    const y = by0 + i * bgap;
    const w = Math.max(3, (bw * b.pct) / 100);
    return (
      <g>
        <text x="20" y={y + 15} class="qfig-hundred-sub">N={b.n}</text>
        <rect x={bx} y={y} width={bw} height="20" rx="4" class="qfig-hundred-track" />
        <rect x={bx} y={y} width={w} height="20" rx="4" class={b.pct > 20 ? 'qfig-hundred-bar is-hot' : 'qfig-hundred-bar'} />
        <text x={bx + bw + 8} y={y + 15} class="qfig-hundred-val">{b.pct.toFixed(1)}%</text>
      </g>
    );
  })}
</svg>

<style>
  .qfig-hundred { width: 100%; height: auto; display: block; }
  .qfig-hundred text { font-family: inherit; }
  .qfig-hundred-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-hundred-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-hundred-sub { font-size: 14px; fill: var(--text-muted); }
  .qfig-hundred-val { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-hundred-box rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-hundred-line { stroke: var(--text-muted); stroke-width: 2; fill: none; }
  .qfig-hundred-head { fill: var(--text-muted); }
  .qfig-hundred-cell { fill: var(--bg-alt); stroke: var(--act-2); stroke-width: 1.5; }
  .qfig-hundred-cell.is-slow { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 2; }
  .qfig-hundred-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-hundred-track { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-hundred-bar { fill: var(--gold); }
  .qfig-hundred-bar.is-hot { fill: var(--red); }
</style>
