---
// Five stocks, hand-picked distances for the question (not market data).
const P: [number, number][] = [[60, 120], [170, 70], [300, 150], [420, 90], [520, 170]];
const N = ['A', 'B', 'C', 'D', 'E'];
const E: [number, number, string][] = [[0, 1, '0.6'], [1, 2, '1.05'], [2, 3, '0.7'], [3, 4, '0.5'], [2, 4, '0.8']];
---
<div class="q11k">
  <svg viewBox="0 0 580 220" role="img" aria-hidden="true">
    <text x="20" y="24" class="q11k-h"><tspan data-lang-en>Five stocks and the distance of each possible link</tspan><tspan data-lang-vi>Năm mã và khoảng cách của từng cạnh có thể có</tspan></text>
    {E.map(([a, b]) => <line x1={P[a][0]} y1={P[a][1]} x2={P[b][0]} y2={P[b][1]} class="q11k-e" />)}
    {E.map(([a, b, d]) => <g><rect x={(P[a][0] + P[b][0]) / 2 - 18} y={(P[a][1] + P[b][1]) / 2 - 11} width="36" height="20" rx="4" class="q11k-l" /><text x={(P[a][0] + P[b][0]) / 2} y={(P[a][1] + P[b][1]) / 2 + 4} text-anchor="middle" class="q11k-d">{d}</text></g>)}
    {P.map(([x, y], i) => <g><circle cx={x} cy={y} r="16" class="q11k-n" /><text x={x} y={y + 5} text-anchor="middle" class="q11k-t">{N[i]}</text></g>)}
  </svg>
</div>
<style>
  .q11k { margin: 0; width: 100%; }
  .q11k svg { display: block; width: 100%; height: auto; }
  .q11k text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .q11k .q11k-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q11k .q11k-t { font-weight: 700; fill: var(--text); }
  .q11k .q11k-d { font-size: 12.5px; font-weight: 600; fill: var(--text); }
  .q11k-e { stroke: var(--text-muted); stroke-width: 1.8; }
  .q11k-l { fill: var(--bg-alt); stroke: var(--border); }
  .q11k-n { fill: var(--bg-alt); stroke: var(--text); stroke-width: 1.5; }
</style>
