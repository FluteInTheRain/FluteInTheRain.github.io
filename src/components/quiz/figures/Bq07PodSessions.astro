---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-auth set 02: three API pods behind a round-robin load balancer, each with its own in-memory
// SESSIONS dict. Two requests of one user go to pod 1 then pod 2. It shows the topology only, not the outcome.
function head(x: number, y: number, dx: number, dy: number) {
  // small arrowhead polygon pointing along (dx, dy)
  const l = Math.hypot(dx, dy); const ux = dx / l; const uy = dy / l;
  const px = -uy; const py = ux;
  return `${x},${y} ${x - ux * 10 + px * 5},${y - uy * 10 + py * 5} ${x - ux * 10 - px * 5},${y - uy * 10 - py * 5}`;
}
const pods = [
  { y: 36, n: 1 },
  { y: 124, n: 2 },
  { y: 212, n: 3 },
];
const lbX = 150;
const podX = 320;
---
<div class="qfig-ps">
  <svg viewBox="0 0 580 296" role="img" aria-label="A client sends two requests through a load balancer to three pods; each pod keeps its own SESSIONS dict in memory. Request 1 goes to pod 1 and request 2 goes to pod 2.">
    <DiagramIcon name="laptop" x={28} y={118} size={34} />
    <text x="45" y="170" text-anchor="middle" class="qfig-ps-lane">
      <tspan data-lang-en>Alice</tspan>
      <tspan data-lang-vi>Alice</tspan>
    </text>

    <DiagramIcon name="network" x={lbX - 20} y={118} size={34} />
    <text x={lbX} y="170" text-anchor="middle" class="qfig-ps-lane">
      <tspan data-lang-en>Load balancer</tspan>
      <tspan data-lang-vi>Load balancer</tspan>
    </text>
    <text x={lbX} y="188" text-anchor="middle" class="qfig-ps-m">
      <tspan data-lang-en>next pod in turn</tspan>
      <tspan data-lang-vi>lần lượt từng pod</tspan>
    </text>

    <line x1="80" x2={lbX - 36} y1="135" y2="135" class="qfig-ps-line" />
    <polygon points={head(lbX - 30, 135, 1, 0)} class="qfig-ps-headline" />

    {pods.map((p) => (
      <g>
        <rect x={podX} y={p.y} width="250" height="76" rx="8" class="qfig-ps-pod" />
        <DiagramIcon name="server" x={podX + 12} y={p.y + 12} size={26} />
        <text x={podX + 48} y={p.y + 30} class="qfig-ps-lane">Pod {p.n}</text>
        <text x={podX + 16} y={p.y + 58} class="qfig-ps-m">
          <tspan data-lang-en>own SESSIONS dict, in memory</tspan>
          <tspan data-lang-vi>dict SESSIONS riêng, trong bộ nhớ</tspan>
        </text>
      </g>
    ))}

    <line x1={lbX + 30} x2={podX - 14} y1="128" y2="76" class="qfig-ps-line" />
    <polygon points={head(podX - 6, 73, 1, -0.2)} class="qfig-ps-headline" />
    <line x1={lbX + 30} x2={podX - 14} y1="142" y2="162" class="qfig-ps-line2" />
    <polygon points={head(podX - 6, 164, 1, 0.2)} class="qfig-ps-headline2" />

    <circle cx={lbX + 95} cy="86" r="11" class="qfig-ps-num" />
    <text x={lbX + 95} y="91" text-anchor="middle" class="qfig-ps-numt">1</text>
    <circle cx={lbX + 95} cy="170" r="11" class="qfig-ps-num2" />
    <text x={lbX + 95} y="175" text-anchor="middle" class="qfig-ps-numt">2</text>
    <text x="10" y="262" class="qfig-ps-t">
      <tspan data-lang-en>1: POST /session/login</tspan>
      <tspan data-lang-vi>1: POST /session/login</tspan>
    </text>
    <text x="10" y="282" class="qfig-ps-t">
      <tspan data-lang-en>2: GET /session/me, with the session id from 1</tspan>
      <tspan data-lang-vi>2: GET /session/me, kèm session id từ bước 1</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-ps { margin: 0; width: 100%; }
  .qfig-ps svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-ps text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-ps .qfig-ps-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-ps .qfig-ps-t { font-weight: 600; fill: var(--text); }
  .qfig-ps .qfig-ps-m { fill: var(--text-muted); }
  .qfig-ps-pod { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-ps-line { stroke: var(--act-2); stroke-width: 2; }
  .qfig-ps-headline { fill: var(--act-2); }
  .qfig-ps-line2 { stroke: var(--text-muted); stroke-width: 2; stroke-dasharray: 6 4; }
  .qfig-ps-headline2 { fill: var(--text-muted); }
  .qfig-ps-num { fill: var(--act-2); }
  .qfig-ps-num2 { fill: var(--text-muted); }
  .qfig-ps .qfig-ps-numt { font-size: 13px; font-weight: 700; fill: var(--bg); }
</style>
