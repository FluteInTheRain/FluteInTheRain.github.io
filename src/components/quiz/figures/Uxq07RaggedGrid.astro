---
// Quiz figure for the images post quiz (Uxq07).
---
<div class="qfig-uxq07raggedgrid">
  <svg viewBox="0 0 600 400" role="img" aria-label="Three cards in one row with images of different heights, so the buttons below them sit at three different heights.">
    <rect x="20" y="40" width="170" height="302" class="card" />
    <path d="M20 342 L80 230 L120 290 L150 250 L190 342 Z" class="bar" />
    <text x="105" y="70" text-anchor="middle" class="h">9:16</text>
    <rect x="20" y="354" width="170" height="30" rx="6" class="accf" />
    <rect x="215" y="40" width="170" height="73" class="card" />
    <path d="M215 113 L260 70 L290 95 L320 62 L385 113 Z" class="bar" />
    <text x="300" y="60" text-anchor="middle" class="h">21:9</text>
    <rect x="215" y="125" width="170" height="30" rx="6" class="accf" />
    <rect x="410" y="40" width="170" height="170" class="card" />
    <path d="M410 210 L470 120 L510 170 L540 140 L580 210 Z" class="bar" />
    <text x="495" y="70" text-anchor="middle" class="h">1:1</text>
    <rect x="410" y="222" width="170" height="30" rx="6" class="accf" />
    <text x="20" y="24" class="mono">width: 100%; height: auto;</text>
    <text x="580" y="392" text-anchor="end" class="m"><tspan data-lang-en>Each card is 200px wide in the page</tspan><tspan data-lang-vi>Mỗi thẻ rộng 200px trên trang</tspan></text>
  </svg>
</div>

<style>
  .qfig-uxq07raggedgrid { margin: 0; width: 100%; }
  .qfig-uxq07raggedgrid svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq07raggedgrid text { font-size: 13.5px; fill: var(--text-body); }
  .qfig-uxq07raggedgrid .h { font-weight: 700; fill: var(--text); }
  .qfig-uxq07raggedgrid .m { fill: var(--text-muted); font-size: 13px; }
  .qfig-uxq07raggedgrid .mono { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; fill: var(--text-muted); }
  .qfig-uxq07raggedgrid .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq07raggedgrid .bar { fill: var(--border); }
  .qfig-uxq07raggedgrid .ln { stroke: var(--text-muted); stroke-width: 1.4; fill: none; }
  .qfig-uxq07raggedgrid .acc { stroke: var(--red); stroke-width: 2; fill: none; }
  .qfig-uxq07raggedgrid .accf { fill: var(--red); }
  .qfig-uxq07raggedgrid .dash { stroke: var(--red); stroke-width: 2; stroke-dasharray: 6 4; fill: none; }
  .qfig-uxq07raggedgrid .ico { stroke: var(--text); fill: none; stroke-linecap: round; stroke-linejoin: round; }
</style>
