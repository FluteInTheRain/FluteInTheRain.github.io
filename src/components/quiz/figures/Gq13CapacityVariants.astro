---
// Quiz figure for the Go concurrency quiz (post 13), set 03: the same two goroutines with a channel of
// capacity 1 and with a channel of capacity 0. It lists each goroutine's two statements in program order and
// names the channel. It draws no timing and no verdict.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const panels = [
  { y: 0, cap: '1', en: 'Variant A: capacity 1', vi: 'Biến thể A: capacity 1' },
  { y: 150, cap: '0', en: 'Variant B: capacity 0', vi: 'Biến thể B: capacity 0' },
];
const main = ['ch <- struct{}{}', 'fmt.Println(i)'];
const child = ['i = 1', '<-ch'];
---
<div class="qfig-gq13cv">
  <svg viewBox="0 0 580 300" role="img" aria-label="Two panels with the same two goroutines. In each panel, main runs a send on the channel and then prints i, and the child goroutine sets i to 1 and then receives from the channel. The first panel's channel has capacity 1, the second panel's channel has capacity 0.">
    {panels.map((p) => (
      <g>
        <text x="0" y={p.y + 18} class="qfig-gq13cv-h">
          <tspan data-lang-en>{p.en}</tspan>
          <tspan data-lang-vi>{p.vi}</tspan>
        </text>
        <text x="20" y={p.y + 44} class="qfig-gq13cv-m">main</text>
        <text x="380" y={p.y + 44} class="qfig-gq13cv-m">
          <tspan data-lang-en>child goroutine</tspan>
          <tspan data-lang-vi>goroutine con</tspan>
        </text>
        {main.map((c, i) => (
          <g>
            <rect x="20" y={p.y + 52 + i * 42} width="190" height="32" rx="6" class="qfig-gq13cv-box" />
            <text x="32" y={p.y + 73 + i * 42} class="qfig-gq13cv-c">{c}</text>
          </g>
        ))}
        {child.map((c, i) => (
          <g>
            <rect x="380" y={p.y + 52 + i * 42} width="180" height="32" rx="6" class="qfig-gq13cv-box" />
            <text x="392" y={p.y + 73 + i * 42} class="qfig-gq13cv-c">{c}</text>
          </g>
        ))}
        <rect x="236" y={p.y + 66} width="118" height="44" rx="22" class="qfig-gq13cv-chan" />
        <text x="295" y={p.y + 85} text-anchor="middle" class="qfig-gq13cv-c">chan struct{}</text>
        <text x="295" y={p.y + 102} text-anchor="middle" class="qfig-gq13cv-m">
          <tspan data-lang-en>capacity {p.cap}</tspan>
          <tspan data-lang-vi>capacity {p.cap}</tspan>
        </text>
        <line x1="115" x2="115" y1={p.y + 84} y2={p.y + 94} class="qfig-gq13cv-line" />
        <line x1="470" x2="470" y1={p.y + 84} y2={p.y + 94} class="qfig-gq13cv-line" />
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-gq13cv { margin: 0; width: 100%; }
  .qfig-gq13cv svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq13cv text { font-size: 13px; fill: var(--text-body); }
  .qfig-gq13cv .qfig-gq13cv-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq13cv .qfig-gq13cv-m { fill: var(--text-muted); }
  .qfig-gq13cv .qfig-gq13cv-c { font-family: var(--font-mono, monospace); fill: var(--text); }
  .qfig-gq13cv-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-gq13cv-chan { fill: var(--bg); stroke: var(--act-2); stroke-width: 2; }
  .qfig-gq13cv-line { stroke: var(--border); stroke-width: 2; }
</style>
