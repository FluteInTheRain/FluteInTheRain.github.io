---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for sharding set 06: the shard map in the shard-map service says host B owns shard 17,
// the routing tier still holds the old map (host A). Shows only scenario inputs, no computed result.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 10 * Math.cos(a - 0.45), y2 - 10 * Math.sin(a - 0.45)];
  const p2 = [x2 - 10 * Math.cos(a + 0.45), y2 - 10 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 8 * Math.cos(a)} ${y2 - 8 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const poll = arrow(290, 108, 290, 176);
const inA = arrow(130, 215, 160, 215);
const toA = arrow(220, 262, 140, 332);
const toB = arrow(360, 262, 440, 332);
---
<div class="qfig-smap">
  <svg viewBox="0 0 580 440" role="img" aria-label="The shard-map service says host B owns shard 17, but the routing tier still holds an old map that points to host A.">
    <g class="qfig-smap-svc">
      <rect x="170" y="14" width="240" height="94" rx="8" />
      <DiagramIcon name="db" x="200" y="42" size={26} />
      <text x="224" y="38" class="qfig-smap-t">
        <tspan data-lang-en>Shard-map service</tspan>
        <tspan data-lang-vi>Dịch vụ shard map</tspan>
      </text>
      <text x="186" y="70" class="qfig-smap-n">
        <tspan data-lang-en>Shard 17 → host B (new)</tspan>
        <tspan data-lang-vi>Shard 17 → host B (mới)</tspan>
      </text>
      <text x="186" y="92" class="qfig-smap-m">
        <tspan data-lang-en>480 shards in total</tspan>
        <tspan data-lang-vi>Tổng cộng 480 shard</tspan>
      </text>
    </g>

    <g class="qfig-smap-go"><path d={poll.line} /><polygon points={poll.head} /></g>
    <text x="302" y="148" class="qfig-smap-m">
      <tspan data-lang-en>each router polls every 5 s</tspan>
      <tspan data-lang-vi>mỗi router hỏi lại mỗi 5 giây</tspan>
    </text>

    <g class="qfig-smap-cl">
      <DiagramIcon name="users" x="56" y="200" size={34} />
      <text x="56" y="244" text-anchor="middle" class="qfig-smap-n">
        <tspan data-lang-en>Clients</tspan>
        <tspan data-lang-vi>Client</tspan>
      </text>
      <text x="56" y="262" text-anchor="middle" class="qfig-smap-m">
        <tspan data-lang-en>96,000 req/s</tspan>
        <tspan data-lang-vi>96.000 req/s</tspan>
      </text>
    </g>
    <g class="qfig-smap-in"><path d={inA.line} /><polygon points={inA.head} /></g>

    <g class="qfig-smap-rt">
      <rect x="160" y="178" width="260" height="84" rx="8" />
      <DiagramIcon name="server" x="190" y="206" size={26} />
      <text x="214" y="202" class="qfig-smap-t">
        <tspan data-lang-en>Routing tier: 4 routers</tspan>
        <tspan data-lang-vi>Tầng định tuyến: 4 router</tspan>
      </text>
      <text x="176" y="230" class="qfig-smap-bad">
        <tspan data-lang-en>Cached: shard 17 → host A</tspan>
        <tspan data-lang-vi>Cache: shard 17 → host A</tspan>
      </text>
      <text x="176" y="250" class="qfig-smap-m">
        <tspan data-lang-en>old copy of the map</tspan>
        <tspan data-lang-vi>bản cũ của shard map</tspan>
      </text>
    </g>

    <g class="qfig-smap-badline"><path d={toA.line} /><polygon points={toA.head} /></g>
    <g class="qfig-smap-go"><path d={toB.line} /><polygon points={toB.head} /></g>

    <g class="qfig-smap-ha">
      <rect x="20" y="334" width="240" height="90" rx="8" />
      <DiagramIcon name="server" x="50" y="362" size={26} />
      <text x="74" y="368" class="qfig-smap-t">
        <tspan data-lang-en>Host A</tspan>
        <tspan data-lang-vi>Host A</tspan>
      </text>
      <text x="36" y="396" class="qfig-smap-m">
        <tspan data-lang-en>shard 17 just moved away</tspan>
        <tspan data-lang-vi>shard 17 vừa chuyển đi</tspan>
      </text>
      <text x="36" y="414" class="qfig-smap-bad">
        <tspan data-lang-en>old route still sends here</tspan>
        <tspan data-lang-vi>route cũ vẫn gửi tới đây</tspan>
      </text>
    </g>
    <g class="qfig-smap-hb">
      <rect x="320" y="334" width="240" height="90" rx="8" />
      <DiagramIcon name="server" x="350" y="362" size={26} />
      <text x="374" y="368" class="qfig-smap-t">
        <tspan data-lang-en>Host B</tspan>
        <tspan data-lang-vi>Host B</tspan>
      </text>
      <text x="336" y="396" class="qfig-smap-m">
        <tspan data-lang-en>shard 17 now lives here</tspan>
        <tspan data-lang-vi>shard 17 giờ nằm ở đây</tspan>
      </text>
    </g>
  </svg>
</div>

<style>
  .qfig-smap { margin: 0; width: 100%; }
  .qfig-smap svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-smap text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-smap .qfig-smap-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-smap .qfig-smap-n { font-size: 15px; font-weight: 600; fill: var(--text); }
  .qfig-smap .qfig-smap-m { fill: var(--text-muted); }
  .qfig-smap .qfig-smap-bad { font-weight: 700; fill: var(--red); }
  .qfig-smap-svc rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-smap-rt rect { fill: var(--bg-alt); stroke: var(--red); stroke-width: 1.6; }
  .qfig-smap-ha rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-smap-hb rect { fill: var(--bg-alt); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-smap-go path { stroke: var(--gold); stroke-width: 2; fill: none; }
  .qfig-smap-go polygon { fill: var(--gold); }
  .qfig-smap-badline path { stroke: var(--red); stroke-width: 2; fill: none; }
  .qfig-smap-badline polygon { fill: var(--red); }
  .qfig-smap-in path { stroke: var(--text-muted); stroke-width: 1.8; fill: none; }
  .qfig-smap-in polygon { fill: var(--text-muted); }
</style>
