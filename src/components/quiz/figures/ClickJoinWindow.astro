---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for stream set 07: two searches on a 0 to 120 minute axis, each with its own one-hour window;
// search A gets a click at minute 34, search B gets none. Below, the totals of the scenario as two bars.
// It shows no click-through rate and no join output. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const x0 = 40;
const px = 4.2; // pixels per minute
const tx = (m: number) => x0 + m * px;
const ticks = [0, 20, 40, 60, 80, 100, 120];
const yA = 86;
const yB = 178;
const axisY = 216;
const barW = 504;
const clickW = (800 / 10000) * barW;
---
<div class="qfig-cjw">
  <svg viewBox="0 0 580 352" role="img" aria-label="Two searches on a 0 to 120 minute axis, each with a one-hour window: search A at minute 10 gets a click at minute 34, search B at minute 25 gets no click. Below, a bar of 10,000 searches shown and a short bar of 800 searches with a click.">
    <text x="0" y="20" class="qfig-cjw-h">
      <tspan data-lang-en>Two searches, one hour to get a click</tspan>
      <tspan data-lang-vi>Hai lượt tìm kiếm, mỗi lượt có một giờ để nhận click</tspan>
    </text>

    <!-- search A -->
    <text x={tx(10)} y={yA - 24} class="qfig-cjw-lane">
      <tspan data-lang-en>Search A, shown at minute 10</tspan>
      <tspan data-lang-vi>Search A, hiện lúc phút 10</tspan>
    </text>
    <rect x={tx(10)} y={yA - 12} width={60 * px} height="24" rx="5" class="qfig-cjw-win-ok" />
    <DiagramIcon name="search" x={tx(10) - 11} y={yA - 11} size={22} />
    <circle cx={tx(34)} cy={yA} r="7" class="qfig-cjw-click" />
    <text x={tx(34)} y={yA + 34} text-anchor="middle" class="qfig-cjw-m">
      <tspan data-lang-en>click at minute 34</tspan>
      <tspan data-lang-vi>click lúc phút 34</tspan>
    </text>

    <!-- search B -->
    <text x={tx(25)} y={yB - 24} class="qfig-cjw-lane">
      <tspan data-lang-en>Search B, shown at minute 25</tspan>
      <tspan data-lang-vi>Search B, hiện lúc phút 25</tspan>
    </text>
    <rect x={tx(25)} y={yB - 12} width={60 * px} height="24" rx="5" class="qfig-cjw-win-none" />
    <DiagramIcon name="search" x={tx(25) - 11} y={yB - 11} size={22} />
    <text x={tx(55)} y={yB + 5} text-anchor="middle" class="qfig-cjw-m">
      <tspan data-lang-en>no click in this hour</tspan>
      <tspan data-lang-vi>không có click trong giờ này</tspan>
    </text>

    <!-- axis -->
    <line x1={tx(0)} x2={tx(120)} y1={axisY} y2={axisY} class="qfig-cjw-axis" />
    {ticks.map((m) => (
      <g>
        <line x1={tx(m)} x2={tx(m)} y1={axisY} y2={axisY + 5} class="qfig-cjw-axis" />
        <text x={tx(m)} y={axisY + 21} text-anchor="middle" class="qfig-cjw-m">{m}</text>
      </g>
    ))}
    <text x={tx(120)} y={axisY + 40} text-anchor="end" class="qfig-cjw-m">
      <tspan data-lang-en>minutes</tspan>
      <tspan data-lang-vi>phút</tspan>
    </text>

    <!-- totals -->
    <text x={x0} y="278" class="qfig-cjw-t">
      <tspan data-lang-en>10,000 searches shown</tspan>
      <tspan data-lang-vi>10.000 lượt tìm kiếm được hiện</tspan>
    </text>
    <rect x={x0} y="286" width={barW} height="16" rx="3" class="qfig-cjw-all" />
    <text x={x0} y="326" class="qfig-cjw-t">
      <tspan data-lang-en>800 of them got a click</tspan>
      <tspan data-lang-vi>800 lượt trong đó nhận được click</tspan>
    </text>
    <rect x={x0} y="334" width={clickW} height="16" rx="3" class="qfig-cjw-got" />
  </svg>
</div>

<style>
  .qfig-cjw { margin: 0; width: 100%; }
  .qfig-cjw svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-cjw text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-cjw .qfig-cjw-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-cjw .qfig-cjw-lane { font-weight: 700; fill: var(--text); }
  .qfig-cjw .qfig-cjw-t { font-weight: 600; fill: var(--text); }
  .qfig-cjw .qfig-cjw-m { fill: var(--text-muted); }
  .qfig-cjw-win-ok { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .qfig-cjw-win-none { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .qfig-cjw-click { fill: var(--gold); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-cjw-axis { stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-cjw-all { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-cjw-got { fill: var(--gold); }
</style>
