---
// Set 02: momentum (Mom) and the market's excess return in March, April, May 2009, Ken French data library.
const mom = [-11.8, -34.36, -12.54], mkt = [9.01, 10.17, 5.21], mo = ['Mar 2009', 'Apr 2009', 'May 2009'], mv = ['3/2009', '4/2009', '5/2009'];
const Z = 170, S = 3.6;
---
<div class="q6b">
  <svg viewBox="0 0 580 380" role="img" aria-hidden="true">
    <text x="20" y="24" class="h"><tspan data-lang-en>Three months in 2009 (%, monthly)</tspan><tspan data-lang-vi>Ba tháng năm 2009 (%, theo tháng)</tspan></text>
    <line x1="20" x2="560" y1={Z} y2={Z} class="z" />
    {mom.map((v, i) => (
      <g>
        <rect x={50 + i * 175} y={Z} width="60" height={-v * S} class="mom" />
        <rect x={116 + i * 175} y={Z - mkt[i] * S} width="60" height={mkt[i] * S} class="mk" />
        <text x={80 + i * 175} y={Z - v * S + 16} text-anchor="middle" class="n">{v.toFixed(2).replace('-', '−')}</text>
        <text x={146 + i * 175} y={Z - mkt[i] * S - 6} text-anchor="middle" class="n">+{mkt[i].toFixed(2)}</text>
        <text x={113 + i * 175} y="360" text-anchor="middle" class="m"><tspan data-lang-en>{mo[i]}</tspan><tspan data-lang-vi>{mv[i]}</tspan></text>
      </g>
    ))}
    <rect x="20" y="40" width="12" height="12" class="mom" /><text x="38" y="51" class="m"><tspan data-lang-en>Momentum (winners − losers)</tspan><tspan data-lang-vi>Momentum (mã thắng − mã thua)</tspan></text>
    <rect x="300" y="40" width="12" height="12" class="mk" /><text x="318" y="51" class="m"><tspan data-lang-en>Market excess return</tspan><tspan data-lang-vi>Lợi nhuận vượt trội thị trường</tspan></text>
  </svg>
</div>
<style>
  .q6b svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .q6b text { font-size: 13px; fill: var(--text-body); }
  .q6b .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q6b .m { fill: var(--text-muted); font-size: 12px; }
  .q6b .n { fill: var(--text); font-weight: 600; font-size: 12.5px; }
  .q6b .z { stroke: var(--text-faint); stroke-width: 1.2; }
  .q6b .mom { fill: var(--red); }
  .q6b .mk { fill: var(--gold); }
</style>
