---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for distributed-system-failures set 06:
// A shard leader checks a 10 s lease at t = 8 s, then freezes for 15 s (GC + swap thrashing).
// Meanwhile Leader 2 acquires the lease at t = 10.5 s and writes v2.
// The wake-up time is shown as t = ? so the figure does not reveal the calculated answer (23 s / 13 s).
// Inline SVG, site CSS tokens only, zero hex colors, no marker/defs/ids.

const W = 580;
const H = 356;
const x0 = 146;
const pxPerSec = 19; // 0..12 s -> 146..374
const tx = (s: number) => x0 + s * pxPerSec;
const xCheck = tx(8);     // 298
const xExpiry = tx(10);   // 336
const xL2 = tx(10.5);     // 345.5
const xPreBreak = 424;
const xPostBreak = 444;
const xWake = 444;
const xEnd = 568;

const yLock = 68;
const yLeader1 = 148;
const yStore = 228;
const yAxis = 304;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const writeV2Arrow = arrow(406, yLock + 20, 406, yStore - 20);
const writeV1Arrow = arrow(506, yLeader1 + 20, 506, yStore - 20);
---
<div class="qfig-gpz">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three-lane timeline of a 10 s lease: Leader 1 passes lease.isValid() at t = 8 s, then freezes for 15 s in GC and swap thrashing. At t = 10 s the lease expires; at t = 10.5 s Leader 2 acquires the lease and writes v2. After the 15 s pause, Leader 1 wakes up at t = ? and runs process(request) to send stale write v1.">
    <text x="0" y="22" class="qfig-gpz-h">
      <tspan data-lang-en>A 10 s lease and a 15 s process pause</tspan>
      <tspan data-lang-vi>Lease 10 giây và cú khựng tiến trình 15 giây</tspan>
    </text>

    {/* Expiry vertical guide */}
    <line x1={xExpiry} x2={xExpiry} y1="42" y2={yAxis} class="qfig-gpz-expiry" />

    {/* Lane dividers & labels */}
    {[
      { y: yLock, icon: 'lock', en: 'Lock service', vi: 'Lock service' },
      { y: yLeader1, icon: 'worker', en: 'Leader 1', vi: 'Leader 1' },
      { y: yStore, icon: 'db', en: 'Storage', vi: 'Tầng lưu trữ' },
    ].map((l) => (
      <g>
        <line x1="0" x2={W} y1={l.y + 38} y2={l.y + 38} class="qfig-gpz-rule" />
        <DiagramIcon name={l.icon as any} x={18} y={l.y} size={22} />
        <text x="38" y={l.y + 5} class="qfig-gpz-lane">
          <tspan data-lang-en>{l.en}</tspan>
          <tspan data-lang-vi>{l.vi}</tspan>
        </text>
      </g>
    ))}

    {/* Lane 1: Lock service */}
    <rect x={x0} y={yLock - 18} width={xExpiry - x0} height="36" rx="6" class="qfig-gpz-gold" />
    <text x={(x0 + xExpiry) / 2} y={yLock + 4} text-anchor="middle" class="qfig-gpz-t">
      <tspan data-lang-en>Lease 1 (10 s TTL)</tspan>
      <tspan data-lang-vi>Lease 1 (hạn 10 s)</tspan>
    </text>

    <rect x={xL2} y={yLock - 18} width={xPreBreak - xL2} height="36" rx="6" class="qfig-gpz-gold" />
    <text x={(xL2 + xPreBreak) / 2} y={yLock + 4} text-anchor="middle" class="qfig-gpz-m">10.5 s</text>
    <rect x={xPostBreak} y={yLock - 18} width={xEnd - xPostBreak} height="36" rx="6" class="qfig-gpz-gold" />
    <text x={(xPostBreak + xEnd) / 2} y={yLock + 4} text-anchor="middle" class="qfig-gpz-t">
      <tspan data-lang-en>Leader 2 lease</tspan>
      <tspan data-lang-vi>Lease Leader 2</tspan>
    </text>

    {/* Draw Leader 2 write arrow behind Leader 1's freeze card so it never crosses text */}
    <g class="qfig-gpz-arrow-gold"><path d={writeV2Arrow.line} /><polygon points={writeV2Arrow.head} /></g>

    {/* Lane 2: Leader 1 */}
    <rect x={x0} y={yLeader1 - 18} width={xCheck - x0} height="36" rx="6" class="qfig-gpz-box" />
    <text x={(x0 + xCheck) / 2} y={yLeader1 + 4} text-anchor="middle" class="qfig-gpz-m">
      <tspan data-lang-en>lease.isValid() = true</tspan>
      <tspan data-lang-vi>lease.isValid() = true</tspan>
    </text>
    <circle cx={xCheck} cy={yLeader1} r="5" class="qfig-gpz-dot" />
    <text x={xCheck - 6} y={yLeader1 - 24} text-anchor="end" class="qfig-gpz-m">
      <tspan data-lang-en>checked at 8 s</tspan>
      <tspan data-lang-vi>kiểm tra lúc 8 s</tspan>
    </text>

    {/* Freeze bar up to break */}
    <rect x={xCheck + 5} y={yLeader1 - 21} width={xPreBreak - (xCheck + 5)} height="42" rx="6" class="qfig-gpz-freeze" />
    <text x={(xCheck + 5 + xPreBreak) / 2} y={yLeader1 - 3} text-anchor="middle" class="qfig-gpz-redtxt">
      <tspan data-lang-en>15 s freeze</tspan>
      <tspan data-lang-vi>khựng 15 s</tspan>
    </text>
    <text x={(xCheck + 5 + xPreBreak) / 2} y={yLeader1 + 14} text-anchor="middle" class="qfig-gpz-m">
      <tspan data-lang-en>GC + swap</tspan>
      <tspan data-lang-vi>GC + swap</tspan>
    </text>

    {/* Wake box */}
    <rect x={xWake} y={yLeader1 - 18} width={xEnd - xWake} height="36" rx="6" class="qfig-gpz-hot" />
    <text x={(xWake + xEnd) / 2} y={yLeader1 + 4} text-anchor="middle" class="qfig-gpz-redtxt">
      <tspan data-lang-en>process(req)</tspan>
      <tspan data-lang-vi>process(req)</tspan>
    </text>

    {/* Lane 3: Storage */}
    <rect x={xL2} y={yStore - 18} width={xPreBreak - xL2} height="36" rx="6" class="qfig-gpz-gold" />
    <text x={(xL2 + xPreBreak) / 2} y={yStore + 4} text-anchor="middle" class="qfig-gpz-t">
      <tspan data-lang-en>writes v2</tspan>
      <tspan data-lang-vi>ghi v2</tspan>
    </text>

    <rect x={xWake} y={yStore - 18} width={xEnd - xWake} height="36" rx="6" class="qfig-gpz-hot" />
    <text x={(xWake + xEnd) / 2} y={yStore + 4} text-anchor="middle" class="qfig-gpz-redtxt">
      <tspan data-lang-en>stale write v1</tspan>
      <tspan data-lang-vi>ghi cũ v1</tspan>
    </text>

    {/* Stale write arrow */}
    <g class="qfig-gpz-arrow-red"><path d={writeV1Arrow.line} /><polygon points={writeV1Arrow.head} /></g>

    {/* Time axis */}
    <line x1={x0} x2={xPreBreak} y1={yAxis} y2={yAxis} class="qfig-gpz-axis" />
    <line x1={xPostBreak} x2={xEnd} y1={yAxis} y2={yAxis} class="qfig-gpz-axis" />
    <path d={`M ${xPreBreak + 4} ${yAxis - 7} L ${xPreBreak + 10} ${yAxis + 7} M ${xPreBreak + 12} ${yAxis - 7} L ${xPreBreak + 18} ${yAxis + 7}`} class="qfig-gpz-break" />

    {[
      { x: x0, label: '0 s' },
      { x: xCheck, label: '8 s' },
      { x: xExpiry, label: '10 s' },
    ].map((t) => (
      <g>
        <line x1={t.x} x2={t.x} y1={yAxis - 5} y2={yAxis + 5} class="qfig-gpz-axis" />
        <text x={t.x} y={yAxis + 21} text-anchor="middle" class="qfig-gpz-m">{t.label}</text>
      </g>
    ))}
    <line x1="506" x2="506" y1={yAxis - 5} y2={yAxis + 5} class="qfig-gpz-axis" />
    <text x="506" y={yAxis + 21} text-anchor="middle" class="qfig-gpz-redtxt">t = ?</text>

    <text x="0" y={yAxis + 21} class="qfig-gpz-m">
      <tspan data-lang-en>Monotonic clock</tspan>
      <tspan data-lang-vi>Đồng hồ monotonic</tspan>
    </text>
    <text x={x0} y={H - 8} class="qfig-gpz-m">
      <tspan data-lang-en>Scale covers 0 to 12 s, then breaks across the 15 s pause.</tspan>
      <tspan data-lang-vi>Tỉ lệ từ 0 đến 12 s, sau đó ngắt qua quãng khựng 15 s.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gpz { margin: 0; width: 100%; }
  .qfig-gpz svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gpz text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gpz .qfig-gpz-h { font-size: 15.5px; font-weight: 700; fill: var(--text); }
  .qfig-gpz .qfig-gpz-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-gpz .qfig-gpz-t { font-weight: 600; fill: var(--text); }
  .qfig-gpz .qfig-gpz-m { font-size: 12.5px; fill: var(--text-muted); }
  .qfig-gpz .qfig-gpz-redtxt { font-weight: 700; fill: var(--red); }
  .qfig-gpz-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-gpz-expiry { stroke: var(--text-muted); stroke-width: 1.3; stroke-dasharray: 4 4; }
  .qfig-gpz-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .qfig-gpz-gold { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-gpz-freeze { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; stroke-dasharray: 4 3; }
  .qfig-gpz-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .qfig-gpz-dot { fill: var(--text); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-gpz-axis { stroke: var(--text-muted); stroke-width: 1.3; }
  .qfig-gpz-break { stroke: var(--text-muted); stroke-width: 1.8; fill: none; }
  .qfig-gpz-arrow-gold path { fill: none; stroke: var(--gold); stroke-width: 2; }
  .qfig-gpz-arrow-gold polygon { fill: var(--gold); }
  .qfig-gpz-arrow-red path { fill: none; stroke: var(--red); stroke-width: 2; }
  .qfig-gpz-arrow-red polygon { fill: var(--red); }
</style>
