---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for batch processing set 02: migrating an HDFS job (20 TB raw, 128 MB blocks, 3x vs 1.5x)
// onto S3 where 10,000 Parquet files move from output/_tmp/ to output/ while Trino scans output/,
// and two retries race to create metadata/v7.json with If-None-Match: *.
// Inline SVG, CSS tokens only, no <marker>/<defs>/ids. Never reveals computed counts or HTTP outcomes.

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const aMove = arrow(158, 82, 240, 82);
const aTrino = arrow(442, 82, 412, 82);
const aR1 = arrow(212, 266, 308, 294);
const aR2 = arrow(212, 350, 308, 322);
---
<div class="qfig-osc">
  <svg viewBox="0 0 580 420" role="img" aria-label="Top: moving 10,000 Parquet objects from output/_tmp/ to output/ on S3 while Trino scans output/, above the HDFS baseline of 20 TB raw, 128 MB blocks, and 3x vs 1.5x storage. Bottom: Retry 1 and Retry 2 race to write metadata/v7.json with If-None-Match: *.">
    <text x="0" y="22" class="qfig-osc-h">
      <tspan data-lang-en>Moving output and committing on S3</tspan>
      <tspan data-lang-vi>Di chuyển đầu ra và commit trên S3</tspan>
    </text>

    <!-- Staging prefix -->
    <rect x="0" y="42" width="156" height="80" rx="7" class="qfig-osc-box" />
    <DiagramIcon name="s3" x={22} y={64} size={22} />
    <text x="40" y="69" class="qfig-osc-t">output/_tmp/</text>
    <text x="12" y="92" class="qfig-osc-m">
      <tspan data-lang-en>10,000 Parquet</tspan>
      <tspan data-lang-vi>10.000 Parquet</tspan>
    </text>
    <text x="12" y="110" class="qfig-osc-m">
      <tspan data-lang-en>staged objects</tspan>
      <tspan data-lang-vi>object tạm</tspan>
    </text>

    <!-- Transfer arrow -->
    <g class="qfig-osc-arr-red"><path d={aMove.line} /><polygon points={aMove.head} /></g>
    <text x="199" y="71" text-anchor="middle" class="qfig-osc-m">
      <tspan data-lang-en>per-key</tspan>
      <tspan data-lang-vi>từng khoá</tspan>
    </text>
    <text x="199" y="102" text-anchor="middle" class="qfig-osc-m">
      <tspan data-lang-en>transfer</tspan>
      <tspan data-lang-vi>một lượt</tspan>
    </text>

    <!-- Target prefix mid-move -->
    <rect x="242" y="42" width="166" height="80" rx="7" class="qfig-osc-hot" />
    <DiagramIcon name="s3" x={264} y={64} size={22} />
    <text x="282" y="69" class="qfig-osc-t">output/</text>
    <text x="254" y="92" class="qfig-osc-m">part-0001..4200</text>
    <text x="254" y="110" class="qfig-osc-bad">
      <tspan data-lang-en>partial mid-job</tspan>
      <tspan data-lang-vi>lộ nửa chừng</tspan>
    </text>

    <!-- Trino reader -->
    <g class="qfig-osc-arr"><path d={aTrino.line} /><polygon points={aTrino.head} /></g>
    <text x="426" y="71" text-anchor="middle" class="qfig-osc-m">list</text>

    <rect x="444" y="42" width="136" height="80" rx="7" class="qfig-osc-box" />
    <DiagramIcon name="search" x={466} y={64} size={22} />
    <text x="484" y="69" class="qfig-osc-t">Trino</text>
    <text x="456" y="92" class="qfig-osc-m">
      <tspan data-lang-en>prefix scan</tspan>
      <tspan data-lang-vi>quét tiền tố</tspan>
    </text>
    <text x="456" y="110" class="qfig-osc-m">
      <tspan data-lang-en>reads output/</tspan>
      <tspan data-lang-vi>đọc output/</tspan>
    </text>

    <!-- HDFS baseline strip -->
    <rect x="0" y="136" width="580" height="40" rx="6" class="qfig-osc-box" />
    <DiagramIcon name="hadoop" x={22} y={156} size={22} />
    <text x="40" y="161" class="qfig-osc-m">
      <tspan data-lang-en>HDFS baseline: 20 TB raw, 128 MB blocks, 3x replication vs. 1.5x erasure coding</tspan>
      <tspan data-lang-vi>Nền HDFS cũ: 20 TB thô, block 128 MB, nhân 3 bản vs. erasure coding 1,5x</tspan>
    </text>

    <line x1="0" x2="580" y1="192" y2="192" class="qfig-osc-rule" />

    <!-- Conditional write race -->
    <text x="0" y="216" class="qfig-osc-lane">
      <tspan data-lang-en>Two retries race on metadata/v7.json</tspan>
      <tspan data-lang-vi>Hai lần chạy lại cùng đua trên metadata/v7.json</tspan>
    </text>

    <rect x="0" y="232" width="210" height="68" rx="7" class="qfig-osc-box" />
    <DiagramIcon name="worker" x={22} y={266} size={22} />
    <text x="42" y="253" class="qfig-osc-t">
      <tspan data-lang-en>Retry 1</tspan>
      <tspan data-lang-vi>Lần chạy lại 1</tspan>
    </text>
    <text x="42" y="271" class="qfig-osc-m">PUT metadata/v7.json</text>
    <text x="42" y="289" class="qfig-osc-m">If-None-Match: *</text>

    <rect x="0" y="316" width="210" height="68" rx="7" class="qfig-osc-box" />
    <DiagramIcon name="worker" x={22} y={350} size={22} />
    <text x="42" y="337" class="qfig-osc-t">
      <tspan data-lang-en>Retry 2</tspan>
      <tspan data-lang-vi>Lần chạy lại 2</tspan>
    </text>
    <text x="42" y="355" class="qfig-osc-m">PUT metadata/v7.json</text>
    <text x="42" y="373" class="qfig-osc-m">If-None-Match: *</text>

    <g class="qfig-osc-arr-gold"><path d={aR1.line} /><polygon points={aR1.head} /></g>
    <text x="258" y="268" text-anchor="middle" class="qfig-osc-m">
      <tspan data-lang-en>1st</tspan>
      <tspan data-lang-vi>trước</tspan>
    </text>

    <g class="qfig-osc-arr"><path d={aR2.line} /><polygon points={aR2.head} /></g>
    <text x="258" y="355" text-anchor="middle" class="qfig-osc-m">
      <tspan data-lang-en>2nd</tspan>
      <tspan data-lang-vi>sau</tspan>
    </text>

    <rect x="312" y="268" width="268" height="80" rx="8" class="qfig-osc-safe" />
    <DiagramIcon name="s3" x={336} y={308} size={26} />
    <text x="358" y="294" class="qfig-osc-t">S3: metadata/v7.json</text>
    <text x="358" y="314" class="qfig-osc-m">
      <tspan data-lang-en>Create only if key is absent</tspan>
      <tspan data-lang-vi>Chỉ tạo nếu khoá chưa có</tspan>
    </text>
    <text x="358" y="334" class="qfig-osc-m">
      <tspan data-lang-en>Absent before Retry 1</tspan>
      <tspan data-lang-vi>Chưa tồn tại trước lần 1</tspan>
    </text>

    <text x="0" y="408" class="qfig-osc-m">
      <tspan data-lang-en>Both retries run after a transient timeout and try to publish the same v7 key.</tspan>
      <tspan data-lang-vi>Cả hai lần chạy lại đều chạy sau timeout tạm thời và cùng ghi vào khoá v7.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-osc { margin: 0; width: 100%; }
  .qfig-osc svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-osc text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-osc .qfig-osc-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-osc .qfig-osc-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-osc .qfig-osc-t { font-weight: 700; fill: var(--text); }
  .qfig-osc .qfig-osc-m { fill: var(--text-muted); }
  .qfig-osc .qfig-osc-bad { fill: var(--red); font-weight: 600; }
  .qfig-osc-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .qfig-osc-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-osc-safe { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .qfig-osc-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-osc-arr path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-osc-arr polygon { fill: var(--text-muted); }
  .qfig-osc-arr-red path { fill: none; stroke: var(--red); stroke-width: 1.6; }
  .qfig-osc-arr-red polygon { fill: var(--red); }
  .qfig-osc-arr-gold path { fill: none; stroke: var(--gold-icon); stroke-width: 1.6; }
  .qfig-osc-arr-gold polygon { fill: var(--gold-icon); }
</style>
