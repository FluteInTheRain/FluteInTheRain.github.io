---
// Set 05: forest rank IC by depth (simulated panel, numpy seed 80, train 80 months, test 40).
const rows = [
  { en: 'Depth 1', vi: 'Độ sâu 1', a: 0.100, b: 0.041 },
  { en: 'Depth 4', vi: 'Độ sâu 4', a: 0.152, b: 0.055 },
  { en: 'Depth 8', vi: 'Độ sâu 8', a: 0.262, b: 0.062 },
  { en: 'No limit', vi: 'Không giới hạn', a: 0.393, b: 0.057 },
];
const Y0 = 62, RH = 34;
---
<div class="aq3">
  <svg viewBox="0 0 580 230" aria-hidden="true">
    <text x="10" y="22" class="h">
      <tspan data-lang-en>Forest of 100 trees: rank IC by depth</tspan>
      <tspan data-lang-vi>Forest 100 cây: rank IC theo độ sâu</tspan>
    </text>
    <text x="250" y="48" text-anchor="end" class="m">
      <tspan data-lang-en>training months</tspan>
      <tspan data-lang-vi>tháng train</tspan>
    </text>
    <text x="410" y="48" text-anchor="end" class="m">
      <tspan data-lang-en>unseen months</tspan>
      <tspan data-lang-vi>tháng chưa thấy</tspan>
    </text>
    {rows.map((r, i) => {
      const y = Y0 + i * RH;
      return (
        <g>
          <rect x="10" y={y} width="560" height="28" rx="5" class="row" />
          <text x="22" y={y + 19} class="v">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          <text x="250" y={y + 19} text-anchor="end">{r.a.toFixed(3)}</text>
          <text x="410" y={y + 19} text-anchor="end">{r.b.toFixed(3)}</text>
        </g>
      );
    })}
  </svg>
</div>

<style>
  .aq3 { margin: 0; width: 100%; }
  .aq3 svg { display: block; width: 100%; height: auto; }
  .aq3 text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .aq3 .h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .aq3 .m { font-size: 12px; fill: var(--text-muted); }
  .aq3 .v { font-weight: 700; fill: var(--text); }
  .aq3 .row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.1; }
</style>
