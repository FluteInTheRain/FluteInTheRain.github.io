---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for trade-offs set 05: the load curve of a product (a launch spike, then steady load)
// above three steps of where its servers live. Numbers are the ones printed in the post for 37signals.
// The curve is a shape, not to scale. It shows no saving and no payback time.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const base = 168; // chart baseline
const forecastY = 142;
const curve = `M 60 ${base - 8} L 96 ${base - 8} L 124 62 L 168 112 L 214 112 L 560 112`;
const cardY = 232;
const cardW = 580;
const cardH = 66;
const gap = 14;
const cards = [
  {
    icon: 'cloud',
    tone: 'gold',
    title: { en: 'Launch: rent', vi: 'Ra mắt: đi thuê' },
    lines: [
      { en: 'Cloud: no servers to buy', vi: 'Cloud: khỏi mua server' },
      { en: 'Capacity is there when sign-ups arrive', vi: 'Có sẵn dung lượng khi người đăng ký ùa tới' },
    ],
  },
  {
    icon: 'rds',
    tone: 'red',
    title: { en: '2022: still renting', vi: '2022: vẫn đi thuê' },
    lines: [
      { en: 'Managed databases and search', vi: 'Database và search quản lý sẵn' },
      { en: 'Over $0.5M a year for those two alone', vi: 'Riêng hai thứ đó đã hơn 0,5 triệu USD/năm' },
    ],
  },
  {
    icon: 'server',
    tone: 'gold',
    title: { en: 'Then: own', vi: 'Sau đó: tự sở hữu' },
    lines: [
      { en: 'About $700,000 of servers, same team', vi: 'Khoảng 700.000 USD máy chủ, vẫn team cũ' },
      { en: 'Yearly bill: $3.2M before, $1.3M after', vi: 'Hóa đơn mỗi năm: 3,2 triệu trước, 1,3 triệu sau' },
    ],
  },
];
const cy = (i: number) => cardY + i * (cardH + gap);
---
<div class="qfig-ros">
  <svg viewBox="0 0 580 466" role="img" aria-label="A load curve with a sharp launch spike that settles into steady load, above three steps: rent the cloud at launch, still renting managed databases and search in 2022, then own about $700,000 of servers.">
    <text x="0" y="22" class="qfig-ros-h">
      <tspan data-lang-en>Load over time, and where the servers live</tspan>
      <tspan data-lang-vi>Tải theo thời gian, và server nằm ở đâu</tspan>
    </text>

    <!-- load chart -->
    <line x1="60" x2="560" y1={base} y2={base} class="qfig-ros-axis" />
    <line x1="60" x2="60" y1="44" y2={base} class="qfig-ros-axis" />
    <line x1="60" x2="560" y1={forecastY} y2={forecastY} class="qfig-ros-forecast" />
    <path d={curve} class="qfig-ros-curve" />
    <circle cx="124" cy="62" r="6" class="qfig-ros-peak" />
    <text x="136" y="58" class="qfig-ros-t qfig-ros-warn">
      <tspan data-lang-en>Launch: 300,000 sign-ups in 3 weeks</tspan>
      <tspan data-lang-vi>Ra mắt: 300.000 đăng ký trong 3 tuần</tspan>
    </text>
    <text x="560" y={forecastY + 17} text-anchor="end" class="qfig-ros-m">
      <tspan data-lang-en>Forecast: 30,000 in 6 months</tspan>
      <tspan data-lang-vi>Dự báo: 30.000 trong 6 tháng</tspan>
    </text>
    <text x="560" y="103" text-anchor="end" class="qfig-ros-t">
      <tspan data-lang-en>2022: steady load</tspan>
      <tspan data-lang-vi>2022: tải đều</tspan>
    </text>
    <text x="52" y="58" text-anchor="end" class="qfig-ros-m">
      <tspan data-lang-en>Load</tspan>
      <tspan data-lang-vi>Tải</tspan>
    </text>
    <text x="560" y={base + 18} text-anchor="end" class="qfig-ros-m">
      <tspan data-lang-en>Time (shape only, not to scale)</tspan>
      <tspan data-lang-vi>Thời gian (chỉ là hình dạng, không theo tỉ lệ)</tspan>
    </text>

    <!-- three steps -->
    {cards.map((c, i) => (
      <g>
        <rect x="1" y={cy(i)} width={cardW - 2} height={cardH} rx="8" class={`qfig-ros-card qfig-ros-${c.tone}`} />
        <DiagramIcon name={c.icon as any} x="30" y={cy(i) + cardH / 2} size={30} />
        <text x="62" y={cy(i) + 24} class="qfig-ros-title">
          <tspan data-lang-en>{c.title.en}</tspan>
          <tspan data-lang-vi>{c.title.vi}</tspan>
        </text>
        {c.lines.map((l, j) => (
          <text x="62" y={cy(i) + 42 + j * 17} class="qfig-ros-t">
            <tspan data-lang-en>{l.en}</tspan>
            <tspan data-lang-vi>{l.vi}</tspan>
          </text>
        ))}
        {i < 2 && <polygon points={`${cardW / 2 - 7},${cy(i) + cardH + 3} ${cardW / 2 + 7},${cy(i) + cardH + 3} ${cardW / 2},${cy(i) + cardH + gap - 3}`} class="qfig-ros-arrowhead" />}
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-ros { margin: 0; width: 100%; }
  .qfig-ros svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-ros text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-ros .qfig-ros-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-ros .qfig-ros-title { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-ros .qfig-ros-t { font-weight: 600; fill: var(--text); }
  .qfig-ros .qfig-ros-m { fill: var(--text-muted); }
  .qfig-ros .qfig-ros-warn { fill: var(--red); }
  .qfig-ros-axis { stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-ros-forecast { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .qfig-ros-curve { stroke: var(--text); stroke-width: 2.5; fill: none; stroke-linejoin: round; }
  .qfig-ros-peak { fill: var(--red); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-ros-card { stroke-width: 1.5; }
  .qfig-ros-gold { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .qfig-ros-red { fill: var(--red-tint-bg); stroke: var(--red); }
    .qfig-ros-arrowhead { fill: var(--text-muted); }
</style>
