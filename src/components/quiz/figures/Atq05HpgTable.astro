---
// Quiz figure, set 05: the HPG results table as reported in the 51Labs post (22 Jun 2025).
const rows = [
  ['Total return', 'Tổng lợi nhuận', '656.45%', '852.83%', '1000.08%'],
  ['Annualised volatility', 'Biến động hằng năm', '33.91%', '29.95%', '29.14%'],
  ['Sharpe ratio', 'Sharpe', '0.82', '0.97', '1.04'],
  ['Worst drawdown', 'Drawdown tệ nhất', '−71.62%', '−41.70%', '−41.70%'],
];
const col = [220, 330, 430, 540];
---
<div class="qfig-atq05h">
  <svg viewBox="0 0 580 262" role="img" aria-label="A table for the stock HPG as reported by 51Labs. Columns: buy and hold, momentum, momentum with graph warning. Total return 656.45, 852.83 and 1000.08 percent. Annualised volatility 33.91, 29.95 and 29.14 percent. Sharpe 0.82, 0.97 and 1.04. Worst drawdown minus 71.62, minus 41.70 and minus 41.70 percent.">
    <text x="0" y="20" class="h">
      <tspan data-lang-en>HPG, as reported by 51Labs</tspan>
      <tspan data-lang-vi>HPG, theo báo cáo của 51Labs</tspan>
    </text>
    <text x={col[1]} y="54" text-anchor="end" class="m">
      <tspan data-lang-en>Buy and hold</tspan>
      <tspan data-lang-vi>Cứ giữ</tspan>
    </text>
    <text x={col[2]} y="54" text-anchor="end" class="m">
      <tspan data-lang-en>Momentum</tspan>
      <tspan data-lang-vi>Momentum</tspan>
    </text>
    <text x={col[3]} y="54" text-anchor="end" class="m">
      <tspan data-lang-en>+ graph warning</tspan>
      <tspan data-lang-vi>+ cảnh báo đồ thị</tspan>
    </text>
    {rows.map((r, k) => (
      <g>
        <line x1="0" y1={66 + k * 46} x2="580" y2={66 + k * 46} class="rule" />
        <text x="0" y={96 + k * 46} class="l">
          <tspan data-lang-en>{r[0]}</tspan>
          <tspan data-lang-vi>{r[1]}</tspan>
        </text>
        <text x={col[1]} y={96 + k * 46} text-anchor="end" class="v">{r[2]}</text>
        <text x={col[2]} y={96 + k * 46} text-anchor="end" class="v">{r[3]}</text>
        <text x={col[3]} y={96 + k * 46} text-anchor="end" class="v">{r[4]}</text>
      </g>
    ))}
    <line x1="0" y1="250" x2="580" y2="250" class="rule" />
  </svg>
</div>
<style>
  .qfig-atq05h { margin: 0; width: 100%; }
  .qfig-atq05h svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-atq05h text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-atq05h .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-atq05h .m { font-size: 12.5px; font-weight: 600; fill: var(--text-muted); }
  .qfig-atq05h .l { font-weight: 600; fill: var(--text); font-size: 13px; }
  .qfig-atq05h .v { font-weight: 700; fill: var(--text); }
  .qfig-atq05h .rule { stroke: var(--border); stroke-width: 1.2; }
</style>
