---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 05 (transactions): four engines, the isolation level name each one is configured with,
// and an unknown ("?") for each of three problems. Shows the question, never an answer.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 356;
const rowH = 38;
const cols = [
  { x: 372, en: 'Read skew', vi: 'Read skew' },
  { x: 450, en: 'Lost update', vi: 'Lost update' },
  { x: 528, en: 'Write skew', vi: 'Write skew' },
];
const groups = [
  {
    y: 112,
    en: 'Service A, orders: PostgreSQL, then MySQL',
    vi: 'Service A, đơn hàng: PostgreSQL, rồi MySQL',
    rows: [
      { icon: 'postgres', name: 'PostgreSQL', level: 'REPEATABLE READ' },
      { icon: 'mysql', name: 'MySQL (InnoDB)', level: 'REPEATABLE READ' },
    ],
  },
  {
    y: 226,
    en: 'Service B, ledger: Oracle, then Db2',
    vi: 'Service B, sổ cái: Oracle, rồi Db2',
    rows: [
      { icon: 'db', name: 'Oracle', level: 'SERIALIZABLE' },
      { icon: 'db', name: 'Db2', level: 'REPEATABLE READ' },
    ],
  },
];
---
<div class="lm">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A matrix of four engines with their isolation level names: PostgreSQL then MySQL for orders, Oracle then Db2 for the ledger, with a question mark for each of three problems.">
    <text x="10" y="24" class="lm-h">
      <tspan data-lang-en>Same level names, but what do they allow?</tspan>
      <tspan data-lang-vi>Cùng tên mức, nhưng chúng cho phép gì?</tspan>
    </text>

    <rect x="10" y="38" width="560" height="38" rx="8" class="lm-bubble" />
    <DiagramIcon name="model" x={34} y={57} size={22} />
    <text x="58" y="62" class="lm-say">
      <tspan data-lang-en>AI: “Keep the level names. Same name, same guarantees.”</tspan>
      <tspan data-lang-vi>AI: “Giữ tên mức. Cùng tên thì cùng bảo đảm.”</tspan>
    </text>

    {cols.map((c) => (
      <text x={c.x} y="104" text-anchor="middle" class="lm-col">
        <tspan data-lang-en>{c.en}</tspan>
        <tspan data-lang-vi>{c.vi}</tspan>
      </text>
    ))}

    {groups.map((g) => (
      <g>
        <text x="10" y={g.y - 8} class="lm-group">
          <tspan data-lang-en>{g.en}</tspan>
          <tspan data-lang-vi>{g.vi}</tspan>
        </text>
        {g.rows.map((r, i) => {
          const y = g.y + i * (rowH + 8);
          const cy = y + rowH / 2;
          return (
            <g>
              <rect x="10" y={y} width="560" height={rowH} rx="8" class="lm-row" />
              <DiagramIcon name={r.icon} x={34} y={cy} size={22} />
              <text x="58" y={cy + 5} class="lm-name">{r.name}</text>
              <rect x="178" y={cy - 13} width="140" height="26" rx="13" class="lm-chip" />
              <text x="248" y={cy + 5} text-anchor="middle" class="lm-level">{r.level}</text>
              {cols.map((c) => (
                <g>
                  <circle cx={c.x} cy={cy} r="12" class="lm-cell" />
                  <text x={c.x} y={cy + 5} text-anchor="middle" class="lm-q">?</text>
                </g>
              ))}
            </g>
          );
        })}
        <polygon points={`28,${g.y + rowH} 40,${g.y + rowH} 34,${g.y + rowH + 8}`} class="lm-down" />
      </g>
    ))}

    <text x="10" y="340" class="lm-note">
      <tspan data-lang-en>? = not checked yet on this engine</tspan>
      <tspan data-lang-vi>? = chưa kiểm tra trên engine này</tspan>
    </text>
  </svg>
</div>

<style>
  .lm { width: 100%; }
  .lm svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .lm text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .lm .lm-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .lm .lm-say { fill: var(--text); }
  .lm .lm-col { font-size: 13px; fill: var(--text-muted); }
  .lm .lm-group { font-weight: 700; fill: var(--text); }
  .lm .lm-name { font-weight: 700; fill: var(--text); }
  .lm .lm-level { font-size: 13px; font-weight: 700; fill: var(--text); }
  .lm .lm-q { font-size: 15px; font-weight: 700; fill: var(--text-muted); }
  .lm .lm-note { font-size: 13px; fill: var(--text-muted); }
  .lm-bubble { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .lm-row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .lm-chip { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .lm-cell { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 3 3; }
  .lm-down { fill: var(--text-muted); }
</style>
