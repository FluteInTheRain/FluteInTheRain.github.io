---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 04: the hedge that died. Top row: the usual pattern in the training data —
// bonds rise when stocks fall. Bottom row: 2022 — both fall together; the 60/40
// portfolio lost 17.5%, its worst year since 1937 (Morningstar / Hulbert).
// Arrow lengths are schematic, not data.
---
<div class="qsb">
  <svg viewBox="0 0 580 402" role="img" aria-hidden="true">
    <DiagramIcon name="warning" x={22} y={20} size={22} />
    <text x="44" y="25" class="qsb-h">
      <tspan data-lang-en>The assumption inside the training data</tspan>
      <tspan data-lang-vi>Giả định nằm bên trong dữ liệu huấn luyện</tspan>
    </text>

    <g class="qsb-panel">
      <rect x="20" y="46" width="540" height="140" rx="10" />
      <text x="36" y="74" class="qsb-strong">
        <tspan data-lang-en>Most years — the hedge works</tspan>
        <tspan data-lang-vi>Đa số năm — nền tảng phòng thủ hoạt động</tspan>
      </text>
      <polygon points="150,120 142,148 158,148" class="qsb-stock" />
      <rect x="143" y="148" width="14" height="22" class="qsb-stock" />
      <text x="150" y="192" text-anchor="middle" class="qsb-label">
        <tspan data-lang-en>stocks fall</tspan>
        <tspan data-lang-vi>cổ phiếu rơi</tspan>
      </text>
      <text x="290" y="146" text-anchor="middle" class="qsb-muted">
        <tspan data-lang-en>while</tspan>
        <tspan data-lang-vi>trong khi</tspan>
      </text>
      <rect x="423" y="106" width="14" height="24" class="qsb-bond" />
      <polygon points="430,94 422,106 438,106" class="qsb-bond" />
      <text x="430" y="192" text-anchor="middle" class="qsb-label">
        <tspan data-lang-en>bonds rise</tspan>
        <tspan data-lang-vi>trái phiếu tăng</tspan>
      </text>
      <text x="36" y="166" class="qsb-good">
        <tspan data-lang-en>the 40% cushions the 60%</tspan>
        <tspan data-lang-vi>40% đệm cho 60%</tspan>
      </text>
    </g>

    <g class="qsb-panel">
      <rect x="20" y="202" width="540" height="140" rx="10" />
      <text x="36" y="230" class="qsb-strong">
        <tspan data-lang-en>2022 — the inflation shock: both fall together</tspan>
        <tspan data-lang-vi>2022 — cú sốc lạm phát: cả hai rơi cùng nhau</tspan>
      </text>
      <polygon points="150,258 142,286 158,286" class="qsb-stock" />
      <rect x="143" y="286" width="14" height="22" class="qsb-stock" />
      <text x="150" y="330" text-anchor="middle" class="qsb-label">
        <tspan data-lang-en>stocks fall</tspan>
        <tspan data-lang-vi>cổ phiếu rơi</tspan>
      </text>
      <text x="290" y="302" text-anchor="middle" class="qsb-muted">
        <tspan data-lang-en>and</tspan>
        <tspan data-lang-vi>và</tspan>
      </text>
      <polygon points="430,258 422,286 438,286" class="qsb-bond" />
      <rect x="423" y="286" width="14" height="22" class="qsb-bond" />
      <text x="430" y="330" text-anchor="middle" class="qsb-label">
        <tspan data-lang-en>bonds fall too</tspan>
        <tspan data-lang-vi>trái phiếu cũng rơi</tspan>
      </text>
      <text x="36" y="270" class="qsb-bad">
        <tspan data-lang-en>nothing cushions anything</tspan>
        <tspan data-lang-vi>không còn gì đệm cho ai</tspan>
      </text>
    </g>

    <rect x="20" y="356" width="540" height="34" rx="10" class="qsb-note" />
    <text x="36" y="378" class="qsb-bad">
      <tspan data-lang-en>The 60/40 portfolio fell 17.5% in 2022 — its worst year since 1937.</tspan>
      <tspan data-lang-vi>Danh mục 60/40 giảm 17,5% năm 2022 — năm tệ nhất của nó từ 1937.</tspan>
    </text>
  </svg>
</div>

<style>
  .qsb {
    margin: 0;
    width: 100%;
  }
  .qsb svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qsb text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qsb .qsb-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qsb .qsb-strong {
    font-size: 14.5px;
    font-weight: 600;
    fill: var(--text);
  }
  .qsb .qsb-label,
  .qsb .qsb-muted {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qsb-panel rect {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .qsb-stock,
  .qsb-stock polygon,
  .qsb-stock rect {
    fill: var(--red);
  }
  .qsb-bond,
  .qsb-bond polygon,
  .qsb-bond rect {
    fill: var(--act-2);
  }
  .qsb .qsb-good {
    fill: var(--act-2);
    font-weight: 700;
  }
  .qsb .qsb-bad {
    fill: var(--red);
    font-weight: 700;
  }
  .qsb-note {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
</style>
