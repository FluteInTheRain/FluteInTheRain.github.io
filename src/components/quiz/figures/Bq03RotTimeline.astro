---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-validation-schemas set 02: a bad priority is accepted on Monday 09:12 and only shows up
// as a crash in the nightly digest job on Wednesday 02:00. Shows the situation, not what the fix is.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const x0 = 20;
const px = 130; // pixels per day
const tx = (d: number) => x0 + d * px; // d in days since Monday 00:00
const startX = tx(0.38); // Monday 09:12
const endX = tx(2.083); // Wednesday 02:00
const days = [
  { d: 0, en: 'Mon', vi: 'T2' },
  { d: 1, en: 'Tue', vi: 'T3' },
  { d: 2, en: 'Wed', vi: 'T4' },
  { d: 3, en: 'Thu', vi: 'T5' },
];
const axisY = 214;
---
<div class="qfig-rot">
  <svg viewBox="0 0 580 250" role="img" aria-label="A timeline from Monday to Thursday: a request with priority 9 is answered 200 on Monday at 09:12, the bad row sits in the table through Tuesday, and the nightly digest job crashes on Wednesday at 02:00.">
    <text x="0" y="22" class="qfig-rot-h">
      <tspan data-lang-en>One bad value, two days apart</tspan>
      <tspan data-lang-vi>Một giá trị sai, cách nhau hai ngày</tspan>
    </text>

    <rect x={startX} y="96" width={endX - startX} height="40" rx="8" class="qfig-rot-bar" />
    <text x={(startX + endX) / 2} y="121" text-anchor="middle" class="qfig-rot-t">
      <tspan data-lang-en>The bad row sits in the table</tspan>
      <tspan data-lang-vi>Dòng sai nằm trong bảng</tspan>
    </text>

    <circle cx={startX} cy="116" r="7" class="qfig-rot-dot" />
    <DiagramIcon name="server" x={startX} y="58" size={24} />
    <text x={startX - 14} y="168" class="qfig-rot-t">
      <tspan data-lang-en>Mon 09:12</tspan>
      <tspan data-lang-vi>T2 09:12</tspan>
    </text>
    <text x={startX - 14} y="186" class="qfig-rot-m">
      <tspan data-lang-en>priority 9 → answered 200</tspan>
      <tspan data-lang-vi>priority 9 → trả về 200</tspan>
    </text>

    <circle cx={endX} cy="116" r="7" class="qfig-rot-dot" />
    <DiagramIcon name="worker" x={endX} y="58" size={24} />
    <text x={endX - 8} y="168" class="qfig-rot-bad">
      <tspan data-lang-en>Wed 02:00</tspan>
      <tspan data-lang-vi>T4 02:00</tspan>
    </text>
    <text x={endX - 8} y="186" class="qfig-rot-m">
      <tspan data-lang-en>digest job: KeyError 9</tspan>
      <tspan data-lang-vi>job digest: KeyError 9</tspan>
    </text>

    <line x1={tx(0)} x2={tx(4)} y1={axisY} y2={axisY} class="qfig-rot-axis" />
    {days.map((t) => (
      <g>
        <line x1={tx(t.d)} x2={tx(t.d)} y1={axisY} y2={axisY + 6} class="qfig-rot-axis" />
        <text x={tx(t.d) + 4} y={axisY + 22} class="qfig-rot-m">
          <tspan data-lang-en>{t.en}</tspan>
          <tspan data-lang-vi>{t.vi}</tspan>
        </text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-rot { margin: 0; width: 100%; }
  .qfig-rot svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-rot text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-rot .qfig-rot-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-rot .qfig-rot-t { font-weight: 700; fill: var(--text); }
  .qfig-rot .qfig-rot-m { fill: var(--text-muted); font-size: 13px; }
  .qfig-rot .qfig-rot-bad { font-weight: 700; fill: var(--red); }
  .qfig-rot-bar { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
  .qfig-rot-dot { fill: var(--red); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-rot-axis { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
