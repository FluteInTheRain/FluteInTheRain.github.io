---
// Set 02: a 128,000-token window. 3,000 system prompt + 40,000 tool results + 80,000 filing = 123,000; 5,000 left.
const parts = [
  { v: 3000, cls: 'a' }, { v: 40000, cls: 'b' }, { v: 80000, cls: 'c' }, { v: 5000, cls: 'd' },
];
let acc = 0;
const segs = parts.map((p) => { const x = 20 + (acc / 128000) * 540; const w = (p.v / 128000) * 540; acc += p.v; return { ...p, x, w }; });
---
<div class="q21w">
  <svg viewBox="0 0 580 150" role="img" aria-hidden="true">
    <text x="20" y="24" class="h"><tspan data-lang-en>A 128,000-token window</tspan><tspan data-lang-vi>Cửa sổ 128.000 token</tspan></text>
    {segs.map((s) => <rect x={s.x} y="38" width={s.w} height="34" class={`p ${s.cls}`} />)}
    <text x={segs[2].x + segs[2].w / 2} y="60" text-anchor="middle" class="n"><tspan data-lang-en>filing 80,000</tspan><tspan data-lang-vi>báo cáo 80.000</tspan></text>
    <text x={segs[1].x + segs[1].w / 2} y="60" text-anchor="middle" class="n"><tspan data-lang-en>10 tool results 40,000</tspan><tspan data-lang-vi>10 kết quả tool 40.000</tspan></text>
    <text x="20" y="96" class="m"><tspan data-lang-en>System prompt 3,000 (grey, at the left edge)</tspan><tspan data-lang-vi>System prompt 3.000 (xám, ở mép trái)</tspan></text>
    <text x="560" y="116" text-anchor="end" class="r"><tspan data-lang-en>5,000 tokens left</tspan><tspan data-lang-vi>Còn 5.000 token</tspan></text>
  </svg>
</div>
<style>
  .q21w svg { display: block; width: 100%; height: auto; }
  .q21w text { font-size: 13px; fill: var(--text-body); }
  .q21w .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .q21w .n { font-weight: 700; fill: var(--text); }
  .q21w .m { font-size: 12px; fill: var(--text-muted); }
  .q21w .r { font-weight: 700; fill: var(--red); }
  .q21w .p { stroke: var(--bg); stroke-width: 1.5; }
  .q21w .a { fill: var(--text-faint); }
  .q21w .b { fill: var(--border); }
  .q21w .c { fill: var(--gold-tint-bg); stroke: var(--gold-icon); }
  .q21w .d { fill: var(--red-tint-bg); stroke: var(--red); }
</style>
