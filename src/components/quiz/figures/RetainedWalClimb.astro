---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for trade-offs set 04 (Photoroom): the primary, the slow replica, and two bars on one 0 to 60 TB scale:
// the WAL on the primary (about 5 GB before, 31.7 TB at the incident) and the disk in use (about 43 TB)
// against the 60 TB limit. It states no growth rate and no run-out time. Inline SVG, site tokens only, no ids.
const x0 = 30;
const pxTB = 520 / 60; // 60 TB across 520 px
const tb = (v: number) => x0 + v * pxTB;
const walEnd = tb(31.7);
const usedEnd = tb(43);
const limitX = tb(60);
const blocks = Array.from({ length: 8 }, (_, i) => 112 + i * 22);
function head(x: number, y: number) {
  return `${x},${y} ${x - 12},${y - 6} ${x - 12},${y + 6}`;
}
---
<div class="qfig-wal">
  <svg viewBox="0 0 580 322" role="img" aria-label="A primary Postgres database sends changes to a replica but the replica applies them more slowly, so WAL piles up on the primary. Two bars on a 0 to 60 TB scale show the WAL on the primary growing from about 5 GB to 31.7 TB, and the disk in use at about 43 TB against a 60 TB limit.">
    <DiagramIcon name="postgres" x="46" y="70" size={40} />
    <text x="46" y="112" text-anchor="middle" class="qfig-wal-lane">
      <tspan data-lang-en>Primary</tspan>
      <tspan data-lang-vi>DB chính</tspan>
    </text>
    <DiagramIcon name="postgres" x="534" y="70" size={40} />
    <text x="534" y="112" text-anchor="middle" class="qfig-wal-lane">
      <tspan data-lang-en>Replica</tspan>
      <tspan data-lang-vi>Replica</tspan>
    </text>
    <text x="580" y="130" text-anchor="end" class="qfig-wal-m">
      <tspan data-lang-en>BI and ETL reads</tspan>
      <tspan data-lang-vi>đọc cho BI và ETL</tspan>
    </text>

    <!-- changes flow: wide where the backfill writes, narrow where the replica applies -->
    <polygon points="92,58 472,67 472,73 92,82" class="qfig-wal-flow" />
    <polygon points={head(492, 70)} class="qfig-wal-flow" />
    <text x="96" y="46" class="qfig-wal-t">
      <tspan data-lang-en>Backfill writes fast</tspan>
      <tspan data-lang-vi>Backfill ghi nhanh</tspan>
    </text>
    <text x="476" y="46" text-anchor="end" class="qfig-wal-t">
      <tspan data-lang-en>Replica applies slower</tspan>
      <tspan data-lang-vi>Replica áp dụng chậm hơn</tspan>
    </text>

    {blocks.map((x) => <rect x={x} y="92" width="18" height="16" rx="3" class="qfig-wal-block" />)}
    <text x="112" y="128" class="qfig-wal-bad">
      <tspan data-lang-en>WAL: the primary's log of changes</tspan>
      <tspan data-lang-vi>WAL: log thay đổi của DB chính</tspan>
    </text>

    <line x1="0" x2="580" y1="148" y2="148" class="qfig-wal-rule" />

    <!-- bar A: retained WAL -->
    <text x={x0} y="174" class="qfig-wal-h">
      <tspan data-lang-en>WAL on the primary</tspan>
      <tspan data-lang-vi>WAL trên DB chính</tspan>
    </text>
    <rect x={x0} y="184" width="520" height="22" rx="3" class="qfig-wal-track" />
    <rect x={x0} y="184" width="3" height="22" class="qfig-wal-ok" />
    <rect x={x0} y="184" width={walEnd - x0} height="22" rx="3" class="qfig-wal-red" />
    <rect x={x0} y="184" width="3" height="22" class="qfig-wal-ok" />
    <text x={walEnd + 10} y="200" class="qfig-wal-bad">
      <tspan data-lang-en>At the incident: 31.7 TB</tspan>
      <tspan data-lang-vi>Lúc xảy ra sự cố: 31,7 TB</tspan>
    </text>
    <text x={x0} y="224" class="qfig-wal-m">
      <tspan data-lang-en>Before the backfill: about 5 GB</tspan>
      <tspan data-lang-vi>Trước backfill: khoảng 5 GB</tspan>
    </text>

    <!-- bar B: disk in use -->
    <text x={x0} y="254" class="qfig-wal-h">
      <tspan data-lang-en>Primary disk in use</tspan>
      <tspan data-lang-vi>Đĩa DB chính đang dùng</tspan>
    </text>
    <rect x={x0} y="264" width="520" height="22" rx="3" class="qfig-wal-track" />
    <rect x={x0} y="264" width={usedEnd - x0} height="22" rx="3" class="qfig-wal-other" />
    <rect x={x0} y="264" width={walEnd - x0} height="22" rx="3" class="qfig-wal-red" />
    <line x1={usedEnd} x2={usedEnd} y1="260" y2="294" class="qfig-wal-tick" />
    <line x1={limitX} x2={limitX} y1="256" y2="294" class="qfig-wal-limit" />
    <text x={usedEnd + 4} y="310" text-anchor="end" class="qfig-wal-t">
      <tspan data-lang-en>In use: about 43 TB</tspan>
      <tspan data-lang-vi>Đang dùng: khoảng 43 TB</tspan>
    </text>
    <text x={limitX} y="310" text-anchor="end" class="qfig-wal-bad">
      <tspan data-lang-en>Limit 60 TB</tspan>
      <tspan data-lang-vi>Giới hạn 60 TB</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-wal { margin: 0; width: 100%; }
  .qfig-wal svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-wal text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-wal .qfig-wal-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-wal .qfig-wal-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-wal .qfig-wal-t { font-weight: 600; fill: var(--text); }
  .qfig-wal .qfig-wal-m { fill: var(--text-muted); }
  .qfig-wal .qfig-wal-bad { font-weight: 600; fill: var(--red); }
  .qfig-wal-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-wal-flow { fill: var(--text-muted); }
  .qfig-wal-block { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-wal-track { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-wal-red { fill: var(--red); }
  .qfig-wal-other { fill: var(--text-muted); opacity: 0.4; }
  .qfig-wal-ok { fill: var(--gold); }
  .qfig-wal-tick { stroke: var(--text); stroke-width: 1.5; }
  .qfig-wal-limit { stroke: var(--red); stroke-width: 2.5; }
</style>
