---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 04 (replication): an old server and a new one with a different major version, and changes that must travel across.
// It shows the setting only: no log format is named and nothing says what is or is not copied.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids, so the EN and VI copies cannot clash.

const W = 580;
const H = 330;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 9;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const old = { x: 10, y: 120, w: 210, h: 150 };
const nw = { x: 360, y: 120, w: 210, h: 150 };
const flow = arrow(236, 190, 344, 190);
const appArrow = arrow(115, 78, 115, 114);
---
<div class="qlr">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="An old server on version 12 holds the orders and an ID counter. A new server on version 16 is empty and waits. An arrow between them shows changes that must travel across.">
    <text x="10" y="24" class="qlr-h">
      <tspan data-lang-en>Two servers, two versions</tspan>
      <tspan data-lang-vi>Hai server, hai version</tspan>
    </text>

    <DiagramIcon name="users" x={115} y={56} size={28} />
    <text x="140" y="61" class="qlr-sub">
      <tspan data-lang-en>Shop app</tspan>
      <tspan data-lang-vi>App của shop</tspan>
    </text>
    <g class="qlr-arrow"><path d={appArrow.line} /><polygon points={appArrow.head} /></g>

    <g class="qlr-box"><rect x={old.x} y={old.y} width={old.w} height={old.h} rx="8" /></g>
    <DiagramIcon name="postgres" x={old.x + 28} y={old.y + 28} size={28} />
    <text x={old.x + 54} y={old.y + 26} class="qlr-name">
      <tspan data-lang-en>Old server</tspan>
      <tspan data-lang-vi>Server cũ</tspan>
    </text>
    <text x={old.x + 54} y={old.y + 44} class="qlr-sub">
      <tspan data-lang-en>version 12</tspan>
      <tspan data-lang-vi>version 12</tspan>
    </text>
    <g class="qlr-fill"><rect x={old.x + 16} y={old.y + 66} width="178" height="30" rx="5" /></g>
    <text x={old.x + 28} y={old.y + 86} class="qlr-name">
      <tspan data-lang-en>orders: 400 GB</tspan>
      <tspan data-lang-vi>orders: 400 GB</tspan>
    </text>
    <g class="qlr-fill"><rect x={old.x + 16} y={old.y + 106} width="178" height="30" rx="5" /></g>
    <text x={old.x + 28} y={old.y + 126} class="qlr-name">
      <tspan data-lang-en>order ID counter</tspan>
      <tspan data-lang-vi>bộ đếm ID đơn</tspan>
    </text>

    <g class="qlr-arrow"><path d={flow.line} /><polygon points={flow.head} /></g>
    <text x="290" y="172" text-anchor="middle" class="qlr-sub">
      <tspan data-lang-en>changes</tspan>
      <tspan data-lang-vi>thay đổi</tspan>
    </text>
    <text x="290" y="214" text-anchor="middle" class="qlr-sub">
      <tspan data-lang-en>150 orders/s</tspan>
      <tspan data-lang-vi>150 đơn/giây</tspan>
    </text>

    <g class="qlr-box"><rect x={nw.x} y={nw.y} width={nw.w} height={nw.h} rx="8" /></g>
    <DiagramIcon name="postgres" x={nw.x + 28} y={nw.y + 28} size={28} />
    <text x={nw.x + 54} y={nw.y + 26} class="qlr-name">
      <tspan data-lang-en>New server</tspan>
      <tspan data-lang-vi>Server mới</tspan>
    </text>
    <text x={nw.x + 54} y={nw.y + 44} class="qlr-sub">
      <tspan data-lang-en>version 16</tspan>
      <tspan data-lang-vi>version 16</tspan>
    </text>
    <g class="qlr-empty"><rect x={nw.x + 16} y={nw.y + 66} width="178" height="30" rx="5" /></g>
    <text x={nw.x + 28} y={nw.y + 86} class="qlr-sub">
      <tspan data-lang-en>orders</tspan>
      <tspan data-lang-vi>orders</tspan>
    </text>
    <g class="qlr-empty"><rect x={nw.x + 16} y={nw.y + 106} width="178" height="30" rx="5" /></g>
    <text x={nw.x + 28} y={nw.y + 126} class="qlr-sub">
      <tspan data-lang-en>order ID counter</tspan>
      <tspan data-lang-vi>bộ đếm ID đơn</tspan>
    </text>

    <g class="qlr-limit"><rect x="10" y="288" width="560" height="30" rx="6" /></g>
    <text x="290" y="308" text-anchor="middle" class="qlr-name">
      <tspan data-lang-en>Limit: 30 seconds of downtime</tspan>
      <tspan data-lang-vi>Giới hạn: 30 giây downtime</tspan>
    </text>
  </svg>
</div>

<style>
  .qlr { width: 100%; }
  .qlr svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qlr text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qlr .qlr-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qlr .qlr-name { font-weight: 700; fill: var(--text); }
  .qlr .qlr-sub { fill: var(--text-muted); }
  .qlr-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qlr-fill rect { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .qlr-empty rect { fill: none; stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .qlr-limit rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.2; }
  .qlr-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .qlr-arrow polygon { fill: var(--text-muted); }
</style>
