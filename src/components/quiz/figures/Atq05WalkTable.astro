---
// Quiz figure, set 05: walk-forward result of the filtered rule on simulated market A (demo/ai-trading/p05_regime_trust.py, seed 5).
const rows = [
  ['Worst fall', 'Sụt tệ nhất', '−19.4%', '−24.8%'],
  ['Days in cash', 'Ngày ở tiền mặt', '0%', '44%'],
  ['Crossings of the 50% line', 'Lần cắt đường 50%', '—', '52'],
];
const col = [440, 560];
---
<div class="qfig-atq05w">
  <svg viewBox="0 0 580 216" role="img" aria-label="Walk-forward test on simulated market A. Worst fall: buy and hold minus 19.4 percent, filtered rule minus 24.8 percent. Days in cash: 0 and 44 percent. Crossings of the 50 percent line: none and 52.">
    <text x="0" y="20" class="h">
      <tspan data-lang-en>Test half of market A, 750 days</tspan>
      <tspan data-lang-vi>Nửa kiểm tra của thị trường A, 750 ngày</tspan>
    </text>
    <text x={col[0]} y="54" text-anchor="end" class="m">
      <tspan data-lang-en>Buy and hold</tspan>
      <tspan data-lang-vi>Cứ giữ</tspan>
    </text>
    <text x={col[1]} y="54" text-anchor="end" class="m">
      <tspan data-lang-en>Filtered rule</tspan>
      <tspan data-lang-vi>Luật filtered</tspan>
    </text>
    {rows.map((r, k) => (
      <g>
        <line x1="0" y1={66 + k * 46} x2="580" y2={66 + k * 46} class="rule" />
        <text x="0" y={96 + k * 46} class="l">
          <tspan data-lang-en>{r[0]}</tspan>
          <tspan data-lang-vi>{r[1]}</tspan>
        </text>
        <text x={col[0]} y={96 + k * 46} text-anchor="end" class="v">{r[2]}</text>
        <text x={col[1]} y={96 + k * 46} text-anchor="end" class="v">{r[3]}</text>
      </g>
    ))}
    <line x1="0" y1="204" x2="580" y2="204" class="rule" />
  </svg>
</div>
<style>
  .qfig-atq05w { margin: 0; width: 100%; }
  .qfig-atq05w svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-atq05w text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-atq05w .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-atq05w .m { font-size: 12.5px; font-weight: 600; fill: var(--text-muted); }
  .qfig-atq05w .l { font-weight: 600; fill: var(--text); font-size: 13px; }
  .qfig-atq05w .v { font-weight: 700; fill: var(--text); }
  .qfig-atq05w .rule { stroke: var(--border); stroke-width: 1.2; }
</style>
