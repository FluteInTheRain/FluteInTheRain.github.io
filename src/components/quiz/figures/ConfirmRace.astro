---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for transactions set 06: two confirm requests from two sessions, same prepared 5 USD transfer,
// both reading the card balance and passing the check at the same moment.
// Inline SVG, site tokens only, no <marker>/<defs>. Shows only the scenario's inputs, no results.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 7 * Math.cos(a)} ${y2 - 7 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const cols = [
  { x: 0, n: 1 },
  { x: 350, n: 2 },
];
const w = 230;
const stepY = [124, 190, 256];
const sh = 42;
const down = (cx: number, y1: number, y2: number) => arrow(cx, y1, cx, y2);
const readL = arrow(w + 2, 145, 262, 145);
const readR = arrow(350 - 2, 145, 318, 145);
---
<div class="qfig-conf">
  <svg viewBox="0 0 580 410" role="img" aria-label="Two sessions each send a confirm for the same 5 dollar transfer. Both read the card balance of 5 dollars, both pass the check, and both go on to debit, at the same moment.">
    <text x="0" y="20" class="qfig-conf-h">
      <tspan data-lang-en>Two confirms of one transfer, from two sessions</tspan>
      <tspan data-lang-vi>Hai confirm của một lệnh chuyển, từ hai session</tspan>
    </text>

    {cols.map((c) => {
      const cx = c.x + w / 2;
      const a0 = down(cx, 100, stepY[0] - 2);
      const a1 = down(cx, stepY[0] + sh + 2, stepY[1] - 2);
      const a2 = down(cx, stepY[1] + sh + 2, stepY[2] - 2);
      return (
        <g>
          <g class="qfig-conf-sess">
            <rect x={c.x} y="34" width={w} height="66" rx="8" />
            <DiagramIcon name="laptop" x={c.x + 28} y={67} size={26} />
            <text x={c.x + 54} y="62" class="qfig-conf-t">
              <tspan data-lang-en>Session {c.n}</tspan>
              <tspan data-lang-vi>Session {c.n}</tspan>
            </text>
            <text x={c.x + 54} y="84" class="qfig-conf-m">
              <tspan data-lang-en>Prepared: send 5 USD</tspan>
              <tspan data-lang-vi>Chuẩn bị: chuyển 5 USD</tspan>
            </text>
          </g>
          {[a0, a1, a2].map((a) => (
            <g class="qfig-conf-arr"><path d={a.line} /><polygon points={a.head} /></g>
          ))}
          <g class="qfig-conf-step">
            <rect x={c.x} y={stepY[0]} width={w} height={sh} rx="6" />
            <text x={c.x + 14} y={stepY[0] + 26}>
              <tspan data-lang-en>1. Read balance: 5 USD</tspan>
              <tspan data-lang-vi>1. Đọc số dư: 5 USD</tspan>
            </text>
            <rect x={c.x} y={stepY[1]} width={w} height={sh} rx="6" />
            <text x={c.x + 14} y={stepY[1] + 26}>
              <tspan data-lang-en>2. Check: 5 USD is enough</tspan>
              <tspan data-lang-vi>2. Kiểm tra: 5 USD là đủ</tspan>
            </text>
            <rect x={c.x} y={stepY[2]} width={w} height={sh} rx="6" />
            <text x={c.x + 14} y={stepY[2] + 26}>
              <tspan data-lang-en>3. Debit card A, credit card B</tspan>
              <tspan data-lang-vi>3. Trừ thẻ A, cộng thẻ B</tspan>
            </text>
          </g>
        </g>
      );
    })}

    <g class="qfig-conf-arr"><path d={readL.line} /><polygon points={readL.head} /></g>
    <g class="qfig-conf-arr"><path d={readR.line} /><polygon points={readR.head} /></g>
    <DiagramIcon name="card" x={290} y={142} size={30} />
    <text x="290" y="176" text-anchor="middle" class="qfig-conf-t">
      <tspan data-lang-en>Card A</tspan>
      <tspan data-lang-vi>Thẻ A</tspan>
    </text>
    <text x="290" y="194" text-anchor="middle" class="qfig-conf-m">
      <tspan data-lang-en>5 USD</tspan>
      <tspan data-lang-vi>5 USD</tspan>
    </text>

    <g class="qfig-conf-bad">
      <rect x="0" y="326" width="580" height="42" rx="8" />
      <text x="290" y="352" text-anchor="middle">
        <tspan data-lang-en>Both requests run at the same moment</tspan>
        <tspan data-lang-vi>Hai request chạy cùng một lúc</tspan>
      </text>
    </g>
    <text x="0" y="396" class="qfig-conf-m">
      <tspan data-lang-en>Each column is one request, top to bottom.</tspan>
      <tspan data-lang-vi>Mỗi cột là một request, đọc từ trên xuống.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-conf { margin: 0; width: 100%; }
  .qfig-conf svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-conf text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-conf .qfig-conf-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-conf .qfig-conf-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-conf .qfig-conf-m { fill: var(--text-muted); }
  .qfig-conf-sess rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-conf-step rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-conf-arr path { stroke: var(--text-muted); stroke-width: 1.8; fill: none; }
  .qfig-conf-arr polygon { fill: var(--text-muted); }
  .qfig-conf-bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-conf .qfig-conf-bad text { font-size: 15px; font-weight: 700; fill: var(--red); }
</style>
