---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for consensus set 06: a 5-node cluster (N1..N5, quorum 3) contrasting an earlier
// ticket/wait-for-all election attempt (which freezes on one silent peer) with Raft across
// a Term 4 partition ({N1, N2} vs {N3, N4, N5}) and post-heal replication of entry #42 via {N2, N3, N4}.
// Plain inline SVG, site tokens only, no SVG markers, defs, or ids.

const W = 580;
const H = 454;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const preNodes = ['N1', 'N2', 'N3', 'N4', 'N5'];
const healXs = [10, 126, 242, 358, 474]; // each w=96 -> 474+96=570
const staleArrow = arrow(106, 356, 124, 356);
const repLeft = arrow(242, 350, 224, 350);
const repRight = arrow(338, 350, 356, 350);
---
<div class="qfig-rte">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: an earlier ticket-counter or wait-for-all election across N1 to N5 freezes when N5 stalls. Middle: during a Term 4 partition, minority {N1, N2} cannot reach quorum 3 while majority {N3, N4, N5} elects N3 in Term 5. Bottom: after the partition heals, N3 replicates entry #42 through {N2, N3, N4} while N1 sends a stale Term 4 append.">
    <text x="10" y="22" class="qfig-rte-h">
      <tspan data-lang-en>Five-node cluster: ticket stall vs. Raft terms</tspan>
      <tspan data-lang-vi>Cụm 5 node: kẹt phát vé so với các nhiệm kỳ Raft</tspan>
    </text>

    <!-- Band 1: Before Raft -->
    <text x="10" y="48" class="qfig-rte-sec">
      <tspan data-lang-en>Before Raft: fetch-and-add (0 wins) or wait-for-all</tspan>
      <tspan data-lang-vi>Trước Raft: fetch-and-add (0 thắng) hoặc chờ cả 5</tspan>
    </text>
    {preNodes.map((n, i) => {
      const x = 10 + i * 70;
      const dead = n === 'N5';
      return (
        <g>
          <rect x={x} y="60" width="60" height="36" rx="6" class={dead ? 'qfig-rte-box is-bad' : 'qfig-rte-box'} />
          <text x={x + 30} y="83" text-anchor="middle" class={dead ? 'qfig-rte-n is-bad' : 'qfig-rte-n'}>{n}</text>
          {dead && (
            <text x={x + 30} y="112" text-anchor="middle" class="qfig-rte-bad-sm">
              <tspan data-lang-en>stalled</tspan>
              <tspan data-lang-vi>treo</tspan>
            </text>
          )}
        </g>
      );
    })}
    <rect x="370" y="56" width="200" height="44" rx="8" class="qfig-rte-box is-bad" />
    <DiagramIcon name="warning" x={392} y={78} size={20} />
    <text x="410" y="75" class="qfig-rte-bad">
      <tspan data-lang-en>One silent peer</tspan>
      <tspan data-lang-vi>Một node im lặng</tspan>
    </text>
    <text x="410" y="93" class="qfig-rte-bad">
      <tspan data-lang-en>freezes election</tspan>
      <tspan data-lang-vi>làm treo bầu cử</tspan>
    </text>

    <!-- Divider -->
    <line x1="10" x2="570" y1="126" y2="126" class="qfig-rte-rule" />

    <!-- Band 2: Partition during Term 4 -->
    <text x="10" y="150" class="qfig-rte-sec">
      <tspan data-lang-en>1. Partition in Term 4 (quorum = 3 of 5)</tspan>
      <tspan data-lang-vi>1. Chia cắt mạng ở kỳ 4 (quorum = 3 trên 5)</tspan>
    </text>

    <!-- Minority zone -->
    <rect x="10" y="162" width="196" height="106" rx="8" class="qfig-rte-zone is-bad" />
    <text x="22" y="182" class="qfig-rte-bad-sm">
      <tspan data-lang-en>Minority {`{N1, N2}`}</tspan>
      <tspan data-lang-vi>Thiểu số {`{N1, N2}`}</tspan>
    </text>
    <rect x="22" y="192" width="80" height="44" rx="6" class="qfig-rte-box is-bad" />
    <text x="62" y="211" text-anchor="middle" class="qfig-rte-n is-bad">N1</text>
    <text x="62" y="228" text-anchor="middle" class="qfig-rte-sm">
      <tspan data-lang-en>Leader T4</tspan>
      <tspan data-lang-vi>Leader K4</tspan>
    </text>
    <rect x="114" y="192" width="80" height="44" rx="6" class="qfig-rte-box" />
    <text x="154" y="211" text-anchor="middle" class="qfig-rte-n">N2</text>
    <text x="154" y="228" text-anchor="middle" class="qfig-rte-sm">
      <tspan data-lang-en>Term 4</tspan>
      <tspan data-lang-vi>Kỳ 4</tspan>
    </text>
    <text x="22" y="256" class="qfig-rte-bad-sm">
      <tspan data-lang-en>2/5: below quorum 3</tspan>
      <tspan data-lang-vi>2/5: chưa đủ quorum 3</tspan>
    </text>

    <!-- Partition cut -->
    <line x1="224" x2="224" y1="160" y2="270" class="qfig-rte-cut" />

    <!-- Majority zone -->
    <rect x="242" y="162" width="328" height="106" rx="8" class="qfig-rte-zone is-gold" />
    <text x="254" y="182" class="qfig-rte-t">
      <tspan data-lang-en>Majority {`{N3, N4, N5}`}</tspan>
      <tspan data-lang-vi>Đa số {`{N3, N4, N5}`}</tspan>
    </text>
    <rect x="254" y="192" width="94" height="44" rx="6" class="qfig-rte-box is-gold" />
    <text x="301" y="211" text-anchor="middle" class="qfig-rte-n">N3</text>
    <text x="301" y="228" text-anchor="middle" class="qfig-rte-sm">
      <tspan data-lang-en>Leader T5</tspan>
      <tspan data-lang-vi>Leader K5</tspan>
    </text>
    <rect x="358" y="192" width="94" height="44" rx="6" class="qfig-rte-box" />
    <text x="405" y="211" text-anchor="middle" class="qfig-rte-n">N4</text>
    <text x="405" y="228" text-anchor="middle" class="qfig-rte-sm">
      <tspan data-lang-en>Term 5</tspan>
      <tspan data-lang-vi>Kỳ 5</tspan>
    </text>
    <rect x="462" y="192" width="96" height="44" rx="6" class="qfig-rte-box" />
    <text x="510" y="211" text-anchor="middle" class="qfig-rte-n">N5</text>
    <text x="510" y="228" text-anchor="middle" class="qfig-rte-sm">
      <tspan data-lang-en>Term 5</tspan>
      <tspan data-lang-vi>Kỳ 5</tspan>
    </text>
    <text x="254" y="256" class="qfig-rte-t">
      <tspan data-lang-en>3/5: elects N3 in Term 5</tspan>
      <tspan data-lang-vi>3/5: bầu N3 ở kỳ 5</tspan>
    </text>

    <!-- Divider -->
    <line x1="10" x2="570" y1="284" y2="284" class="qfig-rte-rule" />

    <!-- Band 3: Partition heals -->
    <text x="10" y="308" class="qfig-rte-sec">
      <tspan data-lang-en>2. Link heals: N3 replicates #42 via {`{N2, N3, N4}`}</tspan>
      <tspan data-lang-vi>2. Mạng nối lại: N3 ghi #42 qua {`{N2, N3, N4}`}</tspan>
    </text>

    <!-- Write group backdrop -->
    <rect x="118" y="320" width="344" height="66" rx="8" class="qfig-rte-zone is-gold" />

    <!-- N1 stale -->
    <rect x={healXs[0]} y="330" width="96" height="46" rx="6" class="qfig-rte-box is-bad" />
    <DiagramIcon name="server" x={healXs[0] + 18} y={353} size={18} />
    <text x={healXs[0] + 34} y="349" class="qfig-rte-n is-bad">N1</text>
    <text x={healXs[0] + 34} y="366" class="qfig-rte-sm">
      <tspan data-lang-en>Term 4</tspan>
      <tspan data-lang-vi>Kỳ 4</tspan>
    </text>

    <!-- N2 -->
    <rect x={healXs[1]} y="330" width="96" height="46" rx="6" class="qfig-rte-box" />
    <DiagramIcon name="server" x={healXs[1] + 18} y={353} size={18} />
    <text x={healXs[1] + 34} y="349" class="qfig-rte-n">N2</text>
    <text x={healXs[1] + 34} y="366" class="qfig-rte-sm">
      <tspan data-lang-en>Term 5</tspan>
      <tspan data-lang-vi>Kỳ 5</tspan>
    </text>

    <!-- N3 -->
    <rect x={healXs[2]} y="330" width="96" height="46" rx="6" class="qfig-rte-box is-gold" />
    <DiagramIcon name="server" x={healXs[2] + 18} y={353} size={18} />
    <text x={healXs[2] + 34} y="349" class="qfig-rte-n">N3</text>
    <text x={healXs[2] + 34} y="366" class="qfig-rte-sm">
      <tspan data-lang-en>Term 5</tspan>
      <tspan data-lang-vi>Kỳ 5</tspan>
    </text>

    <!-- N4 -->
    <rect x={healXs[3]} y="330" width="96" height="46" rx="6" class="qfig-rte-box" />
    <DiagramIcon name="server" x={healXs[3] + 18} y={353} size={18} />
    <text x={healXs[3] + 34} y="349" class="qfig-rte-n">N4</text>
    <text x={healXs[3] + 34} y="366" class="qfig-rte-sm">
      <tspan data-lang-en>Term 5</tspan>
      <tspan data-lang-vi>Kỳ 5</tspan>
    </text>

    <!-- N5 -->
    <rect x={healXs[4]} y="330" width="96" height="46" rx="6" class="qfig-rte-box is-muted" />
    <DiagramIcon name="server" x={healXs[4] + 18} y={353} size={18} />
    <text x={healXs[4] + 34} y="349" class="qfig-rte-n">N5</text>
    <text x={healXs[4] + 34} y="366" class="qfig-rte-sm">
      <tspan data-lang-en>later</tspan>
      <tspan data-lang-vi>sau</tspan>
    </text>

    <!-- Stale N1 -> N2 arrow + replicate arrows -->
    <path d={staleArrow.line} class="qfig-rte-arr is-bad" />
    <polygon points={staleArrow.head} class="qfig-rte-arrhead is-bad" />
    <path d={repLeft.line} class="qfig-rte-arr is-gold" />
    <polygon points={repLeft.head} class="qfig-rte-arrhead is-gold" />
    <path d={repRight.line} class="qfig-rte-arr is-gold" />
    <polygon points={repRight.head} class="qfig-rte-arrhead is-gold" />

    <!-- Bottom labels -->
    <text x="10" y="408" class="qfig-rte-bad-sm">
      <tspan data-lang-en>N1 sends stale Term 4 append</tspan>
      <tspan data-lang-vi>N1 gửi lệnh ghi kỳ 4 cũ</tspan>
    </text>
    <text x="315" y="408" text-anchor="middle" class="qfig-rte-t">
      <tspan data-lang-en>N3 sends #42 (Term 5)</tspan>
      <tspan data-lang-vi>N3 gửi #42 (kỳ 5)</tspan>
    </text>
    <text x="10" y="438" class="qfig-rte-sm">
      <tspan data-lang-en>Red marks stalled or stale Term 4 paths; gold marks majority Term 5 paths.</tspan>
      <tspan data-lang-vi>Đỏ là nhánh treo hoặc kỳ 4 cũ; vàng là nhánh đa số kỳ 5.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-rte { margin: 0; width: 100%; }
  .qfig-rte svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-rte text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-rte .qfig-rte-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-rte .qfig-rte-sec { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-rte .qfig-rte-n { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-rte .qfig-rte-n.is-bad { fill: var(--red); }
  .qfig-rte .qfig-rte-t { font-size: 13px; font-weight: 600; fill: var(--text); }
  .qfig-rte .qfig-rte-sm { font-size: 12.5px; fill: var(--text-muted); }
  .qfig-rte .qfig-rte-bad { font-size: 13px; font-weight: 700; fill: var(--red); }
  .qfig-rte .qfig-rte-bad-sm { font-size: 12.5px; font-weight: 600; fill: var(--red); }
  .qfig-rte-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-rte-cut { stroke: var(--red); stroke-width: 1.8; stroke-dasharray: 5 4; }
  .qfig-rte-zone { fill: none; stroke: var(--border); stroke-width: 1.3; stroke-dasharray: 5 4; }
  .qfig-rte-zone.is-bad { stroke: var(--red); }
  .qfig-rte-zone.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-dasharray: none; }
  .qfig-rte-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .qfig-rte-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-dasharray: 4 3; }
  .qfig-rte-box.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.8; }
  .qfig-rte-box.is-muted { opacity: 0.65; }
  .qfig-rte-arr { fill: none; stroke: var(--text-muted); stroke-width: 1.8; }
  .qfig-rte-arr.is-bad { stroke: var(--red); stroke-dasharray: 3 3; }
  .qfig-rte-arr.is-gold { stroke: var(--gold); stroke-width: 2; }
  .qfig-rte-arrhead { fill: var(--text-muted); }
  .qfig-rte-arrhead.is-bad { fill: var(--red); }
  .qfig-rte-arrhead.is-gold { fill: var(--gold); }
</style>
