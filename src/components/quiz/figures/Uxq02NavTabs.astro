---
// Quiz figure for Post 2: three navigation bars. The active item is Orders in every bar.
const items = ['Overview', 'Orders', 'Customers', 'Reports'];
const itemsVi = ['Tổng quan', 'Đơn hàng', 'Khách hàng', 'Báo cáo'];
const bars = [
  { y: 20, other: '#4d82d9', activeSize: 15 },
  { y: 90, other: '#8b939e', activeSize: 15 },
  { y: 160, other: '#4d82d9', activeSize: 20 },
];
---
<div class="qfig-uxq02navtabs">
  <svg viewBox="0 0 600 228" role="img" aria-label="Three navigation bars with the items Overview, Orders, Customers, Reports; Orders is the active item. Bar 1: Orders is blue 2f6fd6 and bold, the other items are a close blue 4d82d9. Bar 2: Orders is the same blue and bold, the other items are grey 8b939e. Bar 3: Orders is blue and bold at 20px, the other items are the close blue 4d82d9 at 15px.">
    {bars.map((b, v) => (
      <g>
        <text x="6" y={b.y + 33} class="num">{v + 1}</text>
        <rect x="34" y={b.y} width="556" height="50" rx="8" class="bar" />
        {items.map((it, i) => (
          <text x={56 + i * 136} y={b.y + 32} class={i === 1 ? 'on' : 'off'} style={i === 1 ? `font-size:${b.activeSize}px` : `fill:${b.other}`}>
            <tspan data-lang-en>{it}</tspan><tspan data-lang-vi>{itemsVi[i]}</tspan>
          </text>
        ))}
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-uxq02navtabs { margin: 0; width: 100%; }
  .qfig-uxq02navtabs svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq02navtabs .bar { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq02navtabs .num { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-uxq02navtabs .on { font-size: 15px; font-weight: 700; fill: #2f6fd6; }
  .qfig-uxq02navtabs .off { font-size: 15px; font-weight: 500; }
</style>
