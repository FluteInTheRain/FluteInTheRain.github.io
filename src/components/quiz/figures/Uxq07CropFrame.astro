---
// Quiz figure for the images post quiz (Uxq07).
---
<div class="qfig-uxq07cropframe">
  <svg viewBox="0 0 600 290" role="img" aria-label="A tall 2:3 portrait with a head near its top, next to an empty 4:3 frame of the same width.">
    <rect x="40" y="20" width="160" height="240" fill="#e8e2d6" />
    <g transform="translate(40 20)"><circle cx="80" cy="45" r="24" fill="#c9a98a" /><path d="M20 240 L20 150 Q80 90 140 150 L140 240 Z" fill="#6f8aa8" /></g>
    <rect x="40" y="20" width="160" height="240" class="ln" />
    <text x="120" y="282" text-anchor="middle" class="m"><tspan data-lang-en>2:3 upload</tspan><tspan data-lang-vi>Ảnh tải lên 2:3</tspan></text>
    <rect x="300" y="80" width="160" height="120" class="dash" />
    <text x="380" y="222" text-anchor="middle" class="m"><tspan data-lang-en>4:3 frame, same width</tspan><tspan data-lang-vi>Khung 4:3, cùng chiều rộng</tspan></text>
    <text x="380" y="60" text-anchor="middle" class="mono">object-fit: cover</text>
  </svg>
</div>

<style>
  .qfig-uxq07cropframe { margin: 0; width: 100%; }
  .qfig-uxq07cropframe svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq07cropframe text { font-size: 13.5px; fill: var(--text-body); }
  .qfig-uxq07cropframe .h { font-weight: 700; fill: var(--text); }
  .qfig-uxq07cropframe .m { fill: var(--text-muted); font-size: 13px; }
  .qfig-uxq07cropframe .mono { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; fill: var(--text-muted); }
  .qfig-uxq07cropframe .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq07cropframe .bar { fill: var(--border); }
  .qfig-uxq07cropframe .ln { stroke: var(--text-muted); stroke-width: 1.4; fill: none; }
  .qfig-uxq07cropframe .acc { stroke: var(--red); stroke-width: 2; fill: none; }
  .qfig-uxq07cropframe .accf { fill: var(--red); }
  .qfig-uxq07cropframe .dash { stroke: var(--red); stroke-width: 2; stroke-dasharray: 6 4; fill: none; }
  .qfig-uxq07cropframe .ico { stroke: var(--text); fill: none; stroke-linecap: round; stroke-linejoin: round; }
</style>
