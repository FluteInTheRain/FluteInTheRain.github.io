---
// Quiz figure for go-variables-types-pointers-functions set 01 (s01q4): the 256 values of a uint8 laid out on a ring.
// It shows the ring and the start value; it does not mark where the counter ends up.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
---
<div class="qfig-gq02r">
  <svg viewBox="0 0 580 270" role="img" aria-label="The 256 values of a uint8 drawn as a ring, from 0 up to 255 and then back to 0. A start marker sits at 250.">
    <text x="0" y="20" class="qfig-gq02r-h">
      <tspan data-lang-en>The 256 values of a uint8 on a ring</tspan>
      <tspan data-lang-vi>256 giá trị của uint8 trên một vòng tròn</tspan>
    </text>
    <circle cx="170" cy="150" r="90" class="qfig-gq02r-ring" />
    <circle cx="170" cy="60" r="6" class="qfig-gq02r-dot" />
    <text x="170" y="46" text-anchor="middle" class="qfig-gq02r-m">0</text>
    <circle cx="148" cy="62" r="6" class="qfig-gq02r-dot" />
    <text x="130" y="50" text-anchor="end" class="qfig-gq02r-m">255</text>
    <circle cx="105" cy="82" r="6" class="qfig-gq02r-start" />
    <text x="88" y="78" text-anchor="end" class="qfig-gq02r-t">250</text>
    <circle cx="170" cy="150" r="3" class="qfig-gq02r-dot" />
    <path d="M 215 72 A 90 90 0 0 1 252 108" class="qfig-gq02r-arc" />
    <text x="222" y="98" class="qfig-gq02r-b">
      <tspan data-lang-en>++ moves one step</tspan>
      <tspan data-lang-vi>++ đi một bước</tspan>
    </text>

    <rect x="330" y="70" width="240" height="150" rx="8" class="qfig-gq02r-card" />
    <text x="346" y="98" class="qfig-gq02r-b">
      <tspan data-lang-en>Type: uint8, 8 bits</tspan>
      <tspan data-lang-vi>Kiểu: uint8, 8 bit</tspan>
    </text>
    <text x="346" y="124" class="qfig-gq02r-b">
      <tspan data-lang-en>Smallest value: 0</tspan>
      <tspan data-lang-vi>Giá trị nhỏ nhất: 0</tspan>
    </text>
    <text x="346" y="150" class="qfig-gq02r-b">
      <tspan data-lang-en>Largest value: 255</tspan>
      <tspan data-lang-vi>Giá trị lớn nhất: 255</tspan>
    </text>
    <text x="346" y="176" class="qfig-gq02r-b">
      <tspan data-lang-en>Start: level = 250</tspan>
      <tspan data-lang-vi>Bắt đầu: level = 250</tspan>
    </text>
    <text x="346" y="202" class="qfig-gq02r-b">
      <tspan data-lang-en>Steps taken: 10</tspan>
      <tspan data-lang-vi>Số bước: 10</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq02r { margin: 0; width: 100%; }
  .qfig-gq02r svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq02r text { font-size: 13px; fill: var(--text-body); }
  .qfig-gq02r .qfig-gq02r-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq02r .qfig-gq02r-t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-gq02r .qfig-gq02r-m { font-family: 'JetBrains Mono', ui-monospace, monospace; fill: var(--text-muted); }
  .qfig-gq02r-ring { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 2; }
  .qfig-gq02r-dot { fill: var(--text-muted); }
  .qfig-gq02r-start { fill: var(--act-3); stroke: var(--text); stroke-width: 1.5; }
  .qfig-gq02r-arc { fill: none; stroke: var(--act-3); stroke-width: 3; stroke-linecap: round; }
  .qfig-gq02r-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
</style>
