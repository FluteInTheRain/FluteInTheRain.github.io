---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 01 (sharding): one Postgres node whose VACUUM falls behind, then the same data split by workspace_id
// into hosts that each hold 15 logical shards. Shows the mechanism only (no counts of shards in total,
// no result of any question). Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 330;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const gauges = [
  { en: 'Dead tuples', vi: 'Dead tuples', noteEn: 'piling up', noteVi: 'đang chất đống', fill: 196, red: true },
  { en: 'Cleanup (VACUUM)', vi: 'Dọn rác (VACUUM)', noteEn: 'cannot finish', noteVi: 'chạy không xong', fill: 52, red: false },
  { en: 'Transaction IDs used', vi: 'Mã giao dịch (TXID) đã dùng', noteEn: 'writes stop at the limit', noteVi: 'chạm ngưỡng là Postgres ngừng ghi', fill: 204, red: true },
].map((g, i) => ({ ...g, y: 108 + i * 58 }));

const hosts = [0, 1, 2, 3].map((i) => ({ i, x: 300 + i * 68 }));
const cells = Array.from({ length: 15 }, (_, k) => ({ cx: k % 5, cy: Math.floor(k / 5) }));
const down = arrow(408, 88, 408, 128);
---
<div class="ww">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Notion's single Postgres node, with VACUUM falling behind, next to the same data split by workspace_id across hosts that each hold 15 logical shards.">
    <text x="10" y="24" class="ww-h">
      <tspan data-lang-en>Before: one database</tspan>
      <tspan data-lang-vi>Trước: một database</tspan>
    </text>
    <text x="300" y="24" class="ww-h">
      <tspan data-lang-en>After: split by workspace</tspan>
      <tspan data-lang-vi>Sau: chia theo workspace</tspan>
    </text>

    <rect x="10" y="38" width="260" height="282" rx="8" class="ww-card" />
    <DiagramIcon name="rds" x={38} y={66} size={24} />
    <text x="62" y="71" class="ww-name">
      <tspan data-lang-en>One Postgres node</tspan>
      <tspan data-lang-vi>Một node Postgres</tspan>
    </text>

    {gauges.map((g) => (
      <g>
        <text x="26" y={g.y} class="ww-lab">
          <tspan data-lang-en>{g.en}</tspan>
          <tspan data-lang-vi>{g.vi}</tspan>
        </text>
        <rect x="26" y={g.y + 8} width="228" height="14" rx="3" class="ww-track" />
        <rect x="26" y={g.y + 8} width={g.fill} height="14" rx="3" class={g.red ? 'ww-fill is-red' : 'ww-fill'} />
        <text x="26" y={g.y + 40} class={g.red ? 'ww-note is-red' : 'ww-note'}>
          <tspan data-lang-en>{g.noteEn}</tspan>
          <tspan data-lang-vi>{g.noteVi}</tspan>
        </text>
      </g>
    ))}

    <rect x="26" y="278" width="228" height="34" rx="6" class="ww-bad" />
    <text x="140" y="300" text-anchor="middle" class="ww-bad-t">
      <tspan data-lang-en>A bigger instance: no headroom</tspan>
      <tspan data-lang-vi>Máy to hơn: hết dư địa</tspan>
    </text>

    <rect x="290" y="38" width="280" height="282" rx="8" class="ww-card" />
    <DiagramIcon name="users" x={318} y={66} size={24} />
    <rect x="346" y="52" width="124" height="28" rx="14" class="ww-chip" />
    <text x="408" y="71" text-anchor="middle" class="ww-chip-t">workspace_id</text>
    <g class="ww-arrow"><path d={down.line} /><polygon points={down.head} /></g>
    <text x="418" y="112" class="ww-note">
      <tspan data-lang-en>partition key</tspan>
      <tspan data-lang-vi>khoá phân mảnh</tspan>
    </text>

    {hosts.map((h) => (
      <g>
        <rect x={h.x} y="134" width="60" height="78" rx="6" class="ww-host" />
        <text x={h.x + 30} y="152" text-anchor="middle" class="ww-hostname">
          <tspan data-lang-en>Host {h.i + 1}</tspan>
          <tspan data-lang-vi>Máy {h.i + 1}</tspan>
        </text>
        {cells.map((c) => (
          <rect x={h.x + 6 + c.cx * 10} y={162 + c.cy * 12} width="8" height="9" rx="1.5" class="ww-cell" />
        ))}
      </g>
    ))}
    <text x="300" y="232" class="ww-note">
      <tspan data-lang-en>32 hosts in all (4 drawn)</tspan>
      <tspan data-lang-vi>Tổng cộng 32 máy (vẽ 4)</tspan>
    </text>
    <text x="300" y="250" class="ww-note">
      <tspan data-lang-en>15 logical shards on each host</tspan>
      <tspan data-lang-vi>Mỗi máy có 15 shard logic</tspan>
    </text>

    <rect x="300" y="264" width="260" height="48" rx="6" class="ww-ok" />
    <text x="312" y="285" class="ww-ok-t">
      <tspan data-lang-en>Each host holds a slice of</tspan>
      <tspan data-lang-vi>Mỗi máy giữ một lát dữ liệu</tspan>
    </text>
    <text x="312" y="303" class="ww-ok-t">
      <tspan data-lang-en>the data and cleans it alone</tspan>
      <tspan data-lang-vi>và tự dọn phần của mình</tspan>
    </text>
  </svg>
</div>

<style>
  .ww { width: 100%; }
  .ww svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .ww text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .ww .ww-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .ww .ww-name { font-size: 14px; font-weight: 700; fill: var(--text); }
  .ww .ww-lab { font-size: 14px; fill: var(--text); }
  .ww .ww-note { fill: var(--text-muted); }
  .ww .ww-note.is-red { fill: var(--red); font-weight: 700; }
  .ww .ww-hostname { fill: var(--text); font-weight: 700; }
  .ww .ww-chip-t { fill: var(--text); font-weight: 700; }
  .ww .ww-bad-t { fill: var(--red); font-weight: 700; }
  .ww .ww-ok-t { fill: var(--text); }
  .ww-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .ww-track { fill: var(--bg); stroke: var(--border); stroke-width: 1; }
  .ww-fill { fill: var(--text-muted); }
  .ww-fill.is-red { fill: var(--red); }
  .ww-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
  .ww-ok { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.2; }
  .ww-chip { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .ww-host { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .ww-cell { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1; }
  .ww-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .ww-arrow polygon { fill: var(--text-muted); }
</style>
