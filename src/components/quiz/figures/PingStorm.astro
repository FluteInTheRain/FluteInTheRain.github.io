---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for sharding set 08: reads of one chat channel travel through 8 data-service instances to a
// 24-node cluster; only the 3 replicas of the hot partition are marked. Shows the scenario's inputs only,
// never a computed load. Inline SVG, site tokens only, no <marker>/<defs>/ids.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 10 * Math.cos(a - 0.45), y2 - 10 * Math.sin(a - 0.45)];
  const p2 = [x2 - 10 * Math.cos(a + 0.45), y2 - 10 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 8 * Math.cos(a)} ${y2 - 8 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const a1 = arrow(290, 78, 290, 128);
const a2 = arrow(290, 214, 290, 266);
// 24 nodes: 3 rows of 8; the hot partition sits on 3 of them
const hot = new Set([2, 5, 11]);
const nodes = Array.from({ length: 24 }, (_, i) => ({
  x: 150 + (i % 8) * 46,
  y: 296 + Math.floor(i / 8) * 36,
  hot: hot.has(i),
}));
const insts = Array.from({ length: 8 }, (_, i) => 150 + i * 46 + 18);
---
<div class="qfig-ping">
  <svg viewBox="0 0 580 470" role="img" aria-label="Reads for one chat channel go through 8 data-service instances to a cluster of 24 database nodes, where 3 nodes hold the hot partition.">
    <DiagramIcon name="users" x={40} y={40} size={36} />
    <text x="76" y="36" class="qfig-ping-t">
      <tspan data-lang-en>Users read one channel</tspan>
      <tspan data-lang-vi>Người dùng đọc một kênh</tspan>
    </text>
    <text x="76" y="58" class="qfig-ping-m">
      <tspan data-lang-en>12,000 reads/s, same time bucket</tspan>
      <tspan data-lang-vi>12.000 lượt đọc/s, cùng time bucket</tspan>
    </text>

    <g class="qfig-ping-go"><path d={a1.line} /><polygon points={a1.head} /></g>
    <text x="304" y="108" class="qfig-ping-m">
      <tspan data-lang-en>API and load balancer</tspan>
      <tspan data-lang-vi>API và load balancer</tspan>
    </text>

    <g class="qfig-ping-box">
      <rect x="130" y="132" width="440" height="82" rx="8" />
    </g>
    <text x="144" y="154" class="qfig-ping-t">
      <tspan data-lang-en>Data service: 8 instances</tspan>
      <tspan data-lang-vi>Data service: 8 instance</tspan>
    </text>
    {insts.map((cx) => <DiagramIcon name="server" x={cx} y={188} size={24} />)}

    <g class="qfig-ping-bad"><path d={a2.line} /><polygon points={a2.head} /></g>
    <text x="304" y="246" class="qfig-ping-badt">
      <tspan data-lang-en>12,000 reads/s</tspan>
      <tspan data-lang-vi>12.000 lượt đọc/s</tspan>
    </text>

    <text x="0" y="292" class="qfig-ping-t">
      <tspan data-lang-en>Database</tspan>
      <tspan data-lang-vi>Database</tspan>
    </text>
    <text x="0" y="312" class="qfig-ping-m">
      <tspan data-lang-en>24 nodes</tspan>
      <tspan data-lang-vi>24 node</tspan>
    </text>
    {nodes.map((n) => (
      <rect x={n.x} y={n.y} width="36" height="26" rx="5" class={n.hot ? 'qfig-ping-hot' : 'qfig-ping-node'} />
    ))}

    <rect x="150" y="410" width="16" height="12" rx="3" class="qfig-ping-hot" />
    <text x="174" y="421" class="qfig-ping-body">
      <tspan data-lang-en>Replicas of this channel's partition (3 copies)</tspan>
      <tspan data-lang-vi>Replica của partition kênh này (3 bản sao)</tspan>
    </text>
    <text x="0" y="448" class="qfig-ping-m">
      <tspan data-lang-en>Quorum read: wait for 2 of the 3 replicas. One node serves about 3,000 reads/s.</tspan>
      <tspan data-lang-vi>Đọc quorum: chờ 2 trong 3 replica. Một node phục vụ khoảng 3.000 lượt đọc/s.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-ping { margin: 0; width: 100%; }
  .qfig-ping svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-ping text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-ping .qfig-ping-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-ping .qfig-ping-m { fill: var(--text-muted); }
  .qfig-ping .qfig-ping-body { fill: var(--text-body); }
  .qfig-ping .qfig-ping-badt { font-weight: 700; fill: var(--red); }
  .qfig-ping-go path { stroke: var(--text-muted); stroke-width: 1.8; fill: none; }
  .qfig-ping-go polygon { fill: var(--text-muted); }
  .qfig-ping-bad path { stroke: var(--red); stroke-width: 2.2; fill: none; }
  .qfig-ping-bad polygon { fill: var(--red); }
  .qfig-ping-box rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-ping-node { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-ping-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
</style>
