---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 01 (transactions): two transfers out of one account run at the same time, each inside BEGIN ... COMMIT.
// Shows the order of steps only (no final balance), so it never gives an answer away.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 296;
const x0 = 118; // first column
const pitch = 76;
const bw = 71;
const steps = [
  { en: 'Begin', vi: 'Bắt đầu' },
  { en: 'Read: 10', vi: 'Đọc: 10' },
  { en: '10 ≥ 10: ok', vi: '10 ≥ 10: ok' },
  { en: 'Subtract 10', vi: 'Trừ 10' },
  { en: 'Commit', vi: 'Commit' },
];
const lanes = [
  { y: 104, off: 0, name: { en: 'Transfer 1', vi: 'Chuyển 1' }, to: { en: '10 to B', vi: '10 sang B' } },
  { y: 176, off: 1, name: { en: 'Transfer 2', vi: 'Chuyển 2' }, to: { en: '10 to C', vi: '10 sang C' } },
];
const axisY = 262;
---
<div class="ot">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two transfers of 10 out of account A, each wrapped in begin and commit, overlap in time. Each one reads the balance, checks it, subtracts 10 and commits.">
    <text x="10" y="26" class="ot-h">
      <tspan data-lang-en>Two transfers out of the same account</tspan>
      <tspan data-lang-vi>Hai lệnh chuyển tiền từ cùng một tài khoản</tspan>
    </text>

    <g class="ot-acct">
      <rect x="10" y="40" width="250" height="40" rx="8" />
      <DiagramIcon name="db" x={34} y={60} size={22} />
      <text x="56" y="65" class="ot-name">
        <tspan data-lang-en>Account A: balance 10</tspan>
        <tspan data-lang-vi>Tài khoản A: số dư 10</tspan>
      </text>
    </g>

    {lanes.map((l) => (
      <g>
        <DiagramIcon name="laptop" x={22} y={l.y + 14} size={22} />
        <text x="40" y={l.y + 19} class="ot-name">
          <tspan data-lang-en>{l.name.en}</tspan>
          <tspan data-lang-vi>{l.name.vi}</tspan>
        </text>
        <text x="40" y={l.y + 40} class="ot-sub">
          <tspan data-lang-en>{l.to.en}</tspan>
          <tspan data-lang-vi>{l.to.vi}</tspan>
        </text>
        {steps.map((s, i) => {
          const x = x0 + (i + l.off) * pitch;
          const edge = i === 0 || i === steps.length - 1;
          return (
            <g>
              <rect x={x} y={l.y} width={bw} height="34" rx="6" class={edge ? 'ot-step is-edge' : 'ot-step'} />
              <text x={x + bw / 2} y={l.y + 21} text-anchor="middle" class="ot-step-t">
                <tspan data-lang-en>{s.en}</tspan>
                <tspan data-lang-vi>{s.vi}</tspan>
              </text>
            </g>
          );
        })}
      </g>
    ))}

    <line x1={x0} x2={W - 14} y1={axisY} y2={axisY} class="ot-axis" />
    <polygon points={`${W - 6},${axisY} ${W - 16},${axisY - 4} ${W - 16},${axisY + 4}`} class="ot-axis-head" />
    <text x={x0} y={axisY + 22} class="ot-sub">
      <tspan data-lang-en>Time</tspan>
      <tspan data-lang-vi>Thời gian</tspan>
    </text>
    <text x={W - 10} y={axisY + 22} text-anchor="end" class="ot-sub">
      <tspan data-lang-en>Transfer 2 starts a moment later</tspan>
      <tspan data-lang-vi>Lệnh 2 bắt đầu trễ hơn một chút</tspan>
    </text>
  </svg>
</div>

<style>
  .ot { width: 100%; }
  .ot svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .ot text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .ot .ot-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ot .ot-name { font-size: 13px; font-weight: 700; fill: var(--text); }
  .ot .ot-sub { fill: var(--text-muted); }
  .ot-acct rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .ot-step { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .ot-step.is-edge { fill: var(--bg); stroke: var(--text-muted); }
  .ot .ot-step-t { fill: var(--text); }
  .ot-axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .ot-axis-head { fill: var(--text-muted); }
</style>
