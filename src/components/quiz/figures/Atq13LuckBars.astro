---
// Set 06: chance that a strategy with true Sharpe 1 and 10% yearly volatility shows a loss over a window.
// Normal approximation, computed in Python: P(loss) = Phi(-mean/sd), mean = 10% * d/252, sd = 10% * sqrt(d/252).
const W = 580;
const H = 250;
const rows = [
  { en: '21 days', vi: '21 ngày', p: 38.6 },
  { en: '60 days', vi: '60 ngày', p: 31.3 },
  { en: '126 days', vi: '126 ngày', p: 24.0 },
  { en: '252 days', vi: '252 ngày', p: 15.9 },
];
const bw = (p: number) => (p / 50) * 330;
---
<div class="qs13l">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <text x="12" y="24" class="h">
      <tspan data-lang-en>Chance of a loss over the window, true Sharpe 1</tspan>
      <tspan data-lang-vi>Xác suất lỗ trong khung thời gian, Sharpe thật bằng 1</tspan>
    </text>
    {rows.map((r, i) => (
      <g>
        <text x="12" y={72 + i * 46} class="l">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <rect x="110" y={54 + i * 46} width={bw(r.p)} height="26" rx="4" class="bar" />
        <text x={118 + bw(r.p)} y={73 + i * 46} class="l">
          <tspan data-lang-en>{r.p.toFixed(1)}%</tspan>
          <tspan data-lang-vi>{r.p.toFixed(1).replace('.', ',')}%</tspan>
        </text>
      </g>
    ))}
  </svg>
</div>
<style>
  .qs13l { margin: 0; width: 100%; }
  .qs13l svg { display: block; width: 100%; height: auto; }
  .qs13l .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qs13l .l { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qs13l .bar { fill: var(--text-muted); opacity: 0.6; }
</style>
