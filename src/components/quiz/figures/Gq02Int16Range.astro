---
// Quiz figure for go-variables-types-pointers-functions set 03 (s03q5): the int16 range and the 16 low bits of 40000.
// It shows the range and the bits; it does not give the converted value.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
---
<div class="qfig-gq02i">
  <svg viewBox="0 0 580 290" role="img" aria-label="A number line for the int16 range, from -32768 to 32767, with the reading 40000 placed to the right of it. Below, the 16 bits kept from 40000, 1001 1100 0100 0000, with the leftmost bit labelled as the sign bit of an int16.">
    <text x="0" y="20" class="qfig-gq02i-h">
      <tspan data-lang-en>The int16 range and a reading of 40000</tspan>
      <tspan data-lang-vi>Dải int16 và số đo 40000</tspan>
    </text>

    <line x1="20" x2="560" y1="90" y2="90" class="qfig-gq02i-axis" />
    <rect x="20" y="78" width="420" height="24" rx="4" class="qfig-gq02i-band" />
    <text x="20" y="130" class="qfig-gq02i-m">-32768</text>
    <text x="440" y="130" text-anchor="end" class="qfig-gq02i-m">32767</text>
    <text x="230" y="66" text-anchor="middle" class="qfig-gq02i-b">
      <tspan data-lang-en>int16 range</tspan>
      <tspan data-lang-vi>dải int16</tspan>
    </text>
    <circle cx="520" cy="90" r="7" class="qfig-gq02i-pt" />
    <text x="520" y="66" text-anchor="middle" class="qfig-gq02i-t">40000</text>
    <text x="520" y="130" text-anchor="middle" class="qfig-gq02i-b">
      <tspan data-lang-en>reading</tspan>
      <tspan data-lang-vi>số đo</tspan>
    </text>

    <text x="20" y="176" class="qfig-gq02i-b">
      <tspan data-lang-en>The 16 low bits of 40000 (an int64 keeps more bits above these)</tspan>
      <tspan data-lang-vi>16 bit thấp của 40000 (int64 còn giữ thêm các bit cao hơn)</tspan>
    </text>
    <rect x="20" y="190" width="30" height="36" class="qfig-gq02i-cell qfig-gq02i-sign" />
    <rect x="50" y="190" width="30" height="36" class="qfig-gq02i-cell" />
    <rect x="80" y="190" width="30" height="36" class="qfig-gq02i-cell" />
    <rect x="110" y="190" width="30" height="36" class="qfig-gq02i-cell" />
    <rect x="150" y="190" width="30" height="36" class="qfig-gq02i-cell" />
    <rect x="180" y="190" width="30" height="36" class="qfig-gq02i-cell" />
    <rect x="210" y="190" width="30" height="36" class="qfig-gq02i-cell" />
    <rect x="240" y="190" width="30" height="36" class="qfig-gq02i-cell" />
    <rect x="280" y="190" width="30" height="36" class="qfig-gq02i-cell" />
    <rect x="310" y="190" width="30" height="36" class="qfig-gq02i-cell" />
    <rect x="340" y="190" width="30" height="36" class="qfig-gq02i-cell" />
    <rect x="370" y="190" width="30" height="36" class="qfig-gq02i-cell" />
    <rect x="410" y="190" width="30" height="36" class="qfig-gq02i-cell" />
    <rect x="440" y="190" width="30" height="36" class="qfig-gq02i-cell" />
    <rect x="470" y="190" width="30" height="36" class="qfig-gq02i-cell" />
    <rect x="500" y="190" width="30" height="36" class="qfig-gq02i-cell" />
    <g class="qfig-gq02i-bits" text-anchor="middle">
      <text x="35" y="214">1</text><text x="65" y="214">0</text><text x="95" y="214">0</text><text x="125" y="214">1</text>
      <text x="165" y="214">1</text><text x="195" y="214">1</text><text x="225" y="214">0</text><text x="255" y="214">0</text>
      <text x="295" y="214">0</text><text x="325" y="214">1</text><text x="355" y="214">0</text><text x="385" y="214">0</text>
      <text x="425" y="214">0</text><text x="455" y="214">0</text><text x="485" y="214">0</text><text x="515" y="214">0</text>
    </g>
    <text x="20" y="250" class="qfig-gq02i-b">
      <tspan data-lang-en>sign bit of an int16</tspan>
      <tspan data-lang-vi>bit dấu của int16</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq02i { margin: 0; width: 100%; }
  .qfig-gq02i svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq02i text { font-size: 13px; fill: var(--text-body); }
  .qfig-gq02i .qfig-gq02i-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq02i .qfig-gq02i-t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-gq02i .qfig-gq02i-m { font-family: 'JetBrains Mono', ui-monospace, monospace; fill: var(--text-muted); }
  .qfig-gq02i .qfig-gq02i-bits text { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq02i-axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-gq02i-band { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-gq02i-pt { fill: var(--act-3); stroke: var(--text); stroke-width: 1.5; }
  .qfig-gq02i-cell { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-gq02i-sign { stroke: var(--act-3); stroke-width: 3; }
</style>
