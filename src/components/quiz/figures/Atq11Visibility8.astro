---
// Natural visibility graph of the series [5,2,4,1,3,6,2,4] (made up for the question): 13 links, degrees [3,2,5,3,3,6,2,2].
const y = [5, 2, 4, 1, 3, 6, 2, 4];
const E: [number, number][] = [[0,1],[0,2],[0,5],[1,2],[2,3],[2,4],[2,5],[3,4],[3,5],[4,5],[5,6],[5,7],[6,7]];
const bx = (i: number) => 40 + i * 62, by = (v: number) => 190 - v * 24;
---
<div class="q11v">
  <svg viewBox="0 0 580 230" role="img" aria-hidden="true">
    <text x="20" y="20" class="q11v-h"><tspan data-lang-en>Eight daily prices; two days are linked if no price between them blocks the line</tspan><tspan data-lang-vi>Tám giá ngày; hai ngày được nối nếu không giá nào ở giữa chắn đường thẳng</tspan></text>
    {y.map((v, i) => <rect x={bx(i) - 12} y={by(v)} width="24" height={190 - by(v)} rx="3" class="q11v-r" />)}
    {E.map(([a, b]) => <line x1={bx(a)} y1={by(y[a])} x2={bx(b)} y2={by(y[b])} class="q11v-l" />)}
    {y.map((v, i) => <circle cx={bx(i)} cy={by(v)} r="4.5" class="q11v-p" />)}
    {y.map((v, i) => <text x={bx(i)} y="208" text-anchor="middle" class="q11v-t">{i + 1}</text>)}
  </svg>
</div>
<style>
  .q11v { margin: 0; width: 100%; }
  .q11v svg { display: block; width: 100%; height: auto; }
  .q11v text { font-size: 12.5px; fill: var(--text-body); }
  .q11v .q11v-h { font-size: 13px; font-weight: 700; fill: var(--text); }
  .q11v .q11v-t { font-size: 12px; fill: var(--text-muted); }
  .q11v-r { fill: var(--bg-alt); stroke: var(--border); }
  .q11v-l { stroke: var(--text-muted); stroke-width: 1.2; }
  .q11v-p { fill: var(--bg); stroke: var(--text); stroke-width: 1.5; }
</style>
