---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-validation-schemas set 01: three entrances (browser form, partner feed through our own queue,
// admin script) all end in the same save_order(data: dict). Only the browser has a check, and that one runs on the
// user's machine. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const rows = [
  { y: 78, icon: 'laptop', en: 'Browser form', vi: 'Form trên trình duyệt', en2: 'JavaScript checks quantity ≥ 1', vi2: 'JavaScript kiểm tra quantity ≥ 1', checked: true },
  { y: 158, icon: 'rabbitmq', en: 'Partner feed, our own queue', vi: 'Feed đối tác, queue của ta', en2: 'No check before the consumer', vi2: 'Không kiểm tra trước consumer', checked: false },
  { y: 238, icon: 'terminal', en: 'Admin import script', vi: 'Script import của admin', en2: 'No check', vi2: 'Không kiểm tra', checked: false },
];
function head(x: number, y: number) { return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`; }
---
<div class="qfig-fin">
  <svg viewBox="0 0 580 300" role="img" aria-label="Three entrances into one function: a browser form with a JavaScript check, a partner feed through the team's own queue, and an admin script, all calling save_order(data: dict).">
    <text x="0" y="22" class="qfig-fin-h">
      <tspan data-lang-en>Three ways in, one function</tspan>
      <tspan data-lang-vi>Ba lối vào, một hàm</tspan>
    </text>
    {rows.map((r) => (
      <g>
        <rect x="0" y={r.y - 30} width="290" height="60" rx="8" class="qfig-fin-box" />
        <DiagramIcon name={r.icon as any} x={30} y={r.y} size={26} />
        <text x="58" y={r.y - 4} class="qfig-fin-t">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <text x="58" y={r.y + 15} class="qfig-fin-m">
          <tspan data-lang-en>{r.en2}</tspan>
          <tspan data-lang-vi>{r.vi2}</tspan>
        </text>
        <line x1="292" x2="364" y1={r.y} y2="148" class="qfig-fin-arrow" />
      </g>
    ))}
    <polygon points="372,148 362,142 362,154" class="qfig-fin-head" />
    <rect x="374" y="118" width="206" height="80" rx="10" class="qfig-fin-fn" />
    <text x="477" y="148" text-anchor="middle" class="qfig-fin-code">save_order(data: dict)</text>
    <text x="477" y="172" text-anchor="middle" class="qfig-fin-m">
      <tspan data-lang-en>writes to the orders table</tspan>
      <tspan data-lang-vi>ghi vào bảng orders</tspan>
    </text>
    <text x="477" y="236" text-anchor="middle" class="qfig-fin-m">
      <tspan data-lang-en>One partner message:</tspan>
      <tspan data-lang-vi>Một message của đối tác:</tspan>
    </text>
    <text x="477" y="258" text-anchor="middle" class="qfig-fin-bad">{'{"sku": "A-17", "quantity": -3}'}</text>
  </svg>
</div>

<style>
  .qfig-fin { margin: 0; width: 100%; }
  .qfig-fin svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-fin text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-fin .qfig-fin-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-fin .qfig-fin-t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-fin .qfig-fin-m { fill: var(--text-muted); font-size: 13px; }
  .qfig-fin .qfig-fin-code { font-weight: 700; fill: var(--text); }
  .qfig-fin .qfig-fin-bad { font-weight: 700; fill: var(--red); font-size: 13px; }
  .qfig-fin-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-fin-fn { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-fin-arrow { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-fin-head { fill: var(--text-muted); }
</style>
