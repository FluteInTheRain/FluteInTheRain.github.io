---
// Quiz figure for set 06: training and validation error from the post's demo run (60 rows, 8 hidden units),
// no marker and no verdict. Numbers come from the same Python run as the post's demo.
import { DATA } from '../../demos/AtP14FitDemo.tsx';
const run = DATA.runs['60_8'];
const E = DATA.E;
const pl = 44, pr = 14, pt = 34, pb = 40, W = 580, H = 230;
const lx = (e: number) => pl + (Math.log10(e) / Math.log10(3000)) * (W - pl - pr);
const ly = (v: number) => pt + ((1.2 - Math.min(1.2, v)) / 1.2) * (H - pt - pb);
const curve = (ys: number[]) => ys.map((v, i) => `${i ? 'L' : 'M'}${lx(E[i]).toFixed(1)} ${ly(v).toFixed(1)}`).join(' ');
---
<div class="qfig-atq14v">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Training error falling steadily and validation error falling, then rising, against epochs on a log axis from 1 to 3000.">
    <text x="0" y="18" class="h">
      <tspan data-lang-en>Error against epochs (log scale)</tspan>
      <tspan data-lang-vi>Sai số theo epoch (thang log)</tspan>
    </text>
    {[0, 0.4, 0.8, 1.2].map((v) => (
      <g>
        <line x1={pl} x2={W - pr} y1={ly(v)} y2={ly(v)} class="grid" />
        <text x={pl - 6} y={ly(v) + 4} text-anchor="end" class="t">{v.toFixed(1)}</text>
      </g>
    ))}
    {[1, 10, 100, 1000].map((e) => <text x={lx(e)} y={H - pb + 16} text-anchor="middle" class="t">{e}</text>)}
    <path d={curve(run.train)} class="train" />
    <path d={curve(run.val)} class="val" />
    <line x1="330" y1={H - 14} x2="354" y2={H - 14} class="train" />
    <text x="360" y={H - 10} class="t">
      <tspan data-lang-en>training</tspan>
      <tspan data-lang-vi>huấn luyện</tspan>
    </text>
    <line x1="450" y1={H - 14} x2="474" y2={H - 14} class="val" />
    <text x="480" y={H - 10} class="t">validation</text>
  </svg>
</div>

<style>
  .qfig-atq14v svg { display: block; width: 100%; height: auto; max-width: 580px; margin: 0 auto; }
  .qfig-atq14v text { font-size: 12px; fill: var(--text-body); }
  .qfig-atq14v .h { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-atq14v .t { fill: var(--text-muted); }
  .qfig-atq14v .grid { stroke: var(--border); stroke-width: 1; }
  .qfig-atq14v .train { fill: none; stroke: var(--gold); stroke-width: 2.2; }
  .qfig-atq14v .val { fill: none; stroke: var(--red); stroke-width: 2.2; }
</style>
