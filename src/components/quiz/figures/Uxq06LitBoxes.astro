---
// Quiz figure for Post 6 (depth and shadows): two form mocks, one lit correctly from above and one flipped.
const FILT = [
  { id: 'u06a-raised', layers: [{ y: 1, b: 2, s: 0, o: 0.3 }] },
  { id: 'u06a-raised-in', layers: [{ y: 1, b: 2, s: 0, o: 0.16 }] },
];
const fid = (i: number, k: number) => ({ e: `e${i}-${k}`, b: `b${i}-${k}`, o: `o${i}-${k}`, f: `f${i}-${k}`, s: `s${i}-${k}` });
const panels = [
  { x: 10, n: { en: 'Mock 1', vi: 'Bản mẫu 1' }, button: 'inset', field: 'raised' },
  { x: 310, n: { en: 'Mock 2', vi: 'Bản mẫu 2' }, button: 'raised', field: 'inset' },
];
---
<div class="qfig-uxq06litboxes">
  <svg viewBox="0 0 600 236" role="img" aria-label="Two form mocks side by side, each with a red Save button and a text field. In Mock 1 the button has a dark inner shadow along its top edge and the field has a light top edge with a shadow below it. In Mock 2 the button has a light top edge with a shadow below it and the field has a dark inner shadow along its top edge.">
    <defs>
      {FILT.map((d) => (
        <filter id={d.id} x="-20%" y="-40%" width="140%" height="220%" color-interpolation-filters="sRGB">
          {d.layers.map((l, k) => { const n = fid(0, k); return (
            <>
              <feGaussianBlur in="SourceAlpha" stdDeviation={l.b / 2} result={n.b} />
              <feOffset in={n.b} dx="0" dy={l.y} result={n.o} />
              <feFlood style={`flood-color: var(--band-bg); flood-opacity: ${l.o}`} result={n.f} />
              <feComposite in={n.f} in2={n.o} operator="in" result={n.s} />
            </>
          ); })}
          <feMerge>
            {d.layers.map((_, k) => <feMergeNode in={fid(0, k).s} />)}
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      ))}
      <linearGradient id="u06a-inset" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--band-bg); stop-opacity: 0.45" />
        <stop offset="1" style="stop-color: var(--band-bg); stop-opacity: 0" />
      </linearGradient>
      <clipPath id="u06a-clip-btn-1"><rect x="40" y="76" width="130" height="40" rx="8" /></clipPath>
      <clipPath id="u06a-clip-fld-2"><rect x="340" y="146" width="230" height="38" rx="7" /></clipPath>
    </defs>

    {panels.map((p) => (
      <>
        <rect x={p.x} y="8" width="280" height="220" rx="10" class="panel" />
        <text x={p.x + 30} y="38" class="h"><tspan data-lang-en>{p.n.en}</tspan><tspan data-lang-vi>{p.n.vi}</tspan></text>
        {p.button === 'raised' ? (
          <>
            <rect x={p.x + 30} y="76" width="130" height="40" rx="8" class="btn" filter="url(#u06a-raised)" />
            <line x1={p.x + 38} y1="77" x2={p.x + 152} y2="77" class="hl" />
          </>
        ) : (
          <>
            <rect x={p.x + 30} y="76" width="130" height="40" rx="8" class="btn" />
            <g clip-path="url(#u06a-clip-btn-1)"><rect x={p.x + 30} y="76" width="130" height="12" fill="url(#u06a-inset)" /></g>
            <line x1={p.x + 38} y1="117.5" x2={p.x + 152} y2="117.5" class="rim" />
          </>
        )}
        <text x={p.x + 95} y="101" text-anchor="middle" class="btxt"><tspan data-lang-en>Save</tspan><tspan data-lang-vi>Lưu</tspan></text>
        {p.field === 'raised' ? (
          <>
            <rect x={p.x + 30} y="146" width="230" height="38" rx="7" class="fld" filter="url(#u06a-raised-in)" />
            <line x1={p.x + 37} y1="147" x2={p.x + 253} y2="147" class="hlf" />
          </>
        ) : (
          <>
            <rect x={p.x + 30} y="146" width="230" height="38" rx="7" class="fld" />
            <g clip-path="url(#u06a-clip-fld-2)"><rect x={p.x + 30} y="146" width="230" height="12" fill="url(#u06a-inset)" /></g>
            <line x1={p.x + 37} y1="185.5" x2={p.x + 253} y2="185.5" class="rim" />
          </>
        )}
        <text x={p.x + 44} y="170" class="m"><tspan data-lang-en>Full name</tspan><tspan data-lang-vi>Họ và tên</tspan></text>
        <text x={p.x + 30} y="212" class="m"><tspan data-lang-en>Light comes from above in both</tspan><tspan data-lang-vi>Cả hai đều có ánh sáng từ trên</tspan></text>
      </>
    ))}
  </svg>
</div>

<style>
  .qfig-uxq06litboxes { margin: 0; width: 100%; }
  .qfig-uxq06litboxes svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq06litboxes text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq06litboxes .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-uxq06litboxes .m { fill: var(--text-muted); font-size: 13px; }
  .qfig-uxq06litboxes .btxt { fill: #fff; font-weight: 700; font-size: 14px; }
  .qfig-uxq06litboxes .panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq06litboxes .btn { fill: var(--btn-primary-bg); }
  .qfig-uxq06litboxes .fld { fill: var(--card-bg); stroke: var(--border); stroke-width: 1; }
  .qfig-uxq06litboxes .hl { stroke: color-mix(in srgb, var(--btn-primary-bg) 70%, #fff); stroke-width: 1.4; stroke-linecap: round; }
  .qfig-uxq06litboxes .hlf { stroke: var(--bg); stroke-width: 1.4; stroke-linecap: round; }
  .qfig-uxq06litboxes .rim { stroke: color-mix(in srgb, var(--text) 22%, transparent); stroke-width: 1.2; stroke-linecap: round; }
</style>
