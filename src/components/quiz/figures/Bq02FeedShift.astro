---
// Quiz figure for backend REST set 03: the same newest-first feed at two moments. Left: when page 1 (the first five
// rows) was read. Right: when page 2 is requested, after three new rows landed on top. It numbers the positions
// and marks no duplicate and no result. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const before = [20, 19, 18, 17, 16, 15, 14, 13, 12, 11];
const after = [23, 22, 21, 20, 19, 18, 17, 16, 15, 14];
const Y0 = 72, H = 22;
const A = 40, B = 336, W = 210;
---
<div class="qfig-bq02fs">
  <svg viewBox="0 0 580 330" role="img" aria-label="Two views of a newest-first feed with numbered positions: when page 1 was read, the first five rows (ids 20 to 16) were shown; later, three new rows (ids 21 to 23) have landed on top and page 2 is requested with offset 5 and limit 5.">
    <text x="0" y="20" class="qfig-bq02fs-h">
      <tspan data-lang-en>The same feed at two moments</tspan>
      <tspan data-lang-vi>Cùng một feed ở hai thời điểm</tspan>
    </text>

    <text x={A} y="40" class="qfig-bq02fs-t">
      <tspan data-lang-en>Page 1 was read</tspan>
      <tspan data-lang-vi>Đã đọc trang 1</tspan>
    </text>
    <text x={A} y="57" class="qfig-bq02fs-m">offset 0, limit 5</text>
    <text x={B} y="40" class="qfig-bq02fs-t">
      <tspan data-lang-en>Page 2 is requested</tspan>
      <tspan data-lang-vi>Yêu cầu trang 2</tspan>
    </text>
    <text x={B} y="57" class="qfig-bq02fs-m">offset 5, limit 5</text>

    {before.map((id, i) => (
      <g>
        <text x={A - 8} y={Y0 + i * H + 15} text-anchor="end" class="qfig-bq02fs-m">{i + 1}</text>
        <rect x={A} y={Y0 + i * H} width={W} height={H - 3} rx="4" class={i < 5 ? 'qfig-bq02fs-seen' : 'qfig-bq02fs-row'} />
        <text x={A + 10} y={Y0 + i * H + 15} class="qfig-bq02fs-b">
          <tspan data-lang-en>comment {id}</tspan>
          <tspan data-lang-vi>bình luận {id}</tspan>
        </text>
      </g>
    ))}

    {after.map((id, i) => (
      <g>
        <text x={B - 8} y={Y0 + i * H + 15} text-anchor="end" class="qfig-bq02fs-m">{i + 1}</text>
        <rect x={B} y={Y0 + i * H} width={W} height={H - 3} rx="4" class={i < 3 ? 'qfig-bq02fs-new' : 'qfig-bq02fs-row'} />
        <text x={B + 10} y={Y0 + i * H + 15} class="qfig-bq02fs-b">
          <tspan data-lang-en>comment {id}{i < 3 ? ' (new)' : ''}</tspan>
          <tspan data-lang-vi>bình luận {id}{i < 3 ? ' (mới)' : ''}</tspan>
        </text>
      </g>
    ))}

    <text x="290" y={Y0 + 5 * H + 6} text-anchor="middle" class="qfig-bq02fs-m">
      <tspan data-lang-en>later</tspan>
      <tspan data-lang-vi>sau đó</tspan>
    </text>
    <polygon points={`296,${Y0 + 5 * H + 18} 308,${Y0 + 5 * H + 18} 308,${Y0 + 5 * H + 12} 322,${Y0 + 5 * H + 22} 308,${Y0 + 5 * H + 32} 308,${Y0 + 5 * H + 26} 296,${Y0 + 5 * H + 26}`} class="qfig-bq02fs-arrow" />
  </svg>
</div>

<style>
  .qfig-bq02fs { margin: 0; width: 100%; }
  .qfig-bq02fs svg { display: block; width: 100%; min-width: 340px; height: auto; }
  .qfig-bq02fs text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bq02fs .qfig-bq02fs-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-bq02fs .qfig-bq02fs-t { font-weight: 700; fill: var(--text); }
  .qfig-bq02fs .qfig-bq02fs-m { fill: var(--text-muted); }
  .qfig-bq02fs-row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-bq02fs-seen { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .qfig-bq02fs-new { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 5 3; }
  .qfig-bq02fs-arrow { fill: var(--text-muted); }
</style>
