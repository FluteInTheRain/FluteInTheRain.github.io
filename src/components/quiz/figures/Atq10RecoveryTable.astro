---
// Output of demo/ai-trading/p10_recovery.py (100 simulated stocks, 7 sectors, mean of 100 runs).
const rows = [
  ['Single', '0.001', '0.015', '0.904', '1.000'],
  ['Average', '0.230', '0.735', '1.000', '1.000'],
  ['Ward', '0.332', '0.831', '1.000', '1.000'],
];
---
<div class="q10t">
  <svg viewBox="0 0 580 190" role="img" aria-hidden="true">
    <text x="20" y="24" class="q10t-h">
      <tspan data-lang-en>100 simulated stocks, 7 sectors: match with the true sectors</tspan>
      <tspan data-lang-vi>100 cổ phiếu mô phỏng, 7 ngành: độ khớp với ngành thật</tspan>
    </text>
    <rect x="20" y="40" width="540" height="124" rx="8" class="q10t-box" />
    <text x="34" y="64" class="q10t-c"><tspan data-lang-en>Linkage</tspan><tspan data-lang-vi>Cách nối</tspan></text>
    <text x="190" y="64" class="q10t-c"><tspan data-lang-en>20 days</tspan><tspan data-lang-vi>20 ngày</tspan></text>
    <text x="270" y="64" class="q10t-c"><tspan data-lang-en>60 days</tspan><tspan data-lang-vi>60 ngày</tspan></text>
    <text x="360" y="64" class="q10t-c"><tspan data-lang-en>250 days</tspan><tspan data-lang-vi>250 ngày</tspan></text>
    <text x="460" y="64" class="q10t-c"><tspan data-lang-en>1000 days</tspan><tspan data-lang-vi>1000 ngày</tspan></text>
    {rows.map((r, i) => (
      <g>
        <text x="34" y={94 + i * 28} class="q10t-k">{r[0]}</text>
        <text x="190" y={94 + i * 28}>{r[1]}</text>
        <text x="270" y={94 + i * 28}>{r[2]}</text>
        <text x="360" y={94 + i * 28}>{r[3]}</text>
        <text x="460" y={94 + i * 28}>{r[4]}</text>
      </g>
    ))}
    <text x="20" y="184" class="q10t-s">
      <tspan data-lang-en>Adjusted Rand index: 1 = exact sectors, 0 = chance. Mean of 100 runs, cut at 7 groups.</tspan>
      <tspan data-lang-vi>Chỉ số Rand điều chỉnh: 1 = đúng ngành, 0 = ngẫu nhiên. Trung bình 100 lần chạy, cắt thành 7 nhóm.</tspan>
    </text>
  </svg>
</div>

<style>
  .q10t { margin: 0; width: 100%; }
  .q10t svg { display: block; width: 100%; height: auto; }
  .q10t text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .q10t .q10t-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q10t .q10t-c { font-size: 11.5px; font-weight: 700; fill: var(--text-muted); }
  .q10t .q10t-k { font-weight: 700; fill: var(--text); }
  .q10t .q10t-s { font-size: 12px; fill: var(--text-muted); }
  .q10t-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
</style>
