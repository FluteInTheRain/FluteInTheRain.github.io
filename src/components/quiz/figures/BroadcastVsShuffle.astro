---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for batch processing set 05: compares Sort-Merge Join vs Broadcast Join in Stage 1
// (500 GB events × filtered 6 MB users across 20 executors) and shows Stage 2 partition skew
// (80 MB median vs 640 MB hot partition). Does not compute totals or state AQE outcomes.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.

const W = 580;
const H = 396;

function arrowR(x1: number, x2: number, y: number) {
  return {
    line: `M ${x1} ${y} L ${x2 - 8} ${y}`,
    head: `${x2},${y} ${x2 - 9},${y - 4.5} ${x2 - 9},${y + 4.5}`,
  };
}

const aTop1 = arrowR(162, 200, 95);
const aTop2 = arrowR(396, 432, 95);
const aBot1 = arrowR(162, 200, 165);
const aBot2 = arrowR(396, 432, 165);

const barX = 166;
const maxBarW = 330; // 640 MB = 330 px
const medBarW = Math.round((80 / 640) * maxBarW);
---
<div class="qfig-bvs">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Stage 1 joins 500 GB events with users filtered from 45 MB down to 6 MB across 20 executors, comparing all-to-all Sort-Merge shuffle against copying 6 MB to each executor. Stage 2 shows 200 shuffle partitions with an 80 MB median and a 640 MB hot partition.">
    <text x="0" y="22" class="qfig-bvs-h">
      <tspan data-lang-en>Two Spark join stages across 20 executors</tspan>
      <tspan data-lang-vi>Hai bước join Spark trên 20 executor</tspan>
    </text>

    <!-- Stage 1 -->
    <text x="0" y="50" class="qfig-bvs-sub">
      <tspan data-lang-en>Stage 1: events (500 GB) × users (45 MB → 6 MB after filter)</tspan>
      <tspan data-lang-vi>Bước 1: events (500 GB) × users (45 MB → 6 MB sau khi lọc)</tspan>
    </text>

    <!-- Row 1A: Sort-Merge path -->
    <rect x="0" y="68" width="162" height="54" rx="6" class="qfig-bvs-box" />
    <DiagramIcon name="db" x={22} y={95} size={22} />
    <text x="40" y="90" class="qfig-bvs-t">events (500 GB)</text>
    <text x="40" y="109" class="qfig-bvs-m">+ users (6 MB)</text>

    <path d={aTop1.line} class="qfig-bvs-redline" />
    <polygon points={aTop1.head} class="qfig-bvs-redhead" />

    <rect x="202" y="68" width="194" height="54" rx="6" class="qfig-bvs-hotbox" />
    <DiagramIcon name="network" x={222} y={95} size={22} />
    <text x="240" y="90" class="qfig-bvs-t">
      <tspan data-lang-en>All-to-all shuffle</tspan>
      <tspan data-lang-vi>Shuffle qua mạng</tspan>
    </text>
    <text x="240" y="109" class="qfig-bvs-m">
      <tspan data-lang-en>200 partitions</tspan>
      <tspan data-lang-vi>200 phân mảnh</tspan>
    </text>

    <path d={aTop2.line} class="qfig-bvs-redline" />
    <polygon points={aTop2.head} class="qfig-bvs-redhead" />

    <rect x="434" y="68" width="146" height="54" rx="6" class="qfig-bvs-box" />
    <DiagramIcon name="spark" x={454} y={95} size={22} />
    <text x="472" y="90" class="qfig-bvs-t">Sort-Merge</text>
    <text x="472" y="109" class="qfig-bvs-m">
      <tspan data-lang-en>20 executors</tspan>
      <tspan data-lang-vi>20 executor</tspan>
    </text>

    <!-- Row 1B: Broadcast path -->
    <rect x="0" y="138" width="162" height="54" rx="6" class="qfig-bvs-box" />
    <DiagramIcon name="file" x={22} y={165} size={22} />
    <text x="40" y="160" class="qfig-bvs-t">users (6 MB)</text>
    <text x="40" y="179" class="qfig-bvs-m">
      <tspan data-lang-en>filtered side</tspan>
      <tspan data-lang-vi>bảng đã lọc</tspan>
    </text>

    <path d={aBot1.line} class="qfig-bvs-goldline" />
    <polygon points={aBot1.head} class="qfig-bvs-goldhead" />

    <rect x="202" y="138" width="194" height="54" rx="6" class="qfig-bvs-goldbox" />
    <DiagramIcon name="server" x={222} y={165} size={22} />
    <text x="240" y="160" class="qfig-bvs-t">
      <tspan data-lang-en>Copy to 20 nodes</tspan>
      <tspan data-lang-vi>Chép tới 20 node</tspan>
    </text>
    <text x="240" y="179" class="qfig-bvs-m">
      <tspan data-lang-en>events stays local</tspan>
      <tspan data-lang-vi>events giữ tại chỗ</tspan>
    </text>

    <path d={aBot2.line} class="qfig-bvs-goldline" />
    <polygon points={aBot2.head} class="qfig-bvs-goldhead" />

    <rect x="434" y="138" width="146" height="54" rx="6" class="qfig-bvs-box" />
    <DiagramIcon name="spark" x={454} y={165} size={22} />
    <text x="472" y="160" class="qfig-bvs-t">Broadcast</text>
    <text x="472" y="179" class="qfig-bvs-m">
      <tspan data-lang-en>20 executors</tspan>
      <tspan data-lang-vi>20 executor</tspan>
    </text>

    <!-- Divider -->
    <line x1="0" x2={W} y1="212" y2="212" class="qfig-bvs-rule" />

    <!-- Stage 2 -->
    <text x="0" y="238" class="qfig-bvs-sub">
      <tspan data-lang-en>Stage 2: events × orders (200 shuffle partitions)</tspan>
      <tspan data-lang-vi>Bước 2: events × orders (200 phân mảnh shuffle)</tspan>
    </text>

    <text x="0" y="275" class="qfig-bvs-t">
      <tspan data-lang-en>Median partition</tspan>
      <tspan data-lang-vi>Phân mảnh trung vị</tspan>
    </text>
    <rect x={barX} y="258" width={medBarW} height="24" rx="4" class="qfig-bvs-medbar" />
    <text x={barX + medBarW + 10} y="275" class="qfig-bvs-t">80 MB</text>

    <text x="0" y="317" class="qfig-bvs-t">
      <tspan data-lang-en>Skewed partition</tspan>
      <tspan data-lang-vi>Phân mảnh lệch</tspan>
    </text>
    <rect x={barX} y="300" width={maxBarW} height="24" rx="4" class="qfig-bvs-hotbar" />
    <text x={barX + maxBarW + 10} y="317" class="qfig-bvs-hot">640 MB</text>

    <text x="0" y="356" class="qfig-bvs-m">
      <tspan data-lang-en>Stage 1 shrinks users from 45 MB to 6 MB after the active-account filter.</tspan>
      <tspan data-lang-vi>Bước 1 lọc tài khoản active thu gọn bảng users từ 45 MB xuống 6 MB.</tspan>
    </text>
    <text x="0" y="376" class="qfig-bvs-m">
      <tspan data-lang-en>AI adds SortMergeJoin hints everywhere and sets spark.sql.adaptive.enabled = false.</tspan>
      <tspan data-lang-vi>AI gắn hint SortMergeJoin cho mọi bước và tắt spark.sql.adaptive.enabled = false.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-bvs { margin: 0; width: 100%; }
  .qfig-bvs svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-bvs text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bvs .qfig-bvs-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-bvs .qfig-bvs-sub { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .qfig-bvs .qfig-bvs-t { font-weight: 600; fill: var(--text); }
  .qfig-bvs .qfig-bvs-m { fill: var(--text-muted); }
  .qfig-bvs .qfig-bvs-hot { font-weight: 700; fill: var(--red); }
  .qfig-bvs-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-bvs-hotbox { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .qfig-bvs-goldbox { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-bvs-medbar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-bvs-hotbar { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-bvs-redline { stroke: var(--red); stroke-width: 2.4; fill: none; }
  .qfig-bvs-redhead { fill: var(--red); }
  .qfig-bvs-goldline { stroke: var(--gold); stroke-width: 2; fill: none; }
  .qfig-bvs-goldhead { fill: var(--gold); }
  .qfig-bvs-rule { stroke: var(--border); stroke-width: 1; }
</style>
