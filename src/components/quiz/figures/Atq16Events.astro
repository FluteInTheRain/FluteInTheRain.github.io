---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 04: five events at the best queues in one window. Bid: +300, -200. Ask: +100, -250, -150.
const rows = [
  { cls: 'bid', v: 300, en: 'Bid queue ▲ add 300', vi: 'Hàng chờ bid ▲ thêm 300' },
  { cls: 'bid', v: 200, en: 'Bid queue ▼ market sell 200', vi: 'Hàng chờ bid ▼ bán thị trường 200' },
  { cls: 'ask', v: 100, en: 'Ask queue ▲ add 100', vi: 'Hàng chờ ask ▲ thêm 100' },
  { cls: 'ask', v: 250, en: 'Ask queue ▼ cancel 250', vi: 'Hàng chờ ask ▼ huỷ 250' },
  { cls: 'ask', v: 150, en: 'Ask queue ▼ market buy 150', vi: 'Hàng chờ ask ▼ mua thị trường 150' },
];
---
<div class="q16">
  <svg viewBox="0 0 580 290" role="img" aria-hidden="true">
    <DiagramIcon name="stack" x={22} y={20} size={22} />
    <text x="44" y="25" class="t-h"><tspan data-lang-en>Events at the best queues in one window</tspan><tspan data-lang-vi>Các sự kiện ở hàng chờ tốt nhất trong một cửa sổ</tspan></text>
    {rows.map((r, i) => (
      <g>
        <text x="30" y={72 + i * 40} class="t-b"><tspan data-lang-en>{r.en}</tspan><tspan data-lang-vi>{r.vi}</tspan></text>
        <rect x="320" y={54 + i * 40} width={r.v * 0.8} height="26" rx="4" class={r.cls} />
      </g>
    ))}
    <text x="30" y="272" class="t-s"><tspan data-lang-en>Bar length is proportional to the shares. The best prices do not move.</tspan><tspan data-lang-vi>Độ dài cột tỉ lệ với số cổ phiếu. Giá tốt nhất không đổi.</tspan></text>
  </svg>
</div>

<style>
  .q16 { margin: 0; width: 100%; }
  .q16 svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .q16 text { font-size: 13px; fill: var(--text-body); }
  .q16 .t-h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .q16 .t-s { font-size: 12px; fill: var(--text-muted); }
  .q16 .t-b { font-size: 13px; font-weight: 600; fill: var(--text); }
  .q16 .t-gold { font-weight: 700; fill: var(--gold-icon); }
  .q16 .ask { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; }
  .q16 .bid { fill: color-mix(in srgb, var(--act-2) 16%, var(--bg)); stroke: var(--act-2); stroke-width: 1.3; }
  .q16 .mid { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.3; }
  .q16 .empty { fill: none; stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .q16 .midline { stroke: var(--gold); stroke-width: 1.6; stroke-dasharray: 6 4; fill: none; }
  .q16 .axis { stroke: var(--border); stroke-width: 1.4; }
  .q16 .grid { stroke: var(--border); stroke-width: 1; stroke-dasharray: 3 4; }
  .q16 .path { stroke: var(--text); stroke-width: 2; fill: none; }
</style>
