---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend request-lifecycle set 05: three requests from one caller at 0 s, 3 s and 10 s, and the
// 5 s idle timer that starts after each one. It shows the timers only, never which request pays a handshake.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const X0 = 70, X1 = 556, MAX = 15;
const px = (s: number) => X0 + (s * (X1 - X0)) / MAX;
const reqs = [{ s: 0, n: 1 }, { s: 3, n: 2 }, { s: 10, n: 3 }];
const timers = [{ from: 0, y: 112 }, { from: 3, y: 138 }, { from: 10, y: 112 }];
const AX = 192;
---
<div class="qfig-bq01ig">
  <svg viewBox="0 0 580 230" role="img" aria-label="A timeline from 0 to 15 seconds: one caller sends request 1 at 0 seconds, request 2 at 3 seconds and request 3 at 10 seconds, and after each request the server starts a 5 second idle timer.">
    <text x="0" y="20" class="qfig-bq01ig-h">
      <tspan data-lang-en>One caller, three requests</tspan>
      <tspan data-lang-vi>Một bên gọi, ba request</tspan>
    </text>

    <DiagramIcon name="laptop" x="14" y="62" size={26} />
    <line x1={X0} x2={X1} y1="62" y2="62" class="qfig-bq01ig-rule" />
    <text x="0" y="90" class="qfig-bq01ig-m">
      <tspan data-lang-en>Server idle timer</tspan>
      <tspan data-lang-vi>Bộ đếm rảnh của server</tspan>
    </text>

    {timers.map((t) => (
      <g>
        <rect x={px(t.from)} y={t.y - 10} width={px(t.from + 5) - px(t.from)} height="18" rx="4" class="qfig-bq01ig-timer" />
        <text x={px(t.from) + 8} y={t.y + 3} class="qfig-bq01ig-t">
          <tspan data-lang-en>5 s</tspan>
          <tspan data-lang-vi>5 s</tspan>
        </text>
      </g>
    ))}

    {reqs.map((r) => (
      <g>
        <line x1={px(r.s)} x2={px(r.s)} y1="62" y2={AX} class="qfig-bq01ig-drop" />
        <circle cx={px(r.s)} cy="62" r="10" class="qfig-bq01ig-badge" />
        <text x={px(r.s)} y="66.5" text-anchor="middle" class="qfig-bq01ig-n">{r.n}</text>
      </g>
    ))}

    <line x1={X0} x2={X1} y1={AX} y2={AX} class="qfig-bq01ig-axis" />
    {[0, 5, 10, 15].map((s) => (
      <g>
        <line x1={px(s)} x2={px(s)} y1={AX - 4} y2={AX + 4} class="qfig-bq01ig-axis" />
        <text x={px(s)} y={AX + 22} text-anchor={s === 15 ? 'end' : 'middle'} class="qfig-bq01ig-m">{s} s</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-bq01ig { margin: 0; width: 100%; }
  .qfig-bq01ig svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-bq01ig text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bq01ig .qfig-bq01ig-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-bq01ig .qfig-bq01ig-t { font-weight: 700; fill: var(--text); }
  .qfig-bq01ig .qfig-bq01ig-m { fill: var(--text-muted); }
  .qfig-bq01ig .qfig-bq01ig-n { font-size: 12px; font-weight: 700; fill: var(--text); }
  .qfig-bq01ig-rule { stroke: var(--border); stroke-width: 2; }
  .qfig-bq01ig-drop { stroke: var(--border); stroke-width: 1.5; stroke-dasharray: 4 4; }
  .qfig-bq01ig-axis { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-bq01ig-badge { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-bq01ig-timer { fill: var(--bg-alt); stroke: var(--act-2); stroke-width: 1.5; }
</style>
