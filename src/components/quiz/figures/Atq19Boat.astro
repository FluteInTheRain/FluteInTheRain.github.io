---
// Set 01: CoastRunners. Human average score 100 (index), agent about 120 ("about 20 percent higher", OpenAI 2016); laps finished: agent none.
const W = 580;
const H = 230;
---
<div class="q19b">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <text x="14" y="24" class="q19b-h"><tspan data-lang-en>Score and race result, CoastRunners</tspan><tspan data-lang-vi>Điểm số và kết quả đua, CoastRunners</tspan></text>
    <text x="14" y="62" class="q19b-l"><tspan data-lang-en>Human players</tspan><tspan data-lang-vi>Người chơi</tspan></text>
    <rect x="150" y="46" width="250" height="26" rx="4" class="q19b-bar" />
    <text x="410" y="65" class="q19b-n">100</text>
    <text x="14" y="108" class="q19b-l"><tspan data-lang-en>RL agent</tspan><tspan data-lang-vi>Agent RL</tspan></text>
    <rect x="150" y="92" width="300" height="26" rx="4" class="q19b-bar hot" />
    <text x="460" y="111" class="q19b-n">≈ 120</text>
    <text x="14" y="160" class="q19b-s"><tspan data-lang-en>Score index: human average = 100 (agent about 20% higher)</tspan><tspan data-lang-vi>Chỉ số điểm: trung bình người = 100 (agent cao hơn khoảng 20%)</tspan></text>
    <rect x="14" y="176" width="552" height="40" rx="8" class="q19b-note" />
    <text x="28" y="201" class="q19b-n2"><tspan data-lang-en>Laps finished by the agent: 0</tspan><tspan data-lang-vi>Số vòng agent hoàn thành: 0</tspan></text>
  </svg>
</div>
<style>
  .q19b { margin: 0; width: 100%; }
  .q19b svg { display: block; width: 100%; height: auto; }
  .q19b text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .q19b .q19b-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q19b .q19b-l { font-weight: 600; fill: var(--text); }
  .q19b .q19b-n { font-weight: 700; fill: var(--text); }
  .q19b .q19b-s { font-size: 12.5px; fill: var(--text-muted); }
  .q19b .q19b-n2 { font-weight: 700; fill: var(--red); }
  .q19b .q19b-bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .q19b .q19b-bar.hot { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .q19b .q19b-note { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
</style>
