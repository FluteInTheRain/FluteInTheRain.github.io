---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for set 01: an append-only log drawn as a notebook. Lines are only ever added at the bottom;
// a reader starts at the top. Shows the scenario's inputs, never an answer or a computed result.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const rows = [
  { k: 'ana', v: '555-0101' },
  { k: 'bao', v: '555-0202' },
  { k: 'ana', v: '555-0199' },
  { k: 'cuong', v: '555-0303' },
  { k: 'dung', v: '555-0404' },
];
const top = 62;
const rh = 40;
const nbBottom = top + rows.length * rh + 6;
---
<div class="qfig-nb">
  <svg viewBox="0 0 580 376" role="img" aria-label="A log file drawn as a notebook page with five lines of key and value, a reader who starts at the top line, and the size of the whole file.">
    <text x="0" y="22" class="qfig-nb-h">
      <tspan data-lang-en>contacts.log: one key and value per line</tspan>
      <tspan data-lang-vi>contacts.log: mỗi dòng một khoá và giá trị</tspan>
    </text>

    <rect x="0" y="36" width="370" height={nbBottom - 36} rx="8" class="qfig-nb-page" />
    <text x="14" y="55" class="qfig-nb-m">
      <tspan data-lang-en>line</tspan>
      <tspan data-lang-vi>dòng</tspan>
    </text>
    <text x="64" y="55" class="qfig-nb-m">
      <tspan data-lang-en>key</tspan>
      <tspan data-lang-vi>khoá</tspan>
    </text>
    <text x="164" y="55" class="qfig-nb-m">
      <tspan data-lang-en>value</tspan>
      <tspan data-lang-vi>giá trị</tspan>
    </text>

    {rows.map((r, i) => (
      <g>
        <line x1="10" x2="360" y1={top + i * rh} y2={top + i * rh} class="qfig-nb-rule" />
        <text x="14" y={top + i * rh + 26} class="qfig-nb-m">{i + 1}</text>
        <text x="64" y={top + i * rh + 26} class="qfig-nb-k">{r.k}</text>
        <text x="164" y={top + i * rh + 26} class="qfig-nb-v">{r.v}</text>
      </g>
    ))}

    <DiagramIcon name="user" x="470" y={top + 20} size={30} />
    <polygon points={`376,${top + 20} 392,${top + 13} 392,${top + 27}`} class="qfig-nb-eye" />
    <path d={`M 450 ${top + 20} L 394 ${top + 20}`} class="qfig-nb-eyeline" />
    <text x="430" y={top + 58} class="qfig-nb-t">
      <tspan data-lang-en>Reader starts</tspan>
      <tspan data-lang-vi>Người đọc bắt đầu</tspan>
    </text>
    <text x="430" y={top + 78} class="qfig-nb-t">
      <tspan data-lang-en>at the top line</tspan>
      <tspan data-lang-vi>từ dòng trên cùng</tspan>
    </text>

    <g class="qfig-nb-box">
      <rect x="0" y="298" width="580" height="64" rx="8" />
      <DiagramIcon name="disk" x="28" y="330" size={26} />
      <text x="58" y="326" class="qfig-nb-t">
        <tspan data-lang-en>Whole file: 10,000,000 lines of 100 bytes</tspan>
        <tspan data-lang-vi>Cả file: 10.000.000 dòng, mỗi dòng 100 byte</tspan>
      </text>
      <text x="58" y="348" class="qfig-nb-m">
        <tspan data-lang-en>The disk reads 500 MB per second</tspan>
        <tspan data-lang-vi>Ổ đĩa đọc 500 MB mỗi giây</tspan>
      </text>
    </g>
  </svg>
</div>

<style>
  .qfig-nb { margin: 0; width: 100%; }
  .qfig-nb svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-nb text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-nb .qfig-nb-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-nb .qfig-nb-m { fill: var(--text-muted); }
  .qfig-nb .qfig-nb-k { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-nb .qfig-nb-v { font-size: 16px; fill: var(--text-body); }
  .qfig-nb .qfig-nb-t { font-weight: 600; fill: var(--text); }
  .qfig-nb-page { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-nb-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-nb-eye { fill: var(--text-muted); }
  .qfig-nb-eyeline { stroke: var(--text-muted); stroke-width: 1.8; fill: none; stroke-dasharray: 5 4; }
  .qfig-nb-box rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
</style>
