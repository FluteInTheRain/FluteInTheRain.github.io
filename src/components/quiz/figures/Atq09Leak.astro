---
// Quiz figure, set 07: permutation importance (drop in test R-squared), honest model versus model with a leaked column.
const W = 580;
const H = 330;
const X0 = 150, S = 300;
const clean = [
  { en: '12-month momentum', vi: 'Momentum 12 tháng', v: 0.0634 },
  { en: 'value', vi: 'value', v: 0.0229 },
  { en: 'volatility', vi: 'biến động', v: 0.0181 },
];
const leak = [
  { en: '12-month momentum', vi: 'Momentum 12 tháng', v: 0.0152 },
  { en: 'value', vi: 'value', v: 0.0048 },
  { en: 'volatility', vi: 'biến động', v: 0.0035 },
  { en: 'added column', vi: 'cột thêm vào', v: 1.1046, key: true },
];
const f = (n: number) => n.toFixed(4);
const fv = (n: number) => f(n).replace('.', ',');
const bw = (v: number) => Math.max(1, v * 0.36 * S);
---
<div class="qd9l">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <text x="16" y="24" class="h">
      <tspan data-lang-en>Drop in test R² when a column is shuffled</tspan>
      <tspan data-lang-vi>R² kiểm tra tụt bao nhiêu khi xáo trộn một cột</tspan>
    </text>
    <rect x="16" y="38" width="548" height="106" rx="8" class="card" />
    <text x="30" y="60" class="t">
      <tspan data-lang-en>Honest features. Test R² 0.0248</tspan>
      <tspan data-lang-vi>Feature trung thực. R² kiểm tra 0,0248</tspan>
    </text>
    {clean.map((r, i) => (
      <g>
        <text x="30" y={86 + i * 20} class="lab">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <rect x={X0 + 24} y={75 + i * 20} width={bw(r.v)} height="12" class="bar" />
        <text x={X0 + 24 + bw(r.v) + 6} y={86 + i * 20} class="val">
          <tspan data-lang-en>{f(r.v)}</tspan>
          <tspan data-lang-vi>{fv(r.v)}</tspan>
        </text>
      </g>
    ))}
    <rect x="16" y="156" width="548" height="150" rx="8" class="card is-key" />
    <text x="30" y="178" class="t">
      <tspan data-lang-en>One column added. Test R² 0.5888</tspan>
      <tspan data-lang-vi>Thêm một cột. R² kiểm tra 0,5888</tspan>
    </text>
    {leak.map((r, i) => (
      <g>
        <text x="30" y={204 + i * 24} class={r.key ? 'lab is-key' : 'lab'}>
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <rect x={X0 + 24} y={193 + i * 24} width={bw(r.v)} height="12" class={r.key ? 'bar is-key' : 'bar'} />
        <text x={X0 + 24 + bw(r.v) + 6} y={204 + i * 24} class={r.key ? 'val is-key' : 'val'}>
          <tspan data-lang-en>{f(r.v)}</tspan>
          <tspan data-lang-vi>{fv(r.v)}</tspan>
        </text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qd9l { margin: 0; width: 100%; }
  .qd9l svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .qd9l text { font-size: 13px; fill: var(--text-body); }
  .qd9l .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qd9l .t { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qd9l .lab { fill: var(--text); }
  .qd9l .lab.is-key { font-weight: 700; fill: var(--red); }
  .qd9l .val { font-size: 12px; font-weight: 700; fill: var(--text-muted); }
  .qd9l .val.is-key { fill: var(--red); }
  .qd9l .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qd9l .card.is-key { stroke: var(--red); stroke-width: 1.8; }
  .qd9l .bar { fill: var(--act-2); }
  .qd9l .bar.is-key { fill: var(--red); }
</style>
