---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for distributed-systems set 02: GitHub's Oct 21, 2018 43-second optical cut.
// Shows the 3 sites during the cut (East DC isolated, East Cloud + West DC forming a Raft majority quorum)
// and the cross-country 60 ms app traffic + divergent East/West writes after recovery.
// Inline SVG, site tokens only, no SVG markers, patterns, filters, clip paths, or id attributes.
function arrowR(x1: number, x2: number, y: number) {
  return {
    line: `M ${x1} ${y} L ${x2 - 7} ${y}`,
    head: `${x2},${y} ${x2 - 9},${y - 4.5} ${x2 - 9},${y + 4.5}`,
  };
}
const appToWest = arrowR(138, 228, 294);
---
<div class="qfig-gh43">
  <svg viewBox="0 0 580 404" role="img" aria-label="During a 43-second optical link cut, US East DC is isolated while Orchestrator Raft nodes in US East public cloud and US West DC form a majority quorum and promote West MySQL primaries. After the link returns, East apps write to West primaries over a link labeled 60 ms while East still holds earlier unreplicated writes.">
    <text x="10" y="22" class="qfig-gh43-h">
      <tspan data-lang-en>GitHub, Oct 21, 2018: 43-second optical cut</tspan>
      <tspan data-lang-vi>GitHub, 21/10/2018: 43 giây đứt tuyến quang</tspan>
    </text>

    <!-- Zone 1: During the cut -->
    <rect x="10" y="42" width="194" height="156" rx="8" class="qfig-gh43-cut" />
    <DiagramIcon name="db" x={34} y={66} size={22} />
    <text x="52" y="71" class="qfig-gh43-name">
      <tspan data-lang-en>US East DC</tspan>
      <tspan data-lang-vi>Data center US East</tspan>
    </text>
    <text x="22" y="96" class="qfig-gh43-m">
      <tspan data-lang-en>MySQL primaries</tspan>
      <tspan data-lang-vi>Primary MySQL</tspan>
    </text>
    <text x="22" y="114" class="qfig-gh43-m">
      <tspan data-lang-en>Orchestrator node(s)</tspan>
      <tspan data-lang-vi>Node Orchestrator</tspan>
    </text>
    <text x="22" y="140" class="qfig-gh43-red">
      <tspan data-lang-en>Cut off for 43 s</tspan>
      <tspan data-lang-vi>Bị cắt 43 giây</tspan>
    </text>
    <text x="22" y="166" class="qfig-gh43-m">
      <tspan data-lang-en>Holds unreplicated</tspan>
      <tspan data-lang-vi>Còn đoạn ghi</tspan>
    </text>
    <text x="22" y="183" class="qfig-gh43-m">
      <tspan data-lang-en>writes from before cut</tspan>
      <tspan data-lang-vi>chưa sao chép kịp</tspan>
    </text>

    <!-- Link cut symbol -->
    <line x1="204" x2="256" y1="120" y2="120" class="qfig-gh43-reddash" />
    <path d="M 223 113 L 237 127 M 223 127 L 237 113" class="qfig-gh43-redx" />
    <text x="230" y="102" text-anchor="middle" class="qfig-gh43-red">43 s</text>

    <!-- Majority quorum enclosure -->
    <rect x="256" y="42" width="314" height="156" rx="8" class="qfig-gh43-quorum" />
    <text x="268" y="61" class="qfig-gh43-goldt">
      <tspan data-lang-en>Raft majority quorum (Orchestrator)</tspan>
      <tspan data-lang-vi>Quorum quá bán Raft (Orchestrator)</tspan>
    </text>

    <rect x="268" y="72" width="290" height="52" rx="6" class="qfig-gh43-box" />
    <DiagramIcon name="cloud" x={290} y={98} size={22} />
    <text x="310" y="94" class="qfig-gh43-t">
      <tspan data-lang-en>US East public cloud</tspan>
      <tspan data-lang-vi>Public cloud US East</tspan>
    </text>
    <text x="310" y="112" class="qfig-gh43-m">
      <tspan data-lang-en>Orchestrator · reaches West</tspan>
      <tspan data-lang-vi>Orchestrator · nối được tới West</tspan>
    </text>

    <rect x="268" y="134" width="290" height="54" rx="6" class="qfig-gh43-box" />
    <DiagramIcon name="db" x={290} y={161} size={22} />
    <text x="310" y="157" class="qfig-gh43-t">
      <tspan data-lang-en>US West DC</tspan>
      <tspan data-lang-vi>Data center US West</tspan>
    </text>
    <text x="310" y="175" class="qfig-gh43-m">
      <tspan data-lang-en>Promoted to MySQL primary</tspan>
      <tspan data-lang-vi>Được nâng lên primary MySQL</tspan>
    </text>

    <!-- Zone 2: After link returns -->
    <line x1="10" x2="570" y1="216" y2="216" class="qfig-gh43-rule" />
    <text x="10" y="238" class="qfig-gh43-name">
      <tspan data-lang-en>After link returns: writes split across coasts</tspan>
      <tspan data-lang-vi>Khi nối lại: lệnh ghi chia hai bờ nước Mỹ</tspan>
    </text>

    <rect x="10" y="252" width="128" height="84" rx="8" class="qfig-gh43-box" />
    <DiagramIcon name="laptop" x={32} y={276} size={20} />
    <text x="48" y="281" class="qfig-gh43-t">
      <tspan data-lang-en>East apps</tspan>
      <tspan data-lang-vi>App East</tspan>
    </text>
    <text x="20" y="305" class="qfig-gh43-m">
      <tspan data-lang-en>send writes to</tspan>
      <tspan data-lang-vi>gửi lệnh ghi tới</tspan>
    </text>
    <text x="20" y="322" class="qfig-gh43-m">
      <tspan data-lang-en>West primary</tspan>
      <tspan data-lang-vi>primary West</tspan>
    </text>

    <path d={appToWest.line} class="qfig-gh43-goldln" />
    <polygon points={appToWest.head} class="qfig-gh43-goldhd" />
    <text x="183" y="282" text-anchor="middle" class="qfig-gh43-goldt">60 ms</text>
    <text x="183" y="313" text-anchor="middle" class="qfig-gh43-m">
      <tspan data-lang-en>cross-country</tspan>
      <tspan data-lang-vi>xuyên nước</tspan>
    </text>

    <rect x="228" y="252" width="156" height="84" rx="8" class="qfig-gh43-box" />
    <DiagramIcon name="db" x={250} y={276} size={20} />
    <text x="266" y="281" class="qfig-gh43-t">
      <tspan data-lang-en>West primaries</tspan>
      <tspan data-lang-vi>Primary West</tspan>
    </text>
    <text x="238" y="305" class="qfig-gh43-m">
      <tspan data-lang-en>take new writes</tspan>
      <tspan data-lang-vi>nhận lệnh ghi mới</tspan>
    </text>
    <text x="238" y="322" class="qfig-gh43-m">
      <tspan data-lang-en>after link returns</tspan>
      <tspan data-lang-vi>sau khi nối lại</tspan>
    </text>

    <text x="399" y="301" text-anchor="middle" class="qfig-gh43-neq">≠</text>

    <rect x="414" y="252" width="156" height="84" rx="8" class="qfig-gh43-cut" />
    <DiagramIcon name="db" x={436} y={276} size={20} />
    <text x="452" y="281" class="qfig-gh43-t">
      <tspan data-lang-en>East primaries</tspan>
      <tspan data-lang-vi>Primary East</tspan>
    </text>
    <text x="424" y="305" class="qfig-gh43-red">
      <tspan data-lang-en>hold earlier writes</tspan>
      <tspan data-lang-vi>giữ lệnh ghi cũ</tspan>
    </text>
    <text x="424" y="322" class="qfig-gh43-m">
      <tspan data-lang-en>from the 43 s cut</tspan>
      <tspan data-lang-vi>từ lúc đứt 43 giây</tspan>
    </text>

    <text x="10" y="365" class="qfig-gh43-m">
      <tspan data-lang-en>GitHub kept data integrity, restored affected East clusters from</tspan>
      <tspan data-lang-vi>GitHub chọn bảo toàn dữ liệu, dựng lại các cụm East bị ảnh hưởng</tspan>
    </text>
    <text x="10" y="384" class="qfig-gh43-m">
      <tspan data-lang-en>backups, and ran degraded for 24 hours and 11 minutes.</tspan>
      <tspan data-lang-vi>từ bản backup và chạy suy giảm suốt 24 giờ 11 phút.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gh43 { margin: 0; width: 100%; }
  .qfig-gh43 svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gh43 text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gh43 .qfig-gh43-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gh43 .qfig-gh43-name { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .qfig-gh43 .qfig-gh43-t { font-weight: 600; fill: var(--text); }
  .qfig-gh43 .qfig-gh43-m { font-size: 13px; fill: var(--text-muted); }
  .qfig-gh43 .qfig-gh43-red { font-weight: 700; fill: var(--red); }
  .qfig-gh43 .qfig-gh43-goldt { font-weight: 700; fill: var(--gold-icon); }
  .qfig-gh43 .qfig-gh43-neq { font-size: 22px; font-weight: 700; fill: var(--red); }
  .qfig-gh43-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .qfig-gh43-cut { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .qfig-gh43-quorum { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; stroke-dasharray: 5 3; }
  .qfig-gh43-reddash { fill: none; stroke: var(--red); stroke-width: 1.6; stroke-dasharray: 4 3; }
  .qfig-gh43-redx { fill: none; stroke: var(--red); stroke-width: 2.2; }
  .qfig-gh43-goldln { fill: none; stroke: var(--gold-icon); stroke-width: 2; }
  .qfig-gh43-goldhd { fill: var(--gold-icon); }
  .qfig-gh43-rule { stroke: var(--border); stroke-width: 1.2; }
</style>
