---
// Numbers of the post's simulated 12-stock market (Python numpy seeds 5 and 6, 250 days).
const rows = [
  { en: 'Calm run', vi: 'Lần chạy êm', v: ['0.19', '18', '3', '12.16'] },
  { en: 'Crash run', vi: 'Lần chạy sụp đổ', v: ['0.54', '66', '1', '9.22'] },
];
const xs = [215, 305, 395, 495];
---
<div class="q11r">
  <svg viewBox="0 0 580 170" role="img" aria-hidden="true">
    <text x="20" y="24" class="q11r-h"><tspan data-lang-en>Simulated market: 12 stocks, 3 sectors, 250 days</tspan><tspan data-lang-vi>Thị trường mô phỏng: 12 mã, 3 ngành, 250 ngày</tspan></text>
    <rect x="20" y="40" width="540" height="100" rx="8" class="q11r-b" />
    <text x={xs[0]} y="62" text-anchor="end" class="q11r-c"><tspan data-lang-en>mean ρ</tspan><tspan data-lang-vi>ρ trung bình</tspan></text>
    <text x={xs[1] + 30} y="62" text-anchor="end" class="q11r-c"><tspan data-lang-en>links at ρ ≥ 0.30</tspan><tspan data-lang-vi>cạnh ở ρ ≥ 0,30</tspan></text>
    <text x={xs[2] + 40} y="62" text-anchor="end" class="q11r-c"><tspan data-lang-en>groups</tspan><tspan data-lang-vi>nhóm</tspan></text>
    <text x={xs[3] + 50} y="62" text-anchor="end" class="q11r-c"><tspan data-lang-en>tree length</tspan><tspan data-lang-vi>độ dài cây</tspan></text>
    {rows.map((r, i) => (
      <g>
        <text x="34" y={94 + i * 34} class="q11r-k"><tspan data-lang-en>{r.en}</tspan><tspan data-lang-vi>{r.vi}</tspan></text>
        <text x={xs[0]} y={94 + i * 34} text-anchor="end">{r.v[0]}</text>
        <text x={xs[1] + 30} y={94 + i * 34} text-anchor="end">{r.v[1]}</text>
        <text x={xs[2] + 40} y={94 + i * 34} text-anchor="end">{r.v[2]}</text>
        <text x={xs[3] + 50} y={94 + i * 34} text-anchor="end">{r.v[3]}</text>
      </g>
    ))}
    <text x="20" y="162" class="q11r-s"><tspan data-lang-en>Both runs use the same 12 stocks and the same cut-off.</tspan><tspan data-lang-vi>Hai lần chạy dùng cùng 12 mã và cùng mức cắt.</tspan></text>
  </svg>
</div>
<style>
  .q11r { margin: 0; width: 100%; }
  .q11r svg { display: block; width: 100%; height: auto; }
  .q11r text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .q11r .q11r-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q11r .q11r-c { font-size: 11.5px; font-weight: 700; fill: var(--text-muted); }
  .q11r .q11r-k { font-weight: 700; fill: var(--text); }
  .q11r .q11r-s { font-size: 12px; fill: var(--text-muted); }
  .q11r-b { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
</style>
