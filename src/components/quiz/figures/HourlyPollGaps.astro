---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for stream set 02: one product row edited three times between two hourly polls,
// next to the change log of the same database. Shows only what happens, not what the poll delivers.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const x0 = 60;
const px = 8; // pixels per minute
const tx = (m: number) => x0 + m * px;
const edits = [
  { m: 3, v: 9 },
  { m: 20, v: 4 },
  { m: 41, v: 0 },
];
const ticks = [0, 10, 20, 30, 40, 50, 60];
const yA = 86;
const yB = 204;
const yC = 308;
const axisY = 340;
---
<div class="qfig-poll">
  <svg viewBox="0 0 580 372" role="img" aria-label="Three lanes on a 0 to 60 minute axis: product 7 has its stock edited to 9 at minute 3, to 4 at minute 20 and to 0 at minute 41; an hourly poll runs at minute 0 and minute 60; the change log records one entry per commit.">
    <text x="0" y="20" class="qfig-poll-h">
      <tspan data-lang-en>One product row between two polls</tspan>
      <tspan data-lang-vi>Một dòng sản phẩm giữa hai lần poll</tspan>
    </text>

    <!-- lane A: the row -->
    <DiagramIcon name="mysql" x="12" y="44" size={22} />
    <text x="34" y="49" class="qfig-poll-lane">
      <tspan data-lang-en>MySQL shard: stock of product 7</tspan>
      <tspan data-lang-vi>Shard MySQL: stock của sản phẩm 7</tspan>
    </text>
    <line x1={tx(0)} x2={tx(60)} y1={yA} y2={yA} class="qfig-poll-rule" />
    {edits.map((e) => (
      <g>
        <circle cx={tx(e.m)} cy={yA} r="7" class="qfig-poll-edit" />
        <text x={tx(e.m)} y={yA + 26} text-anchor="middle" class="qfig-poll-m">
          <tspan data-lang-en>minute {e.m}</tspan>
          <tspan data-lang-vi>phút {e.m}</tspan>
        </text>
        <text x={tx(e.m)} y={yA + 44} text-anchor="middle" class="qfig-poll-t">stock {e.v}</text>
      </g>
    ))}

    <!-- lane B: the poll -->
    <DiagramIcon name="clock" x="12" y="162" size={22} />
    <text x="34" y="167" class="qfig-poll-lane">
      <tspan data-lang-en>Hourly poll: updated_at &gt; last run</tspan>
      <tspan data-lang-vi>Poll mỗi giờ: updated_at &gt; lần chạy trước</tspan>
    </text>
    <line x1={tx(0) + 10} x2={tx(60) - 10} y1={yB} y2={yB} class="qfig-poll-gap" />
    <polygon points={`${tx(0) + 10},${yB} ${tx(0) + 19},${yB - 4.5} ${tx(0) + 19},${yB + 4.5}`} class="qfig-poll-gaphead" />
    <polygon points={`${tx(60) - 10},${yB} ${tx(60) - 19},${yB - 4.5} ${tx(60) - 19},${yB + 4.5}`} class="qfig-poll-gaphead" />
    <text x={tx(30)} y={yB - 10} text-anchor="middle" class="qfig-poll-red">
      <tspan data-lang-en>up to an hour between polls</tspan>
      <tspan data-lang-vi>cách nhau tới một giờ</tspan>
    </text>
    {[0, 60].map((m) => (
      <g>
        <circle cx={tx(m)} cy={yB} r="7" class="qfig-poll-run" />
        <text x={tx(m)} y={yB + 26} text-anchor={m === 0 ? 'start' : 'end'} class="qfig-poll-m">
          <tspan data-lang-en>poll at minute {m}</tspan>
          <tspan data-lang-vi>poll lúc phút {m}</tspan>
        </text>
      </g>
    ))}

    <!-- lane C: the change log -->
    <DiagramIcon name="log" x="12" y="266" size={22} />
    <text x="34" y="271" class="qfig-poll-lane">
      <tspan data-lang-en>Change log (binlog): one entry per commit</tspan>
      <tspan data-lang-vi>Change log (binlog): mỗi commit một bản ghi</tspan>
    </text>
    <line x1={tx(0)} x2={tx(60)} y1={yC} y2={yC} class="qfig-poll-rule" />
    {edits.map((e) => (
      <rect x={tx(e.m) - 5} y={yC - 10} width="10" height="20" rx="2" class="qfig-poll-entry" />
    ))}

    <!-- axis -->
    <line x1={tx(0)} x2={tx(60)} y1={axisY} y2={axisY} class="qfig-poll-axis" />
    {ticks.map((m) => (
      <g>
        <line x1={tx(m)} x2={tx(m)} y1={axisY} y2={axisY + 5} class="qfig-poll-axis" />
        <text x={tx(m)} y={axisY + 21} text-anchor="middle" class="qfig-poll-m">{m}</text>
      </g>
    ))}
    <text x="0" y={axisY + 21} class="qfig-poll-m">
      <tspan data-lang-en>min</tspan>
      <tspan data-lang-vi>phút</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-poll { margin: 0; width: 100%; }
  .qfig-poll svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-poll text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-poll .qfig-poll-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-poll .qfig-poll-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-poll .qfig-poll-t { font-weight: 600; fill: var(--text); }
  .qfig-poll .qfig-poll-m { fill: var(--text-muted); }
  .qfig-poll .qfig-poll-red { fill: var(--red); font-weight: 600; }
  .qfig-poll-rule { stroke: var(--border); stroke-width: 2; }
  .qfig-poll-edit { fill: var(--text); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-poll-run { fill: var(--bg); stroke: var(--text); stroke-width: 2.4; }
  .qfig-poll-gap { stroke: var(--red); stroke-width: 2; }
  .qfig-poll-gaphead { fill: var(--red); }
  .qfig-poll-entry { fill: var(--gold); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-poll-axis { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
