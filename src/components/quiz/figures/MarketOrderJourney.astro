---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 01: one order's journey — broker -> matching -> clearing -> settlement.
// Matches the post's four hands and the T+2 timeline (illustrative order: buy 100 at 24,500).
const W = 580;
const H = 470;
const steps = [
  {
    icon: 'phone',
    en: 'You — tap "buy 100 at 24,500"',
    vi: 'Bạn — bấm "mua 100 cp giá 24.500"',
    when: { en: 'trade day T', vi: 'ngày giao dịch T' },
  },
  {
    icon: 'user',
    en: 'Broker — checks your funds, routes the order',
    vi: 'CTCK — kiểm tra tiền, chuyển lệnh lên sàn',
    when: { en: 'seconds after the tap', vi: 'vài giây sau cú bấm' },
  },
  {
    icon: 'chart',
    en: 'HOSE — matches: price first, then arrival time',
    vi: 'HOSE — khớp: giá trước, thời điểm đến sau',
    when: { en: 'the same seconds', vi: 'cùng vài giây đó' },
  },
  {
    icon: 'receipt',
    en: 'VSDC — clearing: nets each member’s dues',
    vi: 'VSDC — bù trừ: rút gọn nghĩa vụ từng thành viên',
    when: { en: 'evening of T', vi: 'tối ngày T' },
  },
  {
    icon: 'money',
    en: 'Banks — shares and money change owners',
    vi: 'Ngân hàng — cổ phiếu và tiền đổi chủ',
    when: { en: 'before 13:00 on T+2', vi: 'trước 13h ngày T+2' },
  },
];
const rowH = 74;
const y0 = 56;
---
<div class="qmj">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <text x="14" y="24" class="qmj-h">
      <tspan data-lang-en>One order, four hands</tspan>
      <tspan data-lang-vi>Một lệnh, bốn bộ tay</tspan>
    </text>
    {steps.map((s, i) => {
      const y = y0 + i * rowH;
      return (
        <g>
          {i < steps.length - 1 && (
            <g class="qmj-arrow">
              <path d={`M 190 ${y + 48} L 190 ${y + rowH - 18}`} />
              <polygon points={`190,${y + rowH - 10} 185,${y + rowH - 20} 195,${y + rowH - 20}`} />
            </g>
          )}
          <DiagramIcon name={s.icon} x={22} y={y + 12} size={22} />
          <rect x="54" y={y} width="300" height="48" rx="8" />
          <text x="68" y={y + 21} class="qmj-strong">
            <tspan data-lang-en>{s.en}</tspan>
            <tspan data-lang-vi>{s.vi}</tspan>
          </text>
          <text x="68" y={y + 39} class="qmj-muted">
            <tspan data-lang-en>{s.when.en}</tspan>
            <tspan data-lang-vi>{s.when.vi}</tspan>
          </text>
        </g>
      );
    })}
    <line x1="14" x2={W - 14} y1={y0 + 5 * rowH + 2} y2={y0 + 5 * rowH + 2} class="qmj-rule" />
    <text x="14" y={y0 + 5 * rowH + 26} class="qmj-note">
      <tspan data-lang-en>Cash blocked at order time comes back only through settlement</tspan>
      <tspan data-lang-vi>Tiền bị phong tỏa lúc đặt lệnh chỉ quay lại qua thanh toán</tspan>
    </text>
  </svg>
</div>

<style>
  .qmj {
    margin: 0;
    width: 100%;
  }
  .qmj svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qmj text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qmj .qmj-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qmj rect {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .qmj .qmj-strong {
    font-size: 14px;
    font-weight: 600;
    fill: var(--text);
  }
  .qmj .qmj-muted {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qmj .qmj-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .qmj .qmj-arrow polygon {
    fill: var(--text-muted);
  }
  .qmj .qmj-rule {
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .qmj .qmj-note {
    font-size: 13px;
    font-weight: 600;
    fill: var(--act-2);
  }
</style>
