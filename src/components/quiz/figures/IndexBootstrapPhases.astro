---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for unbundling set 04: three phases of building an index on a live table (scan a snapshot,
// apply the writes made meanwhile, follow new writes) and the write stream that keeps arriving through all of them.
// It shows rates and the scan length only, not the backlog size or the catch-up time. Inline SVG, site tokens only.
const cardW = 176;
const gap = 26;
const cards = [0, 1, 2].map((i) => i * (cardW + gap));
const top = 46;
const cardH = 128;
const bandY = 206;
function right(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 5} ${x - 9},${y + 5}`;
}
function up(x: number, y: number) {
  return `${x},${y} ${x - 5},${y + 9} ${x + 5},${y + 9}`;
}
const steps = [
  { icon: 'db', n: '1',
    t: { en: 'Scan a snapshot', vi: 'Quét snapshot' },
    a: { en: 'Reads the table as it', vi: 'Đọc bảng đúng như lúc' },
    b: { en: 'was at one moment', vi: 'chụp, tại một thời điểm' },
    r: { en: '600 s', vi: '600 giây' } },
  { icon: 'log', n: '2',
    t: { en: 'Catch up', vi: 'Đuổi kịp' },
    a: { en: 'Applies the writes made', vi: 'Áp dụng các lệnh ghi' },
    b: { en: 'while the scan ran', vi: 'xảy ra trong lúc quét' },
    r: { en: '3,000 changes/s', vi: '3.000 thay đổi/s' } },
  { icon: 'sync', n: '3',
    t: { en: 'Stay live', vi: 'Chạy liên tục' },
    a: { en: 'Applies each new write', vi: 'Áp dụng từng lệnh ghi mới' },
    b: { en: 'as it arrives', vi: 'ngay khi nó tới' },
    r: { en: 'from then on', vi: 'từ đó về sau' } },
];
---
<div class="qfig-ibp">
  <svg viewBox="0 0 580 262" role="img" aria-label="Three steps for building an index on a live table: scan a snapshot for 600 seconds, apply the writes made during the scan at 3,000 changes per second, then follow each new write. A band underneath shows 300 writes per second arriving the whole time.">
    <text x="0" y="22" class="qfig-ibp-h">
      <tspan data-lang-en>Building an index on a table that keeps changing</tspan>
      <tspan data-lang-vi>Dựng index trên bảng vẫn đang thay đổi</tspan>
    </text>

    {cards.map((x, i) => (
      <g>
        <rect x={x} y={top} width={cardW} height={cardH} rx="10" class="qfig-ibp-card" />
        <circle cx={x + 20} cy={top + 22} r="11" class="qfig-ibp-num" />
        <text x={x + 20} y={top + 27} text-anchor="middle" class="qfig-ibp-n">{steps[i].n}</text>
        <DiagramIcon name={steps[i].icon as any} x={x + cardW - 22} y={top + cardH - 20} size={24} />
        <text x={x + 38} y={top + 27} class="qfig-ibp-t">
          <tspan data-lang-en>{steps[i].t.en}</tspan>
          <tspan data-lang-vi>{steps[i].t.vi}</tspan>
        </text>
        <text x={x + 12} y={top + 66} class="qfig-ibp-d">
          <tspan data-lang-en>{steps[i].a.en}</tspan>
          <tspan data-lang-vi>{steps[i].a.vi}</tspan>
        </text>
        <text x={x + 12} y={top + 84} class="qfig-ibp-d">
          <tspan data-lang-en>{steps[i].b.en}</tspan>
          <tspan data-lang-vi>{steps[i].b.vi}</tspan>
        </text>
        <text x={x + 12} y={top + 113} class="qfig-ibp-r">
          <tspan data-lang-en>{steps[i].r.en}</tspan>
          <tspan data-lang-vi>{steps[i].r.vi}</tspan>
        </text>
      </g>
    ))}

    {[0, 1].map((i) => {
      const gx = cards[i] + cardW;
      return (
        <g>
          <line x1={gx + 4} x2={gx + gap - 10} y1={top + cardH / 2} y2={top + cardH / 2} class="qfig-ibp-arrow" />
          <polygon points={right(gx + gap - 3, top + cardH / 2)} class="qfig-ibp-head" />
        </g>
      );
    })}

    {cards.map((x) => (
      <g>
        <line x1={x + cardW / 2} x2={x + cardW / 2} y1={bandY} y2={top + cardH + 11} class="qfig-ibp-feed" />
        <polygon points={up(x + cardW / 2, top + cardH + 2)} class="qfig-ibp-feedhead" />
      </g>
    ))}

    <rect x="0" y={bandY} width="580" height="34" rx="8" class="qfig-ibp-band" />
    <text x="290" y={bandY + 22} text-anchor="middle" class="qfig-ibp-bt">
      <tspan data-lang-en>300 writes/s keep arriving the whole time</tspan>
      <tspan data-lang-vi>300 lệnh ghi/giây vẫn đổ vào suốt thời gian đó</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-ibp { margin: 0; width: 100%; }
  .qfig-ibp svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-ibp text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-ibp .qfig-ibp-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-ibp .qfig-ibp-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-ibp .qfig-ibp-d { fill: var(--text-body); }
  .qfig-ibp .qfig-ibp-r { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-ibp .qfig-ibp-n { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qfig-ibp .qfig-ibp-bt { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-ibp-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-ibp-num { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-ibp-arrow { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-ibp-head { fill: var(--text-muted); }
  .qfig-ibp-feed { stroke: var(--gold); stroke-width: 2; }
  .qfig-ibp-feedhead { fill: var(--gold); }
  .qfig-ibp-band { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
</style>
