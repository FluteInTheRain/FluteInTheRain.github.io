---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-caching set 01: ten reads of one key over 70 seconds, drawn as dots on a time axis.
// It shows when the requests arrive, not which ones hit or miss. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const x0 = 30;
const px = 7.4; // pixels per second
const tx = (s: number) => x0 + s * px;
const reads = [0, 6, 13, 21, 29, 34, 41, 50, 58, 66];
const axisY = 150;
const ticks = [0, 10, 20, 30, 40, 50, 60, 70];
---
<div class="qfig-rs">
  <svg viewBox="0 0 580 204" role="img" aria-label="Ten reads of one cached key drawn as dots on a time axis from 0 to 70 seconds, at 0, 6, 13, 21, 29, 34, 41, 50, 58 and 66 seconds.">
    <DiagramIcon name="redis" x={10} y={12} size={28} />
    <text x="48" y="32" class="qfig-rs-h">
      <tspan data-lang-en>GET /cases/C-1, one dot per request</tspan>
      <tspan data-lang-vi>GET /cases/C-1, mỗi chấm là một request</tspan>
    </text>
    <line x1={tx(0)} x2={tx(70)} y1="96" y2="96" class="qfig-rs-lane" />
    {reads.map((s) => (
      <g>
        <circle cx={tx(s)} cy="96" r="8" class="qfig-rs-dot" />
        <text x={tx(s)} y="76" text-anchor="middle" class="qfig-rs-t">{s}</text>
      </g>
    ))}
    <line x1={tx(0)} x2={tx(70)} y1={axisY} y2={axisY} class="qfig-rs-axis" />
    {ticks.map((s) => (
      <g>
        <line x1={tx(s)} x2={tx(s)} y1={axisY} y2={axisY + 5} class="qfig-rs-axis" />
        <text x={tx(s)} y={axisY + 21} text-anchor="middle" class="qfig-rs-m">{s}</text>
      </g>
    ))}
    <text x={tx(70) + 14} y={axisY + 21} class="qfig-rs-m">
      <tspan data-lang-en>s</tspan>
      <tspan data-lang-vi>giây</tspan>
    </text>
    <text x="10" y="196" class="qfig-rs-m">
      <tspan data-lang-en>Time since the first request</tspan>
      <tspan data-lang-vi>Thời gian kể từ request đầu tiên</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-rs { margin: 0; width: 100%; }
  .qfig-rs svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-rs text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-rs .qfig-rs-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-rs .qfig-rs-t { font-weight: 600; fill: var(--text); }
  .qfig-rs .qfig-rs-m { fill: var(--text-muted); }
  .qfig-rs-lane { stroke: var(--border); stroke-width: 2; }
  .qfig-rs-dot { fill: var(--bg); stroke: var(--text); stroke-width: 2.2; }
  .qfig-rs-axis { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
