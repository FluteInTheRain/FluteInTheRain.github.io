---
// 51Labs "Community detection for VN100" results table, copied from the opened page (annual figures).
const rows = [
  ['InfoMap', '22.07', '24.5', '0.90', '−42.85'],
  ['Louvain', '16.71', '26.21', '0.64', '−47.26'],
  ['VNINDEX', '12.53', '19.83', '0.63', '−40.34'],
];
---
<div class="q10t">
  <svg viewBox="0 0 580 190" role="img" aria-hidden="true">
    <text x="20" y="24" class="q10t-h">
      <tspan data-lang-en>51Labs, VN100 backtest, annual figures as reported</tspan>
      <tspan data-lang-vi>51Labs, backtest VN100, số liệu theo năm như bài báo cáo</tspan>
    </text>
    <rect x="20" y="40" width="540" height="124" rx="8" class="q10t-box" />
    <text x="34" y="64" class="q10t-c"> </text>
    <text x="170" y="64" class="q10t-c"><tspan data-lang-en>Return %</tspan><tspan data-lang-vi>Lợi suất %</tspan></text>
    <text x="250" y="64" class="q10t-c"><tspan data-lang-en>Vol. %</tspan><tspan data-lang-vi>Biến động %</tspan></text>
    <text x="350" y="64" class="q10t-c">Sharpe</text>
    <text x="430" y="64" class="q10t-c"><tspan data-lang-en>Max drawdown %</tspan><tspan data-lang-vi>Sụt giảm tối đa %</tspan></text>
    {rows.map((r, i) => (
      <g>
        <text x="34" y={94 + i * 28} class="q10t-k">{r[0]}</text>
        <text x="170" y={94 + i * 28}>{r[1]}</text>
        <text x="250" y={94 + i * 28}>{r[2]}</text>
        <text x="350" y={94 + i * 28}>{r[3]}</text>
        <text x="430" y={94 + i * 28}>{r[4]}</text>
      </g>
    ))}
    <text x="20" y="184" class="q10t-s">
      <tspan data-lang-en>The post gives no test period and no trading costs.</tspan>
      <tspan data-lang-vi>Bài không nêu giai đoạn kiểm thử và chi phí giao dịch.</tspan>
    </text>
  </svg>
</div>

<style>
  .q10t { margin: 0; width: 100%; }
  .q10t svg { display: block; width: 100%; height: auto; }
  .q10t text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .q10t .q10t-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q10t .q10t-c { font-size: 11.5px; font-weight: 700; fill: var(--text-muted); }
  .q10t .q10t-k { font-weight: 700; fill: var(--text); }
  .q10t .q10t-s { font-size: 12px; fill: var(--text-muted); }
  .q10t-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
</style>
