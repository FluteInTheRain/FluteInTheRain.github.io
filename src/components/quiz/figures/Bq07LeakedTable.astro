---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-auth set 01: a leaked `users` table, three rows, sha256 values with the middle cut out.
// It shows the data only; it does not say what the equal values mean. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const rows = [
  { user: 'alice', hash: '7d0c50df99 … 00d9ce' },
  { user: 'bob', hash: '882a2a3fdb … d8bde4' },
  { user: 'carol', hash: '7d0c50df99 … 00d9ce' },
];
const top = 96;
const rh = 50;
---
<div class="qfig-lt">
  <svg viewBox="0 0 580 290" role="img" aria-label="A leaked users table with three rows: alice and carol show the same pw_hash value, bob shows a different one.">
    <DiagramIcon name="db" x={22} y={14} size={30} />
    <text x="64" y="36" class="qfig-lt-h">
      <tspan data-lang-en>Leaked table: users</tspan>
      <tspan data-lang-vi>Bảng bị lộ: users</tspan>
    </text>
    <text x="64" y="54" class="qfig-lt-m">
      <tspan data-lang-en>pw_hash = sha256(password), hex, middle cut out</tspan>
      <tspan data-lang-vi>pw_hash = sha256(password), dạng hex, đã cắt phần giữa</tspan>
    </text>

    <rect x="10" y="72" width="560" height="168" rx="8" class="qfig-lt-box" />
    <rect x="10" y="72" width="560" height="30" rx="8" class="qfig-lt-head" />
    <text x="30" y="92" class="qfig-lt-th">username</text>
    <text x="190" y="92" class="qfig-lt-th">pw_hash</text>
    {rows.map((r, i) => (
      <g>
        <line x1="10" x2="570" y1={top + 6 + i * 46} y2={top + 6 + i * 46} class="qfig-lt-rule" />
        <text x="30" y={top + 36 + i * 46 - 8} class="qfig-lt-u">{r.user}</text>
        <text x="190" y={top + 36 + i * 46 - 8} class="qfig-lt-v">{r.hash}</text>
      </g>
    ))}
    <text x="10" y="266" class="qfig-lt-m">
      <tspan data-lang-en>Full value: 64 hex characters per row</tspan>
      <tspan data-lang-vi>Giá trị đầy đủ: 64 ký tự hex mỗi dòng</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-lt { margin: 0; width: 100%; }
  .qfig-lt svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-lt text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-lt .qfig-lt-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-lt .qfig-lt-m { fill: var(--text-muted); }
  .qfig-lt .qfig-lt-th { font-size: 13px; font-weight: 700; fill: var(--text-muted); }
  .qfig-lt .qfig-lt-u { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-lt .qfig-lt-v { font-size: 16px; font-weight: 600; fill: var(--text); letter-spacing: 0.4px; }
  .qfig-lt-box { fill: var(--bg); stroke: var(--border); stroke-width: 1.4; }
  .qfig-lt-head { fill: var(--bg-alt); stroke: none; }
  .qfig-lt-rule { stroke: var(--border); stroke-width: 1; }
</style>
