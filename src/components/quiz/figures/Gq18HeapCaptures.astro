---
// Quiz figure for go-profiling set 05: three heap captures of two services, in-use MB (bars) and allocated GB.
// Numbers only, no verdict. Inline SVG, site tokens only.
const K = 0.62, BX = 70;
const svc = [
  { name: 'A', rows: [[0, 120, 4], [10, 121, 9], [20, 119, 14]] },
  { name: 'B', rows: [[0, 120, 3], [10, 260, 5], [20, 410, 7]] },
];
const gy = (i: number) => 52 + i * 108;
---
<div class="qfig-gq18hc">
  <svg viewBox="0 0 600 270" role="img" aria-label="Two services, A and B, with three heap captures each at minute 0, 10 and 20. Per capture: in-use megabytes as a bar and total allocated gigabytes. A: 120, 121, 119 MB in use; 4, 9, 14 GB allocated. B: 120, 260, 410 MB in use; 3, 5, 7 GB allocated.">
    <text x="10" y="20" class="qfig-gq18hc-h">
      <tspan data-lang-en>Heap captures, same service over 20 minutes</tspan>
      <tspan data-lang-vi>Heap capture của cùng một service trong 20 phút</tspan>
    </text>
    {svc.map((s, i) => (
      <g>
        <text x="10" y={gy(i)} class="qfig-gq18hc-s">
          <tspan data-lang-en>service {s.name}</tspan>
          <tspan data-lang-vi>service {s.name}</tspan>
        </text>
        <text x={BX + 200} y={gy(i)} class="qfig-gq18hc-m">inuse_space (MB)</text>
        <text x="470" y={gy(i)} class="qfig-gq18hc-m">alloc_space (GB)</text>
        {s.rows.map((r, j) => (
          <g>
            <text x="10" y={gy(i) + 28 + j * 26} class="qfig-gq18hc-m">{r[0]} min</text>
            <rect x={BX} y={gy(i) + 12 + j * 26} width={r[1] * K} height="20" rx="3" class="qfig-gq18hc-bar" />
            <text x={BX + r[1] * K + 6} y={gy(i) + 28 + j * 26} class="qfig-gq18hc-v">{r[1]}</text>
            <text x="470" y={gy(i) + 28 + j * 26} class="qfig-gq18hc-v">{r[2]}</text>
          </g>
        ))}
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-gq18hc { margin: 0; width: 100%; }
  .qfig-gq18hc svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq18hc text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq18hc .qfig-gq18hc-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq18hc .qfig-gq18hc-s { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-gq18hc .qfig-gq18hc-m { fill: var(--text-muted); }
  .qfig-gq18hc .qfig-gq18hc-v { font-weight: 700; fill: var(--text); }
  .qfig-gq18hc-bar { fill: var(--act-3); opacity: 0.75; }
</style>
