---
// Quiz figure, set 06: two models, almost the same score for D, different credit for the momentum twins.
const W = 580;
const H = 270;
const X0 = 150, S = 300;
---
<div class="qd9t">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <text x="16" y="24" class="h">
      <tspan data-lang-en>Stock D under two models</tspan>
      <tspan data-lang-vi>Cổ phiếu D dưới hai mô hình</tspan>
    </text>
    <rect x="16" y="40" width="548" height="100" rx="8" class="card" />
    <text x="30" y="64" class="t">
      <tspan data-lang-en>Model 1, both momentum features. Score 1.540</tspan>
      <tspan data-lang-vi>Mô hình 1, cả hai feature momentum. Điểm 1,540</tspan>
    </text>
    <text x="30" y="92" class="lab">
      <tspan data-lang-en>12-month</tspan>
      <tspan data-lang-vi>12 tháng</tspan>
    </text>
    <rect x={X0} y="79" width={0.549 * S} height="16" class="bar" />
    <text x={X0 + 0.549 * S + 6} y="92" class="val">
      <tspan data-lang-en>+0.549</tspan>
      <tspan data-lang-vi>+0,549</tspan>
    </text>
    <text x="30" y="120" class="lab">
      <tspan data-lang-en>6-month</tspan>
      <tspan data-lang-vi>6 tháng</tspan>
    </text>
    <rect x={X0} y="107" width={0.178 * S} height="16" class="bar" />
    <text x={X0 + 0.178 * S + 6} y="120" class="val">
      <tspan data-lang-en>+0.178</tspan>
      <tspan data-lang-vi>+0,178</tspan>
    </text>

    <rect x="16" y="152" width="548" height="100" rx="8" class="card" />
    <text x="30" y="176" class="t">
      <tspan data-lang-en>Model 2, 6-month feature dropped. Score 1.625</tspan>
      <tspan data-lang-vi>Mô hình 2, bỏ feature 6 tháng. Điểm 1,625</tspan>
    </text>
    <text x="30" y="204" class="lab">
      <tspan data-lang-en>12-month</tspan>
      <tspan data-lang-vi>12 tháng</tspan>
    </text>
    <rect x={X0} y="191" width={0.908 * S} height="16" class="bar is-two" />
    <text x={X0 + 0.908 * S + 6} y="204" class="val">
      <tspan data-lang-en>+0.908</tspan>
      <tspan data-lang-vi>+0,908</tspan>
    </text>
    <text x="30" y="232" class="lab">
      <tspan data-lang-en>6-month</tspan>
      <tspan data-lang-vi>6 tháng</tspan>
    </text>
    <text x={X0 + 6} y="232" class="val">
      <tspan data-lang-en>0.000</tspan>
      <tspan data-lang-vi>0,000</tspan>
    </text>
  </svg>
</div>

<style>
  .qd9t { margin: 0; width: 100%; }
  .qd9t svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .qd9t text { font-size: 13px; fill: var(--text-body); }
  .qd9t .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qd9t .t { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qd9t .lab { fill: var(--text); }
  .qd9t .val { font-weight: 700; fill: var(--text); }
  .qd9t .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qd9t .bar { fill: var(--gold); }
  .qd9t .bar.is-two { fill: var(--act-2); }
</style>
