---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-validation-schemas set 05: a sign-up request body with three fields goes into a handler whose
// return type is the same input model. Shows the situation only, not what the response contains.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const fields = () => [
  { y: 84, name: 'email', bad: false },
  { y: 116, name: 'password', bad: false },
  { y: 148, name: 'name', bad: false },
];
function head(x: number, y: number) { return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`; }
---
<div class="qfig-sue">
  <svg viewBox="0 0 580 196" role="img" aria-label="A sign-up request body with the fields email, password and name enters the handler signup(user: UserIn) -> UserIn, whose return type is the same model as its input.">
    <text x="0" y="22" class="qfig-sue-h">
      <tspan data-lang-en>One model in, the same model out</tspan>
      <tspan data-lang-vi>Một model đi vào, chính model đó đi ra</tspan>
    </text>

    <rect x="0" y="44" width="160" height="136" rx="10" class="qfig-sue-box" />
    <text x="12" y="66" class="qfig-sue-t">
      <tspan data-lang-en>Request body</tspan>
      <tspan data-lang-vi>Body của request</tspan>
    </text>
    {fields().map((f) => (
      <text x="14" y={f.y + 14} class="qfig-sue-f">{f.name}</text>
    ))}

    <rect x="200" y="64" width="240" height="76" rx="10" class="qfig-sue-fn" />
    <DiagramIcon name="server" x={226} y={102} size={24} />
    <text x="250" y="96" class="qfig-sue-code">signup(user: UserIn)</text>
    <text x="250" y="116" class="qfig-sue-code">-&gt; UserIn</text>
    <line x1="164" x2="196" y1="102" y2="102" class="qfig-sue-arrow" />
    <polygon points={head(198, 102)} class="qfig-sue-head" />
    <text x="320" y="162" text-anchor="middle" class="qfig-sue-m">
      <tspan data-lang-en>The return type is the same model as the input</tspan>
      <tspan data-lang-vi>Kiểu trả về là chính model của input</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-sue { margin: 0; width: 100%; }
  .qfig-sue svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-sue text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-sue .qfig-sue-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-sue .qfig-sue-m { font-size: 13px; fill: var(--text-muted); }
  .qfig-sue .qfig-sue-t { font-weight: 700; fill: var(--text); }
  .qfig-sue .qfig-sue-f { font-size: 15px; fill: var(--text-body); }
  .qfig-sue .qfig-sue-bad { font-size: 15px; font-weight: 700; fill: var(--red); }
  .qfig-sue .qfig-sue-code { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qfig-sue-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-sue-fn { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-sue-arrow { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-sue-head { fill: var(--text-muted); }
</style>
