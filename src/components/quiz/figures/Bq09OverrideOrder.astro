---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-testing-strategy set 04: the same three tests run alone and run together in file order.
// It shows the symptom only (pass / fail and the failing assertion), not the cause. Inline SVG, site tokens, no ids.
const tests = [
  { en: 'test_open_201', vi: 'test_open_201' },
  { en: 'test_other_route', vi: 'test_other_route' },
  { en: 'test_stats_empty', vi: 'test_stats_empty' },
];
const colX = [160, 290, 420];
const w = 120;
const rows = [
  { y: 52, en: 'Run alone', vi: 'Chạy riêng', cmd: 'pytest -k stats', results: [null, null, true] },
  { y: 158, en: 'Run in file order', vi: 'Chạy theo thứ tự file', cmd: 'pytest', results: [true, true, false] },
];
---
<div class="qfig-bq9oo">
  <svg viewBox="0 0 580 270" role="img" aria-label="The same three tests run twice: the stats test alone passes, and in file order after the other two the stats test fails with a count of one instead of zero.">
    {tests.map((t, i) => (
      <text x={colX[i] + w / 2} y="24" text-anchor="middle" class="qfig-bq9oo-h">{t.en}</text>
    ))}
    {rows.map((r) => (
      <g>
        <text x="0" y={r.y + 22} class="qfig-bq9oo-lane">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <text x="0" y={r.y + 40} class="qfig-bq9oo-m">{r.cmd}</text>
        {r.results.map((res, i) => (
          <g>
            {res === null ? (
              <rect x={colX[i]} y={r.y} width={w} height="48" rx="6" class="qfig-bq9oo-skip" />
            ) : (
              <rect x={colX[i]} y={r.y} width={w} height="48" rx="6" class={res ? 'qfig-bq9oo-ok' : 'qfig-bq9oo-bad'} />
            )}
            {res === null && (
              <text x={colX[i] + w / 2} y={r.y + 29} text-anchor="middle" class="qfig-bq9oo-m">
                <tspan data-lang-en>not run</tspan>
                <tspan data-lang-vi>không chạy</tspan>
              </text>
            )}
            {res !== null && (
              <g>
                <DiagramIcon name={res ? 'ok' : 'fail'} x={colX[i] + 26} y={r.y + 24} size={24} />
                <text x={colX[i] + 50} y={r.y + 29} class={res ? 'qfig-bq9oo-t' : 'qfig-bq9oo-redt'}>
                  <tspan data-lang-en>{res ? 'passed' : 'failed'}</tspan>
                  <tspan data-lang-vi>{res ? 'pass' : 'fail'}</tspan>
                </text>
              </g>
            )}
          </g>
        ))}
      </g>
    ))}
    <text x="0" y="250" class="qfig-bq9oo-redt">
      <tspan data-lang-en>assert {"{'cases': 1}"} == {"{'cases': 0}"}</tspan>
      <tspan data-lang-vi>assert {"{'cases': 1}"} == {"{'cases': 0}"}</tspan>
    </text>
    <text x="260" y="250" class="qfig-bq9oo-m">
      <tspan data-lang-en>(the failure in the second run)</tspan>
      <tspan data-lang-vi>(lỗi ở lần chạy thứ hai)</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-bq9oo { margin: 0; width: 100%; }
  .qfig-bq9oo svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-bq9oo text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bq9oo .qfig-bq9oo-h { font-size: 12px; font-weight: 700; fill: var(--text); }
  .qfig-bq9oo .qfig-bq9oo-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-bq9oo .qfig-bq9oo-m { fill: var(--text-muted); font-size: 13px; }
  .qfig-bq9oo .qfig-bq9oo-t { font-weight: 700; fill: var(--text); }
  .qfig-bq9oo .qfig-bq9oo-redt { font-weight: 700; fill: var(--red); }
  .qfig-bq9oo-ok { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .qfig-bq9oo-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-bq9oo-skip { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; stroke-dasharray: 4 3; }
</style>
