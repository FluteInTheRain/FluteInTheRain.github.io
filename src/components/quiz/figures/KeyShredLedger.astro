---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for trade-offs set 08: a key service holding one key per user, and three stores
// (event log, warehouse, cache) that each hold rows encrypted under the owner's key.
// It shows the state before anyone is deleted and gives no verdict. Inline SVG, site tokens only, no ids.
const stores = [
  { x: 0, icon: 'log', en: 'Event log', vi: 'Event log', sEn: 'append-only', sVi: 'chỉ ghi thêm', a: 'a91f3c…', b: '7c2e90…' },
  { x: 200, icon: 'db', en: 'Warehouse', vi: 'Warehouse', sEn: 'years of history', sVi: 'lịch sử nhiều năm', a: '5d08e1…', b: 'c43b7a…' },
  { x: 400, icon: 'server', en: 'Caches', vi: 'Cache', sEn: 'copies for speed', sVi: 'bản sao cho nhanh', a: '2be6f4…', b: '90a1d8…' },
];
const W = 180;
function head(x: number, y: number) {
  return `${x},${y + 8} ${x - 5},${y} ${x + 5},${y}`;
}
---
<div class="qfig-ksl">
  <svg viewBox="0 0 580 330" role="img" aria-label="A key service holds one key for Ana and one for Ben. Below it, an event log, a warehouse and caches each hold one encrypted row for Ana and one for Ben.">
    <text x="0" y="22" class="qfig-ksl-h">
      <tspan data-lang-en>Whose key opens which row</tspan>
      <tspan data-lang-vi>Khoá nào mở dòng nào</tspan>
    </text>

    <!-- the user -->
    <DiagramIcon name="user" x={30} y={66} size={34} />
    <text x="56" y="62" class="qfig-ksl-t">
      <tspan data-lang-en>Ana asks the app</tspan>
      <tspan data-lang-vi>Ana yêu cầu app</tspan>
    </text>
    <text x="56" y="82" class="qfig-ksl-t">
      <tspan data-lang-en>to forget her</tspan>
      <tspan data-lang-vi>quên cô ấy</tspan>
    </text>

    <!-- key service -->
    <rect x="236" y="40" width="344" height="76" rx="10" class="qfig-ksl-box" />
    <DiagramIcon name="key" x={262} y={63} size={26} />
    <text x="282" y="68" class="qfig-ksl-lane">
      <tspan data-lang-en>Key service</tspan>
      <tspan data-lang-vi>Key service</tspan>
    </text>
    <rect x="248" y="82" width="150" height="26" rx="13" class="qfig-ksl-ana" />
    <text x="323" y="100" text-anchor="middle" class="qfig-ksl-t">
      <tspan data-lang-en>Ana's key</tspan>
      <tspan data-lang-vi>Khoá của Ana</tspan>
    </text>
    <rect x="410" y="82" width="158" height="26" rx="13" class="qfig-ksl-ben" />
    <text x="489" y="100" text-anchor="middle" class="qfig-ksl-t">
      <tspan data-lang-en>Ben's key</tspan>
      <tspan data-lang-vi>Khoá của Ben</tspan>
    </text>

    <!-- hand-out arrow -->
    <line x1="408" x2="408" y1="118" y2="150" class="qfig-ksl-flow" />
    <polygon points={head(408, 150)} transform="rotate(0)" class="qfig-ksl-flowhead" />
    <text x="400" y="140" text-anchor="end" class="qfig-ksl-m">
      <tspan data-lang-en>a service asks for a key,</tspan>
      <tspan data-lang-vi>service xin khoá,</tspan>
    </text>
    <text x="418" y="140" class="qfig-ksl-m">
      <tspan data-lang-en>then reads or writes</tspan>
      <tspan data-lang-vi>rồi đọc hoặc ghi</tspan>
    </text>

    <!-- stores -->
    {stores.map((s) => (
      <g>
        <rect x={s.x} y="164" width={W} height="132" rx="10" class="qfig-ksl-box" />
        <DiagramIcon name={s.icon as any} x={s.x + 24} y={187} size={26} />
        <text x={s.x + 44} y="192" class="qfig-ksl-lane">
          <tspan data-lang-en>{s.en}</tspan>
          <tspan data-lang-vi>{s.vi}</tspan>
        </text>
        <text x={s.x + 12} y="220" class="qfig-ksl-m">
          <tspan data-lang-en>{s.sEn}</tspan>
          <tspan data-lang-vi>{s.sVi}</tspan>
        </text>
        <rect x={s.x + 10} y="230" width={W - 20} height="24" rx="6" class="qfig-ksl-ana" />
        <text x={s.x + 18} y="247" class="qfig-ksl-t">Ana</text>
        <text x={s.x + W - 18} y="247" text-anchor="end" class="qfig-ksl-m">{s.a}</text>
        <rect x={s.x + 10} y="260" width={W - 20} height="24" rx="6" class="qfig-ksl-ben" />
        <text x={s.x + 18} y="277" class="qfig-ksl-t">Ben</text>
        <text x={s.x + W - 18} y="277" text-anchor="end" class="qfig-ksl-m">{s.b}</text>
      </g>
    ))}

    <text x="0" y="322" class="qfig-ksl-m">
      <tspan data-lang-en>Every row is stored encrypted under its owner's key.</tspan>
      <tspan data-lang-vi>Mỗi dòng được lưu dưới dạng mã hoá bằng khoá của chủ nó.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-ksl { margin: 0; width: 100%; }
  .qfig-ksl svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-ksl text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-ksl .qfig-ksl-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-ksl .qfig-ksl-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-ksl .qfig-ksl-t { font-weight: 600; fill: var(--text); }
  .qfig-ksl .qfig-ksl-m { fill: var(--text-muted); }
  .qfig-ksl-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-ksl-ana { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-ksl-ben { fill: var(--bg); stroke: var(--border); stroke-width: 1.4; }
  .qfig-ksl-flow { stroke: var(--gold); stroke-width: 2; fill: none; }
  .qfig-ksl-flowhead { fill: var(--gold); }
</style>
