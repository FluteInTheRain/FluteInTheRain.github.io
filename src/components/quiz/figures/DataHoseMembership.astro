---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 04: membership history — HOSE opened in 2000 with REE and SAM, had 393
// codes at the end of 2024, and the list did not only grow: four firms were
// forced off during 2024 (post §2). The fix is a membership table per date.
const events = [
  { x: 96, y: 258, bad: false, anchor: 'start', en: '2000: REE + SAM — two tickers', vi: '2000: REE + SAM — hai mã' },
  { x: 276, y: 130, bad: true, anchor: 'middle', en: 'May 2024: POM leaves', vi: '5/2024: POM rời sàn' },
  { x: 344, y: 210, bad: true, anchor: 'middle', en: 'Sep 2024: HBC leaves', vi: '9/2024: HBC rời sàn' },
  { x: 412, y: 130, bad: true, anchor: 'middle', en: 'Oct 2024: DAG leaves', vi: '10/2024: DAG rời sàn' },
  { x: 480, y: 258, bad: true, anchor: 'end', en: 'Jan 2025: GMC last day', vi: '1/2025: GMC ngày cuối' },
];
const W = 580;
const H = 460;
const axisY = 168;
const x0 = 70;
const x1 = 530;
const px = (year: number) => x0 + ((year - 2000) / (2025 - 2000)) * (x1 - x0);
---
<div class="qshm">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <DiagramIcon name="calendar" x={22} y={20} size={22} />
    <text x="44" y="25" class="qshm-h">
      <tspan data-lang-en>The list inside the exchange keeps changing</tspan>
      <tspan data-lang-vi>Danh sách trong sàn thay đổi liên tục</tspan>
    </text>

    <line x1={x0 - 20} x2={x1 + 20} y1={axisY} y2={axisY} class="qshm-axis" />
    <line x1={px(2000)} x2={px(2000)} y1={axisY - 8} y2={axisY + 8} class="qshm-axis" />
    <line x1={px(2025)} x2={px(2025)} y1={axisY - 8} y2={axisY + 8} class="qshm-axis" />
    <circle cx={px(2000)} cy={axisY} r="6" class="qshm-dot" />
    <circle cx={px(2024.9)} cy={axisY} r="6" class="qshm-dot" />
    <text x={px(2000)} y="146" text-anchor="middle" class="qshm-tick">2000</text>
    <text x={px(2025)} y="146" text-anchor="middle" class="qshm-tick">2025</text>

    {events.map((e) => {
      return (
        <g>
          <line x1={e.x} x2={e.x} y1={axisY} y2={e.y + 14} class={e.bad ? 'qshm-stem is-bad' : 'qshm-stem'} />
          <circle cx={e.x} cy={axisY} r="5" class={e.bad ? 'qshm-dot is-bad' : 'qshm-dot'} />
          <text x={e.anchor === 'start' ? 20 : e.x} y={e.y + 8} text-anchor={e.anchor} class={e.bad ? 'qshm-label is-bad' : 'qshm-label'}>
            <tspan data-lang-en>{e.en}</tspan>
            <tspan data-lang-vi>{e.vi}</tspan>
          </text>
        </g>
      );
    })}

    <text x={px(2024.5)} y={axisY - 16} text-anchor="end" class="qshm-count">
      <tspan data-lang-en>end of 2024: 393 codes</tspan>
      <tspan data-lang-vi>cuối 2024: 393 mã</tspan>
    </text>

    <rect x="14" y="330" width="552" height="76" rx="10" class="qshm-fixbox" />
    <DiagramIcon name="db" x={30} y={350} size={20} />
    <text x="60" y="356" class="qshm-strong">
      <tspan data-lang-en>The fix costs little: keep a membership history</tspan>
      <tspan data-lang-vi>Cách sửa rẻ: giữ một lịch sử thành viên</tspan>
    </text>
    <text x="32" y="382" class="qshm-muted">
      <tspan data-lang-en>for each date, which companies were listed on that date.</tspan>
      <tspan data-lang-vi>ngày nào thì những công ty nào đang niêm yết ngày đó.</tspan>
    </text>
    <text x="32" y="402" class="qshm-muted">
      <tspan data-lang-en>Every backtest universe is built from that table — not from today's list.</tspan>
      <tspan data-lang-vi>Universe của mọi backtest dựng từ bảng đó — không phải từ danh sách hôm nay.</tspan>
    </text>
    <text x="14" y="440" class="qshm-bad">
      <tspan data-lang-en>Most free data sources do not give you this table.</tspan>
      <tspan data-lang-vi>Phần lớn nguồn dữ liệu miễn phí không cho bạn bảng này.</tspan>
    </text>
  </svg>
</div>

<style>
  .qshm {
    margin: 0;
    width: 100%;
  }
  .qshm svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qshm text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qshm .qshm-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qshm .qshm-axis {
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .qshm .qshm-stem {
    stroke: var(--text-muted);
    stroke-width: 1.2;
    stroke-dasharray: none;
  }
  .qshm .qshm-stem.is-bad {
    stroke: var(--red);
    stroke-dasharray: 4 3;
  }
  .qshm .qshm-dot {
    fill: var(--act-2);
  }
  .qshm .qshm-dot.is-bad {
    fill: var(--red);
  }
  .qshm .qshm-tick {
    font-size: 13px;
    font-weight: 600;
    fill: var(--text);
  }
  .qshm .qshm-label {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qshm .qshm-label.is-bad {
    fill: var(--red);
    font-weight: 600;
  }
  .qshm .qshm-count {
    font-size: 13px;
    font-weight: 700;
    fill: var(--text);
  }
  .qshm .qshm-strong {
    font-size: 14px;
    font-weight: 600;
    fill: var(--text);
  }
  .qshm .qshm-muted {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .qshm .qshm-bad {
    font-size: 13px;
    font-weight: 600;
    fill: var(--red);
  }
  .qshm .qshm-fixbox {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
</style>
