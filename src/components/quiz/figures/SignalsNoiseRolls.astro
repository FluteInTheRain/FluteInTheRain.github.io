---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 08: the noise-roll demo from the post. The same clean signal four times, each
// covered by a different roll of noise; the red curve is what a flexible model
// "learns" from each roll — patterns that exist only in that roll. Tokens only.
const dashed = 'M 20 44 C 44 20, 68 62, 92 40 C 116 18, 140 58, 164 40';
const reds = [
  'M 20 56 C 40 12, 60 70, 88 26 C 112 66, 138 16, 164 52',
  'M 20 30 C 46 70, 66 20, 96 62 C 122 22, 146 66, 164 30',
  'M 20 50 C 38 14, 72 66, 98 34 C 124 10, 148 62, 164 44',
  'M 20 36 C 48 66, 62 30, 90 58 C 116 74, 142 22, 164 38',
];
---
<div class="qnr">
  <svg viewBox="0 0 580 400" role="img" aria-hidden="true">
    <DiagramIcon name="model" x={22} y={20} size={22} />
    <text x="44" y="25" class="qnr-h">
      <tspan data-lang-en>The same signal, four rolls of noise</tspan>
      <tspan data-lang-vi>Cùng một tín hiệu, bốn lần xào nhiễu</tspan>
    </text>

    {reds.map((d, i) => {
      const ox = 20 + (i % 2) * 280;
      const oy = 60 + Math.floor(i / 2) * 150;
      return (
        <g>
          <rect x={ox} y={oy} width="248" height="122" rx="10" class="qnr-panel" />
          <g transform={`translate(${ox} ${oy})`}>
            <line x1="12" x2="176" y1="86" y2="86" class="qnr-axis" />
            <path d={dashed} transform="scale(1.35 1)" class="qnr-dashed" />
            <path d={d} transform="scale(1.35 1)" class="qnr-red" />
            <text x="224" y="40" text-anchor="middle" class="qnr-tick">
              <tspan data-lang-en>roll</tspan>
              <tspan data-lang-vi>lần xào</tspan>
            </text>
            <text x="224" y="64" text-anchor="middle" class="qnr-tick">{i + 1}</text>
          </g>
        </g>
      );
    })}

    <g transform="translate(20 352)">
      <line x1="0" x2="26" y1="10" y2="10" class="qnr-dashed" />
      <text x="34" y="14" class="qnr-label">
        <tspan data-lang-en>the real signal — never changes</tspan>
        <tspan data-lang-vi>tín hiệu thật — không đổi</tspan>
      </text>
    </g>
    <g transform="translate(260 352)">
      <line x1="0" x2="26" y1="10" y2="10" class="qnr-red" />
      <text x="34" y="14" class="qnr-label">
        <tspan data-lang-en>what the model learns from each roll</tspan>
        <tspan data-lang-vi>thứ mô hình học từ mỗi lần xào</tspan>
      </text>
    </g>
  </svg>
</div>

<style>
  .qnr {
    margin: 0;
    width: 100%;
  }
  .qnr svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qnr text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qnr .qnr-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qnr .qnr-label {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qnr .qnr-tick {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qnr-panel {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .qnr-axis {
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .qnr-dashed {
    fill: none;
    stroke: var(--text);
    stroke-width: 2.5;
    stroke-dasharray: 6 5;
  }
  .qnr-red {
    fill: none;
    stroke: var(--red);
    stroke-width: 2.5;
  }
</style>
