---
// Quiz figure for go-concurrency-patterns set 04: the goroutines and channels of the post's first pool
// after main has received one value from results. Topology only, no state verdict.
// Inline SVG, site tokens only.
const workers = [44, 100, 156];
---
<div class="qfig-gq09pg">
  <svg viewBox="0 0 580 270" role="img" aria-label="A producer goroutine sends jobs 1 to 9 into a jobs channel. Three worker goroutines read from jobs and send squares into a results channel. main reads results. A separate closer goroutine waits on a WaitGroup that the three workers belong to. In total there are six goroutines, counting main.">
    <text x="0" y="20" class="qfig-gq09pg-h">
      <tspan data-lang-en>Goroutines and channels of the first pool</tspan>
      <tspan data-lang-vi>Goroutine và channel của pool đầu tiên</tspan>
    </text>

    <rect x="0" y="104" width="86" height="40" rx="4" class="qfig-gq09pg-box" />
    <text x="43" y="129" text-anchor="middle" class="qfig-gq09pg-t">producer</text>

    <line x1="86" y1="124" x2="130" y2="124" class="qfig-gq09pg-line" />
    <text x="108" y="96" text-anchor="middle" class="qfig-gq09pg-m">jobs</text>

    {workers.map((y, i) => (
      <g>
        <line x1="130" y1="124" x2="180" y2={y + 20} class="qfig-gq09pg-line" />
        <rect x="180" y={y} width="104" height="40" rx="4" class="qfig-gq09pg-fill" />
        <text x="232" y={y + 25} text-anchor="middle" class="qfig-gq09pg-in">worker {i + 1}</text>
        <line x1="284" y1={y + 20} x2="340" y2="124" class="qfig-gq09pg-line" />
      </g>
    ))}
    <text x="318" y="96" text-anchor="middle" class="qfig-gq09pg-m">results</text>

    <line x1="340" y1="124" x2="400" y2="124" class="qfig-gq09pg-line" />
    <rect x="400" y="104" width="80" height="40" rx="4" class="qfig-gq09pg-box" />
    <text x="440" y="129" text-anchor="middle" class="qfig-gq09pg-t">main</text>
    <text x="440" y="164" text-anchor="middle" class="qfig-gq09pg-m">
      <tspan data-lang-en>read 1 value</tspan>
      <tspan data-lang-vi>đã đọc 1 giá trị</tspan>
    </text>

    <rect x="180" y="214" width="190" height="38" rx="4" class="qfig-gq09pg-box" />
    <text x="275" y="238" text-anchor="middle" class="qfig-gq09pg-t">closer: wg.Wait()</text>
    <text x="0" y="238" class="qfig-gq09pg-m">
      <tspan data-lang-en>6 goroutines</tspan>
      <tspan data-lang-vi>6 goroutine</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq09pg { margin: 0; width: 100%; }
  .qfig-gq09pg svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq09pg text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq09pg .qfig-gq09pg-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq09pg .qfig-gq09pg-t { font-weight: 700; fill: var(--text); }
  .qfig-gq09pg .qfig-gq09pg-m { fill: var(--text-muted); }
  .qfig-gq09pg .qfig-gq09pg-in { fill: var(--bg); font-weight: 700; }
  .qfig-gq09pg-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-gq09pg-fill { fill: var(--act-3); opacity: 0.9; }
  .qfig-gq09pg-line { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
</style>
