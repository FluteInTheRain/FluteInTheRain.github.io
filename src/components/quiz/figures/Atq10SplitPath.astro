---
// Path from the top of the HRP bisection to R1 on the 12 simulated stocks (250 days), Python:
// level 1 left half gets 0.326; inside it R1 R3 R2 | R4 S2 S1 gives 0.505 to the left part;
// inside that R1 | R3 R2 gives 0.428 to R1.
const steps = [
  { y: 52, en: 'Level 1: left half of six (variance 2.15) against right half (variance 1.04)', vi: 'Mức 1: nửa trái sáu mã (phương sai 2,15) so với nửa phải (phương sai 1,04)', f: '0.326' },
  { y: 112, en: 'Level 2: R1 R3 R2 against R4 S2 S1, left part gets', vi: 'Mức 2: R1 R3 R2 so với R4 S2 S1, phần trái nhận', f: '0.505' },
  { y: 172, en: 'Level 3: R1 against R3 R2, R1 gets', vi: 'Mức 3: R1 so với R3 R2, R1 nhận', f: '0.428' },
];
---
<div class="q10s">
  <svg viewBox="0 0 580 236" role="img" aria-hidden="true">
    <text x="20" y="24" class="q10s-h">
      <tspan data-lang-en>Split factors on the path to R1</tspan>
      <tspan data-lang-vi>Các hệ số chia trên đường tới R1</tspan>
    </text>
    {steps.map((s) => (
      <g>
        <rect x="20" y={s.y - 16} width="540" height="44" rx="8" class="q10s-box" />
        <text x="34" y={s.y + 8} class="q10s-t">
          <tspan data-lang-en>{s.en}</tspan>
          <tspan data-lang-vi>{s.vi}</tspan>
        </text>
        <text x="546" y={s.y + 8} text-anchor="end" class="q10s-f">{s.f}</text>
      </g>
    ))}
    <text x="20" y="226" class="q10s-s">
      <tspan data-lang-en>Say 12 simulated stocks, 250 days. The weight of R1 is the product of the three factors.</tspan>
      <tspan data-lang-vi>Giả sử 12 cổ phiếu mô phỏng, 250 ngày. Tỷ trọng của R1 là tích ba hệ số.</tspan>
    </text>
  </svg>
</div>

<style>
  .q10s { margin: 0; width: 100%; }
  .q10s svg { display: block; width: 100%; height: auto; }
  .q10s text { font-size: 12.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .q10s .q10s-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q10s .q10s-f { font-size: 16px; font-weight: 700; fill: var(--text); }
  .q10s .q10s-s { font-size: 12px; fill: var(--text-muted); }
  .q10s-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
</style>
