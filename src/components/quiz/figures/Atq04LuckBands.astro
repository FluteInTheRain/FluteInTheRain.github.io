---
// Quiz figure for the sample-length set: 95% luck band for the measured annual Sharpe of a zero-edge strategy,
// +-1.96/sqrt(T): 2y 1.39, 5y 0.88, 6y 0.80, 20y 0.44; measured Sharpe 0.7 marked.
const rows: [number, number][] = [[2, 1.39], [5, 0.88], [6, 0.8], [20, 0.44]];
const X0 = 330, SC = 105;
const x = (v: number) => X0 + v * SC;
---
<div class="qfig-atq04lb">
  <svg viewBox="0 0 580 210" role="img" aria-label="Bands around zero showing the range of annual Sharpe ratios luck alone gives 95 percent of the time: plus or minus 1.39 for 2 years, 0.88 for 5 years, 0.80 for 6 years and 0.44 for 20 years. A dashed vertical line marks a measured Sharpe of 0.7.">
    <text x="20" y="16" class="qfig-atq04lb-h">
      <tspan data-lang-en>Range of Sharpe that luck gives, 95% of cases</tspan>
      <tspan data-lang-vi>Khoảng Sharpe mà may rủi cho ra, 95% trường hợp</tspan>
    </text>
    <line x1={x(0.7)} x2={x(0.7)} y1="28" y2="170" class="qfig-atq04lb-mark" />
    <text x={x(0.7) + 6} y="40" class="qfig-atq04lb-m">
      <tspan data-lang-en>Sharpe 0.7</tspan>
      <tspan data-lang-vi>Sharpe 0,7</tspan>
    </text>
    <line x1={x(0)} x2={x(0)} y1="28" y2="170" class="qfig-atq04lb-axis" />
    {rows.map(([y, w], i) => (
      <g>
        <text x="100" y={67 + i * 34} text-anchor="end" class="qfig-atq04lb-yr">
          <tspan data-lang-en>{y} years</tspan>
          <tspan data-lang-vi>{y} năm</tspan>
        </text>
        <rect x={x(-w)} y={50 + i * 34} width={2 * w * SC} height="24" rx="3" class="qfig-atq04lb-band" />
        <text x="540" y={67 + i * 34} text-anchor="end" class="qfig-atq04lb-v">±{w.toFixed(2)}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-atq04lb svg { display: block; width: 100%; height: auto; max-width: 580px; margin: 0 auto; }
  .qfig-atq04lb text { font-size: 12.5px; fill: var(--text-body); }
  .qfig-atq04lb .qfig-atq04lb-h { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-atq04lb .qfig-atq04lb-yr { font-weight: 600; fill: var(--text); }
  .qfig-atq04lb .qfig-atq04lb-v { font-weight: 700; fill: var(--text); }
  .qfig-atq04lb .qfig-atq04lb-m { font-weight: 700; fill: var(--red); }
  .qfig-atq04lb-band { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-atq04lb-axis { stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-atq04lb-mark { stroke: var(--red); stroke-width: 1.6; stroke-dasharray: 4 4; }
</style>
