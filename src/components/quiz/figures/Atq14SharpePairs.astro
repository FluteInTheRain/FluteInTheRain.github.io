---
// Quiz figure for set 07: Sharpe ratios from Lim, Zohren & Roberts Exhibit 3 (88 futures, 1995-2015, before costs).
const g = [
  { en: 'Linear', vi: 'Tuyến tính', a: 1.211, b: 1.496 },
  { en: 'MLP', vi: 'MLP', a: 1.017, b: 2.017 },
  { en: 'LSTM', vi: 'LSTM', a: 0.791, b: 2.907 },
];
const y0 = 176, S = 40;
---
<div class="qfig-atq14s">
  <svg viewBox="0 0 580 230" role="img" aria-label="Sharpe ratios by model and training loss. Linear 1.211 on squared error and 1.496 on Sharpe loss. MLP 1.017 and 2.017. LSTM 0.791 and 2.907. A dashed line marks long-only at 0.759.">
    <text x="0" y="18" class="h">
      <tspan data-lang-en>Sharpe ratio by training loss</tspan>
      <tspan data-lang-vi>Sharpe ratio theo hàm loss huấn luyện</tspan>
    </text>
    <line x1="40" x2="560" y1={y0} y2={y0} class="ax" />
    <line x1="40" x2="560" y1={y0 - 0.759 * S} y2={y0 - 0.759 * S} class="ref" />
    <text x="560" y={y0 - 0.759 * S - 5} text-anchor="end" class="t">
      <tspan data-lang-en>long-only 0.759</tspan>
      <tspan data-lang-vi>mua giữ 0,759</tspan>
    </text>
    {g.map((m, i) => (
      <g>
        <rect x={80 + i * 170} y={y0 - m.a * S} width="50" height={m.a * S} rx="3" class="bar a" />
        <text x={105 + i * 170} y={y0 - m.a * S - 5} text-anchor="middle" class="v">{m.a.toFixed(2)}</text>
        <rect x={140 + i * 170} y={y0 - m.b * S} width="50" height={m.b * S} rx="3" class="bar b" />
        <text x={165 + i * 170} y={y0 - m.b * S - 5} text-anchor="middle" class="v">{m.b.toFixed(2)}</text>
        <text x={135 + i * 170} y={y0 + 18} text-anchor="middle" class="n">
          <tspan data-lang-en>{m.en}</tspan>
          <tspan data-lang-vi>{m.vi}</tspan>
        </text>
      </g>
    ))}
    <rect x="150" y="206" width="12" height="12" class="bar a" />
    <text x="168" y="216" class="t">
      <tspan data-lang-en>squared error</tspan>
      <tspan data-lang-vi>sai số bình phương</tspan>
    </text>
    <rect x="310" y="206" width="12" height="12" class="bar b" />
    <text x="328" y="216" class="t">Sharpe loss</text>
  </svg>
</div>

<style>
  .qfig-atq14s svg { display: block; width: 100%; height: auto; max-width: 580px; margin: 0 auto; }
  .qfig-atq14s text { font-size: 12px; fill: var(--text-body); }
  .qfig-atq14s .h { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-atq14s .n { font-weight: 700; fill: var(--text); }
  .qfig-atq14s .v { font-weight: 700; fill: var(--text); }
  .qfig-atq14s .t { fill: var(--text-muted); }
  .qfig-atq14s .ax { stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-atq14s .ref { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .qfig-atq14s .bar.a { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-atq14s .bar.b { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
</style>
