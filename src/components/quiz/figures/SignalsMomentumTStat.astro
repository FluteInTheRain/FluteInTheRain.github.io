---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 02: the shape of a real, tested signal. The 51labs time-series-momentum study
// (60 liquid Vietnamese stocks, from 2014): weekly returns significant in weeks 2-6,
// t-statistics fade and flip negative around week ten. Curve values are illustrative;
// only the shape and the crossing points come from the finding.
const weeks = [
  { w: 1, t: 0.8 }, { w: 2, t: 2.2 }, { w: 3, t: 2.7 }, { w: 4, t: 2.9 },
  { w: 5, t: 2.6 }, { w: 6, t: 2.1 }, { w: 7, t: 1.4 }, { w: 8, t: 0.5 },
  { w: 9, t: -0.5 }, { w: 10, t: -1.1 }, { w: 11, t: -1.4 }, { w: 12, t: -1.7 },
];
const x0 = 56;
const step = 40;
const y0 = 240;
const scale = 34; // px per t-unit
const px = (w: number) => x0 + (w - 1) * step;
const py = (t: number) => y0 - t * scale;
const path = weeks.map((d, i) => `${i === 0 ? 'M' : 'L'} ${px(d.w)} ${py(d.t)}`).join(' ');
---
<div class="qmts">
  <svg viewBox="0 0 580 452" role="img" aria-hidden="true">
    <DiagramIcon name="chart" x={22} y={20} size={22} />
    <text x="44" y="25" class="qmts-h">
      <tspan data-lang-en>A real signal, measured week by week</tspan>
      <tspan data-lang-vi>Một tín hiệu thật, đo theo từng tuần</tspan>
    </text>
    <text x="44" y="46" class="qmts-muted">
      <tspan data-lang-en>Time-series momentum on Vietnamese stocks (51labs, from 2014): the t-statistic per holding week</tspan>
      <tspan data-lang-vi>Time-series momentum trên cổ phiếu Việt (51labs, từ 2014): t-statistic theo tuần nắm giữ</tspan>
    </text>

    <line x1="32" x2="548" y1="240" y2="240" class="qmts-axis" />
    <line x1="32" x2="548" y1={y0 - 1.96 * scale} y2={y0 - 1.96 * scale} class="qmts-thresh" />
    <line x1="32" x2="548" y1={y0 + 1.96 * scale} y2={y0 + 1.96 * scale} class="qmts-thresh" />
    <text x="548" y={y0 - 1.96 * scale - 7} text-anchor="end" class="qmts-tick">
      <tspan data-lang-en>+1.96 — significance (5%)</tspan>
      <tspan data-lang-vi>+1.96 — ngưỡng ý nghĩa (5%)</tspan>
    </text>
    <text x="548" y={y0 + 1.96 * scale + 15} text-anchor="end" class="qmts-tick">
      <tspan data-lang-en>−1.96</tspan>
      <tspan data-lang-vi>−1,96</tspan>
    </text>

    <rect x={px(2) - step / 2} y="88" width={5 * step} height={y0 + 1.96 * scale - 88} class="qmts-band" />
    <text x={px(4)} y="110" text-anchor="middle" class="qmts-good">
      <tspan data-lang-en>weeks 2–6: significant</tspan>
      <tspan data-lang-vi>tuần 2–6: có ý nghĩa</tspan>
    </text>
    <text x={px(10) - step} y="330" text-anchor="middle" class="qmts-bad">
      <tspan data-lang-en>around week 10: the t-stat</tspan>
      <tspan data-lang-vi>quanh tuần 10: t-stat</tspan>
    </text>
    <text x={px(10) - step} y="348" text-anchor="middle" class="qmts-bad">
      <tspan data-lang-en>fades and flips negative</tspan>
      <tspan data-lang-vi>phai dần và đảo dấu</tspan>
    </text>

    <path d={path} class="qmts-curve" />
    {weeks.map((d) => <circle cx={px(d.w)} cy={py(d.t)} r="4" class={d.t > 1.96 ? 'qmts-pt is-hot' : 'qmts-pt'} />)}
    {weeks.map((d) => (
      <text x={px(d.w)} y="262" text-anchor="middle" class="qmts-tick">{d.w}</text>
    ))}
    <text x="290" y="284" text-anchor="middle" class="qmts-tick">
      <tspan data-lang-en>holding week</tspan>
      <tspan data-lang-vi>tuần nắm giữ</tspan>
    </text>
    <text x="16" y="120" class="qmts-tick" transform="rotate(-90 16 120)">
      <tspan data-lang-en>t-statistic</tspan>
      <tspan data-lang-vi>t-statistic</tspan>
    </text>

    <rect x="20" y="366" width="540" height="66" rx="10" class="qmts-note" />
    <text x="36" y="392" class="qmts-label">
      <tspan data-lang-en>The finding is the study's: significant for weeks 2–6,</tspan>
      <tspan data-lang-vi>Kết luận thuộc về nghiên cứu: có ý nghĩa trong 2–6 tuần,</tspan>
    </text>
    <text x="36" y="412" class="qmts-label">
      <tspan data-lang-en>then fading and turning negative around week ten. Real, thin, unstable.</tspan>
      <tspan data-lang-vi>phai dần và đảo dấu quanh tuần thứ mười. Có thật, mỏng, không bền.</tspan>
    </text>
  </svg>
</div>

<style>
  .qmts {
    margin: 0;
    width: 100%;
  }
  .qmts svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qmts text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qmts .qmts-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qmts .qmts-muted,
  .qmts .qmts-label {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qmts .qmts-tick {
    font-size: 12px;
    fill: var(--text-muted);
  }
  .qmts-axis {
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .qmts-thresh {
    stroke: var(--text-muted);
    stroke-width: 1.2;
    stroke-dasharray: 5 4;
  }
  .qmts-band {
    fill: var(--act-2);
    opacity: 0.12;
  }
  .qmts-curve {
    fill: none;
    stroke: var(--text);
    stroke-width: 2.5;
  }
  .qmts-pt {
    fill: var(--bg-alt);
    stroke: var(--text);
    stroke-width: 2;
  }
  .qmts-pt.is-hot {
    fill: var(--gold);
    stroke: var(--text);
    stroke-width: 2;
  }
  .qmts .qmts-good {
    fill: var(--act-2);
    font-weight: 700;
  }
  .qmts .qmts-bad {
    fill: var(--red);
    font-weight: 700;
  }
  .qmts-note {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
</style>
