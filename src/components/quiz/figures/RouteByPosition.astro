---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for replication set 05: the leader's log position, the position saved for one user,
// and how far each of four replicas has replayed. Shows inputs only, never which replica may serve the read.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const x0 = 110;
const scale = 3.7;
const base = 4150;
const px = (p: number) => x0 + (p - base) * scale;
const fmt = (n: number) => n.toLocaleString('en-US');
const leader = 4262;
const rows = [
  { name: 'Leader', icon: 'postgres', pos: leader, y: 150 },
  { name: 'R1', icon: 'server', pos: 4196, y: 188 },
  { name: 'R2', icon: 'server', pos: 4230, y: 226 },
  { name: 'R3', icon: 'server', pos: 4200, y: 264 },
  { name: 'R4', icon: 'server', pos: 4171, y: 302 },
];
const mia = 4200;
const raj = 4215;
const bh = 24;
---
<div class="qfig-rbp">
  <svg viewBox="0 0 580 436" role="img" aria-label="The leader's log position, the position saved for one user, and how far each of four replicas has replayed the log.">
    <DiagramIcon name="laptop" x="24" y="30" size="24" />
    <text x="52" y="35" class="qfig-rbp-t">
      <tspan data-lang-en>Mia saves a comment at log position 4,200</tspan>
      <tspan data-lang-vi>Mia lưu một bình luận ở vị trí log 4.200</tspan>
    </text>
    <DiagramIcon name="redis" x="24" y="66" size="24" />
    <text x="52" y="71" class="qfig-rbp-t">
      <tspan data-lang-en>The app keeps that position for her in Redis</tspan>
      <tspan data-lang-vi>App giữ vị trí đó cho cô ấy trong Redis</tspan>
    </text>

    <text x={px(mia) - 4} y="124" text-anchor="end" class="qfig-rbp-g">
      <tspan data-lang-en>Mia: 4,200</tspan>
      <tspan data-lang-vi>Mia: 4.200</tspan>
    </text>

    {rows.map((r) => (
      <g>
        <DiagramIcon name={r.icon as any} x="20" y={r.y + bh / 2} size="22" />
        <text x="44" y={r.y + bh / 2 + 5} class="qfig-rbp-n">
          <tspan data-lang-en>{r.name}</tspan>
          <tspan data-lang-vi>{r.name === 'Leader' ? 'Leader' : r.name}</tspan>
        </text>
        <rect x={x0} y={r.y} width={px(r.pos) - x0} height={bh} rx="3" class="qfig-rbp-ok" />
        {r.pos < leader && (
          <rect x={px(r.pos)} y={r.y} width={px(leader) - px(r.pos)} height={bh} rx="3" class="qfig-rbp-lag" />
        )}
        <text x={px(leader) + 8} y={r.y + bh / 2 + 5} class="qfig-rbp-v"><tspan data-lang-en>{fmt(r.pos)}</tspan><tspan data-lang-vi>{fmt(r.pos).replace(',', '.')}</tspan></text>
      </g>
    ))}

    <line x1={px(raj)} x2={px(raj)} y1="140" y2="338" class="qfig-rbp-raj" />
    <line x1={px(mia)} x2={px(mia)} y1="134" y2="338" class="qfig-rbp-mia" />
    <text x={px(raj) + 6} y="358" class="qfig-rbp-m">
      <tspan data-lang-en>Raj's comment: 4,215</tspan>
      <tspan data-lang-vi>Bình luận của Raj: 4.215</tspan>
    </text>

    <rect x="0" y="384" width="16" height="12" rx="2" class="qfig-rbp-ok" />
    <text x="24" y="395" class="qfig-rbp-m">
      <tspan data-lang-en>Replayed</tspan>
      <tspan data-lang-vi>Đã phát lại</tspan>
    </text>
    <rect x="130" y="384" width="16" height="12" rx="2" class="qfig-rbp-lag" />
    <text x="154" y="395" class="qfig-rbp-m">
      <tspan data-lang-en>Not yet replayed</tspan>
      <tspan data-lang-vi>Chưa phát lại</tspan>
    </text>
    <text x="0" y="426" class="qfig-rbp-m">
      <tspan data-lang-en>Bars show the log position each node has reached; the axis starts at 4,150.</tspan>
      <tspan data-lang-vi>Thanh cho biết vị trí log mỗi node đã tới; trục bắt đầu từ 4.150.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-rbp { margin: 0; width: 100%; }
  .qfig-rbp svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-rbp text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-rbp .qfig-rbp-t { font-size: 15px; fill: var(--text); font-weight: 600; }
  .qfig-rbp .qfig-rbp-n { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-rbp .qfig-rbp-v { font-size: 13px; font-weight: 600; fill: var(--text); }
  .qfig-rbp .qfig-rbp-m { font-size: 13px; fill: var(--text-muted); }
  .qfig-rbp .qfig-rbp-g { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-rbp-ok { fill: var(--act-2); opacity: 0.85; }
  .qfig-rbp-lag { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1; }
  .qfig-rbp-mia { stroke: var(--gold); stroke-width: 3; }
  .qfig-rbp-raj { stroke: var(--text-muted); stroke-width: 1.6; stroke-dasharray: 5 4; }
</style>
