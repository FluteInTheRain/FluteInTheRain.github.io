---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-auth set 08: a time axis 09:45 to 10:15. A token is issued at 09:50 (lives 15 min, the end is
// not drawn), an admin changes the user's allowance at 10:00, and two calls with the same token happen at 10:03 and 10:08.
// It shows the events only, not the guard's answers. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const x0 = 30;
const px = 17.3; // pixels per minute
const tx = (m: number) => x0 + m * px; // m = minutes after 09:45
const axisY = 214;
const ticks = [
  { m: 0, t: '09:45' }, { m: 5, t: '09:50' }, { m: 10, t: '09:55' }, { m: 15, t: '10:00' },
  { m: 20, t: '10:05' }, { m: 25, t: '10:10' }, { m: 30, t: '10:15' },
];
---
<div class="qfig-tf">
  <svg viewBox="0 0 580 262" role="img" aria-label="A time axis from 09:45 to 10:15: a token is issued at 09:50 and lives 15 minutes, an admin removes the write permission at 10:00, and the same token is sent in calls at 10:03 and 10:08.">
    <!-- issue -->
    <DiagramIcon name="key" x={tx(5) - 14} y={20} size={28} />
    <line x1={tx(5)} x2={tx(5)} y1="52" y2={axisY} class="qfig-tf-drop" />
    <text x={tx(5) + 20} y="34" class="qfig-tf-t">
      <tspan data-lang-en>09:50 Dana logs in</tspan>
      <tspan data-lang-vi>09:50 Dana đăng nhập</tspan>
    </text>
    <text x={tx(5) + 20} y="52" class="qfig-tf-m">
      <tspan data-lang-en>token: cases:read, cases:write; lives 15 min</tspan>
      <tspan data-lang-vi>token: cases:read, cases:write; sống 15 phút</tspan>
    </text>

    <!-- admin change -->
    <DiagramIcon name="user" x={tx(15) - 14} y={86} size={28} />
    <line x1={tx(15)} x2={tx(15)} y1="118" y2={axisY} class="qfig-tf-drop" />
    <text x={tx(15) + 20} y="100" class="qfig-tf-t">
      <tspan data-lang-en>10:00 admin removes cases:write</tspan>
      <tspan data-lang-vi>10:00 admin gỡ cases:write</tspan>
    </text>
    <text x={tx(15) + 20} y="118" class="qfig-tf-m">
      <tspan data-lang-en>from Dana's allowance</tspan>
      <tspan data-lang-vi>khỏi phạm vi được phép của Dana</tspan>
    </text>

    <!-- two calls -->
    {[18, 23].map((m, i) => (
      <g>
        <circle cx={tx(m)} cy="188" r="8" class="qfig-tf-call" />
        <text x={tx(m)} y="193" text-anchor="middle" class="qfig-tf-q">?</text>
        <line x1={tx(m)} x2={tx(m)} y1="196" y2={axisY} class="qfig-tf-drop" />
        <text x={tx(m)} y="168" text-anchor="middle" class="qfig-tf-t">{i === 0 ? '10:03' : '10:08'}</text>
      </g>
    ))}
    <text x={tx(18) - 8} y="144" class="qfig-tf-m">
      <tspan data-lang-en>POST /purge, same token</tspan>
      <tspan data-lang-vi>POST /purge, cùng token</tspan>
    </text>

    <!-- axis -->
    <line x1={tx(0)} x2={tx(30)} y1={axisY} y2={axisY} class="qfig-tf-axis" />
    {ticks.map((k) => (
      <g>
        <line x1={tx(k.m)} x2={tx(k.m)} y1={axisY} y2={axisY + 5} class="qfig-tf-axis" />
        <text x={tx(k.m)} y={axisY + 21} text-anchor="middle" class="qfig-tf-m">{k.t}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-tf { margin: 0; width: 100%; }
  .qfig-tf svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-tf text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-tf .qfig-tf-t { font-weight: 700; fill: var(--text); }
  .qfig-tf .qfig-tf-m { fill: var(--text-muted); }
  .qfig-tf .qfig-tf-q { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qfig-tf-drop { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .qfig-tf-axis { stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-tf-call { fill: var(--bg); stroke: var(--text); stroke-width: 2; }
</style>
