---
// Quiz figure for the images post quiz (Uxq07).
---
<div class="qfig-uxq07scrimgradient">
  <svg viewBox="0 0 600 300" role="img" aria-label="A tall card over the cloud photo with a gradient darkest at the bottom and transparent at the top, and two text blocks marked A and B at different heights.">
    <defs>
      <linearGradient id="uxq07grad" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#000" stop-opacity="0.75" />
        <stop offset="1" stop-color="#000" stop-opacity="0" />
      </linearGradient>
    </defs>
    <rect x="190" y="10" width="220" height="270" fill="#e8eef5" />
    <rect x="190" y="10" width="220" height="270" fill="url(#uxq07grad)" />
    <rect x="190" y="10" width="220" height="270" fill="none" class="ln" />
    <rect x="210" y="140" width="150" height="10" rx="3" fill="#ffffff" />
    <rect x="210" y="156" width="110" height="10" rx="3" fill="#ffffff" />
    <rect x="210" y="226" width="150" height="10" rx="3" fill="#ffffff" />
    <rect x="210" y="242" width="110" height="10" rx="3" fill="#ffffff" />
    <line x1="420" y1="153" x2="450" y2="153" class="acc" />
    <text x="458" y="158" class="h">B</text>
    <text x="458" y="176" class="m"><tspan data-lang-en>50% up from the bottom</tspan><tspan data-lang-vi>Cao 50% từ đáy</tspan></text>
    <line x1="420" y1="239" x2="450" y2="239" class="acc" />
    <text x="458" y="244" class="h">A</text>
    <text x="458" y="262" class="m"><tspan data-lang-en>25% up from the bottom</tspan><tspan data-lang-vi>Cao 25% từ đáy</tspan></text>
    <text x="180" y="30" text-anchor="end" class="m"><tspan data-lang-en>Top: clear</tspan><tspan data-lang-vi>Đỉnh: trong</tspan></text>
    <text x="180" y="276" text-anchor="end" class="m"><tspan data-lang-en>Bottom: darkest</tspan><tspan data-lang-vi>Đáy: đậm nhất</tspan></text>
  </svg>
</div>

<style>
  .qfig-uxq07scrimgradient { margin: 0; width: 100%; }
  .qfig-uxq07scrimgradient svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq07scrimgradient text { font-size: 13.5px; fill: var(--text-body); }
  .qfig-uxq07scrimgradient .h { font-weight: 700; fill: var(--text); }
  .qfig-uxq07scrimgradient .m { fill: var(--text-muted); font-size: 13px; }
  .qfig-uxq07scrimgradient .mono { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; fill: var(--text-muted); }
  .qfig-uxq07scrimgradient .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq07scrimgradient .bar { fill: var(--border); }
  .qfig-uxq07scrimgradient .ln { stroke: var(--text-muted); stroke-width: 1.4; fill: none; }
  .qfig-uxq07scrimgradient .acc { stroke: var(--red); stroke-width: 2; fill: none; }
  .qfig-uxq07scrimgradient .accf { fill: var(--red); }
  .qfig-uxq07scrimgradient .dash { stroke: var(--red); stroke-width: 2; stroke-dasharray: 6 4; fill: none; }
  .qfig-uxq07scrimgradient .ico { stroke: var(--text); fill: none; stroke-linecap: round; stroke-linejoin: round; }
</style>
