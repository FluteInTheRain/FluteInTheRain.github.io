---
// The 11 merge heights of the 12-stock Ward tree on 250 days (Python): 0.3523 0.3583 0.3831 0.3894 0.3897
// 0.3971 0.4002 0.402 0.4081 0.9865 1.0621.
const hs = [0.3523, 0.3583, 0.3831, 0.3894, 0.3897, 0.3971, 0.4002, 0.402, 0.4081, 0.9865, 1.0621];
const X0 = 40, X1 = 540;
const hx = (h: number) => X0 + (h / 1.1) * (X1 - X0);
---
<div class="q10m">
  <svg viewBox="0 0 580 190" role="img" aria-hidden="true">
    <text x="20" y="24" class="q10m-h">
      <tspan data-lang-en>Heights at which the 11 merges happened</tspan>
      <tspan data-lang-vi>Độ cao của 11 lần nhập cụm</tspan>
    </text>
    <line x1={X0} y1="110" x2={X1} y2="110" class="q10m-axis" />
    {[0, 0.5, 1].map((t) => (
      <g>
        <line x1={hx(t)} y1="106" x2={hx(t)} y2="114" class="q10m-axis" />
        <text x={hx(t)} y="132" text-anchor="middle" class="q10m-ax">{t}</text>
      </g>
    ))}
    {hs.map((h, i) => (
      <circle cx={hx(h)} cy={h > 0.5 ? 90 : 90 - (i % 3) * 14} r="5.5" class={h > 0.5 ? 'q10m-dot is-hi' : 'q10m-dot'} />
    ))}
    <text x={hx(0.38)} y="156" text-anchor="middle" class="q10m-t">
      <tspan data-lang-en>9 merges between 0.35 and 0.41</tspan>
      <tspan data-lang-vi>9 lần nhập từ 0,35 đến 0,41</tspan>
    </text>
    <text x={hx(0.9865)} y="156" text-anchor="middle" class="q10m-t">
      <tspan data-lang-en>0.99 and 1.06</tspan>
      <tspan data-lang-vi>0,99 và 1,06</tspan>
    </text>
    <text x="20" y="180" class="q10m-s">
      <tspan data-lang-en>Say 12 simulated stocks, 250 days, Ward linkage on d = √(½(1−ρ)).</tspan>
      <tspan data-lang-vi>Giả sử 12 cổ phiếu mô phỏng, 250 ngày, Ward trên d = √(½(1−ρ)).</tspan>
    </text>
  </svg>
</div>

<style>
  .q10m { margin: 0; width: 100%; }
  .q10m svg { display: block; width: 100%; height: auto; }
  .q10m text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .q10m .q10m-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q10m .q10m-ax { font-size: 12px; fill: var(--text-muted); }
  .q10m .q10m-t { font-size: 13px; font-weight: 600; fill: var(--text); }
  .q10m .q10m-s { font-size: 12px; fill: var(--text-muted); }
  .q10m-axis { stroke: var(--text-muted); stroke-width: 1.3; }
  .q10m-dot { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.8; }
  .q10m-dot.is-hi { stroke: var(--gold); fill: var(--gold-tint-bg); }
</style>
