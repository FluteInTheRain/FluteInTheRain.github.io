---
// Set 08: ten training histories (seeds 1-10) of the same Q-learning agent on 500 days of noise, cost 0.05%, 1,000 passes.
// Values from the post's simulation (python3 seeds.py): in-sample %, mean of 100 fresh paths %, position changes.
const W = 580;
const H = 270;
const d = [
  [1, 8.9, -2.5, 50], [2, 15.3, -9.0, 167], [3, 0, 0, 0], [4, 16.5, -7.6, 159], [5, 0, 0, 0],
  [6, 5.4, -6.4, 150], [7, 0, 0, 0], [8, 10.1, -2.4, 70], [9, 18.8, -0.9, 32], [10, 25.2, -8.3, 169],
];
const X0 = 60, STEP = 50, Z = 120, K = 3.6;
---
<div class="q19s">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <text x="14" y="20" class="q19s-h"><tspan data-lang-en>Ten training histories, same code</tspan><tspan data-lang-vi>Mười lịch sử huấn luyện, cùng một code</tspan></text>
    <line x1="30" x2="566" y1={Z} y2={Z} class="q19s-zero" />
    {d.map(([s, a, b, tr], i) => (
      <g>
        <rect x={X0 + i * STEP - 14} y={Z - a * K} width="13" height={Math.max(a * K, 0)} class="q19s-a" />
        <rect x={X0 + i * STEP + 1} y={Z} width="13" height={Math.max(-b * K, 0)} class="q19s-b" />
        <text x={X0 + i * STEP} y="190" text-anchor="middle" class="q19s-s">{s}</text>
        <text x={X0 + i * STEP} y="208" text-anchor="middle" class="q19s-s">{tr}</text>
      </g>
    ))}
    <text x="4" y="190" class="q19s-s">seed</text>
    <text x="4" y="208" class="q19s-s"><tspan data-lang-en>trades</tspan><tspan data-lang-vi>lệnh</tspan></text>
    <rect x="30" y="226" width="12" height="12" class="q19s-a" /><text x="48" y="237" class="q19s-s"><tspan data-lang-en>own training path (%)</tspan><tspan data-lang-vi>chuỗi đã học (%)</tspan></text>
    <rect x="300" y="226" width="12" height="12" class="q19s-b" /><text x="318" y="237" class="q19s-s"><tspan data-lang-en>mean of 100 fresh paths (%)</tspan><tspan data-lang-vi>trung bình 100 chuỗi mới (%)</tspan></text>
    <text x="30" y="260" class="q19s-s"><tspan data-lang-en>Seeds 3, 5 and 7 never trade. Seed 10 has the highest in-sample return, +25.2%.</tspan><tspan data-lang-vi>Seed 3, 5 và 7 không giao dịch. Seed 10 có lợi suất trong mẫu cao nhất, +25,2%.</tspan></text>
  </svg>
</div>
<style>
  .q19s { margin: 0; width: 100%; }
  .q19s svg { display: block; width: 100%; height: auto; }
  .q19s text { font-size: 12.5px; fill: var(--text-muted); font-variant-numeric: tabular-nums; }
  .q19s .q19s-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q19s .q19s-zero { stroke: var(--text-muted); stroke-width: 1.3; }
  .q19s .q19s-a { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.3; }
  .q19s .q19s-b { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; }
</style>
