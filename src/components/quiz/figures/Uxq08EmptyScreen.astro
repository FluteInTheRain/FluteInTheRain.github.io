---
// Quiz figure for Post 8 (finishing touches): a Webhooks screen with zero rows.
---
<div class="qfig-uxq08emptyscreen">
  <svg viewBox="0 0 600 250" role="img" aria-label="A Webhooks screen for a brand-new account. A toolbar shows a search box, a Status All dropdown and an Export CSV button. Below it a table header and the single line No webhooks found.">
    <rect x="10" y="10" width="580" height="230" rx="8" class="panel" />
    <text x="30" y="42" class="h"><tspan data-lang-en>Webhooks</tspan><tspan data-lang-vi>Webhook</tspan></text>
    <rect x="30" y="58" width="220" height="30" rx="5" class="field" />
    <text x="42" y="78" class="m"><tspan data-lang-en>Search webhooks</tspan><tspan data-lang-vi>Tìm webhook</tspan></text>
    <rect x="262" y="58" width="130" height="30" rx="5" class="field" />
    <text x="274" y="78" class="m"><tspan data-lang-en>Status: All</tspan><tspan data-lang-vi>Trạng thái: Tất cả</tspan></text>
    <rect x="470" y="58" width="100" height="30" rx="5" class="btn" />
    <text x="484" y="78" class="b"><tspan data-lang-en>Export CSV</tspan><tspan data-lang-vi>Xuất CSV</tspan></text>
    <line x1="30" y1="106" x2="570" y2="106" class="ln" />
    <text x="30" y="126" class="m"><tspan data-lang-en>URL</tspan><tspan data-lang-vi>URL</tspan></text>
    <text x="330" y="126" class="m"><tspan data-lang-en>Last delivery</tspan><tspan data-lang-vi>Lần gửi gần nhất</tspan></text>
    <line x1="30" y1="136" x2="570" y2="136" class="ln" />
    <text x="300" y="196" class="t" text-anchor="middle"><tspan data-lang-en>No webhooks found.</tspan><tspan data-lang-vi>Không tìm thấy webhook nào.</tspan></text>
  </svg>
</div>

<style>
  .qfig-uxq08emptyscreen { margin: 0; width: 100%; }
  .qfig-uxq08emptyscreen svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq08emptyscreen text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq08emptyscreen .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-uxq08emptyscreen .t { font-size: 14px; }
  .qfig-uxq08emptyscreen .m { fill: var(--text-muted); }
  .qfig-uxq08emptyscreen .b { font-weight: 600; fill: var(--text); }
  .qfig-uxq08emptyscreen .panel { fill: var(--card-bg); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq08emptyscreen .field { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-uxq08emptyscreen .btn { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1; }
  .qfig-uxq08emptyscreen .ln { stroke: var(--border); stroke-width: 1; }
</style>
