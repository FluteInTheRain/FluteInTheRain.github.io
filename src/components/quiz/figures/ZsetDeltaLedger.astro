---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for stream set 04. Top: order events that add up to the current state, with one user's events
// scattered over log segments and a nightly backup. Bottom: a batch of six customer changes arriving at a
// view over 1,000,000 rows where city A holds 500,000. It shows the inputs only, never the net result.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
function head(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`;
}
const segs = [
  { x: 14, en: 'Segment 1', vi: 'Đoạn 1', hit: true },
  { x: 108, en: 'Segment 2', vi: 'Đoạn 2', hit: true },
  { x: 202, en: 'Segment 3', vi: 'Đoạn 3', hit: true },
];
const rows = [
  { en: 'New customer in A', vi: 'Khách mới ở A', n: 3, kind: 'add' },
  { en: 'Customer deleted in A', vi: 'Xoá khách ở A', n: 2, kind: 'del' },
  { en: 'Customer moved A to B', vi: 'Khách chuyển A sang B', n: 1, kind: 'mov' },
];
---
<div class="qfig-zs">
  <svg viewBox="0 0 580 376" role="img" aria-label="Top: three order events add up to the current state of an order, and one user's events sit in three log segments and a nightly backup. Bottom: a batch of six customer changes (3 new in city A, 2 deleted in A, 1 moved from A to B) arrives at a view over 1,000,000 rows where city A holds 500,000.">
    <text x="0" y="20" class="qfig-zs-h">
      <tspan data-lang-en>Events add up to the state</tspan>
      <tspan data-lang-vi>Sự kiện cộng lại thành trạng thái</tspan>
    </text>

    <!-- events -> state -->
    {[
      { x: 0, w: 104, en: 'OrderPlaced', vi: 'OrderPlaced' },
      { x: 124, w: 160, en: 'ItemRemovedFromCart', vi: 'ItemRemovedFromCart' },
      { x: 304, w: 112, en: 'OrderCancelled', vi: 'OrderCancelled' },
    ].map((e, i) => (
      <g>
        <rect x={e.x} y="34" width={e.w} height="34" rx="6" class="qfig-zs-ev" />
        <text x={e.x + e.w / 2} y="56" text-anchor="middle" class="qfig-zs-t qfig-zs-ts">{e.en}</text>
      </g>
    ))}
    <text x="114" y="57" text-anchor="middle" class="qfig-zs-op">+</text>
    <text x="294" y="57" text-anchor="middle" class="qfig-zs-op">+</text>
    <text x="430" y="57" text-anchor="middle" class="qfig-zs-op">=</text>
    <rect x="446" y="34" width="134" height="34" rx="6" class="qfig-zs-state" />
    <text x="513" y="56" text-anchor="middle" class="qfig-zs-t">
      <tspan data-lang-en>Order state now</tspan>
      <tspan data-lang-vi>Trạng thái hiện tại</tspan>
    </text>

    <!-- log segments and backup -->
    {segs.map((s) => (
      <g>
        <rect x={s.x} y="92" width="84" height="40" rx="6" class="qfig-zs-seg" />
        <text x={s.x + 42} y="108" text-anchor="middle" class="qfig-zs-m">
          <tspan data-lang-en>{s.en}</tspan>
          <tspan data-lang-vi>{s.vi}</tspan>
        </text>
        <circle cx={s.x + 42} cy="122" r="5" class="qfig-zs-pii" />
      </g>
    ))}
    <DiagramIcon name="backup" x="306" y="96" size={32} />
    <text x="344" y="109" class="qfig-zs-t">
      <tspan data-lang-en>Nightly backups</tspan>
      <tspan data-lang-vi>Backup hằng đêm</tspan>
    </text>
    <circle cx="350" cy="123" r="5" class="qfig-zs-pii" />
    <text x="362" y="127" class="qfig-zs-m">
      <tspan data-lang-en>also keep the copy</tspan>
      <tspan data-lang-vi>cũng giữ bản sao</tspan>
    </text>
    <circle cx="14" cy="150" r="5" class="qfig-zs-pii" />
    <text x="26" y="154" class="qfig-zs-m">
      <tspan data-lang-en>One user's events, spread over the log and the backups</tspan>
      <tspan data-lang-vi>Sự kiện của một người dùng, rải khắp log và backup</tspan>
    </text>

    <line x1="0" x2="580" y1="174" y2="174" class="qfig-zs-rule" />

    <!-- view and batch -->
    <text x="0" y="200" class="qfig-zs-h">
      <tspan data-lang-en>One batch reaches the live view</tspan>
      <tspan data-lang-vi>Một batch đến view chạy liên tục</tspan>
    </text>

    {rows.map((r, i) => (
      <g>
        <rect x="0" y={216 + i * 44} width="280" height="36" rx="6" class={'qfig-zs-row'} />
        <text x="12" y={239 + i * 44} class="qfig-zs-t">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <text x="268" y={239 + i * 44} text-anchor="end" class="qfig-zs-n">{`× ${r.n}`}</text>
      </g>
    ))}
    <text x="0" y="364" class="qfig-zs-m">
      <tspan data-lang-en>CDC stream: 6 changes in this batch</tspan>
      <tspan data-lang-vi>Luồng CDC: 6 thay đổi trong batch này</tspan>
    </text>

    <path d="M 286 270 L 322 270" class="qfig-zs-flow" />
    <polygon points={head(330, 270)} class="qfig-zs-flowhead" />

    <rect x="336" y="216" width="244" height="124" rx="8" class="qfig-zs-view" />
    <DiagramIcon name="db" x="348" y="226" size={30} />
    <text x="386" y="238" class="qfig-zs-t">customers_per_city</text>
    <text x="348" y="272" class="qfig-zs-m">
      <tspan data-lang-en>Built over 1,000,000 rows</tspan>
      <tspan data-lang-vi>Dựng trên 1.000.000 dòng</tspan>
    </text>
    <rect x="348" y="288" width="104" height="40" rx="6" class="qfig-zs-city" />
    <text x="400" y="304" text-anchor="middle" class="qfig-zs-m">
      <tspan data-lang-en>City A</tspan>
      <tspan data-lang-vi>Thành phố A</tspan>
    </text>
    <text x="400" y="321" text-anchor="middle" class="qfig-zs-n">500,000</text>
    <rect x="464" y="288" width="104" height="40" rx="6" class="qfig-zs-city" />
    <text x="516" y="312" text-anchor="middle" class="qfig-zs-m">
      <tspan data-lang-en>City B</tspan>
      <tspan data-lang-vi>Thành phố B</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-zs { margin: 0; width: 100%; }
  .qfig-zs svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-zs text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-zs .qfig-zs-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-zs .qfig-zs-t { font-weight: 600; fill: var(--text); }
  .qfig-zs .qfig-zs-ts { font-size: 13px; }
  .qfig-zs .qfig-zs-m { fill: var(--text-muted); }
  .qfig-zs .qfig-zs-n { font-weight: 700; fill: var(--text); }
  .qfig-zs .qfig-zs-op { font-size: 20px; font-weight: 700; fill: var(--text-muted); }
  .qfig-zs-ev { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-zs-state { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-zs-seg { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-zs-pii { fill: var(--red); stroke: var(--bg); stroke-width: 1.2; }
  .qfig-zs-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-zs-row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-zs-view { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.6; }
  .qfig-zs-city { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-zs-flow { stroke: var(--text-muted); stroke-width: 2; fill: none; }
  .qfig-zs-flowhead { fill: var(--text-muted); }
</style>
