---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 06: the ±7% band on HOSE for the illustrative reference 24,500:
// theoretical ceiling 26,215 -> rounds DOWN to 26,200; theoretical floor 22,785 -> rounds UP to 22,800.
const W = 580;
const H = 430;
const yCeil = 90;
const yRef = 240;
const yFloor = 380;
const xLine = 300;
const rows = [
  { y: yCeil, name: 'ceiling (+7%)', nameVi: 'giá trần (+7%)', theo: 'theoretical 26,215', theoVi: 'lý thuyết 26.215', price: '26,200', priceVi: '26.200', note: 'rounded down', noteVi: 'làm tròn xuống' },
  { y: yRef, name: 'reference = yesterday’s close', nameVi: 'tham chiếu = đóng cửa hôm trước', theo: '', theoVi: '', price: '24,500', priceVi: '24.500', note: 'anchor of the band', noteVi: 'mốc neo của dải' },
  { y: yFloor, name: 'floor (−7%)', nameVi: 'giá sàn (−7%)', theo: 'theoretical 22,785', theoVi: 'lý thuyết 22.785', price: '22,800', priceVi: '22.800', note: 'rounded up', noteVi: 'làm tròn lên' },
];
---
<div class="qba">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <DiagramIcon name="scale" x={18} y={16} size={22} />
    <text x="40" y="21" class="qba-h">
      <tspan data-lang-en>Where today's price may go: the ±7% band on HOSE</tspan>
      <tspan data-lang-vi>Nơi giá hôm nay được đi: dải ±7% trên HOSE</tspan>
    </text>

    <rect x="110" y={yCeil - 12} width="380" height={yFloor - yCeil + 24} rx="10" class="qba-band" />
    {rows.map((r) => (
      <g>
        <line x1="110" x2="490" y1={r.y} y2={r.y} class={r.theo ? 'qba-edge' : 'qba-refline'} />
        <text x="110" y={r.y - 8} class="qba-name">
          <tspan data-lang-en>{r.name}</tspan>
          <tspan data-lang-vi>{r.nameVi}</tspan>
        </text>
        <text x="490" y={r.y - 8} text-anchor="end" class="qba-tick">
          <tspan data-lang-en>{r.theo}</tspan>
          <tspan data-lang-vi>{r.theoVi}</tspan>
        </text>
        <text x="100" y={r.y + 6} text-anchor="end" class="qba-price">
          <tspan data-lang-en>{r.price}</tspan>
          <tspan data-lang-vi>{r.priceVi}</tspan>
        </text>
        <text x="110" y={r.y + 22} class="qba-tick">
          <tspan data-lang-en>{r.note}</tspan>
          <tspan data-lang-vi>{r.noteVi}</tspan>
        </text>
      </g>
    ))}

    <text x="300" y={(yCeil + yRef) / 2} text-anchor="middle" class="qba-mid">+7%</text>
    <text x="300" y={(yRef + yFloor) / 2 + 8} text-anchor="middle" class="qba-mid">−7%</text>

    <line x1="14" x2={W - 14} y1="408" y2="408" class="qba-rule" />
    <text x="14" y="424" class="qba-note">
      <tspan data-lang-en>Ceiling rounds down, floor rounds up — the real band is never wider than ±7%. (Illustrative reference.)</tspan>
      <tspan data-lang-vi>Trần làm tròn xuống, sàn làm tròn lên — dải thật không bao giờ rộng hơn ±7%. (Tham chiếu minh hoạ.)</tspan>
    </text>
  </svg>
</div>

<style>
  .qba {
    margin: 0;
    width: 100%;
  }
  .qba svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qba text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qba .qba-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qba .qba-band {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .qba .qba-edge {
    stroke: var(--act-0);
    stroke-width: 2;
  }
  .qba .qba-refline {
    stroke: var(--gold);
    stroke-width: 2;
  }
  .qba .qba-name {
    font-size: 14px;
    font-weight: 600;
    fill: var(--text);
  }
  .qba .qba-price {
    font-size: 18px;
    font-weight: 700;
    fill: var(--text);
  }
  .qba .qba-tick {
    font-size: 12px;
    fill: var(--text-muted);
  }
  .qba .qba-mid {
    font-size: 20px;
    font-weight: 700;
    fill: var(--text-faint);
  }
  .qba .qba-rule {
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .qba .qba-note {
    font-size: 13px;
    fill: var(--text-body);
  }
</style>
