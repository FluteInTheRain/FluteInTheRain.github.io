---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for transactions set 08: three workloads of a payments service (a hot counter on one thread,
// a ledger with a long report beside short transfers, a worker taking queue messages into the ledger database).
// Inline SVG, site tokens only, no <marker>/<defs>. Shows only the scenario's inputs, never a result.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 7 * Math.cos(a)} ${y2 - 7 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const queue = [0, 1, 2, 3];
const ticks = Array.from({ length: 42 }, (_, i) => 16 + i * 13);
const a1 = arrow(124, 64, 160, 64);
const c1 = arrow(64, 530, 150, 530);
const c2 = arrow(212, 530, 340, 530);
---
<div class="qfig-sp">
  <svg viewBox="0 0 580 668" role="img" aria-label="Three lanes. A: transactions wait in line for one thread, with a single-shard transaction taking 0.05 ms and a cross-shard one 1 ms. B: a 5-minute report runs beside many short transfers on the ledger database. C: a worker takes a message from a queue and updates the ledger database, and the broker sends the message again if it is not acknowledged.">
    <text x="0" y="22" class="qfig-sp-h">
      <tspan data-lang-en>A. Hot counter on one shard</tspan>
      <tspan data-lang-vi>A. Bộ đếm nóng trên một shard</tspan>
    </text>
    <rect x="0" y="30" width="580" height="174" rx="8" class="qfig-sp-card" />
    {queue.map((i) => <rect x={16 + i * 26} y="54" width="20" height="20" rx="4" class="qfig-sp-job" />)}
    <text x="16" y="96" class="qfig-sp-m">
      <tspan data-lang-en>Transactions wait in line</tspan>
      <tspan data-lang-vi>Giao dịch xếp hàng chờ</tspan>
    </text>
    <g class="qfig-sp-go"><path d={a1.line} /><polygon points={a1.head} /></g>
    <rect x="164" y="44" width="250" height="40" rx="8" class="qfig-sp-box" />
    <DiagramIcon name="cpu" x={188} y={64} size={26} />
    <text x="210" y="69" class="qfig-sp-t">
      <tspan data-lang-en>One thread, one at a time</tspan>
      <tspan data-lang-vi>Một luồng, chạy lần lượt</tspan>
    </text>
    <text x="16" y="124">
      <tspan data-lang-en>Single-shard transaction: 0.05 ms</tspan>
      <tspan data-lang-vi>Giao dịch trong một shard: 0,05 ms</tspan>
    </text>
    <rect x="16" y="130" width="15" height="10" rx="2" class="qfig-sp-ok" />
    <text x="16" y="160">
      <tspan data-lang-en>Cross-shard transaction: 1 ms</tspan>
      <tspan data-lang-vi>Giao dịch xuyên shard: 1 ms</tspan>
    </text>
    <rect x="16" y="166" width="300" height="10" rx="2" class="qfig-sp-bad" />
    <text x="16" y="196" class="qfig-sp-m">
      <tspan data-lang-en>Bar length: how long one transaction holds the thread.</tspan>
      <tspan data-lang-vi>Độ dài thanh: thời gian một giao dịch giữ luồng.</tspan>
    </text>

    <text x="0" y="240" class="qfig-sp-h">
      <tspan data-lang-en>B. Ledger with long reports</tspan>
      <tspan data-lang-vi>B. Sổ cái có báo cáo chạy lâu</tspan>
    </text>
    <rect x="0" y="248" width="580" height="194" rx="8" class="qfig-sp-card" />
    <DiagramIcon name="postgres" x={30} y={280} size={28} />
    <text x="54" y="286" class="qfig-sp-t">
      <tspan data-lang-en>Ledger database: 2,000 transfers per second</tspan>
      <tspan data-lang-vi>Database sổ cái: 2.000 lệnh chuyển mỗi giây</tspan>
    </text>
    <text x="16" y="322">
      <tspan data-lang-en>Transfers: short writes, many per second</tspan>
      <tspan data-lang-vi>Lệnh chuyển: ghi ngắn, rất nhiều mỗi giây</tspan>
    </text>
    {ticks.map((x) => <rect x={x} y="330" width="4" height="14" rx="1" class="qfig-sp-ok" />)}
    <text x="16" y="372">
      <tspan data-lang-en>One report: reads many rows for 5 min</tspan>
      <tspan data-lang-vi>Một báo cáo: đọc nhiều dòng suốt 5 phút</tspan>
    </text>
    <rect x="16" y="380" width="548" height="16" rx="3" class="qfig-sp-rep" />
    <text x="16" y="426" class="qfig-sp-m">
      <tspan data-lang-en>Both run at the same time on the same tables.</tspan>
      <tspan data-lang-vi>Cả hai chạy cùng lúc trên cùng các bảng.</tspan>
    </text>

    <text x="0" y="476" class="qfig-sp-h">
      <tspan data-lang-en>C. Queue message into the ledger</tspan>
      <tspan data-lang-vi>C. Tin nhắn từ queue vào sổ cái</tspan>
    </text>
    <rect x="0" y="484" width="580" height="170" rx="8" class="qfig-sp-card" />
    <DiagramIcon name="mail" x={36} y={530} size={30} />
    <text x="36" y="562" text-anchor="middle" class="qfig-sp-m">
      <tspan data-lang-en>Queue</tspan>
      <tspan data-lang-vi>Queue</tspan>
    </text>
    <g class="qfig-sp-go"><path d={c1.line} /><polygon points={c1.head} /></g>
    <DiagramIcon name="worker" x={180} y={530} size={30} />
    <text x="180" y="562" text-anchor="middle" class="qfig-sp-m">
      <tspan data-lang-en>Worker</tspan>
      <tspan data-lang-vi>Worker</tspan>
    </text>
    <g class="qfig-sp-go"><path d={c2.line} /><polygon points={c2.head} /></g>
    <DiagramIcon name="postgres" x={372} y={530} size={30} />
    <text x="372" y="562" text-anchor="middle" class="qfig-sp-m">
      <tspan data-lang-en>Ledger</tspan>
      <tspan data-lang-vi>Sổ cái</tspan>
    </text>
    <g class="qfig-sp-back">
      <path d="M 180 572 L 180 592 L 36 592 L 36 574" />
      <polygon points={`36,566 31,576 41,576`} />
    </g>
    <text x="196" y="598" class="qfig-sp-redo">
      <tspan data-lang-en>Sent again if not acknowledged</tspan>
      <tspan data-lang-vi>Gửi lại nếu chưa được ack</tspan>
    </text>
    <text x="16" y="636" class="qfig-sp-m">
      <tspan data-lang-en>The worker runs on one VM that restarts at every deploy.</tspan>
      <tspan data-lang-vi>Worker chạy trên một VM, restart mỗi lần deploy.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-sp { margin: 0; width: 100%; }
  .qfig-sp svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-sp text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-sp .qfig-sp-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-sp .qfig-sp-t { font-size: 15px; font-weight: 600; fill: var(--text); }
  .qfig-sp .qfig-sp-m { fill: var(--text-muted); }
  .qfig-sp .qfig-sp-redo { fill: var(--red); font-weight: 600; }
  .qfig-sp-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-sp-job { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-sp-box { fill: var(--bg); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-sp-go path { stroke: var(--gold); stroke-width: 1.8; fill: none; }
  .qfig-sp-go polygon { fill: var(--gold); }
  .qfig-sp-ok { fill: var(--gold); }
  .qfig-sp-bad { fill: var(--red); }
  .qfig-sp-rep { fill: var(--act-2); }
  .qfig-sp-back path { stroke: var(--red); stroke-width: 2; fill: none; stroke-dasharray: 6 4; }
  .qfig-sp-back polygon { fill: var(--red); }
</style>
