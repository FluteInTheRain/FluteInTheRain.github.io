---
// Quiz figure for Post 6 (depth and shadows): the same dark screen built two ways. The hex values are the subject, so they are inline.
const FILT = [
  { id: 'u06d-sh', layers: [{ y: 8, b: 20, s: 0, o: 0.2 }] },
];
const panels = [
  { x: 8, n: { en: 'Panel 1', vi: 'Khung 1' }, canvas: '#17140F', card: '#17140F', pop: '#17140F', cl: 'Canvas #17140F', kl: 'Card #17140F', pl: 'Popover #17140F', foot: 'box-shadow: 0 8px 20px rgb(0 0 0 / 0.2)', top: false },
  { x: 304, n: { en: 'Panel 2', vi: 'Khung 2' }, canvas: '#15120E', card: '#231E18', pop: '#322B23', cl: 'Canvas #15120E', kl: 'Card #231E18', pl: 'Popover #322B23', foot: 'no shadow, 1px lighter top edge', top: true },
];
---
<div class="qfig-uxq06darksteps">
  <svg viewBox="0 0 600 262" role="img" aria-label="Two dark screens side by side. Panel 1 has canvas, card and popover all filled #17140F and relies on a black shadow of 20 percent opacity. Panel 2 has canvas #15120E, card #231E18, popover #322B23 and a 1px lighter top edge, with no shadow.">
    <defs>
      {FILT.map((d) => (
        <filter id={d.id} x="-25%" y="-25%" width="150%" height="170%" color-interpolation-filters="sRGB">
          {d.layers.map((l, k) => (
            <>
              <feGaussianBlur in="SourceAlpha" stdDeviation={l.b / 2} result={`b${k}`} />
              <feOffset in={`b${k}`} dx="0" dy={l.y} result={`o${k}`} />
              <feFlood style={`flood-color: #000; flood-opacity: ${l.o}`} result={`f${k}`} />
              <feComposite in={`f${k}`} in2={`o${k}`} operator="in" result={`s${k}`} />
            </>
          ))}
          <feMerge>
            {d.layers.map((_, k) => <feMergeNode in={`s${k}`} />)}
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      ))}
    </defs>
    {panels.map((p) => (
      <>
        <rect x={p.x} y="6" width="288" height="250" rx="10" style={`fill: ${p.canvas}`} class="panel" />
        <text x={p.x + 16} y="30" class="h"><tspan data-lang-en>{p.n.en}</tspan><tspan data-lang-vi>{p.n.vi}</tspan></text>
        <text x={p.x + 100} y="30" class="m">{p.cl}</text>

        <rect x={p.x + 16} y="46" width="216" height="104" rx="8" style={`fill: ${p.card}`} class="surf" filter={p.top ? undefined : 'url(#u06d-sh)'} />
        {p.top ? <line x1={p.x + 22} y1="47" x2={p.x + 226} y2="47" class="hl" /> : null}
        <text x={p.x + 30} y="72" class="t">{p.kl}</text>
        <line x1={p.x + 30} y1="92" x2={p.x + 150} y2="92" class="bar" />
        <line x1={p.x + 30} y1="108" x2={p.x + 110} y2="108" class="bar" />

        <rect x={p.x + 88} y="106" width="188" height="96" rx="8" style={`fill: ${p.pop}`} class="surf" filter={p.top ? undefined : 'url(#u06d-sh)'} />
        {p.top ? <line x1={p.x + 94} y1="107" x2={p.x + 270} y2="107" class="hl" /> : null}
        <text x={p.x + 102} y="132" class="t">{p.pl}</text>
        <line x1={p.x + 102} y1="152" x2={p.x + 230} y2="152" class="bar" />
        <line x1={p.x + 102} y1="168" x2={p.x + 190} y2="168" class="bar" />

        <text x={p.x + 16} y="238" class="m">{p.foot}</text>
      </>
    ))}
  </svg>
</div>

<style>
  .qfig-uxq06darksteps { margin: 0; width: 100%; }
  .qfig-uxq06darksteps svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq06darksteps text { font-size: 13px; fill: var(--band-text); }
  .qfig-uxq06darksteps .h { font-size: 14px; font-weight: 700; }
  .qfig-uxq06darksteps .m { fill: var(--band-faint); font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11.5px; }
  .qfig-uxq06darksteps .t { font-size: 12.5px; font-weight: 600; }
  .qfig-uxq06darksteps .panel { stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq06darksteps .surf { stroke: #2d2720; stroke-width: 0.8; }
  .qfig-uxq06darksteps .hl { stroke: #52483b; stroke-width: 1.4; stroke-linecap: round; }
  .qfig-uxq06darksteps .bar { stroke: var(--band-faint); stroke-opacity: 0.5; stroke-width: 4; stroke-linecap: round; }
</style>
