---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 08: who is in the market — real numbers from the post:
// individuals ~82% of HOSE turnover (FiinGroup), foreign ~10.4% (SSI Research),
// 10.4M individual accounts vs ~18,500 institutional (VSDC, July 2025).
const W = 580;
const H = 420;
const barX = 24;
const barY = 96;
const barW = 532;
const slices = [
  { share: 82, label: 'individuals ≈ 82%', labelVi: 'cá nhân ≈ 82%', src: 'FiinGroup', cls: 'qrs-ind' },
  { share: 10.4, label: 'foreign ≈ 10.4%', labelVi: 'khối ngoại ≈ 10,4%', src: 'SSI Research', cls: 'qrs-foreign' },
];
const restShare = 100 - 82 - 10.4;
---
<div class="qrs">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <DiagramIcon name="users" x={18} y={16} size={22} />
    <text x="40" y="21" class="qrs-h">
      <tspan data-lang-en>One day of HOSE trading value, by who trades it</tspan>
      <tspan data-lang-vi>Một phiên giá trị giao dịch trên HOSE, chia theo ai tạo ra</tspan>
    </text>

    <g>
      {slices.map((s, i) => {
        const x = barX + slices.slice(0, i).reduce((a, b) => a + (b.share / 100) * barW, 0);
        const w = (s.share / 100) * barW;
        return (
          <g>
            <rect x={x} y={barY} width={w - 1} height="52" rx="3" class={`qrs-slice ${s.cls}`} />
            {w > 120 && (
              <text x={x + w / 2} y={barY + 32} text-anchor="middle" class="qrs-inbar">
                <tspan data-lang-en>{s.label}</tspan>
                <tspan data-lang-vi>{s.labelVi}</tspan>
              </text>
            )}
            {w <= 120 && (
              <text x={x + w / 2} y={barY - 8} text-anchor="middle" class="qrs-small">
                <tspan data-lang-en>{s.label} ({s.src})</tspan>
                <tspan data-lang-vi>{s.labelVi} ({s.src})</tspan>
              </text>
            )}
          </g>
        );
      })}
      <rect x={barX + 82 / 100 * barW + 10.4 / 100 * barW} y={barY} width={(restShare / 100) * barW - 1} height="52" rx="3" class="qrs-slice qrs-rest" />
      <text x={barX + 92.4 / 100 * barW + (restShare / 100) * barW / 2} y={barY + 72} text-anchor="middle" class="qrs-small">
        <tspan data-lang-en>everyone else</tspan>
        <tspan data-lang-vi>phần còn lại</tspan>
      </text>
    </g>

    <line x1="24" x2="556" y1="188" y2="188" class="qrs-rule" />
    <text x="24" y="214" class="qrs-strong">
      <tspan data-lang-en>Counted in accounts instead, the gap is starker (VSDC, July 2025):</tspan>
      <tspan data-lang-vi>Tính theo tài khoản, khoảng cách còn rõ hơn (VSDC, tháng 7/2025):</tspan>
    </text>
    <text x="24" y="252" class="qrs-big">10,400,000</text>
    <text x="24" y="274" class="qrs-tick">
      <tspan data-lang-en>individual accounts</tspan>
      <tspan data-lang-vi>tài khoản cá nhân</tspan>
    </text>
    <text x="300" y="252" class="qrs-big">≈ 18,500</text>
    <text x="300" y="274" class="qrs-tick">
      <tspan data-lang-en>institutional accounts</tspan>
      <tspan data-lang-vi>tài khoản tổ chức</tspan>
    </text>

    <line x1="24" x2="556" y1="300" y2="300" class="qrs-rule" />
    <text x="24" y="328" class="qrs-note">
      <tspan data-lang-en>Most of the daily pushing is done by individuals, not institutions —</tspan>
      <tspan data-lang-vi>Phần lớn lực đẩy hằng ngày đến từ cá nhân, không phải tổ chức —</tspan>
    </text>
    <text x="24" y="348" class="qrs-note">
      <tspan data-lang-en>so prices move on sentiment, momentum and crowded trades.</tspan>
      <tspan data-lang-vi>nên giá vận động theo tâm lý, động lượng và lệnh chen nhau.</tspan>
    </text>
    <text x="24" y="378" class="qrs-tick">
      <tspan data-lang-en>Foreign net selling (bán ròng) makes headlines far beyond its 10.4% share.</tspan>
      <tspan data-lang-vi>Bán ròng của khối ngoại làm tin lớn xa hơn hẳn tỷ trọng 10,4%.</tspan>
    </text>
    <text x="24" y="402" class="qrs-tick">
      <tspan data-lang-en>Source figures from the post: FiinGroup, SSI Research, VSDC.</tspan>
      <tspan data-lang-vi>Số liệu từ bài viết: FiinGroup, SSI Research, VSDC.</tspan>
    </text>
  </svg>
</div>

<style>
  .qrs {
    margin: 0;
    width: 100%;
  }
  .qrs svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qrs text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qrs .qrs-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qrs .qrs-slice {
    stroke-width: 1;
  }
  .qrs .qrs-ind {
    fill: var(--act-2);
    opacity: 0.35;
    stroke: var(--act-2);
  }
  .qrs .qrs-foreign {
    fill: var(--gold);
    opacity: 0.5;
    stroke: var(--gold);
  }
  .qrs .qrs-rest {
    fill: var(--text-faint);
    opacity: 0.25;
    stroke: var(--text-faint);
  }
  .qrs .qrs-inbar {
    font-size: 14px;
    font-weight: 700;
    fill: var(--text);
  }
  .qrs .qrs-small {
    font-size: 12px;
    font-weight: 600;
    fill: var(--text);
  }
  .qrs .qrs-strong {
    font-size: 13.5px;
    font-weight: 600;
    fill: var(--text);
  }
  .qrs .qrs-big {
    font-size: 30px;
    font-weight: 700;
    fill: var(--text);
  }
  .qrs .qrs-note {
    font-size: 13px;
  }
  .qrs .qrs-tick {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qrs .qrs-rule {
    stroke: var(--border);
    stroke-width: 1.2;
  }
</style>
