---
// Quiz figure for the Backtest post: LuckBar. Inline SVG, site tokens only, no ids.
---
<div class="qfig-atq12-luckbar">
  <svg viewBox="0 0 580 222" role="img" aria-label="Bars of the Sharpe ratio that luck alone is expected to reach: 0.70 at N equal 10, 1.13 at 100, 1.24 at 200 and 1.37 at 500, with a dashed line at 1.0.">
<text x="10" y="20" class="h"><tspan data-lang-en>Sharpe that luck alone is expected to reach</tspan><tspan data-lang-vi>Sharpe mà riêng may mắn được kỳ vọng đạt</tspan></text>
<line x1="40" y1="190" x2="560" y2="190" class="ax" />
<line x1="40" y1="102.5" x2="560" y2="102.5" class="mutl" />
<text x="548" y="96.5" class="s" text-anchor="end"><tspan data-lang-en>1.0</tspan><tspan data-lang-vi>1,0</tspan></text>
<rect x="80" y="128.4" width="70" height="61.6" rx="3" class="redf" />
<text x="115" y="120.4" class="t13 b" text-anchor="middle"><tspan data-lang-en>0.70</tspan><tspan data-lang-vi>0,70</tspan></text>
<text x="115" y="210" class="s" text-anchor="middle"><tspan data-lang-en>N = 10</tspan><tspan data-lang-vi>N = 10</tspan></text>
<rect x="200" y="91.0" width="70" height="99.0" rx="3" class="redf" />
<text x="235" y="82.95000000000002" class="t13 b" text-anchor="middle"><tspan data-lang-en>1.13</tspan><tspan data-lang-vi>1,13</tspan></text>
<text x="235" y="210" class="s" text-anchor="middle"><tspan data-lang-en>N = 100</tspan><tspan data-lang-vi>N = 100</tspan></text>
<rect x="320" y="81.8" width="70" height="108.2" rx="3" class="redf" />
<text x="355" y="73.76249999999999" class="t13 b" text-anchor="middle"><tspan data-lang-en>1.24</tspan><tspan data-lang-vi>1,24</tspan></text>
<text x="355" y="210" class="s" text-anchor="middle"><tspan data-lang-en>N = 200</tspan><tspan data-lang-vi>N = 200</tspan></text>
<rect x="440" y="70.6" width="70" height="119.4" rx="3" class="redf" />
<text x="475" y="62.562500000000014" class="t13 b" text-anchor="middle"><tspan data-lang-en>1.36</tspan><tspan data-lang-vi>1,36</tspan></text>
<text x="475" y="210" class="s" text-anchor="middle"><tspan data-lang-en>N = 500</tspan><tspan data-lang-vi>N = 500</tspan></text>
  </svg>
</div>

<style>
  .qfig-atq12-luckbar { margin: 2em 0; width: 100%; }
  .qfig-atq12-luckbar-scroll { overflow-x: auto; }
  .qfig-atq12-luckbar svg { display: block; width: 100%;  height: auto; font-variant-numeric: tabular-nums; }
  .qfig-atq12-luckbar text { font-size: 14px; fill: var(--text-body); }
  .qfig-atq12-luckbar .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-atq12-luckbar .s { font-size: 13px; fill: var(--text-muted); }
  .qfig-atq12-luckbar .t13 { font-size: 13px; }
  .qfig-atq12-luckbar .b { font-weight: 700; fill: var(--text); }
  .qfig-atq12-luckbar .redt { fill: var(--red); font-weight: 700; }
  .qfig-atq12-luckbar .goldt { fill: var(--gold-icon); font-weight: 700; }
  .qfig-atq12-luckbar .box { fill: var(--bg-alt); stroke: var(--border); }
  .qfig-atq12-luckbar .okb { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .qfig-atq12-luckbar .badb { fill: var(--red-tint-bg); stroke: var(--red); }
  .qfig-atq12-luckbar .ln { stroke: var(--text-muted); stroke-width: 1.4; fill: none; }
  .qfig-atq12-luckbar .arrf { fill: var(--text-muted); }
  .qfig-atq12-luckbar .ax { stroke: var(--border); stroke-width: 1.2; fill: none; }
  .qfig-atq12-luckbar .grid { stroke: var(--border); stroke-width: 1; stroke-dasharray: 3 4; fill: none; }
  .qfig-atq12-luckbar .redl { stroke: var(--red); stroke-width: 2; fill: none; }
  .qfig-atq12-luckbar .goldl { stroke: var(--gold); stroke-width: 2; fill: none; }
  .qfig-atq12-luckbar .mutl { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; fill: none; }
  .qfig-atq12-luckbar .redf { fill: var(--red); }
  .qfig-atq12-luckbar .goldf { fill: var(--gold); }
  .qfig-atq12-luckbar .mutf { fill: var(--text-faint); }
  .qfig-atq12-luckbar .hole { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-atq12-luckbar figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
