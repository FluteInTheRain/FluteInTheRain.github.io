---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 02 (post 11): one event-loop thread. /export holds it for 0.2 s (no await); /health arrives at 0.05 s.
// Axis is to scale: 0 to 0.25 s. Plain inline SVG, site tokens only, no markers/defs.
const W = 580;
const x0 = 160;
const pxPerS = 1480; // 0.25 s = 370 px
const xAt = (s: number) => x0 + s * pxPerS;
const x05 = xAt(0.05);
const x20 = xAt(0.2);
const yLoop = 96;
const yAxis = 234;
const yHealth = 176;
---
<div class="bq11lq">
  <svg viewBox={`0 0 ${W} 270`} role="img" aria-hidden="true">
    <DiagramIcon name="server" x={26} y={yLoop + 14} size={24} />
    <text x="50" y={yLoop + 6} class="lq-lane">
      <tspan data-lang-en>One worker</tspan>
      <tspan data-lang-vi>Một worker</tspan>
    </text>
    <text x="50" y={yLoop + 24} class="lq-note">
      <tspan data-lang-en>one thread</tspan>
      <tspan data-lang-vi>một thread</tspan>
    </text>
    <rect x={x0} y={yLoop} width={x20 - x0} height="30" rx="4" class="lq-bar" />
    <text x={x0 + 10} y={yLoop + 20} class="lq-in">
      <tspan data-lang-en>/export: 0.2 s of computation, no await</tspan>
      <tspan data-lang-vi>/export: 0,2 s tính toán, không await</tspan>
    </text>

    <line x1={x05} x2={x05} y1={yLoop - 40} y2={yLoop - 2} class="lq-drop" />
    <polygon points={`${x05},${yLoop - 2} ${x05 - 5},${yLoop - 11} ${x05 + 5},${yLoop - 11}`} class="lq-head" />
    <text x={x05 + 8} y={yLoop - 24} class="lq-strong">
      <tspan data-lang-en>0.05 s: /health arrives</tspan>
      <tspan data-lang-vi>0,05 s: /health đến</tspan>
    </text>

    <rect x={x05} y={yHealth - 18} width={x20 - x05} height="28" rx="4" class="lq-wait" />
    <text x={x05 + 10} y={yHealth + 1} class="lq-note-in">
      <tspan data-lang-en>/health waits</tspan>
      <tspan data-lang-vi>/health chờ</tspan>
    </text>
    <text x={x05} y={yHealth + 28} class="lq-note">
      <tspan data-lang-en>it needs only about 1 ms of real work</tspan>
      <tspan data-lang-vi>nó chỉ cần khoảng 1 ms việc thật</tspan>
    </text>

    <line x1={x0} x2={xAt(0.25)} y1={yAxis} y2={yAxis} class="lq-axis" />
    <g class="lq-tick">
      <line x1={x0} x2={x0} y1={yAxis - 5} y2={yAxis + 5} />
      <line x1={x05} x2={x05} y1={yAxis - 5} y2={yAxis + 5} />
      <line x1={x20} x2={x20} y1={yAxis - 5} y2={yAxis + 5} />
    </g>
    <text x={x0} y={yAxis + 22} text-anchor="middle" class="lq-num">0 s</text>
    <text x={x05} y={yAxis + 22} text-anchor="middle" class="lq-num"><tspan data-lang-en>0.05 s</tspan><tspan data-lang-vi>0,05 s</tspan></text>
    <text x={x20} y={yAxis + 22} text-anchor="middle" class="lq-num"><tspan data-lang-en>0.2 s</tspan><tspan data-lang-vi>0,2 s</tspan></text>
  </svg>
</div>

<style>
  .bq11lq { margin: 0; width: 100%; }
  .bq11lq svg { display: block; width: 100%; min-width: 360px; height: auto; }
  .bq11lq text { font-size: 13px; fill: var(--text-body); }
  .bq11lq .lq-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .bq11lq .lq-note { fill: var(--text-muted); }
  .bq11lq .lq-strong { font-weight: 700; fill: var(--text); }
  .bq11lq .lq-in { font-weight: 600; fill: var(--text); }
  .bq11lq .lq-note-in { fill: var(--text-body); }
  .bq11lq .lq-num { font-variant-numeric: tabular-nums; fill: var(--text-muted); }
  .bq11lq .lq-bar { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bq11lq .lq-wait { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .bq11lq .lq-drop { stroke: var(--text-muted); stroke-width: 2; }
  .bq11lq .lq-head { fill: var(--text-muted); }
  .bq11lq .lq-axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .bq11lq .lq-tick line { stroke: var(--text-muted); stroke-width: 1.5; }
</style>
