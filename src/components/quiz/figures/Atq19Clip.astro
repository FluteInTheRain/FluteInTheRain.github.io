---
// Set 07: PPO clipped objective, eps = 0.2, advantage +2 (left) and -2 (right).
const W = 580;
const H = 250;
const eps = 0.2;
const L = (r: number, A: number) => Math.min(r * A, Math.max(Math.min(r, 1 + eps), 1 - eps) * A);
const R0 = 0.4, R1 = 1.8, PW = 210, PY = 50, PH = 130;
const panels = [
  { A: 2, x0: 40, ymin: 0, ymax: 3.6 },
  { A: -2, x0: 320, ymin: -3.6, ymax: 0 },
];
const px = (r: number, x0: number) => x0 + ((r - R0) / (R1 - R0)) * PW;
const py = (v: number, p: { ymin: number; ymax: number }) => PY + PH - ((v - p.ymin) / (p.ymax - p.ymin)) * PH;
const line = (f: (r: number) => number, p: any) => Array.from({ length: 57 }, (_, i) => {
  const r = R0 + (i * (R1 - R0)) / 56;
  return `${i ? 'L' : 'M'}${px(r, p.x0).toFixed(1)} ${py(f(r), p).toFixed(1)}`;
}).join(' ');
---
<div class="q19c">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <text x="14" y="22" class="q19c-h"><tspan data-lang-en>Clipped objective against the ratio r (band 0.8 to 1.2)</tspan><tspan data-lang-vi>Objective bị cắt theo tỉ lệ r (dải 0,8 đến 1,2)</tspan></text>
    {panels.map((p) => (
      <g>
        <rect x={p.x0 - 8} y={PY - 8} width={PW + 16} height={PH + 16} rx="6" class="q19c-panel" />
        <line x1={px(0.8, p.x0)} x2={px(0.8, p.x0)} y1={PY} y2={PY + PH} class="q19c-edge" />
        <line x1={px(1.2, p.x0)} x2={px(1.2, p.x0)} y1={PY} y2={PY + PH} class="q19c-edge" />
        <path d={line((r) => r * p.A, p)} class="q19c-raw" />
        <path d={line((r) => L(r, p.A), p)} class={p.A > 0 ? 'q19c-clip' : 'q19c-clip bad'} />
        <text x={px(0.8, p.x0)} y={PY + PH + 26} text-anchor="middle" class="q19c-s">0.8</text>
        <text x={px(1.2, p.x0)} y={PY + PH + 26} text-anchor="middle" class="q19c-s">1.2</text>
      </g>
    ))}
    <text x="40" y="44" class="q19c-t"><tspan data-lang-en>Advantage +2</tspan><tspan data-lang-vi>Advantage +2</tspan></text>
    <text x="320" y="44" class="q19c-t"><tspan data-lang-en>Advantage −2</tspan><tspan data-lang-vi>Advantage −2</tspan></text>
    <text x="14" y="242" class="q19c-s"><tspan data-lang-en>Dashed: r × A. Solid: the clipped objective.</tspan><tspan data-lang-vi>Nét đứt: r × A. Nét liền: objective đã cắt.</tspan></text>
  </svg>
</div>
<style>
  .q19c { margin: 0; width: 100%; }
  .q19c svg { display: block; width: 100%; height: auto; }
  .q19c text { font-size: 14px; fill: var(--text-body); }
  .q19c .q19c-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q19c .q19c-t { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .q19c .q19c-s { font-size: 12.5px; fill: var(--text-muted); }
  .q19c .q19c-panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.1; }
  .q19c .q19c-edge { stroke: var(--text-muted); stroke-width: 1; stroke-dasharray: 3 3; }
  .q19c .q19c-raw { fill: none; stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .q19c .q19c-clip { fill: none; stroke: var(--gold-icon); stroke-width: 2.8; }
  .q19c .q19c-clip.bad { stroke: var(--red); }
</style>
