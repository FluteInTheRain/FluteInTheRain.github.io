---
// Straight-line assumption: $460M over 45 minutes = $10.22M a minute. Marks at 1, 4.9 (a $50M cap), 10 and 45 minutes.
const L = 60, R = 560, T = 36, B = 160;
const X = (m: number) => L + (m / 45) * (R - L);
const Y = (v: number) => B - (v / 460) * (B - T);
const marks = [[1, 10.2], [4.9, 50], [10, 102.2], [45, 460]];
---
<div class="qfig-atq22l">
  <svg viewBox="0 0 580 200" role="img" aria-label="A straight line from zero to 460 million dollars over 45 minutes. Dots mark the loss if orders stop at 1 minute (10.2 million), 4.9 minutes (50 million), 10 minutes (102.2 million) and 45 minutes (460 million).">
    <text x="20" y="18" class="h"><tspan data-lang-en>Loss against the minute the orders stop</tspan><tspan data-lang-vi>Lỗ theo phút mà lệnh dừng</tspan></text>
    <line x1={L} x2={R} y1={B} y2={B} class="ax" />
    <line x1={X(0)} y1={Y(0)} x2={X(45)} y2={Y(460)} class="ln" />
    {marks.map(([m, v], i) => (
      <g>
        {m < 40 && <line x1={X(m)} x2={X(m)} y1={Y(v) - 6} y2={56 + i * 16} class="lead" />}
        <circle cx={X(m)} cy={Y(v)} r="4.5" class="dot" />
        {m < 40
          ? <text x={X(m) + 5} y={52 + i * 16 + 4} class="v">{m} min: ${v}M</text>
          : <text x={X(m) - 8} y={Y(v) + 4} text-anchor="end" class="v">${v}M</text>}
      </g>
    ))}
    {[0, 10, 20, 30, 40].map((m) => (<text x={X(m)} y={B + 18} text-anchor="middle" class="s">{m}</text>))}
    <text x={R} y={B + 36} text-anchor="end" class="s"><tspan data-lang-en>minutes</tspan><tspan data-lang-vi>phút</tspan></text>
  </svg>
</div>

<style>
  .qfig-atq22l svg { display: block; width: 100%; height: auto; max-width: 580px; margin: 0 auto; }
  .qfig-atq22l text { font-size: 12.5px; fill: var(--text-body); }
  .qfig-atq22l .h { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-atq22l .v { font-weight: 700; fill: var(--text); }
  .qfig-atq22l .s { fill: var(--text-muted); }
  .qfig-atq22l .ax { stroke: var(--border); }
  .qfig-atq22l .ln { stroke: var(--text-faint); stroke-width: 2; stroke-dasharray: 5 4; }
  .qfig-atq22l .dot { fill: var(--red); }
  .qfig-atq22l .lead { stroke: var(--text-faint); stroke-width: 1; }
</style>
