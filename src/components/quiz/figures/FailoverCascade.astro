---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 08: two replicas share the traffic; when A crashes, B receives all of it.
// Numbers match the scenario: capacity 1,000 req/s per replica, 1,200 req/s arriving.
// Plain inline SVG, site tokens only, no markers/defs (the page renders each figure twice).
const W = 580;
const H = 440;
const panels = [
  { t: 0, crashed: false },
  { t: 226, crashed: true },
];
const capPx = 170; // bar length that stands for 1,000 req/s
const barPx = (rps: number) => (capPx * rps) / 1000;
const srvX = 190;
const srvW = 380;
const srvH = 70;
const rowY = [34, 112]; // server rows, relative to the panel top
const lbH = 44;
const lbX = 50;
const lbW = 100;

function arrow(x1: number, y1: number, x2: number, y2: number, head = 9) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - head * Math.cos(a - 0.45), y2 - head * Math.sin(a - 0.45)];
  const p2 = [x2 - head * Math.cos(a + 0.45), y2 - head * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - (head - 3) * Math.cos(a)} ${y2 - (head - 3) * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
---
<div class="fo">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <line x1="10" x2={W - 10} y1="218" y2="218" class="fo-rule" />
    {panels.map((p) => {
      const { t, crashed } = p;
      const midY = t + (rowY[0] + rowY[1] + srvH) / 2;
      const yA = t + rowY[0];
      const yB = t + rowY[1];
      const toA = arrow(lbX + lbW, midY, srvX, yA + srvH / 2);
      const toB = arrow(lbX + lbW, midY, srvX, yB + srvH / 2, crashed ? 13 : 9);
      const userArrow = arrow(36, midY, lbX, midY, 8);
      return (
        <g>
          <text x="8" y={t + 20} class="fo-h">
            {crashed ? (
              <>
                <tspan data-lang-en>After A crashes: B gets everything</tspan>
                <tspan data-lang-vi>Sau khi A crash: B nhận hết</tspan>
              </>
            ) : (
              <>
                <tspan data-lang-en>Normal: the load is shared</tspan>
                <tspan data-lang-vi>Bình thường: tải được chia đều</tspan>
              </>
            )}
          </text>

          <DiagramIcon name="users" x={20} y={midY} size={22} />
          <g class="fo-arrow"><path d={userArrow.line} /><polygon points={userArrow.head} /></g>
          <text x="20" y={midY + 32} text-anchor="middle" class="fo-note fo-small">1,200/s</text>
          <g class="fo-box">
            <rect x={lbX} y={midY - lbH / 2} width={lbW} height={lbH} rx="8" />
            <text x={lbX + lbW / 2} y={midY + 5} text-anchor="middle">Load balancer</text>
          </g>

          <g class={crashed ? 'fo-arrow is-cut' : 'fo-arrow'}>
            <path d={toA.line} />{!crashed && <polygon points={toA.head} />}
          </g>
          <g class={crashed ? 'fo-arrow is-hot' : 'fo-arrow'}>
            <path d={toB.line} /><polygon points={toB.head} />
          </g>

          <g class={crashed ? 'fo-srv is-down' : 'fo-srv'}>
            <rect x={srvX} y={yA} width={srvW} height={srvH} rx="8" />
            <DiagramIcon name={crashed ? 'fail' : 'server'} x={srvX + 22} y={yA + 20} size={20} />
            <text x={srvX + 42} y={yA + 25} class="fo-name">Replica A</text>
            {crashed ? (
              <text x={srvX + 16} y={yA + 52} class="fo-down">
                <tspan data-lang-en>crashed: out of memory</tspan>
                <tspan data-lang-vi>đã crash: hết bộ nhớ</tspan>
              </text>
            ) : (
              <g>
                <rect x={srvX + 16} y={yA + 34} width={capPx} height="10" rx="2" class="fo-track" />
                <rect x={srvX + 16} y={yA + 34} width={barPx(600)} height="10" rx="2" class="fo-bar" />
                <text x={srvX + 16} y={yA + 63} class="fo-num">
                  <tspan data-lang-en>600 req/s, 60% of 1,000</tspan>
                  <tspan data-lang-vi>600 req/s, 60% của 1.000</tspan>
                </text>
              </g>
            )}
          </g>

          <g class={crashed ? 'fo-srv is-hot' : 'fo-srv'}>
            <rect x={srvX} y={yB} width={srvW} height={srvH} rx="8" />
            <DiagramIcon name="server" x={srvX + 22} y={yB + 20} size={20} />
            <text x={srvX + 42} y={yB + 25} class="fo-name">Replica B</text>
            <rect x={srvX + 16} y={yB + 34} width={capPx} height="10" rx="2" class="fo-track" />
            <rect x={srvX + 16} y={yB + 34} width={barPx(crashed ? 1000 : 600)} height="10" rx="2" class="fo-bar" />
            {crashed && <rect x={srvX + 16 + capPx} y={yB + 34} width={barPx(200)} height="10" rx="2" class="fo-over" />}
            {crashed && <line x1={srvX + 16 + capPx} x2={srvX + 16 + capPx} y1={yB + 29} y2={yB + 49} class="fo-cap" />}
            {crashed && (
              <text x={srvX + 16 + capPx + barPx(200) + 10} y={yB + 44} class="fo-down">
                <tspan data-lang-en>over the limit</tspan>
                <tspan data-lang-vi>vượt giới hạn</tspan>
              </text>
            )}
            <text x={srvX + 16} y={yB + 63} class={crashed ? 'fo-num is-hot' : 'fo-num'}>
              {crashed ? (
                <>
                  <tspan data-lang-en>1,200 req/s against a limit of 1,000</tspan>
                  <tspan data-lang-vi>1.200 req/s trong khi giới hạn là 1.000</tspan>
                </>
              ) : (
                <>
                  <tspan data-lang-en>600 req/s, 60% of 1,000</tspan>
                  <tspan data-lang-vi>600 req/s, 60% của 1.000</tspan>
                </>
              )}
            </text>
          </g>

          <text x="8" y={t + 206} class={crashed ? 'fo-foot is-hot' : 'fo-foot'}>
            {crashed ? (
              <>
                <tspan data-lang-en>Room for 1,000 per second, demand is still 1,200.</tspan>
                <tspan data-lang-vi>Chỉ còn chỗ cho 1.000 mỗi giây, nhu cầu vẫn là 1.200.</tspan>
              </>
            ) : (
              <>
                <tspan data-lang-en>Room for 2,000 per second, demand is 1,200.</tspan>
                <tspan data-lang-vi>Có chỗ cho 2.000 mỗi giây, nhu cầu là 1.200.</tspan>
              </>
            )}
          </text>
        </g>
      );
    })}
  </svg>
</div>

<style>
  .fo { margin: 0; width: 100%; }
    .fo svg { display: block; width: 100%; min-width: 360px; height: auto; }
  .fo text { font-size: 13px; fill: var(--text-body); }
  .fo .fo-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .fo .fo-note { fill: var(--text-muted); }
  .fo .fo-small { font-size: 13px; font-variant-numeric: tabular-nums; }
  .fo .fo-name { font-weight: 700; fill: var(--text); font-size: 14px; }
  .fo .fo-num { font-variant-numeric: tabular-nums; fill: var(--text-muted); }
  .fo .fo-num.is-hot { fill: var(--red); font-weight: 700; }
  .fo .fo-down { fill: var(--red); font-weight: 700; }
  .fo .fo-foot { font-weight: 600; fill: var(--text); font-variant-numeric: tabular-nums; }
  .fo .fo-foot.is-hot { fill: var(--red); font-weight: 700; }
  .fo .fo-rule { stroke: var(--border); stroke-width: 1.5; }
  .fo .fo-box rect, .fo .fo-srv rect:first-child { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .fo .fo-box text { fill: var(--text); font-weight: 600; }
  .fo .fo-srv.is-down rect:first-child { fill: var(--red-tint-bg); stroke: var(--red); stroke-dasharray: 4 3; }
  .fo .fo-srv.is-hot rect:first-child { stroke: var(--red); stroke-width: 1.8; }
  .fo .fo-track { fill: var(--border); }
  .fo .fo-bar { fill: var(--gold); }
  .fo .fo-bar.is-hot { fill: var(--gold); }
  .fo .fo-over { fill: var(--red); }
  .fo .fo-cap { stroke: var(--text); stroke-width: 2; }
  .fo .fo-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 2; }
  .fo .fo-arrow polygon { fill: var(--text-muted); }
  .fo .fo-arrow.is-cut path { stroke-dasharray: 3 4; opacity: 0.5; }
  .fo .fo-arrow.is-hot path { stroke: var(--red); stroke-width: 6; }
  .fo .fo-arrow.is-hot polygon { fill: var(--red); }
</style>
