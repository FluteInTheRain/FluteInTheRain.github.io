---
// Quiz figure, set 08: two replicas share the traffic; when A crashes, B receives all of it.
// Numbers match the scenario: capacity 1,000 req/s each, 1,200 req/s total.
// Plain inline SVG, site tokens only, no markers/defs.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 8 * Math.cos(a - 0.45), y2 - 8 * Math.sin(a - 0.45)];
  const p2 = [x2 - 8 * Math.cos(a + 0.45), y2 - 8 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const cap = 1000;
const rx = 160;
const rw = 300;
const rh = 44;
const barX = rx + 36;
const barCap = 80;
const frames = [
  { top: 0, a: 600, b: 600 },
  { top: 176, a: -1, b: 1200 },
];
---
<figure class="qfig-cascade">
  <svg viewBox="0 0 480 362" role="img" aria-label="Normal: 1,200 requests per second split 600 and 600 over replicas A and B, each at 60% of a 1,000 capacity. After A crashes: B receives all 1,200, which is 120% of its capacity.">
    {frames.map((f, i) => {
      const yA = f.top + 40;
      const yB = f.top + 100;
      const cy = f.top + 84;
      const loads = [f.a, f.b];
      const ys = [yA, yB];
      return (
        <g>
          <text x="16" y={f.top + 22} class="qfig-cascade-h">
            {i === 0 ? (
              <>
                <tspan data-lang-en>1. Normal: the load is shared</tspan>
                <tspan data-lang-vi>1. Bình thường: tải được chia đều</tspan>
              </>
            ) : (
              <>
                <tspan data-lang-en>2. After A crashes: failover to B</tspan>
                <tspan data-lang-vi>2. Sau khi A crash: failover sang B</tspan>
              </>
            )}
          </text>
          <g class="qfig-cascade-box">
            <rect x="16" y={cy - 22} width="84" height="44" rx="8" />
            <text x="58" y={cy - 3} text-anchor="middle" class="qfig-cascade-strong">
              <tspan data-lang-en>Clients</tspan>
              <tspan data-lang-vi>Client</tspan>
            </text>
            <text x="58" y={cy + 14} text-anchor="middle" class="qfig-cascade-muted">1,200/s</text>
          </g>
          {loads.map((load, k) => {
            const down = load < 0;
            const over = load > cap;
            const ar = arrow(100, cy, rx, ys[k] + rh / 2);
            const w = down ? 0 : (barCap * load) / cap;
            return (
              <g>
                <g class={down ? 'qfig-cascade-arrow is-cut' : over ? 'qfig-cascade-arrow is-red' : 'qfig-cascade-arrow'}>
                  <path d={ar.line} />
                  {!down && <polygon points={ar.head} />}
                </g>
                <g class={down ? 'qfig-cascade-rep is-down' : over ? 'qfig-cascade-rep is-over' : 'qfig-cascade-rep'}>
                  <rect x={rx} y={ys[k]} width={rw} height={rh} rx="8" />
                  <text x={rx + 14} y={ys[k] + 27} class="qfig-cascade-strong">{k === 0 ? 'A' : 'B'}</text>
                  {down ? (
                    <text x={rx + rw - 12} y={ys[k] + 27} text-anchor="end" class="qfig-cascade-down">
                      <tspan data-lang-en>✕ crashed</tspan>
                      <tspan data-lang-vi>✕ đã crash</tspan>
                    </text>
                  ) : (
                    <g>
                      <rect x={barX} y={ys[k] + 17} width={barCap} height="10" rx="2" class="qfig-cascade-track" />
                      <rect x={barX} y={ys[k] + 17} width={w} height="10" rx="2" class={over ? 'qfig-cascade-bar is-hot' : 'qfig-cascade-bar'} />
                      <text x={rx + rw - 12} y={ys[k] + 27} text-anchor="end" class={over ? 'qfig-cascade-pct is-hot' : 'qfig-cascade-pct'}>
                        {load.toLocaleString('en-US')} / 1,000 ({Math.round((load / cap) * 100)}%)
                      </text>
                    </g>
                  )}
                </g>
              </g>
            );
          })}
        </g>
      );
    })}
    <line x1="16" x2="464" y1="166" y2="166" class="qfig-cascade-rule" />
    <text x="464" y="352" text-anchor="end" class="qfig-cascade-bad">
      <tspan data-lang-en>B is asked for 200 req/s more than it can serve.</tspan>
      <tspan data-lang-vi>B bị đòi nhiều hơn mức phục vụ được 200 req/s.</tspan>
    </text>
  </svg>
</figure>

<style>
  .qfig-cascade { margin: 1em 0; width: 100%; }
  .qfig-cascade svg { width: 100%; height: auto; display: block; }
  .qfig-cascade text { font-size: 13px; fill: var(--text-body); }
  .qfig-cascade .qfig-cascade-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-cascade .qfig-cascade-strong { font-weight: 700; fill: var(--text); }
  .qfig-cascade .qfig-cascade-muted { fill: var(--text-muted); font-size: 12px; }
  .qfig-cascade-box rect, .qfig-cascade-rep rect:first-child {
    fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2;
  }
  .qfig-cascade-rep.is-over rect:first-child { fill: var(--red-tint-bg); stroke: var(--red); }
  .qfig-cascade-rep.is-down rect:first-child { fill: var(--red-tint-bg); stroke: var(--red); stroke-dasharray: 4 3; }
  .qfig-cascade .qfig-cascade-down { fill: var(--red); font-weight: 700; }
  .qfig-cascade-track { fill: var(--border); }
  .qfig-cascade-bar { fill: var(--act-2); }
  .qfig-cascade-bar.is-hot { fill: var(--red); }
  .qfig-cascade .qfig-cascade-pct { font-variant-numeric: tabular-nums; fill: var(--text-muted); }
  .qfig-cascade .qfig-cascade-pct.is-hot { fill: var(--red); font-weight: 700; }
  .qfig-cascade-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-cascade-arrow polygon { fill: var(--text-muted); }
  .qfig-cascade-arrow.is-cut path { stroke-dasharray: 3 4; opacity: 0.5; }
  .qfig-cascade-arrow.is-red path { stroke: var(--red); }
  .qfig-cascade-arrow.is-red polygon { fill: var(--red); }
  .qfig-cascade-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-cascade .qfig-cascade-bad { fill: var(--red); font-weight: 700; }
</style>
