---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for batch processing set 04: secondary sort shuffle of 40 GB clicks and 8 GB users
// across 4 reducers using hash(user_id) % 4, showing @star routing 70% of clicks to Reducer 4
// while Reducers 1-3 each take 10%. Shows proportions only, never computed GB or imbalance ratio.
// Plain inline SVG, site tokens only, no <marker>/<pattern>/<filter>/<clipPath>/ids.

const W = 580;
const H = 384;

function arrow(x1: number, y1: number, x2: number, y2: number, headLen = 9) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - headLen * Math.cos(a - 0.45), y2 - headLen * Math.sin(a - 0.45)];
  const p2 = [x2 - headLen * Math.cos(a + 0.45), y2 - headLen * Math.sin(a + 0.45)];
  const back = headLen - 2;
  return {
    line: `M ${x1} ${y1} L ${(x2 - back * Math.cos(a)).toFixed(1)} ${(y2 - back * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const reducers = [
  { id: 1, y: 64, hot: false },
  { id: 2, y: 136, hot: false },
  { id: 3, y: 208, hot: false },
  { id: 4, y: 282, hot: true },
];
---
<div class="qfig-shk">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Mappers partition 8 GB of users tagged (user_id, 0_prof) and 40 GB of clicks tagged (user_id, 1_<ts>) across 4 reducers with hash(user_id) % 4. Reducers 1 to 3 each receive 10% of clicks, while celebrity key @star routes 70% of clicks to Reducer 4.">
    <text x="10" y="22" class="qfig-shk-h">
      <tspan data-lang-en>Secondary sort shuffle with @star</tspan>
      <tspan data-lang-vi>Bước shuffle secondary sort với @star</tspan>
    </text>

    <text x="10" y="48" class="qfig-shk-lane">
      <tspan data-lang-en>Map outputs (sorted runs)</tspan>
      <tspan data-lang-vi>Đầu ra Map (đã sắp xếp)</tspan>
    </text>
    <text x="352" y="48" class="qfig-shk-lane">
      <tspan data-lang-en>4 Reducers (join stage)</tspan>
      <tspan data-lang-vi>4 Reducer (bước join)</tspan>
    </text>

    <!-- Left Card 1: users -->
    <rect x="10" y="64" width="204" height="80" rx="8" class="qfig-shk-card" />
    <DiagramIcon name="users" x={30} y={84} size={20} />
    <text x="46" y="89" class="qfig-shk-t">users (8 GB)</text>
    <text x="22" y="113" class="qfig-shk-m">(user_id, 0_prof) -&gt; profile</text>
    <text x="22" y="132" class="qfig-shk-m">
      <tspan data-lang-en>partitioned across workers</tspan>
      <tspan data-lang-vi>phân mảnh trên các worker</tspan>
    </text>

    <!-- Left Card 2: clicks -->
    <rect x="10" y="158" width="204" height="114" rx="8" class="qfig-shk-card" />
    <DiagramIcon name="spark" x={30} y={178} size={20} />
    <text x="46" y="183" class="qfig-shk-t">clicks (40 GB)</text>
    <text x="22" y="207" class="qfig-shk-m">(user_id, 1_&lt;ts&gt;) -&gt; url</text>
    <rect x="20" y="219" width="184" height="42" rx="5" class="qfig-shk-hot" />
    <text x="30" y="237" class="qfig-shk-red">
      <tspan data-lang-en>@star: 70% of clicks</tspan>
      <tspan data-lang-vi>@star: 70% lượt click</tspan>
    </text>
    <text x="30" y="254" class="qfig-shk-m">
      <tspan data-lang-en>all other users: 30%</tspan>
      <tspan data-lang-vi>các user khác: 30%</tspan>
    </text>

    <!-- Shuffle rule box -->
    <rect x="10" y="286" width="204" height="82" rx="8" class="qfig-shk-card" />
    <DiagramIcon name="file" x={30} y={308} size={18} />
    <text x="46" y="312" class="qfig-shk-t">
      <tspan data-lang-en>Shuffle rule</tspan>
      <tspan data-lang-vi>Quy tắc shuffle</tspan>
    </text>
    <text x="22" y="335" class="qfig-shk-m">hash(user_id) % 4</text>
    <text x="22" y="356" class="qfig-shk-m">
      <tspan data-lang-en>sort by (user_id, tag)</tspan>
      <tspan data-lang-vi>xếp theo (user_id, tag)</tspan>
    </text>

    <!-- Arrows from Map outputs edge (x=216) to Reducers without crossing -->
    {reducers.map((r) => {
      const yTarget = r.hot ? r.y + 43 : r.y + 29;
      const yStart = r.hot ? 240 : 178;
      const a = arrow(216, yStart, 348, yTarget, r.hot ? 12 : 9);
      return (
        <g class={r.hot ? 'qfig-shk-heavy' : 'qfig-shk-thin'}>
          <path d={a.line} />
          <polygon points={a.head} />
        </g>
      );
    })}

    <!-- Right Column: Reducers 1-3 -->
    {reducers.filter((r) => !r.hot).map((r) => (
      <g>
        <rect x="352" y={r.y} width="218" height="58" rx="8" class="qfig-shk-card" />
        <DiagramIcon name="server" x={374} y={r.y + 29} size={20} />
        <text x="394" y={r.y + 25} class="qfig-shk-t">Reducer {r.id}</text>
        <text x="394" y={r.y + 45} class="qfig-shk-m">
          <tspan data-lang-en>10% of clicks</tspan>
          <tspan data-lang-vi>10% lượt click</tspan>
        </text>
      </g>
    ))}

    <!-- Right Column: Reducer 4 (Hot Key) -->
    <rect x="352" y="282" width="218" height="86" rx="8" class="qfig-shk-hot" />
    <DiagramIcon name="warning" x={374} y={308} size={20} />
    <text x="394" y="312" class="qfig-shk-red">Reducer 4</text>
    <text x="394" y="334" class="qfig-shk-t">
      <tspan data-lang-en>@star: 70% of clicks</tspan>
      <tspan data-lang-vi>@star: 70% lượt click</tspan>
    </text>
    <text x="394" y="354" class="qfig-shk-m">hash("@star") % 4</text>
  </svg>
</div>

<style>
  .qfig-shk { margin: 0; width: 100%; }
  .qfig-shk svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-shk text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-shk .qfig-shk-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-shk .qfig-shk-lane { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .qfig-shk .qfig-shk-t { font-weight: 600; fill: var(--text); }
  .qfig-shk .qfig-shk-m { fill: var(--text-muted); }
  .qfig-shk .qfig-shk-red { font-weight: 700; fill: var(--red); }
  .qfig-shk-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-shk-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .qfig-shk-thin path { fill: none; stroke: var(--gold); stroke-width: 1.6; }
  .qfig-shk-thin polygon { fill: var(--gold); }
  .qfig-shk-heavy path { fill: none; stroke: var(--red); stroke-width: 5.5; }
  .qfig-shk-heavy polygon { fill: var(--red); }
</style>
