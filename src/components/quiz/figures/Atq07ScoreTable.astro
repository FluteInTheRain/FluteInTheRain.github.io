---
// Quiz figure for ai-trading-portfolio set 01: five momentum z-scores of the small investor's stocks.
const rows = [['A', 2.0], ['B', 1.2], ['C', 0.4], ['D', -0.8], ['E', -1.6]] as [string, number][];
const mid = 300, sx = (v: number) => v * 80;
---
<div class="qfig-q07c">
  <svg viewBox="0 0 580 230" role="img" aria-label="Five horizontal bars for the momentum z-scores of stocks A to E: A 2.0, B 1.2, C 0.4 to the right of a centre line, D minus 0.8 and E minus 1.6 to the left.">
    <text x="0" y="20" class="h"><tspan data-lang-en>Momentum z-scores of the five stocks</tspan><tspan data-lang-vi>Z-score momentum của năm cổ phiếu</tspan></text>
    <line x1={mid} x2={mid} y1="34" y2="206" class="grid" />
    {rows.map(([n, z], i) => (
      <g>
        <text x="20" y={64 + i * 34} class="lab">{n}</text>
        <rect x={z >= 0 ? mid : mid + sx(z)} y={48 + i * 34} width={Math.abs(sx(z))} height="22" rx="3" class={z >= 0 ? 'gold' : 'redf'} />
        <text x={z >= 0 ? mid + sx(z) + 8 : mid + sx(z) - 8} y={64 + i * 34} text-anchor={z >= 0 ? 'start' : 'end'} class="num">{z.toFixed(1)}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-q07c { margin: 0; width: 100%; }
  .qfig-q07c svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .qfig-q07c text { font-size: 13px; fill: var(--text-body); }
  .qfig-q07c .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-q07c .m { font-size: 12px; fill: var(--text-muted); }
  .qfig-q07c .lab { font-weight: 600; fill: var(--text); }
  .qfig-q07c .num { font-weight: 700; fill: var(--text); }
  .qfig-q07c .num.red { fill: var(--red); }
  .qfig-q07c .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-q07c .gold { fill: var(--gold); }
  .qfig-q07c .grey { fill: var(--text-muted); opacity: 0.55; }
  .qfig-q07c .redf { fill: var(--red); }
  .qfig-q07c .grid { stroke: var(--border); stroke-width: 1; }
</style>
