---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 01: the HOSE worked-example book, one row per 50 VND step. Quantities in shares.
const rows = [
  { p: '40,900', q: 200, s: 'ask' }, { p: '40,850', q: 500, s: 'ask' }, { p: '40,800', q: 900, s: 'ask' },
  { p: '40,750', q: 0, s: 'gap' }, { p: '40,700', q: 0, s: 'gap' },
  { p: '40,650', q: 100, s: 'bid' }, { p: '40,600', q: 300, s: 'bid' }, { p: '40,550', q: 500, s: 'bid' },
];
---
<div class="q16">
  <svg viewBox="0 0 580 330" role="img" aria-hidden="true">
    <DiagramIcon name="ladder" x={22} y={20} size={22} />
    <text x="44" y="25" class="t-h"><tspan data-lang-en>Stock C, one row per price step</tspan><tspan data-lang-vi>Cổ phiếu C, mỗi hàng một bước giá</tspan></text>
    {rows.map((r, i) => (
      <g>
        <text x="30" y={72 + i * 30} class="t-b"><tspan data-lang-en>{r.p}</tspan><tspan data-lang-vi>{r.p.replace(',', '.')}</tspan></text>
        {r.s === 'gap'
          ? <rect x="110" y={54 + i * 30} width="270" height="24" rx="4" class="empty" />
          : <rect x="110" y={54 + i * 30} width={r.q * 0.3} height="24" rx="4" class={r.s} />}
        {r.s !== 'gap' && <text x={118 + r.q * 0.3} y={72 + i * 30} class="t-b">{r.q}</text>}
      </g>
    ))}
    <line x1="30" x2="400" y1={54 + 4 * 30 - 3} y2={54 + 4 * 30 - 3} class="midline" />
    <text x="420" y="177" class="t-gold"><tspan data-lang-en>mid 40,725</tspan><tspan data-lang-vi>giữa 40.725</tspan></text>
    <text x="30" y="312" class="t-s"><tspan data-lang-en>Red: sellers waiting. Green: buyers waiting. Shares in each queue.</tspan><tspan data-lang-vi>Đỏ: người bán đang chờ. Xanh: người mua đang chờ. Cổ phiếu trong mỗi hàng chờ.</tspan></text>
  </svg>
</div>

<style>
  .q16 { margin: 0; width: 100%; }
  .q16 svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .q16 text { font-size: 13px; fill: var(--text-body); }
  .q16 .t-h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .q16 .t-s { font-size: 12px; fill: var(--text-muted); }
  .q16 .t-b { font-size: 13px; font-weight: 600; fill: var(--text); }
  .q16 .t-gold { font-weight: 700; fill: var(--gold-icon); }
  .q16 .ask { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; }
  .q16 .bid { fill: color-mix(in srgb, var(--act-2) 16%, var(--bg)); stroke: var(--act-2); stroke-width: 1.3; }
  .q16 .mid { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.3; }
  .q16 .empty { fill: none; stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .q16 .midline { stroke: var(--gold); stroke-width: 1.6; stroke-dasharray: 6 4; fill: none; }
  .q16 .axis { stroke: var(--border); stroke-width: 1.4; }
  .q16 .grid { stroke: var(--border); stroke-width: 1; stroke-dasharray: 3 4; }
  .q16 .path { stroke: var(--text); stroke-width: 2; fill: none; }
</style>
