---
// Set 01 (post 11): 200 sorted response times. 190 short bars (about 30 ms), then 10 tall bars (about 900 ms).
// Shows the situation only: no percentile is marked. Plain inline SVG, site tokens only, no markers/defs.
const W = 580;
const H = 270;
const x0 = 56;
const slot = 2.55;
const base = 205;
const msToPx = (ms: number) => Math.max(3, (ms / 900) * 150);
const bars = Array.from({ length: 200 }, (_, i) => ({ x: x0 + i * slot, h: msToPx(i < 190 ? 30 : 900), slow: i >= 190 }));
const xSlow = x0 + 190 * slot;
const xEnd = x0 + 200 * slot;
---
<div class="bq11tr">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <line x1={x0 - 6} x2={xEnd + 4} y1={base} y2={base} class="tr-axis" />
    <line x1={x0 - 6} x2={xEnd + 4} y1={base - 150} y2={base - 150} class="tr-guide" />
    <text x={x0 - 10} y={base - 146} text-anchor="end" class="tr-num">900 ms</text>
    <text x={x0 - 10} y={base - 1} text-anchor="end" class="tr-num">30 ms</text>
    {bars.map((b) => <rect x={b.x} y={base - b.h} width="1.9" height={b.h} class={b.slow ? 'tr-bar is-slow' : 'tr-bar'} />)}

    <path d={`M ${x0} ${base - 22} L ${x0} ${base - 28} L ${xSlow - 6} ${base - 28} L ${xSlow - 6} ${base - 22}`} class="tr-brace" />
    <text x={(x0 + xSlow) / 2} y={base - 38} text-anchor="middle" class="tr-strong">
      <tspan data-lang-en>190 requests, about 30 ms each</tspan>
      <tspan data-lang-vi>190 request, mỗi cái khoảng 30 ms</tspan>
    </text>
    <text x={xEnd} y={base - 166} text-anchor="end" class="tr-red">
      <tspan data-lang-en>10 requests, about 900 ms each</tspan>
      <tspan data-lang-vi>10 request, mỗi cái khoảng 900 ms</tspan>
    </text>

    <text x={x0} y={base + 22} class="tr-num">
      <tspan data-lang-en>request 1</tspan>
      <tspan data-lang-vi>request 1</tspan>
    </text>
    <text x={xEnd} y={base + 22} text-anchor="end" class="tr-num">
      <tspan data-lang-en>request 200</tspan>
      <tspan data-lang-vi>request 200</tspan>
    </text>
    <text x={W / 2} y={base + 48} text-anchor="middle" class="tr-note">
      <tspan data-lang-en>One bar per request, sorted from fastest to slowest</tspan>
      <tspan data-lang-vi>Mỗi cột là một request, xếp từ nhanh nhất đến chậm nhất</tspan>
    </text>
  </svg>
</div>

<style>
  .bq11tr { margin: 0; width: 100%; }
  .bq11tr svg { display: block; width: 100%; height: auto; }
  .bq11tr text { font-size: 13px; fill: var(--text-body); }
  .bq11tr .tr-strong { font-weight: 700; fill: var(--text); font-size: 14px; }
  .bq11tr .tr-red { font-weight: 700; fill: var(--red); font-size: 14px; }
  .bq11tr .tr-note { fill: var(--text-muted); }
  .bq11tr .tr-num { font-variant-numeric: tabular-nums; fill: var(--text-muted); }
  .bq11tr .tr-bar { fill: var(--text-muted); }
  .bq11tr .tr-bar.is-slow { fill: var(--red); }
  .bq11tr .tr-axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .bq11tr .tr-guide { stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 3 4; }
  .bq11tr .tr-brace { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
</style>
