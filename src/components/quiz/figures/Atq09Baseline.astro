---
// Quiz figure, set 05: D's pushes against all 8 stocks and against the 4 lowest-volatility stocks.
const W = 580;
const H = 360;
const feats = [
  { en: '12-month momentum', vi: 'Momentum 12 tháng', all: 0.549, low: 0.534 },
  { en: '6-month momentum', vi: 'Momentum 6 tháng', all: 0.178, low: 0.148 },
  { en: 'value', vi: 'value', all: 0.446, low: 0.249 },
  { en: 'volatility', vi: 'biến động', all: 0.016, low: -0.159 },
  { en: 'size', vi: 'quy mô', all: 0.417, low: 0.392 },
];
const X0 = 330, S = 230;
const f = (n: number) => (n >= 0 ? '+' : '-') + Math.abs(n).toFixed(3);
const fv = (n: number) => f(n).replace('.', ',');
---
<div class="qd9b">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <text x="16" y="24" class="h">
      <tspan data-lang-en>Stock D (score 1.540) against two baselines</tspan>
      <tspan data-lang-vi>Cổ phiếu D (điểm 1,540) với hai mốc so sánh</tspan>
    </text>
    <line x1={X0} x2={X0} y1="40" y2="258" class="zero" />
    {feats.map((r, i) => {
      const y = 48 + i * 42;
      return (
        <g>
          <text x="16" y={y + 24} class="lab">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          <rect x={r.all >= 0 ? X0 : X0 + r.all * S} y={y + 3} width={Math.max(2, Math.abs(r.all) * S)} height="14" class="bar is-all" />
          <rect x={r.low >= 0 ? X0 : X0 + r.low * S} y={y + 20} width={Math.max(2, Math.abs(r.low) * S)} height="14" class="bar is-low" />
          <text x={X0 + Math.max(r.all, 0) * S + 6} y={y + 15} class="val">
            <tspan data-lang-en>{f(r.all)}</tspan>
            <tspan data-lang-vi>{fv(r.all)}</tspan>
          </text>
          <text x={r.low >= 0 ? X0 + r.low * S + 6 : X0 + 6} y={y + 32} class={r.low < 0 ? 'val is-neg' : 'val'}>
            <tspan data-lang-en>{f(r.low)}</tspan>
            <tspan data-lang-vi>{fv(r.low)}</tspan>
          </text>
        </g>
      );
    })}
    <rect x="16" y="282" width="14" height="14" class="bar is-all" />
    <text x="38" y="294" class="lab">
      <tspan data-lang-en>all 8 stocks: average -0.066</tspan>
      <tspan data-lang-vi>cả 8 cổ phiếu: trung bình -0,066</tspan>
    </text>
    <rect x="16" y="308" width="14" height="14" class="bar is-low" />
    <text x="38" y="320" class="lab">
      <tspan data-lang-en>4 lowest-volatility stocks: average 0.376</tspan>
      <tspan data-lang-vi>4 cổ phiếu biến động thấp nhất: trung bình 0,376</tspan>
    </text>
  </svg>
</div>

<style>
  .qd9b { margin: 0; width: 100%; }
  .qd9b svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .qd9b text { font-size: 13px; fill: var(--text-body); }
  .qd9b .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qd9b .lab { fill: var(--text); }
  .qd9b .val { font-size: 12px; font-weight: 700; fill: var(--text-muted); }
  .qd9b .val.is-neg { fill: var(--red); }
  .qd9b .zero { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .qd9b .bar.is-all { fill: var(--text-faint); }
  .qd9b .bar.is-low { fill: var(--gold); }
</style>
