---
// One slow call and its hedge on a timeline. Numbers match set-07: hedge delay 12 ms,
// hedge copy answers 8 ms after it is sent (so at 20 ms), the first copy would take 400 ms.
// The time axis is broken between 20 ms and 400 ms, so it is not to scale.
---
<figure class="qfig-hedge">
  <svg viewBox="0 0 400 280" role="img" aria-hidden="true">
    <text x="130" y="16" text-anchor="middle" class="qfig-hedge-thr-t">
      <tspan data-lang-en>12 ms: no answer yet, send the hedge</tspan>
      <tspan data-lang-vi>12 ms: chưa có trả lời, gửi hedge</tspan>
    </text>

    <!-- lane A -->
    <text x="6" y="73" class="qfig-hedge-lane"><tspan data-lang-en>Replica A</tspan><tspan data-lang-vi>Replica A</tspan></text>
    <text x="138" y="50" class="qfig-hedge-on">
      <tspan data-lang-en>slow first request, cancelled at 20 ms</tspan>
      <tspan data-lang-vi>request đầu chậm, bị hủy lúc 20 ms</tspan>
    </text>
    <rect x="70" y="58" width="320" height="20" rx="3" class="qfig-hedge-track" />
    <rect x="70" y="58" width="150" height="20" rx="3" class="qfig-hedge-slow" />
    <rect x="262" y="58" width="108" height="20" rx="3" class="qfig-hedge-slow" />
    <path d="M 226 56 L 236 80 M 246 56 L 256 80" class="qfig-hedge-break" />
    <text x="390" y="96" text-anchor="end" class="qfig-hedge-on">
      <tspan data-lang-en>would end at 400 ms</tspan>
      <tspan data-lang-vi>sẽ xong lúc 400 ms</tspan>
    </text>

    <!-- lane B -->
    <text x="6" y="152" class="qfig-hedge-lane"><tspan data-lang-en>Replica B</tspan><tspan data-lang-vi>Replica B</tspan></text>
    <text x="188" y="128" class="qfig-hedge-on">
      <tspan data-lang-en>hedge copy answers after 8 ms</tspan>
      <tspan data-lang-vi>bản hedge trả lời sau 8 ms</tspan>
    </text>
    <rect x="70" y="136" width="320" height="20" rx="3" class="qfig-hedge-track" />
    <rect x="130" y="136" width="50" height="20" rx="3" class="qfig-hedge-fast" />

    <line x1="130" x2="130" y1="22" y2="206" class="qfig-hedge-thr" />
    <line x1="180" x2="180" y1="82" y2="206" class="qfig-hedge-win" />
    <text x="188" y="186" class="qfig-hedge-win-t">
      <tspan data-lang-en>winner: the page is served at 20 ms</tspan>
      <tspan data-lang-vi>thắng: trang xong lúc 20 ms</tspan>
    </text>

    <line x1="70" x2="390" y1="218" y2="218" class="qfig-hedge-axis" />
    <g class="qfig-hedge-tick">
      <line x1="70" x2="70" y1="214" y2="222" /><line x1="130" x2="130" y1="214" y2="222" />
      <line x1="180" x2="180" y1="214" y2="222" /><line x1="370" x2="370" y1="214" y2="222" />
    </g>
    <text x="70" y="238" text-anchor="middle" class="qfig-hedge-num">0</text>
    <text x="130" y="238" text-anchor="middle" class="qfig-hedge-num">12</text>
    <text x="180" y="238" text-anchor="middle" class="qfig-hedge-num">20</text>
    <text x="370" y="238" text-anchor="middle" class="qfig-hedge-num">400 ms</text>
    <text x="70" y="262" class="qfig-hedge-note">
      <tspan data-lang-en>axis is broken after 20 ms, not to scale</tspan>
      <tspan data-lang-vi>trục bị ngắt sau 20 ms, không theo tỉ lệ</tspan>
    </text>
  </svg>
</figure>

<style>
  .qfig-hedge { margin: 0; }
  .qfig-hedge svg { width: 100%; height: auto; display: block; }
  .qfig-hedge text { font-family: inherit; font-size: 12px; fill: var(--text-body); }
  .qfig-hedge .qfig-hedge-lane { font-weight: 600; fill: var(--text); }
  .qfig-hedge .qfig-hedge-track { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-hedge .qfig-hedge-slow { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-hedge .qfig-hedge-fast { fill: var(--act-2); opacity: 0.85; }
  .qfig-hedge .qfig-hedge-break { stroke: var(--text-muted); stroke-width: 2; fill: none; }
  .qfig-hedge .qfig-hedge-on { fill: var(--text); }
  .qfig-hedge .qfig-hedge-thr { stroke: var(--gold); stroke-width: 2; stroke-dasharray: 5 4; }
  .qfig-hedge .qfig-hedge-thr-t, .qfig-hedge .qfig-hedge-win-t { fill: var(--text); font-weight: 600; }
  .qfig-hedge .qfig-hedge-win { stroke: var(--act-2); stroke-width: 2; }
  .qfig-hedge .qfig-hedge-axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-hedge .qfig-hedge-tick line { stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-hedge .qfig-hedge-num { fill: var(--text-muted); font-size: 11px; }
  .qfig-hedge .qfig-hedge-note { fill: var(--text-muted); font-size: 11px; font-style: italic; }
</style>
