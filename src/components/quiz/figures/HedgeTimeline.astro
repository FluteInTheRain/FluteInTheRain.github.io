---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 07: one slow request and its hedge on a timeline. Numbers match the scenario:
// hedge delay 12 ms, the hedge copy answers 8 ms after it is sent (so at 20 ms),
// the stuck first copy would have taken 400 ms. Axis is to scale up to 20 ms, then broken.
// Plain inline SVG, site tokens only, no markers/defs (the page renders each figure twice).
const W = 580;
const H = 350;
const x0 = 130;
const pxPerMs = 14;
const xAt = (ms: number) => x0 + ms * pxPerMs;
const x12 = xAt(12);
const x20 = xAt(20);
const xEnd = 560;
const yClient = 62;
const laneA = { y: 100, h: 26 };
const laneB = { y: 196, h: 26 };
const yAxis = 292;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const sendA = arrow(x0, yClient + 4, x0, laneA.y - 2);
const sendB = arrow(x12, yClient + 4, x12, laneB.y - 2);
const back = arrow(x20, laneB.y - 2, x20, yClient + 6);
---
<div class="hedge">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <DiagramIcon name="laptop" x={22} y={yClient} size={22} />
    <text x="46" y={yClient + 5} class="hedge-lane">Client</text>
    <line x1={x0} x2={x20} y1={yClient} y2={yClient} class="hedge-wire" />
    <text x={x0 + 6} y={yClient - 14} class="hedge-note">
      <tspan data-lang-en>0 ms: send request</tspan>
      <tspan data-lang-vi>0 ms: gửi request</tspan>
    </text>
    <text x={x12 + 8} y={yClient - 14} class="hedge-strong">
      <tspan data-lang-en>12 ms: no answer, send hedge</tspan>
      <tspan data-lang-vi>12 ms: chưa trả lời, gửi hedge</tspan>
    </text>
    <circle cx={x0} cy={yClient} r="4.5" class="hedge-dot" />
    <circle cx={x12} cy={yClient} r="4.5" class="hedge-dot is-gold" />

    <!-- lane A: stuck replica -->
    <DiagramIcon name="server" x={22} y={laneA.y + 13} size={22} />
    <text x="46" y={laneA.y + 18} class="hedge-lane">Replica A</text>
    <rect x={x0} y={laneA.y} width={440 - x0} height={laneA.h} rx="4" class="hedge-bar is-slow" />
    <path d={`M 448 ${laneA.y - 4} L 454 ${laneA.y + laneA.h + 4} M 460 ${laneA.y - 4} L 466 ${laneA.y + laneA.h + 4}`} class="hedge-break" />
    <rect x="474" y={laneA.y} width={xEnd - 474} height={laneA.h} rx="4" class="hedge-bar is-ghost" />
    <text x={x0 + 10} y={laneA.y + 18} class="hedge-in">
      <tspan data-lang-en>stuck (interference)</tspan>
      <tspan data-lang-vi>bị kẹt (nhiễu)</tspan>
    </text>
    <text x={x20 + 10} y={laneA.y + laneA.h + 20} class="hedge-note">
      <tspan data-lang-en>cancelled at 20 ms</tspan>
      <tspan data-lang-vi>bị hủy lúc 20 ms</tspan>
    </text>
    <text x={xEnd} y={laneA.y - 8} text-anchor="end" class="hedge-note">
      <tspan data-lang-en>would have taken 400 ms</tspan>
      <tspan data-lang-vi>lẽ ra mất 400 ms</tspan>
    </text>

    <!-- lane B: hedge copy -->
    <DiagramIcon name="server" x={22} y={laneB.y + 13} size={22} />
    <text x="46" y={laneB.y + 18} class="hedge-lane">Replica B</text>
    <rect x={x12} y={laneB.y} width={x20 - x12} height={laneB.h} rx="4" class="hedge-bar is-win" />
    <text x={x20 + 10} y={laneB.y + 18} class="hedge-note">
      <tspan data-lang-en>answers 8 ms later</tspan>
      <tspan data-lang-vi>trả lời sau 8 ms</tspan>
    </text>
    <text x={x0} y={laneB.y + laneB.h + 28} class="hedge-strong">
      <tspan data-lang-en>First answer wins: page served at 20 ms</tspan>
      <tspan data-lang-vi>Bản về trước thắng: trang xong lúc 20 ms</tspan>
    </text>

    <!-- arrows drawn last so they sit on top of the bars -->
    <g class="hedge-arrow"><path d={sendA.line} /><polygon points={sendA.head} /></g>
    <g class="hedge-arrow is-gold"><path d={sendB.line} /><polygon points={sendB.head} /></g>
    <g class="hedge-arrow is-gold"><path d={back.line} /><polygon points={back.head} /></g>

    <!-- time axis -->
    <line x1={x0} x2="440" y1={yAxis} y2={yAxis} class="hedge-axis" />
    <line x1="474" x2={xEnd} y1={yAxis} y2={yAxis} class="hedge-axis" />
    <path d={`M 448 ${yAxis - 7} L 454 ${yAxis + 7} M 460 ${yAxis - 7} L 466 ${yAxis + 7}`} class="hedge-break" />
    <g class="hedge-tick">
      <line x1={x0} x2={x0} y1={yAxis - 5} y2={yAxis + 5} />
      <line x1={x12} x2={x12} y1={yAxis - 5} y2={yAxis + 5} />
      <line x1={x20} x2={x20} y1={yAxis - 5} y2={yAxis + 5} />
      <line x1={xEnd} x2={xEnd} y1={yAxis - 5} y2={yAxis + 5} />
    </g>
    <text x={x0} y={yAxis + 22} text-anchor="middle" class="hedge-num">0</text>
    <text x={x12} y={yAxis + 22} text-anchor="middle" class="hedge-num">12 ms</text>
    <text x={x20} y={yAxis + 22} text-anchor="middle" class="hedge-num">20 ms</text>
    <text x={xEnd - 6} y={yAxis + 22} text-anchor="middle" class="hedge-num">400 ms</text>
    <text x={x0} y={yAxis + 48} class="hedge-note">
      <tspan data-lang-en>To scale up to 20 ms, then broken.</tspan>
      <tspan data-lang-vi>Đúng tỉ lệ tới 20 ms, sau đó bị ngắt.</tspan>
    </text>
  </svg>
</div>

<style>
  .hedge { margin: 0; width: 100%; }
    .hedge svg { display: block; width: 100%; min-width: 360px; height: auto; }
  .hedge text { font-size: 13px; fill: var(--text-body); }
  .hedge .hedge-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .hedge .hedge-strong { font-weight: 700; fill: var(--text); }
  .hedge .hedge-note { fill: var(--text-muted); }
  .hedge .hedge-in { fill: var(--text); font-weight: 600; }
  .hedge .hedge-num { font-variant-numeric: tabular-nums; fill: var(--text-muted); font-size: 13px; }
  .hedge .hedge-bar.is-slow { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .hedge .hedge-bar.is-ghost { fill: none; stroke: var(--red); stroke-width: 1.5; stroke-dasharray: 4 3; opacity: 0.7; }
  .hedge .hedge-bar.is-win { fill: var(--gold); stroke: var(--gold-icon); stroke-width: 1.5; }
  .hedge .hedge-break { stroke: var(--text-muted); stroke-width: 2; fill: none; }
  .hedge .hedge-wire { stroke: var(--border); stroke-width: 2; }
  .hedge .hedge-dot { fill: var(--text-muted); }
  .hedge .hedge-dot.is-gold { fill: var(--gold-icon); }
  .hedge .hedge-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 2; }
  .hedge .hedge-arrow polygon { fill: var(--text-muted); }
  .hedge .hedge-arrow.is-gold path { stroke: var(--gold-icon); stroke-width: 2.5; }
  .hedge .hedge-arrow.is-gold polygon { fill: var(--gold-icon); }
  .hedge .hedge-drop { stroke: var(--border); stroke-width: 1.5; stroke-dasharray: 3 4; }
  .hedge .hedge-axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .hedge .hedge-tick line { stroke: var(--text-muted); stroke-width: 1.5; }
</style>
