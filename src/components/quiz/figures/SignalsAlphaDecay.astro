---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 06: alpha decay as measured by McLean & Pontiff (97 published stock-return
// patterns): portfolio returns 26% lower out-of-sample, 58% lower after publication;
// the authors estimate publication-informed trading destroys a further 32% of the edge.
// Bars show the surviving share of the in-sample edge: 100% / 74% / 42%.
const bars = [
  { en: 'In-sample', vi: 'Trong mẫu', v: 100, cls: 'qad-bar' },
  { en: 'Out-of-sample', vi: 'Ngoài mẫu', v: 74, cls: 'qad-bar' },
  { en: 'After publication', vi: 'Sau khi công bố', v: 42, cls: 'qad-bar is-dead' },
];
const x0 = 60;
const slot = 170;
const barW = 86;
const baseY = 330;
const maxH = 200;
---
<div class="qad">
  <svg viewBox="0 0 580 430" role="img" aria-hidden="true">
    <DiagramIcon name="money" x={22} y={20} size={22} />
    <text x="44" y="25" class="qad-h">
      <tspan data-lang-en>What survives of a published pattern's edge</tspan>
      <tspan data-lang-vi>Còn lại bao nhiêu lợi thế của một pattern đã công bố</tspan>
    </text>
    <text x="44" y="46" class="qad-muted">
      <tspan data-lang-en>97 published stock-return patterns (McLean &amp; Pontiff, Journal of Finance 2016)</tspan>
      <tspan data-lang-vi>97 pattern lợi suất cổ phiếu đã công bố (McLean &amp; Pontiff, Journal of Finance 2016)</tspan>
    </text>

    <line x1="30" x2="550" y1={baseY} y2={baseY} class="qad-axis" />
    {bars.map((b, i) => {
      const h = (b.v / 100) * maxH;
      const x = x0 + i * slot + (slot - barW) / 2;
      return (
        <g>
          <rect x={x} y={baseY - h} width={barW} height={h} rx="3" class={b.cls} />
          <text x={x + barW / 2} y={baseY - h - 10} text-anchor="middle" class="qad-n">{b.v}%</text>
          <text x={x + barW / 2} y={baseY + 22} text-anchor="middle" class="qad-tick">
            <tspan data-lang-en>{b.en}</tspan>
            <tspan data-lang-vi>{b.vi}</tspan>
          </text>
        </g>
      );
    })}
    <text x="196" y="292" text-anchor="middle" class="qad-dim">
      <tspan data-lang-en>26% lower</tspan>
      <tspan data-lang-vi>thấp hơn 26%</tspan>
    </text>
    <text x="366" y="250" text-anchor="middle" class="qad-bad">
      <tspan data-lang-en>58% lower</tspan>
      <tspan data-lang-vi>thấp hơn 58%</tspan>
    </text>

    <text x="30" y={baseY + 52} class="qad-tick">
      <tspan data-lang-en>share of the in-sample edge left, 100% = the edge found on historical data</tspan>
      <tspan data-lang-vi>phần lợi thế còn lại so với trong mẫu, 100% = lợi thế tìm thấy trên dữ liệu lịch sử</tspan>
    </text>
    <rect x="20" y="392" width="540" height="30" rx="8" class="qad-note" />
    <text x="36" y="412" class="qad-bad">
      <tspan data-lang-en>The authors' estimate: publication-informed trading destroys a further 32% of the edge.</tspan>
      <tspan data-lang-vi>Ước tính của hai tác giả: giao dịch dựa trên bài công bố xoá thêm 32% lợi thế.</tspan>
    </text>
  </svg>
</div>

<style>
  .qad {
    margin: 0;
    width: 100%;
  }
  .qad svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qad text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qad .qad-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qad .qad-muted,
  .qad .qad-tick {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qad-axis {
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .qad-bar {
    fill: var(--gold);
  }
  .qad-bar.is-dead {
    fill: var(--red);
  }
  .qad .qad-n {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qad .qad-dim {
    fill: var(--text-muted);
    font-weight: 700;
    font-size: 12.5px;
  }
  .qad .qad-bad {
    fill: var(--red);
    font-weight: 700;
    font-size: 12.5px;
  }
  .qad-note {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
</style>
