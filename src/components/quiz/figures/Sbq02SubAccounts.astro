---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for venues post set 06: sub-account .1 vs .6 comparison on a 100M VND deposit.
---
<div class="qfig-sbq02sa">
  <svg viewBox="0 0 580 215" role="img" aria-label="Order screen snapshot showing Sub-account .1 with 100 million VND cash buying power and 0% interest vs Sub-account .6 with 200 million VND buying power including 100 million VND margin loan.">
    <text x="16" y="24" class="qfig-h">
      <tspan data-lang-en>Deposit: 100,000,000 VND — two tabs on the order screen</tspan>
      <tspan data-lang-vi>Nạp 100.000.000 đồng — hai tab trên màn hình đặt lệnh</tspan>
    </text>

    <rect x="16" y="44" width="262" height="154" rx="8" class="qfig-card" />
    <DiagramIcon name="ok" x={42} y={72} size={22} />
    <text x="62" y="77" class="qfig-t">
      <tspan data-lang-en>Sub-account .1 (Cash)</tspan>
      <tspan data-lang-vi>Tiểu khoản .1 (Thường)</tspan>
    </text>
    <text x="30" y="108" class="qfig-b">
      <tspan data-lang-en>Buying power: 100M VND</tspan>
      <tspan data-lang-vi>Sức mua: 100 triệu đồng</tspan>
    </text>
    <text x="30" y="134" class="qfig-b">
      <tspan data-lang-en>Loan: 0 VND (0% / yr)</tspan>
      <tspan data-lang-vi>Vay nợ: 0 đồng (0% / năm)</tspan>
    </text>
    <text x="30" y="162" class="qfig-m">
      <tspan data-lang-en>Force sell: never</tspan>
      <tspan data-lang-vi>Giải chấp: không bao giờ</tspan>
    </text>

    <rect x="302" y="44" width="262" height="154" rx="8" class="qfig-card-red" />
    <DiagramIcon name="warning" x={328} y={72} size={22} />
    <text x="348" y="77" class="qfig-t qfig-red">
      <tspan data-lang-en>Sub-account .6 (Margin)</tspan>
      <tspan data-lang-vi>Tiểu khoản .6 (Ký quỹ)</tspan>
    </text>
    <text x="316" y="108" class="qfig-b">
      <tspan data-lang-en>Buying power: 200M VND</tspan>
      <tspan data-lang-vi>Sức mua: 200 triệu đồng</tspan>
    </text>
    <text x="316" y="134" class="qfig-b">
      <tspan data-lang-en>Max loan: 100M (daily interest)</tspan>
      <tspan data-lang-vi>Vay tối đa: 100 triệu (lãi ngày)</tspan>
    </text>
    <text x="316" y="162" class="qfig-m qfig-red">
      <tspan data-lang-en>Force sell if equity falls</tspan>
      <tspan data-lang-vi>Bán giải chấp nếu giá rớt</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-sbq02sa { margin: 0; width: 100%; }
  .qfig-sbq02sa svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-sbq02sa text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-sbq02sa .qfig-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-sbq02sa .qfig-t { font-weight: 700; fill: var(--text); }
  .qfig-sbq02sa .qfig-b { fill: var(--text-body); }
  .qfig-sbq02sa .qfig-m { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-sbq02sa .qfig-red { fill: var(--red); }
  .qfig-sbq02sa .qfig-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-sbq02sa .qfig-card-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
</style>
