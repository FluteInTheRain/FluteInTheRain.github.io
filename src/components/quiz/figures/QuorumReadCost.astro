---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for consistency-consensus set 02: five replicas (n=5, w=3, r=3), an in-flight write,
// and two sequential reads (Client A on {R1, R2, R3}, then Client B on {R3, R4, R5}).
// Shows the state and overlap at R3 without giving away computed r_min or repair latency.
// Plain inline SVG, site CSS tokens only, no <marker>/<defs>/id.

const W = 580;
const H = 382;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const repW = 98;
const repH = 60;
const repY = 136;
const replicas = [
  { id: 'R1', fresh: true, x: 17 },
  { id: 'R2', fresh: true, x: 129 },
  { id: 'R3', fresh: false, x: 241 },
  { id: 'R4', fresh: false, x: 353 },
  { id: 'R5', fresh: false, x: 465 },
].map((r) => ({ ...r, cx: r.x + repW / 2 }));

const writerBox = { x: 100, y: 56, w: 230, h: 40 };
const writerMidX = writerBox.x + writerBox.w / 2;
const writerBotY = writerBox.y + writerBox.h;
---
<div class="qfig-qrc">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Five replicas R1 to R5 with n=5, w=3, r=3 and 25 ms per hop. Writer sends Write(x=1, v1): R1 and R2 hold 1 (v1), while R3, R4, and R5 hold 0 (v0). Client A reads R1, R2, R3 and gets 1; Client B starts afterward, reads R3, R4, R5, and gets stale 0.">
    <text x="0" y="22" class="qfig-qrc-h">
      <tspan data-lang-en>Leaderless store (n = 5, w = 3, r = 3)</tspan>
      <tspan data-lang-vi>Kho không leader (n = 5, w = 3, r = 3)</tspan>
    </text>
    <text x="0" y="43" class="qfig-qrc-sub">
      <tspan data-lang-en>Write(x = 1, v1) is in flight; two sequential reads overlap at R3.</tspan>
      <tspan data-lang-vi>Write(x = 1, v1) đang trên đường; hai lượt đọc nối tiếp giao nhau tại R3.</tspan>
    </text>

    {/* Writer */}
    <rect x={writerBox.x} y={writerBox.y} width={writerBox.w} height={writerBox.h} rx="7" class="qfig-qrc-box" />
    <DiagramIcon name="laptop" x={writerBox.x + 22} y={writerBox.y + 20} size={22} />
    <text x={writerBox.x + 42} y={writerBox.y + 25} class="qfig-qrc-t">
      <tspan data-lang-en>Writer: Write(x = 1, v1)</tspan>
      <tspan data-lang-vi>Writer: Ghi(x = 1, v1)</tspan>
    </text>

    {/* Arrow legend beside Writer */}
    <line x1="358" x2="386" y1="68" y2="68" class="qfig-qrc-leg-done" />
    <text x="394" y="72" class="qfig-qrc-sub">
      <tspan data-lang-en>updated</tspan>
      <tspan data-lang-vi>đã cập nhật</tspan>
    </text>
    <line x1="358" x2="386" y1="88" y2="88" class="qfig-qrc-leg-fly" />
    <text x="394" y="92" class="qfig-qrc-sub">
      <tspan data-lang-en>write in flight</tspan>
      <tspan data-lang-vi>gói ghi đang tới</tspan>
    </text>

    {/* Write arrows to R1..R5 */}
    {replicas.map((r) => {
      const a = arrow(writerMidX, writerBotY, r.cx, repY - 2);
      return (
        <g class={r.fresh ? 'qfig-qrc-warrow is-done' : 'qfig-qrc-warrow is-fly'}>
          <path d={a.line} />
          <polygon points={a.head} />
        </g>
      );
    })}

    {/* 5 Replicas */}
    {replicas.map((r) => (
      <g class={r.fresh ? 'qfig-qrc-rep is-new' : 'qfig-qrc-rep is-old'}>
        <rect x={r.x} y={repY} width={repW} height={repH} rx="7" />
        <DiagramIcon name="server" x={r.x + 20} y={repY + 20} size={18} />
        <text x={r.x + 36} y={repY + 25} class="qfig-qrc-t">{r.id}</text>
        <text x={r.cx} y={repY + 47} text-anchor="middle" class="qfig-qrc-val">
          {r.fresh ? 'x = 1 (v1)' : 'x = 0 (v0)'}
        </text>
      </g>
    ))}

    {/* Client A quorum bracket {R1, R2, R3} */}
    <path d="M 66 198 L 66 208 L 282 208 L 282 198 M 178 198 L 178 228" class="qfig-qrc-br-a" />
    <rect x="17" y="228" width="315" height="54" rx="7" class="qfig-qrc-card" />
    <DiagramIcon name="phone" x={38} y={255} size={24} />
    <text x="58" y="249" class="qfig-qrc-t">
      <tspan data-lang-en>1. Client A reads {"{R1, R2, R3}"}</tspan>
      <tspan data-lang-vi>1. Client A đọc {"{R1, R2, R3}"}</tspan>
    </text>
    <text x="58" y="269" class="qfig-qrc-body">
      <tspan data-lang-en>Gets {"{v1, v1, v0}"} → returns 1</tspan>
      <tspan data-lang-vi>Nhận {"{v1, v1, v0}"} → trả về 1</tspan>
    </text>

    {/* Client B quorum bracket {R3, R4, R5} */}
    <path d="M 298 198 L 298 218 L 514 218 L 514 198 M 402 198 L 402 294" class="qfig-qrc-br-b" />
    <rect x="248" y="294" width="315" height="54" rx="7" class="qfig-qrc-card is-stale" />
    <DiagramIcon name="desktop" x={269} y={321} size={24} />
    <text x="289" y="315" class="qfig-qrc-t">
      <tspan data-lang-en>2. Client B (after A) reads {"{R3, R4, R5}"}</tspan>
      <tspan data-lang-vi>2. Client B (sau A) đọc {"{R3, R4, R5}"}</tspan>
    </text>
    <text x="289" y="335" class="qfig-qrc-stale">
      <tspan data-lang-en>Gets {"{v0, v0, v0}"} → returns stale 0</tspan>
      <tspan data-lang-vi>Nhận {"{v0, v0, v0}"} → trả về 0 (cũ)</tspan>
    </text>

    {/* Footer note */}
    <text x="0" y="372" class="qfig-qrc-sub">
      <tspan data-lang-en>25 ms per one-way hop (50 ms round trip) · background repair only</tspan>
      <tspan data-lang-vi>25 ms mỗi chặng một chiều (50 ms khứ hồi) · chỉ sửa chạy nền</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-qrc { margin: 0; width: 100%; }
  .qfig-qrc svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-qrc text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-qrc .qfig-qrc-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-qrc .qfig-qrc-t { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-qrc .qfig-qrc-val { font-size: 13.5px; font-weight: 600; fill: var(--text); }
  .qfig-qrc .qfig-qrc-body { font-size: 13.5px; fill: var(--text-body); }
  .qfig-qrc .qfig-qrc-stale { font-size: 13.5px; font-weight: 700; fill: var(--red); }
  .qfig-qrc .qfig-qrc-sub { font-size: 13px; fill: var(--text-muted); }
  .qfig-qrc-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .qfig-qrc-rep rect { stroke-width: 1.4; }
  .qfig-qrc-rep.is-new rect { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .qfig-qrc-rep.is-old rect { fill: var(--bg-alt); stroke: var(--border); }
  .qfig-qrc-warrow.is-done path { fill: none; stroke: var(--gold); stroke-width: 1.8; }
  .qfig-qrc-warrow.is-done polygon { fill: var(--gold); }
  .qfig-qrc-warrow.is-fly path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; stroke-dasharray: 4 3; }
  .qfig-qrc-warrow.is-fly polygon { fill: var(--text-muted); }
  .qfig-qrc-leg-done { stroke: var(--gold); stroke-width: 2; }
  .qfig-qrc-leg-fly { stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .qfig-qrc-br-a { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-qrc-br-b { fill: none; stroke: var(--red); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .qfig-qrc-card { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .qfig-qrc-card.is-stale { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
</style>
