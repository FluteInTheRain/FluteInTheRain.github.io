---
// Set 06: a random split of 20 time blocks (x = test, t = train).
const cells = 'ttxttttxttxtttxttxt'.padEnd(20, 't').split('');
const X0 = 12, CW = 27;
---
<div class="aq4">
  <svg viewBox="0 0 580 150" aria-hidden="true">
    <text x="10" y="20" class="h">
      <tspan data-lang-en>One fold of a shuffled split, 20 time blocks</tspan>
      <tspan data-lang-vi>Một fold của phép chia xáo trộn, 20 khối thời gian</tspan>
    </text>
    {cells.map((c, i) => <rect x={X0 + i * CW} y="38" width={CW - 3} height="30" rx="3" class={`c ${c}`} />)}
    <text x={X0} y="92" class="m">
      <tspan data-lang-en>earlier</tspan>
      <tspan data-lang-vi>sớm hơn</tspan>
    </text>
    <text x={X0 + 20 * CW - 3} y="92" text-anchor="end" class="m">
      <tspan data-lang-en>later</tspan>
      <tspan data-lang-vi>muộn hơn</tspan>
    </text>
    <rect x="12" y="110" width="22" height="14" rx="3" class="c t" />
    <text x="42" y="122">train</text>
    <rect x="120" y="110" width="22" height="14" rx="3" class="c x" />
    <text x="150" y="122">test</text>
  </svg>
</div>

<style>
  .aq4 { margin: 0; width: 100%; }
  .aq4 svg { display: block; width: 100%; height: auto; }
  .aq4 text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .aq4 .h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .aq4 .m { font-size: 12px; fill: var(--text-muted); }
  .aq4 .v { font-weight: 700; fill: var(--text); }
  .aq4 .c.t { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.1; }
  .aq4 .c.x { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
</style>
