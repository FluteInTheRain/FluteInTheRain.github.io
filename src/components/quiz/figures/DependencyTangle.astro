---
// Quiz figure for set 05: order-sync wired straight to its consumers and to hidden
// dependencies, versus the same service behind one versioned OrderEvent contract.
// Plain inline SVG, site tokens only. Numbers match the scenario: 4 consumers,
// 3 hidden dependencies, 14 manual runbook steps.
const consumers = ['billing', 'shipping', 'analytics', 'search'];
const cx = [70, 210, 350, 490]; // box centres, width 120
const hidden = [
  { x: 95, en: 'shared.orders', vi: 'shared.orders' },
  { x: 280, en: 'ledger (hard-coded)', vi: 'ledger (viết cứng)' },
  { x: 465, en: 'fix_stuck_orders.sh', vi: 'fix_stuck_orders.sh' },
];
const good = [
  { x: 95, en: 'metrics', vi: 'metrics' },
  { x: 280, en: 'traces', vi: 'traces' },
  { x: 465, en: 'scripted restart', vi: 'restart tự động' },
];
---
<div class="qfig-tangle">
  <svg viewBox="0 0 560 680" role="img" aria-label="Top: four consumers and three hidden dependencies wired straight into order-sync. Bottom: the same service behind one versioned OrderEvent contract, with metrics, traces and a scripted restart.">
    {/* ---------- Panel 1: the tangle ---------- */}
    <text x="10" y="22" class="qfig-tangle-h">
      <tspan data-lang-en>Today: everything touches order-sync</tspan>
      <tspan data-lang-vi>Hiện tại: mọi thứ chạm thẳng vào order-sync</tspan>
    </text>
    {cx.map((x) => <line x1={x} y1="76" x2="280" y2="136" class="qfig-tangle-link is-bad" />)}
    {hidden.map((h) => <line x1="280" y1="176" x2={h.x} y2="236" class="qfig-tangle-link is-hidden" />)}
    {cx.map((x, i) => (
      <g class="qfig-tangle-box">
        <rect x={x - 60} y="46" width="120" height="30" rx="5" />
        <text x={x} y="66" text-anchor="middle">{consumers[i]}</text>
      </g>
    ))}
    <g class="qfig-tangle-box is-core">
      <rect x="210" y="136" width="140" height="40" rx="5" />
      <text x="280" y="161" text-anchor="middle">order-sync</text>
    </g>
    {hidden.map((h) => (
      <g class="qfig-tangle-box is-hidden">
        <rect x={h.x - 85} y="236" width="170" height="30" rx="5" />
        <text x={h.x} y="256" text-anchor="middle">
          <tspan data-lang-en>{h.en}</tspan>
          <tspan data-lang-vi>{h.vi}</tspan>
        </text>
      </g>
    ))}
    <text x="280" y="296" text-anchor="middle" class="qfig-tangle-bad">
      <tspan data-lang-en>3 hidden dependencies · 14 manual steps · no metrics</tspan>
      <tspan data-lang-vi>3 phụ thuộc ngầm · 14 bước làm tay · không có metrics</tspan>
    </text>

    <line x1="10" x2="550" y1="322" y2="322" class="qfig-tangle-rule" />

    {/* ---------- Panel 2: behind a contract ---------- */}
    <text x="10" y="352" class="qfig-tangle-h">
      <tspan data-lang-en>Behind one contract: callers see the interface only</tspan>
      <tspan data-lang-vi>Sau một hợp đồng: người gọi chỉ thấy giao diện</tspan>
    </text>
    {cx.map((x) => <line x1={x} y1="406" x2="280" y2="446" class="qfig-tangle-link is-ok" />)}
    <line x1="280" y1="486" x2="280" y2="526" class="qfig-tangle-link is-ok" />
    {good.map((g) => <line x1="280" y1="566" x2={g.x} y2="606" class="qfig-tangle-link is-ok" />)}
    {cx.map((x, i) => (
      <g class="qfig-tangle-box">
        <rect x={x - 60} y="376" width="120" height="30" rx="5" />
        <text x={x} y="396" text-anchor="middle">{consumers[i]}</text>
      </g>
    ))}
    <g class="qfig-tangle-box is-contract">
      <rect x="140" y="446" width="280" height="40" rx="5" />
      <text x="280" y="471" text-anchor="middle">
        <tspan data-lang-en>OrderEvent v2 contract</tspan>
        <tspan data-lang-vi>Hợp đồng OrderEvent v2</tspan>
      </text>
    </g>
    <g class="qfig-tangle-box is-core">
      <rect x="210" y="526" width="140" height="40" rx="5" />
      <text x="280" y="551" text-anchor="middle">order-sync</text>
    </g>
    {good.map((g) => (
      <g class="qfig-tangle-box is-good">
        <rect x={g.x - 85} y="606" width="170" height="30" rx="5" />
        <text x={g.x} y="626" text-anchor="middle">
          <tspan data-lang-en>{g.en}</tspan>
          <tspan data-lang-vi>{g.vi}</tspan>
        </text>
      </g>
    ))}
    <text x="280" y="664" text-anchor="middle" class="qfig-tangle-ok">
      <tspan data-lang-en>Change inside, keep the contract: nobody else notices</tspan>
      <tspan data-lang-vi>Đổi bên trong, giữ hợp đồng: bên ngoài không hay biết</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-tangle { width: 100%; max-width: 640px; margin: 0 auto; }
  .qfig-tangle svg { width: 100%; height: auto; display: block; }
  .qfig-tangle text { font-size: 14px; fill: var(--text-body); }
  .qfig-tangle .qfig-tangle-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-tangle-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-tangle-box text { fill: var(--text); font-weight: 600; }
  .qfig-tangle-box.is-core rect { stroke: var(--text); stroke-width: 2; }
  .qfig-tangle-box.is-hidden rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-dasharray: 5 3; }
  .qfig-tangle-box.is-contract rect { stroke: var(--act-2); stroke-width: 2; }
  .qfig-tangle-box.is-good rect { stroke: var(--act-2); }
  .qfig-tangle-link { stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-tangle-link.is-bad { stroke: var(--red); }
  .qfig-tangle-link.is-hidden { stroke: var(--gold); stroke-dasharray: 5 3; }
  .qfig-tangle-link.is-ok { stroke: var(--act-2); }
  .qfig-tangle .qfig-tangle-bad { font-weight: 700; fill: var(--red); }
  .qfig-tangle .qfig-tangle-ok { font-weight: 700; fill: var(--act-2); }
  .qfig-tangle-rule { stroke: var(--border); }
</style>
