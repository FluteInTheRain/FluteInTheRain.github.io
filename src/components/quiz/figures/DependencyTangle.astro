---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for set 05: order-sync wired straight to consumers and hidden dependencies,
// versus the same service behind one versioned OrderEvent contract.
// Inline SVG, site tokens only, no <marker>/<defs> (the page renders each figure in two languages).
// Numbers match the scenario: 4 consumers, 3 hidden dependencies, 14 manual runbook steps.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 7 * Math.cos(a)} ${y2 - 7 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const consumers = [
  { en: 'billing', vi: 'billing', icon: 'money' },
  { en: 'shipping', vi: 'shipping', icon: 'package' },
  { en: 'analytics', vi: 'analytics', icon: 'chart' },
  { en: 'search', vi: 'search', icon: 'search' },
] as const;
const cw = 132;
const cgap = 10;
const rowTop = 54;
const rowH = 50;
const OFFSET_R = 420;
const colX = (i: number) => 4 + i * (cw + cgap);
const hidden = [
  { name: 'shared.orders', icon: 'db', en: "Another team's table", vi: 'Bảng của đội khác' },
  { name: 'ledger', icon: 'server', en: 'Hard-coded address', vi: 'Địa chỉ viết cứng' },
  { name: 'fix_stuck_orders.sh', icon: 'worker', en: 'Cron edits state from outside', vi: 'Cron sửa trạng thái từ ngoài' },
] as const;
const good = [
  { en: 'Metrics', vi: 'Metrics', icon: 'chart' },
  { en: 'Traces', vi: 'Trace', icon: 'eye' },
  { en: 'Scripted restart', vi: 'Restart bằng script', icon: 'retry' },
] as const;
const cx0 = 290;
const coreW = 170;
const coreH = 50;
const bottomY = 282;
const bw = 184;
const bx = (i: number) => 2 + i * (bw + 5);
---
<div class="qfig-tangle">
  <svg viewBox="0 0 580 805" role="img" aria-label="Top: four consumers and three hidden dependencies wired straight into order-sync. Bottom: the same service behind one versioned OrderEvent contract, with metrics, traces and a scripted restart.">
    <text x="4" y="22" class="qfig-tangle-h">
      <tspan data-lang-en>Today: everything touches order-sync</tspan>
      <tspan data-lang-vi>Hiện tại: mọi thứ chạm thẳng vào order-sync</tspan>
    </text>
    <text x="4" y="42" class="qfig-tangle-sub">
      <tspan data-lang-en>4 teams, each with its own copy of the schema</tspan>
      <tspan data-lang-vi>4 đội, mỗi đội giữ bản sao schema riêng</tspan>
    </text>

    {consumers.map((c, i) => (
      <line x1={colX(i) + cw / 2} y1={rowTop + rowH} x2={cx0} y2="160" class="qfig-tangle-link is-bad" />
    ))}
    {hidden.map((h, i) => (
      <line x1={cx0} y1="210" x2={bx(i) + bw / 2} y2={bottomY} class="qfig-tangle-link is-bad is-dash" />
    ))}
    {consumers.map((c, i) => (
      <g class="qfig-tangle-box">
        <rect x={colX(i)} y={rowTop} width={cw} height={rowH} rx="8" />
        <DiagramIcon name={c.icon} x={colX(i) + 22} y={rowTop + rowH / 2} size={22} />
        <text x={colX(i) + 42} y={rowTop + rowH / 2 + 5}>{c.en}</text>
      </g>
    ))}
    <g class="qfig-tangle-box is-core">
      <rect x={cx0 - coreW / 2} y="160" width={coreW} height={coreH} rx="8" />
      <DiagramIcon name="server" x={cx0 - coreW / 2 + 26} y="185" size={24} />
      <text x={cx0 - coreW / 2 + 50} y="190">order-sync</text>
    </g>
    {hidden.map((h, i) => (
      <g>
        <g class="qfig-tangle-box is-hidden">
          <rect x={bx(i)} y={bottomY} width={bw} height="50" rx="8" />
          <DiagramIcon name={h.icon} x={bx(i) + 20} y={bottomY + 25} size={22} />
          <text x={bx(i) + 40} y={bottomY + 30}>{h.name}</text>
        </g>
        <text x={bx(i) + bw / 2} y={bottomY + 72} text-anchor="middle" class="qfig-tangle-sub">
          <tspan data-lang-en>{h.en}</tspan>
          <tspan data-lang-vi>{h.vi}</tspan>
        </text>
      </g>
    ))}
    <text x="4" y="378" class="qfig-tangle-bad">
      <tspan data-lang-en>No metrics, no traces. Restart: 14 manual steps.</tspan>
      <tspan data-lang-vi>Không metrics, không trace. Khởi động lại: 14 bước làm tay.</tspan>
    </text>
    <text x="4" y="398" class="qfig-tangle-sub">
      <tspan data-lang-en>3 hidden dependencies nobody wrote down.</tspan>
      <tspan data-lang-vi>3 phụ thuộc ngầm không ai ghi lại.</tspan>
    </text>

    <line x1="0" x2="580" y1="410" y2="410" class="qfig-tangle-rule" />

    <g transform={`translate(0 ${OFFSET_R})`}>
      <text x="4" y="22" class="qfig-tangle-h">
        <tspan data-lang-en>Behind one versioned contract</tspan>
        <tspan data-lang-vi>Sau một hợp đồng có đánh phiên bản</tspan>
      </text>
      <text x="4" y="42" class="qfig-tangle-sub">
        <tspan data-lang-en>The same 4 teams read one shared schema</tspan>
        <tspan data-lang-vi>Cùng 4 đội đó đọc chung một schema</tspan>
      </text>
      {consumers.map((c, i) => {
        const a = arrow(cx0, 136, colX(i) + cw / 2, rowTop + rowH + 2);
        return <g class="qfig-tangle-link is-ok"><path d={a.line} /><polygon points={a.head} /></g>;
      })}
      {consumers.map((c, i) => (
        <g class="qfig-tangle-box">
          <rect x={colX(i)} y={rowTop} width={cw} height={rowH} rx="8" />
          <DiagramIcon name={c.icon} x={colX(i) + 22} y={rowTop + rowH / 2} size={22} />
          <text x={colX(i) + 42} y={rowTop + rowH / 2 + 5}>{c.en}</text>
        </g>
      ))}
      <g class="qfig-tangle-box is-contract">
        <rect x={cx0 - 110} y="136" width="220" height="40" rx="8" />
        <DiagramIcon name="file" x={cx0 - 88} y="156" size={22} />
        <text x={cx0 - 66} y="161">OrderEvent v2</text>
      </g>
      <text x={cx0 + 120} y="161" class="qfig-tangle-ok-sub">
        <tspan data-lang-en>one schema</tspan>
        <tspan data-lang-vi>một schema</tspan>
      </text>
      {(() => { const a = arrow(cx0, 206, cx0, 178); return <g class="qfig-tangle-link is-ok"><path d={a.line} /><polygon points={a.head} /></g>; })()}
      <g class="qfig-tangle-box is-core">
        <rect x={cx0 - coreW / 2} y="206" width={coreW} height={coreH} rx="8" />
        <DiagramIcon name="server" x={cx0 - coreW / 2 + 26} y="231" size={24} />
        <text x={cx0 - coreW / 2 + 50} y="236">order-sync</text>
      </g>
      {good.map((g, i) => (
        <line x1={cx0} y1="256" x2={bx(i) + bw / 2} y2={bottomY} class="qfig-tangle-link is-ok" />
      ))}
      {good.map((g, i) => (
        <g class="qfig-tangle-box is-good">
          <rect x={bx(i)} y={bottomY} width={bw} height="50" rx="8" />
          <DiagramIcon name={g.icon} x={bx(i) + 20} y={bottomY + 25} size={22} />
          <text x={bx(i) + 40} y={bottomY + 30}>
            <tspan data-lang-en>{g.en}</tspan>
            <tspan data-lang-vi>{g.vi}</tspan>
          </text>
        </g>
      ))}
      <text x="4" y="358" class="qfig-tangle-ok">
        <tspan data-lang-en>Changes go through the contract, and you can see inside.</tspan>
        <tspan data-lang-vi>Thay đổi đi qua hợp đồng, và nhìn được vào bên trong.</tspan>
      </text>
    </g>
  </svg>
</div>

<style>
  .qfig-tangle { margin: 0; width: 100%; }
  .qfig-tangle svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-tangle text { font-size: 14px; fill: var(--text-body); }
  .qfig-tangle .qfig-tangle-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-tangle .qfig-tangle-sub { fill: var(--text-muted); }
  .qfig-tangle-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-tangle-box text { fill: var(--text); font-weight: 600; }
  .qfig-tangle-box text.is-small { font-size: 13px; }
  .qfig-tangle-box.is-core rect { stroke: var(--text); stroke-width: 2; }
  .qfig-tangle-box.is-hidden rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-dasharray: 5 3; }
  .qfig-tangle-box.is-contract rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 2; }
  .qfig-tangle-box.is-good rect { stroke: var(--gold); }
  .qfig-tangle-link { stroke: var(--text-muted); stroke-width: 1.6; fill: none; }
  .qfig-tangle-link.is-bad { stroke: var(--red); }
  .qfig-tangle-link.is-dash { stroke-dasharray: 5 3; }
  .qfig-tangle-link.is-ok { stroke: var(--gold); }
  .qfig-tangle-link.is-ok polygon { fill: var(--gold); stroke: none; }
  .qfig-tangle-link.is-ok path { fill: none; stroke: var(--gold); stroke-width: 1.6; }
  .qfig-tangle .qfig-tangle-bad { font-weight: 700; fill: var(--red); }
  .qfig-tangle .qfig-tangle-ok { font-weight: 700; fill: var(--gold-icon); }
  .qfig-tangle .qfig-tangle-ok-sub { font-weight: 600; fill: var(--gold-icon); }
  .qfig-tangle-rule { stroke: var(--border); }
</style>
