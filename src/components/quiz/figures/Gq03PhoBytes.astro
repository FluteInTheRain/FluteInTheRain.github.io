---
// Quiz figure for go-slices-maps-strings set 04: the string "Phở" as five bytes grouped into three runes.
// It shows byte values, byte indexes and where each rune starts; it does not say what any loop prints.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
---
<div class="qfig-gq03pb">
  <svg viewBox="0 0 580 250" role="img" aria-label="The string Phở drawn as five bytes at indexes 0 to 4. The bytes are 0x50, 0x68, 0xe1, 0xbb, 0x9f. The first rune P is byte 0, the second rune h is byte 1, the third rune ở is bytes 2 to 4.">
    <text x="0" y="20" class="qfig-gq03pb-h">
      <tspan data-lang-en>The string "Phở": five bytes, three runes</tspan>
      <tspan data-lang-vi>Chuỗi "Phở": năm byte, ba rune</tspan>
    </text>

    <text x="20" y="54" class="qfig-gq03pb-t">
      <tspan data-lang-en>runes</tspan>
      <tspan data-lang-vi>rune</tspan>
    </text>
    <rect x="20" y="64" width="100" height="40" rx="6" class="qfig-gq03pb-r" />
    <rect x="124" y="64" width="100" height="40" rx="6" class="qfig-gq03pb-r" />
    <rect x="228" y="64" width="312" height="40" rx="6" class="qfig-gq03pb-r" />
    <text x="70" y="90" text-anchor="middle" class="qfig-gq03pb-rt">P  U+0050</text>
    <text x="174" y="90" text-anchor="middle" class="qfig-gq03pb-rt">h  U+0068</text>
    <text x="384" y="90" text-anchor="middle" class="qfig-gq03pb-rt">ở  U+1EDF</text>

    <text x="20" y="132" class="qfig-gq03pb-t">
      <tspan data-lang-en>bytes</tspan>
      <tspan data-lang-vi>byte</tspan>
    </text>
    <rect x="20" y="142" width="100" height="40" rx="4" class="qfig-gq03pb-b" />
    <rect x="124" y="142" width="100" height="40" rx="4" class="qfig-gq03pb-b" />
    <rect x="228" y="142" width="100" height="40" rx="4" class="qfig-gq03pb-b" />
    <rect x="332" y="142" width="100" height="40" rx="4" class="qfig-gq03pb-b" />
    <rect x="436" y="142" width="104" height="40" rx="4" class="qfig-gq03pb-b" />
    <text x="70" y="168" text-anchor="middle" class="qfig-gq03pb-m">0x50</text>
    <text x="174" y="168" text-anchor="middle" class="qfig-gq03pb-m">0x68</text>
    <text x="278" y="168" text-anchor="middle" class="qfig-gq03pb-m">0xe1</text>
    <text x="382" y="168" text-anchor="middle" class="qfig-gq03pb-m">0xbb</text>
    <text x="488" y="168" text-anchor="middle" class="qfig-gq03pb-m">0x9f</text>

    <text x="70" y="202" text-anchor="middle" class="qfig-gq03pb-i">s[0]</text>
    <text x="174" y="202" text-anchor="middle" class="qfig-gq03pb-i">s[1]</text>
    <text x="278" y="202" text-anchor="middle" class="qfig-gq03pb-i">s[2]</text>
    <text x="382" y="202" text-anchor="middle" class="qfig-gq03pb-i">s[3]</text>
    <text x="488" y="202" text-anchor="middle" class="qfig-gq03pb-i">s[4]</text>

    <text x="20" y="236" class="qfig-gq03pb-n">
      <tspan data-lang-en>len(s) is 5; the third rune starts at byte index 2</tspan>
      <tspan data-lang-vi>len(s) là 5; rune thứ ba bắt đầu ở byte số 2</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq03pb { margin: 0; width: 100%; }
  .qfig-gq03pb svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq03pb text { font-size: 13px; fill: var(--text-body); }
  .qfig-gq03pb .qfig-gq03pb-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq03pb .qfig-gq03pb-t { font-weight: 700; fill: var(--text); }
  .qfig-gq03pb .qfig-gq03pb-rt { font-size: 14px; fill: var(--text); }
  .qfig-gq03pb .qfig-gq03pb-m { font-family: 'JetBrains Mono', ui-monospace, monospace; fill: var(--text); }
  .qfig-gq03pb .qfig-gq03pb-i { font-family: 'JetBrains Mono', ui-monospace, monospace; fill: var(--text-muted); }
  .qfig-gq03pb .qfig-gq03pb-n { fill: var(--text-body); }
  .qfig-gq03pb-r { fill: var(--bg-alt); stroke: var(--act-3); stroke-width: 2; }
  .qfig-gq03pb-b { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; }
</style>
