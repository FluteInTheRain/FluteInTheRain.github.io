---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for the holdout set: 45 zero-edge strategies, winner picked on years 1-3 has mean Sharpe 1.28; the same
// strategy on years 4-5 has mean 0.02 (numpy seed 7, 5,000 runs).
---
<div class="qfig-atq04sf">
  <svg viewBox="0 0 580 170" role="img" aria-label="A timeline of five years split into three years of selection and two years of fresh data. The winner of 45 strategies with no edge has an average Sharpe of 1.28 on the first three years and 0.02 on the last two.">
    <rect x="20" y="14" width="330" height="32" rx="5" class="qfig-atq04sf-seg" />
    <rect x="350" y="14" width="210" height="32" rx="5" class="qfig-atq04sf-seg is-new" />
    <text x="185" y="35" text-anchor="middle" class="qfig-atq04sf-lab">
      <tspan data-lang-en>Years 1–3: pick the best of 45</tspan>
      <tspan data-lang-vi>Năm 1–3: chọn cái tốt nhất trong 45</tspan>
    </text>
    <text x="455" y="35" text-anchor="middle" class="qfig-atq04sf-lab">
      <tspan data-lang-en>Years 4–5: untouched</tspan>
      <tspan data-lang-vi>Năm 4–5: chưa đụng tới</tspan>
    </text>
    <DiagramIcon name="chart" x="36" y="86" size={22} />
    <rect x="70" y="74" width={1.28 * 160} height="24" rx="3" class="qfig-atq04sf-bar is-red" />
    <text x={70 + 1.28 * 160 + 8} y="91" class="qfig-atq04sf-v">1.28</text>
    <DiagramIcon name="chart" x="36" y="130" size={22} />
    <rect x="70" y="118" width="3" height="24" class="qfig-atq04sf-bar" />
    <text x="82" y="135" class="qfig-atq04sf-v">0.02</text>
    <text x="340" y="91" class="qfig-atq04sf-sub">
      <tspan data-lang-en>mean Sharpe, years 1–3</tspan>
      <tspan data-lang-vi>Sharpe trung bình, năm 1–3</tspan>
    </text>
    <text x="340" y="135" class="qfig-atq04sf-sub">
      <tspan data-lang-en>mean Sharpe, years 4–5</tspan>
      <tspan data-lang-vi>Sharpe trung bình, năm 4–5</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-atq04sf svg { display: block; width: 100%; height: auto; max-width: 580px; margin: 0 auto; }
  .qfig-atq04sf text { font-size: 12.5px; fill: var(--text-body); }
  .qfig-atq04sf .qfig-atq04sf-lab { font-weight: 700; fill: var(--text); }
  .qfig-atq04sf .qfig-atq04sf-v { font-weight: 700; font-size: 14px; fill: var(--text); }
  .qfig-atq04sf .qfig-atq04sf-sub { fill: var(--text-muted); }
  .qfig-atq04sf-seg { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-atq04sf-seg.is-new { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .qfig-atq04sf-bar { fill: var(--text-muted); }
  .qfig-atq04sf-bar.is-red { fill: var(--red); }
</style>
