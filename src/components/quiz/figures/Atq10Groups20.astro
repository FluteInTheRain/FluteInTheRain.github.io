---
// Single linkage on 20 days of the 12 simulated stocks, cut into 3 groups (Python):
// [R4 R1 R2 R3] [B4] [S4 S2 S1 S3 B2 B1 B3]
const cols: Record<string, string> = { B: 'var(--act-3)', S: 'var(--act-1)', R: 'var(--act-2)' };
const groups = [['R4','R1','R2','R3'], ['B4'], ['S4','S2','S1','S3','B2','B1','B3']];
---
<div class="q10g">
  <svg viewBox="0 0 580 250" role="img" aria-hidden="true">
    <text x="20" y="24" class="q10g-h">
      <tspan data-lang-en>Single linkage, 20 days, cut into three groups</tspan>
      <tspan data-lang-vi>Single linkage, 20 ngày, cắt thành ba nhóm</tspan>
    </text>
    {groups.map((g, gi) => (
      <g>
        <rect x="20" y={42 + gi * 52} width="540" height="42" rx="8" class="q10g-panel" />
        {g.map((n, ni) => (
          <g>
            <rect x={32 + ni * 52} y={48 + gi * 52} width="46" height="30" rx="15" class="q10g-chip" style={`stroke:${cols[n[0]]}`} />
            <text x={55 + ni * 52} y={68 + gi * 52} text-anchor="middle" class="q10g-n" style={`fill:${cols[n[0]]}`}>{n}</text>
          </g>
        ))}
      </g>
    ))}
    <text x="20" y="224" class="q10g-s">
      <tspan data-lang-en>Colour is the real sector: B banks (blue), S steel (olive), R retail (green).</tspan>
      <tspan data-lang-vi>Màu là ngành thật: B ngân hàng (xanh dương), S thép (vàng olive), R bán lẻ (xanh lá).</tspan>
    </text>
  </svg>
</div>

<style>
  .q10g { margin: 0; width: 100%; }
  .q10g svg { display: block; width: 100%; height: auto; }
  .q10g text { font-size: 13.5px; fill: var(--text-body); }
  .q10g .q10g-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q10g .q10g-n { font-size: 13px; font-weight: 700; }
  .q10g .q10g-s { font-size: 12px; fill: var(--text-muted); }
  .q10g-panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .q10g-chip { fill: var(--bg); stroke-width: 1.8; }
</style>
