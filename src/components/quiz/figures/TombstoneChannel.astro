---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for set 03: the channel #ops-bot as a strip of delete markers and one live message,
// a reader walking the strip, and a ten-day line with the cleanup two days ago.
// Inline SVG, site tokens only, no <marker>/<defs>. Shows the scenario's inputs only, never a read time.
const cells = Array.from({ length: 18 }, (_, i) => 14 + i * 21);
const liveX = 428;
const dayW = 55.2;
const x0 = 14;
---
<div class="qfig-tomb">
  <svg viewBox="0 0 580 358" role="img" aria-label="The channel ops-bot as a strip of many delete markers followed by one live message, with a ten-day timeline marking the cleanup two days ago.">
    <text x="0" y="22" class="qfig-tomb-h">
      <tspan data-lang-en>Channel #ops-bot, in message order</tspan>
      <tspan data-lang-vi>Kênh #ops-bot, theo thứ tự tin nhắn</tspan>
    </text>

    <DiagramIcon name="users" x="18" y="58" size="24" />
    <text x="46" y="63" class="qfig-tomb-m">
      <tspan data-lang-en>A user opens the channel: the read starts at the left.</tspan>
      <tspan data-lang-vi>Người dùng mở kênh: lệnh đọc bắt đầu từ bên trái.</tspan>
    </text>

    <rect x="0" y="86" width="580" height="60" rx="8" class="qfig-tomb-strip" />
    {cells.map((x) => <rect x={x} y="98" width="15" height="36" rx="3" class="qfig-tomb-dead" />)}
    <text x="397" y="122" class="qfig-tomb-dots">…</text>
    <rect x={liveX} y="98" width="138" height="36" rx="5" class="qfig-tomb-live" />
    <text x={liveX + 69} y="121" text-anchor="middle" class="qfig-tomb-lt">
      <tspan data-lang-en>1 live message</tspan>
      <tspan data-lang-vi>1 tin còn sống</tspan>
    </text>

    <text x="14" y="170" class="qfig-tomb-red">
      <tspan data-lang-en>3,000,000 delete markers (tombstones)</tspan>
      <tspan data-lang-vi>3.000.000 marker xoá (tombstone)</tspan>
    </text>

    <path d="M 14 200 L 553 200" class="qfig-tomb-walk" />
    <polygon points="566,200 552,193 552,207" class="qfig-tomb-walkhead" />
    <text x="14" y="224" class="qfig-tomb-m">
      <tspan data-lang-en>The read walks right, one entry at a time.</tspan>
      <tspan data-lang-vi>Lệnh đọc đi sang phải, từng mục một.</tspan>
    </text>

    <line x1="0" x2="580" y1="244" y2="244" class="qfig-tomb-rule" />
    <text x="0" y="266" class="qfig-tomb-h">
      <tspan data-lang-en>How long the delete records are kept</tspan>
      <tspan data-lang-vi>Bản ghi xoá được giữ bao lâu</tspan>
    </text>

    <rect x={x0} y="302" width={dayW * 10} height="12" rx="6" class="qfig-tomb-track" />
    <rect x={x0} y="302" width={dayW * 2} height="12" rx="6" class="qfig-tomb-elapsed" />
    <circle cx={x0 + dayW * 2} cy="308" r="8" class="qfig-tomb-now" />
    <text x={x0} y="292" class="qfig-tomb-m">
      <tspan data-lang-en>Cleanup job ran</tspan>
      <tspan data-lang-vi>Job dọn dẹp chạy</tspan>
    </text>
    <text x={x0 + dayW * 2} y="338" text-anchor="middle" class="qfig-tomb-t">
      <tspan data-lang-en>Now: day 2</tspan>
      <tspan data-lang-vi>Hiện tại: ngày 2</tspan>
    </text>
    <text x={x0 + dayW * 10} y="338" text-anchor="end" class="qfig-tomb-m">
      <tspan data-lang-en>Day 10: compaction may drop them</tspan>
      <tspan data-lang-vi>Ngày 10: compaction được bỏ chúng</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-tomb { margin: 0; width: 100%; }
  .qfig-tomb svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-tomb text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-tomb .qfig-tomb-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-tomb .qfig-tomb-t { font-weight: 700; fill: var(--text); }
  .qfig-tomb .qfig-tomb-m { fill: var(--text-muted); }
  .qfig-tomb .qfig-tomb-red { font-size: 15px; font-weight: 700; fill: var(--red); }
  .qfig-tomb .qfig-tomb-dots { font-size: 20px; font-weight: 700; fill: var(--red); }
  .qfig-tomb .qfig-tomb-lt { font-weight: 700; fill: var(--text); }
  .qfig-tomb-strip { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-tomb-dead { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .qfig-tomb-live { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.8; }
  .qfig-tomb-walk { stroke: var(--red); stroke-width: 2; fill: none; stroke-dasharray: 6 4; }
  .qfig-tomb-walkhead { fill: var(--red); }
  .qfig-tomb-rule { stroke: var(--border); }
  .qfig-tomb-track { fill: var(--border); }
  .qfig-tomb-elapsed { fill: var(--text-muted); }
  .qfig-tomb-now { fill: var(--bg); stroke: var(--text); stroke-width: 2; }
</style>
