---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for unbundling set 06: one $11.00 transfer over two connections. Lanes: phone, server, database.
// Connection 1 carries the request to COMMIT, then the reply is lost. Connection 2 resends the same transfer.
// It does not show any balance, total or fix. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const lanes = { phone: 92, server: 158, db: 224 };
const c1 = { x: 158, dot: 180, reply: 330 };
const c2 = { x: 372, dot: 394, reply: 544 };
const up = (x: number, y: number) => `${x},${y} ${x - 4.5},${y + 9} ${x + 4.5},${y + 9}`;
const down = (x: number, y: number) => `${x},${y} ${x - 4.5},${y - 9} ${x + 4.5},${y - 9}`;
const right = (x: number, y: number) => `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`;
---
<div class="qfig-lrr">
  <svg viewBox="0 0 580 300" role="img" aria-label="One transfer of 11.00 dollars sent over two connections: on connection 1 the request reaches the database and commits, but the reply is lost on the way back to the phone; the phone times out and sends the same transfer on connection 2.">
    <text x="0" y="22" class="qfig-lrr-h">
      <tspan data-lang-en>One transfer, two connections</tspan>
      <tspan data-lang-vi>Một lệnh chuyển tiền, hai kết nối</tspan>
    </text>

    {[c1, c2].map((c, i) => (
      <g>
        <rect x={c.x} y="36" width="200" height="226" rx="8" class="qfig-lrr-band" />
        <text x={c.x + 100} y="54" text-anchor="middle" class="qfig-lrr-m">
          <tspan data-lang-en>Connection {i + 1}</tspan>
          <tspan data-lang-vi>Kết nối {i + 1}</tspan>
        </text>
      </g>
    ))}

    {[
      { y: lanes.phone, icon: 'phone', en: 'Phone', vi: 'Điện thoại' },
      { y: lanes.server, icon: 'server', en: 'Server', vi: 'Server' },
      { y: lanes.db, icon: 'db', en: 'Database', vi: 'Database' },
    ].map((l) => (
      <g>
        <line x1="0" x2="580" y1={l.y} y2={l.y} class="qfig-lrr-rule" />
        <DiagramIcon name={l.icon as any} x="18" y={l.y} size={26} />
        <text x="42" y={l.y + 5} class="qfig-lrr-lane">
          <tspan data-lang-en>{l.en}</tspan>
          <tspan data-lang-vi>{l.vi}</tspan>
        </text>
      </g>
    ))}

    <!-- connection 1: request goes down -->
    <line x1={c1.dot} x2={c1.dot} y1={lanes.phone + 6} y2={lanes.db - 14} class="qfig-lrr-flow" />
    <polygon points={down(c1.dot, lanes.db - 6)} class="qfig-lrr-head" />
    <circle cx={c1.dot} cy={lanes.phone} r="6" class="qfig-lrr-dot" />
    <circle cx={c1.dot} cy={lanes.server} r="5" class="qfig-lrr-dot" />
    <circle cx={c1.dot} cy={lanes.db} r="6" class="qfig-lrr-dot" />
    <text x={c1.dot + 14} y={lanes.phone - 10} class="qfig-lrr-t">
      <tspan data-lang-en>Sends $11.00</tspan>
      <tspan data-lang-vi>Gửi $11,00</tspan>
    </text>
    <text x={c1.dot + 14} y={lanes.db + 22} class="qfig-lrr-t">
      <tspan data-lang-en>COMMIT done</tspan>
      <tspan data-lang-vi>COMMIT xong</tspan>
    </text>

    <!-- connection 1: reply goes up and is lost -->
    <line x1={c1.reply} x2={c1.reply} y1={lanes.db - 6} y2={lanes.server - 8} class="qfig-lrr-flow" />
    <polygon points={up(c1.reply, lanes.server - 16)} class="qfig-lrr-head" />
    <line x1={c1.reply} x2={c1.reply} y1={lanes.server - 18} y2={lanes.phone + 8} class="qfig-lrr-dash" />
    <DiagramIcon name="fail" x={c1.reply} y={124} size={22} />
    <text x={c1.reply - 21} y="128" text-anchor="end" class="qfig-lrr-bad">
      <tspan data-lang-en>Signal lost</tspan>
      <tspan data-lang-vi>Mất sóng</tspan>
    </text>
    <text x={c1.reply - 10} y={lanes.db - 14} text-anchor="end" class="qfig-lrr-m">
      <tspan data-lang-en>Reply 200 OK</tspan>
      <tspan data-lang-vi>Phản hồi 200 OK</tspan>
    </text>

    <!-- between: timeout and resend -->
    <line x1={c1.reply + 8} x2={c2.dot - 12} y1={lanes.phone} y2={lanes.phone} class="qfig-lrr-flow" />
    <polygon points={right(c2.dot - 8, lanes.phone)} class="qfig-lrr-head" />
    <text x={(c1.reply + c2.dot) / 2} y={lanes.phone - 10} text-anchor="middle" class="qfig-lrr-m">
      <tspan data-lang-en>Timeout</tspan>
      <tspan data-lang-vi>Timeout</tspan>
    </text>

    <!-- connection 2 -->
    <line x1={c2.dot} x2={c2.dot} y1={lanes.phone + 6} y2={lanes.db - 14} class="qfig-lrr-flow" />
    <polygon points={down(c2.dot, lanes.db - 6)} class="qfig-lrr-head" />
    <circle cx={c2.dot} cy={lanes.phone} r="6" class="qfig-lrr-dot" />
    <circle cx={c2.dot} cy={lanes.server} r="5" class="qfig-lrr-dot" />
    <circle cx={c2.dot} cy={lanes.db} r="6" class="qfig-lrr-dot" />
    <text x={c2.dot + 14} y={lanes.phone + 22} class="qfig-lrr-t">
      <tspan data-lang-en>Sends it again</tspan>
      <tspan data-lang-vi>Gửi lại lần nữa</tspan>
    </text>
    <text x={c2.dot + 14} y={lanes.db + 22} class="qfig-lrr-t">
      <tspan data-lang-en>Runs the transfer</tspan>
      <tspan data-lang-vi>Chạy lệnh chuyển tiền</tspan>
    </text>
    <line x1={c2.reply} x2={c2.reply} y1={lanes.db - 6} y2={lanes.phone + 16} class="qfig-lrr-flow" />
    <polygon points={up(c2.reply, lanes.phone + 8)} class="qfig-lrr-head" />
    <text x={c2.reply - 10} y={lanes.db - 14} text-anchor="end" class="qfig-lrr-m">
      <tspan data-lang-en>Reply 200 OK</tspan>
      <tspan data-lang-vi>Phản hồi 200 OK</tspan>
    </text>

    <text x="290" y="286" text-anchor="middle" class="qfig-lrr-m">
      <tspan data-lang-en>Move $11.00 from account 4321 to account 1234</tspan>
      <tspan data-lang-vi>Chuyển $11,00 từ tài khoản 4321 sang tài khoản 1234</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-lrr { margin: 0; width: 100%; }
  .qfig-lrr svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-lrr text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-lrr .qfig-lrr-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-lrr .qfig-lrr-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-lrr .qfig-lrr-t { font-weight: 600; fill: var(--text); }
  .qfig-lrr .qfig-lrr-m { fill: var(--text-muted); }
  .qfig-lrr .qfig-lrr-bad { font-weight: 700; fill: var(--red); }
  .qfig-lrr-band { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; stroke-dasharray: 5 4; }
  .qfig-lrr-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-lrr-dot { fill: var(--text); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-lrr-flow { stroke: var(--text-muted); stroke-width: 2; fill: none; }
  .qfig-lrr-head { fill: var(--text-muted); }
  .qfig-lrr-dash { stroke: var(--red); stroke-width: 2; stroke-dasharray: 4 4; fill: none; }
</style>
