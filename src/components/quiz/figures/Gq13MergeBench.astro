---
// Quiz figure for the Go concurrency quiz (post 13), set 07: the post's own benchmark of three merge sorts on
// 16,384 ints (Apple M2, Go 1.27.1). Bars show time per sort; allocations are printed beside each bar.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const X0 = 150, X1 = 430, MAX = 4.75;
const w = (ms: number) => ((X1 - X0) * ms) / MAX;
const rows = [
  { ms: 1.28, allocs: '4,095', en: 'Plain sequential', vi: 'Tuần tự thuần' },
  { ms: 4.75, allocs: '37,093', en: 'Split to 1 element', vi: 'Tách tới 1 phần tử' },
  { ms: 0.72, allocs: '4,109', en: 'Split above 2048', vi: 'Tách khi trên 2048' },
];
---
<div class="qfig-gq13mb">
  <svg viewBox="0 0 580 200" role="img" aria-label="Three merge sorts on 16,384 ints: plain sequential 1.28 ms and 4,095 allocations, split down to one element 4.75 ms and 37,093 allocations, split only above 2048 elements 0.72 ms and 4,109 allocations.">
    <text x="0" y="20" class="qfig-gq13mb-h">
      <tspan data-lang-en>Time per sort, 16,384 ints</tspan>
      <tspan data-lang-vi>Thời gian mỗi lần sort, 16.384 số</tspan>
    </text>
    {rows.map((r, i) => (
      <g>
        <text x="0" y={62 + i * 44} class="qfig-gq13mb-l">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <rect x={X0} y={46 + i * 44} width={w(r.ms)} height="24" rx="4" class="qfig-gq13mb-bar" />
        <text x={X0 + w(r.ms) + 8} y={63 + i * 44} class="qfig-gq13mb-v">{r.ms.toFixed(2)} ms</text>
      </g>
    ))}
    <text x="0" y="188" class="qfig-gq13mb-m">
      <tspan data-lang-en>Allocations per sort: 4,095 / 37,093 / 4,109 (same order as the bars)</tspan>
      <tspan data-lang-vi>Số lần cấp phát mỗi lần sort: 4.095 / 37.093 / 4.109 (cùng thứ tự các thanh)</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq13mb { margin: 0; width: 100%; }
  .qfig-gq13mb svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq13mb text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq13mb .qfig-gq13mb-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq13mb .qfig-gq13mb-v { font-weight: 700; fill: var(--text); }
  .qfig-gq13mb .qfig-gq13mb-m { fill: var(--text-muted); }
  .qfig-gq13mb-bar { fill: var(--bg-alt); stroke: var(--act-2); stroke-width: 1.5; }
</style>
