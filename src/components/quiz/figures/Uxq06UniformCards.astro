---
// Quiz figure for Post 6 (depth and shadows): a dashboard where every box carries the same shadow.
const FILT = [{ id: 'u06f-all', layers: [{ y: 10, b: 25, s: 0, o: 0.15 }] }];
---
<div class="qfig-uxq06uniformcards">
  <svg viewBox="0 0 600 320" role="img" aria-label="A dashboard mock: a sidebar, a filter bar, three KPI cards and a modal dialog. Every box has the same shadow, 0 10px 25px at 15 percent black, so all of them look like they float at the same height.">
    <defs>
      {FILT.map((d) => (
        <filter id={d.id} x="-20%" y="-20%" width="140%" height="160%" color-interpolation-filters="sRGB">
          {d.layers.map((l, k) => (
            <>
              <feGaussianBlur in="SourceAlpha" stdDeviation={l.b / 2} result={`b${k}`} />
              <feOffset in={`b${k}`} dx="0" dy={l.y} result={`o${k}`} />
              <feFlood style={`flood-color: var(--band-bg); flood-opacity: ${l.o}`} result={`f${k}`} />
              <feComposite in={`f${k}`} in2={`o${k}`} operator="in" result={`s${k}`} />
            </>
          ))}
          <feMerge>
            {d.layers.map((_, k) => <feMergeNode in={`s${k}`} />)}
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      ))}
    </defs>
    <rect x="8" y="8" width="584" height="304" rx="10" class="page" />

    <rect x="24" y="24" width="110" height="248" rx="8" class="box" filter="url(#u06f-all)" />
    <text x="38" y="50" class="h"><tspan data-lang-en>Sidebar</tspan><tspan data-lang-vi>Thanh bên</tspan></text>
    <line x1="38" y1="72" x2="110" y2="72" class="bar" />
    <line x1="38" y1="90" x2="96" y2="90" class="bar" />
    <line x1="38" y1="108" x2="104" y2="108" class="bar" />

    <rect x="152" y="24" width="424" height="40" rx="8" class="box" filter="url(#u06f-all)" />
    <text x="168" y="49" class="h"><tspan data-lang-en>Filter bar</tspan><tspan data-lang-vi>Thanh bộ lọc</tspan></text>

    <rect x="152" y="86" width="132" height="80" rx="8" class="box" filter="url(#u06f-all)" />
    <rect x="296" y="86" width="132" height="80" rx="8" class="box" filter="url(#u06f-all)" />
    <rect x="440" y="86" width="136" height="80" rx="8" class="box" filter="url(#u06f-all)" />
    <text x="166" y="112" class="m"><tspan data-lang-en>Revenue</tspan><tspan data-lang-vi>Doanh thu</tspan></text>
    <text x="310" y="112" class="m"><tspan data-lang-en>Orders</tspan><tspan data-lang-vi>Đơn hàng</tspan></text>
    <text x="454" y="112" class="m"><tspan data-lang-en>Refunds</tspan><tspan data-lang-vi>Hoàn tiền</tspan></text>
    <text x="166" y="146" class="n">128k</text>
    <text x="310" y="146" class="n">3,402</text>
    <text x="454" y="146" class="n">41</text>

    <rect x="260" y="150" width="270" height="124" rx="8" class="box" filter="url(#u06f-all)" />
    <text x="278" y="178" class="h"><tspan data-lang-en>Delete report?</tspan><tspan data-lang-vi>Xóa báo cáo?</tspan></text>
    <rect x="420" y="232" width="92" height="28" rx="6" class="btn" />
    <text x="466" y="251" text-anchor="middle" class="bt"><tspan data-lang-en>Delete</tspan><tspan data-lang-vi>Xóa</tspan></text>

    <text x="152" y="298" class="m">box-shadow: 0 10px 25px rgb(0 0 0 / 0.15)</text>
  </svg>
</div>

<style>
  .qfig-uxq06uniformcards { margin: 0; width: 100%; }
  .qfig-uxq06uniformcards svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq06uniformcards text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq06uniformcards .h { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-uxq06uniformcards .m { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-uxq06uniformcards .n { font-size: 20px; font-weight: 700; fill: var(--text); }
  .qfig-uxq06uniformcards .bt { fill: #fff; font-weight: 700; font-size: 13px; }
  .qfig-uxq06uniformcards .page { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq06uniformcards .box { fill: var(--card-bg); stroke: var(--border); stroke-width: 0.8; }
  .qfig-uxq06uniformcards .bar { stroke: var(--border); stroke-width: 5; stroke-linecap: round; }
  .qfig-uxq06uniformcards .btn { fill: var(--btn-primary-bg); }
</style>
