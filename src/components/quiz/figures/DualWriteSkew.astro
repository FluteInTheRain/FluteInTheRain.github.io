---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for stream-processing set 01: one checkout seen as a time axis (0 to 2 s) with three lanes:
// the service, PostgreSQL and Redis. Step 1 commits in PostgreSQL within a few ms; step 2 to Redis gets no reply
// until the 2 s timeout. It does not say what state Redis ends in. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const x0 = 170; // time 0
const px = 190; // pixels per second
const tx = (s: number) => x0 + s * px;
const lanes = { svc: 66, pg: 136, redis: 206 };
const axisY = 262;
const ticks = [0, 0.5, 1, 1.5, 2];
const sendX = tx(0.1);
const timeoutX = tx(2);
function head(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`;
}
---
<div class="qfig-dws">
  <svg viewBox="0 0 580 290" role="img" aria-label="A time axis from 0 to 2 seconds with three lanes: the service sends step 1, PostgreSQL commits the order within a few milliseconds, and the Redis lane shows a request with no reply until the 2 s timeout.">
    <text x="0" y="22" class="qfig-dws-h">
      <tspan data-lang-en>One checkout, two writes</tspan>
      <tspan data-lang-vi>Một lần checkout, hai lệnh ghi</tspan>
    </text>

    <line x1={timeoutX} x2={timeoutX} y1="40" y2={axisY} class="qfig-dws-limit" />

    {[
      { y: lanes.svc, icon: 'server', en: 'Service', vi: 'Service' },
      { y: lanes.pg, icon: 'postgres', en: 'PostgreSQL', vi: 'PostgreSQL' },
      { y: lanes.redis, icon: 'redis', en: 'Redis', vi: 'Redis' },
    ].map((l) => (
      <g>
        <line x1="0" x2="580" y1={l.y + 30} y2={l.y + 30} class="qfig-dws-rule" />
        <DiagramIcon name={l.icon as any} x={30} y={l.y} size={26} />
        <text x="56" y={l.y + 5} class="qfig-dws-lane">
          <tspan data-lang-en>{l.en}</tspan>
          <tspan data-lang-vi>{l.vi}</tspan>
        </text>
      </g>
    ))}

    <!-- service -->
    <circle cx={tx(0)} cy={lanes.svc} r="6" class="qfig-dws-dot" />
    <text x={tx(0) + 14} y={lanes.svc + 5} class="qfig-dws-t">
      <tspan data-lang-en>Sends step 1, then step 2</tspan>
      <tspan data-lang-vi>Gửi bước 1, rồi bước 2</tspan>
    </text>
    <circle cx={timeoutX} cy={lanes.svc} r="6" class="qfig-dws-dot2" />
    <text x={timeoutX - 12} y={lanes.svc + 21} text-anchor="end" class="qfig-dws-m">
      <tspan data-lang-en>Gives up waiting at 2 s</tspan>
      <tspan data-lang-vi>Hết chờ lúc 2 giây</tspan>
    </text>

    <!-- postgres -->
    <circle cx={tx(0.03)} cy={lanes.pg} r="6" class="qfig-dws-dot" />
    <text x={tx(0.03) + 14} y={lanes.pg + 5} class="qfig-dws-t">
      <tspan data-lang-en>Step 1: order committed in a few ms</tspan>
      <tspan data-lang-vi>Bước 1: đơn hàng commit sau vài ms</tspan>
    </text>

    <!-- redis -->
    <circle cx={sendX} cy={lanes.redis} r="6" class="qfig-dws-dot2" />
    <path d={`M ${sendX + 8} ${lanes.redis} L ${timeoutX - 24} ${lanes.redis}`} class="qfig-dws-wait" />
    <polygon points={head(timeoutX - 14, lanes.redis)} class="qfig-dws-waithead" />
    <text x={(sendX + timeoutX) / 2} y={lanes.redis - 12} text-anchor="middle" class="qfig-dws-t">
      <tspan data-lang-en>Step 2: set status, no reply</tspan>
      <tspan data-lang-vi>Bước 2: đặt trạng thái, không có phản hồi</tspan>
    </text>
    <line x1={timeoutX - 6} x2={timeoutX + 6} y1={lanes.redis - 6} y2={lanes.redis + 6} class="qfig-dws-x" />
    <line x1={timeoutX - 6} x2={timeoutX + 6} y1={lanes.redis + 6} y2={lanes.redis - 6} class="qfig-dws-x" />
    <text x={timeoutX - 12} y={lanes.redis + 22} text-anchor="end" class="qfig-dws-bad">
      <tspan data-lang-en>Timeout</tspan>
      <tspan data-lang-vi>Hết thời gian chờ</tspan>
    </text>

    <!-- axis -->
    <line x1={tx(0)} x2={tx(2)} y1={axisY} y2={axisY} class="qfig-dws-axis" />
    {ticks.map((s) => (
      <g>
        <line x1={tx(s)} x2={tx(s)} y1={axisY} y2={axisY + 5} class="qfig-dws-axis" />
        <text x={tx(s)} y={axisY + 21} text-anchor="middle" class="qfig-dws-m">{s}</text>
      </g>
    ))}
    <text x={tx(2) + 14} y={axisY + 21} class="qfig-dws-m">
      <tspan data-lang-en>s</tspan>
      <tspan data-lang-vi>giây</tspan>
    </text>
    <text x="0" y={axisY + 21} class="qfig-dws-m">
      <tspan data-lang-en>Time since the request</tspan>
      <tspan data-lang-vi>Thời gian từ request</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-dws { margin: 0; width: 100%; }
  .qfig-dws svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-dws text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-dws .qfig-dws-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-dws .qfig-dws-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-dws .qfig-dws-t { font-weight: 600; fill: var(--text); }
  .qfig-dws .qfig-dws-m { fill: var(--text-muted); }
  .qfig-dws .qfig-dws-bad { font-weight: 700; fill: var(--red); }
  .qfig-dws-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-dws-limit { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .qfig-dws-dot { fill: var(--gold); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-dws-dot2 { fill: var(--bg); stroke: var(--text); stroke-width: 2; }
  .qfig-dws-wait { stroke: var(--red); stroke-width: 2; stroke-dasharray: 6 4; fill: none; }
  .qfig-dws-waithead { fill: var(--red); }
  .qfig-dws-x { stroke: var(--red); stroke-width: 2.4; stroke-linecap: round; }
  .qfig-dws-axis { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
