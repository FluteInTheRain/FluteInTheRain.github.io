---
// Quiz figure for Post 8 (macro and industry).
---
<div class="qfig-sbq08bandruler">
  <svg viewBox="0 0 580 166" role="img" aria-label="USD/VND ruler: new band 22,455 to 24,819, old band 22,928 to 24,346, central rate 23,637, Vietcombank quote 24,495.">
<line x1="20" y1="100" x2="560" y2="100" class="ln" />
<line x1="61.5" y1="96" x2="61.5" y2="106" class="ln" />
<text x="61.5" y="122" class="m" text-anchor="middle">22,500</text>
<line x1="165.4" y1="96" x2="165.4" y2="106" class="ln" />
<text x="165.4" y="122" class="m" text-anchor="middle">23,000</text>
<line x1="269.2" y1="96" x2="269.2" y2="106" class="ln" />
<text x="269.2" y="122" class="m" text-anchor="middle">23,500</text>
<line x1="373.1" y1="96" x2="373.1" y2="106" class="ln" />
<text x="373.1" y="122" class="m" text-anchor="middle">24,000</text>
<line x1="476.9" y1="96" x2="476.9" y2="106" class="ln" />
<text x="476.9" y="122" class="m" text-anchor="middle">24,500</text>
<rect x="52.2" y="50" width="491.0" height="9" rx="3" class="barg" />
<text x="52.2" y="30" class="b"><tspan data-lang-en>New ±5%: 22,455 to 24,819</tspan><tspan data-lang-vi>Mới ±5%: 22.455 đến 24.819</tspan></text>
<rect x="150.4" y="68" width="294.5" height="9" rx="3" class="barm" />
<text x="305.7" y="90" class="m"><tspan data-lang-en>Old ±3%: 22,928 to 24,346</tspan><tspan data-lang-vi>Cũ ±3%: 22.928 đến 24.346</tspan></text>
<line x1="297.7" y1="36" x2="297.7" y2="100" class="lng" />
<line x1="475.9" y1="128" x2="475.9" y2="138" class="lnr" />
<text x="475.9" y="154" class="red" text-anchor="middle"><tspan data-lang-en>Vietcombank 24,495</tspan><tspan data-lang-vi>Vietcombank 24.495</tspan></text>
<text x="303.7" y="44" class="h"><tspan data-lang-en>Central rate 23,637</tspan><tspan data-lang-vi>Tỷ giá trung tâm 23.637</tspan></text>
  </svg>
</div>

<style>
  .qfig-sbq08bandruler { margin: 0; width: 100%; }
  .qfig-sbq08bandruler svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-sbq08bandruler text { font-size: 12.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-sbq08bandruler .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-sbq08bandruler .b { font-size: 12.5px; }
  .qfig-sbq08bandruler .m { fill: var(--text-muted); font-size: 11.5px; }
  .qfig-sbq08bandruler .red { fill: var(--red); font-weight: 700; }
  .qfig-sbq08bandruler .grn { fill: var(--act-2); font-weight: 700; }
  .qfig-sbq08bandruler .ln { stroke: var(--text-muted); stroke-width: 1.6; fill: none; }
  .qfig-sbq08bandruler .lng { stroke: var(--gold); stroke-width: 2.2; fill: none; }
  .qfig-sbq08bandruler .lnr { stroke: var(--red); stroke-width: 2.2; fill: none; }
  .qfig-sbq08bandruler .barr { fill: var(--red); }
  .qfig-sbq08bandruler .barg { fill: var(--act-2); }
  .qfig-sbq08bandruler .barm { fill: var(--text-muted); }
  .qfig-sbq08bandruler .bard { fill: var(--gold); }
  .qfig-sbq08bandruler .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-sbq08bandruler .cardr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .qfig-sbq08bandruler .cardk { fill: var(--bg-alt); stroke: var(--act-2); stroke-width: 1.4; }
</style>
