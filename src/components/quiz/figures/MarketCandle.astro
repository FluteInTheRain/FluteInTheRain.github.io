---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 05: one day folded into a candle. Illustrative day for the 24,500 stock:
// open 24,500 (first match), low 24,400 at 10:05, high 24,700 at 13:40, close 24,600.
const W = 580;
const H = 470;
// price 24,400..24,750 mapped to y 330..70
const py = (p: number) => 330 - ((p - 24400) / 350) * 260;
const pts: Array<[number, number, string?, string?]> = [
  [40, py(24500), 'open 24,500 · first match', 'mở 24.500 · lần khớp đầu'],
  [110, py(24450)],
  [175, py(24400), 'low 24,400 · 10:05', 'đáy 24.400 · 10:05'],
  [250, py(24480)],
  [320, py(24590)],
  [395, py(24700), 'high 24,700 · 13:40', 'đỉnh 24.700 · 13:40'],
  [460, py(24600)],
  [540, py(24600), 'close 24,600 · last match', 'đóng 24.600 · lần khớp cuối'],
];
const path = pts.map(([x, y], i) => `${i === 0 ? 'M' : 'L'} ${x} ${y}`).join(' ');
const candleX = 476;
const bodyTop = py(24600);
const bodyBottom = py(24500);
const lowY = py(24400);
const highY = py(24700);
---
<div class="qca">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <DiagramIcon name="chart" x={18} y={16} size={22} />
    <text x="40" y="21" class="qca-h">
      <tspan data-lang-en>Tens of thousands of matches, folded into one bar</tspan>
      <tspan data-lang-vi>Hàng chục nghìn lần khớp, gói thành một thanh</tspan>
    </text>

    <line x1="20" x2="560" y1="352" y2="352" class="qca-axis" />
    <path d={path} class="qca-path" />
    {pts.filter((p) => p[2]).map(([x, y, label, labelVi]) => (
      <g>
        <circle cx={x} cy={y} r="4" class="qca-dot" />
        <text
          x={x < 100 ? x + 8 : x}
          y={y - 10}
          text-anchor={x < 100 ? 'start' : x > 420 ? 'end' : 'middle'}
          class="qca-mark"
        >
          <tspan data-lang-en>{label}</tspan>
          <tspan data-lang-vi>{labelVi}</tspan>
        </text>
      </g>
    ))}
    <text x="290" y="376" text-anchor="middle" class="qca-tick">
      <tspan data-lang-en>the trading day, match by match</tspan>
      <tspan data-lang-vi>phiên giao dịch, từng lần khớp</tspan>
    </text>

    <g class="qca-arrow">
      <path d="M 300 398 L 300 416" />
      <polygon points="300,424 295,414 305,414" />
    </g>
    <text x="316" y="416" class="qca-note">
      <tspan data-lang-en>the app keeps four numbers and a volume</tspan>
      <tspan data-lang-vi>app giữ lại bốn con số và một khối lượng</tspan>
    </text>

    <g class="qca-candle">
      <line x1={candleX} x2={candleX} y1={highY} y2={lowY} />
      <rect x={candleX - 16} y={bodyTop} width="32" height={bodyBottom - bodyTop} rx="2" />
      <text x={candleX - 28} y={highY + 4} text-anchor="end" class="qca-ohlc">H 24,700</text>
      <text x={candleX - 28} y={bodyTop + 12} text-anchor="end" class="qca-ohlc">C 24,600</text>
      <text x={candleX - 28} y={bodyBottom + 4} text-anchor="end" class="qca-ohlc">O 24,500</text>
      <text x={candleX - 28} y={lowY + 4} text-anchor="end" class="qca-ohlc">L 24,400</text>
    </g>
    <rect x="20" y="430" width="150" height="18" rx="3" class="qca-vol" />
    <text x="180" y="444" class="qca-tick">
      <tspan data-lang-en>volume: 1,200,000 shares — counted once per trade</tspan>
      <tspan data-lang-vi>khối lượng: 1.200.000 cp — mỗi giao dịch đếm một lần</tspan>
    </text>
  </svg>
</div>

<style>
  .qca {
    margin: 0;
    width: 100%;
  }
  .qca svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qca text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qca .qca-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qca .qca-axis {
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .qca .qca-path {
    fill: none;
    stroke: var(--text);
    stroke-width: 2;
  }
  .qca .qca-dot {
    fill: var(--act-0);
  }
  .qca .qca-mark {
    font-size: 12px;
    font-weight: 600;
    fill: var(--text);
  }
  .qca .qca-tick {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qca .qca-note {
    font-size: 13px;
    fill: var(--text-body);
  }
  .qca .qca-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .qca .qca-arrow polygon {
    fill: var(--text-muted);
  }
  .qca .qca-candle line {
    stroke: var(--text);
    stroke-width: 2;
  }
  .qca .qca-candle rect {
    fill: var(--act-2);
    stroke: var(--text);
    stroke-width: 1.2;
  }
  .qca .qca-ohlc {
    font-size: 12px;
    font-weight: 700;
    fill: var(--text);
  }
  .qca .qca-vol {
    fill: var(--gold);
    opacity: 0.5;
  }
</style>
