---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 04: an assumed claims screener with no human review and no appeal.
// Shows the population split and the model's flag rates, never the flagged counts or any precision figure.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 384;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const barX = 10;
const barW = 560;
const fraudW = barW * 0.01;
const a1 = arrow(145, 198, 215, 232);
const a2 = arrow(435, 198, 365, 232);
const a3 = arrow(290, 274, 290, 296);
---
<div class="fh">
  <div>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A claims screener sorts 100,000 claims, flags 90% of the fraudulent ones and 5% of the honest ones, and every flag becomes a fraud decision with no human review and no appeal.">
      <text x="10" y="26" class="fh-h">
        <tspan data-lang-en>100,000 claims go through the screener</tspan>
        <tspan data-lang-vi>100.000 hồ sơ đi qua bộ lọc</tspan>
      </text>

      <rect x={barX} y="46" width={barW} height="26" rx="4" class="fh-honest" />
      <rect x={barX} y="46" width={fraudW} height="26" class="fh-fraud" />
      <path d={`M ${barX + 3} 74 L ${barX + 3} 90`} class="fh-lead" />
      <text x={barX} y="108" class="fh-red">
        <tspan data-lang-en>1,000 truly fraudulent (1%)</tspan>
        <tspan data-lang-vi>1.000 hồ sơ gian lận thật (1%)</tspan>
      </text>
      <text x={barX + barW} y="108" text-anchor="end" class="fh-sub">
        <tspan data-lang-en>99,000 honest claims</tspan>
        <tspan data-lang-vi>99.000 hồ sơ trung thực</tspan>
      </text>

      <g class="fh-box">
        <rect x="10" y="130" width="270" height="68" rx="8" />
        <rect x="300" y="130" width="270" height="68" rx="8" />
      </g>
      <DiagramIcon name="server" x={30} y={152} size={20} />
      <text x="48" y="157" class="fh-name">
        <tspan data-lang-en>Model on fraud</tspan>
        <tspan data-lang-vi>Mô hình, hồ sơ gian lận</tspan>
      </text>
      <text x="22" y="184" class="fh-num">
        <tspan data-lang-en>flags 90% of them</tspan>
        <tspan data-lang-vi>gắn cờ 90% số đó</tspan>
      </text>
      <DiagramIcon name="server" x={320} y={152} size={20} />
      <text x="338" y="157" class="fh-name">
        <tspan data-lang-en>Model on honest claims</tspan>
        <tspan data-lang-vi>Mô hình, hồ sơ trung thực</tspan>
      </text>
      <text x="312" y="184" class="fh-num">
        <tspan data-lang-en>flags 5% of them</tspan>
        <tspan data-lang-vi>gắn cờ 5% số đó</tspan>
      </text>

      <g class="fh-arrow"><path d={a1.line} /><polygon points={a1.head} /></g>
      <g class="fh-arrow"><path d={a2.line} /><polygon points={a2.head} /></g>

      <g class="fh-box">
        <rect x="140" y="232" width="300" height="42" rx="8" />
      </g>
      <DiagramIcon name="warning" x={166} y={253} size={20} />
      <text x="184" y="258" class="fh-name">
        <tspan data-lang-en>Flagged claims</tspan>
        <tspan data-lang-vi>Hồ sơ bị gắn cờ</tspan>
      </text>

      <g class="fh-arrow"><path d={a3.line} /><polygon points={a3.head} /></g>

      <g class="fh-bad">
        <rect x="10" y="296" width="560" height="76" rx="8" />
      </g>
      <DiagramIcon name="fail" x={34} y={322} size={22} />
      <text x="56" y="328" class="fh-red">
        <tspan data-lang-en>Payment stopped, fraud notice sent</tspan>
        <tspan data-lang-vi>Dừng chi trả, gửi thông báo gian lận</tspan>
      </text>
      <text x="26" y="358" class="fh-red">
        <tspan data-lang-en>No human review. No appeal path.</tspan>
        <tspan data-lang-vi>Không ai rà soát. Không có đường khiếu nại.</tspan>
      </text>
    </svg>
  </div>
</div>

<style>
  .fh { width: 100%; }
  .fh svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .fh text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .fh .fh-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .fh .fh-name { font-weight: 700; fill: var(--text); }
  .fh .fh-sub, .fh .fh-num { fill: var(--text-muted); }
  .fh .fh-red { font-weight: 700; fill: var(--red); }
  .fh-honest { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .fh-fraud { fill: var(--red); }
  .fh-lead { fill: none; stroke: var(--red); stroke-width: 1.3; }
  .fh-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .fh-bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .fh-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .fh-arrow polygon { fill: var(--text-muted); }
</style>
