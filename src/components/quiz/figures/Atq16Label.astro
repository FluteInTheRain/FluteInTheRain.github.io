---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 08: how a threshold alpha turns a mid-price path into three labels. The path is hand-drawn, no data.
const pts = [[40, 130], [90, 122], [140, 134], [190, 118], [240, 108], [290, 82], [340, 66], [390, 74], [440, 60], [490, 52]];
const d = 'M ' + pts.map((p) => p.join(' ')).join(' L ');
---
<div class="q16">
  <svg viewBox="0 0 580 270" role="img" aria-hidden="true">
    <DiagramIcon name="signal" x={22} y={20} size={22} />
    <text x="44" y="25" class="t-h"><tspan data-lang-en>From a mid-price path to a label</tspan><tspan data-lang-vi>Từ đường giá giữa đến một nhãn</tspan></text>
    <rect x="40" y="40" width="500" height="64" class="bid" />
    <rect x="40" y="104" width="500" height="52" class="mid" />
    <rect x="40" y="156" width="500" height="64" class="ask" />
    <line x1="40" x2="540" y1="104" y2="104" class="midline" />
    <line x1="40" x2="540" y1="156" y2="156" class="midline" />
    <path d={d} class="path" />
    <circle cx="40" cy="130" r="4" class="dot" />
    <text x="534" y="98" class="t-gold" text-anchor="end">+α</text>
    <text x="534" y="174" class="t-gold" text-anchor="end">−α</text>
    <text x="48" y="60" class="t-b"><tspan data-lang-en>up</tspan><tspan data-lang-vi>tăng</tspan></text>
    <text x="400" y="136" class="t-b"><tspan data-lang-en>stationary</tspan><tspan data-lang-vi>đứng yên</tspan></text>
    <text x="48" y="212" class="t-b"><tspan data-lang-en>down</tspan><tspan data-lang-vi>giảm</tspan></text>
    <text x="40" y="250" class="t-s"><tspan data-lang-en>Label: the mid-price a few steps ahead, relative to the start. The path is a sketch.</tspan><tspan data-lang-vi>Nhãn: giá giữa vài bước phía trước so với lúc đầu. Đường vẽ chỉ là phác hoạ.</tspan></text>
  </svg>
</div>

<style>
  .q16 { margin: 0; width: 100%; }
  .q16 svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .q16 text { font-size: 13px; fill: var(--text-body); }
  .q16 .t-h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .q16 .t-s { font-size: 12px; fill: var(--text-muted); }
  .q16 .t-b { font-size: 13px; font-weight: 600; fill: var(--text); }
  .q16 .t-gold { font-weight: 700; fill: var(--gold-icon); }
  .q16 .ask { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; }
  .q16 .bid { fill: color-mix(in srgb, var(--act-2) 16%, var(--bg)); stroke: var(--act-2); stroke-width: 1.3; }
  .q16 .mid { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.3; }
  .q16 .empty { fill: none; stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .q16 .midline { stroke: var(--gold); stroke-width: 1.6; stroke-dasharray: 6 4; fill: none; }
  .q16 .axis { stroke: var(--border); stroke-width: 1.4; }
  .q16 .grid { stroke: var(--border); stroke-width: 1; stroke-dasharray: 3 4; }
  .q16 .dot { fill: var(--text); }
  .q16 .path { stroke: var(--text); stroke-width: 2; fill: none; }
</style>
