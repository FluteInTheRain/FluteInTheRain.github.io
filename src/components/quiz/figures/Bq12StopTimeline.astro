---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 04 (post 12): one request (0 to 3 s), the stop signal at 1 s, the grace period ending at 5 s.
// Axis to scale, 0 to 6 s. Shows the situation only. Plain inline SVG, site tokens only, no markers/defs.
const x0 = 176;
const pxPerS = 64;
const xAt = (s: number) => x0 + s * pxPerS;
const yReq = 108;
const yAxis = 226;
---
<div class="bq12st">
  <svg viewBox="0 0 580 270" role="img" aria-hidden="true">
    <DiagramIcon name="laptop" x={26} y={yReq + 14} size={24} />
    <text x="50" y={yReq + 10} class="st-lane">
      <tspan data-lang-en>One request</tspan>
      <tspan data-lang-vi>Một request</tspan>
    </text>
    <text x="50" y={yReq + 28} class="st-note">
      <tspan data-lang-en>needs 3 s</tspan>
      <tspan data-lang-vi>cần 3 s</tspan>
    </text>
    <rect x={xAt(0)} y={yReq} width={xAt(3) - xAt(0)} height="28" rx="4" class="st-bar" />
    <text x={xAt(1) + 10} y={yReq + 19} class="st-in">
      <tspan data-lang-en>request running</tspan>
      <tspan data-lang-vi>request đang chạy</tspan>
    </text>

    <line x1={xAt(1)} x2={xAt(1)} y1="52" y2={yAxis} class="st-sig" />
    <text x={xAt(1) + 6} y="50" class="st-strong">
      <tspan data-lang-en>1 s: stop signal (SIGTERM)</tspan>
      <tspan data-lang-vi>giây 1: tín hiệu dừng (SIGTERM)</tspan>
    </text>

    <line x1={xAt(5)} x2={xAt(5)} y1="52" y2={yAxis} class="st-kill" />
    <text x={xAt(5) - 8} y="168" text-anchor="end" class="st-red">
      <tspan data-lang-en>5 s: grace ends,</tspan>
      <tspan data-lang-vi>giây 5: hết ân hạn,</tspan>
    </text>
    <text x={xAt(5) - 8} y="186" text-anchor="end" class="st-red">
      <tspan data-lang-en>SIGKILL</tspan>
      <tspan data-lang-vi>SIGKILL</tspan>
    </text>

    <line x1={xAt(0)} x2={xAt(6)} y1={yAxis} y2={yAxis} class="st-axis" />
    <g class="st-tick">
      {[0, 1, 2, 3, 4, 5, 6].map((s) => <line x1={xAt(s)} x2={xAt(s)} y1={yAxis - 5} y2={yAxis + 5} />)}
    </g>
    {[0, 1, 2, 3, 4, 5, 6].map((s) => <text x={xAt(s)} y={yAxis + 22} text-anchor="middle" class="st-num">{s} s</text>)}
  </svg>
</div>

<style>
  .bq12st { margin: 0; width: 100%; }
  .bq12st svg { display: block; width: 100%; min-width: 360px; height: auto; }
  .bq12st text { font-size: 13px; fill: var(--text-body); }
  .bq12st .st-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .bq12st .st-note { fill: var(--text-muted); }
  .bq12st .st-strong { font-weight: 700; fill: var(--text); }
  .bq12st .st-red { font-weight: 700; fill: var(--red); }
  .bq12st .st-in { font-weight: 600; fill: var(--text); }
  .bq12st .st-num { font-variant-numeric: tabular-nums; fill: var(--text-muted); }
  .bq12st .st-bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; }
  .bq12st .st-sig { stroke: var(--gold); stroke-width: 2.5; }
  .bq12st .st-kill { stroke: var(--red); stroke-width: 2.5; stroke-dasharray: 5 4; }
  .bq12st .st-axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .bq12st .st-tick line { stroke: var(--text-muted); stroke-width: 1.5; }
</style>
