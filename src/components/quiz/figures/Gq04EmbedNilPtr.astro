---
// Quiz figure for go-structs-methods-interfaces set 04: memory of Service{Port: 8080} with an embedded *Logger.
// It shows the field contents; it does not say what happens when Log runs.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
---
<div class="qfig-gq04en">
  <svg viewBox="0 0 580 230" role="img" aria-label="A Service value built with Port 8080. Its first field is the embedded *Logger, holding nothing. Its second field Port holds 8080. A separate Logger struct with a Prefix string field is drawn apart, with no link from the Service.">
    <text x="0" y="20" class="qfig-gq04en-h">
      <tspan data-lang-en>s := Service&#123;Port: 8080&#125;</tspan>
      <tspan data-lang-vi>s := Service&#123;Port: 8080&#125;</tspan>
    </text>

    <text x="20" y="58" class="qfig-gq04en-t">Service</text>
    <rect x="20" y="68" width="280" height="90" rx="6" class="qfig-gq04en-cell" />
    <line x1="20" x2="300" y1="113" y2="113" class="qfig-gq04en-sep" />
    <text x="34" y="96" class="qfig-gq04en-c">*Logger</text>
    <text x="170" y="96" class="qfig-gq04en-c">nil</text>
    <rect x="160" y="80" width="130" height="24" rx="4" class="qfig-gq04en-hot" />
    <text x="34" y="141" class="qfig-gq04en-c">Port</text>
    <text x="170" y="141" class="qfig-gq04en-c">8080</text>

    <text x="350" y="58" class="qfig-gq04en-t">
      <tspan data-lang-en>Logger (not linked to s)</tspan>
      <tspan data-lang-vi>Logger (không nối với s)</tspan>
    </text>
    <rect x="350" y="68" width="210" height="45" rx="6" class="qfig-gq04en-cell qfig-gq04en-dash" />
    <text x="364" y="96" class="qfig-gq04en-c">Prefix  string</text>

    <rect x="20" y="180" width="540" height="36" rx="8" class="qfig-gq04en-card" />
    <text x="36" y="203" class="qfig-gq04en-b">
      <tspan data-lang-en>Log has a value receiver: func (l Logger) Log(msg string)</tspan>
      <tspan data-lang-vi>Log có value receiver: func (l Logger) Log(msg string)</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq04en { margin: 0; width: 100%; }
  .qfig-gq04en svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq04en text { font-size: 13px; fill: var(--text-body); }
  .qfig-gq04en .qfig-gq04en-h { font-size: 16px; font-weight: 700; font-family: 'JetBrains Mono', ui-monospace, monospace; fill: var(--text); }
  .qfig-gq04en .qfig-gq04en-t { font-weight: 700; fill: var(--text); }
  .qfig-gq04en .qfig-gq04en-c { font-family: 'JetBrains Mono', ui-monospace, monospace; fill: var(--text); }
  .qfig-gq04en .qfig-gq04en-b { fill: var(--text-body); }
  .qfig-gq04en-cell { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-gq04en-dash { stroke-dasharray: 5 4; }
  .qfig-gq04en-hot { fill: none; stroke: var(--act-3); stroke-width: 2; }
  .qfig-gq04en-sep { stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-gq04en-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
</style>
