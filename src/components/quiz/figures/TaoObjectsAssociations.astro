---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 06: a photo app's data as objects (nodes) and associations (edges), and the path of a request:
// app servers -> cache -> sharded MySQL. Shows the setup only; it gives no computed result and no answer.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids, so the EN and VI copies cannot clash.

const W = 580;
const H = 340;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const nodes = [
  { x: 14, y: 50, w: 120, name: 'Ana', en: 'user', vi: 'người dùng' },
  { x: 230, y: 50, w: 120, name: 'Photo 7', en: 'photo', vi: 'ảnh' },
  { x: 446, y: 50, w: 120, name: 'Ben', en: 'user', vi: 'người dùng' },
  { x: 230, y: 130, w: 120, name: 'Comment 3', en: 'comment', vi: 'bình luận' },
];
const nh = 44;
const a1 = arrow(134, 74, 230, 74); // Ana -> photo
const a2 = arrow(446, 74, 350, 74); // Ben -> photo
const a3 = arrow(290, 94, 290, 130); // photo -> comment
---
<div class="tao">
  <div>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A photo app stores users, photos and comments as objects joined by typed edges. Requests go from app servers to a cache, and cache misses and writes go to MySQL split into shards.">
      <text x="10" y="26" class="tao-h">
        <tspan data-lang-en>Objects and associations</tspan>
        <tspan data-lang-vi>Object và association</tspan>
      </text>

      {nodes.map((n) => (
        <g class="tao-node">
          <rect x={n.x} y={n.y} width={n.w} height={nh} rx="8" />
          <text x={n.x + n.w / 2} y={n.y + 19} text-anchor="middle" class="tao-name">{n.name}</text>
          <text x={n.x + n.w / 2} y={n.y + 36} text-anchor="middle" class="tao-sub">
            <tspan data-lang-en>{n.en}</tspan>
            <tspan data-lang-vi>{n.vi}</tspan>
          </text>
        </g>
      ))}

      <g class="tao-arrow"><path d={a1.line} /><polygon points={a1.head} /></g>
      <g class="tao-arrow"><path d={a2.line} /><polygon points={a2.head} /></g>
      <g class="tao-arrow"><path d={a3.line} /><polygon points={a3.head} /></g>
      <text x="182" y="66" text-anchor="middle" class="tao-edge">
        <tspan data-lang-en>posted</tspan>
        <tspan data-lang-vi>đã đăng</tspan>
      </text>
      <text x="398" y="66" text-anchor="middle" class="tao-edge">
        <tspan data-lang-en>likes</tspan>
        <tspan data-lang-vi>thích</tspan>
      </text>
      <text x="300" y="116" class="tao-edge">
        <tspan data-lang-en>has comment</tspan>
        <tspan data-lang-vi>có bình luận</tspan>
      </text>
      <text x="14" y="124" class="tao-note">
        <tspan data-lang-en>Box = object (a node).</tspan>
        <tspan data-lang-vi>Hộp = object (một đỉnh).</tspan>
      </text>
      <text x="14" y="144" class="tao-note">
        <tspan data-lang-en>Arrow = association (an edge).</tspan>
        <tspan data-lang-vi>Mũi tên = association (một cạnh).</tspan>
      </text>

      <line x1="10" x2={W - 10} y1="196" y2="196" class="tao-rule" />
      <text x="10" y="222" class="tao-h2">
        <tspan data-lang-en>Where a request goes: 50,000 per second at peak, 99% reads</tspan>
        <tspan data-lang-vi>Request đi đâu: 50.000 mỗi giây lúc cao điểm, 99% là đọc</tspan>
      </text>

      <DiagramIcon name="server" x={40} y={276} size={30} />
      <text x="40" y="312" text-anchor="middle" class="tao-sub">
        <tspan data-lang-en>App servers</tspan>
        <tspan data-lang-vi>App server</tspan>
      </text>
      {(() => { const a = arrow(66, 276, 122, 276); return <g class="tao-arrow"><path d={a.line} /><polygon points={a.head} /></g>; })()}

      <g class="tao-cache">
        <rect x="124" y="244" width="104" height="64" rx="8" />
        <text x="176" y="270" text-anchor="middle" class="tao-name">
          <tspan data-lang-en>Cache</tspan>
          <tspan data-lang-vi>Cache</tspan>
        </text>
        <text x="176" y="290" text-anchor="middle" class="tao-sub">
          <tspan data-lang-en>96% of reads</tspan>
          <tspan data-lang-vi>96% lần đọc</tspan>
        </text>
      </g>
      {(() => { const a = arrow(228, 276, 346, 276); return <g class="tao-arrow"><path d={a.line} /><polygon points={a.head} /></g>; })()}
      <text x="287" y="268" text-anchor="middle" class="tao-edge">
        <tspan data-lang-en>misses, writes</tspan>
        <tspan data-lang-vi>miss, ghi</tspan>
      </text>

      <g class="tao-box">
        <rect x="346" y="236" width="224" height="88" rx="8" />
        <text x="458" y="257" text-anchor="middle" class="tao-name">
          <tspan data-lang-en>MySQL, sharded by id</tspan>
          <tspan data-lang-vi>MySQL, shard theo id</tspan>
        </text>
        <DiagramIcon name="mysql" x={400} y={284} size={26} />
        <DiagramIcon name="mysql" x={516} y={284} size={26} />
        <text x="400" y="314" text-anchor="middle" class="tao-sub">Shard 1</text>
        <text x="516" y="314" text-anchor="middle" class="tao-sub">Shard 2</text>
      </g>
    </svg>
  </div>
</div>

<style>
  .tao { width: 100%; }
  .tao svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .tao text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .tao .tao-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .tao .tao-h2 { font-size: 14px; font-weight: 700; fill: var(--text); }
  .tao .tao-name { font-weight: 700; fill: var(--text); }
  .tao .tao-sub { font-size: 13px; fill: var(--text-muted); }
  .tao .tao-edge { font-size: 13px; fill: var(--text-body); }
  .tao .tao-note { font-size: 13px; fill: var(--text-muted); }
  .tao-node rect, .tao-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .tao-cache rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .tao-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .tao-arrow polygon { fill: var(--text-muted); }
  .tao-rule { stroke: var(--border); stroke-width: 1.2; }
</style>
