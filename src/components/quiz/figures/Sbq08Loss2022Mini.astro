---
// Quiz figure for Post 8 (macro and industry).
---
<div class="qfig-sbq08loss2022mini">
  <svg viewBox="0 0 580 160" role="img" aria-label="Bars of 2022 price falls: NVL 84 percent, PDR 81, VGS 72, TPB 49, VN-Index 32.78.">
<text x="16" y="30" class="b">NVL</text>
<rect x="90" y="14" width="352.8" height="20" rx="3" class="barr" />
<text x="450.8" y="29" class="h">-84%</text>
<text x="16" y="58" class="b">PDR</text>
<rect x="90" y="42" width="340.2" height="20" rx="3" class="barr" />
<text x="438.2" y="57" class="h">-81%</text>
<text x="16" y="86" class="b">VGS</text>
<rect x="90" y="70" width="302.4" height="20" rx="3" class="barr" />
<text x="400.40000000000003" y="85" class="h">-72%</text>
<text x="16" y="114" class="b">TPB</text>
<rect x="90" y="98" width="205.8" height="20" rx="3" class="barr" />
<text x="303.8" y="113" class="h">-49%</text>
<text x="16" y="142" class="b">VN-Index</text>
<rect x="90" y="126" width="137.7" height="20" rx="3" class="bard" />
<text x="235.67600000000002" y="141" class="h">-32.78%</text>
  </svg>
</div>

<style>
  .qfig-sbq08loss2022mini { margin: 0; width: 100%; }
  .qfig-sbq08loss2022mini svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-sbq08loss2022mini text { font-size: 12.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-sbq08loss2022mini .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-sbq08loss2022mini .b { font-size: 12.5px; }
  .qfig-sbq08loss2022mini .m { fill: var(--text-muted); font-size: 11.5px; }
  .qfig-sbq08loss2022mini .red { fill: var(--red); font-weight: 700; }
  .qfig-sbq08loss2022mini .grn { fill: var(--act-2); font-weight: 700; }
  .qfig-sbq08loss2022mini .ln { stroke: var(--text-muted); stroke-width: 1.6; fill: none; }
  .qfig-sbq08loss2022mini .lng { stroke: var(--gold); stroke-width: 2.2; fill: none; }
  .qfig-sbq08loss2022mini .lnr { stroke: var(--red); stroke-width: 2.2; fill: none; }
  .qfig-sbq08loss2022mini .barr { fill: var(--red); }
  .qfig-sbq08loss2022mini .barg { fill: var(--act-2); }
  .qfig-sbq08loss2022mini .barm { fill: var(--text-muted); }
  .qfig-sbq08loss2022mini .bard { fill: var(--gold); }
  .qfig-sbq08loss2022mini .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-sbq08loss2022mini .cardr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .qfig-sbq08loss2022mini .cardk { fill: var(--bg-alt); stroke: var(--act-2); stroke-width: 1.4; }
</style>
