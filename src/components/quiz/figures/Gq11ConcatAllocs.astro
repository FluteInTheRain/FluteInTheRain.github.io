---
// Quiz figure for go-memory-data-types-slices-maps-strings: allocs/op measured with testing.AllocsPerRun for joining 500 strings of 8 bytes.
// Two rows measured, one row left open for the question. Neutral labels. Inline SVG, site tokens only.
const rows = [
  { y: 62, en: 'string += part, 500 times', vi: 'string += part, 500 lần', v: 499 },
  { y: 118, en: 'strings.Builder with sb.Grow(4000)', vi: 'strings.Builder có sb.Grow(4000)', v: 1 },
];
const scale = 0.9;
---
<div class="qfig-g11c">
  <svg viewBox="0 0 580 236" role="img" aria-label="Allocations per run when joining 500 strings of 8 bytes: string += part gives 499, strings.Builder with Grow(4000) gives 1, strings.Builder without Grow is left as a question mark.">
    <text x="0" y="22" class="qfig-g11c-h">
      <tspan data-lang-en>Allocations per run, 500 parts of 8 bytes</tspan>
      <tspan data-lang-vi>Số lần cấp phát mỗi lần chạy, 500 phần 8 byte</tspan>
    </text>
    {rows.map((r) => (
      <g>
        <text x="0" y={r.y - 8} class="qfig-g11c-m">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <rect x="0" y={r.y} width="520" height="24" rx="4" class="qfig-g11c-track" />
        <rect x="0" y={r.y} width={Math.max(3, r.v * scale)} height="24" rx="4" class="qfig-g11c-bar" />
        <text x={Math.max(3, r.v * scale) + 8} y={r.y + 17} class="qfig-g11c-t">{r.v}</text>
      </g>
    ))}
    <text x="0" y="166" class="qfig-g11c-m">
      <tspan data-lang-en>strings.Builder without Grow, same 500 parts</tspan>
      <tspan data-lang-vi>strings.Builder không có Grow, cùng 500 phần</tspan>
    </text>
    <rect x="0" y="174" width="520" height="24" rx="4" class="qfig-g11c-open" />
    <text x="10" y="191" class="qfig-g11c-t">?</text>
  </svg>
</div>
<style>
  .qfig-g11c { margin: 0; width: 100%; }
  .qfig-g11c svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-g11c text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-g11c .qfig-g11c-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-g11c .qfig-g11c-t { font-weight: 700; fill: var(--text); }
  .qfig-g11c .qfig-g11c-m { fill: var(--text-muted); font-size: 13px; }
  .qfig-g11c-track { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-g11c-bar { fill: var(--gold); }
  .qfig-g11c-open { fill: none; stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 6 5; }
</style>
