---
// Quiz figure for the color post, Uxq05: two five-stop yellow ladders, 100 / 300 / 500 / 700 / 900.
---
<div class="qfig-uxq05yellowladders">
  <svg viewBox="0 0 600 220" role="img" aria-label="Two yellow shade ladders with five stops each. Ladder A keeps hue 48 and only lowers lightness; ladder B also changes saturation and hue. The dark stops of ladder A look olive brown, those of ladder B look amber to dark brown.">
<text x="90" y="22" class="m">100</text><text x="190" y="22" class="m">300</text><text x="290" y="22" class="m">500</text><text x="390" y="22" class="m">700</text><text x="490" y="22" class="m">900</text>
<text x="20" y="68" class="h"><tspan data-lang-en>A</tspan><tspan data-lang-vi>A</tspan></text>
<rect x="90" y="32" width="98" height="52" fill="#FDF8E3" /><rect x="190" y="32" width="98" height="52" fill="#F5DD80" /><rect x="290" y="32" width="98" height="52" fill="#EDC31D" /><rect x="390" y="32" width="98" height="52" fill="#A0830D" /><rect x="490" y="32" width="98" height="52" fill="#554507" />
<text x="20" y="152" class="h"><tspan data-lang-en>B</tspan><tspan data-lang-vi>B</tspan></text>
<rect x="90" y="116" width="98" height="52" fill="#FFFBD6" /><rect x="190" y="116" width="98" height="52" fill="#FBE56A" /><rect x="290" y="116" width="98" height="52" fill="#EDC31D" /><rect x="390" y="116" width="98" height="52" fill="#AE6C09" /><rect x="490" y="116" width="98" height="52" fill="#632D03" />
<text x="300" y="204" class="m" text-anchor="middle"><tspan data-lang-en>Same 500 stop in both rows</tspan><tspan data-lang-vi>Bậc 500 giống nhau ở cả hai hàng</tspan></text>
  </svg>
</div>

<style>
  .qfig-uxq05yellowladders { margin: 0; width: 100%; }
  .qfig-uxq05yellowladders svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq05yellowladders text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq05yellowladders .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-uxq05yellowladders .m { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-uxq05yellowladders .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq05yellowladders .w { fill: #FFFFFF; font-weight: 700; font-size: 15px; }
</style>
