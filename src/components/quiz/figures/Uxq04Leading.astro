---
// Quiz figure for the typography post: one 28px headline at two line-heights.
---
<div class="qfig-uxq04leading">
  <svg viewBox="0 0 600 250" role="img" aria-label="The same three-line headline at 28 pixels. Headline P has line-height 1.75, headline Q has 1.15.">
    <text x="20" y="22" class="h"><tspan data-lang-en>Headline P: line-height 1.75</tspan><tspan data-lang-vi>Tiêu đề P: line-height 1.75</tspan></text>
    <rect x="20" y="32" width="262" height="196" rx="8" class="card" />
    <text x="36" y="72" style="font-size:28px;font-weight:700" class="t">Revenue grew</text>
    <text x="36" y="121" style="font-size:28px;font-weight:700" class="t">faster than</text>
    <text x="36" y="170" style="font-size:28px;font-weight:700" class="t">costs this year</text>
    <text x="318" y="22" class="h"><tspan data-lang-en>Headline Q: line-height 1.15</tspan><tspan data-lang-vi>Tiêu đề Q: line-height 1.15</tspan></text>
    <rect x="318" y="32" width="262" height="196" rx="8" class="card" />
    <text x="334" y="72" style="font-size:28px;font-weight:700" class="t">Revenue grew</text>
    <text x="334" y="104" style="font-size:28px;font-weight:700" class="t">faster than</text>
    <text x="334" y="136" style="font-size:28px;font-weight:700" class="t">costs this year</text>
  </svg>
</div>

<style>
  .qfig-uxq04leading { margin: 0; width: 100%; }
  .qfig-uxq04leading svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq04leading text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq04leading .h { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qfig-uxq04leading .m { fill: var(--text-muted); font-size: 12px; }
  .qfig-uxq04leading .t { fill: var(--text); }
  .qfig-uxq04leading .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq04leading .ln { stroke: var(--text-muted); stroke-width: 1; stroke-dasharray: 4 3; fill: none; }
  .qfig-uxq04leading .lna { stroke: var(--act-3); stroke-width: 1.2; fill: none; }
  .qfig-uxq04leading .tag { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
</style>
