---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for replication set 02: one primary with two replicas, a bad DELETE on the primary,
// and the backup schedule on a day timeline. Shows only the scenario's inputs, never what the replicas hold afterwards.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 7 * Math.cos(a)} ${y2 - 7 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const a1 = arrow(250, 112, 150, 186);
const a2 = arrow(330, 112, 430, 186);
const hx = (h: number) => 30 + h * 24;
const backups = [0, 6, 12, 18];
---
<div class="qfig-nab">
  <svg viewBox="0 0 580 432" role="img" aria-label="A primary database with two replicas, a DELETE on the primary at 17:40, and backups taken every six hours on a day timeline.">
    <text x="0" y="22" class="qfig-nab-h">
      <tspan data-lang-en>Parcelo orders database</tspan>
      <tspan data-lang-vi>Database đơn hàng của Parcelo</tspan>
    </text>

    <g class="qfig-nab-node">
      <rect x="200" y="40" width="180" height="72" rx="10" />
      <DiagramIcon name="postgres" x="232" y="76" size={34} />
      <text x="260" y="72" class="qfig-nab-t">
        <tspan data-lang-en>Primary</tspan>
        <tspan data-lang-vi>Primary</tspan>
      </text>
      <text x="260" y="92">
        <tspan data-lang-en>takes all writes</tspan>
        <tspan data-lang-vi>nhận lệnh ghi</tspan>
      </text>
    </g>

    <g class="qfig-nab-go"><path d={a1.line} /><polygon points={a1.head} /></g>
    <g class="qfig-nab-go"><path d={a2.line} /><polygon points={a2.head} /></g>
    <text x="150" y="140" text-anchor="end" class="qfig-nab-m">
      <tspan data-lang-en>async copy of the log</tspan>
      <tspan data-lang-vi>chép log bất đồng bộ</tspan>
    </text>
    <text x="430" y="140" class="qfig-nab-m">
      <tspan data-lang-en>async copy of the log</tspan>
      <tspan data-lang-vi>chép log bất đồng bộ</tspan>
    </text>

    {[20, 360].map((x, i) => (
      <g class="qfig-nab-node">
        <rect x={x} y="190" width="200" height="72" rx="10" />
        <DiagramIcon name="postgres" x={x + 30} y="226" size={32} />
        <text x={x + 58} y="222" class="qfig-nab-t">
          <tspan data-lang-en>Replica {i + 1}</tspan>
          <tspan data-lang-vi>Replica {i + 1}</tspan>
        </text>
        <text x={x + 58} y="242">
          <tspan data-lang-en>another zone</tspan>
          <tspan data-lang-vi>ở zone khác</tspan>
        </text>
      </g>
    ))}

    <g class="qfig-nab-bad">
      <rect x="404" y="40" width="176" height="72" rx="10" />
      <text x="416" y="64" class="qfig-nab-bt">
        <tspan data-lang-en>17:40 on the primary</tspan>
        <tspan data-lang-vi>17:40 trên primary</tspan>
      </text>
      <text x="416" y="86">
        <tspan data-lang-en>DELETE FROM orders;</tspan>
        <tspan data-lang-vi>DELETE FROM orders;</tspan>
      </text>
      <text x="416" y="104" class="qfig-nab-bm">
        <tspan data-lang-en>no WHERE clause</tspan>
        <tspan data-lang-vi>không có WHERE</tspan>
      </text>
    </g>

    <line x1="0" x2="580" y1="290" y2="290" class="qfig-nab-rule" />
    <text x="0" y="316" class="qfig-nab-h">
      <tspan data-lang-en>Backups: a full copy every 6 hours</tspan>
      <tspan data-lang-vi>Backup: một bản đầy đủ mỗi 6 giờ</tspan>
    </text>
    <DiagramIcon name="s3" x="548" y="308" size={28} />

    <line x1="30" x2="510" y1="360" y2="360" class="qfig-nab-axis" />
    {backups.map((h) => (
      <g>
        <rect x={hx(h) - 7} y="353" width="14" height="14" rx="3" class="qfig-nab-snap" />
        <text x={hx(h)} y="392" text-anchor="middle">
          {String(h).padStart(2, '0')}:00
        </text>
      </g>
    ))}
    <g class="qfig-nab-mark">
      <line x1={hx(17 + 40 / 60)} x2={hx(17 + 40 / 60)} y1="338" y2="360" />
      <polygon points={`${hx(17 + 40 / 60) - 6},338 ${hx(17 + 40 / 60) + 6},338 ${hx(17 + 40 / 60)},350`} />
      <text x={hx(17 + 40 / 60) - 10} y="334" text-anchor="end">
        <tspan data-lang-en>17:40 DELETE</tspan>
        <tspan data-lang-vi>17:40 DELETE</tspan>
      </text>
    </g>
    <text x="0" y="426" class="qfig-nab-m">
      <tspan data-lang-en>Squares: backup runs, stored in object storage.</tspan>
      <tspan data-lang-vi>Ô vuông: các lần backup, lưu trong object storage.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-nab { margin: 0; width: 100%; }
  .qfig-nab svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-nab text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-nab .qfig-nab-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-nab .qfig-nab-t { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-nab .qfig-nab-m { fill: var(--text-muted); }
  .qfig-nab-node rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-nab-go path { stroke: var(--gold); stroke-width: 1.8; fill: none; }
  .qfig-nab-go polygon { fill: var(--gold); }
  .qfig-nab-bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-nab .qfig-nab-bt { font-weight: 700; fill: var(--red); }
  .qfig-nab .qfig-nab-bm { fill: var(--text-muted); }
  .qfig-nab-rule { stroke: var(--border); }
  .qfig-nab-axis { stroke: var(--border); stroke-width: 2; }
  .qfig-nab-snap { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-nab-mark line { stroke: var(--red); stroke-width: 2; }
  .qfig-nab-mark polygon { fill: var(--red); }
  .qfig-nab .qfig-nab-mark text { fill: var(--red); font-weight: 700; }
</style>
