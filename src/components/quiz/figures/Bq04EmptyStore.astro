---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-layered-architecture set 05: two requests to the same running server, seconds apart.
// The first creates case C-1 and answers 201; the second asks to close C-1 and answers 404. Shows the symptom only.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
function head(x: number, y: number) { return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`; }
---
<div class="qfig-ems">
  <svg viewBox="0 0 580 250" role="img" aria-label="Two requests to the same server process, a few seconds apart: POST /cases answers 201 with case C-1, then POST /cases/C-1/close answers 404 with the text no case C-1.">
    <text x="0" y="22" class="qfig-ems-h">
      <tspan data-lang-en>Same server, two requests, five seconds apart</tspan>
      <tspan data-lang-vi>Cùng một server, hai request, cách nhau năm giây</tspan>
    </text>

    <rect x="0" y="40" width="580" height="46" rx="8" class="qfig-ems-box" />
    <DiagramIcon name="server" x={26} y={63} size={24} />
    <text x="52" y="68" class="qfig-ems-m">
      <tspan data-lang-en>One uvicorn process, never restarted between the two requests</tspan>
      <tspan data-lang-vi>Một process uvicorn, không khởi động lại giữa hai request</tspan>
    </text>

    <rect x="0" y="108" width="270" height="110" rx="10" class="qfig-ems-box" />
    <text x="14" y="134" class="qfig-ems-m">
      <tspan data-lang-en>Request 1, at 10:00:00</tspan>
      <tspan data-lang-vi>Request 1, lúc 10:00:00</tspan>
    </text>
    <text x="14" y="158" class="qfig-ems-t">POST /cases</text>
    <line x1="14" x2="256" y1="172" y2="172" class="qfig-ems-rule" />
    <text x="14" y="198" class="qfig-ems-ok">201 Created</text>
    <text x="110" y="198" class="qfig-ems-t">case_id: C-1</text>

    <line x1="274" x2="302" y1="163" y2="163" class="qfig-ems-arrow" />
    <polygon points={head(308, 163)} class="qfig-ems-head" />

    <rect x="310" y="108" width="270" height="110" rx="10" class="qfig-ems-box" />
    <text x="324" y="134" class="qfig-ems-m">
      <tspan data-lang-en>Request 2, at 10:00:05</tspan>
      <tspan data-lang-vi>Request 2, lúc 10:00:05</tspan>
    </text>
    <text x="324" y="158" class="qfig-ems-t">POST /cases/C-1/close</text>
    <line x1="324" x2="566" y1="172" y2="172" class="qfig-ems-rule" />
    <text x="324" y="198" class="qfig-ems-bad">404 Not Found</text>
    <text x="440" y="198" class="qfig-ems-t">no case C-1</text>
  </svg>
</div>

<style>
  .qfig-ems { margin: 0; width: 100%; }
  .qfig-ems svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-ems text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-ems .qfig-ems-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-ems .qfig-ems-t { font-weight: 700; fill: var(--text); }
  .qfig-ems .qfig-ems-m { fill: var(--text-muted); font-size: 13px; }
  .qfig-ems .qfig-ems-bad { font-weight: 700; fill: var(--red); }
  .qfig-ems .qfig-ems-ok { font-weight: 700; fill: var(--text); }
  .qfig-ems-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-ems-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-ems-arrow { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-ems-head { fill: var(--text-muted); }
</style>
