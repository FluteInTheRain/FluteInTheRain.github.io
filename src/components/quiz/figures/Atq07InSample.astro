---
// Quiz figure for ai-trading-portfolio set 03: weights fitted and Sharpe measured on exactly the same ten years.
// The 2.1 is the AI report's claim in the question, not a measured number.
const x0 = 30, w = 520, y0 = 2015, y1 = 2024;
const px = (y: number) => x0 + ((y - y0) / (y1 - y0 + 1)) * w;
---
<div class="qfig-q07a">
  <svg viewBox="0 0 580 190" role="img" aria-label="A timeline from 2015 to 2024. A gold bar labelled weights fitted here and a red bar labelled Sharpe 2.1 measured here both cover all of 2015 to 2024.">
    <text x="0" y="20" class="h"><tspan data-lang-en>One history picks the weights and scores them</tspan><tspan data-lang-vi>Một lịch sử vừa chọn trọng số vừa chấm điểm</tspan></text>
    {[2015, 2017, 2019, 2021, 2023].map((y) => (
      <g><line x1={px(y)} x2={px(y)} y1="30" y2="150" class="grid" /><text x={px(y)} y="170" text-anchor="middle" class="m">{y}</text></g>
    ))}
    <rect x={px(2015)} y="52" width={px(2025) - px(2015)} height="30" rx="4" class="gold" />
    <text x={px(2015)} y="46" class="lab"><tspan data-lang-en>weights fitted here</tspan><tspan data-lang-vi>trọng số khớp ở đây</tspan></text>
    <rect x={px(2015)} y="100" width={px(2025) - px(2015)} height="30" rx="4" class="redf" />
    <text x={px(2015)} y="94" class="lab"><tspan data-lang-en>Sharpe 2.1 measured here</tspan><tspan data-lang-vi>Sharpe 2,1 đo ở đây</tspan></text>
  </svg>
</div>

<style>
  .qfig-q07a { margin: 0; width: 100%; }
  .qfig-q07a svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .qfig-q07a text { font-size: 13px; fill: var(--text-body); }
  .qfig-q07a .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-q07a .m { font-size: 12px; fill: var(--text-muted); }
  .qfig-q07a .lab { font-weight: 600; fill: var(--text); }
  .qfig-q07a .num { font-weight: 700; fill: var(--text); }
  .qfig-q07a .num.red { fill: var(--red); }
  .qfig-q07a .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-q07a .gold { fill: var(--gold); }
  .qfig-q07a .grey { fill: var(--text-muted); opacity: 0.55; }
  .qfig-q07a .redf { fill: var(--red); }
  .qfig-q07a .grid { stroke: var(--border); stroke-width: 1; }
</style>
