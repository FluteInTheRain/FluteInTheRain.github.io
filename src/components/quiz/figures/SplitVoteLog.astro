---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for consensus set 07: 5-node Raft cluster in Term 3.
// Shows N1 and N2 holding [T2@1, T2@2] while N3..N5 hold committed [T2@1, T2@2, T3@3],
// and N5 sitting behind an intermittent link. Does not reveal election or Pre-Vote rules.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.

const rowY = [78, 132, 186, 240, 294];
const colX = [200, 290, 380];
const slotW = 82;
const slotH = 34;

const nodes = [
  {
    id: 'N1',
    enState: 'Follower · lagging',
    viState: 'Follower · tụt log',
    leader: false,
    flaky: false,
    hasT3: false,
    tail: '(2, 2)',
  },
  {
    id: 'N2',
    enState: 'Follower · lagging',
    viState: 'Follower · tụt log',
    leader: false,
    flaky: false,
    hasT3: false,
    tail: '(2, 2)',
  },
  {
    id: 'N3',
    enState: 'Leader · Term 3',
    viState: 'Leader · Kỳ 3',
    leader: true,
    flaky: false,
    hasT3: true,
    tail: '(3, 3)',
  },
  {
    id: 'N4',
    enState: 'Follower · synced',
    viState: 'Follower · đồng bộ',
    leader: false,
    flaky: false,
    hasT3: true,
    tail: '(3, 3)',
  },
  {
    id: 'N5',
    enState: 'Flaky link · timeouts',
    viState: 'Mạng chập chờn',
    leader: false,
    flaky: true,
    hasT3: true,
    tail: '(3, 3)',
  },
];
---
<div class="qfig-svl">
  <svg viewBox="0 0 580 396" role="img" aria-label="A 5-node Raft cluster in Term 3 with majority quorum 3. N1 and N2 hold entries T2@1 and T2@2 with tail (2, 2). Leader N3, follower N4, and flaky-link follower N5 hold T2@1, T2@2, and committed T3@3 with tail (3, 3).">
    <text x="0" y="22" class="qfig-svl-h">
      <tspan data-lang-en>5-node Raft cluster in Term 3 (quorum = 3)</tspan>
      <tspan data-lang-vi>Cụm Raft 5 node ở kỳ 3 (quorum = 3)</tspan>
    </text>
    <text x="0" y="43" class="qfig-svl-m">
      <tspan data-lang-en>Log entries shown as [Term@Index]</tspan>
      <tspan data-lang-vi>Mục log viết dạng [Kỳ@Chỉ_số]</tspan>
    </text>

    {/* Column headers */}
    <text x="0" y="66" class="qfig-svl-col">
      <tspan data-lang-en>Node &amp; state</tspan>
      <tspan data-lang-vi>Node &amp; trạng thái</tspan>
    </text>
    <text x={colX[0] + slotW / 2} y="66" text-anchor="middle" class="qfig-svl-col">
      <tspan data-lang-en>Index 1</tspan>
      <tspan data-lang-vi>Mục 1</tspan>
    </text>
    <text x={colX[1] + slotW / 2} y="66" text-anchor="middle" class="qfig-svl-col">
      <tspan data-lang-en>Index 2</tspan>
      <tspan data-lang-vi>Mục 2</tspan>
    </text>
    <text x={colX[2] + slotW / 2} y="66" text-anchor="middle" class="qfig-svl-col">
      <tspan data-lang-en>Index 3</tspan>
      <tspan data-lang-vi>Mục 3</tspan>
    </text>
    <text x="526" y="66" text-anchor="middle" class="qfig-svl-col">
      <tspan data-lang-en>(term, idx)</tspan>
      <tspan data-lang-vi>(kỳ, idx)</tspan>
    </text>

    {nodes.map((n, i) => {
      const y = rowY[i];
      const boxCls = n.leader
        ? 'qfig-svl-node is-leader'
        : n.flaky
          ? 'qfig-svl-node is-flaky'
          : 'qfig-svl-node';
      return (
        <g>
          <rect x="0" y={y} width="188" height="46" rx="6" class={boxCls} />
          <DiagramIcon name="server" x={20} y={y + 23} size={20} />
          <text x="38" y={y + 19} class="qfig-svl-name">{n.id}</text>
          <text x="38" y={y + 37} class={n.flaky ? 'qfig-svl-sub is-red' : 'qfig-svl-sub'}>
            <tspan data-lang-en>{n.enState}</tspan>
            <tspan data-lang-vi>{n.viState}</tspan>
          </text>
          {n.flaky && <DiagramIcon name="warning" x={172} y={y + 14} size={15} />}

          {/* Index 1 */}
          <rect x={colX[0]} y={y + 6} width={slotW} height={slotH} rx="5" class="qfig-svl-slot" />
          <text x={colX[0] + slotW / 2} y={y + 28} text-anchor="middle" class="qfig-svl-t">T2@1</text>

          {/* Index 2 */}
          <rect x={colX[1]} y={y + 6} width={slotW} height={slotH} rx="5" class="qfig-svl-slot" />
          <text x={colX[1] + slotW / 2} y={y + 28} text-anchor="middle" class="qfig-svl-t">T2@2</text>

          {/* Index 3 */}
          {n.hasT3 ? (
            <g>
              <rect x={colX[2]} y={y + 6} width={slotW} height={slotH} rx="5" class="qfig-svl-slot is-commit" />
              <text x={colX[2] + slotW / 2} y={y + 28} text-anchor="middle" class="qfig-svl-t">T3@3</text>
            </g>
          ) : (
            <g>
              <rect x={colX[2]} y={y + 6} width={slotW} height={slotH} rx="5" class="qfig-svl-slot is-miss" />
              <text x={colX[2] + slotW / 2} y={y + 28} text-anchor="middle" class="qfig-svl-m">
                <tspan data-lang-en>missing</tspan>
                <tspan data-lang-vi>thiếu</tspan>
              </text>
            </g>
          )}

          {/* Tail tuple */}
          <text x="526" y={y + 28} text-anchor="middle" class={n.hasT3 ? 'qfig-svl-tail is-hi' : 'qfig-svl-tail'}>
            {n.tail}
          </text>
        </g>
      );
    })}

    <line x1="0" x2="580" y1="350" y2="350" class="qfig-svl-rule" />
    <text x="0" y="370" class="qfig-svl-m">
      <tspan data-lang-en>[T3@3] is committed on 3 of 5 nodes (N3, N4, N5).</tspan>
      <tspan data-lang-vi>[T3@3] đã chốt trên 3/5 node (N3, N4, N5).</tspan>
    </text>
    <text x="0" y="390" class="qfig-svl-m">
      <tspan data-lang-en>N5 drops heartbeats intermittently and triggers repeated timeouts.</tspan>
      <tspan data-lang-vi>N5 rớt heartbeat chập chờn và liên tục hết giờ chờ bầu cử.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-svl { margin: 0; width: 100%; }
  .qfig-svl svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-svl text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-svl .qfig-svl-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-svl .qfig-svl-col { font-size: 12.5px; font-weight: 600; fill: var(--text-muted); }
  .qfig-svl .qfig-svl-name { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-svl .qfig-svl-sub { font-size: 12px; fill: var(--text-muted); }
  .qfig-svl .qfig-svl-sub.is-red { fill: var(--red); font-weight: 600; }
  .qfig-svl .qfig-svl-t { font-weight: 600; fill: var(--text); }
  .qfig-svl .qfig-svl-m { fill: var(--text-muted); }
  .qfig-svl .qfig-svl-tail { font-weight: 600; fill: var(--text-muted); }
  .qfig-svl .qfig-svl-tail.is-hi { fill: var(--text); font-weight: 700; }
  .qfig-svl-node { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-svl-node.is-leader { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-svl-node.is-flaky { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .qfig-svl-slot { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-svl-slot.is-commit { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .qfig-svl-slot.is-miss { fill: var(--bg); stroke: var(--border); stroke-dasharray: 4 3; }
  .qfig-svl-rule { stroke: var(--border); stroke-width: 1; }
</style>
