---
// Quiz figure for go-production set 07: one 100 ms CFS period with six busy threads, all running from 0 to 33 ms.
// It draws what the question states and no cause. Inline SVG, site tokens only.
const X0 = 96, X1 = 556;
const px = (ms: number) => X0 + (ms * (X1 - X0)) / 100;
const lanes = [1, 2, 3, 4, 5, 6];
const Y0 = 78, STEP = 24;
const axisY = Y0 + lanes.length * STEP + 8;
---
<div class="qfig-gq14cfs">
  <svg viewBox="0 0 580 270" role="img" aria-label="One 100 millisecond period with six thread lanes. Each thread runs from 0 to 33 milliseconds and all six lanes are empty after that.">
    <text x="0" y="20" class="qfig-gq14cfs-h">
      <tspan data-lang-en>One 100 ms period, six busy threads</tspan>
      <tspan data-lang-vi>Một chu kỳ 100 ms, sáu thread đang bận</tspan>
    </text>
    <text x="0" y="42" class="qfig-gq14cfs-m">cpu.max: 200000 100000 · GOMAXPROCS 6</text>

    {lanes.map((n, i) => (
      <g>
        <text x="0" y={Y0 + i * STEP + 13} class="qfig-gq14cfs-l">
          <tspan data-lang-en>thread {n}</tspan>
          <tspan data-lang-vi>thread {n}</tspan>
        </text>
        <rect x={px(0)} y={Y0 + i * STEP} width={px(33) - px(0)} height="18" rx="3" class="qfig-gq14cfs-run" />
        <rect x={px(33)} y={Y0 + i * STEP} width={px(100) - px(33)} height="18" rx="3" class="qfig-gq14cfs-idle" />
      </g>
    ))}

    <line x1={px(33)} x2={px(33)} y1={Y0 - 12} y2={axisY} class="qfig-gq14cfs-mark" />
    <line x1={X0} x2={X1} y1={axisY} y2={axisY} class="qfig-gq14cfs-axis" />
    <text x={px(0)} y={axisY + 20} text-anchor="middle" class="qfig-gq14cfs-m">0 ms</text>
    <text x={px(33)} y={axisY + 20} text-anchor="middle" class="qfig-gq14cfs-t">33 ms</text>
    <text x={px(100)} y={axisY + 20} text-anchor="end" class="qfig-gq14cfs-m">100 ms</text>
    <text x={px(33) + 8} y={Y0 - 16} class="qfig-gq14cfs-t">
      <tspan data-lang-en>all six stop running</tspan>
      <tspan data-lang-vi>cả sáu thread ngừng chạy</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq14cfs { margin: 0; width: 100%; }
  .qfig-gq14cfs svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq14cfs text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq14cfs .qfig-gq14cfs-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq14cfs .qfig-gq14cfs-t { font-weight: 700; fill: var(--text); }
  .qfig-gq14cfs .qfig-gq14cfs-m { fill: var(--text-muted); }
  .qfig-gq14cfs .qfig-gq14cfs-l { fill: var(--text-body); }
  .qfig-gq14cfs-run { fill: var(--act-3); opacity: 0.85; }
  .qfig-gq14cfs-idle { fill: none; stroke: var(--border); stroke-width: 1; stroke-dasharray: 4 3; }
  .qfig-gq14cfs-axis { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-gq14cfs-mark { stroke: var(--text); stroke-width: 1.5; stroke-dasharray: 5 3; }
</style>
