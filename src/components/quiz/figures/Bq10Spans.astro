---
// Quiz figure for backend-observability set 07: one trace as a waterfall. Each row is a span of one request that
// crossed two services; the bar starts when the span started and is as long as the span lasted.
// It shows the spans only, not which one is the problem. Inline SVG, site tokens only, no ids.
const rows = [
  { name: 'POST /cases/{case_id}/assign', svc: 0, depth: 0, at: 0, ms: 450 },
  { name: 'SELECT', svc: 0, depth: 1, at: 2, ms: 4 },
  { name: 'UPDATE', svc: 0, depth: 1, at: 8, ms: 6 },
  { name: 'POST', svc: 0, depth: 1, at: 20, ms: 410 },
  { name: 'POST /notify', svc: 1, depth: 2, at: 24, ms: 400 },
  { name: 'send_email', svc: 1, depth: 3, at: 30, ms: 380 },
];
const x0 = 262;
const px = 0.55; // pixels per ms
const y0 = 62;
const gap = 30;
const tx = (ms: number) => x0 + ms * px;
const ticks = [0, 150, 300, 450];
---
<div class="qfig-bq10sp">
  <svg viewBox="0 0 580 290" role="img" aria-label="A waterfall of six spans of one request across two services: a 450 ms root span in clue-api with two short SQL spans and a long outgoing call, and inside that call a 400 ms span in notify-svc containing a 380 ms send_email span.">
    <text x="0" y="22" class="qfig-bq10sp-h">
      <tspan data-lang-en>One trace, six spans</tspan>
      <tspan data-lang-vi>Một trace, sáu span</tspan>
    </text>
    <rect x="262" y="12" width="12" height="12" rx="2" class="qfig-bq10sp-a" />
    <text x="280" y="23" class="qfig-bq10sp-m">clue-api</text>
    <rect x="360" y="12" width="12" height="12" rx="2" class="qfig-bq10sp-b" />
    <text x="378" y="23" class="qfig-bq10sp-m">notify-svc</text>
    {rows.map((r, i) => {
      const y = y0 + i * gap;
      const w = Math.max(3, r.ms * px);
      return (
        <g>
          <line x1="0" x2="580" y1={y + 16} y2={y + 16} class="qfig-bq10sp-rule" />
          <text x={r.depth * 12} y={y + 5} class="qfig-bq10sp-t">{r.name}</text>
          <rect x={tx(r.at)} y={y - 9} width={w} height="16" rx="3" class={r.svc === 0 ? 'qfig-bq10sp-a' : 'qfig-bq10sp-b'} />
          <text x={tx(r.at) + w + 6} y={y + 5} class="qfig-bq10sp-m">{r.ms} ms</text>
        </g>
      );
    })}
    <line x1={x0} x2={tx(450)} y1="256" y2="256" class="qfig-bq10sp-axis" />
    {ticks.map((t) => (
      <g>
        <line x1={tx(t)} x2={tx(t)} y1="256" y2="261" class="qfig-bq10sp-axis" />
        <text x={tx(t)} y="278" text-anchor="middle" class="qfig-bq10sp-m">{t}</text>
      </g>
    ))}
    <text x="0" y="278" class="qfig-bq10sp-m">
      <tspan data-lang-en>Time since the root span started (ms)</tspan>
      <tspan data-lang-vi>Thời gian từ lúc span gốc bắt đầu (ms)</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-bq10sp { margin: 0; width: 100%; }
  .qfig-bq10sp svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-bq10sp text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bq10sp .qfig-bq10sp-h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-bq10sp .qfig-bq10sp-t { fill: var(--text); font-weight: 600; }
  .qfig-bq10sp .qfig-bq10sp-m { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-bq10sp-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-bq10sp-axis { stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-bq10sp-a { fill: var(--gold); }
  .qfig-bq10sp-b { fill: var(--act-2); }
</style>
