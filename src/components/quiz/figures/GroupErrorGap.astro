---
// Quiz figure for ethics set 02: two groups of 500 people, each as a 2x2 table of counts
// (flagged higher risk / labeled lower risk, against reoffended / did not reoffend).
// It shows counts only, never rates or accuracy. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const groups = [
  { x: 0, en: 'Group A: 500 people', vi: 'Nhóm A: 500 người', c: [120, 60, 80, 240] },
  { x: 312, en: 'Group B: 500 people', vi: 'Nhóm B: 500 người', c: [160, 100, 40, 200] },
];
// c = [flagged+reoffended, flagged+not reoffended, lower+reoffended, lower+not reoffended]
const rowW = 84;
const cellW = 92;
const cellH = 66;
const top = 82;
const bad = [false, true, true, false];
---
<div class="qfig-geg">
  <svg viewBox="0 0 580 280" role="img" aria-label="Two tables of counts, one for each group of 500 people, with rows flagged higher risk and labeled lower risk and columns reoffended and did not reoffend. Group A: 120, 60, 80, 240. Group B: 160, 100, 40, 200.">
    {groups.map((g) => (
      <g>
        <text x={g.x} y="22" class="qfig-geg-h">
          <tspan data-lang-en>{g.en}</tspan>
          <tspan data-lang-vi>{g.vi}</tspan>
        </text>

        <text x={g.x + rowW + cellW / 2} y="50" text-anchor="middle" class="qfig-geg-col">
          <tspan data-lang-en>Reoffended</tspan>
          <tspan data-lang-vi>Tái phạm</tspan>
        </text>
        <text x={g.x + rowW + cellW + cellW / 2} y="50" text-anchor="middle" class="qfig-geg-col">
          <tspan data-lang-en>Did not</tspan>
          <tspan data-lang-vi>Không</tspan>
        </text>
        <text x={g.x + rowW + cellW + cellW / 2} y="66" text-anchor="middle" class="qfig-geg-col">
          <tspan data-lang-en>reoffend</tspan>
          <tspan data-lang-vi>tái phạm</tspan>
        </text>

        <text x={g.x + rowW - 8} y={top + cellH / 2 - 3} text-anchor="end" class="qfig-geg-row">
          <tspan data-lang-en>Flagged</tspan>
          <tspan data-lang-vi>Bị gắn cờ</tspan>
        </text>
        <text x={g.x + rowW - 8} y={top + cellH / 2 + 14} text-anchor="end" class="qfig-geg-row">
          <tspan data-lang-en>higher risk</tspan>
          <tspan data-lang-vi>rủi ro cao</tspan>
        </text>
        <text x={g.x + rowW - 8} y={top + cellH + cellH / 2 - 3} text-anchor="end" class="qfig-geg-row">
          <tspan data-lang-en>Labeled</tspan>
          <tspan data-lang-vi>Gắn nhãn</tspan>
        </text>
        <text x={g.x + rowW - 8} y={top + cellH + cellH / 2 + 14} text-anchor="end" class="qfig-geg-row">
          <tspan data-lang-en>lower risk</tspan>
          <tspan data-lang-vi>rủi ro thấp</tspan>
        </text>

        {g.c.map((n, i) => {
          const row = i < 2 ? 0 : 1;
          // order above: [flagged+reoffended, flagged+not, lower+reoffended, lower+not]
          const cx = g.x + rowW + (i % 2) * cellW;
          const cy = top + row * cellH;
          return (
            <g>
              <rect x={cx + 2} y={cy + 2} width={cellW - 4} height={cellH - 4} rx="6" class={bad[i] ? 'qfig-geg-bad' : 'qfig-geg-ok'} />
              <text x={cx + cellW / 2} y={cy + cellH / 2 + 8} text-anchor="middle" class="qfig-geg-n">{n}</text>
            </g>
          );
        })}
      </g>
    ))}

    <rect x="0" y="236" width="16" height="16" rx="4" class="qfig-geg-ok" />
    <text x="24" y="249" class="qfig-geg-key">
      <tspan data-lang-en>The label matched what the person did</tspan>
      <tspan data-lang-vi>Nhãn khớp với việc người đó làm</tspan>
    </text>
    <rect x="312" y="236" width="16" height="16" rx="4" class="qfig-geg-bad" />
    <text x="336" y="249" class="qfig-geg-key">
      <tspan data-lang-en>The label did not match</tspan>
      <tspan data-lang-vi>Nhãn không khớp</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-geg { margin: 0; width: 100%; }
  .qfig-geg svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-geg text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-geg .qfig-geg-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-geg .qfig-geg-col { font-weight: 600; fill: var(--text-muted); }
  .qfig-geg .qfig-geg-row { font-weight: 600; fill: var(--text); }
  .qfig-geg .qfig-geg-n { font-size: 24px; font-weight: 700; fill: var(--text); }
  .qfig-geg .qfig-geg-key { font-size: 13px; fill: var(--text-body); }
  .qfig-geg-ok { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .qfig-geg-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
</style>
