---
// Quiz figure for Post 6 (depth and shadows): the same avatar stack drawn without and with a cutout border.
const rows = [
  { y: 82, n: { en: 'Row A', vi: 'Hàng A' }, cut: false, note: { en: 'overlap 14px, no border', vi: 'chồng 14px, không viền' } },
  { y: 190, n: { en: 'Row B', vi: 'Hàng B' }, cut: true, note: { en: 'overlap 14px, 3px border in the page colour', vi: 'chồng 14px, viền 3px cùng màu nền trang' } },
];
const letters = ['K', 'L', 'M', 'N'];
---
<div class="qfig-uxq06flatoverlap">
  <svg viewBox="0 0 600 256" role="img" aria-label="Two rows of four overlapping blue avatar circles on an off-white page. In row A the circles have no border and run together into one shape. In row B each circle has a 3 pixel border in the page colour, which leaves a clean gap where it overlaps the next one.">
    <rect x="8" y="8" width="584" height="240" rx="10" class="page" />
    {rows.map((r) => (
      <>
        <text x="30" y={r.y - 36} class="h"><tspan data-lang-en>{r.n.en}</tspan><tspan data-lang-vi>{r.n.vi}</tspan></text>
        <text x="110" y={r.y - 36} class="m"><tspan data-lang-en>{r.note.en}</tspan><tspan data-lang-vi>{r.note.vi}</tspan></text>
        {letters.map((l, i) => (
          <>
            <circle cx={64 + i * 58} cy={r.y + 6} r="26" class={r.cut ? 'av cut' : 'av'} />
            <text x={64 + i * 58} y={r.y + 12} text-anchor="middle" class="ini">{l}</text>
          </>
        ))}
      </>
    ))}
  </svg>
</div>

<style>
  .qfig-uxq06flatoverlap { margin: 0; width: 100%; }
  .qfig-uxq06flatoverlap svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq06flatoverlap text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq06flatoverlap .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-uxq06flatoverlap .m { fill: var(--text-muted); }
  .qfig-uxq06flatoverlap .page { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq06flatoverlap .av { fill: var(--act-3); stroke: none; }
  .qfig-uxq06flatoverlap .av.cut { stroke: var(--bg-alt); stroke-width: 3; }
  .qfig-uxq06flatoverlap .ini { fill: #fff; font-weight: 700; font-size: 15px; }
</style>
