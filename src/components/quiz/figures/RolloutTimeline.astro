---
// Staged rollout timeline: 1% -> 10% -> 100%, the gate metric and the rollback point,
// with the scenario's numbers. Below it, the same change pushed to every server at once.
// Plain inline SVG using site tokens only.
---
<figure class="qfig-roll">
  <svg viewBox="0 0 900 400" role="img" aria-label="A staged rollout with three stages, 1 percent, 10 percent and 100 percent of servers, a gate that watches the error rate with a 5 percent threshold, and a rollback arrow. Below, an all-at-once push to every server with no gate.">
    <text x="40" y="32" class="qfig-roll-h">
      <tspan data-lang-en>Staged rollout, 20,000 req/s in total</tspan>
      <tspan data-lang-vi>Rollout theo đợt, tổng 20.000 req/s</tspan>
    </text>

    <g class="qfig-roll-stage">
      <rect x="40" y="50" width="200" height="105" rx="8" />
      <text x="140" y="78" text-anchor="middle" class="qfig-roll-t">
        <tspan data-lang-en>Stage 1: 1%</tspan>
        <tspan data-lang-vi>Đợt 1: 1%</tspan>
      </text>
      <text x="140" y="108" text-anchor="middle">10 servers</text>
      <text x="140" y="138" text-anchor="middle">200 req/s</text>
    </g>
    <g class="qfig-roll-stage">
      <rect x="290" y="50" width="260" height="105" rx="8" />
      <text x="420" y="78" text-anchor="middle" class="qfig-roll-t">
        <tspan data-lang-en>Stage 2: 10%</tspan>
        <tspan data-lang-vi>Đợt 2: 10%</tspan>
      </text>
      <text x="420" y="108" text-anchor="middle">100 servers</text>
      <text x="420" y="138" text-anchor="middle">2,000 req/s</text>
    </g>
    <g class="qfig-roll-stage">
      <rect x="600" y="50" width="260" height="105" rx="8" />
      <text x="730" y="78" text-anchor="middle" class="qfig-roll-t">
        <tspan data-lang-en>Stage 3: 100%</tspan>
        <tspan data-lang-vi>Đợt 3: 100%</tspan>
      </text>
      <text x="730" y="108" text-anchor="middle">1,000 servers</text>
      <text x="730" y="138" text-anchor="middle">20,000 req/s</text>
    </g>

    <g class="qfig-roll-gate">
      <line x1="265" y1="44" x2="265" y2="170" />
      <line x1="575" y1="44" x2="575" y2="170" />
      <text x="265" y="205" text-anchor="middle">
        <tspan data-lang-en>Gate: errors &gt; 5%?</tspan>
        <tspan data-lang-vi>Cổng: lỗi &gt; 5%?</tspan>
      </text>
      <text x="265" y="236" text-anchor="middle" class="qfig-roll-m">
        <tspan data-lang-en>checked every 30 s</tspan>
        <tspan data-lang-vi>kiểm tra mỗi 30 s</tspan>
      </text>
    </g>

    <g class="qfig-roll-back">
      <path d="M 250 270 L 56 270" />
      <polygon points="40,270 56,262 56,278" />
      <text x="150" y="302" text-anchor="middle">
        <tspan data-lang-en>Rollback: 60 s</tspan>
        <tspan data-lang-vi>Rollback: 60 s</tspan>
      </text>
    </g>

    <g class="qfig-roll-all">
      <rect x="40" y="326" width="820" height="62" rx="8" />
      <text x="450" y="365" text-anchor="middle">
        <tspan data-lang-en>All at once: 100% of servers, no gate</tspan>
        <tspan data-lang-vi>Đẩy một lượt: 100% server, không cổng</tspan>
      </text>
    </g>
  </svg>
</figure>

<style>
  .qfig-roll { margin: 0; }
  .qfig-roll svg { width: 100%; height: auto; display: block; }
  .qfig-roll text { font-size: 25px; fill: var(--text-body); }
  .qfig-roll .qfig-roll-h { font-size: 27px; font-weight: 700; fill: var(--text); }
  .qfig-roll .qfig-roll-t { font-weight: 700; fill: var(--text); }
  .qfig-roll .qfig-roll-m { fill: var(--text-muted); font-size: 22px; }
  .qfig-roll-stage rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-roll-gate line { stroke: var(--gold); stroke-width: 3; stroke-dasharray: 6 4; }
  .qfig-roll .qfig-roll-gate text { fill: var(--text); font-weight: 600; }
  .qfig-roll .qfig-roll-gate .qfig-roll-m { fill: var(--text-muted); font-weight: 400; }
  .qfig-roll-back path { stroke: var(--red); stroke-width: 3; fill: none; }
  .qfig-roll-back polygon { fill: var(--red); }
  .qfig-roll .qfig-roll-back text { fill: var(--red); font-weight: 700; }
  .qfig-roll-all rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-roll .qfig-roll-all text { fill: var(--red); font-weight: 700; }
</style>
