---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for set 06: a staged rollout (1%, 10%, 100% of servers) with an error-rate gate
// and a rollback path, next to an all-at-once push with no gate.
// Inline SVG, site tokens only, no <marker>/<defs>. Shows only the scenario's inputs, never the failed-request count.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 7 * Math.cos(a)} ${y2 - 7 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const stages = [
  { y: 46, pct: '1%', n: '10', fill: 1 },
  { y: 192, pct: '10%', n: '100', fill: 10 },
  { y: 338, pct: '100%', n: '1,000', fill: 100 },
];
const cw = 250;
const ch = 76;
const gx = 125;
const gateY = [157, 303];
const loopR = 560;
const lb = arrow(loopR, 84, cw + 4, 84);
---
<div class="qfig-roll">
  <svg viewBox="0 0 580 630" role="img" aria-label="A staged rollout reaches 1 percent, 10 percent and then 100 percent of servers, with an error-rate gate after each stage and a rollback path. Below, an all-at-once push reaches every server with no gate.">
    <text x="0" y="22" class="qfig-roll-h">
      <tspan data-lang-en>Staged rollout: 1,000 servers, 20,000 req/s</tspan>
      <tspan data-lang-vi>Rollout theo đợt: 1.000 server, 20.000 req/s</tspan>
    </text>

    {stages.map((s, i) => (
      <g class="qfig-roll-stage">
        <rect x="0" y={s.y} width={cw} height={ch} rx="8" />
        <text x="14" y={s.y + 24} class="qfig-roll-t">
          <tspan data-lang-en>Stage {i + 1}: {s.pct} of servers</tspan>
          <tspan data-lang-vi>Đợt {i + 1}: {s.pct} server</tspan>
        </text>
        <DiagramIcon name="server" x="28" y={s.y + 46} size={24} />
        <text x="52" y={s.y + 52} class="qfig-roll-n">
          <tspan data-lang-en>{s.n} servers</tspan>
          <tspan data-lang-vi>{s.n} server</tspan>
        </text>
        <rect x="14" y={s.y + ch - 12} width={cw - 28} height="5" rx="2" class="qfig-roll-track" />
        <rect x="14" y={s.y + ch - 12} width={Math.max(4, ((cw - 28) * s.fill) / 100)} height="5" rx="2" class="qfig-roll-fill" />
      </g>
    ))}

    {gateY.map((g, i) => {
      const a1 = arrow(gx, stages[i].y + ch + 2, gx, g - 20);
      const a2 = arrow(gx, g + 20, gx, stages[i + 1].y - 2);
      return (
        <g>
          <g class="qfig-roll-go"><path d={a1.line} /><polygon points={a1.head} /></g>
          <g class="qfig-roll-go"><path d={a2.line} /><polygon points={a2.head} /></g>
          <circle cx={gx} cy={g} r="19" class="qfig-roll-gate-bg" />
          <DiagramIcon name="shield" x={gx} y={g} size={24} />
          <text x={gx + 32} y={g - 3} class="qfig-roll-gate">
            <tspan data-lang-en>Gate checks every 30 s</tspan>
            <tspan data-lang-vi>Cổng kiểm tra mỗi 30 giây</tspan>
          </text>
          <text x={gx + 32} y={g + 16} class="qfig-roll-m">
            <tspan data-lang-en>Errors above 5%: stop</tspan>
            <tspan data-lang-vi>Lỗi trên 5%: dừng lại</tspan>
          </text>
        </g>
      );
    })}

    <g class="qfig-roll-back">
      <path d={`M 340 ${gateY[0]} L ${loopR} ${gateY[0]} L ${loopR} 84 L ${loopR} 84 L ${cw + 8} 84`} />
      <polygon points={lb.head} />
      <text x="350" y="108">
        <tspan data-lang-en>If the gate trips,</tspan>
        <tspan data-lang-vi>Nếu cổng báo lỗi,</tspan>
      </text>
      <text x="350" y="128">
        <tspan data-lang-en>roll back: 60 s to finish</tspan>
        <tspan data-lang-vi>rollback mất 60 giây</tspan>
      </text>
    </g>

    <line x1="0" x2="580" y1="444" y2="444" class="qfig-roll-rule" />
    <text x="0" y="474" class="qfig-roll-h">
      <tspan data-lang-en>All at once: the same change, no stages</tspan>
      <tspan data-lang-vi>Đẩy một lượt: cùng thay đổi, không chia đợt</tspan>
    </text>
    <g class="qfig-roll-all">
      <rect x="0" y="490" width="580" height="96" rx="8" />
      <DiagramIcon name="server" x="30" y="538" size={26} />
      <text x="60" y="526" class="qfig-roll-at">
        <tspan data-lang-en>100% of servers, at the same moment</tspan>
        <tspan data-lang-vi>100% server, cùng một lúc</tspan>
      </text>
      <text x="60" y="550" class="qfig-roll-am">
        <tspan data-lang-en>No gate in between: nothing stops it</tspan>
        <tspan data-lang-vi>Không có cổng ở giữa: không gì chặn lại</tspan>
      </text>
      <text x="60" y="570" class="qfig-roll-am">
        <tspan data-lang-en>if the error rate climbs.</tspan>
        <tspan data-lang-vi>nếu tỉ lệ lỗi tăng.</tspan>
      </text>
    </g>
    <text x="0" y="614" class="qfig-roll-m">
      <tspan data-lang-en>Bar in each stage: share of servers with the change.</tspan>
      <tspan data-lang-vi>Thanh trong mỗi đợt: phần server đã nhận thay đổi.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-roll { margin: 0; width: 100%; }
  .qfig-roll svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-roll text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-roll .qfig-roll-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-roll .qfig-roll-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-roll .qfig-roll-n { font-size: 16px; font-weight: 600; fill: var(--text); }
  .qfig-roll .qfig-roll-m { fill: var(--text-muted); }
  .qfig-roll-stage > rect:first-child { fill: var(--bg-alt); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-roll-track { fill: var(--border); }
  .qfig-roll-fill { fill: var(--gold); }
  .qfig-roll-go path { stroke: var(--gold); stroke-width: 1.8; fill: none; }
  .qfig-roll-go polygon { fill: var(--gold); }
  .qfig-roll-gate-bg { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-roll .qfig-roll-gate { font-weight: 600; fill: var(--text); }
  .qfig-roll-back path { stroke: var(--red); stroke-width: 2; fill: none; stroke-dasharray: 6 4; }
  .qfig-roll-back polygon { fill: var(--red); }
  .qfig-roll .qfig-roll-back text { fill: var(--red); font-weight: 700; }
  .qfig-roll-rule { stroke: var(--border); }
  .qfig-roll-all rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-roll .qfig-roll-at { font-size: 16px; font-weight: 700; fill: var(--red); }
  .qfig-roll .qfig-roll-am { fill: var(--text-body); }
</style>
