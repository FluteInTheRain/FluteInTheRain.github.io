---
// 51labs "Community detection for VN100", results table as reported on the page (annual figures, %).
const rows = [['Infomap', '22.07', '24.5', '0.90', '−42.85'], ['Louvain', '16.71', '26.21', '0.64', '−47.26'], ['VN-Index', '12.53', '19.83', '0.63', '−40.34']];
---
<div class="q11b">
  <svg viewBox="0 0 580 200" role="img" aria-hidden="true">
    <text x="20" y="24" class="q11b-h"><tspan data-lang-en>51labs VN100 backtest, as reported</tspan><tspan data-lang-vi>Backtest VN100 của 51labs, như bài báo cáo</tspan></text>
    <rect x="20" y="40" width="540" height="124" rx="8" class="q11b-x" />
    <text x="190" y="64" text-anchor="end" class="q11b-c"><tspan data-lang-en>return %</tspan><tspan data-lang-vi>lợi suất %</tspan></text>
    <text x="290" y="64" text-anchor="end" class="q11b-c"><tspan data-lang-en>volatility %</tspan><tspan data-lang-vi>biến động %</tspan></text>
    <text x="380" y="64" text-anchor="end" class="q11b-c">Sharpe</text>
    <text x="520" y="64" text-anchor="end" class="q11b-c"><tspan data-lang-en>max drawdown %</tspan><tspan data-lang-vi>sụt tối đa %</tspan></text>
    {rows.map((r, i) => (
      <g>
        <text x="34" y={94 + i * 28} class="q11b-k">{r[0]}</text>
        <text x="190" y={94 + i * 28} text-anchor="end">{r[1]}</text>
        <text x="290" y={94 + i * 28} text-anchor="end">{r[2]}</text>
        <text x="380" y={94 + i * 28} text-anchor="end">{r[3]}</text>
        <text x="520" y={94 + i * 28} text-anchor="end">{r[4]}</text>
      </g>
    ))}
    <text x="20" y="188" class="q11b-s"><tspan data-lang-en>The post gives no backtest period.</tspan><tspan data-lang-vi>Bài không nêu giai đoạn backtest.</tspan></text>
  </svg>
</div>
<style>
  .q11b { margin: 0; width: 100%; }
  .q11b svg { display: block; width: 100%; height: auto; }
  .q11b text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .q11b .q11b-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q11b .q11b-c { font-size: 11.5px; font-weight: 700; fill: var(--text-muted); }
  .q11b .q11b-k { font-weight: 700; fill: var(--text); }
  .q11b .q11b-s { font-size: 12px; fill: var(--text-muted); }
  .q11b-x { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
</style>
