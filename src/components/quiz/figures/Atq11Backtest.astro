---
// Computed by demo/ai-trading/p11_community_noise.py: 200 simulated markets, no edge anywhere; Sharpe, then median max drawdown %.
const rows = [['Community rule|Quy tắc cộng đồng', '−0.01', '0.61', '1.52', '−16.1'], ['Equal weight|Tỷ trọng đều', '0.02', '0.67', '1.54', '−12.3']];
---
<div class="q11b">
  <svg viewBox="0 0 580 184" role="img" aria-hidden="true">
    <text x="20" y="24" class="q11b-h"><tspan data-lang-en>200 simulated markets, no edge anywhere</tspan><tspan data-lang-vi>200 thị trường mô phỏng, không có lợi thế</tspan></text>
    <rect x="20" y="40" width="540" height="100" rx="8" class="q11b-x" />
    <text x="190" y="64" text-anchor="end" class="q11b-c"><tspan data-lang-en>Sharpe median</tspan><tspan data-lang-vi>Sharpe trung vị</tspan></text>
    <text x="285" y="64" text-anchor="end" class="q11b-c"><tspan data-lang-en>90th pct</tspan><tspan data-lang-vi>phân vị 90</tspan></text>
    <text x="365" y="64" text-anchor="end" class="q11b-c"><tspan data-lang-en>best</tspan><tspan data-lang-vi>tốt nhất</tspan></text>
    <text x="540" y="64" text-anchor="end" class="q11b-c"><tspan data-lang-en>median max drawdown %</tspan><tspan data-lang-vi>sụt tối đa trung vị %</tspan></text>
    {rows.map((r, i) => (
      <g>
        <text x="34" y={94 + i * 28} class="q11b-k"><tspan data-lang-en>{r[0].split('|')[0]}</tspan><tspan data-lang-vi>{r[0].split('|')[1]}</tspan></text>
        <text x="195" y={94 + i * 28} text-anchor="end">{r[1]}</text>
        <text x="285" y={94 + i * 28} text-anchor="end">{r[2]}</text>
        <text x="365" y={94 + i * 28} text-anchor="end">{r[3]}</text>
        <text x="540" y={94 + i * 28} text-anchor="end">{r[4]}</text>
      </g>
    ))}
    <text x="20" y="172" class="q11b-s"><tspan data-lang-en>Sharpe is annualised; drawdown is on the cumulative curve.</tspan><tspan data-lang-vi>Sharpe tính theo năm; mức sụt tính trên đường lũy kế.</tspan></text>
  </svg>
</div>
<style>
  .q11b { margin: 0; width: 100%; }
  .q11b svg { display: block; width: 100%; height: auto; }
  .q11b text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .q11b .q11b-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .q11b .q11b-c { font-size: 11.5px; font-weight: 700; fill: var(--text-muted); }
  .q11b .q11b-k { font-weight: 700; fill: var(--text); }
  .q11b .q11b-s { font-size: 12px; fill: var(--text-muted); }
  .q11b-x { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
</style>
