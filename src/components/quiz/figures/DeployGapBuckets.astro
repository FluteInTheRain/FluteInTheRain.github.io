---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for stream set 05: three lanes on a 10:01 to 10:04 clock axis. Clients send at a steady rate,
// the topic holds a backlog while the consumer is stopped by a deploy (10:02:00 to 10:03:00), then the consumer
// reads the backlog first and live traffic after. It shows no bucket totals. Inline SVG, site tokens only.
const x0 = 176;
const pm = 128; // pixels per minute
const tx = (min: number) => x0 + min * pm; // min = minutes after 10:01:00
const lanes = { send: 84, topic: 168, cons: 252 };
const axisY = 306;
const ticks = ['10:01', '10:02', '10:03', '10:04'];
---
<div class="qfig-dgb">
  <svg viewBox="0 0 580 336" role="img" aria-label="Three lanes on a clock from 10:01 to 10:04: clients send steadily, events wait in the topic while the consumer is stopped from 10:02:00 to 10:03:00, then the consumer reads the backlog and live traffic.">
    <text x="0" y="22" class="qfig-dgb-h">
      <tspan data-lang-en>One deploy, as each clock sees it</tspan>
      <tspan data-lang-vi>Một lần deploy, nhìn từ từng đồng hồ</tspan>
    </text>

    {[0, 1, 2, 3].map((m) => (
      <line x1={tx(m)} x2={tx(m)} y1="40" y2={axisY} class="qfig-dgb-grid" />
    ))}

    {[
      { y: lanes.send, icon: 'laptop', en: 'Clients send', vi: 'Client gửi' },
      { y: lanes.topic, icon: 'disk', en: 'Topic', vi: 'Topic' },
      { y: lanes.cons, icon: 'server', en: 'Consumer reads', vi: 'Consumer đọc' },
    ].map((l) => (
      <g>
        <DiagramIcon name={l.icon as any} x="19" y={l.y} size={22} />
        <text x="40" y={l.y + 5} class="qfig-dgb-lane">
          <tspan data-lang-en>{l.en}</tspan>
          <tspan data-lang-vi>{l.vi}</tspan>
        </text>
      </g>
    ))}

    <!-- clients: steady for the whole axis -->
    <rect x={tx(0)} y={lanes.send - 18} width={3 * pm} height="36" rx="6" class="qfig-dgb-band" />
    <text x={tx(1.5)} y={lanes.send + 5} text-anchor="middle" class="qfig-dgb-t">
      <tspan data-lang-en>100 req/s, steady</tspan>
      <tspan data-lang-vi>100 req/s, đều đặn</tspan>
    </text>

    <!-- topic: backlog grows while the consumer is stopped, drains after the restart -->
    <line x1={tx(0)} x2={tx(3)} y1={lanes.topic + 18} y2={lanes.topic + 18} class="qfig-dgb-base" />
    <polygon points={`${tx(1)},${lanes.topic + 18} ${tx(2)},${lanes.topic - 22} ${tx(2) + 26},${lanes.topic + 18}`} class="qfig-dgb-backlog" />
    <text x={tx(1) + 4} y={lanes.topic - 26} class="qfig-dgb-red">
      <tspan data-lang-en>events pile up</tspan>
      <tspan data-lang-vi>sự kiện dồn lại</tspan>
    </text>

    <!-- consumer -->
    <rect x={tx(0)} y={lanes.cons - 18} width={pm} height="36" rx="6" class="qfig-dgb-band" />
    <text x={tx(0.5)} y={lanes.cons + 5} text-anchor="middle" class="qfig-dgb-t">
      <tspan data-lang-en>live</tspan>
      <tspan data-lang-vi>đọc trực tiếp</tspan>
    </text>
    <rect x={tx(1)} y={lanes.cons - 18} width={pm} height="36" rx="6" class="qfig-dgb-stop" />
    <text x={tx(1.5)} y={lanes.cons + 5} text-anchor="middle" class="qfig-dgb-red">
      <tspan data-lang-en>stopped 60 s</tspan>
      <tspan data-lang-vi>dừng 60 giây</tspan>
    </text>
    <rect x={tx(2)} y={lanes.cons - 18} width={pm} height="36" rx="6" class="qfig-dgb-band" />
    <text x={tx(2.5)} y={lanes.cons - 25} text-anchor="middle" class="qfig-dgb-m">
      <tspan data-lang-en>backlog first, then live</tspan>
      <tspan data-lang-vi>backlog trước, rồi mới live</tspan>
    </text>
    <text x={tx(2.5)} y={lanes.cons + 5} text-anchor="middle" class="qfig-dgb-t">
      <tspan data-lang-en>restart at 10:03:00</tspan>
      <tspan data-lang-vi>chạy lại lúc 10:03:00</tspan>
    </text>
    <text x={tx(1) - 6} y={lanes.cons + 38} text-anchor="end" class="qfig-dgb-m">
      <tspan data-lang-en>deploy starts 10:02:00</tspan>
      <tspan data-lang-vi>deploy bắt đầu 10:02:00</tspan>
    </text>

    <!-- axis -->
    <line x1={tx(0)} x2={tx(3)} y1={axisY} y2={axisY} class="qfig-dgb-axis" />
    {ticks.map((t, i) => (
      <g>
        <line x1={tx(i)} x2={tx(i)} y1={axisY} y2={axisY + 5} class="qfig-dgb-axis" />
        <text x={tx(i)} y={axisY + 22} text-anchor="middle" class="qfig-dgb-m">{t}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-dgb { margin: 0; width: 100%; }
  .qfig-dgb svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-dgb text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-dgb .qfig-dgb-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-dgb .qfig-dgb-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-dgb .qfig-dgb-t { font-weight: 600; fill: var(--text); }
  .qfig-dgb .qfig-dgb-m { fill: var(--text-muted); }
  .qfig-dgb .qfig-dgb-red { font-weight: 600; fill: var(--red); }
  .qfig-dgb-grid { stroke: var(--border); stroke-width: 1; stroke-dasharray: 4 4; }
  .qfig-dgb-band { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-dgb-stop { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; stroke-dasharray: 5 4; }
  .qfig-dgb-base { stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-dgb-backlog { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; stroke-linejoin: round; }
  .qfig-dgb-axis { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
