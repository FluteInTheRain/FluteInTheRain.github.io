---
// Quiz figure for set 05: weights per layer of NN3 fed 920 features (920*32+32, 32*16+16, 16*8+8, 8+1).
const layers = [
  { en: 'inputs → 32 units', vi: 'đầu vào → 32 nơ-ron', n: 29472 },
  { en: '32 → 16 units', vi: '32 → 16 nơ-ron', n: 528 },
  { en: '16 → 8 units', vi: '16 → 8 nơ-ron', n: 136 },
  { en: '8 → forecast', vi: '8 → dự báo', n: 9 },
];
const SC = 330 / 29472;
---
<div class="qfig-atq14p">
  <svg viewBox="0 0 580 200" role="img" aria-label="Weights per layer in a 920-input network with hidden layers of 32, 16 and 8 units: 29,472 in the first layer, 528 in the second, 136 in the third and 9 at the output.">
    <text x="0" y="20" class="h">
      <tspan data-lang-en>Weights per layer (including biases)</tspan>
      <tspan data-lang-vi>Số trọng số mỗi layer (gồm cả bias)</tspan>
    </text>
    {layers.map((l, i) => (
      <g>
        <text x="0" y={58 + i * 38} class="n">
          <tspan data-lang-en>{l.en}</tspan>
          <tspan data-lang-vi>{l.vi}</tspan>
        </text>
        <rect x="170" y={42 + i * 38} width={Math.max(2, l.n * SC)} height="24" rx="3" class="bar" />
        <text x={170 + Math.max(2, l.n * SC) + 8} y={59 + i * 38} class="v">{l.n.toLocaleString('en-US')}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-atq14p svg { display: block; width: 100%; height: auto; max-width: 580px; margin: 0 auto; }
  .qfig-atq14p text { font-size: 12.5px; fill: var(--text-body); }
  .qfig-atq14p .h { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-atq14p .n { font-weight: 600; fill: var(--text); }
  .qfig-atq14p .v { font-weight: 700; fill: var(--text); }
  .qfig-atq14p .bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
</style>
