---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for batch set 08: contrasting row-by-row Spark -> live Postgres writes
// against LinkedIn Venice's background Full Push + nearline replay + version backup.
// Shows scenario parameters only (200 tasks, 2 conns/task, max 300, 120 checkout, 5M rows),
// without revealing calculated totals or answers. Inline SVG, site tokens only, no ids.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const directArr = arrow(202, 98, 256, 98);
const nearlineArr = arrow(176, 245, 220, 270);
const pushArr = arrow(176, 323, 220, 294);
const swapArr = arrow(398, 268, 430, 246);
const demoteArr = arrow(506, 278, 506, 304);
---
<div class="qfig-vdr">
  <svg viewBox="0 0 580 436" role="img" aria-label="Comparison of two paths for serving 5,000,000 recommendation rows. Top: 200 Spark tasks open 2 connections each directly to live checkout Postgres, which has max_connections 300 and 120 used by checkout. Bottom: LinkedIn Venice builds a new version in the background from a batch Push Job plus replayed Kafka nearline writes, swaps reads to the live version, and keeps the previous version as backup.">
    <text x="0" y="22" class="qfig-vdr-h">
      <tspan data-lang-en>Serving 5,000,000 recommendations</tspan>
      <tspan data-lang-vi>Phục vụ 5.000.000 dòng gợi ý sản phẩm</tspan>
    </text>

    <!-- Top: Direct OLTP path -->
    <text x="0" y="48" class="qfig-vdr-badt">
      <tspan data-lang-en>Direct OLTP writes (saturates pool)</tspan>
      <tspan data-lang-vi>Ghi thẳng vào OLTP (nghẽn pool)</tspan>
    </text>

    <rect x="0" y="62" width="202" height="72" rx="8" class="qfig-vdr-box" />
    <DiagramIcon name="spark" x={24} y={90} size={22} />
    <text x="42" y="88" class="qfig-vdr-t">
      <tspan data-lang-en>200 Spark tasks</tspan>
      <tspan data-lang-vi>200 task Spark</tspan>
    </text>
    <text x="42" y="106" class="qfig-vdr-m">
      <tspan data-lang-en>2 connections per task</tspan>
      <tspan data-lang-vi>2 kết nối mỗi task</tspan>
    </text>
    <text x="42" y="123" class="qfig-vdr-s">
      <tspan data-lang-en>row-by-row UPSERT</tspan>
      <tspan data-lang-vi>UPSERT từng dòng</tspan>
    </text>

    <g class="qfig-vdr-hotarr"><path d={directArr.line} /><polygon points={directArr.head} /></g>
    <text x="229" y="88" text-anchor="middle" class="qfig-vdr-s">5M</text>

    <rect x="258" y="62" width="322" height="72" rx="8" class="qfig-vdr-hot" />
    <DiagramIcon name="postgres" x={282} y={90} size={22} />
    <text x="302" y="88" class="qfig-vdr-t">
      <tspan data-lang-en>Live checkout Postgres</tspan>
      <tspan data-lang-vi>Postgres thanh toán</tspan>
    </text>
    <text x="302" y="106" class="qfig-vdr-m">max_connections: 300</text>
    <text x="302" y="123" class="qfig-vdr-m">
      <tspan data-lang-en>checkout &amp; login need 120</tspan>
      <tspan data-lang-vi>thanh toán &amp; login cần 120</tspan>
    </text>

    <DiagramIcon name="users" x={282} y={154} size={18} />
    <text x="300" y="159" class="qfig-vdr-badm">
      <tspan data-lang-en>Shopper queries queue behind batch writes</tspan>
      <tspan data-lang-vi>Truy vấn khách mua kẹt sau luồng ghi batch</tspan>
    </text>

    <line x1="0" x2="580" y1="178" y2="178" class="qfig-vdr-rule" />

    <!-- Bottom: LinkedIn Venice decoupled path -->
    <text x="0" y="202" class="qfig-vdr-t">
      <tspan data-lang-en>LinkedIn Venice: bulk push + nearline replay</tspan>
      <tspan data-lang-vi>LinkedIn Venice: đẩy lô nền + phát lại nearline</tspan>
    </text>

    <rect x="0" y="216" width="176" height="58" rx="8" class="qfig-vdr-box" />
    <DiagramIcon name="kafka" x={20} y={245} size={20} />
    <text x="36" y="241" class="qfig-vdr-t">
      <tspan data-lang-en>Nearline clicks</tspan>
      <tspan data-lang-vi>Click nearline</tspan>
    </text>
    <text x="36" y="259" class="qfig-vdr-s">
      <tspan data-lang-en>Kafka stream updates</tspan>
      <tspan data-lang-vi>cập nhật qua Kafka</tspan>
    </text>

    <rect x="0" y="294" width="176" height="58" rx="8" class="qfig-vdr-box" />
    <DiagramIcon name="spark" x={20} y={323} size={20} />
    <text x="36" y="319" class="qfig-vdr-t">
      <tspan data-lang-en>Batch Push Job</tspan>
      <tspan data-lang-vi>Batch Push Job</tspan>
    </text>
    <text x="36" y="337" class="qfig-vdr-s">
      <tspan data-lang-en>Full Push (5M rows)</tspan>
      <tspan data-lang-vi>Full Push (5M dòng)</tspan>
    </text>

    <g class="qfig-vdr-arr"><path d={nearlineArr.line} /><polygon points={nearlineArr.head} /></g>
    <g class="qfig-vdr-arr"><path d={pushArr.line} /><polygon points={pushArr.head} /></g>
    <text x="200" y="240" text-anchor="middle" class="qfig-vdr-s">
      <tspan data-lang-en>replay</tspan>
      <tspan data-lang-vi>phát lại</tspan>
    </text>

    <rect x="222" y="248" width="176" height="66" rx="8" class="qfig-vdr-box" />
    <DiagramIcon name="package" x={242} y={281} size={22} />
    <text x="259" y="276" class="qfig-vdr-t">
      <tspan data-lang-en>New version</tspan>
      <tspan data-lang-vi>Bản mới</tspan>
    </text>
    <text x="259" y="294" class="qfig-vdr-s">
      <tspan data-lang-en>loads offline</tspan>
      <tspan data-lang-vi>nạp ngầm ở nền</tspan>
    </text>

    <g class="qfig-vdr-goldarr"><path d={swapArr.line} /><polygon points={swapArr.head} /></g>
    <text x="413" y="239" text-anchor="middle" class="qfig-vdr-s">
      <tspan data-lang-en>swap</tspan>
      <tspan data-lang-vi>tráo</tspan>
    </text>

    <rect x="432" y="216" width="148" height="60" rx="8" class="qfig-vdr-gold" />
    <DiagramIcon name="db" x={452} y={246} size={20} />
    <text x="468" y="241" class="qfig-vdr-t">
      <tspan data-lang-en>Live version</tspan>
      <tspan data-lang-vi>Bản đang chạy</tspan>
    </text>
    <text x="468" y="259" class="qfig-vdr-s">
      <tspan data-lang-en>serves reads</tspan>
      <tspan data-lang-vi>phục vụ đọc</tspan>
    </text>

    <g class="qfig-vdr-dasharr"><path d={demoteArr.line} /><polygon points={demoteArr.head} /></g>

    <rect x="432" y="306" width="148" height="56" rx="8" class="qfig-vdr-box" />
    <DiagramIcon name="backup" x={452} y={334} size={20} />
    <text x="468" y="330" class="qfig-vdr-t">
      <tspan data-lang-en>Old version</tspan>
      <tspan data-lang-vi>Bản trước</tspan>
    </text>
    <text x="468" y="348" class="qfig-vdr-s">
      <tspan data-lang-en>kept as backup</tspan>
      <tspan data-lang-vi>giữ dự phòng</tspan>
    </text>

    <text x="0" y="394" class="qfig-vdr-s">
      <tspan data-lang-en>LinkedIn production: ~500 use cases (2018), &gt;1,400 pushes/day, &gt;200 hybrid stores.</tspan>
      <tspan data-lang-vi>Thực tế tại LinkedIn: ~500 use case (2018), &gt;1.400 push/ngày, &gt;200 hybrid store.</tspan>
    </text>
    <text x="0" y="416" class="qfig-vdr-s">
      <tspan data-lang-en>Each data center serves reads from one complete version without stopping traffic.</tspan>
      <tspan data-lang-vi>Mỗi data center đọc từ một bản hoàn chỉnh mà không làm gián đoạn truy cập.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-vdr { margin: 0; width: 100%; }
  .qfig-vdr svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-vdr text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-vdr .qfig-vdr-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-vdr .qfig-vdr-t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-vdr .qfig-vdr-badt { font-size: 14px; font-weight: 700; fill: var(--red); }
  .qfig-vdr .qfig-vdr-badm { font-size: 13px; fill: var(--red); }
  .qfig-vdr .qfig-vdr-m { font-size: 13px; fill: var(--text-muted); }
  .qfig-vdr .qfig-vdr-s { font-size: 12.5px; fill: var(--text-muted); }
  .qfig-vdr-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .qfig-vdr-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-vdr-gold { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .qfig-vdr-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-vdr-arr path { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-vdr-arr polygon { fill: var(--text-muted); }
  .qfig-vdr-hotarr path { fill: none; stroke: var(--red); stroke-width: 4; }
  .qfig-vdr-hotarr polygon { fill: var(--red); }
  .qfig-vdr-goldarr path { fill: none; stroke: var(--gold); stroke-width: 2; }
  .qfig-vdr-goldarr polygon { fill: var(--gold); }
  .qfig-vdr-dasharr path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; stroke-dasharray: 4 3; }
  .qfig-vdr-dasharr polygon { fill: var(--text-muted); }
</style>
