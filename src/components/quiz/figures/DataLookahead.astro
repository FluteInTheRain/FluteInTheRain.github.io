---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 06: look-ahead bias — a backtest simulating October 2001 may use only
// information that existed then; the 8 November restatement stays behind the
// wall (post §3).
const W = 580;
const H = 360;
const wallX = 330;
---
<div class="qdla">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <text x="290" y="26" text-anchor="middle" class="qdla-h">
      <tspan data-lang-en>The backtest may only use what existed on its simulation date</tspan>
      <tspan data-lang-vi>Backtest chỉ được dùng những gì tồn tại vào ngày mô phỏng</tspan>
    </text>

    <line x1="30" x2="550" y1="240" y2="240" class="qdla-axis" />
    <line x1={wallX} x2={wallX} y1="70" y2="268" class="qdla-wall" />
    <text x={wallX} y="60" text-anchor="middle" class="qdla-walltext">
      <tspan data-lang-en>simulation date: October 2001</tspan>
      <tspan data-lang-vi>ngày mô phỏng: tháng 10/2001</tspan>
    </text>
    <text x={wallX + 10} y="120" class="qdla-walltext2">
      <tspan data-lang-en>the wall of "now"</tspan>
      <tspan data-lang-vi>bức tường của "hiện tại"</tspan>
    </text>

    <DiagramIcon name="calendar" x={70} y={252} size={20} />
    <text x="82" y="296" text-anchor="middle" class="qdla-when">
      <tspan data-lang-en>the past</tspan>
      <tspan data-lang-vi>quá khứ</tspan>
    </text>
    <text x="470" y="296" text-anchor="middle" class="qdla-when">
      <tspan data-lang-en>the future</tspan>
      <tspan data-lang-vi>tương lai</tspan>
    </text>

    <rect x="42" y="152" width="196" height="52" rx="8" class="qdla-box" />
    <text x="140" y="172" text-anchor="middle" class="qdla-boxtext">
      <tspan data-lang-en>filings already public</tspan>
      <tspan data-lang-vi>hồ sơ đã công bố</tspan>
    </text>
    <text x="140" y="194" text-anchor="middle" class="qdla-boxsub">
      <tspan data-lang-en>net income 2000: 1.3 billion USD</tspan>
      <tspan data-lang-vi>lợi nhuận 2000: 1,3 tỷ USD</tspan>
    </text>
    <line x1="238" x2="286" y1="178" y2="178" class="qdla-okarrow" />
    <polygon points="292,178 282,173 282,183" class="qdla-okarrow" />
    <text x="258" y="168" text-anchor="middle" class="qdla-ok">
      <tspan data-lang-en>may use</tspan>
      <tspan data-lang-vi>được dùng</tspan>
    </text>

    <rect x="372" y="152" width="186" height="52" rx="8" class="qdla-box is-bad" />
    <text x="465" y="172" text-anchor="middle" class="qdla-boxtext">
      <tspan data-lang-en>restatement of 8 Nov 2001</tspan>
      <tspan data-lang-vi>soát xét lại ngày 8/11/2001</tspan>
    </text>
    <text x="465" y="194" text-anchor="middle" class="qdla-boxsub">
      <tspan data-lang-en>591 million USD lower</tspan>
      <tspan data-lang-vi>thấp hơn 591 triệu USD</tspan>
    </text>
    <line x1="366" x2="336" y1="178" y2="178" class="qdla-badarrow" />
    <polygon points="330,178 340,173 340,183" class="qdla-badarrow" />
    <text x="352" y="166" text-anchor="middle" class="qdla-bad">
      <tspan data-lang-en>blocked</tspan>
      <tspan data-lang-vi>bị chặn</tspan>
    </text>

    <text x="290" y="336" text-anchor="middle" class="qdla-muted">
      <tspan data-lang-en>Using the future value in the past is look-ahead bias — results inflate.</tspan>
      <tspan data-lang-vi>Dùng giá trị tương lai trong quá khứ là look-ahead bias — kết quả bị phóng đại.</tspan>
    </text>
  </svg>
</div>

<style>
  .qdla {
    margin: 0;
    width: 100%;
  }
  .qdla svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qdla text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qdla .qdla-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qdla .qdla-axis {
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .qdla .qdla-wall {
    stroke: var(--text);
    stroke-width: 2;
    stroke-dasharray: 8 5;
  }
  .qdla .qdla-walltext {
    font-size: 13px;
    font-weight: 700;
    fill: var(--text);
  }
  .qdla .qdla-walltext2 {
    font-size: 12px;
    fill: var(--text-muted);
  }
  .qdla .qdla-when {
    font-size: 13px;
    font-weight: 600;
    fill: var(--text-muted);
  }
  .qdla .qdla-box {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.4;
  }
  .qdla .qdla-box.is-bad {
    fill: var(--red-tint-bg);
  }
  .qdla .qdla-boxtext {
    font-size: 13px;
    font-weight: 600;
    fill: var(--text);
  }
  .qdla .qdla-boxsub {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qdla .qdla-okarrow {
    stroke: var(--act-2);
    stroke-width: 2;
    fill: var(--act-2);
  }
  .qdla .qdla-ok {
    font-size: 12px;
    font-weight: 700;
    fill: var(--act-2);
  }
  .qdla .qdla-badarrow {
    stroke: var(--red);
    stroke-width: 2;
    stroke-dasharray: 5 4;
    fill: var(--red);
  }
  .qdla .qdla-bad {
    font-size: 12px;
    font-weight: 700;
    fill: var(--red);
  }
  .qdla .qdla-muted {
    font-size: 13px;
    fill: var(--text-muted);
  }
</style>
