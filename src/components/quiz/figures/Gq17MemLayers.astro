---
// Quiz figure for go-observability set 02: four memory counters of one pod on a shared MiB scale.
// The heap numbers are assumed in the set's context text. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const X0 = 214, W = 300, MAX = 900;
const bars = [
  { key: 'container_memory_working_set_bytes', v: 900, en: 'Container counter', vi: 'Bộ đếm của container', y: 58 },
  { key: 'HeapSys', v: 56, en: 'Go runtime', vi: 'Go runtime', y: 104 },
  { key: 'HeapInuse', v: 48, en: 'Go runtime', vi: 'Go runtime', y: 150 },
  { key: 'HeapAlloc', v: 40, en: 'Go runtime', vi: 'Go runtime', y: 196 },
];
const w = (v: number) => Math.max(3, (v * W) / MAX);
---
<div class="qfig-gq17ml">
  <svg viewBox="0 0 580 240" role="img" aria-label="Four horizontal bars on one MiB scale: container working set 900, HeapSys 56, HeapInuse 48, HeapAlloc 40.">
    <text x="0" y="22" class="qfig-gq17ml-h">
      <tspan data-lang-en>One pod, four memory counters (MiB)</tspan>
      <tspan data-lang-vi>Một pod, bốn bộ đếm bộ nhớ (MiB)</tspan>
    </text>
    {bars.map((b) => (
      <g>
        <text x="0" y={b.y} class="qfig-gq17ml-k">{b.key.length > 22 ? 'container_memory_' : b.key}</text>
        {b.key.length > 22 && <text x="0" y={b.y + 17} class="qfig-gq17ml-k">working_set_bytes</text>}
        <text x="0" y={b.y + (b.key.length > 22 ? 34 : 17)} class="qfig-gq17ml-s">
          <tspan data-lang-en>{b.en}</tspan>
          <tspan data-lang-vi>{b.vi}</tspan>
        </text>
        <rect x={X0} y={b.y - 14} width={w(b.v)} height="26" rx="4" class="qfig-gq17ml-bar" />
        <text x={X0 + w(b.v) + 8} y={b.y + 5} class="qfig-gq17ml-v">{b.v}</text>
      </g>
    ))}
    <line x1={X0} x2={X0} y1="40" y2="226" class="qfig-gq17ml-axis" />
  </svg>
</div>

<style>
  .qfig-gq17ml { margin: 0; width: 100%; }
  .qfig-gq17ml svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq17ml text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq17ml .qfig-gq17ml-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq17ml .qfig-gq17ml-k { font-weight: 700; fill: var(--text); }
  .qfig-gq17ml .qfig-gq17ml-s { fill: var(--text-muted); }
  .qfig-gq17ml .qfig-gq17ml-v { font-weight: 700; fill: var(--text); }
  .qfig-gq17ml-bar { fill: var(--act-3); }
  .qfig-gq17ml-axis { stroke: var(--text-muted); stroke-width: 1.5; }
</style>
