---
// Quiz figure for the Go hardware post, set 02: two cores, each with an L1 cache, and one memory line
// that holds two fields. It names things and shows offsets; it does not say what happens.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
---
<div class="qfig-gq16fs">
  <svg viewBox="0 0 580 270" role="img" aria-label="Two cores, each with its own L1 cache, and one 64-byte memory line that holds field a at offset 0 and field b at offset 8.">
    <rect x="30" y="14" width="220" height="86" rx="8" class="qfig-gq16fs-core" />
    <text x="46" y="38" class="qfig-gq16fs-t">
      <tspan data-lang-en>Core 1 · goroutine uses c.a</tspan>
      <tspan data-lang-vi>Nhân 1 · goroutine dùng c.a</tspan>
    </text>
    <rect x="46" y="52" width="188" height="34" rx="5" class="qfig-gq16fs-l1" />
    <text x="140" y="74" text-anchor="middle" class="qfig-gq16fs-b">
      <tspan data-lang-en>own L1 cache</tspan>
      <tspan data-lang-vi>L1 cache riêng</tspan>
    </text>

    <rect x="330" y="14" width="220" height="86" rx="8" class="qfig-gq16fs-core" />
    <text x="346" y="38" class="qfig-gq16fs-t">
      <tspan data-lang-en>Core 2 · goroutine uses c.b</tspan>
      <tspan data-lang-vi>Nhân 2 · goroutine dùng c.b</tspan>
    </text>
    <rect x="346" y="52" width="188" height="34" rx="5" class="qfig-gq16fs-l1" />
    <text x="440" y="74" text-anchor="middle" class="qfig-gq16fs-b">
      <tspan data-lang-en>own L1 cache</tspan>
      <tspan data-lang-vi>L1 cache riêng</tspan>
    </text>

    <line x1="140" x2="140" y1="100" y2="168" class="qfig-gq16fs-wire" />
    <line x1="440" x2="440" y1="100" y2="168" class="qfig-gq16fs-wire" />

    <text x="30" y="160" class="qfig-gq16fs-m">
      <tspan data-lang-en>one 64-byte line in memory</tspan>
      <tspan data-lang-vi>một dòng 64 byte trong bộ nhớ</tspan>
    </text>
    <rect x="30" y="170" width="520" height="40" rx="4" class="qfig-gq16fs-line" />
    <rect x="30" y="170" width="65" height="40" rx="4" class="qfig-gq16fs-fa" />
    <rect x="95" y="170" width="65" height="40" class="qfig-gq16fs-fb" />
    <text x="62" y="195" text-anchor="middle" class="qfig-gq16fs-t">a</text>
    <text x="127" y="195" text-anchor="middle" class="qfig-gq16fs-t">b</text>
    <text x="355" y="195" text-anchor="middle" class="qfig-gq16fs-m">
      <tspan data-lang-en>other bytes</tspan>
      <tspan data-lang-vi>các byte khác</tspan>
    </text>
    <text x="30" y="232" class="qfig-gq16fs-m">offset 0</text>
    <text x="95" y="232" class="qfig-gq16fs-m">offset 8</text>
    <text x="550" y="232" text-anchor="end" class="qfig-gq16fs-m">offset 63</text>
  </svg>
</div>

<style>
  .qfig-gq16fs { margin: 0; width: 100%; }
  .qfig-gq16fs svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq16fs text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq16fs .qfig-gq16fs-t { font-weight: 700; fill: var(--text); }
  .qfig-gq16fs .qfig-gq16fs-b { fill: var(--text-body); }
  .qfig-gq16fs .qfig-gq16fs-m { fill: var(--text-muted); }
  .qfig-gq16fs-core { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-gq16fs-l1 { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-gq16fs-wire { stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .qfig-gq16fs-line { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-gq16fs-fa { fill: var(--act-3); opacity: 0.45; stroke: var(--text-muted); stroke-width: 1; }
  .qfig-gq16fs-fb { fill: var(--act-3); opacity: 0.25; stroke: var(--text-muted); stroke-width: 1; }
</style>
