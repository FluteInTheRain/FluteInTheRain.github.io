---
// Quiz figure for go-observability set 06: the three tables of one benchstat run (v1 vs v2 of encodeTodos),
// copied from the post's terminal output. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const blocks = [
  { en: 'sec/op', vi: 'sec/op', rows: [
    ['items=10', '1.628µ ± 5%', '1.020µ ± 4%', '-37.30% (p=0.000)'],
    ['items=200', '26.82µ ± 8%', '22.03µ ± 3%', '-17.87% (p=0.000)'],
    ['geomean', '6.607µ', '4.741µ', '-28.24%'],
  ] },
  { en: 'B/op', vi: 'B/op', rows: [
    ['items=10', '608.0 ± 0%', '576.0 ± 0%', '-5.26% (p=0.000)'],
    ['items=200', '10.73Ki ± 0%', '12.00Ki ± 0%', '+11.86% (p=0.000)'],
    ['geomean', '2.524Ki', '2.598Ki', '+2.94%'],
  ] },
  { en: 'allocs/op', vi: 'allocs/op', rows: [
    ['items=10', '4.000 ± 0%', '1.000 ± 0%', '-75.00% (p=0.000)'],
    ['items=200', '4.000 ± 0%', '1.000 ± 0%', '-75.00% (p=0.000)'],
    ['geomean', '4.000', '1.000', '-75.00%'],
  ] },
];
const C = [0, 100, 224, 348];
const top = (i: number) => 52 + i * 112;
---
<div class="qfig-gq17bt">
  <svg viewBox="0 0 600 392" role="img" aria-label="Three benchstat tables for EncodeTodos, v1 against v2, with rows for items=10, items=200 and geomean.">
    <text x="0" y="20" class="qfig-gq17bt-h">
      <tspan data-lang-en>benchstat v1.txt v2.txt (n=10 runs per side)</tspan>
      <tspan data-lang-vi>benchstat v1.txt v2.txt (n=10 lần chạy mỗi bên)</tspan>
    </text>
    {blocks.map((b, i) => (
      <g>
        <rect x="0" y={top(i) - 18} width="600" height="102" rx="8" class="qfig-gq17bt-card" />
        <text x="12" y={top(i)} class="qfig-gq17bt-t">{b.en}</text>
        <text x={C[1] + 12} y={top(i)} class="qfig-gq17bt-m">v1</text>
        <text x={C[2] + 12} y={top(i)} class="qfig-gq17bt-m">v2</text>
        <text x={C[3] + 12} y={top(i)} class="qfig-gq17bt-m">
          <tspan data-lang-en>vs base</tspan>
          <tspan data-lang-vi>so với base</tspan>
        </text>
        {b.rows.map((r, j) => (
          <g>
            <text x="12" y={top(i) + 24 + j * 22} class="qfig-gq17bt-b">{r[0]}</text>
            <text x={C[1] + 12} y={top(i) + 24 + j * 22} class="qfig-gq17bt-b">{r[1]}</text>
            <text x={C[2] + 12} y={top(i) + 24 + j * 22} class="qfig-gq17bt-b">{r[2]}</text>
            <text x={C[3] + 12} y={top(i) + 24 + j * 22} class="qfig-gq17bt-t">{r[3]}</text>
          </g>
        ))}
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-gq17bt { margin: 0; width: 100%; }
  .qfig-gq17bt svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq17bt text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq17bt .qfig-gq17bt-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq17bt .qfig-gq17bt-t { font-weight: 700; fill: var(--text); }
  .qfig-gq17bt .qfig-gq17bt-b { fill: var(--text-body); }
  .qfig-gq17bt .qfig-gq17bt-m { fill: var(--text-muted); }
  .qfig-gq17bt-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
</style>
