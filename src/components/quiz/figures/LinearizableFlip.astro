---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for consistency-consensus set 01: four logged operation intervals for feature flag maintenance_mode.
// Shows only the raw intervals and returned values; never draws a flip point or validity verdict.
// Plain inline SVG, site CSS tokens only, no <marker>/<defs>/id.

const W = 580;
const H = 318;
const x0 = 122;
const scale = 0.96; // 0..450 ms fits cleanly in 122..554
const tx = (ms: number) => x0 + ms * scale;
const ticks = [0, 100, 200, 300, 400];
const axisY = 266;

const lanes = [
  { id: 'writer', y: 86, icon: 'server', en: 'Writer', vi: 'Writer', start: 100, end: 420, isWrite: true },
  { id: 'm', y: 136, icon: 'laptop', en: 'Client M', vi: 'Client M', start: 80, end: 150, isWrite: false },
  { id: 'n', y: 186, icon: 'phone', en: 'Client N', vi: 'Client N', start: 210, end: 290, isWrite: false },
  { id: 'p', y: 236, icon: 'desktop', en: 'Client P', vi: 'Client P', start: 310, end: 390, isWrite: false },
];
---
<div class="qfig-lf">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Logged millisecond intervals for maintenance_mode starting at off: Writer runs Write(on) to OK from 100 to 420 ms, Client M reads off from 80 to 150 ms, Client N reads on from 210 to 290 ms, and Client P reads off from 310 to 390 ms.">
    <text x="0" y="22" class="qfig-lf-h">
      <tspan data-lang-en>Logged request intervals for maintenance_mode</tspan>
      <tspan data-lang-vi>Khoảng thời gian request với maintenance_mode</tspan>
    </text>
    <text x="0" y="43" class="qfig-lf-sub">
      <tspan data-lang-en>Left edge = request sent; right edge = reply received. Starts "off".</tspan>
      <tspan data-lang-vi>Đầu trái = gửi request; đầu phải = nhận phản hồi. Ban đầu "off".</tspan>
    </text>

    {/* vertical millisecond grid */}
    {ticks.map((t) => (
      <line x1={tx(t)} x2={tx(t)} y1="60" y2={axisY} class="qfig-lf-grid" />
    ))}

    {/* lane separators and labels */}
    {lanes.map((l, i) => (
      <g>
        {i > 0 && <line x1="0" x2={W} y1={l.y - 25} y2={l.y - 25} class="qfig-lf-rule" />}
        <DiagramIcon name={l.icon as any} x={14} y={l.y} size={22} />
        <text x="32" y={l.y + 5} class="qfig-lf-lane">
          <tspan data-lang-en>{l.en}</tspan>
          <tspan data-lang-vi>{l.vi}</tspan>
        </text>
      </g>
    ))}

    {/* Writer bar */}
    <rect x={tx(100)} y={86 - 13} width={(420 - 100) * scale} height="26" rx="4" class="qfig-lf-write" />
    <text x={(tx(100) + tx(420)) / 2} y={86 + 5} text-anchor="middle" class="qfig-lf-bar-t">
      <tspan data-lang-en>Write("on") → OK  [100, 420]</tspan>
      <tspan data-lang-vi>Ghi("on") → OK  [100, 420]</tspan>
    </text>

    {/* Client M bar */}
    <rect x={tx(80)} y={136 - 13} width={(150 - 80) * scale} height="26" rx="4" class="qfig-lf-read" />
    <text x={tx(150) + 8} y={136 + 5} class="qfig-lf-bar-t">
      <tspan data-lang-en>Read → "off"  [80, 150]</tspan>
      <tspan data-lang-vi>Đọc → "off"  [80, 150]</tspan>
    </text>

    {/* Client N bar */}
    <rect x={tx(210)} y={186 - 13} width={(290 - 210) * scale} height="26" rx="4" class="qfig-lf-read" />
    <text x={tx(210) - 8} y={186 + 5} text-anchor="end" class="qfig-lf-bar-t">
      <tspan data-lang-en>Read → "on"  [210, 290]</tspan>
      <tspan data-lang-vi>Đọc → "on"  [210, 290]</tspan>
    </text>

    {/* Client P bar */}
    <rect x={tx(310)} y={236 - 13} width={(390 - 310) * scale} height="26" rx="4" class="qfig-lf-read" />
    <text x={tx(310) - 8} y={236 + 5} text-anchor="end" class="qfig-lf-bar-t">
      <tspan data-lang-en>Read → "off"  [310, 390]</tspan>
      <tspan data-lang-vi>Đọc → "off"  [310, 390]</tspan>
    </text>

    {/* Time axis */}
    <line x1={x0} x2={W - 12} y1={axisY} y2={axisY} class="qfig-lf-axis" />
    {ticks.map((t) => (
      <g>
        <line x1={tx(t)} x2={tx(t)} y1={axisY} y2={axisY + 5} class="qfig-lf-axis" />
        <text x={tx(t)} y={axisY + 21} text-anchor="middle" class="qfig-lf-sub">{t}</text>
      </g>
    ))}
    <text x="0" y={axisY + 21} class="qfig-lf-sub">
      <tspan data-lang-en>Time (ms)</tspan>
      <tspan data-lang-vi>Thời gian (ms)</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-lf { margin: 0; width: 100%; }
  .qfig-lf svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-lf text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-lf .qfig-lf-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-lf .qfig-lf-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-lf .qfig-lf-bar-t { font-size: 13.5px; font-weight: 600; fill: var(--text); }
  .qfig-lf .qfig-lf-sub { font-size: 13px; fill: var(--text-muted); }
  .qfig-lf-grid { stroke: var(--border); stroke-width: 1; }
  .qfig-lf-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-lf-write { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .qfig-lf-read { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-lf-axis { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
