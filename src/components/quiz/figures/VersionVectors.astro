---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for set 08: two phones add to the same list at the same time through two different replicas.
// Inline SVG, site tokens only, no <marker>/<defs>. Shows each replica's list and version, never an outcome.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 7 * Math.cos(a)} ${y2 - 7 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const cards = [
  { x: 0, name: 'A', list: 'tent, stove', ver: '{A:2}' },
  { x: 200, name: 'B', list: 'tent, lamp', ver: '{A:1, B:1}' },
  { x: 400, name: 'C', list: 'tent', ver: '{A:1}' },
];
const aMai = arrow(90, 104, 90, 152);
const aLong = arrow(290, 104, 290, 152);
---
<div class="qfig-vv">
  <svg viewBox="0 0 580 400" role="img" aria-label="Two phones add an item to the same list at the same time. One write reaches replica A and the other reaches replica B. Replica C still holds the original list.">
    <text x="0" y="22" class="qfig-vv-h">
      <tspan data-lang-en>Trip alps: two writes, neither saw the other</tspan>
      <tspan data-lang-vi>Chuyến alps: hai lần ghi, bên nào cũng chưa thấy bên kia</tspan>
    </text>

    <DiagramIcon name="phone" x="22" y="76" size={28} />
    <text x="52" y="72" class="qfig-vv-t">
      <tspan data-lang-en>Mai adds stove</tspan>
      <tspan data-lang-vi>Mai thêm stove</tspan>
    </text>
    <text x="52" y="92" class="qfig-vv-m">
      <tspan data-lang-en>read tent at {'{A:1}'}</tspan>
      <tspan data-lang-vi>đã đọc tent ở {'{A:1}'}</tspan>
    </text>
    <DiagramIcon name="phone" x="222" y="76" size={28} />
    <text x="252" y="72" class="qfig-vv-t">
      <tspan data-lang-en>Long adds lamp</tspan>
      <tspan data-lang-vi>Long thêm lamp</tspan>
    </text>
    <text x="252" y="92" class="qfig-vv-m">
      <tspan data-lang-en>read tent at {'{A:1}'}</tspan>
      <tspan data-lang-vi>đã đọc tent ở {'{A:1}'}</tspan>
    </text>

    <g class="qfig-vv-go"><path d={aMai.line} /><polygon points={aMai.head} /></g>
    <g class="qfig-vv-go"><path d={aLong.line} /><polygon points={aLong.head} /></g>

    {cards.map((c) => (
      <g class="qfig-vv-card">
        <rect x={c.x} y="156" width="180" height="128" rx="8" />
        <DiagramIcon name="server" x={c.x + 26} y="184" size={26} />
        <text x={c.x + 52} y="190" class="qfig-vv-t">
          <tspan data-lang-en>Replica {c.name}</tspan>
          <tspan data-lang-vi>Replica {c.name}</tspan>
        </text>
        <text x={c.x + 14} y="228" class="qfig-vv-m">
          <tspan data-lang-en>List</tspan>
          <tspan data-lang-vi>Danh sách</tspan>
        </text>
        <text x={c.x + 14} y="248" class="qfig-vv-n">{c.list}</text>
        <text x={c.x + 14} y="272" class="qfig-vv-m">
          <tspan data-lang-en>Version {c.ver}</tspan>
          <tspan data-lang-vi>Phiên bản {c.ver}</tspan>
        </text>
      </g>
    ))}

    <g class="qfig-vv-gap">
      <path d="M 90 288 L 90 316 L 290 316 L 290 288" />
      <text x="190" y="340">
        <tspan data-lang-en>Not copied between A and B yet</tspan>
        <tspan data-lang-vi>Chưa được chép giữa A và B</tspan>
      </text>
    </g>

    <text x="0" y="376" class="qfig-vv-m">
      <tspan data-lang-en>Version: one counter per replica; {'{A:1}'} means A has counted 1 write.</tspan>
      <tspan data-lang-vi>Phiên bản: mỗi replica một bộ đếm; {'{A:1}'} nghĩa là A đã đếm 1 lần ghi.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-vv { margin: 0; width: 100%; }
  .qfig-vv svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-vv text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-vv .qfig-vv-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-vv .qfig-vv-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-vv .qfig-vv-n { font-size: 16px; font-weight: 600; fill: var(--text); }
  .qfig-vv .qfig-vv-m { fill: var(--text-muted); }
  .qfig-vv-go path { stroke: var(--gold); stroke-width: 1.8; fill: none; }
  .qfig-vv-go polygon { fill: var(--gold); }
  .qfig-vv-card rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-vv-gap path { stroke: var(--red); stroke-width: 2; fill: none; stroke-dasharray: 6 4; }
  .qfig-vv .qfig-vv-gap text { fill: var(--red); font-weight: 700; text-anchor: middle; }
</style>
