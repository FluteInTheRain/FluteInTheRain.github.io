---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for set 08: an append-only event log of a rewards service, a projection worker
// that replays it, one live view and one view the team has not built yet.
// Inline SVG, site tokens only, no <marker>/<defs>. Shows only the scenario's inputs, never a computed result.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 7 * Math.cos(a)} ${y2 - 7 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const chips = [
  { en: 'Earned', vi: 'Cộng điểm' },
  { en: 'Spent', vi: 'Tiêu điểm' },
  { en: 'Earned', vi: 'Cộng điểm' },
  { en: 'Earned', vi: 'Cộng điểm' },
  { en: 'Spent', vi: 'Tiêu điểm' },
];
const a0 = arrow(290, 152, 290, 200);
const a1 = arrow(190, 262, 140, 304);
const a2 = arrow(390, 262, 440, 304);
---
<div class="qfig-elog">
  <svg viewBox="0 0 580 396" role="img" aria-label="An append-only log of points events feeds a projection worker. The worker builds a balances view, and a second view for a new expiry rule has not been built yet.">
    <text x="0" y="22" class="qfig-elog-h">
      <tspan data-lang-en>Rewards service: every points change is an event</tspan>
      <tspan data-lang-vi>Dịch vụ điểm thưởng: mỗi lần đổi điểm là một event</tspan>
    </text>

    <rect x="0" y="40" width="580" height="112" rx="8" class="qfig-elog-log" />
    <DiagramIcon name="log" x="30" y="84" size={26} />
    {chips.map((c, i) => (
      <g>
        <rect x={64 + i * 84} y="66" width="78" height="32" rx="6" class="qfig-elog-chip" />
        <text x={64 + i * 84 + 39} y="87" class="qfig-elog-ct">
          <tspan data-lang-en>{c.en}</tspan>
          <tspan data-lang-vi>{c.vi}</tspan>
        </text>
      </g>
    ))}
    <rect x="484" y="66" width="78" height="32" rx="6" class="qfig-elog-next" />
    <text x="523" y="87" class="qfig-elog-ct qfig-elog-m">
      <tspan data-lang-en>next</tspan>
      <tspan data-lang-vi>tiếp theo</tspan>
    </text>
    <text x="64" y="122" class="qfig-elog-b">
      <tspan data-lang-en>Append-only log: 90,000,000 events, never edited</tspan>
      <tspan data-lang-vi>Log chỉ ghi nối: 90.000.000 event, không bao giờ sửa</tspan>
    </text>
    <text x="64" y="142" class="qfig-elog-m">
      <tspan data-lang-en>Grows by 3,000,000 events per day</tspan>
      <tspan data-lang-vi>Mỗi ngày thêm 3.000.000 event</tspan>
    </text>

    <g class="qfig-elog-go"><path d={a0.line} /><polygon points={a0.head} /></g>

    <rect x="110" y="202" width="360" height="60" rx="8" class="qfig-elog-box" />
    <DiagramIcon name="worker" x="140" y="232" size={26} />
    <text x="172" y="226" class="qfig-elog-b">
      <tspan data-lang-en>Projection worker</tspan>
      <tspan data-lang-vi>Projection worker</tspan>
    </text>
    <text x="172" y="248" class="qfig-elog-m">
      <tspan data-lang-en>Replays 15,000 events per second</tspan>
      <tspan data-lang-vi>Replay 15.000 event mỗi giây</tspan>
    </text>

    <g class="qfig-elog-go"><path d={a1.line} /><polygon points={a1.head} /></g>
    <g class="qfig-elog-go"><path d={a2.line} /><polygon points={a2.head} /></g>

    <rect x="0" y="306" width="280" height="84" rx="8" class="qfig-elog-box" />
    <DiagramIcon name="db" x="30" y="348" size={26} />
    <text x="62" y="340" class="qfig-elog-b">
      <tspan data-lang-en>View: balances</tspan>
      <tspan data-lang-vi>View: balances</tspan>
    </text>
    <text x="62" y="362" class="qfig-elog-m">
      <tspan data-lang-en>Current points per member</tspan>
      <tspan data-lang-vi>Điểm hiện tại của mỗi member</tspan>
    </text>

    <rect x="300" y="306" width="280" height="84" rx="8" class="qfig-elog-new" />
    <DiagramIcon name="calendar" x="330" y="348" size={26} />
    <text x="362" y="340" class="qfig-elog-b">
      <tspan data-lang-en>New view: not built yet</tspan>
      <tspan data-lang-vi>View mới: chưa dựng</tspan>
    </text>
    <text x="362" y="362" class="qfig-elog-m">
      <tspan data-lang-en>Points expire after 12 months</tspan>
      <tspan data-lang-vi>Điểm hết hạn sau 12 tháng</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-elog { margin: 0; width: 100%; }
  .qfig-elog svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-elog text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-elog .qfig-elog-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-elog .qfig-elog-b { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-elog .qfig-elog-m { fill: var(--text-muted); }
  .qfig-elog .qfig-elog-ct { font-size: 13px; text-anchor: middle; fill: var(--text); }
  .qfig-elog-log { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-elog-chip { fill: var(--bg); stroke: var(--gold); stroke-width: 1.2; }
  .qfig-elog-next { fill: none; stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .qfig-elog-box { fill: var(--bg-alt); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-elog-new { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 6 4; }
  .qfig-elog-go path { stroke: var(--gold); stroke-width: 1.8; fill: none; }
  .qfig-elog-go polygon { fill: var(--gold); }
</style>
