---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for distributed failures set 08: a Raft store targeting partially synchronous + crash-recovery
// sees a 1 Kb/s NIC with /health 200 OK and firmware forgetting flushed disk blocks after reboot.
// Two replays with seed = 481516 diverge on send order without revealing why.
// Inline SVG, site tokens only, no marker/defs/ids.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const seedToSim = arrow(160, 173, 186, 173);
---
<div class="qfig-dsr">
  <svg viewBox="0 0 580 416" role="img" aria-label="A Raft metadata store targeting partially synchronous crash-recovery hits a 1 Kb/s NIC returning /health 200 OK and firmware reboot block loss. Under seeded DST with seed 481516 mocking network, disk, clock, and PRNG, Run 1 sends N2 then N3 while Run 2 sends N3 then N2 and diverges.">
    <text x="8" y="22" class="qfig-dsr-h">
      <tspan data-lang-en>Seed 481516: two replays of the same fault trace</tspan>
      <tspan data-lang-vi>Seed 481516: hai lần phát lại cùng vết sự cố</tspan>
    </text>

    <!-- Target model & production symptoms -->
    <rect x="8" y="36" width="564" height="86" rx="8" class="qfig-dsr-box" />
    <DiagramIcon name="server" x={30} y={56} size={22} />
    <text x="48" y="61" class="qfig-dsr-b">
      <tspan data-lang-en>Raft store (Go / Rust) · partially sync + crash-recovery</tspan>
      <tspan data-lang-vi>Kho Raft (Go / Rust) · partially sync + crash-recovery</tspan>
    </text>

    <rect x="20" y="76" width="264" height="36" rx="6" class="qfig-dsr-hot" />
    <DiagramIcon name="network" x={38} y={94} size={18} />
    <text x="54" y="99" class="qfig-dsr-r">
      <tspan data-lang-en>NIC 1 Kb/s, /health 200 OK</tspan>
      <tspan data-lang-vi>NIC 1 Kb/s, /health 200 OK</tspan>
    </text>

    <rect x="296" y="76" width="264" height="36" rx="6" class="qfig-dsr-hot" />
    <DiagramIcon name="disk" x={314} y={94} size={18} />
    <text x="330" y="99" class="qfig-dsr-r">
      <tspan data-lang-en>Reboot forgets flushed blocks</tspan>
      <tspan data-lang-vi>Reboot quên block đã flush</tspan>
    </text>

    <!-- Seeded DST harness -->
    <rect x="8" y="138" width="152" height="70" rx="8" class="qfig-dsr-gold" />
    <DiagramIcon name="retry" x={30} y={162} size={20} />
    <text x="46" y="166" class="qfig-dsr-b">seed = 481516</text>
    <text x="20" y="191" class="qfig-dsr-m">
      <tspan data-lang-en>fixed test seed</tspan>
      <tspan data-lang-vi>seed cố định</tspan>
    </text>

    <path d={seedToSim.line} class="qfig-dsr-lng" /><polygon points={seedToSim.head} class="qfig-dsr-hdg" />

    <rect x="186" y="138" width="386" height="70" rx="8" class="qfig-dsr-box" />
    <text x="200" y="159" class="qfig-dsr-b">
      <tspan data-lang-en>Simulator mocks nondeterminism:</tspan>
      <tspan data-lang-vi>Bộ mô phỏng giả lập các nguồn bất định:</tspan>
    </text>
    <DiagramIcon name="network" x={210} y={186} size={18} />
    <text x="224" y="191" class="qfig-dsr-t">
      <tspan data-lang-en>Net</tspan>
      <tspan data-lang-vi>Mạng</tspan>
    </text>
    <DiagramIcon name="disk" x={290} y={186} size={18} />
    <text x="304" y="191" class="qfig-dsr-t">
      <tspan data-lang-en>Disk</tspan>
      <tspan data-lang-vi>Đĩa</tspan>
    </text>
    <DiagramIcon name="clock" x={368} y={186} size={18} />
    <text x="382" y="191" class="qfig-dsr-t">
      <tspan data-lang-en>Clock</tspan>
      <tspan data-lang-vi>Giờ</tspan>
    </text>
    <DiagramIcon name="random" x={450} y={186} size={18} />
    <text x="464" y="191" class="qfig-dsr-t">PRNG</text>

    <!-- Diverging runs -->
    <rect x="8" y="226" width="564" height="66" rx="8" class="qfig-dsr-gold" />
    <DiagramIcon name="terminal" x={30} y={248} size={20} />
    <text x="48" y="252" class="qfig-dsr-b">
      <tspan data-lang-en>Run 1 (seed = 481516)</tspan>
      <tspan data-lang-vi>Lần chạy 1 (seed = 481516)</tspan>
    </text>
    <text x="48" y="276" class="qfig-dsr-t">
      <tspan data-lang-en>Send order: N2, then N3   |   leader elected   |   pass</tspan>
      <tspan data-lang-vi>Thứ tự gửi: N2 rồi N3   |   bầu được leader   |   đạt</tspan>
    </text>

    <rect x="8" y="306" width="564" height="66" rx="8" class="qfig-dsr-hot" />
    <DiagramIcon name="bug" x={30} y={328} size={20} />
    <text x="48" y="332" class="qfig-dsr-r">
      <tspan data-lang-en>Run 2 (seed = 481516)</tspan>
      <tspan data-lang-vi>Lần chạy 2 (seed = 481516)</tspan>
    </text>
    <text x="48" y="356" class="qfig-dsr-t">
      <tspan data-lang-en>Send order: N3, then N2   |   split vote   |   diverges (?)</tspan>
      <tspan data-lang-vi>Thứ tự gửi: N3 rồi N2   |   chia phiếu   |   lệch (?)</tspan>
    </text>

    <text x="8" y="398" class="qfig-dsr-m">
      <tspan data-lang-en>Same binary and seed 481516, yet message order and memory usage differ.</tspan>
      <tspan data-lang-vi>Cùng binary và seed 481516, nhưng thứ tự gửi tin và mức nhớ lại khác nhau.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-dsr { margin: 0; width: 100%; }
  .qfig-dsr svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-dsr text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-dsr .qfig-dsr-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-dsr .qfig-dsr-b { font-weight: 700; fill: var(--text); }
  .qfig-dsr .qfig-dsr-t { fill: var(--text); }
  .qfig-dsr .qfig-dsr-m { fill: var(--text-muted); }
  .qfig-dsr .qfig-dsr-r { font-weight: 700; fill: var(--red); }
  .qfig-dsr-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .qfig-dsr-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-dsr-gold { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .qfig-dsr-lng { fill: none; stroke: var(--gold); stroke-width: 2; }
  .qfig-dsr-hdg { fill: var(--gold); }
</style>
