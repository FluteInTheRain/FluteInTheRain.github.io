---
// Quiz figure for Post 6 (depth and shadows): a card with a dropdown opened over it, shadows as written in the CSS.
const FILT = [
  { id: 'u06b-card', layers: [{ y: 12, b: 28, s: 0, o: 0.26 }] },
  { id: 'u06b-menu', layers: [{ y: 2, b: 4, s: 0, o: 0.22 }] },
];
---
<div class="qfig-uxq06elevationstack">
  <svg viewBox="0 0 600 290" role="img" aria-label="A card with a large soft shadow, 0 12px 28px. A dropdown menu opened over the card has a small tight shadow, 0 2px 4px. The card looks as if it floats higher than the menu that sits on top of it.">
    <defs>
      {FILT.map((d) => (
        <filter id={d.id} x="-25%" y="-30%" width="150%" height="190%" color-interpolation-filters="sRGB">
          {d.layers.map((l, k) => (
            <>
              <feGaussianBlur in="SourceAlpha" stdDeviation={l.b / 2} result={`b${k}`} />
              <feOffset in={`b${k}`} dx="0" dy={l.y} result={`o${k}`} />
              <feFlood style={`flood-color: var(--band-bg); flood-opacity: ${l.o}`} result={`f${k}`} />
              <feComposite in={`f${k}`} in2={`o${k}`} operator="in" result={`s${k}`} />
            </>
          ))}
          <feMerge>
            {d.layers.map((_, k) => <feMergeNode in={`s${k}`} />)}
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      ))}
    </defs>
    <rect x="8" y="8" width="584" height="274" rx="10" class="page" />

    <rect x="40" y="36" width="330" height="190" rx="10" class="card" filter="url(#u06b-card)" />
    <text x="60" y="66" class="h"><tspan data-lang-en>Card</tspan><tspan data-lang-vi>Thẻ nội dung</tspan></text>
    <text x="60" y="88" class="m">box-shadow: 0 12px 28px</text>
    <line x1="60" y1="110" x2="250" y2="110" class="bar" />
    <line x1="60" y1="128" x2="200" y2="128" class="bar" />

    <rect x="270" y="132" width="290" height="124" rx="8" class="menu" filter="url(#u06b-menu)" />
    <text x="290" y="160" class="h"><tspan data-lang-en>Dropdown menu</tspan><tspan data-lang-vi>Menu thả xuống</tspan></text>
    <text x="290" y="182" class="m">box-shadow: 0 2px 4px</text>
    <line x1="290" y1="204" x2="460" y2="204" class="bar" />
    <line x1="290" y1="222" x2="520" y2="222" class="bar" />
    <line x1="290" y1="240" x2="420" y2="240" class="bar" />
  </svg>
</div>

<style>
  .qfig-uxq06elevationstack { margin: 0; width: 100%; }
  .qfig-uxq06elevationstack svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq06elevationstack text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq06elevationstack .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-uxq06elevationstack .m { fill: var(--text-muted); font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12.5px; }
  .qfig-uxq06elevationstack .page { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq06elevationstack .card { fill: var(--card-bg); stroke: var(--border); stroke-width: 1; }
  .qfig-uxq06elevationstack .menu { fill: var(--card-bg); stroke: var(--border); stroke-width: 1; }
  .qfig-uxq06elevationstack .bar { stroke: var(--border); stroke-width: 5; stroke-linecap: round; }
</style>
