---
// Quiz figure for the up-day set: a fair coin over 1,500 days (mean 750, sd 19.4) with the record at 783 up days.
// Tails beyond 783 and 717 shaded; exact two-sided binomial p = 0.093 (scipy). No ids or markers.
const MEAN = 750, SD = Math.sqrt(1500 * 0.25), K0 = MEAN - 3.2 * SD, K1 = MEAN + 3.2 * SD;
const X0 = 20, X1 = 560, YB = 150, YH = 100;
const kx = (k: number) => X0 + ((k - K0) / (K1 - K0)) * (X1 - X0);
const ky = (k: number) => YB - Math.exp(-0.5 * ((k - MEAN) / SD) ** 2) * YH;
function area(a: number, b: number) {
  let d = `M ${kx(a).toFixed(1)} ${YB}`;
  for (let i = 0; i <= 30; i++) { const k = a + ((b - a) * i) / 30; d += ` L ${kx(k).toFixed(1)} ${ky(k).toFixed(1)}`; }
  return d + ` L ${kx(b).toFixed(1)} ${YB} Z`;
}
let curve = '';
for (let i = 0; i <= 90; i++) { const k = K0 + ((K1 - K0) * i) / 90; curve += `${i ? 'L' : 'M'} ${kx(k).toFixed(1)} ${ky(k).toFixed(1)} `; }
---
<div class="qfig-atq04ct">
  <svg viewBox="0 0 580 196" role="img" aria-label="A bell curve of up days from a fair coin over 1,500 flips, centred at 750. A red line marks the record of 783 up days, a dashed line marks 717, and the two tails beyond them are shaded.">
    <text x="20" y="18" class="qfig-atq04ct-h">
      <tspan data-lang-en>Up days out of 1,500 fair flips</tspan>
      <tspan data-lang-vi>Số ngày tăng trong 1.500 lần tung đồng xu công bằng</tspan>
    </text>
    <path d={area(K0, MEAN - 33)} class="qfig-atq04ct-tail" />
    <path d={area(MEAN + 33, K1)} class="qfig-atq04ct-tail" />
    <path d={curve} class="qfig-atq04ct-curve" />
    <line x1={X0} x2={X1} y1={YB} y2={YB} class="qfig-atq04ct-axis" />
    <line x1={kx(MEAN + 33)} x2={kx(MEAN + 33)} y1="34" y2={YB} class="qfig-atq04ct-obs" />
    <line x1={kx(MEAN - 33)} x2={kx(MEAN - 33)} y1="34" y2={YB} class="qfig-atq04ct-obs is-dash" />
    <text x={kx(MEAN + 33) + 6} y="44" class="qfig-atq04ct-lab">
      <tspan data-lang-en>783 up days</tspan>
      <tspan data-lang-vi>783 ngày tăng</tspan>
    </text>
    <text x={kx(MEAN - 33) - 6} y="44" text-anchor="end" class="qfig-atq04ct-sub">717</text>
    <text x={kx(MEAN)} y="172" text-anchor="middle" class="qfig-atq04ct-sub">750</text>
    <text x={kx(MEAN)} y="190" text-anchor="middle" class="qfig-atq04ct-sub">
      <tspan data-lang-en>shaded tails: 9% of fair-coin records</tspan>
      <tspan data-lang-vi>phần tô: 9% số kết quả của đồng xu công bằng</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-atq04ct svg { display: block; width: 100%; height: auto; max-width: 580px; margin: 0 auto; }
  .qfig-atq04ct text { font-size: 12.5px; fill: var(--text-body); }
  .qfig-atq04ct .qfig-atq04ct-h { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-atq04ct .qfig-atq04ct-lab { font-weight: 700; fill: var(--red); }
  .qfig-atq04ct .qfig-atq04ct-sub { fill: var(--text-muted); }
  .qfig-atq04ct-tail { fill: var(--red-tint-bg); }
  .qfig-atq04ct-curve { fill: none; stroke: var(--text); stroke-width: 1.6; }
  .qfig-atq04ct-axis { stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-atq04ct-obs { stroke: var(--red); stroke-width: 1.8; }
  .qfig-atq04ct-obs.is-dash { stroke-dasharray: 4 4; stroke-width: 1.4; }
</style>
