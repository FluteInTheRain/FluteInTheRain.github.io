---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 04 (sharding): viewers write to one counter key; a random suffix would turn it into
// salted keys stored on 20 shards; a page reads the total. Shows the setup only, no computed rates.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 330;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const gx = 328;
const gy = 70;
const cw = 44;
const ch = 30;
const gap = 6;
const cells = Array.from({ length: 20 }, (_, i) => ({
  x: gx + (i % 5) * (cw + gap),
  y: gy + Math.floor(i / 5) * (ch + gap),
  n: i + 1,
}));
const gridW = 5 * cw + 4 * gap;
const gridH = 4 * ch + 3 * gap;
const a1 = arrow(100, 110, 140, 110);
const a2 = arrow(306, 110, gx - 4, 110);
const a3 = arrow(gx + gridW / 2, 262, gx + gridW / 2, gy + gridH + 6);
---
<div class="sc">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Viewers write 60,000 times per second to one counter key, an optional random suffix turns it into salted keys, and those keys are stored on 20 shards while a page reads the total.">
    <text x="10" y="26" class="sc-h">
      <tspan data-lang-en>One counter key, 20 shards</tspan>
      <tspan data-lang-vi>Một key bộ đếm, 20 shard</tspan>
    </text>

    <DiagramIcon name="users" x={50} y={92} size={30} />
    <text x="50" y="138" text-anchor="middle" class="sc-name">
      <tspan data-lang-en>Viewers</tspan>
      <tspan data-lang-vi>Người xem</tspan>
    </text>
    <text x="50" y="156" text-anchor="middle" class="sc-num">
      <tspan data-lang-en>60,000 writes/s</tspan>
      <tspan data-lang-vi>60.000 ghi/giây</tspan>
    </text>
    <g class="sc-arrow"><path d={a1.line} /><polygon points={a1.head} /></g>

    <g class="sc-box">
      <rect x="140" y="62" width="166" height="96" rx="8" />
    </g>
    <DiagramIcon name="server" x={160} y={82} size={18} />
    <text x="176" y="87" class="sc-name">
      <tspan data-lang-en>App</tspan>
      <tspan data-lang-vi>Ứng dụng</tspan>
    </text>
    <text x="150" y="112" class="sc-key">views:item_42</text>
    <text x="150" y="132" class="sc-sub">
      <tspan data-lang-en>+ random suffix</tspan>
      <tspan data-lang-vi>+ hậu tố ngẫu nhiên</tspan>
    </text>
    <text x="150" y="150" class="sc-gold">#00 … #99</text>
    <g class="sc-arrow"><path d={a2.line} /><polygon points={a2.head} /></g>

    {cells.map((c) => (
      <g>
        <rect x={c.x} y={c.y} width={cw} height={ch} rx="4" class="sc-cell" />
        <text x={c.x + cw / 2} y={c.y + 20} text-anchor="middle" class="sc-cellnum">{c.n}</text>
      </g>
    ))}
    <text x={gx + gridW / 2} y={gy - 14} text-anchor="middle" class="sc-name">
      <tspan data-lang-en>20 shards, hash-sharded</tspan>
      <tspan data-lang-vi>20 shard, chia theo hash</tspan>
    </text>

    <DiagramIcon name="laptop" x={gx + gridW / 2 - 70} y={282} size={26} />
    <text x={gx + gridW / 2 - 50} y={278} class="sc-name">
      <tspan data-lang-en>Product page</tspan>
      <tspan data-lang-vi>Trang sản phẩm</tspan>
    </text>
    <text x={gx + gridW / 2 - 50} y={298} class="sc-num">
      <tspan data-lang-en>reads the total, 2,000/s</tspan>
      <tspan data-lang-vi>đọc tổng, 2.000/giây</tspan>
    </text>
    <g class="sc-arrow"><path d={a3.line} /><polygon points={a3.head} /></g>

    <text x="10" y="232" class="sc-note">
      <tspan data-lang-en>The total is the value of the key, or the sum</tspan>
      <tspan data-lang-vi>Tổng là giá trị của key, hoặc tổng của</tspan>
    </text>
    <text x="10" y="252" class="sc-note">
      <tspan data-lang-en>of its salted keys if it is salted.</tspan>
      <tspan data-lang-vi>các salted key nếu key đã được salt.</tspan>
    </text>
  </svg>
</div>

<style>
  .sc { width: 100%; }
  .sc svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .sc text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .sc .sc-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sc .sc-name { font-weight: 700; fill: var(--text); }
  .sc .sc-sub, .sc .sc-num { fill: var(--text-muted); }
  .sc .sc-key { fill: var(--text); font-weight: 700; }
  .sc .sc-gold { fill: var(--text); font-weight: 700; }
  .sc .sc-note { fill: var(--text-muted); }
  .sc .sc-cellnum { font-size: 13px; fill: var(--text-muted); }
  .sc-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .sc-cell { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .sc-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .sc-arrow polygon { fill: var(--text-muted); }
</style>
