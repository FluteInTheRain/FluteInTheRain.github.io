---
// Quiz figure for go-profiling set 04: a small CPU flame graph, root at the top.
// Width = samples out of 100. Names and counts only, no verdict. Inline SVG, site tokens only.
const U = 5.8, X0 = 10, H = 42, GAP = 4, Y0 = 32;
const row = (r: number) => Y0 + r * (H + GAP);
const boxes = [
  { r: 0, s: 0, n: 100, name: 'all', en: 'all samples', vi: 'mọi mẫu' },
  { r: 1, s: 0, n: 90, name: 'serve' },
  { r: 1, s: 90, n: 10, name: 'gc' },
  { r: 2, s: 0, n: 60, name: 'listTodos' },
  { r: 2, s: 60, n: 25, name: 'getTodo' },
  { r: 3, s: 0, n: 38, name: 'encode' },
  { r: 3, s: 38, n: 18, name: 'store.list' },
  { r: 3, s: 60, n: 25, name: 'lookup' },
  { r: 4, s: 0, n: 27, name: 'write' },
];
---
<div class="qfig-gq18fl">
  <svg viewBox="0 0 600 270" role="img" aria-label="A CPU flame graph with the root at the top. Boxes: serve 90, gc 10, listTodos 60, getTodo 25, encode 38, store.list 18, lookup 25, write 27 samples out of 100.">
    <text x="10" y="20" class="qfig-gq18fl-h">
      <tspan data-lang-en>CPU flame graph, width = samples out of 100</tspan>
      <tspan data-lang-vi>Flame graph CPU, độ rộng = số mẫu trên 100</tspan>
    </text>
    {boxes.map((b) => (
      <g>
        <rect x={X0 + b.s * U + 1} y={row(b.r)} width={b.n * U - 2} height={H} rx="3" class="qfig-gq18fl-box" />
        <text x={X0 + b.s * U + 7} y={row(b.r) + 18} class="qfig-gq18fl-n">
          {b.en ? (<><tspan data-lang-en>{b.en}</tspan><tspan data-lang-vi>{b.vi}</tspan></>) : b.name}
        </text>
        <text x={X0 + b.s * U + 7} y={row(b.r) + 35} class="qfig-gq18fl-c">{b.n}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-gq18fl { margin: 0; width: 100%; }
  .qfig-gq18fl svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq18fl text { font-size: 13px; fill: var(--text-body); }
  .qfig-gq18fl .qfig-gq18fl-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq18fl .qfig-gq18fl-n { font-weight: 700; fill: var(--text); font-family: var(--font-mono, monospace); }
  .qfig-gq18fl .qfig-gq18fl-c { fill: var(--text-muted); font-variant-numeric: tabular-nums; }
  .qfig-gq18fl-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
</style>
