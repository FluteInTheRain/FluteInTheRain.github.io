---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-async-concurrency-workers set 05: four uvicorn worker processes, each with its own
// in-memory `cases` dict. A POST landed on worker 1 and a later GET landed on worker 3. It shows the layout
// and where each request landed; it does not draw the GET's result. Inline SVG, site tokens only.
const boxX = 318;
const boxW = 250;
const boxH = 46;
const rows = [
  { y: 44, name: 1, data: '{ "C-1": … }' },
  { y: 108, name: 2, data: '{ }' },
  { y: 172, name: 3, data: '{ }' },
  { y: 236, name: 4, data: '{ }' },
];
function head(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`;
}
const cx = 60; // client icon x
const cy = 150;
---
<div class="qfig-bqwm">
  <svg viewBox="0 0 580 306" role="img" aria-label="A client and four worker processes, each holding its own in-memory cases dictionary. The first request, POST /cases, lands on worker 1, whose dictionary now holds C-1. The later request, GET /cases/C-1, lands on worker 3, whose dictionary is empty.">
    <text x="0" y="20" class="qfig-bqwm-h">
      <tspan data-lang-en>uvicorn --workers 4</tspan>
      <tspan data-lang-vi>uvicorn --workers 4</tspan>
    </text>

    <DiagramIcon name={'laptop' as any} x={cx} y={cy} size={30} />
    <text x={cx} y={cy + 34} text-anchor="middle" class="qfig-bqwm-lane">
      <tspan data-lang-en>Client</tspan>
      <tspan data-lang-vi>Client</tspan>
    </text>

    {rows.map((r) => (
      <g>
        <rect x={boxX} y={r.y} width={boxW} height={boxH} rx="6" class="qfig-bqwm-box" />
        <DiagramIcon name={'server' as any} x={boxX + 24} y={r.y + boxH / 2} size={22} />
        <text x={boxX + 46} y={r.y + 19} class="qfig-bqwm-lane">
          <tspan data-lang-en>Worker {r.name}</tspan>
          <tspan data-lang-vi>Worker {r.name}</tspan>
        </text>
        <text x={boxX + 46} y={r.y + 37} class="qfig-bqwm-t">cases = {r.data}</text>
      </g>
    ))}

    <path d={`M ${cx + 24} ${cy - 16} L ${boxX - 14} ${rows[0].y + boxH / 2}`} class="qfig-bqwm-arrow" />
    <polygon points={head(boxX - 4, rows[0].y + boxH / 2)} class="qfig-bqwm-head" />
    <text x="110" y="62" class="qfig-bqwm-t">
      <tspan data-lang-en>1st: POST /cases</tspan>
      <tspan data-lang-vi>Lần 1: POST /cases</tspan>
    </text>

    <path d={`M ${cx + 24} ${cy + 8} L ${boxX - 14} ${rows[2].y + boxH / 2}`} class="qfig-bqwm-arrow2" />
    <polygon points={head(boxX - 4, rows[2].y + boxH / 2)} class="qfig-bqwm-head2" />
    <text x="96" y="232" class="qfig-bqwm-t">
      <tspan data-lang-en>Later: GET /cases/C-1</tspan>
      <tspan data-lang-vi>Sau đó: GET /cases/C-1</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-bqwm { margin: 0; width: 100%; }
  .qfig-bqwm svg { display: block; width: 100%; min-width: 340px; height: auto; }
  .qfig-bqwm text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bqwm .qfig-bqwm-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-bqwm .qfig-bqwm-lane { font-weight: 700; fill: var(--text); }
  .qfig-bqwm .qfig-bqwm-t { font-weight: 600; fill: var(--text); }
  .qfig-bqwm-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-bqwm-arrow { stroke: var(--gold); stroke-width: 2.2; fill: none; }
  .qfig-bqwm-head { fill: var(--gold); }
  .qfig-bqwm-arrow2 { stroke: var(--text-muted); stroke-width: 2.2; stroke-dasharray: 6 4; fill: none; }
  .qfig-bqwm-head2 { fill: var(--text-muted); }
</style>
