---
// Set 08: the 40 monthly rank ICs of the simulated model (python, numpy seed 80).
const ics: number[] = [0.0605, 0.1021, 0.1077, 0.1286, 0.0787, 0.0057, 0.1651, 0.0151, 0.0595, 0.0226, 0.0082, 0.0623, 0.0389, 0.1606, 0.0921, 0.1615, 0.0836, -0.0527, 0.064, 0.13, 0.1009, 0.2279, -0.1002, 0.0894, 0.0432, 0.1415, -0.0328, -0.0531, 0.0752, 0.0516, 0.024, 0.0555, 0.0513, -0.0993, 0.0966, 0.0175, -0.066, 0.1432, -0.0636, 0.0072];
const X0 = 40, PW = 530, PY = 40, PH = 130;
const ZY = PY + PH / 2;
const sc = (PH / 2) / 0.25;
const BW = PW / ics.length;
---
<div class="aq5">
  <svg viewBox="0 0 580 230" aria-hidden="true">
    <text x="10" y="20" class="h">
      <tspan data-lang-en>Rank IC for each of 40 unseen months</tspan>
      <tspan data-lang-vi>Rank IC của từng tháng trong 40 tháng chưa thấy</tspan>
    </text>
    <rect x={X0} y={PY} width={PW} height={PH} rx="4" class="panel" />
    <line x1={X0} y1={ZY} x2={X0 + PW} y2={ZY} class="axis" />
    {ics.map((v, i) => (
      <rect x={X0 + i * BW + 1} y={v >= 0 ? ZY - v * sc : ZY} width={BW - 2} height={Math.max(1, Math.abs(v) * sc)} class={v >= 0 ? 'up' : 'dn'} />
    ))}
    <line x1={X0} y1={ZY - 0.055 * sc} x2={X0 + PW} y2={ZY - 0.055 * sc} class="mean" />
    <text x={X0 - 6} y={ZY + 4} text-anchor="end" class="m">0</text>
    <text x="10" y="204" class="v">
      <tspan data-lang-en>mean 0.055 · standard deviation 0.076 · 40 months</tspan>
      <tspan data-lang-vi>trung bình 0,055 · độ lệch chuẩn 0,076 · 40 tháng</tspan>
    </text>
  </svg>
</div>

<style>
  .aq5 { margin: 0; width: 100%; }
  .aq5 svg { display: block; width: 100%; height: auto; }
  .aq5 text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .aq5 .h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .aq5 .m { font-size: 12px; fill: var(--text-muted); }
  .aq5 .v { font-weight: 700; fill: var(--text); }
  .aq5 .panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.1; }
  .aq5 .axis { stroke: var(--text-muted); stroke-width: 1.1; }
  .aq5 .up { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 0.8; }
  .aq5 .dn { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 0.8; }
  .aq5 .mean { stroke: var(--text); stroke-width: 1.3; stroke-dasharray: 5 3; }
</style>
