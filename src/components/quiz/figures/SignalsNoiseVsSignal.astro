---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 01: the same problem twice. A cat photo: the signal fills the frame and repeats.
// A price chart: a thin thread inside noise. Tokens only, bilingual labels.
// Dot positions are hand-scattered; no numbers in the figure are data.
const dots = [
  [64, 214], [92, 196], [118, 228], [140, 186], [158, 238], [176, 205],
  [196, 232], [214, 188], [232, 222], [250, 198], [268, 244], [286, 210],
  [304, 186], [322, 236], [340, 204], [358, 226], [376, 192], [394, 248],
  [412, 214], [430, 198], [448, 230], [466, 206], [484, 236], [500, 212],
  [76, 258], [128, 262], [190, 256], [252, 266], [314, 254], [372, 264],
  [434, 258], [492, 262], [56, 176], [104, 168], [166, 172], [226, 166],
  [288, 170], [350, 174], [410, 170], [470, 176],
];
const line = 'M 56 232 L 118 218 L 180 236 L 244 208 L 308 220 L 372 196 L 436 210 L 502 190';
---
<div class="qnvs">
  <svg viewBox="0 0 580 452" role="img" aria-hidden="true">
    <DiagramIcon name="model" x={22} y={20} size={22} />
    <text x="44" y="25" class="qnvs-h">
      <tspan data-lang-en>The same job, two kinds of data</tspan>
      <tspan data-lang-vi>Cùng một công việc, hai loại dữ liệu</tspan>
    </text>

    <g class="qnvs-panel">
      <rect x="20" y="44" width="252" height="180" rx="10" />
      <text x="36" y="72" class="qnvs-strong">
        <tspan data-lang-en>A cat photo</tspan>
        <tspan data-lang-vi>Một tấm ảnh mèo</tspan>
      </text>
      <rect x="40" y="84" width="212" height="96" rx="4" class="qnvs-fill" />
      <text x="146" y="138" text-anchor="middle" class="qnvs-onfill">
        <tspan data-lang-en>signal</tspan>
        <tspan data-lang-vi>tín hiệu</tspan>
      </text>
      <text x="36" y="204" class="qnvs-muted">
        <tspan data-lang-en>Signal fills the frame, and repeats:</tspan>
        <tspan data-lang-vi>Tín hiệu chiếm đầy khung hình, và lặp lại:</tspan>
      </text>
      <text x="36" y="220" class="qnvs-muted">
        <tspan data-lang-en>whiskers are whiskers in every photo.</tspan>
        <tspan data-lang-vi>ria méo là ria méo trong mọi tấm ảnh.</tspan>
      </text>
    </g>

    <g class="qnvs-panel">
      <rect x="292" y="44" width="268" height="180" rx="10" />
      <text x="308" y="72" class="qnvs-strong">
        <tspan data-lang-en>A price chart</tspan>
        <tspan data-lang-vi>Một biểu đồ giá</tspan>
      </text>
      <line x1="304" x2="548" y1="180" y2="180" class="qnvs-axis" />
      {dots.map(([x, y]) => <circle cx={x - 16} cy={y - 60} r="3.4" class="qnvs-dot" />)}
      <path d={line} class="qnvs-line" transform="translate(-16 -60)" />
      <text x="308" y="204" class="qnvs-muted">
        <tspan data-lang-en>The signal is a thin thread inside noise.</tspan>
        <tspan data-lang-vi>Tín hiệu là một sợi chỉ mảnh giữa nhiễu.</tspan>
      </text>
    </g>

    <g class="qnvs-arrow">
      <path d="M 146 234 L 146 268" />
      <polygon points="146,278 141,268 151,268" />
      <path d="M 426 234 L 426 268" />
      <polygon points="426,278 421,268 431,268" />
    </g>

    <text x="290" y="302" text-anchor="middle" class="qnvs-strong">
      <tspan data-lang-en>So signal-to-noise ratio decides how easy the job is</tspan>
      <tspan data-lang-vi>Vì vậy tỉ lệ tín hiệu trên nhiễu quyết định độ khó của công việc</tspan>
    </text>

    <g class="qnvs-panel">
      <rect x="20" y="320" width="540" height="112" rx="10" />
      <circle cx="48" cy="352" r="6" class="qnvs-dot" />
      <text x="62" y="357" class="qnvs-label">
        <tspan data-lang-en>Noise: movement you cannot predict, however good you are</tspan>
        <tspan data-lang-vi>Nhiễu: chuyển động không thể đoán, dù bạn giỏi đến đâu</tspan>
      </text>
      <line x1="40" x2="60" y1="384" y2="380" class="qnvs-line" />
      <text x="62" y="387" class="qnvs-label">
        <tspan data-lang-en>Signal: a real tendency you could act on</tspan>
        <tspan data-lang-vi>Tín hiệu: một khuynh hướng thật mà bạn có thể hành động</tspan>
      </text>
      <text x="36" y="416" class="qnvs-bad">
        <tspan data-lang-en>Markets sit at the very low end of that ratio — every day, with money attached.</tspan>
        <tspan data-lang-vi>Thị trường nằm ở mức thấp nhất của tỉ lệ đó — ngày này qua ngày khác, và có tiền đàng sau.</tspan>
      </text>
    </g>
  </svg>
</div>

<style>
  .qnvs {
    margin: 0;
    width: 100%;
  }
  .qnvs svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qnvs text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qnvs .qnvs-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qnvs .qnvs-strong {
    font-size: 14.5px;
    font-weight: 600;
    fill: var(--text);
  }
  .qnvs .qnvs-label,
  .qnvs .qnvs-muted {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qnvs-panel rect {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .qnvs-fill {
    fill: var(--gold);
  }
  .qnvs-onfill {
    fill: var(--bg);
    font-weight: 700;
  }
  .qnvs-dot {
    fill: var(--red);
    opacity: 0.75;
  }
  .qnvs-line {
    fill: none;
    stroke: var(--act-2);
    stroke-width: 2.5;
  }
  .qnvs-axis {
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .qnvs-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .qnvs-arrow polygon {
    fill: var(--text-muted);
  }
  .qnvs .qnvs-bad {
    fill: var(--red);
    font-weight: 600;
  }
</style>
