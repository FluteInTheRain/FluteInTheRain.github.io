---
// Quiz figure, set 03: the fitted transition matrix as a 2x2 grid (rows = today, columns = tomorrow).
const cells = [
  { r: 0, c: 0, v: '98.2%', cls: 'stay' },
  { r: 0, c: 1, v: '1.8%', cls: 'go' },
  { r: 1, c: 0, v: '4.6%', cls: 'go' },
  { r: 1, c: 1, v: '95.4%', cls: 'stay turb' },
];
---
<div class="qfig-atq05m">
  <svg viewBox="0 0 580 250" role="img" aria-label="A two by two table of daily transition probabilities. From calm: 98.2 percent to calm, 1.8 percent to turbulent. From turbulent: 4.6 percent to calm, 95.4 percent to turbulent.">
    <text x="0" y="20" class="h">
      <tspan data-lang-en>Transition probabilities for one day</tspan>
      <tspan data-lang-vi>Xác suất chuyển trạng thái trong một ngày</tspan>
    </text>
    <text x="300" y="52" text-anchor="middle" class="m">
      <tspan data-lang-en>tomorrow: calm</tspan>
      <tspan data-lang-vi>ngày mai: yên</tspan>
    </text>
    <text x="450" y="52" text-anchor="middle" class="m">
      <tspan data-lang-en>tomorrow: turbulent</tspan>
      <tspan data-lang-vi>ngày mai: hỗn loạn</tspan>
    </text>
    {[0, 1].map((r) => (
      <text x="190" y={110 + r * 74} text-anchor="end" class="m">
        <tspan data-lang-en>{r ? 'today: turbulent' : 'today: calm'}</tspan>
        <tspan data-lang-vi>{r ? 'hôm nay: hỗn loạn' : 'hôm nay: yên'}</tspan>
      </text>
    ))}
    {cells.map((c) => (
      <g>
        <rect x={228 + c.c * 150} y={66 + c.r * 74} width="144" height="66" rx="8" class={'cell ' + c.cls} />
        <text x={228 + c.c * 150 + 72} y={66 + c.r * 74 + 40} text-anchor="middle" class="v">{c.v}</text>
      </g>
    ))}
  </svg>
</div>
<style>
  .qfig-atq05m { margin: 0; width: 100%; }
  .qfig-atq05m svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-atq05m text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-atq05m .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-atq05m .m { fill: var(--text-muted); font-size: 13px; }
  .qfig-atq05m .v { font-size: 20px; font-weight: 700; fill: var(--text); }
  .qfig-atq05m .cell { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .qfig-atq05m .cell.stay { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .qfig-atq05m .cell.turb { fill: var(--red-tint-bg); stroke: var(--red); }
</style>
