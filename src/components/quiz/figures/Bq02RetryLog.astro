---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend REST set 05: one create sent three times by an SDK with a 3 s timeout. Each request arrives
// at the server; the replies to attempts 1 and 2 are lost; the reply to attempt 3 arrives. It shows no row count.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const attempts = [
  { n: 1, x: 180, t: '0 s', lost: true },
  { n: 2, x: 320, t: '3 s', lost: true },
  { n: 3, x: 450, t: '6 s', lost: false },
];
const CY = 78, SY = 196;
const down = (x: number, y: number) => `${x},${y} ${x - 5},${y - 10} ${x + 5},${y - 10}`;
const up = (x: number, y: number) => `${x},${y} ${x - 5},${y + 10} ${x + 5},${y + 10}`;
---
<div class="qfig-bq02rl">
  <svg viewBox="0 0 580 270" role="img" aria-label="A client sends the same create three times, at 0, 3 and 6 seconds. Every request reaches the server. The replies to attempts 1 and 2 are lost on the way back, and the reply to attempt 3 arrives as 201 Created.">
    <text x="0" y="20" class="qfig-bq02rl-h">
      <tspan data-lang-en>One create, three attempts</tspan>
      <tspan data-lang-vi>Một lệnh tạo, ba lần thử</tspan>
    </text>

    <line x1="118" x2="580" y1={CY} y2={CY} class="qfig-bq02rl-rule" />
    <line x1="118" x2="580" y1={SY} y2={SY} class="qfig-bq02rl-rule" />
    <DiagramIcon name="laptop" x="6" y={CY - 13} size={26} />
    <text x="38" y={CY + 5} class="qfig-bq02rl-lane">
      <tspan data-lang-en>Client SDK</tspan>
      <tspan data-lang-vi>SDK của client</tspan>
    </text>
    <DiagramIcon name="server" x="6" y={SY - 13} size={26} />
    <text x="38" y={SY + 5} class="qfig-bq02rl-lane">
      <tspan data-lang-en>Server</tspan>
      <tspan data-lang-vi>Server</tspan>
    </text>

    {attempts.map((a) => (
      <g>
        <line x1={a.x - 14} x2={a.x - 14} y1={CY + 8} y2={SY - 12} class="qfig-bq02rl-flow" />
        <polygon points={down(a.x - 14, SY - 4)} class="qfig-bq02rl-head" />
        <circle cx={a.x - 14} cy={CY} r="6" class="qfig-bq02rl-dot" />
        <circle cx={a.x - 14} cy={SY} r="6" class="qfig-bq02rl-dot" />
        <text x={a.x - 14} y={CY - 28} text-anchor="middle" class="qfig-bq02rl-t">
          <tspan data-lang-en>Attempt {a.n}</tspan>
          <tspan data-lang-vi>Lần thử {a.n}</tspan>
        </text>
        <text x={a.x - 14} y={CY - 13} text-anchor="middle" class="qfig-bq02rl-m">POST · {a.t}</text>

        {a.lost ? (
          <g>
            <line x1={a.x + 14} x2={a.x + 14} y1={SY - 6} y2={140} class="qfig-bq02rl-flow" />
            <line x1={a.x + 14} x2={a.x + 14} y1={134} y2={CY + 8} class="qfig-bq02rl-lost" />
            <DiagramIcon name="fail" x={a.x + 14} y={137} size={20} />
            <text x={a.x + 30} y={141} class="qfig-bq02rl-bad">
              <tspan data-lang-en>reply lost</tspan>
              <tspan data-lang-vi>mất phản hồi</tspan>
            </text>
          </g>
        ) : (
          <g>
            <line x1={a.x + 14} x2={a.x + 14} y1={SY - 6} y2={CY + 16} class="qfig-bq02rl-flow" />
            <polygon points={up(a.x + 14, CY + 6)} class="qfig-bq02rl-head" />
            <text x={a.x + 24} y={141} class="qfig-bq02rl-t">
              <tspan data-lang-en>201 Created</tspan>
              <tspan data-lang-vi>201 Created</tspan>
            </text>
          </g>
        )}
      </g>
    ))}

    <text x="290" y="262" text-anchor="middle" class="qfig-bq02rl-m">
      <tspan data-lang-en>timeout 3 s · the same request each time, no Idempotency-Key</tspan>
      <tspan data-lang-vi>timeout 3 s · cùng một request mỗi lần, không có Idempotency-Key</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-bq02rl { margin: 0; width: 100%; }
  .qfig-bq02rl svg { display: block; width: 100%; min-width: 340px; height: auto; }
  .qfig-bq02rl text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bq02rl .qfig-bq02rl-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-bq02rl .qfig-bq02rl-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-bq02rl .qfig-bq02rl-t { font-weight: 700; fill: var(--text); }
  .qfig-bq02rl .qfig-bq02rl-m { fill: var(--text-muted); }
  .qfig-bq02rl .qfig-bq02rl-bad { font-weight: 700; fill: var(--red); }
  .qfig-bq02rl-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-bq02rl-flow { stroke: var(--text-muted); stroke-width: 2; fill: none; }
  .qfig-bq02rl-lost { stroke: var(--red); stroke-width: 2; stroke-dasharray: 4 4; fill: none; }
  .qfig-bq02rl-head { fill: var(--text-muted); }
  .qfig-bq02rl-dot { fill: var(--text); stroke: var(--bg); stroke-width: 1.5; }
</style>
