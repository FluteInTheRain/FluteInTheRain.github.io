---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for trade-offs set 03 (Hex, November 2022): free disk on the production database from Thu 3 Nov
// to Mon 7 Nov, with what the team saw underneath. The line is simplified. It does not name the cause and
// does not show an alert threshold or a runway. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const x0 = 80; // Thu 3 Nov, 00:00
const px = 96; // pixels per day
const tx = (d: number) => x0 + d * px;
const yTop = 78; // 0.85 TiB
const yZero = 186; // 0 TiB
const endX = tx(4.5); // Mon 7 Nov, about noon
const days = [
  { d: 0, en: 'Thu 3', vi: 'T5 3' },
  { d: 1, en: 'Fri 4', vi: 'T6 4' },
  { d: 2, en: 'Sat 5', vi: 'T7 5' },
  { d: 3, en: 'Sun 6', vi: 'CN 6' },
  { d: 4, en: 'Mon 7', vi: 'T2 7' },
];
---
<div class="qfig-wal">
  <svg viewBox="0 0 580 372" role="img" aria-label="Free disk on a production database falls from 0.85 TiB on Thursday 3 November to zero around noon on Monday 7 November, with three events listed below: a tunnel is rebuilt, the sync job fails with no alert, and the free-disk alert stays muted.">
    <text x="0" y="22" class="qfig-wal-h">
      <tspan data-lang-en>Free disk on production, 3 to 7 November</tspan>
      <tspan data-lang-vi>Dung lượng đĩa trống của production, 3 đến 7/11</tspan>
    </text>
    <text x="0" y="42" class="qfig-wal-m">
      <tspan data-lang-en>Simplified from the team's own chart</tspan>
      <tspan data-lang-vi>Vẽ gọn lại từ biểu đồ của chính team</tspan>
    </text>

    <!-- chart frame -->
    <line x1={x0} x2={x0} y1={yTop - 8} y2={yZero} class="qfig-wal-axis" />
    <line x1={x0} x2={tx(5)} y1={yZero} y2={yZero} class="qfig-wal-axis" />
    <line x1={x0} x2={tx(5)} y1={yTop} y2={yTop} class="qfig-wal-grid" />
    <text x={x0 - 8} y={yTop + 5} text-anchor="end" class="qfig-wal-m">0.85 TiB</text>
    <text x={x0 - 8} y={yZero + 5} text-anchor="end" class="qfig-wal-m">0</text>
    {days.map((t) => (
      <g>
        <line x1={tx(t.d)} x2={tx(t.d)} y1={yZero} y2={yZero + 5} class="qfig-wal-axis" />
        <text x={tx(t.d)} y={yZero + 22} text-anchor="middle" class="qfig-wal-m">
          <tspan data-lang-en>{t.en}</tspan>
          <tspan data-lang-vi>{t.vi}</tspan>
        </text>
      </g>
    ))}

    <!-- free disk line -->
    <line x1={x0} x2={endX} y1={yTop} y2={yZero} class="qfig-wal-line" />
    <circle cx={x0} cy={yTop} r="5" class="qfig-wal-dot" />
    <circle cx={endX} cy={yZero} r="6" class="qfig-wal-end" />
    <text x={endX - 8} y={yTop + 44} text-anchor="end" class="qfig-wal-t">
      <tspan data-lang-en>Disk full, about noon</tspan>
      <tspan data-lang-vi>Đầy đĩa, khoảng trưa</tspan>
    </text>
    <text x={x0 + 14} y={yTop - 12} class="qfig-wal-t">
      <tspan data-lang-en>Free space on Thursday</tspan>
      <tspan data-lang-vi>Dung lượng trống ngày thứ Năm</tspan>
    </text>
    <line x1={endX} x2={endX} y1={yTop} y2={yZero} class="qfig-wal-drop" />

    <!-- what the team saw -->
    <text x="0" y="244" class="qfig-wal-lane">
      <tspan data-lang-en>What the team saw</tspan>
      <tspan data-lang-vi>Team đã thấy gì</tspan>
    </text>

    <DiagramIcon name="link" x={tx(0.3)} y="272" size={24} />
    <text x={tx(0.3) + 24} y="277" class="qfig-wal-t">
      <tspan data-lang-en>Thursday: tunnel rebuilt, host fingerprint changes</tspan>
      <tspan data-lang-vi>Thứ Năm: dựng lại tunnel, fingerprint của host đổi</tspan>
    </text>

    <DiagramIcon name="sync" x={tx(0.3)} y="308" size={24} />
    <text x={tx(0.3) + 24} y="313" class="qfig-wal-t">
      <tspan data-lang-en>Fivetran cannot connect, no alert fires</tspan>
      <tspan data-lang-vi>Fivetran không kết nối được, không có cảnh báo</tspan>
    </text>

    <rect x={tx(0.3) - 12} y="330" width={endX - tx(0.3) + 12} height="26" rx="4" class="qfig-wal-muted" />
    <text x={tx(0.3)} y="348" class="qfig-wal-t">
      <tspan data-lang-en>Free-disk alert muted as too noisy</tspan>
      <tspan data-lang-vi>Cảnh báo đĩa trống bị tắt vì báo quá nhiều</tspan>
    </text>
    <DiagramIcon name="fail" x={endX} y="343" size={22} />
  </svg>
</div>

<style>
  .qfig-wal { margin: 0; width: 100%; }
  .qfig-wal svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-wal text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-wal .qfig-wal-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-wal .qfig-wal-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-wal .qfig-wal-t { font-weight: 600; fill: var(--text); }
  .qfig-wal .qfig-wal-m { fill: var(--text-muted); }
  .qfig-wal-axis { stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-wal-grid { stroke: var(--border); stroke-width: 1; stroke-dasharray: 4 4; }
  .qfig-wal-line { stroke: var(--red); stroke-width: 3; stroke-linecap: round; }
  .qfig-wal-dot { fill: var(--bg-alt); stroke: var(--red); stroke-width: 2; }
  .qfig-wal-end { fill: var(--red); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-wal-drop { stroke: var(--red); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .qfig-wal-muted { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1; }
</style>
