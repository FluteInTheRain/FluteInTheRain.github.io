---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 05: point-in-time data — the same Enron figure has two honest values,
// each tagged with the date it became known (post §3).
const rows = [
  {
    figure: { en: '2000 net income', vi: 'Lợi nhuận ròng 2000' },
    value: { en: 'record: 1.3 billion USD', vi: 'kỷ lục: 1,3 tỷ USD' },
    known: { en: 'Oct 2001', vi: 'tháng 10/2001' },
    bad: false,
  },
  {
    figure: { en: 'same figure, restated', vi: 'cùng con số, sau soát xét' },
    value: { en: '1997–2000 lower by $591 million', vi: '1997–2000 thấp hơn 591 triệu USD' },
    known: { en: '8 Nov 2001', vi: '8/11/2001' },
    bad: true,
  },
];
const W = 580;
const H = 372;
---
<div class="qdpit">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <DiagramIcon name="clock" x={22} y={20} size={22} />
    <text x="44" y="25" class="qdpit-h">
      <tspan data-lang-en>One number, two honest values — one per date you ask</tspan>
      <tspan data-lang-vi>Một con số, hai giá trị trung thực — mỗi ngày hỏi một giá trị</tspan>
    </text>

    <text x="30" y="62" class="qdpit-col">
      <tspan data-lang-en>the figure</tspan>
      <tspan data-lang-vi>con số</tspan>
    </text>
    <text x="228" y="62" class="qdpit-col">
      <tspan data-lang-en>what the row said</tspan>
      <tspan data-lang-vi>dòng dữ liệu nói</tspan>
    </text>
    <text x="476" y="62" class="qdpit-col">
      <tspan data-lang-en>known_at</tspan>
      <tspan data-lang-vi>biết được lúc</tspan>
    </text>

    {rows.map((r, i) => {
      const y = 74 + i * 108;
      return (
        <g>
          <rect x="14" y={y} width="552" height="98" rx="8" class={r.bad ? 'qdpit-row is-bad' : 'qdpit-row'} />
          <text x="30" y={y + 40} class="qdpit-fig">
            <tspan data-lang-en>{r.figure.en}</tspan>
            <tspan data-lang-vi>{r.figure.vi}</tspan>
          </text>
          <text x="228" y={y + 40} class={r.bad ? 'qdpit-val is-bad' : 'qdpit-val'}>
            <tspan data-lang-en>{r.value.en}</tspan>
            <tspan data-lang-vi>{r.value.vi}</tspan>
          </text>
          <text x="228" y={y + 66} class="qdpit-muted">
            <tspan data-lang-en>{r.bad ? 'business unchanged that day' : "from Enron's own annual report"}</tspan>
            <tspan data-lang-vi>{r.bad ? 'kinh doanh hôm đó không đổi' : 'theo báo cáo thường niên Enron'}</tspan>
          </text>
          <text x="476" y={y + 40} class={r.bad ? 'qdpit-known is-bad' : 'qdpit-known'}>
            <tspan data-lang-en>{r.known.en}</tspan>
            <tspan data-lang-vi>{r.known.vi}</tspan>
          </text>
        </g>
      );
    })}

    <text x="14" y="308" class="qdpit-strong">
      <tspan data-lang-en>A backtest on 31 October 2001 may read only the first row.</tspan>
      <tspan data-lang-vi>Backtest ngày 31/10/2001 chỉ được đọc dòng đầu tiên.</tspan>
    </text>
    <text x="14" y="334" class="qdpit-muted">
      <tspan data-lang-en>Two timestamps per figure: the period it describes, and the date it became known.</tspan>
      <tspan data-lang-vi>Hai mốc thời gian cho mỗi con số: kỳ nó mô tả, và ngày nó biết được.</tspan>
    </text>
  </svg>
</div>

<style>
  .qdpit {
    margin: 0;
    width: 100%;
  }
  .qdpit svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qdpit text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qdpit .qdpit-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qdpit .qdpit-col {
    font-size: 12px;
    font-weight: 700;
    fill: var(--text-muted);
  }
  .qdpit .qdpit-fig {
    font-size: 14px;
    font-weight: 600;
    fill: var(--text);
  }
  .qdpit .qdpit-val {
    font-size: 14px;
    font-weight: 600;
    fill: var(--text);
  }
  .qdpit .qdpit-val.is-bad {
    fill: var(--red);
  }
  .qdpit .qdpit-known {
    font-size: 13px;
    font-weight: 600;
    fill: var(--act-2);
  }
  .qdpit .qdpit-known.is-bad {
    fill: var(--red);
  }
  .qdpit .qdpit-muted {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qdpit .qdpit-strong {
    font-size: 13.5px;
    font-weight: 600;
    fill: var(--text);
  }
  .qdpit .qdpit-row {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .qdpit .qdpit-row.is-bad {
    fill: var(--red-tint-bg);
  }
</style>
