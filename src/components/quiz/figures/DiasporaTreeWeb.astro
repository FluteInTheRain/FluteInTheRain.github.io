---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 01: the same small social network drawn two ways, nested in one document and as links between people.
// Shows both shapes only; it does not say which one is better. Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 318;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const wrote = arrow(372, 152, 404, 98);
const commented = arrow(508, 152, 476, 98);
const liked = arrow(440, 250, 440, 98);
---
<div class="dt">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The same small social network drawn two ways: Ana's profile, post, comment, like and friends nested inside one document, and Ana, Bo and Chi as separate people linked to a post and to each other.">
    <text x="10" y="24" class="dt-h">
      <tspan data-lang-en>Nested in one document</tspan>
      <tspan data-lang-vi>Lồng trong một document</tspan>
    </text>
    <text x="310" y="24" class="dt-h">
      <tspan data-lang-en>Linked between people</tspan>
      <tspan data-lang-vi>Nối giữa các người dùng</tspan>
    </text>

    <line x1="291" x2="291" y1="12" y2="300" class="dt-split" />

    <g class="dt-box">
      <rect x="10" y="40" width="262" height="256" rx="8" />
      <rect x="24" y="76" width="234" height="140" rx="6" class="dt-in1" />
      <rect x="38" y="108" width="206" height="44" rx="5" class="dt-in2" />
      <rect x="38" y="160" width="206" height="44" rx="5" class="dt-in2" />
      <rect x="24" y="226" width="234" height="58" rx="6" class="dt-in1" />
    </g>
    <text x="24" y="63" class="dt-name">
      <tspan data-lang-en>Ana's document</tspan>
      <tspan data-lang-vi>Document của Ana</tspan>
    </text>
    <text x="36" y="97" class="dt-sub">
      <tspan data-lang-en>Post</tspan>
      <tspan data-lang-vi>Bài viết</tspan>
    </text>
    <text x="50" y="127" class="dt-body">
      <tspan data-lang-en>Comment</tspan>
      <tspan data-lang-vi>Bình luận</tspan>
    </text>
    <text x="50" y="144" class="dt-sub">
      <tspan data-lang-en>by Bo</tspan>
      <tspan data-lang-vi>của Bo</tspan>
    </text>
    <text x="50" y="179" class="dt-body">
      <tspan data-lang-en>Like</tspan>
      <tspan data-lang-vi>Lượt thích</tspan>
    </text>
    <text x="50" y="196" class="dt-sub">
      <tspan data-lang-en>by Chi</tspan>
      <tspan data-lang-vi>của Chi</tspan>
    </text>
    <text x="36" y="247" class="dt-body">
      <tspan data-lang-en>Friends</tspan>
      <tspan data-lang-vi>Bạn bè</tspan>
    </text>
    <text x="36" y="268" class="dt-sub">
      <tspan data-lang-en>Bo, Chi</tspan>
      <tspan data-lang-vi>Bo, Chi</tspan>
    </text>

    <g class="dt-box">
      <rect x="380" y="62" width="120" height="36" rx="6" />
    </g>
    <text x="440" y="85" text-anchor="middle" class="dt-body">
      <tspan data-lang-en>Ana's post</tspan>
      <tspan data-lang-vi>Bài của Ana</tspan>
    </text>

    <g class="dt-arrow"><path d={wrote.line} /><polygon points={wrote.head} /></g>
    <g class="dt-arrow"><path d={commented.line} /><polygon points={commented.head} /></g>
    <g class="dt-arrow"><path d={liked.line} /><polygon points={liked.head} /></g>
    <line x1="504" y1="190" x2="456" y2="252" class="dt-link" />

    <text x="380" y="128" text-anchor="end" class="dt-sub">
      <tspan data-lang-en>wrote</tspan>
      <tspan data-lang-vi>đã viết</tspan>
    </text>
    <text x="498" y="128" class="dt-sub">
      <tspan data-lang-en>commented</tspan>
      <tspan data-lang-vi>bình luận</tspan>
    </text>
    <text x="450" y="178" class="dt-sub">
      <tspan data-lang-en>liked</tspan>
      <tspan data-lang-vi>thích</tspan>
    </text>
    <text x="484" y="236" class="dt-sub">
      <tspan data-lang-en>friends</tspan>
      <tspan data-lang-vi>bạn bè</tspan>
    </text>

    <DiagramIcon name="user" x={370} y={170} size={30} />
    <text x="390" y="176" class="dt-name">Ana</text>
    <DiagramIcon name="user" x={510} y={170} size={30} />
    <text x="530" y="176" class="dt-name">Bo</text>
    <DiagramIcon name="user" x={440} y={270} size={30} />
    <text x="460" y="294" class="dt-name">Chi</text>
  </svg>
</div>

<style>
  .dt { width: 100%; }
  .dt svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .dt text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .dt .dt-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .dt .dt-name { font-weight: 700; fill: var(--text); }
  .dt .dt-body { fill: var(--text); }
  .dt .dt-sub { font-size: 13px; fill: var(--text-muted); }
  .dt-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .dt-box rect.dt-in1 { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .dt-box rect.dt-in2 { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .dt-split { stroke: var(--border); stroke-width: 1; stroke-dasharray: 4 4; }
  .dt-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .dt-arrow polygon { fill: var(--text-muted); }
  .dt-link { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
