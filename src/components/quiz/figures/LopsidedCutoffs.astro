---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for ethics set 01: one lender, two cutoffs. For each cutoff, two bars drawn to the same scale:
// risky applicants missed (out of 100) and safe applicants refused (out of 900). The unit cost of each kind of
// mistake sits in the legend. It shows no totals and no verdict. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const scale = 1.8; // pixels per person
const panels = [
  { top: 118, en: 'Strict cutoff', vi: 'Ngưỡng cắt chặt', missed: 5, refused: 180 },
  { top: 252, en: 'Loose cutoff', vi: 'Ngưỡng cắt lỏng', missed: 30, refused: 45 },
];
---
<div class="qfig-cut">
  <svg viewBox="0 0 580 370" role="img" aria-label="A lender with two cutoffs. Strict: 5 of 100 risky applicants missed and 180 of 900 safe applicants refused. Loose: 30 of 100 missed and 45 of 900 refused. A missed bad loan costs 2,000 dollars and a refused safe applicant costs 150 dollars.">
    <text x="0" y="22" class="qfig-cut-h">
      <tspan data-lang-en>One lender, two cutoffs</tspan>
      <tspan data-lang-vi>Một nhà cho vay, hai ngưỡng cắt</tspan>
    </text>

    <rect x="0" y="38" width="580" height="64" rx="8" class="qfig-cut-legend" />
    <DiagramIcon name="money" x="24" y="58" size={22} />
    <text x="46" y="63" class="qfig-cut-t">
      <tspan data-lang-en>A missed bad loan costs $2,000</tspan>
      <tspan data-lang-vi>Bỏ lọt một khoản vay xấu mất 2.000 đô la</tspan>
    </text>
    <DiagramIcon name="user" x="24" y="84" size={22} />
    <text x="46" y="89" class="qfig-cut-t">
      <tspan data-lang-en>A refused safe applicant costs $150 in lost margin</tspan>
      <tspan data-lang-vi>Từ chối nhầm một người an toàn mất 150 đô la lợi nhuận</tspan>
    </text>

    {panels.map((p) => (
      <g>
        <DiagramIcon name="scale" x="14" y={p.top + 8} size={22} />
        <text x="38" y={p.top + 14} class="qfig-cut-lane">
          <tspan data-lang-en>{p.en}</tspan>
          <tspan data-lang-vi>{p.vi}</tspan>
        </text>

        <text x="0" y={p.top + 44} class="qfig-cut-m">
          <tspan data-lang-en>Risky applicants missed (out of 100)</tspan>
          <tspan data-lang-vi>Người rủi ro bị bỏ lọt (trên 100)</tspan>
        </text>
        <rect x="0" y={p.top + 52} width={p.missed * scale} height="16" rx="2" class="qfig-cut-missed" />
        <text x={p.missed * scale + 8} y={p.top + 65} class="qfig-cut-n">{p.missed}</text>

        <text x="0" y={p.top + 90} class="qfig-cut-m">
          <tspan data-lang-en>Safe applicants refused (out of 900)</tspan>
          <tspan data-lang-vi>Người an toàn bị từ chối (trên 900)</tspan>
        </text>
        <rect x="0" y={p.top + 98} width={p.refused * scale} height="16" rx="2" class="qfig-cut-refused" />
        <text x={p.refused * scale + 8} y={p.top + 111} class="qfig-cut-n">{p.refused}</text>
      </g>
    ))}
    <line x1="0" x2="580" y1="242" y2="242" class="qfig-cut-rule" />
  </svg>
</div>

<style>
  .qfig-cut { margin: 0; width: 100%; }
  .qfig-cut svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-cut text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-cut .qfig-cut-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-cut .qfig-cut-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-cut .qfig-cut-t { font-weight: 600; fill: var(--text); }
  .qfig-cut .qfig-cut-n { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-cut .qfig-cut-m { fill: var(--text-muted); }
  .qfig-cut-legend { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-cut-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-cut-missed { fill: var(--red); }
  .qfig-cut-refused { fill: var(--act-2); }
</style>
