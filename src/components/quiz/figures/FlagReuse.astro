---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for set 01: one flags bit read as "boost" by v1 code and "eco" by v2 code,
// and a fleet of 5 servers (4 on v2, 1 still on v1) that all handle the same homes.
// Inline SVG, site tokens only, no <marker>/<defs>. Shows only the scenario's inputs, never an outcome.
const servers = [
  { x: 130, v: 'v2' },
  { x: 220, v: 'v2' },
  { x: 310, v: 'v2' },
  { x: 400, v: 'v2' },
  { x: 490, v: 'v1' },
];
const sy = 372;
---
<div class="qfig-flag">
  <svg viewBox="0 0 580 520" role="img" aria-label="Two cards show that bit 8 of the flags field means boost for version 1 code and eco for version 2 code. Below, a phone app sends a record to five servers, four running version 2 and one still on version 1, and all of them use one database.">
    <text x="0" y="22" class="qfig-flag-h">
      <tspan data-lang-en>One bit, two meanings</tspan>
      <tspan data-lang-vi>Một bit, hai nghĩa</tspan>
    </text>

    <g class="qfig-flag-card">
      <rect x="0" y="38" width="280" height="132" rx="8" />
      <text x="14" y="64" class="qfig-flag-t">
        <tspan data-lang-en>v1 code reads bit 8 as</tspan>
        <tspan data-lang-vi>Code v1 đọc bit 8 là</tspan>
      </text>
      <rect x="14" y="78" width="96" height="30" rx="6" class="qfig-flag-bit" />
      <text x="62" y="99" text-anchor="middle" class="qfig-flag-bt">
        <tspan data-lang-en>boost</tspan>
        <tspan data-lang-vi>boost</tspan>
      </text>
      <text x="14" y="134" class="qfig-flag-m">
        <tspan data-lang-en>Heater at full power</tspan>
        <tspan data-lang-vi>Lò sưởi chạy hết công suất</tspan>
      </text>
      <text x="14" y="154" class="qfig-flag-m">
        <tspan data-lang-en>until someone cancels.</tspan>
        <tspan data-lang-vi>cho tới khi có người huỷ.</tspan>
      </text>
    </g>

    <g class="qfig-flag-card qfig-flag-new">
      <rect x="300" y="38" width="280" height="132" rx="8" />
      <text x="314" y="64" class="qfig-flag-t">
        <tspan data-lang-en>v2 code reads bit 8 as</tspan>
        <tspan data-lang-vi>Code v2 đọc bit 8 là</tspan>
      </text>
      <rect x="314" y="78" width="96" height="30" rx="6" class="qfig-flag-bit" />
      <text x="362" y="99" text-anchor="middle" class="qfig-flag-bt">
        <tspan data-lang-en>eco</tspan>
        <tspan data-lang-vi>eco</tspan>
      </text>
      <text x="314" y="134" class="qfig-flag-m">
        <tspan data-lang-en>Target temperature</tspan>
        <tspan data-lang-vi>Nhiệt độ mục tiêu</tspan>
      </text>
      <text x="314" y="154" class="qfig-flag-m">
        <tspan data-lang-en>3 degrees lower.</tspan>
        <tspan data-lang-vi>thấp hơn 3 độ.</tspan>
      </text>
    </g>

    <line x1="0" x2="580" y1="194" y2="194" class="qfig-flag-rule" />
    <text x="0" y="224" class="qfig-flag-h">
      <tspan data-lang-en>Rolling deploy in progress</tspan>
      <tspan data-lang-vi>Đang deploy cuốn chiếu</tspan>
    </text>

    <DiagramIcon name="phone" x="40" y="290" size={34} />
    <text x="40" y="326" text-anchor="middle" class="qfig-flag-m">
      <tspan data-lang-en>App v2</tspan>
      <tspan data-lang-vi>App v2</tspan>
    </text>
    <text x="40" y="344" text-anchor="middle" class="qfig-flag-m">
      <tspan data-lang-en>sets bit 8</tspan>
      <tspan data-lang-vi>bật bit 8</tspan>
    </text>

    <path d="M 66 290 L 130 290 L 130 316 M 130 290 L 490 290 L 490 316 M 220 290 L 220 316 M 310 290 L 310 316 M 400 290 L 400 316" class="qfig-flag-line" />
    {servers.map((s) => (
      <polygon points={`${s.x},334 ${s.x - 5},324 ${s.x + 5},324`} class="qfig-flag-head" />
    ))}

    {servers.map((s, i) => (
      <g>
        <DiagramIcon name="server" x={s.x} y={sy} size={32} />
        <rect x={s.x - 24} y={sy + 28} width="48" height="24" rx="6" class={s.v === 'v2' ? 'qfig-flag-v2' : 'qfig-flag-v1'} />
        <text x={s.x} y={sy + 45} text-anchor="middle" class="qfig-flag-vt">
          <tspan data-lang-en>{s.v}</tspan>
          <tspan data-lang-vi>{s.v}</tspan>
        </text>
      </g>
    ))}

    <path d="M 130 446 L 130 460 L 490 460 M 310 460 L 310 470" class="qfig-flag-line" />
    <DiagramIcon name="db" x="310" y="490" size={28} />
    <text x="336" y="495" class="qfig-flag-m">
      <tspan data-lang-en>One shared database</tspan>
      <tspan data-lang-vi>Một database chung</tspan>
    </text>
    <text x="0" y="512" class="qfig-flag-m">
      <tspan data-lang-en>Any server can handle any home.</tspan>
      <tspan data-lang-vi>Server nào cũng xử lý được mọi nhà.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-flag { margin: 0; width: 100%; }
  .qfig-flag svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-flag text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-flag .qfig-flag-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-flag .qfig-flag-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-flag .qfig-flag-m { fill: var(--text-muted); }
  .qfig-flag-card rect:first-child { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-flag-new rect:first-child { stroke: var(--gold); stroke-width: 1.6; }
  .qfig-flag-bit { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .qfig-flag .qfig-flag-bt { font-size: 16px; font-weight: 700; fill: var(--red); }
  .qfig-flag-rule { stroke: var(--border); }
  .qfig-flag-line { stroke: var(--text-muted); stroke-width: 1.6; fill: none; }
  .qfig-flag-head { fill: var(--text-muted); }
  .qfig-flag-v2 { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-flag-v1 { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-flag .qfig-flag-vt { font-size: 15px; font-weight: 700; fill: var(--text); }
</style>
