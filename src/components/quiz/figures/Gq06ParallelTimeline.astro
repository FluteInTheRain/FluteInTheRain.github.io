---
// Quiz figure for go-testing-table-tests set 04 (s04q3): the order of events when t.Run subtests call t.Parallel inside a for loop.
// It shows when the subtests pause and resume; it does not say what value the loop variable holds.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
---
<div class="qfig-gq06pt">
  <svg viewBox="0 0 580 330" role="img" aria-label="Timeline of the parent test TestUpper and three parallel subtests: each subtest starts, calls t.Parallel and pauses; the loop ends and the parent returns; the paused subtests then run.">
    <text x="0" y="20" class="qfig-gq06pt-h">
      <tspan data-lang-en>Events in time order (top to bottom)</tspan>
      <tspan data-lang-vi>Các sự kiện theo thứ tự thời gian (từ trên xuống)</tspan>
    </text>

    <text x="20" y="50" class="qfig-gq06pt-t">TestUpper</text>
    <text x="290" y="50" class="qfig-gq06pt-t">
      <tspan data-lang-en>subtests</tspan>
      <tspan data-lang-vi>subtest</tspan>
    </text>
    <line x1="270" x2="270" y1="58" y2="318" class="qfig-gq06pt-sep" />

    <rect x="20" y="64" width="230" height="30" rx="6" class="qfig-gq06pt-cell" />
    <text x="30" y="84" class="qfig-gq06pt-m">t.Run("lower", ...)</text>
    <rect x="290" y="64" width="270" height="30" rx="6" class="qfig-gq06pt-pause" />
    <text x="300" y="84" class="qfig-gq06pt-m">
      <tspan data-lang-en>lower: t.Parallel(), pauses</tspan>
      <tspan data-lang-vi>lower: t.Parallel(), tạm dừng</tspan>
    </text>

    <rect x="20" y="104" width="230" height="30" rx="6" class="qfig-gq06pt-cell" />
    <text x="30" y="124" class="qfig-gq06pt-m">t.Run("mixed", ...)</text>
    <rect x="290" y="104" width="270" height="30" rx="6" class="qfig-gq06pt-pause" />
    <text x="300" y="124" class="qfig-gq06pt-m">
      <tspan data-lang-en>mixed: t.Parallel(), pauses</tspan>
      <tspan data-lang-vi>mixed: t.Parallel(), tạm dừng</tspan>
    </text>

    <rect x="20" y="144" width="230" height="30" rx="6" class="qfig-gq06pt-cell" />
    <text x="30" y="164" class="qfig-gq06pt-m">t.Run("upper", ...)</text>
    <rect x="290" y="144" width="270" height="30" rx="6" class="qfig-gq06pt-pause" />
    <text x="300" y="164" class="qfig-gq06pt-m">
      <tspan data-lang-en>upper: t.Parallel(), pauses</tspan>
      <tspan data-lang-vi>upper: t.Parallel(), tạm dừng</tspan>
    </text>

    <rect x="20" y="204" width="230" height="46" rx="6" class="qfig-gq06pt-cell" />
    <text x="30" y="224" class="qfig-gq06pt-b">
      <tspan data-lang-en>range loop ends,</tspan>
      <tspan data-lang-vi>vòng range kết thúc,</tspan>
    </text>
    <text x="30" y="242" class="qfig-gq06pt-b">
      <tspan data-lang-en>TestUpper body returns</tspan>
      <tspan data-lang-vi>thân TestUpper trả về</tspan>
    </text>

    <rect x="290" y="204" width="270" height="100" rx="6" class="qfig-gq06pt-run" />
    <text x="300" y="226" class="qfig-gq06pt-b">
      <tspan data-lang-en>paused subtests resume and</tspan>
      <tspan data-lang-vi>các subtest đang dừng chạy tiếp và</tspan>
    </text>
    <text x="300" y="246" class="qfig-gq06pt-b">
      <tspan data-lang-en>run their closure body:</tspan>
      <tspan data-lang-vi>chạy thân closure của chúng:</tspan>
    </text>
    <text x="300" y="270" class="qfig-gq06pt-m">Upper(tc.in) != tc.want</text>
    <text x="300" y="290" class="qfig-gq06pt-m">t.Errorf(..., tc.in, ..., tc.want)</text>
  </svg>
</div>

<style>
  .qfig-gq06pt { margin: 0; width: 100%; }
  .qfig-gq06pt svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq06pt text { font-size: 13px; fill: var(--text-body); }
  .qfig-gq06pt .qfig-gq06pt-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq06pt .qfig-gq06pt-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq06pt .qfig-gq06pt-m { font-family: 'JetBrains Mono', ui-monospace, monospace; fill: var(--text); }
  .qfig-gq06pt .qfig-gq06pt-b { fill: var(--text-body); }
  .qfig-gq06pt-cell { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-gq06pt-pause { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .qfig-gq06pt-run { fill: var(--bg-alt); stroke: var(--act-3); stroke-width: 2; }
  .qfig-gq06pt-sep { stroke: var(--border); stroke-width: 1; }
</style>
