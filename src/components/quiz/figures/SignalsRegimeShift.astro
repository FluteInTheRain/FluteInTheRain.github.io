---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 03: a regime change. Calm 2019 data on the left, the 2020 pandemic panic on the
// right — one of the sharpest crashes in 150 years of market records. Tokens only.
const calm = 'M 40 150 L 70 142 L 100 152 L 130 144 L 160 150 L 190 140 L 220 148 L 250 142';
const panic = 'M 330 96 L 352 130 L 370 110 L 388 168 L 404 132 L 420 190 L 436 150 L 452 200 L 468 162 L 484 208 L 500 170 L 516 196';
---
<div class="qrs">
  <svg viewBox="0 0 580 386" role="img" aria-hidden="true">
    <DiagramIcon name="clock" x={22} y={20} size={22} />
    <text x="44" y="25" class="qrs-h">
      <tspan data-lang-en>The market changes personality: a regime shift</tspan>
      <tspan data-lang-vi>Thị trường đổi tính cách: một cú đổi regime</tspan>
    </text>

    <g class="qrs-panel">
      <rect x="20" y="48" width="256" height="230" rx="10" />
      <text x="36" y="76" class="qrs-strong">
        <tspan data-lang-en>2019 — a calm regime</tspan>
        <tspan data-lang-vi>2019 — regime êm ru</tspan>
      </text>
      <line x1="36" x2="260" y1="220" y2="220" class="qrs-axis" />
      <path d={calm} class="qrs-calm" />
      <text x="36" y="252" class="qrs-muted">
        <tspan data-lang-en>Small, predictable moves. The rules a</tspan>
        <tspan data-lang-vi>Biên độ nhỏ, dễ đoán. Những luật mô hình</tspan>
      </text>
      <text x="36" y="270" class="qrs-muted">
        <tspan data-lang-en>model learns here are learned here.</tspan>
        <tspan data-lang-vi>học được ở đây là học của riêng giai đoạn này.</tspan>
      </text>
    </g>

    <g class="qrs-arrow">
      <path d="M 280 160 L 312 160" />
      <polygon points="322,160 312,155 312,165" />
    </g>
    <text x="298" y="140" text-anchor="middle" class="qrs-bad">
      <tspan data-lang-en>2020</tspan>
      <tspan data-lang-vi>2020</tspan>
    </text>

    <g class="qrs-panel">
      <rect x="326" y="48" width="234" height="230" rx="10" />
      <text x="342" y="76" class="qrs-strong">
        <tspan data-lang-en>2020 — a panic regime</tspan>
        <tspan data-lang-vi>2020 — regime hoảng loạn</tspan>
      </text>
      <line x1="340" x2="546" y1="220" y2="220" class="qrs-axis" />
      <path d={panic} class="qrs-panic" />
      <text x="342" y="252" class="qrs-bad">
        <tspan data-lang-en>One of the sharpest crashes in 150</tspan>
        <tspan data-lang-vi>Một trong những cú rơi gắt nhất trong</tspan>
      </text>
      <text x="342" y="270" class="qrs-bad">
        <tspan data-lang-en>years of market records.</tspan>
        <tspan data-lang-vi>150 năm dữ liệu thị trường.</tspan>
      </text>
    </g>

    <rect x="20" y="298" width="540" height="72" rx="10" class="qrs-note" />
    <text x="36" y="324" class="qrs-label">
      <tspan data-lang-en>Rules learned on calm 2019 data were useless within weeks. Financial data is not one big</tspan>
      <tspan data-lang-vi>Luật học từ dữ liệu êm ru năm 2019 vô dụng chỉ sau vài tuần. Dữ liệu tài chính không phải</tspan>
    </text>
    <text x="36" y="344" class="qrs-label">
      <tspan data-lang-en>dataset: it is a sequence of different datasets wearing the same clothes.</tspan>
      <tspan data-lang-vi>một dataset lớn: nó là một chuỗi các dataset khác nhau mặc cùng bộ đồ.</tspan>
    </text>
  </svg>
</div>

<style>
  .qrs {
    margin: 0;
    width: 100%;
  }
  .qrs svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qrs text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qrs .qrs-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qrs .qrs-strong {
    font-size: 14.5px;
    font-weight: 600;
    fill: var(--text);
  }
  .qrs .qrs-muted,
  .qrs .qrs-label {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qrs-panel rect {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .qrs-axis {
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .qrs-calm {
    fill: none;
    stroke: var(--act-2);
    stroke-width: 2.5;
  }
  .qrs-panic {
    fill: none;
    stroke: var(--red);
    stroke-width: 2.5;
  }
  .qrs-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .qrs-arrow polygon {
    fill: var(--text-muted);
  }
  .qrs .qrs-bad {
    fill: var(--red);
    font-weight: 700;
  }
  .qrs-note {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
</style>
