---
// Quiz figure for the color post, Uxq05: four amber text colours on the pale tint #FEF3C7.
---
<div class="qfig-uxq05textontint">
  <svg viewBox="0 0 600 230" role="img" aria-label="Four lines of Payment pending text on a pale amber panel #FEF3C7, in text colours #D97706, #B45309, #92400E and #78350F, from light to dark.">
<rect x="20" y="14" width="350" height="202" rx="10" fill="#FEF3C7" />
<text x="40" y="58" style="font-size:18px;font-weight:600" fill="#D97706"><tspan data-lang-en>Payment pending</tspan><tspan data-lang-vi>Thanh toán đang chờ</tspan></text>
<text x="40" y="108" style="font-size:18px;font-weight:600" fill="#B45309"><tspan data-lang-en>Payment pending</tspan><tspan data-lang-vi>Thanh toán đang chờ</tspan></text>
<text x="40" y="158" style="font-size:18px;font-weight:600" fill="#92400E"><tspan data-lang-en>Payment pending</tspan><tspan data-lang-vi>Thanh toán đang chờ</tspan></text>
<text x="40" y="208" style="font-size:18px;font-weight:600" fill="#78350F"><tspan data-lang-en>Payment pending</tspan><tspan data-lang-vi>Thanh toán đang chờ</tspan></text>
<text x="400" y="58" class="m">#D97706</text>
<text x="400" y="108" class="m">#B45309</text>
<text x="400" y="158" class="m">#92400E</text>
<text x="400" y="208" class="m">#78350F</text>
  </svg>
</div>

<style>
  .qfig-uxq05textontint { margin: 0; width: 100%; }
  .qfig-uxq05textontint svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq05textontint text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq05textontint .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-uxq05textontint .m { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-uxq05textontint .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq05textontint .w { fill: #FFFFFF; font-weight: 700; font-size: 15px; }
</style>
