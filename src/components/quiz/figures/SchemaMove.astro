---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 07 (sharding): how a request reaches a Postgres host in the Notion setup, and why one host is under strain.
// Shows today's layout only (32 hosts, 15 schemas each); no target fleet size and no results, so it gives no answer away.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 478;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const arrows = [
  arrow(150, 66, 176, 66),
  arrow(400, 66, 428, 66),
  arrow(495, 98, 495, 124),
  arrow(495, 168, 495, 196),
  arrow(175, 252, 175, 284),
  arrow(465, 252, 465, 284),
];
const cells = Array.from({ length: 15 }, (_, i) => ({ x: 24 + (i % 5) * 46, y: 334 + Math.floor(i / 5) * 24 }));
---
<div class="sm">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A workspace id is hashed modulo 480 to pick a logical schema. A table maps the schema to a host. Requests pass through a proxy tier of about 100 instances. One Postgres host holds 15 schemas and runs hot, with 31 more hosts like it.">
    <text x="10" y="24" class="sm-h">
      <tspan data-lang-en>From a workspace to a Postgres host</tspan>
      <tspan data-lang-vi>Từ một workspace tới một máy Postgres</tspan>
    </text>

    <rect x="10" y="40" width="140" height="58" rx="8" class="sm-box" />
    <DiagramIcon name="users" x={28} y={69} size={20} />
    <text x="44" y="63" class="sm-name"><tspan data-lang-en>A workspace</tspan><tspan data-lang-vi>Một workspace</tspan></text>
    <text x="44" y="83" class="sm-sub">workspace_id</text>
    <g class="sm-arrow"><path d={arrows[0].line} /><polygon points={arrows[0].head} /></g>

    <rect x="176" y="40" width="224" height="58" rx="8" class="sm-box" />
    <DiagramIcon name="key" x={198} y={69} size={22} />
    <text x="216" y="63" class="sm-name">hash(workspace_id) % 480</text>
    <text x="216" y="83" class="sm-sub"><tspan data-lang-en>picks a logical schema</tspan><tspan data-lang-vi>chọn một schema logic</tspan></text>
    <g class="sm-arrow"><path d={arrows[1].line} /><polygon points={arrows[1].head} /></g>

    <rect x="428" y="40" width="142" height="58" rx="8" class="sm-box" />
    <DiagramIcon name="file" x={448} y={69} size={20} />
    <text x="464" y="63" class="sm-name"><tspan data-lang-en>Schema</tspan><tspan data-lang-vi>Schema</tspan></text>
    <text x="464" y="83" class="sm-sub"><tspan data-lang-en>one of 480</tspan><tspan data-lang-vi>một trong 480</tspan></text>
    <g class="sm-arrow"><path d={arrows[2].line} /><polygon points={arrows[2].head} /></g>

    <rect x="330" y="124" width="240" height="44" rx="8" class="sm-box is-map" />
    <DiagramIcon name="index" x={354} y={146} size={20} />
    <text x="374" y="151" class="sm-name"><tspan data-lang-en>Table: schema to host</tspan><tspan data-lang-vi>Bảng: schema tới máy</tspan></text>
    <g class="sm-arrow"><path d={arrows[3].line} /><polygon points={arrows[3].head} /></g>

    <rect x="10" y="196" width="560" height="56" rx="8" class="sm-box" />
    <DiagramIcon name="server" x={36} y={224} size={22} />
    <text x="56" y="219" class="sm-name"><tspan data-lang-en>PgBouncer proxy tier</tspan><tspan data-lang-vi>Tầng proxy PgBouncer</tspan></text>
    <text x="56" y="239" class="sm-sub"><tspan data-lang-en>about 100 instances, up to 6 connections to each database per instance</tspan><tspan data-lang-vi>khoảng 100 instance, mỗi instance mở tối đa 6 kết nối tới mỗi database</tspan></text>
    <g class="sm-arrow"><path d={arrows[4].line} /><polygon points={arrows[4].head} /></g>
    <g class="sm-arrow"><path d={arrows[5].line} /><polygon points={arrows[5].head} /></g>

    <rect x="10" y="284" width="330" height="178" rx="8" class="sm-box is-hot" />
    <DiagramIcon name="postgres" x={36} y={308} size={24} />
    <text x="58" y="313" class="sm-name is-hot"><tspan data-lang-en>One busy Postgres host</tspan><tspan data-lang-vi>Một máy Postgres đang quá tải</tspan></text>
    {cells.map((c) => <rect x={c.x} y={c.y} width="40" height="18" rx="3" class="sm-cell" />)}
    <text x="262" y="371" class="sm-sub"><tspan data-lang-en>15 schemas</tspan><tspan data-lang-vi>15 schema</tspan></text>
    <text x="24" y="425" class="sm-warn"><tspan data-lang-en>CPU above 90% at peak</tspan><tspan data-lang-vi>CPU trên 90% lúc cao điểm</tspan></text>
    <text x="24" y="446" class="sm-warn"><tspan data-lang-en>Disk IOPS near the limit</tspan><tspan data-lang-vi>IOPS của đĩa gần chạm trần</tspan></text>

    {[0, 1, 2].map((i) => (
      <g>
        <rect x="360" y={284 + i * 44} width="210" height="36" rx="8" class="sm-box" />
        <DiagramIcon name="postgres" x={382} y={302 + i * 44} size={18} />
        <text x="400" y={307 + i * 44} class="sm-sub"><tspan data-lang-en>Host with 15 schemas</tspan><tspan data-lang-vi>Máy có 15 schema</tspan></text>
      </g>
    ))}
    <text x="465" y="436" text-anchor="middle" class="sm-sub"><tspan data-lang-en>31 more hosts like it</tspan><tspan data-lang-vi>còn 31 máy tương tự</tspan></text>
  </svg>
</div>

<style>
  .sm { width: 100%; }
  .sm svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .sm text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .sm .sm-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sm .sm-name { font-weight: 700; fill: var(--text); }
  .sm .sm-name.is-hot { fill: var(--red); }
  .sm .sm-sub { font-size: 13px; fill: var(--text-muted); }
  .sm .sm-warn { font-weight: 700; fill: var(--red); }
  .sm-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .sm-box.is-map { stroke: var(--gold); stroke-width: 1.6; fill: var(--gold-tint-bg); }
  .sm-box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .sm-cell { fill: var(--bg); stroke: var(--border); stroke-width: 1; }
  .sm-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .sm-arrow polygon { fill: var(--text-muted); }
</style>
