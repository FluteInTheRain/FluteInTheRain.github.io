---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 03 (sharding): keys 0 to 11 and the node each one is routed to by key % 3 and by key % 4,
// above the 4 cache nodes and the database behind them. Shows the rule only, never how many keys move.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids, so the EN and VI copies cannot clash.

const W = 580;
const H = 372;
const keys = Array.from({ length: 12 }, (_, i) => i);
const x0 = 128; // centre of key 0
const step = 38;
const cx = (i: number) => x0 + i * step;
const letters = ['A', 'B', 'C', 'D'];
const nodes = letters.map((l, i) => ({ l, x: 140 + i * 100, isNew: i === 3 }));

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const dbA = arrow(290, 262, 290, 312);
---
<div class="ms">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Keys 0 to 11 shown with the node that key % 3 picks and the node that key % 4 picks, with cache misses falling through to the database.">
    <text x="10" y="26" class="ms-h">
      <tspan data-lang-en>Which node does each key go to?</tspan>
      <tspan data-lang-vi>Mỗi key được gửi tới node nào?</tspan>
    </text>

    <text x="10" y="62" class="ms-sub">
      <tspan data-lang-en>Key</tspan>
      <tspan data-lang-vi>Key</tspan>
    </text>
    {keys.map((k) => (
      <text x={cx(k)} y="62" text-anchor="middle" class="ms-num">{k}</text>
    ))}

    <text x="10" y="94" class="ms-name">
      <tspan data-lang-en>3 nodes</tspan>
      <tspan data-lang-vi>3 node</tspan>
    </text>
    <text x="10" y="112" class="ms-sub">key % 3</text>
    {keys.map((k) => (
      <g>
        <rect x={cx(k) - 16} y="78" width="32" height="30" rx="5" class="ms-chip" />
        <text x={cx(k)} y="99" text-anchor="middle" class="ms-letter">{letters[k % 3]}</text>
      </g>
    ))}

    <text x="10" y="144" class="ms-name">
      <tspan data-lang-en>4 nodes</tspan>
      <tspan data-lang-vi>4 node</tspan>
    </text>
    <text x="10" y="162" class="ms-sub">key % 4</text>
    {keys.map((k) => (
      <g>
        <rect x={cx(k) - 16} y="128" width="32" height="30" rx="5" class="ms-chip" />
        <text x={cx(k)} y="149" text-anchor="middle" class="ms-letter">{letters[k % 4]}</text>
      </g>
    ))}

    <text x="10" y="194" class="ms-note">
      <tspan data-lang-en>The hash of a key is fixed. Only N changes.</tspan>
      <tspan data-lang-vi>Hash của một key không đổi. Chỉ N đổi.</tspan>
    </text>

    {nodes.map((n) => (
      <g>
        <rect x={n.x - 40} y="212" width="80" height="50" rx="8" class={n.isNew ? 'ms-box is-new' : 'ms-box'} />
        <DiagramIcon name="server" x={n.x - 18} y={237} size={20} />
        <text x={n.x + 6} y="243" class="ms-name">{n.l}</text>
        {n.isNew && (
          <text x={n.x} y="206" text-anchor="middle" class="ms-sub">
            <tspan data-lang-en>new node</tspan>
            <tspan data-lang-vi>node mới</tspan>
          </text>
        )}
      </g>
    ))}
    <text x="10" y="242" class="ms-sub">
      <tspan data-lang-en>Cache</tspan>
      <tspan data-lang-vi>Cache</tspan>
    </text>

    <g class="ms-arrow"><path d={dbA.line} /><polygon points={dbA.head} /></g>
    <text x="306" y="292" class="ms-sub">
      <tspan data-lang-en>miss: read goes on to the database</tspan>
      <tspan data-lang-vi>miss: lượt đọc đi tiếp xuống database</tspan>
    </text>
    <DiagramIcon name="db" x={290} y={338} size={26} />
    <text x={316} y={344} class="ms-name">
      <tspan data-lang-en>Database</tspan>
      <tspan data-lang-vi>Database</tspan>
    </text>
  </svg>
</div>

<style>
  .ms { width: 100%; }
  .ms svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .ms text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .ms .ms-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ms .ms-name { font-weight: 700; fill: var(--text); }
  .ms .ms-sub, .ms .ms-num { fill: var(--text-muted); }
  .ms .ms-note { fill: var(--text); }
  .ms .ms-letter { font-weight: 700; fill: var(--text); }
  .ms-chip { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .ms-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .ms-box.is-new { stroke-dasharray: 5 4; }
  .ms-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .ms-arrow polygon { fill: var(--text-muted); }
</style>
