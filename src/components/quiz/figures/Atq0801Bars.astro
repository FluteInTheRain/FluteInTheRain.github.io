---
// Set 01: monthly out-of-sample R2 from Gu, Kelly & Xiu (2020). OLS on all 900+ predictors is below zero.
const rows = [
  { en: 'Linear, 3 predictors', vi: 'Tuyến tính, 3 predictor', v: 0.16, k: '' },
  { en: 'Linear, all 900+', vi: 'Tuyến tính, cả 900+', v: null, k: 'bad' },
  { en: 'Elastic net', vi: 'Elastic net', v: 0.11, k: '' },
  { en: 'Random forest', vi: 'Random forest', v: 0.33, k: 'tree' },
  { en: 'Neural net, 3 layers', vi: 'Neural net, 3 tầng', v: 0.40, k: '' },
];
const X0 = 200, SC = 800, Y0 = 44, RH = 36;
---
<div class="aq1">
  <svg viewBox="0 0 580 250" aria-hidden="true">
    <text x="10" y="22" class="h">
      <tspan data-lang-en>Monthly out-of-sample R², US stocks 1987–2016</tspan>
      <tspan data-lang-vi>R² ngoài mẫu theo tháng, cổ phiếu Mỹ 1987–2016</tspan>
    </text>
    <line x1={X0} y1={Y0 - 6} x2={X0} y2={Y0 + rows.length * RH} class="axis" />
    {rows.map((r, i) => {
      const y = Y0 + i * RH;
      return (
        <g>
          <text x={X0 - (r.v === null ? 22 : 8)} y={y + 22} text-anchor="end">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          {r.v === null ? (
            <g>
              <polygon points={`${X0 - 4},${y + 11} ${X0 - 4},${y + 25} ${X0 - 16},${y + 18}`} class="neg" />
              <text x={X0 + 6} y={y + 22} class="negt">
                <tspan data-lang-en>below zero</tspan>
                <tspan data-lang-vi>dưới 0</tspan>
              </text>
            </g>
          ) : (
            <g>
              <rect x={X0} y={y + 7} width={r.v * SC} height="22" rx="3" class={`bar ${r.k}`} />
              <text x={X0 + r.v * SC + 6} y={y + 23} class="v">{r.v.toFixed(2)}%</text>
            </g>
          )}
        </g>
      );
    })}
  </svg>
</div>

<style>
  .aq1 { margin: 0; width: 100%; }
  .aq1 svg { display: block; width: 100%; height: auto; }
  .aq1 text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .aq1 .h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .aq1 .m { font-size: 12px; fill: var(--text-muted); }
  .aq1 .v { font-weight: 700; fill: var(--text); }
  .aq1 .axis { stroke: var(--text-muted); stroke-width: 1.2; }
  .aq1 .bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .aq1 .bar.tree { fill: var(--gold-tint-bg); stroke: var(--gold-icon); }
  .aq1 .neg { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; }
  .aq1 .negt { fill: var(--red); font-weight: 600; }
</style>
