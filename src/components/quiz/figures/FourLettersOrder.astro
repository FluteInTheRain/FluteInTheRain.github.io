---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 02 (transactions): a "fully ACID" datasheet next to one order request made of four statements,
// with a crash between statement 2 and 3, and two other incidents. Shows only the scenario's facts, no answers.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const letters = [
  { l: 'A', en: 'Atomicity', vi: 'Atomicity' },
  { l: 'C', en: 'Consistency', vi: 'Consistency' },
  { l: 'I', en: 'Isolation', vi: 'Isolation' },
  { l: 'D', en: 'Durability', vi: 'Durability' },
];
const rows = [
  { n: 1, y: 156, en: 'insert into orders', vi: 'insert vào orders', done: true },
  { n: 2, y: 206, en: 'insert into order_items', vi: 'insert vào order_items', done: true },
  { n: 3, y: 278, en: 'update stock', vi: 'update stock', done: false },
  { n: 4, y: 328, en: 'update unread badge', vi: 'update badge chưa đọc', done: false },
];
---
<div class="qf2">
  <svg viewBox="0 0 580 440" role="img" aria-label="A datasheet with four letters, A, C, I and D, and one order request made of four statements with a crash between the second and the third.">
    <text x="0" y="22" class="qf2-h">
      <tspan data-lang-en>Datasheet: "fully ACID"</tspan>
      <tspan data-lang-vi>Datasheet: "fully ACID"</tspan>
    </text>
    {letters.map((t, i) => (
      <g class="qf2-tile">
        <rect x={i * 150} y="36" width="130" height="48" rx="8" />
        <text x={i * 150 + 24} y="68" text-anchor="middle" class="qf2-letter">{t.l}</text>
        <text x={i * 150 + 44} y="66" class="qf2-t">
          <tspan data-lang-en>{t.en}</tspan>
          <tspan data-lang-vi>{t.vi}</tspan>
        </text>
      </g>
    ))}

    <text x="0" y="124" class="qf2-h">
      <tspan data-lang-en>One order request, four statements</tspan>
      <tspan data-lang-vi>Một request đặt hàng, bốn câu lệnh</tspan>
    </text>

    {rows.map((r) => (
      <g>
        <rect x="0" y={r.y - 20} width="350" height="40" rx="6" class={r.done ? 'qf2-row' : 'qf2-row is-skip'} />
        <circle cx="22" cy={r.y} r="11" class="qf2-num-bg" />
        <text x="22" y={r.y + 5} text-anchor="middle" class="qf2-num">{r.n}</text>
        <DiagramIcon name="db" x={58} y={r.y} size={20} />
        <text x="80" y={r.y + 5} class="qf2-t">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <text x="372" y={r.y + 5} class={r.done ? 'qf2-state' : 'qf2-state is-skip'}>
          {r.done ? (
            <><tspan data-lang-en>ran, saved</tspan><tspan data-lang-vi>đã chạy, đã lưu</tspan></>
          ) : (
            <><tspan data-lang-en>never ran</tspan><tspan data-lang-vi>chưa kịp chạy</tspan></>
          )}
        </text>
      </g>
    ))}

    <line x1="230" x2="580" y1="242" y2="242" class="qf2-crash" />
    <DiagramIcon name="warning" x={22} y={242} size={22} />
    <text x="46" y="247" class="qf2-crash-t">
      <tspan data-lang-en>Process crashes here</tspan>
      <tspan data-lang-vi>Tiến trình sập ở đây</tspan>
    </text>

    <g class="qf2-chip">
      <rect x="0" y="370" width="280" height="56" rx="8" />
      <text x="14" y="392" class="qf2-t">
        <tspan data-lang-en>Stock of item A7 was 2,</tspan>
        <tspan data-lang-vi>Tồn kho món A7 là 2,</tspan>
      </text>
      <text x="14" y="414" class="qf2-t">
        <tspan data-lang-en>an order for 5 committed</tspan>
        <tspan data-lang-vi>đơn mua 5 vẫn commit</tspan>
      </text>
    </g>
    <g class="qf2-chip">
      <rect x="300" y="370" width="280" height="56" rx="8" />
      <text x="314" y="392" class="qf2-t">
        <tspan data-lang-en>Under load: deadlock error,</tspan>
        <tspan data-lang-vi>Lúc tải cao: lỗi deadlock,</tspan>
      </text>
      <text x="314" y="414" class="qf2-t">
        <tspan data-lang-en>the ORM answers HTTP 500</tspan>
        <tspan data-lang-vi>ORM trả HTTP 500</tspan>
      </text>
    </g>
  </svg>
</div>

<style>
  .qf2 { width: 100%; }
  .qf2 svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qf2 text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qf2 .qf2-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qf2 .qf2-t { fill: var(--text); }
  .qf2-tile rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qf2 .qf2-letter { font-size: 26px; font-weight: 700; fill: var(--text); }
  .qf2-row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qf2-row.is-skip { fill: var(--bg); stroke-dasharray: 4 3; }
  .qf2-num-bg { fill: var(--text-muted); }
  .qf2 .qf2-num { font-size: 13px; font-weight: 700; fill: var(--bg); }
  .qf2 .qf2-state { font-weight: 700; fill: var(--text); }
  .qf2 .qf2-state.is-skip { fill: var(--text-muted); font-weight: 400; }
  .qf2-crash { stroke: var(--red); stroke-width: 2; stroke-dasharray: 6 4; }
  .qf2 .qf2-crash-t { fill: var(--red); font-weight: 700; }
  .qf2-chip rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
</style>
