---
// Quiz figure for go-concurrency-patterns set 01: three workers that finish at different times and the
// WaitGroup counter that drops as each calls Done. It shows the timeline only, not who should close what.
// Inline SVG, site tokens only.
const X0 = 120, X1 = 540;
const rows = [
  { y: 50, name: 'worker 1', end: 300, left: 2 },
  { y: 92, name: 'worker 2', end: 440, left: 1 },
  { y: 134, name: 'worker 3', end: 360, left: 0 },
];
// counter drops in finish order: worker 1 (300), worker 3 (360), worker 2 (440)
const drops = [
  { x: 300, v: 2 },
  { x: 360, v: 1 },
  { x: 440, v: 0 },
];
---
<div class="qfig-gq09we">
  <svg viewBox="0 0 580 250" role="img" aria-label="Three workers drawn as bars on one time axis. Each bar ends at a different moment with a Done call. Below them, the WaitGroup counter starts at 3 and falls to 2, 1 and 0 as the bars end.">
    <text x="0" y="20" class="qfig-gq09we-h">
      <tspan data-lang-en>Three workers, one WaitGroup</tspan>
      <tspan data-lang-vi>Ba worker, một WaitGroup</tspan>
    </text>

    {rows.map((r) => (
      <g>
        <text x="0" y={r.y + 16} class="qfig-gq09we-l">{r.name}</text>
        <rect x={X0} y={r.y} width={r.end - X0} height="24" rx="3" class="qfig-gq09we-bar" />
        <text x={X0 + 10} y={r.y + 17} class="qfig-gq09we-in">
          <tspan data-lang-en>sending results</tspan>
          <tspan data-lang-vi>đang gửi kết quả</tspan>
        </text>
        <line x1={r.end} x2={r.end} y1={r.y - 4} y2={r.y + 28} class="qfig-gq09we-done" />
        <text x={r.end + 6} y={r.y + 17} class="qfig-gq09we-l">wg.Done()</text>
      </g>
    ))}

    <line x1={X0} x2={X1} y1="186" y2="186" class="qfig-gq09we-axis" />
    <text x="0" y="176" class="qfig-gq09we-l">
      <tspan data-lang-en>counter</tspan>
      <tspan data-lang-vi>bộ đếm</tspan>
    </text>
    <text x={X0} y="208" class="qfig-gq09we-t">3</text>
    {drops.map((d) => (
      <g>
        <line x1={d.x} x2={d.x} y1="180" y2="192" class="qfig-gq09we-done" />
        <text x={d.x} y="208" text-anchor="middle" class="qfig-gq09we-t">{d.v}</text>
      </g>
    ))}
    <text x="0" y="242" class="qfig-gq09we-m">
      <tspan data-lang-en>The three Done calls land at different times.</tspan>
      <tspan data-lang-vi>Ba lệnh Done rơi vào ba thời điểm khác nhau.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq09we { margin: 0; width: 100%; }
  .qfig-gq09we svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq09we text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq09we .qfig-gq09we-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq09we .qfig-gq09we-t { font-weight: 700; fill: var(--text); }
  .qfig-gq09we .qfig-gq09we-m { fill: var(--text-muted); }
  .qfig-gq09we .qfig-gq09we-in { fill: var(--bg); font-weight: 700; }
  .qfig-gq09we-bar { fill: var(--act-3); opacity: 0.9; }
  .qfig-gq09we-done { stroke: var(--text); stroke-width: 1.5; }
  .qfig-gq09we-axis { stroke: var(--text-muted); stroke-width: 2; }
</style>
