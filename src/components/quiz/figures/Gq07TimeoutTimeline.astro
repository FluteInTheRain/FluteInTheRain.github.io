---
// Quiz figure for the Go goroutines quiz (post 07), set 04: the timeline of one call to lookup() in s04q1.
// The time axis is linear (30 px per ms, 0 to 10 ms). It shows when the caller's select ends and when the
// helper goroutine reaches its send. It draws no verdict.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const x0 = 130;
const px = 30;
---
<div class="qfig-gq07tt">
  <svg viewBox="0 0 580 230" role="img" aria-label="Timeline of one call to lookup, from 0 to 10 milliseconds. The caller goroutine waits in a select from 0 ms to 1 ms, where the time.After case fires and it returns -1. The helper goroutine sleeps from 0 ms to 10 ms and then runs ch <- 42 on an unbuffered channel.">
    <text x="0" y="18" class="qfig-gq07tt-h">
      <tspan data-lang-en>One call to lookup()</tspan>
      <tspan data-lang-vi>Một lần gọi lookup()</tspan>
    </text>

    <text x="0" y="68" class="qfig-gq07tt-m">
      <tspan data-lang-en>caller</tspan>
      <tspan data-lang-vi>caller</tspan>
    </text>
    <rect x={x0} y="50" width={px} height="26" rx="4" class="qfig-gq07tt-bar" />
    <text x={x0 + px + 10} y="68" class="qfig-gq07tt-c">select, time.After fires, return -1</text>

    <text x="0" y="128" class="qfig-gq07tt-m">
      <tspan data-lang-en>helper goroutine</tspan>
      <tspan data-lang-vi>goroutine phụ</tspan>
    </text>
    <rect x={x0} y="110" width={px * 10} height="26" rx="4" class="qfig-gq07tt-bar" />
    <text x={x0 + 10} y="128" class="qfig-gq07tt-c">time.Sleep(10ms)</text>
    <circle cx={x0 + px * 10} cy="123" r="7" class="qfig-gq07tt-dot" />
    <text x={x0 + px * 10} y="158" text-anchor="end" class="qfig-gq07tt-c">ch &lt;- 42</text>

    <line x1={x0} x2={x0 + px * 10 + 20} y1="184" y2="184" class="qfig-gq07tt-axis" />
    <line x1={x0} x2={x0} y1="178" y2="190" class="qfig-gq07tt-axis" />
    <line x1={x0 + px} x2={x0 + px} y1="178" y2="190" class="qfig-gq07tt-axis" />
    <line x1={x0 + px * 10} x2={x0 + px * 10} y1="178" y2="190" class="qfig-gq07tt-axis" />
    <text x={x0} y="210" text-anchor="middle" class="qfig-gq07tt-m">0 ms</text>
    <text x={x0 + px} y="210" text-anchor="middle" class="qfig-gq07tt-m">1 ms</text>
    <text x={x0 + px * 10} y="210" text-anchor="middle" class="qfig-gq07tt-m">10 ms</text>
    <text x="0" y="210" class="qfig-gq07tt-m">
      <tspan data-lang-en>time</tspan>
      <tspan data-lang-vi>thời gian</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq07tt { margin: 0; width: 100%; }
  .qfig-gq07tt svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq07tt text { font-size: 13px; fill: var(--text-body); }
  .qfig-gq07tt .qfig-gq07tt-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq07tt .qfig-gq07tt-m { fill: var(--text-muted); }
  .qfig-gq07tt .qfig-gq07tt-c { font-family: var(--font-mono, monospace); fill: var(--text); }
  .qfig-gq07tt-bar { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-gq07tt-dot { fill: var(--act-3); stroke: var(--act-3); stroke-width: 1; }
  .qfig-gq07tt-axis { stroke: var(--border); stroke-width: 2; }
</style>
