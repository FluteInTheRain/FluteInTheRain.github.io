---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 06: a Postgres table "orders" (heap file) with five indexes, and one UPDATE aimed at one row.
// Shows the layout only: which indexes exist and that each one has an entry for the row. No counts, no results.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const W = 580;
const H = 330;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const heap = { x: 10, y: 100, w: 180, h: 214 };
const row = { x: 24, y: 190, w: 152, h: 40 };
const rowMid = row.y + row.h / 2;
const ix = 300;
const iw = 270;
const ih = 38;
const idx = [
  { name: 'orders_pkey', cols: 'id' },
  { name: 'orders_status_idx', cols: 'status' },
  { name: 'orders_city_idx', cols: 'city' },
  { name: 'orders_created_idx', cols: 'created_at' },
  { name: 'orders_driver_idx', cols: 'driver_id' },
].map((r, i) => ({ ...r, y: 70 + i * 48 }));
---
<div class="qu">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="An UPDATE aimed at one row of a Postgres heap file that has five indexes, each with an entry for that row.">
    <DiagramIcon name="laptop" x={24} y={26} size={26} />
    <text x="48" y="31" class="qu-sql">UPDATE orders SET status = 'shipped' WHERE id = 42</text>
    {(() => { const a = arrow(24, 46, 24, heap.y - 2); return <g class="qu-arrow"><path d={a.line} /><polygon points={a.head} /></g>; })()}

    <g class="qu-box">
      <rect x={heap.x} y={heap.y} width={heap.w} height={heap.h} rx="8" />
      <DiagramIcon name="postgres" x={heap.x + 24} y={heap.y + 24} size={24} />
      <text x={heap.x + 44} y={heap.y + 29} class="qu-name">
        <tspan data-lang-en>Heap file: orders</tspan>
        <tspan data-lang-vi>Heap file: orders</tspan>
      </text>
      <text x={heap.x + 14} y={heap.y + 64} class="qu-sub">
        <tspan data-lang-en>Rows in no set order</tspan>
        <tspan data-lang-vi>Dòng không theo thứ tự</tspan>
      </text>
      <rect x={row.x} y={row.y} width={row.w} height={row.h} rx="5" class="qu-row" />
      <text x={row.x + 12} y={row.y + 17} class="qu-name">
        <tspan data-lang-en>Row 42</tspan>
        <tspan data-lang-vi>Dòng 42</tspan>
      </text>
      <text x={row.x + 12} y={row.y + 33} class="qu-sub">status = 'paid'</text>
    </g>

    <text x={ix} y="54" class="qu-head">
      <tspan data-lang-en>Five indexes on the table</tspan>
      <tspan data-lang-vi>Năm index trên bảng</tspan>
    </text>

    {idx.map((r) => {
      const a = arrow(ix, r.y + ih / 2, row.x + row.w + 2, rowMid);
      return (
        <g>
          <g class="qu-link"><path d={a.line} /><polygon points={a.head} /></g>
          <g class="qu-box">
            <rect x={ix} y={r.y} width={iw} height={ih} rx="6" />
            <DiagramIcon name="index" x={ix + 20} y={r.y + ih / 2} size={18} />
            <text x={ix + 40} y={r.y + 24} class="qu-name">{r.name}</text>
            <text x={ix + iw - 12} y={r.y + 24} text-anchor="end" class="qu-sub">({r.cols})</text>
          </g>
        </g>
      );
    })}
  </svg>
</div>

<style>
  .qu { width: 100%; }
  .qu svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qu text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qu .qu-sql { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qu .qu-head { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qu .qu-name { font-weight: 700; fill: var(--text); }
  .qu .qu-sub { fill: var(--text-muted); }
  .qu-box rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qu-box .qu-row { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.4; }
  .qu-arrow path, .qu-link path { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .qu-arrow polygon, .qu-link polygon { fill: var(--text-muted); }
  .qu-link path { stroke-dasharray: 4 3; }
</style>
