---
// Quiz figure for the Go hardware post, set 07: Go heap in use over time around a traffic spike.
// It draws the heap and one marker; the RSS line is a number in a label, not a verdict.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const X0 = 70, X1 = 550, Y0 = 200, Y1 = 40; // y: 0 MiB at Y0, 420 MiB at Y1
const y = (mib: number) => Y0 - (mib / 420) * (Y0 - Y1);
const pts = [[X0, y(70)], [160, y(80)], [230, y(250)], [300, y(420)], [340, y(420)], [345, y(90)], [440, y(90)], [X1, y(90)]]
  .map(([a, b]) => `${a},${b}`).join(' ');
---
<div class="qfig-gq16hs">
  <svg viewBox="0 0 580 270" role="img" aria-label="Go heap in use over time: it climbs to 420 MiB during a traffic spike, drops to 90 MiB after a GC cycle, and a marker shows RSS near 420 MiB at that moment.">
    <text x="0" y="18" class="qfig-gq16hs-h">
      <tspan data-lang-en>Go heap in use over time</tspan>
      <tspan data-lang-vi>Heap của Go đang dùng theo thời gian</tspan>
    </text>
    <line x1={X0} x2={X0} y1={Y1 - 6} y2={Y0} class="qfig-gq16hs-axis" />
    <line x1={X0} x2={X1} y1={Y0} y2={Y0} class="qfig-gq16hs-axis" />
    <line x1={X0} x2={X1} y1={y(420)} y2={y(420)} class="qfig-gq16hs-grid" />
    <line x1={X0} x2={X1} y1={y(90)} y2={y(90)} class="qfig-gq16hs-grid" />
    <text x={X0 - 8} y={y(420) + 4} text-anchor="end" class="qfig-gq16hs-m">420 MiB</text>
    <text x={X0 - 8} y={y(90) + 4} text-anchor="end" class="qfig-gq16hs-m">90 MiB</text>
    <text x={X0 - 8} y={Y0 + 4} text-anchor="end" class="qfig-gq16hs-m">0</text>
    <polyline points={pts} class="qfig-gq16hs-line" />
    <text x="170" y="70" class="qfig-gq16hs-b">
      <tspan data-lang-en>traffic spike</tspan>
      <tspan data-lang-vi>đợt tăng tải</tspan>
    </text>
    <line x1="345" x2="345" y1={y(420) - 2} y2={Y0 + 10} class="qfig-gq16hs-mark" />
    <text x="352" y="228" class="qfig-gq16hs-b">
      <tspan data-lang-en>after a GC cycle</tspan>
      <tspan data-lang-vi>sau một chu kỳ GC</tspan>
    </text>
    <text x="352" y="248" class="qfig-gq16hs-m">
      <tspan data-lang-en>Kubernetes reads RSS: ~420 MiB</tspan>
      <tspan data-lang-vi>Kubernetes đọc RSS: ~420 MiB</tspan>
    </text>
    <text x={X1} y={Y0 + 18} text-anchor="end" class="qfig-gq16hs-m">
      <tspan data-lang-en>time</tspan>
      <tspan data-lang-vi>thời gian</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq16hs { margin: 0; width: 100%; }
  .qfig-gq16hs svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq16hs text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq16hs .qfig-gq16hs-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq16hs .qfig-gq16hs-b { fill: var(--text); font-weight: 600; }
  .qfig-gq16hs .qfig-gq16hs-m { fill: var(--text-muted); }
  .qfig-gq16hs-axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-gq16hs-grid { stroke: var(--border); stroke-width: 1; stroke-dasharray: 4 3; }
  .qfig-gq16hs-line { fill: none; stroke: var(--act-3); stroke-width: 3; stroke-linejoin: round; }
  .qfig-gq16hs-mark { stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 3 3; }
</style>
