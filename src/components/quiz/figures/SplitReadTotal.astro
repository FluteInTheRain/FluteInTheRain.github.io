---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 03 (transactions): a balance page reads A, a transfer commits, the page reads B; a report job runs for 20 minutes.
// Shows the timeline and the committed values only, never a total, so it gives no answer away.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 330;
const commitX = 330;
---
<div class="srt">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A balance page reads account A, then a transfer commits, then the page reads account B. A report job runs for 20 minutes beside them.">
    <text x="10" y="24" class="srt-h">
      <tspan data-lang-en>Two reads, one transfer in between</tspan>
      <tspan data-lang-vi>Hai lần đọc, một lệnh chuyển ở giữa</tspan>
    </text>

    <line x1={commitX} x2={commitX} y1="52" y2="266" class="srt-commit" />
    <text x={commitX} y="46" text-anchor="middle" class="srt-ct">
      <tspan data-lang-en>Transfer commits</tspan>
      <tspan data-lang-vi>Lệnh chuyển commit</tspan>
    </text>

    <DiagramIcon name="money" x={24} y={86} size={22} />
    <text x="46" y="82" class="srt-name"><tspan data-lang-en>Transfer</tspan><tspan data-lang-vi>Lệnh chuyển</tspan></text>
    <text x="46" y="99" class="srt-sub"><tspan data-lang-en>100, A to B</tspan><tspan data-lang-vi>100, từ A sang B</tspan></text>
    <rect x="170" y="72" width="160" height="28" rx="4" class="srt-bar" />
    <text x="250" y="91" text-anchor="middle" class="srt-sub">
      <tspan data-lang-en>runs, then commits</tspan>
      <tspan data-lang-vi>chạy rồi commit</tspan>
    </text>

    <DiagramIcon name="db" x={24} y={148} size={22} />
    <text x="46" y="144" class="srt-name"><tspan data-lang-en>Committed</tspan><tspan data-lang-vi>Giá trị</tspan></text>
    <text x="46" y="161" class="srt-sub"><tspan data-lang-en>values</tspan><tspan data-lang-vi>đã commit</tspan></text>
    <rect x="170" y="130" width="150" height="36" rx="6" class="srt-card" />
    <text x="195" y="153" class="srt-val">A 500</text><text x="265" y="153" class="srt-val">B 500</text>
    <rect x="340" y="130" width="150" height="36" rx="6" class="srt-card" />
    <text x="365" y="153" class="srt-val">A 400</text><text x="435" y="153" class="srt-val">B 600</text>

    <DiagramIcon name="laptop" x={24} y={212} size={22} />
    <text x="46" y="217" class="srt-name"><tspan data-lang-en>Balance page</tspan><tspan data-lang-vi>Trang số dư</tspan></text>
    <line x1="170" x2="560" y1="212" y2="212" class="srt-axis" />
    <circle cx="250" cy="212" r="7" class="srt-dot" />
    <circle cx="430" cy="212" r="7" class="srt-dot" />
    <text x="250" y="240" text-anchor="middle" class="srt-sub"><tspan data-lang-en>reads A: 500</tspan><tspan data-lang-vi>đọc A: 500</tspan></text>
    <text x="430" y="240" text-anchor="middle" class="srt-sub"><tspan data-lang-en>reads B: 600</tspan><tspan data-lang-vi>đọc B: 600</tspan></text>

    <DiagramIcon name="chart" x={24} y={296} size={22} />
    <text x="46" y="301" class="srt-name"><tspan data-lang-en>Report job</tspan><tspan data-lang-vi>Job báo cáo</tspan></text>
    <rect x="170" y="282" width="390" height="28" rx="4" class="srt-bar" />
    <text x="365" y="301" text-anchor="middle" class="srt-sub">
      <tspan data-lang-en>runs 20 minutes while rows keep changing</tspan>
      <tspan data-lang-vi>chạy 20 phút trong lúc dữ liệu vẫn đổi</tspan>
    </text>
  </svg>
</div>

<style>
  .srt { width: 100%; }
  .srt svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .srt text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .srt .srt-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .srt .srt-name { font-weight: 700; fill: var(--text); }
  .srt .srt-sub { fill: var(--text-muted); }
  .srt .srt-val { fill: var(--text); font-weight: 700; }
  .srt .srt-ct { fill: var(--text); font-weight: 700; }
  .srt-bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .srt-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .srt-axis { stroke: var(--border); stroke-width: 1.5; }
  .srt-dot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 2.5; }
  .srt-commit { stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 5 4; }
</style>
