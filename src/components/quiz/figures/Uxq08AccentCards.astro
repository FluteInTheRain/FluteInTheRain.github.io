---
// Quiz figure for Post 8 (finishing touches): the same alert card drawn two ways.
---
<div class="qfig-uxq08accentcards">
  <svg viewBox="0 0 600 190" role="img" aria-label="Two alert cards. Version 1 has a thick coloured border on all four sides. Version 2 has a thin grey border and a thick coloured strip on the left edge only.">
    <text x="20" y="24" class="h"><tspan data-lang-en>Version 1</tspan><tspan data-lang-vi>Bản 1</tspan></text>
    <rect x="22" y="40" width="262" height="110" rx="6" class="card all" />
    <circle cx="48" cy="72" r="8" class="dot" />
    <text x="66" y="77" class="t"><tspan data-lang-en>Payment failed</tspan><tspan data-lang-vi>Thanh toán lỗi</tspan></text>
    <rect x="42" y="96" width="210" height="8" rx="3" class="bar" />
    <rect x="42" y="112" width="150" height="8" rx="3" class="bar" />

    <text x="316" y="24" class="h"><tspan data-lang-en>Version 2</tspan><tspan data-lang-vi>Bản 2</tspan></text>
    <rect x="318" y="40" width="262" height="110" rx="6" class="card thin" />
    <rect x="318" y="40" width="4" height="110" class="strip" />
    <circle cx="346" cy="72" r="8" class="dot" />
    <text x="364" y="77" class="t"><tspan data-lang-en>Payment failed</tspan><tspan data-lang-vi>Thanh toán lỗi</tspan></text>
    <rect x="340" y="96" width="210" height="8" rx="3" class="bar" />
    <rect x="340" y="112" width="150" height="8" rx="3" class="bar" />
  </svg>
</div>

<style>
  .qfig-uxq08accentcards { margin: 0; width: 100%; }
  .qfig-uxq08accentcards svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq08accentcards text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq08accentcards .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-uxq08accentcards .t { font-size: 14px; font-weight: 600; fill: var(--text); }
  .qfig-uxq08accentcards .card { fill: var(--card-bg); }
  .qfig-uxq08accentcards .all { stroke: var(--act-2); stroke-width: 4; }
  .qfig-uxq08accentcards .thin { stroke: var(--border); stroke-width: 1; }
  .qfig-uxq08accentcards .strip { fill: var(--act-2); }
  .qfig-uxq08accentcards .dot { fill: var(--act-2); }
  .qfig-uxq08accentcards .bar { fill: var(--border); }
</style>
