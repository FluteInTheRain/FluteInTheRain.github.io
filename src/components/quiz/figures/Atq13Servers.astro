---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 01: eight SMARS servers, seven with the new code and one still on the old Power Peg code (SEC 34-70694 paras 15-16).
const W = 580;
const H = 232;
const xs = Array.from({ length: 8 }, (_, i) => 12 + i * 69);
---
<div class="qs13">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <text x="12" y="22" class="h">
      <tspan data-lang-en>Order router SMARS, 1 August 2012</tspan>
      <tspan data-lang-vi>Bộ định tuyến lệnh SMARS, ngày 1/8/2012</tspan>
    </text>
    {xs.map((x, i) => (
      <g>
        <rect x={x} y="40" width="61" height="76" rx="8" class={i === 7 ? 'box hot' : 'box good'} />
        <DiagramIcon name="server" x={x + 30.5} y={66} size={22} />
        <text x={x + 30.5} y="104" text-anchor="middle" class="s">{i + 1}</text>
      </g>
    ))}
    <text x="12" y="146" class="note">
      <tspan data-lang-en>Gold: new code copied. Red: nothing copied, old code still there.</tspan>
      <tspan data-lang-vi>Vàng: đã chép code mới. Đỏ: chưa chép gì, code cũ vẫn nằm đó.</tspan>
    </text>
    <text x="12" y="176" class="note">
      <tspan data-lang-en>Orders that carry the repurposed flag reach any of the eight.</tspan>
      <tspan data-lang-vi>Lệnh mang cờ đã dùng lại có thể rơi vào bất kỳ server nào trong tám.</tspan>
    </text>
    <text x="12" y="206" class="note">
      <tspan data-lang-en>A second technician did not review the deployment.</tspan>
      <tspan data-lang-vi>Không có kỹ thuật viên thứ hai xem lại lần triển khai.</tspan>
    </text>
  </svg>
</div>
<style>
  .qs13 { margin: 0; width: 100%; }
  .qs13 svg { display: block; width: 100%; height: auto; }
  .qs13 .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qs13 .s { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qs13 .note { font-size: 13px; fill: var(--text-body); }
  .qs13 .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qs13 .box.good { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .qs13 .box.hot { fill: var(--red-tint-bg); stroke: var(--red); }
</style>
