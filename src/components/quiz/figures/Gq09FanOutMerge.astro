---
// Quiz figure for go-concurrency-patterns set 03: one input channel read by three copies of a stage,
// whose outputs go to one merged channel. It shows the topology only, not the order that comes out.
// Inline SVG, site tokens only.
const copies = [48, 112, 176];
---
<div class="qfig-gq09fo">
  <svg viewBox="0 0 580 250" role="img" aria-label="Six values, 1 to 6, enter one input channel in that order. Three copies of a slow stage all read from that channel. Each copy writes to its own output channel, and a merge goroutine sends everything into one merged channel.">
    <text x="0" y="20" class="qfig-gq09fo-h">
      <tspan data-lang-en>One stage, three copies, one merged output</tspan>
      <tspan data-lang-vi>Một stage, ba bản sao, một đầu ra gộp</tspan>
    </text>

    <rect x="0" y="108" width="100" height="40" rx="4" class="qfig-gq09fo-box" />
    <text x="50" y="125" text-anchor="middle" class="qfig-gq09fo-t">in</text>
    <text x="50" y="141" text-anchor="middle" class="qfig-gq09fo-m">1 2 3 4 5 6</text>

    {copies.map((y, i) => (
      <g>
        <line x1="100" y1="128" x2="200" y2={y + 40} class="qfig-gq09fo-line" />
        <rect x="200" y={y + 24} width="110" height="32" rx="4" class="qfig-gq09fo-fill" />
        <text x="255" y={y + 45} text-anchor="middle" class="qfig-gq09fo-in">
          <tspan data-lang-en>copy {i + 1}</tspan>
          <tspan data-lang-vi>bản {i + 1}</tspan>
        </text>
        <line x1="310" y1={y + 40} x2="400" y2="128" class="qfig-gq09fo-line" />
      </g>
    ))}

    <rect x="400" y="100" width="76" height="56" rx="4" class="qfig-gq09fo-box" />
    <text x="438" y="124" text-anchor="middle" class="qfig-gq09fo-t">merge</text>
    <text x="438" y="142" text-anchor="middle" class="qfig-gq09fo-m">
      <tspan data-lang-en>goroutine</tspan>
      <tspan data-lang-vi>goroutine</tspan>
    </text>
    <line x1="476" y1="128" x2="500" y2="128" class="qfig-gq09fo-line" />
    <rect x="500" y="108" width="80" height="40" rx="4" class="qfig-gq09fo-box" />
    <text x="540" y="132" text-anchor="middle" class="qfig-gq09fo-t">out</text>

    <text x="0" y="242" class="qfig-gq09fo-m">
      <tspan data-lang-en>Each value goes to exactly one copy.</tspan>
      <tspan data-lang-vi>Mỗi giá trị đi tới đúng một bản sao.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq09fo { margin: 0; width: 100%; }
  .qfig-gq09fo svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq09fo text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq09fo .qfig-gq09fo-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq09fo .qfig-gq09fo-t { font-weight: 700; fill: var(--text); }
  .qfig-gq09fo .qfig-gq09fo-m { fill: var(--text-muted); }
  .qfig-gq09fo .qfig-gq09fo-in { fill: var(--bg); font-weight: 700; }
  .qfig-gq09fo-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-gq09fo-fill { fill: var(--act-3); opacity: 0.9; }
  .qfig-gq09fo-line { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
</style>
