---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 05 (sharding): two ways to search orders by email.
// Option A: a search goes to a grid of 100 shards, one replies slowly. Option B: orders shards feed an email index asynchronously.
// Mechanism only (no probabilities or counts of shards touched), so it never gives an answer away.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 372;

function head(x2: number, y2: number, a: number) {
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
}

const cols = 20;
const rowsN = 5;
const gx = 190;
const gy = 62;
const step = 19;
const slow = { c: 13, r: 2 };
const dots: { x: number; y: number; slow: boolean }[] = [];
for (let r = 0; r < rowsN; r++) {
  for (let c = 0; c < cols; c++) {
    dots.push({ x: gx + c * step, y: gy + r * 18, slow: c === slow.c && r === slow.r });
  }
}
const ordersBox = { x: 10, y: 262, w: 150, h: 76 };
const indexBox = { x: 300, y: 262, w: 150, h: 76 };
const midY = ordersBox.y + ordersBox.h / 2;
---
<div class="sw">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two ways to search orders by email: a search sent to a grid of 100 shards where one replies slowly, and an email index that is copied from the orders shards asynchronously.">
    <text x="10" y="24" class="sw-h">
      <tspan data-lang-en>Option A: a local index in every shard</tspan>
      <tspan data-lang-vi>Cách A: local index trong từng shard</tspan>
    </text>

    <DiagramIcon name="laptop" x={40} y={98} size={28} />
    <text x="40" y="130" text-anchor="middle" class="sw-sub">
      <tspan data-lang-en>Search</tspan>
      <tspan data-lang-vi>Tìm kiếm</tspan>
    </text>
    <g class="sw-arrow">
      <path d="M 66 98 L 160 98" />
      <polygon points={head(170, 98, 0)} />
    </g>
    <line x1="176" x2="176" y1="54" y2="142" class="sw-bar" />

    <text x={gx - 6} y="46" class="sw-sub">
      <tspan data-lang-en>100 shards, one reply from each</tspan>
      <tspan data-lang-vi>100 shard, mỗi shard trả lời một lần</tspan>
    </text>
    {dots.map((d) => (
      <circle cx={d.x} cy={d.y} r={d.slow ? 7 : 6} class={d.slow ? 'sw-dot is-slow' : 'sw-dot'} />
    ))}

    <circle cx="12" cy="170" r="6" class="sw-dot" />
    <text x="26" y="175" class="sw-num">
      <tspan data-lang-en>5 ms reply</tspan>
      <tspan data-lang-vi>trả lời 5 ms</tspan>
    </text>
    <circle cx="170" cy="170" r="6" class="sw-dot is-slow" />
    <text x="184" y="175" class="sw-num is-slow">
      <tspan data-lang-en>92 ms reply (slow disk, GC pause)</tspan>
      <tspan data-lang-vi>trả lời 92 ms (đĩa chậm, GC pause)</tspan>
    </text>
    <text x="10" y="204" class="sw-note">
      <tspan data-lang-en>The page is ready when the last reply arrives.</tspan>
      <tspan data-lang-vi>Trang xong khi câu trả lời cuối cùng về.</tspan>
    </text>

    <line x1="10" x2={W - 10} y1="226" y2="226" class="sw-rule" />

    <text x="10" y="252" class="sw-h">
      <tspan data-lang-en>Option B: a global index on customer_email</tspan>
      <tspan data-lang-vi>Cách B: global index trên customer_email</tspan>
    </text>
    <g class="sw-box">
      <rect x={ordersBox.x} y={ordersBox.y + 14} width={ordersBox.w} height={ordersBox.h} rx="8" />
      <DiagramIcon name="db" x={ordersBox.x + 24} y={ordersBox.y + 38} size={22} />
      <text x={ordersBox.x + 44} y={ordersBox.y + 43} class="sw-name">
        <tspan data-lang-en>Orders</tspan>
        <tspan data-lang-vi>Đơn hàng</tspan>
      </text>
      <text x={ordersBox.x + ordersBox.w / 2} y={ordersBox.y + 72} text-anchor="middle" class="sw-sub">
        <tspan data-lang-en>shard by order_id</tspan>
        <tspan data-lang-vi>shard theo order_id</tspan>
      </text>
    </g>
    <g class="sw-box">
      <rect x={indexBox.x} y={indexBox.y + 14} width={indexBox.w} height={indexBox.h} rx="8" />
      <DiagramIcon name="db" x={indexBox.x + 24} y={indexBox.y + 38} size={22} />
      <text x={indexBox.x + 44} y={indexBox.y + 43} class="sw-name">
        <tspan data-lang-en>Email index</tspan>
        <tspan data-lang-vi>Index theo email</tspan>
      </text>
      <text x={indexBox.x + indexBox.w / 2} y={indexBox.y + 72} text-anchor="middle" class="sw-sub">
        <tspan data-lang-en>shard by email</tspan>
        <tspan data-lang-vi>shard theo email</tspan>
      </text>
    </g>

    <g class="sw-arrow is-dash">
      <path d={`M ${ordersBox.x + ordersBox.w + 4} ${midY + 14} L ${indexBox.x - 12} ${midY + 14}`} />
      <polygon points={head(indexBox.x - 4, midY + 14, 0)} />
    </g>
    <text x={(ordersBox.x + ordersBox.w + indexBox.x) / 2} y={midY - 2} text-anchor="middle" class="sw-sub">
      <tspan data-lang-en>async copy</tspan>
      <tspan data-lang-vi>chép bất đồng bộ</tspan>
    </text>

    <DiagramIcon name="laptop" x={522} y={midY + 14} size={28} />
    <text x="522" y={midY + 46} text-anchor="middle" class="sw-sub">
      <tspan data-lang-en>Search</tspan>
      <tspan data-lang-vi>Tìm kiếm</tspan>
    </text>
    <g class="sw-arrow">
      <path d={`M 496 ${midY + 14} L ${indexBox.x + indexBox.w + 12} ${midY + 14}`} />
      <polygon points={head(indexBox.x + indexBox.w + 4, midY + 14, Math.PI)} />
    </g>
  </svg>
</div>

<style>
  .sw { width: 100%; }
  .sw svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .sw text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .sw .sw-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sw .sw-name { font-weight: 700; fill: var(--text); }
  .sw .sw-sub, .sw .sw-num { fill: var(--text-muted); }
  .sw .sw-num.is-slow { fill: var(--red); font-weight: 700; }
  .sw .sw-note { fill: var(--text); }
  .sw-dot { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .sw-dot.is-slow { fill: var(--red); stroke: var(--red); }
  .sw-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .sw-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .sw-arrow polygon { fill: var(--text-muted); }
  .sw-arrow.is-dash path { stroke-dasharray: 5 4; }
  .sw-bar { stroke: var(--text-muted); stroke-width: 1.4; }
  .sw-rule { stroke: var(--border); stroke-width: 1; }
</style>
