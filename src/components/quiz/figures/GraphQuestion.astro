---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 07: top, a person's friendships followed hop by hop (a toy fan-out of 3);
// bottom, one GraphQL request turning into several database calls.
// Mechanism only, no counts and no results. Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 404;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

// Top panel: toy tree, fan-out 3
const youX = 40, youY = 104;
const h1X = 170, h2X = 320, h3X = 450;
const h1 = [0, 1, 2].map((i) => ({ x: h1X, y: 56 + i * 48 }));
const h2 = [0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => ({ x: h2X, y: 40 + i * 16 }));
const h3dots = h2.flatMap((p) => [-4, 0, 4].map((d) => ({ x: h3X + 18, y: p.y + d, fromY: p.y })));

// Bottom panel
const srv = { x: 136, y: 262, w: 100, h: 124 };
const dbx = { x: 478, y: 262, w: 92, h: 124 };
const calls = [
  { y: 286, en: 'friends of Mai', vi: 'bạn của Mai', bad: false },
  { y: 318, en: 'posts of friend 1', vi: 'bài của bạn 1', bad: true },
  { y: 350, en: 'posts of friend 2', vi: 'bài của bạn 2', bad: true },
  { y: 376, en: 'posts of friend 3 …', vi: 'bài của bạn 3 …', bad: true },
];
const phoneArrow = arrow(66, 324, srv.x - 2, 324);
---
<div class="qg">
  <div>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: one person's friendships followed hop by hop, each hop branching out further. Bottom: one request from a phone to a GraphQL server turns into several separate database calls.">
      <text x="10" y="20" class="qg-h">
        <tspan data-lang-en>Following friendships, hop by hop</tspan>
        <tspan data-lang-vi>Đi theo quan hệ bạn bè, từng bước một</tspan>
      </text>

      <!-- edges first -->
      {h1.map((p) => {
        const a = arrow(youX + 20, youY, p.x - 10, p.y);
        return <g class="qg-arrow"><path d={a.line} /><polygon points={a.head} /></g>;
      })}
      {h2.map((p, i) => {
        const parent = h1[Math.floor(i / 3)];
        const a = arrow(parent.x + 10, parent.y, p.x - 8, p.y);
        return <g class="qg-arrow"><path d={a.line} /><polygon points={a.head} /></g>;
      })}
      {h2.map((p) => (
        <g class="qg-fan"><path d={`M ${p.x + 8} ${p.y} L ${h3X + 14} ${p.y - 4} M ${p.x + 8} ${p.y} L ${h3X + 14} ${p.y} M ${p.x + 8} ${p.y} L ${h3X + 14} ${p.y + 4}`} /></g>
      ))}

      <!-- nodes -->
      <DiagramIcon name="user" x={youX} y={youY} size={28} />
      {h1.map((p) => <circle cx={p.x} cy={p.y} r="9" class="qg-node" />)}
      {h2.map((p) => <circle cx={p.x} cy={p.y} r="5" class="qg-node" />)}
      {h3dots.map((d) => <circle cx={d.x} cy={d.y} r="1.8" class="qg-dot" />)}
      <text x={h3X + 30} y={110} class="qg-bad">…</text>

      <!-- column labels -->
      <text x={youX} y="160" text-anchor="middle" class="qg-sub">
        <tspan data-lang-en>You</tspan>
        <tspan data-lang-vi>Bạn</tspan>
      </text>
      <text x={h1X} y="212" text-anchor="middle" class="qg-sub">
        <tspan data-lang-en>Hop 1</tspan>
        <tspan data-lang-vi>Bước 1</tspan>
      </text>
      <text x={h2X} y="212" text-anchor="middle" class="qg-sub">
        <tspan data-lang-en>Hop 2</tspan>
        <tspan data-lang-vi>Bước 2</tspan>
      </text>
      <text x={h3X + 16} y="212" text-anchor="middle" class="qg-sub">
        <tspan data-lang-en>Hop 3</tspan>
        <tspan data-lang-vi>Bước 3</tspan>
      </text>
      <text x="570" y="20" text-anchor="end" class="qg-note">
        <tspan data-lang-en>toy example: 3 friends each</tspan>
        <tspan data-lang-vi>ví dụ thu nhỏ: mỗi người 3 bạn</tspan>
      </text>

      <line x1="10" x2="570" y1="230" y2="230" class="qg-rule" />

      <!-- bottom panel -->
      <text x="10" y="252" class="qg-h2">
        <tspan data-lang-en>One screen through a GraphQL API</tspan>
        <tspan data-lang-vi>Một màn hình qua GraphQL API</tspan>
      </text>

      <DiagramIcon name="phone" x={40} y={324} size={28} />
      <g class="qg-arrow"><path d={phoneArrow.line} /><polygon points={phoneArrow.head} /></g>
      <text x="94" y="312" text-anchor="middle" class="qg-sub">
        <tspan data-lang-en>1 request</tspan>
        <tspan data-lang-vi>1 request</tspan>
      </text>

      <g class="qg-box">
        <rect x={srv.x} y={srv.y} width={srv.w} height={srv.h} rx="8" />
        <DiagramIcon name="server" x={srv.x + srv.w / 2} y={srv.y + 24} size={22} />
        <text x={srv.x + srv.w / 2} y={srv.y + 62} text-anchor="middle" class="qg-name">GraphQL</text>
        <text x={srv.x + srv.w / 2} y={srv.y + 80} text-anchor="middle" class="qg-sub">
          <tspan data-lang-en>resolvers</tspan>
          <tspan data-lang-vi>resolver</tspan>
        </text>
      </g>
      <g class="qg-box">
        <rect x={dbx.x} y={dbx.y} width={dbx.w} height={dbx.h} rx="8" />
        <DiagramIcon name="postgres" x={dbx.x + dbx.w / 2} y={dbx.y + 36} size={26} />
        <text x={dbx.x + dbx.w / 2} y={dbx.y + 78} text-anchor="middle" class="qg-name">
          <tspan data-lang-en>Database</tspan>
          <tspan data-lang-vi>Database</tspan>
        </text>
      </g>

      {calls.map((c) => {
        const a = arrow(srv.x + srv.w + 2, c.y, dbx.x - 2, c.y);
        return (
          <g>
            <g class={c.bad ? 'qg-arrow is-bad' : 'qg-arrow'}><path d={a.line} /><polygon points={a.head} /></g>
            <text x={(srv.x + srv.w + dbx.x) / 2} y={c.y - 6} text-anchor="middle" class={c.bad ? 'qg-call is-bad' : 'qg-call'}>
              <tspan data-lang-en>{c.en}</tspan>
              <tspan data-lang-vi>{c.vi}</tspan>
            </text>
          </g>
        );
      })}
    </svg>
  </div>
</div>

<style>
  .qg { width: 100%; }
  .qg svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qg text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qg .qg-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qg .qg-h2 { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qg .qg-name { font-weight: 700; fill: var(--text); }
  .qg .qg-sub, .qg .qg-note { fill: var(--text-muted); }
  .qg .qg-note { font-size: 13px; }
  .qg .qg-call { font-size: 13px; fill: var(--text-body); }
  .qg .qg-call.is-bad { fill: var(--red); }
  .qg .qg-bad { font-size: 18px; font-weight: 700; fill: var(--red); }
  .qg-node { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .qg-dot { fill: var(--red); }
  .qg-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qg-rule { stroke: var(--border); stroke-width: 1.2; }
  .qg-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.2; }
  .qg-arrow polygon { fill: var(--text-muted); }
  .qg-arrow.is-bad path { stroke: var(--red); }
  .qg-arrow.is-bad polygon { fill: var(--red); }
  .qg-fan path { fill: none; stroke: var(--red); stroke-width: 0.8; opacity: 0.7; }
</style>
