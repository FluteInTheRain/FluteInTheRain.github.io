---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for stream set 08: partition 7 as a row of offset boxes (99 to 106), the last committed
// offset (100), the five records the job already wrote to PostgreSQL (101 to 105), the crash before the
// commit, and the counter row before the batch. It does not show the replacement or any final counter value.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const x0 = 50;
const step = 60;
const bw = 54;
const by = 100;
const bh = 44;
const offsets = [99, 100, 101, 102, 103, 104, 105, 106];
const bx = (i: number) => x0 + i * step;
const commitX = bx(2) - 3;
const crashX = bx(6) + bw + 3;
---
<div class="qfig-og">
  <svg viewBox="0 0 580 250" role="img" aria-label="Partition 7 as boxes for offsets 99 to 106: offset 100 is the last committed one, the job has written records 101 to 105 to the PostgreSQL counter, and it crashes before committing 105. The counter row read 1,000 before record 101.">
    <text x="0" y="22" class="qfig-og-h">
      <tspan data-lang-en>One job, one partition, one counter</tspan>
      <tspan data-lang-vi>Một job, một partition, một counter</tspan>
    </text>

    <text x="0" y="56" class="qfig-og-lane">
      <tspan data-lang-en>Partition 7</tspan>
      <tspan data-lang-vi>Partition 7</tspan>
    </text>
    <text x={commitX + 8} y="56" class="qfig-og-t">
      <tspan data-lang-en>last committed: 100</tspan>
      <tspan data-lang-vi>đã commit tới: 100</tspan>
    </text>
    <text x="580" y="56" text-anchor="end" class="qfig-og-bad">
      <tspan data-lang-en>crash before commit</tspan>
      <tspan data-lang-vi>sập trước khi commit</tspan>
    </text>

    {offsets.map((o, i) => (
      <g>
        <rect x={bx(i)} y={by} width={bw} height={bh} rx="6" class={o >= 101 && o <= 105 ? 'qfig-og-box qfig-og-written' : 'qfig-og-box'} />
        <text x={bx(i) + bw / 2} y={by + 27} text-anchor="middle" class="qfig-og-num">{o}</text>
      </g>
    ))}

    <line x1={commitX} x2={commitX} y1="70" y2="158" class="qfig-og-commit" />
    <line x1={crashX} x2={crashX} y1="88" y2="158" class="qfig-og-crash" />
    <DiagramIcon name="fail" x={crashX} y={74} size={22} />

    <path d={`M ${bx(2)} 156 V 164 H ${bx(6) + bw - 6} V 156`} class="qfig-og-brace" />
    <text x={(bx(2) + bx(6) + bw - 6) / 2} y="186" text-anchor="middle" class="qfig-og-t">
      <tspan data-lang-en>Already wrote +1 for each of 101 to 105</tspan>
      <tspan data-lang-vi>Đã ghi +1 cho từng bản ghi 101 đến 105</tspan>
    </text>

    <rect x="0" y="202" width="580" height="44" rx="8" class="qfig-og-row" />
    <DiagramIcon name="db" x={26} y={224} size={26} />
    <text x="56" y="219" class="qfig-og-lane">
      <tspan data-lang-en>PostgreSQL, counter for partition 7</tspan>
      <tspan data-lang-vi>PostgreSQL, counter của partition 7</tspan>
    </text>
    <text x="56" y="238" class="qfig-og-m">
      <tspan data-lang-en>1,000 before record 101</tspan>
      <tspan data-lang-vi>1.000 trước bản ghi 101</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-og { margin: 0; width: 100%; }
  .qfig-og svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-og text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-og .qfig-og-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-og .qfig-og-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-og .qfig-og-t { font-weight: 600; fill: var(--text); }
  .qfig-og .qfig-og-m { fill: var(--text-muted); }
  .qfig-og .qfig-og-num { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-og .qfig-og-bad { font-weight: 700; fill: var(--red); }
  .qfig-og-box { fill: var(--bg); stroke: var(--border); stroke-width: 1.5; }
  .qfig-og-written { fill: var(--bg-alt); stroke: var(--text-muted); }
  .qfig-og-commit { stroke: var(--gold); stroke-width: 3; }
  .qfig-og-crash { stroke: var(--red); stroke-width: 2.5; stroke-dasharray: 5 4; }
  .qfig-og-brace { stroke: var(--text-muted); stroke-width: 1.6; fill: none; }
  .qfig-og-row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
</style>
