---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 02: the order book of the illustrative stock near 24,500 VND.
// Best bid 24,500 x 1,200; best ask 24,550 x 600; spread = 50 VND = one tick.
const W = 580;
const H = 470;
const maxQ = 2500;
const barMax = 190;
const bids = [
  { price: '24,500', q: 1200 },
  { price: '24,450', q: 2000 },
  { price: '24,400', q: 2500 },
];
const asks = [
  { price: '24,550', q: 600 },
  { price: '24,600', q: 900 },
  { price: '24,650', q: 1100 },
];
const rowH = 66;
const y0 = 108;
const cx = 290;
const bidX = 276;
const askX = 304;
---
<div class="qbd">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <DiagramIcon name="chart" x={18} y={16} size={22} />
    <text x="40" y="21" class="qbd-h">
      <tspan data-lang-en>The order book, right now</tspan>
      <tspan data-lang-vi>Sổ lệnh, tại thời điểm này</tspan>
    </text>
    <text x={bidX} y="52" text-anchor="end" class="qbd-side qbd-bids">
      <tspan data-lang-en>Bids — buy orders waiting</tspan>
      <tspan data-lang-vi>Bid — các lệnh mua đang chờ</tspan>
    </text>
    <text x={askX} y="52" class="qbd-side qbd-asks">
      <tspan data-lang-en>Asks — sell orders waiting</tspan>
      <tspan data-lang-vi>Ask — các lệnh bán đang chờ</tspan>
    </text>

    {asks.map((a, i) => {
      const y = y0 + i * rowH;
      const w = (a.q / maxQ) * barMax;
      return (
        <g>
          <rect x={askX} y={y} width={w} height="34" rx="4" class="qbd-bar qbd-ask" />
          <text x={askX + 8} y={y + 22} class="qbd-price">{a.price}</text>
          <text x={askX + w - 8} y={y + 22} text-anchor="end" class="qbd-q">{a.q.toLocaleString('en-US')}</text>
        </g>
      );
    })}
    {bids.map((b, i) => {
      const y = y0 + i * rowH;
      const w = (b.q / maxQ) * barMax;
      return (
        <g>
          <rect x={bidX - w} y={y} width={w} height="34" rx="4" class="qbd-bar qbd-bid" />
          <text x={bidX - w + 8} y={y + 22} class="qbd-price">{b.price}</text>
          <text x={bidX - 8} y={y + 22} text-anchor="end" class="qbd-q">{b.q.toLocaleString('en-US')}</text>
        </g>
      );
    })}

    <text x={cx} y={y0 - 14} text-anchor="middle" class="qbd-tick">
      <tspan data-lang-en>price →</tspan>
      <tspan data-lang-vi>giá →</tspan>
    </text>

    <g class="qbd-spread">
      <line x1={cx} x2={cx} y1={y0 - 2} y2={y0 + 30} />
      {/* labels sit in the gap between rows 1 and 2 so "50 đ" cannot touch the row-2 bar tips */}
      <text x={cx} y={y0 + 46} text-anchor="middle" class="qbd-spread-t">
        <tspan data-lang-en>spread</tspan>
        <tspan data-lang-vi>chênh lệch</tspan>
      </text>
      <text x={cx} y={y0 + 62} text-anchor="middle" class="qbd-spread-v">50 đ</text>
    </g>

    <line x1="14" x2={W - 14} y1="318" y2="318" class="qbd-rule" />
    <text x="14" y="344" class="qbd-note">
      <tspan data-lang-en>Best bid 24,500 and best ask 24,550 bracket the market.</tspan>
      <tspan data-lang-vi>Bid tốt nhất 24.500 và ask tốt nhất 24.550 kẹp thị trường ở giữa.</tspan>
    </text>
    <text x="14" y="366" class="qbd-note">
      <tspan data-lang-en>The gap is one tick: prices move in 50 đ steps in this range.</tspan>
      <tspan data-lang-vi>Khoảng cách bằng đúng một bước giá: vùng này giá đi theo bước 50 đồng.</tspan>
    </text>
    <text x="14" y="396" class="qbd-tick">
      <tspan data-lang-en>Tick on HOSE: 10 đ under 10,000 · 50 đ to 49,950 · 100 đ from 50,000 up</tspan>
      <tspan data-lang-vi>Bước giá trên HOSE: 10 đ dưới 10.000 · 50 đ tới 49.950 · 100 đ từ 50.000 trở lên</tspan>
    </text>
    <text x="14" y="424" class="qbd-tick">
      <tspan data-lang-en>Numbers in the bars: shares waiting at that price (illustrative)</tspan>
      <tspan data-lang-vi>Số trong thanh: lượng cổ phiếu chờ ở mức giá đó (minh hoạ)</tspan>
    </text>
  </svg>
</div>

<style>
  .qbd {
    margin: 0;
    width: 100%;
  }
  .qbd svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qbd text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qbd .qbd-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qbd .qbd-side {
    font-size: 13.5px;
    font-weight: 700;
  }
  .qbd .qbd-bids {
    fill: var(--act-2);
  }
  .qbd .qbd-asks {
    fill: var(--act-0);
  }
  .qbd .qbd-bar {
    rx: 4;
  }
  .qbd .qbd-bid {
    fill: var(--act-2);
    opacity: 0.22;
    stroke: var(--act-2);
    stroke-width: 1.2;
  }
  .qbd .qbd-ask {
    fill: var(--act-0);
    opacity: 0.18;
    stroke: var(--act-0);
    stroke-width: 1.2;
  }
  .qbd .qbd-price {
    font-weight: 700;
    fill: var(--text);
    font-size: 14px;
  }
  .qbd .qbd-q {
    fill: var(--text-muted);
    font-size: 13px;
  }
  .qbd .qbd-rule {
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .qbd .qbd-note {
    font-size: 13.5px;
    fill: var(--text-body);
  }
  .qbd .qbd-tick {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qbd .qbd-spread line {
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .qbd .qbd-spread-t {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qbd .qbd-spread-v {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
</style>
