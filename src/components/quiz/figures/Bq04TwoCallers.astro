---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-layered-architecture set 01: two entrances approve a refund. The HTTP endpoint checks the
// manager rule inline; the Slack command, written later by copying the endpoint, has no such check. Both write to the
// same refunds table. Inline SVG, site tokens only, no <marker>/<defs>/ids.
function head(x: number, y: number) { return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`; }
---
<div class="qfig-tcl">
  <svg viewBox="0 0 580 270" role="img" aria-label="Two entrances that approve a refund and write to the same refunds table: an HTTP endpoint whose code refuses amounts over 500 without a manager, and a Slack command whose code has no such check.">
    <text x="0" y="22" class="qfig-tcl-h">
      <tspan data-lang-en>Two entrances, one refunds table</tspan>
      <tspan data-lang-vi>Hai lối vào, một bảng refunds</tspan>
    </text>

    <rect x="0" y="40" width="340" height="92" rx="10" class="qfig-tcl-box" />
    <DiagramIcon name="server" x={28} y={72} size={24} />
    <text x="56" y="70" class="qfig-tcl-t">POST /refunds/{'{id}'}/approve</text>
    <text x="14" y="98" class="qfig-tcl-m">
      <tspan data-lang-en>amount over 500 and not a manager → refuse</tspan>
      <tspan data-lang-vi>amount trên 500 mà không phải manager → từ chối</tspan>
    </text>
    <text x="14" y="118" class="qfig-tcl-m">
      <tspan data-lang-en>Rule written inside this function</tspan>
      <tspan data-lang-vi>Luật viết ngay trong hàm này</tspan>
    </text>

    <rect x="0" y="150" width="340" height="92" rx="10" class="qfig-tcl-box" />
    <DiagramIcon name="slack" x={28} y={182} size={24} />
    <text x="56" y="180" class="qfig-tcl-t">
      <tspan data-lang-en>Slack command /refund approve</tspan>
      <tspan data-lang-vi>Lệnh Slack /refund approve</tspan>
    </text>
    <text x="14" y="208" class="qfig-tcl-bad">
      <tspan data-lang-en>no limit check in this function</tspan>
      <tspan data-lang-vi>không có kiểm tra giới hạn trong hàm này</tspan>
    </text>
    <text x="14" y="228" class="qfig-tcl-m">
      <tspan data-lang-en>Written later, by copying the endpoint</tspan>
      <tspan data-lang-vi>Viết sau, bằng cách chép từ endpoint</tspan>
    </text>

    <line x1="344" x2="432" y1="86" y2="150" class="qfig-tcl-arrow" />
    <line x1="344" x2="432" y1="196" y2="160" class="qfig-tcl-arrow" />
    <polygon points={head(438, 156)} class="qfig-tcl-head" />
    <rect x="440" y="116" width="140" height="80" rx="10" class="qfig-tcl-db" />
    <DiagramIcon name="db" x={470} y={156} size={26} />
    <text x="494" y="152" class="qfig-tcl-t">refunds</text>
    <text x="494" y="172" class="qfig-tcl-m">
      <tspan data-lang-en>table</tspan>
      <tspan data-lang-vi>bảng</tspan>
    </text>
    <text x="14" y="262" class="qfig-tcl-m">
      <tspan data-lang-en>Support agent, not a manager, approves a refund of 900 from Slack</tspan>
      <tspan data-lang-vi>Nhân viên hỗ trợ, không phải manager, duyệt hoàn tiền 900 từ Slack</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-tcl { margin: 0; width: 100%; }
  .qfig-tcl svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-tcl text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-tcl .qfig-tcl-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-tcl .qfig-tcl-t { font-weight: 700; fill: var(--text); }
  .qfig-tcl .qfig-tcl-m { fill: var(--text-muted); font-size: 13px; }
  .qfig-tcl .qfig-tcl-bad { font-weight: 700; fill: var(--red); font-size: 13px; }
  .qfig-tcl-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-tcl-db { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-tcl-arrow { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-tcl-head { fill: var(--text-muted); }
</style>
