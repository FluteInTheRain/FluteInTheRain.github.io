---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for set 06 (encoding post): a rolling deploy of 6 servers, one every 2 minutes, with the
// moment a migration drops a column and the table that holds it. Shows the scenario's inputs only,
// never the number of servers whose queries would fail.
// Inline SVG, site tokens only, no <marker>/<defs>/ids.
const x0 = 34;
const perMin = 42;
const axisY = 134;
const switches = [2, 4, 6, 8, 10, 12];
const px = (m: number) => x0 + m * perMin;
const dropX = px(5);
const cols = [
  { x: 0, w: 110, en: 'id', vi: 'id', hot: false },
  { x: 110, w: 130, en: 'total', vi: 'total', hot: false },
  { x: 240, w: 170, en: 'coupon_code', vi: 'coupon_code', hot: true },
];
---
<div class="qfig-drop">
  <svg viewBox="0 0 580 336" role="img" aria-label="A timeline from 10:00 to 10:12: six servers switch to the new release one every 2 minutes, and a migration drops the coupon_code column of the orders table at 10:05.">
    <text x="0" y="22" class="qfig-drop-h">
      <tspan data-lang-en>Rolling deploy: 6 servers, one every 2 minutes</tspan>
      <tspan data-lang-vi>Rolling deploy: 6 server, mỗi 2 phút một server</tspan>
    </text>

    <line x1={x0} x2={px(12)} y1={axisY} y2={axisY} class="qfig-drop-axis" />
    <line x1={x0} x2={x0} y1={axisY - 6} y2={axisY + 6} class="qfig-drop-axis" />
    <text x={x0} y={axisY + 24} text-anchor="middle" class="qfig-drop-m">10:00</text>

    {switches.map((m, i) => (
      <g>
        <line x1={px(m)} x2={px(m)} y1={104} y2={axisY} class="qfig-drop-stem" />
        <circle cx={px(m)} cy={axisY} r="5" class="qfig-drop-dot" />
        <DiagramIcon name="server" x={px(m)} y={90} size={24} />
        <text x={px(m)} y={axisY + 24} text-anchor="middle" class="qfig-drop-m">10:{String(m).padStart(2, '0')}</text>
        <text x={px(m)} y={axisY + 42} text-anchor="middle" class="qfig-drop-s">
          <tspan data-lang-en>server {i + 1}</tspan>
          <tspan data-lang-vi>server {i + 1}</tspan>
        </text>
      </g>
    ))}

    <line x1={dropX} x2={dropX} y1="58" y2={axisY + 50} class="qfig-drop-cut" />
    <rect x={dropX - 66} y="36" width="132" height="22" rx="6" class="qfig-drop-cutbg" />
    <text x={dropX} y="52" text-anchor="middle" class="qfig-drop-cutt">
      <tspan data-lang-en>10:05 drop column</tspan>
      <tspan data-lang-vi>10:05 xoá cột</tspan>
    </text>

    <text x={x0} y="214" class="qfig-drop-n">
      <tspan data-lang-en>Gold dot: that server switches to the new release.</tspan>
      <tspan data-lang-vi>Chấm vàng: server đó chuyển sang bản mới.</tspan>
    </text>

    <DiagramIcon name="db" x="30" y="250" size={28} />
    <text x="60" y="247" class="qfig-drop-t">
      <tspan data-lang-en>Table orders in Postgres</tspan>
      <tspan data-lang-vi>Bảng orders trong Postgres</tspan>
    </text>
    <g transform="translate(60 260)">
      {cols.map((c) => (
        <g>
          <rect x={c.x} y="0" width={c.w} height="34" class={c.hot ? 'qfig-drop-cell qfig-drop-hot' : 'qfig-drop-cell'} />
          <text x={c.x + c.w / 2} y="22" text-anchor="middle" class={c.hot ? 'qfig-drop-hott' : 'qfig-drop-ct'}>{c.en}</text>
        </g>
      ))}
    </g>
    <text x="60" y="318" class="qfig-drop-m">
      <tspan data-lang-en>Old release: reads coupon_code at checkout. New release: no line mentions it.</tspan>
      <tspan data-lang-vi>Bản cũ: đọc coupon_code lúc checkout. Bản mới: không dòng nào nhắc tới nó.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-drop { margin: 0; width: 100%; }
  .qfig-drop svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-drop text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-drop .qfig-drop-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-drop .qfig-drop-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-drop .qfig-drop-m { fill: var(--text-muted); }
  .qfig-drop .qfig-drop-s { font-size: 13px; fill: var(--text-muted); }
  .qfig-drop .qfig-drop-n { fill: var(--text-muted); }
  .qfig-drop-axis { stroke: var(--text-muted); stroke-width: 1.6; }
  .qfig-drop-stem { stroke: var(--gold); stroke-width: 1.6; }
  .qfig-drop-dot { fill: var(--gold); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-drop-cut { stroke: var(--red); stroke-width: 2; stroke-dasharray: 6 4; }
  .qfig-drop-cutbg { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
  .qfig-drop .qfig-drop-cutt { font-weight: 700; fill: var(--red); }
  .qfig-drop-cell { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-drop-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .qfig-drop .qfig-drop-ct { font-weight: 600; fill: var(--text); }
  .qfig-drop .qfig-drop-hott { font-weight: 700; fill: var(--red); }
</style>
