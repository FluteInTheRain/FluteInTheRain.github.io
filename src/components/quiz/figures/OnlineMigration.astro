---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for data-models set 04: one ALTER on the live table, or a shadow copy that is filled in
// the background, kept in sync with new writes and swapped in, with two replicas following the primary.
// Inline SVG, site tokens only, no <marker>/<defs>. Shows only the scenario's inputs, never a computed result.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 7 * Math.cos(a)} ${y2 - 7 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const copy = arrow(180, 176, 398, 176);
const mirror = arrow(180, 214, 398, 214);
const writes = arrow(85, 276, 85, 236);
---
<div class="qfig-mig">
  <svg viewBox="0 0 580 452" role="img" aria-label="Two ways to change the orders table: one ALTER on the live table, or a shadow copy filled in the background, kept in sync with new writes and swapped in, with two replicas following the primary.">
    <text x="0" y="22" class="qfig-mig-h">
      <tspan data-lang-en>Way 1: change the live table in place</tspan>
      <tspan data-lang-vi>Cách 1: đổi ngay trên bảng đang chạy</tspan>
    </text>
    <g class="qfig-mig-plain">
      <rect x="0" y="34" width="580" height="54" rx="8" />
      <DiagramIcon name="mysql" x="30" y="61" size={26} />
      <text x="58" y="56" class="qfig-mig-t">
        <tspan data-lang-en>orders: 800,000,000 rows</tspan>
        <tspan data-lang-vi>orders: 800.000.000 dòng</tspan>
      </text>
      <text x="58" y="76" class="qfig-mig-m">
        <tspan data-lang-en>One ALTER TABLE statement runs on this table.</tspan>
        <tspan data-lang-vi>Một câu ALTER TABLE chạy trên chính bảng này.</tspan>
      </text>
    </g>

    <line x1="0" x2="580" y1="108" y2="108" class="qfig-mig-rule" />
    <text x="0" y="132" class="qfig-mig-h">
      <tspan data-lang-en>Way 2: build a shadow copy, then swap</tspan>
      <tspan data-lang-vi>Cách 2: dựng bảng bóng, rồi đổi chỗ</tspan>
    </text>

    <g class="qfig-mig-plain">
      <rect x="0" y="146" width="180" height="90" rx="8" />
      <DiagramIcon name="mysql" x="28" y="176" size={26} />
      <text x="52" y="172" class="qfig-mig-t">orders</text>
      <text x="52" y="190" class="qfig-mig-m">
        <tspan data-lang-en>old schema</tspan>
        <tspan data-lang-vi>schema cũ</tspan>
      </text>
      <text x="14" y="219" class="qfig-mig-n">
        <tspan data-lang-en>800,000,000 rows</tspan>
        <tspan data-lang-vi>800.000.000 dòng</tspan>
      </text>
    </g>
    <g class="qfig-mig-ghost">
      <rect x="400" y="146" width="180" height="90" rx="8" />
      <DiagramIcon name="mysql" x="428" y="176" size={26} />
      <text x="452" y="172" class="qfig-mig-t">orders_new</text>
      <text x="452" y="190" class="qfig-mig-m">
        <tspan data-lang-en>new schema</tspan>
        <tspan data-lang-vi>schema mới</tspan>
      </text>
      <text x="414" y="219" class="qfig-mig-n">
        <tspan data-lang-en>filling up</tspan>
        <tspan data-lang-vi>đang được điền</tspan>
      </text>
    </g>

    <text x="289" y="163" text-anchor="middle" class="qfig-mig-g">
      <tspan data-lang-en>Copy old rows: 25,000 rows/s</tspan>
      <tspan data-lang-vi>Copy dòng cũ: 25.000 dòng/s</tspan>
    </text>
    <g class="qfig-mig-go"><path d={copy.line} /><polygon points={copy.head} /></g>
    <text x="289" y="206" text-anchor="middle" class="qfig-mig-g">
      <tspan data-lang-en>Mirror each new write</tspan>
      <tspan data-lang-vi>Chép theo mỗi lần ghi mới</tspan>
    </text>
    <g class="qfig-mig-go qfig-mig-dash"><path d={mirror.line} /><polygon points={mirror.head} /></g>
    <text x="289" y="234" text-anchor="middle" class="qfig-mig-m">
      <tspan data-lang-en>At the end: swap the two names</tspan>
      <tspan data-lang-vi>Cuối cùng: đổi tên hai bảng</tspan>
    </text>

    <DiagramIcon name="users" x="30" y="296" size={28} />
    <g class="qfig-mig-w"><path d={writes.line} /><polygon points={writes.head} /></g>
    <text x="58" y="292" class="qfig-mig-t">
      <tspan data-lang-en>Customers write 4,000 rows/s at peak</tspan>
      <tspan data-lang-vi>Khách ghi 4.000 dòng/s lúc cao điểm</tspan>
    </text>
    <text x="58" y="312" class="qfig-mig-m">
      <tspan data-lang-en>They keep writing to the old table during the copy.</tspan>
      <tspan data-lang-vi>Họ vẫn ghi vào bảng cũ trong lúc copy.</tspan>
    </text>

    <line x1="0" x2="580" y1="338" y2="338" class="qfig-mig-rule" />
    <g class="qfig-mig-plain">
      <rect x="0" y="352" width="580" height="88" rx="8" />
      <DiagramIcon name="server" x="30" y="378" size={24} />
      <DiagramIcon name="server" x="66" y="378" size={24} />
      <text x="96" y="383" class="qfig-mig-t">
        <tspan data-lang-en>2 replicas follow the primary</tspan>
        <tspan data-lang-vi>2 replica bám theo primary</tspan>
      </text>
      <text x="14" y="412" class="qfig-mig-m">
        <tspan data-lang-en>Each applies at most 24,000 row writes/s. Copy and mirror</tspan>
        <tspan data-lang-vi>Mỗi replica áp dụng tối đa 24.000 lần ghi dòng/s. Việc copy</tspan>
      </text>
      <text x="14" y="430" class="qfig-mig-m">
        <tspan data-lang-en>writes are replicated like any other write.</tspan>
        <tspan data-lang-vi>và chép theo cũng được replicate như mọi lần ghi khác.</tspan>
      </text>
    </g>
  </svg>
</div>

<style>
  .qfig-mig { margin: 0; width: 100%; }
  .qfig-mig svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-mig text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-mig .qfig-mig-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-mig .qfig-mig-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-mig .qfig-mig-n { font-size: 15px; font-weight: 600; fill: var(--text); }
  .qfig-mig .qfig-mig-m { fill: var(--text-muted); }
  .qfig-mig .qfig-mig-g { font-weight: 600; fill: var(--text); }
  .qfig-mig-plain > rect { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .qfig-mig-ghost > rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .qfig-mig-go path { stroke: var(--gold); stroke-width: 2; fill: none; }
  .qfig-mig-go polygon { fill: var(--gold); }
  .qfig-mig-dash path { stroke-dasharray: 6 4; }
  .qfig-mig-w path { stroke: var(--text-muted); stroke-width: 1.8; fill: none; }
  .qfig-mig-w polygon { fill: var(--text-muted); }
  .qfig-mig-rule { stroke: var(--border); }
</style>
