---
// Quiz figure for go-efficiency-workflow-raer-tfbo-hardware-memory set 02: five parallel backend calls for one page.
// Call durations (assumed in the question): 12, 15, 11, 240 and 14 ms, all starting at 0. Inline SVG, site tokens only.
// It draws the five bars and a time axis; it does not mark when the page is ready.
const x0 = 96;
const pxPerMs = 1.7;
const tx = (ms: number) => x0 + ms * pxPerMs;
const calls = [12, 15, 11, 240, 14];
const rowY = (i: number) => 74 + i * 38;
const axisY = 276;
const ticks = [0, 50, 100, 150, 200, 250];
---
<div class="qfig-gq15fl">
  <svg viewBox="0 0 560 306" role="img" aria-label="A time axis from 0 to 250 milliseconds with five horizontal bars, one per backend call for a single page. The calls last 12, 15, 11, 240 and 14 milliseconds, and all start at 0.">
    <text x="0" y="24" class="qfig-gq15fl-h">
      <tspan data-lang-en>One page, five parallel calls</tspan>
      <tspan data-lang-vi>Một trang, năm lệnh gọi song song</tspan>
    </text>

    {calls.map((ms, i) => (
      <g>
        <line x1="0" x2="560" y1={rowY(i) + 19} y2={rowY(i) + 19} class="qfig-gq15fl-rule" />
        <text x="0" y={rowY(i) + 5} class="qfig-gq15fl-lane">
          <tspan data-lang-en>Call {i + 1}</tspan>
          <tspan data-lang-vi>Gọi {i + 1}</tspan>
        </text>
        <rect x={tx(0)} y={rowY(i) - 11} width={ms * pxPerMs} height="22" rx="4" class="qfig-gq15fl-bar" />
        <text x={tx(ms) + 8} y={rowY(i) + 5} class="qfig-gq15fl-t">{ms} ms</text>
      </g>
    ))}

    <line x1={tx(0)} x2={tx(250)} y1={axisY} y2={axisY} class="qfig-gq15fl-axis" />
    {ticks.map((ms) => (
      <g>
        <line x1={tx(ms)} x2={tx(ms)} y1={axisY} y2={axisY + 5} class="qfig-gq15fl-axis" />
        <text x={tx(ms)} y={axisY + 22} text-anchor="middle" class="qfig-gq15fl-m">{ms}</text>
      </g>
    ))}
    <text x="0" y={axisY + 22} class="qfig-gq15fl-m">
      <tspan data-lang-en>Time (ms)</tspan>
      <tspan data-lang-vi>Thời gian (ms)</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq15fl { margin: 0; width: 100%; }
  .qfig-gq15fl svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq15fl text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq15fl .qfig-gq15fl-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq15fl .qfig-gq15fl-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-gq15fl .qfig-gq15fl-t { font-weight: 600; fill: var(--text); }
  .qfig-gq15fl .qfig-gq15fl-m { fill: var(--text-muted); }
  .qfig-gq15fl-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-gq15fl-bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-gq15fl-axis { stroke: var(--text-muted); stroke-width: 1.4; }
</style>
