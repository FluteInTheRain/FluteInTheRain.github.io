---
// Set 08: a model trained on text up to Dec 2022; backtest on 2021-2023 headlines.
const x = (y: number) => 40 + ((y - 2020) / 4) * 500;
---
<div class="q21k">
  <svg viewBox="0 0 580 170" role="img" aria-hidden="true">
    <text x="20" y="24" class="h"><tspan data-lang-en>Training text vs backtest window</tspan><tspan data-lang-vi>Văn bản huấn luyện so với cửa sổ backtest</tspan></text>
    <rect x={x(2020)} y="38" width={x(2023) - x(2020)} height="26" rx="4" class="t" />
    <text x={x(2020) + 10} y="56" class="s"><tspan data-lang-en>training text, ends Dec 2022</tspan><tspan data-lang-vi>văn bản huấn luyện, đến 12/2022</tspan></text>
    <rect x={x(2021)} y="76" width={x(2023) - x(2021)} height="26" rx="4" class="l" />
    <rect x={x(2023)} y="76" width={x(2024) - x(2023)} height="26" rx="4" class="k" />
    <text x={x(2021) + 10} y="94" class="s"><tspan data-lang-en>2021-2022</tspan><tspan data-lang-vi>2021-2022</tspan></text>
    <text x={x(2023) + 10} y="94" class="s">2023</text>
    <line x1="40" y1="118" x2="540" y2="118" class="a" />
    {[2020, 2021, 2022, 2023, 2024].map((y) => (<g><line x1={x(y)} y1="113" x2={x(y)} y2="123" class="a" /><text x={x(y)} y="140" text-anchor="middle" class="m">{y}</text></g>))}
  </svg>
</div>
<style>
  .q21k svg { display: block; width: 100%; height: auto; }
  .q21k text { font-size: 13px; fill: var(--text-body); }
  .q21k .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .q21k .s { fill: var(--text); font-weight: 600; }
  .q21k .m { font-size: 12px; fill: var(--text-muted); }
  .q21k .t { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.1; }
  .q21k .l { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
  .q21k .k { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.3; }
  .q21k .a { stroke: var(--text-muted); stroke-width: 1.2; }
</style>
