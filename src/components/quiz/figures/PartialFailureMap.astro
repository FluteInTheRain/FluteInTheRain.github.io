---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for distributed-systems set 01: a payment call trace from Host A to Host B (charge($45),
// TCP ACK at 12 ms from the kernel socket buffer, 5,000 ms timeout with no app reply), plus Host C's
// one-way drop and the medium datacenter monthly fault counts. Does not name or state any quiz answer.
// Inline SVG, site tokens only, no SVG markers, patterns, filters, clip paths, or id attributes.
function arrowR(x1: number, x2: number, y: number) {
  return {
    line: `M ${x1} ${y} L ${x2 - 7} ${y}`,
    head: `${x2},${y} ${x2 - 9},${y - 4.5} ${x2 - 9},${y + 4.5}`,
  };
}
function arrowL(x1: number, x2: number, y: number) {
  return {
    line: `M ${x1} ${y} L ${x2 + 7} ${y}`,
    head: `${x2},${y} ${x2 + 9},${y - 4.5} ${x2 + 9},${y + 4.5}`,
  };
}
function arrowD(x: number, y1: number, y2: number) {
  return {
    line: `M ${x} ${y1} L ${x} ${y2 - 6}`,
    head: `${x},${y2} ${x - 4},${y2 - 8} ${x + 4},${y2 - 8}`,
  };
}

const sendArr = arrowR(175, 327, 89);
const ackArr = arrowL(327, 175, 108);
const replyArr = arrowL(327, 175, 159);
const readArr = arrowD(442, 114, 136);
const pingInArr = arrowR(82, 186, 287);
const pingOutArr = arrowL(186, 82, 319);
---
<div class="qfig-pfm">
  <svg viewBox="0 0 580 374" role="img" aria-label="Host A sends charge($45) over TCP to Host B, receives a TCP ACK from Host B's OS kernel buffer at 12 ms, and hits a 5,000 ms timeout with no app reply. Below, Host C receives inbound pings while dropping outbound replies, and a datacenter study counts about 12 network faults per month.">
    <text x="10" y="22" class="qfig-pfm-h">
      <tspan data-lang-en>Payment call trace and cluster fault map</tspan>
      <tspan data-lang-vi>Lược đồ gọi thanh toán và các lỗi trong cụm</tspan>
    </text>

    <!-- Host A -->
    <rect x="10" y="42" width="165" height="150" rx="8" class="qfig-pfm-card" />
    <DiagramIcon name="server" x={34} y={66} size={22} />
    <text x="52" y="71" class="qfig-pfm-name">Host A</text>
    <text x="22" y="96" class="qfig-pfm-m">
      <tspan data-lang-en>Order service</tspan>
      <tspan data-lang-vi>Order service</tspan>
    </text>
    <rect x="22" y="108" width="141" height="28" rx="6" class="qfig-pfm-pill" />
    <DiagramIcon name="card" x={39} y={122} size={16} />
    <text x="54" y="127" class="qfig-pfm-t">charge($45)</text>
    <DiagramIcon name="stopwatch" x={34} y={160} size={18} />
    <text x="49" y="160" class="qfig-pfm-red">
      <tspan data-lang-en>5,000 ms</tspan>
      <tspan data-lang-vi>5.000 ms</tspan>
    </text>
    <text x="49" y="177" class="qfig-pfm-red">
      <tspan data-lang-en>timeout fires</tspan>
      <tspan data-lang-vi>chạm timeout</tspan>
    </text>

    <!-- Host B -->
    <rect x="315" y="42" width="255" height="150" rx="8" class="qfig-pfm-shell" />
    <DiagramIcon name="server" x={337} y={62} size={20} />
    <text x="354" y="67" class="qfig-pfm-name">
      <tspan data-lang-en>Host B · Payment</tspan>
      <tspan data-lang-vi>Host B · Thanh toán</tspan>
    </text>

    <rect x="327" y="78" width="231" height="36" rx="6" class="qfig-pfm-goldbox" />
    <text x="442" y="101" text-anchor="middle" class="qfig-pfm-t">
      <tspan data-lang-en>OS kernel socket buffer</tspan>
      <tspan data-lang-vi>Bộ đệm socket của kernel</tspan>
    </text>

    <path d={readArr.line} class="qfig-pfm-ln" />
    <polygon points={readArr.head} class="qfig-pfm-hd" />
    <text x="454" y="130" class="qfig-pfm-m">read()?</text>

    <rect x="327" y="138" width="231" height="44" rx="6" class="qfig-pfm-appbox" />
    <text x="442" y="157" text-anchor="middle" class="qfig-pfm-t">
      <tspan data-lang-en>Payment app</tspan>
      <tspan data-lang-vi>Ứng dụng thanh toán</tspan>
    </text>
    <text x="442" y="174" text-anchor="middle" class="qfig-pfm-m">
      <tspan data-lang-en>status after 12 ms: unknown</tspan>
      <tspan data-lang-vi>sau 12 ms: chưa rõ trạng thái</tspan>
    </text>

    <!-- Wire arrows between Host A and Host B -->
    <path d={sendArr.line} class="qfig-pfm-ln" />
    <polygon points={sendArr.head} class="qfig-pfm-hd" />
    <text x="251" y="79" text-anchor="middle" class="qfig-pfm-m">
      <tspan data-lang-en>0 ms · TCP send</tspan>
      <tspan data-lang-vi>0 ms · gửi TCP</tspan>
    </text>

    <path d={ackArr.line} class="qfig-pfm-goldln" />
    <polygon points={ackArr.head} class="qfig-pfm-goldhd" />
    <text x="251" y="126" text-anchor="middle" class="qfig-pfm-goldt">12 ms · TCP ACK</text>

    <path d={replyArr.line} class="qfig-pfm-reddash" />
    <polygon points={replyArr.head} class="qfig-pfm-redhd" />
    <text x="251" y="177" text-anchor="middle" class="qfig-pfm-red">
      <tspan data-lang-en>no app reply</tspan>
      <tspan data-lang-vi>không hồi âm app</tspan>
    </text>

    <!-- Divider -->
    <line x1="10" x2="570" y1="210" y2="210" class="qfig-pfm-rule" />

    <!-- Bottom left: Host C one-way drop -->
    <rect x="10" y="226" width="272" height="136" rx="8" class="qfig-pfm-card" />
    <DiagramIcon name="warning" x={32} y={248} size={20} />
    <text x="48" y="253" class="qfig-pfm-name">
      <tspan data-lang-en>Host C · one-way port drop</tspan>
      <tspan data-lang-vi>Host C · rớt một chiều</tspan>
    </text>
    <text x="20" y="294" class="qfig-pfm-m">
      <tspan data-lang-en>Network</tspan>
      <tspan data-lang-vi>Mạng</tspan>
    </text>
    <path d={pingInArr.line} class="qfig-pfm-goldln" />
    <polygon points={pingInArr.head} class="qfig-pfm-goldhd" />
    <text x="134" y="279" text-anchor="middle" class="qfig-pfm-m">
      <tspan data-lang-en>inbound OK</tspan>
      <tspan data-lang-vi>gói vào OK</tspan>
    </text>
    <path d={pingOutArr.line} class="qfig-pfm-reddash" />
    <polygon points={pingOutArr.head} class="qfig-pfm-redhd" />
    <path d="M 129 313 L 139 325 M 129 325 L 139 313" class="qfig-pfm-redx" />
    <text x="134" y="339" text-anchor="middle" class="qfig-pfm-red">
      <tspan data-lang-en>replies dropped</tspan>
      <tspan data-lang-vi>rớt gói đi ra</tspan>
    </text>
    <rect x="190" y="272" width="82" height="62" rx="6" class="qfig-pfm-pill" />
    <DiagramIcon name="server" x={231} y={293} size={22} />
    <text x="231" y="323" text-anchor="middle" class="qfig-pfm-t">Host C</text>

    <!-- Bottom right: Datacenter fault study -->
    <rect x="298" y="226" width="272" height="136" rx="8" class="qfig-pfm-card" />
    <DiagramIcon name="network" x={320} y={248} size={20} />
    <text x="336" y="253" class="qfig-pfm-name">
      <tspan data-lang-en>~12 network faults / month</tspan>
      <tspan data-lang-vi>~12 sự cố mạng / tháng</tspan>
    </text>

    <rect x="312" y="270" width="38" height="24" rx="5" class="qfig-pfm-goldbox" />
    <text x="331" y="287" text-anchor="middle" class="qfig-pfm-t">~6</text>
    <text x="360" y="287" class="qfig-pfm-t">
      <tspan data-lang-en>isolate 1 server</tspan>
      <tspan data-lang-vi>cô lập 1 máy chủ</tspan>
    </text>

    <rect x="312" y="302" width="38" height="24" rx="5" class="qfig-pfm-redbox" />
    <text x="331" y="319" text-anchor="middle" class="qfig-pfm-red">~6</text>
    <text x="360" y="319" class="qfig-pfm-t">
      <tspan data-lang-en>isolate 1 whole rack</tspan>
      <tspan data-lang-vi>cô lập cả 1 tủ rack</tspan>
    </text>

    <text x="312" y="348" class="qfig-pfm-m">
      <tspan data-lang-en>Medium datacenter measurement</tspan>
      <tspan data-lang-vi>Đo đạc ở data center cỡ vừa</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-pfm { margin: 0; width: 100%; }
  .qfig-pfm svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-pfm text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-pfm .qfig-pfm-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-pfm .qfig-pfm-name { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .qfig-pfm .qfig-pfm-t { font-weight: 600; fill: var(--text); }
  .qfig-pfm .qfig-pfm-m { font-size: 13px; fill: var(--text-muted); }
  .qfig-pfm .qfig-pfm-red { font-weight: 700; fill: var(--red); }
  .qfig-pfm .qfig-pfm-goldt { font-weight: 700; fill: var(--gold-icon); }
  .qfig-pfm-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .qfig-pfm-shell { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .qfig-pfm-pill { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .qfig-pfm-goldbox { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-pfm-redbox { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .qfig-pfm-appbox { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .qfig-pfm-ln { fill: none; stroke: var(--text-muted); stroke-width: 1.6; }
  .qfig-pfm-hd { fill: var(--text-muted); }
  .qfig-pfm-goldln { fill: none; stroke: var(--gold-icon); stroke-width: 1.9; }
  .qfig-pfm-goldhd { fill: var(--gold-icon); }
  .qfig-pfm-reddash { fill: none; stroke: var(--red); stroke-width: 1.6; stroke-dasharray: 4 3; }
  .qfig-pfm-redhd { fill: var(--red); }
  .qfig-pfm-redx { fill: none; stroke: var(--red); stroke-width: 2.2; }
  .qfig-pfm-rule { stroke: var(--border); stroke-width: 1.2; }
</style>
