---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for backend-layered-architecture set 07: the three files of the layered clue.api demo with their sizes
// (wc -l of demo/layered_app.py, layered_service.py, layered_data.py) and the ticket "keep cases in PostgreSQL".
// Shows the project as it is, not which files the change touches. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const files = [
  { y: 46, icon: 'web', name: 'layered_app.py', lines: 121, en: '4 endpoints, 2 exception handlers', vi: '4 endpoint, 2 exception handler' },
  { y: 112, icon: 'worker', name: 'layered_service.py', lines: 64, en: 'open, get, assign and close, with their rules', vi: 'open, get, assign và close, cùng các luật' },
  { y: 178, icon: 'db', name: 'layered_data.py', lines: 49, en: 'CaseRecord, CaseRepository, an in-memory store', vi: 'CaseRecord, CaseRepository, một kho trong bộ nhớ' },
];
---
<div class="qfig-swp">
  <svg viewBox="0 0 580 256" role="img" aria-label="The three files of the layered clue.api: layered_app.py with 121 lines, layered_service.py with 64 lines and layered_data.py with 49 lines, next to a ticket that says to keep cases in PostgreSQL.">
    <text x="0" y="22" class="qfig-swp-h">
      <tspan data-lang-en>The project today, and the ticket</tspan>
      <tspan data-lang-vi>Dự án hiện tại, và ticket</tspan>
    </text>
    {files.map((f) => (
      <g>
        <rect x="0" y={f.y} width="360" height="58" rx="10" class="qfig-swp-box" />
        <DiagramIcon name={f.icon as any} x={28} y={f.y + 29} size={24} />
        <text x="56" y={f.y + 24} class="qfig-swp-t">{f.name}</text>
        <text x="352" y={f.y + 24} text-anchor="end" class="qfig-swp-m">
          <tspan data-lang-en>{f.lines} lines</tspan>
          <tspan data-lang-vi>{f.lines} dòng</tspan>
        </text>
        <text x="56" y={f.y + 44} class="qfig-swp-m">
          <tspan data-lang-en>{f.en}</tspan>
          <tspan data-lang-vi>{f.vi}</tspan>
        </text>
      </g>
    ))}
    <rect x="392" y="46" width="188" height="190" rx="10" class="qfig-swp-ticket" />
    <DiagramIcon name="postgres" x={420} y={80} size={28} />
    <text x="446" y="78" class="qfig-swp-t">
      <tspan data-lang-en>Ticket</tspan>
      <tspan data-lang-vi>Ticket</tspan>
    </text>
    <text x="408" y="124" class="qfig-swp-b">
      <tspan data-lang-en>Keep cases in</tspan>
      <tspan data-lang-vi>Lưu các case trong</tspan>
    </text>
    <text x="408" y="146" class="qfig-swp-b">
      <tspan data-lang-en>PostgreSQL, not in</tspan>
      <tspan data-lang-vi>PostgreSQL, thay vì</tspan>
    </text>
    <text x="408" y="168" class="qfig-swp-b">
      <tspan data-lang-en>a dict in memory</tspan>
      <tspan data-lang-vi>một dict trong bộ nhớ</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-swp { margin: 0; width: 100%; }
  .qfig-swp svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-swp text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-swp .qfig-swp-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-swp .qfig-swp-t { font-weight: 700; fill: var(--text); }
  .qfig-swp .qfig-swp-b { font-weight: 600; fill: var(--text); }
  .qfig-swp .qfig-swp-m { fill: var(--text-muted); font-size: 13px; }
  .qfig-swp-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-swp-ticket { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
</style>
