---
// Quiz figure for Post 2 (visual hierarchy): a support ticket card where only font size separates the lines.
---
<div class="qfig-uxq02ticketcard">
  <svg viewBox="0 0 400 200" role="img" aria-label="A support ticket card. The subject Refund not received is 26px. The customer Linh Tran, the priority High and the time 14 Nov 09:12 are each 12px. All four lines use the same dark colour and the same normal weight.">
    <rect x="6" y="6" width="388" height="188" rx="10" class="card" />
    <text x="24" y="56" class="big"><tspan data-lang-en>Refund not received</tspan><tspan data-lang-vi>Chưa nhận được tiền hoàn</tspan></text>
    <text x="24" y="92" class="small"><tspan data-lang-en>Customer: Linh Tran</tspan><tspan data-lang-vi>Khách hàng: Linh Trần</tspan></text>
    <text x="24" y="116" class="small"><tspan data-lang-en>Priority: High</tspan><tspan data-lang-vi>Độ ưu tiên: Cao</tspan></text>
    <text x="24" y="140" class="small"><tspan data-lang-en>Opened: 14 Nov, 09:12</tspan><tspan data-lang-vi>Mở lúc: 14/11, 09:12</tspan></text>
    <text x="24" y="176" class="note"><tspan data-lang-en>Subject 26px, other lines 12px</tspan><tspan data-lang-vi>Tiêu đề 26px, các dòng khác 12px</tspan></text>
  </svg>
</div>

<style>
  .qfig-uxq02ticketcard { margin: 0; width: 100%; }
  .qfig-uxq02ticketcard svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq02ticketcard .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq02ticketcard .big { font-size: 26px; font-weight: 400; fill: var(--text); }
  .qfig-uxq02ticketcard .small { font-size: 12px; font-weight: 400; fill: var(--text); }
  .qfig-uxq02ticketcard .note { font-size: 11px; fill: var(--text-muted); }
</style>
