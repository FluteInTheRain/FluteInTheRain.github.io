---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure, set 07: fit window and test window of the walk-forward run on S&P 500 returns.
---
<div class="qfig-atq05s">
  <svg viewBox="0 0 580 250" role="img" aria-label="A timeline split in two. Fit window: 2 December 2016 to 2 December 2021, 1,259 days, parameters learned. Test window: 3 December 2021 to 25 November 2026, 1,250 days, parameters frozen. Test results: buy and hold 1.57 with worst fall 25.4 percent, the filtered rule 1.55 with worst fall 12.1 percent, cash on 30.6 percent of days.">
    <text x="0" y="20" class="h">
      <tspan data-lang-en>Walk-forward on the S&amp;P 500</tspan>
      <tspan data-lang-vi>Walk-forward trên S&amp;P 500</tspan>
    </text>
    <rect x="0" y="36" width="290" height="62" rx="8" class="fit" />
    <DiagramIcon name="model" x="26" y="67" size="22" />
    <text x="48" y="62" class="t">
      <tspan data-lang-en>Fit: 2 Dec 2016 to 2 Dec 2021</tspan>
      <tspan data-lang-vi>Khớp: 2/12/2016 tới 2/12/2021</tspan>
    </text>
    <text x="48" y="82" class="m">
      <tspan data-lang-en>1,259 days, parameters learned</tspan>
      <tspan data-lang-vi>1.259 ngày, học tham số</tspan>
    </text>
    <rect x="290" y="36" width="290" height="62" rx="8" class="test" />
    <DiagramIcon name="lock" x="316" y="67" size="22" />
    <text x="338" y="62" class="t">
      <tspan data-lang-en>Test: 3 Dec 2021 to 25 Nov 2026</tspan>
      <tspan data-lang-vi>Kiểm: 3/12/2021 tới 25/11/2026</tspan>
    </text>
    <text x="338" y="82" class="m">
      <tspan data-lang-en>1,250 days, parameters frozen</tspan>
      <tspan data-lang-vi>1.250 ngày, tham số đóng băng</tspan>
    </text>
    <text x="0" y="140" class="t">
      <tspan data-lang-en>Test window results</tspan>
      <tspan data-lang-vi>Kết quả cửa sổ kiểm</tspan>
    </text>
    <text x="0" y="168" class="m">
      <tspan data-lang-en>Buy and hold: 1 becomes 1.57, worst fall −25.4%</tspan>
      <tspan data-lang-vi>Cứ giữ: 1 thành 1,57, sụt tối đa −25,4%</tspan>
    </text>
    <text x="0" y="192" class="m">
      <tspan data-lang-en>Filtered rule: 1 becomes 1.55, worst fall −12.1%</tspan>
      <tspan data-lang-vi>Luật filtered: 1 thành 1,55, sụt tối đa −12,1%</tspan>
    </text>
    <text x="0" y="216" class="m">
      <tspan data-lang-en>Filtered rule in cash on 30.6% of days</tspan>
      <tspan data-lang-vi>Luật filtered đứng tiền mặt 30,6% số ngày</tspan>
    </text>
  </svg>
</div>
<style>
  .qfig-atq05s { margin: 0; width: 100%; }
  .qfig-atq05s svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-atq05s text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-atq05s .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-atq05s .t { font-weight: 700; fill: var(--text); }
  .qfig-atq05s .m { font-size: 13.5px; fill: var(--text-body); }
  .qfig-atq05s .fit { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .qfig-atq05s .test { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
</style>
