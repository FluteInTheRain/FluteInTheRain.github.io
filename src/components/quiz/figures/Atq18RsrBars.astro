---
// Set 01: Table 6 of Feng et al. (2019), industry relations: mean return ratio and the +- the paper prints,
// no graph (Rank_LSTM) against RSR_I. Numbers copied from the paper.
const rows = [
  { en: 'NASDAQ, no graph', vi: 'NASDAQ, không graph', m: 0.68, s: 0.60, k: 'base' },
  { en: 'NASDAQ, RSR_I', vi: 'NASDAQ, RSR_I', m: 0.23, s: 0.27, k: 'worse' },
  { en: 'NYSE, no graph', vi: 'NYSE, không graph', m: 0.56, s: 0.68, k: 'base' },
  { en: 'NYSE, RSR_I', vi: 'NYSE, RSR_I', m: 1.06, s: 0.27, k: 'better' },
];
const X0 = 170;
const SC = 300 / 1.8;
const gx = (v: number) => X0 + (v + 0.2) * SC;
---
<div class="qg18">
  <svg viewBox="0 0 580 250" role="img" aria-hidden="true">
    <text x="20" y="24" class="h">
      <tspan data-lang-en>Return ratio on the 237 test days, mean ± spread</tspan>
      <tspan data-lang-vi>Return ratio trên 237 ngày test, trung bình ± độ lệch</tspan>
    </text>
    {[0, 0.5, 1, 1.5].map((v) => (
      <g>
        <line x1={gx(v)} x2={gx(v)} y1="40" y2="200" class="grid" />
        <text x={gx(v)} y="220" text-anchor="middle" class="muted">{v.toFixed(1)}</text>
      </g>
    ))}
    {rows.map((r, i) => (
      <g>
        <text x="20" y={68 + i * 40} class="lab">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <line x1={gx(r.m - r.s)} x2={gx(r.m + r.s)} y1={64 + i * 40} y2={64 + i * 40} class={`bar ${r.k}`} />
        <circle cx={gx(r.m)} cy={64 + i * 40} r="5.5" class={`dot ${r.k}`} />
      </g>
    ))}
  </svg>
</div>

<style>
  .qg18 { margin: 0; width: 100%; }
  .qg18 svg { display: block; width: 100%; height: auto; }
  .qg18 text { font-size: 12.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qg18 .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qg18 .lab { font-size: 12.5px; fill: var(--text); }
  .qg18 .muted { fill: var(--text-muted); font-size: 11.5px; }
  .qg18 .grid { stroke: var(--border); }
  .qg18 .bar { stroke-width: 2.4; }
  .qg18 .bar.base { stroke: var(--text-muted); }
  .qg18 .bar.worse { stroke: var(--red); }
  .qg18 .bar.better { stroke: var(--gold); }
  .qg18 .dot.base { fill: var(--text-muted); }
  .qg18 .dot.worse { fill: var(--red); }
  .qg18 .dot.better { fill: var(--gold); }
</style>
