---
// Quiz figure for Post 9 (leveling up your design eye): a reference card and a blind first attempt, drawn at 1 unit = 1 px.
---
<div class="qfig-uxq09copywork">
  <svg viewBox="0 0 580 300" role="img" aria-label="Two pricing cards side by side: the reference on the left and a blind first attempt on the right, with different inner padding, heading leading and shadow.">
    <defs>
      <filter id="uxq09-sh-ref" x="-20%" y="-20%" width="140%" height="160%" color-interpolation-filters="sRGB">
        <feDropShadow dx="0" dy="1" stdDeviation="1" flood-color="#000" flood-opacity="0.06" />
        <feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#000" flood-opacity="0.07" />
      </filter>
      <filter id="uxq09-sh-try" x="-20%" y="-20%" width="140%" height="160%" color-interpolation-filters="sRGB">
        <feDropShadow dx="0" dy="10" stdDeviation="12.5" flood-color="#000" flood-opacity="0.18" />
      </filter>
    </defs>
    <text x="20" y="26" class="cap"><tspan data-lang-en>Reference</tspan><tspan data-lang-vi>Bản mẫu</tspan></text>
    <text x="310" y="26" class="cap"><tspan data-lang-en>Blind first attempt</tspan><tspan data-lang-vi>Bản dựng mù lần đầu</tspan></text>

    <g filter="url(#uxq09-sh-ref)">
      <rect x="20" y="40" width="250" height="200" rx="10" class="card" />
    </g>
    <text x="44" y="80" class="h">Pro Workspace</text>
    <text x="44" y="100.7" class="h">for engineering teams</text>
    <text x="44" y="128" class="b"><tspan data-lang-en>Unlimited previews and audit logs.</tspan><tspan data-lang-vi>Không giới hạn bản xem thử và log.</tspan></text>
    <text x="44" y="156" class="p">$49 <tspan class="b">/ seat / mo</tspan></text>
    <rect x="44" y="176" width="130" height="30" rx="6" class="btn" />
    <text x="109" y="196" text-anchor="middle" class="bt"><tspan data-lang-en>Upgrade</tspan><tspan data-lang-vi>Nâng cấp</tspan></text>

    <g filter="url(#uxq09-sh-try)">
      <rect x="310" y="40" width="250" height="200" rx="10" class="card" />
    </g>
    <text x="322" y="68" class="h">Pro Workspace</text>
    <text x="322" y="95.9" class="h">for engineering teams</text>
    <text x="322" y="124" class="b"><tspan data-lang-en>Unlimited previews and audit logs.</tspan><tspan data-lang-vi>Không giới hạn bản xem thử và log.</tspan></text>
    <text x="322" y="152" class="p">$49 <tspan class="b">/ seat / mo</tspan></text>
    <rect x="322" y="172" width="130" height="30" rx="6" class="btn" />
    <text x="387" y="192" text-anchor="middle" class="bt"><tspan data-lang-en>Upgrade</tspan><tspan data-lang-vi>Nâng cấp</tspan></text>
  </svg>
</div>

<style>
  .qfig-uxq09copywork { margin: 0; width: 100%; }
  .qfig-uxq09copywork svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq09copywork text { fill: var(--text-body); font-size: 13px; }
  .qfig-uxq09copywork .cap { fill: var(--text); font-size: 14px; font-weight: 700; }
  .qfig-uxq09copywork .h { fill: var(--text); font-size: 18px; font-weight: 700; }
  .qfig-uxq09copywork .b { fill: var(--text-muted); font-size: 13px; font-weight: 400; }
  .qfig-uxq09copywork .p { fill: var(--text); font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .qfig-uxq09copywork .bt { fill: var(--bg); font-size: 13px; font-weight: 700; }
  .qfig-uxq09copywork .card { fill: var(--bg); stroke: var(--border); stroke-width: 1; }
  .qfig-uxq09copywork .btn { fill: var(--accent); }
</style>
