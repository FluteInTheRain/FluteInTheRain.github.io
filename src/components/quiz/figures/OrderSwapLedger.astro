---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for unbundling set 01: two edits to the same price (A = 9, B = 12) and the order in which
// PostgreSQL and Elasticsearch each received them. Inline SVG, site tokens only, no <marker>/<defs>/ids.
const rows = [
  { y: 146, icon: 'postgres', en: 'PostgreSQL', vi: 'PostgreSQL', first: 'A', second: 'B', end: '12', bad: false },
  { y: 236, icon: 'elasticsearch', en: 'Elasticsearch', vi: 'Elasticsearch', first: 'B', second: 'A', end: '9', bad: true },
];
const chip = { w: 108, h: 38 };
const x1 = 186;
const x2 = 332;
const xr = 468;
function head(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`;
}
---
<div class="qfig-osl">
  <svg viewBox="0 0 580 290" role="img" aria-label="Two edits to the same product price, A sets 9 and B sets 12, sent at the same moment. PostgreSQL receives A then B and ends with 12. Elasticsearch receives B then A and ends with 9.">
    <text x="0" y="22" class="qfig-osl-h">
      <tspan data-lang-en>Two edits to one product, as each store receives them</tspan>
      <tspan data-lang-vi>Hai lần sửa một sản phẩm, như từng kho nhận được</tspan>
    </text>

    {[
      { x: x1, en: 'Arrives first', vi: 'Đến trước' },
      { x: x2, en: 'Arrives second', vi: 'Đến sau' },
      { x: xr, en: 'Stored price', vi: 'Giá đang lưu' },
    ].map((c) => (
      <text x={c.x + (c.x === xr ? 0 : chip.w / 2)} y="84" text-anchor={c.x === xr ? 'start' : 'middle'} class="qfig-osl-m">
        <tspan data-lang-en>{c.en}</tspan>
        <tspan data-lang-vi>{c.vi}</tspan>
      </text>
    ))}

    {rows.map((r) => (
      <g>
        <line x1="0" x2="580" y1={r.y - 40} y2={r.y - 40} class="qfig-osl-rule" />
        <DiagramIcon name={r.icon as any} x="22" y={r.y} size={30} />
        <text x="48" y={r.y + 5} class="qfig-osl-lane">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        {[{ x: x1, id: r.first }, { x: x2, id: r.second }].map((s) => (
          <g>
            <rect x={s.x} y={r.y - chip.h / 2} width={chip.w} height={chip.h} rx="8" class={s.id === 'A' ? 'qfig-osl-a' : 'qfig-osl-b'} />
            <text x={s.x + chip.w / 2} y={r.y + 5} text-anchor="middle" class="qfig-osl-t">
              <tspan data-lang-en>{s.id === 'A' ? 'Edit A: 9' : 'Edit B: 12'}</tspan>
              <tspan data-lang-vi>{s.id === 'A' ? 'Lần sửa A: 9' : 'Lần sửa B: 12'}</tspan>
            </text>
          </g>
        ))}
        <line x1={x1 + chip.w + 4} x2={x2 - 11} y1={r.y} y2={r.y} class="qfig-osl-flow" />
        <polygon points={head(x2 - 3, r.y)} class="qfig-osl-flowhead" />
        <line x1={x2 + chip.w + 4} x2={xr - 11} y1={r.y} y2={r.y} class="qfig-osl-flow" />
        <polygon points={head(xr - 3, r.y)} class="qfig-osl-flowhead" />
        <rect x={xr + 4} y={r.y - chip.h / 2} width="100" height={chip.h} rx="8" class={r.bad ? 'qfig-osl-end qfig-osl-bad' : 'qfig-osl-end'} />
        <text x={xr + 54} y={r.y + 5} text-anchor="middle" class={r.bad ? 'qfig-osl-t qfig-osl-badt' : 'qfig-osl-t'}>
          <tspan data-lang-en>Price {r.end}</tspan>
          <tspan data-lang-vi>Giá {r.end}</tspan>
        </text>
      </g>
    ))}
    <line x1="0" x2="580" y1="276" y2="276" class="qfig-osl-rule" />
  </svg>
</div>

<style>
  .qfig-osl { margin: 0; width: 100%; }
  .qfig-osl svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-osl text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-osl .qfig-osl-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-osl .qfig-osl-lane { font-size: 15px; font-weight: 700; fill: var(--text); }
  .qfig-osl .qfig-osl-t { font-weight: 600; fill: var(--text); }
  .qfig-osl .qfig-osl-badt { fill: var(--red); }
  .qfig-osl .qfig-osl-m { fill: var(--text-muted); }
  .qfig-osl-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-osl-a { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 2; }
  .qfig-osl-b { fill: var(--bg-alt); stroke: var(--act-2); stroke-width: 2; }
  .qfig-osl-end { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .qfig-osl-bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .qfig-osl-flow { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-osl-flowhead { fill: var(--text-muted); }
</style>
