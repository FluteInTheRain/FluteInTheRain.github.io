---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for distributed failures set 07: Client 1 gets token 33, emits v1, and is killed by STONITH
// while a congested switch holds the packet for 45 s. Client 2 gets token 34 and commits v2 first.
// Shows the trace inputs only (ends with "?" at storage) without revealing the outcome.
// Inline SVG, site tokens only, no marker/defs/ids.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const toC1 = arrow(24, 146, 46, 146);
const toC2 = arrow(24, 239, 46, 239);
const c1ToSwitch = arrow(252, 146, 274, 146);
const c2Down = arrow(456, 239, 456, 300);
const swDown = arrow(536, 146, 536, 300);
---
<div class="qfig-fl">
  <svg viewBox="0 0 580 412" role="img" aria-label="Lock service grants token 33 to Client 1 and token 34 to Client 2. Client 1 sends v1 before STONITH powers it off, while a congested switch buffers that packet for 45 seconds. Client 2 commits v2 with token 34 first; at 45 seconds the delayed v1 packet with token 33 reaches the storage ledger.">
    <text x="8" y="22" class="qfig-fl-h">
      <tspan data-lang-en>Fencing token trace and storage ledger</tspan>
      <tspan data-lang-vi>Vết fencing token và sổ cái lưu trữ</tspan>
    </text>

    <!-- Lock service -->
    <rect x="8" y="38" width="564" height="52" rx="8" class="qfig-fl-box" />
    <DiagramIcon name="etcd" x={34} y={64} size={24} />
    <text x="58" y="60" class="qfig-fl-b">
      <tspan data-lang-en>Lock service (etcd / ZooKeeper)</tspan>
      <tspan data-lang-vi>Dịch vụ khóa (etcd / ZooKeeper)</tspan>
    </text>
    <text x="58" y="79" class="qfig-fl-m">
      <tspan data-lang-en>Grants strictly increasing tokens: 33, then 34</tspan>
      <tspan data-lang-vi>Cấp token tăng nghiêm ngặt: 33, rồi 34</tspan>
    </text>

    <!-- Left bus from lock service to Client 1 and Client 2 -->
    <path d="M 24 90 L 24 239" class="qfig-fl-ln" />
    <path d={toC1.line} class="qfig-fl-ln" /><polygon points={toC1.head} class="qfig-fl-hd" />
    <path d={toC2.line} class="qfig-fl-ln" /><polygon points={toC2.head} class="qfig-fl-hd" />

    <!-- Client 1 + Switch lane -->
    <rect x="46" y="108" width="206" height="76" rx="8" class="qfig-fl-box" />
    <DiagramIcon name="laptop" x={68} y={130} size={22} />
    <text x="86" y="130" class="qfig-fl-b">Client 1 · token = 33</text>
    <text x="58" y="152" class="qfig-fl-t">
      <tspan data-lang-en>t = 0 s: emits write v1</tspan>
      <tspan data-lang-vi>t = 0 s: gửi lệnh ghi v1</tspan>
    </text>
    <text x="58" y="171" class="qfig-fl-r">
      <tspan data-lang-en>killed by STONITH (kill -9)</tspan>
      <tspan data-lang-vi>bị STONITH cắt điện (kill -9)</tspan>
    </text>

    <path d={c1ToSwitch.line} class="qfig-fl-lnr" /><polygon points={c1ToSwitch.head} class="qfig-fl-hdr" />

    <rect x="274" y="108" width="194" height="76" rx="8" class="qfig-fl-hot" />
    <DiagramIcon name="network" x={296} y={130} size={22} />
    <text x="314" y="130" class="qfig-fl-r">
      <tspan data-lang-en>Congested switch</tspan>
      <tspan data-lang-vi>Switch bị nghẽn</tspan>
    </text>
    <text x="286" y="152" class="qfig-fl-t">
      <tspan data-lang-en>buffers packet 45 s</tspan>
      <tspan data-lang-vi>giữ gói tin suốt 45 s</tspan>
    </text>
    <text x="286" y="171" class="qfig-fl-m">
      <tspan data-lang-en>in flight: (v1, token = 33)</tspan>
      <tspan data-lang-vi>đang bay: (v1, token = 33)</tspan>
    </text>

    <path d="M 468 146 L 536 146 L 536 294" class="qfig-fl-lnrd" />
    <polygon points={swDown.head} class="qfig-fl-hdr" />
    <text x="502" y="138" text-anchor="middle" class="qfig-fl-r">t = 45 s</text>

    <!-- Client 2 lane -->
    <rect x="46" y="204" width="368" height="70" rx="8" class="qfig-fl-gold" />
    <DiagramIcon name="laptop" x={70} y={228} size={22} />
    <text x="90" y="228" class="qfig-fl-b">Client 2 · token = 34</text>
    <text x="58" y="254" class="qfig-fl-t">
      <tspan data-lang-en>Gets new lease, commits (v2, token = 34) early</tspan>
      <tspan data-lang-vi>Nhận lease mới, commit (v2, token = 34) trước</tspan>
    </text>

    <path d="M 414 239 L 456 239 L 456 294" class="qfig-fl-lng" />
    <polygon points={c2Down.head} class="qfig-fl-hdg" />
    <text x="456" y="227" text-anchor="middle" class="qfig-fl-g">&lt; 45 s</text>

    <!-- Storage ledger -->
    <rect x="46" y="300" width="526" height="104" rx="8" class="qfig-fl-box" />
    <DiagramIcon name="db" x={72} y={323} size={22} />
    <text x="92" y="328" class="qfig-fl-b">
      <tspan data-lang-en>Storage ledger</tspan>
      <tspan data-lang-vi>Sổ cái tầng lưu trữ</tspan>
    </text>

    <rect x="58" y="340" width="502" height="24" rx="4" class="qfig-fl-rowgold" />
    <text x="68" y="357" class="qfig-fl-t">
      <tspan data-lang-en>1. Before 45 s: stores v2   |   maxToken = 34</tspan>
      <tspan data-lang-vi>1. Trước 45 s: lưu v2   |   maxToken = 34</tspan>
    </text>

    <rect x="58" y="370" width="502" height="24" rx="4" class="qfig-fl-rowwait" />
    <text x="68" y="387" class="qfig-fl-m">
      <tspan data-lang-en>2. At 45 s: packet (v1, token = 33) arrives   →   ?</tspan>
      <tspan data-lang-vi>2. Lúc 45 s: gói (v1, token = 33) tới nơi   →   ?</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-fl { margin: 0; width: 100%; }
  .qfig-fl svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-fl text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-fl .qfig-fl-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-fl .qfig-fl-b { font-weight: 700; fill: var(--text); }
  .qfig-fl .qfig-fl-t { fill: var(--text); }
  .qfig-fl .qfig-fl-m { fill: var(--text-muted); }
  .qfig-fl .qfig-fl-r { font-weight: 700; fill: var(--red); }
  .qfig-fl .qfig-fl-g { font-weight: 700; fill: var(--text); }
  .qfig-fl-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .qfig-fl-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-fl-gold { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .qfig-fl-rowgold { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.2; }
  .qfig-fl-rowwait { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .qfig-fl-ln { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-fl-hd { fill: var(--text-muted); }
  .qfig-fl-lnr { fill: none; stroke: var(--red); stroke-width: 1.8; }
  .qfig-fl-lnrd { fill: none; stroke: var(--red); stroke-width: 1.8; stroke-dasharray: 5 4; }
  .qfig-fl-hdr { fill: var(--red); }
  .qfig-fl-lng { fill: none; stroke: var(--gold); stroke-width: 2; }
  .qfig-fl-hdg { fill: var(--gold); }
</style>
