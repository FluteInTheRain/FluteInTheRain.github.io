---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 07: one key on five replicas in a ring, a moment after version v7 was sent.
// Shows the mechanism only (who holds which version), never w, r or a result.
// Plain inline SVG, site tokens, no <marker>/<defs>, so the EN and VI copies cannot clash.

const W = 580;
const H = 386;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const cx = 375;
const cy = 186;
const rx = 150;
const ry = 98;
const nw = 86;
const nh = 48;
const newest = [true, true, false, false, false];
const nodes = newest.map((fresh, i) => {
  const ang = ((-90 + i * 72) * Math.PI) / 180;
  return { name: `R${i + 1}`, fresh, x: cx + rx * Math.cos(ang), y: cy + ry * Math.sin(ang) };
});
const client = { x: 12, y: 96 };
const toNode = arrow(66, 118, nodes[4].x - nw / 2 - 2, nodes[4].y);
---
<div class="qr">
  <div>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="One key sits on five replicas in a ring. A client sends version v7. Two replicas already hold v7, three still hold v6.">
      <text x="10" y="26" class="qr-h">
        <tspan data-lang-en>One key, five replicas, no leader</tspan>
        <tspan data-lang-vi>Một khoá, năm replica, không có leader</tspan>
      </text>

      <ellipse cx={cx} cy={cy} rx={rx} ry={ry} class="qr-ring" />

      <DiagramIcon name="laptop" x={client.x + 12} y={client.y} size={34} />
      <text x={client.x + 29} y={client.y + 52} text-anchor="middle" class="qr-name">Client</text>
      <g class="qr-arrow"><path d={toNode.line} /><polygon points={toNode.head} /></g>
      <text x="14" y="186" class="qr-sub">
        <tspan data-lang-en>sends v7 to</tspan>
        <tspan data-lang-vi>gửi v7 tới</tspan>
      </text>
      <text x="14" y="204" class="qr-sub">
        <tspan data-lang-en>the replicas</tspan>
        <tspan data-lang-vi>các replica</tspan>
      </text>

      {nodes.map((n) => (
        <g class={n.fresh ? 'qr-node is-new' : 'qr-node is-old'}>
          <rect x={n.x - nw / 2} y={n.y - nh / 2} width={nw} height={nh} rx="8" />
          <DiagramIcon name="server" x={n.x - nw / 2 + 12} y={n.y - 8} size={20} />
          <text x={n.x - 4} y={n.y - 4} class="qr-name">{n.name}</text>
          <text x={n.x - 4} y={n.y + 15} class="qr-ver">{n.fresh ? 'v7' : 'v6'}</text>
        </g>
      ))}

      <rect x="10" y="280" width="16" height="16" rx="3" class="qr-key-new" />
      <text x="34" y="293" class="qr-sub">
        <tspan data-lang-en>holds the newest version, v7</tspan>
        <tspan data-lang-vi>giữ phiên bản mới nhất, v7</tspan>
      </text>
      <rect x="10" y="304" width="16" height="16" rx="3" class="qr-key-old" />
      <text x="34" y="317" class="qr-sub">
        <tspan data-lang-en>still holds the older version, v6</tspan>
        <tspan data-lang-vi>vẫn giữ phiên bản cũ, v6</tspan>
      </text>

      <text x="10" y="352" class="qr-note">
        <tspan data-lang-en>A read keeps the newest version it sees,</tspan>
        <tspan data-lang-vi>Lượt đọc giữ phiên bản mới nhất nó thấy,</tspan>
      </text>
      <text x="10" y="372" class="qr-note">
        <tspan data-lang-en>and may write it back to a stale replica.</tspan>
        <tspan data-lang-vi>và có thể ghi lại vào replica còn cũ.</tspan>
      </text>
    </svg>
  </div>
</div>

<style>
  .qr { width: 100%; }
  .qr svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qr text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qr .qr-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qr .qr-name { font-weight: 700; fill: var(--text); }
  .qr .qr-sub { fill: var(--text-muted); }
  .qr .qr-note { fill: var(--text); }
  .qr .qr-ver { font-weight: 700; font-size: 15px; }
  .qr-ring { fill: none; stroke: var(--border); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .qr-node rect { stroke-width: 1.4; }
  .qr-node.is-new rect { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .qr-node.is-old rect { fill: var(--red-tint-bg); stroke: var(--red); }
  .qr .qr-node.is-old .qr-ver { fill: var(--red); }
  .qr-key-new { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qr-key-old { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .qr-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .qr-arrow polygon { fill: var(--text-muted); }
</style>
