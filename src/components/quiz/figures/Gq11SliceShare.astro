---
// Quiz figure for go-memory-data-types-slices-maps-strings: a 5-element backing array with the slice header of s1 and of s2 := s1[1:3].
// Neutral drawing: pointer, len and cap only, not what a later write does. Inline SVG, site tokens only.
const vals = [10, 20, 30, 40, 50];
const cx = (i: number) => 30 + i * 104;
---
<div class="qfig-g11a">
  <svg viewBox="0 0 580 250" role="img" aria-label="A backing array of five ints, 10 20 30 40 50, with two slice headers over it: s1 starts at index 0 with len 5 and cap 5, s2 starts at index 1 with len 2 and cap 4.">
    <text x="30" y="22" class="qfig-g11a-h">
      <tspan data-lang-en>One backing array, two slice headers</tspan>
      <tspan data-lang-vi>Một mảng nền, hai slice header</tspan>
    </text>
    <text x="30" y="52" class="qfig-g11a-t">s1</text>
    <text x="56" y="52" class="qfig-g11a-m">ptr [0], len 5, cap 5</text>
    <path d="M 30 66 H 542" class="qfig-g11a-b1" />
    {vals.map((v, i) => (
      <g>
        <rect x={cx(i)} y="84" width="96" height="46" rx="6" class="qfig-g11a-cell" />
        <text x={cx(i) + 48} y="113" text-anchor="middle" class="qfig-g11a-t">{v}</text>
        <text x={cx(i) + 48} y="148" text-anchor="middle" class="qfig-g11a-m">[{i}]</text>
      </g>
    ))}
    <path d="M 134 160 H 334" class="qfig-g11a-b2" />
    <path d="M 134 172 H 542" class="qfig-g11a-b2 qfig-g11a-thin" />
    <text x="134" y="200" class="qfig-g11a-t">s2</text>
    <text x="160" y="200" class="qfig-g11a-m">ptr [1], len 2, cap 4</text>
    <text x="134" y="226" class="qfig-g11a-m">
      <tspan data-lang-en>thick bar: len, thin bar: cap</tspan>
      <tspan data-lang-vi>vạch dày: len, vạch mảnh: cap</tspan>
    </text>
  </svg>
</div>
<style>
  .qfig-g11a { margin: 0; width: 100%; }
  .qfig-g11a svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-g11a text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-g11a .qfig-g11a-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-g11a .qfig-g11a-t { font-weight: 700; fill: var(--text); }
  .qfig-g11a .qfig-g11a-m { fill: var(--text-muted); font-size: 13px; }
  .qfig-g11a-cell { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-g11a-b1 { stroke: var(--gold); stroke-width: 5; fill: none; stroke-linecap: round; }
  .qfig-g11a-b2 { stroke: var(--red); stroke-width: 5; fill: none; stroke-linecap: round; }
  .qfig-g11a-thin { stroke-width: 2; }
</style>
