---
// Quiz figure for backend REST set 01: the route table of an AI-generated case-tracker, one row per operation.
// It lists method, path and the status the code returns, and draws no verdict. Inline SVG, site tokens only,
// no <marker>/<defs>/ids.
const rows = [
  { path: '/getCases', ops: { en: 'list cases', vi: 'liệt kê case' } },
  { path: '/getCaseById', ops: { en: 'read one case', vi: 'đọc một case' } },
  { path: '/createCase', ops: { en: 'create a case', vi: 'tạo một case' } },
  { path: '/updateCase', ops: { en: 'change a case', vi: 'sửa một case' } },
  { path: '/deleteCase', ops: { en: 'remove a case', vi: 'xoá một case' } },
];
const Y0 = 66, H = 36;
---
<div class="qfig-bq02gs">
  <svg viewBox={`0 0 580 ${Y0 + rows.length * H + 14}`} role="img" aria-label="Five routes of a generated case tracker: list, read, create, change and remove all use the POST method with a verb in the path, and each returns status 200.">
    <text x="0" y="20" class="qfig-bq02gs-h">
      <tspan data-lang-en>Routes of the generated service</tspan>
      <tspan data-lang-vi>Các route của service được sinh ra</tspan>
    </text>

    <text x="24" y="52" class="qfig-bq02gs-m">
      <tspan data-lang-en>Method</tspan>
      <tspan data-lang-vi>Method</tspan>
    </text>
    <text x="110" y="52" class="qfig-bq02gs-m">
      <tspan data-lang-en>Path and what it does</tspan>
      <tspan data-lang-vi>Path và việc nó làm</tspan>
    </text>
    <text x="474" y="52" class="qfig-bq02gs-m">
      <tspan data-lang-en>Status returned</tspan>
      <tspan data-lang-vi>Status trả về</tspan>
    </text>

    {rows.map((r, i) => (
      <g>
        <rect x="0" y={Y0 + i * H - 4} width="580" height={H - 6} rx="6" class="qfig-bq02gs-row" />
        <rect x="14" y={Y0 + i * H + 1} width="62" height="20" rx="10" class="qfig-bq02gs-pill" />
        <text x="45" y={Y0 + i * H + 15} text-anchor="middle" class="qfig-bq02gs-t">POST</text>
        <text x="110" y={Y0 + i * H + 16} class="qfig-bq02gs-t">/v1{r.path}</text>
        <text x="270" y={Y0 + i * H + 16} class="qfig-bq02gs-b">
          <tspan data-lang-en>{r.ops.en}</tspan>
          <tspan data-lang-vi>{r.ops.vi}</tspan>
        </text>
        <rect x="470" y={Y0 + i * H + 1} width="46" height="20" rx="10" class="qfig-bq02gs-status" />
        <text x="493" y={Y0 + i * H + 15} text-anchor="middle" class="qfig-bq02gs-t">200</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-bq02gs { margin: 0; width: 100%; }
  .qfig-bq02gs svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-bq02gs text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-bq02gs .qfig-bq02gs-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-bq02gs .qfig-bq02gs-t { font-weight: 700; fill: var(--text); }
  .qfig-bq02gs .qfig-bq02gs-m { fill: var(--text-muted); }
  .qfig-bq02gs .qfig-bq02gs-b { fill: var(--text-body); }
  .qfig-bq02gs-row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-bq02gs-pill { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-bq02gs-status { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; }
</style>
