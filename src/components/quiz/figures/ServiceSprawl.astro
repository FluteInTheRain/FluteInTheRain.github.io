---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 06 (trade-offs post): Segment before the merge, 140 services each with its own repo and library copy.
// Shows the situation only (no answers). Plain inline SVG, site tokens, no <marker>/<defs>/ids.

const W = 580;
const H = 290;
const cols = 14;
const cell = 12;
const gap = 4;
const gx = 10;
const gy = 52;
// 140 services; a scattering of 36 marked as "a repo one library fix must reach"
const hit = new Set([3, 8, 12, 17, 22, 26, 31, 35, 40, 44, 49, 53, 58, 62, 67, 71, 76, 80, 85, 89, 94, 98, 103, 107, 112, 116, 121, 125, 130, 134, 139, 6, 47, 92, 118, 127]);
const squares = Array.from({ length: 140 }, (_, i) => ({
  x: gx + (i % cols) * (cell + gap),
  y: gy + Math.floor(i / cols) * (cell + gap),
  hit: hit.has(i),
}));
const legendY = gy + 10 * (cell + gap) + 14;
---
<div class="ss">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A grid of 140 small squares, one per service and repo, with 36 marked red. Beside it: 3 engineers keep the system alive, a full test run takes up to 1 hour, and each repo holds its own copy of a shared library.">
    <text x="10" y="26" class="ss-h">
      <tspan data-lang-en>140+ services, one per destination</tspan>
      <tspan data-lang-vi>Hơn 140 service, mỗi đích một service</tspan>
    </text>

    {squares.map((s) => <rect x={s.x} y={s.y} width={cell} height={cell} rx="2" class={s.hit ? 'ss-sq is-hit' : 'ss-sq'} />)}

    <rect x={gx} y={legendY - 9} width="10" height="10" rx="2" class="ss-sq" />
    <text x={gx + 16} y={legendY} class="ss-sub">
      <tspan data-lang-en>One service and its own repo</tspan>
      <tspan data-lang-vi>Một service và repo riêng</tspan>
    </text>
    <rect x={gx} y={legendY + 15} width="10" height="10" rx="2" class="ss-sq is-hit" />
    <text x={gx + 16} y={legendY + 24} class="ss-sub">
      <tspan data-lang-en>A repo one library fix must reach</tspan>
      <tspan data-lang-vi>Repo mà một bản sửa phải tới</tspan>
    </text>

    <DiagramIcon name="users" x={266} y={76} size={26} />
    <text x={292} y={72} class="ss-name">
      <tspan data-lang-en>3 engineers keep it alive</tspan>
      <tspan data-lang-vi>3 kỹ sư giữ cho nó sống</tspan>
    </text>
    <text x={292} y={92} class="ss-sub">
      <tspan data-lang-en>most of their working time</tspan>
      <tspan data-lang-vi>gần hết thời gian làm việc</tspan>
    </text>

    <DiagramIcon name="clock" x={266} y={150} size={26} />
    <text x={292} y={146} class="ss-name">
      <tspan data-lang-en>Full test run: up to 1 hour</tspan>
      <tspan data-lang-vi>Chạy hết bộ test: tới 1 giờ</tspan>
    </text>
    <text x={292} y={166} class="ss-sub">
      <tspan data-lang-en>across all the destinations</tspan>
      <tspan data-lang-vi>trên mọi đích dữ liệu</tspan>
    </text>

    <DiagramIcon name="code" x={266} y={224} size={26} />
    <text x={292} y={220} class="ss-name">
      <tspan data-lang-en>Shared library, one copy per repo</tspan>
      <tspan data-lang-vi>Thư viện chung, mỗi repo một bản</tspan>
    </text>
    <text x={292} y={240} class="ss-sub">
      <tspan data-lang-en>one fix touches dozens of repos</tspan>
      <tspan data-lang-vi>một lần sửa đụng hàng chục repo</tspan>
    </text>
  </svg>
</div>

<style>
  .ss { width: 100%; }
  .ss svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .ss text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .ss .ss-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ss .ss-name { font-weight: 700; fill: var(--text); }
  .ss .ss-sub { fill: var(--text-muted); }
  .ss-sq { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1; }
  .ss-sq.is-hit { fill: var(--red-tint-bg); stroke: var(--red); }
</style>
