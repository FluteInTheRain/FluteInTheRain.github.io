---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 03: walking the book — the post's demo: buy 900 shares with limit 24,600
// eats 600 at 24,550, then 300 at 24,600; the best ask moves up a step.
const W = 580;
const H = 452;
const maxQ = 1100;
const barMax = 200;
const asks = [
  { price: '24,650', q: 900, fill: false, note: 'now the best ask', noteVi: 'giờ là ask tốt nhất' },
  { price: '24,600', q: 300, fill: true, note: 'your last 300 filled here', noteVi: '300 cp cuối khớp ở đây' },
  { price: '24,550', q: 600, fill: true, note: 'your first 600 filled here', noteVi: '600 cp đầu khớp ở đây' },
];
const y0 = 96;
const rowH = 78;
const x = 210;
---
<div class="qml">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <DiagramIcon name="chart" x={18} y={16} size={22} />
    <text x="40" y="21" class="qml-h">
      <tspan data-lang-en>One large buy, walking down the ask side</tspan>
      <tspan data-lang-vi>Một lệnh mua lớn, đi xuống mặt ask</tspan>
    </text>

    <g class="qml-order">
      <rect x="360" y="40" width="206" height="56" rx="8" />
      <text x="374" y="62" class="qml-strong">
        <tspan data-lang-en>Your order</tspan>
        <tspan data-lang-vi>Lệnh của bạn</tspan>
      </text>
      <text x="374" y="84" class="qml-note">
        <tspan data-lang-en>buy 900 · limit 24,600</tspan>
        <tspan data-lang-vi>mua 900 · giá tối đa 24.600</tspan>
      </text>
    </g>

    {asks.map((a, i) => {
      const y = y0 + i * rowH;
      const w = (a.q / maxQ) * barMax;
      return (
        <g>
          <rect x={x} y={y} width={w} height="36" rx="4" class={a.fill ? 'qml-bar is-filled' : 'qml-bar'} />
          <text x={x + 8} y={y + 24} class="qml-price">{a.price}</text>
          <text x={x + w - 8} y={y + 24} text-anchor="end" class="qml-q">{a.q} sh</text>
          <text x={x + w + 12} y={y + 24} class={a.fill ? 'qml-note is-filled-t' : 'qml-note'}>
            <tspan data-lang-en>{a.note}</tspan>
            <tspan data-lang-vi>{a.noteVi}</tspan>
          </text>
        </g>
      );
    })}

    <text x="14" y={y0 - 12} class="qml-tick">
      <tspan data-lang-en>cheapest sellers on top →</tspan>
      <tspan data-lang-vi>người bán rẻ nhất ở trên →</tspan>
    </text>

    <g class="qml-arrow">
      <path d={`M 230 ${y0 + 2 * rowH + 44} L 230 ${y0 + 2 * rowH + 66}`} />
      <polygon points={`230,${y0 + 2 * rowH + 74} 225,${y0 + 2 * rowH + 64} 235,${y0 + 2 * rowH + 64}`} />
    </g>
    <text x="246" y={y0 + 2 * rowH + 64} class="qml-strong">
      <tspan data-lang-en>900 shares filled; the best ask steps up to 24,650</tspan>
      <tspan data-lang-vi>900 cp đã khớp; ask tốt nhất nhích lên 24.650</tspan>
    </text>

    <line x1="14" x2={W - 14} y1={y0 + 2 * rowH + 92} y2={y0 + 2 * rowH + 92} class="qml-rule" />
    <text x="14" y={y0 + 2 * rowH + 118} class="qml-note">
      <tspan data-lang-en>Your limit only caps what you pay — the fill always takes the better price first.</tspan>
      <tspan data-lang-vi>Giá tối đa chỉ chặn cái giá bạn trả — lệnh luôn ăn mức tốt hơn trước.</tspan>
    </text>
  </svg>
</div>

<style>
  .qml {
    margin: 0;
    width: 100%;
  }
  .qml svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qml text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qml .qml-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qml .qml-order rect {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .qml .qml-strong {
    font-size: 14px;
    font-weight: 700;
    fill: var(--text);
  }
  .qml .qml-bar {
    fill: var(--act-0);
    opacity: 0.18;
    stroke: var(--act-0);
    stroke-width: 1.2;
  }
  .qml .qml-bar.is-filled {
    fill: var(--act-2);
    opacity: 0.22;
    stroke: var(--act-2);
  }
  .qml .qml-price {
    font-weight: 700;
    fill: var(--text);
    font-size: 14px;
  }
  .qml .qml-q {
    fill: var(--text-muted);
    font-size: 13px;
  }
  .qml .qml-note {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qml .is-filled-t {
    fill: var(--act-2);
    font-weight: 600;
  }
  .qml .qml-tick {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .qml .qml-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .qml .qml-arrow polygon {
    fill: var(--text-muted);
  }
  .qml .qml-rule {
    stroke: var(--border);
    stroke-width: 1.2;
  }
</style>
