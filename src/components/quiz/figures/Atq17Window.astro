---
// Quiz figure for financial NLP set 08: a model's training cutoff against two backtest windows.
import DiagramIcon from '../../mdx/DiagramIcon.astro';
---
<div class="qfig-atq17w">
  <svg viewBox="0 0 640 170" role="img" aria-label="A timeline with a dashed line where the model's training data ends. Backtest window A lies before the line and is marked as risky because the model may have read how those stocks moved. Backtest window B lies after the line and is marked clean.">
    <line x1="20" y1="100" x2="620" y2="100" class="qfig-atq17w-axis" />
    <rect x="40" y="62" width="230" height="24" rx="4" class="qfig-atq17w-bt is-bad" />
    <text x="155" y="79" text-anchor="middle" class="qfig-atq17w-t">
      <tspan data-lang-en>window A</tspan>
      <tspan data-lang-vi>cửa sổ A</tspan>
    </text>
    <rect x="390" y="62" width="200" height="24" rx="4" class="qfig-atq17w-bt is-ok" />
    <text x="490" y="79" text-anchor="middle" class="qfig-atq17w-t">
      <tspan data-lang-en>window B</tspan>
      <tspan data-lang-vi>cửa sổ B</tspan>
    </text>
    <line x1="330" y1="40" x2="330" y2="118" class="qfig-atq17w-cut" />
    <DiagramIcon name="model" x="330" y="26" size="20" />
    <text x="346" y="31" class="qfig-atq17w-s">
      <tspan data-lang-en>training data ends</tspan>
      <tspan data-lang-vi>dữ liệu huấn luyện dừng</tspan>
    </text>
    <text x="155" y="130" text-anchor="middle" class="qfig-atq17w-bad">
      <tspan data-lang-en>may have been read</tspan>
      <tspan data-lang-vi>có thể đã bị đọc</tspan>
    </text>
    <text x="490" y="130" text-anchor="middle" class="qfig-atq17w-ok">
      <tspan data-lang-en>never seen</tspan>
      <tspan data-lang-vi>chưa từng thấy</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-atq17w svg { display: block; width: 100%; height: auto; }
  .qfig-atq17w text { font-size: 13px; fill: var(--text-body); }
  .qfig-atq17w .qfig-atq17w-t { font-weight: 600; fill: var(--text); }
  .qfig-atq17w .qfig-atq17w-s { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-atq17w .qfig-atq17w-bad { fill: var(--red); font-weight: 600; font-size: 12.5px; }
  .qfig-atq17w .qfig-atq17w-ok { fill: var(--gold-icon); font-weight: 600; font-size: 12.5px; }
  .qfig-atq17w-axis { stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-atq17w-cut { stroke: var(--text); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .qfig-atq17w-bt { stroke-width: 1.4; }
  .qfig-atq17w-bt.is-bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .qfig-atq17w-bt.is-ok { fill: var(--gold-tint-bg); stroke: var(--gold-icon); }
</style>
