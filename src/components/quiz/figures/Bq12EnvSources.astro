---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 01 (post 12): what reaches the container's environment. Shows the situation only, not the outcome of Settings().
// Plain inline SVG, site tokens only, no markers/defs.
---
<div class="bq12es">
  <svg viewBox="0 0 580 250" role="img" aria-hidden="true">
    <rect x="4" y="38" width="198" height="62" rx="6" class="es-box" />
    <DiagramIcon name="server" x={22} y={69} size={22} />
    <text x="42" y="62" class="es-strong">ConfigMap</text>
    <text x="42" y="82" class="es-note">ORDERS_POOL_SIZE = 8</text>

    <rect x="4" y="140" width="198" height="62" rx="6" class="es-box is-ghost" />
    <DiagramIcon name="key" x={22} y={171} size={22} />
    <text x="42" y="164" class="es-strong">Secret</text>
    <text x="42" y="184" class="es-note">
      <tspan data-lang-en>not attached</tspan>
      <tspan data-lang-vi>không được gắn</tspan>
    </text>

    <line x1="202" x2="212" y1="69" y2="69" class="es-line" />
    <polygon points="222,69 212,64 212,74" class="es-head" />

    <rect x="224" y="26" width="200" height="188" rx="6" class="es-env" />
    <text x="238" y="52" class="es-strong">
      <tspan data-lang-en>Container environment</tspan>
      <tspan data-lang-vi>Môi trường của container</tspan>
    </text>
    <text x="238" y="86" class="es-in">ORDERS_POOL_SIZE = 8</text>
    <text x="238" y="124" class="es-miss">ORDERS_DATABASE_URL</text>
    <text x="238" y="142" class="es-note">
      <tspan data-lang-en>not set</tspan>
      <tspan data-lang-vi>chưa đặt</tspan>
    </text>
    <text x="238" y="176" class="es-miss">ORDERS_RELEASE</text>
    <text x="238" y="194" class="es-note">
      <tspan data-lang-en>not set</tspan>
      <tspan data-lang-vi>chưa đặt</tspan>
    </text>

    <line x1="424" x2="446" y1="120" y2="120" class="es-line" />
    <polygon points="456,120 446,115 446,125" class="es-head" />

    <rect x="458" y="88" width="108" height="64" rx="6" class="es-box" />
    <text x="512" y="116" text-anchor="middle" class="es-strong">Settings()</text>
    <text x="512" y="136" text-anchor="middle" class="es-note">
      <tspan data-lang-en>at import</tspan>
      <tspan data-lang-vi>lúc import</tspan>
    </text>
  </svg>
</div>

<style>
  .bq12es { margin: 0; width: 100%; }
  .bq12es svg { display: block; width: 100%; min-width: 360px; height: auto; }
  .bq12es text { font-size: 13px; fill: var(--text-body); }
  .bq12es .es-strong { font-weight: 700; fill: var(--text); font-size: 14px; }
  .bq12es .es-note { fill: var(--text-muted); }
  .bq12es .es-in { fill: var(--text); font-weight: 600; }
  .bq12es .es-miss { fill: var(--red); font-weight: 600; }
  .bq12es .es-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .bq12es .es-box.is-ghost { fill: none; stroke: var(--text-muted); stroke-dasharray: 5 4; }
  .bq12es .es-env { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; }
  .bq12es .es-line { stroke: var(--text-muted); stroke-width: 2; }
  .bq12es .es-head { fill: var(--text-muted); }
</style>
