---
// Quiz set 03 (ethics): a screener drops two sensitive columns but keeps two others; 20,000 applicants split by district and group.
// Shows the setup only (counts and the two district rates), never the group totals or the ratio.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids.
const W = 580;
const H = 330;

const chips = [
  { en: 'gender', vi: 'gender', w: 76, dropped: true },
  { en: 'nationality', vi: 'nationality', w: 104, dropped: true },
  { en: 'postal district', vi: 'postal district', w: 124, dropped: false },
  { en: 'phone prefix', vi: 'phone prefix', w: 108, dropped: false },
  { en: 'experience', vi: 'kinh nghiệm', w: 96, dropped: false, neutral: true },
];
let cx = 10;
const placed = chips.map((c) => { const p = { ...c, x: cx }; cx += c.w + 8; return p; });

const barX = 10, barW = 560, barY = 168, barH = 34;
const gap = 4;
const xW = (barW - gap) * 0.2;
const oW = (barW - gap) * 0.8;
const xG = xW * 0.7;
const oG = oW * 0.125;
const oX = barX + xW + gap;
---
<div class="pl">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A screener keeps postal district and phone prefix while gender and nationality are dropped; 20,000 applicants split by district and group, approved at 15% in district X and 35% elsewhere.">
    <text x="10" y="24" class="pl-h">
      <tspan data-lang-en>Training table, after the assistant's edit</tspan>
      <tspan data-lang-vi>Bảng huấn luyện, sau khi assistant sửa</tspan>
    </text>

    {placed.map((c) => (
      <g>
        <rect x={c.x} y="40" width={c.w} height="32" rx="6" class={c.dropped ? 'pl-chip is-dropped' : c.neutral ? 'pl-chip' : 'pl-chip is-kept'} />
        <text x={c.x + c.w / 2} y="61" text-anchor="middle" class={c.dropped ? 'pl-chip-t is-dropped' : 'pl-chip-t'}>
          <tspan data-lang-en>{c.en}</tspan>
          <tspan data-lang-vi>{c.vi}</tspan>
        </text>
      </g>
    ))}
    <text x="10" y="94" class="pl-sub">
      <tspan data-lang-en>Struck out: dropped. Red outline: kept, and still tied to where people live.</tspan>
      <tspan data-lang-vi>Gạch ngang: đã xóa. Viền đỏ: còn giữ, và vẫn gắn với nơi người ta sống.</tspan>
    </text>

    <line x1="10" x2="570" y1="116" y2="116" class="pl-rule" />

    <text x="10" y="142" class="pl-h">
      <tspan data-lang-en>20,000 applicants by district and group</tspan>
      <tspan data-lang-vi>20.000 ứng viên theo khu và nhóm</tspan>
    </text>

    <text x={barX} y={barY - 8} class="pl-name">
      <tspan data-lang-en>District X</tspan>
      <tspan data-lang-vi>Khu X</tspan>
    </text>
    <text x={oX} y={barY - 8} class="pl-name">
      <tspan data-lang-en>Other districts</tspan>
      <tspan data-lang-vi>Các khu còn lại</tspan>
    </text>

    <rect x={barX} y={barY} width={xG} height={barH} class="pl-g" />
    <rect x={barX + xG} y={barY} width={xW - xG} height={barH} class="pl-rest" />
    <rect x={oX} y={barY} width={oG} height={barH} class="pl-g" />
    <rect x={oX + oG} y={barY} width={oW - oG} height={barH} class="pl-rest" />

    <text x={barX} y="222" class="pl-num"><tspan data-lang-en>4,000</tspan><tspan data-lang-vi>4.000</tspan></text>
    <text x={oX} y="222" class="pl-num"><tspan data-lang-en>16,000</tspan><tspan data-lang-vi>16.000</tspan></text>

    <text x={barX} y="244" class="pl-sub">
      <tspan data-lang-en>2,800 in G</tspan>
      <tspan data-lang-vi>2.800 nhóm G</tspan>
    </text>
    <text x={barX} y="262" class="pl-sub">
      <tspan data-lang-en>1,200 others</tspan>
      <tspan data-lang-vi>1.200 khác</tspan>
    </text>
    <text x={oX} y="244" class="pl-sub">
      <tspan data-lang-en>2,000 in G</tspan>
      <tspan data-lang-vi>2.000 nhóm G</tspan>
    </text>
    <text x={oX} y="262" class="pl-sub">
      <tspan data-lang-en>14,000 others</tspan>
      <tspan data-lang-vi>14.000 khác</tspan>
    </text>

    <text x={barX} y="290" class="pl-rate">
      <tspan data-lang-en>Approved: 15%</tspan>
      <tspan data-lang-vi>Duyệt: 15%</tspan>
    </text>
    <text x={oX} y="290" class="pl-rate">
      <tspan data-lang-en>Approved: 35%</tspan>
      <tspan data-lang-vi>Duyệt: 35%</tspan>
    </text>

    <rect x="10" y="306" width="14" height="14" class="pl-g" />
    <text x="30" y="318" class="pl-sub">
      <tspan data-lang-en>Group G</tspan>
      <tspan data-lang-vi>Nhóm G</tspan>
    </text>
    <rect x="110" y="306" width="14" height="14" class="pl-rest" />
    <text x="130" y="318" class="pl-sub">
      <tspan data-lang-en>Everyone else</tspan>
      <tspan data-lang-vi>Những người còn lại</tspan>
    </text>
  </svg>
</div>

<style>
  .pl { width: 100%; }
  .pl svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .pl text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .pl .pl-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .pl .pl-name { font-weight: 700; fill: var(--text); }
  .pl .pl-sub, .pl .pl-num { fill: var(--text-muted); }
  .pl .pl-rate { font-weight: 700; fill: var(--text); }
  .pl-chip { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .pl-chip.is-kept { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .pl-chip.is-dropped { fill: var(--bg); stroke: var(--text-muted); stroke-dasharray: 4 3; }
  .pl .pl-chip-t { fill: var(--text); font-weight: 600; }
  .pl .pl-chip-t.is-dropped { fill: var(--text-muted); text-decoration: line-through; }
  .pl-rule { stroke: var(--border); stroke-width: 1.2; }
  .pl-g { fill: var(--act-2); }
  .pl-rest { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
</style>
