---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz set 07 (storage engines): a sales file sorted by store_id then sale_date, cut into row groups.
// Shows the layout mechanism only (sort order, group size, min/max kept per group). No scan counts, no results.
// Plain inline SVG, site tokens, no <marker>/<defs>/ids, so the EN and VI copies cannot clash.

const W = 580;
const H = 396;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const tx = 10;
const ty = 44;
const colW = 96;
const rowH = 22;
const cols = [
  { name: 'store_id', first: true },
  { name: 'sale_date', first: false },
  { name: 'amount', first: false },
];
const rows = [
  ['1', 'day 1', '…'],
  ['1', 'day 2', '…'],
  ['⋮', '⋮', '⋮'],
  ['1', 'day 400', '…'],
  ['2', 'day 1', '…'],
  ['⋮', '⋮', '⋮'],
];
const boxes = [
  { x: 10, en: 'Row group 1', vi: 'Row group 1' },
  { x: 175, en: 'Row group 2', vi: 'Row group 2' },
  { x: 420, en: 'Row group 200', vi: 'Row group 200' },
];
const by = 262;
const a1 = arrow(70, ty + rowH * 7 + 8, 70, by - 4);
---
<div class="qsg">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <DiagramIcon name="file" x={22} y={20} size={20} />
    <text x="42" y="25" class="qsg-h">
      <tspan data-lang-en>One file, rows in sort order</tspan>
      <tspan data-lang-vi>Một file, các dòng theo thứ tự sắp xếp</tspan>
    </text>

    {cols.map((c, i) => (
      <g>
        <rect x={tx + i * colW} y={ty} width={colW} height={rowH} class={c.first ? 'qsg-head is-first' : 'qsg-head'} />
        <text x={tx + i * colW + colW / 2} y={ty + 16} text-anchor="middle" class="qsg-hname">{c.name}</text>
      </g>
    ))}
    {rows.map((r, ri) => (
      <g>
        {r.map((cell, ci) => (
          <g>
            <rect x={tx + ci * colW} y={ty + rowH * (ri + 1)} width={colW} height={rowH} class="qsg-cell" />
            <text x={tx + ci * colW + colW / 2} y={ty + rowH * (ri + 1) + 16} text-anchor="middle" class="qsg-num">{cell}</text>
          </g>
        ))}
      </g>
    ))}

    <text x="318" y="68" class="qsg-label">
      <tspan data-lang-en>Sort key</tspan>
      <tspan data-lang-vi>Khoá sắp xếp</tspan>
    </text>
    <text x="318" y="92" class="qsg-text">
      <tspan data-lang-en>1st: store_id</tspan>
      <tspan data-lang-vi>Thứ nhất: store_id</tspan>
    </text>
    <text x="318" y="114" class="qsg-text">
      <tspan data-lang-en>2nd: sale_date</tspan>
      <tspan data-lang-vi>Thứ hai: sale_date</tspan>
    </text>
    <text x="318" y="146" class="qsg-sub">
      <tspan data-lang-en>Each store has rows on</tspan>
      <tspan data-lang-vi>Mỗi cửa hàng có dòng ở</tspan>
    </text>
    <text x="318" y="166" class="qsg-sub">
      <tspan data-lang-en>every one of the 400 days.</tspan>
      <tspan data-lang-vi>cả 400 ngày.</tspan>
    </text>

    <g class="qsg-arrow"><path d={a1.line} /><polygon points={a1.head} /></g>
    <text x="84" y={by - 12} class="qsg-sub">
      <tspan data-lang-en>cut every 1,000,000 rows, in this order</tspan>
      <tspan data-lang-vi>cắt mỗi 1.000.000 dòng, theo thứ tự này</tspan>
    </text>

    {boxes.map((b) => (
      <g>
        <rect x={b.x} y={by} width="150" height="104" rx="8" class="qsg-box" />
        <text x={b.x + 10} y={by + 20} class="qsg-name">
          <tspan data-lang-en>{b.en}</tspan>
          <tspan data-lang-vi>{b.vi}</tspan>
        </text>
        {cols.map((c, i) => (
          <g>
            <text x={b.x + 10} y={by + 46 + i * 22} class="qsg-sub">{c.name}</text>
            <rect x={b.x + 80} y={by + 33 + i * 22} width="28" height="18" rx="3" class="qsg-chip" />
            <text x={b.x + 94} y={by + 46 + i * 22} text-anchor="middle" class="qsg-chiptext">min</text>
            <rect x={b.x + 112} y={by + 33 + i * 22} width="28" height="18" rx="3" class="qsg-chip" />
            <text x={b.x + 126} y={by + 46 + i * 22} text-anchor="middle" class="qsg-chiptext">max</text>
          </g>
        ))}
      </g>
    ))}
    <text x="363" y={by + 58} text-anchor="middle" class="qsg-name">…</text>

    <text x="10" y={H - 8} class="qsg-note">
      <tspan data-lang-en>Every group stores the min and max of each column.</tspan>
      <tspan data-lang-vi>Mỗi group lưu min và max của từng cột.</tspan>
    </text>
  </svg>
</div>

<style>
  .qsg { width: 100%; }
  .qsg svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qsg text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qsg .qsg-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qsg .qsg-hname { font-size: 13px; font-weight: 700; fill: var(--text); }
  .qsg .qsg-num { font-size: 13px; fill: var(--text-body); }
  .qsg .qsg-label, .qsg .qsg-name { font-weight: 700; fill: var(--text); }
  .qsg .qsg-text { fill: var(--text); }
  .qsg .qsg-sub { font-size: 13px; fill: var(--text-muted); }
  .qsg .qsg-note { font-size: 13px; fill: var(--text); }
  .qsg .qsg-chiptext { font-size: 13px; fill: var(--text-muted); }
  .qsg-head { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qsg-head.is-first { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .qsg-cell { fill: var(--bg); stroke: var(--border); stroke-width: 1; }
  .qsg-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qsg-chip { fill: var(--bg); stroke: var(--border); stroke-width: 1; }
  .qsg-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.3; }
  .qsg-arrow polygon { fill: var(--text-muted); }
</style>
