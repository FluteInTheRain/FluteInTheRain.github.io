---
// Quiz figure (post 20, Alpha): shows only the scenario's inputs, no answer. Inline SVG, site tokens only.
---
<div class="qfig-atq20curve">
  <svg viewBox="0 0 560 272" role="img" aria-label="Six markets, each with a gold dot for the best rule on the search window and a red dot for the same rule on unseen days. Gold dots sit between 1.5 and 2.1; red dots scatter from about minus 0.6 to 1.0.">
<text x="0" y="20" class="h"><tspan data-lang-en>Best rule in each of six pure-noise markets</tspan><tspan data-lang-vi>Quy tắc tốt nhất ở sáu thị trường nhiễu thuần</tspan></text>
<line x1="40" y1="210" x2="550" y2="210" class="grid" />
<text x="34" y="214.0" class="s" text-anchor="end">-1</text>
<line x1="40" y1="166" x2="550" y2="166" class="ax" />
<text x="34" y="170.0" class="s" text-anchor="end">0</text>
<line x1="40" y1="122" x2="550" y2="122" class="grid" />
<text x="34" y="126.0" class="s" text-anchor="end">1</text>
<line x1="40" y1="78" x2="550" y2="78" class="grid" />
<text x="34" y="82.0" class="s" text-anchor="end">2</text>
<line x1="80" y1="72" x2="80" y2="188" class="st" />
<circle cx="80" cy="72" r="6" class="gd" />
<circle cx="80" cy="188" r="6" class="rd" />
<text x="80" y="242" class="s" text-anchor="middle">1</text>
<line x1="165" y1="100" x2="165" y2="160" class="st" />
<circle cx="165" cy="100" r="6" class="gd" />
<circle cx="165" cy="160" r="6" class="rd" />
<text x="165" y="242" class="s" text-anchor="middle">2</text>
<line x1="250" y1="99" x2="250" y2="122" class="st" />
<circle cx="250" cy="99" r="6" class="gd" />
<circle cx="250" cy="122" r="6" class="rd" />
<text x="250" y="242" class="s" text-anchor="middle">3</text>
<line x1="335" y1="87" x2="335" y2="179" class="st" />
<circle cx="335" cy="87" r="6" class="gd" />
<circle cx="335" cy="179" r="6" class="rd" />
<text x="335" y="242" class="s" text-anchor="middle">4</text>
<line x1="420" y1="93" x2="420" y2="144" class="st" />
<circle cx="420" cy="93" r="6" class="gd" />
<circle cx="420" cy="144" r="6" class="rd" />
<text x="420" y="242" class="s" text-anchor="middle">5</text>
<line x1="505" y1="84" x2="505" y2="191" class="st" />
<circle cx="505" cy="84" r="6" class="gd" />
<circle cx="505" cy="191" r="6" class="rd" />
<text x="505" y="242" class="s" text-anchor="middle">6</text>
<text x="300" y="262" class="s" text-anchor="middle"><tspan data-lang-en>market</tspan><tspan data-lang-vi>thị trường</tspan></text>
<circle cx="400" cy="38" r="5" class="gd" />
<text x="410" y="42" class="s"><tspan data-lang-en>search window</tspan><tspan data-lang-vi>đoạn tìm kiếm</tspan></text>
<circle cx="400" cy="56" r="5" class="rd" />
<text x="410" y="60" class="s"><tspan data-lang-en>unseen days</tspan><tspan data-lang-vi>ngày chưa thấy</tspan></text>
  </svg>
</div>

<style>
  .qfig-atq20curve { margin: 0.5em 0; width: 100%; }
  .qfig-atq20curve svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .qfig-atq20curve text { font-size: 13px; fill: var(--text-body); }
  .qfig-atq20curve .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-atq20curve .s { font-size: 12px; fill: var(--text-muted); }
  .qfig-atq20curve .b { font-weight: 700; fill: var(--text); }
  .qfig-atq20curve .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-atq20curve .okb { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .qfig-atq20curve .badb { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-atq20curve .ax { stroke: var(--border); stroke-width: 1.2; fill: none; }
  .qfig-atq20curve .grid { stroke: var(--border); stroke-width: 1; stroke-dasharray: 3 4; fill: none; }
  .qfig-atq20curve .mut { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 4 3; fill: none; }
  .qfig-atq20curve .st { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .qfig-atq20curve .gd { fill: var(--gold); } .qfig-atq20curve .rd { fill: var(--red); }
</style>