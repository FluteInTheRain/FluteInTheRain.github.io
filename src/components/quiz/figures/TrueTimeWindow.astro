---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for distributed-system-failures set 05:
// Top: two transactions read [earliest, latest] bounds from a TrueTime-style clock on a 98..112 ms axis,
// showing an overlap band [101.5, 107.0] without stating whether midpoint ordering is valid.
// Bottom: the legacy Java lease check subtracting a remote lock service wall clock from the local wall clock.
// Inline SVG, site CSS tokens only, zero hex colors, no marker/defs/ids.

const W = 580;
const H = 376;
const x0 = 152;
const pxPerMs = 28; // 98..112 ms = 14 ms -> 392 px (152..544)
const tx = (ms: number) => x0 + (ms - 98) * pxPerMs;
const ticks = [98, 100, 102, 104, 106, 108, 110, 112];

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const leftArrow = arrow(230, 308, 248, 308);
const rightArrow = arrow(342, 308, 324, 308);
---
<div class="qfig-ttw">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: Tx A reads [100.0, 107.0] ms and Tx B starts right after and reads [101.5, 108.5] ms, overlapping across 101.5 to 107.0 ms. Bottom: a lease loop subtracts the lock service's expiryTimeMillis from the app node's System.currentTimeMillis().">
    <text x="0" y="22" class="qfig-ttw-h">
      <tspan data-lang-en>1. Confidence intervals [earliest, latest] on true time</tspan>
      <tspan data-lang-vi>1. Khoảng tin cậy [earliest, latest] theo thời gian thực</tspan>
    </text>

    {/* Overlap band [101.5, 107.0] */}
    <rect x={tx(101.5)} y="58" width={tx(107.0) - tx(101.5)} height="84" rx="4" class="qfig-ttw-overlap" />
    <text x={(tx(101.5) + tx(107.0)) / 2} y="104" text-anchor="middle" class="qfig-ttw-ovtxt">
      <tspan data-lang-en>overlap: 101.5..107.0</tspan>
      <tspan data-lang-vi>giao nhau: 101,5..107,0</tspan>
    </text>

    {/* Tx A row */}
    <DiagramIcon name="db" x={18} y={74} size={22} />
    <text x="38" y="79" class="qfig-ttw-lane">Tx A</text>
    <line x1={tx(100.0)} x2={tx(107.0)} y1="74" y2="74" class="qfig-ttw-bar-a" />
    <line x1={tx(100.0)} x2={tx(100.0)} y1="66" y2="82" class="qfig-ttw-cap-a" />
    <line x1={tx(107.0)} x2={tx(107.0)} y1="66" y2="82" class="qfig-ttw-cap-a" />
    <circle cx={tx(103.5)} cy="74" r="4.5" class="qfig-ttw-dot-a" />
    <text x={tx(103.5)} y="48" text-anchor="middle" class="qfig-ttw-t">
      <tspan data-lang-en>[100.0, 107.0] ms (mid 103.5)</tspan>
      <tspan data-lang-vi>[100,0, 107,0] ms (giữa 103,5)</tspan>
    </text>

    {/* Tx B row */}
    <DiagramIcon name="db" x={18} y={126} size={22} />
    <text x="38" y="131" class="qfig-ttw-lane">Tx B</text>
    <line x1={tx(101.5)} x2={tx(108.5)} y1="126" y2="126" class="qfig-ttw-bar-b" />
    <line x1={tx(101.5)} x2={tx(101.5)} y1="118" y2="134" class="qfig-ttw-cap-b" />
    <line x1={tx(108.5)} x2={tx(108.5)} y1="118" y2="134" class="qfig-ttw-cap-b" />
    <circle cx={tx(105.0)} cy="126" r="4.5" class="qfig-ttw-dot-b" />
    <text x={tx(105.0)} y="159" text-anchor="middle" class="qfig-ttw-t">
      <tspan data-lang-en>[101.5, 108.5] ms (mid 105.0)</tspan>
      <tspan data-lang-vi>[101,5, 108,5] ms (giữa 105,0)</tspan>
    </text>

    {/* True-time axis */}
    <line x1={tx(98)} x2={tx(112)} y1="184" y2="184" class="qfig-ttw-axis" />
    {ticks.map((ms) => (
      <g>
        <line x1={tx(ms)} x2={tx(ms)} y1="180" y2="188" class="qfig-ttw-axis" />
        <text x={tx(ms)} y="204" text-anchor="middle" class="qfig-ttw-m">{ms}</text>
      </g>
    ))}
    <text x="0" y="204" class="qfig-ttw-m">
      <tspan data-lang-en>True time (ms)</tspan>
      <tspan data-lang-vi>Thời gian thực (ms)</tspan>
    </text>

    {/* Divider */}
    <line x1="0" x2={W} y1="224" y2="224" class="qfig-ttw-rule" />

    {/* Section 2: Java lease clock subtraction */}
    <text x="0" y="250" class="qfig-ttw-h">
      <tspan data-lang-en>2. Legacy lease check across two machines</tspan>
      <tspan data-lang-vi>2. Phép kiểm tra lease cũ giữa hai máy</tspan>
    </text>

    {/* Left box: Lock service */}
    <rect x="2" y="268" width="228" height="84" rx="8" class="qfig-ttw-card" />
    <DiagramIcon name="lock" x={26} y={294} size={22} />
    <text x="46" y="299" class="qfig-ttw-lane">
      <tspan data-lang-en>Lock service</tspan>
      <tspan data-lang-vi>Dịch vụ khóa</tspan>
    </text>
    <text x="14" y="321" class="qfig-ttw-code">lease.expiryTimeMillis</text>
    <text x="14" y="340" class="qfig-ttw-m">
      <tspan data-lang-en>Clock 1 (wall clock)</tspan>
      <tspan data-lang-vi>Đồng hồ 1 (wall clock)</tspan>
    </text>

    {/* Right box: App node */}
    <rect x="342" y="268" width="236" height="84" rx="8" class="qfig-ttw-card" />
    <DiagramIcon name="server" x={366} y={294} size={22} />
    <text x="386" y="299" class="qfig-ttw-lane">
      <tspan data-lang-en>App node</tspan>
      <tspan data-lang-vi>Node ứng dụng</tspan>
    </text>
    <text x="354" y="321" class="qfig-ttw-code">System.currentTimeMillis()</text>
    <text x="354" y="340" class="qfig-ttw-m">
      <tspan data-lang-en>Clock 2 (wall clock)</tspan>
      <tspan data-lang-vi>Đồng hồ 2 (wall clock)</tspan>
    </text>

    {/* Center subtraction badge */}
    <g class="qfig-ttw-arrow"><path d={leftArrow.line} /><polygon points={leftArrow.head} /></g>
    <g class="qfig-ttw-arrow"><path d={rightArrow.line} /><polygon points={rightArrow.head} /></g>
    <rect x="248" y="278" width="76" height="62" rx="8" class="qfig-ttw-warn" />
    <DiagramIcon name="clock" x={267} y={300} size={17} />
    <text x="286" y="305" text-anchor="middle" class="qfig-ttw-op">−</text>
    <DiagramIcon name="clock" x={305} y={300} size={17} />
    <text x="286" y="328" text-anchor="middle" class="qfig-ttw-warntxt">&lt; 10,000</text>
  </svg>
</div>

<style>
  .qfig-ttw { margin: 0; width: 100%; }
  .qfig-ttw svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-ttw text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-ttw .qfig-ttw-h { font-size: 15.5px; font-weight: 700; fill: var(--text); }
  .qfig-ttw .qfig-ttw-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-ttw .qfig-ttw-t { font-weight: 600; fill: var(--text); }
  .qfig-ttw .qfig-ttw-m { font-size: 12.5px; fill: var(--text-muted); }
  .qfig-ttw .qfig-ttw-code { font-size: 12px; fill: var(--text); font-weight: 600; }
  .qfig-ttw .qfig-ttw-op { font-size: 16px; font-weight: 700; fill: var(--red); }
  .qfig-ttw .qfig-ttw-ovtxt { font-size: 12.5px; font-weight: 700; fill: var(--red); }
  .qfig-ttw .qfig-ttw-warntxt { font-size: 13px; font-weight: 700; fill: var(--red); }
  .qfig-ttw-overlap { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1; stroke-dasharray: 4 3; }
  .qfig-ttw-bar-a, .qfig-ttw-cap-a { stroke: var(--gold); stroke-width: 3; }
  .qfig-ttw-dot-a { fill: var(--gold); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-ttw-bar-b, .qfig-ttw-cap-b { stroke: var(--red); stroke-width: 3; }
  .qfig-ttw-dot-b { fill: var(--red); stroke: var(--bg); stroke-width: 1.5; }
  .qfig-ttw-axis { stroke: var(--text-muted); stroke-width: 1.3; }
  .qfig-ttw-rule { stroke: var(--border); stroke-width: 1; }
  .qfig-ttw-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .qfig-ttw-warn { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .qfig-ttw-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .qfig-ttw-arrow polygon { fill: var(--text-muted); }
</style>
