---
// Quiz figure for go-production set 08: the limits of the production http.Client from the post, each as a bar
// on a 0-5 s axis (IdleConnTimeout is a pool setting and sits in its own note). It states settings, not a verdict.
// Inline SVG, site tokens only.
const X0 = 190, X1 = 556;
const px = (s: number) => X0 + (s * (X1 - X0)) / 5;
const bars = [
  { y: 58, s: 1, name: 'Dialer.Timeout', en: 'opening the connection', vi: 'mở connection' },
  { y: 98, s: 1, name: 'TLSHandshakeTimeout', en: 'TLS handshake', vi: 'bắt tay TLS' },
  { y: 138, s: 2, name: 'ResponseHeaderTimeout', en: 'request sent to first header', vi: 'tới header đầu tiên' },
  { y: 178, s: 5, name: 'Client.Timeout', en: 'the whole call, body included', vi: 'cả lời gọi, gồm cả body' },
];
const axisY = 222;
---
<div class="qfig-gq14cp">
  <svg viewBox="0 0 580 316" role="img" aria-label="Four limits of one http.Client drawn as bars on a 0 to 5 second axis: Dialer.Timeout 1 second, TLSHandshakeTimeout 1 second, ResponseHeaderTimeout 2 seconds and Client.Timeout 5 seconds. A separate note gives IdleConnTimeout as 90 seconds for unused connections in the pool.">
    <text x="0" y="20" class="qfig-gq14cp-h">
      <tspan data-lang-en>The limits of one http.Client</tspan>
      <tspan data-lang-vi>Các giới hạn của một http.Client</tspan>
    </text>

    {bars.map((b) => (
      <g>
        <text x="0" y={b.y + 8} class="qfig-gq14cp-t">{b.name}</text>
        <text x="0" y={b.y + 26} class="qfig-gq14cp-m">
          <tspan data-lang-en>{b.en}</tspan>
          <tspan data-lang-vi>{b.vi}</tspan>
        </text>
        <rect x={px(0)} y={b.y - 8} width={px(b.s) - px(0)} height="22" rx="3" class="qfig-gq14cp-bar" />
        <text x={px(b.s) + 8} y={b.y + 8} class="qfig-gq14cp-t">{b.s} s</text>
      </g>
    ))}

    <line x1={X0} x2={X1} y1={axisY} y2={axisY} class="qfig-gq14cp-axis" />
    {[0, 1, 2, 3, 4, 5].map((s) => (
      <text x={px(s)} y={axisY + 20} text-anchor="middle" class="qfig-gq14cp-m">{s} s</text>
    ))}

    <rect x="0" y="262" width="556" height="40" rx="6" class="qfig-gq14cp-card" />
    <text x="12" y="287" class="qfig-gq14cp-b">
      <tspan data-lang-en>IdleConnTimeout 90 s: how long an unused connection stays in the pool</tspan>
      <tspan data-lang-vi>IdleConnTimeout 90 s: connection không dùng được giữ trong pool bao lâu</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-gq14cp { margin: 0; width: 100%; }
  .qfig-gq14cp svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-gq14cp text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-gq14cp .qfig-gq14cp-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-gq14cp .qfig-gq14cp-t { font-weight: 700; fill: var(--text); }
  .qfig-gq14cp .qfig-gq14cp-m { fill: var(--text-muted); }
  .qfig-gq14cp .qfig-gq14cp-b { fill: var(--text-body); }
  .qfig-gq14cp-bar { fill: var(--act-3); opacity: 0.85; }
  .qfig-gq14cp-axis { stroke: var(--text-muted); stroke-width: 2; }
  .qfig-gq14cp-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
</style>
