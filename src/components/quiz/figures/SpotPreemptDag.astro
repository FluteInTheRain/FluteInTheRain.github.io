---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Quiz figure for batch processing set 03: Airflow workflow DAG across Spark, Trino, and Python,
// Kubernetes cluster orchestration on EC2 Spot workers (Task 42 reclaimed at 95%), and a shared
// 64-GPU pool where two jobs each hold 32 GPUs. Shows the setup only, never computed answers.
// Plain inline SVG, site tokens only, no <marker>/<pattern>/<filter>/<clipPath>/ids.

const W = 580;
const H = 416;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const a1 = arrow(130, 89, 153, 89);
const a2 = arrow(256, 89, 275, 89);
const a3 = arrow(350, 89, 371, 89);
const a4 = arrow(474, 89, 493, 89);
const downA = arrow(76, 112, 76, 143);
const retryA = arrow(292, 221, 353, 221);
---
<div class="qfig-spd">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="An Airflow DAG sequences Spark, Trino, and Python jobs via S3 and Iceberg. On Kubernetes Spot workers, Task 42 of 50,000 records reaches 95% before Spot preemption reschedules it on another worker. Meanwhile, two 64-GPU training jobs each hold 32 GPUs in a shared 64-GPU pool.">
    <text x="10" y="22" class="qfig-spd-h">
      <tspan data-lang-en>Airflow DAG, Spot preemption, and GPU pool</tspan>
      <tspan data-lang-vi>Airflow DAG, thu hồi Spot và cụm GPU</tspan>
    </text>

    <!-- Zone 1: Workflow orchestrator -->
    <rect x="10" y="38" width="560" height="84" rx="8" class="qfig-spd-zone" />
    <DiagramIcon name="calendar" x={28} y={53} size={18} />
    <text x="45" y="58" class="qfig-spd-title">
      <tspan data-lang-en>Workflow orchestrator: Airflow DAG (60 nightly jobs)</tspan>
      <tspan data-lang-vi>Điều phối workflow: Airflow DAG (60 job/đêm)</tspan>
    </text>

    <rect x="22" y="68" width="108" height="42" rx="6" class="qfig-spd-goldbox" />
    <DiagramIcon name="spark" x={35} y={89} size={16} />
    <text x="50" y="94" class="qfig-spd-t">
      <tspan data-lang-en>Spark (6 h)</tspan>
      <tspan data-lang-vi>Spark (6 giờ)</tspan>
    </text>

    <g class="qfig-spd-arrow"><path d={a1.line} /><polygon points={a1.head} /></g>
    <rect x="154" y="72" width="102" height="34" rx="5" class="qfig-spd-pill" />
    <DiagramIcon name="s3" x={167} y={89} size={16} />
    <text x="182" y="94" class="qfig-spd-m">S3/Iceberg</text>

    <g class="qfig-spd-arrow"><path d={a2.line} /><polygon points={a2.head} /></g>
    <rect x="276" y="68" width="74" height="42" rx="6" class="qfig-spd-box" />
    <DiagramIcon name="server" x={290} y={89} size={16} />
    <text x="305" y="94" class="qfig-spd-t">Trino</text>

    <g class="qfig-spd-arrow"><path d={a3.line} /><polygon points={a3.head} /></g>
    <rect x="372" y="72" width="102" height="34" rx="5" class="qfig-spd-pill" />
    <DiagramIcon name="s3" x={385} y={89} size={16} />
    <text x="400" y="94" class="qfig-spd-m">S3/Iceberg</text>

    <g class="qfig-spd-arrow"><path d={a4.line} /><polygon points={a4.head} /></g>
    <rect x="494" y="68" width="66" height="42" rx="6" class="qfig-spd-box" />
    <text x="527" y="94" text-anchor="middle" class="qfig-spd-t">Python</text>

    <!-- Connector from Spark job down to Kubernetes cluster -->
    <g class="qfig-spd-dasharrow"><path d={downA.line} /><polygon points={downA.head} /></g>
    <text x="86" y="135" class="qfig-spd-m">
      <tspan data-lang-en>runs on cluster</tspan>
      <tspan data-lang-vi>chạy trên cụm</tspan>
    </text>

    <!-- Zone 2: Cluster orchestrator -->
    <rect x="10" y="144" width="560" height="134" rx="8" class="qfig-spd-zone" />
    <DiagramIcon name="kubernetes" x={28} y={159} size={18} />
    <text x="45" y="164" class="qfig-spd-title">
      <tspan data-lang-en>Cluster orchestrator: Kubernetes (etcd, kubelet, cgroups)</tspan>
      <tspan data-lang-vi>Điều phối cụm: Kubernetes (etcd, kubelet, cgroups)</tspan>
    </text>

    <!-- Spot worker A -->
    <rect x="22" y="178" width="268" height="86" rx="6" class="qfig-spd-box" />
    <DiagramIcon name="worker" x={37} y={197} size={17} />
    <text x="54" y="202" class="qfig-spd-t">
      <tspan data-lang-en>Spot worker A — Task 42 (50,000)</tspan>
      <tspan data-lang-vi>Spot worker A — Task 42 (50.000)</tspan>
    </text>
    <rect x="34" y="214" width="206" height="14" rx="3" class="qfig-spd-track" />
    <rect x="34" y="214" width="196" height="14" rx="3" class="qfig-spd-prog" />
    <text x="247" y="226" class="qfig-spd-red">95%</text>
    <DiagramIcon name="warning" x={40} y={246} size={15} />
    <text x="55" y="251" class="qfig-spd-red">
      <tspan data-lang-en>EC2 Spot reclaimed at 95%</tspan>
      <tspan data-lang-vi>EC2 Spot bị thu hồi ở 95%</tspan>
    </text>

    <!-- Retry arrow -->
    <g class="qfig-spd-redarrow"><path d={retryA.line} /><polygon points={retryA.head} /></g>
    <text x="323" y="210" text-anchor="middle" class="qfig-spd-m">
      <tspan data-lang-en>retry</tspan>
      <tspan data-lang-vi>chạy lại</tspan>
    </text>

    <!-- Spot worker B -->
    <rect x="356" y="178" width="202" height="86" rx="6" class="qfig-spd-dashbox" />
    <DiagramIcon name="retry" x={372} y={197} size={17} />
    <text x="390" y="202" class="qfig-spd-t">Spot worker B</text>
    <text x="368" y="228" class="qfig-spd-m">
      <tspan data-lang-en>Task 42 rescheduled</tspan>
      <tspan data-lang-vi>Xếp chạy lại Task 42</tspan>
    </text>
    <text x="368" y="249" class="qfig-spd-m">
      <tspan data-lang-en>(50,000 records)</tspan>
      <tspan data-lang-vi>(50.000 bản ghi)</tspan>
    </text>

    <!-- Zone 3: Shared 64-GPU pool -->
    <rect x="10" y="294" width="560" height="110" rx="8" class="qfig-spd-zone" />
    <DiagramIcon name="model" x={28} y={313} size={18} />
    <text x="45" y="318" class="qfig-spd-title">
      <tspan data-lang-en>Shared 64-GPU pool (each job needs all 64 at once)</tspan>
      <tspan data-lang-vi>Cụm 64 GPU dùng chung (mỗi job cần đủ 64 cùng lúc)</tspan>
    </text>

    <rect x="22" y="332" width="264" height="32" rx="5" class="qfig-spd-hot" />
    <text x="154" y="353" text-anchor="middle" class="qfig-spd-t">
      <tspan data-lang-en>Job A holds 32 GPUs (needs 64)</tspan>
      <tspan data-lang-vi>Job A giữ 32 GPU (cần 64)</tspan>
    </text>

    <rect x="294" y="332" width="264" height="32" rx="5" class="qfig-spd-hot" />
    <text x="426" y="353" text-anchor="middle" class="qfig-spd-t">
      <tspan data-lang-en>Job B holds 32 GPUs (needs 64)</tspan>
      <tspan data-lang-vi>Job B giữ 32 GPU (cần 64)</tspan>
    </text>

    <text x="22" y="388" class="qfig-spd-m">
      <tspan data-lang-en>0 free GPUs remain in the pool while both training jobs wait.</tspan>
      <tspan data-lang-vi>Cụm còn 0 GPU trống trong khi cả hai job training đều đang chờ.</tspan>
    </text>
  </svg>
</div>

<style>
  .qfig-spd { margin: 0; width: 100%; }
  .qfig-spd svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-spd text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .qfig-spd .qfig-spd-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .qfig-spd .qfig-spd-title { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-spd .qfig-spd-t { font-weight: 600; fill: var(--text); }
  .qfig-spd .qfig-spd-m { fill: var(--text-muted); }
  .qfig-spd .qfig-spd-red { font-weight: 600; fill: var(--red); }
  .qfig-spd-zone { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-spd-box { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .qfig-spd-dashbox { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .qfig-spd-goldbox { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .qfig-spd-pill { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1; }
  .qfig-spd-track { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .qfig-spd-prog { fill: var(--gold); }
  .qfig-spd-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .qfig-spd-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .qfig-spd-arrow polygon { fill: var(--text-muted); }
  .qfig-spd-dasharrow path { fill: none; stroke: var(--gold); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .qfig-spd-dasharrow polygon { fill: var(--gold); }
  .qfig-spd-redarrow path { fill: none; stroke: var(--red); stroke-width: 1.6; }
  .qfig-spd-redarrow polygon { fill: var(--red); }
</style>
