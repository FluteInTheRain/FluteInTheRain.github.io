---
// Final balances of the six Alpha Arena Season 1 models as tallied by Forklog (4 Nov 2025), start $10,000 each.
const rows = [
  { n: 'Qwen3 Max', v: 12231 }, { n: 'DeepSeek', v: 10489 }, { n: 'Claude', v: 5799 },
  { n: 'Gemini', v: 5445 }, { n: 'Grok', v: 4208 }, { n: 'GPT-5', v: 4126 },
];
const X0 = 100, SC = 360 / 12500;
---
<div class="qfig-atq22b">
  <svg viewBox="0 0 580 250" role="img" aria-label="Horizontal bars of final balances, starting from 10,000 dollars each: Qwen3 Max 12,231, DeepSeek 10,489, Claude 5,799, Gemini 5,445, Grok 4,208, GPT-5 4,126. A dashed line marks the 10,000 dollar start.">
    <text x="20" y="18" class="h"><tspan data-lang-en>Final balances, start $10,000 each</tspan><tspan data-lang-vi>Số dư cuối, mỗi mô hình bắt đầu 10.000 USD</tspan></text>
    <line x1={X0 + 10000 * SC} x2={X0 + 10000 * SC} y1="30" y2="226" class="ref" />
    <text x={X0 + 10000 * SC} y="244" text-anchor="middle" class="s"><tspan data-lang-en>start</tspan><tspan data-lang-vi>vốn đầu</tspan></text>
    {rows.map((r, i) => (
      <g>
        <text x="92" y={52 + i * 30} text-anchor="end" class="n">{r.n}</text>
        <rect x={X0} y={36 + i * 30} width={r.v * SC} height="22" rx="3" class={r.v >= 10000 ? 'bar up' : 'bar'} />
        <text x={X0 + r.v * SC + 6} y={52 + i * 30} class="v">${r.v.toLocaleString('en-US')}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .qfig-atq22b svg { display: block; width: 100%; height: auto; max-width: 580px; margin: 0 auto; }
  .qfig-atq22b text { font-size: 12.5px; fill: var(--text-body); }
  .qfig-atq22b .h { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .qfig-atq22b .n { font-weight: 600; fill: var(--text); }
  .qfig-atq22b .v { font-weight: 700; fill: var(--text); }
  .qfig-atq22b .s { fill: var(--text-muted); }
  .qfig-atq22b .bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qfig-atq22b .bar.up { fill: var(--gold-tint-bg); stroke: var(--gold-icon); }
  .qfig-atq22b .ref { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 4; }
</style>
