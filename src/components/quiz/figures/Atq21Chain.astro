---
// Set 06: 10 steps, each right 95%: no check 59.9%; check catches 80% and allows one retry 88.6%.
// python3: 0.95**10 = 0.599; s = .95+.05*.8*.95 = .988, s**10 = .886
const rows = [
  { en: 'No check', vi: 'Không kiểm', v: 59.9, cls: 'is-red' },
  { en: 'Check after each step', vi: 'Kiểm sau mỗi bước', v: 88.6, cls: '' },
];
---
<div class="q21c">
  <svg viewBox="0 0 580 160" role="img" aria-hidden="true">
    <text x="20" y="24" class="h"><tspan data-lang-en>A 10-step task, each step right 95%</tspan><tspan data-lang-vi>Việc 10 bước, mỗi bước đúng 95%</tspan></text>
    {rows.map((r, i) => (
      <g>
        <text x="20" y={58 + i * 44} class="s"><tspan data-lang-en>{r.en}</tspan><tspan data-lang-vi>{r.vi}</tspan></text>
        <rect x="190" y={42 + i * 44} width={(r.v / 100) * 300} height="22" rx="4" class={`b ${r.cls}`} />
        <text x={190 + (r.v / 100) * 300 + 8} y={58 + i * 44} class="n">{r.v.toFixed(1)}%</text>
      </g>
    ))}
    <text x="20" y="146" class="m"><tspan data-lang-en>Task finishes correctly: no check vs check catching 80%, one retry.</tspan><tspan data-lang-vi>Việc xong đúng: không kiểm so với kiểm bắt 80%, thử lại một lần.</tspan></text>
  </svg>
</div>
<style>
  .q21c svg { display: block; width: 100%; height: auto; font-variant-numeric: tabular-nums; }
  .q21c text { font-size: 13px; fill: var(--text-body); }
  .q21c .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .q21c .s { fill: var(--text); }
  .q21c .n { font-weight: 700; fill: var(--text); }
  .q21c .m { font-size: 12px; fill: var(--text-muted); }
  .q21c .b { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.3; }
  .q21c .b.is-red { fill: var(--red-tint-bg); stroke: var(--red); }
</style>
