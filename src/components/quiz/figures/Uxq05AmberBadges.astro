<rect x="425" y="56" width="150" height="48" rx="8" fill="#FEF3C7" />
<text x="500" y="86" text-anchor="middle" style="font-size:15px;font-weight:700" fill="#78350F"><tspan data-lang-en>Pending</tspan><tspan data-lang-vi>Đang chờ</tspan></text>
<text x="500" y="128" class="m" text-anchor="middle">#FEF3C7 / #78350F</text>
<text x="300" y="164" class="m" text-anchor="middle"><tspan data-lang-en>Background / text colour</tspan><tspan data-lang-vi>Màu nền / màu chữ</tspan></text>
  </svg>
</div>

<style>
  .qfig-uxq05amberbadges { margin: 0; width: 100%; }
  .qfig-uxq05amberbadges svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq05amberbadges text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq05amberbadges .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-uxq05amberbadges .m { fill: var(--text-muted); font-size: 12.5px; }
  .qfig-uxq05amberbadges .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq05amberbadges .w { fill: #FFFFFF; font-weight: 700; font-size: 15px; }
</style>
