---
// Quiz figure for the post "Design before prompting": the same card with two different personality settings.
// The colour swatches are the subject of the question, so they carry their real colour inline.
---
<div class="qfig-uxq01cardpair">
  <svg viewBox="0 0 600 250" role="img" aria-label="Two versions of an Assign task card. Card X: square corners, serif title, a dark blue square button reading Assign task. Card Y: 16 pixel rounded corners, rounded sans title, a pink pill button reading Let's hand it off!">
    <text x="150" y="22" class="h" text-anchor="middle"><tspan data-lang-en>Card X</tspan><tspan data-lang-vi>Thẻ X</tspan></text>
    <rect x="20" y="34" width="260" height="200" rx="0" class="card" />
    <text x="38" y="70" class="serif">Assign task</text>
    <text x="38" y="98" class="body"><tspan data-lang-en>Choose the person responsible.</tspan><tspan data-lang-vi>Chọn người phụ trách.</tspan></text>
    <rect x="38" y="112" width="224" height="30" rx="0" class="field" />
    <rect x="38" y="180" width="140" height="34" rx="0" style="fill:#1e3a8a" />
    <text x="108" y="202" class="btn" text-anchor="middle">Assign task</text>

    <text x="450" y="22" class="h" text-anchor="middle"><tspan data-lang-en>Card Y</tspan><tspan data-lang-vi>Thẻ Y</tspan></text>
    <rect x="320" y="34" width="260" height="200" rx="16" class="card" />
    <text x="338" y="70" class="sans">Assign task</text>
    <text x="338" y="98" class="body"><tspan data-lang-en>Who's taking this one?</tspan><tspan data-lang-vi>Ai nhận việc này nè?</tspan></text>
    <rect x="338" y="112" width="224" height="30" rx="12" class="field" />
    <rect x="338" y="180" width="170" height="34" rx="17" style="fill:#ec4899" />
    <text x="423" y="202" class="btn" text-anchor="middle"><tspan data-lang-en>Let's hand it off!</tspan><tspan data-lang-vi>Giao thôi nào!</tspan></text>
  </svg>
</div>

<style>
  .qfig-uxq01cardpair { margin: 0; width: 100%; }
  .qfig-uxq01cardpair svg { display: block; width: 100%; min-width: 320px; height: auto; }
  .qfig-uxq01cardpair text { font-size: 13px; fill: var(--text-body); }
  .qfig-uxq01cardpair .h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .qfig-uxq01cardpair .serif { font-family: Georgia, 'Times New Roman', serif; font-size: 20px; font-weight: 700; fill: var(--text); }
  .qfig-uxq01cardpair .sans { font-size: 20px; font-weight: 700; fill: var(--text); }
  .qfig-uxq01cardpair .body { fill: var(--text-muted); }
  .qfig-uxq01cardpair .btn { fill: #fff; font-weight: 700; }
  .qfig-uxq01cardpair .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .qfig-uxq01cardpair .field { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
</style>
