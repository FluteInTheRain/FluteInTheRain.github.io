---
import DiagramIcon from '../../mdx/DiagramIcon.astro';
// Set 03: survivorship bias — a dataset built in 2025 from today's HOSE list
// silently drops the four firms forced off the exchange during 2024 (post §2).
const lost = [
  { sym: 'POM', en: 'Pomina Steel — reports three years late', vi: 'Thép Pomina — nộp báo cáo trễ ba năm' },
  { sym: 'HBC', en: 'Hoa Binh Constr. — losses above charter capital', vi: 'Xây dựng Hoà Bình — lỗ lũy kế vượt vốn điều lệ' },
  { sym: 'DAG', en: 'Dong A Plastic — disclosure violations', vi: 'Nhựa Đông Á — vi phạm công bố thông tin' },
  { sym: 'GMC', en: 'Garmex Saigon — operations halted over a year', vi: 'Garmex Sài Gòn — ngừng hoạt động chính trên một năm' },
];
const kept = ['REE', 'SAM', 'HSG', 'VNM', 'FPT', '…'];
const W = 580;
const H = 440;
---
<div class="qdsb">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    <DiagramIcon name="file" x={22} y={20} size={22} />
    <text x="44" y="25" class="qdsb-h">
      <tspan data-lang-en>The accidental filter</tspan>
      <tspan data-lang-vi>Cái lọc vô tình</tspan>
    </text>

    <text x="16" y="56" class="qdsb-strong">
      <tspan data-lang-en>Dataset built in 2025 from today's HOSE list</tspan>
      <tspan data-lang-vi>Dataset dựng năm 2025 từ danh sách HOSE hôm nay</tspan>
    </text>
    {kept.map((s, i) => {
      const x = 24 + i * 88;
      return (
        <g>
          <rect x={x} y="70" width="76" height="34" rx="6" class="qdsb-tile" />
          <text x={x + 38} y="92" text-anchor="middle" class="qdsb-sym">{s}</text>
        </g>
      );
    })}
    <text x="24" y="126" class="qdsb-muted">
      <tspan data-lang-en>Backtest over ten years: "a decent result".</tspan>
      <tspan data-lang-vi>Backtest mười năm: "kết quả khá ổn".</tspan>
    </text>

    <text x="16" y="164" class="qdsb-strong">
      <tspan data-lang-en>What the file cannot show — forced off HOSE in 2024:</tspan>
      <tspan data-lang-vi>Cái file không thấy — bị buộc rời HOSE năm 2024:</tspan>
    </text>
    {lost.map((r, i) => {
      const y = 178 + i * 56;
      return (
        <g>
          <rect x="14" y={y} width="552" height="46" rx="8" class="qdsb-lostrow" />
          <rect x="26" y={y + 8} width="52" height="30" rx="6" class="qdsb-losstile" />
          <text x="52" y={y + 28} text-anchor="middle" class="qdsb-lostsym">{r.sym}</text>
          <text x="92" y={y + 28} class="qdsb-losttext">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
        </g>
      );
    })}
    <text x="16" y={178 + 4 * 56 + 22} class="qdsb-bad">
      <tspan data-lang-en>Their losing years are not in the file — every backtest turns optimistic.</tspan>
      <tspan data-lang-vi>Những năm thua lỗ của họ không có trong file — mọi backtest trở nên lạc quan.</tspan>
    </text>
  </svg>
</div>

<style>
  .qdsb {
    margin: 0;
    width: 100%;
  }
  .qdsb svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .qdsb text {
    font-size: 14px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .qdsb .qdsb-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .qdsb .qdsb-strong {
    font-size: 14px;
    font-weight: 600;
    fill: var(--text);
  }
  .qdsb .qdsb-muted {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .qdsb .qdsb-tile {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .qdsb .qdsb-sym {
    font-size: 14px;
    font-weight: 700;
    fill: var(--text);
  }
  .qdsb .qdsb-lostrow {
    fill: var(--red-tint-bg);
    stroke: var(--border);
    stroke-width: 1;
  }
  .qdsb .qdsb-losstile {
    fill: var(--bg);
    stroke: var(--red);
    stroke-width: 1.4;
  }
  .qdsb .qdsb-lostsym {
    font-size: 13px;
    font-weight: 700;
    fill: var(--red);
  }
  .qdsb .qdsb-losttext {
    font-size: 13.5px;
    fill: var(--text-body);
  }
  .qdsb .qdsb-bad {
    font-size: 13.5px;
    font-weight: 700;
    fill: var(--red);
  }
</style>
