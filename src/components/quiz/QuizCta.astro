---
// A link card to a post's quiz, shown under the post when the quiz exists.
import T from '../T.astro';

interface Props { slug: string; count: number }
const { slug, count } = Astro.props;
---
<aside class="quiz-cta" aria-label="Review quiz">
  <div>
    <p class="quiz-cta-title"><T en="Test what you took from this post" vi="Kiểm tra những gì bạn rút ra từ bài này" /></p>
    <p class="quiz-cta-sub">
      <T
        en={`${count} multiple-choice questions in short cases, from easy to hard, with answers and explanations.`}
        vi={`${count} câu trắc nghiệm theo tình huống ngắn, từ dễ đến khó, có đáp án và lời giải.`}
      />
    </p>
  </div>
  <a class="quiz-cta-link" href={`/blog/${slug}/quiz/`}><T en="Start the quiz" vi="Làm bài ôn tập" /> →</a>
</aside>
