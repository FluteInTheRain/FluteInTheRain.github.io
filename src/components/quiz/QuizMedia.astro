---
// One piece of media in a scenario or a question: a figure component by name, or a code block.
import T from '../T.astro';
import type { QuizMedia } from '../../data/quiz/types';

interface Props { media: QuizMedia }
const { media } = Astro.props;

const figures = import.meta.glob<{ default: any }>('./figures/*.astro', { eager: true });
let Figure: any = null;
if (media.kind === 'figure') {
  const key = `./figures/${media.component}.astro`;
  const mod = figures[key];
  if (!mod) {
    throw new Error(`Quiz figure "${media.component}" not found: create src/components/quiz/figures/${media.component}.astro`);
  }
  Figure = mod.default;
}
---
{media.kind === 'figure' ? (
  <figure class="quiz-figure">
    <Figure />
    <figcaption class="quiz-figcap"><T en={media.alt.en} vi={media.alt.vi} /></figcaption>
  </figure>
) : (
  <figure class="quiz-code-wrap">
    <pre class="quiz-code" data-lang={media.lang}><code>{media.code}</code></pre>
    {media.caption && <figcaption class="quiz-figcap"><T en={media.caption.en} vi={media.caption.vi} /></figcaption>}
  </figure>
)}
