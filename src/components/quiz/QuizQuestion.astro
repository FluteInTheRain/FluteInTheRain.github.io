---
// One question. Everything is in the HTML (stem, options, explanation); src/scripts/quiz.ts turns it into a player.
// Without JavaScript the reader sees every question, with the correct answer and the explanation underneath.
import T from '../T.astro';
import QuizText from './QuizText.astro';
import QuizMedia from './QuizMedia.astro';
import { LEVEL_LABELS } from '../../data/quiz/labels';
import { shuffleOptions } from '../../utils/quiz';
import type { QuizQuestion } from '../../data/quiz/types';

interface Props {
  q: QuizQuestion;
  /** 1-based position among all questions of the quiz */
  n: number;
  postSlug: string;
  /** English heading slug -> Vietnamese heading slug of the post */
  slugPairs: Record<string, string>;
}
const { q, n, postSlug, slugPairs } = Astro.props;

const isMulti = q.type === 'multi';
const options = shuffleOptions(q.options, q.id);
const letterOf = new Map(options.map((o, i) => [o.id, String.fromCharCode(65 + i)]));
const rightLetters = options.filter((o) => q.answer.includes(o.id)).map((o) => letterOf.get(o.id));
const wrongOptions = options.filter((o) => !q.answer.includes(o.id));
const { reread } = q.explanation;
const viAnchor = slugPairs[reread.anchor] ?? reread.anchor;
---
<article
  class="quiz-q"
  id={q.id}
  data-q={q.id}
  data-type={isMulti ? 'multi' : 'single'}
  data-answer={q.answer.join(',')}
  data-level={q.level}
  data-n={n}
>
  <header class="quiz-q-head">
    <span class="quiz-q-num">{n}</span>
    <span class="quiz-tag quiz-tag-level"><T en={LEVEL_LABELS[q.level].en} vi={LEVEL_LABELS[q.level].vi} /></span>
    <span class="quiz-diff" role="img" aria-label={`Difficulty ${q.difficulty} of 5`}>
      {[1, 2, 3, 4, 5].map((d) => <span class={d <= q.difficulty ? 'is-on' : ''}></span>)}
    </span>
  </header>

  <div class="quiz-stem quiz-text"><QuizText en={q.stem.en} vi={q.stem.vi} /></div>
  {q.media?.map((m) => <QuizMedia media={m} />)}

  <p class="quiz-hint">
    {isMulti
      ? <T en="Tick two answers, then press Check." vi="Chọn hai đáp án, rồi bấm Kiểm tra." />
      : <T en="Choose the best answer." vi="Chọn đáp án đúng nhất." />}
  </p>

  <ol class="quiz-options" role="list">
    {options.map((o) => (
      <li>
        <button type="button" class="quiz-opt" data-opt={o.id} aria-pressed="false">
          <span class="quiz-opt-key">{letterOf.get(o.id)}</span>
          <span class="quiz-opt-text quiz-text"><QuizText en={o.text.en} vi={o.text.vi} /></span>
        </button>
      </li>
    ))}
  </ol>

  {isMulti && (
    <button type="button" class="quiz-btn quiz-check" disabled>
      <T en="Check" vi="Kiểm tra" />
    </button>
  )}

  <div class="quiz-explain" data-explain>
    <p class="quiz-verdict" data-verdict>
      <strong><T en={`Correct answer: ${rightLetters.join(' and ')}`} vi={`Đáp án đúng: ${rightLetters.join(' và ')}`} /></strong>
    </p>
    <p class="quiz-section-label"><T en="Why it works" vi="Vì sao đúng" /></p>
    <div class="quiz-text quiz-why"><QuizText en={q.explanation.whyRight.en} vi={q.explanation.whyRight.vi} /></div>
    <p class="quiz-section-label"><T en="Why not the others" vi="Vì sao các đáp án khác sai" /></p>
    <ul class="quiz-why-wrong" role="list">
      {wrongOptions.map((o) => (
        <li data-for={o.id}>
          <span class="quiz-opt-key">{letterOf.get(o.id)}</span>
          <span class="quiz-text"><QuizText en={q.explanation.whyWrong[o.id].en} vi={q.explanation.whyWrong[o.id].vi} /></span>
        </li>
      ))}
    </ul>
    <p class="quiz-say">
      <span class="quiz-say-label"><T en="Takeaway" vi="Điều rút ra" /></span>
      <span class="quiz-text"><QuizText en={q.explanation.say.en} vi={q.explanation.say.vi} /></span>
    </p>
    <p class="quiz-reread">
      <a data-lang-en href={`/blog/${postSlug}/#${reread.anchor}`}>Read again: {reread.label.en}</a>
      <a data-lang-vi href={`/blog/${postSlug}/#${viAnchor}`}>Đọc lại: {reread.label.vi}</a>
    </p>
    <button type="button" class="quiz-btn quiz-next" hidden>
      <T en="Next" vi="Tiếp" />
    </button>
  </div>
</article>
