---
// The scenario of a case set, as short paragraphs and bullet lists instead of one wall of text.
// Authoring format (same string in `en` and `vi`): one paragraph per line, blank lines are ignored,
// consecutive lines that start with "• " become one list, `code` between backticks is a formula or token.
// Same output shape as QuizText (one block per language) so the language toggle works unchanged.
interface Props { en: string; vi: string }
const { en, vi } = Astro.props;

type Node = { kind: 'p'; text: string } | { kind: 'ul'; items: string[] };
const parse = (s: string): Node[] => {
  const out: Node[] = [];
  for (const raw of s.split('\n')) {
    const line = raw.trim();
    if (!line) continue;
    if (line.startsWith('• ')) {
      const last = out[out.length - 1];
      if (last?.kind === 'ul') last.items.push(line.slice(2));
      else out.push({ kind: 'ul', items: [line.slice(2)] });
    } else out.push({ kind: 'p', text: line });
  }
  return out;
};
const inline = (s: string) => s.split(/`([^`]+)`/);
const langs = [{ attr: 'en', nodes: parse(en) }, { attr: 'vi', nodes: parse(vi) }];
---
<div class="quiz-ctx">
  {langs.map(({ attr, nodes }) => (
    <div {...{ [`data-lang-${attr}`]: true }}>
      {nodes.map((n) => n.kind === 'ul'
        ? <ul>{n.items.map((it) => <li>{inline(it).map((p, i) => (i % 2 ? <code class="quiz-formula">{p}</code> : p))}</li>)}</ul>
        : <p>{inline(n.text).map((p, i) => (i % 2 ? <code class="quiz-formula">{p}</code> : p))}</p>)}
    </div>
  ))}
</div>
