---
import { rootHref } from '../utils/href';
import content from '../data/content';
import Icon from './Icon.astro';
const { person, nav } = content;
---
<div class="nav">
  <div class="container nav-inner">
    <a class="nav-brand" href="/">
      <div class="nav-name">{person.name}</div>
      <div class="nav-role">{person.role}</div>
    </a>
    <div class="nav-links" id="nav-links">
      {nav.links.map((l) => <a class="nav-link" href={rootHref(l.href)}>{l.label}</a>)}
    </div>
    <div class="nav-actions">
      <a class="btn btn-outline-red" href={nav.resumeUrl} target="_blank" rel="noopener">Resume</a>
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode">
        <span class="icon-sun"><Icon name="sun" size={18} /></span>
        <span class="icon-moon"><Icon name="moon" size={18} /></span>
      </button>
      <button class="icon-btn nav-hamburger" id="nav-hamburger" type="button" aria-label="Toggle menu" aria-expanded="false">
        <span class="icon-open"><Icon name="hamburger" size={18} /></span>
        <span class="icon-close"><Icon name="close" size={18} /></span>
      </button>
    </div>
  </div>
</div>
<style is:global>
  #theme-toggle > span, #nav-hamburger > span { display: inline-flex; }
  #theme-toggle .icon-sun { display: none; }
  html[data-theme='dark'] #theme-toggle .icon-sun { display: inline-flex; }
  html[data-theme='dark'] #theme-toggle .icon-moon { display: none; }
  #nav-hamburger .icon-close { display: none; }
  #nav-hamburger[aria-expanded='true'] .icon-close { display: inline-flex; }
  #nav-hamburger[aria-expanded='true'] .icon-open { display: none; }
</style>
