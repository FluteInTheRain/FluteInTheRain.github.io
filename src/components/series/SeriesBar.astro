---
// One line above a series post's title: which part this is, and a link to the series cover.
import T from '../T.astro';
import type { getSeriesNav } from '../../utils/series';

interface Props { nav: NonNullable<Awaited<ReturnType<typeof getSeriesNav>>> }
const { nav } = Astro.props;
const { view, current } = nav;
const total = view.parts.length;
---
<p class="series-bar">
  <span class="series-bar-part"><T en={`Part ${current.n} of ${total}`} vi={`Bài ${current.n}/${total}`} /></span>
  <span class="series-bar-dot" aria-hidden="true">·</span>
  <a href={view.url}><T en={view.series.title.en} vi={view.series.title.vi} /></a>
</p>

<style>
  .series-bar { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 8px; margin: 0 0 14px; font-size: 14px; color: var(--text-muted); }
  .series-bar-part { font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; font-size: 12px; color: var(--red); }
  .series-bar a { color: var(--text-body); font-weight: 600; }
  .series-bar a:hover { color: var(--red); }
</style>
