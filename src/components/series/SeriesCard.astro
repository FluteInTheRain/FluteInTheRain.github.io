---
// Compact series entry for list pages: a small book cover beside what the series is,
// how far along it is, and a link in.
import T from '../T.astro';
import BookCover from './BookCover.astro';
import type { SeriesView } from '../../utils/series';

interface Props { view: SeriesView }
const { view } = Astro.props;
const { series, parts, publishedCount } = view;
---
<a class="series-card" href={view.url}>
  <span class="series-card-book" aria-hidden="true"><BookCover view={view} size="sm" /></span>
  <span class="series-card-body">
    <span class="series-card-kicker"><T en={series.kicker.en} vi={series.kicker.vi} /></span>
    <span class="series-card-title"><T en={series.title.en} vi={series.title.vi} /></span>
    <span class="series-card-tagline"><T en={series.tagline.en} vi={series.tagline.vi} /></span>
    <span class="series-card-foot">
      <T en={`${publishedCount} of ${parts.length} published · Open the series →`} vi={`Đã đăng ${publishedCount}/${parts.length} bài · Xem cả series →`} />
    </span>
  </span>
</a>

<style>
  .series-card { display: flex; gap: 28px; align-items: center; max-width: 760px; box-sizing: border-box; margin: 0 0 32px; padding: 22px 28px 22px 24px; border-radius: 12px; background: var(--bg-alt); border: 1px solid var(--border); text-decoration: none; transition: border-color 0.15s; }
  .series-card:hover { border-color: var(--red); }
  .series-card-book { flex: none; padding: 4px 10px 6px 2px; }
  .series-card-body { display: grid; gap: 6px; min-width: 0; }
  .series-card-kicker { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--red); }
  .series-card-title { font-size: 22px; line-height: 1.25; font-weight: 800; letter-spacing: -0.015em; color: var(--text); }
  .series-card-tagline { font-size: 15px; line-height: 1.5; color: var(--text-body); }
  .series-card-foot { margin-top: 4px; font-size: 14px; font-weight: 600; color: var(--red); }
  @media (max-width: 520px) {
    .series-card { gap: 18px; padding: 18px; }
    .series-card-title { font-size: 19px; }
  }
</style>
