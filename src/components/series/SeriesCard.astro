---
// Compact series cover for list pages: what the series is, how far along it is, and a link in.
import T from '../T.astro';
import type { SeriesView } from '../../utils/series';

interface Props { view: SeriesView }
const { view } = Astro.props;
const { series, parts, publishedCount } = view;
---
<a class="series-card" href={view.url}>
  <span class="series-card-kicker"><T en={series.kicker.en} vi={series.kicker.vi} /></span>
  <span class="series-card-title"><T en={series.title.en} vi={series.title.vi} /></span>
  <span class="series-card-tagline"><T en={series.tagline.en} vi={series.tagline.vi} /></span>
  <span class="series-card-spine" aria-hidden="true">
    {parts.map((p) => <span class:list={['series-card-cell', `act-${p.part.act}`, { 'is-soon': !p.published }]}></span>)}
  </span>
  <span class="series-card-foot">
    <T en={`${publishedCount} of ${parts.length} published · Open the series →`} vi={`Đã đăng ${publishedCount}/${parts.length} bài · Xem cả series →`} />
  </span>
</a>

<style>
  .series-card { display: grid; gap: 8px; max-width: 760px; box-sizing: border-box; margin: 0 0 32px; padding: 24px 28px; border-radius: 12px; background: var(--band-bg); color: var(--band-text); text-decoration: none; border-left: 6px solid var(--band-accent-red); }
  .series-card:hover .series-card-foot { color: var(--band-text); }
  .series-card-kicker { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--band-accent-gold); }
  .series-card-title { font-size: 26px; line-height: 1.2; font-weight: 800; letter-spacing: -0.02em; color: var(--band-text); }
  .series-card-tagline { font-size: 16px; line-height: 1.5; color: var(--band-sub); max-width: 65ch; }
  .series-card-spine { display: flex; gap: 4px; margin-top: 6px; }
  .series-card-cell { width: 28px; height: 8px; border-radius: 2px; }
  .series-card-cell.act-start { background: #8C3021; }
  .series-card-cell.act-structure { background: #85661A; }
  .series-card-cell.act-surface { background: #2F6B5E; }
  .series-card-cell.act-craft { background: #3E4C7A; }
  .series-card-cell.is-soon { background: transparent; outline: 1px dashed var(--band-card-border); outline-offset: -1px; }
  .series-card-foot { font-size: 14px; font-weight: 600; color: var(--band-accent-red); }
</style>
