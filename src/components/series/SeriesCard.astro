---
// Series entry for list pages: the book, how far along the series is, one pill per act,
// the first three parts, and a link in. Renders as a grid item; the parent supplies `.series-shelf`.
import T from '../T.astro';
import BookCover from './BookCover.astro';
import { actIndex } from '../../data/series';
import { ui } from '../../data/content';
import type { SeriesView } from '../../utils/series';

interface Props { view: SeriesView; headingLevel?: 2 | 3 }
const { view, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const { series, parts, publishedCount } = view;
const complete = publishedCount === parts.length;
const pad = (n: number) => String(n).padStart(2, '0');
const acts = series.acts.map((a) => ({
  label: a.label,
  index: actIndex(series, a.id),
  count: parts.filter((p) => p.part.act === a.id).length,
}));
---
<article class="series-card">
  <div class="series-card-book" aria-hidden="true"><BookCover view={view} size="sm" /></div>
  <div class="series-card-body">
    <p class="series-card-kicker">
      <T
        en={`${series.kicker.en} · ${complete ? ui.allPublished.en : `${publishedCount} of ${parts.length} published`}`}
        vi={`${series.kicker.vi} · ${complete ? ui.allPublished.vi : `đã đăng ${publishedCount}/${parts.length}`}`}
      />
    </p>
    <Heading class="series-card-title"><a href={view.url}><T en={series.title.en} vi={series.title.vi} /></a></Heading>
    <p class="series-card-tagline"><T en={series.tagline.en} vi={series.tagline.vi} /></p>
    <ul class="series-card-acts">
      {acts.map((a) => (
        <li class={`series-card-act act-${a.index}`}><T en={`${a.label.en} · ${a.count}`} vi={`${a.label.vi} · ${a.count}`} /></li>
      ))}
    </ul>
    <ol class="series-card-parts">
      {parts.slice(0, 3).map((p) => (
        <li class:list={{ 'is-soon': !p.published }}>
          <span class="series-card-n">{pad(p.n)}</span>
          {p.published
            ? <a href={p.url}><T en={p.title} vi={p.titleVi} /></a>
            : <span><T en={p.title} vi={p.titleVi} /> <em class="series-card-soon"><T en={ui.soon.en} vi={ui.soon.vi} /></em></span>}
        </li>
      ))}
    </ol>
    <a class="series-card-open" href={view.url}><T en={ui.openSeries.en} vi={ui.openSeries.vi} /></a>
  </div>
</article>

<style>
  .series-card { display: flex; gap: 24px; align-items: flex-start; box-sizing: border-box; min-width: 0; padding: 22px 24px 22px 20px; border-radius: 14px; background: var(--bg-alt); border: 1px solid var(--border); transition: border-color 0.15s; }
  .series-card:hover { border-color: color-mix(in srgb, var(--red) 40%, var(--border)); }
  .series-card-book { flex: none; padding: 4px 8px 6px 2px; }
  .series-card-body { display: flex; flex-direction: column; gap: 8px; min-width: 0; flex: 1; }
  .series-card-kicker { margin: 0; font-size: 12px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--red); }
  .series-card-title { margin: 0; font-size: 21px; line-height: 1.25; font-weight: 800; letter-spacing: -0.015em; }
  .series-card-title a { color: var(--text); text-decoration: none; }
  .series-card-title a:hover { color: var(--red); }
  .series-card-tagline { margin: 0; font-size: 15px; line-height: 1.5; color: var(--text-body); }
  .series-card-acts { display: flex; flex-wrap: wrap; gap: 6px; margin: 2px 0 0; padding: 0; list-style: none; }
  .series-card-act { padding: 2px 10px; border-radius: 999px; font-size: 12.5px; font-weight: 700; color: var(--act); border: 1px solid color-mix(in srgb, var(--act) 40%, var(--border)); background: color-mix(in srgb, var(--act) 9%, transparent); }
  .act-0 { --act: var(--act-0); }
  .act-1 { --act: var(--act-1); }
  .act-2 { --act: var(--act-2); }
  .act-3 { --act: var(--act-3); }
  .series-card-parts { margin: 6px 0 0; padding: 0; list-style: none; }
  .series-card-parts li { display: flex; gap: 10px; padding: 7px 0; font-size: 14px; line-height: 1.4; color: var(--text-body); border-top: 1px dashed var(--border); }
  .series-card-parts li:last-child { border-bottom: 1px dashed var(--border); }
  .series-card-parts a { color: var(--text-body); text-decoration: none; }
  .series-card-parts a:hover { color: var(--red); }
  .series-card-n { flex: none; font-weight: 800; font-variant-numeric: tabular-nums; color: var(--text-muted); }
  .series-card-parts li.is-soon { color: var(--text-muted); }
  .series-card-soon { font-size: 11px; font-style: normal; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 1px 7px; border: 1px dashed var(--border); border-radius: 999px; }
  .series-card-open { margin-top: 6px; font-size: 14px; font-weight: 700; color: var(--red); text-decoration: none; }
  .series-card-open:hover { color: var(--red-hover); }
  @media (max-width: 520px) {
    .series-card { flex-direction: column; gap: 14px; padding: 18px; }
    .series-card-title { font-size: 19px; }
  }
</style>
