---
// Previous / next published part at the end of a series post, plus a link back to the cover.
import T from '../T.astro';
import type { getSeriesNav } from '../../utils/series';

interface Props { nav: NonNullable<Awaited<ReturnType<typeof getSeriesNav>>> }
const { nav } = Astro.props;
const { view, prev, next } = nav;
---
<nav class="series-pager" aria-label="Series">
  <a class="series-pager-cover" href={view.url}>
    <T en={`${view.series.kicker.en}: ${view.series.title.en}`} vi={`${view.series.kicker.vi}: ${view.series.title.vi}`} />
  </a>
  {(prev || next) && (
    <div class="series-pager-links">
      {prev && (
        <a class="series-pager-prev" href={prev.url} rel="prev">
          <span class="series-pager-label"><T en={`← Part ${prev.n}`} vi={`← Bài ${prev.n}`} /></span>
          <span class="series-pager-title"><T en={prev.title} vi={prev.titleVi} /></span>
        </a>
      )}
      {next && (
        <a class="series-pager-next" href={next.url} rel="next">
          <span class="series-pager-label"><T en={`Part ${next.n} →`} vi={`Bài ${next.n} →`} /></span>
          <span class="series-pager-title"><T en={next.title} vi={next.titleVi} /></span>
        </a>
      )}
    </div>
  )}
</nav>

<style>
  .series-pager { margin: 40px 0 0; padding-top: 24px; border-top: 1px solid var(--border); }
  .series-pager-cover { display: inline-block; margin-bottom: 14px; font-size: 14px; font-weight: 600; color: var(--text-muted); }
  .series-pager-cover:hover { color: var(--red); }
  .series-pager-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .series-pager-links a { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg-alt); text-decoration: none; }
  .series-pager-links a:hover { border-color: var(--red); }
  .series-pager-next { grid-column: 2; text-align: right; }
  .series-pager-label { font-size: 12px; font-weight: 600; letter-spacing: 0; color: var(--red); }
  .series-pager-title { font-size: 15px; font-weight: 600; line-height: 1.4; color: var(--text); }
  @media (max-width: 600px) {
    .series-pager-links { grid-template-columns: 1fr; }
    .series-pager-next { grid-column: 1; }
  }
</style>
