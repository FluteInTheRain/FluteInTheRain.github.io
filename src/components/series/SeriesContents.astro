---
// Table of contents: every part in series order, with its one-line hook and reading time.
// Headings use the part's topic, the same label as its box in the reading map above.
import T from '../T.astro';
import type { SeriesView } from '../../utils/series';

interface Props { view: SeriesView }
const { view } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<ol class="sct">
  {view.parts.map((p) => (
    <li class:list={['sct-row', { 'is-soon': !p.published }]}>
      <span class="sct-n">{pad(p.n)}</span>
      <div class="sct-body">
        <h3 class="sct-title">
          {p.published
            ? <a href={p.url}><T en={p.part.topic.en} vi={p.part.topic.vi} /></a>
            : <T en={p.part.topic.en} vi={p.part.topic.vi} />}
        </h3>
        <p class="sct-hook"><T en={p.part.hook.en} vi={p.part.hook.vi} /></p>
      </div>
      <span class="sct-meta">
        {p.published
          ? <T en={`${p.mins} min read`} vi={`${p.mins} phút đọc`} />
          : <span class="sct-soon"><T en="Soon" vi="Sắp có" /></span>}
      </span>
    </li>
  ))}
</ol>

<style>
  .sct { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .sct-row { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: 16px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--border); }
  .sct-n { font-size: 24px; font-weight: 800; color: var(--red); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .sct-row.is-soon .sct-n { color: var(--text-faint); }
  .sct-title { margin: 0 0 4px; font-size: 18px; line-height: 1.35; font-weight: 600; color: var(--text); }
  .sct-row.is-soon .sct-title { color: var(--text-muted); font-weight: 400; }
  .sct-hook { margin: 0; font-size: 15px; line-height: 1.55; color: var(--text-body); }
  .sct-meta { font-size: 13px; color: var(--text-muted); white-space: nowrap; }
  .sct-soon { font-size: 11px; font-weight: 600; letter-spacing: 0; padding: 2px 8px; border: 1px dashed var(--border); border-radius: 999px; }
  @media (max-width: 600px) {
    .sct-row { grid-template-columns: 36px minmax(0, 1fr); }
    .sct-n { font-size: 20px; }
    .sct-meta { grid-column: 2; }
  }
</style>
