---
// A technical-book cover: paper face with an act-colour band, title and a tipped-in photo plate,
// wrapped in CSS that adds a hinge, page edges and a shadow. Text sizes use container units so
// the same cover works as a large hero and as a small thumbnail.
// Cover photo: "Anker compass set in case" by Slashme, Wikimedia Commons, CC0. A drafting set
// keeps every instrument in its own slot on a grid, the series' idea of fixed scales over eyeballing.
import { Image } from 'astro:assets';
import T from '../T.astro';
import draftingSet from '../../assets/series/drafting-set.jpg';
import type { SeriesView } from '../../utils/series';

interface Props { view: SeriesView; size?: 'lg' | 'sm' }
const { view, size = 'lg' } = Astro.props;
const { series } = view;
const subtitle = {
  en: 'Hierarchy · Spacing · Type · Colour · Depth',
  vi: 'Phân cấp · Khoảng cách · Chữ · Màu · Chiều sâu',
};
---
<div class:list={['book', `book-${size}`]}>
  <div class="bk-face">
    <span class="bk-band" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <span class="bk-kicker"><T en={series.kicker.en} vi={series.kicker.vi} /></span>
    <span class="bk-title"><T en={series.title.en} vi={series.title.vi} /></span>
    <span class="bk-rule" aria-hidden="true"></span>
    <span class="bk-sub"><T en={subtitle.en} vi={subtitle.vi} /></span>
    <span class="bk-plate">
      <Image
        src={draftingSet}
        alt="A vintage drafting set open on graph paper: compasses, dividers and ruling pens, each resting in its own slot of a blue velvet case."
        widths={size === 'sm' ? [120, 240] : [360, 720]}
        sizes={size === 'sm' ? '92px' : '(max-width: 900px) 78vw, 320px'}
        loading={size === 'sm' ? 'lazy' : 'eager'}
      />
    </span>
    <span class="bk-foot">
      <span class="bk-author">Khang Nguyen</span>
      <span class="bk-imprint">UI / UX</span>
    </span>
  </div>
  <span class="bk-pages" aria-hidden="true"></span>
</div>

<style>
  .book { position: relative; container-type: inline-size; transform: perspective(1400px) rotateY(-16deg) rotateX(2deg); transform-origin: left center; filter: drop-shadow(18px 22px 22px rgba(30, 25, 20, 0.28)); transition: transform 0.3s ease; }
  .book:hover { transform: perspective(1400px) rotateY(-8deg) rotateX(1deg); }
  .book-lg { width: min(320px, 78vw); }
  .book-sm { width: 92px; filter: drop-shadow(6px 8px 8px rgba(30, 25, 20, 0.3)); }
  :global([data-theme='dark']) .book { filter: drop-shadow(18px 22px 24px rgba(0, 0, 0, 0.6)); }

  .bk-face {
    position: relative; z-index: 1; aspect-ratio: 3 / 4; box-sizing: border-box; overflow: hidden;
    display: flex; flex-direction: column; padding: 13cqw 9cqw 6cqw 12cqw;
    background: #F4EEE3; color: #262421; border-radius: 0.6cqw 2cqw 2cqw 0.6cqw;
  }
  /* hinge: the crease where the cover bends at the spine */
  .bk-face::after { content: ''; position: absolute; inset: 0 auto 0 0; width: 5cqw; background: linear-gradient(90deg, rgba(0,0,0,0.22), rgba(0,0,0,0.04) 55%, rgba(255,255,255,0.25)); pointer-events: none; }
  .bk-band { position: absolute; inset: 0 0 auto 0; height: 3.4cqw; display: flex; }
  .bk-band i { flex: 1; }
  .bk-band i:nth-child(1) { background: #8C3021; }
  .bk-band i:nth-child(2) { background: #85661A; }
  .bk-band i:nth-child(3) { background: #2F6B5E; }
  .bk-band i:nth-child(4) { background: #3E4C7A; }

  .bk-kicker { font-size: 3.5cqw; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #B3402F; }
  .bk-title { margin-top: 3cqw; font-size: 8.4cqw; line-height: 1.12; font-weight: 800; letter-spacing: -0.02em; }
  .bk-rule { width: 26cqw; height: 1cqw; margin-top: 4cqw; background: #B3402F; }
  .bk-sub { margin-top: 3cqw; font-size: 3.2cqw; font-weight: 600; color: #6B665F; }
  .bk-plate { margin-top: 5cqw; flex: 1; min-height: 0; padding: 1.4cqw; background: #FBF8F2; border: 0.4cqw solid rgba(38, 36, 33, 0.18); box-shadow: 0 0.6cqw 1.6cqw rgba(30, 25, 20, 0.12); }
  .bk-plate :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 55% 60%; filter: saturate(0.85) contrast(1.04); }
  .bk-foot { display: flex; justify-content: space-between; align-items: baseline; margin-top: 4.5cqw; padding-top: 3cqw; border-top: 0.3cqw solid rgba(38, 36, 33, 0.2); }
  .bk-author { font-size: 4cqw; font-weight: 800; letter-spacing: 0.02em; }
  .bk-imprint { font-size: 3.3cqw; font-weight: 700; letter-spacing: 0.1em; color: #B3402F; }

  .bk-pages {
    position: absolute; top: 1.2%; bottom: 1.2%; right: -3.5%; width: 4.5%; border-radius: 0 3px 3px 0;
    background: repeating-linear-gradient(90deg, #FFFDF8 0 1.5px, #E2DACB 1.5px 2.5px);
  }
</style>
