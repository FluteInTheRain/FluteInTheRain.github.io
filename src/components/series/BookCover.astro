---
// A technical-book cover: a full-bleed real photo under a series-coloured fade, a large title with
// the topic word in the series colour, a hairline, a one-line subtitle and the author bottom-right.
// CSS adds the hinge, page edges and shadow. Text sizes use container units so the same cover
// works as a large hero and as a small thumbnail (the thumbnail drops subtitle and author).
// Cover text is English only (decision 2026-11-24); title, tagline, hue, photo and credit come from
// each series' `cover` (src/data/series.ts). Colours are the cover's own, identical in both themes.
import { Image } from 'astro:assets';
import type { SeriesView } from '../../utils/series';

interface Props { view: SeriesView; size?: 'lg' | 'sm' }
const { view, size = 'lg' } = Astro.props;
const { cover } = view.series;
const { title } = cover;
---
<div class:list={['book', `book-${size}`]} style={`--h: ${cover.hue}`}>
  <div class="bk-face">
    <Image
      class="bk-photo"
      src={cover.image}
      alt={cover.alt}
      style={`object-position: ${cover.position}`}
      widths={size === 'sm' ? [120, 240] : [360, 720, 1080]}
      sizes={size === 'sm' ? '92px' : '(max-width: 900px) 78vw, 320px'}
      loading={size === 'sm' ? 'lazy' : 'eager'}
    />
    <span class="bk-text">
      <span class="bk-title">{title.lead}<em>{title.accent}</em>{title.rest}</span>
      <span class="bk-sub">{cover.tagline}</span>
    </span>
    <span class="bk-author">Khang Nguyen</span>
  </div>
  <span class="bk-pages" aria-hidden="true"></span>
</div>

<style>
  .book { position: relative; container-type: inline-size; transform: perspective(1400px) rotateY(-16deg) rotateX(2deg); transform-origin: left center; filter: drop-shadow(18px 22px 22px rgba(30, 25, 20, 0.28)); transition: transform 0.3s ease; }
  .book:hover { transform: perspective(1400px) rotateY(-8deg) rotateX(1deg); }
  .book-lg { width: min(320px, 78vw); }
  .book-sm { width: 92px; filter: drop-shadow(6px 8px 8px rgba(30, 25, 20, 0.3)); }
  :global([data-theme='dark']) .book { filter: drop-shadow(18px 22px 24px rgba(0, 0, 0, 0.6)); }

  .bk-face {
    position: relative; z-index: 1; aspect-ratio: 3 / 4; box-sizing: border-box; overflow: hidden; isolation: isolate;
    background: oklch(0.14 0.04 var(--h)); color: #fff; border-radius: 0.6cqw 2cqw 2cqw 0.6cqw;
  }
  /* series-coloured fade: dark at the top for the title, a lighter scrim at the foot for the author */
  .bk-face::before {
    content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background:
      linear-gradient(180deg, oklch(0.13 0.05 var(--h) / 0.95) 0%, oklch(0.17 0.06 var(--h) / 0.74) 38%, transparent 66%),
      linear-gradient(0deg, oklch(0.1 0.03 var(--h) / 0.72) 0%, transparent 20%);
  }
  /* hinge: the crease where the cover bends at the spine */
  .bk-face::after { content: ''; position: absolute; inset: 0 auto 0 0; width: 5cqw; z-index: 9; background: linear-gradient(90deg, rgba(0,0,0,0.3), rgba(0,0,0,0.04) 60%, rgba(255,255,255,0.14)); pointer-events: none; }
  .bk-face :global(.bk-photo) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }

  .bk-text { position: absolute; z-index: 4; left: 10cqw; right: 7cqw; top: 9cqw; display: flex; flex-direction: column; gap: 3.4cqw; }
  .bk-title { font-size: 11.4cqw; line-height: 1.08; font-weight: 600; letter-spacing: -0.02em; text-wrap: balance; }
  .bk-title em { font-style: normal; color: oklch(0.86 0.12 var(--h)); }
  /* hairline between title and subtitle */
  .bk-text::after { content: ''; order: 1; height: 0.35cqw; background: oklch(0.86 0.12 var(--h) / 0.55); }
  .bk-sub { order: 2; font-size: 3.7cqw; line-height: 1.38; font-weight: 400; color: rgba(255, 255, 255, 0.88); }
  /* the author line matches the subtitle's font, size, weight and colour */
  .bk-author { position: absolute; z-index: 4; right: 7cqw; bottom: 6cqw; font-size: 3.7cqw; line-height: 1.38; font-weight: 400; color: rgba(255, 255, 255, 0.88); text-shadow: 0 0.3cqw 1.4cqw rgba(0, 0, 0, 0.5); }

  /* thumbnail: title only, a touch larger */
  @container (max-width: 140px) {
    .bk-sub, .bk-text::after, .bk-author { display: none; }
    .bk-title { font-size: 13cqw; }
  }

  .bk-pages {
    position: absolute; top: 1.2%; bottom: 1.2%; right: -3.5%; width: 4.5%; border-radius: 0 3px 3px 0;
    background: repeating-linear-gradient(90deg, #FFFDF8 0 1.5px, #E2DACB 1.5px 2.5px);
  }
</style>
