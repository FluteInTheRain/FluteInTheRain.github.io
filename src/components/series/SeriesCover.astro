---
// Series cover: a 3D technical book (cover, spine, page edges) with an engraving-style
// illustration of a UI specimen, next to a shelf of one spine per part.
// The book keeps its own paper and ink colours in both themes, like a physical object.
import T from '../T.astro';
import BookCover from './BookCover.astro';
import type { SeriesView } from '../../utils/series';
import { actIndex } from '../../data/series';

interface Props { view: SeriesView }
const { view } = Astro.props;
const { series, parts, publishedCount, first } = view;
const total = parts.length;
const pad = (n: number) => String(n).padStart(2, '0');
// small, stable height differences so the shelf does not look like a bar chart
const heights = [100, 92, 96, 88, 100, 94, 90, 97, 93];
---
<section class="scv">
  <div class="container scv-grid">
    <div class="scv-book-wrap">
      <BookCover view={view} />
    </div>

    <div class="scv-text">
      <p class="scv-kicker"><T en={series.kicker.en} vi={series.kicker.vi} /></p>
      <h1 class="scv-title"><T en={series.title.en} vi={series.title.vi} /></h1>
      <p class="scv-tagline"><T en={series.tagline.en} vi={series.tagline.vi} /></p>
      {series.pitch.map((p) => <p class="scv-pitch"><T en={p.en} vi={p.vi} /></p>)}
      <div class="scv-cta">
        {first && (
          <a class="btn btn-primary" href={first.url}>
            <T en={`Start with Part ${first.n} →`} vi={`Bắt đầu từ Bài ${first.n} →`} />
          </a>
        )}
        <span class="scv-count">
          <T en={`${publishedCount} of ${total} published`} vi={`Đã đăng ${publishedCount}/${total} bài`} />
        </span>
      </div>

      <div class:list={['scv-shelf', { 'scv-shelf-long': total > 14 }]} aria-label="Parts">
        <ol class="scv-spines">
          {parts.map((p, i) => {
            const inner = (
              <>
                <span class="scv-sn">{pad(p.n)}</span>
                <span class="scv-st"><T en={p.part.topic.en} vi={p.part.topic.vi} /></span>
              </>
            );
            return (
              <li class:list={['scv-spine', `act-${actIndex(series, p.part.act)}`, { 'is-soon': !p.published }]} style={`--h:${heights[i % heights.length]}%`}>
                {p.published
                  ? <a href={p.url} title={p.title}>{inner}</a>
                  : <span title="Coming soon">{inner}</span>}
              </li>
            );
          })}
        </ol>
        <div class="scv-board" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<section class="scv-out">
  <div class="container">
    <h2 class="scv-h2"><T en="After the series you can" vi="Đọc xong series, bạn có thể" /></h2>
    <ul class="scv-outcomes">
      {series.outcomes.map((o, i) => (
        <li><span class="scv-check" aria-hidden="true">{i + 1}</span><T en={o.en} vi={o.vi} /></li>
      ))}
    </ul>
    <p class="scv-credit"><T en={series.credit.en} vi={series.credit.vi} /></p>
    <p class="scv-credit scv-photo-credit">
      <T en="Cover photo:" vi="Ảnh bìa:" /> <a href={series.cover.credit.url} rel="noopener">{series.cover.credit.title}</a>, {series.cover.credit.author}, {series.cover.credit.origin ?? 'Wikimedia Commons'} ({series.cover.credit.license}).
    </p>
  </div>
</section>

<style>
  .scv { padding: 24px 0 40px; }
  .scv-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 64px; align-items: center; }
  .scv-book-wrap { display: flex; justify-content: center; }

  .scv-kicker { margin: 0 0 12px; font-size: 13px; font-weight: 600; letter-spacing: 0; color: var(--red); }
  .scv-title { margin: 0 0 14px; font-size: 44px; line-height: 1.1; letter-spacing: -0.025em; font-weight: 600; color: var(--text); }
  .scv-tagline { margin: 0 0 18px; font-size: 20px; line-height: 1.45; color: var(--text); font-weight: 600; }
  .scv-pitch { margin: 0 0 10px; font-size: 16px; line-height: 1.65; color: var(--text-body); max-width: 60ch; }
  .scv-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 24px; }
  .scv-count { font-size: 14px; color: var(--text-muted); }

  /* bookshelf: one standing spine per part */
  .scv-shelf { margin-top: 36px; max-width: 520px; }
  .scv-spines { list-style: none; margin: 0; padding: 0 6px; display: flex; align-items: flex-end; gap: 4px; height: 190px; }
  .scv-spine { flex: 1 1 0; height: var(--h); min-width: 0; }
  /* many-part series (ai-trading, 22 spines) cannot shrink below the vertical titles'
     min-content on a phone: let the shelf scroll horizontally instead of widening
     the whole page. Scoped via .scv-shelf-long (total > 14) so every existing
     series' shelf renders exactly as before this class existed — note ddia has
     14 spines and still gets the pre-branch squish-and-shrink behaviour. */
  @media (max-width: 560px) {
    .scv-shelf-long { overflow-x: auto; }
    .scv-shelf-long .scv-spines { min-width: 480px; gap: 3px; }
    /* the <=900px single column is 1fr (min track size auto): without this the
       min-width:480px spine list would widen the whole grid column instead of
       scrolling inside the shelf */
    .scv-grid:has(.scv-shelf-long) { grid-template-columns: minmax(0, 1fr); }
  }
  .scv-spine > a, .scv-spine > span {
    display: flex; flex-direction: column; align-items: center; gap: 8px; height: 100%; padding: 10px 0 12px;
    border-radius: 3px 3px 1px 1px; color: #fff; text-decoration: none; box-sizing: border-box;
    background-image: linear-gradient(90deg, rgba(0,0,0,0.22), rgba(255,255,255,0.08) 22%, rgba(0,0,0,0) 45%, rgba(0,0,0,0.18));
    box-shadow: inset 0 6px 0 rgba(255,255,255,0.12), inset 0 -10px 0 rgba(0,0,0,0.18);
    transition: transform 0.15s ease;
  }
  .scv-spine > a:hover, .scv-spine > a:focus-visible { transform: translateY(-8px); }
  .scv-spine.act-0 > * { background-color: #8C3021; }
  .scv-spine.act-1 > * { background-color: #85661A; }
  .scv-spine.act-2 > * { background-color: #2F6B5E; }
  .scv-spine.act-3 > * { background-color: #3E4C7A; }
  .scv-spine.is-soon > span { background: var(--bg-alt); color: var(--text-muted); border: 1px dashed var(--border); box-shadow: none; }
  .scv-sn { font-size: 11px; font-weight: 800; letter-spacing: 0.04em; font-variant-numeric: tabular-nums; opacity: 0.85; }
  .scv-st { writing-mode: vertical-rl; transform: rotate(180deg); font-size: 13px; font-weight: 700; letter-spacing: 0.02em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-height: 100%; }
  .scv-board { height: 10px; border-radius: 2px; background: linear-gradient(#8A6A4A, #6B5038); box-shadow: 0 6px 12px -6px rgba(30, 25, 20, 0.45); }

  .scv-out { padding: 32px 0 8px; }
  .scv-h2 { margin: 0 0 20px; font-size: 24px; font-weight: 600; color: var(--text); }
  .scv-outcomes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
  .scv-outcomes li { display: flex; gap: 12px; align-items: flex-start; padding: 16px; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 10px; color: var(--text-body); font-size: 16px; line-height: 1.5; }
  .scv-check { flex: none; width: 26px; height: 26px; border-radius: 999px; display: grid; place-items: center; font-size: 13px; font-weight: 700; background: var(--red-tint-bg); color: var(--red); }
  .scv-credit { margin: 20px 0 0; font-size: 14px; color: var(--text-muted); max-width: 70ch; }
  .scv-photo-credit { margin-top: 6px; font-size: 13px; }

  @media (max-width: 900px) {
    .scv-grid { grid-template-columns: 1fr; gap: 40px; }
    .scv-title { font-size: 34px; }
    .scv-tagline { font-size: 18px; }
    .scv-shelf { max-width: none; }
  }
</style>
