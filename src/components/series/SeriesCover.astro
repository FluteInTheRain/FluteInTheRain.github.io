---
// Series "book cover": a dark band like a technical book jacket, with the parts drawn as a
// stack of spines on the right. Published parts are solid and link to the post.
import T from '../T.astro';
import type { SeriesView } from '../../utils/series';

interface Props { view: SeriesView }
const { view } = Astro.props;
const { series, parts, publishedCount, first } = view;
const total = parts.length;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="scv">
  <div class="container scv-grid">
    <div class="scv-text">
      <p class="scv-kicker"><T en={series.kicker.en} vi={series.kicker.vi} /></p>
      <h1 class="scv-title"><T en={series.title.en} vi={series.title.vi} /></h1>
      <p class="scv-tagline"><T en={series.tagline.en} vi={series.tagline.vi} /></p>
      {series.pitch.map((p) => <p class="scv-pitch"><T en={p.en} vi={p.vi} /></p>)}
      <div class="scv-cta">
        {first && (
          <a class="btn btn-primary" href={first.url}>
            <T en={`Start with Part ${first.n} →`} vi={`Bắt đầu từ Bài ${first.n} →`} />
          </a>
        )}
        <span class="scv-count">
          <T en={`${publishedCount} of ${total} published`} vi={`Đã đăng ${publishedCount}/${total} bài`} />
        </span>
      </div>
    </div>

    <ol class="scv-spines" aria-label="Parts">
      {parts.map((p) => (
        <li class:list={['scv-spine', `act-${p.part.act}`, { 'is-soon': !p.published }]}>
          {p.published
            ? <a href={p.url}><span class="scv-n">{pad(p.n)}</span><span class="scv-topic"><T en={p.part.topic.en} vi={p.part.topic.vi} /></span></a>
            : <span><span class="scv-n">{pad(p.n)}</span><span class="scv-topic"><T en={p.part.topic.en} vi={p.part.topic.vi} /></span><span class="scv-soon"><T en="soon" vi="sắp có" /></span></span>}
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="scv-out">
  <div class="container">
    <h2 class="scv-h2"><T en="After the series you can" vi="Đọc xong series, bạn có thể" /></h2>
    <ul class="scv-outcomes">
      {series.outcomes.map((o, i) => (
        <li><span class="scv-check" aria-hidden="true">{i + 1}</span><T en={o.en} vi={o.vi} /></li>
      ))}
    </ul>
    <p class="scv-credit"><T en={series.credit.en} vi={series.credit.vi} /></p>
  </div>
</section>

<style>
  .scv { background: var(--band-bg); color: var(--band-text); padding: 72px 0 64px; border-bottom: 6px solid var(--band-accent-red); }
  .scv-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .scv-kicker { margin: 0 0 14px; font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--band-accent-gold); }
  .scv-title { margin: 0 0 16px; font-size: 48px; line-height: 1.1; letter-spacing: -0.025em; font-weight: 800; color: var(--band-text); }
  .scv-tagline { margin: 0 0 20px; font-size: 20px; line-height: 1.45; color: var(--band-accent-red); font-weight: 600; }
  .scv-pitch { margin: 0 0 12px; font-size: 16px; line-height: 1.65; color: var(--band-sub); max-width: 60ch; }
  .scv-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 28px; }
  .scv-count { font-size: 14px; color: var(--band-faint); }

  .scv-spines { list-style: none; margin: 0; padding: 18px; display: flex; flex-direction: column; gap: 6px; background: var(--band-card-bg); border: 1px solid var(--band-card-border); border-radius: 6px 14px 14px 6px; box-shadow: inset 10px 0 0 rgba(0, 0, 0, 0.25); }
  .scv-spine > a, .scv-spine > span { display: flex; align-items: center; gap: 12px; padding: 8px 12px; border-radius: 4px; text-decoration: none; color: #fff; border-left: 6px solid rgba(0, 0, 0, 0.25); }
  .scv-spine.act-start > a { background: #8C3021; }
  .scv-spine.act-structure > a { background: #85661A; }
  .scv-spine.act-surface > a { background: #2F6B5E; }
  .scv-spine.act-craft > a { background: #3E4C7A; }
  .scv-spine > a:hover { filter: brightness(1.15); }
  .scv-spine.is-soon > span { background: transparent; border: 1px dashed var(--band-card-border); border-left-width: 6px; color: var(--band-faint); }
  .scv-n { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; opacity: 0.8; font-variant-numeric: tabular-nums; }
  .scv-topic { font-size: 15px; font-weight: 700; }
  .scv-soon { margin-left: auto; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; }

  .scv-out { padding: 56px 0 8px; }
  .scv-h2 { margin: 0 0 20px; font-size: 24px; font-weight: 700; color: var(--text); }
  .scv-outcomes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
  .scv-outcomes li { display: flex; gap: 12px; align-items: flex-start; padding: 16px; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 10px; color: var(--text-body); font-size: 16px; line-height: 1.5; }
  .scv-check { flex: none; width: 26px; height: 26px; border-radius: 999px; display: grid; place-items: center; font-size: 13px; font-weight: 700; background: var(--red-tint-bg); color: var(--red); }
  .scv-credit { margin: 20px 0 0; font-size: 14px; color: var(--text-muted); max-width: 70ch; }

  @media (max-width: 860px) {
    .scv { padding: 48px 0 40px; }
    .scv-grid { grid-template-columns: 1fr; gap: 32px; }
    .scv-title { font-size: 36px; }
    .scv-tagline { font-size: 18px; }
  }
</style>
