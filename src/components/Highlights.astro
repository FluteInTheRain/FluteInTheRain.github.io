---
import content from '../data/content';
import Icon from './Icon.astro';
const tints = ['tint-red', 'tint-gold'];
---
<section class="container highlights-wrap">
  <div class="highlights-grid">
    {content.highlights.map((h, i) => (
      <div class={`card highlight ${tints[i % tints.length]}`}>
        <div class={`highlight-icon ${tints[i % tints.length]}`}><Icon name={h.icon} size={22} /></div>
        <h3>{h.title}</h3>
        <p>{h.desc}</p>
        <a class="highlight-link" href={h.cta.href}>{h.cta.label} &rarr;</a>
      </div>
    ))}
  </div>
</section>
