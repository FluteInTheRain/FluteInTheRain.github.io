---
import content from '../data/content';
const e = content.experience;
---
<section class="section" id="experience">
  <div class="container">
    <p class="eyebrow">{e.eyebrow}</p>
    <h2 class="section-title">{e.heading}</h2>
    <p class="section-sub">{e.subheading}</p>
    <div>
      {e.items.map((it: any, i: number) => (
        <div class="timeline-row">
          <div class="timeline-gutter">
            <div class="timeline-dot"></div>
            {i < e.items.length - 1 && <div class="timeline-line"></div>}
          </div>
          <div class="card t-card">
            <div class="t-head"><span class="t-date">{it.dateRange}</span></div>
            <h3 class="t-role">{it.role}</h3>
            <p class="t-org">{it.org}</p>
            {it.bullets && it.bullets.length ? (
              <ul class="t-bullets">{it.bullets.map((b: string) => <li>{b}</li>)}</ul>
            ) : (
              <p class="t-desc">{it.desc}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
