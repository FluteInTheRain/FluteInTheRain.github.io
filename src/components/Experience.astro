---
import content, { contentVi } from '../data/content';
import T from './T.astro';
const e = content.experience;
const eVi = contentVi.experience;
---
<section class="section" id="experience">
  <div class="container">
    <p class="eyebrow"><T en={e.eyebrow} vi={eVi.eyebrow} /></p>
    <h2 class="section-title"><T en={e.heading} vi={eVi.heading} /></h2>
    <p class="section-sub"><T en={e.subheading} vi={eVi.subheading} /></p>
    <div>
      {e.items.map((it: any, i: number) => {
        const itVi: any = eVi.items[i] ?? {};
        return (
          <div class="timeline-row">
            <div class="timeline-gutter">
              <div class="timeline-dot"></div>
              {i < e.items.length - 1 && <div class="timeline-line"></div>}
            </div>
            <div class="card t-card">
              <div class="t-head"><span class="t-date"><T en={it.dateRange} vi={itVi.dateRange} /></span></div>
              <h3 class="t-role"><T en={it.role} vi={itVi.role} /></h3>
              <p class="t-org"><T en={it.org} vi={itVi.org} /></p>
              {it.bullets && it.bullets.length ? (
                <ul class="t-bullets">
                  {it.bullets.map((b: string, bi: number) => (
                    <li><T en={b} vi={itVi.bullets?.[bi]} /></li>
                  ))}
                </ul>
              ) : (
                <p class="t-desc"><T en={it.desc} vi={itVi.desc} /></p>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
