---
import { formatDate, readingTime, categoryUrl } from '../utils/blog';
import { CATEGORY_LABELS } from '../data/categories';
interface Props { post: any }
const { post } = Astro.props;
const { title, description, date, tags, category } = post.data;
---
<article class="card post-card">
  <p class="post-category"><a href={categoryUrl(category)}>{CATEGORY_LABELS[category as keyof typeof CATEGORY_LABELS]}</a></p>
  <p class="post-meta">
    <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingTime(post.body)} min read
  </p>
  <h3 class="post-card-title"><a href={`/blog/${post.id}/`}>{title}</a></h3>
  <p class="post-card-desc">{description}</p>
  {tags.length > 0 && <div class="project-tags">{tags.map((t: string) => <span class="tag">{t}</span>)}</div>}
</article>
