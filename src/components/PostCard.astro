---
// One post as a card: cover on top, then category, title, description, and date pinned to the bottom.
// Used on /blog/, category pages and the home page. The whole card is clickable through the title link.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, formatDateVi, readingTime } from '../utils/blog';
import { CATEGORY_LABELS, CATEGORY_LABELS_VI, type CategoryId } from '../data/categories';
import { ui } from '../data/content';
import T from './T.astro';
interface Props { post: CollectionEntry<'blog'>; headingLevel?: 2 | 3 }
const { post, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const { title, title_vi, description, description_vi, date, category, cover, cover_alt } = post.data;
const cat = category as CategoryId;
const mins = readingTime(post.body);
---
<article class="post-card">
  <div class:list={['post-card-media', { 'is-empty': !cover }]}>
    {cover
      ? <Image src={cover} alt={cover_alt ?? ''} widths={[400, 720]} sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw" loading="lazy" />
      : <span class="post-card-media-label"><T en={CATEGORY_LABELS[cat]} vi={CATEGORY_LABELS_VI[cat]} /></span>}
  </div>
  <div class="post-card-body">
    <p class="post-card-kicker"><T en={CATEGORY_LABELS[cat]} vi={CATEGORY_LABELS_VI[cat]} /></p>
    <Heading class="post-card-title">
      <a href={`/blog/${post.id}/`}><T en={title} vi={title_vi} /></a>
    </Heading>
    <p class="post-card-desc"><T en={description} vi={description_vi} /></p>
    <p class="post-card-meta">
      <time datetime={date.toISOString()}><T en={formatDate(date)} vi={formatDateVi(date)} /></time> · {mins}{' '}
      <T en={ui.minRead.en} vi={ui.minRead.vi} />
    </p>
  </div>
</article>
