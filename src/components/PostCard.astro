---
import { formatDate, formatDateVi, readingTime, categoryUrl } from '../utils/blog';
import { CATEGORY_LABELS, CATEGORY_LABELS_VI, type CategoryId } from '../data/categories';
import { ui } from '../data/content';
import T from './T.astro';
interface Props { post: any; featured?: boolean; headingLevel?: 2 | 3 }
const { post, featured = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}`;
const { title, title_vi, description, description_vi, date, tags, category } = post.data;
const cat = category as CategoryId;
const mins = readingTime(post.body);
---
<article class={featured ? 'card post-card post-card--featured' : 'card post-card'}>
  <p class="post-category">
    <a href={categoryUrl(cat)}><T en={CATEGORY_LABELS[cat]} vi={CATEGORY_LABELS_VI[cat]} /></a>
  </p>
  <p class="post-meta">
    <time datetime={date.toISOString()}><T en={formatDate(date)} vi={formatDateVi(date)} /></time> · {mins}{' '}
    <T en={ui.minRead.en} vi={ui.minRead.vi} />
  </p>
  <Heading class="post-card-title">
    <a href={`/blog/${post.id}/`}><T en={title} vi={title_vi} /></a>
  </Heading>
  <p class="post-card-desc"><T en={description} vi={description_vi} /></p>
  {tags.length > 0 && <div class="project-tags">{tags.map((t: string) => <span class="tag">{t}</span>)}</div>}
</article>
