---
import { rootHref } from '../utils/href';
import content, { contentVi } from '../data/content';
import T from './T.astro';
const f = content.footer as any;
const fVi = contentVi.footer as any;
---
<footer class="footer" id="contact">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h2 class="footer-heading"><T en={f.heading} vi={fVi.heading} /></h2>
        <a class="footer-email" href={`mailto:${f.email}`}>{f.email}</a>
      </div>
      <div>
        <p class="footer-col-title"><T en={f.elsewhereLabel || 'Elsewhere'} vi={fVi.elsewhereLabel} /></p>
        <div class="footer-link-list">
          {f.elsewhere.map((l: any, i: number) => (
            <a class="footer-link" href={l.href} target="_blank" rel="noopener">
              <T en={l.label} vi={fVi.elsewhere?.[i]?.label} />
            </a>
          ))}
        </div>
      </div>
      <div>
        <p class="footer-col-title"><T en={f.quickLinksLabel || 'Quick Links'} vi={fVi.quickLinksLabel} /></p>
        <div class="footer-link-list">
          {f.quickLinks.map((l: any, i: number) => (
            <a class="footer-link" href={rootHref(l.href)}>
              <T en={l.label} vi={fVi.quickLinks?.[i]?.label} />
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{f.copyright}</span>
      <span><T en={f.location} vi={fVi.location} /></span>
    </div>
  </div>
</footer>
