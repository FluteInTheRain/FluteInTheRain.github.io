---
import content from '../data/content';
const f = content.footer as any;
---
<footer class="footer" id="contact">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h2 class="footer-heading">{f.heading}</h2>
        <a class="footer-email" href={`mailto:${f.email}`}>{f.email}</a>
      </div>
      <div>
        <p class="footer-col-title">{f.elsewhereLabel || 'Elsewhere'}</p>
        <div class="footer-link-list">
          {f.elsewhere.map((l: any) => <a class="footer-link" href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
        </div>
      </div>
      <div>
        <p class="footer-col-title">{f.quickLinksLabel || 'Quick Links'}</p>
        <div class="footer-link-list">
          {f.quickLinks.map((l: any) => <a class="footer-link" href={l.href}>{l.label}</a>)}
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{f.copyright}</span>
      <span>{f.location}</span>
    </div>
  </div>
</footer>
