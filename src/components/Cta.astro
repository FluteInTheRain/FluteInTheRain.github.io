---
import content, { contentVi } from '../data/content';
import T from './T.astro';
const c = content.cta;
const cVi = contentVi.cta;
---
<section class="cta-band">
  <div class="container">
    <h2><T en={c.heading} vi={cVi.heading} /></h2>
    <p><T en={c.subtext} vi={cVi.subtext} /></p>
    <a class="btn btn-primary" href={`mailto:${content.person.email}`}>
      <T en={c.button.label} vi={cVi.button.label} />
    </a>
  </div>
</section>
