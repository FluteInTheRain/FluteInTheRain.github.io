---
// Vietnamese puts a space between syllables, not between words. PhoBERT (Nguyen & Nguyen, 2020) expects
// word-segmented input (VinAI README: "a word segmenter must be applied ... before feeding to PhoBERT").
// The grouping below is an example of the convention (underscore joins syllables), not the output of one tool.
const W = 900;
const H = 330;
const syl = ['Cổ', 'phiếu', 'ngân', 'hàng', 'tăng', 'mạnh'];
const sx = (i: number) => 60 + i * 130;
const words = [
  { from: 0, to: 1, t: 'Cổ_phiếu', en: 'stock', vi: 'cổ phiếu' },
  { from: 2, to: 3, t: 'ngân_hàng', en: 'bank', vi: 'ngân hàng' },
  { from: 4, to: 4, t: 'tăng', en: 'rise', vi: 'tăng' },
  { from: 5, to: 5, t: 'mạnh', en: 'strongly', vi: 'mạnh' },
];
---
<figure class="p17i">
  <div class="p17i-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The Vietnamese sentence Cổ phiếu ngân hàng tăng mạnh, banking stocks rise sharply. Split on spaces it gives six pieces, but they are syllables: cổ and phiếu together mean stock, ngân and hàng together mean bank. Grouped into words with underscores it gives four units: Cổ_phiếu, ngân_hàng, tăng, mạnh. Models such as PhoBERT expect the second form.">
    <text x="20" y="28" class="p17i-h">
      <tspan data-lang-en>In Vietnamese a space does not mark a word</tspan>
      <tspan data-lang-vi>Trong tiếng Việt, dấu cách không đánh dấu ranh giới từ</tspan>
    </text>

    <text x="20" y="66" class="p17i-t">
      <tspan data-lang-en>Split on spaces: six syllables</tspan>
      <tspan data-lang-vi>Tách theo dấu cách: sáu âm tiết</tspan>
    </text>
    {syl.map((s, i) => (
      <g>
        <rect x={sx(i)} y="80" width="110" height="40" rx="6" class="p17i-syl" />
        <text x={sx(i) + 55} y="106" text-anchor="middle" class="p17i-w">{s}</text>
      </g>
    ))}

    <polygon points="440,138 440,150 432,150 450,164 468,150 460,150 460,138" class="p17i-arrow" />

    <text x="20" y="196" class="p17i-t">
      <tspan data-lang-en>Grouped into words: four units (what PhoBERT expects)</tspan>
      <tspan data-lang-vi>Gom thành từ: bốn đơn vị (dạng PhoBERT cần)</tspan>
    </text>
    {words.map((w) => {
      const x = sx(w.from);
      const width = sx(w.to) + 110 - x;
      return (
        <g>
          <rect x={x} y="210" width={width} height="40" rx="6" class="p17i-word" />
          <text x={x + width / 2} y="236" text-anchor="middle" class="p17i-w">{w.t}</text>
          <text x={x + width / 2} y="272" text-anchor="middle" class="p17i-s">
            <tspan data-lang-en>{w.en}</tspan>
            <tspan data-lang-vi>{w.vi}</tspan>
          </text>
        </g>
      );
    })}
    <text x="20" y="312" class="p17i-note">
      <tspan data-lang-en>The grouping shown is an example of the underscore convention; different segmenters can disagree on some words.</tspan>
      <tspan data-lang-vi>Cách gom ở đây theo quy ước dấu gạch dưới; các công cụ tách từ khác nhau có thể không đồng ý ở một số từ.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Skip the segmentation step and a model like PhoBERT reads the wrong units. Source: the VinAI PhoBERT README and Nguyen and Nguyen (2020).</span>
    <span data-lang-vi>Bỏ bước tách từ thì mô hình như PhoBERT đọc sai đơn vị. Nguồn: README của PhoBERT (VinAI) và Nguyen & Nguyen (2020).</span>
  </figcaption>
</figure>

<style>
  .p17i { margin: 2em 0; width: 100%; }
  .p17i-scroll { overflow-x: auto; }
  .p17i svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p17i text { font-size: 14px; fill: var(--text-body); }
  .p17i .p17i-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p17i .p17i-t { font-size: 13.5px; font-weight: 600; fill: var(--text-muted); }
  .p17i .p17i-w { font-size: 16px; font-weight: 600; fill: var(--text); }
  .p17i .p17i-s { font-size: 12.5px; fill: var(--text-muted); }
  .p17i .p17i-note { font-size: 12.5px; fill: var(--text-muted); }
  .p17i-syl { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p17i-word { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.4; }
  .p17i-arrow { fill: var(--text-muted); }
  .p17i figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
