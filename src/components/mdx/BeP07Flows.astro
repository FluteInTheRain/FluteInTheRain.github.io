---
// Three OAuth2 flows: who types the password, what the client ends up with.
// Red = the flow the demo uses and the standard now forbids.
const W = 900, H = 330;
const cards = [
  { x: 20, bad: true, name: { en: 'password grant', vi: 'password grant' },
    tag: { en: 'this post\'s demo', vi: 'demo của bài này' },
    l1: { en: 'the client sees the password', vi: 'client thấy mật khẩu' },
    l2: { en: 'and swaps it for a token', vi: 'rồi đổi nó lấy token' },
    use: { en: 'RFC 9700: MUST NOT be used', vi: 'RFC 9700: MUST NOT be used' } },
  { x: 320, bad: false, name: { en: 'authorization code + PKCE', vi: 'authorization code + PKCE' },
    tag: { en: 'a user, a third-party app', vi: 'người dùng, app bên thứ ba' },
    l1: { en: 'the user logs in at the provider', vi: 'người dùng đăng nhập ở provider' },
    l2: { en: 'the app gets a code, then a token', vi: 'app nhận code, rồi mới đổi ra token' },
    use: { en: 'Sign in with Google, GitHub…', vi: 'Đăng nhập bằng Google, GitHub…' } },
  { x: 620, bad: false, name: { en: 'client credentials', vi: 'client credentials' },
    tag: { en: 'no user at all', vi: 'không có người dùng' },
    l1: { en: 'a service proves who it is', vi: 'một service tự chứng minh mình' },
    l2: { en: 'with its own id and secret', vi: 'bằng id và secret riêng' },
    use: { en: 'service to service', vi: 'service gọi service' } },
];
---
<figure class="bep7f">
  <div class="bep7f-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three OAuth2 flows as cards. Password grant, drawn in red: the client sees the user's password; RFC 9700 says it must not be used. Authorization code with PKCE: the user logs in at the provider and the app gets a code, then a token. Client credentials: a service authenticates with its own id and secret, no user involved.">
    {cards.map((c) => (
      <g>
        <rect x={c.x} y="30" width="260" height="250" rx="12" class={c.bad ? 'badbox' : 'box'} />
        <text x={c.x + 130} y="68" text-anchor="middle" class="nm"><tspan data-lang-en>{c.name.en}</tspan><tspan data-lang-vi>{c.name.vi}</tspan></text>
        <text x={c.x + 130} y="92" text-anchor="middle" class="sub"><tspan data-lang-en>{c.tag.en}</tspan><tspan data-lang-vi>{c.tag.vi}</tspan></text>
        <line x1={c.x + 30} y1="116" x2={c.x + 230} y2="116" class="sep" />
        <text x={c.x + 130} y="150" text-anchor="middle" class="bl"><tspan data-lang-en>{c.l1.en}</tspan><tspan data-lang-vi>{c.l1.vi}</tspan></text>
        <text x={c.x + 130} y="176" text-anchor="middle" class="bl"><tspan data-lang-en>{c.l2.en}</tspan><tspan data-lang-vi>{c.l2.vi}</tspan></text>
        <line x1={c.x + 30} y1="206" x2={c.x + 230} y2="206" class="sep" />
        <text x={c.x + 130} y="240" text-anchor="middle" class={c.bad ? 'use bad-t' : 'use'}><tspan data-lang-en>{c.use.en}</tspan><tspan data-lang-vi>{c.use.vi}</tspan></text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The three flows differ in one thing: who gets to see the password. The demo uses the first because it is the shortest to run, not because it is what you should ship to a third party.</span>
    <span data-lang-vi>Ba flow khác nhau ở đúng một điểm: ai được nhìn thấy mật khẩu. Demo dùng flow đầu vì nó chạy ngắn nhất, không phải vì bạn nên đem nó ra cho bên thứ ba.</span>
  </figcaption>
</figure>

<style>
  .bep7f { margin: 2em 0; width: 100%; }
  .bep7f-scroll { overflow-x: auto; }
  .bep7f svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .bep7f text { font-size: 14px; fill: var(--text-body); }
  .bep7f .nm { font-weight: 700; fill: var(--text); font-size: 15.5px; }
  .bep7f .bl { fill: var(--text-body); font-size: 13.5px; }
  .bep7f .sub { fill: var(--text-muted); font-size: 12.5px; }
  .bep7f .use { font-weight: 700; fill: var(--text); font-size: 14px; }
  .bep7f .bad-t { fill: var(--red); }
  .bep7f .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep7f .badbox { fill: var(--bg-alt); stroke: var(--red); stroke-width: 2; }
  .bep7f .sep { stroke: var(--border); stroke-width: 1; }
  .bep7f figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
