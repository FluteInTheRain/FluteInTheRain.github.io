---
// Where four real changes land. Left: the layered app — each arrow
// touches exactly one box (the service box is the red one, where the new
// rule goes). Right: the fat router — the same four changes, one
// function, every time.
const W = 900, H = 320;
const changes = [
  { y: 76, target: 'web', en: 'a new endpoint', vi: 'một endpoint mới' },
  { y: 100, target: 'web', en: 'a renamed JSON field', vi: 'đổi tên một trường JSON' },
  { y: 160, target: 'service', en: 'a new closing rule', vi: 'một luật đóng case mới' },
  { y: 236, target: 'data', en: 'a real database', vi: 'database thật' },
];
const boxes = [
  { y: 62, h: 52, red: false, en: 'web', vi: 'web' },
  { y: 140, h: 52, red: true, en: 'service', vi: 'service' },
  { y: 218, h: 52, red: false, en: 'data', vi: 'data' },
];
const rightYs = [100, 136, 172, 208];
---
<figure class="bep4e">
  <div class="bep4e-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: three stacked boxes web, service, data; four labelled arrows from the left each touch exactly one box. Right: one tall box labelled the endpoint, with the same four arrows all converging into it.">
    <text x="235" y="28" text-anchor="middle" class="h">
      <tspan data-lang-en>layered: each change lands in one layer</tspan>
      <tspan data-lang-vi>phân tầng: mỗi thay đổi rơi vào đúng một tầng</tspan>
    </text>
    <text x="670" y="28" text-anchor="middle" class="h">
      <tspan data-lang-en>fat router: one function, every time</tspan>
      <tspan data-lang-vi>router béo: một hàm, lần nào cũng vậy</tspan>
    </text>

    {changes.map((c) => (
      <g>
        <text x="24" y={c.y + 4} class="cl">
          <tspan data-lang-en>{c.en}</tspan><tspan data-lang-vi>{c.vi}</tspan>
        </text>
        <line x1="188" y1={c.y} x2="268" y2={c.y} class="ln" />
        <polygon points={`276,${c.y} 266,${c.y - 5} 266,${c.y + 5}`} class="hd" />
      </g>
    ))}

    {boxes.map((b, i) => (
      <g>
        <rect x="276" y={b.y} width="180" height={b.h} rx="10" class={b.red ? 'box red' : 'box'} />
        <text x="366" y={b.y + 31} text-anchor="middle" class="nm">
          <tspan data-lang-en>{b.en}</tspan><tspan data-lang-vi>{b.vi}</tspan>
        </text>
        {i < 2 && (
          <g>
            <line x1="366" y1={b.y + b.h} x2="366" y2={boxes[i + 1].y - 9} class="ln" />
            <polygon points={`366,${boxes[i + 1].y} 361,${boxes[i + 1].y - 9} 371,${boxes[i + 1].y - 9}`} class="hd" />
          </g>
        )}
      </g>
    ))}

    <rect x="680" y="72" width="180" height="164" rx="10" class="box" />
    <image href="/icons/flow/fastapi.svg" x="739" y="128" width="62" height="11.5" aria-hidden="true" />
    <text x="770" y="168" text-anchor="middle" class="nm">
      <tspan data-lang-en>the endpoint</tspan><tspan data-lang-vi>hàm endpoint</tspan>
    </text>

    {rightYs.map((y, i) => (
      <g>
        <text x="648" y={y + 4} text-anchor="end" class="cl">
          <tspan data-lang-en>{changes[i].en}</tspan><tspan data-lang-vi>{changes[i].vi}</tspan>
        </text>
        <line x1="656" y1={y} x2="672" y2={y} class="ln" />
        <polygon points={`680,${y} 670,${y - 5} 670,${y + 5}`} class="hd" />
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Four changes every feature brings. Split by layer, three of the four never meet the others; in the fat router all four edit the same function, so a storage swap can break a rule and a rule can break a response shape.</span>
    <span data-lang-vi>Bốn thay đổi mà tính năng nào cũng kéo theo. Tách tầng rồi, ba trong bốn thay đổi không chạm vào nhau; còn trong router béo, cả bốn sửa chung một hàm — đổi kho dữ liệu có thể làm gãy luật, thêm luật có thể làm gãy dạng JSON trả về.</span>
  </figcaption>
</figure>

<style>
  .bep4e { margin: 2em 0; width: 100%; }
  .bep4e-scroll { overflow-x: auto; }
  .bep4e svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep4e text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep4e .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep4e .nm { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep4e .cl { fill: var(--text-muted); font-size: 12.5px; }
  .bep4e .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep4e .box.red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .bep4e .ln { stroke: var(--text-muted); stroke-width: 1.6; }
  .bep4e .hd { fill: var(--text-muted); }
  .bep4e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
