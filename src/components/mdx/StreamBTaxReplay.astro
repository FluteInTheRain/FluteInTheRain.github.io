---
// Replaying last month's sales: join against the current tax rate (wrong) vs a rate version stored with the sale (right).
// Numbers and dates are illustrative.
import StreamBFigure from './StreamBFigure.astro';
import StreamBNode from './StreamBNode.astro';
import StreamBArrow from './StreamBArrow.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    hl: 'Replay joins the current rate', hr: 'The sale carries its rate version',
    sale: 'Sale, 3 Oct', sl: '$100', sr: '$100, rate v7 = 8%',
    rl: ['tax_rates', 'today: 10%'], rr: ['tax_rates', 'v7 = 8%, v8 = 10%'],
    resl: ['Tax $10', 'wrong: the Oct rate was 8%'], resr: ['Tax $8', 'same result on replay'],
    alt: 'Two panels. Left: replaying a 3 October sale of 100 dollars against the current tax rate of 10 percent gives a tax of 10 dollars, which is wrong because the October rate was 8 percent. Right: the sale event stores rate version v7, which is 8 percent, so every replay gives a tax of 8 dollars.',
    cap: 'Pin the rate to the event, either by a version id or by copying the rate into the sale, and a replay gives the same answer every time.',
  },
  vi: {
    hl: 'Replay join với mức thuế hiện tại', hr: 'Đơn hàng mang theo phiên bản mức thuế',
    sale: 'Đơn hàng, 3/10', sl: '$100', sr: '$100, mức v7 = 8%',
    rl: ['tax_rates', 'hôm nay: 10%'], rr: ['tax_rates', 'v7 = 8%, v8 = 10%'],
    resl: ['Thuế $10', 'sai: mức tháng 10 là 8%'], resr: ['Thuế $8', 'replay lần nào cũng vậy'],
    alt: 'Hai khung. Trái: chạy lại đơn hàng 100 đô ngày 3 tháng 10 với mức thuế hiện tại 10 phần trăm cho ra thuế 10 đô, sai vì mức tháng 10 là 8 phần trăm. Phải: sự kiện đơn hàng lưu phiên bản mức thuế v7, tức 8 phần trăm, nên mỗi lần replay đều cho thuế 8 đô.',
    cap: 'Gắn mức thuế vào sự kiện, bằng mã phiên bản hoặc chép thẳng mức thuế vào đơn hàng, thì replay lần nào cũng cho cùng kết quả.',
  },
}[lang];
const panels = [
  { x: 20, h: T.hl, s: T.sl, r: T.rl, res: T.resl, kind: 'bad', icon: 'fail', ak: 'bad' },
  { x: 460, h: T.hr, s: T.sr, r: T.rr, res: T.resr, kind: 'good', icon: 'ok', ak: 'good' },
];
---
<StreamBFigure h={250} alt={T.alt} cap={T.cap}>
  {panels.map((p) => (
    <>
      <text x={p.x} y="24" class="h">{p.h}</text>
      <StreamBNode x={p.x} y={44} w={200} h={66} icon="receipt" title={T.sale} sub={[p.s]} />
      <StreamBNode x={p.x + 225} y={44} w={195} h={66} icon="db" title={p.r[0]} sub={[p.r[1]]} />
      <StreamBArrow x1={p.x + 100} y1={110} x2={p.x + 165} y2={160} kind={p.ak} />
      <StreamBArrow x1={p.x + 322} y1={110} x2={p.x + 265} y2={160} kind={p.ak} />
      <StreamBNode x={p.x + 90} y={160} w={250} h={66} icon={p.icon} title={p.res[0]} sub={[p.res[1]]} kind={p.kind} />
    </>
  ))}
</StreamBFigure>
