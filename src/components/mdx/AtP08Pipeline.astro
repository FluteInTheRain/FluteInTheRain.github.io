---
// Predict-then-rank, drawn as a pipeline. The label box feeds only the training
// step; at prediction time the model sees features and nothing else.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 330;
const BW = 150;
const BH = 96;
const Y = 100;
const boxes = [
  { x: 20, icon: 'db', en: ['Features', 'known at month end'], vi: ['Feature', 'biết được cuối tháng'] },
  { x: 200, icon: 'model', en: ['Model', 'trees, forest, boosting'], vi: ['Mô hình', 'tree, forest, boosting'] },
  { x: 380, icon: 'chart', en: ['Score', 'one number per stock'], vi: ['Điểm', 'một số cho mỗi cổ phiếu'] },
  { x: 560, icon: 'search', en: ['Rank', 'sort high to low'], vi: ['Xếp hạng', 'sắp từ cao xuống thấp'] },
  { x: 740, icon: 'package', en: ['Top group', 'handed to portfolio'], vi: ['Nhóm đầu', 'giao cho bước danh mục'] },
];
---
<figure class="atp08-pl">
  <div class="atp08-pl-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Predict-then-rank pipeline: features known at month end go into a model, which gives each stock a score; stocks are ranked by score and the top group is handed to portfolio construction. A separate dashed box, the label, the forward return, feeds only the training of the model.">
      <text x="20" y="28" class="h">
        <tspan data-lang-en>Predict, then rank: the model's job ends at the ordering</tspan>
        <tspan data-lang-vi>Dự đoán rồi xếp hạng: việc của mô hình dừng ở thứ tự</tspan>
      </text>
      {boxes.map((b, i) => (
        <g>
          <rect x={b.x} y={Y} width={BW} height={BH} rx="8" class={`box ${i === 3 ? 'key' : ''}`} />
          <DiagramIcon name={b.icon} x={b.x + BW / 2} y={Y + 26} size={24} />
          <text x={b.x + BW / 2} y={Y + 58} text-anchor="middle" class="bt">
            <tspan data-lang-en>{b.en[0]}</tspan>
            <tspan data-lang-vi>{b.vi[0]}</tspan>
          </text>
          <text x={b.x + BW / 2} y={Y + 78} text-anchor="middle" class="bs">
            <tspan data-lang-en>{b.en[1]}</tspan>
            <tspan data-lang-vi>{b.vi[1]}</tspan>
          </text>
          {i < boxes.length - 1 && <polygon points={`${b.x + BW + 6},${Y + BH / 2 - 7} ${b.x + BW + 6},${Y + BH / 2 + 7} ${b.x + BW + 22},${Y + BH / 2}`} class="arr" />}
        </g>
      ))}
      <rect x="200" y="248" width="150" height="60" rx="8" class="box lab" />
      <DiagramIcon name="calendar" x={224} y={278} size={22} />
      <text x="244" y="274" class="bt">
        <tspan data-lang-en>Label</tspan>
        <tspan data-lang-vi>Nhãn</tspan>
      </text>
      <text x="244" y="293" class="bs">
        <tspan data-lang-en>forward return</tspan>
        <tspan data-lang-vi>lợi suất tương lai</tspan>
      </text>
      <line x1="275" y1="246" x2="275" y2="204" class="dash" />
      <polygon points="268,212 282,212 275,198" class="arr2" />
      <text x="370" y="274" class="note">
        <tspan data-lang-en>only while training; never an input when scoring</tspan>
        <tspan data-lang-vi>chỉ dùng lúc huấn luyện; không bao giờ là input khi chấm điểm</tspan>
      </text>
      <text x="560" y="228" class="note">
        <tspan data-lang-en>Ties between neighbours do not matter,</tspan>
        <tspan data-lang-vi>Hai cổ phiếu sát nhau xếp trước sau không quan trọng,</tspan>
      </text>
      <text x="560" y="246" class="note">
        <tspan data-lang-en>only who lands in the top group does.</tspan>
        <tspan data-lang-vi>quan trọng là ai lọt vào nhóm đầu.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Weights, sizing and costs are the Portfolio post's job. Prediction only has to put the right stocks on the right side of the line.</span>
    <span data-lang-vi>Tỷ trọng, quy mô lệnh và chi phí là việc của bài Danh mục. Dự đoán chỉ cần đặt đúng cổ phiếu vào đúng phía của đường ranh.</span>
  </figcaption>
</figure>

<style>
  .atp08-pl { margin: 2em 0; width: 100%; }
  .atp08-pl-scroll { overflow-x: auto; }
  .atp08-pl svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp08-pl text { font-size: 14px; fill: var(--text-body); }
  .atp08-pl .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp08-pl .bt { font-size: 15px; font-weight: 700; fill: var(--text); }
  .atp08-pl .bs { font-size: 12px; fill: var(--text-muted); }
  .atp08-pl .note { font-size: 12.5px; fill: var(--text-muted); }
  .atp08-pl .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .atp08-pl .box.key { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.8; }
  .atp08-pl .box.lab { stroke-dasharray: 4 3; stroke: var(--text-muted); }
  .atp08-pl .arr { fill: var(--text-muted); }
  .atp08-pl .arr2 { fill: var(--text-muted); }
  .atp08-pl .dash { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .atp08-pl figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
