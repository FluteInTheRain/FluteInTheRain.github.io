---
// Who connects to whom around a FIX gateway: clients outside the firm, the gateway at the
// front door, the broker's OMS inside, then the exchange. Inline SVG with site tokens only;
// arrowheads are plain polygons (no <marker> ids), so the figure is safe to render twice.

const W = 900;
const H = 336;

// Small filled triangle pointing along angle a, tip at (x, y).
function tri(x: number, y: number, a: number) {
  const len = 8;
  const p1 = [x - len * Math.cos(a - 0.45), y - len * Math.sin(a - 0.45)];
  const p2 = [x - len * Math.cos(a + 0.45), y - len * Math.sin(a + 0.45)];
  return `${x.toFixed(1)},${y.toFixed(1)} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
}

// Two-way arrow: orders go one way, execution reports come back the other way.
function twoWay(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const c = Math.cos(a);
  const s = Math.sin(a);
  return {
    line: `M ${x1 + 6 * c} ${y1 + 6 * s} L ${x2 - 6 * c} ${y2 - 6 * s}`,
    end: tri(x2, y2, a),
    start: tri(x1, y1, a + Math.PI),
  };
}

const clientX = 20;
const clientW = 170;
const clientH = 48;
const clients = [
  { en: 'Hedge fund algo', vi: 'Quỹ đầu cơ (algo)', y: 70, toY: 120 },
  { en: 'Asset manager', vi: 'Công ty quản lý quỹ', y: 145, toY: 169 },
  { en: 'Another broker', vi: 'Công ty CK khác', y: 220, toY: 218 },
];

const gw = { x: 260, y: 70, w: 210, h: 198 };
const gwJobs = [
  { en: 'logon and heartbeats', vi: 'logon, heartbeat' },
  { en: 'sequence numbers', vi: 'đếm số thứ tự' },
  { en: 'a journal of every message', vi: 'nhật ký mọi tin nhắn' },
  { en: 'validation and throttling', vi: 'kiểm tra, giới hạn tần suất' },
  { en: 'FIX to binary', vi: 'đổi FIX sang nhị phân' },
];

const oms = { x: 570, y: 134, w: 130, h: 70 };
const exch = { x: 750, y: 134, w: 130, h: 70 };
const midY = 169;

// Zone boundaries sit in the middle of each gap.
const zones = [225, 520, 725];
const zoneTop = 52;
const zoneBottom = 280;

const heads = [
  { x: 105, en: 'Clients', vi: 'Khách hàng' },
  { x: 365, en: 'Front door (DMZ)', vi: 'Cửa ngõ (DMZ)' },
  { x: 635, en: 'Inside the broker', vi: 'Bên trong công ty CK' },
  { x: 815, en: 'Exchange', vi: 'Sở giao dịch' },
];

const wires = [
  { x: zones[0], en: ['FIX over TCP', 'TLS or leased line'], vi: ['FIX qua TCP', 'TLS hoặc kênh thuê riêng'] },
  { x: zones[1], en: ['binary over IPC', '(ring buffer, SBE)'], vi: ['nhị phân qua IPC', '(ring buffer, SBE)'] },
  { x: zones[2], en: ["FIX or the exchange's", 'own binary protocol'], vi: ['FIX hoặc giao thức', 'nhị phân của sàn'] },
];

const links = [
  ...clients.map((c) => twoWay(clientX + clientW, c.y + clientH / 2, gw.x, c.toY)),
  twoWay(gw.x + gw.w, midY, oms.x, midY),
  twoWay(oms.x + oms.w, midY, exch.x, midY),
];
---
<figure class="fixtopo">
  <div class="fixtopo-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Hedge funds, asset managers and other brokers connect over FIX on TCP to the broker's FIX gateway at the network edge. The gateway talks to the broker's internal OMS over a fast binary IPC link, and the OMS sends orders on to the exchange's matching engine.">
      {heads.map((h) => (
        <text x={h.x} y="36" text-anchor="middle" class="fixtopo-zone">
          <tspan data-lang-en>{h.en}</tspan>
          <tspan data-lang-vi>{h.vi}</tspan>
        </text>
      ))}

      {zones.map((x) => (
        <line x1={x} x2={x} y1={zoneTop} y2={zoneBottom} class="fixtopo-edge" />
      ))}

      {links.map((l) => (
        <g class="fixtopo-arrow">
          <path d={l.line} />
          <polygon points={l.end} />
          <polygon points={l.start} />
        </g>
      ))}

      {clients.map((c) => (
        <g class="fixtopo-box">
          <rect x={clientX} y={c.y} width={clientW} height={clientH} rx="8" />
          <text x={clientX + clientW / 2} y={c.y + 29} text-anchor="middle">
            <tspan data-lang-en>{c.en}</tspan>
            <tspan data-lang-vi>{c.vi}</tspan>
          </text>
        </g>
      ))}

      <g class="fixtopo-gw">
        <rect x={gw.x} y={gw.y} width={gw.w} height={gw.h} rx="10" />
        <text x={gw.x + gw.w / 2} y={gw.y + 34} text-anchor="middle" class="fixtopo-gw-name">FIX gateway</text>
        {gwJobs.map((j, i) => (
          <text x={gw.x + gw.w / 2} y={gw.y + 66 + i * 24} text-anchor="middle" class="fixtopo-job">
            <tspan data-lang-en>{j.en}</tspan>
            <tspan data-lang-vi>{j.vi}</tspan>
          </text>
        ))}
      </g>

      <g class="fixtopo-box">
        <rect x={oms.x} y={oms.y} width={oms.w} height={oms.h} rx="8" />
        <text x={oms.x + oms.w / 2} y={oms.y + 30} text-anchor="middle">OMS</text>
        <text x={oms.x + oms.w / 2} y={oms.y + 52} text-anchor="middle" class="fixtopo-sub">
          <tspan data-lang-en>order management</tspan>
          <tspan data-lang-vi>quản lý lệnh</tspan>
        </text>
      </g>

      <g class="fixtopo-box">
        <rect x={exch.x} y={exch.y} width={exch.w} height={exch.h} rx="8" />
        <text x={exch.x + exch.w / 2} y={exch.y + 30} text-anchor="middle">
          <tspan data-lang-en>Matching engine</tspan>
          <tspan data-lang-vi>Lõi khớp lệnh</tspan>
        </text>
        <text x={exch.x + exch.w / 2} y={exch.y + 52} text-anchor="middle" class="fixtopo-sub">HOSE, NYSE, CME</text>
      </g>

      {wires.map((w) => (
        <g>
          <text x={w.x} y="302" text-anchor="middle" class="fixtopo-wire">
            <tspan data-lang-en>{w.en[0]}</tspan>
            <tspan data-lang-vi>{w.vi[0]}</tspan>
          </text>
          <text x={w.x} y="321" text-anchor="middle" class="fixtopo-wire-sub">
            <tspan data-lang-en>{w.en[1]}</tspan>
            <tspan data-lang-vi>{w.vi[1]}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Every client connects to one place, the broker's FIX gateway. It keeps the stateful FIX sessions with the outside world and speaks a fast binary format to the systems inside. Orders travel left to right; execution reports come back right to left.</span>
    <span data-lang-vi>Mọi khách hàng đều kết nối vào một chỗ: FIX gateway của công ty chứng khoán. Gateway giữ các phiên FIX có trạng thái với bên ngoài, và nói chuyện với hệ thống bên trong bằng định dạng nhị phân cho nhanh. Lệnh đi từ trái sang phải; báo cáo khớp lệnh quay về từ phải sang trái.</span>
  </figcaption>
</figure>

<style>
  .fixtopo {
    margin: 2em 0;
    width: 100%;
  }
  .fixtopo-scroll {
    overflow-x: auto;
  }
  .fixtopo svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .fixtopo text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .fixtopo .fixtopo-zone {
    font-weight: 600;
    fill: var(--text-muted);
  }
  .fixtopo-edge {
    stroke: var(--border);
    stroke-width: 1.5;
    stroke-dasharray: 5 5;
  }
  .fixtopo-box rect {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .fixtopo-box text {
    fill: var(--text);
    font-weight: 600;
  }
  .fixtopo .fixtopo-sub {
    font-size: 13px;
    font-weight: 400;
    fill: var(--text-muted);
  }
  .fixtopo-gw rect {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .fixtopo .fixtopo-gw-name {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .fixtopo .fixtopo-job {
    font-size: 13.5px;
  }
  .fixtopo-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .fixtopo-arrow polygon {
    fill: var(--text-muted);
  }
  .fixtopo .fixtopo-wire {
    font-size: 13.5px;
    font-weight: 600;
  }
  .fixtopo .fixtopo-wire-sub {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .fixtopo figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
