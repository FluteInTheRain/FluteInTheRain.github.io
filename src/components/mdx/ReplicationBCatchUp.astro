---
// Three ways a leaderless replica catches up: read repair, hinted handoff, anti-entropy.
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Arrow from './ReplicationBArrow.astro';
import Bi from './ReplicationBBi.astro';
---
<Frame h={300}
  label="Three ways a replica that missed a write catches up. Read repair: a client reads, sees a stale replica and writes the newer value back. Hinted handoff: another node keeps the write as a hint while a replica is down and hands it over when it returns. Anti-entropy: a background job compares replicas and copies what is missing."
  cap="The first two react to something that just happened. The third is a slow sweep that catches whatever the other two missed."
  capVi="Hai cách đầu phản ứng với chuyện vừa xảy ra. Cách thứ ba là một lượt quét chậm, bắt những gì hai cách kia bỏ sót.">
  <rect x="10" y="10" width="280" height="280" rx="8" class="rb-panel" />
  <text x="150" y="38" text-anchor="middle" class="rb-h"><Bi en="Read repair" vi="Read repair" /></text>
  <text x="150" y="58" text-anchor="middle" class="rb-n"><Bi en="a read fixes a stale replica" vi="một lần đọc sửa replica cũ" /></text>
  <Node x={24} y={80} w={252} h={60} icon="laptop" t="Client" tv="Client" s="reads, sees Replica B is stale" sv="đọc, thấy Replica B đã cũ" />
  <Arrow x1={150} y1={140} x2={150} y2={196} cls="gold" />
  <text x="162" y="174" class="rb-n"><Bi en="writes v2 back" vi="ghi lại v2" /></text>
  <Node x={24} y={196} w={252} h={64} icon="db" t="Replica B" tv="Replica B" s="v1 becomes v2" sv="v1 thành v2" cls="gold" />

  <rect x="310" y="10" width="280" height="280" rx="8" class="rb-panel" />
  <text x="450" y="38" text-anchor="middle" class="rb-h"><Bi en="Hinted handoff" vi="Hinted handoff" /></text>
  <text x="450" y="58" text-anchor="middle" class="rb-n"><Bi en="another node holds the write" vi="node khác giữ hộ lần ghi" /></text>
  <Node x={324} y={80} w={252} h={60} icon="server" t="Node D" tv="Node D" s="keeps the write as a hint" sv="giữ lần ghi làm gợi ý" />
  <Arrow x1={450} y1={140} x2={450} y2={196} cls="gold" />
  <text x="462" y="174" class="rb-n"><Bi en="hands it over" vi="giao lại khi nó về" /></text>
  <Node x={324} y={196} w={252} h={64} icon="db" t="Node A" tv="Node A" s="was down, is back" sv="đã hỏng, nay sống lại" cls="gold" />

  <rect x="610" y="10" width="280" height="280" rx="8" class="rb-panel" />
  <text x="750" y="38" text-anchor="middle" class="rb-h"><Bi en="Anti-entropy" vi="Anti-entropy" /></text>
  <text x="750" y="58" text-anchor="middle" class="rb-n"><Bi en="a background job compares replicas" vi="job nền so sánh các replica" /></text>
  <Node x={624} y={80} w={252} h={60} icon="worker" t="Background job" tv="Job nền" s="compares what each has" sv="so xem mỗi bên có gì" />
  <Arrow x1={700} y1={140} x2={700} y2={196} />
  <Arrow x1={800} y1={140} x2={800} y2={196} />
  <Node x={624} y={196} w={118} h={64} t="Replica A" tv="Replica A" s="has k1, k2" sv="có k1, k2" />
  <Node x={758} y={196} w={118} h={64} t="Replica B" tv="Replica B" s="has k1 only" sv="chỉ có k1" cls="red" />
  <text x="750" y="280" text-anchor="middle" class="rb-n"><Bi en="copies k2 to B" vi="chép k2 sang B" /></text>
</Frame>
