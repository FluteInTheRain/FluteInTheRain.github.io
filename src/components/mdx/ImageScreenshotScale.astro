---
// Visual before/after showing why shrinking a full 1440px desktop dashboard into
// a 320px feature card creates unreadable micro-text, versus two legible fixes:
// (A) a zoomed partial UI crop at native scale, and (B) a simplified UI schematic.
const uid = Math.random().toString(36).slice(2, 8);
const W = 900;
const H = 430;
---
<figure class="img-scr">
  <div class="img-scr-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Before and after comparison: left shows a full 1440px desktop dashboard shrunk into a 320px feature card where 14px UI labels collapse into unreadable 3px gray bars; right shows a zoomed partial widget crop and a simplified UI schematic that stay readable.">
      <defs>
        <clipPath id={`scr-bad-${uid}`}>
          <rect x="0" y="0" width="356" height="222" rx="6" />
        </clipPath>
        <clipPath id={`scr-crop-${uid}`}>
          <rect x="0" y="0" width="184" height="148" rx="6" />
        </clipPath>
        <clipPath id={`scr-simp-${uid}`}>
          <rect x="0" y="0" width="184" height="148" rx="6" />
        </clipPath>
      </defs>

      {/* Left Column: Full 1440px dashboard shrunk to 320px (Wrong) */}
      <text x="20" y="26" class="img-scr-h is-bad">
        <tspan data-lang-en>1. Full 1440 px dashboard shrunk to 320 px</tspan>
        <tspan data-lang-vi>1. Thu nhỏ cả dashboard 1440 px vào ô 320 px</tspan>
      </text>

      <rect x="20" y="42" width="400" height="366" rx="8" class="img-scr-card is-bad" />

      {/* Feature card mockup holding the shrunken screenshot */}
      <g transform="translate(42, 64)">
        <g clip-path={`url(#scr-bad-${uid})`}>
          <rect width="356" height="222" fill="var(--bg)" />
          {/* Tiny top browser bar */}
          <rect x="0" y="0" width="356" height="14" fill="var(--bg-alt)" />
          <circle cx="8" cy="7" r="2.2" fill="var(--text-faint)" />
          <circle cx="15" cy="7" r="2.2" fill="var(--text-faint)" />
          <circle cx="22" cy="7" r="2.2" fill="var(--text-faint)" />
          <rect x="44" y="4" width="120" height="6" rx="2" fill="var(--border)" />
          {/* Tiny left sidebar */}
          <rect x="0" y="14" width="54" height="208" fill="var(--bg-alt)" />
          {[24, 34, 44, 54, 64, 74, 84, 94].map((ny) => (
            <rect x="8" y={ny} width="36" height="4" rx="1" fill="var(--text-faint)" opacity="0.6" />
          ))}
          {/* Main area header */}
          <rect x="64" y="22" width="84" height="7" rx="1.5" fill="var(--text)" opacity="0.65" />
          <rect x="304" y="21" width="42" height="9" rx="2" fill="var(--red)" opacity="0.8" />
          {/* 4 crammed KPI cards */}
          {[64, 136, 208, 280].map((kx) => (
            <g>
              <rect x={kx} y="36" width="66" height="34" rx="3" fill="var(--bg-alt)" stroke="var(--border)" stroke-width="0.7" />
              <rect x={kx + 6} y="43" width="32" height="3" rx="1" fill="var(--text-faint)" />
              <rect x={kx + 6} y="51" width="44" height="6" rx="1" fill="var(--text)" opacity="0.7" />
              <rect x={kx + 6} y="61" width="24" height="3" rx="1" fill="var(--text-faint)" opacity="0.6" />
            </g>
          ))}
          {/* Tiny chart box */}
          <rect x="64" y="78" width="182" height="66" rx="3" fill="var(--bg-alt)" stroke="var(--border)" stroke-width="0.7" />
          <polyline points="72,132 96,118 120,124 146,102 174,108 202,92 238,98" fill="none" stroke="var(--red)" stroke-width="1.2" opacity="0.8" />
          {/* Tiny side feed */}
          <rect x="254" y="78" width="92" height="66" rx="3" fill="var(--bg-alt)" stroke="var(--border)" stroke-width="0.7" />
          {[86, 98, 110, 122, 134].map((fy) => (
            <rect x="262" y={fy} width="74" height="3.5" rx="1" fill="var(--text-faint)" opacity="0.65" />
          ))}
          {/* Dense unreadable data table */}
          <rect x="64" y="152" width="282" height="62" rx="3" fill="var(--bg-alt)" stroke="var(--border)" stroke-width="0.7" />
          {[160, 170, 180, 190, 200, 208].map((ty) => (
            <g>
              <rect x="70" y={ty} width="46" height="2.8" rx="1" fill="var(--text-faint)" opacity="0.75" />
              <rect x="128" y={ty} width="68" height="2.8" rx="1" fill="var(--text-faint)" opacity="0.55" />
              <rect x="210" y={ty} width="44" height="2.8" rx="1" fill="var(--text-faint)" opacity="0.55" />
              <rect x="268" y={ty} width="32" height="2.8" rx="1" fill="var(--text-faint)" opacity="0.55" />
              <rect x="312" y={ty} width="26" height="2.8" rx="1" fill="var(--text-faint)" opacity="0.55" />
            </g>
          ))}
        </g>
        <rect x="0" y="0" width="356" height="222" rx="6" fill="none" stroke="var(--border)" stroke-width="1" />
      </g>

      {/* Callout notes under bad preview */}
      <text x="42" y="314" class="img-scr-note is-bad">
        <tspan data-lang-en>22% scale: 14 px UI labels shrink to ~3 px</tspan>
        <tspan data-lang-vi>Tỷ lệ 22%: chữ UI 14 px teo còn ~3 px</tspan>
      </text>
      <text x="42" y="338" class="img-scr-sub">
        <tspan data-lang-en>Every table row, sidebar item, and chart axis turns</tspan>
        <tspan data-lang-vi>Mọi dòng bảng, thanh menu và trục biểu đồ đều biến</tspan>
      </text>
      <text x="42" y="358" class="img-scr-sub">
        <tspan data-lang-en>into illegible gray noise. Nothing draws the eye.</tspan>
        <tspan data-lang-vi>thành mảng xám mờ tịt. Không còn điểm nhấn nào.</tspan>
      </text>
      <text x="42" y="388" class="img-scr-meta">
        <tspan data-lang-en>1440 × 900 capture → squeezed into 320 × 200 slot</tspan>
        <tspan data-lang-vi>Ảnh chụp 1440 × 900 → ép vào khung 320 × 200</tspan>
      </text>

      {/* Center divider */}
      <line x1="444" y1="20" x2="444" y2="408" stroke="var(--border)" stroke-width="1" stroke-dasharray="4 4" />

      {/* Right Column: Two clean alternatives */}
      <text x="466" y="26" class="img-scr-h">
        <tspan data-lang-en>2. Keep detail readable: crop or simplify</tspan>
        <tspan data-lang-vi>2. Giữ chi tiết dễ đọc: cắt cận hoặc lược giản</tspan>
      </text>

      {/* Card A: Zoomed partial UI crop */}
      <rect x="466" y="42" width="414" height="174" rx="8" class="img-scr-card" />
      <g transform="translate(480, 55)">
        <g clip-path={`url(#scr-crop-${uid})`}>
          <rect width="184" height="148" fill="var(--bg)" />
          {/* Single zoomed-in widget at native 1:1 legibility */}
          <rect x="10" y="10" width="184" height="132" rx="7" fill="var(--bg-alt)" stroke="var(--border)" stroke-width="1.2" />
          <text x="22" y="34" class="img-scr-ui-kicker">
            <tspan data-lang-en>Monthly revenue</tspan>
            <tspan data-lang-vi>Doanh thu tháng</tspan>
          </text>
          <text x="22" y="64" class="img-scr-ui-num">$48,290</text>
          <text x="116" y="64" class="img-scr-ui-delta">+18.4%</text>
          <polyline points="22,114 48,104 74,108 102,90 132,96 164,76" fill="none" stroke="var(--red)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="164" cy="76" r="3.5" fill="var(--red)" />
          <line x1="22" y1="126" x2="176" y2="126" stroke="var(--border)" stroke-width="1" />
        </g>
        <rect x="0" y="0" width="184" height="148" rx="6" fill="none" stroke="var(--border)" stroke-width="1" />
      </g>
      <text x="680" y="84" class="img-scr-note">
        <tspan data-lang-en>A. Partial UI crop</tspan>
        <tspan data-lang-vi>A. Cắt cận một cụm UI</tspan>
      </text>
      <text x="680" y="108" class="img-scr-sub">
        <tspan data-lang-en>Shoot at a smaller viewport</tspan>
        <tspan data-lang-vi>Chụp ở khung hẹp hơn rồi cắt</tspan>
      </text>
      <text x="680" y="128" class="img-scr-sub">
        <tspan data-lang-en>and frame only the single</tspan>
        <tspan data-lang-vi>sát đúng widget bạn đang</tspan>
      </text>
      <text x="680" y="148" class="img-scr-sub">
        <tspan data-lang-en>widget you are explaining.</tspan>
        <tspan data-lang-vi>muốn giới thiệu.</tspan>
      </text>
      <text x="680" y="180" class="img-scr-meta">
        <tspan data-lang-en>Real UI at ~100% scale</tspan>
        <tspan data-lang-vi>UI thật giữ tỷ lệ ~100%</tspan>
      </text>

      {/* Card B: Simplified UI schematic */}
      <rect x="466" y="234" width="414" height="174" rx="8" class="img-scr-card" />
      <g transform="translate(480, 247)">
        <g clip-path={`url(#scr-simp-${uid})`}>
          <rect width="184" height="148" fill="var(--bg)" />
          {/* Clean simplified schematic: recognizable structure, bars instead of micro-text */}
          <rect x="12" y="12" width="160" height="124" rx="7" fill="var(--bg-alt)" stroke="var(--border)" stroke-width="1.2" />
          <circle cx="32" cy="34" r="10" fill="var(--red-tint-bg)" />
          <rect x="50" y="27" width="72" height="6" rx="3" fill="var(--text)" opacity="0.8" />
          <rect x="50" y="38" width="48" height="4.5" rx="2.2" fill="var(--text-muted)" opacity="0.55" />
          <line x1="22" y1="54" x2="162" y2="54" stroke="var(--border)" stroke-width="1" />
          <rect x="22" y="64" width="136" height="5" rx="2.5" fill="var(--text-muted)" opacity="0.45" />
          <rect x="22" y="76" width="112" height="5" rx="2.5" fill="var(--text-muted)" opacity="0.35" />
          <rect x="22" y="98" width="66" height="22" rx="5" fill="var(--red)" />
          <rect x="96" y="98" width="54" height="22" rx="5" fill="var(--bg)" stroke="var(--border)" stroke-width="1" />
        </g>
        <rect x="0" y="0" width="184" height="148" rx="6" fill="none" stroke="var(--border)" stroke-width="1" />
      </g>
      <text x="680" y="276" class="img-scr-note">
        <tspan data-lang-en>B. Simplified schematic</tspan>
        <tspan data-lang-vi>B. Minh họa UI tối giản</tspan>
      </text>
      <text x="680" y="300" class="img-scr-sub">
        <tspan data-lang-en>Keep key shapes and primary</tspan>
        <tspan data-lang-vi>Giữ bố cục chính và nút hành</tspan>
      </text>
      <text x="680" y="320" class="img-scr-sub">
        <tspan data-lang-en>actions; replace tiny copy</tspan>
        <tspan data-lang-vi>động; thay chữ nhỏ li ti bằng</tspan>
      </text>
      <text x="680" y="340" class="img-scr-sub">
        <tspan data-lang-en>with clean neutral bars.</tspan>
        <tspan data-lang-vi>các thanh màu trung tính.</tspan>
      </text>
      <text x="680" y="372" class="img-scr-meta">
        <tspan data-lang-en>Zero unreadable micro-text</tspan>
        <tspan data-lang-vi>Không còn chữ siêu nhỏ gây rối</tspan>
      </text>
    </svg>
  </div>

  <figcaption>
    <span data-lang-en>Never cram a 1440 px desktop screenshot into a narrow card. Crop closely to one legible widget or draw a simplified UI schematic.</span>
    <span data-lang-vi>Đừng ép nguyên ảnh chụp màn hình 1440 px vào thẻ nhỏ. Hãy cắt cận một cụm widget rõ nét hoặc dùng bản minh họa UI tối giản.</span>
  </figcaption>
</figure>

<style>
  .img-scr { margin: 2em 0; width: 100%; }
  .img-scr-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .img-scr svg { min-width: 640px; width: 100%; height: auto; display: block; font-family: inherit; }
  .img-scr-h { font-size: 15px; font-weight: 700; fill: var(--text); font-variant-numeric: tabular-nums; }
  .img-scr-h.is-bad { fill: var(--red); }
  .img-scr-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .img-scr-card.is-bad { stroke: var(--red); }
  .img-scr-note { font-size: 13.5px; font-weight: 700; fill: var(--text); font-variant-numeric: tabular-nums; }
  .img-scr-note.is-bad { fill: var(--red); }
  .img-scr-sub { font-size: 13px; fill: var(--text-body); }
  .img-scr-meta { font-size: 12.5px; fill: var(--text-muted); font-variant-numeric: tabular-nums; }
  .img-scr-ui-kicker { font-size: 11.5px; font-weight: 600; fill: var(--text-muted); }
  .img-scr-ui-num { font-size: 20px; font-weight: 700; fill: var(--text); font-variant-numeric: tabular-nums; }
  .img-scr-ui-delta { font-size: 12px; font-weight: 600; fill: var(--red); font-variant-numeric: tabular-nums; }
  .img-scr figcaption { margin-top: 0.75em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
