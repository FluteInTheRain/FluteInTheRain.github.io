---
// Wall time for 10 concurrent requests, six endpoints, all numbers from the
// captures beside the figure (M2, Python 3.13, FastAPI 0.165.0).
const W = 900, H = 410;
const X0 = 330, PER_S = 48; // 0..10.5 s
type Row = { code: string; v: number; bad: boolean };
const g1: Row[] = [
  { code: 'async def + await asyncio.sleep(1)', v: 1.06, bad: false },
  { code: 'def + time.sleep(1)', v: 1.03, bad: false },
  { code: 'async def + time.sleep(1)', v: 10.05, bad: true },
];
const g2: Row[] = [
  { code: 'async def + requests.get', v: 5.06, bad: true },
  { code: 'async def + httpx.AsyncClient', v: 0.62, bad: false },
  { code: 'def + requests.get', v: 0.53, bad: false },
];
const groups = [
  { y: 52, rows: g1, title: { en: 'waiting one second', vi: 'chờ đúng một giây' } },
  { y: 232, rows: g2, title: { en: 'calling an upstream that takes 0.5 s', vi: 'gọi một upstream mất 0.5 s' } },
];
---
<figure class="bep6c">
  <div class="bep6c-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Horizontal bars of wall time for ten concurrent requests. Waiting one second: async def with await 1.06 seconds, plain def 1.03, async def with time.sleep 10.05. Calling an upstream that takes half a second: async def with requests 5.06, async def with httpx.AsyncClient 0.62, plain def with requests 0.53.">
    {groups.map((g) => (
      <g>
        <text x="20" y={g.y} class="gt"><tspan data-lang-en>{g.title.en}</tspan><tspan data-lang-vi>{g.title.vi}</tspan></text>
        {g.rows.map((r, i) => (
          <g>
            <text x={X0 - 14} y={g.y + 42 + i * 44} text-anchor="end" class="code">{r.code}</text>
            <rect x={X0} y={g.y + 26 + i * 44} width={r.v * PER_S} height="24" rx="3" class={r.bad ? 'bad' : 'ok'} />
            <text x={X0 + r.v * PER_S + 10} y={g.y + 43 + i * 44} class={r.bad ? 'vr' : 'v'}>{r.v.toFixed(2)} s</text>
          </g>
        ))}
      </g>
    ))}
    <line x1={X0} y1="46" x2={X0} y2="392" class="axis" />
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Wall time for 10 concurrent requests (Apple M2, 8 cores, Python 3.13, FastAPI 0.165.0). The two red bars are the same sin: a blocking call inside async def.</span>
    <span data-lang-vi>Tổng thời gian cho 10 request đồng thời (Apple M2, 8 cores, Python 3.13, FastAPI 0.165.0). Hai thanh đỏ là cùng một lỗi: lời gọi chặn bên trong async def.</span>
  </figcaption>
</figure>

<style>
  .bep6c { margin: 2em 0; width: 100%; }
  .bep6c-scroll { overflow-x: auto; }
  .bep6c svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .bep6c text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep6c .gt { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep6c .code { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; fill: var(--text); }
  .bep6c .v { fill: var(--text); font-weight: 700; }
  .bep6c .vr { fill: var(--red); font-weight: 700; }
  .bep6c .axis { stroke: var(--text-muted); stroke-width: 1.4; }
  .bep6c .ok { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.3; }
  .bep6c .bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; }
  .bep6c figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
