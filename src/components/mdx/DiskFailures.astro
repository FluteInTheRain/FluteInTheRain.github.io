---
// 10,000 disks over 30 days: each small square is one disk, red ones died during the month.
// With an average disk lifetime of ~27 years (inside the 10–50 year range), 10,000 disks
// lose about one disk per day, so ~30 in a month, scattered at random (hardware faults are independent).

const COLS = 200;
const ROWS = 50;
const PITCH = 4.4; // cell size + gap
const CELL = 3.4;
const X0 = 10;
const Y0 = 34;
const W = X0 * 2 + COLS * PITCH;
const H = Y0 + ROWS * PITCH + 30;

const DAYS = 30;
const LIFETIME_YEARS = 27.4;
const perDay = (COLS * ROWS) / (LIFETIME_YEARS * 365);

// Deterministic positions so every build draws the same picture.
function rng(a: number) {
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(2026);
const failed = new Set<number>();
while (failed.size < Math.round(perDay * DAYS)) failed.add(Math.floor(rand() * COLS * ROWS));
const dead = [...failed].map((i) => ({ x: X0 + (i % COLS) * PITCH, y: Y0 + Math.floor(i / COLS) * PITCH }));

// Unique per instance: the EN and VI copies of the post each render this component,
// and a <pattern> referenced from a display:none subtree may not paint.
const pid = `disks-${Math.random().toString(36).slice(2, 9)}`;
---
<figure class="disks">
  <div class="disks-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`A grid of ${COLS * ROWS} disks; ${dead.length} of them, scattered at random, died during one month.`}>
      <defs>
        <pattern id={pid} width={PITCH} height={PITCH} patternUnits="userSpaceOnUse" x={X0} y={Y0}>
          <rect width={CELL} height={CELL} rx="0.6" class="disks-cell" />
        </pattern>
      </defs>

      <text x={X0} y="20" class="disks-h">
        <tspan data-lang-en>10,000 disks, one month</tspan>
        <tspan data-lang-vi>10.000 ổ đĩa, một tháng</tspan>
      </text>
      <text x={W - X0} y="20" text-anchor="end" class="disks-key">
        <tspan data-lang-en>■ died this month: {dead.length}</tspan>
        <tspan data-lang-vi>■ chết trong tháng: {dead.length}</tspan>
      </text>

      <rect x={X0} y={Y0} width={COLS * PITCH} height={ROWS * PITCH} fill={`url(#${pid})`} />
      {dead.map((d) => <rect x={d.x - 1.2} y={d.y - 1.2} width={CELL + 2.4} height={CELL + 2.4} rx="1" class="disks-dead" />)}

      <text x={X0} y={H - 8} class="disks-note">
        <tspan data-lang-en>About {perDay.toFixed(1)} disk a day. No pattern: one dead disk does not kill its neighbours.</tspan>
        <tspan data-lang-vi>Khoảng {perDay.toFixed(1).replace('.', ',')} ổ mỗi ngày. Không theo quy luật nào: một ổ chết không kéo ổ bên cạnh chết theo.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Simulated. If a disk lasts about 27 years on average (inside the 10–50 year range quoted above), 10,000 disks lose roughly one disk per day. Replacing disks is routine work, which is why storage is built with redundancy.</span>
    <span data-lang-vi>Mô phỏng. Nếu một ổ đĩa sống trung bình khoảng 27 năm (nằm trong khoảng 10–50 năm ở trên), thì 10.000 ổ sẽ chết khoảng một ổ mỗi ngày. Thay ổ đĩa là việc thường ngày, vì vậy hệ thống lưu trữ luôn được xây với dự phòng (redundancy).</span>
  </figcaption>
</figure>

<style>
  .disks {
    margin: 2em 0;
    width: 100%;
  }
  .disks-scroll {
    overflow-x: auto;
  }
  .disks svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .disks-cell {
    fill: var(--border);
  }
  .disks-dead {
    fill: var(--red);
  }
  .disks text {
    font-size: 14px;
    fill: var(--text-muted);
  }
  .disks .disks-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .disks .disks-key {
    fill: var(--red);
    font-weight: 600;
  }
  .disks figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
