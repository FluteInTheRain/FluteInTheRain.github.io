---
// The automatic rebalancing loop versus a human-approved plan. Inline SVG, site CSS tokens only.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
type Lbl = { x: number; y: number; c: string; en: string[]; vi: string[]; a?: string; lh?: number };
const W = 900;
const H = 350;
const xs = [20, 325, 630];
const bw = 250;
const bh = 82;
const lane1 = 44;
const lane2 = 236;
const steps1 = [
  { icon: 'server', en: ['One node is overloaded', 'and answers heartbeats', 'slowly'], vi: ['Một node quá tải,', 'trả lời heartbeat', 'rất chậm'] },
  { icon: 'warning', en: ['Peers assume it is dead', 'and start moving its', 'shards elsewhere'], vi: ['Các node khác tưởng nó', 'đã chết và bắt đầu dời', 'shard của nó đi nơi khác'] },
  { icon: 'network', en: ['Copying gigabytes loads', 'the remaining nodes', 'past their limit'], vi: ['Sao chép gigabyte làm', 'các node còn lại', 'vượt ngưỡng chịu tải'] },
];
const steps2 = [
  { icon: 'file', en: ['The cluster computes a', 'rebalance plan but does', 'not run it'], vi: ['Cụm chỉ tính sẵn', 'phương án rebalance,', 'chưa chạy ngay'] },
  { icon: 'user', en: ['An operator reviews the', 'plan and commits it', '(Couchbase, Riak)'], vi: ['Kỹ sư vận hành xem', 'phương án rồi bấm duyệt', '(Couchbase, Riak)'] },
  { icon: 'ok', en: ['Shards move once, on', 'purpose, not because', 'of a false alarm'], vi: ['Shard chỉ dời một lần,', 'có chủ đích, không vì', 'báo động giả'] },
];
const link1 = [arrow(xs[0] + bw, lane1 + 41, xs[1] - 4, lane1 + 41), arrow(xs[1] + bw, lane1 + 41, xs[2] - 4, lane1 + 41)];
const link2 = [arrow(xs[0] + bw, lane2 + 41, xs[1] - 4, lane2 + 41), arrow(xs[1] + bw, lane2 + 41, xs[2] - 4, lane2 + 41)];
const back = arrow(xs[0] + 125, lane1 + bh + 40, xs[0] + 125, lane1 + bh + 3);
const loopY = lane1 + bh + 40;
const labels: Lbl[] = [
  { x: 20, y: 28, c: 'h is-hot', a: 'start', en: ['Fully automatic: failure detection plus rebalancing'], vi: ['Hoàn toàn tự động: tự phát hiện lỗi cộng tự rebalance'] },
  { x: 450, y: loopY + 22, c: 'note is-hot', en: ['More nodes slow down, so the loop starts again'], vi: ['Thêm node chậm đi, vòng lặp lại bắt đầu'] },
  { x: 20, y: lane2 - 14, c: 'h is-gold', a: 'start', en: ['With a human in the loop: plan first, then approval'], vi: ['Có người duyệt: tính phương án trước, rồi mới duyệt'] },
  { x: 450, y: lane2 + bh + 28, c: 'note is-gold', en: ['Result: a cascade needs a person to say yes'], vi: ['Kết quả: sập dây chuyền phải có người gật đầu'] },
];
---
<figure class="shbc">
  <div class="shbc-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top row, fully automatic: an overloaded node answers heartbeats slowly, peers assume it is dead and start moving its shards, copying gigabytes overloads the remaining nodes, and the loop starts again as a cascading failure. Bottom row, with a human in the loop: the cluster computes a rebalance plan, an operator reviews and commits it, and shards move once on purpose.">
      {steps1.map((s, i) => (
        <g>
          <rect x={xs[i]} y={lane1} width={bw} height={bh} rx="8" class="box is-hot" />
          <DiagramIcon name={s.icon} x={xs[i] + 28} y={lane1 + 30} size={26} />
          <circle cx={xs[i] + 28} cy={lane1 + 62} r="9" class="circ" />
          <text x={xs[i] + 28} y={lane1 + 66} text-anchor="middle" class="num">{i + 1}</text>
        </g>
      ))}
      {steps2.map((s, i) => (
        <g>
          <rect x={xs[i]} y={lane2} width={bw} height={bh} rx="8" class="box is-gold" />
          <DiagramIcon name={s.icon} x={xs[i] + 28} y={lane2 + 30} size={26} />
          <circle cx={xs[i] + 28} cy={lane2 + 62} r="9" class="circ" />
          <text x={xs[i] + 28} y={lane2 + 66} text-anchor="middle" class="num">{i + 1}</text>
        </g>
      ))}
      {link1.map((a) => (<g><path d={a.line} class="arrow is-hot" /><polygon points={a.head} class="head is-hot" /></g>))}
      {link2.map((a) => (<g><path d={a.line} class="arrow is-gold" /><polygon points={a.head} class="head is-gold" /></g>))}
      <path d={`M ${xs[2] + 125} ${lane1 + bh + 3} L ${xs[2] + 125} ${loopY} L ${xs[0] + 125} ${loopY} L ${xs[0] + 125} ${lane1 + bh + 9}`} class="arrow is-hot is-dash" />
      <polygon points={back.head} class="head is-hot" />
      {steps1.map((s, i) => (
        <>
          <text x={xs[i] + 54} y={lane1 + 28} class="s" data-lang-en>{s.en.map((t, k) => <tspan x={xs[i] + 54} dy={k === 0 ? 0 : 15}>{t}</tspan>)}</text>
          <text x={xs[i] + 54} y={lane1 + 28} class="s" data-lang-vi>{s.vi.map((t, k) => <tspan x={xs[i] + 54} dy={k === 0 ? 0 : 15}>{t}</tspan>)}</text>
        </>
      ))}
      {steps2.map((s, i) => (
        <>
          <text x={xs[i] + 54} y={lane2 + 28} class="s" data-lang-en>{s.en.map((t, k) => <tspan x={xs[i] + 54} dy={k === 0 ? 0 : 15}>{t}</tspan>)}</text>
          <text x={xs[i] + 54} y={lane2 + 28} class="s" data-lang-vi>{s.vi.map((t, k) => <tspan x={xs[i] + 54} dy={k === 0 ? 0 : 15}>{t}</tspan>)}</text>
        </>
      ))}
      {labels.map((l) => (
        <>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-en>{l.en.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-vi>{l.vi.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
        </>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The same slow node, handled two ways. Automatic rebalancing can turn one slow node into a cluster-wide outage; waiting for approval breaks the loop.</span>
    <span data-lang-vi>Cùng một node chậm, xử lý theo hai cách. Rebalance tự động có thể biến một node chậm thành sự cố toàn cụm; chờ người duyệt thì phá được vòng lặp.</span>
  </figcaption>
</figure>

<style>
  .shbc { margin: 2em 0; width: 100%; }
  .shbc-scroll { overflow-x: auto; }
  .shbc svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shbc text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shbc .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shbc .h.is-hot { fill: var(--red); }
  .shbc .h.is-gold { fill: var(--gold-icon); }
  .shbc .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shbc .sub.is-gold { fill: var(--gold-icon); font-weight: 600; }
  .shbc .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shbc .b.is-hot { fill: var(--red); }
  .shbc .s { font-size: 12px; fill: var(--text-body); }
  .shbc .s.is-hot { fill: var(--red); font-weight: 600; }
  .shbc .note { font-size: 13px; font-weight: 600; fill: var(--text); }
  .shbc .note.is-hot { fill: var(--red); }
  .shbc .note.is-gold { fill: var(--gold-icon); }
  .shbc .num { font-size: 11px; font-weight: 700; fill: var(--text); }
  .shbc .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbc .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shbc .box.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .shbc .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shbc .box.is-dim { opacity: 0.5; }
  .shbc .circ { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbc .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shbc .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shbc .arrow.is-hot { stroke: var(--red); }
  .shbc .arrow.is-gold { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shbc .arrow.is-strong { stroke: var(--text); stroke-width: 1.7; }
  .shbc .arrow.is-dash { stroke-dasharray: 5 4; }
  .shbc .head { fill: var(--text-muted); }
  .shbc .head.is-hot { fill: var(--red); }
  .shbc .head.is-gold { fill: var(--gold-icon); }
  .shbc .head.is-strong { fill: var(--text); }
  .shbc figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>

