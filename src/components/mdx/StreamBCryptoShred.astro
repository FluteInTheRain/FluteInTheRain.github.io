---
// Crypto-shredding: encrypt each user's records with their own key, delete the key to erase the user.
import StreamBFigure from './StreamBFigure.astro';
import StreamBNode from './StreamBNode.astro';
import StreamBArrow from './StreamBArrow.astro';
import StreamBNum from './StreamBNum.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    s1: 'Write', s1a: 'Each user gets their own key; records are stored encrypted',
    s2: 'Erase', s2a: 'The user asks to be forgotten: delete only their key',
    s3: 'Result', s3a: 'The old bytes stay in logs and backups, but nobody can read them',
    a1: ['user A: has a key', 'records stored encrypted'], b1: ['user B: has a key', 'records stored encrypted'],
    a2: ['user A: key deleted', 'nothing else touched'], b2: ['user B: key kept', 'nothing else touched'],
    a3: ['user A: unreadable', 'still in log and backups'], b3: ['user B: readable', 'still in log and backups'],
    alt: 'Three steps. Step 1: each user has their own key in a key store and their records are written encrypted into the log. Step 2: when user A asks to be erased, only user A\'s key is deleted. Step 3: user A\'s records remain in the log and backups but cannot be read, while user B\'s records stay readable.',
    cap: 'You never rewrite the immutable log. Deleting a small key makes a user\'s data unreadable everywhere it was copied.',
  },
  vi: {
    s1: 'Ghi', s1a: 'Mỗi người dùng có khoá riêng; bản ghi được lưu ở dạng mã hoá',
    s2: 'Xoá', s2a: 'Người dùng yêu cầu bị quên: chỉ xoá khoá của người đó',
    s3: 'Kết quả', s3a: 'Dữ liệu cũ vẫn nằm trong log và backup, nhưng không ai đọc được',
    a1: ['user A: có khoá', 'bản ghi lưu dạng mã hoá'], b1: ['user B: có khoá', 'bản ghi lưu dạng mã hoá'],
    a2: ['user A: khoá đã xoá', 'không đụng gì khác'], b2: ['user B: giữ khoá', 'không đụng gì khác'],
    a3: ['user A: không đọc được', 'vẫn nằm trong log, backup'], b3: ['user B: đọc được', 'vẫn nằm trong log, backup'],
    alt: 'Ba bước. Bước 1: mỗi người dùng có khoá riêng trong kho khoá và bản ghi của họ được ghi vào log ở dạng mã hoá. Bước 2: khi user A yêu cầu xoá, chỉ khoá của user A bị xoá. Bước 3: bản ghi của user A vẫn nằm trong log và backup nhưng không đọc được, còn bản ghi của user B vẫn đọc được.',
    cap: 'Bạn không bao giờ sửa lại log bất biến. Xoá một chiếc khoá nhỏ là dữ liệu của người đó không đọc được ở mọi nơi đã sao chép.',
  },
}[lang];
const cx = [20, 320, 620];
---
<StreamBFigure h={246} alt={T.alt} cap={T.cap}>
  {[[T.s1, T.s1a], [T.s2, T.s2a], [T.s3, T.s3a]].map((s, i) => (
    <>
      <StreamBNum x={cx[i] + 11} y={22} n={i + 1} />
      <text x={cx[i] + 30} y="27" class="h">{s[0]}</text>
      <text x={cx[i]} y="56" class="sub">{s[1].length > 38 ? s[1].slice(0, s[1].lastIndexOf(' ', 38)) : s[1]}</text>
      {s[1].length > 38 && <text x={cx[i]} y="73" class="sub">{s[1].slice(s[1].lastIndexOf(' ', 38) + 1)}</text>}
    </>
  ))}
  <StreamBNode x={20} y={100} w={260} h={58} icon="key" title={T.a1[0]} sub={[T.a1[1]]} />
  <StreamBNode x={20} y={170} w={260} h={58} icon="key" title={T.b1[0]} sub={[T.b1[1]]} />
  <StreamBNode x={320} y={100} w={260} h={58} icon="key" title={T.a2[0]} sub={[T.a2[1]]} kind="bad" />
  <StreamBNode x={320} y={170} w={260} h={58} icon="key" title={T.b2[0]} sub={[T.b2[1]]} />
  <StreamBNode x={620} y={100} w={260} h={58} icon="log" title={T.a3[0]} sub={[T.a3[1]]} kind="bad" />
  <StreamBNode x={620} y={170} w={260} h={58} icon="log" title={T.b3[0]} sub={[T.b3[1]]} kind="good" />
</StreamBFigure>
