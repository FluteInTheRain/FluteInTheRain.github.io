---
// Where eager writes meet lazy reads: comparing server-side index boundaries,
// local-first device replicas fed by SSE/WebSockets, and reads treated as a stream-table join.
// Plain inline SVG using site CSS tokens; polygon arrowheads avoid duplicate marker IDs.

const W = 900;
const H = 620;

function arrowRight(x1: number, x2: number, y: number) {
  return {
    line: `M${x1},${y} L${x2 - 7},${y}`,
    head: `${x2 - 8},${y - 4.5} ${x2 - 8},${y + 4.5} ${x2},${y}`,
  };
}

// Band 1 arrows
const b1a = arrowRight(170, 205, 146);
const b1b = arrowRight(420, 485, 146);
const b1c = arrowRight(660, 706, 146);

// Band 2 arrows
const b2a = arrowRight(170, 205, 318);
const b2b = arrowRight(400, 465, 318);
const b2c = arrowRight(680, 725, 318);

// Band 3 arrows (converging streams into processor, then output)
const b3top = {
  line: 'M250,494 L290,494 L290,514 L323,514',
  head: '322,509.5 322,518.5 330,514',
};
const b3bot = {
  line: 'M250,554 L290,554 L290,534 L323,534',
  head: '322,529.5 322,538.5 330,534',
};
const b3out = arrowRight(600, 655, 523);
---
<figure class="unb-fig">
  <div class="unb-scroll">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label="Three placements of the boundary between write path and read path: a traditional server-side index where clients must poll, a local-first device store fed eagerly over WebSockets or SSE, and treating read queries as a stream joined with partitioned state."
    >
      <text x="20" y="26" class="unb-h">
        <tspan data-lang-en>Shifting the boundary between write path and read path</tspan>
        <tspan data-lang-vi>Dịch ranh giới giữa đường ghi và đường đọc</tspan>
      </text>
      <text x="20" y="48" class="unb-sub">
        <tspan data-lang-en>Solid arrows run eagerly on every write; dashed arrows run lazily only when a user asks.</tspan>
        <tspan data-lang-vi>Mũi tên liền chạy sẵn mỗi khi ghi; mũi tên đứt chỉ chạy khi có người truy vấn.</tspan>
      </text>

      {/* Band 1: Server boundary */}
      <text x="20" y="84" class="unb-lane-h">
        <tspan data-lang-en>1. Classic server boundary (index or cache)</tspan>
        <tspan data-lang-vi>1. Ranh giới truyền thống trên server (index hoặc cache)</tspan>
      </text>
      <text x="20" y="104" class="unb-lane-sub">
        <tspan data-lang-en>Derived store sits in the datacenter; the browser goes stale until the next poll or reload.</tspan>
        <tspan data-lang-vi>Kho dữ liệu nằm ở datacenter; trình duyệt giữ bản cũ cho tới lần poll hoặc tải lại sau.</tspan>
      </text>

      <rect x="20" y="120" width="150" height="52" rx="4" class="unb-box" />
      <text x="95" y="143" text-anchor="middle" class="unb-in-b">
        <tspan data-lang-en>Write event</tspan>
        <tspan data-lang-vi>Sự kiện ghi</tspan>
      </text>
      <text x="95" y="162" text-anchor="middle" class="unb-in-m">
        <tspan data-lang-en>row / document</tspan>
        <tspan data-lang-vi>dòng / tài liệu</tspan>
      </text>

      <path d={b1a.line} class="unb-solid" />
      <polygon points={b1a.head} class="unb-head" />

      <rect x="205" y="120" width="215" height="52" rx="4" class="unb-box" />
      <text x="312.5" y="143" text-anchor="middle" class="unb-in-b">
        <tspan data-lang-en>Derived index / view</tspan>
        <tspan data-lang-vi>Index / khung nhìn</tspan>
      </text>
      <text x="312.5" y="162" text-anchor="middle" class="unb-in-m">
        <tspan data-lang-en>eager update on write</tspan>
        <tspan data-lang-vi>cập nhật sẵn khi ghi</tspan>
      </text>

      <line x1="450" y1="114" x2="450" y2="180" class="unb-boundary" />
      <text x="450" y="200" text-anchor="middle" class="unb-boundary-lbl">
        <tspan data-lang-en>Boundary in datacenter</tspan>
        <tspan data-lang-vi>Ranh giới nằm ở datacenter</tspan>
      </text>

      <path d={b1b.line} class="unb-dashed" />
      <polygon points={b1b.head} class="unb-head" />

      <rect x="485" y="120" width="175" height="52" rx="4" class="unb-box" />
      <text x="572.5" y="143" text-anchor="middle" class="unb-in-b">
        <tspan data-lang-en>Network query</tspan>
        <tspan data-lang-vi>Truy vấn mạng</tspan>
      </text>
      <text x="572.5" y="162" text-anchor="middle" class="unb-in-m">
        <tspan data-lang-en>lazy request on read</tspan>
        <tspan data-lang-vi>gửi khi người dùng hỏi</tspan>
      </text>

      <path d={b1c.line} class="unb-dashed" />
      <polygon points={b1c.head} class="unb-head" />

      <rect x="706" y="120" width="174" height="52" rx="4" class="unb-box" />
      <text x="793" y="143" text-anchor="middle" class="unb-in-b">
        <tspan data-lang-en>Browser screen</tspan>
        <tspan data-lang-vi>Màn hình trình duyệt</tspan>
      </text>
      <text x="793" y="162" text-anchor="middle" class="unb-in-m">
        <tspan data-lang-en>stale without reload</tspan>
        <tspan data-lang-vi>cũ nếu không reload</tspan>
      </text>

      <line x1="20" y1="224" x2={W - 20} y2="224" class="unb-rule" />

      {/* Band 2: Boundary pushed to device */}
      <text x="20" y="256" class="unb-lane-h">
        <tspan data-lang-en>2. Boundary pushed to the device (local-first and sync engines)</tspan>
        <tspan data-lang-vi>2. Ranh giới đẩy xuống tận thiết bị (local-first và sync engine)</tspan>
      </text>
      <text x="20" y="276" class="unb-lane-sub">
        <tspan data-lang-en>Write path extends over SSE or WebSockets by log offset; UI reads local storage even offline.</tspan>
        <tspan data-lang-vi>Đường ghi vươn tới máy khách qua SSE hoặc WebSocket theo offset; UI đọc cục bộ cả khi mất mạng.</tspan>
      </text>

      <rect x="20" y="292" width="150" height="52" rx="4" class="unb-box" />
      <text x="95" y="315" text-anchor="middle" class="unb-in-b">
        <tspan data-lang-en>Write event</tspan>
        <tspan data-lang-vi>Sự kiện ghi</tspan>
      </text>
      <text x="95" y="334" text-anchor="middle" class="unb-in-m">
        <tspan data-lang-en>other device / API</tspan>
        <tspan data-lang-vi>thiết bị khác / API</tspan>
      </text>

      <path d={b2a.line} class="unb-solid" />
      <polygon points={b2a.head} class="unb-head" />

      <rect x="205" y="292" width="195" height="52" rx="4" class="unb-box" />
      <text x="302.5" y="315" text-anchor="middle" class="unb-in-b">
        <tspan data-lang-en>Log + stream push</tspan>
        <tspan data-lang-vi>Log + đẩy qua stream</tspan>
      </text>
      <text x="302.5" y="334" text-anchor="middle" class="unb-in-m">
        <tspan data-lang-en>SSE / WebSocket / offset</tspan>
        <tspan data-lang-vi>SSE / WebSocket / offset</tspan>
      </text>

      <path d={b2b.line} class="unb-solid is-hot" />
      <polygon points={b2b.head} class="unb-head is-hot" />

      <rect x="465" y="292" width="215" height="52" rx="4" class="unb-box is-hot" />
      <text x="572.5" y="315" text-anchor="middle" class="unb-in-b">
        <tspan data-lang-en>Local store on device</tspan>
        <tspan data-lang-vi>Kho cục bộ trên máy</tspan>
      </text>
      <text x="572.5" y="334" text-anchor="middle" class="unb-in-m">
        <tspan data-lang-en>offline-capable replica</tspan>
        <tspan data-lang-vi>bản sao chạy được offline</tspan>
      </text>

      <line x1="702" y1="286" x2="702" y2="352" class="unb-boundary" />
      <text x="702" y="372" text-anchor="middle" class="unb-boundary-lbl">
        <tspan data-lang-en>Boundary on user device</tspan>
        <tspan data-lang-vi>Ranh giới ngay trên thiết bị</tspan>
      </text>

      <path d={b2c.line} class="unb-dashed" />
      <polygon points={b2c.head} class="unb-head" />

      <rect x="725" y="292" width="155" height="52" rx="4" class="unb-box" />
      <text x="802.5" y="315" text-anchor="middle" class="unb-in-b">
        <tspan data-lang-en>Pixels on screen</tspan>
        <tspan data-lang-vi>Hiển thị tức thì</tspan>
      </text>
      <text x="802.5" y="334" text-anchor="middle" class="unb-in-m">
        <tspan data-lang-en>0 ms network wait</tspan>
        <tspan data-lang-vi>không chờ mạng</tspan>
      </text>

      <line x1="20" y1="398" x2={W - 20} y2="398" class="unb-rule" />

      {/* Band 3: Reads as events */}
      <text x="20" y="430" class="unb-lane-h">
        <tspan data-lang-en>3. Reads are events too (stream-table join)</tspan>
        <tspan data-lang-vi>3. Coi lệnh đọc như sự kiện (stream-table join)</tspan>
      </text>
      <text x="20" y="450" class="unb-lane-sub">
        <tspan data-lang-en>Route writes and read queries by key to the same shard: a one-off read forgets; a subscribe stays.</tspan>
        <tspan data-lang-vi>Định tuyến cả ghi và đọc theo khoá tới cùng shard: đọc một lần rồi quên; subscribe là join giữ mãi.</tspan>
      </text>

      <rect x="20" y="472" width="230" height="44" rx="4" class="unb-box" />
      <text x="135" y="499" text-anchor="middle" class="unb-in-b">
        <tspan data-lang-en>Write stream (by key)</tspan>
        <tspan data-lang-vi>Luồng ghi (theo khoá)</tspan>
      </text>

      <rect x="20" y="532" width="230" height="44" rx="4" class="unb-box" />
      <text x="135" y="559" text-anchor="middle" class="unb-in-b">
        <tspan data-lang-en>Read query stream (by key)</tspan>
        <tspan data-lang-vi>Luồng truy vấn đọc (theo khoá)</tspan>
      </text>

      <path d={b3top.line} class="unb-solid" />
      <polygon points={b3top.head} class="unb-head" />
      <path d={b3bot.line} class="unb-dashed" />
      <polygon points={b3bot.head} class="unb-head" />

      <rect x="330" y="486" width="270" height="74" rx="4" class="unb-box" />
      <text x="465" y="516" text-anchor="middle" class="unb-in-b">
        <tspan data-lang-en>Co-partitioned processor</tspan>
        <tspan data-lang-vi>Processor đồng phân vùng</tspan>
      </text>
      <text x="465" y="538" text-anchor="middle" class="unb-in-m">
        <tspan data-lang-en>joins query stream with shard state</tspan>
        <tspan data-lang-vi>join luồng đọc với trạng thái shard</tspan>
      </text>

      <path d={b3out.line} class="unb-dashed" />
      <polygon points={b3out.head} class="unb-head" />

      <rect x="655" y="492" width="225" height="62" rx="4" class="unb-box" />
      <text x="767.5" y="518" text-anchor="middle" class="unb-in-b">
        <tspan data-lang-en>Response / live stream</tspan>
        <tspan data-lang-vi>Kết quả / luồng theo dõi</tspan>
      </text>
      <text x="767.5" y="540" text-anchor="middle" class="unb-in-m">
        <tspan data-lang-en>one-off reply or standing query</tspan>
        <tspan data-lang-vi>trả một lần hoặc liên tục</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Indexes, caches and materialized views are not fixed boxes—they move the line between eager precomputation and lazy work on read. Extending that eager write path onto user devices turns the browser UI into a live view of an event log.</span>
    <span data-lang-vi>Index, cache và materialized view đều làm cùng một việc: dời ranh giới giữa phần tính sẵn khi ghi và phần tính khi đọc. Đẩy hẳn đường ghi này xuống tận thiết bị biến giao diện trình duyệt thành một khung nhìn sống động theo log sự kiện.</span>
  </figcaption>
</figure>

<style>
  .unb-fig {
    margin: 2em 0;
    width: 100%;
  }
  .unb-scroll {
    overflow-x: auto;
  }
  .unb-fig svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .unb-fig text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .unb-fig .unb-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .unb-fig .unb-sub {
    font-size: 13.5px;
    fill: var(--text-muted);
  }
  .unb-fig .unb-lane-h {
    font-size: 14.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .unb-fig .unb-lane-sub {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .unb-rule {
    stroke: var(--border);
  }
  .unb-box {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .unb-box.is-hot {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .unb-fig .unb-in-b {
    font-weight: 700;
    fill: var(--text);
    font-size: 13.5px;
  }
  .unb-fig .unb-in-m {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .unb-boundary {
    stroke: var(--red);
    stroke-width: 1.6;
    stroke-dasharray: 5 4;
  }
  .unb-fig .unb-boundary-lbl {
    font-size: 12.5px;
    font-weight: 700;
    fill: var(--red);
  }
  .unb-solid {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.8;
  }
  .unb-solid.is-hot {
    stroke: var(--red);
    stroke-width: 2;
  }
  .unb-dashed {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.4;
    stroke-dasharray: 5 4;
  }
  .unb-head {
    fill: var(--text-muted);
  }
  .unb-head.is-hot {
    fill: var(--red);
  }
  .unb-fig figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
