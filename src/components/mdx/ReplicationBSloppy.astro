---
// Dynamo's sloppy quorum and hinted handoff, using the paper's example: node A is down.
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Arrow from './ReplicationBArrow.astro';
import Bi from './ReplicationBBi.astro';
---
<Frame h={310}
  label="A write meant for nodes A, B and C. Node A is down. The coordinator writes to the first three healthy nodes: B, C and D. Node D stores it with a hint that it belongs to A. When A recovers, D hands the data over and deletes its copy."
  cap="The write succeeds even though A is down, because D stands in. The hint is what lets D give the data back."
  capVi="Lần ghi vẫn thành công dù A hỏng, vì D đứng ra thay. Gợi ý (hint) là thứ giúp D trả dữ liệu lại cho A.">
  <Node x={340} y={10} w={220} h={56} icon="laptop" t="Coordinator" tv="Coordinator" s="first 3 healthy nodes" sv="3 node khoẻ đầu tiên" />
  <text x="580" y="42" class="rb-step"><Bi en="1. write for A, B and C" vi="1. ghi cho A, B và C" /></text>
  <Arrow x1={400} y1={66} x2={107} y2={150} cls="red" />
  <Arrow x1={430} y1={66} x2={337} y2={150} />
  <Arrow x1={470} y1={66} x2={567} y2={150} />
  <Arrow x1={500} y1={66} x2={797} y2={150} cls="gold" />
  <Node x={15} y={150} w={185} h={84} icon="db" t="Node A" tv="Node A" s="down" sv="đã hỏng" cls="red" />
  <Node x={245} y={150} w={185} h={84} icon="db" t="Node B" tv="Node B" s="stores the write" sv="lưu lần ghi" />
  <Node x={475} y={150} w={185} h={84} icon="db" t="Node C" tv="Node C" s="stores the write" sv="lưu lần ghi" />
  <Node x={705} y={150} w={185} h={84} icon="db" t="Node D" tv="Node D" s="stores it with a hint" sv="lưu kèm hint" s2="hint: this is for A" s2v="hint: dành cho A" cls="gold" />
  <line x1="797" y1="234" x2="797" y2="272" class="rb-edge gold" />
  <line x1="797" y1="272" x2="107" y2="272" class="rb-edge gold" />
  <Arrow x1={107} y1={272} x2={107} y2={236} cls="gold" />
  <text x="460" y="264" text-anchor="middle" class="rb-step"><Bi en="2. when A is back, D hands the data over and deletes its copy" vi="2. khi A sống lại, D giao dữ liệu rồi xoá bản của mình" /></text>
</Frame>
