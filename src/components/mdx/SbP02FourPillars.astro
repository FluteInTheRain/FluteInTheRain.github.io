---
// Four institutions behind every Vietnamese brokerage app:
// You -> Broker (CTCK) -> Exchange (HOSE/HNX) -> VSDC, supervised by SSC.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 310;

const NODES = [
  { x: 110, icon: 'user', en: 'You', vi: 'Bạn', subEn: 'investor app', subVi: 'app giao dịch', accent: false },
  { x: 325, icon: 'phone', en: 'Broker (CTCK)', vi: 'CTCK', subEn: 'routes orders, holds cash', subVi: 'chuyển lệnh, giữ tiền', accent: false },
  { x: 545, icon: 'server', en: 'HOSE / HNX', vi: 'HOSE / HNX', subEn: 'matches buyers & sellers', subVi: 'khớp lệnh mua – bán', accent: false },
  { x: 775, icon: 'shield', en: 'VSDC', vi: 'VSDC', subEn: 'holds your shares', subVi: 'giữ sổ sở hữu CP', accent: true },
] as const;

const ARROWS = [
  { x1: 158, x2: 277, en: 'order + cash check', vi: 'lệnh + kiểm tra tiền' },
  { x1: 373, x2: 497, en: 'routed trade', vi: 'đưa lệnh lên sàn' },
  { x1: 593, x2: 727, en: 'title recorded', vi: 'ghi nhận sở hữu' },
] as const;
---
<figure class="sbp2-pillars">
  <div class="sbp2-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four institutions behind your trading app: Broker routes orders, HOSE or HNX matches them, VSDC holds share ownership records, and SSC supervises all of them.">
      <text x="20" y="30" class="sbp2-title">
        <tspan data-lang-en>Four hands behind one tap on your phone</tspan>
        <tspan data-lang-vi>Bốn đơn vị đứng sau một lần bấm trên điện thoại</tspan>
      </text>

      {/* SSC oversight bar at top */}
      <rect x="235" y="54" width="610" height="44" rx="8" class="sbp2-ssc-box" />
      <DiagramIcon name="scale" x={265} y={76} size={24} />
      <text x="292" y="81" class="sbp2-ssc-txt">
        <tspan data-lang-en>SSC (State Securities Commission) — licenses brokers and enforces market rules</tspan>
        <tspan data-lang-vi>UBCKNN — cấp phép công ty chứng khoán và giám sát luật chơi</tspan>
      </text>

      {/* vertical dashed supervision lines */}
      <line x1="325" y1="98" x2="325" y2="144" class="sbp2-dash" />
      <line x1="545" y1="98" x2="545" y2="144" class="sbp2-dash" />
      <line x1="775" y1="98" x2="775" y2="144" class="sbp2-dash" />

      {/* main 4 nodes */}
      {NODES.map((n) => (
        <g>
          <rect
            x={n.x - 76}
            y="148"
            width="152"
            height="112"
            rx="10"
            class={n.accent ? 'sbp2-box sbp2-box-red fm-glow' : 'sbp2-box'}
          />
          <DiagramIcon name={n.icon} x={n.x} y={182} size={30} />
          <text x={n.x} y="220" text-anchor="middle" class={n.accent ? 'sbp2-node sbp2-red' : 'sbp2-node'}>
            <tspan data-lang-en>{n.en}</tspan>
            <tspan data-lang-vi>{n.vi}</tspan>
          </text>
          <text x={n.x} y="242" text-anchor="middle" class="sbp2-sub">
            <tspan data-lang-en>{n.subEn}</tspan>
            <tspan data-lang-vi>{n.subVi}</tspan>
          </text>
        </g>
      ))}

      {/* connecting arrows */}
      {ARROWS.map((a, idx) => (
        <g>
          <line
            x1={a.x1 + 28}
            y1="204"
            x2={a.x2 - 36}
            y2="204"
            class={idx === 1 ? 'sbp2-arrow fm-flow' : 'sbp2-arrow'}
          />
          <polygon
            points={`${a.x2 - 28},204 ${a.x2 - 38},199 ${a.x2 - 38},209`}
            class="sbp2-head"
          />
          <text x={(a.x1 + a.x2) / 2} y="284" text-anchor="middle" class="sbp2-sub">
            <tspan data-lang-en>{a.en}</tspan>
            <tspan data-lang-vi>{a.vi}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Your app is only the front door. The broker checks cash and routes orders; HOSE or HNX matches them; VSDC keeps the central book-entry ledger of every share you own, all under SSC supervision.</span>
    <span data-lang-vi>App chỉ là cửa trước. CTCK kiểm tra tiền và đẩy lệnh; HOSE hoặc HNX khớp lệnh; còn VSDC mới là nơi giữ sổ gốc ghi tên bạn là chủ cổ phiếu, dưới sự giám sát của UBCKNN.</span>
  </figcaption>
</figure>

<style>
  .sbp2-pillars { margin: 2em 0; width: 100%; }
  .sbp2-scroll { overflow-x: auto; }
  .sbp2-pillars svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sbp2-pillars text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .sbp2-title { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sbp2-ssc-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .sbp2-ssc-txt { font-size: 13.5px; font-weight: 600; fill: var(--text); }
  .sbp2-dash { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .sbp2-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .sbp2-box-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .sbp2-node { font-size: 15px; font-weight: 700; fill: var(--text); }
  .sbp2-red { fill: var(--red); }
  .sbp2-sub { font-size: 12.5px; fill: var(--text-muted); }
  .sbp2-arrow { stroke: var(--text-muted); stroke-width: 1.6; }
  .sbp2-head { fill: var(--text-muted); }
  .sbp2-pillars figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
