---
// Order of attack: do less work, then reduce, reuse, recycle. Each row names the case-study change
// that belongs to it. Numbers come from the post's benchstat runs (Apple M2, Go 1.27.1, 1,000,000 lines).
const W = 900;
const top = 56;
const rowH = 100;
const rows = [
  {
    n: '0',
    name: 'Do less work',
    nameVi: 'Làm ít việc hơn',
    q: 'Is all of this work needed?',
    qVi: 'Có cần hết chừng này việc không?',
    a: 'Sum2 stops building a list of 1,000,000 lines.',
    aVi: 'Sum2 thôi dựng danh sách 1.000.000 dòng.',
    b: 'Sum4 drops the checks it never needs.',
    bVi: 'Sum4 bỏ những phép kiểm tra không cần.',
    r: '52.07 ms to 14.36 ms',
    rVi: '52,07 ms xuống 14,36 ms',
    r2: 'Sum1 to Sum4',
    r2Vi: 'Từ Sum1 đến Sum4',
    risk: 'none',
  },
  {
    n: '1',
    name: 'Reduce',
    nameVi: 'Giảm',
    q: 'Can the work allocate less?',
    qVi: 'Có cấp phát ít hơn được không?',
    a: 'Scan the bytes in place, no slice of lines.',
    aVi: 'Quét thẳng trên byte, không tạo slice các dòng.',
    b: 'Sum1 to Sum2.',
    bVi: 'Từ Sum1 sang Sum2.',
    r: '29.9 MiB to 7.0 MiB',
    rVi: '29,9 MiB xuống 7,0 MiB',
    r2: 'memory per call',
    r2Vi: 'bộ nhớ mỗi lần gọi',
    risk: 'low',
  },
  {
    n: '2',
    name: 'Reuse',
    nameVi: 'Dùng lại',
    q: 'Can one piece of memory serve many times?',
    qVi: 'Một vùng nhớ có phục vụ được nhiều lần không?',
    a: 'Sum6 reads the file through one 8 KiB buffer.',
    aVi: 'Sum6 đọc file qua một buffer 8 KiB.',
    b: 'You pass the buffer in, you own it.',
    bVi: 'Bạn truyền buffer vào, bạn giữ nó.',
    r: '7.0 MiB to 8.2 KiB',
    rVi: '7,0 MiB xuống 8,2 KiB',
    r2: 'memory per call',
    r2Vi: 'bộ nhớ mỗi lần gọi',
    risk: 'medium',
  },
  {
    n: '3',
    name: 'Recycle',
    nameVi: 'Tái chế',
    q: 'Can a shared pool hand it back?',
    qVi: 'Một pool dùng chung có trả lại được không?',
    a: 'Sum6Pool borrows the buffer from a sync.Pool.',
    aVi: 'Sum6Pool mượn buffer từ một sync.Pool.',
    b: 'Many goroutines, short-lived buffers.',
    bVi: 'Nhiều goroutine, buffer sống ngắn.',
    r: '8,376 B to 185 B',
    rVi: '8.376 B xuống 185 B',
    r2: 'memory per call, 2.4% faster',
    r2Vi: 'bộ nhớ mỗi lần gọi, nhanh hơn 2,4%',
    risk: 'high',
  },
];
const H = top + rows.length * rowH + 16;
const xName = 60;
const xQ = 200;
const xR = 640;
---
<figure class="gp19a">
  <div class="gp19a-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four steps in order: do less work, reduce, reuse, recycle. Each row shows the question to ask and the change in the Sum case study that answers it.">
    <text x="20" y="24" class="h">
      <tspan data-lang-en>Try the steps in this order</tspan>
      <tspan data-lang-vi>Thử các bước theo thứ tự này</tspan>
    </text>
    <text x={xName} y={top - 12} class="m">
      <tspan data-lang-en>Step</tspan>
      <tspan data-lang-vi>Bước</tspan>
    </text>
    <text x={xQ} y={top - 12} class="m">
      <tspan data-lang-en>Question to ask, then the change in the Sum case study</tspan>
      <tspan data-lang-vi>Câu hỏi cần đặt, rồi thay đổi trong bài toán Sum</tspan>
    </text>
    <text x={xR} y={top - 12} class="m">
      <tspan data-lang-en>Measured</tspan>
      <tspan data-lang-vi>Số đo</tspan>
    </text>
    {rows.map((r, i) => {
      const y = top + i * rowH;
      const cls = r.risk === 'high' ? 'card bad' : 'card';
      return (
        <g>
          <rect x="20" y={y} width={W - 40} height={rowH - 12} rx="8" class={cls} />
          <circle cx="38" cy={y + (rowH - 12) / 2} r="11" class="dot" />
          <text x="38" y={y + (rowH - 12) / 2 + 5} text-anchor="middle" class="b num">{r.n}</text>
          <text x={xName} y={y + (rowH - 12) / 2 + 5} class="b">
            <tspan data-lang-en>{r.name}</tspan>
            <tspan data-lang-vi>{r.nameVi}</tspan>
          </text>
          <text x={xQ} y={y + 28} class="b">
            <tspan data-lang-en>{r.q}</tspan>
            <tspan data-lang-vi>{r.qVi}</tspan>
          </text>
          <text x={xQ} y={y + 48} class="m">
            <tspan data-lang-en>{r.a}</tspan>
            <tspan data-lang-vi>{r.aVi}</tspan>
          </text>
          <text x={xQ} y={y + 68} class="m">
            <tspan data-lang-en>{r.b}</tspan>
            <tspan data-lang-vi>{r.bVi}</tspan>
          </text>
          <text x={xR} y={y + 38} class="b num">
            <tspan data-lang-en>{r.r}</tspan>
            <tspan data-lang-vi>{r.rVi}</tspan>
          </text>
          <text x={xR} y={y + 58} class="m">
            <tspan data-lang-en>{r.r2}</tspan>
            <tspan data-lang-vi>{r.r2Vi}</tspan>
          </text>
        </g>
      );
    })}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Each step costs more care than the one above it: step 0 is free, step 3 can quietly make things worse. The numbers are the medians from this post's benchstat tables.</span>
    <span data-lang-vi>Mỗi bước đòi hỏi cẩn thận hơn bước phía trên: bước 0 không tốn gì, bước 3 có thể âm thầm làm mọi thứ tệ đi. Các số là trung vị trong bảng benchstat của bài này.</span>
  </figcaption>
</figure>

<style>
  .gp19a { margin: 2em 0; width: 100%; }
  .gp19a-scroll { overflow-x: auto; }
  .gp19a svg { display: block; width: 100%; min-width: 760px; height: auto; }
  .gp19a text { font-size: 14px; fill: var(--text-body); }
  .gp19a .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp19a .b { font-weight: 700; fill: var(--text); }
  .gp19a .m { fill: var(--text-muted); }
  .gp19a .body { fill: var(--text-body); }
  .gp19a .num { font-variant-numeric: tabular-nums; }
  .gp19a .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .gp19a .card.bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp19a .dot { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp19a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
