---
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 352;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
---
<figure class="dpt">
  <div class="dpt-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Timeline with three lanes. The old leader thread checks that its lease is valid, then freezes for 15 seconds. During the freeze the lease expires and the lock service elects a new leader. The thread wakes up, still believes it is the leader, and sends a stale write to storage.">
      <text x="20" y="24" class="t-h" data-lang-en>The lease check passes, then the thread freezes before it acts</text><text x="20" y="24" class="t-h" data-lang-vi>Kiểm tra lease xong, luồng khựng lại trước khi kịp hành động</text>
      <DiagramIcon name="lock" x={36} y={58} size={26} />
      <text x="20" y="84" class="t-b" data-lang-en>Lock service</text><text x="20" y="84" class="t-b" data-lang-vi>Lock service</text>
      <DiagramIcon name="worker" x={36} y={148} size={26} />
      <text x="20" y="174" class="t-b" data-lang-en>Old leader thread</text><text x="20" y="174" class="t-b" data-lang-vi>Luồng leader cũ</text>
      <DiagramIcon name="db" x={36} y={238} size={26} />
      <text x="20" y="264" class="t-b" data-lang-en>Storage</text><text x="20" y="264" class="t-b" data-lang-vi>Storage</text>
      <line x1="150" x2="880" y1="80" y2="80" class="ln-g" />
      <line x1="150" x2="880" y1="170" y2="170" class="ln-g" />
      <line x1="150" x2="880" y1="260" y2="260" class="ln-g" />
      <rect x="160" y="56" width="200" height="48" rx="6" class="box" />
      <text x="260" y="84" text-anchor="middle" class="t-m" data-lang-en>lease held by old leader</text><text x="260" y="84" text-anchor="middle" class="t-m" data-lang-vi>lease thuộc leader cũ</text>
      <rect x="370" y="56" width="220" height="48" rx="6" class="box" />
      <text x="480" y="84" text-anchor="middle" class="t-b" data-lang-en>lease expired, new leader</text><text x="480" y="84" text-anchor="middle" class="t-b" data-lang-vi>lease hết hạn, có leader mới</text>
      <rect x="160" y="146" width="200" height="48" rx="6" class="box" />
      <text x="260" y="174" text-anchor="middle" class="t-b" data-lang-en>lease.isValid() is true</text><text x="260" y="174" text-anchor="middle" class="t-b" data-lang-vi>lease.isValid() là true</text>
      <rect x="370" y="146" width="220" height="48" rx="6" class="box-d" />
      <text x="480" y="174" text-anchor="middle" class="t-m" data-lang-en>frozen 15 s (GC, VM, disk)</text><text x="480" y="174" text-anchor="middle" class="t-m" data-lang-vi>khựng 15 giây (GC, VM, đĩa)</text>
      <rect x="600" y="146" width="280" height="48" rx="6" class="box-r" />
      <text x="740" y="166" text-anchor="middle" class="t-r" data-lang-en>process(request) runs,</text><text x="740" y="166" text-anchor="middle" class="t-r" data-lang-vi>process(request) vẫn chạy,</text>
      <text x="740" y="182" text-anchor="middle" class="t-r" data-lang-en>still thinks it leads</text><text x="740" y="182" text-anchor="middle" class="t-r" data-lang-vi>tưởng mình còn là leader</text>
      <rect x="600" y="236" width="280" height="48" rx="6" class="box-r" />
      <text x="740" y="256" text-anchor="middle" class="t-r" data-lang-en>stale write lands next to</text><text x="740" y="256" text-anchor="middle" class="t-r" data-lang-vi>lệnh ghi cũ rơi cạnh dữ liệu</text>
      <text x="740" y="272" text-anchor="middle" class="t-r" data-lang-en>the new leader's data</text><text x="740" y="272" text-anchor="middle" class="t-r" data-lang-vi>của leader mới</text>
      <path d="M 740 194 L 740.0 230.0" class="ln-r" /><polygon points="740,236 736.5,228.8 743.5,228.8" class="hd-r" />
      <line x1="365" x2="365" y1="108" y2="142" class="ln-d" />
      <path d="M 160 322 L 874.0 322.0" class="ln" /><polygon points="880,322 872.8,325.5 872.8,318.5" class="hd" />
      <text x="160" y="344" class="t-m" data-lang-en>time</text><text x="160" y="344" class="t-m" data-lang-vi>thời gian</text>
      <text x="880" y="344" text-anchor="end" class="t-m" data-lang-en>Nothing between the check and the action is guaranteed to run promptly.</text><text x="880" y="344" text-anchor="end" class="t-m" data-lang-vi>Không gì đảm bảo đoạn giữa lúc kiểm tra và lúc hành động chạy liền mạch.</text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The check and the write are two separate moments. A pause between them is invisible to the thread that was paused.</span>
    <span data-lang-vi>Kiểm tra và ghi là hai thời điểm khác nhau. Một cú khựng ở giữa là vô hình với chính luồng bị khựng.</span>
  </figcaption>
</figure>

<style>
  .dpt { margin: 2em 0; width: 100%; }
  .dpt-scroll { overflow-x: auto; }
  .dpt svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dpt text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .dpt .t-h { font-size: 15.5px; font-weight: 700; fill: var(--text); }
  .dpt .t-b { font-weight: 700; fill: var(--text); }
  .dpt .t-r { font-weight: 700; fill: var(--red); }
  .dpt .t-m { fill: var(--text-muted); font-size: 12.5px; }
  .dpt .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .dpt .box-r { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dpt .box-d { fill: transparent; stroke: var(--border); stroke-dasharray: 5 4; stroke-width: 1.2; }
  .dpt .box-q { fill: transparent; stroke: var(--text-muted); stroke-dasharray: 2 4; stroke-width: 1.4; }
  .dpt .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .dpt .ln-r { fill: none; stroke: var(--red); stroke-width: 2; }
  .dpt .ln-d { fill: none; stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .dpt .ln-g { fill: none; stroke: var(--border); stroke-dasharray: 2 4; }
  .dpt .hd { fill: var(--text-muted); }
  .dpt .hd-r { fill: var(--red); }
  .dpt figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
