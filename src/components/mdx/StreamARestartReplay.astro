---
// At-least-once on restart: the consumer saved offset 100, processed 101-105, crashed before saving, then replays 101-105.
// Offsets match the callout in the post; they are an illustrative example.
import DiagramIcon from './DiagramIcon.astro';
import StreamAFrame from './StreamAFrame.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    h: 'Crash and restart: offsets 101 to 105 run twice',
    r1: 'Before the crash', r2: 'After the restart',
    saved: 'last saved', done: 'done, not saved', again: 'processed again', from: 'resume after this',
    crash: 'crash',
    restart: 'Restart: the new worker resumes from the last saved offset, 100',
    res: 'Result: at-least-once. Writes triggered by 101 to 105 must be safe to repeat (idempotent).',
    alt: 'Top row, before the crash: offset 100 is saved, offsets 101 to 105 are processed but not saved, then the worker crashes. Bottom row, after the restart: the new worker resumes after offset 100, so offsets 101 to 105 are processed a second time.',
    cap: 'The consumer only saves one number. If it dies before saving, the safest choice is to repeat work, never to skip it.',
  },
  vi: {
    h: 'Sập rồi khởi động lại: offset 101 đến 105 chạy hai lần',
    r1: 'Trước khi sập', r2: 'Sau khi khởi động lại',
    saved: 'đã lưu cuối', done: 'xong, chưa lưu', again: 'xử lý lại', from: 'chạy tiếp từ sau đây',
    crash: 'sập',
    restart: 'Khởi động lại: worker mới chạy tiếp từ offset đã lưu cuối cùng, 100',
    res: 'Kết quả: at-least-once. Thao tác ghi do 101 đến 105 sinh ra phải an toàn khi lặp lại (idempotent).',
    alt: 'Hàng trên, trước khi sập: offset 100 đã lưu, offset 101 đến 105 đã xử lý nhưng chưa lưu, rồi worker sập. Hàng dưới, sau khi khởi động lại: worker mới chạy tiếp sau offset 100 nên offset 101 đến 105 bị xử lý lần thứ hai.',
    cap: 'Consumer chỉ lưu một con số. Nếu chết trước khi lưu, lựa chọn an toàn là làm lại, không bao giờ bỏ qua.',
  },
}[lang];
const offs = [100, 101, 102, 103, 104, 105];
const cx = (i: number) => 30 + i * 130;
---
<StreamAFrame h={322} alt={T.alt} cap={T.cap} title={T.h}>
  <text x="30" y="56" class="name">{T.r1}</text>
  {offs.map((o, i) => (
    <g>
      <g class={i === 0 ? 'box good' : 'box'}>
        <rect x={cx(i)} y="66" width="120" height="44" rx="6" />
        <text x={cx(i) + 60} y="94" text-anchor="middle" class="num">{`offset ${o}`}</text>
      </g>
      <text x={cx(i) + 60} y="128" text-anchor="middle" class="sub">{i === 0 ? T.saved : T.done}</text>
    </g>
  ))}
  <DiagramIcon name="fail" x={850} y={88} size={26} />
  <text x="850" y="118" text-anchor="middle" class="bad">{T.crash}</text>
  <DiagramIcon name="retry" x={42} y={160} size={24} />
  <text x="66" y="165" class="name" style="font-size:13px">{T.restart}</text>
  <text x="30" y="204" class="name">{T.r2}</text>
  {offs.map((o, i) => (
    <g>
      <g class={i === 0 ? 'box good' : 'box off'}>
        <rect x={cx(i)} y="214" width="120" height="44" rx="6" />
        <text x={cx(i) + 60} y="242" text-anchor="middle" class="num">{`offset ${o}`}</text>
      </g>
      <text x={cx(i) + 60} y="276" text-anchor="middle" class={i === 0 ? 'sub' : 'bad'}>{i === 0 ? T.from : T.again}</text>
    </g>
  ))}
  <text x="30" y="306" class="name" style="font-size:13px">{T.res}</text>
</StreamAFrame>
