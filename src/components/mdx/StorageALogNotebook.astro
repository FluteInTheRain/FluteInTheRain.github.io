---
// The simplest database: a log file. Left, a write is one append at the end.
// Right, a lookup scans from the top and keeps the last match. Values are illustrative.
// Plain inline SVG, site tokens, polygon arrowheads, no ids.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 372;
const rows = [
  ['1', 'user7', '555-0101'],
  ['2', 'user42', '555-0142'],
  ['3', 'user7', '555-0199'],
  ['4', 'user9', '555-0109'],
  ['5', 'user42', '555-0177'],
];
const rowH = 28;
const rowGap = 6;
const y0 = 100;
const ry = (i: number) => y0 + i * (rowH + rowGap);
const ax = 20;   // panel A left
const bx = 470;  // panel B left
const rw = 190;  // row width
function arrowRight(x1: number, x2: number, y: number, cls = '') {
  return { line: `M${x1},${y} L${x2 - 7},${y}`, head: `${x2 - 8},${y - 5} ${x2 - 8},${y + 5} ${x2},${y}` };
}
const wA = arrowRight(ax + 56, ax + 84, ry(5) + 14);
const rB = arrowRight(bx + 56, bx + 84, ry(0) + 14);
---
<figure class="lgn">
  <div class="lgn-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A log file with five lines. A write appends one new line at the end, which is cheap. A lookup of user42 reads from line 1 to the last line and keeps the last match, line 5, so the cost grows with the file.">
    <text x={ax} y="24" class="lgn-h">
      <tspan data-lang-en>Write: add a line at the end</tspan>
      <tspan data-lang-vi>Ghi: thêm một dòng ở cuối</tspan>
    </text>
    <text x={ax} y="46" class="lgn-sub">
      <tspan data-lang-en>One append. Nothing already written is touched.</tspan>
      <tspan data-lang-vi>Một lần nối thêm. Thứ đã ghi không bị đụng tới.</tspan>
    </text>
    <text x={bx} y="24" class="lgn-h">
      <tspan data-lang-en>Read: scan from the top</tspan>
      <tspan data-lang-vi>Đọc: quét từ đầu file</tspan>
    </text>
    <text x={bx} y="46" class="lgn-sub">
      <tspan data-lang-en>Look up user42: read every line, keep the last match.</tspan>
      <tspan data-lang-vi>Tra user42: đọc mọi dòng, giữ kết quả khớp cuối.</tspan>
    </text>
    <line x1="445" x2="445" y1="64" y2="340" class="lgn-divider" />

    {/* panel A: write */}
    <DiagramIcon name="laptop" x={ax + 26} y={ry(5) + 14} size={30} />
    <path d={wA.line} class="lgn-arrow is-good" /><polygon points={wA.head} class="lgn-head is-good" />
    <text x={ax + 26} y={ry(5) + 44} text-anchor="middle" class="lgn-small">
      <tspan data-lang-en>app</tspan>
      <tspan data-lang-vi>ứng dụng</tspan>
    </text>
    {rows.map((r, i) => (
      <g>
        <rect x={ax + 90} y={ry(i)} width={rw} height={rowH} rx="3" class="lgn-cell" />
        <text x={ax + 100} y={ry(i) + 19} class="lgn-mono">{r[0]}  {r[1]} = {r[2]}</text>
      </g>
    ))}
    <rect x={ax + 90} y={ry(5)} width={rw} height={rowH} rx="3" class="lgn-cell is-good" />
    <text x={ax + 100} y={ry(5) + 19} class="lgn-mono is-good">6  user9 = 555-0150</text>
    <text x={ax + 90 + rw + 10} y={ry(5) + 19} class="lgn-note is-good">
      <tspan data-lang-en>new line</tspan>
      <tspan data-lang-vi>dòng mới</tspan>
    </text>
    <text x={ax + 90} y={ry(5) + 56} class="lgn-note">
      <tspan data-lang-en>Appending is about the cheapest thing a disk does.</tspan>
      <tspan data-lang-vi>Ghi nối thêm gần như là việc rẻ nhất của ổ đĩa.</tspan>
    </text>

    {/* panel B: read */}
    <DiagramIcon name="laptop" x={bx + 26} y={ry(0) + 14} size={30} />
    <path d={rB.line} class="lgn-arrow is-bad" /><polygon points={rB.head} class="lgn-head is-bad" />
    <text x={bx + 26} y={ry(0) + 44} text-anchor="middle" class="lgn-small">
      <tspan data-lang-en>app</tspan>
      <tspan data-lang-vi>ứng dụng</tspan>
    </text>
    {rows.map((r, i) => (
      <g>
        <rect x={bx + 90} y={ry(i)} width={rw} height={rowH} rx="3" class={i === 4 ? 'lgn-cell is-good' : i === 1 ? 'lgn-cell is-dead' : 'lgn-cell'} />
        <text x={bx + 100} y={ry(i) + 19} class={i === 4 ? 'lgn-mono is-good' : 'lgn-mono'}>{r[0]}  {r[1]} = {r[2]}</text>
      </g>
    ))}
    {/* scan arrow down the right side of the rows */}
    <path d={`M${bx + 90 + rw + 14},${ry(0) + 4} L${bx + 90 + rw + 14},${ry(4) + 14}`} class="lgn-arrow is-bad" />
    <polygon points={`${bx + 90 + rw + 9},${ry(4) + 6} ${bx + 90 + rw + 19},${ry(4) + 6} ${bx + 90 + rw + 14},${ry(4) + 15}`} class="lgn-head is-bad" />
    <text x={bx + 90 + rw + 28} y={ry(0) + 19} class="lgn-note is-bad">
      <tspan data-lang-en>reads all 5 lines</tspan>
      <tspan data-lang-vi>đọc cả 5 dòng</tspan>
    </text>
    <text x={bx + 90 + rw + 28} y={ry(1) + 19} class="lgn-note">
      <tspan data-lang-en>older match</tspan>
      <tspan data-lang-vi>khớp cũ hơn</tspan>
    </text>
    <text x={bx + 90 + rw + 28} y={ry(4) + 19} class="lgn-note is-good">
      <tspan data-lang-en>last match wins</tspan>
      <tspan data-lang-vi>khớp cuối thắng</tspan>
    </text>
    <text x={bx + 90} y={ry(4) + 56} class="lgn-note">
      <tspan data-lang-en>Answer: 555-0177. Double the file, double the work.</tspan>
      <tspan data-lang-vi>Kết quả: 555-0177. File dài gấp đôi, việc gấp đôi.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>A log file in miniature, with made-up phone numbers. The write side is why logs are fast; the read side is why the next section adds an index.</span>
    <span data-lang-vi>File log thu nhỏ, với số điện thoại bịa ra cho dễ theo dõi. Phía ghi là lý do log nhanh; phía đọc là lý do mục sau thêm index.</span>
  </figcaption>
</figure>

<style>
  .lgn { margin: 2em 0; width: 100%; }
  .lgn-scroll { overflow-x: auto; }
  .lgn svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .lgn text { font-size: 14px; fill: var(--text-body); }
  .lgn .lgn-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .lgn .lgn-sub { fill: var(--text-muted); }
  .lgn-rule { stroke: var(--border); }
  .lgn-divider { stroke: var(--border); stroke-dasharray: 6 5; }
  .lgn-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .lgn-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .lgn-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .lgn-cell { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .lgn-cell.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .lgn-cell.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .lgn-cell.is-dead { fill: var(--bg-alt); stroke: var(--text-muted); stroke-dasharray: 3 3; }
  .lgn .lgn-in { font-weight: 600; fill: var(--text); }
  .lgn .lgn-in-b { font-weight: 700; fill: var(--text); }
  .lgn .lgn-in-m { font-size: 13px; fill: var(--text-body); }
  .lgn .lgn-in-s { font-size: 13px; font-weight: 600; fill: var(--text); }
  .lgn .lgn-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; fill: var(--text-body); }
  .lgn .lgn-mono.is-good { fill: var(--gold-icon); font-weight: 700; }
  .lgn .lgn-mono.is-bad { fill: var(--red); font-weight: 700; }
  .lgn .lgn-note { font-size: 13px; fill: var(--text-muted); }
  .lgn .lgn-note.is-good { fill: var(--gold-icon); font-weight: 700; }
  .lgn .lgn-note.is-bad { fill: var(--red); font-weight: 700; }
  .lgn .lgn-small { font-size: 12px; fill: var(--text-muted); }
  .lgn .lgn-num { font-size: 12px; font-weight: 700; fill: var(--text); }
  .lgn-circle { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .lgn-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .lgn-arrow.is-good { stroke: var(--gold-icon); stroke-width: 1.8; }
  .lgn-arrow.is-bad { stroke: var(--red); stroke-width: 1.8; }
  .lgn-head { fill: var(--text-muted); }
  .lgn-head.is-good { fill: var(--gold-icon); }
  .lgn-head.is-bad { fill: var(--red); }
  .lgn figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
