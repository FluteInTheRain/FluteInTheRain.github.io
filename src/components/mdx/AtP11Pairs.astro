---
// Eight stocks: all 28 pairs as edges versus the 7 edges of a spanning tree; and the same counts for N = 100.
// Counts: n(n-1)/2, n-1, 3(n-2) (Python: comb(100,2)=4950, 99, 294; 4950/294 = 16.8).
const W = 900, H = 400;
const ring = (cx: number, cy: number, r: number, n: number) => Array.from({ length: n }, (_, i) => {
  const a = -Math.PI / 2 + (2 * Math.PI * i) / n;
  return [cx + r * Math.cos(a), cy + r * Math.sin(a)] as [number, number];
});
const full = ring(190, 190, 120, 8);
const fullEdges: [number, number][] = [];
for (let i = 0; i < 8; i++) for (let j = i + 1; j < 8; j++) fullEdges.push([i, j]);
// a tree on the same 8 nodes at the right
const tp: [number, number][] = [[560, 90], [470, 170], [650, 170], [420, 260], [520, 260], [610, 260], [700, 260], [560, 335]];
const te: [number, number][] = [[0, 1], [0, 2], [1, 3], [1, 4], [2, 5], [2, 6], [4, 7]];
const bars = [
  { en: 'All pairs', vi: 'Mọi cặp', v: 4950, cls: 'a' },
  { en: 'Planar filter (PMFG)', vi: 'Lọc phẳng (PMFG)', v: 294, cls: 'b' },
  { en: 'Spanning tree (MST)', vi: 'Cây khung (MST)', v: 99, cls: 'c' },
];
---
<figure class="atp11-pr">
  <div class="atp11-pr-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: eight stocks joined by all 28 pairs, a tangle. Middle: the same eight stocks joined by a tree of 7 edges. Right: for 100 stocks the full graph has 4,950 edges, a planar filter keeps 294 and a spanning tree keeps 99.">
      <text x="20" y="26" class="h"><tspan data-lang-en>Why filter the graph: 8 stocks, then 100</tspan><tspan data-lang-vi>Vì sao phải lọc đồ thị: 8 mã, rồi 100 mã</tspan></text>
      {fullEdges.map(([a, b]) => <line x1={full[a][0]} y1={full[a][1]} x2={full[b][0]} y2={full[b][1]} class="e-full" />)}
      {full.map(([x, y]) => <circle cx={x} cy={y} r="7" class="n" />)}
      <text x="190" y="346" class="cap" text-anchor="middle"><tspan data-lang-en>every pair: 28 edges</tspan><tspan data-lang-vi>mọi cặp: 28 cạnh</tspan></text>
      {te.map(([a, b]) => <line x1={tp[a][0]} y1={tp[a][1]} x2={tp[b][0]} y2={tp[b][1]} class="e-tree" />)}
      {tp.map(([x, y]) => <circle cx={x} cy={y} r="7" class="n n-t" />)}
      <text x="560" y="382" class="cap" text-anchor="middle"><tspan data-lang-en>spanning tree: 7 edges</tspan><tspan data-lang-vi>cây khung: 7 cạnh</tspan></text>
      <text x="730" y="60" class="sh"><tspan data-lang-en>Edges when N = 100</tspan><tspan data-lang-vi>Số cạnh khi N = 100</tspan></text>
      {bars.map((b, i) => {
        const w = Math.max(3, (b.v / 4950) * 80);
        return (
          <g>
            <text x="730" y={92 + i * 62} class="bl"><tspan data-lang-en>{b.en}</tspan><tspan data-lang-vi>{b.vi}</tspan></text>
            <rect x="730" y={100 + i * 62} width={w} height="14" rx="3" class={`bar bar-${b.cls}`} />
            <text x={730 + w + 6} y={112 + i * 62} class="bv"><tspan data-lang-en>{b.v.toLocaleString('en-US')}</tspan><tspan data-lang-vi>{b.v.toLocaleString('en-US').replace(',', '.')}</tspan></text>
          </g>
        );
      })}
      <text x="730" y="278" class="cap2">PMFG = 3(N−2)</text><text x="730" y="296" class="cap2">MST = N−1</text>
      <text x="730" y="318" class="cap2"><tspan data-lang-en>4,950 → 294</tspan><tspan data-lang-vi>4.950 → 294</tspan></text><text x="730" y="336" class="cap2"><tspan data-lang-en>about 17× fewer</tspan><tspan data-lang-vi>ít hơn khoảng 17 lần</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>With 8 stocks the complete graph is already unreadable; with 100 it has 4,950 edges. Filtering keeps the strongest links that still connect everything.</span>
    <span data-lang-vi>Với 8 mã, đồ thị đầy đủ đã rối; với 100 mã nó có 4.950 cạnh. Lọc là giữ lại những mối nối mạnh nhất mà vẫn nối được mọi mã.</span>
  </figcaption>
</figure>
<style>
  .atp11-pr { margin: 2em 0; width: 100%; }
  .atp11-pr-scroll { overflow-x: auto; }
  .atp11-pr svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .atp11-pr text { font-size: 14px; fill: var(--text-body); }
  .atp11-pr .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp11-pr .sh { font-size: 14px; font-weight: 700; fill: var(--text); }
  .atp11-pr .cap { font-size: 13px; fill: var(--text-muted); }
  .atp11-pr .cap2 { font-size: 12.5px; fill: var(--text-muted); }
  .atp11-pr .bl { font-size: 13px; fill: var(--text); }
  .atp11-pr .bv { font-size: 13px; font-weight: 700; fill: var(--text); }
  .atp11-pr .e-full { stroke: var(--text-faint); stroke-width: 1; opacity: 0.55; }
  .atp11-pr .e-tree { stroke: var(--gold-icon); stroke-width: 2.6; }
  .atp11-pr .n { fill: var(--bg-alt); stroke: var(--text); stroke-width: 1.5; }
  .atp11-pr .n-t { stroke: var(--gold-icon); }
  .atp11-pr .bar-a { fill: var(--red); }
  .atp11-pr .bar-b { fill: var(--text-muted); }
  .atp11-pr .bar-c { fill: var(--gold-icon); }
  .atp11-pr figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
