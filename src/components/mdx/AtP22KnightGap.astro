---
// Which controls Knight had and which it lacked, from SEC Release 34-70694, paragraphs 15, 19-22.
import DiagramIcon from './DiagramIcon.astro';
const W = 900, H = 400;
const had = [
  { en: ['Checks before SMARS', 'customer interface, order manager, internal crossing'], vi: ['Kiểm tra trước SMARS', 'giao diện khách, quản lý lệnh, khớp nội bộ'] },
  { en: ['Price cap on parent order', '9.5% from the best bid or offer; skipped for pre-open orders'], vi: ['Trần giá lên lệnh mẹ', '9,5% so với giá chào tốt nhất; bỏ qua lệnh trước giờ mở cửa'] },
  { en: ['Position limits per group', 'but they ignored orders still outstanding'], vi: ['Hạn mức vị thế theo nhóm', 'nhưng không tính lệnh đang treo'] },
];
const missing = [
  { en: ['Orders out versus orders in', 'no control compared what SMARS sent with what it received'], vi: ['Lệnh ra so với lệnh vào', 'không có kiểm soát nào so lệnh SMARS gửi với lệnh nó nhận'] },
  { en: ['A way to halt SMARS', 'no procedure to stop it on its own odd activity'], vi: ['Cách dừng SMARS', 'không có quy trình dừng khi nó tự làm điều bất thường'] },
  { en: ['A firm-wide capital limit', 'none tied to an automatic block on new orders'], vi: ['Hạn mức vốn toàn công ty', 'không có cái nào gắn với việc tự chặn lệnh mới'] },
  { en: ['A second pair of eyes', 'one technician deployed; no written procedure for a review'], vi: ['Người thứ hai kiểm tra', 'một người triển khai; không quy trình viết sẵn để soát lại'] },
];
---
<figure class="p22g">
  <div class="p22g-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two columns. Controls Knight had: checks before the router, a 9.5 percent price cap that skipped pre-open orders, position limits that ignored outstanding orders. Controls missing: orders out compared with orders in, a way to halt the router, a firm-wide capital limit tied to automatic blocking, and a second person reviewing the deployment.">
      <text x="20" y="28" class="h"><tspan data-lang-en>Most controls sat around the router, not on it</tspan><tspan data-lang-vi>Phần lớn kiểm soát nằm quanh bộ định tuyến, không nằm trên nó</tspan></text>
      <text x="20" y="62" class="col"><tspan data-lang-en>What existed</tspan><tspan data-lang-vi>Cái đã có</tspan></text>
      <text x="470" y="62" class="col bad-t"><tspan data-lang-en>What was not there</tspan><tspan data-lang-vi>Cái không có</tspan></text>
      {had.map((r, i) => (
        <g>
          <rect x="20" y={76 + i * 74} width="420" height="62" rx="6" class="box" />
          <DiagramIcon name="ok" x={44} y={107 + i * 74} size={22} />
          <text x="68" y={102 + i * 74} class="t"><tspan data-lang-en>{r.en[0]}</tspan><tspan data-lang-vi>{r.vi[0]}</tspan></text>
          <text x="68" y={122 + i * 74} class="n"><tspan data-lang-en>{r.en[1]}</tspan><tspan data-lang-vi>{r.vi[1]}</tspan></text>
        </g>
      ))}
      {missing.map((r, i) => (
        <g>
          <rect x="470" y={76 + i * 74} width="410" height="62" rx="6" class="box bad" />
          <DiagramIcon name="fail" x={494} y={107 + i * 74} size={22} />
          <text x="518" y={102 + i * 74} class="t"><tspan data-lang-en>{r.en[0]}</tspan><tspan data-lang-vi>{r.vi[0]}</tspan></text>
          <text x="518" y={122 + i * 74} class="n"><tspan data-lang-en>{r.en[1]}</tspan><tspan data-lang-vi>{r.vi[1]}</tspan></text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Paraphrased from the SEC's findings. Every item on the right is a rule a person writes down once; none needs a smart model.</span>
    <span data-lang-vi>Diễn giải từ phần kết luận của SEC. Mọi mục bên phải là một quy tắc con người viết ra một lần; không cái nào cần mô hình thông minh.</span>
  </figcaption>
</figure>

<style>
  .p22g { margin: 2em 0; width: 100%; }
  .p22g-scroll { overflow-x: auto; }
  .p22g svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .col { font-size: 14px; font-weight: 700; fill: var(--text-muted); }
  .t { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .n { font-size: 12px; fill: var(--text-muted); }
  .bad-t { fill: var(--red); }
  .box { fill: var(--card-bg); stroke: var(--border); stroke-width: 1.5; }
  .box.bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .p22g figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
