  .gp05d .b { font-weight: 700; fill: var(--text); }
  .gp05d .m { fill: var(--text-muted); font-size: 13px; }
  .gp05d .n { font-variant-numeric: tabular-nums; }
  .gp05d .r { fill: var(--red); font-weight: 700; }
  .gp05d .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp05d .box.red { fill: var(--red-tint-bg); stroke: var(--red); }
