---
// Heartbleed in one picture: a one-byte heartbeat that claims 64 KB, the
// server that believes the claim, and the two years nobody saw it.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 330;
const arrows = [arrow(270, 205, 345, 205), arrow(555, 205, 630, 205)];
---
<figure class="bep3n1">
  <div class="bep3n1-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Timeline: the Heartbleed bug was in the wild from March 2012 and the internet learned of it in April 2014, with nothing abnormal in the logs. Below, a heartbeat request with a one-byte payload claiming 64 kilobytes reaches a server that believes the claim and sends 64 kilobytes of memory back.">
    <line x1="80" y1="70" x2="820" y2="70" class="ln" />
    <circle cx="120" cy="70" r="6" class="dotc" />
    <circle cx="780" cy="70" r="6" class="dotr" />
    <text x="120" y="38" text-anchor="middle" class="t"><tspan data-lang-en>March 2012</tspan><tspan data-lang-vi>Tháng 3/2012</tspan></text>
    <text x="120" y="98" text-anchor="middle" class="m"><tspan data-lang-en>the bug is in the wild</tspan><tspan data-lang-vi>lỗi đã có ngoài đời</tspan></text>
    <text x="780" y="38" text-anchor="middle" class="t"><tspan data-lang-en>April 2014</tspan><tspan data-lang-vi>Tháng 4/2014</tspan></text>
    <text x="780" y="98" text-anchor="middle" class="m"><tspan data-lang-en>the internet learns</tspan><tspan data-lang-vi>cả internet mới biết</tspan></text>
    <text x="450" y="56" text-anchor="middle" class="rr"><tspan data-lang-en>two years, nothing abnormal in the logs</tspan><tspan data-lang-vi>hai năm, log không có gì bất thường</tspan></text>

    <rect x="60" y="140" width="210" height="130" rx="8" class="box" />
    <DiagramIcon name="mail" x={165} y={165} size={24} />
    <text x="165" y="206" text-anchor="middle" class="t"><tspan data-lang-en>heartbeat request</tspan><tspan data-lang-vi>request heartbeat</tspan></text>
    <text x="165" y="228" text-anchor="middle" class="m"><tspan data-lang-en>payload: 1 byte</tspan><tspan data-lang-vi>payload: 1 byte</tspan></text>
    <text x="165" y="248" text-anchor="middle" class="rr"><tspan data-lang-en>claims: 64 KB</tspan><tspan data-lang-vi>tự khai: 64 KB</tspan></text>

    <rect x="345" y="140" width="210" height="130" rx="8" class="box" />
    <DiagramIcon name="server" x={450} y={165} size={24} />
    <text x="450" y="206" text-anchor="middle" class="t">OpenSSL</text>
    <text x="450" y="228" text-anchor="middle" class="m"><tspan data-lang-en>believes the claim</tspan><tspan data-lang-vi>tin lời tự khai</tspan></text>
    <text x="450" y="248" text-anchor="middle" class="m"><tspan data-lang-en>never checks it</tspan><tspan data-lang-vi>không đối chiếu</tspan></text>

    <rect x="630" y="140" width="210" height="130" rx="8" class="boxr" />
    <DiagramIcon name="key" x={735} y={165} size={24} />
    <text x="735" y="206" text-anchor="middle" class="t r"><tspan data-lang-en>64 KB comes back</tspan><tspan data-lang-vi>trả về 64 KB</tspan></text>
    <text x="735" y="228" text-anchor="middle" class="m"><tspan data-lang-en>keys, tickets, passwords</tspan><tspan data-lang-vi>khoá, ticket, mật khẩu</tspan></text>
    <text x="735" y="248" text-anchor="middle" class="m"><tspan data-lang-en>whatever sat in the buffer</tspan><tspan data-lang-vi>bất cứ thứ gì trong buffer</tspan></text>
    {arrows.map((a) => (<g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>))}
    <text x="450" y="306" text-anchor="middle" class="rr"><tspan data-lang-en>one byte in, 64 kilobytes of someone else's memory out</tspan><tspan data-lang-vi>vào một byte, ra 64 kilobyte bộ nhớ của người khác</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The request carried its own length and the boundary believed it. Nothing compared the claim with the payload that actually arrived.</span>
    <span data-lang-vi>Request tự mang theo độ dài và biên giới tin nó. Không có gì đối chiếu lời khai với payload thực sự nhận được.</span>
  </figcaption>
</figure>

<style>
  .bep3n1 { margin: 2em 0; width: 100%; }
  .bep3n1-scroll { overflow-x: auto; }
  .bep3n1 svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep3n1 text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep3n1 .t { font-weight: 700; fill: var(--text); }
  .bep3n1 .m { fill: var(--text-muted); font-size: 12.5px; }
  .bep3n1 .r { fill: var(--red); }
  .bep3n1 .rr { font-weight: 700; fill: var(--red); font-size: 13px; }
  .bep3n1 .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep3n1 .boxr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bep3n1 .ghost { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .bep3n1 .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep3n1 .lnr { stroke: var(--red); stroke-width: 1.5; fill: none; }
  .bep3n1 .hd { fill: var(--text-muted); }
  .bep3n1 .hdr { fill: var(--red); }
  .bep3n1 figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
<style>
  .bep3n1 .dotc { fill: var(--text-muted); }
  .bep3n1 .dotr { fill: var(--red); }
</style>
