---
// Direct left/right comparison of local (document-partitioned) vs. global
// (term-partitioned) secondary indexes across shards.
// Plain inline SVG using site CSS tokens; arrowheads are polygons (no SVG ids).

const W = 900;
const H = 492;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const localShards = [
  { name: 'Shard 0', range: '1–499', hitWrite: false, idx: 'cust:42 → 105', lat: '4 ms', slow: false },
  { name: 'Shard 1', range: '500–999', hitWrite: true, idx: 'cust:42 → 812', lat: '6 ms', slow: false },
  { name: 'Shard 2', range: '1000–1499', hitWrite: false, idx: 'cust:42 → 1204', lat: '92 ms', slow: true },
];
const shardW = 125;
const shardGap = 15;
const localX = (i: number) => 20 + i * (shardW + shardGap);
---
<figure class="shidx">
  <div class="shidx-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Comparison of local and global secondary indexes across shards. With a local index, inserting order 812 touches only Shard 1, but querying customer_id 42 must scatter across all three shards and wait for the slowest 92 ms shard. With a global index, querying customer_id 42 hits only Index Shard A, but inserting order 812 has to update both Data Shard 1 and Index Shard A.">
      <line x1="450" x2="450" y1="12" y2={H - 12} class="shidx-sep" />

      {/* Headers */}
      <text x="20" y="26" class="shidx-h">
        <tspan data-lang-en>Local index (document-partitioned)</tspan>
        <tspan data-lang-vi>Local index (chia theo từng shard dữ liệu)</tspan>
      </text>
      <text x="20" y="47" class="shidx-sub">
        <tspan data-lang-en>Each shard indexes only the rows it stores.</tspan>
        <tspan data-lang-vi>Mỗi shard tự đánh index cho riêng các dòng nó giữ.</tspan>
      </text>

      <text x="475" y="26" class="shidx-h">
        <tspan data-lang-en>Global index (term-partitioned)</tspan>
        <tspan data-lang-vi>Global index (chia theo giá trị tìm kiếm)</tspan>
      </text>
      <text x="475" y="47" class="shidx-sub">
        <tspan data-lang-en>Index is sharded separately by the indexed value.</tspan>
        <tspan data-lang-vi>Index được tách thành shard riêng theo giá trị tìm.</tspan>
      </text>

      {/* ---------- WRITE PATH ---------- */}
      <text x="20" y="74" class="shidx-lbl">
        <tspan data-lang-en>Write: insert order 812 (customer 42)</tspan>
        <tspan data-lang-vi>Lệnh ghi: thêm order 812 (customer 42)</tspan>
      </text>
      <text x="475" y="74" class="shidx-lbl">
        <tspan data-lang-en>Write: insert order 812 (customer 42)</tspan>
        <tspan data-lang-vi>Lệnh ghi: thêm order 812 (customer 42)</tspan>
      </text>

      {/* Left Write */}
      <rect x="122" y="84" width="200" height="26" rx="4" class="shidx-pill" />
      <text x="222" y="101" text-anchor="middle" class="shidx-pill-txt">order 812 (cust: 42)</text>
      {(() => {
        const cx = localX(1) + shardW / 2;
        const a = arrow(222, 110, cx, 130);
        return <g><path d={a.line} class="shidx-arrow is-strong" /><polygon points={a.head} class="shidx-head is-strong" /></g>;
      })()}

      {localShards.map((s, i) => {
        const x = localX(i);
        return (
          <g>
            <rect x={x} y="132" width={shardW} height="56" rx="5" class={s.hitWrite ? 'shidx-box is-active' : 'shidx-box is-dim'} />
            <text x={x + shardW / 2} y="150" text-anchor="middle" class="shidx-box-b">{s.name}</text>
            <text x={x + shardW / 2} y="167" text-anchor="middle" class="shidx-box-s">{s.range}</text>
            <text x={x + shardW / 2} y="182" text-anchor="middle" class="shidx-box-s">
              {s.hitWrite ? (
                <>
                  <tspan data-lang-en>+ row &amp; index</tspan>
                  <tspan data-lang-vi>+ dòng &amp; index</tspan>
                </>
              ) : (
                <>
                  <tspan data-lang-en>untouched</tspan>
                  <tspan data-lang-vi>không đụng tới</tspan>
                </>
              )}
            </text>
          </g>
        );
      })}
      <text x="222" y="208" text-anchor="middle" class="shidx-note">
        <tspan data-lang-en>1 shard updated (fast, synchronous)</tspan>
        <tspan data-lang-vi>Cập nhật đúng 1 shard (nhanh, đồng bộ)</tspan>
      </text>

      {/* Right Write */}
      <rect x="577" y="84" width="200" height="26" rx="4" class="shidx-pill" />
      <text x="677" y="101" text-anchor="middle" class="shidx-pill-txt">order 812 (cust: 42)</text>
      {(() => {
        const a1 = arrow(635, 110, 570, 130);
        const a2 = arrow(720, 110, 785, 130);
        return (
          <g>
            <path d={a1.line} class="shidx-arrow is-hot" /><polygon points={a1.head} class="shidx-head is-hot" />
            <path d={a2.line} class="shidx-arrow is-hot" /><polygon points={a2.head} class="shidx-head is-hot" />
          </g>
        );
      })()}

      <rect x="475" y="132" width="190" height="56" rx="5" class="shidx-box is-hot" />
      <text x="570" y="150" text-anchor="middle" class="shidx-box-b is-hot">Data Shard 1 (500–999)</text>
      <text x="570" y="172" text-anchor="middle" class="shidx-box-s">
        <tspan data-lang-en>+ row order 812</tspan>
        <tspan data-lang-vi>+ dòng order 812</tspan>
      </text>

      <rect x="690" y="132" width="190" height="56" rx="5" class="shidx-box is-hot" />
      <text x="785" y="150" text-anchor="middle" class="shidx-box-b is-hot">Index Shard A (cust 1–50)</text>
      <text x="785" y="172" text-anchor="middle" class="shidx-box-s">cust:42 → 105, 812, 1204</text>

      <text x="677" y="208" text-anchor="middle" class="shidx-note is-bad">
        <tspan data-lang-en>2+ shards updated (async lag or distributed tx)</tspan>
        <tspan data-lang-vi>Đụng từ 2 shard trở lên (trễ async hoặc distributed tx)</tspan>
      </text>

      {/* Rule */}
      <line x1="20" x2="425" y1="226" y2="226" class="shidx-rule" />
      <line x1="475" x2="880" y1="226" y2="226" class="shidx-rule" />

      {/* ---------- READ PATH ---------- */}
      <text x="20" y="250" class="shidx-lbl">
        <tspan data-lang-en>Read: WHERE customer_id = 42</tspan>
        <tspan data-lang-vi>Lệnh đọc: WHERE customer_id = 42</tspan>
      </text>
      <text x="475" y="250" class="shidx-lbl">
        <tspan data-lang-en>Read: WHERE customer_id = 42</tspan>
        <tspan data-lang-vi>Lệnh đọc: WHERE customer_id = 42</tspan>
      </text>

      {/* Left Read: Scatter/Gather */}
      <rect x="112" y="262" width="220" height="28" rx="4" class="shidx-pill" />
      <text x="222" y="280" text-anchor="middle" class="shidx-pill-txt">
        <tspan data-lang-en>Query all 3 shards in parallel</tspan>
        <tspan data-lang-vi>Hỏi cả 3 shard song song</tspan>
      </text>
      {localShards.map((s, i) => {
        const x = localX(i);
        const cx = x + shardW / 2;
        const a = arrow(222, 290, cx, 326);
        return (
          <g>
            <path d={a.line} class="shidx-arrow is-hot" /><polygon points={a.head} class="shidx-head is-hot" />
            <rect x={x} y="328" width={shardW} height="64" rx="5" class={s.slow ? 'shidx-box is-hot' : 'shidx-box'} />
            <text x={cx} y="347" text-anchor="middle" class="shidx-box-b">{s.name}</text>
            <text x={cx} y="365" text-anchor="middle" class="shidx-box-s">{s.idx}</text>
            <text x={cx} y="383" text-anchor="middle" class={s.slow ? 'shidx-lat is-bad' : 'shidx-lat'}>{s.lat}{s.slow ? ' (tail)' : ''}</text>
          </g>
        );
      })}
      <text x="222" y="416" text-anchor="middle" class="shidx-note is-bad">
        <tspan data-lang-en>Slowest shard sets response time (92 ms)</tspan>
        <tspan data-lang-vi>Shard chậm nhất quyết định thời gian chờ (92 ms)</tspan>
      </text>

      {/* Right Read: Single index shard */}
      <rect x="567" y="262" width="220" height="28" rx="4" class="shidx-pill" />
      <text x="677" y="280" text-anchor="middle" class="shidx-pill-txt">
        <tspan data-lang-en>Route directly by term (cust: 42)</tspan>
        <tspan data-lang-vi>Đi thẳng tới shard chứa cust: 42</tspan>
      </text>
      {(() => {
        const a = arrow(635, 290, 570, 326);
        return <g><path d={a.line} class="shidx-arrow is-strong" /><polygon points={a.head} class="shidx-head is-strong" /></g>;
      })()}

      <rect x="475" y="328" width="190" height="64" rx="5" class="shidx-box is-active" />
      <text x="570" y="347" text-anchor="middle" class="shidx-box-b">Index Shard A (cust 1–50)</text>
      <text x="570" y="366" text-anchor="middle" class="shidx-box-s">cust:42 → 105, 812, 1204</text>
      <text x="570" y="384" text-anchor="middle" class="shidx-lat">
        <tspan data-lang-en>1 index shard</tspan>
        <tspan data-lang-vi>1 shard index</tspan>
      </text>

      <rect x="690" y="328" width="190" height="64" rx="5" class="shidx-box is-dim" />
      <text x="785" y="347" text-anchor="middle" class="shidx-box-b">Index Shard B (cust 51+)</text>
      <text x="785" y="366" text-anchor="middle" class="shidx-box-s">
        <tspan data-lang-en>not queried</tspan>
        <tspan data-lang-vi>không truy vấn</tspan>
      </text>

      <text x="677" y="416" text-anchor="middle" class="shidx-note">
        <tspan data-lang-en>1 index shard read; fetch rows from data shards if needed</tspan>
        <tspan data-lang-vi>Đọc 1 shard index; lấy thêm dòng ở shard dữ liệu nếu cần</tspan>
      </text>

      {/* Verdicts */}
      <text x="20" y="472" class="shidx-verdict is-bad">
        <tspan data-lang-en>Fast writes, expensive scatter/gather reads.</tspan>
        <tspan data-lang-vi>Ghi nhanh, đọc phải quét qua mọi shard.</tspan>
      </text>
      <text x="475" y="472" class="shidx-verdict">
        <tspan data-lang-en>Fast index lookups, complex cross-shard writes.</tspan>
        <tspan data-lang-vi>Tra cứu nhanh, ghi phức tạp vì qua nhiều shard.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Local vs. global secondary indexes. A local index keeps writes fast on one shard, at the price of querying every shard when the partition key is unknown. A global index routes a single-term lookup straight to one index shard, while writes have to update data and index shards separately.</span>
    <span data-lang-vi>Local index so với global index. Local index giúp lệnh ghi nằm gọn trên một shard, đổi lại lệnh đọc không biết partition key phải hỏi tất cả các shard. Global index đưa truy vấn một điều kiện về đúng một shard index, còn lệnh ghi phải cập nhật cả shard dữ liệu lẫn shard index.</span>
  </figcaption>
</figure>

<style>
  .shidx {
    margin: 2em 0;
    width: 100%;
  }
  .shidx-scroll {
    overflow-x: auto;
  }
  .shidx svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .shidx text {
    font-size: 13px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .shidx .shidx-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .shidx .shidx-sub,
  .shidx .shidx-lbl {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .shidx .shidx-lbl {
    font-weight: 600;
  }
  .shidx-sep {
    stroke: var(--border);
    stroke-dasharray: 5 5;
  }
  .shidx-rule {
    stroke: var(--border);
  }
  .shidx-pill {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.1;
  }
  .shidx .shidx-pill-txt {
    font-size: 12.5px;
    font-weight: 600;
    fill: var(--text);
  }
  .shidx-box {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .shidx-box.is-hot {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .shidx-box.is-active {
    stroke: var(--text);
    stroke-width: 1.7;
  }
  .shidx-box.is-dim {
    opacity: 0.45;
  }
  .shidx .shidx-box-b {
    font-size: 12.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .shidx .shidx-box-b.is-hot {
    fill: var(--red);
  }
  .shidx .shidx-box-s {
    font-size: 11.5px;
    fill: var(--text-body);
  }
  .shidx .shidx-lat {
    font-size: 11.5px;
    font-weight: 700;
    fill: var(--text-muted);
  }
  .shidx .shidx-lat.is-bad {
    fill: var(--red);
  }
  .shidx .shidx-note {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .shidx .shidx-note.is-bad {
    fill: var(--red);
    font-weight: 600;
  }
  .shidx-arrow {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.3;
  }
  .shidx-arrow.is-hot {
    stroke: var(--red);
    stroke-width: 1.5;
  }
  .shidx-arrow.is-strong {
    stroke: var(--text);
    stroke-width: 1.6;
  }
  .shidx-head {
    fill: var(--text-muted);
  }
  .shidx-head.is-hot {
    fill: var(--red);
  }
  .shidx-head.is-strong {
    fill: var(--text);
  }
  .shidx .shidx-verdict {
    font-size: 13.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .shidx .shidx-verdict.is-bad {
    fill: var(--red);
  }
  .shidx figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
