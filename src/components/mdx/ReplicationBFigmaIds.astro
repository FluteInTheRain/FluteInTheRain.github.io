---
// Figma: each client puts its own client ID into every object ID, so offline creation never clashes.
// The ID format shown is illustrative.
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Arrow from './ReplicationBArrow.astro';
import Bi from './ReplicationBBi.astro';
---
<Frame h={200}
  label="Client 7 creates objects 7:1 and 7:2. Client 12 creates 12:1 and 12:2. Each client puts its own client ID into every object ID, so when the objects reach the document no two IDs are alike."
  cap="Each writer gets its own range of IDs, so nobody needs to ask the server for one."
  capVi="Mỗi người ghi có dải ID riêng, nên không ai phải hỏi server xin ID.">
  <Node x={20} y={20} w={230} h={64} icon="laptop" t="Client 7" tv="Client 7" s="its ID goes in every object ID" sv="ID gắn vào mọi object ID" />
  <Node x={300} y={20} w={110} h={64} icon="file" t="7:1" tv="7:1" />
  <Node x={440} y={20} w={110} h={64} icon="file" t="7:2" tv="7:2" />
  <Arrow x1={250} y1={52} x2={300} y2={52} />
  <Node x={20} y={116} w={230} h={64} icon="laptop" t="Client 12" tv="Client 12" s="its ID goes in every object ID" sv="ID gắn vào mọi object ID" />
  <Node x={300} y={116} w={110} h={64} icon="file" t="12:1" tv="12:1" />
  <Node x={440} y={116} w={110} h={64} icon="file" t="12:2" tv="12:2" />
  <Arrow x1={250} y1={148} x2={300} y2={148} />
  <Arrow x1={550} y1={52} x2={660} y2={86} />
  <Arrow x1={550} y1={148} x2={660} y2={114} />
  <Node x={660} y={58} w={220} h={84} icon="figma" t="Document" tv="Tài liệu" s="4 objects" sv="4 object" s2="no two IDs alike" s2v="không có hai ID trùng" cls="gold" />
</Frame>
