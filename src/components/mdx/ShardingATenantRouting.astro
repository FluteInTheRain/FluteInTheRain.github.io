---
// Sharding by tenant: workspace_id is the partition key, so one workspace lives on one shard.
// Workspace ids and shard numbers are illustrative. Inline SVG, site tokens.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const A = (x1: number, y1: number, x2: number, y2: number, c = '') => {
  const a = arrow(x1, y1, x2, y2);
  return { ...a, c };
};

const W = 900;
const H = 340;
const rows = [
  { y: 60, name: 'A', id: '1041', shard: 12 },
  { y: 140, name: 'B', id: '2278', shard: 301 },
  { y: 220, name: 'C', id: '3590', shard: 87 },
];
---
<figure class="shaa-tr">
  <div class="shaa-tr-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Sharding by tenant. Each workspace goes through hash of workspace_id modulo 480 to land on one logical shard, which holds all of that workspace's blocks, pages and comments. Example: workspace A with id 1041 lands on shard 12, B with 2278 on shard 301, C with 3590 on shard 87. A workspace query touches one shard and needs no cross-shard join.">
      <text x="20" y="32" class="sub"><tspan data-lang-en>Workspace (the tenant)</tspan><tspan data-lang-vi>Workspace (tenant)</tspan></text>
      <text x="270" y="32" class="sub"><tspan data-lang-en>Partition key, hashed</tspan><tspan data-lang-vi>Partition key, đem đi băm</tspan></text>
      <text x="540" y="32" class="sub"><tspan data-lang-en>Where its data lives</tspan><tspan data-lang-vi>Dữ liệu nằm ở đâu</tspan></text>
      {rows.map((r) => {
        const a1 = A(210, r.y + 30, 270, r.y + 30);
        const a2 = A(480, r.y + 30, 540, r.y + 30, 'is-fix');
        return (
          <g>
            <rect x="20" y={r.y} width="190" height="60" rx="6" class="box" />
            <DiagramIcon name="users" x={50} y={r.y + 30} size={26} />
            <text x="80" y={r.y + 26} class="b"><tspan data-lang-en>{`Workspace ${r.name}`}</tspan><tspan data-lang-vi>{`Workspace ${r.name}`}</tspan></text>
            <text x="80" y={r.y + 44} class="s">{`workspace_id = ${r.id}`}</text>
            <path d={a1.line} class="arrow" /><polygon points={a1.head} class="head" />

            <rect x="270" y={r.y} width="210" height="60" rx="6" class="box" />
            <text x="375" y={r.y + 26} text-anchor="middle" class="b">{`hash(${r.id}) % 480`}</text>
            <text x="375" y={r.y + 44} text-anchor="middle" class="s">{`= ${r.shard}`}</text>
            <path d={a2.line} class="arrow is-fix" /><polygon points={a2.head} class="head is-fix" />

            <rect x="540" y={r.y} width="340" height="60" rx="6" class="box is-fix" />
            <DiagramIcon name="postgres" x={572} y={r.y + 30} size={26} />
            <text x="604" y={r.y + 26} class="b"><tspan data-lang-en>{`Logical shard ${r.shard}`}</tspan><tspan data-lang-vi>{`Shard logic ${r.shard}`}</tspan></text>
            <text x="604" y={r.y + 44} class="s"><tspan data-lang-en>{`all of ${r.name}'s blocks, pages, comments`}</tspan><tspan data-lang-vi>{`mọi block, trang, bình luận của ${r.name}`}</tspan></text>
          </g>
        );
      })}
      <DiagramIcon name="ok" x={34} y={314} size={22} />
      <text x="62" y="319" class="b"><tspan data-lang-en>A workspace query touches one shard: no cross-shard join.</tspan><tspan data-lang-vi>Truy vấn của một workspace chỉ chạm một shard: không có JOIN xuyên shard.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The tenant id is the partition key, so everything one customer owns sits together.</span>
    <span data-lang-vi>Id của tenant là partition key, nên mọi thứ của một khách hàng nằm chung chỗ.</span>
  </figcaption>
</figure>

<style>
  .shaa-tr { margin: 2em 0; width: 100%; }
  .shaa-tr-scroll { overflow-x: auto; }
  .shaa-tr svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shaa-tr text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shaa-tr .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shaa-tr .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shaa-tr .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shaa-tr .b.is-hot { fill: var(--red); }
  .shaa-tr .s { font-size: 12px; fill: var(--text-body); }
  .shaa-tr .s.is-hot { fill: var(--red); font-weight: 600; }
  .shaa-tr .big { font-size: 18px; font-weight: 700; fill: var(--text); }
  .shaa-tr .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shaa-tr .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shaa-tr .box.is-fix { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-tr .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shaa-tr .box.is-dim { opacity: 0.45; }
  .shaa-tr .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shaa-tr .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shaa-tr .arrow.is-hot { stroke: var(--red); }
  .shaa-tr .arrow.is-fix { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-tr .head { fill: var(--text-muted); }
  .shaa-tr .head.is-hot { fill: var(--red); }
  .shaa-tr .head.is-fix { fill: var(--gold-icon); }
  .shaa-tr figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
