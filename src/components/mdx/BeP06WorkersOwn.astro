---
// What each uvicorn worker owns: its own copy of module state. Numbers are the
// counters from the capture beside it (12 requests, a new connection each).
const W = 900, H = 360;
const workers = [
  { x: 30, pid: 48988, hits: 11, served: 11 },
  { x: 320, pid: null, hits: 0, served: 0 },
  { x: 610, pid: 48990, hits: 1, served: 1 },
];
---
<figure class="bep6e">
  <div class="bep6e-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A parent process on top with three arrows to three worker processes, each with its own hits counter. Worker 48988 reads 11, the third worker never answered so its counter stays 0, worker 48990 reads 1.">
    <rect x="300" y="14" width="300" height="52" rx="10" class="box" />
    <text x="450" y="36" text-anchor="middle" class="h">uvicorn --workers 3</text>
    <text x="450" y="55" text-anchor="middle" class="s"><tspan data-lang-en>parent: owns the listening socket</tspan><tspan data-lang-vi>parent: giữ socket đang lắng nghe</tspan></text>

    {workers.map((w) => {
      const cx = w.x + 130;
      return (
        <g>
          <line x1={cx} y1="66" x2={cx} y2="116" class="ln" />
          <polygon points={`${cx},128 ${cx - 5},116 ${cx + 5},116`} class="hd" />
          <rect x={w.x} y="128" width="260" height="214" rx="10" class="box" />
          <image href="/icons/flow/python.svg" x={w.x + 18} y="144" width="24" height="24" aria-hidden="true" />
          <text x={w.x + 52} y="162" class="h">{w.pid ? `worker · pid ${w.pid}` : <><tspan data-lang-en>worker · never answered</tspan><tspan data-lang-vi>worker · không nhận request</tspan></>}</text>
          <rect x={w.x + 20} y="184" width="220" height="92" rx="8" class="mem" />
          <text x={w.x + 130} y="206" text-anchor="middle" class="s"><tspan data-lang-en>its own memory</tspan><tspan data-lang-vi>bộ nhớ riêng</tspan></text>
          <text x={w.x + 130} y="254" text-anchor="middle" class="num">hits = {w.hits}</text>
          <text x={w.x + 130} y="306" text-anchor="middle" class="b"><tspan data-lang-en>answered {w.served} of 12 requests</tspan><tspan data-lang-vi>trả lời {w.served} trong 12 request</tspan></text>
          <text x={w.x + 130} y="328" text-anchor="middle" class="s"><tspan data-lang-en>a variable here is invisible there</tspan><tspan data-lang-vi>biến ở đây thì bên kia không thấy</tspan></text>
        </g>
      );
    })}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The kernel hands each new connection to one worker. Each worker runs the same code on its own copy of the data, so a counter kept in a variable splits three ways.</span>
    <span data-lang-vi>Kernel giao mỗi kết nối mới cho một worker. Mỗi worker chạy cùng code trên bản dữ liệu riêng của nó, nên một bộ đếm lưu trong biến bị chia làm ba.</span>
  </figcaption>
</figure>

<style>
  .bep6e { margin: 2em 0; width: 100%; }
  .bep6e-scroll { overflow-x: auto; }
  .bep6e svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .bep6e text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep6e .h { font-weight: 700; fill: var(--text); font-size: 15.5px; }
  .bep6e .s { fill: var(--text-muted); font-size: 12.5px; }
  .bep6e .b { fill: var(--text-body); }
  .bep6e .num { font-family: 'JetBrains Mono', ui-monospace, monospace; font-weight: 700; font-size: 26px; fill: var(--red); }
  .bep6e .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep6e .mem { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .bep6e .ln { stroke: var(--text-muted); stroke-width: 1.6; }
  .bep6e .hd { fill: var(--text-muted); }
  .bep6e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
