---
import DiagramIcon from './DiagramIcon.astro';
import NfrText from './NfrText.astro';
import NfrArrow from './NfrArrow.astro';
import './nfr-fig.css';
// Why the slowest requests belong to the best customers: a big cart means many more backend calls. Counts are not given in the post, so none are drawn.
const W = 900;
const H = 270;
const calls = [
  { y: 124, icon: 'db', en: 'Database queries', vi: 'Truy vấn database' },
  { y: 172, icon: 'model', en: 'Recommendation checks', vi: 'Kiểm tra gợi ý' },
  { y: 220, icon: 'package', en: 'Inventory checks', vi: 'Kiểm tra tồn kho' },
] as const;
---
<figure class="nf">
  <div class="nf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: a customer buying one book triggers one small database lookup. Bottom: a power shopper with 200 items in the cart triggers hundreds of database queries, recommendation checks and inventory checks, so more chances to hit a slow one and land in the p99.9 tail.">
      <DiagramIcon name="user" x={70} y={50} size={30} />
      <NfrText x={70} y={86} anchor="middle" cls="n" en="One book" vi="Một cuốn sách" />
      <NfrArrow x1={102} y1={50} x2={296} y2={50} />
      <rect x="300" y="26" width="230" height="48" rx="8" class="box" />
      <DiagramIcon name="db" x={326} y={50} size={26} />
      <NfrText x={350} y={55} cls="n" en="One database lookup" vi="Một lần tra database" />
      <NfrText x={560} y={55} en="Tiny request. Fast." vi="Request nhỏ. Nhanh." />

      <line x1="20" y1="100" x2="880" y2="100" class="panel" />
      <DiagramIcon name="users" x={70} y={172} size={30} />
      <NfrText x={70} y={208} anchor="middle" lh={14} cls="n" en={['Power shopper,', '200 items']} vi={['Khách mua nhiều,', '200 món']} />
      {calls.map((c) => (
        <g>
          <NfrArrow x1={102} y1={172} x2={296} y2={c.y} />
          <rect x="300" y={c.y - 20} width="230" height="40" rx="8" class="box" />
          <DiagramIcon name={c.icon} x={326} y={c.y} size={24} />
          <NfrText x={348} y={c.y + 5} cls="n" en={c.en} vi={c.vi} />
        </g>
      ))}
      <NfrText x={560} y={150} cls="n" en="Hundreds of calls, not one" vi="Hàng trăm lần gọi, không phải một" />
      <NfrText x={560} y={172} lh={18} cls="is-red" en={['More chances to hit a slow one:', 'this customer lands in the p99.9 tail']} vi={['Nhiều cơ hội gặp một cái chậm hơn:', 'khách này rơi vào đuôi p99.9']} />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The tail is not random. It is the customers who ask the most of the system.</span>
    <span data-lang-vi>Phần đuôi không ngẫu nhiên. Đó là những khách hàng đòi hỏi hệ thống nhiều nhất.</span>
  </figcaption>
</figure>
