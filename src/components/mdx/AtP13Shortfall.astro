---
import DiagramIcon from './DiagramIcon.astro';
// Left: implementation shortfall on one buy. Say a model decides to buy at 100.00, the order reaches the market at 100.03
// and the average fill is 100.13: 13 bps of cost, 3 from waiting and 10 from pushing the price.
// Right: the real averages from Frazzini, Israel and Moskowitz (NBER draft, 5 Dec 2012), full sample 1998-2011.
const W = 900;
const H = 340;
const py = (v: number) => 250 - (v - 99.95) * 560;
const rows = [
  { en: 'Mean (all trades)', vi: 'Trung bình (mọi lệnh)', v: 13.0 },
  { en: 'Median', vi: 'Trung vị', v: 10.34 },
  { en: 'Weighted by dollars', vi: 'Có trọng số theo tiền', v: 20.2 },
];
const bx = (v: number) => (v / 22) * 270;
---
<figure class="atp13-sf">
  <div class="atp13-sf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: a buy order. The model decides at 100.00, the order arrives at 100.03, the average fill is 100.13, so the shortfall is 13 basis points. Right: real average implementation shortfall from a live institutional dataset: mean 13 basis points, median 10.34, dollar-weighted 20.2.">
      <text x="30" y="28" class="h">
        <tspan data-lang-en>One buy order, from decision to fill</tspan>
        <tspan data-lang-vi>Một lệnh mua, từ quyết định tới khớp</tspan>
      </text>
      <line x1="40" x2="440" y1="250" y2="250" class="axis" />
      <text x="440" y="270" text-anchor="end" class="tick">
        <tspan data-lang-en>time</tspan>
        <tspan data-lang-vi>thời gian</tspan>
      </text>

      <line x1="110" x2="320" y1={py(100.0)} y2={py(100.0)} class="ref" />
      <circle cx="110" cy={py(100.0)} r="6" class="dot" />
      <text x="124" y={py(100.0) + 18} class="lab">
        <tspan data-lang-en>decision price 100.00</tspan>
        <tspan data-lang-vi>giá lúc quyết định 100,00</tspan>
      </text>

      <circle cx="200" cy={py(100.03)} r="6" class="dot" />
      <text x="188" y={py(100.03) + 4} text-anchor="end" class="lab">
        <tspan data-lang-en>order arrives 100.03</tspan>
        <tspan data-lang-vi>lệnh tới sàn 100,03</tspan>
      </text>

      <circle cx="320" cy={py(100.13)} r="6" class="dot hot" />
      <text x="320" y={py(100.13) - 14} text-anchor="middle" class="lab hotl">
        <tspan data-lang-en>average fill 100.13</tspan>
        <tspan data-lang-vi>giá khớp trung bình 100,13</tspan>
      </text>

      <line x1="320" x2="320" y1={py(100.0)} y2={py(100.13)} class="ref hotline" />
      <text x="40" y="82" class="note">
        <tspan data-lang-en>+3 cents from waiting, +10 cents from our own buying</tspan>
        <tspan data-lang-vi>+3 xu do chờ, +10 xu do chính lệnh mua của mình</tspan>
      </text>
      <text x="40" y="102" class="note">
        <tspan data-lang-en>13 cents on 100 is 13 basis points (bps)</tspan>
        <tspan data-lang-vi>13 xu trên 100 là 13 điểm cơ bản (bps)</tspan>
      </text>

      <line x1="480" x2="480" y1="30" y2="310" class="axis" />
      <text x="510" y="28" class="h">
        <tspan data-lang-en>Real averages, live institutional trades</tspan>
        <tspan data-lang-vi>Số trung bình thật, lệnh thật của một quỹ lớn</tspan>
      </text>
      <DiagramIcon name="measure" x={522} y={56} size={20} />
      <text x="540" y="61" class="note">
        <tspan data-lang-en>implementation shortfall, bps per dollar traded</tspan>
        <tspan data-lang-vi>implementation shortfall, bps trên mỗi đồng giao dịch</tspan>
      </text>
      {rows.map((r, i) => (
        <g>
          <text x="510" y={110 + i * 62} class="lab">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          <rect x="510" y={118 + i * 62} width={bx(r.v)} height="22" rx="4" class={i === 0 ? 'bar hotbar' : 'bar'} />
          <text x={516 + bx(r.v)} y={135 + i * 62} class="num"><tspan data-lang-en>{r.v}</tspan><tspan data-lang-vi>{String(r.v).replace(".", ",")}</tspan></text>
        </g>
      ))}
      <text x="510" y="316" class="note">
        <tspan data-lang-en>The biggest trades cost the most.</tspan>
        <tspan data-lang-vi>Lệnh càng lớn càng tốn.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Left: say a model decides to buy at 100.00 and the order arrives at 100.03; this is how the shortfall is counted. Right: Frazzini, Israel and Moskowitz, Trading Costs of Asset Pricing Anomalies, NBER draft of 5 December 2012, nearly a trillion dollars of trades, 1998 to 2011.</span>
    <span data-lang-vi>Trái: giả sử mô hình quyết định mua ở 100,00 và lệnh tới sàn ở 100,03; shortfall được tính như vậy. Phải: Frazzini, Israel và Moskowitz, Trading Costs of Asset Pricing Anomalies, bản nháp NBER ngày 5/12/2012, gần một nghìn tỷ USD giao dịch, 1998 đến 2011.</span>
  </figcaption>
</figure>

<style>
  .atp13-sf { margin: 2em 0; width: 100%; }
  .atp13-sf-scroll { overflow-x: auto; }
  .atp13-sf svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp13-sf .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .atp13-sf .lab { font-size: 13px; font-weight: 700; fill: var(--text); }
  .atp13-sf .hotl { fill: var(--red); }
  .atp13-sf .note { font-size: 13px; fill: var(--text-body); }
  .atp13-sf .tick { font-size: 12px; fill: var(--text-muted); }
  .atp13-sf .num { font-size: 13px; font-weight: 700; fill: var(--text); }
  .atp13-sf .axis { stroke: var(--border); stroke-width: 1.5; }
  .atp13-sf .ref { stroke: var(--text-muted); stroke-width: 1; stroke-dasharray: 4 3; }
  .atp13-sf .hotline { stroke: var(--red); }
  .atp13-sf .dot { fill: var(--text); }
  .atp13-sf .dot.hot { fill: var(--red); }
  .atp13-sf .bar { fill: var(--text-muted); opacity: 0.55; }
  .atp13-sf .hotbar { fill: var(--red); opacity: 1; }
  .atp13-sf figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
