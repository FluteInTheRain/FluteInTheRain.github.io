---
// Processing time vs event time when a stream consumer restarts for 60 seconds:
//  1. Processing time counts events when the consumer machine reads them, turning a
//     one-minute deploy pause into a false zero followed by a fake 2x backlog spike.
//  2. Event time groups events by the timestamp inside each record, restoring the true
//     flat rate once a watermark lets delayed events catch up.
// Plain inline SVG using site CSS tokens; no marker ids.

const W = 900;
const H = 446;

const minutes = ['10:00', '10:01', '10:02', '10:03', '10:04'];
const xs = [132, 232, 332, 432, 532];
const barW = 58;

// Processing time counts (0 at 10:02 during restart, 200 at 10:03 draining backlog)
const procCounts = [100, 100, 0, 200, 100];
// Event time counts (flat reality of 100 req/min)
const eventCounts = [100, 100, 100, 100, 100];

const yScale = 0.54; // 200 events = 108px
const topBase = 178;
const botBase = 398;
const xAxisStart = 84;
const xAxisEnd = 586;
const noteX = 612;
---
<figure class="sttm">
  <div class="sttm-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Comparison of processing-time and event-time 1-minute request counts during a consumer restart at 10:02. Processing time shows 0 events at 10:02 and a 200-event spike at 10:03 as the backlog drains. Event time restores the true steady rate of 100 events per minute.">
    {/* ---------- Panel 1: Processing time ---------- */}
    <text x="20" y="24" class="sttm-h">
      <tspan data-lang-en>1. Grouped by processing time (consumer wall clock)</tspan>
      <tspan data-lang-vi>1. Gom theo thời gian xử lý (đồng hồ máy chạy consumer)</tspan>
    </text>

    {[0, 100, 200].map((tick) => {
      const y = topBase - tick * yScale;
      return (
        <g>
          <line x1={xAxisStart} x2={xAxisEnd} y1={y} y2={y} class={tick === 0 ? 'sttm-axis' : 'sttm-grid'} />
          <text x={xAxisStart - 10} y={y + 4} text-anchor="end" class="sttm-tick">{tick}</text>
        </g>
      );
    })}

    {minutes.map((m, i) => {
      const val = procCounts[i];
      const h = val * yScale;
      const x = xs[i] - barW / 2;
      const y = topBase - h;
      const isSpike = val === 200;
      const isZero = val === 0;
      return (
        <g>
          {isZero ? (
            <g>
              <rect x={x} y={topBase - 100 * yScale} width={barW} height={100 * yScale} rx="3" class="sttm-bar is-gap" />
              <text x={xs[i]} y={topBase - 100 * yScale - 8} text-anchor="middle" class="sttm-val is-bad">0</text>
              <text x={xs[i]} y={topBase - 22} text-anchor="middle" class="sttm-gap-lbl">
                <tspan data-lang-en>restart</tspan>
                <tspan data-lang-vi>tắt 60s</tspan>
              </text>
            </g>
          ) : (
            <g>
              <rect x={x} y={y} width={barW} height={h} rx="3" class={isSpike ? 'sttm-bar is-bad' : 'sttm-bar'} />
              <text x={xs[i]} y={y - 7} text-anchor="middle" class={isSpike ? 'sttm-val is-bad' : 'sttm-val'}>{val}</text>
            </g>
          )}
          <text x={xs[i]} y={topBase + 18} text-anchor="middle" class="sttm-tick">{m}</text>
        </g>
      );
    })}

    <text x={noteX} y="82" class="sttm-note-bad">
      <tspan data-lang-en>False alarm at 10:03 (2× spike)</tspan>
      <tspan data-lang-vi>Báo động giả lúc 10:03 (vọt gấp đôi)</tspan>
    </text>
    <text x={noteX} y="106" class="sttm-note">
      <tspan data-lang-en>Consumer paused at 10:02, then</tspan>
      <tspan data-lang-vi>Consumer dừng lúc 10:02, rồi</tspan>
    </text>
    <text x={noteX} y="126" class="sttm-note">
      <tspan data-lang-en>drained two minutes at once.</tspan>
      <tspan data-lang-vi>xả dồn hai phút vào một lúc.</tspan>
    </text>

    {/* ---------- Divider ---------- */}
    <line x1="20" x2={W - 20} y1="216" y2="216" class="sttm-rule" />

    {/* ---------- Panel 2: Event time ---------- */}
    <text x="20" y="244" class="sttm-h">
      <tspan data-lang-en>2. Grouped by event time + watermark (timestamp inside event)</tspan>
      <tspan data-lang-vi>2. Gom theo thời gian sự kiện + watermark (mốc giờ trong event)</tspan>
    </text>

    {[0, 100, 200].map((tick) => {
      const y = botBase - tick * yScale;
      return (
        <g>
          <line x1={xAxisStart} x2={xAxisEnd} y1={y} y2={y} class={tick === 0 ? 'sttm-axis' : 'sttm-grid'} />
          <text x={xAxisStart - 10} y={y + 4} text-anchor="end" class="sttm-tick">{tick}</text>
        </g>
      );
    })}

    {minutes.map((m, i) => {
      const val = eventCounts[i];
      const h = val * yScale;
      const x = xs[i] - barW / 2;
      const y = botBase - h;
      const isDelayed = i === 2;
      return (
        <g>
          <rect x={x} y={y} width={barW} height={h} rx="3" class={isDelayed ? 'sttm-bar is-delayed' : 'sttm-bar'} />
          <text x={xs[i]} y={y - 7} text-anchor="middle" class="sttm-val">{val}</text>
          {isDelayed && (
            <text x={xs[i]} y={botBase - 22} text-anchor="middle" class="sttm-in-lbl">
              <tspan data-lang-en>late OK</tspan>
              <tspan data-lang-vi>đến bù</tspan>
            </text>
          )}
          <text x={xs[i]} y={botBase + 18} text-anchor="middle" class="sttm-tick">{m}</text>
        </g>
      );
    })}

    {/* Watermark dashed marker after 10:02 */}
    <line x1="382" x2="382" y1="292" y2={botBase} class="sttm-wm" />
    <text x="382" y="284" text-anchor="middle" class="sttm-wm-lbl">
      <tspan data-lang-en>watermark W(10:03)</tspan>
      <tspan data-lang-vi>watermark W(10:03)</tspan>
    </text>

    <text x={noteX} y="302" class="sttm-note-b">
      <tspan data-lang-en>Steady traffic: 100 events/min</tspan>
      <tspan data-lang-vi>Lưu lượng thật đều 100/phút</tspan>
    </text>
    <text x={noteX} y="326" class="sttm-note">
      <tspan data-lang-en>Watermark waits for delayed 10:02</tspan>
      <tspan data-lang-vi>Watermark chờ tin 10:02 đến bù</tspan>
    </text>
    <text x={noteX} y="346" class="sttm-note">
      <tspan data-lang-en>events before closing that bucket.</tspan>
      <tspan data-lang-vi>rồi mới chốt cửa sổ phút đó.</tspan>
    </text>
    <text x={noteX} y="374" class="sttm-note-bad-s">
      <tspan data-lang-en>Stragglers past W are dropped or</tspan>
      <tspan data-lang-vi>Tin lạc quá mốc W bị bỏ hoặc</tspan>
    </text>
    <text x={noteX} y="394" class="sttm-note-bad-s">
      <tspan data-lang-en>emit an updated correction.</tspan>
      <tspan data-lang-vi>phát thêm bản cập nhật sửa số.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>A 60-second consumer deploy at 10:02 leaves processing-time metrics reading zero and then double. Grouping by event time keeps the true 100/min rate intact once watermarks account for backlog lag.</span>
    <span data-lang-vi>Một lần deploy consumer 60 giây lúc 10:02 khiến biểu đồ theo thời gian xử lý tụt về 0 rồi nhảy vọt gấp đôi. Gom theo thời gian sự kiện giữ nguyên mức 100/phút thực tế khi watermark đợi được lượng tồn đọng.</span>
  </figcaption>
</figure>

<style>
  .sttm {
    margin: 2em 0;
    width: 100%;
  }
  .sttm-scroll {
    overflow-x: auto;
  }
  .sttm svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .sttm text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .sttm .sttm-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .sttm .sttm-tick {
    font-size: 13px;
    fill: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .sttm .sttm-val {
    font-size: 13.5px;
    font-weight: 600;
    fill: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .sttm .sttm-val.is-bad {
    fill: var(--red);
    font-weight: 700;
  }
  .sttm .sttm-gap-lbl {
    font-size: 12.5px;
    fill: var(--red);
  }
  .sttm .sttm-in-lbl {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .sttm-axis {
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .sttm-grid {
    stroke: var(--border);
    stroke-dasharray: 4 4;
  }
  .sttm-rule {
    stroke: var(--border);
  }
  .sttm-bar {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .sttm-bar.is-bad {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .sttm-bar.is-gap {
    fill: none;
    stroke: var(--red);
    stroke-dasharray: 4 3;
    stroke-width: 1.4;
  }
  .sttm-bar.is-delayed {
    stroke-dasharray: 4 3;
  }
  .sttm-wm {
    stroke: var(--red);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .sttm .sttm-wm-lbl {
    font-size: 12.5px;
    font-weight: 600;
    fill: var(--red);
    font-variant-numeric: tabular-nums;
  }
  .sttm .sttm-note {
    font-size: 13.5px;
    fill: var(--text-muted);
  }
  .sttm .sttm-note-b {
    font-size: 14px;
    font-weight: 700;
    fill: var(--text);
  }
  .sttm .sttm-note-bad {
    font-size: 14px;
    font-weight: 700;
    fill: var(--red);
  }
  .sttm .sttm-note-bad-s {
    font-size: 13.5px;
    fill: var(--red);
  }
  .sttm figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
