---
// Interactive risk-classifier threshold and 8-generation feedback loop simulator
// wrapped in DemoFrame with bilingual caption and scoped styles (.eth-*).
import DemoFrame from './DemoFrame.astro';
import EthicsThresholdDemo from '../demos/EthicsThresholdDemo.tsx';
---
<figure class="eth-figure">
  <DemoFrame title="Threshold trade-offs and feedback-loop drift" titleVi="Đánh đổi ngưỡng từ chối và trôi lệch qua vòng lặp">
    <EthicsThresholdDemo client:visible />
  </DemoFrame>
  <figcaption>
    <span data-lang-en>Simulation of 100 applicants (50 per group, identical 80% genuinely safe ground truth) with a +8-point initial proxy offset on Group B. Lowering the threshold stops risky cases from slipping through but traps far more innocent people; stepping forward across retraining cycles shows how denying Group B today feeds worse outcomes into tomorrow's training set.</span>
    <span data-lang-vi>Mô phỏng với 100 hồ sơ (50 mỗi nhóm, tỉ lệ thật an toàn đều là 80%) khi Nhóm B chịu mức cộng điểm rủi ro đại diện ban đầu (+8 điểm). Kéo ngưỡng xuống giúp giảm ca lọt lưới nhưng đẩy nhiều người vô tội vào "nhà tù thuật toán"; bấm qua các vòng huấn luyện lại cho thấy việc chặn Nhóm B hôm nay tự tạo ra dữ liệu xấu cho mô hình ngày mai.</span>
  </figcaption>
</figure>

<style is:global>
  .eth-figure {
    margin: 2em 0;
    width: 100%;
  }
  .eth-figure > .demo-frame {
    margin-bottom: 0;
  }
  .eth-figure > figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
  .eth .sd-stat span,
  .eth .sd-group > span {
    text-transform: none;
    letter-spacing: 0;
    font-size: 12.5px;
    font-weight: 600;
  }
  .eth-slider-group {
    flex: 1 1 250px;
  }
  .eth-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-body);
  }
  .eth-range {
    flex: 1 1 130px;
    accent-color: var(--red);
  }
  .eth-val {
    min-width: 2.5ch;
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .eth-msg {
    margin: 0 0 14px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .eth-panels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 18px;
  }
  .eth-panel {
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-alt);
  }
  .eth-panel-title {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
  }
  .eth-group-block {
    margin-bottom: 12px;
  }
  .eth-group-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 6px;
    font-size: 12.5px;
    color: var(--text-body);
    font-weight: 600;
  }
  .eth-group-head small {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .eth-group-head small.is-bad {
    color: var(--red);
    font-weight: 700;
  }
  .eth-dots {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .eth-dot {
    display: inline-block;
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: var(--border);
  }
  .eth-dot.is-tn {
    background: var(--border);
  }
  .eth-dot.is-fp {
    background: var(--red);
  }
  .eth-dot.is-fn {
    background: var(--gold);
  }
  .eth-dot.is-tp {
    background: var(--text-muted);
  }
  .eth-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-top: 8px;
    font-size: 12px;
    color: var(--text-muted);
  }
  .eth-legend > span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .eth-chart {
    display: block;
    width: 100%;
    height: auto;
  }
  .eth-gridline {
    stroke: var(--border);
    stroke-width: 1;
  }
  .eth-tick {
    font-size: 11px;
    fill: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .eth-line-a {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2;
    stroke-dasharray: 5 3;
  }
  .eth-line-b {
    fill: none;
    stroke: var(--red);
    stroke-width: 2.5;
  }
  .eth-guide {
    stroke: var(--border);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }
  .eth-pt-a {
    fill: var(--text-muted);
  }
  .eth-pt-b {
    fill: var(--red);
  }
  .eth-lbl-a {
    font-size: 11.5px;
    font-weight: 600;
    fill: var(--text-muted);
  }
  .eth-lbl-b {
    font-size: 11.5px;
    font-weight: 700;
    fill: var(--red);
  }
</style>
