---
// Read skew: the post's $500 + $500 accounts and a $100 transfer, read under Read Committed vs one snapshot.
// Plain inline SVG, site tokens only, polygon arrowheads (no ids).
import DiagramIcon from './DiagramIcon.astro';
const left = [
  { icon: 'user', t: { en: '1. Read account A', vi: '1. Đọc tài khoản A' }, n: { en: 'before the transfer commits', vi: 'trước khi transfer commit' }, v: '$500', box: '' },
  { icon: 'money', t: { en: '2. Transfer of $100, A to B, commits', vi: '2. Transfer $100 từ A sang B commit' }, n: { en: 'A is now $400, B is $600', vi: 'A còn $400, B thành $600' }, v: '', box: '' },
  { icon: 'user', t: { en: '3. Read account B', vi: '3. Đọc tài khoản B' }, n: { en: 'sees the newest committed value', vi: 'thấy giá trị mới nhất đã commit' }, v: '$600', box: 'is-bad' },
];
const right = [
  { icon: 'backup', t: { en: '1. Snapshot frozen at start', vi: '1. Snapshot đóng băng lúc bắt đầu' }, n: { en: 'A is $500, B is $500', vi: 'A là $500, B là $500' }, v: '', box: '' },
  { icon: 'user', t: { en: '2. Read account A', vi: '2. Đọc tài khoản A' }, n: { en: 'from the snapshot', vi: 'từ snapshot' }, v: '$500', box: '' },
  { icon: 'user', t: { en: '3. Read account B', vi: '3. Đọc tài khoản B' }, n: { en: 'the transfer committed meanwhile, still hidden', vi: 'transfer đã commit nhưng vẫn bị ẩn' }, v: '$500', box: 'is-ok' },
];
const cols = [
  { x: 20, kind: 'is-bad', steps: left },
  { x: 470, kind: 'is-ok', steps: right },
];
---
<figure class="txrs">
  <div class="txrs-scroll">
  <svg viewBox="0 0 900 350" role="img" aria-label="Two panels reading two accounts that hold 500 dollars each. Left, Read Committed: read A as 500, a 100 dollar transfer from A to B commits, read B as 600, and the screen shows 1,100 dollars. Right, snapshot isolation: a snapshot is frozen at the start, A and B are both read as 500, and the total is 1,000 dollars.">
    <text x="20" y="26" class="h">
      <tspan data-lang-en>Read skew: two reads, two points in time</tspan>
      <tspan data-lang-vi>Read skew: hai lần đọc, hai thời điểm khác nhau</tspan>
    </text>
    {cols.map((c) => (
      <g>
        <rect x={c.x} y="44" width="410" height="292" rx="6" class={`txrs-panel ${c.kind}`} />
        <text x={c.x + 16} y="70" class={`sec ${c.kind === 'is-bad' ? 'is-bad' : ''}`}>
          {c.kind === 'is-bad'
            ? <><tspan data-lang-en>Read Committed: a fresh view per statement</tspan><tspan data-lang-vi>Read Committed: mỗi câu lệnh một góc nhìn mới</tspan></>
            : <><tspan data-lang-en>Snapshot isolation: one view for the whole transaction</tspan><tspan data-lang-vi>Snapshot isolation: một góc nhìn cho cả transaction</tspan></>}
        </text>
        {c.steps.map((s, i) => (
          <g>
            <rect x={c.x + 14} y={86 + i * 62} width="382" height="52" rx="4" class={`txrs-box ${s.box}`} />
            <DiagramIcon name={s.icon} x={c.x + 38} y={112 + i * 62} size={24} />
            <text x={c.x + 62} y={108 + i * 62} class="b"><tspan data-lang-en>{s.t.en}</tspan><tspan data-lang-vi>{s.t.vi}</tspan></text>
            <text x={c.x + 62} y={126 + i * 62} class="note"><tspan data-lang-en>{s.n.en}</tspan><tspan data-lang-vi>{s.n.vi}</tspan></text>
            {s.v && <text x={c.x + 384} y={116 + i * 62} class="b" text-anchor="end">{s.v}</text>}
          </g>
        ))}
        <rect x={c.x + 14} y="280" width="382" height="42" rx="4" class={`txrs-box ${c.kind}`} />
        {c.kind === 'is-bad'
          ? <text x={c.x + 205} y="306" class="b" text-anchor="middle"><tspan data-lang-en>$500 + $600 = $1,100: money appeared</tspan><tspan data-lang-vi>$500 + $600 = $1.100: tiền tự sinh ra</tspan></text>
          : <text x={c.x + 205} y="306" class="b" text-anchor="middle"><tspan data-lang-en>$500 + $500 = $1,000: consistent</tspan><tspan data-lang-vi>$500 + $500 = $1.000: nhất quán</tspan></text>}
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Both panels read the same two accounts and the same transfer commits in the middle. Under Read Committed the second read sees the new world, so the page adds up wrong. A snapshot keeps both reads in the same old world.</span>
    <span data-lang-vi>Cả hai panel đọc cùng hai tài khoản và cùng một transfer commit ở giữa. Với Read Committed, lần đọc thứ hai thấy thế giới mới nên tổng sai. Snapshot giữ cả hai lần đọc trong cùng một thế giới cũ.</span>
  </figcaption>
</figure>

<style>
  .txrs { margin: 2em 0; width: 100%; }
  .txrs-scroll { overflow-x: auto; }
  .txrs svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .txrs text { font-size: 13px; fill: var(--text-body); }
  .txrs .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .txrs .sec { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .txrs .sec.is-bad { fill: var(--red); }
  .txrs .b { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .txrs .m { font-size: 12.5px; fill: var(--text-body); }
  .txrs .mono { font-family: var(--font-mono, ui-monospace, monospace); font-size: 12px; }
  .txrs .note { font-size: 12px; fill: var(--text-muted); }
  .txrs .note.is-bad { fill: var(--red); font-weight: 600; }
  .txrs .note.is-ok { fill: var(--gold-icon); font-weight: 600; }
  .txrs .num { font-size: 12px; font-weight: 700; fill: var(--text); }
  .txrs-panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .txrs-panel.is-bad { stroke: var(--red); }
  .txrs-panel.is-ok { stroke: var(--gold); }
  .txrs-box { fill: var(--card-bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .txrs-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .txrs-box.is-ok { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .txrs-dot { fill: var(--card-bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .txrs-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .txrs-arrow.is-bad { stroke: var(--red); }
  .txrs-arrow.is-ok { stroke: var(--gold); }
  .txrs-dash { stroke-dasharray: 4 4; }
  .txrs-head { fill: var(--text-muted); }
  .txrs-head.is-bad { fill: var(--red); }
  .txrs-head.is-ok { fill: var(--gold); }
  .txrs-life { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .txrs figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.5; }
</style>
