---
// The three places multi-leader replication pays off: regions, offline devices, live collaboration.
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Arrow from './ReplicationBArrow.astro';
import Bi from './ReplicationBBi.astro';

const cols = [
  { th: 'Several regions', thv: 'Nhiều region', ic: 'cloud', a: ['Region A', 'Region A', 'writes fast, locally', 'ghi nhanh, tại chỗ'], b: ['Region B', 'Region B', 'works if the link breaks', 'chạy tiếp nếu đường truyền đứt'], n: 'Each region has its own leader.', nv: 'Mỗi region có leader riêng.', ib: 'cloud' },
  { th: 'Offline clients', thv: 'Client ngoại tuyến', ic: 'phone', a: ['Phone', 'Điện thoại', 'leader of its own copy', 'leader của bản sao riêng'], b: ['Laptop', 'Laptop', 'leader of its own copy', 'leader của bản sao riêng'], n: 'They sync when online, maybe days later.', nv: 'Đồng bộ khi có mạng, có khi vài ngày sau.', ib: 'laptop' },
  { th: 'Real-time collaboration', thv: 'Cộng tác thời gian thực', ic: 'laptop', a: ['Your browser tab', 'Tab trình duyệt của bạn', 'applies your edit at once', 'áp dụng chỉnh sửa ngay'], b: ['A teammate\'s tab', 'Tab của đồng đội', 'applies theirs at once', 'áp dụng chỉnh sửa của họ ngay'], n: 'Edits sync in the background.', nv: 'Các chỉnh sửa đồng bộ ngầm.', ib: 'laptop' },
];
---
<Frame h={330}
  label="Three places multi-leader replication pays off. Several regions: each region has a leader, writes are fast locally and a region keeps working when the link breaks. Offline clients: a phone and a laptop each lead their own copy and sync when online. Real-time collaboration: each open browser tab applies edits at once and syncs in the background."
  cap="In all three, two copies accept writes independently and exchange them afterwards. That is what makes each one fast, and what makes conflicts possible."
  capVi="Cả ba trường hợp đều có hai bản sao nhận ghi độc lập rồi trao đổi với nhau sau. Đó là thứ làm chúng nhanh, và cũng là thứ gây ra xung đột.">
  {cols.map((c, k) => {
    const x = 10 + k * 300;
    return (
      <g>
        <rect x={x} y={10} width={280} height={310} rx="8" class="rb-panel" />
        <text x={x + 140} y={40} text-anchor="middle" class="rb-h"><Bi en={c.th} vi={c.thv} /></text>
        <Node x={x + 14} y={64} w={252} h={64} icon={c.ic} t={c.a[0]} tv={c.a[1]} s={c.a[2]} sv={c.a[3]} cls="strong" />
        <Arrow x1={x + 128} y1={134} x2={x + 128} y2={196} />
        <Arrow x1={x + 152} y1={196} x2={x + 152} y2={134} />
        <text x={x + 170} y={170} class="rb-n"><Bi en="sync" vi="đồng bộ" /></text>
        <Node x={x + 14} y={202} w={252} h={64} icon={c.ib} t={c.b[0]} tv={c.b[1]} s={c.b[2]} sv={c.b[3]} cls="strong" />
        <text x={x + 140} y={296} text-anchor="middle" class="rb-n"><Bi en={c.n} vi={c.nv} /></text>
      </g>
    );
  })}
</Frame>
