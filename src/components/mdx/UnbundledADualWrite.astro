---
// Dual write: two concurrent requests reach two stores in opposite orders. Values are illustrative.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 292;
const heads = (x2: number, y: number) => `${x2 - 7},${y - 4} ${x2 - 7},${y + 4} ${x2},${y}`;
type Row = { y: number; icon: string; en: string; vi: string; first: [string, string]; second: [string, string]; fin: [string, string]; bad: boolean };
const rows: Row[] = [
  { y: 118, icon: 'postgres', en: 'PostgreSQL', vi: 'PostgreSQL', first: ['A arrives first', 'A tới trước'], second: ['B arrives second', 'B tới sau'], fin: ['Ends at price = 20', 'Kết quả: price = 20'], bad: false },
  { y: 204, icon: 'elasticsearch', en: 'Elasticsearch', vi: 'Elasticsearch', first: ['B arrives first', 'B tới trước'], second: ['A arrives second', 'A tới sau'], fin: ['Ends at price = 10', 'Kết quả: price = 10'], bad: true },
];
---
<figure class="ua-fig">
  <div class="ua-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two concurrent requests write to PostgreSQL and Elasticsearch. PostgreSQL sees A then B and ends at 20; Elasticsearch sees B then A and ends at 10, so the two stores disagree.">
      <text x="20" y="24" class="ua-h"><tspan data-lang-en>Same two writes, opposite order</tspan><tspan data-lang-vi>Cùng hai lệnh ghi, thứ tự ngược nhau</tspan></text>
      <rect x="20" y="42" width="425" height="52" rx="4" class="ua-box" />
      <DiagramIcon name="laptop" x={50} y={68} size={28} />
      <text x="78" y="73" class="ua-b"><tspan data-lang-en>Request A: set price to 10</tspan><tspan data-lang-vi>Request A: đặt price = 10</tspan></text>
      <rect x="455" y="42" width="425" height="52" rx="4" class="ua-box" />
      <DiagramIcon name="laptop" x={485} y={68} size={28} />
      <text x="513" y="73" class="ua-b"><tspan data-lang-en>Request B: set price to 20</tspan><tspan data-lang-vi>Request B: đặt price = 20</tspan></text>
      {rows.map((r) => (
        <>
          <rect x="20" y={r.y} width="200" height="60" rx="4" class="ua-box" />
          <DiagramIcon name={r.icon as any} x={52} y={r.y + 30} size={30} />
          <text x="80" y={r.y + 35} class="ua-b"><tspan data-lang-en>{r.en}</tspan><tspan data-lang-vi>{r.vi}</tspan></text>
          <path d={`M220,${r.y + 30} L253,${r.y + 30}`} class="ua-solid" />
          <polygon points={heads(260, r.y + 30)} class="ua-head" />
          <rect x="260" y={r.y} width="170" height="60" rx="4" class="ua-box" />
          <text x="345" y={r.y + 26} text-anchor="middle" class="ua-n"><tspan data-lang-en>1st</tspan><tspan data-lang-vi>Thứ nhất</tspan></text>
          <text x="345" y={r.y + 45} text-anchor="middle" class="ua-b"><tspan data-lang-en>{r.first[0]}</tspan><tspan data-lang-vi>{r.first[1]}</tspan></text>
          <path d={`M430,${r.y + 30} L463,${r.y + 30}`} class="ua-solid" />
          <polygon points={heads(470, r.y + 30)} class="ua-head" />
          <rect x="470" y={r.y} width="170" height="60" rx="4" class="ua-box" />
          <text x="555" y={r.y + 26} text-anchor="middle" class="ua-n"><tspan data-lang-en>2nd</tspan><tspan data-lang-vi>Thứ hai</tspan></text>
          <text x="555" y={r.y + 45} text-anchor="middle" class="ua-b"><tspan data-lang-en>{r.second[0]}</tspan><tspan data-lang-vi>{r.second[1]}</tspan></text>
          <path d={`M640,${r.y + 30} L673,${r.y + 30}`} class="ua-solid" />
          <polygon points={heads(680, r.y + 30)} class="ua-head" />
          <rect x="680" y={r.y} width="200" height="60" rx="4" class={r.bad ? 'ua-box is-hot' : 'ua-box'} />
          <text x="780" y={r.y + 35} text-anchor="middle" class={r.bad ? 'ua-b is-hot' : 'ua-b'}><tspan data-lang-en>{r.fin[0]}</tspan><tspan data-lang-vi>{r.fin[1]}</tspan></text>
        </>
      ))}
      <text x="450" y="284" text-anchor="middle" class="ua-n is-hot"><tspan data-lang-en>Neither store knows who won, so the index disagrees with the database for good.</tspan><tspan data-lang-vi>Không bên nào biết ai thắng, nên index lệch khỏi database vĩnh viễn.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Follow each row left to right: the order of arrival decides the final value.</span>
    <span data-lang-vi>Đọc từng hàng từ trái sang phải: thứ tự tới nơi quyết định giá trị cuối cùng.</span>
  </figcaption>
</figure>

<style>
  .ua-fig { margin: 2em 0; width: 100%; }
  .ua-scroll { overflow-x: auto; }
  .ua-fig svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .ua-fig text { font-size: 13px; fill: var(--text-body); }
  .ua-fig .ua-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-ph { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-b { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-m { font-size: 12.5px; fill: var(--text-muted); }
  .ua-fig .ua-n { font-size: 12.5px; font-weight: 700; fill: var(--text-muted); }
  .ua-fig .ua-n.is-hot, .ua-fig .ua-b.is-hot, .ua-fig .ua-m.is-hot { fill: var(--red); }
  .ua-fig .ua-n.is-good, .ua-fig .ua-b.is-good, .ua-fig .ua-m.is-good { fill: var(--gold-icon); }
  .ua-fig .ua-q { font-size: 20px; font-weight: 700; fill: var(--red); }
  .ua-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .ua-box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .ua-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .ua-panel { fill: none; stroke: var(--border); stroke-width: 1.2; }
  .ua-life { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .ua-solid { fill: none; stroke: var(--text-muted); stroke-width: 1.8; }
  .ua-dashed { fill: none; stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .ua-head { fill: var(--text-muted); }
  .ua-solid.is-hot, .ua-dashed.is-hot { stroke: var(--red); stroke-width: 1.9; }
  .ua-head.is-hot { fill: var(--red); }
  .ua-solid.is-good { stroke: var(--gold-icon); stroke-width: 2; }
  .ua-head.is-good { fill: var(--gold-icon); }
  .ua-fig figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
