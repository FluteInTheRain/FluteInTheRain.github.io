---
// Same table, two questions: checkout loads one row by key; finance scans every row for one column.
// Values are made up for illustration.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 340;
const cols = [
  { k: 'id', w: 64 }, { k: 'store', w: 104 }, { k: 'total', w: 84 }, { k: 'status', w: 100 },
];
const rows = [
  ['1040', 'Hanoi', '$24', 'paid'],
  ['1041', 'Hue', '$9', 'paid'],
  ['1042', 'Da Nang', '$31', 'new'],
  ['1043', 'Hanoi', '$12', 'paid'],
  ['1044', 'Hue', '$47', 'paid'],
  ['1045', 'Da Nang', '$8', 'paid'],
  ['...', '...', '...', '...'],
];
const rowH = 22;
const tblY = 96;
const tblW = cols.reduce((s, c) => s + c.w, 0);
const colX = (px: number, i: number) => px + cols.slice(0, i).reduce((s, c) => s + c.w, 0);
const panels = [
  { x: 20, icon: 'user', titleEn: 'Checkout asks: load order 1042', titleVi: 'Thanh toán hỏi: lấy đơn 1042',
    noteEn: 'Touches 1 row, found by its key', noteVi: 'Chạm 1 dòng, tìm theo khoá',
    note2En: 'Done in milliseconds', note2Vi: 'Xong trong vài mili-giây', hit: (r: number, c: number) => r === 2 },
  { x: 470, icon: 'chart', titleEn: 'Finance asks: total per store', titleVi: 'Tài chính hỏi: tổng theo cửa hàng',
    noteEn: 'Touches every row, two columns', noteVi: 'Chạm mọi dòng, hai cột',
    note2En: 'Millions of rows, fine to take seconds', note2Vi: 'Hàng triệu dòng, chạy vài giây cũng được', hit: (r: number, c: number) => r < 6 && c <= 2 && c >= 1 },
];
---
<figure class="topv">
  <div class="topv-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The same orders table asked two ways. Checkout loads one row, order 1042, by its key. Finance reads the store and total columns of every row to add them up.">
    {panels.map((p) => (
      <g>
        <DiagramIcon name={p.icon as any} x={p.x + 20} y={44} size={30} />
        <text x={p.x + 48} y={50} class="topv-h"><tspan data-lang-en>{p.titleEn}</tspan><tspan data-lang-vi>{p.titleVi}</tspan></text>
        {cols.map((c, ci) => (
          <text x={colX(p.x, ci) + 8} y={tblY - 6} class="topv-field">{c.k}</text>
        ))}
        {rows.map((r, ri) => (
          <g>
            {r.map((v, ci) => (
              <g>
                <rect x={colX(p.x, ci)} y={tblY + ri * rowH} width={cols[ci].w} height={rowH} class={p.hit(ri, ci) ? 'topv-cell is-hit' : 'topv-cell'} />
                <text x={colX(p.x, ci) + 8} y={tblY + ri * rowH + 15} class={p.hit(ri, ci) ? 'topv-v is-hit' : 'topv-v'}>{v}</text>
              </g>
            ))}
          </g>
        ))}
        <text x={p.x} y={tblY + rows.length * rowH + 30} class="topv-name"><tspan data-lang-en>{p.noteEn}</tspan><tspan data-lang-vi>{p.noteVi}</tspan></text>
        <text x={p.x} y={tblY + rows.length * rowH + 50} class="topv-small"><tspan data-lang-en>{p.note2En}</tspan><tspan data-lang-vi>{p.note2Vi}</tspan></text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Gold cells are what each question has to read. Same table, very different work. Values are made up for illustration.</span>
    <span data-lang-vi>Ô màu vàng là phần mỗi câu hỏi phải đọc. Cùng một bảng nhưng khối lượng việc rất khác nhau. Giá trị là số tự đặt để minh hoạ.</span>
  </figcaption>
</figure>

<style>
  .topv { margin: 2em 0; width: 100%; }
  .topv-scroll { overflow-x: auto; }
  .topv svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .topv text { font-size: 13px; fill: var(--text-body); }
  .topv .topv-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .topv .topv-field { font-size: 12px; fill: var(--text-muted); font-weight: 700; }
  .topv .topv-name { font-weight: 700; fill: var(--text); }
  .topv .topv-small { fill: var(--text-muted); }
  .topv .topv-v.is-hit { fill: var(--text); font-weight: 700; }
  .topv-cell { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .topv-cell.is-hit { fill: var(--gold-tint-bg); stroke: var(--gold-icon); }
  .topv figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
