---
import DiagramIcon from './DiagramIcon.astro';
// The SEC's order on Knight Capital (Release No. 34-70694, paras 15-17): eight
// SMARS servers, the new RLP code reached seven, the eighth still had the old
// Power Peg code; 212 parent orders led to 4 million executions in 154 stocks,
// over 397 million shares, in about 45 minutes, and a $460 million loss.
const W = 900, H = 330;
const boxes = Array.from({ length: 8 }, (_, i) => ({ x: 40 + i * 104, bad: i === 7 }));
---
<figure class="bep12a">
  <div class="bep12a-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Eight servers in a row. The first seven got the new code and are drawn in a neutral outline. The eighth was missed, still runs the old Power Peg code, and is drawn in red. Below: 212 parent orders turned into 4 million executions and a 460 million dollar loss in about 45 minutes.">
    <text x="40" y="30" class="h"><tspan data-lang-en>one deploy, eight servers</tspan><tspan data-lang-vi>một lần deploy, tám server</tspan></text>
    {boxes.map((b, i) => (
      <g>
        <rect x={b.x} y="50" width="92" height="84" rx="8" class={b.bad ? 'box bad' : 'box'} />
        <DiagramIcon name="server" x={b.x + 46} y="84" size={26} />
        <text x={b.x + 46} y="122" text-anchor="middle" class={b.bad ? 'sm red' : 'sm'}><tspan data-lang-en>{b.bad ? 'old code' : 'new code'}</tspan><tspan data-lang-vi>{b.bad ? 'code cũ' : 'code mới'}</tspan></text>
      </g>
    ))}
    <text x="40" y="164" class="note"><tspan data-lang-en>7 servers got the new code</tspan><tspan data-lang-vi>7 server nhận code mới</tspan></text>
    <text x="690" y="164" class="note red"><tspan data-lang-en>1 server was missed</tspan><tspan data-lang-vi>1 server bị bỏ sót</tspan></text>
    <line x1="40" y1="190" x2="860" y2="190" class="axis" />
    <text x="40" y="230" class="num"><tspan data-lang-en>212</tspan><tspan data-lang-vi>212</tspan></text>
    <text x="40" y="252" class="note"><tspan data-lang-en>orders sent the repurposed flag</tspan><tspan data-lang-vi>order mang cờ bị dùng lại</tspan></text>
    <text x="330" y="230" class="num"><tspan data-lang-en>about 45 min</tspan><tspan data-lang-vi>khoảng 45 phút</tspan></text>
    <text x="330" y="252" class="note"><tspan data-lang-en>4 million executions, 154 stocks</tspan><tspan data-lang-vi>4 triệu lệnh khớp, 154 mã</tspan></text>
    <text x="640" y="230" class="num red"><tspan data-lang-en>$460 million</tspan><tspan data-lang-vi>460 triệu USD</tspan></text>
    <text x="640" y="252" class="note"><tspan data-lang-en>realised loss</tspan><tspan data-lang-vi>khoản lỗ thực tế</tspan></text>
    <text x="40" y="304" class="note"><tspan data-lang-en>the SEC found no second technician reviewed the deploy and no written procedure required one</tspan><tspan data-lang-vi>SEC ghi nhận không có kỹ thuật viên thứ hai kiểm tra và không có quy trình bằng văn bản yêu cầu việc đó</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Figures from the SEC order. The bug was old code; the failure was a deploy nobody could verify per server.</span>
    <span data-lang-vi>Số liệu lấy từ lệnh của SEC. Lỗi nằm ở code cũ; sự cố nằm ở lần deploy mà không ai kiểm chứng được từng server.</span>
  </figcaption>
</figure>

<style>
  .bep12a { margin: 2em 0; width: 100%; }
  .bep12a-scroll { overflow-x: auto; }
  .bep12a svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .bep12a text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep12a .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep12a .sm { font-size: 13px; fill: var(--text-muted); }
  .bep12a .note { fill: var(--text-muted); font-size: 13px; }
  .bep12a .num { font-weight: 700; fill: var(--text); font-size: 22px; }
  .bep12a .red { fill: var(--red); }
  .bep12a .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep12a .box.bad { stroke: var(--red); stroke-width: 2.4; fill: var(--red-tint-bg); }
  .bep12a .axis { stroke: var(--border); stroke-width: 1.4; }
  .bep12a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
