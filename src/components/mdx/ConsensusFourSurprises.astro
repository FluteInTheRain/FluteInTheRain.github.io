---
// Picture-first overview of the four failures that open the post. One card each; the figure
// only names the symptom, the sections after it explain the cure. Static SVG, site tokens only.
import ConsensusFigure from './ConsensusFigure.astro';
import DiagramIcon from './DiagramIcon.astro';
interface Props { lang: 'en' | 'vi' }
const { lang } = Astro.props;

const T = {
  en: {
    aria: 'Four cards. One: a leader cut off from the cluster still answers reads from its own old copy (etcd, MongoDB). Two: with w=2, r=2, n=3 one reader sees the new value and the next reader still sees the old one. Three: a private photo gets an earlier timestamp than the privacy switch because two shards have skewed clocks. Four: Kafka unclean leader election promotes a lagging broker and committed messages are overwritten. A strip below says three ideas cover all four: linearizability, logical clocks and consensus.',
    cards: [
      { icons: ['etcd', 'mongodb'], title: ['Stale read from a', 'cut-off leader'], body: ['A leader that lost an', 'election still answers', 'reads from its own copy.'] },
      { icons: ['db', 'db', 'db'], title: ['Two quorums, two', 'different answers'], body: ['With w=2, r=2, n=3 one', 'reader sees the new value;', 'the next still sees the old', 'one (async read repair).'] },
      { icons: ['laptop', 'phone'], title: ['A photo older than', 'its privacy switch'], body: ['Two shards with skewed', 'clocks stamp the photo', 'earlier than the switch.'] },
      { icons: ['kafka'], title: ['Committed data lost', 'in a fast failover'], body: ['Unclean election promotes', 'a lagging broker; committed', 'messages are overwritten.'] },
    ],
    strip: 'One small set of ideas covers all four: linearizability, logical clocks, consensus.',
    cap: 'Four real failure patterns, one card each. The sections below explain the three ideas that prevent them.',
  },
  vi: {
    aria: 'Bốn thẻ. Một: leader bị cô lập vẫn trả lời đọc từ bản cũ của chính nó (etcd, MongoDB). Hai: với w=2, r=2, n=3, một người đọc thấy giá trị mới còn người đọc kế tiếp vẫn thấy giá trị cũ. Ba: ảnh riêng tư có giờ sớm hơn lúc bật chế độ riêng tư vì hai shard lệch đồng hồ. Bốn: Kafka unclean leader election đưa broker tụt hậu lên làm leader và tin nhắn đã commit bị ghi đè. Dải bên dưới nói ba ý tưởng giải quyết cả bốn: tính khả tuyến tính, đồng hồ logic và đồng thuận.',
    cards: [
      { icons: ['etcd', 'mongodb'], title: ['Đọc dữ liệu cũ từ', 'leader bị cô lập'], body: ['Leader đã thua bầu cử vẫn', 'trả lời đọc bằng bản', 'của chính nó.'] },
      { icons: ['db', 'db', 'db'], title: ['Hai quorum, hai đáp', 'án khác nhau'], body: ['Với w=2, r=2, n=3, một người', 'đọc thấy giá trị mới, người', 'kế tiếp vẫn thấy giá trị cũ', '(read repair bất đồng bộ).'] },
      { icons: ['laptop', 'phone'], title: ['Ảnh có giờ sớm hơn', 'lúc đổi chế độ riêng tư'], body: ['Hai shard lệch đồng hồ gán', 'giờ cho ảnh sớm hơn giờ', 'của lần đổi chế độ.'] },
      { icons: ['kafka'], title: ['Mất dữ liệu đã commit', 'khi failover nhanh'], body: ['Unclean election đưa broker', 'tụt hậu lên làm leader; tin', 'nhắn đã commit bị ghi đè.'] },
    ],
    strip: 'Một bộ ý tưởng nhỏ giải quyết cả bốn: tính khả tuyến tính, đồng hồ logic, đồng thuận.',
    cap: 'Bốn kiểu lỗi thật, mỗi thẻ một kiểu. Các phần sau giải thích ba ý tưởng giúp tránh chúng.',
  },
}[lang];

const cw = 200;
const step = 233.3;
---
<ConsensusFigure aria={T.aria} cap={T.cap} w={900} h={280}>
  {T.cards.map((c, i) => {
    const x = Math.round(i * step);
    return (
      <g>
        <rect x={x} y="0" width={cw} height="200" rx="8" class="cfg-box is-bad" />
        {c.icons.map((n, k) => <DiagramIcon name={n as any} x={x + 28 + k * 40} y={34} size={28} />)}
        {c.title.map((t, k) => <text x={x + 14} y={86 + k * 18} class="cfg-n" style="font-size:14px">{t}</text>)}
        {c.body.map((t, k) => <text x={x + 14} y={132 + k * 17} class="cfg-m" style="fill:var(--text-body)">{t}</text>)}
      </g>
    );
  })}
  <rect x="0" y="224" width="900" height="44" rx="8" class="cfg-box is-ok" />
  <text x="450" y="251" text-anchor="middle" class="cfg-g" style="font-size:14px">{T.strip}</text>
</ConsensusFigure>
