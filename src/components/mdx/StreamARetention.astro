---
// Retention back-of-the-envelope: a 20 TB drive written at 250 MB/s overwrites itself in about 22 hours
// (20,000,000 MB / 250 MB/s = 80,000 s). The segment strip below is illustrative.
import DiagramIcon from './DiagramIcon.astro';
import StreamAFrame from './StreamAFrame.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    h: 'How long does the log last? A back-of-the-envelope check',
    a: '20 TB drive', as: '20,000,000 MB', b: '250 MB/s', bs: 'sequential writes', c: 'about 22 hours', cs: '80,000 s to overwrite once',
    strip: 'The same log as segments: old ones are deleted, new ones are appended (illustrative)',
    seg: 'seg', next: 'next write', del: 'deleted: past the retention window', keep: 'kept: still readable',
    stall: 'Stalled consumer: fix it before its segment is deleted',
    alt: 'An equation: a 20 TB drive divided by 250 MB/s of sequential writes equals about 22 hours to overwrite once. Below, a strip of log segments: the two oldest are deleted, five are kept, and the next write is appended at the end. A stalled consumer points at the oldest kept segment.',
    cap: 'Real clusters write slower than the disk limit, so the runway is days or weeks. The log is a circular buffer on disk.',
  },
  vi: {
    h: 'Log giữ được bao lâu? Tính nhẩm nhanh',
    a: 'Ổ 20 TB', as: '20.000.000 MB', b: '250 MB/s', bs: 'ghi tuần tự', c: 'khoảng 22 giờ', cs: '80.000 giây để ghi đè một lượt',
    strip: 'Cùng log đó dưới dạng segment: segment cũ bị xoá, segment mới được nối thêm (minh hoạ)',
    seg: 'seg', next: 'ghi tiếp', del: 'đã xoá: quá hạn lưu giữ', keep: 'còn giữ: vẫn đọc được',
    stall: 'Consumer bị kẹt: sửa trước khi segment của nó bị xoá',
    alt: 'Một phép tính: ổ 20 TB chia cho 250 MB/s ghi tuần tự bằng khoảng 22 giờ để ghi đè một lượt. Bên dưới là dải các segment của log: hai segment cũ nhất đã bị xoá, năm segment còn giữ, và lần ghi tiếp theo được nối vào cuối. Một consumer bị kẹt trỏ vào segment cũ nhất còn giữ.',
    cap: 'Cụm thật ghi chậm hơn giới hạn của đĩa, nên khoảng đệm là vài ngày đến vài tuần. Log là một bộ đệm vòng nằm trên đĩa.',
  },
}[lang];
const sx = (i: number) => 20 + i * 104;
---
<StreamAFrame h={336} alt={T.alt} cap={T.cap} title={T.h}>
  <g class="box"><rect x="20" y="52" width="230" height="76" rx="7" /></g>
  <DiagramIcon name="disk" x={50} y={90} size={30} />
  <text x="80" y="88" class="name">{T.a}</text>
  <text x="80" y="108" class="sub">{T.as}</text>
  <text x="274" y="100" text-anchor="middle" class="name" style="font-size:26px">÷</text>
  <g class="box"><rect x="298" y="52" width="230" height="76" rx="7" /></g>
  <DiagramIcon name="stopwatch" x={328} y={90} size={30} />
  <text x="358" y="88" class="name">{T.b}</text>
  <text x="358" y="108" class="sub">{T.bs}</text>
  <text x="552" y="100" text-anchor="middle" class="name" style="font-size:26px">=</text>
  <g class="box good"><rect x="576" y="52" width="304" height="76" rx="7" /></g>
  <DiagramIcon name="clock" x={606} y={90} size={30} />
  <text x="636" y="88" class="name">{T.c}</text>
  <text x="636" y="108" class="sub">{T.cs}</text>
  <line x1="20" x2="880" y1="152" y2="152" class="rule" />
  <text x="20" y="178" class="sub">{T.strip}</text>
  {[0, 1, 2, 3, 4, 5, 6].map((i) => (
    <g class={i < 2 ? 'box ghost' : 'box'}>
      <rect x={sx(i)} y="192" width="96" height="42" rx="5" />
      <text x={sx(i) + 48} y="218" text-anchor="middle" class="num">{`${T.seg} ${i + 1}`}</text>
    </g>
  ))}
  <g class="box dash"><rect x={sx(7)} y="192" width="96" height="42" rx="5" /></g>
  <text x={sx(7) + 48} y="218" text-anchor="middle" class="sub">{T.next}</text>
  <text x={sx(0) + 100} y="256" text-anchor="middle" class="sub">{T.del}</text>
  <text x={sx(4) + 48} y="256" text-anchor="middle" class="sub">{T.keep}</text>
  <line x1={sx(2) + 48} x2={sx(2) + 48} y1="298" y2="248" class="rule" style="stroke:var(--red);stroke-width:1.5" />
  <polygon points={`${sx(2) + 48},240 ${sx(2) + 43},250 ${sx(2) + 53},250`} style="fill:var(--red)" />
  <text x={sx(2) + 60} y="304" class="bad">{T.stall}</text>
</StreamAFrame>
