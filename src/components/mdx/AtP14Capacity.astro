---
// Rows of data versus weights in the network, on a log axis. All three numbers are arithmetic:
// 10 years x 252 trading days = 2,520; 393 HOSE codes at end of 2024 x 120 months = 47,160 (upper bound, not every code
// was listed for ten years); NN3 weights with 920 inputs = 30,145.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 350;
const x0 = 58, x1 = 800;
const lo = Math.log10(1000), hi = Math.log10(100000);
const gx = (v: number) => x0 + ((Math.log10(v) - lo) / (hi - lo)) * (x1 - x0);
const bars = [
  { v: 2520, label: { en: 'One stock, 10 years of daily rows', vi: 'Một cổ phiếu, 10 năm dữ liệu ngày' }, val: '2,520', tone: 'rows', icon: 'chart' },
  { v: 47160, label: { en: '393 HOSE codes × 120 months (at most)', vi: '393 mã HOSE × 120 tháng (tối đa)' }, val: '47,160', tone: 'rows', icon: 'chart' },
  { v: 30145, label: { en: 'Weights in a 32-16-8 net on 920 features', vi: 'Trọng số của mạng 32-16-8 với 920 feature' }, val: '30,145', tone: 'w', icon: 'model' },
];
const ticks = [1000, 10000, 100000];
const top = 92, step = 62;
---
<figure class="atp14-cap">
  <div class="atp14-cap-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three bars on a log axis. One stock over ten years of daily data gives 2,520 rows. All 393 HOSE codes over 120 months give at most 47,160 rows. A network with layers of 32, 16 and 8 units fed 920 features has 30,145 weights: about 12 weights per daily row of one stock, and 0.64 per monthly row of the whole HOSE panel.">
    <text x="20" y="26" class="h">
      <tspan data-lang-en>More weights than rows is the normal case</tspan>
      <tspan data-lang-vi>Trọng số nhiều hơn số dòng dữ liệu là chuyện bình thường</tspan>
    </text>
    <text x="20" y="46" class="sub">
      <tspan data-lang-en>Log scale. Rows are an upper bound; weights count every connection and bias.</tspan>
      <tspan data-lang-vi>Thang log. Số dòng là cận trên; trọng số tính mọi kết nối và bias.</tspan>
    </text>
    {ticks.map((t) => (
      <g>
        <line x1={gx(t)} y1="64" x2={gx(t)} y2={top + step * 3 - 20} class="grid" />
        <text x={gx(t)} y={top + step * 3 + 8} text-anchor="middle" class="tick">{t.toLocaleString('en-US')}</text>
      </g>
    ))}
    {bars.map((b, i) => (
      <g>
        <DiagramIcon name={b.icon as 'chart' | 'model'} x={32} y={top + i * step + 4} size={22} />
        <text x="58" y={top + i * step} class="lab">
          <tspan data-lang-en>{b.label.en}</tspan>
          <tspan data-lang-vi>{b.label.vi}</tspan>
        </text>
        <rect x={x0} y={top + i * step + 8} width={gx(b.v) - x0} height="26" rx="4" class={`bar ${b.tone}`} />
        <text x={gx(b.v) + 8} y={top + i * step + 26} class="num">{b.val}</text>
      </g>
    ))}
    <text x="20" y={top + step * 3 + 40} class="note">
      <tspan data-lang-en>One stock, daily: about 12 weights for every row (30,145 / 2,520).</tspan>
      <tspan data-lang-vi>Một cổ phiếu, theo ngày: khoảng 12 trọng số cho mỗi dòng (30.145 / 2.520).</tspan>
    </text>
    <text x="20" y={top + step * 3 + 62} class="note">
      <tspan data-lang-en>Whole HOSE panel, monthly: about 0.64 per row (30,145 / 47,160).</tspan>
      <tspan data-lang-vi>Cả bảng HOSE, theo tháng: khoảng 0,64 cho mỗi dòng (30.145 / 47.160).</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Rows: 252 trading days × 10 years; HOSE had 393 listed codes at the end of 2024 (VnExpress). Weights: 920 × 32 + 32, 32 × 16 + 16, 16 × 8 + 8 and 8 + 1.</span>
    <span data-lang-vi>Số dòng: 252 phiên × 10 năm; HOSE có 393 mã niêm yết cuối 2024 (VnExpress). Trọng số: 920 × 32 + 32, 32 × 16 + 16, 16 × 8 + 8 và 8 + 1.</span>
  </figcaption>
</figure>

<style>
  .atp14-cap { margin: 2em 0; width: 100%; }
  .atp14-cap-scroll { overflow-x: auto; }
  .atp14-cap svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .atp14-cap text { font-size: 14px; fill: var(--text-body); }
  .atp14-cap .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp14-cap .sub { font-size: 13px; fill: var(--text-muted); }
  .atp14-cap .lab { font-size: 13.5px; font-weight: 600; fill: var(--text); }
  .atp14-cap .num { font-size: 14px; font-weight: 700; fill: var(--text); }
  .atp14-cap .tick { font-size: 12px; fill: var(--text-muted); }
  .atp14-cap .note { font-size: 13.5px; fill: var(--text-body); }
  .atp14-cap .grid { stroke: var(--border); stroke-width: 1; stroke-dasharray: 3 3; }
  .atp14-cap .bar.rows { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .atp14-cap .bar.w { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .atp14-cap figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
