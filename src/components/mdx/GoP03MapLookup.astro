---
// Values come from the output shown in the post: 0 false for m["lint"], 1 true for m["go"]; map from the code above it.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

import DiagramIcon from './DiagramIcon.astro';
---
<figure class="gp03e">
  <div class="gp03e-scroll">
  <svg viewBox="0 0 900 245" role="img" aria-label="A map with keys go, vet and fmt. Looking up go returns 1 and true. Looking up lint finds no key and returns 0 and false.">
<text x="360" y="22" class="hd">m</text>
    <DiagramIcon name="db" x={392} y={17} size={24} />
    <rect x="360" y="55" width="180" height="36" rx="4" class="cell" />
    <text x="380" y="78" class="strong">"go"</text>
    <text x="520" y="78" text-anchor="end" class="num">1</text>
    <rect x="360" y="95" width="180" height="36" rx="4" class="cell" />
    <text x="380" y="118" class="strong">"vet"</text>
    <text x="520" y="118" text-anchor="end" class="num">2</text>
    <rect x="360" y="135" width="180" height="36" rx="4" class="cell" />
    <text x="380" y="158" class="strong">"fmt"</text>
    <text x="520" y="158" text-anchor="end" class="num">3</text>
    <rect x="360" y="185" width="180" height="36" rx="4" class="cell free" />
    <text x="450" y="208" text-anchor="middle" class="mut"><tspan data-lang-en>no "lint" key</tspan><tspan data-lang-vi>không có khóa "lint"</tspan></text>
    <rect x="20" y="55" width="260" height="36" rx="6" class="box" />
    <DiagramIcon name="search" x={42} y={73} size={26} />
    <text x="160" y="78" text-anchor="middle" class="strong">v, ok := m["go"]</text>
    {(() => { const a = arrow(280, 73, 356, 73); return <g><path d={a.line} class="ln" /><polygon points={a.head} fill="var(--text-muted)" /></g>; })()}
    {(() => { const a = arrow(544, 73, 640, 73); return <g><path d={a.line} class="ln" /><polygon points={a.head} fill="var(--text-muted)" /></g>; })()}
    <circle class="dot fm-dot" r="4"><animateMotion dur="2.2s" repeatCount="indefinite" path="M280,73 L640,73"/></circle>
    <text x="650" y="78" class="num">1 true</text>
    <rect x="20" y="185" width="260" height="36" rx="6" class="box hot fm-pulse" />
    <DiagramIcon name="search" x={42} y={203} size={26} />
    <text x="160" y="208" text-anchor="middle" class="strong hot">v, ok := m["lint"]</text>
    {(() => { const a = arrow(280, 203, 356, 203); return <g><path d={a.line} class="ln hot" /><polygon points={a.head} fill="var(--red)" /></g>; })()}
    {(() => { const a = arrow(544, 203, 640, 203); return <g><path d={a.line} class="ln hot" /><polygon points={a.head} fill="var(--red)" /></g>; })()}
    <text x="650" y="208" class="num hot">0 false</text>
    <DiagramIcon name="ok" x={734} y={73} size={24} />
    <text x="756" y="78" class="mut"><tspan data-lang-en>found</tspan><tspan data-lang-vi>có khóa</tspan></text>
    <DiagramIcon name="fail" x={734} y={203} size={24} />
    <text x="756" y="208" class="mut"><tspan data-lang-en>zero value, ok is false</tspan><tspan data-lang-vi>giá trị zero, ok là false</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>A missing key is not an error: you get the zero value of the value type. Only ok tells a missing key apart from a stored 0.</span>
    <span data-lang-vi>Khóa không có không phải là lỗi: bạn nhận giá trị zero của kiểu giá trị. Chỉ có ok phân biệt được khóa không có với số 0 được lưu thật.</span>
  </figcaption>
</figure>

<style>
  .gp03e { margin: 2em 0; width: 100%; }
  .gp03e-scroll { overflow-x: auto; }
  .gp03e svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp03e text { font-size: 14px; fill: var(--text-body); }
  .gp03e .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp03e .mut { fill: var(--text-muted); }
  .gp03e .strong { font-weight: 700; fill: var(--text); }
  .gp03e .num { font-variant-numeric: tabular-nums; font-weight: 700; fill: var(--text); }
  .gp03e .cell { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp03e .cell.free { fill: none; stroke-dasharray: 4 3; stroke: var(--border); }
  .gp03e .cell.hot { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp03e text.hot { fill: var(--red); font-weight: 700; }
  .gp03e .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp03e .box.hot { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp03e .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp03e .ln.thin { stroke: var(--border); stroke-width: 1; }
  .gp03e .ln.dash { stroke-dasharray: 3 4; }
  .gp03e .ln.hot { stroke: var(--red); }
  .gp03e .hd { fill: var(--text-muted); }
  .gp03e .hd.hot { fill: var(--red); }
  .gp03e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  .gp03e .dot { fill: var(--gold); stroke: var(--text); stroke-width: 1; }
</style>
