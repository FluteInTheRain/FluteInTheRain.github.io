---
// "Happened before" versus "concurrent": the question a database has to answer for every pair of writes.
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Arrow from './ReplicationBArrow.astro';
import Bi from './ReplicationBBi.astro';
---
<Frame h={260}
  label="Two cases for a pair of writes. Left: writer B had seen write A before writing, so A happened before B and B simply overwrites A. Right: neither writer had seen the other, so the writes are concurrent and something must resolve the conflict."
  cap="The only difference is whether B knew about A. The clock does not tell you that."
  capVi="Khác biệt duy nhất là B có biết về A hay không. Đồng hồ không cho bạn biết điều đó.">
  <rect x="10" y="10" width="430" height="240" rx="8" class="rb-panel" />
  <text x="225" y="38" text-anchor="middle" class="rb-h"><Bi en="B knew about A" vi="B biết về A" /></text>
  <Node x={30} y={60} w={150} h={60} icon="laptop" t="Write A" tv="Ghi A" s="x = 1" sv="x = 1" />
  <Node x={270} y={60} w={150} h={60} icon="laptop" t="Write B" tv="Ghi B" s="x = 2" sv="x = 2" />
  <Arrow x1={180} y1={90} x2={270} y2={90} cls="gold" />
  <text x="225" y="80" text-anchor="middle" class="rb-n"><Bi en="B saw A" vi="B thấy A" /></text>
  <Arrow x1={225} y1={130} x2={225} y2={166} cls="gold" />
  <Node x={30} y={166} w={390} h={60} icon="ok" t="A happened before B" tv="A xảy ra trước B" s="B overwrites A, no conflict" sv="B ghi đè A, không xung đột" cls="gold" />

  <rect x="460" y="10" width="430" height="240" rx="8" class="rb-panel" />
  <text x="675" y="38" text-anchor="middle" class="rb-h"><Bi en="Neither knew about the other" vi="Không bên nào biết bên kia" /></text>
  <Node x={480} y={60} w={150} h={60} icon="laptop" t="Write A" tv="Ghi A" s="x = 1" sv="x = 1" />
  <Node x={720} y={60} w={150} h={60} icon="laptop" t="Write B" tv="Ghi B" s="x = 2" sv="x = 2" />
  <text x="675" y="95" text-anchor="middle" class="rb-n"><Bi en="no message" vi="không có tin" /></text>
  <Arrow x1={675} y1={130} x2={675} y2={166} cls="red" />
  <Node x={480} y={166} w={390} h={60} icon="warning" t="A and B are concurrent" tv="A và B đồng thời" s="something must resolve it" sv="phải có thứ gì đó giải quyết" cls="red" />
</Frame>
