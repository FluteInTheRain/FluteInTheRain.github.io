---
// Shared frame for the ReplicationB figures: figure, sideways scroll on phones, caption, and the
// style classes (rb-*) used by ReplicationBNode, ReplicationBArrow and the figures themselves.
interface Props {
  w?: number; h: number; min?: number;
  label: string;
  cap: string; capVi: string;
}
const { w = 900, h, min = 640, label, cap, capVi } = Astro.props;
---
<figure class="rb">
  <div class="rb-scroll">
    <svg viewBox={`0 0 ${w} ${h}`} role="img" aria-label={label} style={`min-width:${min}px`}>
      <slot />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>{cap}</span>
    <span data-lang-vi>{capVi}</span>
  </figcaption>
</figure>

<style is:global>
  .rb { margin: 2em 0; width: 100%; }
  .rb-scroll { overflow-x: auto; }
  .rb svg { display: block; width: 100%; height: auto; }
  .rb text { font-size: 14px; fill: var(--text-body); }
  .rb .rb-h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .rb .rb-n { font-size: 12.5px; fill: var(--text-muted); }
  .rb .rb-t { font-size: 14px; fill: var(--text-body); }
  .rb .rb-mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; fill: var(--text); }
  .rb .rb-title { font-size: 15.5px; font-weight: 700; fill: var(--text); }
  .rb .rb-bad { fill: var(--red); font-weight: 700; }
  .rb .rb-good { fill: var(--text); font-weight: 700; }
  .rb .rb-step { font-size: 12.5px; font-weight: 700; fill: var(--text); }
  .rb .rb-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .rb .rb-box.strong { stroke: var(--text); stroke-width: 1.8; }
  .rb .rb-box.gold { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.8; }
  .rb .rb-box.red { stroke: var(--red); stroke-width: 1.8; }
  .rb .rb-box.dash { stroke-dasharray: 5 4; fill: transparent; stroke: var(--text-faint); }
  .rb .rb-box.plain { fill: transparent; stroke: var(--border); }
  .rb .rb-panel { fill: none; stroke: var(--border); stroke-width: 1; }
  .rb .rb-dot { fill: var(--text-muted); }
  .rb .rb-dot.red { fill: var(--red); }
  .rb .rb-dot.gold { fill: var(--gold-icon); }
  .rb .rb-edge { stroke: var(--text-muted); stroke-width: 1.4; fill: none; }
  .rb .rb-edge.dash { stroke-dasharray: 5 4; }
  .rb .rb-edge.red { stroke: var(--red); stroke-dasharray: 5 4; }
  .rb .rb-edge.gold { stroke: var(--gold-icon); stroke-width: 2; }
  .rb .rb-head { fill: var(--text-muted); }
  .rb .rb-head.red { fill: var(--red); }
  .rb .rb-head.gold { fill: var(--gold-icon); }
  .rb .rb-head.dash { fill: var(--text-muted); }
  .rb .rb-rule { stroke: var(--border); stroke-width: 1; }
  .rb .rb-axis { stroke: var(--text-faint); stroke-width: 1.2; }
  .rb figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
