---
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 368;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const aTop1 = arrow(244, 74, 300, 74);
const aTop2 = arrow(244, 126, 300, 126);
const aTop3 = arrow(566, 98, 636, 98);

const aBot1 = arrow(244, 260, 300, 260);
const aBot2 = arrow(244, 314, 300, 314);
const aBot3 = arrow(566, 286, 636, 286);
---
<figure class="g13nil">
  <div class="g13nil-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Comparing a closed channel left inside select versus assigning ch1 = nil. Top: closed ch1 immediately yields (0, false) every iteration, spinning at 100% CPU. Bottom: assigning ch1 = nil disables that select branch so select waits cleanly for ch2 and exits when both are nil.">
      {/* Row 1: Closed channel spin */}
      <text x="20" y="24" class="g13nil-h is-red">
        <tspan data-lang-en>1. Closed channel left active: busy-wait loop</tspan>
        <tspan data-lang-vi>1. Giữ nguyên channel đã đóng: vòng lặp quay rỗng</tspan>
      </text>

      <rect x="20" y="48" width="220" height="48" rx="7" class="g13nil-box is-red" />
      <DiagramIcon name="chan-in" x={214} y={62} size={24} />
      <text x="136" y="70" text-anchor="middle" class="g13nil-b is-red">ch1 (closed)</text>
      <text x="136" y="88" text-anchor="middle" class="g13nil-red">
        <tspan data-lang-en>yields (0, false) nonstop</tspan>
        <tspan data-lang-vi>trả ngay (0, false) liên tục</tspan>
      </text>

      <rect x="20" y="106" width="220" height="40" rx="7" class="g13nil-box" />
      <text x="130" y="131" text-anchor="middle" class="g13nil-sub">
        <tspan data-lang-en>ch2 (still waiting)</tspan>
        <tspan data-lang-vi>ch2 (vẫn đang chờ)</tspan>
      </text>

      <g class="g13nil-arrow is-red"><path d={aTop1.line} /><polygon points={aTop1.head} /></g>
      <g class="g13nil-arrow"><path d={aTop2.line} /><polygon points={aTop2.head} /></g>

      <rect x="304" y="48" width="260" height="98" rx="8" class="g13nil-box is-red" />
      <g class="fm-spin"><DiagramIcon name="loop" x={330} y={72} size={26} /></g>
      <text x="440" y="76" text-anchor="middle" class="g13nil-b">for {'{'} select {'{'} ... {'}'} {'}'}</text>
      <text x="434" y="102" text-anchor="middle" class="g13nil-red">
        <tspan data-lang-en>case &lt;-ch1 is always ready</tspan>
        <tspan data-lang-vi>nhánh &lt;-ch1 lúc nào cũng sẵn sàng</tspan>
      </text>
      <text x="434" y="126" text-anchor="middle" class="g13nil-sub">
        <tspan data-lang-en>loop never parks to wait</tspan>
        <tspan data-lang-vi>vòng lặp không bao giờ dừng chờ</tspan>
      </text>

      <g class="g13nil-arrow is-red"><path d={aTop3.line} /><polygon points={aTop3.head} /></g>

      <rect x="640" y="48" width="240" height="98" rx="8" class="g13nil-box is-red" />
      <DiagramIcon name="hot" x={760} y={64} size={26} />
      <text x="760" y="92" text-anchor="middle" class="g13nil-b is-red">
        <tspan data-lang-en>100% CPU spin</tspan>
        <tspan data-lang-vi>Đốt 100% một nhân CPU</tspan>
      </text>
      <text x="760" y="114" text-anchor="middle" class="g13nil-sub">
        <tspan data-lang-en>loop spins millions/sec</tspan>
        <tspan data-lang-vi>lặp hàng triệu lần mỗi giây</tspan>
      </text>

      <line x1="20" y1="176" x2="880" y2="176" class="g13nil-rule" />

      {/* Row 2: Nil channel disables branch */}
      <text x="20" y="210" class="g13nil-h">
        <tspan data-lang-en>2. Assign ch1 = nil when !ok: branch disabled cleanly</tspan>
        <tspan data-lang-vi>2. Gán ch1 = nil khi !ok: tắt gọn nhánh đã đóng</tspan>
      </text>

      <rect x="20" y="234" width="220" height="48" rx="7" class="g13nil-box is-muted" />
      <DiagramIcon name="chan-in" x={214} y={249} size={24} />
      <text x="136" y="256" text-anchor="middle" class="g13nil-b">ch1 = nil</text>
      <text x="136" y="274" text-anchor="middle" class="g13nil-sub">
        <tspan data-lang-en>blocks forever in select</tspan>
        <tspan data-lang-vi>block vĩnh viễn → bị bỏ qua</tspan>
      </text>

      <rect x="20" y="294" width="220" height="42" rx="7" class="g13nil-box is-gold" />
      <text x="130" y="320" text-anchor="middle" class="g13nil-gold">
        <tspan data-lang-en>ch2 (only active case)</tspan>
        <tspan data-lang-vi>ch2 (nhánh duy nhất còn mở)</tspan>
      </text>

      <g class="g13nil-arrow is-cut"><path d={aBot1.line} /><polygon points={aBot1.head} /></g>
      <g class="g13nil-arrow is-gold"><path class="fm-flow" d={aBot2.line} /><polygon points={aBot2.head} /></g>

      <rect x="304" y="234" width="260" height="102" rx="8" class="g13nil-box is-gold" />
      <text x="434" y="262" text-anchor="middle" class="g13nil-b">for ch1 != nil || ch2 != nil</text>
      <text x="434" y="288" text-anchor="middle" class="g13nil-gold">
        <tspan data-lang-en>parks sleeping on ch2 only</tspan>
        <tspan data-lang-vi>ngủ chờ gọn trên mỗi ch2</tspan>
      </text>
      <text x="434" y="312" text-anchor="middle" class="g13nil-sub">
        <tspan data-lang-en>sets ch2 = nil when ch2 closes</tspan>
        <tspan data-lang-vi>ch2 đóng thì gán ch2 = nil tiếp</tspan>
      </text>

      <g class="g13nil-arrow is-gold"><path d={aBot3.line} /><polygon points={aBot3.head} /></g>

      <rect x="640" y="234" width="240" height="102" rx="8" class="g13nil-box is-gold" />
      <DiagramIcon name="ok" x={760} y={252} size={26} />
      <text x="760" y="280" text-anchor="middle" class="g13nil-b">
        <tspan data-lang-en>0% idle spin, clean exit</tspan>
        <tspan data-lang-vi>0% quay rỗng, thoát sạch</tspan>
      </text>
      <text x="760" y="302" text-anchor="middle" class="g13nil-sub">
        <tspan data-lang-en>closes out when both nil</tspan>
        <tspan data-lang-vi>cả hai đều nil là đóng out</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Because receiving from a nil channel blocks forever, Go's select skips that branch. Assigning ch = nil when ok is false prevents a closed channel from spinning the loop.</span>
    <span data-lang-vi>Vì đọc từ một nil channel sẽ block vĩnh viễn, select tự động bỏ qua nhánh đó. Gán ch = nil ngay khi ok == false giúp tắt nhánh đã đóng mà không đốt CPU.</span>
  </figcaption>
</figure>

<style>
  .g13nil { margin: 2em 0; width: 100%; }
  .g13nil-scroll { overflow-x: auto; }
  .g13nil svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .g13nil text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .g13nil-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .g13nil-h.is-red { fill: var(--red); }
  .g13nil-b { font-size: 14px; font-weight: 700; fill: var(--text); }
  .g13nil-b.is-red { fill: var(--red); }
  .g13nil-sub { font-size: 12.5px; fill: var(--text-muted); }
  .g13nil-red { font-size: 12.5px; font-weight: 600; fill: var(--red); }
  .g13nil-gold { font-size: 12.5px; font-weight: 600; fill: var(--gold-icon); }
  .g13nil-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .g13nil-box.is-red { fill: var(--red-tint-bg); stroke: var(--red); }
  .g13nil-box.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .g13nil-box.is-muted { fill: var(--bg-alt); stroke: var(--border); stroke-dasharray: 4 3; opacity: 0.72; }
  .g13nil-rule { stroke: var(--border); }
  .g13nil-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.6; }
  .g13nil-arrow polygon { fill: var(--text-muted); }
  .g13nil-arrow.is-red path { stroke: var(--red); }
  .g13nil-arrow.is-red polygon { fill: var(--red); }
  .g13nil-arrow.is-gold path { stroke: var(--gold-icon); }
  .g13nil-arrow.is-gold polygon { fill: var(--gold-icon); }
  .g13nil-arrow.is-cut path { stroke-dasharray: 3 4; opacity: 0.55; }
  .g13nil-arrow.is-cut polygon { opacity: 0.55; }
  .g13nil figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
