---
// Full refresh vs incremental view maintenance (IVM): re-run the whole query, or apply only the
// signed delta (+1 insert, -1 delete) to existing state. Numbers are illustrative.
// Plain inline SVG, site CSS tokens, polygon arrowheads (no SVG ids). Labels come from the lang prop.
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const W = 900, H = 356;
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 8 * Math.cos(a - 0.45), y2 - 8 * Math.sin(a - 0.45)];
  const p2 = [x2 - 8 * Math.cos(a + 0.45), y2 - 8 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const T = {
  en: {
    h1: 'Full refresh: re-run the whole query every time',
    h2: 'Incremental view maintenance: apply only the change',
    t1: 'Base table', t1s: 'every row, rescanned',
    q1: 'Re-run the query', q1s: 'REFRESH MATERIALIZED VIEW',
    v1: 'View', v1s: 'stale until the next run',
    bad: 'Cost grows with the size of the table',
    d: 'Changes from CDC', d1: '+1  order, Vietnam', d2: '-1  order, US (cancelled)',
    op: 'Operator with state', ops: 'orders per country',
    v2: 'View, updated at once', v2a: 'Vietnam 41 to 42', v2b: 'US 17 to 16',
    good: 'Cost grows with the size of the change',
    alt: 'Top: a full refresh rescans every row of the base table and re-runs the query, so the view is stale until the next run and cost grows with the table. Bottom: CDC changes (plus one Vietnam order, minus one cancelled US order) flow into a stateful operator that updates the view immediately, so cost grows with the change.',
    cap: 'Illustrative numbers. Streaming SQL engines compile a query into operators that keep state and consume signed row changes (Z-sets).',
  },
  vi: {
    h1: 'Refresh toàn bộ: chạy lại cả câu truy vấn mỗi lần',
    h2: 'Incremental view maintenance: chỉ áp dụng phần thay đổi',
    t1: 'Bảng gốc', t1s: 'quét lại mọi dòng',
    q1: 'Chạy lại truy vấn', q1s: 'REFRESH MATERIALIZED VIEW',
    v1: 'View', v1s: 'cũ cho tới lần chạy sau',
    bad: 'Chi phí tăng theo kích thước bảng',
    d: 'Thay đổi từ CDC', d1: '+1  đơn hàng, Việt Nam', d2: '-1  đơn hàng, Mỹ (đã huỷ)',
    op: 'Toán tử giữ trạng thái', ops: 'số đơn theo quốc gia',
    v2: 'View, cập nhật ngay', v2a: 'Việt Nam 41 lên 42', v2b: 'Mỹ 17 xuống 16',
    good: 'Chi phí tăng theo kích thước thay đổi',
    alt: 'Trên: refresh toàn bộ quét lại mọi dòng của bảng gốc rồi chạy lại truy vấn, nên view cũ cho tới lần chạy sau và chi phí tăng theo bảng. Dưới: các thay đổi từ CDC (thêm một đơn Việt Nam, bớt một đơn Mỹ đã huỷ) đi vào một toán tử giữ trạng thái và cập nhật view ngay, nên chi phí tăng theo phần thay đổi.',
    cap: 'Số liệu minh hoạ. Engine SQL streaming biên dịch truy vấn thành các toán tử giữ trạng thái và nhận thay đổi dòng có dấu (Z-set).',
  },
}[lang];
const bh = 70;
const y1 = 44, y2 = 224;
const bx = [{ x: 20, w: 220 }, { x: 340, w: 240 }, { x: 680, w: 200 }];
const a1 = [arrow(240, y1 + bh / 2, 340, y1 + bh / 2), arrow(580, y1 + bh / 2, 680, y1 + bh / 2)];
const a2 = [arrow(240, y2 + bh / 2, 340, y2 + bh / 2), arrow(580, y2 + bh / 2, 680, y2 + bh / 2)];
---
<figure class="sivm">
  <div class="sivm-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={T.alt}>
    <text x="20" y="24" class="h">{T.h1}</text>
    {[[T.t1, T.t1s], [T.q1, T.q1s], [T.v1, T.v1s]].map((t, i) => (
      <g class={i === 1 ? 'box off' : 'box'}>
        <rect x={bx[i].x} y={y1} width={bx[i].w} height={bh} rx="7" />
        <text x={bx[i].x + bx[i].w / 2} y={y1 + 30} text-anchor="middle" class="name">{t[0]}</text>
        <text x={bx[i].x + bx[i].w / 2} y={y1 + 52} text-anchor="middle" class="sub">{t[1]}</text>
      </g>
    ))}
    {a1.map((a) => (<g class="arr"><path d={a.line} /><polygon points={a.head} /></g>))}
    <text x="20" y="150" class="bad">{T.bad}</text>
    <line x1="20" x2={W - 20} y1="176" y2="176" class="rule" />
    <text x="20" y="204" class="h">{T.h2}</text>
    <g class="box">
      <rect x={bx[0].x} y={y2} width={bx[0].w} height={bh} rx="7" />
      <text x={bx[0].x + 14} y={y2 + 24} class="sub">{T.d}</text>
      <text x={bx[0].x + 14} y={y2 + 45} class="name">{T.d1}</text>
      <text x={bx[0].x + 14} y={y2 + 63} class="name">{T.d2}</text>
    </g>
    <g class="box">
      <rect x={bx[1].x} y={y2} width={bx[1].w} height={bh} rx="7" />
      <text x={bx[1].x + bx[1].w / 2} y={y2 + 30} text-anchor="middle" class="name">{T.op}</text>
      <text x={bx[1].x + bx[1].w / 2} y={y2 + 52} text-anchor="middle" class="sub">{T.ops}</text>
    </g>
    <g class="box">
      <rect x={bx[2].x} y={y2} width={bx[2].w} height={bh} rx="7" />
      <text x={bx[2].x + 14} y={y2 + 24} class="sub">{T.v2}</text>
      <text x={bx[2].x + 14} y={y2 + 45} class="name">{T.v2a}</text>
      <text x={bx[2].x + 14} y={y2 + 63} class="name">{T.v2b}</text>
    </g>
    {a2.map((a) => (<g class="arr"><path d={a.line} /><polygon points={a.head} /></g>))}
    <text x="20" y="338" class="name">{T.good}</text>
  </svg>
  </div>
  <figcaption>{T.cap}</figcaption>
</figure>

<style>
  .sivm { margin: 2em 0; width: 100%; }
  .sivm-scroll { overflow-x: auto; }
  .sivm svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sivm text { font-size: 14px; fill: var(--text-body); }
  .sivm .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sivm .name { font-weight: 700; fill: var(--text); }
  .sivm .sub { font-size: 13px; fill: var(--text-muted); font-variant-numeric: tabular-nums; }
  .sivm .bad { font-size: 13px; fill: var(--red); }
  .sivm .num { font-size: 13px; font-weight: 700; fill: var(--text); font-variant-numeric: tabular-nums; }
  .sivm .box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .sivm .box.off rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .sivm .box.dash rect { stroke-dasharray: 4 4; fill: none; }
  .sivm .arr path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .sivm .arr polygon { fill: var(--text-muted); }
  .sivm .arr.bad path { stroke: var(--red); stroke-dasharray: 5 4; }
  .sivm .arr.bad polygon { fill: var(--red); }
  .sivm .rule { stroke: var(--border); stroke-width: 1; }
  .sivm figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
