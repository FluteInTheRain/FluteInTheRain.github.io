---
// One order, four shard writes: the data shard plus one index shard per indexed column. Illustrative.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
type Lbl = { x: number; y: number; c: string; en: string[]; vi: string[]; a?: string; lh?: number };
const W = 900;
const H = 316;
const targets = [
  { y: 36, icon: 'db', en: ['Data shard', 'the order row'], vi: ['Shard dữ liệu', 'dòng order'], idx: false },
  { y: 108, icon: 'index', en: ['Index shard 1', 'customer_id'], vi: ['Shard index 1', 'customer_id'], idx: true },
  { y: 180, icon: 'index', en: ['Index shard 2', 'status'], vi: ['Shard index 2', 'status'], idx: true },
  { y: 252, icon: 'index', en: ['Index shard 3', 'created_at'], vi: ['Shard index 3', 'created_at'], idx: true },
];
const fan = targets.map((t) => arrow(200, 160, 322, t.y + 26));
const labels: Lbl[] = [
  { x: 112, y: 160, c: 'b', en: ['One new order'], vi: ['Một order mới'] },
  { x: 112, y: 178, c: 'sub', en: ['3 indexed columns'], vi: ['3 cột có index'] },
  { x: 112, y: 207, c: 'note is-hot', en: ['4 shards written'], vi: ['Ghi vào 4 shard'] },
  ...targets.flatMap((t) => [
    { x: 392, y: t.y + 23, c: 'b', a: 'start', en: [t.en[0]], vi: [t.vi[0]] } as Lbl,
    { x: 392, y: t.y + 40, c: 's', a: 'start', en: [t.en[1]], vi: [t.vi[1]] } as Lbl,
  ]),
  { x: 640, y: 36, c: 'h', a: 'start', en: ['How engines pay this cost'], vi: ['Engine trả chi phí này ra sao'] },
  { x: 686, y: 106, c: 'b', a: 'start', en: ['Asynchronous'], vi: ['Bất đồng bộ'] },
  { x: 686, y: 124, c: 's', a: 'start', en: ['DynamoDB GSIs: the write stays'], vi: ['DynamoDB GSI: ghi vẫn nhanh,'] },
  { x: 686, y: 139, c: 's', a: 'start', en: ['fast, index reads can be stale'], vi: ['đọc index có thể cũ'] },
  { x: 686, y: 218, c: 'b', a: 'start', en: ['Synchronous'], vi: ['Đồng bộ'] },
  { x: 686, y: 236, c: 's', a: 'start', en: ['CockroachDB, TiDB: one'], vi: ['CockroachDB, TiDB: một'] },
  { x: 686, y: 251, c: 's', a: 'start', en: ['distributed transaction,'], vi: ['distributed transaction,'] },
  { x: 686, y: 266, c: 's', a: 'start', en: ['slower but consistent'], vi: ['chậm hơn nhưng nhất quán'] },
];
---
<figure class="shbg">
  <div class="shbg-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Writing one order that has three indexed columns updates four shards: the data shard and three index shards, one per indexed column. DynamoDB global secondary indexes are updated asynchronously, so reads can be stale. CockroachDB and TiDB update them in one distributed transaction, which is slower but consistent.">
      <rect x="20" y="96" width="184" height="128" rx="6" class="box" />
      <DiagramIcon name="receipt" x={112} y={122} size={24} />
      {fan.map((a) => (<g><path d={a.line} class="arrow is-hot" /><polygon points={a.head} class="head is-hot" /></g>))}
      {targets.map((t) => (
        <g>
          <rect x="326" y={t.y} width="246" height="52" rx="6" class={t.idx ? 'box is-hot' : 'box'} />
          <DiagramIcon name={t.icon} x={356} y={t.y + 26} size={26} />
        </g>
      ))}
      <rect x="640" y="62" width="240" height="106" rx="6" class="box" />
      <DiagramIcon name="dynamodb" x={662} y={115} size={26} />
      <rect x="640" y="180" width="240" height="116" rx="6" class="box" />
      <DiagramIcon name="sync" x={662} y={238} size={26} />
      {labels.map((l) => (
        <>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-en>{l.en.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-vi>{l.vi.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
        </>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The price of a global index is paid on writes. One order touches the data shard and every index shard.</span>
    <span data-lang-vi>Cái giá của global index trả ở lúc ghi. Một order chạm vào shard dữ liệu và mọi shard index.</span>
  </figcaption>
</figure>

<style>
  .shbg { margin: 2em 0; width: 100%; }
  .shbg-scroll { overflow-x: auto; }
  .shbg svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shbg text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shbg .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shbg .h.is-hot { fill: var(--red); }
  .shbg .h.is-gold { fill: var(--gold-icon); }
  .shbg .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shbg .sub.is-gold { fill: var(--gold-icon); font-weight: 600; }
  .shbg .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shbg .b.is-hot { fill: var(--red); }
  .shbg .s { font-size: 12px; fill: var(--text-body); }
  .shbg .s.is-hot { fill: var(--red); font-weight: 600; }
  .shbg .note { font-size: 13px; font-weight: 600; fill: var(--text); }
  .shbg .note.is-hot { fill: var(--red); }
  .shbg .note.is-gold { fill: var(--gold-icon); }
  .shbg .num { font-size: 11px; font-weight: 700; fill: var(--text); }
  .shbg .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbg .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shbg .box.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .shbg .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shbg .box.is-dim { opacity: 0.5; }
  .shbg .circ { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbg .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shbg .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shbg .arrow.is-hot { stroke: var(--red); }
  .shbg .arrow.is-gold { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shbg .arrow.is-strong { stroke: var(--text); stroke-width: 1.7; }
  .shbg .arrow.is-dash { stroke-dasharray: 5 4; }
  .shbg .head { fill: var(--text-muted); }
  .shbg .head.is-hot { fill: var(--red); }
  .shbg .head.is-gold { fill: var(--gold-icon); }
  .shbg .head.is-strong { fill: var(--text); }
  .shbg figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>

