---
// Raft Pre-Vote: a node on a flaky link must not raise its term until a majority says it would vote
// for it. Term numbers are illustrative. Static SVG, site tokens only.
import ConsensusFigure from './ConsensusFigure.astro';
import DiagramIcon from './DiagramIcon.astro';
import { head } from './consensus-fig';
interface Props { lang: 'en' | 'vi' }
const { lang } = Astro.props;

const T = {
  en: {
    aria: 'Two panels with a node on a flaky link and a healthy leader in term 5. Left, without Pre-Vote: the flaky node times out again and again and raises its term 5, 6, 7, 8; when a packet gets through, the leader sees the higher term and steps down, and the cluster halts. Right, with Pre-Vote: the flaky node first asks peers whether they would vote for it; they answer no because the leader is alive, the term stays 5, and the leader stays.',
    lT: 'Without Pre-Vote', lS: 'Each timeout raises the term.',
    rT: 'With Pre-Vote', rS: 'A timeout only asks a question.',
    flaky: 'Flaky node', leader: 'Leader',
    lTerm: 'term 5 → 6 → 7 → 8', lLead: 'term 5',
    rTerm: 'term stays 5', rLead: 'term 5',
    lMsg: 'term 8', lMsg2: '',
    rAsk: 'would you vote?', rNo: 'no: leader is alive',
    lRes: ['The leader sees term 8 and steps down.', 'The healthy cluster halts.'],
    rRes: ['The leader stays. The flaky node cannot', 'disturb a cluster that is working.'],
    cap: 'Pre-Vote moves the "is it worth an election?" check before the term bump.',
  },
  vi: {
    aria: 'Hai khung với một node trên đường truyền chập chờn và một leader khoẻ ở nhiệm kỳ 5. Trái, không có Pre-Vote: node chập chờn hết giờ liên tục và tăng nhiệm kỳ 5, 6, 7, 8; khi một gói tin lọt qua, leader thấy nhiệm kỳ cao hơn và thoái vị, cả cụm dừng. Phải, có Pre-Vote: node chập chờn trước hết hỏi các node khác có bầu cho mình không; họ trả lời không vì leader còn sống, nhiệm kỳ vẫn là 5 và leader ở lại.',
    lT: 'Không có Pre-Vote', lS: 'Mỗi lần hết giờ là tăng nhiệm kỳ.',
    rT: 'Có Pre-Vote', rS: 'Hết giờ chỉ là đặt một câu hỏi.',
    flaky: 'Node chập chờn', leader: 'Leader',
    lTerm: 'kỳ 5 → 6 → 7 → 8', lLead: 'kỳ 5',
    rTerm: 'kỳ vẫn là 5', rLead: 'kỳ 5',
    lMsg: 'kỳ 8', lMsg2: '',
    rAsk: 'bầu cho tôi không?', rNo: 'không: leader sống',
    lRes: ['Leader thấy kỳ 8 nên thoái vị.', 'Cụm đang khoẻ bị dừng.'],
    rRes: ['Leader ở lại. Node chập chờn không', 'làm phiền được cụm đang chạy tốt.'],
    cap: 'Pre-Vote đưa bước "có đáng bầu cử không?" lên trước khi tăng nhiệm kỳ.',
  },
}[lang];

const bw = 150, bh = 62;
const panels = [
  { ox: 10, t: T.lT, s: T.lS, term: T.lTerm, lead: T.lLead, bad: true, res: T.lRes },
  { ox: 460, t: T.rT, s: T.rS, term: T.rTerm, lead: T.rLead, bad: false, res: T.rRes },
];
---
<ConsensusFigure aria={T.aria} cap={T.cap} w={900} h={290}>
  <line x1="450" x2="450" y1="10" y2="270" class="cfg-rule" />
  {panels.map((p) => {
    const fx = p.ox + 10, lx = p.ox + 280;
    return (
      <g>
        <text x={p.ox + 10} y="24" class="cfg-t">{p.t}</text>
        <text x={p.ox + 10} y="44" class="cfg-s">{p.s}</text>
        <rect x={fx} y="66" width={bw} height={bh} rx="6" class="cfg-box is-dash" />
        <DiagramIcon name="server" x={fx + 22} y={97} size={24} />
        <text x={fx + 42} y="102" class="cfg-n" style="font-size:12px">{T.flaky}</text>
        <text x={fx + bw / 2} y="150" text-anchor="middle" class={`cfg-m ${p.bad ? 'cfg-r' : ''}`}>{p.term}</text>
        <rect x={lx} y="66" width={bw} height={bh} rx="6" class={`cfg-box ${p.bad ? 'is-bad' : 'is-ok'}`} />
        <DiagramIcon name="server" x={lx + 22} y={97} size={24} />
        <text x={lx + 46} y="92" class="cfg-n">{T.leader}</text>
        <text x={lx + 46} y="112" class="cfg-m">{p.lead}</text>
        {p.bad ? (
          <g>
            <path d={`M ${fx + bw} 96 L ${lx - 8} 96`} class="cfg-arrow is-bad is-dash" />
            <polygon points={head(fx + bw, 96, lx, 96)} class="cfg-head is-bad" />
            <text x={(fx + bw + lx) / 2} y="86" text-anchor="middle" class="cfg-r">{T.lMsg}</text>
          </g>
        ) : (
          <g>
            <path d={`M ${fx + bw} 84 L ${lx - 8} 84`} class="cfg-arrow is-dash" />
            <polygon points={head(fx + bw, 84, lx, 84)} class="cfg-head" />
            <text x={(fx + bw + lx) / 2} y="76" text-anchor="middle" class="cfg-m" style="fill:var(--text)">{T.rAsk}</text>
            <path d={`M ${lx} 112 L ${fx + bw + 8} 112`} class="cfg-arrow is-ok" />
            <polygon points={head(lx, 112, fx + bw, 112)} class="cfg-head is-ok" />
            <text x={(fx + bw + lx) / 2} y="130" text-anchor="middle" class="cfg-m" style="fill:var(--text)">{T.rNo}</text>
          </g>
        )}
        <rect x={p.ox + 10} y="170" width="420" height="68" rx="6" class={`cfg-box ${p.bad ? 'is-bad' : 'is-ok'}`} />
        <text x={p.ox + 220} y="198" text-anchor="middle" class="cfg-g">{p.res[0]}</text>
        <text x={p.ox + 220} y="218" text-anchor="middle" class="cfg-g">{p.res[1]}</text>
      </g>
    );
  })}
</ConsensusFigure>
