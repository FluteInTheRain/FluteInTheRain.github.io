---
// Order of events for the Ariane 5 opener. All facts come from the paragraph above it.
function head(x2: number, y2: number, a: number) { const l = 9; const p = (d: number) => `${(x2 - l * Math.cos(a + d)).toFixed(1)},${(y2 - l * Math.sin(a + d)).toFixed(1)}`; return `${x2},${y2} ${p(-0.45)} ${p(0.45)}`; }
const W = 900;
const H = 260;
const boxes = [
  { x: 20, w: 250, en: ['A 64-bit', 'floating-point number'], vi: ['Một số thực', 'dấu phẩy động 64 bit'] },
  { x: 325, w: 250, en: ['A 16-bit signed', 'integer slot'], vi: ['Một ô số nguyên', 'có dấu 16 bit'] },
  { x: 630, w: 250, en: ['The flight computer reads', 'an error message as data'], vi: ['Máy tính bay đọc', 'thông báo lỗi như dữ liệu'], red: true },
];
---
<figure class="gp02a">
  <div class="gp02a-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Timeline from lift-off at 0 seconds to the rocket being destroyed at 37 seconds, and below it the three steps of the failure: a 64-bit float, a 16-bit integer slot that is too small, and an error message read as flight data.">
    <line x1="40" y1="60" x2="860" y2="60" class="axis" />
    <line x1="40" y1="52" x2="40" y2="68" class="axis" />
    <line x1="860" y1="52" x2="860" y2="68" class="axis" />
    <text x="40" y="38" class="strong">
      <tspan data-lang-en>0 s: lift-off, 4 June 1996</tspan>
      <tspan data-lang-vi>0 giây: phóng, ngày 4 tháng 6 năm 1996</tspan>
    </text>
    <text x="860" y="38" text-anchor="end" class="red">
      <tspan data-lang-en>37 s: rocket destroyed</tspan>
      <tspan data-lang-vi>37 giây: tên lửa bị phá hủy</tspan>
    </text>
    <text x="450" y="86" text-anchor="middle" class="muted">
      <tspan data-lang-en>The guidance software converted one number to a smaller type, with no check</tspan>
      <tspan data-lang-vi>Phần mềm dẫn đường đổi một số sang kiểu nhỏ hơn, không kiểm tra</tspan>
    </text>

    {boxes.map((b, i) => (
      <g>
        <rect x={b.x} y="120" width={b.w} height="84" rx="8" class={b.red ? 'box-red' : 'box'} />
        <text x={b.x + b.w / 2} y="156" text-anchor="middle" class={b.red ? 'red' : 'strong'}>
          <tspan data-lang-en>{b.en[0]}</tspan><tspan data-lang-vi>{b.vi[0]}</tspan>
        </text>
        <text x={b.x + b.w / 2} y="177" text-anchor="middle" class={b.red ? 'red' : 'strong'}>
          <tspan data-lang-en>{b.en[1]}</tspan><tspan data-lang-vi>{b.vi[1]}</tspan>
        </text>
        {i < boxes.length - 1 && (
          <g>
            <line x1={b.x + b.w + 4} y1="162" x2={b.x + b.w + 40} y2="162" class="line" />
            <polygon points={head(b.x + b.w + 49, 162, 0)} class="head" />
          </g>
        )}
      </g>
    ))}
    <text x="450" y="232" text-anchor="middle" class="muted">
      <tspan data-lang-en>The value was too big for 16 bits, so the conversion overflowed.</tspan>
      <tspan data-lang-vi>Giá trị quá lớn so với 16 bit nên phép chuyển đổi bị tràn.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The same shape of bug is possible in Go: a wide number converted to a narrow type. The overflow section below shows it with real output.</span>
    <span data-lang-vi>Lỗi cùng dạng này cũng xảy ra được trong Go: số rộng bị ép sang kiểu hẹp. Phần tràn số bên dưới cho thấy điều đó với output thật.</span>
  </figcaption>
</figure>

<style>
  .gp02a { margin: 2em 0; width: 100%; }
  .gp02a-scroll { overflow-x: auto; }
  .gp02a svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp02a text { font-size: 14px; fill: var(--text-body); }
  .gp02a .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .gp02a .muted { fill: var(--text-muted); }
  .gp02a .strong { font-weight: 700; fill: var(--text); }
  .gp02a .red { fill: var(--red); font-weight: 700; }
  .gp02a .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp02a .box-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .gp02a .ghost { fill: none; stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .gp02a .axis { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp02a .line { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp02a .line-red { stroke: var(--red); stroke-width: 1.8; fill: none; }
  .gp02a .head { fill: var(--text-muted); }
  .gp02a .head-red { fill: var(--red); }
  .gp02a .num { font-variant-numeric: tabular-nums; }
  .gp02a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
