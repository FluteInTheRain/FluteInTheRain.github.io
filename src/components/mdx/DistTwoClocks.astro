---
import DiagramIcon from './DiagramIcon.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const L = (en: string, vi: string) => (lang === 'vi' ? vi : en);
const W = 900;
const H = 286;
---
<figure class="dtc2">
  <div class="dtc2-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L("The same 0.5 second request timed two ways. A wall clock that steps back one second during the request gives a negative duration. A monotonic clock gives plus 0.5 seconds.", "Cùng một request 0,5 giây đo hai cách. Đồng hồ giờ thực lùi một giây giữa chừng cho thời lượng âm. Đồng hồ đơn điệu cho +0,5 giây.")}>
<text x="20" y="24" class="t-h">{L("The same request, timed with two different clocks","Cùng một request, đo bằng hai đồng hồ khác nhau")}</text>
<DiagramIcon name="clock" x={80} y={72} size={34} />
<text x="80" y="118" class="t-b" text-anchor="middle">{L("Wall clock","Đồng hồ giờ thực")}</text>
<rect x="150" y="50" width="165" height="70" rx="6" class="box" />
<text x="162" y="78" class="t-b">{L("Request starts","Request bắt đầu")}</text>
<text x="162" y="100" class="t-m">{L("reads 10.8 s","đọc 10.8 s")}</text>
<path d="M 315 85 L 329.0 85.0" class="ln" /><polygon points="335,85 327.8,88.5 327.8,81.5" class="hd" />
<rect x="335" y="50" width="165" height="70" rx="6" class="box-r" />
<text x="347" y="78" class="t-r">{L("Leap second","Giây nhuận")}</text>
<text x="347" y="100" class="t-m">{L("clock steps back 1 s","đồng hồ lùi 1 s")}</text>
<path d="M 500 85 L 514.0 85.0" class="ln" /><polygon points="520,85 512.8,88.5 512.8,81.5" class="hd" />
<rect x="520" y="50" width="165" height="70" rx="6" class="box" />
<text x="532" y="78" class="t-b">{L("Reply arrives","Phản hồi tới")}</text>
<text x="532" y="100" class="t-m">{L("reads 10.3 s","đọc 10.3 s")}</text>
<path d="M 685 85 L 699.0 85.0" class="ln" /><polygon points="705,85 697.8,88.5 697.8,81.5" class="hd" />
<rect x="705" y="50" width="165" height="70" rx="6" class="box-r" />
<text x="717" y="78" class="t-r">{L("end minus start","end trừ start")}</text>
<text x="717" y="100" class="t-m">{L("= -0.5 s","= -0.5 s")}</text>
<DiagramIcon name="stopwatch" x={80} y={182} size={34} />
<text x="80" y="228" class="t-b" text-anchor="middle">{L("Monotonic","Đồng hồ đơn điệu")}</text>
<rect x="150" y="160" width="165" height="70" rx="6" class="box" />
<text x="162" y="188" class="t-b">{L("Request starts","Request bắt đầu")}</text>
<text x="162" y="210" class="t-m">{L("reads 5000.8 s","đọc 5000.8 s")}</text>
<path d="M 315 195 L 329.0 195.0" class="ln" /><polygon points="335,195 327.8,198.5 327.8,191.5" class="hd" />
<rect x="335" y="160" width="165" height="70" rx="6" class="box-g" />
<text x="347" y="188" class="t-b">{L("Only moves forward","Chỉ tiến lên")}</text>
<text x="347" y="210" class="t-m">{L("never steps back","không bao giờ lùi")}</text>
<path d="M 500 195 L 514.0 195.0" class="ln" /><polygon points="520,195 512.8,198.5 512.8,191.5" class="hd" />
<rect x="520" y="160" width="165" height="70" rx="6" class="box" />
<text x="532" y="188" class="t-b">{L("Reply arrives","Phản hồi tới")}</text>
<text x="532" y="210" class="t-m">{L("reads 5001.3 s","đọc 5001.3 s")}</text>
<path d="M 685 195 L 699.0 195.0" class="ln" /><polygon points="705,195 697.8,198.5 697.8,191.5" class="hd" />
<rect x="705" y="160" width="165" height="70" rx="6" class="box-g" />
<text x="717" y="188" class="t-b">{L("end minus start","end trừ start")}</text>
<text x="717" y="210" class="t-m">{L("= +0.5 s","= +0.5 s")}</text>
<text x="20" y="268" class="t-m">{L("Real elapsed time was 0.5 s. A negative duration is what reached rand.Int63n() at Cloudflare.","Thời gian thực trôi qua là 0,5 s. Thời lượng âm là thứ đã lọt vào rand.Int63n() ở Cloudflare.")}</text>
    </svg>
  </div>
  <figcaption>{L("Use the wall clock to say what time it is, and the monotonic clock to measure how long something took.", "Dùng đồng hồ giờ thực để biết mấy giờ, dùng đồng hồ đơn điệu để đo việc gì đó mất bao lâu.")}</figcaption>
</figure>

<style>
  .dtc2 { margin: 2em 0; width: 100%; }
  .dtc2-scroll { overflow-x: auto; }
  .dtc2 svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dtc2 text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .dtc2 .t-h { font-size: 15.5px; font-weight: 700; fill: var(--text); }
  .dtc2 .t-b { font-weight: 700; fill: var(--text); }
  .dtc2 .t-r { font-weight: 700; fill: var(--red); }
  .dtc2 .t-m { fill: var(--text-muted); font-size: 12.5px; }
  .dtc2 .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .dtc2 .box-r { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dtc2 .box-g { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.5; }
  .dtc2 .box-d { fill: transparent; stroke: var(--border); stroke-dasharray: 5 4; stroke-width: 1.2; }
  .dtc2 .box-gd { fill: transparent; stroke: var(--gold-icon); stroke-dasharray: 5 4; stroke-width: 1.4; }
  .dtc2 .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .dtc2 .ln-r { fill: none; stroke: var(--red); stroke-width: 2; }
  .dtc2 .ln-g { fill: none; stroke: var(--gold-icon); stroke-width: 2; }
  .dtc2 .ln-d { fill: none; stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .dtc2 .ln-rd { fill: none; stroke: var(--red); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .dtc2 .ln-gr { fill: none; stroke: var(--border); stroke-dasharray: 2 4; }
  .dtc2 .hd { fill: var(--text-muted); }
  .dtc2 .hd-r { fill: var(--red); }
  .dtc2 .hd-g { fill: var(--gold-icon); }
  .dtc2 .dot-g { fill: var(--gold-icon); }
  .dtc2 figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
