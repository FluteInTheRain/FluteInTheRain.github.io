---
// Unknown fields: the default quietly drops them (200), extra="forbid"
// refuses them by name (422). Same request, two model settings.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 330;
const arrows = [arrow(190, 94, 240, 94), arrow(400, 94, 450, 94), arrow(190, 227, 240, 227), arrow(400, 227, 450, 227)];
---
<figure class="bep3n5">
  <div class="bep3n5-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The same request with an extra field is_admin. With the default model setting the field is silently dropped and the answer is a clean 200. With extra forbid the model refuses it by name: 422, body.is_admin, Extra inputs are not permitted.">
    <text x="20" y="46" class="t"><tspan data-lang-en>default: unknown fields ignored</tspan><tspan data-lang-vi>mặc định: field lạ bị bỏ qua</tspan></text>
    <rect x="60" y="52" width="130" height="84" rx="8" class="box" />
    <DiagramIcon name="mail" x={125} y={76} size={22} />
    <text x="125" y="112" text-anchor="middle" class="t">request</text>
    <text x="125" y="130" text-anchor="middle" class="m">+ is_admin</text>
    <rect x="240" y="52" width="160" height="84" rx="8" class="box" />
    <DiagramIcon name="shield" x={320} y={76} size={22} />
    <text x="320" y="112" text-anchor="middle" class="t">Draft</text>
    <text x="320" y="130" text-anchor="middle" class="m"><tspan data-lang-en>doesn't know it</tspan><tspan data-lang-vi>không biết field này</tspan></text>
    <rect x="450" y="52" width="170" height="84" rx="8" class="box" />
    <DiagramIcon name="ok" x={535} y={76} size={22} />
    <text x="535" y="112" text-anchor="middle" class="t">200 OK</text>
    <text x="535" y="130" text-anchor="middle" class="m"><tspan data-lang-en>looks fine</tspan><tspan data-lang-vi>trông vẫn ổn</tspan></text>
    <text x="760" y="90" text-anchor="middle" class="rr"><tspan data-lang-en>the field silently</tspan><tspan data-lang-vi>field lặng lẽ</tspan></text>
    <text x="760" y="110" text-anchor="middle" class="rr"><tspan data-lang-en>disappears</tspan><tspan data-lang-vi>biến mất</tspan></text>

    <text x="20" y="179" class="t"><tspan data-lang-en>extra="forbid": unknown fields refused</tspan><tspan data-lang-vi>extra="forbid": field lạ bị từ chối</tspan></text>
    <rect x="60" y="185" width="130" height="84" rx="8" class="box" />
    <DiagramIcon name="mail" x={125} y={209} size={22} />
    <text x="125" y="245" text-anchor="middle" class="t">request</text>
    <text x="125" y="263" text-anchor="middle" class="m">+ is_admin</text>
    <rect x="240" y="185" width="160" height="84" rx="8" class="box" />
    <DiagramIcon name="shield" x={320} y={209} size={22} />
    <text x="320" y="245" text-anchor="middle" class="t">Draft</text>
    <text x="320" y="263" text-anchor="middle" class="m"><tspan data-lang-en>lists who may enter</tspan><tspan data-lang-vi>liệt kê ai được vào</tspan></text>
    <rect x="450" y="185" width="170" height="84" rx="8" class="boxr" />
    <DiagramIcon name="fail" x={535} y={209} size={22} />
    <text x="535" y="245" text-anchor="middle" class="t r">422</text>
    <text x="535" y="263" text-anchor="middle" class="m">body.is_admin</text>
    <text x="760" y="227" text-anchor="middle" class="m"><tspan data-lang-en>"Extra inputs are</tspan><tspan data-lang-vi>"Extra inputs are</tspan></text>
    <text x="760" y="247" text-anchor="middle" class="m"><tspan data-lang-en>not permitted"</tspan><tspan data-lang-vi>not permitted"</tspan></text>
    {arrows.map((a) => (<g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>))}
    <text x="20" y="312" class="m"><tspan data-lang-en>same request, one model setting apart</tspan><tspan data-lang-vi>cùng một request, chỉ khác một cấu hình của model</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Silence about extras is how mass-assignment bugs start; forbid turns the stranger away by name.</span>
    <span data-lang-vi>Im lặng về field thừa là cách lỗi mass-assignment bắt đầu; forbid từ chối người lạ ngay bằng tên.</span>
  </figcaption>
</figure>

<style>
  .bep3n5 { margin: 2em 0; width: 100%; }
  .bep3n5-scroll { overflow-x: auto; }
  .bep3n5 svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep3n5 text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep3n5 .t { font-weight: 700; fill: var(--text); }
  .bep3n5 .m { fill: var(--text-muted); font-size: 12.5px; }
  .bep3n5 .r { fill: var(--red); }
  .bep3n5 .rr { font-weight: 700; fill: var(--red); font-size: 13px; }
  .bep3n5 .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep3n5 .boxr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bep3n5 .ghost { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .bep3n5 .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep3n5 .lnr { stroke: var(--red); stroke-width: 1.5; fill: none; }
  .bep3n5 .hd { fill: var(--text-muted); }
  .bep3n5 .hdr { fill: var(--red); }
  .bep3n5 figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
