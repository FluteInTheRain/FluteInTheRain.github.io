---
// Jepsen's etcd 3.4.3 lock finding: a lock alone does not stop a paused holder from writing late;
// checking the lock key's revision (a fencing token) at the resource does. Static SVG, site tokens only.
// Token labels "n" and "n+1" are symbolic, not measured values.
import DiagramIcon from './DiagramIcon.astro';
interface Props { lang: 'en' | 'vi' }
const { lang } = Astro.props;

const T = {
  en: {
    aria: 'Two timelines with Client A, Client B and the shared resource. Top, lock alone: A takes the lock with token n, stalls and its lease expires, B takes the lock with token n+1 and writes, then A wakes up, still believes it holds the lock, writes, and B\'s update is lost. Bottom, lock plus fencing check: the same steps, but the resource rejects A\'s late write because token n is older than n+1.',
    topT: 'Lock alone: the paused holder still writes',
    botT: 'Lock plus a fencing check at the resource',
    lanes: ['Client A', 'Client B', 'Shared resource'],
    s1: ['takes the lock,', 'token n'],
    s2: ['stalls; lease', 'expires'],
    s3: ['takes the lock,', 'token n+1'],
    s3r: ['accepts B\'s write'],
    s4: ['wakes up, still', 'thinks it holds it'],
    s4rBad: ['A overwrites B:', 'update lost'],
    s4rOk: ['rejects A:', 'token n < n+1'],
    cap: 'Same four steps twice: a lock alone lets the stalled holder overwrite; a token check at the resource rejects it.',
    cols: ['1', '2', '3', '4'],
  },
  vi: {
    aria: 'Hai dòng thời gian với Client A, Client B và tài nguyên dùng chung. Trên, chỉ có khoá: A lấy khoá với token n, bị treo và lease hết hạn, B lấy khoá với token n+1 rồi ghi, sau đó A tỉnh dậy, vẫn tưởng mình giữ khoá, ghi đè và cập nhật của B mất. Dưới, khoá kèm kiểm tra fencing: các bước y hệt, nhưng tài nguyên từ chối lệnh ghi muộn của A vì token n cũ hơn n+1.',
    topT: 'Chỉ có khoá: người giữ khoá bị treo vẫn ghi được',
    botT: 'Khoá kèm kiểm tra fencing tại tài nguyên',
    lanes: ['Client A', 'Client B', 'Tài nguyên chung'],
    s1: ['lấy khoá,', 'token n'],
    s2: ['bị treo; lease', 'hết hạn'],
    s3: ['lấy khoá,', 'token n+1'],
    s3r: ['nhận lệnh ghi của B'],
    s4: ['tỉnh dậy, vẫn tưởng', 'mình giữ khoá'],
    s4rBad: ['A ghi đè B:', 'mất cập nhật'],
    s4rOk: ['từ chối A:', 'token n < n+1'],
    cap: 'Bốn bước giống nhau hai lần: chỉ có khoá thì người giữ bị treo vẫn ghi đè được; kiểm tra token tại tài nguyên thì từ chối được.',
    cols: ['1', '2', '3', '4'],
  },
}[lang];

const W = 900;
const H = 500;
const cx = [260, 430, 600, 770];      // column centres
const bw = 150;                       // box width
const bh = 46;                        // box height
const laneY = [64, 126, 188];         // lane centre offsets inside a panel

function head(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const l = 8;
  const p1 = [x2 - l * Math.cos(a - 0.45), y2 - l * Math.sin(a - 0.45)];
  const p2 = [x2 - l * Math.cos(a + 0.45), y2 - l * Math.sin(a + 0.45)];
  return `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
}

const panels = [
  { oy: 0, title: T.topT, bad: true },
  { oy: 250, title: T.botT, bad: false },
];
---
<figure class="clf">
  <div class="clf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={T.aria}>
      {panels.map((p, pi) => {
        const ly = laneY.map((v) => p.oy + v);
        const boxes = [
          { c: 0, lane: 0, lines: T.s1, kind: '' },
          { c: 1, lane: 0, lines: T.s2, kind: 'is-warn' },
          { c: 2, lane: 1, lines: T.s3, kind: '' },
          { c: 2, lane: 2, lines: T.s3r, kind: '' },
          { c: 3, lane: 0, lines: T.s4, kind: 'is-warn' },
          { c: 3, lane: 2, lines: p.bad ? T.s4rBad : T.s4rOk, kind: p.bad ? 'is-bad' : 'is-ok' },
        ];
        return (
          <g>
            {pi === 1 && <line x1="20" x2={W - 20} y1="240" y2="240" class="clf-rule" />}
            <text x="20" y={p.oy + 26} class="clf-h">{p.title}</text>
            {T.lanes.map((name, i) => (
              <g>
                <line x1="186" x2={W - 20} y1={ly[i]} y2={ly[i]} class="clf-lane" />
                <DiagramIcon name={i === 2 ? 'db' : 'laptop'} x={32} y={ly[i]} size={22} />
                <text x="54" y={ly[i] + 5} class="clf-lanelbl">{name}</text>
              </g>
            ))}
            <path d={`M ${cx[2]} ${ly[1] + bh / 2} L ${cx[2]} ${ly[2] - bh / 2 - 6}`} class="clf-arrow" />
            <polygon points={head(cx[2], ly[1] + bh / 2, cx[2], ly[2] - bh / 2)} class="clf-head" />
            <path d={`M ${cx[3]} ${ly[0] + bh / 2} L ${cx[3]} ${ly[2] - bh / 2 - 6}`} class={`clf-arrow ${p.bad ? 'is-bad' : 'is-ok'}`} />
            <polygon points={head(cx[3], ly[0] + bh / 2, cx[3], ly[2] - bh / 2)} class={`clf-head ${p.bad ? 'is-bad' : 'is-ok'}`} />
            {boxes.map((b) => (
              <g>
                <rect x={cx[b.c] - bw / 2} y={ly[b.lane] - bh / 2} width={bw} height={bh} rx="6" class={`clf-box ${b.kind}`} />
                {b.lines.map((line, k) => (
                  <text x={cx[b.c]} y={ly[b.lane] + (b.lines.length === 1 ? 5 : k === 0 ? -3 : 13)} text-anchor="middle" class="clf-boxtxt">{line}</text>
                ))}
              </g>
            ))}
          </g>
        );
      })}
    </svg>
  </div>
  <figcaption>{T.cap}</figcaption>
</figure>
<style>
  .clf { margin: 2em 0; width: 100%; }
  .clf-scroll { overflow-x: auto; }
  .clf svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .clf text { font-size: 14px; fill: var(--text-body); }
  .clf .clf-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .clf .clf-lanelbl { font-size: 13px; font-weight: 600; fill: var(--text-muted); }
  .clf .clf-step { font-size: 12px; font-weight: 700; fill: var(--text-muted); }
  .clf-rule { stroke: var(--border); }
  .clf-lane { stroke: var(--border); stroke-width: 1; stroke-dasharray: 2 4; }
  .clf-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .clf-box.is-warn { stroke: var(--red); stroke-dasharray: 4 3; }
  .clf-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .clf-box.is-ok { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.8; }
  .clf .clf-boxtxt { font-size: 12.5px; font-weight: 600; fill: var(--text); }
  .clf-arrow { fill: none; stroke: var(--text); stroke-width: 1.5; }
  .clf-head { fill: var(--text); }
  .clf-arrow.is-bad { stroke: var(--red); stroke-dasharray: 4 3; }
  .clf-head.is-bad { fill: var(--red); }
  .clf-arrow.is-ok { stroke: var(--gold); }
  .clf-head.is-ok { fill: var(--gold); }
  .clf figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
