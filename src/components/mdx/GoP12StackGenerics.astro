---
// Generic Stack[T] contiguous typed slice vs []any (eface boxing + runtime assertion) and when generics fit (#9).
const W = 900;
const H = 356;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const g1 = arrow(256, 76, 294, 76);
const a1 = arrow(256, 198, 294, 198);
---
<figure class="gp12c">
  <div class="gp12c-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: Stack[int] keeps raw integers contiguous in []int and returns int directly at compile time. Middle: StackAny with []any boxes each integer in a two-word eface header and needs a runtime type assertion. Bottom: use interfaces for varying behavior and generics for shared container logic.">
    {/* Row 1: Stack[int] */}
    <text x="20" y="26" class="h">
      <tspan data-lang-en>1. Generic Stack[int]: raw values in []int, type-checked at build time</tspan>
      <tspan data-lang-vi>1. Generic Stack[int]: giá trị nằm thẳng trong []int, kiểm kiểu lúc build</tspan>
    </text>

    <rect x="20" y="44" width="236" height="64" rx="6" class="box" />
    <text x="138" y="70" text-anchor="middle" class="b">var nums Stack[int]</text>
    <text x="138" y="92" text-anchor="middle" class="m">items []int</text>

    <g><path d={g1.line} class="ln" /><polygon points={g1.head} class="ar" /></g>

    <rect x="298" y="52" width="76" height="48" class="box" />
    <rect x="374" y="52" width="76" height="48" class="box" />
    <rect x="450" y="52" width="76" height="48" class="box" />
    <text x="336" y="81" text-anchor="middle" class="b">10</text>
    <text x="412" y="81" text-anchor="middle" class="b">20</text>
    <text x="488" y="81" text-anchor="middle" class="b">30</text>

    <text x="556" y="70" class="b">top, ok := nums.Pop()  -&gt;  int</text>
    <text x="556" y="94" class="m">
      <tspan data-lang-en>0 boxing, 0 runtime type assertions</tspan>
      <tspan data-lang-vi>0 đóng hộp, 0 cần ép kiểu lúc chạy</tspan>
    </text>

    <line x1="20" x2={W - 20} y1="130" y2="130" class="rule" />

    {/* Row 2: StackAny */}
    <text x="20" y="158" class="h">
      <tspan data-lang-en>2. Non-generic []any: every element is a 16-byte eface + runtime assertion</tspan>
      <tspan data-lang-vi>2. Không dùng generic ([]any): mỗi phần tử là một eface 16 byte + phải ép kiểu</tspan>
    </text>

    <rect x="20" y="176" width="236" height="64" rx="6" class="hot" />
    <text x="138" y="202" text-anchor="middle" class="b">var nums StackAny</text>
    <text x="138" y="224" text-anchor="middle" class="r">items []any</text>

    <g><path d={a1.line} class="lnr" /><polygon points={a1.head} class="arr" /></g>

    {[0, 1, 2].map((i) => {
      const bx = 298 + i * 86;
      const val = [10, 20, 30][i];
      return (
        <g>
          <rect x={bx} y="176" width="76" height="32" class="hot" />
          <rect x={bx} y="208" width="76" height="32" class="hot" />
          <text x={bx + 38} y="197" text-anchor="middle" class="m">int</text>
          <text x={bx + 38} y="229" text-anchor="middle" class="r">ptr -&gt; {val}</text>
        </g>
      );
    })}

    <text x="572" y="198" class="b">v := nums.Pop().(int)</text>
    <text x="572" y="222" class="r">
      <tspan data-lang-en>panics at runtime if wrong type</tspan>
      <tspan data-lang-vi>nổ panic lúc chạy nếu nhầm kiểu</tspan>
    </text>

    <line x1="20" x2={W - 20} y1="264" y2="264" class="rule" />

    {/* Bottom rule: interfaces vs generics */}
    <rect x="20" y="282" width="420" height="58" rx="6" class="box" />
    <text x="36" y="306" class="b">
      <tspan data-lang-en>Use an interface when behavior varies</tspan>
      <tspan data-lang-vi>Dùng interface khi hành vi thay đổi theo nơi cài</tspan>
    </text>
    <text x="36" y="328" class="m">
      <tspan data-lang-en>io.Reader, store vs mock in tests</tspan>
      <tspan data-lang-vi>io.Reader, store thật vs mock trong unit test</tspan>
    </text>

    <rect x="460" y="282" width="420" height="58" rx="6" class="box" />
    <text x="476" y="306" class="b">
      <tspan data-lang-en>Use generics when one algorithm fits many types</tspan>
      <tspan data-lang-vi>Dùng generics khi một logic áp dụng cho nhiều kiểu</tspan>
    </text>
    <text x="476" y="328" class="m">
      <tspan data-lang-en>Stack[T], slices.SortFunc, maps.Keys</tspan>
      <tspan data-lang-vi>Stack[T], slices.SortFunc, maps.Keys</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en><code>Stack[T]</code> keeps elements strongly typed in <code>[]T</code> with no <code>any</code> boxing. Keep behavioral boundaries like <code>io.Reader</code> as plain interfaces rather than generic type parameters.</span>
    <span data-lang-vi><code>Stack[T]</code> giữ phần tử đúng kiểu trong <code>[]T</code> mà không cần đóng hộp vào <code>any</code>. Còn với các ranh giới hành vi như <code>io.Reader</code>, giữ nguyên interface thuần luôn gọn hơn tham số kiểu generic.</span>
  </figcaption>
</figure>

<style>
  .gp12c { margin: 2em 0; width: 100%; }
  .gp12c-scroll { overflow-x: auto; }
  .gp12c svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp12c text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .gp12c .h { font-size: 15.5px; font-weight: 700; fill: var(--text); }
  .gp12c .b { font-weight: 700; fill: var(--text); }
  .gp12c .m { fill: var(--text-muted); font-size: 13px; }
  .gp12c .r { fill: var(--red); font-weight: 700; font-size: 13px; }
  .gp12c .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp12c .hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .gp12c .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp12c .ar { fill: var(--text-muted); }
  .gp12c .lnr { fill: none; stroke: var(--red); stroke-width: 1.5; }
  .gp12c .arr { fill: var(--red); }
  .gp12c .rule { stroke: var(--border); stroke-width: 1; }
  .gp12c figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
