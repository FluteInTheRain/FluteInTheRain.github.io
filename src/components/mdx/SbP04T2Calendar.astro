---
// T+2 calendar across Monday buy vs Thursday buy (skipping Saturday & Sunday).
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 290;

const DAYS = [
  { x: 20, dEn: 'Mon', dVi: 'T2', subEn: 'Buy Day T', subVi: 'Mua Ngày T', off: false, accent: false },
  { x: 144, dEn: 'Tue', dVi: 'T3', subEn: 'T+1 clearing', subVi: 'T+1 chờ', off: false, accent: false },
  { x: 268, dEn: 'Wed', dVi: 'T4', subEn: 'T+2 <13:00 OK!', subVi: 'T+2 chiều bán OK!', off: false, accent: true },
  { x: 392, dEn: 'Thu', dVi: 'T5', subEn: 'Buy Day T', subVi: 'Mua Ngày T', off: false, accent: false },
  { x: 516, dEn: 'Fri', dVi: 'T6', subEn: 'T+1 clearing', subVi: 'T+1 chờ', off: false, accent: false },
  { x: 640, dEn: 'Sat–Sun', dVi: 'T7–CN', subEn: 'skipped (closed)', subVi: 'nghỉ (bỏ qua)', off: true, accent: false },
  { x: 764, dEn: 'Mon', dVi: 'T2 sau', subEn: 'T+2 <13:00 OK!', subVi: 'T+2 chiều bán OK!', off: false, accent: true },
] as const;
---
<figure class="sbp4-cal">
  <div class="sbp4-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="T+2 working-day settlement calendar: a Monday morning buy settles before 13:00 on Wednesday (sellable Wednesday afternoon); a Thursday buy skips Saturday and Sunday and settles before 13:00 on the following Monday.">
      <text x="20" y="30" class="sbp4-title">
        <tspan data-lang-en>T+2 counts working days only: Monday settles Wednesday, Thursday settles Monday</tspan>
        <tspan data-lang-vi>T+2 chỉ đếm ngày làm việc: mua thứ Hai chiều thứ Tư bán, mua thứ Năm phải chờ thứ Hai tuần sau</tspan>
      </text>

      {DAYS.map((d) => (
        <g>
          <rect
            x={d.x}
            y="60"
            width="114"
            height="120"
            rx="8"
            class={d.accent ? 'sbp4-box sbp4-box-red' : d.off ? 'sbp4-box sbp4-off' : 'sbp4-box'}
          />
          <text x={d.x + 57} y="92" text-anchor="middle" class={d.accent ? 'sbp4-day sbp4-red' : 'sbp4-day'}>
            <tspan data-lang-en>{d.dEn}</tspan>
            <tspan data-lang-vi>{d.dVi}</tspan>
          </text>
          <DiagramIcon
            name={d.accent ? 'ok' : d.off ? 'clock' : 'calendar'}
            x={d.x + 57}
            y={122}
            size={22}
          />
          <text x={d.x + 57} y="160" text-anchor="middle" class={d.accent ? 'sbp4-sub sbp4-red' : 'sbp4-sub'}>
            <tspan data-lang-en>{d.subEn}</tspan>
            <tspan data-lang-vi>{d.subVi}</tspan>
          </text>
        </g>
      ))}

      <rect x="20" y="204" width="858" height="62" rx="8" class="sbp4-box" />
      <DiagramIcon name="hourglass" x={48} y={235} size={24} />
      <text x="74" y="232" class="sbp4-hdr">
        <tspan data-lang-en>Why 13:00 on T+2 matters (since 29 August 2022)</tspan>
        <tspan data-lang-vi>Mốc trước 13:00 ngày T+2 quan trọng thế nào (từ 29/08/2022)</tspan>
      </text>
      <text x="74" y="254" class="sbp4-sub">
        <tspan data-lang-en>VSDC delivers shares before 13:00 on T+2 so you can sell in that afternoon session (13:00–14:45). Holidays also pause the clock.</tspan>
        <tspan data-lang-vi>VSDC giao cổ phiếu trước 13:00 ngày T+2 để bạn bán được ngay trong phiên chiều hôm đó (13:00–14:45). Ngày lễ Tết cũng không tính vào T+2.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Two working days, not 48 calendar hours. Buying on Thursday means Friday is T+1, Saturday and Sunday do not count, and your shares become sellable in Monday afternoon's session.</span>
    <span data-lang-vi>T+2 tính theo hai ngày làm việc, không phải 48 giờ đồng hồ. Mua vào thứ Năm thì thứ Sáu là T+1, thứ Bảy và Chủ Nhật nghỉ, tới chiều thứ Hai tuần sau cổ phiếu mới về tài khoản để bán.</span>
  </figcaption>
</figure>

<style>
  .sbp4-cal { margin: 2em 0; width: 100%; }
  .sbp4-scroll { overflow-x: auto; }
  .sbp4-cal svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sbp4-cal text { font-size: 13px; fill: var(--text-body); }
  .sbp4-title { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sbp4-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .sbp4-box-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .sbp4-off { fill: var(--bg); stroke: var(--border); stroke-dasharray: 4 3; }
  .sbp4-day { font-size: 15px; font-weight: 700; fill: var(--text); }
  .sbp4-hdr { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .sbp4-red { fill: var(--red); }
  .sbp4-sub { font-size: 11.5px; fill: var(--text-muted); }
  .sbp4-cal figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
