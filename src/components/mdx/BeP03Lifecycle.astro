---
// Order of events inside FastAPI for one POST: route, parse, validate, and
// only then your handler. Two of the gates can answer 422 on their own.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 330;
const stages = [
  { x: 40, icon: 'network', t: { en: 'route', vi: 'định tuyến' }, s: { en: 'match POST /cases', vi: 'khớp POST /cases' }, red: false },
  { x: 260, icon: 'doc', t: { en: 'parse the body', vi: 'đọc body' }, s: { en: 'JSON in, Python out', vi: 'JSON vào, Python ra' }, red: false },
  { x: 480, icon: 'shield', t: { en: 'validate', vi: 'kiểm tra' }, s: { en: 'every CaseCreate rule', vi: 'mọi luật của CaseCreate' }, red: false },
  { x: 700, icon: 'code', t: { en: 'your handler', vi: 'handler của bạn' }, s: { en: 'gets a checked instance', vi: 'nhận một instance đã kiểm' }, red: true },
];
const flow = [arrow(220, 100, 260, 100), arrow(440, 100, 480, 100), arrow(660, 100, 700, 100)];
const drops = [arrow(350, 150, 350, 214), arrow(570, 150, 570, 214)];
---
<figure class="bep3n3">
  <div class="bep3n3-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Request path inside FastAPI: route, parse the body, validate with the model, and only then call your handler. Undecodable JSON dies at the parse step with a 422 of type json_invalid, and rule violations die at the validate step with a 422; the handler is reached only by a request that passed both.">
    {stages.map((s) => (
      <g>
        <rect x={s.x} y="50" width="180" height="100" rx="8" class={s.red ? 'boxr' : 'box'} />
        <DiagramIcon name={s.icon} x={s.x + 90} y={74} size={22} />
        <text x={s.x + 90} y="118" text-anchor="middle" class={s.red ? 't r' : 't'}><tspan data-lang-en>{s.t.en}</tspan><tspan data-lang-vi>{s.t.vi}</tspan></text>
        <text x={s.x + 90} y="138" text-anchor="middle" class="m"><tspan data-lang-en>{s.s.en}</tspan><tspan data-lang-vi>{s.s.vi}</tspan></text>
      </g>
    ))}
    {flow.map((a) => (<g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>))}
    {drops.map((a) => (<g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>))}
    <rect x="260" y="220" width="180" height="62" rx="8" class="box" />
    <text x="350" y="246" text-anchor="middle" class="t">422</text>
    <text x="350" y="266" text-anchor="middle" class="m">json_invalid</text>
    <rect x="480" y="220" width="180" height="62" rx="8" class="box" />
    <text x="570" y="246" text-anchor="middle" class="t">422</text>
    <text x="570" y="266" text-anchor="middle" class="m"><tspan data-lang-en>one entry per broken rule</tspan><tspan data-lang-vi>mỗi luật vỡ một mục</tspan></text>
    <text x="790" y="244" text-anchor="middle" class="rr"><tspan data-lang-en>only valid input gets here</tspan><tspan data-lang-vi>chỉ input hợp lệ mới tới đây</tspan></text>
    <text x="790" y="264" text-anchor="middle" class="m"><tspan data-lang-en>so a 422 never prints</tspan><tspan data-lang-vi>nên 422 không bao giờ in</tspan></text>
    <text x="790" y="282" text-anchor="middle" class="m">"handler running"</text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The 422 is born in the framework, at the parse and validate steps, before the line of your code that would have run next.</span>
    <span data-lang-vi>422 sinh ra trong framework, ở bước đọc và kiểm tra, trước dòng code của bạn lẽ ra chạy tiếp theo.</span>
  </figcaption>
</figure>

<style>
  .bep3n3 { margin: 2em 0; width: 100%; }
  .bep3n3-scroll { overflow-x: auto; }
  .bep3n3 svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep3n3 text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep3n3 .t { font-weight: 700; fill: var(--text); }
  .bep3n3 .m { fill: var(--text-muted); font-size: 12.5px; }
  .bep3n3 .r { fill: var(--red); }
  .bep3n3 .rr { font-weight: 700; fill: var(--red); font-size: 13px; }
  .bep3n3 .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep3n3 .boxr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bep3n3 .ghost { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .bep3n3 .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep3n3 .lnr { stroke: var(--red); stroke-width: 1.5; fill: none; }
  .bep3n3 .hd { fill: var(--text-muted); }
  .bep3n3 .hdr { fill: var(--red); }
  .bep3n3 figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
