---
// Chapter 4: a 1.25 modular scale from 16px vs the hand-crafted 9-step UI scale.
// Each "Aa" is drawn at its size in the viewBox, so fractional steps and the gap between 16 and 20 show.

const modular = [10.24, 12.8, 16, 20, 25, 31.25, 39.06, 48.83];
const hand = [12, 14, 16, 18, 20, 24, 30, 36, 48];

const W = 900;
const H = 370;
const x0 = 30;

function layout(values: number[]) {
  let x = x0;
  return values.map((v) => {
    const w = Math.max(v * 1.35, 40);
    const item = { v, x: x + w / 2 };
    x += w + 26;
    return item;
  });
}
const rowM = layout(modular);
const rowH = layout(hand);
const baseM = 120;
const baseH = 300;
const isFrac = (v: number) => !Number.isInteger(v);
const fracCount = modular.filter(isFrac).length;
---
<figure class="mvh">
  <div class="mvh-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Top row: a modular scale, 16 pixels times 1.25 up and down: 10.24, 12.8, 16, 20, 25, 31.25, 39.06, 48.83. ${fracCount} of 8 steps are fractional, and nothing sits between 16 and 20. Bottom row: the hand-crafted UI scale, 12, 14, 16, 18, 20, 24, 30, 36, 48, all whole pixels.`}>
      <text x={x0} y="26" class="mvh-h">
        <tspan data-lang-en>Modular scale, 16px × 1.25: {fracCount} of {modular.length} steps fractional</tspan>
        <tspan data-lang-vi>Thang tỷ lệ, 16px × 1.25: {fracCount}/{modular.length} bậc là số lẻ</tspan>
      </text>
      <line x1={x0} x2={W - 30} y1={baseM} y2={baseM} class="mvh-base" />
      {rowM.map(({ v, x }) => (
        <g>
          <text x={x} y={baseM - 4} text-anchor="middle" class="mvh-glyph" style={`font-size:${v}px`}>Aa</text>
          <text x={x} y={baseM + 24} text-anchor="middle" class:list={['mvh-num', { 'is-off': isFrac(v) }]}>{v}</text>
        </g>
      ))}
      <path d={`M ${rowM[2].x + 14} ${baseM + 36} Q ${(rowM[2].x + rowM[3].x) / 2} ${baseM + 50} ${rowM[3].x - 14} ${baseM + 36}`} class="mvh-gap" />
      <text x={(rowM[2].x + rowM[3].x) / 2} y={baseM + 66} text-anchor="middle" class="mvh-note">
        <tspan data-lang-en>no 18 for card titles</tspan>
        <tspan data-lang-vi>không có 18 cho tiêu đề thẻ</tspan>
      </text>

      <text x={x0} y="214" class="mvh-h">
        <tspan data-lang-en>Hand-crafted UI scale: {hand.length} steps, all whole pixels</tspan>
        <tspan data-lang-vi>Thang chữ tự chọn cho UI: {hand.length} bậc, toàn số nguyên</tspan>
      </text>
      <line x1={x0} x2={W - 30} y1={baseH} y2={baseH} class="mvh-base" />
      {rowH.map(({ v, x }) => (
        <g>
          <text x={x} y={baseH - 4} text-anchor="middle" class="mvh-glyph" style={`font-size:${v}px`}>Aa</text>
          <text x={x} y={baseH + 24} text-anchor="middle" class="mvh-num">{v}</text>
        </g>
      ))}
      <text x={W - 30} y={H - 8} text-anchor="end" class="mvh-unit">px</text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Red labels are sizes a ratio produces but a screen cannot draw cleanly. The ratio also jumps from 16 to 20, skipping the step most UIs need for card titles.</span>
    <span data-lang-vi>Nhãn đỏ là các cỡ mà phép nhân tỷ lệ sinh ra nhưng màn hình không vẽ gọn được. Tỷ lệ này còn nhảy thẳng từ 16 lên 20, bỏ mất nấc mà hầu hết UI cần cho tiêu đề thẻ.</span>
  </figcaption>
</figure>

<style>
  .mvh { margin: 2em 0; width: 100%; }
  .mvh-scroll { overflow-x: auto; }
  .mvh svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .mvh text { fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .mvh text.mvh-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .mvh text.mvh-glyph { font-weight: 600; fill: var(--text); }
  .mvh text.mvh-num { font-size: 13px; fill: var(--text-muted); }
  .mvh text.mvh-num.is-off { fill: var(--red); font-weight: 700; }
  .mvh text.mvh-note { font-size: 12px; fill: var(--red); }
  .mvh text.mvh-unit { font-size: 13px; fill: var(--text-faint); }
  .mvh-base { stroke: var(--border); }
  .mvh-gap { fill: none; stroke: var(--red); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .mvh figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
