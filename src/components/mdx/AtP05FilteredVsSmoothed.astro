---
// P(turbulent) around the Feb 2020 break, from the full-sample two-state HMM fitted to real S&P 500 returns (python).
// Filtered = uses data up to that day's close. Smoothed = also uses every later day.
// Values: 18,19,20,21,24,25,26,27,28 Feb 2020.
const W = 900, H = 400;
const days = ['18', '19', '20', '21', '24', '25', '26', '27', '28'];
const filt = [0.011, 0.011, 0.012, 0.045, 0.9999, 1.0, 0.901, 1.0, 0.9495];
const smooth = [0.041, 0.106, 0.289, 0.717, 1.0, 1.0, 0.998, 1.0, 0.999];
const ret = ['−0.3', '+0.5', '−0.4', '−1.1', '−3.4', '−3.1', '−0.4', '−4.5', '−0.8'];
const x0 = 90, step = 86, top = 80, base = 300;
const X = (k: number) => x0 + k * step;
const Y = (p: number) => base - p * (base - top);
const line = (a: number[]) => a.map((p, k) => `${k ? 'L' : 'M'} ${X(k)} ${Y(p).toFixed(1)}`).join(' ');
---
<figure class="p5v">
  <div class="p5v-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two lines of the probability of the turbulent state from 18 to 28 February 2020. The smoothed line, which uses future days, rises from 4 percent on 18 February to 72 percent on 21 February. The filtered line, which uses only the past, stays near 1 to 5 percent until 21 February and jumps to 100 percent on 24 February.">
    <text x="20" y="26" class="h">
      <tspan data-lang-en>Probability of “turbulent”: what you knew vs what you know now</tspan>
      <tspan data-lang-vi>Xác suất “hỗn loạn”: lúc đó biết gì và bây giờ biết gì</tspan>
    </text>
    <line x1={x0 - 20} y1={Y(0.5)} x2={X(8) + 20} y2={Y(0.5)} class="thr" />
    <text x={X(8) + 22} y={Y(0.5) + 4} class="tick">
      <tspan data-lang-en>50%</tspan>
      <tspan data-lang-vi>50%</tspan>
    </text>
    <line x1={x0 - 20} y1={base} x2={X(8) + 20} y2={base} class="axis" />
    <path d={line(smooth)} class="ls" />
    <path d={line(filt)} class="lf" />
    {filt.map((p, k) => <circle cx={X(k)} cy={Y(p)} r="4.5" class="df" />)}
    {smooth.map((p, k) => <circle cx={X(k)} cy={Y(p)} r="4" class="ds" />)}
    {days.map((dd, k) => (
      <g>
        <text x={X(k)} y={base + 22} text-anchor="middle" class="tick">{dd}</text>
        <text x={X(k)} y={base + 44} text-anchor="middle" class={Math.abs(parseFloat(ret[k].replace('−', '-'))) > 2 ? 'rv hot' : 'rv'}>{ret[k]}%</text>
      </g>
    ))}
    <text x={x0 - 20} y={base + 66} class="note">
      <tspan data-lang-en>Feb 2020 (top row) and the S&amp;P 500 return that day (bottom row)</tspan>
      <tspan data-lang-vi>Ngày trong 2/2020 (hàng trên) và lợi suất S&amp;P 500 hôm đó (hàng dưới)</tspan>
    </text>

    <text x={X(0) + 6} y={Y(0.72) - 14} class="lab-s">
      <tspan data-lang-en>smoothed: already 72% on 21 Feb</tspan>
      <tspan data-lang-vi>smoothed: đã 72% từ 21/2</tspan>
    </text>
    <text x={X(4) + 14} y={Y(0.3)} class="lab-f">
      <tspan data-lang-en>filtered: 4.5% on 21 Feb, 100% on 24 Feb</tspan>
      <tspan data-lang-vi>filtered: 4,5% ngày 21/2, 100% ngày 24/2</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The smoothed line peeks at later returns, so it starts leaning towards turbulence three days early. The filtered line is the one a live system could have computed.</span>
    <span data-lang-vi>Đường smoothed liếc nhìn các lợi suất về sau nên nghiêng sang hỗn loạn sớm ba ngày. Đường filtered mới là thứ một hệ thống chạy thật có thể tính được.</span>
  </figcaption>
</figure>

<style>
  .p5v { margin: 2em 0; width: 100%; }
  .p5v-scroll { overflow-x: auto; }
  .p5v svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .p5v text { fill: var(--text-body); font-size: 13px; }
  .p5v .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p5v .tick { fill: var(--text-muted); font-size: 12.5px; }
  .p5v .note { fill: var(--text-muted); font-size: 12.5px; }
  .p5v .rv { fill: var(--text-muted); font-size: 12.5px; font-weight: 600; }
  .p5v .rv.hot { fill: var(--red); }
  .p5v .lab-s { font-size: 13px; font-weight: 700; fill: var(--text-muted); }
  .p5v .lab-f { font-size: 13px; font-weight: 700; fill: var(--red); }
  .p5v .axis { stroke: var(--border); stroke-width: 1.3; }
  .p5v .thr { stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .p5v .ls { fill: none; stroke: var(--text-muted); stroke-width: 2; stroke-dasharray: 6 4; }
  .p5v .lf { fill: none; stroke: var(--red); stroke-width: 2.4; }
  .p5v .df { fill: var(--red); }
  .p5v .ds { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.8; }
  .p5v figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
