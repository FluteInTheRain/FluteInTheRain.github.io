---
// One handler folds the default list of error objects into a flat map keyed
// by loc, using the three broken inputs from the captured request.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 330;
const rows = [
  { y: 74, tag: 'path', bad: 'case_id = NOPE', key: 'path.case_id', msg: "String should match pattern '^[0-9a-f]{8}$'" },
  { y: 166, tag: 'query', bad: 'dry_run = maybe', key: 'query.dry_run', msg: 'Input should be a valid boolean, unable to interpret input' },
  { y: 258, tag: 'body', bad: 'title = ??', key: 'body.title', msg: 'String should have at least 3 characters' },
];
const inA = rows.map((r) => arrow(210, r.y, 262, r.y));
const outA = rows.map((r) => arrow(382, r.y, 430, r.y));
---
<figure class="bep3n4">
  <div class="bep3n4-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three broken inputs from one request, path case_id NOPE, query dry_run maybe and body title ??, go through one exception handler for RequestValidationError and come out as a flat map of three entries keyed path.case_id, query.dry_run and body.title.">
    <rect x="262" y="34" width="120" height="262" rx="8" class="box" />
    <DiagramIcon name="sync" x={322} y={66} size={24} />
    <text x="322" y="116" text-anchor="middle" class="t">flat_422</text>
    <text x="322" y="138" text-anchor="middle" class="m"><tspan data-lang-en>one handler</tspan><tspan data-lang-vi>một handler</tspan></text>
    <text x="322" y="156" text-anchor="middle" class="m"><tspan data-lang-en>for every 422</tspan><tspan data-lang-vi>cho mọi 422</tspan></text>
    {rows.map((r) => (
      <g>
        <text x="30" y={r.y - 6} class="t">{r.tag}</text>
        <text x="30" y={r.y + 14} class="m">{r.bad}</text>
        <text x="440" y={r.y - 6} class="t">{r.key}</text>
        <text x="440" y={r.y + 14} class="m">{r.msg}</text>
      </g>
    ))}
    {inA.map((a) => (<g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>))}
    {outA.map((a) => (<g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>))}
    <text x="450" y="322" text-anchor="middle" class="rr"><tspan data-lang-en>reshaped on the way out; your handler still never ran</tspan><tspan data-lang-vi>định hình lại lúc đi ra; handler của bạn vẫn chưa chạy</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Three broken inputs, three entries. The loc prefix says which part of the request each one came from.</span>
    <span data-lang-vi>Ba input sai, ba mục lỗi. Tiền tố của loc cho biết mỗi mục đến từ phần nào của request.</span>
  </figcaption>
</figure>

<style>
  .bep3n4 { margin: 2em 0; width: 100%; }
  .bep3n4-scroll { overflow-x: auto; }
  .bep3n4 svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep3n4 text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep3n4 .t { font-weight: 700; fill: var(--text); }
  .bep3n4 .m { fill: var(--text-muted); font-size: 12.5px; }
  .bep3n4 .r { fill: var(--red); }
  .bep3n4 .rr { font-weight: 700; fill: var(--red); font-size: 13px; }
  .bep3n4 .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep3n4 .boxr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bep3n4 .ghost { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .bep3n4 .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep3n4 .lnr { stroke: var(--red); stroke-width: 1.5; fill: none; }
  .bep3n4 .hd { fill: var(--text-muted); }
  .bep3n4 .hdr { fill: var(--red); }
  .bep3n4 figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
