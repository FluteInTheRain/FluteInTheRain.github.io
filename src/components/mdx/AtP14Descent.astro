---
// Gradient descent on the simplest loss, f(w) = w^2, starting at w = 4:
// w <- w - lr * 2w, six steps. Checked in Python:
//   lr 0.10: 4, 3.2, 2.56, 2.048, 1.638, 1.311, 1.049
//   lr 0.45: 4, 0.4, 0.04, 0.004, ... (w after 6 steps = 4e-6)
//   lr 1.05: 4, -4.4, 4.84, -5.324, 5.856, -6.442, 7.086
const W = 900;
const H = 372;
const runs = [
  { lr: 0.1, tone: 'slow', en: 'too small', vi: 'quá nhỏ', end: '1.049', endvi: '1,049', noteEn: 'still far from 0 after 6 steps', noteVi: 'sau 6 bước vẫn còn xa 0' },
  { lr: 0.45, tone: 'good', en: 'about right', vi: 'vừa phải', end: '0.000004', endvi: '0,000004', noteEn: 'lands on the bottom in 2 steps', noteVi: 'chạm đáy sau 2 bước' },
  { lr: 1.05, tone: 'bad', en: 'too big', vi: 'quá lớn', end: '7.086', endvi: '7,086', noteEn: 'overshoots, and each swing is larger', noteVi: 'vọt qua đáy, mỗi lần dao động lớn hơn' },
];
const px = 30, pw = 250, py = 96, ph = 150, gap = 295;
const gx = (w: number, k: number) => px + k * gap + ((w + 8) / 16) * pw;
const gy = (f: number) => py + ph - (Math.min(f, 64) / 64) * ph;
const curve = (k: number) =>
  Array.from({ length: 33 }, (_, i) => {
    const w = -8 + i * 0.5;
    return `${i ? 'L' : 'M'}${gx(w, k).toFixed(1)} ${gy(w * w).toFixed(1)}`;
  }).join(' ');
const path = (lr: number) => {
  const pts: number[] = [4];
  for (let i = 0; i < 6; i++) pts.push(pts[i] - lr * 2 * pts[i]);
  return pts;
};
---
<figure class="atp14-gd">
  <div class="atp14-gd-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three gradient descent runs on a bowl-shaped loss, six steps from w equal 4. With learning rate 0.1 the steps are small and w is still 1.049. With 0.45 w reaches almost 0 in two steps. With 1.05 the steps jump from side to side and grow, ending at 7.086.">
    <text x="20" y="26" class="h">
      <tspan data-lang-en>Gradient descent: walk downhill, and the step size decides everything</tspan>
      <tspan data-lang-vi>Gradient descent: đi xuống dốc, và độ dài bước quyết định tất cả</tspan>
    </text>
    <text x="20" y="46" class="sub">
      <tspan data-lang-en>Loss f(w) = w², start at w = 4, six steps of w ← w − lr · 2w.</tspan>
      <tspan data-lang-vi>Loss f(w) = w², bắt đầu ở w = 4, sáu bước w ← w − lr · 2w.</tspan>
    </text>
    {runs.map((r, k) => {
      const ws = path(r.lr);
      return (
        <g>
          <rect x={px + k * gap - 10} y="64" width={pw + 20} height="290" rx="6" class="panel" />
          <text x={px + k * gap + pw / 2} y="86" text-anchor="middle" class="t">
            <tspan data-lang-en>learning rate {r.lr} ({r.en})</tspan>
            <tspan data-lang-vi>learning rate {String(r.lr).replace('.', ',')} ({r.vi})</tspan>
          </text>
          <line x1={px + k * gap} y1={py + ph} x2={px + k * gap + pw} y2={py + ph} class="axis" />
          <path d={curve(k)} class="bowl" />
          <polyline points={ws.map((w) => `${gx(w, k).toFixed(1)},${gy(w * w).toFixed(1)}`).join(' ')} class={`trail ${r.tone}`} />
          {ws.map((w, i) => (
            <circle cx={gx(w, k)} cy={gy(w * w)} r={i === 0 ? 5 : 3.6} class={`pt ${r.tone}${i === 0 ? ' first' : ''}`} />
          ))}
          <text x={px + k * gap + pw / 2} y={py + ph + 24} text-anchor="middle" class="n">
            <tspan data-lang-en>w after 6 steps: {r.end}</tspan>
            <tspan data-lang-vi>w sau 6 bước: {r.endvi}</tspan>
          </text>
          <text x={px + k * gap + pw / 2} y={py + ph + 46} text-anchor="middle" class="sub">
            <tspan data-lang-en>{r.noteEn}</tspan>
            <tspan data-lang-vi>{r.noteVi}</tspan>
          </text>
        </g>
      );
    })}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The big circle is the start. Training a network repeats this walk over millions of weights at once, with the slope computed by backpropagation.</span>
    <span data-lang-vi>Chấm lớn là điểm xuất phát. Huấn luyện một mạng là lặp lại cú đi này trên hàng triệu trọng số cùng lúc, với độ dốc tính bằng backpropagation.</span>
  </figcaption>
</figure>

<style>
  .atp14-gd { margin: 2em 0; width: 100%; }
  .atp14-gd-scroll { overflow-x: auto; }
  .atp14-gd svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .atp14-gd text { font-size: 14px; fill: var(--text-body); }
  .atp14-gd .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp14-gd .sub { font-size: 13px; fill: var(--text-muted); }
  .atp14-gd .t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .atp14-gd .n { font-size: 13.5px; font-weight: 600; fill: var(--text); }
  .atp14-gd .panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .atp14-gd .axis { stroke: var(--border); stroke-width: 1.2; }
  .atp14-gd .bowl { fill: none; stroke: var(--text-muted); stroke-width: 1.6; }
  .atp14-gd .trail { fill: none; stroke-width: 1.5; stroke-dasharray: 3 3; }
  .atp14-gd .trail.slow { stroke: var(--text-muted); }
  .atp14-gd .trail.good { stroke: var(--gold); stroke-dasharray: none; }
  .atp14-gd .trail.bad { stroke: var(--red); }
  .atp14-gd .pt { stroke-width: 1.4; }
  .atp14-gd .pt.slow { fill: var(--bg); stroke: var(--text-muted); }
  .atp14-gd .pt.good { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .atp14-gd .pt.bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .atp14-gd .pt.first { stroke-width: 2.4; }
  .atp14-gd figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
