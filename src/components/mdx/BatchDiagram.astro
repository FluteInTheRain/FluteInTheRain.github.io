---
// Generic bilingual SVG diagram renderer for the batch-processing post.
// Callers pass plain data (boxes, arrows, texts); colours come only from site tokens.
type L = [string, string]; // [English, Vietnamese]
interface Box { x: number; y: number; w: number; h: number; t: L; s?: L[]; kind?: 'hot' | 'good' }
interface Arrow { x1: number; y1: number; x2: number; y2: number; kind?: 'hot' | 'good' | 'dash'; label?: L; lx?: number; ly?: number }
interface Txt { x: number; y: number; cls: 'h' | 'sub' | 'warn' | 'ok' | 'foot'; t: L; anchor?: 'start' | 'middle' | 'end' }
interface Props {
  w: number; h: number; aria: string;
  boxes: Box[]; arrows?: Arrow[]; texts?: Txt[]; rules?: number[];
  caption: L;
}
const { w, h, aria, boxes, arrows = [], texts = [], rules = [], caption } = Astro.props as Props;

const arrows2 = arrows.map((a) => {
  const ang = Math.atan2(a.y2 - a.y1, a.x2 - a.x1);
  const bx = a.x2 - 9 * Math.cos(ang), by = a.y2 - 9 * Math.sin(ang);
  const px = 4.5 * Math.sin(ang), py = 4.5 * Math.cos(ang);
  return {
    ...a,
    line: `M${a.x1},${a.y1} L${bx.toFixed(1)},${by.toFixed(1)}`,
    head: `${(bx + px).toFixed(1)},${(by - py).toFixed(1)} ${(bx - px).toFixed(1)},${(by + py).toFixed(1)} ${a.x2},${a.y2}`,
    mx: a.lx ?? (a.x1 + a.x2) / 2,
    my: a.ly ?? ((a.y1 + a.y2) / 2 - 8),
  };
});
---
<figure class="bdg">
  <div class="bdg-scroll">
    <svg viewBox={`0 0 ${w} ${h}`} role="img" aria-label={aria}>
      {rules.map((y) => <line x1="20" x2={w - 20} y1={y} y2={y} class="bdg-rule" />)}
      {texts.map((t) => (
        <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`bdg-${t.cls}`}>
          <tspan data-lang-en>{t.t[0]}</tspan>
          <tspan data-lang-vi>{t.t[1]}</tspan>
        </text>
      ))}
      {arrows2.map((a) => (
        <g>
          <path d={a.line} class={`bdg-arrow ${a.kind ? 'is-' + a.kind : ''}`} />
          <polygon points={a.head} class={`bdg-head ${a.kind ? 'is-' + a.kind : ''}`} />
          {a.label && (
            <text x={a.mx} y={a.my} text-anchor="middle" class="bdg-note">
              <tspan data-lang-en>{a.label[0]}</tspan>
              <tspan data-lang-vi>{a.label[1]}</tspan>
            </text>
          )}
        </g>
      ))}
      {boxes.map((b) => {
        const lines = b.s ?? [];
        const total = 1 + lines.length;
        const top = b.y + b.h / 2 - (total * 18) / 2 + 13;
        return (
          <g>
            <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" class={`bdg-box ${b.kind ? 'is-' + b.kind : ''}`} />
            <text x={b.x + b.w / 2} y={top} text-anchor="middle" class={`bdg-in-b ${b.kind ? 'is-' + b.kind : ''}`}>
              <tspan data-lang-en>{b.t[0]}</tspan>
              <tspan data-lang-vi>{b.t[1]}</tspan>
            </text>
            {lines.map((s, i) => (
              <text x={b.x + b.w / 2} y={top + 18 * (i + 1)} text-anchor="middle" class="bdg-in-m">
                <tspan data-lang-en>{s[0]}</tspan>
                <tspan data-lang-vi>{s[1]}</tspan>
              </text>
            ))}
          </g>
        );
      })}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>{caption[0]}</span>
    <span data-lang-vi>{caption[1]}</span>
  </figcaption>
</figure>

<style>
  .bdg { margin: 2em 0; width: 100%; }
  .bdg-scroll { overflow-x: auto; }
  .bdg svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bdg text { font-size: 14px; fill: var(--text-body); }
  .bdg .bdg-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .bdg .bdg-sub { fill: var(--text-muted); }
  .bdg .bdg-warn { font-size: 13px; font-weight: 600; fill: var(--red); }
  .bdg .bdg-ok { font-size: 13px; font-weight: 600; fill: var(--gold-icon); }
  .bdg .bdg-foot { font-size: 13px; fill: var(--text-muted); }
  .bdg .bdg-note { font-size: 12.5px; fill: var(--text-muted); }
  .bdg-rule { stroke: var(--border); }
  .bdg-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bdg-box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .bdg-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .bdg .bdg-in-b { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .bdg .bdg-in-b.is-hot { fill: var(--red); }
  .bdg .bdg-in-m { font-size: 12.5px; fill: var(--text-muted); }
  .bdg-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .bdg-arrow.is-hot { stroke: var(--red); stroke-width: 1.8; }
  .bdg-arrow.is-good { stroke: var(--gold); stroke-width: 1.8; }
  .bdg-arrow.is-dash { stroke-dasharray: 5 4; }
  .bdg-head { fill: var(--text-muted); }
  .bdg-head.is-hot { fill: var(--red); }
  .bdg-head.is-good { fill: var(--gold); }
  .bdg-head.is-dash { fill: var(--text-muted); }
  .bdg figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
