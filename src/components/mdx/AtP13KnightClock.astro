---
import DiagramIcon from './DiagramIcon.astro';
// Knight Capital, 1 Aug 2012, every number from SEC Release 34-70694 (paras 16-19).
// Not to scale: the 97 e-mails arrive before 9:30, the damage happens in about 45 minutes after the open.
const W = 900;
const H = 372;
const stats = [
  { n: '212', en: 'parent orders hit the old code', vi: 'lệnh mẹ chạm vào code cũ' },
  { n: '4,000,000', en: 'executions in 154 stocks', vi: 'lần khớp ở 154 mã' },
  { n: '397,000,000+', en: 'shares traded (more than)', vi: 'cổ phiếu được giao dịch (hơn)' },
  { n: '$460 million', en: 'realised loss', vi: 'thua lỗ đã chốt', bad: true },
];
---
<figure class="atp13-kc">
  <div class="atp13-kc-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Timeline of 1 August 2012 at Knight Capital: 97 automated e-mails before the 9:30 open that nobody acted on, then about 45 minutes of runaway orders: 212 parent orders produced 4 million executions in 154 stocks, 397 million shares and a 460 million dollar loss.">
      <text x="30" y="30" class="h">
        <tspan data-lang-en>1 August 2012, one router server, not to scale</tspan>
        <tspan data-lang-vi>Ngày 1/8/2012, một server định tuyến lệnh, không theo tỉ lệ</tspan>
      </text>

      <line x1="30" x2="870" y1="112" y2="112" class="axis" />

      <rect x="30" y="90" width="220" height="44" rx="8" class="box" />
      <DiagramIcon name="mail" x={54} y={112} size={22} />
      <text x="76" y="108" class="lab">
        <tspan data-lang-en>from 8:01: 97 e-mails</tspan>
        <tspan data-lang-vi>từ 8:01: 97 e-mail</tspan>
      </text>
      <text x="76" y="126" class="sub">
        <tspan data-lang-en>"Power Peg disabled"</tspan>
        <tspan data-lang-vi>"Power Peg disabled"</tspan>
      </text>

      <line x1="250" x2="300" y1="112" y2="112" class="axis" />
      <line x1="300" x2="300" y1="80" y2="146" class="open" />
      <text x="300" y="72" text-anchor="middle" class="tick">
        <tspan data-lang-en>9:30 market opens</tspan>
        <tspan data-lang-vi>9:30 thị trường mở cửa</tspan>
      </text>

      <rect x="300" y="90" width="570" height="44" rx="8" class="box hot fm-glow" />
      <DiagramIcon name="panic" x={326} y={112} size={22} />
      <text x="352" y="108" class="lab hotl">
        <tspan data-lang-en>about 45 minutes of child orders</tspan>
        <tspan data-lang-vi>khoảng 45 phút lệnh con tuôn ra</tspan>
      </text>
      <text x="352" y="126" class="sub">
        <tspan data-lang-en>nobody and nothing stops the router</tspan>
        <tspan data-lang-vi>không người và không cơ chế nào dừng được router</tspan>
      </text>

      <text x="30" y="178" class="note">
        <tspan data-lang-en>The e-mails were not designed as alerts, and nobody read them before the open.</tspan>
        <tspan data-lang-vi>Các e-mail này không được thiết kế làm cảnh báo, và không ai đọc trước giờ mở cửa.</tspan>
      </text>

      {stats.map((s, i) => (
        <g>
          <rect x={30 + i * 212} y="206" width="196" height="118" rx="10" class={s.bad ? 'box hot' : 'box'} />
          <text x={30 + i * 212 + 98} y="254" text-anchor="middle" class={s.bad ? 'big hotl' : 'big'}>{s.n}</text>
          <text x={30 + i * 212 + 98} y="284" text-anchor="middle" class="sub">
            <tspan data-lang-en>{s.en}</tspan>
            <tspan data-lang-vi>{s.vi}</tspan>
          </text>
        </g>
      ))}
      <text x="30" y="352" class="note">
        <tspan data-lang-en>Net positions at the end: about $3.5 billion long in 80 stocks and $3.15 billion short in 74 stocks.</tspan>
        <tspan data-lang-vi>Vị thế ròng cuối cùng: khoảng 3,5 tỷ USD mua ở 80 mã và 3,15 tỷ USD bán khống ở 74 mã.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Source: SEC order against Knight Capital Americas LLC, Release 34-70694, 16 October 2013, paragraphs 16 to 19.</span>
    <span data-lang-vi>Nguồn: lệnh xử phạt của SEC đối với Knight Capital Americas LLC, Release 34-70694, ngày 16/10/2013, đoạn 16 đến 19.</span>
  </figcaption>
</figure>

<style>
  .atp13-kc { margin: 2em 0; width: 100%; }
  .atp13-kc-scroll { overflow-x: auto; }
  .atp13-kc svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp13-kc .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .atp13-kc .lab { font-size: 14px; font-weight: 700; fill: var(--text); }
  .atp13-kc .hotl { fill: var(--red); }
  .atp13-kc .sub { font-size: 13px; fill: var(--text-muted); }
  .atp13-kc .note { font-size: 13px; fill: var(--text-body); }
  .atp13-kc .tick { font-size: 13px; fill: var(--text-muted); }
  .atp13-kc .big { font-size: 26px; font-weight: 700; fill: var(--text); }
  .atp13-kc .axis { stroke: var(--border); stroke-width: 2; }
  .atp13-kc .open { stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .atp13-kc .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .atp13-kc .box.hot { fill: var(--red-tint-bg); stroke: var(--red); }
  .atp13-kc figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
