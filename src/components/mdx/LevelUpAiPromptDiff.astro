---
// Before/after visual showdown: a vague AI prompt ("Make a modern SaaS card")
// and its generic output on the left, versus a trained-eye prompt naming exact
// hierarchy, spacing, and shadow rules and its crisp output on the right.

const W = 900;
const H = 434;
---

<figure class="lap">
  <div class="lap-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Side-by-side comparison of a vague AI prompt producing a generic cramped SaaS card versus a trained-eye prompt specifying hierarchy, padding, and layered shadow producing a crisp card.">
      {/* Column titles */}
      <text x="20" y="24" class="lap-col-h">
        <tspan data-lang-en>Vague aesthetic prompt → generic output</tspan>
        <tspan data-lang-vi>Prompt cảm tính mơ hồ → kết quả đại trà</tspan>
      </text>
      <text x="472" y="24" class="lap-col-h is-accent">
        <tspan data-lang-en>Trained-eye prompt → deliberate output</tspan>
        <tspan data-lang-vi>Prompt từ mắt đã rèn → giao diện sắc nét</tspan>
      </text>
      <line x1="20" x2="428" y1="35" y2="35" class="lap-rule" />
      <line x1="472" x2="880" y1="35" y2="35" class="lap-rule is-accent" />

      {/* ================= LEFT: VAGUE PROMPT ================= */}
      <rect x="20" y="48" width="408" height="92" rx="8" class="lap-prompt-box" />
      <text x="36" y="70" class="lap-prompt-lbl">
        <tspan data-lang-en>Prompt:</tspan>
        <tspan data-lang-vi>Lời nhắc:</tspan>
      </text>
      <text x="36" y="94" class="lap-prompt-txt">
        <tspan data-lang-en>"Make a clean, modern SaaS pricing card</tspan>
        <tspan data-lang-vi>"Làm một thẻ bảng giá SaaS trông sạch sẽ,</tspan>
      </text>
      <text x="36" y="114" class="lap-prompt-txt">
        <tspan data-lang-en>that looks nice and professional."</tspan>
        <tspan data-lang-vi>hiện đại và chuyên nghiệp hơn."</tspan>
      </text>

      {/* Down arrow left */}
      <line x1="224" x2="224" y1="140" y2="164" class="lap-arrow" />
      <polygon points="224,169 219,161 229,161" class="lap-arrow-head" />

      {/* Generic output card */}
      <g transform="translate(20, 176)">
        <rect x="0" y="0" width="408" height="206" rx="4" class="lap-generic-card" />
        {/* Cramped uniform typography, competing buttons, thick dividers */}
        <text x="14" y="26" class="lap-gen-title">
          <tspan data-lang-en>Pro Plan — Most Popular</tspan>
          <tspan data-lang-vi>Gói Pro — Phổ biến nhất</tspan>
        </text>
        <text x="14" y="48" class="lap-gen-price">
          <tspan data-lang-en>$49 / month per user</tspan>
          <tspan data-lang-vi>$49 / tháng mỗi người</tspan>
        </text>
        <line x1="14" x2="394" y1="60" y2="60" class="lap-gen-hr" />
        <text x="14" y="82" class="lap-gen-body">
          <tspan data-lang-en>• Unlimited projects and team members</tspan>
          <tspan data-lang-vi>• Không giới hạn dự án và thành viên</tspan>
        </text>
        <text x="14" y="102" class="lap-gen-body">
          <tspan data-lang-en>• Priority support and audit logs</tspan>
          <tspan data-lang-vi>• Hỗ trợ ưu tiên và nhật ký kiểm tra</tspan>
        </text>
        <text x="14" y="122" class="lap-gen-body">
          <tspan data-lang-en>• Custom domains and analytics</tspan>
          <tspan data-lang-vi>• Tên miền riêng và bảng thống kê</tspan>
        </text>
        <line x1="14" x2="394" y1="138" y2="138" class="lap-gen-hr" />
        {/* Two competing equal-weight buttons */}
        <rect x="14" y="152" width="184" height="38" rx="4" class="lap-gen-btn" />
        <text x="106" y="176" text-anchor="middle" class="lap-gen-btn-txt">
          <tspan data-lang-en>Compare plans</tspan>
          <tspan data-lang-vi>So sánh gói</tspan>
        </text>
        <rect x="210" y="152" width="184" height="38" rx="4" class="lap-gen-btn" />
        <text x="302" y="176" text-anchor="middle" class="lap-gen-btn-txt">
          <tspan data-lang-en>Buy now</tspan>
          <tspan data-lang-vi>Mua ngay</tspan>
        </text>
      </g>

      {/* Left diagnosis note */}
      <text x="20" y="408" class="lap-diag">
        <tspan data-lang-en>Result: flat hierarchy, cramped 14px padding, and two buttons fighting for attention.</tspan>
        <tspan data-lang-vi>Kết quả: thiếu phân cấp, đệm 14px bí bách và hai nút tranh sự chú ý nhau.</tspan>
      </text>

      {/* ================= RIGHT: TRAINED-EYE PROMPT ================= */}
      <rect x="472" y="48" width="408" height="92" rx="8" class="lap-prompt-box is-accent" />
      <text x="488" y="70" class="lap-prompt-lbl is-accent">
        <tspan data-lang-en>Prompt with Parts 1–8 vocabulary:</tspan>
        <tspan data-lang-vi>Lời nhắc dùng từ vựng Bài 1–8:</tspan>
      </text>
      <text x="488" y="94" class="lap-prompt-txt">
        <tspan data-lang-en>"24px padding; muted eyebrow; bold tabular price</tspan>
        <tspan data-lang-vi>"Đệm 24px; nhãn trên dịu màu; giá lớn tabular</tspan>
      </text>
      <text x="488" y="114" class="lap-prompt-txt">
        <tspan data-lang-en>with soft $/mo; two-part shadow; one primary CTA."</tspan>
        <tspan data-lang-vi>hạ sắc $/tháng; bóng hai lớp; một nút chính."</tspan>
      </text>

      {/* Down arrow right */}
      <line x1="676" x2="676" y1="140" y2="164" class="lap-arrow is-accent" />
      <polygon points="676,169 671,161 681,161" class="lap-arrow-head is-accent" />

      {/* Crisp output card */}
      <g transform="translate(472, 176)">
        <rect x="0" y="8" width="408" height="206" rx="10" class="lap-shadow-wide" />
        <rect x="0" y="3" width="408" height="206" rx="10" class="lap-shadow-tight" />
        <rect x="0" y="0" width="408" height="206" rx="10" class="lap-crisp-card" />
        <rect x="1" y="1" width="406" height="3.5" rx="2" class="lap-accent-bar" />

        {/* Eyebrow + Title + Price aligned cleanly */}
        <text x="24" y="28" class="lap-crisp-eye">
          <tspan data-lang-en>Recommended · Team</tspan>
          <tspan data-lang-vi>Khuyên dùng · Đội nhóm</tspan>
        </text>
        <text x="24" y="52" class="lap-crisp-title">
          <tspan data-lang-en>Pro Workspace</tspan>
          <tspan data-lang-vi>Không gian Pro</tspan>
        </text>

        {/* Price on right side of header with de-emphasized $ and /mo */}
        <text x="310" y="42" class="lap-crisp-unit">$</text>
        <text x="321" y="52" class="lap-crisp-num">49</text>
        <text x="357" y="52" class="lap-crisp-unit">
          <tspan data-lang-en>/mo</tspan>
          <tspan data-lang-vi>/th</tspan>
        </text>

        {/* Clean feature lines with generous group separation */}
        <text x="24" y="86" class="lap-crisp-body">
          <tspan data-lang-en>Unlimited projects, preview branches, and audit logs.</tspan>
          <tspan data-lang-vi>Không giới hạn dự án, nhánh xem trước và nhật ký.</tspan>
        </text>
        <text x="24" y="110" class="lap-crisp-meta">
          <tspan data-lang-en>Includes SSO, priority support, and custom domains.</tspan>
          <tspan data-lang-vi>Gồm SSO, hỗ trợ ưu tiên và tên miền tùy chỉnh.</tspan>
        </text>

        {/* Subtle divider + de-emphasized secondary link + one clear primary CTA */}
        <line x1="24" x2="384" y1="136" y2="136" class="lap-crisp-sep" />
        <text x="24" y="172" class="lap-crisp-link">
          <tspan data-lang-en>Compare plans</tspan>
          <tspan data-lang-vi>So sánh gói</tspan>
        </text>
        <rect x="256" y="150" width="128" height="34" rx="6" class="lap-crisp-cta" />
        <text x="320" y="172" text-anchor="middle" class="lap-crisp-cta-txt">
          <tspan data-lang-en>Start 14-day trial</tspan>
          <tspan data-lang-vi>Dùng thử 14 ngày</tspan>
        </text>
      </g>

      {/* Right diagnosis note */}
      <text x="472" y="408" class="lap-diag is-accent">
        <tspan data-lang-en>Result: clear 3-tier hierarchy, breathing room, and one unmistakable action.</tspan>
        <tspan data-lang-vi>Kết quả: phân cấp 3 tầng rõ ràng, khoảng thở thoáng và đúng một nút chính.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>AI models mirror the specificity of your eye. Naming hierarchy tiers, padding rhythm, and shadow depth turns generic defaults into production-grade UI.</span>
    <span data-lang-vi>Mô hình AI phản chiếu đúng độ tinh của mắt bạn. Chỉ rõ tầng phân cấp, nhịp khoảng đệm và độ sâu bóng biến bản vẽ mặc định thành UI đạt chuẩn sản phẩm.</span>
  </figcaption>
</figure>

<style>
  .lap { margin: 2em 0; width: 100%; }
  .lap-scroll { overflow-x: auto; }
  .lap svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .lap text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .lap text.lap-col-h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .lap text.lap-col-h.is-accent { fill: var(--red); }
  .lap-rule { stroke: var(--border); stroke-width: 1.5; }
  .lap-rule.is-accent { stroke: var(--red); }
  .lap-prompt-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.25; }
  .lap-prompt-box.is-accent { fill: var(--red-tint-bg); stroke: var(--red); }
  .lap text.lap-prompt-lbl { font-size: 12px; font-weight: 700; fill: var(--text-muted); }
  .lap text.lap-prompt-lbl.is-accent { fill: var(--red); }
  .lap text.lap-prompt-txt { font-size: 13.5px; font-weight: 500; fill: var(--text); }
  .lap-arrow { stroke: var(--text-muted); stroke-width: 1.5; }
  .lap-arrow.is-accent { stroke: var(--red); }
  .lap-arrow-head { fill: var(--text-muted); }
  .lap-arrow-head.is-accent { fill: var(--red); }

  /* Left generic card */
  .lap-generic-card { fill: var(--bg); stroke: var(--text-muted); stroke-width: 2; }
  .lap text.lap-gen-title { font-size: 15px; font-weight: 700; fill: var(--text); }
  .lap text.lap-gen-price { font-size: 15px; font-weight: 700; fill: var(--text); }
  .lap-gen-hr { stroke: var(--text-muted); stroke-width: 1; opacity: 0.5; }
  .lap text.lap-gen-body { font-size: 13px; fill: var(--text); }
  .lap-gen-btn { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; }
  .lap text.lap-gen-btn-txt { font-size: 13px; font-weight: 700; fill: var(--text); }

  /* Right crisp card */
  .lap-shadow-wide { fill: var(--text); opacity: 0.05; }
  .lap-shadow-tight { fill: var(--text); opacity: 0.07; }
  .lap-crisp-card { fill: var(--bg); stroke: var(--border); stroke-width: 1.25; }
  .lap-accent-bar { fill: var(--red); }
  .lap text.lap-crisp-eye { font-size: 11.5px; font-weight: 600; fill: var(--red); }
  .lap text.lap-crisp-title { font-size: 19px; font-weight: 700; fill: var(--text); }
  .lap text.lap-crisp-num { font-size: 28px; font-weight: 700; fill: var(--text); }
  .lap text.lap-crisp-unit { font-size: 12.5px; font-weight: 500; fill: var(--text-muted); }
  .lap text.lap-crisp-body { font-size: 13.5px; fill: var(--text-body); }
  .lap text.lap-crisp-meta { font-size: 12.5px; fill: var(--text-muted); }
  .lap-crisp-sep { stroke: var(--border); stroke-width: 1; }
  .lap text.lap-crisp-link { font-size: 13px; font-weight: 600; fill: var(--text-muted); }
  .lap-crisp-cta { fill: var(--red); }
  .lap text.lap-crisp-cta-txt { font-size: 13px; font-weight: 600; fill: #ffffff; }

  .lap text.lap-diag { font-size: 12px; fill: var(--text-muted); }
  .lap text.lap-diag.is-accent { fill: var(--red); font-weight: 600; }
  .lap figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
