---
// Demo wrapper: the React island plus a no-JS table with the same six headlines and scores.
import DemoFrame from './DemoFrame.astro';
import AtP17SentimentDemo, { HEADLINES, MODES, scoreText } from '../demos/AtP17SentimentDemo.tsx';
const rows = HEADLINES.map((h) => ({ h, s: MODES.map((m) => scoreText(h.en, m.id).score) }));
const sign = (n: number) => (n > 0 ? `+${n}` : String(n));
---
<figure class="p17-demo">
  <DemoFrame title="Score a headline three ways" titleVi="Chấm điểm một tiêu đề theo ba cách">
    <AtP17SentimentDemo client:visible />
    <noscript>
      <table class="p17-table">
        <thead>
          <tr>
            <th><span data-lang-en>Headline</span><span data-lang-vi>Tiêu đề</span></th>
            {MODES.map((m) => <th><span data-lang-en>{m.en}</span><span data-lang-vi>{m.vi}</span></th>)}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td>{r.h.en}<br /><small data-lang-vi>{r.h.vi}</small></td>
              {r.s.map((v) => <td>{sign(v)}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </noscript>
  </DemoFrame>
  <figcaption>
    <span data-lang-en>Say a news feed shows these six headlines. The word lists are small toy lists written for this post. Headline 1 is the Harvard-list trap, headline 3 needs negation, headline 5 trips on "mine" and "foreign".</span>
    <span data-lang-vi>Giả sử một bảng tin hiện sáu tiêu đề này. Các bộ từ là danh sách nhỏ viết riêng cho bài. Tiêu đề 1 là cái bẫy của bộ từ Harvard, tiêu đề 3 cần xử lý phủ định, tiêu đề 5 vấp ở chữ "mine" và "foreign".</span>
  </figcaption>
</figure>

<style is:global>
  .p17-demo { margin: 2em 0; width: 100%; }
  .p17-demo > .demo-frame { margin-bottom: 0; }
  .p17-demo > figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  .p17d-picks { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
  .p17d-btn { min-width: 34px; padding: 4px 10px; border: 1px solid var(--border); border-radius: 999px; background: var(--card-bg); color: var(--text-body); font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; }
  .p17d-btn.is-on { background: var(--btn-primary-bg); border-color: var(--btn-primary-bg); color: var(--bg); }
  .p17d-label { display: block; font-size: 13px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; }
  .p17d-in { width: 100%; box-sizing: border-box; padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--text); font: inherit; font-size: 14px; }
  .p17d-gloss { margin: 6px 0 0; font-size: 13px; color: var(--text-muted); }
  .p17d-rows { display: grid; gap: 8px; margin-top: 12px; }
  .p17d-row { border: 1px solid var(--border); border-radius: 8px; background: var(--bg); padding: 8px 10px; }
  .p17d-rowhead { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin-bottom: 6px; }
  .p17d-mode { font-size: 13px; font-weight: 700; color: var(--text); }
  .p17d-score { font-size: 18px; font-variant-numeric: tabular-nums; }
  .p17d-score.is-pos { color: var(--gold-icon); }
  .p17d-score.is-neg { color: var(--red); }
  .p17d-score.is-zero { color: var(--text-muted); }
  .p17d-toks { display: flex; flex-wrap: wrap; gap: 4px; }
  .p17d-tok { padding: 1px 7px; border-radius: 6px; border: 1px solid transparent; font-size: 13px; color: var(--text-body); }
  .p17d-tok.is-pos { background: var(--gold-tint-bg); border-color: var(--gold-icon); color: var(--text); }
  .p17d-tok.is-neg { background: var(--red-tint-bg); border-color: var(--red); color: var(--text); }
  .p17d-tok.is-flip { border-style: dashed; }
  .p17d-note { margin: 10px 0 0; font-size: 12.5px; color: var(--text-muted); line-height: 1.5; }
  .p17-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .p17-table th, .p17-table td { border: 1px solid var(--border); padding: 5px 8px; text-align: left; vertical-align: top; }
</style>
