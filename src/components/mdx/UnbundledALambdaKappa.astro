---
// Lambda (two pipelines) next to unified / Kappa (one pipeline, replay the log).
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 372;
const heads = (x2: number, y: number) => `${x2 - 4},${y - 7} ${x2 + 4},${y - 7} ${x2},${y}`;
---
<figure class="ua-fig">
  <div class="ua-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Lambda architecture: a raw store feeds a batch engine and a separate stream engine, merged at read time, so two codebases. Unified or Kappa: a replayable log feeds one stream job and one serving view, so one codebase.">
      <rect x="20" y="12" width="420" height="348" rx="6" class="ua-panel" />
      <rect x="460" y="12" width="420" height="348" rx="6" class="ua-panel" />
      <text x="40" y="40" class="ua-ph"><tspan data-lang-en>Lambda: two pipelines</tspan><tspan data-lang-vi>Lambda: hai đường ống</tspan></text>
      <text x="480" y="40" class="ua-ph"><tspan data-lang-en>Unified (Kappa): one pipeline</tspan><tspan data-lang-vi>Hợp nhất (Kappa): một đường ống</tspan></text>

      <rect x="125" y="58" width="210" height="46" rx="4" class="ua-box" />
      <DiagramIcon name="file" x={153} y={81} size={26} />
      <text x="178" y="86" class="ua-b"><tspan data-lang-en>Raw event store</tspan><tspan data-lang-vi>Kho sự kiện thô</tspan></text>
      <path d="M230,104 L230,124 L130,124 L130,144 M230,124 L330,124 L330,144" class="ua-solid" />
      <polygon points={heads(130, 151)} class="ua-head" />
      <polygon points={heads(330, 151)} class="ua-head" />
      <rect x="35" y="152" width="190" height="64" rx="4" class="ua-box" />
      <DiagramIcon name="hadoop" x={66} y={184} size={30} />
      <text x="96" y="180" class="ua-b"><tspan data-lang-en>Batch engine</tspan><tspan data-lang-vi>Engine batch</tspan></text>
      <text x="96" y="198" class="ua-m"><tspan data-lang-en>e.g. Hadoop, slow</tspan><tspan data-lang-vi>vd Hadoop, chậm</tspan></text>
      <rect x="235" y="152" width="190" height="64" rx="4" class="ua-box" />
      <DiagramIcon name="worker" x={266} y={184} size={30} />
      <text x="296" y="180" class="ua-b"><tspan data-lang-en>Stream engine</tspan><tspan data-lang-vi>Engine stream</tspan></text>
      <text x="296" y="198" class="ua-m"><tspan data-lang-en>e.g. Storm, fast</tspan><tspan data-lang-vi>vd Storm, nhanh</tspan></text>
      <path d="M130,216 L130,240 L230,240 L230,254 M330,216 L330,240 L230,240" class="ua-solid" />
      <polygon points={heads(230, 261)} class="ua-head" />
      <rect x="110" y="262" width="240" height="46" rx="4" class="ua-box" />
      <DiagramIcon name="db" x={140} y={285} size={26} />
      <text x="166" y="290" class="ua-b"><tspan data-lang-en>View merged at read</tspan><tspan data-lang-vi>View trộn khi đọc</tspan></text>
      <text x="230" y="336" text-anchor="middle" class="ua-n is-hot"><tspan data-lang-en>Same logic written twice: it drifts</tspan><tspan data-lang-vi>Cùng logic viết hai lần: dễ lệch</tspan></text>

      <rect x="565" y="58" width="210" height="46" rx="4" class="ua-box" />
      <DiagramIcon name="log" x={593} y={81} size={26} />
      <text x="618" y="86" class="ua-b"><tspan data-lang-en>Replayable log</tspan><tspan data-lang-vi>Log phát lại được</tspan></text>
      <path d="M670,104 L670,145" class="ua-solid is-good" />
      <polygon points={heads(670, 152)} class="ua-head is-good" />
      <rect x="535" y="152" width="270" height="64" rx="4" class="ua-box is-good" />
      <DiagramIcon name="worker" x={567} y={184} size={30} />
      <text x="597" y="180" class="ua-b"><tspan data-lang-en>One stream job</tspan><tspan data-lang-vi>Một job stream</tspan></text>
      <text x="597" y="198" class="ua-m"><tspan data-lang-en>live and replay, same code</tspan><tspan data-lang-vi>chạy thật + phát lại, cùng code</tspan></text>
      <path d="M670,216 L670,255" class="ua-solid is-good" />
      <polygon points={heads(670, 262)} class="ua-head is-good" />
      <rect x="570" y="262" width="200" height="46" rx="4" class="ua-box" />
      <DiagramIcon name="db" x={600} y={285} size={26} />
      <text x="626" y="290" class="ua-b"><tspan data-lang-en>Serving view</tspan><tspan data-lang-vi>View phục vụ</tspan></text>
      <text x="670" y="336" text-anchor="middle" class="ua-n is-good"><tspan data-lang-en>Backfill = replay from offset 0</tspan><tspan data-lang-vi>Backfill = phát lại từ offset 0</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Count the boxes that hold business logic: two on the left, one on the right.</span>
    <span data-lang-vi>Đếm số khối chứa logic nghiệp vụ: bên trái có hai, bên phải chỉ một.</span>
  </figcaption>
</figure>

<style>
  .ua-fig { margin: 2em 0; width: 100%; }
  .ua-scroll { overflow-x: auto; }
  .ua-fig svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .ua-fig text { font-size: 13px; fill: var(--text-body); }
  .ua-fig .ua-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-ph { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-b { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-m { font-size: 12.5px; fill: var(--text-muted); }
  .ua-fig .ua-n { font-size: 12.5px; font-weight: 700; fill: var(--text-muted); }
  .ua-fig .ua-n.is-hot, .ua-fig .ua-b.is-hot, .ua-fig .ua-m.is-hot { fill: var(--red); }
  .ua-fig .ua-n.is-good, .ua-fig .ua-b.is-good, .ua-fig .ua-m.is-good { fill: var(--gold-icon); }
  .ua-fig .ua-q { font-size: 20px; font-weight: 700; fill: var(--red); }
  .ua-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .ua-box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .ua-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .ua-panel { fill: none; stroke: var(--border); stroke-width: 1.2; }
  .ua-life { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .ua-solid { fill: none; stroke: var(--text-muted); stroke-width: 1.8; }
  .ua-dashed { fill: none; stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .ua-head { fill: var(--text-muted); }
  .ua-solid.is-hot, .ua-dashed.is-hot { stroke: var(--red); stroke-width: 1.9; }
  .ua-head.is-hot { fill: var(--red); }
  .ua-solid.is-good { stroke: var(--gold-icon); stroke-width: 2; }
  .ua-head.is-good { fill: var(--gold-icon); }
  .ua-fig figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
