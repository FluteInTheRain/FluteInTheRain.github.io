---
import DiagramIcon from './DiagramIcon.astro';
import NfrText from './NfrText.astro';
import NfrArrow from './NfrArrow.astro';
import NfrStep from './NfrStep.astro';
import './nfr-fig.css';
// A risky change meets four defences in order; chaos tests sit alongside. No numbers beyond the post's 1% -> 10% -> 100%.
const W = 900;
const H = 280;
const boxes = [
  { x: 20, icon: 'laptop', en: ['Sandbox'], vi: ['Sandbox'], s: ['Try it where mistakes', 'touch no users'], sv: ['Thử ở nơi sai sót', 'không chạm tới người dùng'] },
  { x: 240, icon: 'users', en: ['Canary rollout'], vi: ['Canary rollout'], s: ['1% to 10% to 100%', 'of users'], sv: ['1% rồi 10% rồi 100%', 'người dùng'] },
  { x: 460, icon: 'chart', en: ['Monitors'], vi: ['Giám sát'], s: ['Watch the error rate', 'during the rollout'], sv: ['Theo dõi tỉ lệ lỗi', 'trong lúc phát hành'] },
] as const;
const L = (v: readonly string[]) => v as unknown as string[];
---
<figure class="nf">
  <div class="nf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Defences against human error: a change goes to a sandbox, then a canary rollout to a growing share of users, watched by monitors. If the error rate rises, an automatic rollback returns everyone to the old version. Chaos engineering kills random instances in business hours to prove recovery.">
      {boxes.map((b, i) => (
        <g>
          <rect x={b.x} y="34" width="180" height="96" rx="8" class="box" />
          <DiagramIcon name={b.icon} x={b.x + 28} y={62} size={28} />
          <NfrText x={b.x + 54} y={67} cls="n" en={L(b.en)} vi={L(b.vi)} />
          <NfrText x={b.x + 16} y={98} lh={16} cls="s" en={L(b.s)} vi={L(b.sv)} />
          {i < 2 && <NfrArrow x1={b.x + 182} y1={82} x2={b.x + 218} y2={82} />}
        </g>
      ))}
      <NfrText x={20} y={22} cls="h" en="A risky change, step by step" vi="Một thay đổi rủi ro, từng bước" />
      <NfrArrow x1={642} y1={82} x2={698} y2={82} tone="gold" />
      <rect x="702" y="34" width="178" height="96" rx="8" class="box is-gold" />
      <DiagramIcon name="ok" x={730} y={62} size={28} />
      <NfrText x={756} y={67} cls="n" en="Everyone" vi="Mọi người" />
      <NfrText x={718} y={98} lh={16} cls="s" en={['Only if the error', 'rate stays low']} vi={['Chỉ khi tỉ lệ lỗi', 'vẫn thấp']} />

      <NfrArrow x1={550} y1={132} x2={550} y2={176} tone="red" />
      <NfrText x={562} y={158} cls="is-red" en="error rate too high" vi="tỉ lệ lỗi quá cao" />
      <rect x="460" y="180" width="180" height="76" rx="8" class="box is-gold" />
      <DiagramIcon name="retry" x={488} y={208} size={28} />
      <NfrText x={514} y={213} cls="n" en="Rollback" vi="Rollback" />
      <NfrText x={476} y={240} cls="s" en="Back to the old version" vi="Quay về bản cũ" />
      <NfrArrow x1={460} y1={218} x2={340} y2={134} tone="gold" />

      <rect x="702" y="180" width="178" height="76" rx="8" class="box is-dash" />
      <DiagramIcon name="server" x={730} y={206} size={26} />
      <NfrText x={756} y={211} cls="n" en="Chaos tests" vi="Chaos test" />
      <NfrText x={718} y={236} lh={14} cls="s" en={['Kill random instances', 'in business hours']} vi={['Tắt ngẫu nhiên instance', 'trong giờ làm việc']} />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Each defence catches a mistake at a different point, before it reaches most users.</span>
    <span data-lang-vi>Mỗi lớp phòng thủ bắt sai sót ở một điểm khác nhau, trước khi nó tới đa số người dùng.</span>
  </figcaption>
</figure>
