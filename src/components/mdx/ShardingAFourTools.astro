---
// Four ways to cool a hot key, one card each: icon, tiny before/after picture, plain description.
// Inline SVG, site tokens.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const A = (x1: number, y1: number, x2: number, y2: number, c = '') => {
  const a = arrow(x1, y1, x2, y2);
  return { ...a, c };
};

const W = 900;
const H = 240;
const xs = [20, 245, 470, 695];
---
<figure class="shaa-ft">
  <div class="shaa-ft-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four tools for cooling a hot key. One: a dedicated shard, where the hot key gets its own machine. Two: key salting, where a random suffix spreads one key into many. Three: request coalescing, where many identical reads become one query. Four: cloud heat management, where the service splits hot ranges on its own.">
      {xs.map((x) => (<rect x={x} y="15" width="185" height="215" rx="6" class="box" />))}

      {/* 1 dedicated shard */}
      <DiagramIcon name="server" x={112} y={48} size={28} />
      <text x="112" y="90" text-anchor="middle" class="b"><tspan data-lang-en>Dedicated shard</tspan><tspan data-lang-vi>Shard riêng</tspan></text>
      <rect x="34" y="106" width="60" height="28" rx="4" class="box is-hot" />
      <text x="64" y="124" text-anchor="middle" class="s is-hot"><tspan data-lang-en>hot key</tspan><tspan data-lang-vi>hot key</tspan></text>
      <path d={A(98, 120, 122, 120).line} class="arrow" /><polygon points={A(98, 120, 122, 120).head} class="head" />
      <rect x="126" y="106" width="64" height="28" rx="4" class="box is-fix" />
      <text x="158" y="124" text-anchor="middle" class="s"><tspan data-lang-en>own host</tspan><tspan data-lang-vi>máy riêng</tspan></text>
      <text x="112" y="166" text-anchor="middle" class="s"><tspan data-lang-en>Isolate the hot key on its</tspan><tspan data-lang-vi>Tách hot key ra một máy</tspan></text>
      <text x="112" y="184" text-anchor="middle" class="s"><tspan data-lang-en>own machine so neighbours</tspan><tspan data-lang-vi>riêng để các khoá khác</tspan></text>
      <text x="112" y="202" text-anchor="middle" class="s"><tspan data-lang-en>do not starve.</tspan><tspan data-lang-vi>không bị vạ lây.</tspan></text>

      {/* 2 salting */}
      <DiagramIcon name="key" x={337} y={48} size={28} />
      <text x="337" y="90" text-anchor="middle" class="b"><tspan data-lang-en>Key salting</tspan><tspan data-lang-vi>Thêm muối vào khoá</tspan></text>
      {['#00', '#01', '...', '#99'].map((t, i) => (
        <g>
          <rect x={259 + i * 41} y="106" width="35" height="28" rx="4" class={t === '...' ? 'box' : 'box is-fix'} />
          <text x={276.5 + i * 41} y="124" text-anchor="middle" class="s">{t}</text>
        </g>
      ))}
      <text x="337" y="166" text-anchor="middle" class="s"><tspan data-lang-en>Add a random suffix before</tspan><tspan data-lang-vi>Gắn hậu tố ngẫu nhiên trước</tspan></text>
      <text x="337" y="184" text-anchor="middle" class="s"><tspan data-lang-en>hashing: writes spread</tspan><tspan data-lang-vi>khi băm: lệnh ghi rải ra</tspan></text>
      <text x="337" y="202" text-anchor="middle" class="s"><tspan data-lang-en>100 ways.</tspan><tspan data-lang-vi>100 hướng.</tspan></text>

      {/* 3 coalescing */}
      <DiagramIcon name="worker" x={562} y={48} size={28} />
      <text x="562" y="90" text-anchor="middle" class="b"><tspan data-lang-en>Request coalescing</tspan><tspan data-lang-vi>Gộp request</tspan></text>
      <rect x="484" y="106" width="60" height="28" rx="4" class="box is-hot" />
      <text x="514" y="124" text-anchor="middle" class="s is-hot"><tspan data-lang-en>many reads</tspan><tspan data-lang-vi>nhiều đọc</tspan></text>
      <path d={A(548, 120, 572, 120).line} class="arrow" /><polygon points={A(548, 120, 572, 120).head} class="head" />
      <rect x="576" y="106" width="64" height="28" rx="4" class="box is-fix" />
      <text x="608" y="124" text-anchor="middle" class="s"><tspan data-lang-en>1 query</tspan><tspan data-lang-vi>1 truy vấn</tspan></text>
      <text x="562" y="166" text-anchor="middle" class="s"><tspan data-lang-en>Merge identical reads into</tspan><tspan data-lang-vi>Gộp các lệnh đọc giống nhau</tspan></text>
      <text x="562" y="184" text-anchor="middle" class="s"><tspan data-lang-en>one query and share the</tspan><tspan data-lang-vi>thành một truy vấn, dùng</tspan></text>
      <text x="562" y="202" text-anchor="middle" class="s"><tspan data-lang-en>answer.</tspan><tspan data-lang-vi>chung kết quả.</tspan></text>

      {/* 4 cloud heat management */}
      <DiagramIcon name="cloud" x={787} y={48} size={28} />
      <text x="787" y="90" text-anchor="middle" class="b"><tspan data-lang-en>Cloud heat management</tspan><tspan data-lang-vi>Cloud tự điều tiết</tspan></text>
      <rect x="709" y="106" width="60" height="28" rx="4" class="box is-hot" />
      <text x="739" y="124" text-anchor="middle" class="s is-hot"><tspan data-lang-en>hot range</tspan><tspan data-lang-vi>dải nóng</tspan></text>
      <path d={A(773, 120, 797, 120).line} class="arrow" /><polygon points={A(773, 120, 797, 120).head} class="head" />
      <rect x="801" y="106" width="34" height="28" rx="4" class="box is-fix" />
      <rect x="839" y="106" width="34" height="28" rx="4" class="box is-fix" />
      <text x="787" y="166" text-anchor="middle" class="s"><tspan data-lang-en>DynamoDB and S3 split hot</tspan><tspan data-lang-vi>DynamoDB và S3 tự tách</tspan></text>
      <text x="787" y="184" text-anchor="middle" class="s"><tspan data-lang-en>ranges or lend burst</tspan><tspan data-lang-vi>dải nóng hoặc cấp thêm</tspan></text>
      <text x="787" y="202" text-anchor="middle" class="s"><tspan data-lang-en>capacity on their own.</tspan><tspan data-lang-vi>băng thông bùng nổ.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Red is the hot key or hot read crowd, gold is where it ends up. Salting and dedicated shards help writes; coalescing helps read bursts.</span>
    <span data-lang-vi>Màu đỏ là hot key hoặc đám đông đọc, màu vàng là nơi nó được dồn tới. Thêm muối và shard riêng giúp phần ghi; gộp request giúp các đợt bùng nổ đọc.</span>
  </figcaption>
</figure>

<style>
  .shaa-ft { margin: 2em 0; width: 100%; }
  .shaa-ft-scroll { overflow-x: auto; }
  .shaa-ft svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shaa-ft text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shaa-ft .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shaa-ft .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shaa-ft .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shaa-ft .b.is-hot { fill: var(--red); }
  .shaa-ft .s { font-size: 12px; fill: var(--text-body); }
  .shaa-ft .s.is-hot { fill: var(--red); font-weight: 600; }
  .shaa-ft .big { font-size: 18px; font-weight: 700; fill: var(--text); }
  .shaa-ft .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shaa-ft .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shaa-ft .box.is-fix { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-ft .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shaa-ft .box.is-dim { opacity: 0.45; }
  .shaa-ft .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shaa-ft .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shaa-ft .arrow.is-hot { stroke: var(--red); }
  .shaa-ft .arrow.is-fix { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-ft .head { fill: var(--text-muted); }
  .shaa-ft .head.is-hot { fill: var(--red); }
  .shaa-ft .head.is-fix { fill: var(--gold-icon); }
  .shaa-ft figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
