---
// One order's journey from the app to settled shares, on a T / T+1 / T+2 timeline.
// Real Vietnamese process: broker routing, HOSE matching, VSDC clearing,
// settlement completing before 13:00 on T+2. Static SVG, site CSS tokens only,
// plain-polygon arrowheads (no <marker> ids: the figure renders twice on the page).
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 440;

const NODES = [
  { x: 90, icon: 'user', en: 'You', vi: 'Bạn', subEn: 'investor', subVi: 'nhà đầu tư' },
  { x: 268, icon: 'phone', en: 'Broker', vi: 'CTCK', subEn: 'the app + funds check', subVi: 'app + kiểm tra tiền' },
  { x: 446, icon: 'server', en: 'Exchange (HOSE)', vi: 'Sàn (HOSE)', subEn: 'matching engine', subVi: 'bộ máy khớp lệnh' },
  { x: 624, icon: 'db', en: 'VSDC', vi: 'VSDC', subEn: 'clearing', subVi: 'bù trừ' },
  { x: 802, icon: 'bank', en: 'Bank', vi: 'Ngân hàng', subEn: 'moves the money', subVi: 'chuyển tiền' },
] as const;

const ARROWS = [
  { x1: 124, x2: 234, en: 'your order', vi: 'lệnh của bạn' },
  { x1: 302, x2: 412, en: 'routed', vi: 'đưa lên sàn' },
  { x1: 480, x2: 590, en: 'matches', vi: 'kết quả khớp' },
  { x1: 658, x2: 768, en: 'money + shares', vi: 'tiền + cổ phiếu' },
] as const;

const STOPS = [
  {
    x: 90,
    dayEn: 'Day T',
    dayVi: 'Ngày T',
    en: ['order placed, matched', 'cash blocked'],
    vi: ['đặt lệnh, khớp lệnh', 'tiền bị phong tỏa'],
  },
  {
    x: 446,
    dayEn: 'T+1',
    dayVi: 'T+1',
    en: ['brokers confirm the money', 'VSDC readies the swap'],
    vi: ['CTCK xác nhận đủ tiền', 'VSDC chuẩn bị chuyển'],
  },
  {
    x: 802,
    dayEn: 'T+2, by 13:00',
    dayVi: 'T+2, trước 13h',
    en: ['shares and money move', 'sellable that afternoon'],
    vi: ['chuyển cổ phiếu + tiền', 'chiều T+2 bán lại được'],
  },
] as const;

const nodeY = 108;
const tlY = 330;
---
<figure class="atm-journey">
  <div class="atm-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="An order travels from the investor to the broker, to the HOSE matching engine, to VSDC for clearing, and to the bank for settlement on the second working day after the trade (T+2).">
      <text x="20" y="30" class="atm-j-title">
        <tspan data-lang-en>From the tap to settled shares</tspan>
        <tspan data-lang-vi>Từ lúc bấm lệnh tới lúc nhận cổ phiếu</tspan>
      </text>

      {/* node chain */}
      {NODES.map((n) => (
        <g>
          <DiagramIcon name={n.icon} x={n.x} y={nodeY} size={34} />
          <text x={n.x} y={nodeY + 44} text-anchor="middle" class="atm-j-node">
            <tspan data-lang-en>{n.en}</tspan>
            <tspan data-lang-vi>{n.vi}</tspan>
          </text>
          <text x={n.x} y={nodeY + 62} text-anchor="middle" class="atm-j-sub">
            <tspan data-lang-en>{n.subEn}</tspan>
            <tspan data-lang-vi>{n.subVi}</tspan>
          </text>
        </g>
      ))}

      {/* arrows between nodes, polygon heads, no ids */}
      {ARROWS.map((a) => (
        <g>
          <line x1={a.x1} y1={nodeY} x2={a.x2 - 9} y2={nodeY} class="atm-j-arrow" />
          <polygon points={`${a.x2},${nodeY - 5} ${a.x2},${nodeY + 5} ${a.x2 - 9},${nodeY}`} class="atm-j-head" />
          <text x={(a.x1 + a.x2) / 2} y={nodeY - 22} text-anchor="middle" class="atm-j-sub">
            <tspan data-lang-en>{a.en}</tspan>
            <tspan data-lang-vi>{a.vi}</tspan>
          </text>
        </g>
      ))}

      {/* timeline */}
      <line x1="60" y1={tlY} x2="840" y2={tlY} class="atm-j-tl" />
      {STOPS.map((s) => (
        <g>
          <circle cx={s.x} cy={tlY} r="5" class="atm-j-stop" />
          <text x={s.x} y={tlY - 16} text-anchor="middle" class="atm-j-day">
            <tspan data-lang-en>{s.dayEn}</tspan>
            <tspan data-lang-vi>{s.dayVi}</tspan>
          </text>
          <text x={s.x} y={tlY + 24} text-anchor="middle" class="atm-j-sub">
            <tspan data-lang-en>{s.en[0]}</tspan>
            <tspan data-lang-vi>{s.vi[0]}</tspan>
          </text>
          <text x={s.x} y={tlY + 42} text-anchor="middle" class="atm-j-sub">
            <tspan data-lang-en>{s.en[1]}</tspan>
            <tspan data-lang-vi>{s.vi[1]}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>One order, end to end. The broker blocks your cash and routes the order to HOSE, whose matching engine pairs it with a sell. VSDC nets up the day's trades after the close, and the money-and-shares swap completes before 13:00 on the second working day (T+2), when the shares can be sold again that afternoon. Since 29 Aug 2022 Vietnam settles in T+2 instead of T+3. Sources: <a href="https://www.ssi.com.vn/khach-hang-ca-nhan/quy-dinh-giao-dich/quy-dinh-giao-dich-co-phieu" rel="noopener" target="_blank">SSI trading rules</a>; <a href="https://tapchinganhang.gov.vn/chu-ky-thanh-toan-chung-khoan-chinh-thuc-rut-ngan-xuong-t2-10193.html" rel="noopener" target="_blank">VSD via Tạp chí Ngân hàng</a>.</span>
    <span data-lang-vi>Một lệnh đi hết vòng. CTCK phong tỏa tiền của bạn và đưa lệnh lên HOSE, bộ máy khớp lệnh ghép nó với một lệnh bán. Sau phiên, VSDC bù trừ toàn bộ giao dịch trong ngày, và việc chuyển tiền đổi cổ phiếu hoàn tất trước 13h ngày làm việc thứ hai (T+2), chiều đó cổ phiếu đã bán lại được. Từ 29/8/2022, Việt Nam thanh toán theo T+2 thay vì T+3. Nguồn: <a href="https://www.ssi.com.vn/khach-hang-ca-nhan/quy-dinh-giao-dich/quy-dinh-giao-dich-co-phieu" rel="noopener" target="_blank">quy định giao dịch của SSI</a>; <a href="https://tapchinganhang.gov.vn/chu-ky-thanh-toan-chung-khoan-chinh-thuc-rut-ngan-xuong-t2-10193.html" rel="noopener" target="_blank">VSD, đăng trên Tạp chí Ngân hàng</a>.</span>
  </figcaption>
</figure>

<style>
  .atm-journey {
    margin: 2em 0;
    width: 100%;
  }
  .atm-scroll {
    overflow-x: auto;
  }
  .atm-journey svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .atm-journey text {
    font-size: 14px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .atm-j-title {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .atm-j-node {
    font-weight: 700;
    fill: var(--text);
  }
  .atm-j-sub {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .atm-j-arrow {
    stroke: var(--text-muted);
    stroke-width: 1.4;
  }
  .atm-j-head {
    fill: var(--text-muted);
  }
  .atm-j-tl {
    stroke: var(--border);
    stroke-width: 2;
  }
  .atm-j-stop {
    fill: var(--red);
  }
  .atm-j-day {
    font-size: 15px;
    font-weight: 700;
    fill: var(--red);
  }
  .atm-journey figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
