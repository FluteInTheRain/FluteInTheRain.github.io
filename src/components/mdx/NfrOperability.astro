---
import DiagramIcon from './DiagramIcon.astro';
import NfrText from './NfrText.astro';
import NfrArrow from './NfrArrow.astro';
import NfrStep from './NfrStep.astro';
import './nfr-fig.css';
// What an operable system reports about itself: the three kinds of telemetry named in the post.
const W = 900;
const H = 250;
const rows = [
  { y: 20, icon: 'chart', en: 'Metrics', vi: 'Metrics', s: 'Numbers over time', sv: 'Các con số theo thời gian' },
  { y: 92, icon: 'log', en: 'Logs', vi: 'Logs', s: 'Text records of events', sv: 'Dòng ghi lại sự kiện' },
  { y: 164, icon: 'network', en: 'Traces', vi: 'Traces', s: 'The path of one request across services', sv: 'Đường đi của một request qua các service' },
] as const;
---
<figure class="nf">
  <div class="nf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A system reports metrics, logs and traces about itself, so the operator can watch its health, deploy safely and restore service quickly.">
      <DiagramIcon name="server" x={50} y={125} size={34} />
      <NfrText x={50} y={166} anchor="middle" cls="n" en="The system" vi="Hệ thống" />
      {rows.map((r) => (
        <g>
          <NfrArrow x1={84} y1={125} x2={236} y2={r.y + 33} />
          <rect x="240" y={r.y} width="340" height="66" rx="8" class="box" />
          <DiagramIcon name={r.icon} x={274} y={r.y + 33} size={28} />
          <NfrText x={306} y={r.y + 29} cls="n" en={r.en} vi={r.vi} />
          <NfrText x={306} y={r.y + 49} cls="s" en={r.s} vi={r.sv} />
          <NfrArrow x1={580} y1={r.y + 33} x2={664} y2={125 + (r.y + 33 - 125) * 0.25} />
        </g>
      ))}
      <DiagramIcon name="desktop" x={700} y={125} size={34} />
      <NfrText x={700} y={178} anchor="middle" cls="n" en="Operator" vi="Người vận hành" />
      <NfrText x={700} y={198} anchor="middle" lh={16} cls="s" en={['watch health,', 'deploy safely,', 'restore fast']} vi={['theo dõi sức khỏe,', 'triển khai an toàn,', 'khôi phục nhanh']} />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>An operable system tells you what it is doing, so people do not have to guess during an incident.</span>
    <span data-lang-vi>Hệ thống dễ vận hành tự cho bạn biết nó đang làm gì, để lúc có sự cố không ai phải đoán mò.</span>
  </figcaption>
</figure>
