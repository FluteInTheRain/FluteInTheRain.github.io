---
import DiagramIcon from './DiagramIcon.astro';
// The five optimization design levels, with one example change for GET /todos at each level.
const W = 940;
const H = 392;
const icons = ['server', 'tree', 'code', 'terminal', 'cpu'] as const;
const levels = [
  { n: '1', en: ['System'], vi: ['Hệ thống'],
    exEn: ['Return 50 todos per request,', 'not the whole list'], exVi: ['Mỗi request trả 50 todo,', 'không trả cả danh sách'],
    ownEn: ['Your team'], ownVi: ['Nhóm của bạn'] },
  { n: '2', en: ['Algorithm and data structure'], vi: ['Thuật toán và cấu trúc dữ liệu'],
    exEn: ['Index todos by user, so a list', 'reads only that user’s items'], exVi: ['Đánh chỉ mục todo theo user, để', 'chỉ đọc todo của user đó'],
    ownEn: ['Your team'], ownVi: ['Nhóm của bạn'] },
  { n: '3', en: ['Code'], vi: ['Code'],
    exEn: ['Write the JSON response', 'with fewer allocations'], exVi: ['Ghi JSON trả về', 'với ít lần cấp phát hơn'],
    ownEn: ['You'], ownVi: ['Bạn'] },
  { n: '4', en: ['Operating system'], vi: ['Hệ điều hành'],
    exEn: ['Set the container memory', 'and CPU limits'], exVi: ['Đặt giới hạn bộ nhớ', 'và CPU cho container'],
    ownEn: ['Platform or', 'operations team'], ownVi: ['Đội nền tảng', 'hoặc vận hành'] },
  { n: '5', en: ['Hardware'], vi: ['Phần cứng'],
    exEn: ['Run on a machine with', 'faster memory or more cache'], exVi: ['Chạy trên máy có RAM nhanh hơn', 'hoặc cache lớn hơn'],
    ownEn: ['Mostly fixed by', 'the machine you rent'], ownVi: ['Phần lớn cố định', 'theo máy bạn thuê'] },
];
const rowY = (i: number) => 52 + i * 66;
---
<figure class="gp15c">
  <div class="gp15c-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Five optimization design levels from top to bottom: system, algorithm and data structure, code, operating system, hardware. Each row gives an example change for GET /todos and who usually owns that level. Changes at a higher level can make work at a lower level worth less.">
    <text x="56" y="30" class="m">
      <tspan data-lang-en>Level</tspan>
      <tspan data-lang-vi>Tầng</tspan>
    </text>
    <text x="384" y="30" class="m">
      <tspan data-lang-en>Example change for GET /todos</tspan>
      <tspan data-lang-vi>Ví dụ thay đổi cho GET /todos</tspan>
    </text>
    <text x="756" y="30" class="m">
      <tspan data-lang-en>Usually owned by</tspan>
      <tspan data-lang-vi>Thường do ai quyết</tspan>
    </text>

    <line x1="28" x2="28" y1="46" y2="364" class="ln fm-flow" />
    <polygon points="28,372 22,362 34,362" class="ah" />

    {levels.map((l, i) => (
      <g>
        <rect x="48" y={rowY(i)} width="316" height="56" rx="8" class={i < 3 ? 'goldbox' : 'box'} />
        <rect x="374" y={rowY(i)} width="370" height="56" rx="8" class="box" />
        <rect x="754" y={rowY(i)} width="168" height="56" rx="8" class="box" />
        <DiagramIcon name={icons[i]} x={74} y={rowY(i) + 28} size={26} />
        <text x="96" y={rowY(i) + 34} class="b">
          <tspan data-lang-en>{l.n}  {l.en[0]}</tspan>
          <tspan data-lang-vi>{l.n}  {l.vi[0]}</tspan>
        </text>
        {l.exEn.map((_, k) => (
          <text x="388" y={rowY(i) + 24 + k * 18} class="body">
            <tspan data-lang-en>{l.exEn[k]}</tspan>
            <tspan data-lang-vi>{l.exVi[k]}</tspan>
          </text>
        ))}
        {l.ownEn.map((_, k) => (
          <text x="768" y={l.ownEn.length === 1 ? rowY(i) + 33 : rowY(i) + 24 + k * 18} class="body">
            <tspan data-lang-en>{l.ownEn[k]}</tspan>
            <tspan data-lang-vi>{l.ownVi[k]}</tspan>
          </text>
        ))}
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Gold rows are the levels a Go developer usually controls. The arrow points the way to try them: top first, because a change high up can make work further down worth less.</span>
    <span data-lang-vi>Hàng màu vàng là các tầng lập trình viên Go thường tự quyết được. Mũi tên chỉ thứ tự nên thử: từ trên xuống, vì một thay đổi ở tầng cao có thể làm công sức ở tầng thấp bớt giá trị.</span>
  </figcaption>
</figure>

<style>
  .gp15c { margin: 2em 0; width: 100%; }
  .gp15c-scroll { overflow-x: auto; }
  .gp15c svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .gp15c text { font-size: 14px; fill: var(--text-body); }
  .gp15c .b { font-weight: 700; fill: var(--text); }
  .gp15c .body { font-size: 13.5px; fill: var(--text-body); }
  .gp15c .m { fill: var(--text-muted); font-size: 13px; }
  .gp15c .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .gp15c .goldbox { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.2; }
  .gp15c .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp15c .ah { fill: var(--text-muted); }
  .gp15c figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
