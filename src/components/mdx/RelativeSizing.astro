---
// Chapter 3, "relative sizing doesn't scale": the same article heading on a phone at 2.5em of 14px
// body text (35px) vs a size chosen for the phone (22px); then buttons whose padding is tied to the
// font size vs padding tuned per size. Phones drawn at real pixel size (300px wide).

const W = 900;
const H = 470;
const phones = [
  { x: 20, size: 35, good: false, en: 'Headline = 2.5em = 35px', vi: 'Tiêu đề = 2.5em = 35px', noteEn: 'The heading eats the top half of the screen', noteVi: 'Tiêu đề chiếm nửa trên màn hình' },
  { x: 350, size: 22, good: true, en: 'Headline set to 22px for phones', vi: 'Tiêu đề đặt 22px cho điện thoại', noteEn: 'Still the biggest thing, content visible', noteVi: 'Vẫn to nhất, nội dung vẫn thấy được' },
];
const phoneTop = 30;
const pw = 300;
const ph = 300;

// Buttons: same three font sizes; padding either proportional to the font or tuned.
const fonts = [12, 16, 22];
const prop = fonts.map((f) => ({ f, px: f, py: f * 0.75 }));
const tuned = [
  { f: 12, px: 10, py: 5 },
  { f: 16, px: 16, py: 11 },
  { f: 22, px: 30, py: 18 },
];
const textW = (f: number) => f * 2.3; // rough width of the word "Save"
const btnRowX = 665;
---
<figure class="rls">
  <div class="rls-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two phone screens. On the left the heading is 35 pixels and wraps over four lines before any body text. On the right the heading is 22 pixels, still the largest text, and the body is visible. On the far right, two columns of three buttons: padding tied to font size looks like the same button zoomed; tuned padding makes small buttons compact and large buttons generous.">
      {phones.map((p) => (
        <g>
          <rect x={p.x} y={phoneTop} width={pw} height={ph} rx="22" class="rls-phone" />
          <foreignObject x={p.x + 20} y={phoneTop + 24} width={pw - 40} height={ph - 48}>
            <div class="rls-screen" xmlns="http://www.w3.org/1999/xhtml">
              <p class:list={['rls-head', { 'is-bad': !p.good }]} style={`font-size:${p.size}px`}>
                <span data-lang-en>Spacing is a system, not a pixel count</span>
                <span data-lang-vi>Khoảng cách là hệ thống, không phải đếm pixel</span>
              </p>
              <p class="rls-body">
                <span data-lang-en>A misaligned ballot moved thousands of votes. Most screens are not ballots, but the cause is the same.</span>
                <span data-lang-vi>Một lá phiếu căn lệch làm hàng nghìn phiếu đi nhầm chỗ. Màn hình thường không phải lá phiếu, nhưng nguyên nhân giống nhau.</span>
              </p>
            </div>
          </foreignObject>
          <text x={p.x} y={phoneTop + ph + 28} class:list={['rls-label', { 'is-good': p.good }]}>
            <tspan data-lang-en>{p.en}</tspan>
            <tspan data-lang-vi>{p.vi}</tspan>
          </text>
          <text x={p.x} y={phoneTop + ph + 50} class="rls-note">
            <tspan data-lang-en>{p.noteEn}</tspan>
            <tspan data-lang-vi>{p.noteVi}</tspan>
          </text>
        </g>
      ))}

      {[{ list: prop, x: btnRowX, en: 'Tied to font', vi: 'Theo cỡ chữ', good: false }, { list: tuned, x: btnRowX + 110, en: 'Tuned', vi: 'Chỉnh riêng', good: true }].map((col) => (
        <g>
          <text x={col.x} y={phoneTop + 10} class:list={['rls-col', { 'is-good': col.good }]}>
            <tspan data-lang-en>{col.en}</tspan>
            <tspan data-lang-vi>{col.vi}</tspan>
          </text>
          {col.list.map((b, i) => {
            const bw = textW(b.f) + b.px * 2;
            const bh = b.f * 1.2 + b.py * 2;
            const y = phoneTop + 34 + [0, 50, 112][i];
            return (
              <g>
                <rect x={col.x} y={y} width={bw} height={bh} rx="6" class="rls-btn" />
                <text x={col.x + bw / 2} y={y + bh / 2 + b.f * 0.36} text-anchor="middle" class="rls-btn-text" style={`font-size:${b.f}px`}>Save</text>
              </g>
            );
          })}
        </g>
      ))}
      <text x={btnRowX} y={phoneTop + 240} class="rls-note">
        <tspan data-lang-en>Left: one button, zoomed.</tspan>
        <tspan data-lang-vi>Trái: một nút, phóng to.</tspan>
      </text>
      <text x={btnRowX} y={phoneTop + 262} class="rls-note">
        <tspan data-lang-en>Right: small, medium, large.</tspan>
        <tspan data-lang-vi>Phải: nhỏ, vừa, lớn thật.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Phones drawn at real size with 14px body text. Big things need to shrink more than small things.</span>
    <span data-lang-vi>Điện thoại vẽ đúng kích thước thật, chữ thân bài 14px. Thứ lớn cần co nhiều hơn thứ nhỏ.</span>
  </figcaption>
</figure>

<style>
  .rls { margin: 2em 0; width: 100%; }
  .rls-scroll { overflow-x: auto; }
  .rls svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .rls text { font-size: 14px; fill: var(--text-body); }
  .rls-phone { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.5; }
  .rls-screen { font-family: inherit; overflow: hidden; height: 100%; }
  .rls-head { margin: 0 0 10px; font-weight: 700; line-height: 1.15; color: var(--text); }
  .rls-head.is-bad { color: var(--red); }
  .rls-body { margin: 0; font-size: 14px; line-height: 1.5; color: var(--text-body); }
  .rls text.rls-label { font-size: 15px; font-weight: 700; fill: var(--text); }
  .rls text.rls-label.is-good { fill: var(--red); }
  .rls text.rls-note { fill: var(--text-muted); }
  .rls text.rls-col { font-weight: 700; fill: var(--text); }
  .rls text.rls-col.is-good { fill: var(--red); }
  .rls-btn { fill: var(--text); }
  .rls text.rls-btn-text { fill: var(--bg-alt); font-weight: 600; }
  .rls figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
