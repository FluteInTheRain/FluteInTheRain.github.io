---
// Picture first for "Reading from a follower": the write lands on the leader, the follower is a
// moment behind, and a read from the follower misses the new comment. Illustrative.
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Arrow from './ReplicationBArrow.astro';
import Bi from './ReplicationBBi.astro';
---
<Frame h={250}
  label="Alice writes a comment to the leader. The leader copies it to a follower a moment later. If Alice reads from the follower before the copy arrives, her comment is missing; reading from the leader shows it."
  cap="Read replicas make reads cheap, but the copy takes time. The same page can show two different answers depending on which node answers."
  capVi="Replica đọc làm việc đọc rẻ hơn, nhưng việc sao chép tốn thời gian. Cùng một trang có thể cho hai câu trả lời khác nhau, tuỳ node nào trả lời.">
  <Node x={20} y={90} w={190} h={70} icon="laptop" t="Alice" tv="Alice" s="posts, then refreshes" sv="đăng, rồi tải lại" />
  <Node x={330} y={20} w={220} h={70} icon="server" t="Leader" tv="Leader" s="has the new comment" sv="đã có bình luận mới" cls="gold" />
  <Node x={330} y={150} w={220} h={70} icon="server" t="Follower" tv="Follower" s="copy has not arrived" sv="bản sao chưa tới" cls="red" />
  <Arrow x1={210} y1={110} x2={330} y2={58} />
  <text x="262" y="66" text-anchor="middle" class="rb-step"><Bi en="1. write" vi="1. ghi" /></text>
  <Arrow x1={440} y1={90} x2={440} y2={150} cls="dash" />
  <text x="452" y="126" class="rb-n"><Bi en="2. copied a moment later" vi="2. sao chép chậm hơn một chút" /></text>
  <Arrow x1={210} y1={142} x2={330} y2={184} cls="red" />
  <text x="262" y="182" text-anchor="middle" class="rb-step"><Bi en="3. read" vi="3. đọc" /></text>
  <Node x={650} y={150} w={230} h={70} icon="fail" t="Comment is missing" tv="Bình luận biến mất" s="Alice sees the old page" sv="Alice thấy trang cũ" cls="red" />
  <Arrow x1={550} y1={185} x2={650} y2={185} cls="red" />
  <Node x={650} y={20} w={230} h={70} icon="ok" t="Comment is shown" tv="Bình luận hiện ra" s="if she had read here" sv="nếu cô ấy đọc ở đây" cls="gold" />
  <Arrow x1={550} y1={55} x2={650} y2={55} cls="gold" />
</Frame>
