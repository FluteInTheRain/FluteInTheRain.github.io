---
import DiagramIcon from './DiagramIcon.astro';
import NfrText from './NfrText.astro';
import NfrArrow from './NfrArrow.astro';
import './nfr-fig.css';
// Backward and forward compatibility on one made-up record that gains an `email` field.
const W = 900;
const H = 270;
---
<figure class="nf">
  <div class="nf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Example record that gains an email field. Backward compatible: new code reads old data and uses a default for the missing email. Forward compatible: old code reads new data and ignores the email field it does not know.">
      <NfrText x={20} y={24} cls="h" en="Backward compatible: new code reads old data" vi="Tương thích ngược: code mới đọc dữ liệu cũ" />
      <rect x="20" y="40" width="380" height="64" rx="8" class="box" />
      <DiagramIcon name="file" x={46} y={72} size={26} />
      <NfrText x={74} y={68} cls="s" en="Old data" vi="Dữ liệu cũ" />
      <text x="74" y="90" class="mono">{'{ id: 7, name: "Ana" }'}</text>
      <NfrArrow x1={402} y1={72} x2={462} y2={72} tone="gold" />
      <rect x="466" y="40" width="360" height="64" rx="8" class="box is-gold" />
      <DiagramIcon name="server" x={492} y={72} size={26} />
      <NfrText x={520} y={68} cls="n" en="New code (knows email)" vi="Code mới (biết email)" />
      <NfrText x={520} y={90} cls="s" en="email is missing, so use a default" vi="thiếu email, nên dùng giá trị mặc định" />
      <DiagramIcon name="ok" x={858} y={72} size={26} />

      <NfrText x={20} y={150} cls="h" en="Forward compatible: old code reads new data" vi="Tương thích xuôi: code cũ đọc dữ liệu mới" />
      <rect x="20" y="166" width="380" height="64" rx="8" class="box" />
      <DiagramIcon name="file" x={46} y={198} size={26} />
      <NfrText x={74} y={194} cls="s" en="New data" vi="Dữ liệu mới" />
      <text x="74" y="216" class="mono">{'{ id: 7, name: "Ana", email: "a@x.io" }'}</text>
      <NfrArrow x1={402} y1={198} x2={462} y2={198} tone="gold" />
      <rect x="466" y="166" width="360" height="64" rx="8" class="box is-gold" />
      <DiagramIcon name="server" x={492} y={198} size={26} />
      <NfrText x={520} y={194} cls="n" en="Old code (no email yet)" vi="Code cũ (chưa có email)" />
      <NfrText x={520} y={216} cls="s" en="ignores the field it does not know" vi="bỏ qua trường nó không biết" />
      <DiagramIcon name="ok" x={858} y={198} size={26} />
      <NfrText x={20} y={256} cls="s" en="During an upgrade both versions run at once, so both directions must work." vi="Lúc nâng cấp hai phiên bản chạy cùng lúc, nên cả hai chiều đều phải chạy được." />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Formats like Protocol Buffers and Avro are built so that adding a field like this stays safe.</span>
    <span data-lang-vi>Các định dạng như Protocol Buffers và Avro được thiết kế để thêm một trường như thế này vẫn an toàn.</span>
  </figcaption>
</figure>
