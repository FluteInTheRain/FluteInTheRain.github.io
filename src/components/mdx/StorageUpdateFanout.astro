---
// One UPDATE that changes an indexed column, left/right showdown:
// PostgreSQL (heap file, every index points at the row's physical location)
// vs MySQL InnoDB (row lives in the primary-key B-tree, secondary indexes
// point at the primary key). Based on the users table in Uber's 2016 post.
// Plain inline SVG with site tokens; no ids.

const W = 900;
const H = 420;

type Box = { en: string; vi: string; state: 'hot' | 'old' | 'cold' };
type Side = {
  x: number;
  headEn: string;
  headVi: string;
  subEn: string;
  subVi: string;
  storeEn: string;
  storeVi: string;
  rows: Box[];
  indexes: Box[];
  idxEn: string;
  idxVi: string;
  verdictEn: string;
  verdictVi: string;
};

const sides: Side[] = [
  {
    x: 20,
    headEn: 'PostgreSQL',
    headVi: 'PostgreSQL',
    subEn: 'Indexes point at where the row sits on disk (ctid).',
    subVi: 'Index trỏ tới vị trí của dòng trên đĩa (ctid).',
    storeEn: 'table (heap file)',
    storeVi: 'bảng (heap file)',
    rows: [
      { en: 'id 4, old birth_year (stays until vacuum)', vi: 'id 4, birth_year cũ (nằm đó tới khi vacuum)', state: 'old' },
      { en: 'id 4, new birth_year, new ctid', vi: 'id 4, birth_year mới, ctid mới', state: 'hot' },
    ],
    indexes: [
      { en: 'primary key (id): new entry', vi: 'primary key (id): thêm entry mới', state: 'hot' },
      { en: '(first, last): new entry', vi: '(first, last): thêm entry mới', state: 'hot' },
      { en: 'birth_year: new entry', vi: 'birth_year: thêm entry mới', state: 'hot' },
    ],
    idxEn: 'indexes (all point at the ctid)',
    idxVi: 'các index (đều trỏ tới ctid)',
    verdictEn: '4 writes, each also logged in the WAL',
    verdictVi: '4 lần ghi, lần nào cũng vào WAL',
  },
  {
    x: 470,
    headEn: 'MySQL (InnoDB)',
    headVi: 'MySQL (InnoDB)',
    subEn: 'Row lives in the primary-key B-tree; indexes hold the id.',
    subVi: 'Dòng nằm trong B-tree khoá chính; index khác chỉ lưu id.',
    storeEn: 'primary-key B-tree (holds the row)',
    storeVi: 'B-tree khoá chính (chứa luôn dòng)',
    rows: [
      { en: 'id 4, birth_year changed in place', vi: 'id 4, birth_year sửa tại chỗ', state: 'hot' },
    ],
    indexes: [
      { en: '(first, last) → id 4: untouched', vi: '(first, last) → id 4: không đổi', state: 'cold' },
      { en: 'birth_year: entry moved', vi: 'birth_year: dời entry', state: 'hot' },
    ],
    idxEn: 'secondary indexes (point at the id)',
    idxVi: 'các index phụ (trỏ tới id)',
    verdictEn: '2 structures change; one index is left alone',
    verdictVi: '2 cấu trúc bị sửa; một index được để yên',
  },
];

const colW = 410;
const rowH = 30;
---
<figure class="upd">
  <div class="upd-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="One UPDATE of birth_year on the users table. In PostgreSQL a new row version is written and all three indexes get a new entry pointing at it. In MySQL InnoDB the row is changed inside the primary-key B-tree, the birth_year index entry moves, and the first-last index is untouched.">
    <text x="20" y="24" class="upd-q">UPDATE users SET birth_year = … WHERE id = 4</text>
    <line x1="20" x2={W - 20} y1="40" y2="40" class="upd-rule" />

    {sides.map((s) => {
      const storeY = 108;
      const storeH = 30 + s.rows.length * (rowH + 6);
      const idxY = storeY + storeH + 36;
      return (
        <g>
          <text x={s.x} y="70" class="upd-h">
            <tspan data-lang-en>{s.headEn}</tspan>
            <tspan data-lang-vi>{s.headVi}</tspan>
          </text>
          <text x={s.x} y="92" class="upd-sub">
            <tspan data-lang-en>{s.subEn}</tspan>
            <tspan data-lang-vi>{s.subVi}</tspan>
          </text>

          <rect x={s.x} y={storeY} width={colW} height={storeH} rx="4" class="upd-store" />
          <text x={s.x + 12} y={storeY + 20} class="upd-label">
            <tspan data-lang-en>{s.storeEn}</tspan>
            <tspan data-lang-vi>{s.storeVi}</tspan>
          </text>
          {s.rows.map((r, i) => {
            const y = storeY + 30 + i * (rowH + 6);
            return (
              <g>
                <rect x={s.x + 12} y={y} width={colW - 24} height={rowH} rx="3" class={`upd-cell is-${r.state}`} />
                <text x={s.x + 24} y={y + 20} class={`upd-in is-${r.state}`}>
                  <tspan data-lang-en>{r.en}</tspan>
                  <tspan data-lang-vi>{r.vi}</tspan>
                </text>
              </g>
            );
          })}

          <text x={s.x} y={idxY - 10} class="upd-label">
            <tspan data-lang-en>{s.idxEn}</tspan>
            <tspan data-lang-vi>{s.idxVi}</tspan>
          </text>
          {s.indexes.map((b, i) => {
            const y = idxY + i * (rowH + 8);
            return (
              <g>
                <rect x={s.x} y={y} width={colW} height={rowH} rx="3" class={`upd-cell is-${b.state}`} />
                <text x={s.x + 12} y={y + 20} class={`upd-in is-${b.state}`}>
                  <tspan data-lang-en>{b.en}</tspan>
                  <tspan data-lang-vi>{b.vi}</tspan>
                </text>
              </g>
            );
          })}

          <text x={s.x} y="390" class={s.x === 20 ? 'upd-verdict is-bad' : 'upd-verdict'}>
            <tspan data-lang-en>{s.verdictEn}</tspan>
            <tspan data-lang-vi>{s.verdictVi}</tspan>
          </text>
        </g>
      );
    })}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The same one-column update in the two layouts. Drawn from the users table in Evan Klitzke's post for Uber (2016), which lists the four Postgres writes. In Postgres the "primary key" is one more index, which is why it is drawn with the others.</span>
    <span data-lang-vi>Cùng một lệnh update một cột trên hai cách lưu. Vẽ lại từ bảng users trong bài của Evan Klitzke cho Uber (2016), bài đó liệt kê đúng bốn lần ghi của Postgres. Trong Postgres, "primary key" chỉ là thêm một index nữa, nên mình vẽ chung với các index khác.</span>
  </figcaption>
</figure>

<style>
  .upd {
    margin: 2em 0;
    width: 100%;
  }
  .upd-scroll {
    overflow-x: auto;
  }
  .upd svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .upd text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .upd .upd-q {
    font-size: 15px;
    font-weight: 600;
    fill: var(--text);
  }
  .upd .upd-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .upd .upd-sub,
  .upd .upd-label {
    fill: var(--text-muted);
    font-size: 13px;
  }
  .upd-rule {
    stroke: var(--border);
  }
  .upd-store {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .upd-cell {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .upd-cell.is-hot {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .upd-cell.is-old {
    stroke-dasharray: 5 4;
  }
  .upd .upd-in {
    font-size: 13px;
    fill: var(--text);
  }
  .upd .upd-in.is-hot {
    font-weight: 700;
  }
  .upd .upd-in.is-old,
  .upd .upd-in.is-cold {
    fill: var(--text-faint);
  }
  .upd .upd-verdict {
    font-weight: 700;
    fill: var(--text);
  }
  .upd .upd-verdict.is-bad {
    fill: var(--red);
  }
  .upd figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
