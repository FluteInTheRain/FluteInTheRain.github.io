---
import EncodingStepCards from './EncodingStepCards.astro';
const props = {
 "arrows": true,
 "title": {
  "en": "After a crash, finished steps come back from the log",
  "vi": "Sau khi sập, các bước đã xong được lấy lại từ log"
 },
 "alt": "A payment workflow with durable execution. Step 1, the fraud check, runs once and its result is logged. Step 2, charging the card, runs once and is logged, then the machine dies. On replay the code runs again from the start and steps 1 and 2 return their logged results without being called again. Step 3, paying the bank, has no log entry, so it really runs now.",
 "cards": [
  {
   "icon": "model",
   "head": {
    "en": [
     "1. Fraud check"
    ],
    "vi": [
     "1. Kiểm tra gian lận"
    ]
   },
   "lines": {
    "en": [
     "Ran once. The result is",
     "written to the history."
    ],
    "vi": [
     "Chạy một lần. Kết quả",
     "được ghi vào history."
    ]
   },
   "tone": "plain",
   "mono": [
    "result: ok (logged)"
   ]
  },
  {
   "icon": "card",
   "head": {
    "en": [
     "2. Charge the card"
    ],
    "vi": [
     "2. Trừ tiền thẻ"
    ]
   },
   "lines": {
    "en": [
     "Ran once. Then the machine",
     "dies before the next step."
    ],
    "vi": [
     "Chạy một lần. Rồi máy",
     "sập trước bước kế tiếp."
    ]
   },
   "tone": "plain",
   "mono": [
    "result: paid (logged)"
   ]
  },
  {
   "icon": "retry",
   "head": {
    "en": [
     "3. Replay the code"
    ],
    "vi": [
     "3. Chạy lại từ đầu"
    ]
   },
   "lines": {
    "en": [
     "The code runs again. Steps",
     "1 and 2 return the logged",
     "results; nothing is called",
     "twice."
    ],
    "vi": [
     "Code chạy lại. Bước 1 và 2",
     "trả về kết quả đã ghi;",
     "không gì bị gọi hai lần."
    ]
   },
   "tone": "good"
  },
  {
   "icon": "bank",
   "head": {
    "en": [
     "4. Pay the bank"
    ],
    "vi": [
     "4. Trả ngân hàng"
    ]
   },
   "lines": {
    "en": [
     "The first step with no",
     "log entry, so it really",
     "runs now."
    ],
    "vi": [
     "Bước đầu tiên chưa có",
     "trong log, nên giờ nó",
     "mới thật sự chạy."
    ]
   },
   "tone": "good"
  }
 ],
 "caption": {
  "en": "This only works if the replayed code makes the same calls in the same order.",
  "vi": "Cách này chỉ chạy được nếu code chạy lại gọi đúng các lệnh, đúng thứ tự cũ."
 }
};
---
<EncodingStepCards {...props} />
