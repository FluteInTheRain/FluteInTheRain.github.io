---
// A rounded box with an optional icon at the left and 1-4 lines of text. Used inside StreamBFigure.
import DiagramIcon from './DiagramIcon.astro';
interface Props { x: number; y: number; w: number; h: number; title: string; sub?: string[]; icon?: string; kind?: 'bad' | 'good' | 'dash' | ''; mono?: boolean }
const { x, y, w, h, title, sub = [], icon, kind = '', mono = false } = Astro.props;
const lines = [title, ...sub];
const tx = x + (icon ? 54 : 14);
const y0 = y + h / 2 - ((lines.length - 1) * 9) + 5;
---
<g class={`box ${kind}`}>
  <rect x={x} y={y} width={w} height={h} rx="7" />
  {icon && <DiagramIcon name={icon as any} x={x + 28} y={y + h / 2} size={26} />}
  {lines.map((t, i) => (
    <text x={tx} y={y0 + i * 18} class={i === 0 ? 'name' : mono ? 'mono' : 'sub'}>{t}</text>
  ))}
</g>
