---
// What a partition forces: refuse on the minority side (consistent) or serve possibly stale data
// (available). Static SVG, site tokens only.
import ConsensusFigure from './ConsensusFigure.astro';
import DiagramIcon from './DiagramIcon.astro';
interface Props { lang: 'en' | 'vi' }
const { lang } = Astro.props;

const T = {
  en: {
    aria: 'Two panels, each with two datacenters cut apart by a network partition. Left, choose consistent: the minority side refuses requests, so nothing stale is served but some clients get errors. Right, choose available: both sides keep answering, so clients may see stale or conflicting data. A strip below says that even with no partition, a linearizable system pays network latency on reads and writes.',
    lT: 'Choose consistent', lS: 'The minority side stops answering.',
    rT: 'Choose available', rS: 'Both sides keep answering.',
    dc1: 'Datacenter 1', dc2: 'Datacenter 2', cut: 'partition',
    lA: 'serves requests', lB: 'refuses requests',
    rA: 'serves requests', rB: 'serves requests',
    lRes: ['No stale data, but clients on the', 'minority side get errors.'],
    rRes: ['Everyone gets an answer, but it may', 'be stale or conflict with the other side.'],
    strip: 'No partition? Linearizability still costs network round trips on every read and write.',
    cap: 'A partition is a fault, not a setting: when it happens you pick which cost to pay.',
  },
  vi: {
    aria: 'Hai khung, mỗi khung có hai datacenter bị chia cắt mạng. Trái, chọn nhất quán: phía thiểu số từ chối yêu cầu, không có dữ liệu cũ nhưng một số client nhận lỗi. Phải, chọn sẵn sàng: cả hai phía vẫn trả lời, client có thể thấy dữ liệu cũ hoặc xung đột. Dải bên dưới nói kể cả khi không có chia cắt, hệ khả tuyến tính vẫn phải trả độ trễ mạng cho mỗi lần đọc và ghi.',
    lT: 'Chọn nhất quán', lS: 'Phía thiểu số ngừng trả lời.',
    rT: 'Chọn sẵn sàng', rS: 'Cả hai phía vẫn trả lời.',
    dc1: 'Datacenter 1', dc2: 'Datacenter 2', cut: 'chia cắt',
    lA: 'phục vụ yêu cầu', lB: 'từ chối yêu cầu',
    rA: 'phục vụ yêu cầu', rB: 'phục vụ yêu cầu',
    lRes: ['Không có dữ liệu cũ, nhưng client', 'phía thiểu số nhận lỗi.'],
    rRes: ['Ai cũng có đáp án, nhưng có thể cũ', 'hoặc xung đột với phía bên kia.'],
    strip: 'Không có chia cắt? Khả tuyến tính vẫn tốn vòng đi về qua mạng cho mỗi lần đọc và ghi.',
    cap: 'Chia cắt là một sự cố, không phải một nút cấu hình: khi nó xảy ra bạn chọn trả giá nào.',
  },
}[lang];

const panels = [
  { ox: 10, t: T.lT, s: T.lS, a: T.lA, b: T.lB, res: T.lRes, bKind: 'is-dash', resKind: 'is-ok' },
  { ox: 460, t: T.rT, s: T.rS, a: T.rA, b: T.rB, res: T.rRes, bKind: '', resKind: 'is-bad' },
];
const bw = 150, bh = 62;
---
<ConsensusFigure aria={T.aria} cap={T.cap} w={900} h={330}>
  <line x1="450" x2="450" y1="10" y2="238" class="cfg-rule" />
  {panels.map((p) => (
    <g>
      <text x={p.ox + 10} y="26" class="cfg-t">{p.t}</text>
      <text x={p.ox + 10} y="46" class="cfg-s">{p.s}</text>
      {[0, 1].map((k) => {
        const x = p.ox + 20 + k * 250;
        const dead = k === 1 && p.bKind === 'is-dash';
        return (
          <g>
            <DiagramIcon name="laptop" x={x + 75} y={80} size={26} />
            <rect x={x} y="112" width={bw} height={bh} rx="6" class={`cfg-box ${dead ? 'is-dash' : ''}`} />
            <DiagramIcon name="db" x={x + 26} y={112 + bh / 2} size={26} />
            <text x={x + 50} y="136" class="cfg-n">{k === 0 ? T.dc1 : T.dc2}</text>
            <text x={x + 50} y="154" class={`cfg-m ${dead ? 'cfg-r' : ''}`} style="font-size:11.5px">{k === 0 ? p.a : p.b}</text>
          </g>
        );
      })}
      <line x1={p.ox + 220} x2={p.ox + 220} y1="104" y2="190" class="cfg-cut" />
      <text x={p.ox + 220} y="206" text-anchor="middle" class="cfg-r">{T.cut}</text>
    </g>
  ))}
  {panels.map((p) => (
    <g>
      <rect x={p.ox + 10} y="222" width="420" height="52" rx="6" class={`cfg-box ${p.resKind}`} />
      <text x={p.ox + 220} y="244" text-anchor="middle" class="cfg-g">{p.res[0]}</text>
      <text x={p.ox + 220} y="262" text-anchor="middle" class="cfg-g">{p.res[1]}</text>
    </g>
  ))}
  <rect x="10" y="288" width="880" height="36" rx="6" class="cfg-box" />
  <DiagramIcon name="stopwatch" x={36} y={306} size={22} />
  <text x="62" y="311" class="cfg-g">{T.strip}</text>
</ConsensusFigure>
