---
// Post 5, "Handle an error once": the readConfig / start / main example, logging twice vs once.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 8 * Math.cos(a - 0.45), y2 - 8 * Math.sin(a - 0.45)];
  const p2 = [x2 - 8 * Math.cos(a + 0.45), y2 - 8 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const bx = [20, 335, 650];
const bw = 230;
const rows = [
  { y: 40, logStart: true, enH: 'As written: two log lines for one failure', viH: 'Như đã viết: hai dòng log cho một lỗi' },
  { y: 190, logStart: false, enH: 'Fixed: only main logs', viH: 'Đã sửa: chỉ main log' },
];
---
<figure class="gp05b">
  <div class="gp05b-scroll">
  <svg viewBox="0 0 900 330" role="img" aria-label="readConfig returns permission denied to start, which returns it to main. As written, start and main both log it. In the fix only main logs it.">
    {rows.map((r) => (
      <g>
        <text x="20" y={r.y - 16} class="h"><tspan data-lang-en>{r.enH}</tspan><tspan data-lang-vi>{r.viH}</tspan></text>
        {[0, 1, 2].map((i) => (
          <g>
            <rect class={i === 1 && r.logStart ? 'box red' : 'box'} x={bx[i]} y={r.y} width={bw} height="58" rx="6" />
            <text x={bx[i] + 14} y={r.y + 23} class="b">{['main', 'start', 'readConfig'][i]}</text>
            {i > 0 && (
              <text x={bx[i] + 14} y={r.y + 44} class="m">
                <tspan data-lang-en>returns {i === 1 ? 'start: ' : ''}permission denied</tspan>
                <tspan data-lang-vi>trả về {i === 1 ? 'start: ' : ''}permission denied</tspan>
              </text>
            )}
            {i === 0 && (
              <text x={bx[i] + 14} y={r.y + 44} class="m"><tspan data-lang-en>top of the call chain</tspan><tspan data-lang-vi>đầu chuỗi gọi</tspan></text>
            )}
          </g>
        ))}
        {[0, 1].map((i) => {
          const a = arrow(bx[i + 1], r.y + 29, bx[i] + bw, r.y + 29);
          return <g><path class="ln" d={a.line} /><polygon points={a.head} class="bar" /></g>;
        })}
        {r.logStart && (
          <text x={bx[1] + 14} y={r.y + 82} class="r"><tspan data-lang-en>log: readConfig failed: permission denied</tspan><tspan data-lang-vi>log: readConfig failed: permission denied</tspan></text>
        )}
        <text x={bx[0] + 14} y={r.y + (r.logStart ? 106 : 82)} class="r"><tspan data-lang-en>log: main: start: permission denied</tspan><tspan data-lang-vi>log: main: start: permission denied</tspan></text>
      </g>
    ))}
    <text x="880" y="302" text-anchor="end" class="m"><tspan data-lang-en>Arrows show the error travelling up.</tspan><tspan data-lang-vi>Mũi tên cho thấy lỗi đi ngược lên trên.</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The same failure from the example above. Each layer that logs and also returns adds another line; if only main logs, the wrapped message still carries the whole path.</span>
    <span data-lang-vi>Cùng một thất bại như ví dụ trên. Mỗi tầng vừa log vừa return lại thêm một dòng; nếu chỉ main log, thông báo đã bọc vẫn mang đủ đường đi.</span>
  </figcaption>
</figure>

<style>
  .gp05b { margin: 2em 0; width: 100%; }
  .gp05b-scroll { overflow-x: auto; }
  .gp05b svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp05b text { font-size: 14px; fill: var(--text-body); }
  .gp05b .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp05b .b { font-weight: 700; fill: var(--text); }
  .gp05b .m { fill: var(--text-muted); font-size: 13px; }
  .gp05b .n { font-variant-numeric: tabular-nums; }
  .gp05b .r { fill: var(--red); font-weight: 700; }
  .gp05b .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp05b .box.red { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp05b .box.dash { stroke-dasharray: 4 3; }
  .gp05b .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp05b .ln.red { stroke: var(--red); }
  .gp05b .ln.cut { stroke-dasharray: 3 4; opacity: 0.5; }
  .gp05b .hd { fill: var(--text-muted); }
  .gp05b .hd.red { fill: var(--red); }
  .gp05b .rule { stroke: var(--border); }
  .gp05b .bar { fill: var(--text-muted); }
  .gp05b .bar.red { fill: var(--red); }
  .gp05b figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
