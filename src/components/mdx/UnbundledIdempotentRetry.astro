---
// A charge request whose response is lost: blind retry versus retry with a client-generated idempotency key. Source: Stripe blog, "Designing robust and predictable APIs with idempotency".
// Plain inline SVG with site CSS tokens; polygon arrowheads avoid duplicate marker ids.
const W = 900;
const H = 370;

type Box = { x: number; y: number; w: number; h: number; en: string; vi: string; sen?: string; svi?: string; hot?: boolean; good?: boolean };
const boxes: Box[] = [{"x": 20, "y": 78, "w": 145, "h": 56, "en": "Client", "vi": "Client", "sen": "sends charge", "svi": "gửi lệnh trừ tiền"}, {"x": 196, "y": 78, "w": 145, "h": 56, "en": "Server", "vi": "Server", "sen": "charges the card", "svi": "trừ tiền thẻ"}, {"x": 372, "y": 78, "w": 145, "h": 56, "en": "Network", "vi": "Mạng", "sen": "drops the response", "svi": "mất phản hồi"}, {"x": 548, "y": 78, "w": 145, "h": 56, "en": "Client", "vi": "Client", "sen": "retries blindly", "svi": "thử lại mù"}, {"x": 724, "y": 78, "w": 156, "h": 56, "en": "Server", "vi": "Server", "sen": "charges again", "svi": "trừ tiền lần nữa", "hot": true}, {"x": 20, "y": 240, "w": 145, "h": 60, "en": "Client", "vi": "Client", "sen": "sends key + charge", "svi": "gửi key + lệnh trừ"}, {"x": 196, "y": 240, "w": 145, "h": 60, "en": "Server", "vi": "Server", "sen": "links key to request", "svi": "gắn key với request"}, {"x": 372, "y": 240, "w": 145, "h": 60, "en": "Network", "vi": "Mạng", "sen": "drops the response", "svi": "mất phản hồi"}, {"x": 548, "y": 240, "w": 145, "h": 60, "en": "Client", "vi": "Client", "sen": "retries with same key", "svi": "thử lại cùng key"}, {"x": 724, "y": 240, "w": 156, "h": 60, "en": "Server", "vi": "Server", "sen": "replays cached result", "svi": "trả lại kết quả đã lưu", "good": true}];
// [x1, y, x2, dashed, hot]
const arrows: [number, number, number, boolean, boolean | string][] = [[165, 106, 196, false, false], [341, 106, 372, false, false], [517, 106, 548, true, false], [693, 106, 724, false, true], [165, 270, 196, false, false], [341, 270, 372, false, false], [517, 270, 548, true, false], [693, 270, 724, false, "good"]];
// [x, y, en, vi, anchor, hot]
const notes: [number, number, string, string, string, boolean | string][] = [[20, 162, "Both requests look new to the server, so the customer is billed twice.", "Server thấy cả hai request đều là request mới, nên khách bị trừ tiền hai lần.", "start", true], [20, 336, "Same key, same outcome: the customer is charged once. Clients retry with exponential backoff and jitter.", "Cùng key, cùng kết quả: khách chỉ bị trừ một lần. Client thử lại với exponential backoff và jitter.", "start", "good"]];
const heads = (x2: number, y: number) => `${x2 - 8},${y - 4.5} ${x2 - 8},${y + 4.5} ${x2},${y}`;
---
<figure class="unb-fig">
  <div class="unb-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two retries after a lost response: without an idempotency key the server charges the card twice; with a client-generated key it replays the first result.">
      <text x="20" y="26" class="unb-h"><tspan data-lang-en>Retrying a charge after a lost response</tspan><tspan data-lang-vi>Thử lại lệnh trừ tiền sau khi mất phản hồi</tspan></text>
      <text x="20" y="64" class="unb-lane-h"><tspan data-lang-en>Without a key</tspan><tspan data-lang-vi>Không có key</tspan></text>
      <text x="20" y="226" class="unb-lane-h"><tspan data-lang-en>With an idempotency key</tspan><tspan data-lang-vi>Có idempotency key</tspan></text>
      {boxes.map((b) => (
        <>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" class={b.hot ? 'unb-box is-hot' : b.good ? 'unb-box is-good' : 'unb-box'} />
          <text x={b.x + b.w / 2} y={b.y + (b.sen ? b.h / 2 - 3 : b.h / 2 + 5)} text-anchor="middle" class="unb-in-b"><tspan data-lang-en>{b.en}</tspan><tspan data-lang-vi>{b.vi}</tspan></text>
          {b.sen && <text x={b.x + b.w / 2} y={b.y + b.h / 2 + 15} text-anchor="middle" class="unb-in-m"><tspan data-lang-en>{b.sen}</tspan><tspan data-lang-vi>{b.svi}</tspan></text>}
        </>
      ))}
      {arrows.map(([x1, y, x2, dashed, hot]) => (
        <>
          <path d={`M${x1},${y} L${x2 - 7},${y}`} class={`${dashed ? 'unb-dashed' : 'unb-solid'}${hot === 'good' ? ' is-good' : hot ? ' is-hot' : ''}`} />
          <polygon points={heads(x2, y)} class={hot === 'good' ? 'unb-head is-good' : hot ? 'unb-head is-hot' : 'unb-head'} />
        </>
      ))}
      {notes.map(([x, y, en, vi, anchor, hot]) => (
        <text x={x} y={y} text-anchor={anchor} class={hot === 'good' ? 'unb-note is-good' : hot ? 'unb-note is-hot' : 'unb-note'}><tspan data-lang-en>{en}</tspan><tspan data-lang-vi>{vi}</tspan></text>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The client generates the key before sending, so only the endpoints can tell a retry from a new request. Source: Stripe Engineering blog.</span>
    <span data-lang-vi>Client tạo key trước khi gửi, nên chỉ hai đầu cuối mới phân biệt được request thử lại với request mới. Nguồn: blog kỹ thuật của Stripe.</span>
  </figcaption>
</figure>

<style>
  .unb-fig {
    margin: 2em 0;
    width: 100%;
  }
  .unb-scroll {
    overflow-x: auto;
  }
  .unb-fig svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .unb-fig text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .unb-fig .unb-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .unb-fig .unb-sub {
    font-size: 13.5px;
    fill: var(--text-muted);
  }
  .unb-fig .unb-lane-h {
    font-size: 14.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .unb-fig .unb-lane-sub {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .unb-rule {
    stroke: var(--border);
  }
  .unb-box {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .unb-box.is-hot {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .unb-fig .unb-in-b {
    font-weight: 700;
    fill: var(--text);
    font-size: 13.5px;
  }
  .unb-fig .unb-in-m {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .unb-boundary {
    stroke: var(--red);
    stroke-width: 1.6;
    stroke-dasharray: 5 4;
  }
  .unb-fig .unb-boundary-lbl {
    font-size: 12.5px;
    font-weight: 700;
    fill: var(--red);
  }
  .unb-solid {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.8;
  }
  .unb-solid.is-hot {
    stroke: var(--red);
    stroke-width: 2;
  }
  .unb-dashed {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.4;
    stroke-dasharray: 5 4;
  }
  .unb-head {
    fill: var(--text-muted);
  }
  .unb-head.is-hot {
    fill: var(--red);
  }
  .unb-fig figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
  .unb-fig .unb-note { font-size: 13px; fill: var(--text-muted); }
  .unb-fig .unb-note.is-hot { fill: var(--red); font-weight: 700; }
  .unb-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .unb-solid.is-good { stroke: var(--gold-icon); stroke-width: 2; }
  .unb-head.is-good { fill: var(--gold-icon); }
  .unb-fig .unb-note.is-good { fill: var(--gold-icon); font-weight: 700; }
</style>
