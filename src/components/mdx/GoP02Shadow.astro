---
// Icons: label = a variable named count, terminal = program output. Motion: fm-flow on the red return-reads-outer line, fm-pulse on the outer count.
import DiagramIcon from './DiagramIcon.astro';
// Scope boxes for buggy(5): the inner count is a second variable.
function head(x2: number, y2: number, a: number) { const l = 9; const p = (d: number) => `${(x2 - l * Math.cos(a + d)).toFixed(1)},${(y2 - l * Math.sin(a + d)).toFixed(1)}`; return `${x2},${y2} ${p(-0.45)} ${p(0.45)}`; }
const W = 900;
const H = 320;
---
<figure class="gp02d">
  <div class="gp02d-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Function buggy called with 5. The outer scope holds count equal to 0. Inside the if block, count := n * 2 creates a second variable count equal to 10. After the block, return count reads the outer count, which is still 0.">
    <rect x="20" y="20" width="560" height="280" rx="10" class="box" style="fill: none" />
    <text x="38" y="46" class="strong"><tspan data-lang-en>function buggy, called with n = 5</tspan><tspan data-lang-vi>hàm buggy, gọi với n = 5</tspan></text>

    <rect x="44" y="64" width="240" height="56" rx="6" class="box-red fm-pulse" />
    <DiagramIcon name="label" x={68} y={92} size={26} />
    <text x="94" y="88" class="strong">count := 0</text>
    <text x="94" y="108" class="muted"><tspan data-lang-en>outer count, value 0</tspan><tspan data-lang-vi>count ngoài, giá trị 0</tspan></text>

    <rect x="44" y="140" width="500" height="90" rx="8" class="ghost" />
    <text x="60" y="162" class="muted"><tspan data-lang-en>inside the if n &gt; 0 block</tspan><tspan data-lang-vi>bên trong khối if n &gt; 0</tspan></text>
    <rect x="64" y="174" width="250" height="44" rx="6" class="box" />
    <DiagramIcon name="label" x={84} y={196} size={22} />
    <text x="106" y="196" class="strong">count := n * 2</text>
    <text x="106" y="212" class="muted num" style="font-size:13px"><tspan data-lang-en>a second count, value 10</tspan><tspan data-lang-vi>count thứ hai, giá trị 10</tspan></text>
    <text x="334" y="201" class="muted"><tspan data-lang-en>gone at the closing brace</tspan><tspan data-lang-vi>mất khi hết dấu ngoặc nhọn</tspan></text>

    <text x="60" y="268" class="strong">return count</text>
    <polyline points="55,263 32,263 32,92 36,92" class="line-red fm-flow" />
    <polygon points={head(44, 92, 0)} class="head-red" />

    <DiagramIcon name="terminal" x={622} y={85} size={26} />
    <text x="644" y="90" class="red"><tspan data-lang-en>The program printed:</tspan><tspan data-lang-vi>Chương trình in ra:</tspan></text>
    <text x="610" y="120" class="num strong">inside block: 10</text>
    <text x="610" y="146" class="num red">buggy: 0</text>
    <text x="610" y="190" class="muted"><tspan data-lang-en>The block looked fine, but</tspan><tspan data-lang-vi>Khối lệnh trông ổn, nhưng</tspan></text>
    <text x="610" y="210" class="muted"><tspan data-lang-en>the return reads the outer one.</tspan><tspan data-lang-vi>return đọc count bên ngoài.</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Two variables share the name count. The inner one is set to 10 and thrown away; the outer one, which is returned, was never touched.</span>
    <span data-lang-vi>Hai biến cùng tên count. Biến bên trong được gán 10 rồi bị bỏ; biến bên ngoài, thứ được trả về, chưa hề bị đụng tới.</span>
  </figcaption>
</figure>

<style>
  .gp02d { margin: 2em 0; width: 100%; }
  .gp02d-scroll { overflow-x: auto; }
  .gp02d svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp02d text { font-size: 14px; fill: var(--text-body); }
  .gp02d .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .gp02d .muted { fill: var(--text-muted); }
  .gp02d .strong { font-weight: 700; fill: var(--text); }
  .gp02d .red { fill: var(--red); font-weight: 700; }
  .gp02d .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp02d .box-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .gp02d .ghost { fill: none; stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .gp02d .axis { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp02d .line { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp02d .line-red { stroke: var(--red); stroke-width: 1.8; fill: none; }
  .gp02d .head { fill: var(--text-muted); }
  .gp02d .head-red { fill: var(--red); }
  .gp02d .num { font-variant-numeric: tabular-nums; }
  .gp02d figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
