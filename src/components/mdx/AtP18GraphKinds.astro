---
import DiagramIcon from './DiagramIcon.astro';
// Three ways to draw the edges of a stock graph. Density numbers: Feng et al. 2019, Table 4 (industry, Wikidata)
// and Tumminello et al. 2005 (PMFG keeps 3(N-2) edges; for N = 100 that is 294 of C(100,2) = 4,950 pairs). The node layouts are schematic.
const W = 900;
const H = 372;
const pw = 276;
const xs = [20, 312, 604];
const ind = { n: [['HPG', 60, 120], ['HSG', 140, 100], ['NKG', 100, 176], ['VCB', 176, 150], ['BID', 224, 100], ['CTG', 214, 190]] as [string, number, number][], e: [[0, 1], [0, 2], [1, 2], [3, 4], [3, 5], [4, 5]] };
const wiki = { n: [['Boeing', 62, 108], ['747', 138, 150], ['United', 214, 108], ['Alphabet', 62, 196], ['Google', 214, 196]] as [string, number, number][], e: [[0, 1], [2, 1], [3, 4]] };
const ret = { n: ind.n, e: [[0, 1, 3], [0, 2, 2], [1, 2, 3], [3, 4, 3], [3, 5, 2], [4, 5, 3], [2, 3, 1]] };
---
<figure class="atp18-kinds">
  <div class="atp18-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three ways to build the edges of a stock graph. Industry labels connect stocks with the same label and cover 5 to 9 percent of pairs in the US datasets. Wikidata statements such as supplier or owner connect very few pairs, 0.21 to 0.30 percent. A graph drawn from return correlations keeps 294 edges out of 4,950 pairs for 100 stocks.">
      <text x="20" y="24" class="h">
        <tspan data-lang-en>An edge means whatever you decided it means</tspan>
        <tspan data-lang-vi>Một cạnh nghĩa là điều bạn quyết định nó nghĩa là</tspan>
      </text>
      {[ind, wiki, ret].map((g, k) => (
        <g>
          <rect x={xs[k]} y="42" width={pw} height="296" rx="8" class="panel" />
          <text x={xs[k] + 14} y="66" class="t">
            <tspan data-lang-en>{['Industry labels', 'Knowledge-base facts', 'Return correlation'][k]}</tspan>
            <tspan data-lang-vi>{['Nhãn ngành', 'Dữ kiện từ knowledge base', 'Tương quan lợi suất'][k]}</tspan>
          </text>
          {g.e.map((e) => (
            <line x1={xs[k] + g.n[e[0]][1]} y1={g.n[e[0]][2] + 20} x2={xs[k] + g.n[e[1]][1]} y2={g.n[e[1]][2] + 20} class={k === 2 ? `edge w${e[2]}` : 'edge'} />
          ))}
          {g.n.map((nd) => (
            <g>
              <circle cx={xs[k] + nd[1]} cy={nd[2] + 20} r={k === 1 && nd[0] !== '747' ? 25 : k === 1 ? 17 : 17} class={k === 1 && nd[0] === '747' ? 'node item' : 'node'} />
              <text x={xs[k] + nd[1]} y={nd[2] + 24} text-anchor="middle" class="nl">{nd[0]}</text>
            </g>
          ))}
          <text x={xs[k] + 14} y="276" class="sm">
            <tspan data-lang-en>{['Who draws it: a classification table', 'Who draws it: a public database', 'Who draws it: the returns themselves'][k]}</tspan>
            <tspan data-lang-vi>{['Ai vẽ: một bảng phân loại', 'Ai vẽ: một cơ sở dữ liệu công khai', 'Ai vẽ: chính chuỗi lợi suất'][k]}</tspan>
          </text>
          <text x={xs[k] + 14} y="298" class="sm">
            <tspan data-lang-en>{['Linked pairs: 5.00% NASDAQ, 9.37% NYSE', 'Linked pairs: 0.21% NASDAQ, 0.30% NYSE', 'Kept: 294 of 4,950 pairs (N = 100)'][k]}</tspan>
            <tspan data-lang-vi>{['Cặp được nối: 5,00% NASDAQ, 9,37% NYSE', 'Cặp được nối: 0,21% NASDAQ, 0,30% NYSE', 'Giữ lại: 294 trên 4.950 cặp (N = 100)'][k]}</tspan>
          </text>
          <text x={xs[k] + 14} y="320" class="sm warn">
            <tspan data-lang-en>{['Misses links across industries', 'Rich, but almost empty', 'Moves when the market regime moves'][k]}</tspan>
            <tspan data-lang-vi>{['Bỏ sót liên kết giữa các ngành', 'Giàu thông tin nhưng gần như trống', 'Đổi khi chu kỳ thị trường đổi'][k]}</tspan>
          </text>
        </g>
      ))}
      <DiagramIcon name="network" x={xs[2] + pw - 24} y={60} size={20} />
      <DiagramIcon name="bank" x={xs[0] + pw - 24} y={60} size={20} />
      <DiagramIcon name="file" x={xs[1] + pw - 24} y={60} size={20} />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The left two panels use the US datasets of Feng et al. (2019); the right panel uses the 3(N − 2) edge count of the planar filter of Tumminello et al. (2005), here for 100 stocks. Wikidata example: Boeing and United Airlines both link to the Boeing 747 item, the paper's own example of a second-order relation.</span>
    <span data-lang-vi>Hai khung trái dùng bộ dữ liệu Mỹ của Feng và cộng sự (2019); khung phải dùng số cạnh 3(N − 2) của bộ lọc phẳng Tumminello và cộng sự (2005), ở đây cho 100 mã. Ví dụ Wikidata: Boeing và United Airlines cùng nối tới mục Boeing 747, đúng ví dụ quan hệ bậc hai trong bài báo.</span>
  </figcaption>
</figure>

<style>
  .atp18-kinds { margin: 2em 0; width: 100%; }
  .atp18-scroll { overflow-x: auto; }
  .atp18-kinds svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp18-kinds .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .atp18-kinds .t { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .atp18-kinds .sm { font-size: 12px; fill: var(--text-body); }
  .atp18-kinds .sm.warn { fill: var(--red); }
  .atp18-kinds .nl { font-size: 9.5px; font-weight: 700; fill: var(--text); }
  .atp18-kinds .panel { fill: var(--bg-alt); stroke: var(--border); }
  .atp18-kinds .edge { stroke: var(--text-muted); stroke-width: 1.6; }
  .atp18-kinds .edge.w1 { stroke-width: 1; }
  .atp18-kinds .edge.w2 { stroke-width: 2.2; }
  .atp18-kinds .edge.w3 { stroke-width: 3.2; }
  .atp18-kinds .node { fill: var(--card-bg); stroke: var(--text-muted); stroke-width: 1.6; }
  .atp18-kinds .node.item { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .atp18-kinds figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
