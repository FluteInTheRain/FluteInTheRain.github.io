---
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 330;
---
<figure class="gp1b">
  <div class="gp1b-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Folder tree of the greeter module. main.go in cmd/greeter imports example.com/greeter/internal/greet, which is the module name followed by the folder path internal/greet.">
    <text x="20" y="26" class="h"><tspan data-lang-en>Folders on disk</tspan><tspan data-lang-vi>Thư mục trên đĩa</tspan></text>
    <g>
      <text x="20" y="58" class="t">greeter/</text>
      <text x="50" y="84">go.mod</text><text x="250" y="84" class="m">module example.com/greeter</text>
      <text x="50" y="110">cmd/greeter/main.go</text>
      <text x="50" y="136">internal/greet/greet.go</text>
      <path d="M 30 66 L 30 132 M 30 84 L 44 84 M 30 110 L 44 110 M 30 136 L 44 136" class="ln" />
    </g>
    <rect x="474" y="92" width="406" height="68" rx="6" class="box" />
    <text x="490" y="120" class="m">package main</text>
    <text x="490" y="146" class="t">import "example.com/greeter/internal/greet"</text>
    {(() => { const a = arrow(244, 106, 470, 118); return <g><path d={a.line} class="lnd" /><polygon points={a.head} class="hd" /></g>; })()}
    <text x="20" y="214" class="h"><tspan data-lang-en>How the import path is built</tspan><tspan data-lang-vi>Đường dẫn import được ghép thế nào</tspan></text>
    <rect x="20" y="232" width="330" height="44" rx="6" class="box" />
    <text x="185" y="260" text-anchor="middle" class="t">example.com/greeter</text>
    <text x="364" y="260" text-anchor="middle" class="t">+</text>
    <rect x="378" y="232" width="250" height="44" rx="6" class="box" />
    <text x="503" y="260" text-anchor="middle" class="t">/internal/greet</text>
    <text x="20" y="302" class="m"><tspan data-lang-en>module name, from go.mod</tspan><tspan data-lang-vi>tên module, lấy từ go.mod</tspan></text>
    <text x="378" y="302" class="m"><tspan data-lang-en>folder path inside the module</tspan><tspan data-lang-vi>đường dẫn thư mục trong module</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>An import path is the module name from go.mod followed by the folder that holds the package.</span>
    <span data-lang-vi>Đường dẫn import là tên module trong go.mod, nối với thư mục chứa package.</span>
  </figcaption>
</figure>

<style>
  .gp1b { margin: 2em 0; width: 100%; }
  .gp1b-scroll { overflow-x: auto; }
  .gp1b svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp1b text { font-size: 14px; fill: var(--text-body); }
  .gp1b .t { font-weight: 700; fill: var(--text); }
  .gp1b .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp1b .m { fill: var(--text-muted); }
  .gp1b .r { fill: var(--red); font-weight: 700; }
  .gp1b .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp1b .grp { fill: none; stroke: var(--border); stroke-width: 1.5; }
  .gp1b .bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp1b .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp1b .lnd { stroke: var(--text-muted); stroke-width: 1.5; fill: none; stroke-dasharray: 4 4; }
  .gp1b .lnr { stroke: var(--red); stroke-width: 1.5; fill: none; stroke-dasharray: 5 4; }
  .gp1b .hd { fill: var(--text-muted); }
  .gp1b .hdr { fill: var(--red); }
  .gp1b .axis { stroke: var(--border); stroke-width: 1.5; }
  .gp1b figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
