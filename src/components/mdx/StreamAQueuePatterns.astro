---
// The two consumer patterns of a classic broker: load balancing (shared queue) vs fan-out (topic).
import DiagramIcon from './DiagramIcon.astro';
import StreamAFrame from './StreamAFrame.astro';
import { arrow } from './StreamAHelpers';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    h1: 'Load balancing: one message, one worker', h2: 'Fan-out: every message, every subscriber',
    q: 'Queue', t: 'Topic',
    w: [['Worker 1', 'only m1'], ['Worker 2', 'only m2'], ['Worker 3', 'only m3']],
    f: [['Billing', 'gets all three'], ['Search', 'gets all three'], ['Analytics', 'gets all three']],
    n1: 'Splits expensive work across a pool.', n2: 'Each subscriber reads its own full copy.',
    alt: 'Left: a queue hands m1, m2 and m3 to three different workers, one message each. Right: a topic delivers m1, m2 and m3 to all three subscribers, billing, search and analytics.',
    cap: 'Same broker, two jobs. Load balancing shares the work; fan-out shares the data.',
  },
  vi: {
    h1: 'Chia tải: mỗi tin nhắn một worker', h2: 'Fan-out: mọi tin nhắn tới mọi bên nhận',
    q: 'Queue', t: 'Topic',
    w: [['Worker 1', 'chỉ nhận m1'], ['Worker 2', 'chỉ nhận m2'], ['Worker 3', 'chỉ nhận m3']],
    f: [['Billing', 'nhận cả ba'], ['Search', 'nhận cả ba'], ['Analytics', 'nhận cả ba']],
    n1: 'Chia việc nặng cho cả nhóm worker.', n2: 'Mỗi bên nhận tự đọc trọn một bản sao.',
    alt: 'Trái: queue giao m1, m2 và m3 cho ba worker khác nhau, mỗi worker một tin. Phải: topic gửi m1, m2 và m3 tới cả ba bên nhận là billing, search và analytics.',
    cap: 'Cùng một broker, hai việc khác nhau. Chia tải là chia việc; fan-out là chia dữ liệu.',
  },
}[lang];
const panels = [
  { ox: 0, h: T.h1, b: T.q, kids: T.w, icons: ['worker', 'worker', 'worker'], n: T.n1 },
  { ox: 440, h: T.h2, b: T.t, kids: T.f, icons: ['card', 'search', 'chart'], n: T.n2 },
];
const ys = [56, 126, 196];
---
<StreamAFrame h={300} alt={T.alt} cap={T.cap}>
  {panels.map((p) => (
    <g>
      <text x={p.ox + 20} y="28" class="name" style="font-size:15px">{p.h}</text>
      <g class="box"><rect x={p.ox + 20} y="60" width="124" height="182" rx="7" /></g>
      <DiagramIcon name="rabbitmq" x={p.ox + 82} y={92} size={30} />
      <text x={p.ox + 82} y="130" text-anchor="middle" class="name">{p.b}</text>
      {[0, 1, 2].map((k) => (
        <g class="box">
          <rect x={p.ox + 32 + k * 34} y="152" width="28" height="28" rx="4" />
          <text x={p.ox + 46 + k * 34} y="171" text-anchor="middle" class="num">{`m${k + 1}`}</text>
        </g>
      ))}
      {ys.map((y, i) => {
        const a = arrow(p.ox + 144, 151, p.ox + 286, y + 25);
        return (
          <g>
            <g class="arr"><path d={a.line} /><polygon points={a.head} /></g>
            <g class="box good"><rect x={p.ox + 290} y={y} width="150" height="50" rx="7" /></g>
            <DiagramIcon name={p.icons[i] as any} x={p.ox + 316} y={y + 25} size={26} />
            <text x={p.ox + 340} y={y + 22} class="name">{p.kids[i][0]}</text>
            <text x={p.ox + 340} y={y + 40} class="sub">{p.kids[i][1]}</text>
          </g>
        );
      })}
      <text x={p.ox + 20} y="272" class="sub">{p.n}</text>
    </g>
  ))}
</StreamAFrame>
