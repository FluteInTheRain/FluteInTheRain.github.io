---
// The naming trap: the same level name means different things in different engines.
// Plain inline SVG, site tokens only. Facts as in the post's table.
import DiagramIcon from './DiagramIcon.astro';
const rows = [
  { icon: 'postgres', eng: 'PostgreSQL', label: 'REPEATABLE READ', en: 'True snapshot isolation', vi: 'Snapshot isolation thật', n: { en: 'stops read skew, aborts lost updates; write skew still possible', vi: 'chặn read skew, huỷ lost update; write skew vẫn xảy ra' }, k: '' },
  { icon: 'mysql', eng: 'MySQL (InnoDB)', label: 'REPEATABLE READ', en: 'Weaker than snapshot isolation', vi: 'Yếu hơn snapshot isolation', n: { en: 'Jepsen 2023: lost updates, G-single, non-monotonic views', vi: 'Jepsen 2023: có lost update, G-single, view không đơn điệu' }, k: 'is-bad' },
  { icon: 'db', eng: 'Oracle', label: 'SERIALIZABLE', en: 'Only snapshot isolation', vi: 'Chỉ là snapshot isolation', n: { en: 'write skew still passes silently', vi: 'write skew vẫn lọt qua âm thầm' }, k: 'is-bad' },
  { icon: 'db', eng: 'IBM Db2', label: 'REPEATABLE READ', en: 'Full serializability (locking)', vi: 'Serializability đầy đủ (dùng khoá)', n: { en: 'stronger than the name suggests', vi: 'mạnh hơn tên gọi gợi ý' }, k: 'is-ok' },
];
---
<figure class="txnm">
  <div class="txnm-scroll">
  <svg viewBox="0 0 900 330" role="img" aria-label="Four rows, each showing an engine, the isolation level name on its label, and what it actually gives. PostgreSQL REPEATABLE READ is true snapshot isolation. MySQL InnoDB REPEATABLE READ is weaker than snapshot isolation. Oracle SERIALIZABLE is only snapshot isolation. IBM Db2 REPEATABLE READ is full serializability using locking.">
    <text x="20" y="26" class="h">
      <tspan data-lang-en>The label on the setting is not the guarantee</tspan>
      <tspan data-lang-vi>Tên trên cài đặt không phải là mức bảo đảm</tspan>
    </text>
    <text x="40" y="56" class="note"><tspan data-lang-en>Engine</tspan><tspan data-lang-vi>Engine</tspan></text>
    <text x="250" y="56" class="note"><tspan data-lang-en>Name you set</tspan><tspan data-lang-vi>Tên bạn đặt</tspan></text>
    <text x="500" y="56" class="note"><tspan data-lang-en>What you actually get</tspan><tspan data-lang-vi>Thứ bạn thật sự nhận</tspan></text>
    {rows.map((r, i) => (
      <g>
        <rect x="20" y={68 + i * 62} width="860" height="52" rx="6" class={`txnm-box ${r.k}`} />
        <DiagramIcon name={r.icon} x={46} y={94 + i * 62} size={28} />
        <text x="72" y={99 + i * 62} class="b">{r.eng}</text>
        <rect x="236" y={78 + i * 62} width="188" height="32" rx="4" class="txnm-dot" />
        <text x="330" y={99 + i * 62} class="b" text-anchor="middle">{r.label}</text>
        <path d={`M430,${94 + i * 62} L482,${94 + i * 62}`} class="txnm-arrow" /><polygon points={`490,${94 + i * 62} 482,${90 + i * 62} 482,${98 + i * 62}`} class="txnm-head" />
        <text x="500" y={90 + i * 62} class="b"><tspan data-lang-en>{r.en}</tspan><tspan data-lang-vi>{r.vi}</tspan></text>
        <text x="500" y={108 + i * 62} class="note"><tspan data-lang-en>{r.n.en}</tspan><tspan data-lang-vi>{r.n.vi}</tspan></text>
      </g>
    ))}
    <text x="20" y="322" class="note"><tspan data-lang-en>Red: the name promises more than the engine delivers. Gold: it delivers more than the name suggests.</tspan><tspan data-lang-vi>Đỏ: tên hứa nhiều hơn engine làm được. Vàng: engine làm được nhiều hơn tên gợi ý.</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Read each row left to right: the engine, the name you type into the setting, and what that name really means there. Two engines share the name <code>REPEATABLE READ</code> yet differ, and Oracle's <code>SERIALIZABLE</code> is not serializable.</span>
    <span data-lang-vi>Đọc mỗi dòng từ trái sang phải: engine, tên bạn gõ vào cài đặt, và ý nghĩa thật của tên đó ở engine ấy. Hai engine dùng chung tên <code>REPEATABLE READ</code> nhưng khác nhau, còn <code>SERIALIZABLE</code> của Oracle không phải serializable.</span>
  </figcaption>
</figure>

<style>
  .txnm { margin: 2em 0; width: 100%; }
  .txnm-scroll { overflow-x: auto; }
  .txnm svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .txnm text { font-size: 13px; fill: var(--text-body); }
  .txnm .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .txnm .sec { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .txnm .sec.is-bad { fill: var(--red); }
  .txnm .b { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .txnm .m { font-size: 12.5px; fill: var(--text-body); }
  .txnm .mono { font-family: var(--font-mono, ui-monospace, monospace); font-size: 12px; }
  .txnm .note { font-size: 12px; fill: var(--text-muted); }
  .txnm .note.is-bad { fill: var(--red); font-weight: 600; }
  .txnm .note.is-ok { fill: var(--gold-icon); font-weight: 600; }
  .txnm .num { font-size: 12px; font-weight: 700; fill: var(--text); }
  .txnm-panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .txnm-panel.is-bad { stroke: var(--red); }
  .txnm-panel.is-ok { stroke: var(--gold); }
  .txnm-box { fill: var(--card-bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .txnm-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .txnm-box.is-ok { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .txnm-dot { fill: var(--card-bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .txnm-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .txnm-arrow.is-bad { stroke: var(--red); }
  .txnm-arrow.is-ok { stroke: var(--gold); }
  .txnm-dash { stroke-dasharray: 4 4; }
  .txnm-head { fill: var(--text-muted); }
  .txnm-head.is-bad { fill: var(--red); }
  .txnm-head.is-ok { fill: var(--gold); }
  .txnm-life { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .txnm figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.5; }
</style>
