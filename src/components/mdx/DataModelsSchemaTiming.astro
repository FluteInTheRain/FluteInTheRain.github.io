---
import DiagramIcon from './DiagramIcon.astro';
// Schema on read against schema on write, using Stripe's subscription field: where the shape gets checked.
// Arrowheads are polygons: no SVG ids.
const W = 900;
const H = 400;
type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}
const frames: any[] = [];
const boxes: any[] = [];
const links: any[] = [];
const labels: any[] = [];
const nums: any[] = [];
frames.push({ x: 10, y: 10, w: 880, h: 180, kind: 'bad' }, { x: 10, y: 210, w: 880, h: 180, kind: 'good' });
labels.push(
  { x: 28, y: 36, en: 'Schema on read: the database accepts any shape', vi: 'Schema on read: database nhận mọi hình dạng', cls: 'h' },
  { x: 28, y: 236, en: 'Schema on write: the database checks every write', vi: 'Schema on write: database kiểm tra mọi lần ghi', cls: 'h' },
  { x: 258, y: 139, en: 'old shape: subscription: { … }', cls: 'mono' },
  { x: 258, y: 169, en: 'new shape: subscriptions: [ … ]', cls: 'mono' },
);
boxes.push(
  { x: 28, y: 56, w: 160, h: 52, icon: 'laptop', en: ['App', 'writes any shape'], vi: ['App', 'ghi mọi hình dạng'] },
  { x: 240, y: 56, w: 300, h: 52, icon: 'db', en: ['Database', 'no check on write'], vi: ['Database', 'không kiểm tra khi ghi'] },
  { x: 244, y: 122, w: 292, h: 26, kind: 'plain', flat: true, en: [''], vi: [''] },
  { x: 244, y: 152, w: 292, h: 26, kind: 'plain', flat: true, en: [''], vi: [''] },
  { x: 600, y: 56, w: 272, h: 100, icon: 'worker', kind: 'bad', en: ['Every reader', 'handles every shape', 'ever written'], vi: ['Mọi đoạn code đọc', 'phải xử lý mọi hình dạng', 'đã từng được ghi'] },
  { x: 28, y: 262, w: 160, h: 70, icon: 'laptop', en: ['App', 'writes one shape'], vi: ['App', 'ghi một hình dạng'] },
  { x: 240, y: 258, w: 300, h: 50, icon: 'db', en: ['Database checks the shape'], vi: ['Database kiểm tra hình dạng'] },
  { x: 240, y: 322, w: 146, h: 56, icon: 'fail', kind: 'bad', en: ['Wrong shape', 'rejected'], vi: ['Sai dạng', 'bị từ chối'] },
  { x: 394, y: 322, w: 146, h: 56, icon: 'ok', kind: 'good', en: ['Right shape', 'stored'], vi: ['Đúng dạng', 'được lưu'] },
  { x: 600, y: 262, w: 272, h: 100, icon: 'worker', kind: 'good', en: ['Readers see one shape', 'but every old row had', 'to be moved to it first'], vi: ['Code đọc chỉ thấy', 'một hình dạng, nhưng mọi', 'dòng cũ phải chuyển trước'] },
);
links.push(
  { pts: [[188, 82], [240, 82]] }, { pts: [[540, 82], [600, 82]] },
  { pts: [[188, 283], [240, 283]] }, { pts: [[540, 283], [600, 283]] },
);
---
<figure class="dmst">
  <div class="dmst-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two lanes. Schema on read: the app writes any shape, the database stores both the old subscription field and the new subscriptions array, and every reader must handle every shape ever written. Schema on write: the database checks every write, a wrong shape is rejected and a right shape is stored, so readers see one shape, but every old row had to be moved first.">
    {frames.map((f) => (
      <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="6" class={`dmst-frame ${f.kind ?? ''}`} />
    ))}
    {boxes.map((b) => {
      const n = Math.max(b.en.length, b.vi.length);
      const top = !!b.top;
      const cx = b.x + b.w / 2;
      const x0 = top ? cx : b.icon ? b.x + 46 : b.x + 14;
      const y0 = top ? b.y + (b.icon ? 56 : 24) : b.y + b.h / 2 - ((n - 1) * 17) / 2 + 4;
      return (
        <g class={`dmst-box ${b.kind ?? ''}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
          {b.icon && <DiagramIcon name={b.icon} x={top ? cx : b.x + 24} y={top ? b.y + 24 : b.y + b.h / 2} size={b.is ?? 26} />}
          {Array.from({ length: n }).map((_, i) => (
            <text x={x0} y={y0 + i * 17} text-anchor={top ? 'middle' : 'start'} class={i === 0 && !b.flat ? 'dmst-name' : 'dmst-sub'}>
              <tspan data-lang-en>{b.en[i] ?? ''}</tspan>
              <tspan data-lang-vi>{b.vi[i] ?? ''}</tspan>
            </text>
          ))}
        </g>
      );
    })}
    {links.map((l) => {
      const a = arrow(l.pts);
      return (
        <g>
          <polyline points={l.plain ? l.pts.map((p) => p.join(',')).join(' ') : a.line} class={`dmst-edge ${l.kind ?? ''}`} fill="none" />
          {!l.plain && <polygon points={a.head} class={`dmst-head ${l.kind ?? ''}`} />}
        </g>
      );
    })}
    {labels.map((t) => (
      <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`dmst-lab ${t.cls ?? ''}`}>
        <tspan data-lang-en>{t.en}</tspan>
        <tspan data-lang-vi>{t.vi ?? t.en}</tspan>
      </text>
    ))}
    {nums.map((n) => (
      <g class="dmst-num">
        <circle cx={n.x} cy={n.y} r="11" />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.n}</text>
      </g>
    ))}

  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Neither lane removes the work of changing shape. Schema on read moves it into every reader; schema on write moves it into one migration.</span>
    <span data-lang-vi>Không cách nào làm mất công đổi hình dạng. Schema on read đẩy công đó vào mọi đoạn code đọc; schema on write dồn nó vào một lần migration.</span>
  </figcaption>
</figure>

<style>
  .dmst { margin: 2em 0; width: 100%; }
  .dmst-scroll { overflow-x: auto; }
  .dmst svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dmst text { font-size: 14px; fill: var(--text-body); }
  .dmst .dmst-name { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .dmst .dmst-sub { font-size: 12px; fill: var(--text-muted); }
  .dmst .dmst-lab { font-size: 13px; }
  .dmst .dmst-lab.h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dmst .dmst-lab.strong { font-weight: 700; fill: var(--text); }
  .dmst .dmst-lab.muted { fill: var(--text-muted); }
  .dmst .dmst-lab.bad { font-weight: 700; fill: var(--red); }
  .dmst .dmst-lab.good { font-weight: 700; fill: var(--text); }
  .dmst .dmst-lab.mono, .dmst .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .dmst-frame { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .dmst-frame.bad { stroke: var(--red); }
  .dmst-frame.good { stroke: var(--gold); }
  .dmst-box rect { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmst-box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dmst-box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmst-box.plain rect { fill: none; stroke: var(--border); }
  .dmst-edge { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmst-edge.bad { stroke: var(--red); }
  .dmst-edge.good { stroke: var(--gold-icon); }
  .dmst-head { fill: var(--text-muted); }
  .dmst-head.bad { fill: var(--red); }
  .dmst-head.good { fill: var(--gold-icon); }
  .dmst-num circle { fill: var(--bg-alt); stroke: var(--text-muted); }
  .dmst-num text { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dmst figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
