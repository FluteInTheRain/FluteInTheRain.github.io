---
import DiagramIcon from './DiagramIcon.astro';
// The nested GitHub GraphQL query from the post, counted in nodes, and the limits GitHub publishes (GitHub Docs).
// Arrowheads are polygons: no SVG ids.
const W = 900;
const H = 360;
type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}
const frames: any[] = [];
const boxes: any[] = [];
const links: any[] = [];
const labels: any[] = [];
const nums: any[] = [];
boxes.push(
  { x: 10, y: 30, w: 150, h: 52, icon: 'user', en: ['viewer'], vi: ['viewer'] },
  { x: 215, y: 30, w: 215, h: 52, icon: 'file', en: ['repositories', 'first: 50'], vi: ['repositories', 'first: 50'] },
  { x: 485, y: 30, w: 215, h: 52, icon: 'file', en: ['issues', 'first: 20'], vi: ['issues', 'first: 20'] },
);
links.push({ pts: [[160, 56], [215, 56]] }, { pts: [[430, 56], [485, 56]] });
labels.push(
  { x: 322, y: 106, anchor: 'middle', en: '50 nodes', vi: '50 node', cls: 'strong' },
  { x: 592, y: 106, anchor: 'middle', en: 'up to 50 × 20 = 1,000 nodes', vi: 'tối đa 50 × 20 = 1.000 node', cls: 'strong' },
  { x: 10, y: 144, en: '1,050 nodes in total. Cost: (1 + 50) requests ÷ 100, rounded = 1 point (the minimum).', vi: 'Tổng 1.050 node. Chi phí: (1 + 50) request ÷ 100, làm tròn = 1 điểm (mức tối thiểu).', cls: 'muted' },
  { x: 10, y: 182, en: 'Against the cap of 500,000 nodes per call', vi: 'So với mức trần 500.000 node mỗi lời gọi', cls: 'strong' },
  { x: 890, y: 182, anchor: 'end', en: '1,050 is about 0.2%', vi: '1.050 là khoảng 0,2%', cls: 'muted' },
  { x: 46, y: 262, en: "GitHub's published limits", vi: 'Giới hạn GitHub công bố', cls: 'h' },
);
frames.push({ x: 10, y: 192, w: 880, h: 22 });
boxes.push(
  { x: 10, y: 282, w: 208, h: 66, icon: 'index', en: ['Every list needs', 'first or last, 1 to 100'], vi: ['Mỗi list phải có', 'first hoặc last, 1–100'] },
  { x: 232, y: 282, w: 208, h: 66, icon: 'package', en: ['500,000 nodes', 'at most per call'], vi: ['500.000 node', 'tối đa mỗi lời gọi'] },
  { x: 454, y: 282, w: 208, h: 66, icon: 'chart', en: ['5,000 points', 'per user per hour'], vi: ['5.000 điểm', 'mỗi user mỗi giờ'] },
  { x: 676, y: 282, w: 214, h: 66, icon: 'stopwatch', en: ['10 seconds', 'then it is cut off'], vi: ['10 giây', 'rồi bị cắt ngang'] },
);
---
<figure class="dmgl">
  <div class="dmgl-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A query from viewer to repositories (first 50) to issues (first 20) touches 50 repositories and up to 1,000 issues, 1,050 nodes in total, a tiny sliver of the 500,000-node cap. GitHub's limits: every list needs first or last between 1 and 100, at most 500,000 nodes per call, 5,000 points per user per hour, and a request over 10 seconds is cut off.">
    {frames.map((f) => (
      <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="6" class={`dmgl-frame ${f.kind ?? ''}`} />
    ))}
    {boxes.map((b) => {
      const n = Math.max(b.en.length, b.vi.length);
      const top = !!b.top;
      const cx = b.x + b.w / 2;
      const x0 = top ? cx : b.icon ? b.x + 46 : b.x + 14;
      const y0 = top ? b.y + (b.icon ? 56 : 24) : b.y + b.h / 2 - ((n - 1) * 17) / 2 + 4;
      return (
        <g class={`dmgl-box ${b.kind ?? ''}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
          {b.icon && <DiagramIcon name={b.icon} x={top ? cx : b.x + 24} y={top ? b.y + 24 : b.y + b.h / 2} size={b.is ?? 26} />}
          {Array.from({ length: n }).map((_, i) => (
            <text x={x0} y={y0 + i * 17} text-anchor={top ? 'middle' : 'start'} class={i === 0 && !b.flat ? 'dmgl-name' : 'dmgl-sub'}>
              <tspan data-lang-en>{b.en[i] ?? ''}</tspan>
              <tspan data-lang-vi>{b.vi[i] ?? ''}</tspan>
            </text>
          ))}
        </g>
      );
    })}
    {links.map((l) => {
      const a = arrow(l.pts);
      return (
        <g>
          <polyline points={l.plain ? l.pts.map((p) => p.join(',')).join(' ') : a.line} class={`dmgl-edge ${l.kind ?? ''}`} fill="none" />
          {!l.plain && <polygon points={a.head} class={`dmgl-head ${l.kind ?? ''}`} />}
        </g>
      );
    })}
    {labels.map((t) => (
      <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`dmgl-lab ${t.cls ?? ''}`}>
        <tspan data-lang-en>{t.en}</tspan>
        <tspan data-lang-vi>{t.vi ?? t.en}</tspan>
      </text>
    ))}
    {nums.map((n) => (
      <g class="dmgl-num">
        <circle cx={n.x} cy={n.y} r="11" />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.n}</text>
      </g>
    ))}
    <rect x="10" y="192" width="3" height="22" class="dmgl-fill" />
    <DiagramIcon name="github" x={24} y={257} size={22} />
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>One query shaped like a tree of lists, counted node by node. The caps exist because the queries come from clients you do not control.</span>
    <span data-lang-vi>Một truy vấn có dạng cây các list, đếm từng node. Mức trần tồn tại vì truy vấn đến từ client mà bạn không kiểm soát được.</span>
  </figcaption>
</figure>

<style>
  .dmgl { margin: 2em 0; width: 100%; }
  .dmgl-scroll { overflow-x: auto; }
  .dmgl svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dmgl text { font-size: 14px; fill: var(--text-body); }
  .dmgl .dmgl-name { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .dmgl .dmgl-sub { font-size: 12px; fill: var(--text-muted); }
  .dmgl .dmgl-lab { font-size: 13px; }
  .dmgl .dmgl-lab.h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dmgl .dmgl-lab.strong { font-weight: 700; fill: var(--text); }
  .dmgl .dmgl-lab.muted { fill: var(--text-muted); }
  .dmgl .dmgl-lab.bad { font-weight: 700; fill: var(--red); }
  .dmgl .dmgl-lab.good { font-weight: 700; fill: var(--text); }
  .dmgl .dmgl-lab.mono, .dmgl .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .dmgl-frame { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .dmgl-frame.bad { stroke: var(--red); }
  .dmgl-frame.good { stroke: var(--gold); }
  .dmgl-box rect { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmgl-box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dmgl-box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmgl-box.plain rect { fill: none; stroke: var(--border); }
  .dmgl-edge { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmgl-edge.bad { stroke: var(--red); }
  .dmgl-edge.good { stroke: var(--gold-icon); }
  .dmgl-head { fill: var(--text-muted); }
  .dmgl-head.bad { fill: var(--red); }
  .dmgl-head.good { fill: var(--gold-icon); }
  .dmgl-num circle { fill: var(--bg-alt); stroke: var(--text-muted); }
  .dmgl-num text { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dmgl figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  .dmgl-fill { fill: var(--gold-icon); }
</style>
