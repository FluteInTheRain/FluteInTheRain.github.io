---
// Two panels: a value receiver works on a copy, a pointer receiver works on the original.
// Values match the Counter program: IncValue leaves n at 0, IncPointer makes it 1.
const W = 900;
const H = 300;
import DiagramIcon from './DiagramIcon.astro';
---
<figure class="p04b">
  <div class="p04b-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: c.IncValue() copies c, increments the copy, and the copy is thrown away, so n in main stays 0. Right: c.IncPointer() receives the address of c and increments the original, so n becomes 1.">
    <text x="20" y="26" class="h">c.IncValue()</text>
    <text x="470" y="26" class="h">c.IncPointer()</text>
    <line x1="450" x2="450" y1="10" y2="290" class="rule" />

    <DiagramIcon name="struct" x={134} y={59} size={24} />
    <text x="20" y="64" class="m"><tspan data-lang-en>c in main</tspan><tspan data-lang-vi>c trong main</tspan></text>
    <rect x="20" y="74" width="100" height="38" class="cell" />
    <rect x="120" y="74" width="80" height="38" class="cell" />
    <text x="34" y="98" class="m">n</text>
    <text x="134" y="98" class="b">0</text>
    <path d="M 70 112 L 70 178" class="ln" />
    <polygon points="70,188 64,176 76,176" class="ar" />
    <text x="84" y="154" class="m"><tspan data-lang-en>receiver gets a copy</tspan><tspan data-lang-vi>receiver nhận một bản sao</tspan></text>
    <rect x="20" y="192" width="100" height="38" class="hot" />
    <rect x="120" y="192" width="80" height="38" class="hot fm-pulse" />
    <text x="34" y="216" class="m">n</text>
    <text x="134" y="216" class="r">1</text>
    <text x="214" y="216" class="m"><tspan data-lang-en>c inside IncValue</tspan><tspan data-lang-vi>c trong IncValue</tspan></text>
    <text x="20" y="256" class="r"><tspan data-lang-en>The copy is dropped when the method returns.</tspan><tspan data-lang-vi>Bản sao bị bỏ khi method trả về.</tspan></text>
    <text x="20" y="278" class="b"><tspan data-lang-en>n in main is still 0.</tspan><tspan data-lang-vi>n trong main vẫn là 0.</tspan></text>

    <DiagramIcon name="struct" x={584} y={59} size={24} />
    <text x="470" y="64" class="m"><tspan data-lang-en>c in main</tspan><tspan data-lang-vi>c trong main</tspan></text>
    <rect x="470" y="74" width="100" height="38" class="cell" />
    <rect x="570" y="74" width="80" height="38" class="cell" />
    <text x="484" y="98" class="m">n</text>
    <text x="584" y="98" class="b">1</text>
    <path d="M 520 192 L 520 122" class="ln fm-flow" />
    <polygon points="520,112 514,124 526,124" class="ar" />
    <text x="534" y="154" class="m"><tspan data-lang-en>receiver gets the address</tspan><tspan data-lang-vi>receiver nhận địa chỉ</tspan></text>
    <rect x="470" y="192" width="200" height="38" class="cell" />
    <DiagramIcon name="label" x={644} y={211} size={24} />
    <text x="484" y="216" class="b"><tspan data-lang-en>address of c</tspan><tspan data-lang-vi>địa chỉ của c</tspan></text>
    <text x="684" y="216" class="m"><tspan data-lang-en>c inside IncPointer</tspan><tspan data-lang-vi>c trong IncPointer</tspan></text>
    <text x="470" y="256" class="b"><tspan data-lang-en>c.n++ follows the address to the original.</tspan><tspan data-lang-vi>c.n++ đi theo địa chỉ tới bản gốc.</tspan></text>
    <text x="470" y="278" class="b"><tspan data-lang-en>n in main is now 1.</tspan><tspan data-lang-vi>n trong main giờ là 1.</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>A value receiver changes its own copy of the struct. A pointer receiver is handed the address, so the change lands on the struct in main.</span>
    <span data-lang-vi>Value receiver chỉ sửa bản sao của struct. Pointer receiver được đưa địa chỉ, nên thay đổi rơi vào struct trong main.</span>
  </figcaption>
</figure>

<style>
  .p04b { margin: 2em 0; width: 100%; }
  .p04b-scroll { overflow-x: auto; }
  .p04b svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p04b text { font-size: 14px; fill: var(--text-body); }
  .p04b .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .p04b .m { fill: var(--text-muted); }
  .p04b .b { font-weight: 700; fill: var(--text); }
  .p04b .r { fill: var(--red); font-weight: 700; }
  .p04b .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .p04b .cell { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p04b .hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .p04b .dash { fill: none; stroke: var(--red); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .p04b .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .p04b .ar { fill: var(--text-muted); }
  .p04b .lnr { fill: none; stroke: var(--red); stroke-width: 1.5; }
  .p04b .arr { fill: var(--red); }
  .p04b .rule { stroke: var(--border); stroke-width: 1; }
  .p04b figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
