---
// Linearizability timeline: compares a valid linearizable execution (once Aaliyah
// reads "2-1", every later read sees "2-1") against a non-linearizable execution
// where Bryce reads a lagging replica and sees "0-0" after Aaliyah saw "2-1".
// Plain inline SVG with polygon arrowheads and site CSS tokens (no SVG marker ids).

const W = 900;
const H = 456;
const flipX = 460;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const causalOk = arrow(565, 146, 602, 182);
const causalBad = arrow(565, 366, 602, 402);
---
<figure class="clt">
  <div class="clt-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top lane: linearizable execution where an atomic flip moves score from 0-0 to 2-1, and once Aaliyah reads 2-1, Bryce's subsequent read also returns 2-1. Bottom lane: non-linearizable execution where Bryce starts a read after Aaliyah finishes yet receives stale 0-0 from a lagging replica.">
      {/* ---------- Lane 1: Linearizable ---------- */}
      <text x="20" y="24" class="clt-h">
        <tspan data-lang-en>1. Linearizable: one atomic flip point, time moves forward</tspan>
        <tspan data-lang-vi>1. Linearizable: một điểm lật nguyên tử, thời gian luôn đi tới</tspan>
      </text>
      <text x="20" y="46" class="clt-sub">
        <tspan data-lang-en>Once Aaliyah sees "2-1", Bryce's later read must also return "2-1", even before the write replies OK.</tspan>
        <tspan data-lang-vi>Khi Aaliyah đã thấy "2-1", lệnh đọc sau của Bryce cũng phải trả về "2-1", kể cả khi lệnh ghi chưa báo OK xong.</tspan>
      </text>

      {/* Flip line */}
      <line x1={flipX} x2={flipX} y1="74" y2="210" class="clt-flip" />
      <text x={flipX} y="68" text-anchor="middle" class="clt-flip-lbl">
        <tspan data-lang-en>atomic flip: 0-0 → 2-1</tspan>
        <tspan data-lang-vi>điểm lật: 0-0 → 2-1</tspan>
      </text>

      {/* Client labels */}
      <text x="20" y="107" class="clt-client">
        <tspan data-lang-en>Writer</tspan>
        <tspan data-lang-vi>Người ghi</tspan>
      </text>
      <text x="20" y="147" class="clt-client">Aaliyah</text>
      <text x="20" y="187" class="clt-client">Bryce</text>

      {/* Writer bar */}
      <rect x="150" y="88" width="585" height="28" rx="4" class="clt-bar" />
      <line x1={flipX} x2={flipX} y1="84" y2="120" class="clt-tick" />
      <text x="305" y="107" text-anchor="middle" class="clt-in">
        <tspan data-lang-en>Write(score, "2-1") → OK</tspan>
        <tspan data-lang-vi>Ghi(score, "2-1") → OK</tspan>
      </text>

      {/* Aaliyah bars */}
      <rect x="170" y="128" width="165" height="28" rx="4" class="clt-bar" />
      <line x1="252" x2="252" y1="124" y2="160" class="clt-tick-muted" />
      <text x="252" y="147" text-anchor="middle" class="clt-in">
        <tspan data-lang-en>Read → "0-0"</tspan>
        <tspan data-lang-vi>Đọc → "0-0"</tspan>
      </text>

      <rect x="420" y="128" width="145" height="28" rx="4" class="clt-bar is-new" />
      <line x1="498" x2="498" y1="124" y2="160" class="clt-tick" />
      <text x="492" y="147" text-anchor="middle" class="clt-in is-new">
        <tspan data-lang-en>Read → "2-1"</tspan>
        <tspan data-lang-vi>Đọc → "2-1"</tspan>
      </text>

      {/* Bryce bar */}
      <rect x="602" y="168" width="148" height="28" rx="4" class="clt-bar is-new" />
      <line x1="676" x2="676" y1="164" y2="200" class="clt-tick" />
      <text x="676" y="187" text-anchor="middle" class="clt-in is-new">
        <tspan data-lang-en>Read → "2-1"</tspan>
        <tspan data-lang-vi>Đọc → "2-1"</tspan>
      </text>
      <text x="760" y="187" class="clt-note">
        <tspan data-lang-en>after Aaliyah</tspan>
        <tspan data-lang-vi>sau Aaliyah</tspan>
      </text>

      {/* Causal arrow */}
      <path d={causalOk.line} class="clt-arrow" /><polygon points={causalOk.head} class="clt-head" />

      <text x="150" y="220" class="clt-axis">
        <tspan data-lang-en>valid order of points: 252 → 460 → 498 → 676 (strictly left to right)</tspan>
        <tspan data-lang-vi>thứ tự điểm lật hợp lệ: 252 → 460 → 498 → 676 (luôn đi từ trái sang phải)</tspan>
      </text>

      {/* ---------- Divider ---------- */}
      <line x1="20" x2={W - 20} y1="238" y2="238" class="clt-rule" />

      {/* ---------- Lane 2: Non-linearizable ---------- */}
      <text x="20" y="266" class="clt-h">
        <tspan data-lang-en>2. Not linearizable: Bryce reads stale data from a lagging replica</tspan>
        <tspan data-lang-vi>2. Không linearizable: Bryce đọc phải dữ liệu cũ từ replica trễ</tspan>
      </text>
      <text x="20" y="288" class="clt-sub">
        <tspan data-lang-en>Bryce starts after Aaliyah's read finished, yet sees "0-0". No valid left-to-right flip order exists.</tspan>
        <tspan data-lang-vi>Bryce bắt đầu đọc sau khi Aaliyah đã xong, nhưng lại thấy "0-0". Không có thứ tự điểm lật nào hợp lệ.</tspan>
      </text>

      <line x1={flipX} x2={flipX} y1="306" y2="426" class="clt-flip" />

      <text x="20" y="327" class="clt-client">
        <tspan data-lang-en>Writer</tspan>
        <tspan data-lang-vi>Người ghi</tspan>
      </text>
      <text x="20" y="367" class="clt-client">Aaliyah</text>
      <text x="20" y="407" class="clt-client">Bryce</text>

      <rect x="150" y="308" width="585" height="28" rx="4" class="clt-bar" />
      <line x1={flipX} x2={flipX} y1="304" y2="340" class="clt-tick" />
      <text x="305" y="327" text-anchor="middle" class="clt-in">
        <tspan data-lang-en>Write(score, "2-1") → OK</tspan>
        <tspan data-lang-vi>Ghi(score, "2-1") → OK</tspan>
      </text>

      <rect x="420" y="348" width="145" height="28" rx="4" class="clt-bar is-new" />
      <line x1="498" x2="498" y1="344" y2="380" class="clt-tick" />
      <text x="492" y="367" text-anchor="middle" class="clt-in is-new">
        <tspan data-lang-en>Read → "2-1"</tspan>
        <tspan data-lang-vi>Đọc → "2-1"</tspan>
      </text>

      <rect x="602" y="388" width="160" height="28" rx="4" class="clt-bar is-bad" />
      <text x="682" y="407" text-anchor="middle" class="clt-in is-bad">
        <tspan data-lang-en>Read → "0-0" ✕</tspan>
        <tspan data-lang-vi>Đọc → "0-0" ✕</tspan>
      </text>
      <text x="772" y="407" class="clt-bad-note">
        <tspan data-lang-en>stale read</tspan>
        <tspan data-lang-vi>đọc dữ liệu cũ</tspan>
      </text>

      <path d={causalBad.line} class="clt-arrow is-bad" /><polygon points={causalBad.head} class="clt-head is-bad" />

      <text x="150" y="442" class="clt-bad-axis">
        <tspan data-lang-en>violates recency: returning "0-0" places Bryce before the flip (t &lt; 460), after Aaliyah finished at 565</tspan>
        <tspan data-lang-vi>vi phạm tính mới nhất: trả về "0-0" đẩy Bryce về trước điểm lật (t &lt; 460), dù Aaliyah đã xong lúc 565</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Operation bars span from request send to response arrival. Linearizability requires a single point inside each bar where it atomically takes effect, arranged left to right without ever stepping backward in real time.</span>
    <span data-lang-vi>Mỗi thanh kéo dài từ lúc gửi request tới lúc nhận phản hồi. Tính khả tuyến tính (linearizability) đòi hỏi tồn tại một điểm bên trong mỗi thanh để thao tác có hiệu lực nguyên tử, xếp nối tiếp từ trái sang phải mà không bao giờ đi lùi theo thời gian thực.</span>
  </figcaption>
</figure>

<style>
  .clt {
    margin: 2em 0;
    width: 100%;
  }
  .clt-scroll {
    overflow-x: auto;
  }
  .clt svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .clt text {
    font-size: 14px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .clt .clt-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .clt .clt-sub,
  .clt .clt-note,
  .clt .clt-axis {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .clt .clt-client {
    font-weight: 600;
    fill: var(--text);
  }
  .clt-rule {
    stroke: var(--border);
  }
  .clt-flip {
    stroke: var(--red);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .clt .clt-flip-lbl {
    font-size: 12.5px;
    font-weight: 700;
    fill: var(--red);
  }
  .clt-bar {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .clt-bar.is-new {
    fill: var(--bg-alt);
    stroke: var(--text);
    stroke-width: 1.6;
  }
  .clt-bar.is-bad {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.8;
  }
  .clt-tick {
    stroke: var(--red);
    stroke-width: 2.2;
  }
  .clt-tick-muted {
    stroke: var(--text-muted);
    stroke-width: 2;
  }
  .clt .clt-in {
    font-size: 13px;
    fill: var(--text-body);
  }
  .clt .clt-in.is-new {
    font-weight: 600;
    fill: var(--text);
  }
  .clt .clt-in.is-bad {
    font-weight: 700;
    fill: var(--red);
  }
  .clt .clt-bad-note,
  .clt .clt-bad-axis {
    font-size: 13px;
    font-weight: 600;
    fill: var(--red);
  }
  .clt-arrow {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.4;
  }
  .clt-head {
    fill: var(--text-muted);
  }
  .clt-arrow.is-bad {
    stroke: var(--red);
  }
  .clt-head.is-bad {
    fill: var(--red);
  }
  .clt figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
