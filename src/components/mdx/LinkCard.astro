---
interface Props {
  url: string;
  title: string;
  description?: string;
  domain?: string;
  tag?: string;
}
const { url, title, description, domain, tag } = Astro.props;
let host = domain;
if (!host) {
  try {
    host = new URL(url).hostname.replace(/^www\./, '');
  } catch {
    host = url;
  }
}
---
<a class="link-card" href={url} rel="noopener" target="_blank">
  <span class="link-card-meta">
    <span class="link-card-domain">{host}</span>
    {tag && <span class="link-card-tag">{tag}</span>}
  </span>
  <span class="link-card-title">{title} <span aria-hidden="true">&#8599;</span></span>
  {description && <span class="link-card-desc">{description}</span>}
</a>