---
// The Facebook outage of Oct 4, 2021 as a causal chain: maintenance command,
// BGP routes withdrawn, authoritative DNS unreachable, everything dark.
const W = 900, H = 270;
const xs = [20, 250, 480, 710];
function head(x: number, y: number) {
  return `${x},${y} ${x - 9},${y - 4.5} ${x - 9},${y + 4.5}`;
}
---
<figure class="bep1n1">
  <div class="bep1n1-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Timeline of the Facebook outage on October 4, 2021: a maintenance command took down the backbone, Facebook's DNS servers withdrew their own BGP advertisements and vanished from the internet map, apps and internal tools went dark, and for hours no request ever arrived.">
    <text x="20" y="28" class="m"><tspan data-lang-en>October 4, 2021</tspan><tspan data-lang-vi>Ngày 4 tháng 10 năm 2021</tspan></text>
    {xs.map((x) => <rect x={x} y="50" width="170" height="76" rx="8" class="box" />)}
    <text x="105" y="82" text-anchor="middle" class="t"><tspan data-lang-en>Maintenance</tspan><tspan data-lang-vi>Lệnh bảo trì</tspan></text>
    <text x="105" y="102" text-anchor="middle" class="m"><tspan data-lang-en>command</tspan><tspan data-lang-vi>chạy xong</tspan></text>
    <text x="335" y="82" text-anchor="middle" class="t"><tspan data-lang-en>Backbone down,</tspan><tspan data-lang-vi>Backbone đứt,</tspan></text>
    <text x="335" y="102" text-anchor="middle" class="m"><tspan data-lang-en>BGP withdrawn</tspan><tspan data-lang-vi>BGP bị rút</tspan></text>
    <text x="565" y="82" text-anchor="middle" class="t"><tspan data-lang-en>Authoritative DNS</tspan><tspan data-lang-vi>DNS authoritative</tspan></text>
    <text x="565" y="102" text-anchor="middle" class="m"><tspan data-lang-en>gone from the map</tspan><tspan data-lang-vi>mất khỏi bản đồ</tspan></text>
    <text x="795" y="82" text-anchor="middle" class="t"><tspan data-lang-en>Everything dark</tspan><tspan data-lang-vi>Tất cả tắt</tspan></text>
    <text x="795" y="102" text-anchor="middle" class="m"><tspan data-lang-en>apps, internal tools</tspan><tspan data-lang-vi>app, tool nội bộ</tspan></text>
    {[190, 420, 650].map((x) => <g><path d={`M ${x + 6} 88 L ${x + 44} 88`} class="ln" /><polygon points={head(x + 52, 88)} class="hd" /></g>)}
    <path d="M 20 176 L 880 176" class="bar" />
    <path d="M 20 166 L 20 186" class="tick" />
    <path d="M 880 166 L 880 186" class="tick" />
    <text x="450" y="212" text-anchor="middle" class="r"><tspan data-lang-en>hours of downtime: no request ever arrived</tspan><tspan data-lang-vi>nhiều giờ ngừng: không request nào tới được</tspan></text>
    <text x="450" y="240" text-anchor="middle" class="m"><tspan data-lang-en>No line of their code ran badly. The chain broke before the code.</tspan><tspan data-lang-vi>Không dòng code nào chạy sai. Chuỗi đứt trước khi tới code.</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>One maintenance command, four links, hours without a single request.</span>
    <span data-lang-vi>Một lệnh bảo trì, bốn mắt xích, nhiều giờ không một request.</span>
  </figcaption>
</figure>

<style>
  .bep1n1 { margin: 2em 0; width: 100%; }
  .bep1n1-scroll { overflow-x: auto; }
  .bep1n1 svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep1n1 text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep1n1 .t { font-weight: 700; fill: var(--text); }
  .bep1n1 .m { fill: var(--text-muted); font-size: 13px; }
  .bep1n1 .r { fill: var(--red); font-weight: 700; font-size: 15px; }
  .bep1n1 .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep1n1 .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep1n1 .hd { fill: var(--text-muted); }
  .bep1n1 .bar { stroke: var(--red); stroke-width: 3; fill: none; }
  .bep1n1 .tick { stroke: var(--red); stroke-width: 2; fill: none; }
  .bep1n1 figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
