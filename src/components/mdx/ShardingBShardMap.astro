---
// Picture-first: a routing layer looks the shard up in a shard map, then sends the request to its owner. Illustrative values.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
type Lbl = { x: number; y: number; c: string; en: string[]; vi: string[]; a?: string; lh?: number };
const W = 900;
const H = 304;
const rows = [
  { shard: 16, node: 'A', y: 66, on: false },
  { shard: 17, node: 'B', y: 128, on: true },
  { shard: 18, node: 'C', y: 190, on: false },
];
const toClient = arrow(170, 150, 288, 150);
const toNode = rows.map((r) => arrow(540, r.y + 22, 678, r.y + 22));
const labels: Lbl[] = [
  { x: 415, y: 52, c: 'b', en: ['Shard map'], vi: ['Bản đồ shard'] },
  { x: 229, y: 128, c: 'sub', en: ['user_42 is', 'in shard 17'], vi: ['user_42 nằm', 'trong shard 17'], lh: 14 },
  { x: 609, y: 120, c: 'sub is-gold', en: ['node B owns it'], vi: ['node B giữ shard'] },
  { x: 450, y: 282, c: 'note', en: ['Whoever routes the request must hold this map, and keep it current'], vi: ['Bên định tuyến phải nắm bản đồ này và giữ cho nó luôn mới'] },
];
---
<figure class="shbm2">
  <div class="shbm2-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A client asks for user_42. The shard map says user_42 is in shard 17, and shard 17 lives on node B, so the request is sent to node B. Nodes A and C hold other shards.">
      <rect x="20" y="128" width="150" height="44" rx="6" class="box" />
      <DiagramIcon name="laptop" x={46} y={150} size={26} />
      <text x="70" y="146" class="b" data-lang-en>Client</text><text x="70" y="146" class="b" data-lang-vi>Client</text>
      <text x="70" y="162" class="s">get user_42</text>
      <path d={toClient.line} class="arrow is-strong" /><polygon points={toClient.head} class="head is-strong" />

      <rect x="290" y="62" width="250" height="196" rx="8" class="rule" />
      {rows.map((r) => (
        <g>
          <rect x="304" y={r.y} width="222" height="44" rx="6" class={r.on ? 'box is-gold' : 'box is-dim'} />
          <text x="322" y={r.y + 27} class={r.on ? 'b' : 's'}>{`shard ${r.shard}`}</text>
          <text x="508" y={r.y + 27} text-anchor="end" class={r.on ? 'b' : 's'}>{`node ${r.node}`}</text>
        </g>
      ))}
      {rows.map((r, i) => (
        <g>
          <path d={toNode[i].line} class={r.on ? 'arrow is-gold' : 'arrow'} />
          <polygon points={toNode[i].head} class={r.on ? 'head is-gold' : 'head'} />
          <rect x="680" y={r.y} width="200" height="44" rx="6" class={r.on ? 'box is-gold' : 'box is-dim'} />
          <DiagramIcon name="server" x={706} y={r.y + 22} size={26} />
          <text x="732" y={r.y + 27} class={r.on ? 'b' : 's'}>{`Node ${r.node}`}</text>
        </g>
      ))}
      {labels.map((l) => (
        <>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-en>{l.en.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-vi>{l.vi.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
        </>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The lookup every router, proxy or smart client performs: key to shard, shard to node. The rest of this section is about where that map lives and how it stays right.</span>
    <span data-lang-vi>Bước tra cứu mà mọi router, proxy hay smart client đều làm: khoá sang shard, shard sang node. Phần còn lại của mục này nói về chỗ đặt bản đồ và cách giữ nó đúng.</span>
  </figcaption>
</figure>

<style>
  .shbm2 { margin: 2em 0; width: 100%; }
  .shbm2-scroll { overflow-x: auto; }
  .shbm2 svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shbm2 text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shbm2 .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shbm2 .h.is-hot { fill: var(--red); }
  .shbm2 .h.is-gold { fill: var(--gold-icon); }
  .shbm2 .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shbm2 .sub.is-gold { fill: var(--gold-icon); font-weight: 600; }
  .shbm2 .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shbm2 .b.is-hot { fill: var(--red); }
  .shbm2 .s { font-size: 12px; fill: var(--text-body); }
  .shbm2 .s.is-hot { fill: var(--red); font-weight: 600; }
  .shbm2 .note { font-size: 13px; font-weight: 600; fill: var(--text); }
  .shbm2 .note.is-hot { fill: var(--red); }
  .shbm2 .note.is-gold { fill: var(--gold-icon); }
  .shbm2 .num { font-size: 11px; font-weight: 700; fill: var(--text); }
  .shbm2 .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbm2 .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shbm2 .box.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .shbm2 .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shbm2 .box.is-dim { opacity: 0.5; }
  .shbm2 .circ { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbm2 .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shbm2 .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shbm2 .arrow.is-hot { stroke: var(--red); }
  .shbm2 .arrow.is-gold { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shbm2 .arrow.is-strong { stroke: var(--text); stroke-width: 1.7; }
  .shbm2 .arrow.is-dash { stroke-dasharray: 5 4; }
  .shbm2 .head { fill: var(--text-muted); }
  .shbm2 .head.is-hot { fill: var(--red); }
  .shbm2 .head.is-gold { fill: var(--gold-icon); }
  .shbm2 .head.is-strong { fill: var(--text); }
  .shbm2 figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>

