---
// Dot strip comparison of two real 10-run Go 1.27.1 benchstat datasets:
// Top: AtomicStore32 vs AtomicStore64 (overlapping distributions -> ~ p=0.853)
// Bottom: EncodeTodos/items=10 v1 vs v2 (separated distributions -> -37.30% p=0.000)

const a32 = [4.798, 2.173, 2.168, 2.141, 2.062, 2.103, 2.112, 2.076, 2.044, 2.050];
const a64 = [2.419, 2.104, 2.061, 2.347, 2.066, 2.037, 2.034, 2.102, 2.117, 2.300];
const v1 = [1629, 1585, 1687, 1626, 1701, 1690, 1608, 1705, 1594, 1465];
const v2 = [1007, 973.4, 1021, 1022, 996.3, 1031, 1040, 977.8, 1020, 1300];

const W = 900;
const H = 398;
const xLeft = 175;
const xRight = 720;

// Top chart scale: 1.8 ns .. 5.0 ns
const xTop = (v: number) => xLeft + ((v - 1.8) / (5.0 - 1.8)) * (xRight - xLeft);
// Bottom chart scale: 900 ns .. 1800 ns
const xBot = (v: number) => xLeft + ((v - 900) / (1800 - 900)) * (xRight - xLeft);
---
<figure class="gp17d">
  <div class="gp17d-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two 10-run Go 1.27.1 benchmark dot plots compared by benchstat. Top: AtomicStore32 and AtomicStore64 overlap around 2.10 ns/op, so benchstat prints tilde with p=0.853. Bottom: EncodeTodos v2 clusters tightly at 1020 ns/op completely below v1 at 1628 ns/op, so benchstat proves a -37.30% speedup with p=0.000.">
    {/* ---------- Panel 1: Overlapping noise (~) ---------- */}
    <text x="20" y="24" class="h">
      <tspan data-lang-en>1. Overlapping runs: benchstat refuses to pick a winner (~ p=0.853)</tspan>
      <tspan data-lang-vi>1. Hai cụm chấm chồng lên nhau: benchstat báo ~ (p=0.853, chưa kết luận)</tspan>
    </text>

    {/* Gridlines top */}
    {[2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0].map((t) => (
      <g>
        <line x1={xTop(t)} x2={xTop(t)} y1="42" y2="134" class="grid" />
        <text x={xTop(t)} y="152" text-anchor="middle" class="s num">{t.toFixed(1)}</text>
      </g>
    ))}
    <text x={xRight + 10} y="152" class="s">ns/op</text>

    {/* Labels */}
    <text x="20" y="64" class="b">AtomicStore32</text>
    <text x="20" y="84" class="s num">med 2.107 ns ± 3%</text>
    <text x="20" y="112" class="b">AtomicStore64</text>
    <text x="20" y="132" class="s num">med 2.103 ns ± 12%</text>

    {/* Median ticks */}
    <line x1={xTop(2.107)} x2={xTop(2.107)} y1="50" y2="76" class="medline" />
    <line x1={xTop(2.103)} x2={xTop(2.103)} y1="98" y2="124" class="medline" />

    {/* Points top */}
    {a32.map((v, i) => (
      <circle cx={xTop(v)} cy={63 + ((i % 3) - 1) * 4} r="4.2" class={v > 3 ? 'dot-hot' : 'dot-base'} />
    ))}
    {a64.map((v, i) => (
      <circle cx={xTop(v)} cy={111 + ((i % 3) - 1) * 4} r="4.2" class="dot-base" />
    ))}

    {/* Callout badge box on right */}
    <rect x="742" y="56" width="138" height="64" rx="6" class="hot" />
    <text x="811" y="82" text-anchor="middle" class="r num">~ (p=0.853)</text>
    <text x="811" y="104" text-anchor="middle" class="s">
      <tspan data-lang-en>noise, n=10+10</tspan>
      <tspan data-lang-vi>nhiễu nền, n=10</tspan>
    </text>

    <line x1="20" x2="880" y1="180" y2="180" class="rule" />

    {/* ---------- Panel 2: Clean separation (p=0.000) ---------- */}
    <text x="20" y="210" class="h">
      <tspan data-lang-en>2. Separated runs: EncodeTodos/items=10 drops -37.30% (p=0.000)</tspan>
      <tspan data-lang-vi>2. Hai cụm tách rời hẳn: EncodeTodos/items=10 giảm 37,30% (p=0.000)</tspan>
    </text>

    {[900, 1100, 1300, 1500, 1700].map((t) => (
      <g>
        <line x1={xBot(t)} x2={xBot(t)} y1="228" y2="320" class="grid" />
        <text x={xBot(t)} y="338" text-anchor="middle" class="s num">{t}</text>
      </g>
    ))}
    <text x={xRight + 10} y="338" class="s">ns/op</text>

    {/* Labels */}
    <text x="20" y="250" class="b">v1 · json.NewEncoder</text>
    <text x="20" y="270" class="s num">med 1628 ns ± 5%</text>
    <text x="20" y="298" class="b">v2 · pre-sized []byte</text>
    <text x="20" y="318" class="s num">med 1020 ns ± 4%</text>

    {/* Median lines */}
    <line x1={xBot(1628)} x2={xBot(1628)} y1="236" y2="262" class="medline" />
    <line x1={xBot(1020)} x2={xBot(1020)} y1="284" y2="310" class="goldmed" />

    {/* Points bottom */}
    {v1.map((v, i) => (
      <circle cx={xBot(v)} cy={249 + ((i % 3) - 1) * 4} r="4.2" class="dot-base" />
    ))}
    {v2.map((v, i) => (
      <circle cx={xBot(v)} cy={297 + ((i % 3) - 1) * 4} r="4.2" class="dot-gold" />
    ))}

    <rect x="742" y="242" width="138" height="64" rx="6" class="goldbox" />
    <text x="811" y="268" text-anchor="middle" class="b num">-37.30%</text>
    <text x="811" y="290" text-anchor="middle" class="s num">p=0.000 · n=10</text>

    {/* Bottom footnote axis title */}
    <text x="450" y="376" text-anchor="middle" class="m">
      <tspan data-lang-en>Each circle is one run from -count=10 (vertical bar marks the median)</tspan>
      <tspan data-lang-vi>Mỗi chấm tròn là 1 trong 10 lần chạy -count=10 (vạch đứng là số trung vị)</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Every dot is an actual Go 1.27.1 measurement from this post. Notice how AtomicStore32 had one cold outlier at 4.798 ns while the medians sit 0.004 ns apart (~ p=0.853); by contrast, every v2 EncodeTodos run beats the fastest v1 run (p=0.000).</span>
    <span data-lang-vi>Mỗi chấm là một lần đo thật trên Go 1.27.1. AtomicStore32 có một phát lệch lạnh 4,798 ns nhưng hai trung vị cách nhau đúng 0,004 ns (~ p=0.853); ngược lại cả 10 lượt v2 EncodeTodos đều nhanh hơn cả lượt nhanh nhất của v1 (p=0.000).</span>
  </figcaption>
</figure>

<style>
  .gp17d { margin: 2em 0; width: 100%; }
  .gp17d-scroll { overflow-x: auto; }
  .gp17d svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp17d text { font-size: 14px; fill: var(--text-body); }
  .gp17d .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp17d .b { font-weight: 700; fill: var(--text); }
  .gp17d .m { font-size: 13.5px; fill: var(--text-muted); }
  .gp17d .s { font-size: 12.5px; fill: var(--text-muted); }
  .gp17d .r { font-weight: 700; fill: var(--red); }
  .gp17d .num { font-variant-numeric: tabular-nums; }
  .gp17d .grid { stroke: var(--border); stroke-width: 1; }
  .gp17d .rule { stroke: var(--border); stroke-width: 1; }
  .gp17d .medline { stroke: var(--text); stroke-width: 2; }
  .gp17d .goldmed { stroke: var(--gold); stroke-width: 2.2; }
  .gp17d .dot-base { fill: var(--text-muted); opacity: 0.85; }
  .gp17d .dot-hot { fill: var(--red); }
  .gp17d .dot-gold { fill: var(--gold); }
  .gp17d .hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; }
  .gp17d .goldbox { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.2; }
  .gp17d figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
