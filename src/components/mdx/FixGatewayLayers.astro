---
// The five layers inside a FIX gateway, top to bottom in the order a message passes them,
// with what each layer catches on the right. Inline SVG, site tokens, polygon arrowheads (no ids).

const W = 900;
const boxX = 20;
const boxW = W - 40;
const boxH = 66;
const gap = 26;
const top = 58;
const divX = 580;

const layers = [
  {
    en: 'Network and socket I/O', vi: 'Mạng và socket I/O',
    dEn: 'epoll / kqueue event loop, TLS, buffers bytes until 10=xxx closes a frame',
    dVi: 'vòng lặp sự kiện epoll / kqueue, TLS, gom byte tới khi 10=xxx đóng gói tin',
    cEn: 'only half a frame so far?', cVi: 'mới nhận được nửa gói tin?',
    rEn: '→ wait for the rest', rVi: '→ chờ nhận đủ',
  },
  {
    en: 'Session state and message store', vi: 'Trạng thái phiên và message store',
    dEn: 'tracks ExpectedInSeqNum / NextOutSeqNum, journals every message (WAL)',
    dVi: 'giữ ExpectedInSeqNum / NextOutSeqNum, ghi mọi tin nhắn xuống nhật ký (WAL)',
    cEn: 'a gap in MsgSeqNum?', cVi: 'MsgSeqNum bị hụt số?',
    rEn: '→ ResendRequest (35=2)', rVi: '→ ResendRequest (35=2)',
  },
  {
    en: 'Parser and data dictionary', vi: 'Parser và data dictionary',
    dEn: 'checks required tags, data types and CheckSum against the agreed FIX version',
    dVi: 'kiểm tra tag bắt buộc, kiểu dữ liệu, CheckSum theo phiên bản FIX đã thống nhất',
    cEn: 'malformed, or a bad CheckSum?', cVi: 'sai cú pháp hoặc sai CheckSum?',
    rEn: '→ Session Reject (35=3)', rVi: '→ Session Reject (35=3)',
  },
  {
    en: 'Throttle and pre-trade gate', vi: 'Throttle và chốt kiểm tra trước giao dịch',
    dEn: 'token-bucket rate limit per CompID, account whitelist, fat-finger filter',
    dVi: 'giới hạn tần suất theo CompID, whitelist tài khoản, lọc lỗi gõ nhầm',
    cEn: 'too fast, wrong account, absurd size?', cVi: 'quá nhanh, sai tài khoản, giá vô lý?',
    rEn: '→ rejected at the door', rVi: '→ chặn ngay tại cửa',
  },
  {
    en: 'IPC bridge and binary transcoder', vi: 'IPC bridge và chuyển sang nhị phân',
    dEn: 'turns FIX text into SBE or another binary format, publishes it on a ring buffer',
    dVi: 'đổi FIX dạng text sang SBE hoặc nhị phân khác, đẩy lên ring buffer',
    cEn: 'only clean orders reach this layer', cVi: 'chỉ lệnh hợp lệ mới tới được đây',
    rEn: '→ handed to the systems inside', rVi: '→ chuyển vào hệ thống bên trong',
    clean: true,
  },
];

const boxY = (i: number) => top + i * (boxH + gap);
const lastBottom = boxY(layers.length - 1) + boxH;
const H = lastBottom + 52;

function downArrow(x: number, y1: number, y2: number) {
  return {
    line: `M ${x} ${y1} L ${x} ${y2 - 7}`,
    head: `${x},${y2} ${x - 5},${y2 - 9} ${x + 5},${y2 - 9}`,
  };
}
const arrowX = 300;
const arrows = [
  downArrow(arrowX, 28, top),
  ...layers.slice(1).map((_, i) => downArrow(arrowX, boxY(i) + boxH, boxY(i + 1))),
  downArrow(arrowX, lastBottom, lastBottom + 24),
];
---
<figure class="fixlayers">
  <div class="fixlayers-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Five layers stacked top to bottom: network and socket I/O, session state and message store, parser and data dictionary, throttle and pre-trade gate, IPC bridge and binary transcoder. Each layer stops a different kind of bad input: incomplete frames wait, sequence gaps trigger a ResendRequest, malformed messages get a Session Reject, floods and bad orders are rejected, and only clean orders reach the inside.">
      <text x={arrowX + 14} y="22" class="fixlayers-io">
        <tspan data-lang-en>raw TCP bytes from clients</tspan>
        <tspan data-lang-vi>byte TCP thô từ client</tspan>
      </text>
      <text x={divX + 16} y={top - 10} class="fixlayers-colhead">
        <tspan data-lang-en>What it catches</tspan>
        <tspan data-lang-vi>Bắt được gì</tspan>
      </text>

      {arrows.map((a) => (
        <g class="fixlayers-arrow"><path d={a.line} /><polygon points={a.head} /></g>
      ))}

      {layers.map((l, i) => {
        const y = boxY(i);
        return (
          <g class="fixlayers-layer">
            <rect x={boxX} y={y} width={boxW} height={boxH} rx="8" />
            <text x={boxX + 16} y={y + 27} class="fixlayers-name">
              <tspan class="fixlayers-num">{i + 1}</tspan>
              <tspan dx="10" data-lang-en>{l.en}</tspan>
              <tspan dx="10" data-lang-vi>{l.vi}</tspan>
            </text>
            <text x={boxX + 16} y={y + 50} class="fixlayers-detail">
              <tspan data-lang-en>{l.dEn}</tspan>
              <tspan data-lang-vi>{l.dVi}</tspan>
            </text>
            <line x1={divX} x2={divX} y1={y + 12} y2={y + boxH - 12} class="fixlayers-div" />
            <text x={divX + 16} y={y + 27} class={l.clean ? 'fixlayers-catch is-clean' : 'fixlayers-catch'}>
              <tspan data-lang-en>{l.cEn}</tspan>
              <tspan data-lang-vi>{l.cVi}</tspan>
            </text>
            <text x={divX + 16} y={y + 49} class={l.clean ? 'fixlayers-result is-clean' : 'fixlayers-result'}>
              <tspan data-lang-en>{l.rEn}</tspan>
              <tspan data-lang-vi>{l.rVi}</tspan>
            </text>
          </g>
        );
      })}

      <text x={arrowX + 14} y={H - 10} class="fixlayers-io">
        <tspan data-lang-en>binary message to the OMS or matching engine</tspan>
        <tspan data-lang-vi>tin nhị phân tới OMS hoặc matching engine</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A message goes through the five layers in order, and each one filters out a different kind of trouble. By the time an order reaches the bridge at the bottom, it is complete, in sequence, well-formed and allowed.</span>
    <span data-lang-vi>Tin nhắn đi qua năm tầng theo đúng thứ tự, mỗi tầng lọc một loại rắc rối khác nhau. Khi lệnh xuống tới tầng bridge ở dưới cùng, nó đã đủ byte, đúng thứ tự, đúng cú pháp và được phép giao dịch.</span>
  </figcaption>
</figure>

<style>
  .fixlayers {
    margin: 2em 0;
    width: 100%;
  }
  .fixlayers-scroll {
    overflow-x: auto;
  }
  .fixlayers svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .fixlayers text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .fixlayers-layer rect {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .fixlayers .fixlayers-name {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .fixlayers .fixlayers-num {
    fill: var(--red);
    font-variant-numeric: tabular-nums;
  }
  .fixlayers .fixlayers-detail {
    font-size: 13.5px;
    fill: var(--text-muted);
  }
  .fixlayers-div {
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .fixlayers .fixlayers-colhead {
    font-weight: 600;
    fill: var(--text-muted);
  }
  .fixlayers .fixlayers-catch {
    font-size: 13.5px;
  }
  .fixlayers .fixlayers-result {
    font-size: 13.5px;
    font-weight: 700;
    fill: var(--red);
  }
  .fixlayers .fixlayers-catch.is-clean,
  .fixlayers .fixlayers-result.is-clean {
    fill: var(--text-muted);
    font-weight: 400;
  }
  .fixlayers .fixlayers-io {
    fill: var(--text-muted);
  }
  .fixlayers-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .fixlayers-arrow polygon {
    fill: var(--text-muted);
  }
  .fixlayers figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
