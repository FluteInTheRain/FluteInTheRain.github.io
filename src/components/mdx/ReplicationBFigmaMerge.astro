---
// Figma: the server defines the order, so the last value to reach it wins per property.
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Arrow from './ReplicationBArrow.astro';
import Bi from './ReplicationBBi.astro';
---
<Frame h={330}
  label="A text property is B. Client 1 changes it to AB, client 2 changes it to BC. The server receives AB first and BC second and keeps the last one, so everyone ends with BC, never ABC. Changes to different properties never conflict."
  cap="The server's arrival order is the clock, so no timestamp is needed. One of the two edits is lost, but the document always ends the same everywhere."
  capVi="Thứ tự tới server chính là đồng hồ, nên không cần timestamp. Một trong hai chỉnh sửa bị mất, nhưng tài liệu luôn giống nhau ở mọi nơi.">
  <Node x={20} y={30} w={220} h={70} icon="laptop" t="Client 1" tv="Client 1" s="changes B to AB" sv="đổi B thành AB" />
  <Node x={20} y={200} w={220} h={70} icon="laptop" t="Client 2" tv="Client 2" s="changes B to BC" sv="đổi B thành BC" />
  <Node x={370} y={100} w={260} h={110} icon="figma" t="Server" tv="Server" s="text = B" sv="text = B" s2="receives AB, then BC" s2v="nhận AB, rồi BC" cls="strong" />
  <Arrow x1={240} y1={65} x2={370} y2={130} />
  <text x="276" y="74" class="rb-step"><Bi en="1. arrives first" vi="1. tới trước" /></text>
  <Arrow x1={240} y1={235} x2={370} y2={180} />
  <text x="272" y="252" class="rb-step"><Bi en="2. arrives second" vi="2. tới sau" /></text>
  <Arrow x1={630} y1={155} x2={710} y2={155} cls="gold" />
  <Node x={710} y={100} w={170} h={110} icon="ok" t="Everyone sees" tv="Mọi người thấy" s="text = BC" sv="text = BC" s2="never ABC" s2v="không bao giờ ABC" cls="gold" />
  <text x="450" y="312" text-anchor="middle" class="rb-n"><Bi en="Two people changing different properties of the same object do not conflict at all." vi="Hai người đổi các thuộc tính khác nhau của cùng một object thì không xung đột chút nào." /></text>
</Frame>
