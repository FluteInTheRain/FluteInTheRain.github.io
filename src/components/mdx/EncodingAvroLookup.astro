---
import EncodingStepCards from './EncodingStepCards.astro';
const props = {
 "arrows": false,
 "title": {
  "en": "Where the reader finds the writer's schema",
  "vi": "Bên đọc tìm schema của bên ghi ở đâu"
 },
 "alt": "Three places an Avro reader gets the writer's schema. In a file of records written together the schema is stored once in the file header. In a database with records written over years each record starts with a schema version number and the schemas live in a table or a registry such as Confluent's Schema Registry. On a network connection both sides agree on the schema when it opens.",
 "cards": [
  {
   "icon": "file",
   "head": {
    "en": [
     "A file of records"
    ],
    "vi": [
     "Một file bản ghi"
    ]
   },
   "lines": {
    "en": [
     "The schema is stored once,",
     "in the file header."
    ],
    "vi": [
     "Schema được lưu một lần,",
     "ở header của file."
    ]
   },
   "tone": "plain",
   "mono": [
    "[schema][rec][rec][rec]"
   ]
  },
  {
   "icon": "db",
   "head": {
    "en": [
     "A database over years"
    ],
    "vi": [
     "Database qua nhiều năm"
    ]
   },
   "lines": {
    "en": [
     "Each record starts with a",
     "schema version number. The",
     "schemas live in a table or",
     "a registry."
    ],
    "vi": [
     "Mỗi bản ghi mở đầu bằng số",
     "phiên bản schema. Các schema",
     "nằm trong một bảng hoặc",
     "một registry."
    ]
   },
   "tone": "plain",
   "mono": [
    "[v3][bytes...] -> registry"
   ]
  },
  {
   "icon": "network",
   "head": {
    "en": [
     "A network connection"
    ],
    "vi": [
     "Một kết nối mạng"
    ]
   },
   "lines": {
    "en": [
     "Both sides agree on the",
     "schema when the connection",
     "opens."
    ],
    "vi": [
     "Hai bên thống nhất schema",
     "khi kết nối được mở."
    ]
   },
   "tone": "plain",
   "mono": [
    "hello, schema v3 -> ok"
   ]
  }
 ],
 "caption": {
  "en": "The bytes never carry the whole schema per record; only a place to look it up.",
  "vi": "Byte không mang cả schema trong từng bản ghi; chỉ mang chỗ để tra schema."
 }
};
---
<EncodingStepCards {...props} />
