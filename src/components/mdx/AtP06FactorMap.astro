---
import DiagramIcon from './DiagramIcon.astro';
// Three classic factors: what is sorted, which side is bought, who published it.
// Definitions follow the Ken French data library (SMB, HML, Mom) and the original papers' titles.
const cards = [
  { x: 20, icon: 'scale', en: 'Size', vi: 'Quy mô (size)', sortEn: 'Market value of the company', sortVi: 'Vốn hoá của công ty', buyEn: 'Buy small, sell big', buyVi: 'Mua nhỏ, bán lớn', ff: 'SMB', whoEn: 'Fama & French, 1993', whoVi: 'Fama & French, 1993' },
  { x: 315, icon: 'receipt', en: 'Value', vi: 'Giá trị (value)', sortEn: 'Book value ÷ market value', sortVi: 'Giá sổ sách ÷ giá thị trường', buyEn: 'Buy high ("cheap"), sell low', buyVi: 'Mua cao ("rẻ"), bán thấp', ff: 'HML', whoEn: 'Fama & French, 1992–93', whoVi: 'Fama & French, 1992–93' },
  { x: 610, icon: 'chart', en: 'Momentum', vi: 'Đà tăng (momentum)', sortEn: 'Return from 12 months ago to 2 months ago', sortVi: 'Lợi nhuận từ 12 tháng trước đến 2 tháng trước', buyEn: 'Buy winners, sell losers', buyVi: 'Mua mã thắng, bán mã thua', ff: 'Mom', whoEn: 'Jegadeesh & Titman, 1993', whoVi: 'Jegadeesh & Titman, 1993' },
];
---
<figure class="p06b">
  <div class="p06b-scroll">
    <svg viewBox="0 0 900 300" role="img" aria-label="Three classic factors. Size sorts companies by market value and buys small, sells big (SMB). Value sorts by book value over market value and buys high, sells low (HML). Momentum sorts by the return from twelve months ago to two months ago and buys winners, sells losers (Mom).">
      <text x="20" y="26" class="h"><tspan data-lang-en>Three factors, three different sorts</tspan><tspan data-lang-vi>Ba factor, ba cách xếp hạng khác nhau</tspan></text>
      {cards.map((c) => (
        <g>
          <rect x={c.x} y="44" width="270" height="220" rx="8" class="card" />
          <DiagramIcon name={c.icon} x={c.x + 28} y={74} size={26} />
          <text x={c.x + 54} y="80" class="t"><tspan data-lang-en>{c.en}</tspan><tspan data-lang-vi>{c.vi}</tspan></text>
          <text x={c.x + 16} y="118" class="k"><tspan data-lang-en>Rank stocks by</tspan><tspan data-lang-vi>Xếp hạng theo</tspan></text>
          <foreignObject x={c.x + 12} y="124" width="248" height="44"><div class="fo"><span data-lang-en>{c.sortEn}</span><span data-lang-vi>{c.sortVi}</span></div></foreignObject>
          <text x={c.x + 16} y="192" class="k"><tspan data-lang-en>The bet</tspan><tspan data-lang-vi>Vị thế</tspan></text>
          <text x={c.x + 16} y="212" class="v"><tspan data-lang-en>{c.buyEn}</tspan><tspan data-lang-vi>{c.buyVi}</tspan></text>
          <text x={c.x + 16} y="246" class="k"><tspan data-lang-en>{`Series: ${c.ff} · ${c.whoEn}`}</tspan><tspan data-lang-vi>{`Chuỗi: ${c.ff} · ${c.whoVi}`}</tspan></text>
        </g>
      ))}
      <text x="20" y="288" class="k"><tspan data-lang-en>Hundreds more exist. Each is one more way to rank the same stocks.</tspan><tspan data-lang-vi>Còn hàng trăm cái nữa. Mỗi cái chỉ là thêm một cách xếp hạng cùng những cổ phiếu đó.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>SMB, HML and Mom are the names of the monthly return series in the Ken French data library, which the next sections use.</span>
    <span data-lang-vi>SMB, HML và Mom là tên các chuỗi lợi nhuận tháng trong thư viện dữ liệu của Ken French, được dùng ở các phần sau.</span>
  </figcaption>
</figure>
<style>
  .p06b { margin: 2em 0; width: 100%; }
  .p06b-scroll { overflow-x: auto; }
  .p06b svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p06b text { font-size: 13px; fill: var(--text-body); }
  .p06b .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p06b .t { font-size: 17px; font-weight: 700; fill: var(--text); }
  .p06b .k { font-size: 12.5px; fill: var(--text-muted); }
  .p06b .v { font-size: 14px; font-weight: 700; fill: var(--text); }
  .p06b .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p06b .fo { font-size: 14px; line-height: 1.35; color: var(--text); font-family: inherit; }
  .p06b figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
