---
// Chapter 3, "you don't have to fill the whole screen" and "thinking in columns":
// the same contact form on a wide screen, stretched full width vs kept at the width it needs
// with the help text moved into a second column. Grey bars stand for text.

const W = 900;
const H = 330;
const fw = 420;
const fh = 250;
const frames = [
  { x: 15, good: false, en: 'Stretched to fill the screen', vi: 'Kéo giãn cho đầy màn hình', noteEn: 'Long inputs, eyes travel far', noteVi: 'Ô nhập quá dài, mắt phải đi xa' },
  { x: 465, good: true, en: 'Form at its own width, help in a column', vi: 'Form đúng độ rộng, phần giải thích sang cột bên', noteEn: 'Same content, easier to read', noteVi: 'Cùng nội dung, dễ đọc hơn' },
];
const top = 20;
---
<figure class="fls">
  <div class="fls-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two wide browser windows. Left: a heading, a paragraph and three inputs all stretched across the full width. Right: the same form kept narrow on the left, with the help text in a second column on the right.">
      {frames.map((f) => (
        <g>
          <rect x={f.x} y={top} width={fw} height={fh} rx="8" class="fls-frame" />
          <rect x={f.x} y={top} width={fw} height="22" rx="8" class="fls-bar" />
          <circle cx={f.x + 14} cy={top + 11} r="3.5" class="fls-dot" />
          <circle cx={f.x + 26} cy={top + 11} r="3.5" class="fls-dot" />
          <circle cx={f.x + 38} cy={top + 11} r="3.5" class="fls-dot" />
          {f.good ? (
            <g>
              <rect x={f.x + 30} y={top + 44} width="120" height="10" rx="3" class="fls-head" />
              {[0, 1, 2].map((i) => (
                <g>
                  <rect x={f.x + 30} y={top + 72 + i * 52} width="60" height="7" rx="3" class="fls-text" />
                  <rect x={f.x + 30} y={top + 84 + i * 52} width="200" height="22" rx="4" class="fls-input" />
                </g>
              ))}
              <rect x={f.x + 30} y={top + 226} width="70" height="16" rx="4" class="fls-btn" />
              {[0, 1, 2, 3, 4].map((i) => (
                <rect x={f.x + 262} y={top + 76 + i * 14} width={i === 4 ? 70 : 128} height="6" rx="3" class="fls-text is-soft" />
              ))}
            </g>
          ) : (
            <g>
              <rect x={f.x + 30} y={top + 44} width="120" height="10" rx="3" class="fls-head" />
              <rect x={f.x + 30} y={top + 62} width="360" height="6" rx="3" class="fls-text is-soft" />
              <rect x={f.x + 30} y={top + 74} width="300" height="6" rx="3" class="fls-text is-soft" />
              {[0, 1, 2].map((i) => (
                <g>
                  <rect x={f.x + 30} y={top + 92 + i * 44} width="60" height="7" rx="3" class="fls-text" />
                  <rect x={f.x + 30} y={top + 104 + i * 44} width="360" height="22" rx="4" class="fls-input is-bad" />
                </g>
              ))}
              <rect x={f.x + 30} y={top + 226} width="360" height="16" rx="4" class="fls-btn" />
            </g>
          )}
          <text x={f.x} y={top + fh + 28} class:list={['fls-label', { 'is-good': f.good }]}>
            <tspan data-lang-en>{f.en}</tspan>
            <tspan data-lang-vi>{f.vi}</tspan>
          </text>
          <text x={f.x} y={top + fh + 50} class="fls-note">
            <tspan data-lang-en>{f.noteEn}</tspan>
            <tspan data-lang-vi>{f.noteVi}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Grey bars stand for text. The right-hand version uses the width of the screen without making the form itself wider.</span>
    <span data-lang-vi>Các thanh xám thay cho chữ. Bản bên phải dùng được bề ngang màn hình mà không kéo rộng chính cái form.</span>
  </figcaption>
</figure>

<style>
  .fls { margin: 2em 0; width: 100%; }
  .fls-scroll { overflow-x: auto; }
  .fls svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .fls text { font-size: 14px; fill: var(--text-body); }
  .fls-frame { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .fls-bar { fill: var(--border); }
  .fls-dot { fill: var(--text-faint); }
  .fls-head { fill: var(--text); }
  .fls-text { fill: var(--text-muted); }
  .fls-text.is-soft { fill: var(--text-faint); }
  .fls-input { fill: none; stroke: var(--text-muted); stroke-width: 1.2; }
  .fls-input.is-bad { stroke: var(--red); }
  .fls-btn { fill: var(--text); }
  .fls text.fls-label { font-size: 15px; font-weight: 700; fill: var(--text); }
  .fls text.fls-label.is-good { fill: var(--red); }
  .fls text.fls-note { fill: var(--text-muted); }
  .fls figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
