---
import DiagramIcon from './DiagramIcon.astro';
// The baseline ladder: each rung must beat the one below out of sample and after costs.
const rungs = [
  { icon: 'retry', en: 'Repeat the last value', vi: 'Lặp lại giá trị gần nhất', ne: 'Beat every Transformer on exchange rates by around 45% in Zeng et al.', nv: 'Thắng mọi Transformer trên dữ liệu tỷ giá khoảng 45% trong Zeng và cộng sự.' },
  { icon: 'chart', en: 'Linear model on lagged returns', vi: 'Mô hình tuyến tính trên lợi suất trễ', ne: 'One-layer linear models beat the Transformers on all nine datasets.', nv: 'Mô hình tuyến tính một lớp thắng các Transformer trên cả chín bộ dữ liệu.' },
  { icon: 'model', en: 'Small CNN or LSTM', vi: 'CNN hoặc LSTM nhỏ', ne: 'Fischer and Krauss: clear to 2009, around zero after costs from 2010.', nv: 'Fischer và Krauss: vượt trội rõ tới 2009, quanh 0 sau chi phí từ 2010.' },
  { icon: 'parallel', en: 'Bigger model or Transformer', vi: 'Mô hình lớn hơn hoặc Transformer', ne: 'Briola et al.: strong forecasting power does not always mean tradable signals.', nv: 'Briola và cộng sự: dự báo tốt chưa chắc cho tín hiệu giao dịch được.' },
];
---
<figure class="p15k">
  <div class="scroll">
  <svg viewBox="0 0 900 380" role="img" aria-label="A ladder of four model types, from the simplest at the bottom (repeat the last value) to the most complex at the top (bigger model or Transformer). Each rung is only worth climbing if it beats the rung below on data it never saw, after costs. Next to each rung, one finding from a paper.">
    <text x="20" y="26" class="h"><tspan data-lang-en>The baseline ladder</tspan><tspan data-lang-vi>Cái thang đối chứng</tspan></text>
    <text x="20" y="48" class="sub"><tspan data-lang-en>Climb a rung only when it beats the one below on unseen data, after costs.</tspan><tspan data-lang-vi>Chỉ leo lên nấc trên khi nó thắng nấc dưới trên dữ liệu chưa thấy, sau chi phí.</tspan></text>
    {rungs.map((r, i) => (
      <g>
        <rect x="20" y={290 - i * 74} width="340" height="56" rx="8" class={i === 3 ? 'rung top' : 'rung'} />
        <DiagramIcon name={r.icon} x="50" y={318 - i * 74} size="24" />
        <text x="80" y={323 - i * 74} class="rt"><tspan data-lang-en>{r.en}</tspan><tspan data-lang-vi>{r.vi}</tspan></text>
        <line x1="362" y1={318 - i * 74} x2="390" y2={318 - i * 74} class="link" />
        <text x="398" y={322 - i * 74} class="rn"><tspan data-lang-en>{r.ne}</tspan><tspan data-lang-vi>{r.nv}</tspan></text>
      </g>
    ))}
    <line x1="10" y1="360" x2="10" y2="70" class="up" />
    <polygon points="4,76 16,76 10,64" class="uph" />
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The notes come from the papers cited in this post; the first two are time-series benchmarks that include exchange rates, not stock-trading results.</span>
    <span data-lang-vi>Các ghi chú lấy từ những bài báo trích trong bài; hai nấc đầu là benchmark chuỗi thời gian có cả tỷ giá, không phải kết quả giao dịch cổ phiếu.</span>
  </figcaption>
</figure>

<style>
  .p15k { margin: 2em 0; width: 100%; }
  .p15k .scroll { overflow-x: auto; }
  .p15k svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p15k text { font-size: 13px; fill: var(--text-body); }
  .p15k .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p15k .sub { fill: var(--text-muted); }
  .p15k .rung { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .p15k .rung.top { fill: var(--red-tint-bg); stroke: var(--red); }
  .p15k .rt { fill: var(--text); font-weight: 700; font-size: 13.5px; }
  .p15k .rn { fill: var(--text); font-size: 12.5px; }
  .p15k .link { stroke: var(--text-muted); stroke-width: 1.2; }
  .p15k .up { stroke: var(--text-muted); stroke-width: 1.4; }
  .p15k .uph { fill: var(--text-muted); }
  .p15k figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
