---
// Left: EWMA weights (lambda 0.94) on the last 30 days. Right: the EWMA volatility (annualised, %)
// computed from real S&P 500 returns around 24 Feb 2020 (python, seed variance = first 20 days).
const W = 900, H = 380;
const lam = 0.94;
const weights = Array.from({ length: 30 }, (_, j) => (1 - lam) * lam ** j);
const lx = 40, lb = 280, bw = 10, lh = 3200; // left chart
const days = ['18', '19', '20', '21', '24', '25', '26', '27', '28'];
const ew = [11.1, 10.9, 10.7, 11.1, 17.1, 20.4, 19.9, 26.1, 25.5];
const rx = 500, rb = 280, rbw = 30, rgap = 38;
const ry = (v: number) => rb - v * 7.2;
---
<figure class="p5e">
  <div class="p5e-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: bar chart of the EWMA weights for the last 30 days with decay 0.94; yesterday carries 6 percent, the weight halves in about 11 days. Right: EWMA volatility of the S&P 500 from 18 to 28 February 2020, flat near 11 percent a year until 21 February, then 17.1 on 24 February and 25.5 on 28 February.">
    <text x="20" y="26" class="h">
      <tspan data-lang-en>EWMA: a volatility that forgets</tspan>
      <tspan data-lang-vi>EWMA: độ biến động biết quên</tspan>
    </text>
    <text x={lx} y="62" class="sub">
      <tspan data-lang-en>Weight on each past day (decay 0.94)</tspan>
      <tspan data-lang-vi>Trọng số của từng ngày quá khứ (hệ số 0,94)</tspan>
    </text>
    {weights.map((w, j) => (
      <rect x={lx + (29 - j) * (bw + 2)} y={lb - w * lh} width={bw} height={w * lh} rx="2" class={j === 0 ? 'bar hot' : 'bar'} />
    ))}
    <line x1={lx} y1={lb} x2={lx + 30 * (bw + 2)} y2={lb} class="axis" />
    <text x={lx} y={lb + 20} class="tick">
      <tspan data-lang-en>30 days ago</tspan>
      <tspan data-lang-vi>30 ngày trước</tspan>
    </text>
    <text x={lx + 30 * (bw + 2)} y={lb + 20} text-anchor="end" class="tick">
      <tspan data-lang-en>yesterday: 6.0%</tspan>
      <tspan data-lang-vi>hôm qua: 6,0%</tspan>
    </text>
    <text x={lx + 20} y="110" class="note">
      <tspan data-lang-en>Half-life: about 11 days</tspan>
      <tspan data-lang-vi>Chu kỳ bán rã: khoảng 11 ngày</tspan>
    </text>

    <text x={rx} y="62" class="sub">
      <tspan data-lang-en>EWMA volatility, % a year, Feb 2020</tspan>
      <tspan data-lang-vi>Độ biến động EWMA, % một năm, 2/2020</tspan>
    </text>
    {ew.map((v, k) => (
      <g>
        <rect x={rx + k * rgap} y={ry(v)} width={rbw} height={rb - ry(v)} rx="2" class={k >= 4 ? 'bar hot' : 'bar calm'} />
        <text x={rx + k * rgap + rbw / 2} y={ry(v) - 6} text-anchor="middle" class="val">{v}</text>
        <text x={rx + k * rgap + rbw / 2} y={rb + 20} text-anchor="middle" class="tick">{days[k]}</text>
      </g>
    ))}
    <line x1={rx - 6} y1={rb} x2={rx + 9 * rgap} y2={rb} class="axis" />
    <text x={rx} y={rb + 40} class="tick">
      <tspan data-lang-en>days of February 2020</tspan>
      <tspan data-lang-vi>ngày trong tháng 2/2020</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Each day's squared return enters with weight 0.06 and the old estimate keeps 0.94. After the −3.41% day on 24 February the estimate jumps from 11.1 to 17.1, and there is no state, only a number you still have to threshold yourself.</span>
    <span data-lang-vi>Bình phương lợi suất mỗi ngày vào với trọng số 0,06, ước lượng cũ giữ 0,94. Sau ngày −3,41% hôm 24/2, ước lượng nhảy từ 11,1 lên 17,1; nhưng nó chỉ là một con số, bạn vẫn phải tự chọn ngưỡng.</span>
  </figcaption>
</figure>

<style>
  .p5e { margin: 2em 0; width: 100%; }
  .p5e-scroll { overflow-x: auto; }
  .p5e svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .p5e text { fill: var(--text-body); font-size: 13px; }
  .p5e .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p5e .sub { fill: var(--text-muted); font-size: 13px; font-weight: 600; }
  .p5e .note { fill: var(--text-muted); font-size: 12.5px; }
  .p5e .tick { fill: var(--text-muted); font-size: 12px; }
  .p5e .val { font-size: 12px; font-weight: 700; fill: var(--text); }
  .p5e .axis { stroke: var(--border); stroke-width: 1.3; }
  .p5e .bar { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p5e .bar.calm { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .p5e .bar.hot { fill: var(--red-tint-bg); stroke: var(--red); }
  .p5e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
