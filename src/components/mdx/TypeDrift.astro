---
// The font-size values this blog's own stylesheet uses, measured with a regex audit on
// src/styles/style.css at commit 9528380, against a 9-step handcrafted UI scale.
// The numbers are the real script output: 41 distinct sizes, with 33 off the scale.

const used = [9.5, 10, 10.5, 11, 11.5, 12, 12.5, 13, 13.5, 14, 14.1, 14.5, 14.7, 15, 15.5, 16, 16.5, 16.8, 17, 17.5, 18, 18.5, 19, 19.5, 20, 20.5, 21, 22, 24, 25, 26, 28, 30, 32, 36, 38, 42, 44, 66.5, 68, 96.5];
const scale = [12, 14, 16, 18, 20, 24, 30, 36, 48];

const W = 900;
const H = 230;
const pad = { l: 30, r: 30 };
const max = 100;
const sx = (v: number) => pad.l + (v / max) * (W - pad.l - pad.r);
const yUsed = 70;
const yScale = 150;
const off = used.filter((v) => !scale.includes(v)).length;
---
<figure class="tdr">
  <div class="tdr-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Top row: ${used.length} different font sizes used in this blog's CSS, packed densely between 9.5 and 96.5 pixels, ${off} of them off the scale. Bottom row: the 9 steps of a hand-crafted UI scale, 12 to 48 pixels.`}>
      <text x={pad.l} y="26" class="tdr-h">
        <tspan data-lang-en>Used in this blog's CSS: {used.length} sizes, {off} off the scale</tspan>
        <tspan data-lang-vi>Đang dùng trong CSS của blog: {used.length} cỡ chữ, {off} cỡ lạc thang</tspan>
      </text>
      <line x1={pad.l} x2={W - pad.r} y1={yUsed} y2={yUsed} class="tdr-axis" />
      {used.map((v) => (
        <circle cx={sx(v)} cy={yUsed} r="5" class:list={['tdr-dot', { 'is-off': !scale.includes(v) }]} />
      ))}

      <text x={pad.l} y="118" class="tdr-h">
        <tspan data-lang-en>A hand-crafted UI scale: {scale.length} steps</tspan>
        <tspan data-lang-vi>Thang chữ chuẩn cho UI: {scale.length} bậc</tspan>
      </text>
      <line x1={pad.l} x2={W - pad.r} y1={yScale} y2={yScale} class="tdr-axis" />
      {scale.map((v) => (
        <g>
          <line x1={sx(v)} x2={sx(v)} y1={yScale - 12} y2={yScale + 12} class="tdr-step" />
          <text x={sx(v)} y={yScale + 30} text-anchor="middle" class="tdr-num">{v}</text>
        </g>
      ))}
      <text x={W - pad.r} y={H - 8} text-anchor="end" class="tdr-unit">px</text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Real font sizes from this site's stylesheet. Red dots are arbitrary values (like 12.5px or 16.5px) tuned by eye outside any scale.</span>
    <span data-lang-vi>Cỡ chữ thật từ stylesheet của trang này. Chấm đỏ là các kích cỡ tùy tiện (như 12.5px hay 16.5px) được chỉnh bằng mắt nằm ngoài thang đo.</span>
  </figcaption>
</figure>

<style>
  .tdr { margin: 2em 0; width: 100%; }
  .tdr-scroll { overflow-x: auto; }
  .tdr svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .tdr text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .tdr text.tdr-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .tdr-axis { stroke: var(--border); }
  .tdr-dot { fill: var(--text-muted); stroke: var(--bg-alt); stroke-width: 1.5; }
  .tdr-dot.is-off { fill: var(--red); }
  .tdr-step { stroke: var(--text); stroke-width: 2.5; }
  .tdr text.tdr-num { font-size: 13px; fill: var(--text-muted); }
  .tdr text.tdr-unit { fill: var(--text-faint); }
  .tdr figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
