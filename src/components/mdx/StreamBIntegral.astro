---
// A shopping cart as events and as state: adding events up gives the state, subtracting two states gives the change.
// Illustrative example. Plain inline SVG via StreamBFigure.
import StreamBFigure from './StreamBFigure.astro';
import StreamBNode from './StreamBNode.astro';
import StreamBArrow from './StreamBArrow.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    hl: 'Events: what happened', hr: 'State: what is true now',
    ev: ['ItemAdded: book', 'ItemAdded: pen', 'ItemRemovedFromCart: book'],
    n: ['event 1', 'event 2', 'event 3'],
    st: ['Cart after event 1', 'Cart after event 2', 'Cart after event 3'],
    sv: ['book', 'book, pen', 'pen'],
    up: 'add them up (integrate)',
    down: 'subtract two states to get the change between them (differentiate)',
    alt: 'Three cart events (add book, add pen, remove book) on the left. Adding them up one by one gives the cart state on the right: book, then book and pen, then pen. An arrow back from the state to the events shows that subtracting two states gives the change.',
    cap: 'Same information, two shapes. Keep the events and you can rebuild any state; keep the states and you can recover the events by comparing neighbours.',
  },
  vi: {
    hl: 'Sự kiện: chuyện đã xảy ra', hr: 'Trạng thái: giờ đang như thế nào',
    ev: ['ItemAdded: book', 'ItemAdded: pen', 'ItemRemovedFromCart: book'],
    n: ['sự kiện 1', 'sự kiện 2', 'sự kiện 3'],
    st: ['Giỏ hàng sau sự kiện 1', 'Giỏ hàng sau sự kiện 2', 'Giỏ hàng sau sự kiện 3'],
    sv: ['book', 'book, pen', 'pen'],
    up: 'cộng dồn lại (tích phân)',
    down: 'lấy hai trạng thái trừ nhau ra phần thay đổi (đạo hàm)',
    alt: 'Ba sự kiện giỏ hàng (thêm book, thêm pen, bỏ book) ở bên trái. Cộng dồn từng sự kiện cho ra trạng thái giỏ hàng bên phải: book, rồi book và pen, rồi pen. Mũi tên ngược từ trạng thái về sự kiện cho thấy hai trạng thái trừ nhau ra phần thay đổi.',
    cap: 'Cùng một thông tin, hai dạng. Giữ sự kiện thì dựng lại được mọi trạng thái; giữ trạng thái thì suy ra sự kiện bằng cách so hai trạng thái liền kề.',
  },
}[lang];
const ys = [50, 122, 194];
---
<StreamBFigure h={326} alt={T.alt} cap={T.cap}>
  <text x="20" y="30" class="h">{T.hl}</text>
  <text x="580" y="30" class="h">{T.hr}</text>
  {ys.map((y, i) => (
    <>
      <StreamBNode x={20} y={y} w={300} h={56} icon="log" title={T.ev[i]} sub={[T.n[i]]} />
      <StreamBArrow x1={320} y1={y + 28} x2={580} y2={y + 28} label={i === 0 ? T.up : undefined} />
      <StreamBNode x={580} y={y} w={300} h={56} icon="db" title={T.st[i]} sub={[T.sv[i]]} kind={i === 2 ? 'good' : ''} />
    </>
  ))}
  <StreamBArrow x1={730} y1={286} x2={170} y2={286} kind="dash" label={T.down} dy={-8} />
</StreamBFigure>
