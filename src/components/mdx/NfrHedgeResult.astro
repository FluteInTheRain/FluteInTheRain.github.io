---
import DiagramIcon from './DiagramIcon.astro';
import NfrText from './NfrText.astro';
import './nfr-fig.css';
// Before/after from the paper's numbers: p99.9 for fetching all 1,000 values, 1,800 ms vs 74 ms, +2% requests, 10 ms hedge delay.
const W = 900;
const H = 270;
const X0 = 260;
const S = 480 / 1800;
---
<figure class="nf">
  <div class="nf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Bars to scale for the 99.9th percentile latency of reading 1,000 values: 1,800 ms without hedging, 74 ms when a second request is sent after 10 ms. The cost is about 2% more requests.">
      <NfrText x={20} y={24} cls="h" en="99.9th percentile to fetch all 1,000 values" vi="Độ trễ p99.9 để lấy đủ 1,000 giá trị" />
      <DiagramIcon name="server" x={40} y={72} size={28} />
      <NfrText x={70} y={77} cls="n" en="One replica only" vi="Chỉ một replica" />
      <rect x={X0} y="58" width={1800 * S} height="30" rx="3" class="bar is-red" />
      <NfrText x={X0 + 1800 * S + 10} y={78} cls="num" en="1,800 ms" vi="1,800 ms" />

      <DiagramIcon name="retry" x={40} y={128} size={28} />
      <NfrText x={70} y={125} cls="n" en="Hedge after 10 ms" vi="Hedge sau 10 ms" />
      <NfrText x={70} y={142} cls="s" en="ask a second replica" vi="hỏi replica thứ hai" />
      <rect x={X0} y="114" width={74 * S} height="30" rx="3" class="bar is-gold" />
      <NfrText x={X0 + 74 * S + 10} y={134} cls="num" en="74 ms" vi="74 ms" />

      <rect x="20" y="178" width="860" height="68" rx="8" class="box" />
      <DiagramIcon name="stopwatch" x={52} y={212} size={28} />
      <NfrText x={80} y={208} cls="n" en="The price" vi="Cái giá phải trả" />
      <NfrText x={80} y={228} en="Only about 2% more requests are sent." vi="Chỉ gửi thêm khoảng 2% request." />
      <NfrText x={470} y={208} cls="n" en="Why it works" vi="Vì sao hiệu quả" />
      <NfrText x={470} y={228} en="The delay is around one server, not the request." vi="Độ trễ nằm quanh một server, không phải ở request." />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Bar lengths are to scale. About 24 times faster in the tail, for a 2% cost.</span>
    <span data-lang-vi>Độ dài cột theo đúng tỉ lệ. Nhanh hơn khoảng 24 lần ở phần đuôi, với cái giá 2%.</span>
  </figcaption>
</figure>
