---
import DiagramIcon from './DiagramIcon.astro';
// Multishard $11 payment without two-phase commit (2PC):
// client generates an end-to-end request_id and appends to Payer Shard A's log;
// deterministic stream processor A reserves $11 and emits events to Shard A outgoing
// and Shard B payee; each shard deduplicates independently by request_id.
// Plain inline SVG using site CSS tokens; polygon arrowheads avoid duplicate marker IDs.

const W = 900;
const H = 540;

const clientToLog = {
  line: 'M195,144 L260,144',
  head: '259,139.5 259,148.5 267,144',
};
const logToProc = {
  line: 'M410,166 L410,190',
  head: '405.5,189 414.5,189 410,197',
};
const procToDeclined = {
  line: 'M410,284 L410,310',
  head: '405.5,309 414.5,309 410,317',
};
const procToOut = {
  line: 'M553,232 L589,232 L589,157 L618,157',
  head: '617,152.5 617,161.5 625,157',
};
const procToPayee = {
  line: 'M553,250 L589,250 L589,303 L618,303',
  head: '617,298.5 617,307.5 625,303',
};
---
<figure class="unmp-fig">
  <div class="unmp-scroll">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label="A multishard $11 transfer without two-phase commit. The client sends a unique request_id to Shard A's requests log. Stream processor A checks balance and seen_ids, reserves $11, and emits outgoing and incoming events to independent shard logs for Account A and Account B, which deduplicate by request_id."
    >
      <text x="20" y="26" class="unmp-h">
        <tspan data-lang-en>Multishard $11 transfer via partitioned logs (no distributed lock)</tspan>
        <tspan data-lang-vi>Chuyển $11 liên shard qua log phân vùng (không cần khóa phân tán)</tspan>
      </text>
      <text x="20" y="48" class="unmp-sub">
        <tspan data-lang-en>Appending the request to Shard A is the single atomic commit; downstream shards deduplicate via request_id.</tspan>
        <tspan data-lang-vi>Ghi yêu cầu vào log Shard A là điểm commit nguyên tử duy nhất; các shard sau tự lọc trùng bằng request_id.</tspan>
      </text>

      {/* Client endpoint */}
      <rect x="20" y="102" width="175" height="88" rx="4" class="unmp-box is-hot" />
      <DiagramIcon name="phone" x={173} y={102} size={24} />
      <text x="107.5" y="128" text-anchor="middle" class="unmp-in-b">
        <tspan data-lang-en>Client endpoint</tspan>
        <tspan data-lang-vi>Đầu cuối client</tspan>
      </text>
      <text x="107.5" y="150" text-anchor="middle" class="unmp-in-m">
        <tspan data-lang-en>id: req-7f9a ($11)</tspan>
        <tspan data-lang-vi>id: req-7f9a ($11)</tspan>
      </text>
      <text x="107.5" y="172" text-anchor="middle" class="unmp-in-s">
        <tspan data-lang-en>retries keep same id</tspan>
        <tspan data-lang-vi>thử lại giữ nguyên id</tspan>
      </text>

      <path d={clientToLog.line} class="unmp-arrow is-hot" />
      <polygon points={clientToLog.head} class="unmp-head is-hot" />

      {/* Shard A container */}
      <rect x="247" y="80" width="326" height="314" rx="6" class="unmp-shard" />
      <text x="267" y="104" class="unmp-shard-h">
        <tspan data-lang-en>Shard A · Payer account (#4321)</tspan>
        <tspan data-lang-vi>Shard A · Tài khoản gửi (#4321)</tspan>
      </text>

      <rect x="267" y="120" width="286" height="46" rx="4" class="unmp-box" />
      <DiagramIcon name="log" x={531} y={120} size={24} />
      <text x="410" y="148" text-anchor="middle" class="unmp-in-b">
        <tspan data-lang-en>1. Requests log (key = account A)</tspan>
        <tspan data-lang-vi>1. Log yêu cầu (khoá = tài khoản A)</tspan>
      </text>

      <path d={logToProc.line} class="unmp-arrow" />
      <polygon points={logToProc.head} class="unmp-head" />

      <rect x="267" y="197" width="286" height="87" rx="4" class="unmp-box" />
      <DiagramIcon name="worker" x={531} y={197} size={24} />
      <text x="410" y="220" text-anchor="middle" class="unmp-in-b">
        <tspan data-lang-en>2. Stream processor A</tspan>
        <tspan data-lang-vi>2. Stream processor A</tspan>
      </text>
      <text x="410" y="242" text-anchor="middle" class="unmp-in-m">
        <tspan data-lang-en>seen_ids ok? balance &gt;= $11?</tspan>
        <tspan data-lang-vi>chưa thấy id? đủ $11 không?</tspan>
      </text>
      <text x="410" y="264" text-anchor="middle" class="unmp-in-s">
        <tspan data-lang-en>reserve $11, save id, emit events</tspan>
        <tspan data-lang-vi>giữ $11, lưu id, phát 2 event</tspan>
      </text>

      <path d={procToDeclined.line} class="unmp-arrow is-dashed" />
      <polygon points={procToDeclined.head} class="unmp-head" />

      <rect x="267" y="317" width="286" height="60" rx="4" class="unmp-box is-warn" />
      <DiagramIcon name="warning" x={531} y={317} size={24} />
      <text x="410" y="341" text-anchor="middle" class="unmp-in-b">
        <tspan data-lang-en>If balance &lt; $11: emit Declined</tspan>
        <tspan data-lang-vi>Nếu thiếu tiền: phát event Từ chối</tspan>
      </text>
      <text x="410" y="361" text-anchor="middle" class="unmp-in-s">
        <tspan data-lang-en>refund / apology workflow</tspan>
        <tspan data-lang-vi>kích hoạt hoàn tiền / xin lỗi</tspan>
      </text>

      {/* Downstream shards */}
      <path d={procToOut.line} class="unmp-arrow" />
      <polygon points={procToOut.head} class="unmp-head" />
      <path d={procToPayee.line} class="unmp-arrow" />
      <polygon points={procToPayee.head} class="unmp-head" />

      <rect x="625" y="102" width="255" height="110" rx="4" class="unmp-box" />
      <DiagramIcon name="db" x={858} y={102} size={24} />
      <text x="752.5" y="128" text-anchor="middle" class="unmp-in-b">
        <tspan data-lang-en>Shard A · Outgoing ledger</tspan>
        <tspan data-lang-vi>Shard A · Sổ chi đi</tspan>
      </text>
      <text x="752.5" y="150" text-anchor="middle" class="unmp-in-m">
        <tspan data-lang-en>debit -$11 (req-7f9a)</tspan>
        <tspan data-lang-vi>trừ -$11 (req-7f9a)</tspan>
      </text>
      <text x="752.5" y="172" text-anchor="middle" class="unmp-in-s">
        <tspan data-lang-en>notify client of settlement</tspan>
        <tspan data-lang-vi>báo kết quả cho client</tspan>
      </text>
      <text x="752.5" y="194" text-anchor="middle" class="unmp-in-s">
        <tspan data-lang-en>ignores duplicate req-7f9a</tspan>
        <tspan data-lang-vi>bỏ qua req-7f9a bị lặp</tspan>
      </text>

      <rect x="625" y="248" width="255" height="110" rx="4" class="unmp-box" />
      <DiagramIcon name="db" x={858} y={248} size={24} />
      <text x="752.5" y="274" text-anchor="middle" class="unmp-in-b">
        <tspan data-lang-en>Shard B · Payee (#1234)</tspan>
        <tspan data-lang-vi>Shard B · Tài khoản nhận</tspan>
      </text>
      <text x="752.5" y="296" text-anchor="middle" class="unmp-in-m">
        <tspan data-lang-en>credit +$11 (req-7f9a)</tspan>
        <tspan data-lang-vi>cộng +$11 (req-7f9a)</tspan>
      </text>
      <text x="752.5" y="318" text-anchor="middle" class="unmp-in-s">
        <tspan data-lang-en>independent shard &amp; local DB</tspan>
        <tspan data-lang-vi>shard &amp; DB cục bộ độc lập</tspan>
      </text>
      <text x="752.5" y="340" text-anchor="middle" class="unmp-in-s">
        <tspan data-lang-en>ignores duplicate req-7f9a</tspan>
        <tspan data-lang-vi>bỏ qua req-7f9a bị lặp</tspan>
      </text>

      {/* Bottom explanation strip */}
      <rect x="20" y="420" width="860" height="96" rx="6" class="unmp-note-box" />
      <text x="38" y="446" class="unmp-in-b">
        <tspan data-lang-en>Where atomicity comes from without cross-shard locking:</tspan>
        <tspan data-lang-vi>Tính nguyên tử đến từ đâu khi không khóa chéo giữa các shard:</tspan>
      </text>
      <text x="38" y="471" class="unmp-note-line">
        <tspan data-lang-en>1. Appending the request to Shard A's log is the atomic commit; no 2PC lock sits between Shard A and Shard B.</tspan>
        <tspan data-lang-vi>1. Ghi yêu cầu vào log Shard A là điểm commit nguyên tử duy nhất; không khóa 2PC giữa Shard A và Shard B.</tspan>
      </text>
      <text x="38" y="495" class="unmp-note-line">
        <tspan data-lang-en>2. If Processor A crashes and replays, deterministic logic re-emits req-7f9a and each shard applies it once.</tspan>
        <tspan data-lang-vi>2. Nếu Processor A sập rồi chạy lại, logic tất định phát lại đúng req-7f9a và mỗi shard áp dụng đúng một lần.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Splitting a cross-shard payment into partitioned log stages replaces synchronous two-phase commit with deterministic stream processors and end-to-end request ID deduplication.</span>
    <span data-lang-vi>Tách một giao dịch liên shard thành các chặng log phân vùng giúp thay thế giao thức two-phase commit đồng bộ bằng các stream processor tất định và cơ chế lọc trùng request_id đầu-cuối.</span>
  </figcaption>
</figure>

<style>
  .unmp-fig {
    margin: 2em 0;
    width: 100%;
  }
  .unmp-scroll {
    overflow-x: auto;
  }
  .unmp-fig svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .unmp-fig text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .unmp-fig .unmp-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .unmp-fig .unmp-sub {
    font-size: 13.5px;
    fill: var(--text-muted);
  }
  .unmp-shard {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.5;
    stroke-dasharray: 6 4;
  }
  .unmp-fig .unmp-shard-h {
    font-size: 13.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .unmp-box {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .unmp-box.is-hot {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .unmp-box.is-warn {
    fill: var(--bg-alt);
    stroke: var(--red);
    stroke-width: 1.3;
    stroke-dasharray: 5 4;
  }
  .unmp-note-box {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .unmp-fig .unmp-in-b {
    font-weight: 700;
    fill: var(--text);
    font-size: 13.5px;
  }
  .unmp-fig .unmp-in-m {
    font-size: 13px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .unmp-fig .unmp-in-s {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .unmp-fig .unmp-note-line {
    font-size: 13px;
    fill: var(--text-body);
  }
  .unmp-arrow {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.6;
  }
  .unmp-arrow.is-hot {
    stroke: var(--red);
    stroke-width: 1.8;
  }
  .unmp-arrow.is-dashed {
    stroke-dasharray: 5 4;
  }
  .unmp-head {
    fill: var(--text-muted);
  }
  .unmp-head.is-hot {
    fill: var(--red);
  }
  .unmp-fig figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
