---
import EncodingStepCards from './EncodingStepCards.astro';
const props = {
 "arrows": false,
 "title": {
  "en": "What a decoder is willing to build",
  "vi": "Bộ giải mã chịu dựng những gì"
 },
 "alt": "Two kinds of decoder. JSON, Protocol Buffers and Avro decoders build only plain data: numbers, strings, lists and records. Java serialization, pickle and Marshal find the class named in the bytes and run code that belongs to it, so whoever controls the bytes chooses the class and the code.",
 "cards": [
  {
   "icon": "ok",
   "head": {
    "en": [
     "JSON, Protocol Buffers, Avro"
    ],
    "vi": [
     "JSON, Protocol Buffers, Avro"
    ]
   },
   "lines": {
    "en": [
     "The decoder builds plain data only:",
     "numbers, strings, lists, records.",
     "Bytes cannot pick a class to run."
    ],
    "vi": [
     "Bộ giải mã chỉ dựng dữ liệu thuần:",
     "số, chuỗi, danh sách, bản ghi.",
     "Byte không chọn được class để chạy."
    ]
   },
   "tone": "good"
  },
  {
   "icon": "warning",
   "head": {
    "en": [
     "Java serialization, pickle, Marshal"
    ],
    "vi": [
     "Java serialization, pickle, Marshal"
    ]
   },
   "lines": {
    "en": [
     "The decoder finds the class named",
     "in the bytes and runs its code.",
     "Whoever wrote the bytes picks both."
    ],
    "vi": [
     "Bộ giải mã tìm class được nêu trong",
     "byte rồi chạy code của nó. Ai ghi",
     "byte thì chọn cả class lẫn code."
    ]
   },
   "tone": "bad"
  }
 ],
 "caption": {
  "en": "The difference is what the decoder is allowed to construct, not how fast or compact the format is.",
  "vi": "Khác biệt nằm ở thứ bộ giải mã được phép dựng, không phải ở độ nhanh hay gọn của định dạng."
 }
};
---
<EncodingStepCards {...props} />
