---
// Side-by-side showdown of three micro-decisions from Part 9's lens:
// what a default developer or AI generates on the left, versus the unexpected choice
// worth logging in a swipe file on the right.

const W = 900;
const H = 410;
---

<figure class="luc">
  <div class="luc-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Comparison of three UI micro-decisions: default habit versus unexpected choice. First, a detached button versus a button nested inside the input. Second, a flat single-tone headline versus a two-tone headline. Third, a light popover with a heavy border versus an inverted dark surface.">
      {/* Column headers */}
      <text x="24" y="28" class="luc-col-h">
        <tspan data-lang-en>What default habits (and AI) build</tspan>
        <tspan data-lang-vi>Thói quen mặc định (và AI hay vẽ)</tspan>
      </text>
      <text x="476" y="28" class="luc-col-h is-accent">
        <tspan data-lang-en>The unexpected choice worth logging</tspan>
        <tspan data-lang-vi>Quyết định bất ngờ đáng ghi chép</tspan>
      </text>
      <line x1="24" x2="424" y1="40" y2="40" class="luc-rule" />
      <line x1="476" x2="876" y1="40" y2="40" class="luc-rule is-accent" />

      {/* ROW 1: Detached button vs nested button inside input */}
      <g transform="translate(0, 56)">
        <text x="24" y="16" class="luc-row-lbl">
          <tspan data-lang-en>1. Detached button next to an input</tspan>
          <tspan data-lang-vi>1. Nút bấm tách rời cạnh ô nhập liệu</tspan>
        </text>
        <rect x="24" y="28" width="262" height="44" rx="6" class="luc-box" />
        <text x="40" y="55" class="luc-placeholder">you@company.com</text>
        <rect x="296" y="28" width="116" height="44" rx="6" class="luc-btn-muted" />
        <text x="354" y="55" text-anchor="middle" class="luc-btn-txt">
          <tspan data-lang-en>Subscribe</tspan>
          <tspan data-lang-vi>Đăng ký</tspan>
        </text>

        {/* Arrow */}
        <line x1="436" x2="460" y1="50" y2="50" class="luc-arrow" />
        <polygon points="464,50 456,45 456,55" class="luc-arrow-head" />

        <text x="476" y="16" class="luc-row-lbl is-strong">
          <tspan data-lang-en>Button seated inside the input container</tspan>
          <tspan data-lang-vi>Nút bấm lồng gọn ngay trong khung nhập</tspan>
        </text>
        <rect x="476" y="28" width="400" height="44" rx="8" class="luc-box is-focus" />
        <text x="494" y="55" class="luc-placeholder">you@company.com</text>
        <rect x="758" y="34" width="112" height="32" rx="6" class="luc-btn-red" />
        <text x="814" y="55" text-anchor="middle" class="luc-btn-txt-inv">
          <tspan data-lang-en>Subscribe</tspan>
          <tspan data-lang-vi>Đăng ký</tspan>
        </text>
      </g>

      {/* ROW 2: Single-tone headline vs two-tone headline */}
      <g transform="translate(0, 168)">
        <text x="24" y="16" class="luc-row-lbl">
          <tspan data-lang-en>2. One flat colour across the whole headline</tspan>
          <tspan data-lang-vi>2. Một màu đều tăm tắp cho cả tiêu đề</tspan>
        </text>
        <rect x="24" y="28" width="400" height="72" rx="6" class="luc-panel" />
        <text x="42" y="58" class="luc-headline">
          <tspan data-lang-en>Deploy without downtime,</tspan>
          <tspan data-lang-vi>Triển khai không gián đoạn,</tspan>
        </text>
        <text x="42" y="84" class="luc-headline">
          <tspan data-lang-en>even on Friday afternoons.</tspan>
          <tspan data-lang-vi>kể cả vào chiều thứ Sáu.</tspan>
        </text>

        {/* Arrow */}
        <line x1="436" x2="460" y1="64" y2="64" class="luc-arrow" />
        <polygon points="464,64 456,59 456,69" class="luc-arrow-head" />

        <text x="476" y="16" class="luc-row-lbl is-strong">
          <tspan data-lang-en>Two tones separate the claim from its qualifier</tspan>
          <tspan data-lang-vi>Hai sắc độ tách ý chính khỏi vế bổ sung</tspan>
        </text>
        <rect x="476" y="28" width="400" height="72" rx="6" class="luc-panel" />
        <text x="494" y="58" class="luc-headline">
          <tspan data-lang-en>Deploy without downtime,</tspan>
          <tspan data-lang-vi>Triển khai không gián đoạn,</tspan>
        </text>
        <text x="494" y="84" class="luc-headline is-muted">
          <tspan data-lang-en>even on Friday afternoons.</tspan>
          <tspan data-lang-vi>kể cả vào chiều thứ Sáu.</tspan>
        </text>
      </g>

      {/* ROW 3: Light-on-light popover vs inverted dark popover */}
      <g transform="translate(0, 294)">
        <text x="24" y="16" class="luc-row-lbl">
          <tspan data-lang-en>3. Same surface colour for a floating picker</tspan>
          <tspan data-lang-vi>3. Bảng chọn nổi dùng cùng màu nền trang</tspan>
        </text>
        <rect x="24" y="28" width="400" height="72" rx="6" class="luc-panel" />
        <rect x="42" y="40" width="136" height="48" rx="6" class="luc-box" />
        <text x="58" y="69" class="luc-mini-txt">Nov 19, 2026</text>
        <rect x="196" y="36" width="212" height="56" rx="6" class="luc-box" />
        <text x="212" y="59" class="luc-mini-txt">17   18   19   20   21</text>
        <text x="212" y="79" class="luc-mini-sub">
          <tspan data-lang-en>Blends into the card behind it</tspan>
          <tspan data-lang-vi>Hòa lẫn vào nền thẻ phía sau</tspan>
        </text>

        {/* Arrow */}
        <line x1="436" x2="460" y1="64" y2="64" class="luc-arrow" />
        <polygon points="464,64 456,59 456,69" class="luc-arrow-head" />

        <text x="476" y="16" class="luc-row-lbl is-strong">
          <tspan data-lang-en>Inverted dark surface creates instant separation</tspan>
          <tspan data-lang-vi>Đảo nền tối tạo độ tách lớp ngay lập tức</tspan>
        </text>
        <rect x="476" y="28" width="400" height="72" rx="6" class="luc-panel" />
        <rect x="494" y="40" width="136" height="48" rx="6" class="luc-box" />
        <text x="510" y="69" class="luc-mini-txt">Nov 19, 2026</text>
        <rect x="648" y="36" width="212" height="56" rx="6" class="luc-inverted" />
        <text x="664" y="59" class="luc-inv-txt">17   18   </text>
        <rect x="720" y="45" width="26" height="19" rx="4" class="luc-btn-red" />
        <text x="733" y="59" text-anchor="middle" class="luc-inv-txt">19</text>
        <text x="752" y="59" class="luc-inv-txt">  20   21</text>
        <text x="664" y="79" class="luc-inv-sub">
          <tspan data-lang-en>Pops cleanly without heavy shadows</tspan>
          <tspan data-lang-vi>Nổi bật gọn gàng, không cần bóng nặng</tspan>
        </text>
      </g>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Three examples of the "would I have thought of that?" filter. None require exotic CSS — they are small structural decisions you only start noticing once you actively collect them.</span>
    <span data-lang-vi>Ba ví dụ cho bộ lọc "mình có tự nghĩ ra cách này không?". Không cần CSS cầu kỳ — chỉ là những quyết định cấu trúc nhỏ mà bạn chỉ thấy khi chủ động ghi lại.</span>
  </figcaption>
</figure>

<style>
  .luc { margin: 2em 0; width: 100%; }
  .luc-scroll { overflow-x: auto; }
  .luc svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .luc text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .luc text.luc-col-h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .luc text.luc-col-h.is-accent { fill: var(--red); }
  .luc-rule { stroke: var(--border); stroke-width: 1.5; }
  .luc-rule.is-accent { stroke: var(--red); }
  .luc text.luc-row-lbl { font-size: 13px; fill: var(--text-muted); }
  .luc text.luc-row-lbl.is-strong { fill: var(--text); font-weight: 600; }
  .luc-panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .luc-box { fill: var(--bg); stroke: var(--border); stroke-width: 1.25; }
  .luc-box.is-focus { stroke: var(--text-muted); }
  .luc-btn-muted { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.25; }
  .luc-btn-red { fill: var(--red); }
  .luc text.luc-placeholder { font-size: 13.5px; fill: var(--text-faint); }
  .luc text.luc-btn-txt { font-size: 13.5px; font-weight: 600; fill: var(--text); }
  .luc text.luc-btn-txt-inv { font-size: 13px; font-weight: 600; fill: #ffffff; }
  .luc-arrow { stroke: var(--text-muted); stroke-width: 1.5; }
  .luc-arrow-head { fill: var(--text-muted); }
  .luc text.luc-headline { font-size: 18px; font-weight: 700; fill: var(--text); }
  .luc text.luc-headline.is-muted { fill: var(--text-muted); font-weight: 500; }
  .luc text.luc-mini-txt { font-size: 13px; font-weight: 600; fill: var(--text); }
  .luc text.luc-mini-sub { font-size: 12px; fill: var(--text-muted); }
  .luc-inverted { fill: var(--text); }
  .luc text.luc-inv-txt { font-size: 13px; font-weight: 600; fill: var(--bg); }
  .luc text.luc-inv-sub { font-size: 12px; fill: var(--bg-alt); opacity: 0.85; }
  .luc figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
