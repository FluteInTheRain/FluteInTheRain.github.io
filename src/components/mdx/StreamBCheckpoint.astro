---
// Fault tolerance as five steps: barrier, snapshot, crash, restore and replay, idempotent sink. Offsets are illustrative.
import StreamBFigure from './StreamBFigure.astro';
import StreamBNode from './StreamBNode.astro';
import StreamBArrow from './StreamBArrow.astro';
import StreamBNum from './StreamBNum.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    src: ['Kafka', 'offsets up to 150'], op: ['Flink operator', 'keeps running state'], sink: ['PostgreSQL', 'column last_offset'], st: ['Durable storage', 'state snapshots'],
    bar: 'barrier N', res: 'results',
    steps: [
      'A barrier is injected into the stream at offset 120 and flows along with the data.',
      'The operator snapshots its state to durable storage and keeps working.',
      'The job crashes after offset 150.',
      'Restart: restore the snapshot, rewind Kafka to offset 120, replay 121 to 150.',
      'The sink ignores replayed rows: WHERE last_offset < $incoming_offset.',
    ],
    alt: 'Kafka feeds a Flink operator, which writes to PostgreSQL and saves state snapshots to durable storage. Five numbered steps: a checkpoint barrier flows with the data at offset 120; the operator snapshots its state; the job crashes after offset 150; on restart the snapshot is restored and Kafka rewound to offset 120 to replay 121 to 150; the sink ignores replayed rows by comparing last_offset.',
    cap: 'Illustrative offsets. The engine makes its own state safe by rewinding; the sink makes the outside world safe by ignoring repeats.',
  },
  vi: {
    src: ['Kafka', 'offset tới 150'], op: ['Toán tử Flink', 'giữ trạng thái chạy'], sink: ['PostgreSQL', 'cột last_offset'], st: ['Lưu trữ bền', 'bản chụp trạng thái'],
    bar: 'barrier N', res: 'kết quả',
    steps: [
      'Một barrier được chèn vào stream tại offset 120 và chạy cùng dữ liệu.',
      'Toán tử chụp trạng thái vào nơi lưu trữ bền và vẫn tiếp tục chạy.',
      'Job sập sau offset 150.',
      'Khởi động lại: khôi phục bản chụp, tua Kafka về offset 120, chạy lại 121 đến 150.',
      'Sink bỏ qua các dòng chạy lại: WHERE last_offset < $incoming_offset.',
    ],
    alt: 'Kafka cấp dữ liệu cho một toán tử Flink, toán tử ghi vào PostgreSQL và lưu bản chụp trạng thái vào nơi lưu trữ bền. Năm bước đánh số: barrier checkpoint chạy cùng dữ liệu tại offset 120; toán tử chụp trạng thái; job sập sau offset 150; khi khởi động lại bản chụp được khôi phục và Kafka tua về offset 120 để chạy lại 121 đến 150; sink bỏ qua các dòng chạy lại bằng cách so last_offset.',
    cap: 'Offset minh hoạ. Engine tự bảo vệ trạng thái của mình bằng cách tua lại; sink bảo vệ thế giới bên ngoài bằng cách bỏ qua dòng lặp.',
  },
}[lang];
---
<StreamBFigure h={420} alt={T.alt} cap={T.cap}>
  <StreamBNode x={20} y={50} w={220} h={72} icon="kafka" title={T.src[0]} sub={[T.src[1]]} />
  <StreamBNode x={340} y={50} w={220} h={72} icon="flink" title={T.op[0]} sub={[T.op[1]]} />
  <StreamBNode x={660} y={50} w={220} h={72} icon="postgres" title={T.sink[0]} sub={[T.sink[1]]} />
  <StreamBNode x={340} y={170} w={220} h={64} icon="disk" title={T.st[0]} sub={[T.st[1]]} />
  <StreamBArrow x1={240} y1={86} x2={340} y2={86} label={T.bar} dy={-10} />
  <StreamBArrow x1={560} y1={86} x2={660} y2={86} label={T.res} dy={-10} />
  <StreamBArrow x1={420} y1={122} x2={420} y2={170} kind="dash" />
  <StreamBArrow x1={480} y1={170} x2={480} y2={122} kind="good" />
  <StreamBNum x={290} y={50} n={1} />
  <StreamBNum x={406} y={146} n={2} />
  <StreamBNum x={549} y={50} n={3} />
  <StreamBNum x={494} y={146} n={4} />
  <StreamBNum x={869} y={50} n={5} />
  {T.steps.map((s, i) => (
    <>
      <StreamBNum x={31} y={277 + i * 32} n={i + 1} />
      <text x="54" y={282 + i * 32}>{s}</text>
    </>
  ))}
</StreamBFigure>
