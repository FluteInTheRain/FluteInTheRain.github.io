---
// LSM storage engine: where a write goes (WAL + memtable, flush to L0, compaction
// down the levels) and the order a read checks things in (newest first, Bloom
// filters skip files that cannot hold the key).
// Plain inline SVG with site tokens; arrowheads are polygons, so there are no ids
// to clash between the EN and VI copies of the figure.

const W = 900;
const H = 560;

// Disk levels: boxes left to right, with the key range each file covers.
const levelX = 330;
const boxGap = 8;
const levels = [
  { name: 'L0', y: 178, w: 58, files: ['a–z', 'a–z', 'a–z', 'a–z'] },
  { name: 'L1', y: 254, w: 58, files: ['a–f', 'g–m', 'n–s', 't–z'] },
  { name: 'L2', y: 330, w: 58, files: ['a–c', 'd–f', 'g–i', 'j–m', 'n–p', 'q–s', 't–v', 'w–z'] },
];
const boxH = 36;

// Read chain at the bottom.
const readY = 478;
const readW = 132;
const readGap = 30;
const reads = [
  { en: 'Memtable', vi: 'Memtable', noteEn: 'not here', noteVi: 'không có', hit: false },
  { en: 'L0, newest file', vi: 'L0, file mới nhất', noteEn: 'Bloom filter: no', noteVi: 'Bloom filter: không', hit: false },
  { en: 'L0, older files', vi: 'L0, các file cũ hơn', noteEn: 'Bloom filter: no', noteVi: 'Bloom filter: không', hit: false },
  { en: 'L1, file t–z', vi: 'L1, file t–z', noteEn: 'Bloom filter: no', noteVi: 'Bloom filter: không', hit: false },
  { en: 'L2, file t–v', vi: 'L2, file t–v', noteEn: 'found user42', noteVi: 'tìm thấy user42', hit: true },
];

function arrowDown(x: number, y1: number, y2: number) {
  return { line: `M${x},${y1} L${x},${y2 - 7}`, head: `${x - 5},${y2 - 8} ${x + 5},${y2 - 8} ${x},${y2}` };
}
function arrowRight(x1: number, x2: number, y: number) {
  return { line: `M${x1},${y} L${x2 - 7},${y}`, head: `${x2 - 8},${y - 5} ${x2 - 8},${y + 5} ${x2},${y}` };
}

const toMem = arrowRight(240, levelX, 89);
const toWal = arrowDown(130, 112, 172);
const flush = arrowDown(levelX + levels[0].w / 2, 118, levels[0].y);
const c01 = arrowDown(levelX + 2 * (58 + boxGap) + 29, levels[0].y + boxH, levels[1].y);
const c12 = arrowDown(levelX + 2 * (58 + boxGap) + 29, levels[1].y + boxH, levels[2].y);
const readArrows = reads.slice(1).map((_, i) => {
  const x1 = 20 + (i + 1) * readW + i * readGap;
  return arrowRight(x1 + 2, x1 + readGap - 2, readY + 20);
});
---
<figure class="lsm">
  <div class="lsm-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="An LSM storage engine. A write is appended to the write-ahead log on disk and inserted into a sorted memtable in memory. A full memtable is flushed as a new file in level 0. Compaction merges files down into level 1 and level 2, where each file covers one key range. A read checks the memtable, then level 0 newest first, then one file per lower level, using Bloom filters to skip files that cannot hold the key.">
    <text x="20" y="24" class="lsm-h">
      <tspan data-lang-en>Writes</tspan>
      <tspan data-lang-vi>Đường ghi</tspan>
    </text>
    <text x="20" y="46" class="lsm-sub">
      <tspan data-lang-en>A write goes to memory and to an append-only log. Files on disk are written once and never changed.</tspan>
      <tspan data-lang-vi>Lệnh ghi vào RAM và vào một log chỉ nối thêm. File trên đĩa ghi một lần rồi không sửa nữa.</tspan>
    </text>

    {/* memory / disk divider */}
    <text x={W - 20} y="76" text-anchor="end" class="lsm-zone">
      <tspan data-lang-en>memory</tspan>
      <tspan data-lang-vi>bộ nhớ (RAM)</tspan>
    </text>
    <line x1="20" x2={W - 20} y1="146" y2="146" class="lsm-divider" />
    <text x={W - 20} y="166" text-anchor="end" class="lsm-zone">
      <tspan data-lang-en>disk</tspan>
      <tspan data-lang-vi>đĩa</tspan>
    </text>

    {/* the write */}
    <rect x="20" y="66" width="220" height="46" rx="4" class="lsm-box is-write" />
    <text x="130" y="94" text-anchor="middle" class="lsm-in">
      <tspan data-lang-en>New write: user42</tspan>
      <tspan data-lang-vi>Lệnh ghi mới: user42</tspan>
    </text>

    {/* memtable */}
    <rect x={levelX} y="60" width="250" height="58" rx="4" class="lsm-box" />
    <text x={levelX + 14} y="84" class="lsm-in-b">Memtable</text>
    <text x={levelX + 14} y="106" class="lsm-in-m">
      <tspan data-lang-en>sorted by key, in memory</tspan>
      <tspan data-lang-vi>sắp xếp theo khoá, nằm trong RAM</tspan>
    </text>
    <path d={toMem.line} class="lsm-arrow" /><polygon points={toMem.head} class="lsm-head" />

    {/* WAL */}
    <rect x="20" y="172" width="220" height="50" rx="4" class="lsm-box" />
    <text x="34" y="193" class="lsm-in-b">
      <tspan data-lang-en>Write-ahead log</tspan>
      <tspan data-lang-vi>Write-ahead log (WAL)</tspan>
    </text>
    <text x="34" y="213" class="lsm-in-m">
      <tspan data-lang-en>append only, for crash recovery</tspan>
      <tspan data-lang-vi>chỉ nối thêm, để khôi phục</tspan>
    </text>
    <path d={toWal.line} class="lsm-arrow" /><polygon points={toWal.head} class="lsm-head" />

    {/* flush */}
    <path d={flush.line} class="lsm-arrow" /><polygon points={flush.head} class="lsm-head" />
    <text x={levelX + levels[0].w / 2 + 10} y="138" class="lsm-note">
      <tspan data-lang-en>flush when full</tspan>
      <tspan data-lang-vi>đầy thì ghi ra đĩa (flush)</tspan>
    </text>

    {/* levels */}
    {levels.map((lv) => (
      <g>
        <text x={levelX - 14} y={lv.y + 23} text-anchor="end" class="lsm-level">{lv.name}</text>
        {lv.files.map((f, i) => (
          <g>
            <rect x={levelX + i * (lv.w + boxGap)} y={lv.y} width={lv.w} height={boxH} rx="3" class="lsm-file" />
            <text x={levelX + i * (lv.w + boxGap) + lv.w / 2} y={lv.y + 23} text-anchor="middle" class="lsm-in-m">{f}</text>
          </g>
        ))}
      </g>
    ))}
    <path d={c01.line} class="lsm-arrow" /><polygon points={c01.head} class="lsm-head" />
    <path d={c12.line} class="lsm-arrow" /><polygon points={c12.head} class="lsm-head" />

    <text x="604" y={levels[0].y + 23} class="lsm-note">
      <tspan data-lang-en>newest file on the left; key ranges overlap</tspan>
      <tspan data-lang-vi>file mới nhất bên trái; dải khoá chồng lên nhau</tspan>
    </text>
    <text x="604" y={levels[1].y + 23} class="lsm-note">
      <tspan data-lang-en>each file holds one key range</tspan>
      <tspan data-lang-vi>mỗi file giữ một dải khoá riêng</tspan>
    </text>
    <text x={levelX} y={levels[2].y + boxH + 24} class="lsm-note">
      <tspan data-lang-en>each level is larger than the one above it</tspan>
      <tspan data-lang-vi>tầng dưới luôn lớn hơn tầng trên</tspan>
    </text>

    {/* compaction explanation, left column */}
    <text x="20" y="270" class="lsm-in-b">
      <tspan data-lang-en>Compaction, in the background:</tspan>
      <tspan data-lang-vi>Compaction, chạy ngầm:</tspan>
    </text>
    <text x="20" y="294" class="lsm-in-m">
      <tspan data-lang-en>merges sorted files into new ones,</tspan>
      <tspan data-lang-vi>trộn các file đã sắp xếp thành file mới,</tspan>
    </text>
    <text x="20" y="316" class="lsm-in-m">
      <tspan data-lang-en>keeps the newest value of each key,</tspan>
      <tspan data-lang-vi>giữ giá trị mới nhất của mỗi khoá,</tspan>
    </text>
    <text x="20" y="338" class="lsm-in-m">
      <tspan data-lang-en>drops overwritten values and</tspan>
      <tspan data-lang-vi>bỏ các giá trị đã bị ghi đè</tspan>
    </text>
    <text x="20" y="360" class="lsm-in-m">
      <tspan data-lang-en>tombstones that are old enough.</tspan>
      <tspan data-lang-vi>và các tombstone đủ cũ.</tspan>
    </text>

    {/* reads */}
    <line x1="20" x2={W - 20} y1="412" y2="412" class="lsm-rule" />
    <text x="20" y="440" class="lsm-h">
      <tspan data-lang-en>Reads</tspan>
      <tspan data-lang-vi>Đường đọc</tspan>
    </text>
    <text x="20" y="462" class="lsm-sub">
      <tspan data-lang-en>Looking up user42: newest data first, stop at the first hit.</tspan>
      <tspan data-lang-vi>Tìm user42: xem dữ liệu mới nhất trước, gặp là dừng.</tspan>
    </text>
    {reads.map((r, i) => {
      const x = 20 + i * (readW + readGap);
      return (
        <g>
          <rect x={x} y={readY} width={readW} height="40" rx="4" class={r.hit ? 'lsm-box is-hit' : 'lsm-box'} />
          <text x={x + readW / 2} y={readY + 25} text-anchor="middle" class="lsm-in-s">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          <text x={x + readW / 2} y={readY + 62} text-anchor="middle" class={r.hit ? 'lsm-note is-hit' : 'lsm-note'}>
            <tspan data-lang-en>{r.noteEn}</tspan>
            <tspan data-lang-vi>{r.noteVi}</tspan>
          </text>
        </g>
      );
    })}
    {readArrows.map((a) => (
      <g><path d={a.line} class="lsm-arrow" /><polygon points={a.head} class="lsm-head" /></g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The write and read paths of an LSM storage engine such as RocksDB, Cassandra or ScyllaDB, simplified: real engines run several memtables, more levels and many more files. A Bloom filter answers "definitely not here" or "maybe here", so a "no" skips a file without reading it.</span>
    <span data-lang-vi>Đường ghi và đường đọc của một storage engine kiểu LSM như RocksDB, Cassandra hay ScyllaDB, đã giản lược: engine thật có nhiều memtable, nhiều tầng và nhiều file hơn. Bloom filter chỉ trả lời "chắc chắn không có" hoặc "có thể có", nên gặp "không" là bỏ qua file đó mà không cần đọc.</span>
  </figcaption>
</figure>

<style>
  .lsm {
    margin: 2em 0;
    width: 100%;
  }
  .lsm-scroll {
    overflow-x: auto;
  }
  .lsm svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .lsm text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .lsm .lsm-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .lsm .lsm-sub,
  .lsm .lsm-zone {
    fill: var(--text-muted);
  }
  .lsm .lsm-zone {
    font-size: 13px;
  }
  .lsm-divider {
    stroke: var(--border);
    stroke-dasharray: 6 5;
  }
  .lsm-rule {
    stroke: var(--border);
  }
  .lsm-box {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .lsm-box.is-write,
  .lsm-box.is-hit {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .lsm-file {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .lsm .lsm-in {
    font-weight: 600;
    fill: var(--text);
  }
  .lsm .lsm-in-b {
    font-weight: 700;
    fill: var(--text);
  }
  .lsm .lsm-in-m {
    font-size: 13px;
    fill: var(--text-body);
  }
  .lsm .lsm-in-s {
    font-size: 13px;
    font-weight: 600;
    fill: var(--text);
  }
  .lsm .lsm-level {
    font-weight: 700;
    fill: var(--text);
  }
  .lsm .lsm-note {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .lsm .lsm-note.is-hit {
    fill: var(--red);
    font-weight: 700;
  }
  .lsm-arrow {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.4;
  }
  .lsm-head {
    fill: var(--text-muted);
  }
  .lsm figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
