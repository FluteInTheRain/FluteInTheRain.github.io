---
// Roadmap of the post: text becomes numbers in five steps, and each arrow is a place to go wrong.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 330;
const steps = [
  { icon: 'doc', en: 'Text', vi: 'Văn bản', exEn: 'Profit beats forecast', exVi: 'Lợi nhuận vượt dự báo' },
  { icon: 'label', en: 'Tokens', vi: 'Token', exEn: 'profit | beats | forecast', exVi: 'profit | beats | forecast' },
  { icon: 'chart', en: 'Numbers', vi: 'Con số', exEn: 'score +2', exVi: 'điểm +2' },
  { icon: 'signal', en: 'Signal', vi: 'Tín hiệu', exEn: 'score per stock, per day', exVi: 'điểm mỗi mã, mỗi ngày' },
  { icon: 'money', en: 'Portfolio', vi: 'Danh mục', exEn: 'rank, buy the top', exVi: 'xếp hạng, mua top đầu' },
] as const;
const risks = [
  { en: 'Which words count?', vi: 'Từ nào được tính?' },
  { en: 'Finance changes meanings', vi: 'Tài chính đổi nghĩa từ' },
  { en: 'Knowable back then?', vi: 'Lúc đó biết chưa?' },
  { en: 'A faint signal', vi: 'Tín hiệu yếu' },
];
const bx = (i: number) => 24 + i * 176;
---
<figure class="p17a">
  <div class="p17a-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Five steps from text to a portfolio: raw text, tokens, numbers, a signal per stock per day, and a portfolio. Under each arrow sits a place where the process goes wrong: which words count, the same word with a new meaning in finance, whether the text was knowable at the time, and a signal that is faint and needs many days to show.">
    <text x="20" y="28" class="p17a-h">
      <tspan data-lang-en>Text becomes a trade in five steps</tspan>
      <tspan data-lang-vi>Từ văn bản tới lệnh mua bán qua năm bước</tspan>
    </text>
    {steps.map((s, i) => (
      <g>
        <rect x={bx(i)} y="52" width="152" height="128" rx="8" class="p17a-box" />
        <DiagramIcon name={s.icon} x={bx(i) + 76} y={86} size={30} />
        <text x={bx(i) + 76} y="126" text-anchor="middle" class="p17a-t">
          <tspan data-lang-en>{s.en}</tspan>
          <tspan data-lang-vi>{s.vi}</tspan>
        </text>
        <text x={bx(i) + 76} y="156" text-anchor="middle" class="p17a-ex">
          <tspan data-lang-en>{s.exEn}</tspan>
          <tspan data-lang-vi>{s.exVi}</tspan>
        </text>
      </g>
    ))}
    {[0, 1, 2, 3].map((i) => (
      <g>
        <line x1={bx(i) + 154} y1="116" x2={bx(i + 1) - 2} y2="116" class="p17a-arrow" />
        <polygon points={`${bx(i + 1) - 2},116 ${bx(i + 1) - 10},111 ${bx(i + 1) - 10},121`} class="p17a-head" />
        <rect x={bx(i) + 88} y="212" width="152" height="54" rx="8" class="p17a-risk" />
        <text x={bx(i) + 164} y="244" text-anchor="middle" class="p17a-rt">
          <tspan data-lang-en>{risks[i].en}</tspan>
          <tspan data-lang-vi>{risks[i].vi}</tspan>
        </text>
        <line x1={bx(i) + 164} y1="212" x2={bx(i) + 164} y2="124" class="p17a-tick" />
      </g>
    ))}
    <text x="20" y="304" class="p17a-note">
      <tspan data-lang-en>Each red box is a section of this post.</tspan>
      <tspan data-lang-vi>Mỗi ô đỏ là một phần của bài này.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The whole field in one line. The model in the middle is the easy part; the arrows around it carry the risk.</span>
    <span data-lang-vi>Cả mảng này trong một dòng. Mô hình ở giữa là phần dễ; rủi ro nằm ở các mũi tên xung quanh.</span>
  </figcaption>
</figure>

<style>
  .p17a { margin: 2em 0; width: 100%; }
  .p17a-scroll { overflow-x: auto; }
  .p17a svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p17a text { font-size: 14px; fill: var(--text-body); }
  .p17a .p17a-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p17a .p17a-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .p17a .p17a-ex { font-size: 12.5px; fill: var(--text-muted); }
  .p17a .p17a-rt { font-size: 13px; font-weight: 600; fill: var(--text); }
  .p17a .p17a-note { font-size: 12.5px; fill: var(--text-muted); }
  .p17a-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p17a-risk { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
  .p17a-arrow { stroke: var(--text-muted); stroke-width: 1.6; }
  .p17a-head { fill: var(--text-muted); }
  .p17a-tick { stroke: var(--red); stroke-width: 1; stroke-dasharray: 3 3; }
  .p17a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
