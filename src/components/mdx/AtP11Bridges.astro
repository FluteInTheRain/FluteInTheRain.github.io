---
// Euler's seven bridges as a graph: four land masses (nodes), seven bridges (edges), degrees 5, 3, 3, 3.
// Facts: Wikipedia "Seven Bridges of Königsberg" (opened 2026-11-28). The layout is schematic, not a map.
import DiagramIcon from './DiagramIcon.astro';
const W = 900, H = 360;
const N = {
  alt: { x: 450, y: 66, en: 'Altstadt (mainland)', vi: 'Altstadt (đất liền)', d: 3 },
  vor: { x: 450, y: 296, en: 'Vorstadt (mainland)', vi: 'Vorstadt (đất liền)', d: 3 },
  kne: { x: 270, y: 181, en: 'Kneiphof (island)', vi: 'Kneiphof (đảo)', d: 5 },
  lom: { x: 630, y: 181, en: 'Lomse (island)', vi: 'Lomse (đảo)', d: 3 },
};
// [from, to, bend]: bend 0 = straight, +/- = curve for parallel bridges
const E: [keyof typeof N, keyof typeof N, number][] = [
  ['kne', 'alt', -18], ['kne', 'alt', 18], ['kne', 'vor', -18], ['kne', 'vor', 18],
  ['kne', 'lom', 0], ['alt', 'lom', 0], ['vor', 'lom', 0],
];
const path = (a: string, b: string, bend: number) => {
  const p = N[a as keyof typeof N], q = N[b as keyof typeof N];
  const mx = (p.x + q.x) / 2, my = (p.y + q.y) / 2;
  const dx = q.x - p.x, dy = q.y - p.y, L = Math.hypot(dx, dy);
  const cx = mx + (-dy / L) * bend * 2, cy = my + (dx / L) * bend * 2;
  return `M ${p.x} ${p.y} Q ${cx.toFixed(1)} ${cy.toFixed(1)} ${q.x} ${q.y}`;
};
---
<figure class="atp11-br">
  <div class="atp11-br-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The Königsberg bridge puzzle as a graph. Four land masses are nodes and seven bridges are edges. Kneiphof has five bridges and the other three land masses have three each, so four nodes have an odd number of bridges; a walk that crosses every bridge exactly once allows at most two.">
      <text x="20" y="28" class="h">
        <tspan data-lang-en>Euler drops the map and keeps the links</tspan>
        <tspan data-lang-vi>Euler bỏ bản đồ, chỉ giữ các mối nối</tspan>
      </text>
      {E.map(([a, b, bend]) => <path d={path(a, b, bend)} class="edge" />)}
      {Object.values(N).map((n) => (
        <g>
          <circle cx={n.x} cy={n.y} r="22" class="node" />
          <text x={n.x} y={n.y + 6} class="deg" text-anchor="middle">{n.d}</text>
        </g>
      ))}
      <text x={N.alt.x + 32} y={N.alt.y + 5} class="lab"><tspan data-lang-en>{N.alt.en}</tspan><tspan data-lang-vi>{N.alt.vi}</tspan></text>
      <text x={N.vor.x + 32} y={N.vor.y + 5} class="lab"><tspan data-lang-en>{N.vor.en}</tspan><tspan data-lang-vi>{N.vor.vi}</tspan></text>
      <text x={N.kne.x - 32} y={N.kne.y + 5} class="lab" text-anchor="end"><tspan data-lang-en>{N.kne.en}</tspan><tspan data-lang-vi>{N.kne.vi}</tspan></text>
      <text x={N.lom.x + 32} y={N.lom.y + 5} class="lab"><tspan data-lang-en>{N.lom.en}</tspan><tspan data-lang-vi>{N.lom.vi}</tspan></text>
      <rect x="700" y="276" width="180" height="62" rx="6" class="box" />
      <DiagramIcon name="warning" x={722} y={307} size={22} />
      <text x="742" y="299" class="note"><tspan data-lang-en>4 nodes with an odd</tspan><tspan data-lang-vi>4 nút có số cầu lẻ,</tspan></text>
      <text x="742" y="318" class="note"><tspan data-lang-en>count; a walk allows 2</tspan><tspan data-lang-vi>một lối đi chỉ cho phép 2</tspan></text>
      <text x="20" y="342" class="sub"><tspan data-lang-en>Number inside a node = how many bridges touch it</tspan><tspan data-lang-vi>Số trong nút = số cây cầu chạm vào nó</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Each land mass is a node and each of the seven bridges is an edge, so the whole puzzle fits in a degree count. The layout is schematic, not a map.</span>
    <span data-lang-vi>Mỗi mảnh đất là một nút, mỗi cây trong bảy cây cầu là một cạnh, nên cả câu đố gói gọn trong việc đếm bậc. Bố cục chỉ là sơ đồ, không phải bản đồ.</span>
  </figcaption>
</figure>
<style>
  .atp11-br { margin: 2em 0; width: 100%; }
  .atp11-br-scroll { overflow-x: auto; }
  .atp11-br svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp11-br text { font-size: 14px; fill: var(--text-body); }
  .atp11-br .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp11-br .sub { font-size: 13px; fill: var(--text-muted); }
  .atp11-br .lab { font-size: 13.5px; font-weight: 600; fill: var(--text); }
  .atp11-br .deg { font-size: 17px; font-weight: 700; fill: var(--text); }
  .atp11-br .note { font-size: 12.5px; fill: var(--text); }
  .atp11-br .edge { fill: none; stroke: var(--text-muted); stroke-width: 2.4; }
  .atp11-br .node { fill: var(--bg-alt); stroke: var(--text); stroke-width: 1.6; }
  .atp11-br .box { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
  .atp11-br figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
