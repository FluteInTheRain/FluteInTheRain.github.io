---
// Version numbers on one replica: four writes to one shopping cart key, and what the server keeps.
// Illustrative example.
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Arrow from './ReplicationBArrow.astro';

const rows = [
  { l: ['1. Client 1 writes [milk]', '1. Client 1 ghi [milk]', 'has not read anything yet', 'chưa đọc gì cả'],
    r: ['v1: [milk]', 'v1: [milk]', 'the current value', 'giá trị hiện tại'], cls: '' },
  { l: ['2. Client 2 writes [eggs]', '2. Client 2 ghi [eggs]', 'has not read anything yet', 'chưa đọc gì cả'],
    r: ['v2: [eggs]', 'v2: [eggs]', 'keeps sibling v1: [milk]', 'giữ sibling v1: [milk]'], cls: '' },
  { l: ['3. Client 1 writes [milk, flour]', '3. Client 1 ghi [milk, flour]', 'read v1 first, sends v1 back', 'đã đọc v1, gửi v1 kèm theo'],
    r: ['v3: [milk, flour]', 'v3: [milk, flour]', 'v1 overwritten; keeps sibling v2: [eggs]', 'v1 bị ghi đè; giữ sibling v2: [eggs]'], cls: '' },
  { l: ['4. Client 2 writes [eggs, milk, flour]', '4. Client 2 ghi [eggs, milk, flour]', 'merged both siblings, sends v3', 'đã gộp hai sibling, gửi v3'],
    r: ['v4: [eggs, milk, flour]', 'v4: [eggs, milk, flour]', 'v1, v2 and v3 overwritten', 'v1, v2 và v3 bị ghi đè'], cls: 'gold' },
];
---
<Frame h={340}
  label="Four writes to one cart key on one replica. Client 1 writes milk, the server stores v1. Client 2 writes eggs without having seen anything, so the server stores v2 and keeps v1 as a sibling. Client 1 writes milk and flour with v1, so v1 is overwritten and v2 stays as a sibling. Client 2 merges the siblings and sends v3, so the server stores v4 and overwrites everything."
  cap="A write that sends back the version it read overwrites everything at or below it. Anything newer is kept as a sibling, because it must be concurrent. Illustrative values."
  capVi="Lần ghi gửi kèm phiên bản đã đọc sẽ ghi đè mọi thứ ở mức đó trở xuống. Cái gì mới hơn được giữ làm sibling, vì nó chắc chắn là đồng thời. Giá trị minh hoạ.">
  {rows.map((r, i) => {
    const y = 14 + i * 80;
    return (
      <g>
        <Node x={20} y={y} w={390} h={64} icon="laptop" t={r.l[0]} tv={r.l[1]} s={r.l[2]} sv={r.l[3]} />
        <Arrow x1={410} y1={y + 32} x2={490} y2={y + 32} />
        <Node x={490} y={y} w={390} h={64} icon="db" t={r.r[0]} tv={r.r[1]} s={r.r[2]} sv={r.r[3]} cls={r.cls} />
      </g>
    );
  })}
</Frame>
