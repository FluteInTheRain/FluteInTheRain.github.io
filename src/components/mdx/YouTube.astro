---
// Click-to-load facade: the player (and its ~1MB of JS) is only fetched when the reader presses play.
interface Props {
  id: string;
  title: string;
  titleVi?: string;
  start?: number;
  end?: number;
  caption?: string;
  captionVi?: string;
  sourceTitle?: string;
  sourceUrl?: string;
}

const { id, title, titleVi, start, end, caption, captionVi, sourceTitle, sourceUrl } = Astro.props;

const fmtTime = (s: number) => {
  const m = Math.floor(s / 60);
  const rem = Math.floor(s % 60);
  return `${m}:${rem.toString().padStart(2, '0')}`;
};

const timeBadge =
  start !== undefined
    ? end !== undefined
      ? `${fmtTime(start)} – ${fmtTime(end)}`
      : `Starts at ${fmtTime(start)}`
    : undefined;

const resolvedSourceUrl =
  sourceUrl ?? (sourceTitle ? `https://www.youtube.com/watch?v=${id}${start ? `&t=${start}s` : ''}` : undefined);
---
<figure class="figure">
  <div class="yt" data-yt-id={id} data-yt-title={title} data-yt-start={start} data-yt-end={end}>
    <button type="button" class="yt-play" aria-label={`Play video: ${title}${timeBadge ? ` (${timeBadge})` : ''}`}>
      <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" />
      <span class="yt-btn" aria-hidden="true">&#9654;</span>
      {timeBadge && <span class="yt-badge">{timeBadge}</span>}
    </button>
  </div>
  {(caption || captionVi || sourceTitle) && (
    <figcaption>
      {caption && captionVi && caption !== captionVi ? (
        <>
          <span data-lang-en>{caption}</span>
          <span data-lang-vi>{captionVi}</span>
        </>
      ) : (
        <span>{caption || captionVi}</span>
      )}
      {sourceTitle && (
        <span class="figure-source">
          {(caption || captionVi) ? ' · ' : ''}
          <span data-lang-en>Source: </span>
          <span data-lang-vi>Nguồn: </span>
          {resolvedSourceUrl ? <a href={resolvedSourceUrl} rel="noopener" target="_blank">{sourceTitle}</a> : sourceTitle}
        </span>
      )}
    </figcaption>
  )}
</figure>
<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const id = el.dataset.ytId;
      const title = el.dataset.ytTitle || '';
      const start = el.dataset.ytStart;
      const end = el.dataset.ytEnd;
      if (!id) return;
      const params = new URLSearchParams({
        autoplay: '1',
        rel: '0',
        playsinline: '1',
      });
      if (start) params.set('start', start);
      if (end) params.set('end', end);
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?${params.toString()}`;
      iframe.title = title;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    });
  });
</script>
