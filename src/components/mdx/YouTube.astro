---
// Click-to-load facade: the player (and its ~1MB of JS) is only fetched when the reader presses play.
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<div class="yt" data-yt-id={id} data-yt-title={title}>
  <button type="button" class="yt-play" aria-label={`Play video: ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" />
    <span class="yt-btn" aria-hidden="true">&#9654;</span>
  </button>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.ytId}?autoplay=1&rel=0`;
      iframe.title = el.dataset.ytTitle ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    }, { once: true });
  });
</script>
