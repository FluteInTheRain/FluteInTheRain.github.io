  .bep2g .b { fill: var(--text-body); font-size: 13px; }
  .bep2g .bb { fill: var(--text); font-size: 13px; font-weight: 700; }
  .bep2g .m { fill: var(--text-muted); font-size: 12.5px; }
  .bep2g .f { fill: var(--text-faint); font-size: 12px; }
  .bep2g .r { fill: var(--red); font-weight: 700; }
  .bep2g .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep2g .boxr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bep2g .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep2g .lnr { stroke: var(--red); stroke-width: 1.5; fill: none; }
  .bep2g .d { stroke-dasharray: 5 4; }
  .bep2g .hd { fill: var(--text-muted); }
  .bep2g .hdr { fill: var(--red); }
  .bep2g .xr { stroke: var(--red); stroke-width: 2.2; fill: none; }
  .bep2g .ok { stroke: var(--text-muted); stroke-width: 2.2; fill: none; }
  .bep2g .band { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep2g .bandr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bep2g .dot { fill: var(--text-muted); }
  .bep2g .dotr { fill: var(--red); }
  .bep2g figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
