---
// Waterfall for stock D: base value + five contributions = the model's score.
// Numbers from the Python run (exact Shapley, 8-stock background, model "both"):
// base -0.066; momentum 12m +0.549; momentum 6m +0.178; value +0.446; volatility +0.016; size +0.417; score 1.540.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 416;
const base = -0.066;
const feats = [
  { en: '12-month momentum', vi: 'Momentum 12 tháng', v: 0.549, x: '+1.41' },
  { en: '6-month momentum', vi: 'Momentum 6 tháng', v: 0.178, x: '+1.07' },
  { en: 'value', vi: 'value', v: 0.446, x: '+0.51' },
  { en: 'volatility', vi: 'biến động', v: 0.016, x: '-0.31' },
  { en: 'size', vi: 'quy mô', v: 0.417, x: '+2.39' },
];
const X0 = 330, S = 300; // x = X0 + v * S
const px = (v: number) => X0 + v * S;
let cum = base;
const rows = feats.map((f, i) => {
  const a = cum; const b = cum + f.v; cum = b;
  return { ...f, a, b, y: 96 + (i + 1) * 40 };
});
const fx = cum;
const fmt = (n: number, d = 3) => (n >= 0 ? '+' : '-') + Math.abs(n).toFixed(d);
const fmtVi = (n: number, d = 3) => fmt(n, d).replace('.', ',');
---
<figure class="atp09-wf">
  <div class="atp09-wf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Waterfall for stock D. The average score is -0.066. 12-month momentum adds 0.549, 6-month momentum 0.178, value 0.446, volatility 0.016 and size 0.417, which together give D a score of 1.540.">
      <text x="20" y="26" class="h">
        <tspan data-lang-en>Why stock D scores 1.54: the average, plus five pushes</tspan>
        <tspan data-lang-vi>Vì sao cổ phiếu D được 1,54: mức trung bình, cộng năm cú đẩy</tspan>
      </text>
      <text x="20" y="48" class="sub">
        <tspan data-lang-en>Simulated stocks, exact Shapley values against the average of 8 background stocks. Value in the left column = D's feature value (z-score).</tspan>
        <tspan data-lang-vi>Cổ phiếu mô phỏng, Shapley chính xác so với trung bình của 8 cổ phiếu nền. Số ở cột trái = giá trị feature của D (z-score).</tspan>
      </text>

      <line x1={px(0)} x2={px(0)} y1="70" y2="350" class="zero" />

      <DiagramIcon name="model" x={36} y={96 + 20} size={22} />
      <text x="62" y={96 + 25} class="lab">
        <tspan data-lang-en>average score</tspan>
        <tspan data-lang-vi>điểm trung bình</tspan>
      </text>
      <rect x={px(base)} y={96 + 8} width={px(0) - px(base)} height="24" class="bar is-base" />
      <text x={px(0) + 8} y={96 + 25} class="val">{base.toFixed(3)}</text>

      {rows.map((r) => (
        <g>
          <text x="20" y={r.y + 25} class="lab">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          <text x="226" y={r.y + 25} class="xv">{r.x}</text>
          <rect x={px(Math.min(r.a, r.b))} y={r.y + 8} width={Math.max(2, Math.abs(px(r.b) - px(r.a)))} height="24" class="bar is-up" />
          <text x={px(Math.max(r.a, r.b)) + 8} y={r.y + 25} class="val is-up">
            <tspan data-lang-en>{fmt(r.v)}</tspan>
            <tspan data-lang-vi>{fmtVi(r.v)}</tspan>
          </text>
        </g>
      ))}

      <DiagramIcon name="ok" x={36} y={96 + 6 * 40 + 20} size={22} />
      <text x="62" y={96 + 6 * 40 + 25} class="lab b">
        <tspan data-lang-en>score for D</tspan>
        <tspan data-lang-vi>điểm của D</tspan>
      </text>
      <rect x={px(0)} y={96 + 6 * 40 + 8} width={px(fx) - px(0)} height="24" class="bar is-final" />
      <text x={px(fx) + 8} y={96 + 6 * 40 + 25} class="val b">
        <tspan data-lang-en>{fx.toFixed(3)}</tspan>
        <tspan data-lang-vi>{fx.toFixed(3).replace('.', ',')}</tspan>
      </text>

      <text x="20" y="402" class="n">
        <tspan data-lang-en>-0.066 + 0.549 + 0.178 + 0.446 + 0.016 + 0.417 = 1.540. The pieces always add back to the score; that is the checksum.</tspan>
        <tspan data-lang-vi>-0,066 + 0,549 + 0,178 + 0,446 + 0,016 + 0,417 = 1,540. Các phần luôn cộng lại đúng bằng điểm; đó là phép kiểm tra.</tspan>
      </text>
    </svg>
  </div>
</figure>

<style>
  .atp09-wf { margin: 2em 0; width: 100%; }
  .atp09-wf-scroll { overflow-x: auto; }
  .atp09-wf svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .atp09-wf text { fill: var(--text-body); font-size: 14px; }
  .atp09-wf .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp09-wf .sub { font-size: 12.5px; fill: var(--text-muted); }
  .atp09-wf .lab { font-size: 14px; fill: var(--text); }
  .atp09-wf .lab.b { font-weight: 700; }
  .atp09-wf .xv { font-size: 12.5px; fill: var(--text-muted); }
  .atp09-wf .val { font-size: 13.5px; font-weight: 600; fill: var(--text); }
  .atp09-wf .val.is-up { fill: var(--gold-icon); font-weight: 700; }
  .atp09-wf .val.b { font-weight: 700; }
  .atp09-wf .n { font-size: 13px; fill: var(--text-muted); }
  .atp09-wf .zero { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .atp09-wf .bar.is-base { fill: var(--text-faint); }
  .atp09-wf .bar.is-up { fill: var(--gold); }
  .atp09-wf .bar.is-final { fill: var(--act-2); }
</style>
