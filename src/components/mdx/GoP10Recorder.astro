---
// statusRecorder wraps the real http.ResponseWriter so the logging middleware can read the status afterwards.
// Icons: DiagramIcon (log = logging middleware, struct = statusRecorder, web = the handler). Motion: fm-flow on call arrows 1 to 3.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 372;
function head(x2: number, y2: number, dir: 'r' | 'l' | 'd') {
  if (dir === 'r') return `${x2},${y2} ${x2 - 9},${y2 - 5} ${x2 - 9},${y2 + 5}`;
  if (dir === 'l') return `${x2},${y2} ${x2 + 9},${y2 - 5} ${x2 + 9},${y2 + 5}`;
  return `${x2},${y2} ${x2 - 5},${y2 - 9} ${x2 + 5},${y2 - 9}`;
}
const steps = [
  { n: '1', en: 'logging passes rec to next.ServeHTTP(rec, r) instead of w.', vi: 'logging đưa rec cho next.ServeHTTP(rec, r) thay vì w.' },
  { n: '2', en: 'The handler writes its status through what it was given: WriteHeader(404) lands on rec.', vi: 'Handler ghi status qua thứ nó được đưa: WriteHeader(404) rơi vào rec.' },
  { n: '3', en: 'rec saves status = 404, then calls the real w.WriteHeader(404).', vi: 'rec lưu status = 404, rồi gọi w.WriteHeader(404) thật.' },
  { n: '4', en: 'When next returns, logging reads rec.status for the log line.', vi: 'Khi next trả về, logging đọc rec.status để ghi dòng log.' },
];
---
<figure class="gp10r">
  <div class="gp10r-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The logging middleware hands statusRecorder to the handler. The handler's WriteHeader call lands on the recorder, which stores the status and forwards it to the real ResponseWriter. After the handler returns, logging reads the stored status.">
    <rect x="20" y="40" width="150" height="104" rx="8" class="box" />
    <DiagramIcon name="log" x={95} y={64} size={28} />
    <text x="95" y="96" text-anchor="middle" class="b">logging</text>
    <text x="95" y="118" text-anchor="middle" class="m">start := time.Now()</text>

    <rect x="290" y="30" width="320" height="140" rx="8" class="box" />
    <DiagramIcon name="struct" x={352} y={49} size={24} />
    <text x="460" y="54" text-anchor="middle" class="b">statusRecorder (rec)</text>
    <rect x="310" y="68" width="280" height="30" rx="5" class="own" />
    <text x="450" y="88" text-anchor="middle">status int</text>
    <rect x="310" y="124" width="280" height="30" rx="5" class="own" />
    <text x="450" y="144" text-anchor="middle">http.ResponseWriter (the real w)</text>
    <line x1="450" x2="450" y1="98" y2={124 - 9} class="ln fm-flow" />
    <polygon points={head(450, 124, 'd')} class="bar" />
    <text x="462" y="116" class="hd">3</text>

    <rect x="730" y="40" width="150" height="104" rx="8" class="box" />
    <DiagramIcon name="web" x={805} y={64} size={28} />
    <text x="805" y="96" text-anchor="middle" class="b">getTodo</text>
    <text x="805" y="118" text-anchor="middle" class="m">writes 404</text>

    <line x1="170" x2="281" y1="74" y2="74" class="ln fm-flow" />
    <polygon points={head(290, 74, 'r')} class="bar" />
    <text x="224" y="64" class="hd">1</text>

    <line x1="730" x2="619" y1="74" y2="74" class="ln fm-flow" />
    <polygon points={head(610, 74, 'l')} class="bar" />
    <text x="666" y="64" class="hd">2</text>

    <line x1="290" x2="179" y1="124" y2="124" class="ln dash" />
    <polygon points={head(170, 124, 'l')} class="bar" />
    <text x="224" y="116" class="hd">4</text>

    {steps.map((s, i) => (
      <text x="20" y={216 + i * 36} class={i === 3 ? '' : ''}>
        <tspan class="b">{s.n}. </tspan>
        <tspan data-lang-en>{s.en}</tspan>
        <tspan data-lang-vi>{s.vi}</tspan>
      </text>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The handler only knows it holds an <code>http.ResponseWriter</code>. Because <code>statusRecorder</code> embeds one and overrides <code>WriteHeader</code>, logging can hand over a stand-in that behaves like the real thing and keeps a copy of the status.</span>
    <span data-lang-vi>Handler chỉ biết nó cầm một <code>http.ResponseWriter</code>. Vì <code>statusRecorder</code> nhúng một cái và ghi đè <code>WriteHeader</code>, logging đưa được một bản thay thế hoạt động như thật mà vẫn giữ lại bản sao của status.</span>
  </figcaption>
</figure>

<style>
  .gp10r { margin: 2em 0; width: 100%; }
  .gp10r-scroll { overflow-x: auto; }
  .gp10r svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp10r text { font-size: 14px; fill: var(--text-body); }
  .gp10r .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp10r .b { font-weight: 700; fill: var(--text); }
  .gp10r .m { fill: var(--text-muted); }
  .gp10r .r { fill: var(--red); font-weight: 700; }
  .gp10r .num { font-variant-numeric: tabular-nums; }
  .gp10r .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp10r .own { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp10r .bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
  .gp10r .bar { fill: var(--text-muted); }
  .gp10r .limit { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp10r .grid { stroke: var(--border); stroke-width: 1; }
  .gp10r .redline { stroke: var(--red); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .gp10r .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp10r .ln.dash { stroke-dasharray: 3 4; }
  .gp10r .ln.red { stroke: var(--red); }
  .gp10r .hd { fill: var(--text-muted); }
  .gp10r .hd.red { fill: var(--red); }
  .gp10r figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
