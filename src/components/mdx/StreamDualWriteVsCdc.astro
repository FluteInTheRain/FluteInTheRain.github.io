---
// Two ways to synchronize derived stores (such as a search index or cache) with a primary database:
//  1. Dual write: two clients write concurrently to both systems; network jitter reorders them,
//     leaving the database and search index permanently out of sync with zero error responses.
//  2. Change data capture (CDC): clients write only to the primary database; its commit log
//     establishes a single total order that Debezium and Kafka replay to every derived system.
// Plain inline SVG using site CSS tokens and polygon arrowheads (no SVG marker ids).

const W = 900;
const H = 472;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

// Row 1: Dual write race condition
const dwC1 = { x: 20, y: 54, w: 152, h: 46 };
const dwC2 = { x: 20, y: 142, w: 152, h: 46 };
const dwPg = { x: 376, y: 48, w: 236, h: 64 };
const dwEs = { x: 376, y: 136, w: 236, h: 64 };

const dwC1Pg = arrow(dwC1.x + dwC1.w, dwC1.y + 16, dwPg.x, dwPg.y + 20);
const dwC2Pg = arrow(dwC2.x + dwC2.w, dwC2.y + 14, dwPg.x, dwPg.y + 46);
const dwC1Es = arrow(dwC1.x + dwC1.w, dwC1.y + 32, dwEs.x, dwEs.y + 20);
const dwC2Es = arrow(dwC2.x + dwC2.w, dwC2.y + 32, dwEs.x, dwEs.y + 46);

// Row 2: CDC single-leader order
const cdcC1 = { x: 20, y: 294, w: 128, h: 44 };
const cdcC2 = { x: 20, y: 364, w: 128, h: 44 };
const cdcPg = { x: 184, y: 294, w: 174, h: 114 };
const cdcDeb = { x: 392, y: 314, w: 122, h: 74 };
const cdcKaf = { x: 548, y: 314, w: 122, h: 74 };
const cdcEs = { x: 708, y: 288, w: 172, h: 56 };
const cdcWh = { x: 708, y: 358, w: 172, h: 56 };

const aC1Pg = arrow(cdcC1.x + cdcC1.w, cdcC1.y + 22, cdcPg.x, cdcPg.y + 24);
const aC2Pg = arrow(cdcC2.x + cdcC2.w, cdcC2.y + 22, cdcPg.x, cdcPg.y + 90);
const aPgDeb = arrow(cdcPg.x + cdcPg.w, 351, cdcDeb.x, 351);
const aDebKaf = arrow(cdcDeb.x + cdcDeb.w, 351, cdcKaf.x, 351);
const aKafEs = arrow(cdcKaf.x + cdcKaf.w, 338, cdcEs.x, cdcEs.y + 28);
const aKafWh = arrow(cdcKaf.x + cdcKaf.w, 364, cdcWh.x, cdcWh.y + 28);
---
<figure class="stdw">
  <div class="stdw-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Comparison between dual writes and change data capture under concurrent updates. Top: two clients set X to A and B concurrently; PostgreSQL sees A then B while Elasticsearch sees B then A, leaving the two stores permanently out of sync. Bottom: both clients write only to PostgreSQL, whose WAL fixes one order (A then B) that Debezium and Kafka replay to every downstream store so all converge on B.">
    {/* ---------- Row 1: Dual write ---------- */}
    <text x="20" y="24" class="stdw-h">
      <tspan data-lang-en>1. Dual write: concurrent updates arrive in opposite orders</tspan>
      <tspan data-lang-vi>1. Dual write: hai lệnh ghi song song tới đích ngược thứ tự</tspan>
    </text>

    <g class="stdw-box">
      <rect x={dwC1.x} y={dwC1.y} width={dwC1.w} height={dwC1.h} rx="7" />
      <text x={dwC1.x + dwC1.w / 2} y={dwC1.y + 28} text-anchor="middle" class="stdw-name">
        <tspan data-lang-en>Client 1: X = A</tspan>
        <tspan data-lang-vi>Client 1: X = A</tspan>
      </text>
    </g>
    <g class="stdw-box">
      <rect x={dwC2.x} y={dwC2.y} width={dwC2.w} height={dwC2.h} rx="7" />
      <text x={dwC2.x + dwC2.w / 2} y={dwC2.y + 28} text-anchor="middle" class="stdw-name">
        <tspan data-lang-en>Client 2: X = B</tspan>
        <tspan data-lang-vi>Client 2: X = B</tspan>
      </text>
    </g>

    <g class="stdw-arrow"><path d={dwC1Pg.line} /><polygon points={dwC1Pg.head} /></g>
    <g class="stdw-arrow"><path d={dwC2Pg.line} /><polygon points={dwC2Pg.head} /></g>
    <g class="stdw-arrow is-bad"><path d={dwC1Es.line} /><polygon points={dwC1Es.head} /></g>
    <g class="stdw-arrow"><path d={dwC2Es.line} /><polygon points={dwC2Es.head} /></g>

    <text x="242" y="198" text-anchor="middle" class="stdw-bad-note">
      <tspan data-lang-en>dashed line = delayed packet from Client 1</tspan>
      <tspan data-lang-vi>nét đứt = gói tin từ Client 1 bị trễ mạng</tspan>
    </text>

    <g class="stdw-box">
      <rect x={dwPg.x} y={dwPg.y} width={dwPg.w} height={dwPg.h} rx="7" />
      <text x={dwPg.x + 14} y={dwPg.y + 24} class="stdw-name">PostgreSQL</text>
      <text x={dwPg.x + 14} y={dwPg.y + 47} class="stdw-small">
        <tspan data-lang-en>1st: X = A   then   2nd: X = B</tspan>
        <tspan data-lang-vi>Trước: X = A   sau: X = B</tspan>
      </text>
    </g>

    <g class="stdw-box is-off">
      <rect x={dwEs.x} y={dwEs.y} width={dwEs.w} height={dwEs.h} rx="7" />
      <text x={dwEs.x + 14} y={dwEs.y + 24} class="stdw-name">Elasticsearch</text>
      <text x={dwEs.x + 14} y={dwEs.y + 47} class="stdw-small">
        <tspan data-lang-en>1st: X = B   then   2nd: X = A</tspan>
        <tspan data-lang-vi>Trước: X = B   sau: X = A</tspan>
      </text>
    </g>

    <text x="632" y={dwPg.y + 38} class="stdw-ok">
      <tspan data-lang-en>Final: X = B</tspan>
      <tspan data-lang-vi>Cuối cùng: X = B</tspan>
    </text>
    <text x="632" y={dwEs.y + 30} class="stdw-bad">
      <tspan data-lang-en>Final: X = A</tspan>
      <tspan data-lang-vi>Cuối cùng: X = A</tspan>
    </text>
    <text x="632" y={dwEs.y + 50} class="stdw-bad-note">
      <tspan data-lang-en>Both got 200 OK — silent drift</tspan>
      <tspan data-lang-vi>Đều báo 200 OK — lệch ngầm</tspan>
    </text>

    {/* ---------- Divider ---------- */}
    <line x1="20" x2={W - 20} y1="228" y2="228" class="stdw-rule" />

    {/* ---------- Row 2: CDC ---------- */}
    <text x="20" y="256" class="stdw-h">
      <tspan data-lang-en>2. Change data capture (CDC): the database fixes one order</tspan>
      <tspan data-lang-vi>2. Change data capture (CDC): database chốt một thứ tự duy nhất</tspan>
    </text>

    <g class="stdw-box">
      <rect x={cdcC1.x} y={cdcC1.y} width={cdcC1.w} height={cdcC1.h} rx="7" />
      <text x={cdcC1.x + cdcC1.w / 2} y={cdcC1.y + 27} text-anchor="middle" class="stdw-name">Client 1: X = A</text>
    </g>
    <g class="stdw-box">
      <rect x={cdcC2.x} y={cdcC2.y} width={cdcC2.w} height={cdcC2.h} rx="7" />
      <text x={cdcC2.x + cdcC2.w / 2} y={cdcC2.y + 27} text-anchor="middle" class="stdw-name">Client 2: X = B</text>
    </g>

    <g class="stdw-arrow"><path d={aC1Pg.line} /><polygon points={aC1Pg.head} /></g>
    <g class="stdw-arrow"><path d={aC2Pg.line} /><polygon points={aC2Pg.head} /></g>

    <text x={cdcPg.x + cdcPg.w / 2} y={cdcPg.y - 8} text-anchor="middle" class="stdw-tag">
      <tspan data-lang-en>single source of order</tspan>
      <tspan data-lang-vi>nơi duy nhất chốt thứ tự</tspan>
    </text>
    <g class="stdw-box">
      <rect x={cdcPg.x} y={cdcPg.y} width={cdcPg.w} height={cdcPg.h} rx="7" />
      <text x={cdcPg.x + cdcPg.w / 2} y={cdcPg.y + 28} text-anchor="middle" class="stdw-name">PostgreSQL</text>
      <text x={cdcPg.x + cdcPg.w / 2} y={cdcPg.y + 52} text-anchor="middle" class="stdw-small">
        <tspan data-lang-en>commit log (WAL)</tspan>
        <tspan data-lang-vi>nhật ký commit (WAL)</tspan>
      </text>
      <rect x={cdcPg.x + 14} y={cdcPg.y + 66} width={cdcPg.w - 28} height="32" rx="4" class="stdw-inner" />
      <text x={cdcPg.x + cdcPg.w / 2} y={cdcPg.y + 87} text-anchor="middle" class="stdw-seq">1: X = A  →  2: X = B</text>
    </g>

    <g class="stdw-arrow"><path d={aPgDeb.line} /><polygon points={aPgDeb.head} /></g>

    <g class="stdw-box">
      <rect x={cdcDeb.x} y={cdcDeb.y} width={cdcDeb.w} height={cdcDeb.h} rx="7" />
      <text x={cdcDeb.x + cdcDeb.w / 2} y={cdcDeb.y + 30} text-anchor="middle" class="stdw-name">Debezium</text>
      <text x={cdcDeb.x + cdcDeb.w / 2} y={cdcDeb.y + 52} text-anchor="middle" class="stdw-small">
        <tspan data-lang-en>tails WAL</tspan>
        <tspan data-lang-vi>đọc WAL</tspan>
      </text>
    </g>

    <g class="stdw-arrow"><path d={aDebKaf.line} /><polygon points={aDebKaf.head} /></g>

    <g class="stdw-box">
      <rect x={cdcKaf.x} y={cdcKaf.y} width={cdcKaf.w} height={cdcKaf.h} rx="7" />
      <text x={cdcKaf.x + cdcKaf.w / 2} y={cdcKaf.y + 30} text-anchor="middle" class="stdw-name">Kafka</text>
      <text x={cdcKaf.x + cdcKaf.w / 2} y={cdcKaf.y + 52} text-anchor="middle" class="stdw-small">
        <tspan data-lang-en>1: A  →  2: B</tspan>
        <tspan data-lang-vi>1: A  →  2: B</tspan>
      </text>
    </g>

    <g class="stdw-arrow"><path d={aKafEs.line} /><polygon points={aKafEs.head} /></g>
    <g class="stdw-arrow"><path d={aKafWh.line} /><polygon points={aKafWh.head} /></g>

    <g class="stdw-box">
      <rect x={cdcEs.x} y={cdcEs.y} width={cdcEs.w} height={cdcEs.h} rx="7" />
      <text x={cdcEs.x + cdcEs.w / 2} y={cdcEs.y + 23} text-anchor="middle" class="stdw-name">Elasticsearch</text>
      <text x={cdcEs.x + cdcEs.w / 2} y={cdcEs.y + 43} text-anchor="middle" class="stdw-ok-s">
        <tspan data-lang-en>Final: X = B</tspan>
        <tspan data-lang-vi>Cuối cùng: X = B</tspan>
      </text>
    </g>

    <g class="stdw-box">
      <rect x={cdcWh.x} y={cdcWh.y} width={cdcWh.w} height={cdcWh.h} rx="7" />
      <text x={cdcWh.x + cdcWh.w / 2} y={cdcWh.y + 23} text-anchor="middle" class="stdw-name">
        <tspan data-lang-en>Cache / Warehouse</tspan>
        <tspan data-lang-vi>Cache / Kho phân tích</tspan>
      </text>
      <text x={cdcWh.x + cdcWh.w / 2} y={cdcWh.y + 43} text-anchor="middle" class="stdw-ok-s">
        <tspan data-lang-en>Final: X = B</tspan>
        <tspan data-lang-vi>Cuối cùng: X = B</tspan>
      </text>
    </g>

    <text x={W / 2} y="448" text-anchor="middle" class="stdw-note">
      <tspan data-lang-en>Every derived store acts as a follower of the database log, so concurrent writes never leave stale opposites.</tspan>
      <tspan data-lang-vi>Mọi kho phái sinh chỉ theo sau nhật ký của database, nên ghi đồng thời không bao giờ để lại hai bản lệch nhau.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Top: dual writes race across the network, leaving two stores permanently disagreeing even when every HTTP request returns 200 OK. Bottom: writing once to PostgreSQL lets the WAL establish one serial order that Debezium and Kafka replay everywhere.</span>
    <span data-lang-vi>Trên: dual write chạy đua qua mạng khiến hai kho dữ liệu lệch nhau vĩnh viễn dù mọi request đều trả về 200 OK. Dưới: chỉ ghi vào PostgreSQL giúp WAL chốt một thứ tự tuần tự duy nhất để Debezium và Kafka phát lại đồng bộ đi khắp nơi.</span>
  </figcaption>
</figure>

<style>
  .stdw {
    margin: 2em 0;
    width: 100%;
  }
  .stdw-scroll {
    overflow-x: auto;
  }
  .stdw svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .stdw text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .stdw .stdw-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .stdw .stdw-name {
    font-weight: 700;
    fill: var(--text);
  }
  .stdw .stdw-small {
    font-size: 13px;
    fill: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .stdw .stdw-seq {
    font-size: 13px;
    font-weight: 600;
    fill: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .stdw .stdw-tag {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .stdw .stdw-note {
    font-size: 13.5px;
    fill: var(--text-muted);
  }
  .stdw .stdw-ok {
    font-weight: 700;
    fill: var(--text);
  }
  .stdw .stdw-ok-s {
    font-size: 13px;
    font-weight: 600;
    fill: var(--text);
  }
  .stdw .stdw-bad {
    font-weight: 700;
    fill: var(--red);
  }
  .stdw .stdw-bad-note {
    font-size: 13px;
    fill: var(--red);
  }
  .stdw-box rect {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .stdw-box rect.stdw-inner {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1;
  }
  .stdw-box.is-off rect {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.5;
  }
  .stdw-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .stdw-arrow polygon {
    fill: var(--text-muted);
  }
  .stdw-arrow.is-bad path {
    stroke: var(--red);
    stroke-dasharray: 5 4;
  }
  .stdw-arrow.is-bad polygon {
    fill: var(--red);
  }
  .stdw-rule {
    stroke: var(--border);
  }
  .stdw figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
