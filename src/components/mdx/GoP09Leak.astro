---
// Pipeline gen -> square -> main, main reads two values and stops reading.
// Top: no cancel, two stages stay blocked (3 goroutines alive). Bottom: cancel(), both return (1 alive).
// Values (1 4, 3, 6, counts 3 and 1) come from the two programs and outputs shown in the post.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

import DiagramIcon from './DiagramIcon.astro';
// Icons: gopher = goroutine, deadlock = a stage stuck forever. Motion: fm-pulse on the red leak count.
const W = 900;
const H = 312;
const bw = 230;
const bh = 58;
const xs = [20, 335, 650];
const names = ['gen', 'square', 'main'];
const panels = [
  {
    y: 40,
    titleEn: '1. No cancel: main takes two values and stops reading',
    titleVi: '1. Không hủy: main lấy hai giá trị rồi ngừng đọc',
    cut: false,
    states: [
      { en: 'blocked sending 4', vi: 'kẹt khi gửi 4', bad: true },
      { en: 'blocked sending 9', vi: 'kẹt khi gửi 9', bad: true },
      { en: 'read 1 and 4, then stopped', vi: 'đọc 1 và 4, rồi dừng', bad: false },
    ],
    resEn: 'goroutines still alive: 3 (main and two stuck stages)',
    resVi: 'goroutine còn sống: 3 (main và hai stage bị kẹt)',
    resBad: true,
  },
  {
    y: 196,
    titleEn: '2. With cancel: main calls cancel() after the two values',
    titleVi: '2. Có hủy: main gọi cancel() sau hai giá trị',
    cut: true,
    states: [
      { en: 'returned through ctx.Done()', vi: 'thoát qua ctx.Done()', bad: false, gone: true },
      { en: 'returned through ctx.Done()', vi: 'thoát qua ctx.Done()', bad: false, gone: true },
      { en: 'called cancel()', vi: 'đã gọi cancel()', bad: false },
    ],
    resEn: 'goroutines still alive: 1 (main)',
    resVi: 'goroutine còn sống: 1 (main)',
    resBad: false,
  },
];
---
<figure class="gp09leak">
  <div class="gp09leak-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A pipeline of gen, square and main. Without cancel, gen and square stay blocked after main stops reading and 3 goroutines stay alive. With cancel, both stages return and only main is left.">
    {panels.map((p, pi) => (
      <g>
        <text x="20" y={p.y - 14} class="gp09leak-h">
          <tspan data-lang-en>{p.titleEn}</tspan>
          <tspan data-lang-vi>{p.titleVi}</tspan>
        </text>
        {names.map((n, i) => (
          <g class={p.states[i].bad ? 'gp09leak-box is-bad' : p.states[i].gone ? 'gp09leak-box is-gone' : 'gp09leak-box'}>
            <rect x={xs[i]} y={p.y} width={bw} height={bh} rx="8" />
            <DiagramIcon name={p.states[i].bad ? 'deadlock' : 'gopher'} x={xs[i] + 26} y={p.y + 18} size={26} />
            <text x={xs[i] + 48} y={p.y + 24} class="gp09leak-name">{n}</text>
            <text x={xs[i] + 14} y={p.y + 45} class={p.states[i].bad ? 'gp09leak-bad' : 'gp09leak-muted'}>
              <tspan data-lang-en>{p.states[i].en}</tspan>
              <tspan data-lang-vi>{p.states[i].vi}</tspan>
            </text>
          </g>
        ))}
        {[0, 1].map((i) => {
          const a = arrow(xs[i] + bw + 8, p.y + bh / 2, xs[i + 1] - 8, p.y + bh / 2);
          return <g class={p.cut ? 'gp09leak-arrow is-cut' : 'gp09leak-arrow'}><path d={a.line} /><polygon points={a.head} /></g>;
        })}
        <text x="20" y={p.y + bh + 28} class={p.resBad ? 'gp09leak-bad fm-pulse' : 'gp09leak-name'}>
          <tspan data-lang-en>{p.resEn}</tspan>
          <tspan data-lang-vi>{p.resVi}</tspan>
        </text>
      </g>
    ))}
    <line x1="20" x2={W - 20} y1="150" y2="150" class="gp09leak-rule" />
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Arrows show values moving from gen to square to main. Once main stops receiving, square waits to send and gen waits to send to square, and nothing ever frees them. cancel() closes ctx.Done(), which both stages are listening to.</span>
    <span data-lang-vi>Mũi tên chỉ giá trị đi từ gen qua square tới main. Khi main không nhận nữa, square chờ để gửi và gen chờ để gửi cho square, và không gì giải phóng chúng. cancel() đóng ctx.Done(), kênh mà cả hai stage đang lắng nghe.</span>
  </figcaption>
</figure>

<style>
  .gp09leak { margin: 2em 0; width: 100%; }
  .gp09leak-scroll { overflow-x: auto; }
  .gp09leak svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp09leak text { font-size: 14px; fill: var(--text-body); }
  .gp09leak .gp09leak-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp09leak-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp09leak-box.is-bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-dasharray: 4 3; }
  .gp09leak-box.is-gone rect { stroke-dasharray: 2 4; stroke: var(--border); }
  .gp09leak .gp09leak-name { font-weight: 700; fill: var(--text); }
  .gp09leak .gp09leak-bad { fill: var(--red); font-weight: 700; }
  .gp09leak .gp09leak-muted { fill: var(--text-muted); }
  .gp09leak-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp09leak-arrow polygon { fill: var(--text-muted); }
  .gp09leak-arrow.is-cut path { stroke-dasharray: 3 4; opacity: 0.5; }
  .gp09leak-arrow.is-cut polygon { opacity: 0.5; }
  .gp09leak-rule { stroke: var(--border); }
  .gp09leak figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
