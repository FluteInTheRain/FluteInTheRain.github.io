---
// Picture first: two-phase commit holds locks on both shards; the partitioned-log design commits with one append.
// Plain inline SVG with site CSS tokens; polygon arrowheads avoid duplicate marker ids.
import DiagramIcon from './DiagramIcon.astro';
---
<figure class="unb-fig">
  <div class="unb-scroll">
    <svg viewBox="0 0 900 392" role="img" aria-label="Top lane: a coordinator makes both shards prepare and hold locks. Bottom lane: a client appends a request to the payer shard log, which is the single commit, and each shard applies its own part and skips repeated ids.">
      <text x="20" y="26" class="unb-h"><tspan data-lang-en>Two shards, two ways to move $11</tspan><tspan data-lang-vi>Hai shard, hai cách chuyển $11</tspan></text>
      <text x="20" y="56" text-anchor="start" class="unb-lane-h"><tspan data-lang-en>Two-phase commit</tspan><tspan data-lang-vi>Two-phase commit</tspan></text>
      <rect x="20" y="76" width="210" height="72" rx="4" class="unb-box" />
      <DiagramIcon name="server" x={45} y={112} size={26} />
      <text x="149" y="108" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>Coordinator</tspan><tspan data-lang-vi>Bộ điều phối</tspan></text>
      <text x="149" y="125" text-anchor="middle" class="unb-in-m"><tspan data-lang-en>asks both to prepare</tspan><tspan data-lang-vi>hỏi cả hai chuẩn bị</tspan></text>
      <rect x="330" y="70" width="260" height="44" rx="4" class="unb-box is-hot" />
      <DiagramIcon name="db" x={355} y={92} size={26} />
      <text x="484" y="88" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>Shard A</tspan><tspan data-lang-vi>Shard A</tspan></text>
      <text x="484" y="105" text-anchor="middle" class="unb-in-m"><tspan data-lang-en>locked until both agree</tspan><tspan data-lang-vi>khoá tới khi cả hai đồng ý</tspan></text>
      <rect x="330" y="126" width="260" height="44" rx="4" class="unb-box is-hot" />
      <DiagramIcon name="db" x={355} y={148} size={26} />
      <text x="484" y="144" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>Shard B</tspan><tspan data-lang-vi>Shard B</tspan></text>
      <text x="484" y="161" text-anchor="middle" class="unb-in-m"><tspan data-lang-en>locked until both agree</tspan><tspan data-lang-vi>khoá tới khi cả hai đồng ý</tspan></text>
      <path d="M230,100 L280,100 L280,92 L323,92" class="unb-solid" /><polygon points="322,87.5 322,96.5 330,92" class="unb-head" />
      <path d="M230,124 L300,124 L300,148 L323,148" class="unb-solid" /><polygon points="322,143.5 322,152.5 330,148" class="unb-head" />
      <text x="630" y="106" text-anchor="start" class="unb-note is-hot"><tspan data-lang-en>Both shards hold locks</tspan><tspan data-lang-vi>Cả hai shard giữ khoá</tspan></text>
      <text x="630" y="126" text-anchor="start" class="unb-note is-hot"><tspan data-lang-en>and wait for the coordinator.</tspan><tspan data-lang-vi>và chờ bộ điều phối.</tspan></text>
      <line x1="20" y1="196" x2="880" y2="196" class="unb-solid" />
      <text x="20" y="226" text-anchor="start" class="unb-lane-h"><tspan data-lang-en>Partitioned log</tspan><tspan data-lang-vi>Log phân vùng</tspan></text>
      <rect x="20" y="262" width="190" height="60" rx="4" class="unb-box" />
      <DiagramIcon name="phone" x={45} y={292} size={26} />
      <text x="139" y="288" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>Client</tspan><tspan data-lang-vi>Client</tspan></text>
      <text x="139" y="305" text-anchor="middle" class="unb-in-m"><tspan data-lang-en>request_id req-7f9a</tspan><tspan data-lang-vi>request_id req-7f9a</tspan></text>
      <rect x="260" y="262" width="250" height="60" rx="4" class="unb-box is-good" />
      <DiagramIcon name="log" x={285} y={292} size={26} />
      <text x="409" y="288" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>Shard A request log</tspan><tspan data-lang-vi>Log yêu cầu Shard A</tspan></text>
      <text x="409" y="305" text-anchor="middle" class="unb-in-m"><tspan data-lang-en>one append = the commit</tspan><tspan data-lang-vi>một lần ghi = commit</tspan></text>
      <rect x="590" y="240" width="290" height="52" rx="4" class="unb-box" />
      <DiagramIcon name="db" x={615} y={266} size={26} />
      <text x="759" y="262" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>Shard A: debit $11</tspan><tspan data-lang-vi>Shard A: trừ $11</tspan></text>
      <text x="759" y="279" text-anchor="middle" class="unb-in-m"><tspan data-lang-en>skips a repeated request_id</tspan><tspan data-lang-vi>bỏ qua request_id lặp</tspan></text>
      <rect x="590" y="306" width="290" height="52" rx="4" class="unb-box" />
      <DiagramIcon name="db" x={615} y={332} size={26} />
      <text x="759" y="328" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>Shard B: credit $11</tspan><tspan data-lang-vi>Shard B: cộng $11</tspan></text>
      <text x="759" y="345" text-anchor="middle" class="unb-in-m"><tspan data-lang-en>skips a repeated request_id</tspan><tspan data-lang-vi>bỏ qua request_id lặp</tspan></text>
      <path d="M210,292 L253,292" class="unb-solid" /><polygon points="252,287.5 252,296.5 260,292" class="unb-head" />
      <path d="M510,292 L550,292 L550,266 L583,266" class="unb-solid is-good" /><polygon points="582,261.5 582,270.5 590,266" class="unb-head is-good" />
      <path d="M510,292 L550,292 L550,332 L583,332" class="unb-solid is-good" /><polygon points="582,327.5 582,336.5 590,332" class="unb-head is-good" />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The log design needs no shared lock: one append commits the request, and each shard applies its own part on its own.</span>
    <span data-lang-vi>Thiết kế dùng log không cần khoá chung: một lần ghi là commit yêu cầu, rồi mỗi shard tự xử lý phần của mình.</span>
  </figcaption>
</figure>

<style>
  .unb-fig { margin: 2em 0; width: 100%; }
  .unb-scroll { overflow-x: auto; }
  .unb-fig svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .unb-fig text { font-size: 14px; fill: var(--text-body); }
  .unb-fig .unb-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .unb-fig .unb-lane-h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .unb-fig .unb-lane-sub { font-size: 13px; fill: var(--text-muted); }
  .unb-fig .unb-in-b { font-weight: 700; fill: var(--text); font-size: 13.5px; }
  .unb-fig .unb-in-m { font-size: 12.5px; fill: var(--text-muted); }
  .unb-fig .unb-note { font-size: 13px; fill: var(--text-muted); }
  .unb-fig .unb-note.is-hot { fill: var(--red); font-weight: 700; }
  .unb-fig .unb-note.is-good { fill: var(--gold-icon); font-weight: 700; }
  .unb-fig .unb-mono { font-size: 12.5px; fill: var(--text-body); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .unb-fig .unb-tick { font-size: 12.5px; fill: var(--text-muted); }
  .unb-panel { fill: none; stroke: var(--border); stroke-width: 1; }
  .unb-panel.is-fill { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .unb-panel.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .unb-panel.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.4; }
  .unb-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .unb-box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .unb-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .unb-box.is-dash { stroke-dasharray: 5 4; fill: none; }
  .unb-box.is-dash.is-good { fill: none; }
  .unb-box.is-dash.is-hot { fill: none; }
  .unb-solid { fill: none; stroke: var(--text-muted); stroke-width: 1.8; }
  .unb-solid.is-hot { stroke: var(--red); stroke-width: 2; }
  .unb-solid.is-good { stroke: var(--gold-icon); stroke-width: 2; }
  .unb-solid.is-dashedline { stroke-dasharray: 5 4; stroke-width: 1.2; }
  .unb-dashed { fill: none; stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .unb-dashed.is-hot { stroke: var(--red); stroke-width: 1.8; }
  .unb-dashed.is-good { stroke: var(--gold-icon); stroke-width: 1.8; }
  .unb-head { fill: var(--text-muted); }
  .unb-head.is-hot { fill: var(--red); }
  .unb-head.is-good { fill: var(--gold-icon); }
  .unb-step { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; }
  .unb-step.is-hot { fill: var(--red-tint-bg); stroke: var(--red); }
  .unb-step.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); }
  .unb-fig .unb-step-n { font-size: 12.5px; font-weight: 700; fill: var(--text); }
  .unb-fig figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
