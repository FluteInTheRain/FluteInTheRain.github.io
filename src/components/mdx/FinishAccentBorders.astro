---
// Chapter 8: 2x2 visual grid comparing plain flat boxes against 3-4px accent borders
// across four common UI spots: alert left stripe, active tab underline,
// top-of-card highlight bar, and callout/quote rule.
// Uses site CSS tokens and unique SVG clipPath IDs per instance.

const W = 900;
const H = 420;
const uid = Math.random().toString(36).slice(2, 8);
const cardClipId = `fab-card-clip-${uid}`;
const alertClipId = `fab-alert-clip-${uid}`;
---
<figure class="fab">
  <div class="fab-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four-example grid comparing plain flat UI boxes against 3 to 4 pixel accent borders on an alert left stripe, an active tab underline, a card top highlight bar, and a callout rule.">
      <defs>
        <clipPath id={alertClipId}>
          <rect x="0" y="0" width="184" height="82" rx="6" />
        </clipPath>
        <clipPath id={cardClipId}>
          <rect x="0" y="0" width="184" height="82" rx="6" />
        </clipPath>
      </defs>

      {/* Quadrant 1: Alert left stripe */}
      <g transform="translate(16, 14)">
        <rect x="0" y="0" width="424" height="184" rx="10" class="fab-panel" />
        <text x="16" y="26" class="fab-head">
          <tspan data-lang-en>1. Alert left stripe</tspan>
          <tspan data-lang-vi>1. Viền trái khung cảnh báo</tspan>
        </text>

        {/* Flat version */}
        <g transform="translate(16, 44)">
          <text x="0" y="12" class="fab-sub is-muted">
            <tspan data-lang-en>Plain flat box</tspan>
            <tspan data-lang-vi>Khung phẳng</tspan>
          </text>
          <rect x="0" y="22" width="184" height="82" rx="6" class="fab-flat" />
          <text x="12" y="48" class="fab-item-title is-muted">
            <tspan data-lang-en>API key expires soon</tspan>
            <tspan data-lang-vi>Khóa API sắp hết hạn</tspan>
          </text>
          <text x="12" y="68" class="fab-item-sub">
            <tspan data-lang-en>Rotate before Friday</tspan>
            <tspan data-lang-vi>Đổi mới trước thứ Sáu</tspan>
          </text>
          <text x="12" y="88" class="fab-item-sub">
            <tspan data-lang-en>Blends into body text</tspan>
            <tspan data-lang-vi>Dễ lẫn vào nội dung</tspan>
          </text>
        </g>

        {/* Accented version */}
        <g transform="translate(222, 44)">
          <text x="0" y="12" class="fab-sub is-accent">
            <tspan data-lang-en>4px left accent</tspan>
            <tspan data-lang-vi>Viền nhấn trái 4px</tspan>
          </text>
          <g transform="translate(0, 22)" clip-path={`url(#${alertClipId})`}>
            <rect x="0" y="0" width="184" height="82" class="fab-tint" />
            <rect x="0" y="0" width="4.5" height="82" class="fab-accent-fill" />
          </g>
          <rect x="0" y="22" width="184" height="82" rx="6" class="fab-outline" />
          <text x="16" y="48" class="fab-item-title">
            <tspan data-lang-en>API key expires soon</tspan>
            <tspan data-lang-vi>Khóa API sắp hết hạn</tspan>
          </text>
          <text x="16" y="68" class="fab-item-sub">
            <tspan data-lang-en>Rotate before Friday</tspan>
            <tspan data-lang-vi>Đổi mới trước thứ Sáu</tspan>
          </text>
          <text x="16" y="88" class="fab-item-note">
            <tspan data-lang-en>Signals urgency immediately</tspan>
            <tspan data-lang-vi>Báo mức độ chú ý ngay lập tức</tspan>
          </text>
        </g>
      </g>

      {/* Quadrant 2: Active tab underline */}
      <g transform="translate(460, 14)">
        <rect x="0" y="0" width="424" height="184" rx="10" class="fab-panel" />
        <text x="16" y="26" class="fab-head">
          <tspan data-lang-en>2. Active tab underline</tspan>
          <tspan data-lang-vi>2. Gạch chân tab đang chọn</tspan>
        </text>

        {/* Flat version */}
        <g transform="translate(16, 44)">
          <text x="0" y="12" class="fab-sub is-muted">
            <tspan data-lang-en>Plain text tabs</tspan>
            <tspan data-lang-vi>Tab chữ phẳng</tspan>
          </text>
          <rect x="0" y="22" width="184" height="82" rx="6" class="fab-flat" />
          <line x1="0" y1="56" x2="184" y2="56" class="fab-rule" />
          <text x="12" y="45" class="fab-item-title is-muted">
            <tspan data-lang-en>Logs</tspan>
            <tspan data-lang-vi>Nhật ký</tspan>
          </text>
          <text x="68" y="45" class="fab-item-sub">
            <tspan data-lang-en>Metrics</tspan>
            <tspan data-lang-vi>Chỉ số</tspan>
          </text>
          <text x="128" y="45" class="fab-item-sub">
            <tspan data-lang-en>Alerts</tspan>
            <tspan data-lang-vi>Cảnh báo</tspan>
          </text>
          <text x="12" y="82" class="fab-item-sub">
            <tspan data-lang-en>Active view is unclear</tspan>
            <tspan data-lang-vi>Khó nhận ra tab đang mở</tspan>
          </text>
        </g>

        {/* Accented version */}
        <g transform="translate(222, 44)">
          <text x="0" y="12" class="fab-sub is-accent">
            <tspan data-lang-en>3px bottom accent</tspan>
            <tspan data-lang-vi>Gạch nhấn đáy 3px</tspan>
          </text>
          <rect x="0" y="22" width="184" height="82" rx="6" class="fab-flat" />
          <line x1="0" y1="56" x2="184" y2="56" class="fab-rule" />
          <text x="12" y="45" class="fab-item-title is-accent">
            <tspan data-lang-en>Logs</tspan>
            <tspan data-lang-vi>Nhật ký</tspan>
          </text>
          <rect x="10" y="53" width="46" height="3.5" rx="1.5" class="fab-accent-fill" />
          <text x="68" y="45" class="fab-item-sub">
            <tspan data-lang-en>Metrics</tspan>
            <tspan data-lang-vi>Chỉ số</tspan>
          </text>
          <text x="128" y="45" class="fab-item-sub">
            <tspan data-lang-en>Alerts</tspan>
            <tspan data-lang-vi>Cảnh báo</tspan>
          </text>
          <text x="12" y="82" class="fab-item-note">
            <tspan data-lang-en>Anchors current location</tspan>
            <tspan data-lang-vi>Định vị rõ màn hình hiện tại</tspan>
          </text>
        </g>
      </g>

      {/* Quadrant 3: Top-of-card highlight bar */}
      <g transform="translate(16, 218)">
        <rect x="0" y="0" width="424" height="184" rx="10" class="fab-panel" />
        <text x="16" y="26" class="fab-head">
          <tspan data-lang-en>3. Top-of-card highlight bar</tspan>
          <tspan data-lang-vi>3. Thanh nhấn mép trên thẻ</tspan>
        </text>

        {/* Flat version */}
        <g transform="translate(16, 44)">
          <text x="0" y="12" class="fab-sub is-muted">
            <tspan data-lang-en>Plain card</tspan>
            <tspan data-lang-vi>Thẻ phẳng</tspan>
          </text>
          <rect x="0" y="22" width="184" height="82" rx="6" class="fab-flat" />
          <text x="14" y="48" class="fab-item-title is-muted">
            <tspan data-lang-en>Team plan</tspan>
            <tspan data-lang-vi>Gói nhóm</tspan>
          </text>
          <text x="14" y="68" class="fab-item-sub">
            <tspan data-lang-en>$29 / month</tspan>
            <tspan data-lang-vi>29 USD / tháng</tspan>
          </text>
          <text x="14" y="88" class="fab-item-sub">
            <tspan data-lang-en>Same weight as every card</tspan>
            <tspan data-lang-vi>Mờ nhạt như mọi thẻ khác</tspan>
          </text>
        </g>

        {/* Accented version */}
        <g transform="translate(222, 44)">
          <text x="0" y="12" class="fab-sub is-accent">
            <tspan data-lang-en>4px top accent</tspan>
            <tspan data-lang-vi>Viền nhấn trên 4px</tspan>
          </text>
          <g transform="translate(0, 22)" clip-path={`url(#${cardClipId})`}>
            <rect x="0" y="0" width="184" height="82" class="fab-flat-fill" />
            <rect x="0" y="0" width="184" height="4.5" class="fab-accent-fill" />
          </g>
          <rect x="0" y="22" width="184" height="82" rx="6" class="fab-outline" />
          <text x="14" y="48" class="fab-item-title">
            <tspan data-lang-en>Team plan</tspan>
            <tspan data-lang-vi>Gói nhóm</tspan>
          </text>
          <text x="14" y="68" class="fab-item-sub">
            <tspan data-lang-en>$29 / month</tspan>
            <tspan data-lang-vi>29 USD / tháng</tspan>
          </text>
          <text x="14" y="88" class="fab-item-note">
            <tspan data-lang-en>Draws the eye without a loud box</tspan>
            <tspan data-lang-vi>Nổi bật mà không cần khung dày</tspan>
          </text>
        </g>
      </g>

      {/* Quadrant 4: Callout / quote rule */}
      <g transform="translate(460, 218)">
        <rect x="0" y="0" width="424" height="184" rx="10" class="fab-panel" />
        <text x="16" y="26" class="fab-head">
          <tspan data-lang-en>4. Callout or quote rule</tspan>
          <tspan data-lang-vi>4. Đường dẫn cạnh ghi chú</tspan>
        </text>

        {/* Flat version */}
        <g transform="translate(16, 44)">
          <text x="0" y="12" class="fab-sub is-muted">
            <tspan data-lang-en>Boxed grey note</tspan>
            <tspan data-lang-vi>Khung ghi chú xám</tspan>
          </text>
          <rect x="0" y="22" width="184" height="82" rx="6" class="fab-flat" />
          <text x="12" y="48" class="fab-item-sub">
            <tspan data-lang-en>Keep background contrast</tspan>
            <tspan data-lang-vi>Giữ độ tương phản nền</tspan>
          </text>
          <text x="12" y="66" class="fab-item-sub">
            <tspan data-lang-en>low so copy stays crisp.</tspan>
            <tspan data-lang-vi>thật thấp để chữ luôn rõ.</tspan>
          </text>
          <text x="12" y="88" class="fab-item-sub">
            <tspan data-lang-en>Feels heavy and generic</tspan>
            <tspan data-lang-vi>Nặng nề và thiếu điểm nhấn</tspan>
          </text>
        </g>

        {/* Accented version */}
        <g transform="translate(222, 44)">
          <text x="0" y="12" class="fab-sub is-accent">
            <tspan data-lang-en>3.5px left rule</tspan>
            <tspan data-lang-vi>Đường nhấn trái 3.5px</tspan>
          </text>
          <rect x="0" y="24" width="3.5" height="76" rx="1.75" class="fab-accent-fill" />
          <text x="14" y="48" class="fab-item-title">
            <tspan data-lang-en>Keep background contrast</tspan>
            <tspan data-lang-vi>Giữ độ tương phản nền</tspan>
          </text>
          <text x="14" y="66" class="fab-item-title">
            <tspan data-lang-en>low so copy stays crisp.</tspan>
            <tspan data-lang-vi>thật thấp để chữ luôn rõ.</tspan>
          </text>
          <text x="14" y="90" class="fab-item-note">
            <tspan data-lang-en>Editorial rhythm, zero box clutter</tspan>
            <tspan data-lang-vi>Nhịp điệu gọn, bỏ hẳn khung thừa</tspan>
          </text>
        </g>
      </g>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A single 3–4px accent edge adds brand personality and visual hierarchy without wrapping all four sides in a loud border.</span>
    <span data-lang-vi>Chỉ cần một cạnh nhấn dày 3–4px đã đủ tạo cá tính thương hiệu và phân cấp thị giác mà không cần đóng khung đậm cả bốn phía.</span>
  </figcaption>
</figure>

<style>
  .fab { margin: 2em 0; width: 100%; }
  .fab-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .fab svg { width: 100%; min-width: 640px; height: auto; display: block; font-family: inherit; }

  .fab-panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .fab-head { font-size: 14.5px; font-weight: 600; fill: var(--text); }
  .fab-sub { font-size: 12px; font-weight: 500; }
  .fab-sub.is-muted { fill: var(--text-muted); }
  .fab-sub.is-accent { fill: var(--red); }

  .fab-flat { fill: var(--bg); stroke: var(--border); stroke-width: 1; }
  .fab-flat-fill { fill: var(--bg); }
  .fab-tint { fill: var(--red-tint-bg); }
  .fab-outline { fill: none; stroke: var(--border); stroke-width: 1; }
  .fab-rule { stroke: var(--border); stroke-width: 1; }
  .fab-accent-fill { fill: var(--red); }

  .fab-item-title { font-size: 12.5px; font-weight: 600; fill: var(--text); }
  .fab-item-title.is-muted { fill: var(--text-body); font-weight: 500; }
  .fab-item-title.is-accent { fill: var(--red); }
  .fab-item-sub { font-size: 11.5px; fill: var(--text-muted); }
  .fab-item-note { font-size: 11.5px; fill: var(--red); }

  .fab figcaption { margin-top: 0.8em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
