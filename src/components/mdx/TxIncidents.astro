---
// Four incidents from the intro, one card each: what the system did and how much it cost.
// Plain inline SVG, site tokens only. Facts are the ones already stated in the post text.
import DiagramIcon from './DiagramIcon.astro';

const cards = [
  { x: 20, icon: 'money', name: 'Flexcoin', when: { en: 'March 2014', vi: 'Tháng 3/2014' },
    lines: [{ en: 'Concurrent transfers ran', vi: 'Nhiều lệnh chuyển chạy' }, { en: 'before the balance was', vi: 'trước khi số dư bị' }, { en: 'reduced.', vi: 'trừ đi.' }],
    out: [{ en: '896 BTC drained;', vi: 'Mất 896 BTC;' }, { en: 'service shut down', vi: 'dịch vụ đóng cửa' }] },
  { x: 240, icon: 'bank', name: 'Poloniex', when: { en: 'Two days later', vi: 'Hai ngày sau' },
    lines: [{ en: 'Simultaneous withdrawals', vi: 'Nhiều lệnh rút cùng lúc' }, { en: 'passed the balance check,', vi: 'qua được bước kiểm tra' }, { en: 'down to -8 BTC.', vi: 'số dư, xuống -8 BTC.' }],
    out: [{ en: '12.3% of every bitcoin', vi: '12,3% số bitcoin' }, { en: 'on the exchange', vi: 'trên sàn bị rút' }] },
  { x: 460, icon: 'card', name: 'Starbucks', when: { en: '2015', vi: '2015' },
    lines: [{ en: 'Two browser sessions', vi: 'Hai session trình duyệt' }, { en: 'confirmed the same $5', vi: 'cùng confirm một lệnh' }, { en: 'transfer at once.', vi: 'chuyển $5 một lúc.' }],
    out: [{ en: 'Cards ended up', vi: 'Hai thẻ còn' }, { en: 'holding $15 and $5', vi: '$15 và $5' }] },
  { x: 680, icon: 'receipt', name: 'UK Post Office', when: { en: 'Horizon, PEAK 0195561', vi: 'Horizon, PEAK 0195561' },
    lines: [{ en: 'A crash in the middle of', vi: 'Một vụ crash giữa chừng' }, { en: 'a transfer printed', vi: 'khi chuyển tiền in ra' }, { en: 'duplicate receipts.', vi: 'biên lai trùng.' }],
    out: [{ en: 'Two £4,000 receipts;', vi: 'Hai biên lai £4,000;' }, { en: 'stock unit £4,000 short', vi: 'kho thiếu £4,000' }] },
];
---
<figure class="txin">
  <div class="txin-scroll">
  <svg viewBox="0 0 900 330" role="img" aria-label="Four incident cards. Flexcoin, March 2014: concurrent transfers ran before the balance was reduced, 896 BTC drained. Poloniex, two days later: simultaneous withdrawals passed the balance check down to minus 8 BTC, 12.3 percent of every bitcoin on the exchange. Starbucks, 2015: two sessions confirmed the same 5 dollar transfer at once, cards ended up holding 15 and 5 dollars. UK Post Office Horizon: a crash mid-transfer printed duplicate 4,000 pound receipts and left a stock unit 4,000 pounds short.">
    <text x="20" y="26" class="h">
      <tspan data-lang-en>Four real incidents, two patterns</tspan>
      <tspan data-lang-vi>Bốn sự cố thật, hai khuôn mẫu</tspan>
    </text>
    {cards.map((c) => (
      <g>
        <rect x={c.x} y="44" width="200" height="214" rx="6" class="txin-panel" />
        <DiagramIcon name={c.icon} x={c.x + 28} y={74} size={30} />
        <text x={c.x + 54} y="72" class="b">
          <tspan data-lang-en>{c.name}</tspan><tspan data-lang-vi>{c.name}</tspan>
        </text>
        <text x={c.x + 54} y="89" class="note">
          <tspan data-lang-en>{c.when.en}</tspan><tspan data-lang-vi>{c.when.vi}</tspan>
        </text>
        <line x1={c.x + 12} y1="106" x2={c.x + 188} y2="106" class="txin-life" />
        {c.lines.map((l, i) => (
          <text x={c.x + 14} y={130 + i * 19} class="m">
            <tspan data-lang-en>{l.en}</tspan><tspan data-lang-vi>{l.vi}</tspan>
          </text>
        ))}
        <rect x={c.x + 10} y="200" width="180" height="48" rx="4" class="txin-box is-bad" />
        {c.out.map((l, i) => (
          <text x={c.x + 100} y={220 + i * 18} class="b" text-anchor="middle">
            <tspan data-lang-en>{l.en}</tspan><tspan data-lang-vi>{l.vi}</tspan>
          </text>
        ))}
      </g>
    ))}
    <rect x="20" y="272" width="860" height="42" rx="6" class="txin-box" />
    <text x="450" y="298" class="m" text-anchor="middle">
      <tspan data-lang-en>The first three: two requests slipped past one check. The fourth: a crash left a transfer half done.</tspan>
      <tspan data-lang-vi>Ba vụ đầu: hai request cùng lọt qua một lần kiểm tra. Vụ thứ tư: crash làm giao dịch dang dở.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Each card is one of the incidents from the list above. Notice that three of the four went the same way: a check ran, something else happened before the write landed, and the system acted on a stale answer. The fourth is different: a crash left the transfer half done.</span>
    <span data-lang-vi>Mỗi thẻ là một sự cố trong danh sách trên. Để ý ba trong bốn vụ đi theo cùng một kiểu: có bước kiểm tra, rồi có chuyện khác xảy ra trước khi lệnh ghi tới nơi, và hệ thống hành động theo câu trả lời đã cũ. Vụ thứ tư khác: crash làm lệnh chuyển dang dở.</span>
  </figcaption>
</figure>

<style>
  .txin { margin: 2em 0; width: 100%; }
  .txin-scroll { overflow-x: auto; }
  .txin svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .txin text { font-size: 13px; fill: var(--text-body); }
  .txin .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .txin .sec { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .txin .sec.is-bad { fill: var(--red); }
  .txin .b { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .txin .m { font-size: 12.5px; fill: var(--text-body); }
  .txin .mono { font-family: var(--font-mono, ui-monospace, monospace); font-size: 12px; }
  .txin .note { font-size: 12px; fill: var(--text-muted); }
  .txin .note.is-bad { fill: var(--red); font-weight: 600; }
  .txin .note.is-ok { fill: var(--gold-icon); font-weight: 600; }
  .txin .num { font-size: 12px; font-weight: 700; fill: var(--text); }
  .txin-panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .txin-panel.is-bad { stroke: var(--red); }
  .txin-panel.is-ok { stroke: var(--gold); }
  .txin-box { fill: var(--card-bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .txin-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .txin-box.is-ok { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .txin-dot { fill: var(--card-bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .txin-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .txin-arrow.is-bad { stroke: var(--red); }
  .txin-arrow.is-ok { stroke: var(--gold); }
  .txin-dash { stroke-dasharray: 4 4; }
  .txin-head { fill: var(--text-muted); }
  .txin-head.is-bad { fill: var(--red); }
  .txin-head.is-ok { fill: var(--gold); }
  .txin-life { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .txin figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.5; }
</style>
