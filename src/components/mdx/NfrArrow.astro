---
// A straight arrow drawn as a line plus a polygon head (no SVG markers or ids, safe to render twice).
interface Props { x1: number; y1: number; x2: number; y2: number; tone?: 'red' | 'gold' | ''; dash?: boolean }
const { x1, y1, x2, y2, tone = '', dash = false } = Astro.props;
const a = Math.atan2(y2 - y1, x2 - x1);
const len = 9;
const p = (d: number, off: number) => `${(x2 - d * Math.cos(a) - off * Math.sin(a)).toFixed(1)},${(y2 - d * Math.sin(a) + off * Math.cos(a)).toFixed(1)}`;
const head = `${x2.toFixed(1)},${y2.toFixed(1)} ${p(len, 4.5)} ${p(len, -4.5)}`;
const lx = x2 - 7 * Math.cos(a);
const ly = y2 - 7 * Math.sin(a);
const t = tone ? ` is-${tone}` : '';
---
<g>
  <line x1={x1} y1={y1} x2={lx} y2={ly} class={`edge${t}${dash ? ' is-dash' : ''}`} />
  <polygon points={head} class={`ah${t}`} />
</g>
