---
import DiagramIcon from './DiagramIcon.astro';
// Real numbers from Moody & Saffell, "Reinforcement Learning for Trading" (NIPS 11, 1998/1999):
// monthly S&P 500 vs 3-month T-bill, test period Jan 1970 - Dec 1994, transaction cost 0.5%.
// Annualised monthly Sharpe ratios of excess returns: buy and hold 0.34, Q-trader voting 0.63, RRL voting 0.83.
const W = 900;
const H = 360;
const bars = [
  { en: 'Buy and hold', vi: 'Mua và giữ', v: 0.34, hot: false },
  { en: 'Q-learning trader', vi: 'Trader Q-learning', v: 0.63, hot: false },
  { en: 'RRL trader (policy gradient)', vi: 'Trader RRL (policy gradient)', v: 0.83, hot: true },
];
const bw = (v: number) => v * 480;
---
<figure class="p19-mr">
  <div class="p19-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Sharpe ratios from a 1999 reinforcement learning paper on monthly S&P 500 data, test period 1970 to 1994, with a 0.5 percent transaction cost: buy and hold 0.34, a Q-learning trader 0.63, a recurrent reinforcement learning trader 0.83.">
      <text x="30" y="28" class="h">
        <tspan data-lang-en>An early RL trader, tested 25 years out of sample</tspan>
        <tspan data-lang-vi>Một trader RL đời đầu, thử 25 năm ngoài mẫu</tspan>
      </text>
      <text x="30" y="52" class="s">
        <tspan data-lang-en>Annualised Sharpe ratio, monthly S&P 500 vs 3-month T-bill, Jan 1970 – Dec 1994, cost 0.5% per trade</tspan>
        <tspan data-lang-vi>Sharpe quy năm, S&P 500 theo tháng so với tín phiếu 3 tháng, 1/1970 – 12/1994, phí 0,5% mỗi lần giao dịch</tspan>
      </text>
      {bars.map((b, i) => (
        <g>
          <text x="30" y={110 + i * 62} class="lab">
            <tspan data-lang-en>{b.en}</tspan>
            <tspan data-lang-vi>{b.vi}</tspan>
          </text>
          <rect x="300" y={90 + i * 62} width={bw(b.v)} height="34" rx="5" class={b.hot ? 'bar hot' : 'bar'} />
          <text x={308 + bw(b.v)} y={113 + i * 62} class="num">
            <tspan data-lang-en>{b.v.toFixed(2)}</tspan>
            <tspan data-lang-vi>{b.v.toFixed(2).replace('.', ',')}</tspan>
          </text>
        </g>
      ))}
      <rect x="30" y="288" width="840" height="52" rx="8" class="note" />
      <DiagramIcon name="calendar" x={56} y={314} size={22} />
      <text x="82" y="308" class="s2">
        <tspan data-lang-en>Walk-forward: each year it was retrained on the previous 20 years, then traded the next year.</tspan>
        <tspan data-lang-vi>Walk-forward: mỗi năm huấn luyện lại trên 20 năm trước, rồi giao dịch năm kế tiếp.</tspan>
      </text>
      <text x="82" y="328" class="s2">
        <tspan data-lang-en>One market, one 25-year path, 84 input series. It shows a method, not a promise.</tspan>
        <tspan data-lang-vi>Một thị trường, một chuỗi 25 năm, 84 chuỗi đầu vào. Nó chứng minh một phương pháp, không phải lời hứa.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Source: Moody and Saffell, "Reinforcement Learning for Trading". Sharpe ratios as reported in the paper.</span>
    <span data-lang-vi>Nguồn: Moody và Saffell, "Reinforcement Learning for Trading". Sharpe đúng như số bài báo công bố.</span>
  </figcaption>
</figure>

<style>
  .p19-mr { margin: 2em 0; width: 100%; }
  .p19-scroll { overflow-x: auto; }
  .p19-mr svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .p19-mr text { font-size: 14px; fill: var(--text-body); }
  .p19-mr .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p19-mr .s { font-size: 12.5px; fill: var(--text-muted); }
  .p19-mr .s2 { font-size: 13px; fill: var(--text); }
  .p19-mr .lab { font-size: 14px; font-weight: 600; fill: var(--text); }
  .p19-mr .num { font-size: 15px; font-weight: 700; fill: var(--text); }
  .p19-mr .bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .p19-mr .bar.hot { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .p19-mr .note { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p19-mr figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
