---
// Three guarantees side by side: what each one covers (one object, many objects, many objects plus
// real time). Static SVG, site tokens only.
import ConsensusFigure from './ConsensusFigure.astro';
import DiagramIcon from './DiagramIcon.astro';
interface Props { lang: 'en' | 'vi' }
const { lang } = Astro.props;

const T = {
  en: {
    aria: 'Three cards. Linearizability covers one object and promises recency: a read that starts after a write finishes sees that write; example etcd v3 reads. Serializability covers many objects in a transaction and promises the transactions act as if run one at a time in some order, even one that ignores real time; example PostgreSQL SERIALIZABLE. Strict serializability covers many objects and real time together; examples Spanner and FoundationDB.',
    cards: [
      { icons: ['db'], title: 'Linearizability', scope: 'Covers one object', body: ['Recency: a read that starts after', 'a write finishes must see it.'], ex: 'etcd v3 reads', exIcon: 'etcd', kind: '' },
      { icons: ['file', 'file', 'file'], title: 'Serializability', scope: 'Covers many objects', body: ['Transactions act as if run one', 'at a time, in some order, even', 'one that ignores real time.'], ex: 'PostgreSQL SERIALIZABLE', exIcon: 'postgres', kind: '' },
      { icons: ['file', 'file', 'clock'], title: 'Strict serializability', scope: 'Many objects plus real time', body: ['Both at once: that one order', 'must also match real', 'finish-before-start order.'], ex: 'Spanner, FoundationDB', exIcon: '', kind: 'is-ok' },
    ],
    cap: 'Linearizability is about one object and time; serializability is about many objects and isolation. Only strict serializability gives both.',
  },
  vi: {
    aria: 'Ba thẻ. Khả tuyến tính áp dụng cho một đối tượng và hứa tính mới: lần đọc bắt đầu sau khi một lần ghi kết thúc phải thấy lần ghi đó; ví dụ các lần đọc của etcd v3. Tuần tự hoá áp dụng cho nhiều đối tượng trong giao dịch và hứa các giao dịch chạy như thể lần lượt từng cái theo một thứ tự nào đó, kể cả thứ tự bỏ qua thời gian thực; ví dụ PostgreSQL SERIALIZABLE. Tuần tự hoá chặt áp dụng cho nhiều đối tượng cùng thời gian thực; ví dụ Spanner và FoundationDB.',
    cards: [
      { icons: ['db'], title: 'Khả tuyến tính', scope: 'Áp dụng cho một đối tượng', body: ['Tính mới: lần đọc bắt đầu sau', 'khi một lần ghi xong phải thấy nó.'], ex: 'đọc của etcd v3', exIcon: 'etcd', kind: '' },
      { icons: ['file', 'file', 'file'], title: 'Tuần tự hoá', scope: 'Áp dụng cho nhiều đối tượng', body: ['Giao dịch chạy như thể lần lượt', 'từng cái, theo một thứ tự nào đó,', 'kể cả thứ tự bỏ qua thời gian.'], ex: 'PostgreSQL SERIALIZABLE', exIcon: 'postgres', kind: '' },
      { icons: ['file', 'file', 'clock'], title: 'Tuần tự hoá chặt', scope: 'Nhiều đối tượng và thời gian thực', body: ['Cả hai cùng lúc: thứ tự đó còn', 'phải khớp thứ tự thật, cái nào', 'xong trước cái nào bắt đầu sau.'], ex: 'Spanner, FoundationDB', exIcon: '', kind: 'is-ok' },
    ],
    cap: 'Khả tuyến tính nói về một đối tượng và thời gian; tuần tự hoá nói về nhiều đối tượng và cô lập. Chỉ tuần tự hoá chặt mới có cả hai.',
  },
}[lang];
const cw = 280;
---
<ConsensusFigure aria={T.aria} cap={T.cap} w={900} h={236}>
  {T.cards.map((c, i) => {
    const x = i * 310;
    return (
      <g>
        <rect x={x} y="0" width={cw} height="236" rx="8" class={`cfg-box ${c.kind}`} />
        {c.icons.map((n, k) => <DiagramIcon name={n as any} x={x + 28 + k * 40} y={34} size={28} />)}
        <text x={x + 14} y={86} class="cfg-n" style="font-size:15px">{c.title}</text>
        <text x={x + 14} y={106} class="cfg-s">{c.scope}</text>
        {c.body.map((t, k) => <text x={x + 14} y={134 + k * 17}>{t}</text>)}
        <line x1={x + 14} x2={x + cw - 14} y1="192" y2="192" class="cfg-rule" />
        {c.exIcon && <DiagramIcon name={c.exIcon as any} x={x + 28} y={214} size={20} />}
        <text x={x + (c.exIcon ? 50 : 14)} y={218} class="cfg-code">{c.ex}</text>
      </g>
    );
  })}
</ConsensusFigure>
