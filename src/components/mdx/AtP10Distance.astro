---
// Correlation -> distance: d = sqrt(0.5 * (1 - rho)). Values from Python:
// rho 1 -> 0, 0.5 -> 0.5, 0 -> 0.7071, -0.5 -> 0.866, -1 -> 1.
// Also checked: d equals the Euclidean distance between the two standardised series divided by 2*sqrt(T).
const W = 900, H = 340;
const PX = 90, PY = 50, PW = 440, PH = 220;
const rx = (r: number) => PX + ((1 - r) / 2) * PW; // rho 1 at left, -1 at right
const dy = (d: number) => PY + PH - d * PH;
let path = '';
for (let i = 0; i <= 100; i++) {
  const r = 1 - (i / 100) * 2;
  const d = Math.sqrt(0.5 * (1 - r));
  path += `${i ? 'L' : 'M'} ${rx(r).toFixed(1)} ${dy(d).toFixed(1)} `;
}
const pts = [
  { r: 1, d: 0, en: 'same asset', vi: 'cùng một tài sản' },
  { r: 0.5, d: 0.5, en: 'move together', vi: 'đi cùng nhau' },
  { r: 0, d: 0.7071, en: 'unrelated', vi: 'không liên quan' },
  { r: -1, d: 1, en: 'mirror images', vi: 'ngược hẳn nhau' },
];
const f = (d: number, vi: boolean) => { const s = d.toFixed(2); return vi ? s.replace('.', ',') : s; };
---
<figure class="p10d">
  <div class="p10d-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Curve of distance against correlation. Correlation 1 gives distance 0, correlation 0.5 gives 0.5, correlation 0 gives 0.71 and correlation −1 gives distance 1. A box states the formula d equals the square root of one half times one minus rho.">
    <text x="20" y="28" class="p10d-h">
      <tspan data-lang-en>Turning correlation into a distance a clustering algorithm can use</tspan>
      <tspan data-lang-vi>Đổi tương quan thành khoảng cách để thuật toán phân cụm dùng được</tspan>
    </text>
    <line x1={PX} y1={PY + PH} x2={PX + PW} y2={PY + PH} class="p10d-axis" />
    <line x1={PX} y1={PY} x2={PX} y2={PY + PH} class="p10d-axis" />
    <path d={path} class="p10d-curve" />
    {pts.map((p) => (
      <g>
        <circle cx={rx(p.r)} cy={dy(p.d)} r="5.5" class="p10d-dot" />
        <text x={rx(p.r)} y={PY + PH + 20} text-anchor="middle" class="p10d-ax">
          <tspan data-lang-en>ρ = {p.r}</tspan>
          <tspan data-lang-vi>ρ = {String(p.r).replace('.', ',')}</tspan>
        </text>
        <text x={rx(p.r) + (p.r === -1 ? 6 : 12)} y={dy(p.d) + (p.r === 1 ? -10 : 24)} text-anchor={p.r === -1 ? 'end' : 'start'} class="p10d-pt">
          <tspan data-lang-en>d = {f(p.d, false)}</tspan>
          <tspan data-lang-vi>d = {f(p.d, true)}</tspan>
        </text>
      </g>
    ))}
    <text x={PX - 12} y={PY + 6} text-anchor="end" class="p10d-ax">d</text>
    <text x={PX + PW / 2} y={PY + PH + 44} text-anchor="middle" class="p10d-sub">
      <tspan data-lang-en>correlation ρ, from +1 (left) to −1 (right)</tspan>
      <tspan data-lang-vi>tương quan ρ, từ +1 (trái) đến −1 (phải)</tspan>
    </text>

    <rect x="580" y="70" width="300" height="190" rx="8" class="p10d-box" />
    <text x="598" y="100" class="p10d-f">d = √( ½ · (1 − ρ) )</text>
    <text x="598" y="128" class="p10d-t">
      <tspan data-lang-en>0 when two assets are identical</tspan>
      <tspan data-lang-vi>0 khi hai tài sản giống hệt nhau</tspan>
    </text>
    <text x="598" y="150" class="p10d-t">
      <tspan data-lang-en>1 when they are exact opposites</tspan>
      <tspan data-lang-vi>1 khi chúng hoàn toàn đối nghịch</tspan>
    </text>
    <text x="598" y="182" class="p10d-t">
      <tspan data-lang-en>It is the straight-line distance between</tspan>
      <tspan data-lang-vi>Đó là khoảng cách đường thẳng giữa</tspan>
    </text>
    <text x="598" y="202" class="p10d-t">
      <tspan data-lang-en>the two standardised return series,</tspan>
      <tspan data-lang-vi>hai chuỗi lợi suất đã chuẩn hóa,</tspan>
    </text>
    <text x="598" y="222" class="p10d-t">
      <tspan data-lang-en>scaled by 1 / (2√T). Checked in Python.</tspan>
      <tspan data-lang-vi>chia cho 2√T. Đã kiểm bằng Python.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Two stocks that are strongly negatively correlated are far apart: a hedge is not a neighbour.</span>
    <span data-lang-vi>Hai cổ phiếu tương quan âm mạnh nằm rất xa nhau: một công cụ phòng hộ không phải hàng xóm.</span>
  </figcaption>
</figure>

<style>
  .p10d { margin: 2em 0; width: 100%; }
  .p10d-scroll { overflow-x: auto; }
  .p10d svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .p10d text { font-size: 14px; fill: var(--text-body); }
  .p10d .p10d-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p10d .p10d-ax { font-size: 12.5px; fill: var(--text-muted); }
  .p10d .p10d-sub { font-size: 12.5px; fill: var(--text-muted); }
  .p10d .p10d-pt { font-size: 13px; font-weight: 700; fill: var(--text); }
  .p10d .p10d-f { font-size: 18px; font-weight: 700; fill: var(--text); }
  .p10d .p10d-t { font-size: 13.5px; }
  .p10d-axis { stroke: var(--text-muted); stroke-width: 1.2; }
  .p10d-curve { fill: none; stroke: var(--act-3); stroke-width: 2.6; }
  .p10d-dot { fill: var(--bg); stroke: var(--act-3); stroke-width: 2.4; }
  .p10d-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p10d figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
