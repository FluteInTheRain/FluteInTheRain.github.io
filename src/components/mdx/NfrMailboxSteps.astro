---
import DiagramIcon from './DiagramIcon.astro';
import NfrText from './NfrText.astro';
import NfrArrow from './NfrArrow.astro';
import NfrStep from './NfrStep.astro';
import './nfr-fig.css';
// Fan-out on write as four numbered steps. Numbers (30,000,000 followers, under 2 ms) come from the post.
const W = 900;
const H = 300;
const mb = [
  { y: 56, en: 'Follower 1 mailbox', vi: 'Hộp thư follower 1' },
  { y: 106, en: 'Follower 2 mailbox', vi: 'Hộp thư follower 2' },
  { y: 176, en: 'Follower 30,000,000', vi: 'Follower 30,000,000' },
];
---
<figure class="nf">
  <div class="nf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Fan-out on write in four steps: a celebrity posts; a worker asks the social graph who follows; the worker pushes the tweet ID into each follower's Redis mailbox, 30,000,000 writes; a follower opens the app and reads one mailbox in under 2 milliseconds.">
      <DiagramIcon name="user" x={60} y={123} size={32} />
      <NfrText x={60} y={162} anchor="middle" cls="n" en="Celebrity" vi="Người nổi tiếng" />
      <NfrArrow x1={90} y1={123} x2={216} y2={123} />
      <NfrStep x={153} y={104} n={1} />
      <NfrText x={153} y={146} anchor="middle" cls="s" en="posts a tweet" vi="đăng tweet" />

      <DiagramIcon name="worker" x={250} y={123} size={32} />
      <NfrText x={250} y={162} anchor="middle" cls="n" en="Fan-out workers" vi="Worker fan-out" />
      <NfrArrow x1={250} y1={176} x2={250} y2={218} />
      <NfrStep x={232} y={197} n={2} />
      <NfrText x={266} y={201} cls="s" en="who follows?" vi="ai theo dõi?" />
      <DiagramIcon name="db" x={250} y={244} size={32} />
      <NfrText x={290} y={248} cls="n" en="Social graph" vi="Đồ thị theo dõi" />

      <NfrArrow x1={282} y1={123} x2={430} y2={123} />
      <NfrStep x={356} y={104} n={3} />
      <NfrText x={356} y={146} anchor="middle" lh={14} cls="s" en={['push the ID into', 'every mailbox']} vi={['đẩy ID vào', 'từng hộp thư']} />

      {mb.map((m) => (
        <g>
          <rect x="440" y={m.y} width="210" height="34" rx="6" class="box" />
          <DiagramIcon name="redis" x={462} y={m.y + 17} size={22} />
          <NfrText x={482} y={m.y + 21} cls="n" en={m.en} vi={m.vi} />
        </g>
      ))}
      <text x="545" y="162" text-anchor="middle" class="n">...</text>
      <NfrText x={545} y={250} anchor="middle" cls="is-red" en="30,000,000 writes for one tweet" vi="30,000,000 lệnh ghi cho một tweet" />

      <NfrArrow x1={796} y1={123} x2={656} y2={123} tone="gold" />
      <NfrStep x={726} y={104} n={4} />
      <NfrText x={726} y={146} anchor="middle" lh={14} cls="s" en={['LRANGE,', 'under 2 ms']} vi={['LRANGE,', 'dưới 2 ms']} />
      <DiagramIcon name="laptop" x={830} y={123} size={32} />
      <NfrText x={830} y={162} anchor="middle" lh={14} cls="n" en={['Follower opens', 'the app']} vi={['Follower mở', 'ứng dụng']} />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Step 4 is why reading is fast. Step 3 is why one celebrity tweet is so expensive.</span>
    <span data-lang-vi>Bước 4 là lý do đọc nhanh. Bước 3 là lý do một tweet của người nổi tiếng quá đắt.</span>
  </figcaption>
</figure>
