---
// Picture first for "What one write really costs": the same 1 KB change
// becomes several physical writes in an LSM-tree and in a B-tree.
// Sizes are illustrative (16 KB is the InnoDB default page size the post cites).
// Plain inline SVG with site tokens, polygon arrowheads, no ids.
import DiagramIcon from './DiagramIcon.astro';
import type { DiagramIconName } from '../../data/diagram-icons';

const W = 900;
const H = 372;
const bw = 196;
const bh = 66;
const xs = [20, 240, 460, 680];

type Node = { icon: DiagramIconName; en: [string, string]; vi: [string, string]; hot?: boolean };
type Row = { y: number; headEn: string; headVi: string; nodes: (Node & { col: number })[] };

const rows: Row[] = [
  {
    y: 92,
    headEn: 'LSM-tree',
    headVi: 'LSM-tree',
    nodes: [
      { col: 0, icon: 'log', en: ['Write-ahead log', '1 KB written'], vi: ['Log ghi trước', 'ghi 1 KB'] },
      { col: 1, icon: 'disk', en: ['Memtable flush', '1 KB again'], vi: ['Flush memtable', 'lại 1 KB'] },
      { col: 2, icon: 'sync', en: ['Each compaction', '1 KB again'], vi: ['Mỗi lần compaction', 'lại 1 KB'] },
      { col: 3, icon: 'warning', hot: true, en: ['Several copies', 'of the same 1 KB'], vi: ['Nhiều bản sao', 'của cùng 1 KB'] },
    ],
  },
  {
    y: 218,
    headEn: 'B-tree',
    headVi: 'B-tree',
    nodes: [
      { col: 0, icon: 'log', en: ['Write-ahead log', '1 KB written'], vi: ['Log ghi trước', 'ghi 1 KB'] },
      { col: 1, icon: 'disk', en: ['Page in the tree', 'all 16 KB rewritten'], vi: ['Trang trong cây', 'ghi lại cả 16 KB'] },
      { col: 2, icon: 'warning', hot: true, en: ['1 KB log + a page', 'for a few bytes'], vi: ['1 KB log + 1 trang', 'cho vài byte đổi'] },
    ],
  },
];

function arrowRight(x1: number, x2: number, y: number) {
  return { line: `M${x1},${y} L${x2 - 7},${y}`, head: `${x2 - 8},${y - 5} ${x2 - 8},${y + 5} ${x2},${y}` };
}
---
<figure class="wa">
  <div class="wa-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="One 1 KB change written to an LSM-tree and to a B-tree. The LSM-tree writes it to the log, again when the memtable is flushed, and again in each compaction. The B-tree writes it to the log and rewrites the whole 16 KB page. Both add up to more bytes than the change itself.">
    <text x="20" y="24" class="wa-h">
      <tspan data-lang-en>One 1 KB change, several physical writes</tspan>
      <tspan data-lang-vi>Một thay đổi 1 KB, nhiều lần ghi vật lý</tspan>
    </text>
    <text x="20" y="46" class="wa-sub">
      <tspan data-lang-en>Write amplification is the bytes the disk writes divided by the bytes you changed.</tspan>
      <tspan data-lang-vi>Write amplification là số byte đĩa ghi chia cho số byte bạn thật sự đổi.</tspan>
    </text>

    {rows.map((r) => (
      <g>
        <text x="20" y={r.y - 10} class="wa-row">
          <tspan data-lang-en>{r.headEn}</tspan>
          <tspan data-lang-vi>{r.headVi}</tspan>
        </text>
        {r.nodes.map((n, i) => {
          const x = xs[n.col];
          const a = i > 0 ? arrowRight(xs[r.nodes[i - 1].col] + bw, x, r.y + bh / 2) : null;
          return (
            <g>
              <rect x={x} y={r.y} width={bw} height={bh} rx="4" class={n.hot ? 'wa-box is-hot' : 'wa-box'} />
              <DiagramIcon name={n.icon} x={x + 28} y={r.y + bh / 2} size={28} />
              <text x={x + 54} y={r.y + 28} class="wa-in">
                <tspan data-lang-en>{n.en[0]}</tspan>
                <tspan data-lang-vi>{n.vi[0]}</tspan>
              </text>
              <text x={x + 54} y={r.y + 48} class={n.hot ? 'wa-in-m is-hot' : 'wa-in-m'}>
                <tspan data-lang-en>{n.en[1]}</tspan>
                <tspan data-lang-vi>{n.vi[1]}</tspan>
              </text>
              {a && (<g><path d={a.line} class="wa-arrow" /><polygon points={a.head} class="wa-head" /></g>)}
            </g>
          );
        })}
      </g>
    ))}

    <line x1="20" x2={W - 20} y1="316" y2="316" class="wa-rule" />
    <text x="20" y="342" class="wa-note">
      <tspan data-lang-en>Sizes are illustrative. The LSM-tree repeats the write once per compaction that touches the value.</tspan>
      <tspan data-lang-vi>Kích thước chỉ để minh hoạ. LSM-tree lặp lại lần ghi ở mỗi lần compaction đụng tới giá trị.</tspan>
    </text>
    <text x="20" y="360" class="wa-note">
      <tspan data-lang-en>On SSDs, more writes also means the drive wears out sooner.</tspan>
      <tspan data-lang-vi>Với SSD, ghi nhiều hơn còn làm ổ mòn nhanh hơn.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Look at the last box in each row: the disk writes more than the 1 KB you changed. Both families pay, in different places.</span>
    <span data-lang-vi>Nhìn ô cuối mỗi hàng: đĩa ghi nhiều hơn 1 KB bạn đổi. Cả hai họ đều trả giá, chỉ khác chỗ.</span>
  </figcaption>
</figure>

<style>
  .wa { margin: 2em 0; width: 100%; }
  .wa-scroll { overflow-x: auto; }
  .wa svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .wa text { font-size: 14px; fill: var(--text-body); }
  .wa .wa-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .wa .wa-sub { fill: var(--text-muted); }
  .wa .wa-row { font-weight: 700; fill: var(--text); }
  .wa-rule { stroke: var(--border); }
  .wa-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .wa-box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .wa .wa-in { font-size: 13px; font-weight: 600; fill: var(--text); }
  .wa .wa-in-m { font-size: 13px; fill: var(--text-body); }
  .wa .wa-in-m.is-hot { fill: var(--red); font-weight: 700; }
  .wa .wa-note { font-size: 13px; fill: var(--text-muted); }
  .wa-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .wa-head { fill: var(--text-muted); }
  .wa figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
