---
// What a retry is allowed to do, drawn twice. Row one: POST without
// protection — the first request arrived, the answer died, the retry
// files a second case. Row two (the red accent, the pattern you own):
// an idempotency key makes the retry replay the saved answer instead.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 354;
const rows = [
  {
    title: { en: 'POST with no idempotency key', vi: 'POST không kèm idempotency key' },
    y: 0, red: false,
    req1: { en: '1 · POST create — the server files case 14', vi: '1 · POST create — server ghi vụ 14' },
    resp1: { en: 'the answer dies on the way back — timeout', vi: 'hồi âm chết giữa đường về — timeout' },
    req2: { en: '2 · the client cannot tell — it retries the same POST', vi: '2 · không biết kết quả, client gửi lại đúng POST đó' },
    resp2: { en: '201 Created — the server files case 15 too', vi: '201 Created — server ghi thêm cả vụ 15' },
  },
  {
    title: { en: 'POST with an Idempotency-Key', vi: 'POST kèm Idempotency-Key' },
    y: 172, red: true,
    req1: { en: '1 · POST create, key KG5LxwFBepaKHyUD — files case 14', vi: '1 · POST create, khoá KG5LxwFBepaKHyUD — ghi vụ 14' },
    resp1: { en: 'the answer dies again — the client retries', vi: 'hồi âm lại mất — client thử lại' },
    req2: { en: '2 · retry, same key', vi: '2 · thử lại, đúng khoá đó' },
    resp2: { en: 'the saved answer replays: 201, case 14 — no second case', vi: 'phát lại câu đã lưu: 201, vụ 14 — không có vụ thứ hai' },
  },
];
---
<figure class="bep2e">
  <div class="bep2e-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two retry timelines. Without an idempotency key: the POST arrives and the server files case 14, the response dies on the way back, the retry files a second case 15. With an idempotency key: the retry with the same key replays the saved answer — 201, case 14 — and no second case is created.">
    {rows.map((r) => (
      <g>
        <text x="20" y={r.y + 22} class={r.red ? 'tt r' : 'tt'}><tspan data-lang-en>{r.title.en}</tspan><tspan data-lang-vi>{r.title.vi}</tspan></text>
        <circle cx="60" cy={r.y + 48} r="17" class="disc" />
        <image href="/icons/flow/curl.svg" x="48" y={r.y + 36} width="24" height="24" class="icn" aria-hidden="true" />
        <text x="60" y={r.y + 76} text-anchor="middle" class="nd">client</text>
        <circle cx="840" cy={r.y + 48} r="17" class="disc" />
        <image href="/icons/flow/fastapi.svg" x="828" y={r.y + 36} width="24" height="24" class="icn" aria-hidden="true" />
        <text x="840" y={r.y + 76} text-anchor="middle" class="nd">server</text>
        <text x="450" y={r.y + 38} text-anchor="middle" class={r.red ? 'al r' : 'al'}><tspan data-lang-en>{r.req1.en}</tspan><tspan data-lang-vi>{r.req1.vi}</tspan></text>
        {(() => { const a = arrow(92, r.y + 44, 804, r.y + 44); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
        {(() => { const a = arrow(808, r.y + 66, 96, r.y + 66); return <g><path d={a.line} class="ln d" /><polygon points={a.head} class="hd d" /></g>; })()}
        <text x="450" y={r.y + 88} text-anchor="middle" class="al"><tspan data-lang-en>{r.resp1.en}</tspan><tspan data-lang-vi>{r.resp1.vi}</tspan></text>
        <text x="450" y={r.y + 106} text-anchor="middle" class={r.red ? 'al r' : 'al'}><tspan data-lang-en>{r.req2.en}</tspan><tspan data-lang-vi>{r.req2.vi}</tspan></text>
        {(() => { const a = arrow(92, r.y + 112, 804, r.y + 112); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
        {(() => { const a = arrow(808, r.y + 134, 96, r.y + 134); return <g><path d={a.line} class={r.red ? 'lnr' : 'ln'} /><polygon points={a.head} class={r.red ? 'hdr' : 'hd'} /></g>; })()}
        <text x="450" y={r.y + 156} text-anchor="middle" class={r.red ? 'al r' : 'al'}><tspan data-lang-en>{r.resp2.en}</tspan><tspan data-lang-vi>{r.resp2.vi}</tspan></text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>A timeout is ambiguous — the request may already have arrived. Retry an unprotected POST and the server files the case twice. With an idempotency key, the server executes once, saves the answer under that key, and replays it to every retry carrying the same key — the pattern Stripe uses for every POST.</span>
    <span data-lang-vi>Timeout là tín hiệu mơ hồ — request có thể đã tới nơi từ lâu. POST không được bảo vệ mà cứ retry thì server ghi vụ hai lần. Có idempotency key, server chạy đúng một lần, lưu câu trả lời theo khoá đó, rồi phát lại cho mọi lần retry mang cùng khoá — đúng pattern Stripe dùng cho mọi POST.</span>
  </figcaption>
</figure>

<style>
  .bep2e { margin: 2em 0; width: 100%; }
  .bep2e-scroll { overflow-x: auto; }
  .bep2e svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep2e text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep2e .tt { font-weight: 700; fill: var(--text); font-size: 14px; }
  .bep2e .nd { fill: var(--text-muted); font-size: 11.5px; }
  .bep2e .al { fill: var(--text-body); font-size: 12.5px; }
  .bep2e .r { fill: var(--red); }
  .bep2e .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep2e .lnr { stroke: var(--red); stroke-width: 1.5; fill: none; }
  .bep2e .d { stroke-dasharray: 5 4; }
  .bep2e .hd { fill: var(--text-muted); }
  .bep2e .hdr { fill: var(--red); }
  .bep2e .disc { fill: none; }
  .bep2e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  :global([data-theme='dark']) .bep2e .disc { fill: rgba(255, 255, 255, 0.88); }
</style>
