---
import DemoFrame from './DemoFrame.astro';
import GoP15RaerCheckDemo from '../demos/GoP15RaerCheckDemo.tsx';
---
<figure class="gp15e">
  <DemoFrame title="Check a measurement against the RAER" titleVi="Đối chiếu số đo với RAER">
    <GoP15RaerCheckDemo client:visible />
  </DemoFrame>
  <figcaption>
    <span data-lang-en>Pick a dataset size, or change a budget, and see whether TFBO step 5 says stop or go on. The measurements are the ones from the program above.</span>
    <span data-lang-vi>Chọn cỡ dữ liệu hoặc sửa ngân sách để xem bước 5 của TFBO bảo dừng hay đi tiếp. Số đo là số từ chương trình ở trên.</span>
  </figcaption>
</figure>

<style is:global>
  .gp15e { margin: 2em 0; width: 100%; }
  .gp15e > .demo-frame { margin-bottom: 0; }
  .gp15e > figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  .gp15demo-row { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: flex-end; margin-bottom: 14px; }
  .gp15demo-label { font-size: 13px; font-weight: 600; color: var(--text-muted); }
  .gp15demo-field { display: flex; flex-direction: column; gap: 4px; font-size: 13px; font-weight: 600; color: var(--text-muted); }
  .gp15demo-field input { width: 150px; padding: 6px 8px; font-size: 14px; color: var(--text); background: var(--bg); border: 1px solid var(--border); border-radius: 6px; }
  .gp15demo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .gp15demo-cell { display: flex; flex-direction: column; gap: 4px; padding: 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-alt); }
  .gp15demo-cell b { font-size: 18px; color: var(--text); font-variant-numeric: tabular-nums; }
  .gp15demo-cell span { font-size: 13px; color: var(--text-muted); }
  .gp15demo-cell.is-over { border-color: var(--red); background: var(--red-tint-bg); }
  .gp15demo-cell.is-over b { color: var(--red); }
  .gp15demo-verdict { margin: 14px 0 0; font-size: 15px; line-height: 1.55; color: var(--text-body); }
</style>
