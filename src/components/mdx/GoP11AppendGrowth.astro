---
// Real Go 1.27.1 runtime.growslice steps for []int up to 10,000 appends (when slice starts at cap 4 -> 12288)
// alongside BenchmarkSliceNoCap vs BenchmarkSlicePrealloc measurements.
const W = 900;
const H = 384;

// Growth ratios measured from Go 1.27.1: cap transitions 4->8->...->256 (2.00x), then tapers above 256.
const steps = [
  { cap: 8, ratio: 2.00, label: '8', above: false },
  { cap: 16, ratio: 2.00, label: '16', above: false },
  { cap: 32, ratio: 2.00, label: '32', above: false },
  { cap: 64, ratio: 2.00, label: '64', above: false },
  { cap: 128, ratio: 2.00, label: '128', above: false },
  { cap: 256, ratio: 2.00, label: '256', above: false },
  { cap: 512, ratio: 2.00, label: '512', above: true },
  { cap: 848, ratio: 1.66, label: '848', above: true },
  { cap: 1280, ratio: 1.51, label: '1.3k', above: true },
  { cap: 1792, ratio: 1.40, label: '1.8k', above: true },
  { cap: 2560, ratio: 1.43, label: '2.6k', above: true },
  { cap: 3408, ratio: 1.33, label: '3.4k', above: true },
  { cap: 5120, ratio: 1.50, label: '5.1k', above: true },
  { cap: 7168, ratio: 1.40, label: '7.2k', above: true },
  { cap: 9216, ratio: 1.29, label: '9.2k', above: true },
  { cap: 12288, ratio: 1.33, label: '12.3k', above: true },
];

const plotX = 76;
const plotY = 58;
const plotW = 796;
const plotH = 148;
const baseLineY = plotY + plotH;
const barSlot = plotW / steps.length;
const barW = 34;

function yForRatio(r: number) {
  // Scale 1.0x .. 2.2x across plotH
  return baseLineY - ((r - 1.0) / 1.2) * plotH;
}

const threshX = plotX + 6 * barSlot + 2;
const line125Y = yForRatio(1.25);
const line200Y = yForRatio(2.0);
---
<figure class="gp11ag">
  <div class="gp11ag-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: Go 1.27.1 slice capacity growth factor doubles (2.0x) up to oldCap 256, then tapers between 1.66x and 1.29x toward 1.25x. Bottom: appending 10,000 ints without preallocation takes 19 allocations and 357,625 B/op versus 1 allocation and 81,920 B/op with make([]int, 0, 10_000).">
      <text x="16" y="26" class="h">
        <tspan data-lang-en>1. Growth factor per reallocation in Go 1.27.1 (nextslicecap + size-class rounding)</tspan>
        <tspan data-lang-vi>1. Hệ số tăng dung lượng mỗi lần cấp phát lại trên Go 1.27.1</tspan>
      </text>

      {/* Y gridlines */}
      <line x1={plotX} x2={plotX + plotW} y1={baseLineY} y2={baseLineY} class="axis" />
      <line x1={plotX} x2={plotX + plotW} y1={line125Y} y2={line125Y} class="grid dash" />
      <line x1={plotX} x2={plotX + plotW} y1={line200Y} y2={line200Y} class="grid" />

      <text x={plotX - 10} y={baseLineY + 5} text-anchor="end" class="m num">1.0x</text>
      <text x={plotX - 10} y={line125Y + 5} text-anchor="end" class="m num">1.25x</text>
      <text x={plotX - 10} y={line200Y + 5} text-anchor="end" class="m num">2.0x</text>

      {/* Threshold divider at oldCap = 256 */}
      <line x1={threshX} x2={threshX} y1={plotY - 12} y2={baseLineY} class="thresh" />
      <text x={threshX + 8} y={plotY - 2} class="r">
        <tspan data-lang-en>threshold oldCap = 256 (tapers toward 1.25x)</tspan>
        <tspan data-lang-vi>ngưỡng oldCap = 256 (giảm dần về 1,25x)</tspan>
      </text>

      {steps.map((st, i) => {
        const bx = plotX + i * barSlot + (barSlot - barW) / 2;
        const by = yForRatio(st.ratio);
        const bh = baseLineY - by;
        return (
          <g>
            <rect x={bx} y={by} width={barW} height={bh} rx="3" class={st.above ? 'bar gold' : 'bar'} />
            <text x={bx + barW / 2} y={baseLineY + 18} text-anchor="middle" class="m num">{st.label}</text>
          </g>
        );
      })}

      <text x={plotX + plotW / 2} y={baseLineY + 40} text-anchor="middle" class="m">
        <tspan data-lang-en>New slice capacity after each growslice step (integers)</tspan>
        <tspan data-lang-vi>Sức chứa cap mới sau mỗi bước growslice (số phần tử int)</tspan>
      </text>

      <line x1="16" x2={W - 16} y1="268" y2="268" class="rule" />

      {/* Bottom benchmark comparison */}
      <text x="16" y="298" class="h">
        <tspan data-lang-en>2. Appending 10,000 ints (go test -bench -benchmem on Apple M2, Go 1.27.1)</tspan>
        <tspan data-lang-vi>2. Append 10.000 số int (đo bằng go test -bench -benchmem trên Go 1.27.1)</tspan>
      </text>

      <text x="16" y="330" class="b">var s []int</text>
      <rect x="200" y="313" width="380" height="22" rx="4" class="bar red" />
      <text x="592" y="329" class="r num">357,625 B/op · 19 allocs/op · 48,359 ns/op</text>

      <text x="16" y="362" class="b">make([]int, 0, 10_000)</text>
      <rect x="200" y="345" width="87" height="22" rx="4" class="bar gold" />
      <text x="299" y="361" class="b num">81,920 B/op · 1 alloc/op · 28,653 ns/op</text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Below 256 elements, <code>runtime.growslice</code> doubles capacity on every jump; above 256, it tapers smoothly using <code>(oldCap + 3*256) / 4</code> plus allocator size-class rounding. Preallocating with <code>make([]int, 0, n)</code> cuts heap churn from 19 allocations (357,625 B) to 1 allocation (81,920 B).</span>
    <span data-lang-vi>Dưới 256 phần tử, <code>runtime.growslice</code> nhân đôi sức chứa mỗi lần đầy; qua ngưỡng 256, hệ số giảm dần theo công thức <code>(oldCap + 3*256) / 4</code> kết hợp làm tròn size class. Khai báo sẵn <code>make([]int, 0, n)</code> giảm từ 19 lần cấp phát (357.625 B) xuống 1 lần (81.920 B).</span>
  </figcaption>
</figure>

<style>
  .gp11ag { margin: 2em 0; width: 100%; }
  .gp11ag-scroll { overflow-x: auto; }
  .gp11ag svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp11ag text { font-size: 13.5px; fill: var(--text-body); }
  .gp11ag .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp11ag .b { font-weight: 700; fill: var(--text); }
  .gp11ag .m { fill: var(--text-muted); }
  .gp11ag .r { fill: var(--red); font-weight: 700; }
  .gp11ag .num { font-variant-numeric: tabular-nums; }
  .gp11ag .axis { stroke: var(--text-muted); stroke-width: 1.4; }
  .gp11ag .grid { stroke: var(--border); stroke-width: 1; }
  .gp11ag .grid.dash { stroke-dasharray: 4 3; }
  .gp11ag .thresh { stroke: var(--red); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .gp11ag .bar { fill: var(--text-muted); }
  .gp11ag .bar.gold { fill: var(--gold); }
  .gp11ag .bar.red { fill: var(--red); }
  .gp11ag .rule { stroke: var(--border); stroke-width: 1; }
  .gp11ag figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
