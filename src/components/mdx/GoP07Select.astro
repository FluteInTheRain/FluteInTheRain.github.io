---
// Static inline SVG, site tokens only, no ids/markers. All values come from the code shown next to the figure in the post.
// Icons: DiagramIcon (names from diagram-icons.ts). Motion: fig-motion.css.
import DiagramIcon from './DiagramIcon.astro';
---
<figure class="gp7s">
  <div class="gp7s-scroll">
  <svg viewBox="0 0 930 300" role="img" aria-label="Two timelines for select racing slowSquare against a 300 ms timer. For n = 1 the answer arrives at 100 ms and wins. For n = 5 the timer fires at 300 ms, select takes the timeout case, and the goroutine keeps running.">
<text x="20" y="24" class="h"><tspan data-lang-en>n = 1: the answer is faster than the timer</tspan><tspan data-lang-vi>n = 1: kết quả tới trước timer</tspan></text>
<DiagramIcon name="gopher" x={32} y={56} size={26} />
<text x="54" y="61" class="lane"><tspan data-lang-en>slowSquare(1)</tspan><tspan data-lang-vi>slowSquare(1)</tspan></text>
<DiagramIcon name="timer" x={32} y={92} size={26} />
<text x="54" y="97" class="lane"><tspan data-lang-en>time.After</tspan><tspan data-lang-vi>time.After</tspan></text>
<text x="20" y="144" class="h"><tspan data-lang-en>n = 5: the timer is faster than the answer</tspan><tspan data-lang-vi>n = 5: timer nổ trước khi có kết quả</tspan></text>
<g class="fm-bob"><DiagramIcon name="gopher" x={32} y={176} size={26} /></g>
<text x="54" y="181" class="lane"><tspan data-lang-en>slowSquare(5)</tspan><tspan data-lang-vi>slowSquare(5)</tspan></text>
<DiagramIcon name="timer" x={32} y={212} size={26} />
<text x="54" y="217" class="lane"><tspan data-lang-en>time.After</tspan><tspan data-lang-vi>time.After</tspan></text>
<g transform="translate(30 0)">
<line class="grid" x1="150.0" y1="40" x2="150.0" y2="262"/>
<text x="150.0" y="284" text-anchor="middle" class="mute num">0 ms</text>
<line class="grid" x1="290.0" y1="40" x2="290.0" y2="262"/>
<text x="290.0" y="284" text-anchor="middle" class="mute num">100 ms</text>
<line class="grid" x1="430.0" y1="40" x2="430.0" y2="262"/>
<text x="430.0" y="284" text-anchor="middle" class="mute num">200 ms</text>
<line class="grid" x1="570.0" y1="40" x2="570.0" y2="262"/>
<text x="570.0" y="284" text-anchor="middle" class="mute num">300 ms</text>
<line class="grid" x1="710.0" y1="40" x2="710.0" y2="262"/>
<text x="710.0" y="284" text-anchor="middle" class="mute num">400 ms</text>
<line class="grid" x1="850.0" y1="40" x2="850.0" y2="262"/>
<text x="850.0" y="284" text-anchor="middle" class="mute num">500 ms</text>
<rect class="bar" x="150.0" y="44" width="140.0" height="24" rx="3"/>
<text x="300.0" y="61" class="strong"><tspan data-lang-en>answer at 100 ms, first case runs</tspan><tspan data-lang-vi>kết quả tới lúc 100 ms, case đầu chạy</tspan></text>
<rect class="wait" x="150.0" y="80" width="420.0" height="24" rx="3"/>
<text x="300.0" y="97" class="mute"><tspan data-lang-en>timer still pending, not needed</tspan><tspan data-lang-vi>timer vẫn chạy, không cần dùng</tspan></text>
<line class="vline" x1="290.0" y1="40" x2="290.0" y2="108"/>
<rect class="bar" x="150.0" y="164" width="420.0" height="24" rx="3"/>
<rect class="bad fm-pulse" x="570.0" y="164" width="280.0" height="24" rx="3"/>
<text x="710.0" y="181" class="badtx" text-anchor="middle"><tspan data-lang-en>goroutine keeps going</tspan><tspan data-lang-vi>goroutine vẫn chạy tiếp</tspan></text>
<rect class="bar" x="150.0" y="200" width="420.0" height="24" rx="3"/>
<text x="580.0" y="217" class="strong"><tspan data-lang-en>timer fires at 300 ms, timeout case runs</tspan><tspan data-lang-vi>timer nổ lúc 300 ms, case timeout chạy</tspan></text>
<line class="vline" x1="570.0" y1="160" x2="570.0" y2="228"/>
</g>
  </svg>
  </div>
  <figcaption><span data-lang-en>Times come from the program above: slowSquare(n) sleeps n × 100 ms, the timer is 300 ms. select runs whichever case is ready first.</span><span data-lang-vi>Thời gian lấy từ chương trình ở trên: slowSquare(n) ngủ n × 100 ms, timer là 300 ms. select chạy case nào sẵn sàng trước.</span></figcaption>
</figure>

<style>
  .gp7s { margin: 2em 0; width: 100%; }
  .gp7s-scroll { overflow-x: auto; }
  .gp7s svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp7s text { font-size: 14px; fill: var(--text-body); }
  .gp7s .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp7s .lane { fill: var(--text-muted); font-weight: 600; }
  .gp7s .bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp7s .wait { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp7s .bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp7s .badtx { fill: var(--red); font-weight: 700; }
  .gp7s .mute { fill: var(--text-muted); }
  .gp7s .strong { fill: var(--text); font-weight: 600; }
  .gp7s .vline { stroke: var(--text-muted); stroke-width: 1.2; }
  .gp7s .vline.red { stroke: var(--red); }
  .gp7s .grid { stroke: var(--border); stroke-width: 1; }
  .gp7s .arrow { fill: var(--text-muted); }
  .gp7s .num { font-variant-numeric: tabular-nums; }
  .gp7s figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
