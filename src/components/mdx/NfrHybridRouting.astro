---
import DiagramIcon from './DiagramIcon.astro';
import NfrText from './NfrText.astro';
import NfrArrow from './NfrArrow.astro';
import './nfr-fig.css';
// Hybrid fan-out: the write path picks push or store-once by follower count; the read path merges both.
const W = 900;
const H = 345;
---
<figure class="nf">
  <div class="nf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Hybrid timeline. When someone posts: a regular user under 20,000 followers is pushed into follower mailboxes; a celebrity over 1,000,000 followers is written once to a celebrity store. When someone opens the app: a timeline merger reads their mailbox and the recent tweets of the celebrities they follow, and merges them in under 5 milliseconds.">
      <NfrText x={20} y={24} cls="h" en="When someone posts" vi="Khi có người đăng bài" />
      <DiagramIcon name="user" x={60} y={96} size={32} />
      <NfrText x={60} y={136} anchor="middle" cls="n" en="A user posts" vi="Người đăng" />
      <NfrArrow x1={90} y1={96} x2={148} y2={96} />
      <rect x="152" y="70" width="170" height="52" rx="8" class="box" />
      <NfrText x={237} y={93} anchor="middle" lh={16} cls="n" en={['How many', 'followers?']} vi={['Bao nhiêu', 'người theo dõi?']} />
      <NfrArrow x1={322} y1={84} x2={462} y2={62} />
      <NfrArrow x1={322} y1={108} x2={462} y2={132} tone="gold" />
      <rect x="466" y="38" width="360" height="50" rx="8" class="box" />
      <DiagramIcon name="redis" x={492} y={63} size={26} />
      <NfrText x={518} y={59} cls="n" en="Push into every follower's mailbox" vi="Đẩy vào hộp thư từng follower" />
      <NfrText x={518} y={77} cls="s" en="Regular user: under 20,000 followers" vi="Người thường: dưới 20,000 follower" />
      <rect x="466" y="108" width="360" height="50" rx="8" class="box is-gold" />
      <DiagramIcon name="db" x={492} y={133} size={26} />
      <NfrText x={518} y={129} cls="n" en="Write once to the celebrity store" vi="Ghi một lần vào kho người nổi tiếng" />
      <NfrText x={518} y={147} cls="s" en="Celebrity: over 1,000,000 followers" vi="Người nổi tiếng: trên 1,000,000 follower" />

      <line x1="20" y1="182" x2="880" y2="182" class="panel" />
      <NfrText x={20} y={206} cls="h" en="When someone opens the app" vi="Khi có người mở ứng dụng" />
      <DiagramIcon name="laptop" x={60} y={280} size={32} />
      <NfrText x={60} y={320} anchor="middle" cls="n" en="Follower" vi="Follower" />
      <NfrArrow x1={90} y1={280} x2={172} y2={280} />
      <rect x="176" y="252" width="170" height="56" rx="8" class="box is-gold" />
      <DiagramIcon name="server" x={202} y={280} size={26} />
      <NfrText x={226} y={276} lh={15} cls="n" en={['Timeline', 'merger']} vi={['Bộ hợp nhất', 'timeline']} />
      <NfrArrow x1={346} y1={266} x2={462} y2={242} />
      <NfrArrow x1={346} y1={294} x2={462} y2={318} />
      <rect x="466" y="218" width="360" height="50" rx="8" class="box" />
      <DiagramIcon name="redis" x={492} y={243} size={26} />
      <NfrText x={518} y={239} cls="n" en="My mailbox" vi="Hộp thư của mình" />
      <NfrText x={518} y={257} cls="s" en="Tweets from regular friends" vi="Tweet của bạn bè thường" />
      <rect x="466" y="290" width="360" height="50" rx="8" class="box is-gold" />
      <DiagramIcon name="db" x={492} y={315} size={26} />
      <NfrText x={518} y={311} cls="n" en="Celebrity store" vi="Kho người nổi tiếng" />
      <NfrText x={518} y={329} cls="s" en="Recent tweets of celebrities I follow" vi="Tweet mới của người nổi tiếng mình theo dõi" />
      <NfrText x={176} y={326} cls="s" en="merged in RAM: under 5 ms" vi="ghép trong RAM: dưới 5 ms" />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Most people get the cheap push. The few huge accounts skip it, and their tweets are merged in when you read.</span>
    <span data-lang-vi>Đa số người dùng được đẩy sẵn, rẻ. Vài tài khoản khổng lồ bỏ qua bước đó, và tweet của họ được ghép vào lúc bạn đọc.</span>
  </figcaption>
</figure>
