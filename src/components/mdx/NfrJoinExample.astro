---
import NfrText from './NfrText.astro';
import NfrArrow from './NfrArrow.astro';
import NfrStep from './NfrStep.astro';
import './nfr-fig.css';
// Fan-out on read, followed on made-up rows: what the JOIN query does for one feed open. Rows are illustrative.
const W = 900;
const H = 330;
const follows = [['me', 'ana'], ['me', 'bo'], ['me', 'cy']];
const tweets = [
  ['ana', 'lunch', '12:05', 1], ['bo', 'gm', '12:09', 1], ['dan', 'hello', '12:11', 0], ['cy', 'wow', '12:12', 1], ['eve', 'ok', '12:14', 0],
] as const;
const result = [['12:12', 'cy', 'wow'], ['12:09', 'bo', 'gm'], ['12:05', 'ana', 'lunch']];
const RH = 28;
const TOP = 92;
---
<figure class="nf">
  <div class="nf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Fan-out on read on example rows: step 1 find who me follows (ana, bo, cy); step 2 join with the tweets table, keeping tweets from those people and dropping dan and eve; step 3 sort newest first.">
      <NfrStep x={32} y={26} n={1} />
      <NfrText x={50} y={31} cls="h" en="Who do I follow?" vi="Mình theo dõi ai?" />
      <NfrStep x={330} y={26} n={2} />
      <NfrText x={348} y={31} cls="h" en="Keep their tweets" vi="Giữ tweet của họ" />
      <NfrStep x={660} y={26} n={3} />
      <NfrText x={678} y={31} cls="h" en="Newest first" vi="Mới nhất trước" />

      {/* follows */}
      <NfrText x={20} y={60} cls="s mono" en="follows" vi="follows" />
      <rect x="20" y="68" width="250" height={RH} class="box" />
      <text x="30" y="87" class="s mono">follower_id</text>
      <text x="150" y="87" class="s mono">followee_id</text>
      {follows.map((r, i) => (
        <g>
          <rect x="20" y={TOP + i * RH} width="250" height={RH} class="box is-gold" />
          <text x="30" y={TOP + i * RH + 19} class="mono">{r[0]}</text>
          <text x="150" y={TOP + i * RH + 19} class="mono">{r[1]}</text>
        </g>
      ))}

      {/* tweets */}
      <NfrText x={330} y={60} cls="s mono" en="tweets" vi="tweets" />
      <rect x="330" y="68" width="280" height={RH} class="box" />
      <text x="340" y="87" class="s mono">user_id</text>
      <text x="410" y="87" class="s mono">text</text>
      <text x="520" y="87" class="s mono">timestamp</text>
      {tweets.map((r, i) => (
        <g opacity={r[3] ? 1 : 0.5}>
          <rect x="330" y={TOP + i * RH} width="280" height={RH} class={r[3] ? 'box is-gold' : 'box'} />
          <text x="340" y={TOP + i * RH + 19} class="mono">{r[0]}</text>
          <text x="410" y={TOP + i * RH + 19} class="mono">{r[1]}</text>
          <text x="520" y={TOP + i * RH + 19} class="mono">{r[2]}</text>
        </g>
      ))}

      <NfrArrow x1={274} y1={TOP + 42} x2={324} y2={TOP + 42} />
      <NfrArrow x1={614} y1={TOP + 70} x2={654} y2={TOP + 70} />

      {/* result */}
      <NfrText x={660} y={60} cls="s mono" en="home timeline" vi="home timeline" />
      <rect x="660" y="68" width="220" height={RH} class="box" />
      <text x="670" y="87" class="s mono">timestamp</text>
      <text x="750" y="87" class="s mono">user</text>
      <text x="810" y="87" class="s mono">text</text>
      {result.map((r, i) => (
        <g>
          <rect x="660" y={TOP + i * RH} width="220" height={RH} class="box is-gold" />
          <text x="670" y={TOP + i * RH + 19} class="mono">{r[0]}</text>
          <text x="750" y={TOP + i * RH + 19} class="mono">{r[1]}</text>
          <text x="810" y={TOP + i * RH + 19} class="mono">{r[2]}</text>
        </g>
      ))}

      <NfrText x={20} y={262} cls="s" en="dan and eve are in the tweets table, but I do not follow them, so the JOIN drops their rows." vi="dan và eve có trong bảng tweets, nhưng mình không theo dõi họ, nên JOIN bỏ các dòng đó." />
      <rect x="20" y="278" width="860" height="40" rx="8" class="box is-red" />
      <NfrText x={450} y={303} anchor="middle" cls="n" en="This runs again for every feed open: 300,000 times per second. (Rows above are made up.)" vi="Câu này chạy lại mỗi lần mở feed: 300,000 lần mỗi giây. (Các dòng trên là ví dụ tự đặt.)" />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Highlighted rows are the ones that survive the JOIN. Notice how much work one feed open costs.</span>
    <span data-lang-vi>Các dòng được tô là dòng còn lại sau JOIN. Hãy để ý một lần mở feed tốn bao nhiêu việc.</span>
  </figcaption>
</figure>
