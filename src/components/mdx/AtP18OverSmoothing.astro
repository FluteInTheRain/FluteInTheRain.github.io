---
// Over-smoothing on the toy graph: apply the same averaging layer 0..12 times and draw each stock's number.
// Same matrix as calc.py (D^-1 (A+I)); the lines converge to the degree-weighted mean 1.004.
const names = ['HPG', 'HSG', 'NKG', 'VCB', 'BID', 'CTG', 'FPT', 'MWG'];
const x0 = [3.0, 2.4, 2.8, -0.4, -0.2, 0.1, 1.2, -1.5];
const edges: [number, number][] = [[0, 1], [0, 2], [1, 2], [3, 4], [3, 5], [4, 5], [6, 7], [0, 4], [6, 3]];
const nb: number[][] = names.map((_, i) => [i]);
edges.forEach(([a, b]) => { nb[a].push(b); nb[b].push(a); });
const L = 12;
const traj: number[][] = [x0];
for (let l = 1; l <= L; l++) {
  const prev = traj[l - 1];
  traj.push(nb.map((list) => list.reduce((s, j) => s + prev[j], 0) / list.length));
}
const spread = traj.map((t) => Math.max(...t) - Math.min(...t));
const W = 900;
const H = 384;
const PX0 = 70;
const PX1 = 590;
const PY0 = 66;
const PY1 = 300;
const vmin = -2;
const vmax = 3.5;
const gx = (l: number) => PX0 + (l / L) * (PX1 - PX0);
const gy = (v: number) => PY1 - ((v - vmin) / (vmax - vmin)) * (PY1 - PY0);
const path = (i: number) => traj.map((t, l) => `${l ? 'L' : 'M'} ${gx(l).toFixed(1)} ${gy(t[i]).toFixed(1)}`).join(' ');
const nv = (v: number) => v.toFixed(2);
---
<figure class="atp18-os">
  <div class="atp18-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Eight stock values on the toy graph after 0 to 12 averaging layers. The gap between the highest and lowest value shrinks from ${nv(spread[0])} at layer 0 to ${nv(spread[12])} at layer 12, and all lines drift toward 1.00.`}>
      <text x="20" y="24" class="h">
        <tspan data-lang-en>Stack more layers and every stock starts to look the same</tspan>
        <tspan data-lang-vi>Chồng thêm lớp và mọi mã bắt đầu giống nhau</tspan>
      </text>
      {[-2, -1, 0, 1, 2, 3].map((v) => (
        <g>
          <line x1={PX0} x2={PX1} y1={gy(v)} y2={gy(v)} class={v === 0 ? 'zero' : 'grid'} />
          <text x={PX0 - 8} y={gy(v) + 4} text-anchor="end" class="tick">{v}</text>
        </g>
      ))}
      {[0, 2, 4, 6, 8, 10, 12].map((l) => (
        <text x={gx(l)} y={PY1 + 20} text-anchor="middle" class="tick">{l}</text>
      ))}
      <text x={(PX0 + PX1) / 2} y={PY1 + 42} text-anchor="middle" class="axis">
        <tspan data-lang-en>layers stacked</tspan>
        <tspan data-lang-vi>số lớp chồng lên</tspan>
      </text>
      <line x1={PX0} x2={PX1} y1={gy(1.004)} y2={gy(1.004)} class="limit" />
      {names.map((nm, i) => (
        <path d={path(i)} class={i === 0 ? 'ln hot' : i === 7 ? 'ln cold' : 'ln'} />
      ))}
      <text x={PX1 + 10} y={gy(traj[L][0]) - 6} class="lab hot">HPG</text>
      <text x={PX1 + 10} y={gy(traj[L][7]) + 16} class="lab cold">MWG</text>
      <text x={PX1 + 10} y={gy(1.004) + 4} class="lab">
        <tspan data-lang-en>limit 1.00</tspan>
        <tspan data-lang-vi>giới hạn 1,00</tspan>
      </text>
      <rect x="730" y="66" width="150" height="150" rx="8" class="panel" />
      <text x="742" y="90" class="t">
        <tspan data-lang-en>Top minus bottom</tspan>
        <tspan data-lang-vi>Chênh cao – thấp</tspan>
      </text>
      {[0, 1, 4, 8, 12].map((l, k) => (
        <g>
          <text x="742" y={116 + k * 20} class="sm">
            <tspan data-lang-en>{l} {l === 1 ? 'layer' : 'layers'}</tspan>
            <tspan data-lang-vi>{l} lớp</tspan>
          </text>
          <text x="868" y={116 + k * 20} text-anchor="end" class="sm b">
            <tspan data-lang-en>{nv(spread[l])}</tspan>
            <tspan data-lang-vi>{nv(spread[l]).replace('.', ',')}</tspan>
          </text>
        </g>
      ))}
      <text x="20" y="372" class="muted">
        <tspan data-lang-en>Toy graph and made-up returns from the demo below. Each layer replaces every number by the average of its neighbourhood.</tspan>
        <tspan data-lang-vi>Graph và lợi suất giả định của demo bên dưới. Mỗi lớp thay mọi con số bằng trung bình của vùng lân cận.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Li, Han and Wu (2018) showed that a graph convolution is a smoothing step and warned that many of them stacked can over-smooth. In a market the damage is concrete: the ranking you wanted to learn is the differences between stocks, and smoothing erases exactly those.</span>
    <span data-lang-vi>Li, Han và Wu (2018) chỉ ra rằng tích chập trên graph là một bước làm mượt và cảnh báo rằng chồng nhiều lớp có thể làm mượt quá đà. Ở thị trường, thiệt hại rất cụ thể: thứ bạn muốn học để xếp hạng chính là sự khác biệt giữa các mã, và làm mượt xoá đúng phần đó.</span>
  </figcaption>
</figure>

