---
// The seven layers of an investment system, top to bottom, and who may say no at each one.
// No data: a structural diagram.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 520;
const rows = [
  { icon: 'db', en: ['Data', 'prices, filings, news, with the date each was known'], vi: ['Dữ liệu', 'giá, báo cáo, tin, kèm ngày mà nó thực sự có mặt'], own: ['sources and point-in-time rules', 'nguồn và quy tắc point-in-time'] },
  { icon: 'model', en: ['Signals and models', 'factors, forecasts, regime flags'], vi: ['Tín hiệu và mô hình', 'factor, dự báo, cờ regime'], own: ['what counts as evidence', 'cái gì được coi là bằng chứng'] },
  { icon: 'search', en: ['Research agents', 'read, summarise, call tools, propose ideas'], vi: ['Agent nghiên cứu', 'đọc, tóm tắt, gọi tool, đề xuất ý tưởng'], own: ['which tools and data they get', 'agent được dùng tool và dữ liệu nào'] },
  { icon: 'scale', en: ['Portfolio construction', 'ideas become target weights'], vi: ['Dựng danh mục', 'ý tưởng thành tỷ trọng mục tiêu'], own: ['the risk budget', 'ngân sách rủi ro'] },
  { icon: 'shield', en: ['Risk gate', 'fixed limits in plain code, no model inside'], vi: ['Cổng rủi ro', 'giới hạn cố định bằng code thường, không có mô hình'], own: ['the limits and who may change them', 'các giới hạn và ai được đổi chúng'] },
  { icon: 'server', en: ['Execution', 'orders, venues, price bands'], vi: ['Thực thi', 'lệnh, sàn, biên độ giá'], own: ['venues and accounts', 'sàn và tài khoản được dùng'] },
  { icon: 'eye', en: ['Monitoring and stop button', 'orders out versus orders in, loss so far'], vi: ['Giám sát và nút dừng', 'lệnh ra so với lệnh vào, lỗ đến lúc này'], own: ['the stop button', 'nút dừng'] },
];
const y0 = 74, step = 58, bh = 46, bx = 190, bw = 420;
---
<figure class="p22s">
  <div class="p22s-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Seven layers of an investment system from data down to monitoring. The top four layers are where machines propose; the bottom three, including the risk gate, are fixed rules. A column on the right names what a person decides at each layer.">
      <text x="20" y="28" class="h"><tspan data-lang-en>An investment system is seven layers, and only some of them may be a model</tspan><tspan data-lang-vi>Một hệ thống đầu tư gồm bảy lớp, và chỉ một số lớp được phép là mô hình</tspan></text>
      <text x="648" y="58" class="sub"><tspan data-lang-en>A person decides</tspan><tspan data-lang-vi>Con người quyết định</tspan></text>
      {rows.map((r, i) => {
        const y = y0 + i * step;
        const gate = i === 4;
        return (
          <g>
            <rect x={bx} y={y} width={bw} height={bh} rx="6" class={gate ? 'box gate' : 'box'} />
            <DiagramIcon name={r.icon} x={bx + 24} y={y + 23} size={24} />
            <text x={bx + 50} y={y + 20} class="t"><tspan data-lang-en>{r.en[0]}</tspan><tspan data-lang-vi>{r.vi[0]}</tspan></text>
            <text x={bx + 50} y={y + 37} class="n"><tspan data-lang-en>{r.en[1]}</tspan><tspan data-lang-vi>{r.vi[1]}</tspan></text>
            {i < 6 && <polygon points={`${bx + bw / 2 - 5},${y + bh + 1} ${bx + bw / 2 + 5},${y + bh + 1} ${bx + bw / 2},${y + bh + 9}`} class="arr" />}
            <line x1={bx + bw} x2="640" y1={y + bh / 2} y2={y + bh / 2} class="tie" />
            <text x="648" y={y + 28} class="own"><tspan data-lang-en>{r.own[0]}</tspan><tspan data-lang-vi>{r.own[1]}</tspan></text>
          </g>
        );
      })}
      <path d={`M 176 ${y0} L 170 ${y0} L 170 ${y0 + 3 * step + bh} L 176 ${y0 + 3 * step + bh}`} class="brk" />
      <text x="160" y={y0 + 1.5 * step + 6} text-anchor="end" class="grp"><tspan data-lang-en>machines</tspan><tspan data-lang-vi>máy</tspan></text>
      <text x="160" y={y0 + 1.5 * step + 24} text-anchor="end" class="grp"><tspan data-lang-en>propose</tspan><tspan data-lang-vi>đề xuất</tspan></text>
      <path d={`M 176 ${y0 + 4 * step} L 170 ${y0 + 4 * step} L 170 ${y0 + 6 * step + bh} L 176 ${y0 + 6 * step + bh}`} class="brk gold" />
      <text x="160" y={y0 + 5 * step + 6} text-anchor="end" class="grp"><tspan data-lang-en>fixed rules</tspan><tspan data-lang-vi>luật cố định</tspan></text>
      <text x="160" y={y0 + 5 * step + 24} text-anchor="end" class="grp"><tspan data-lang-en>decide</tspan><tspan data-lang-vi>quyết định</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The split is the design: layers 1 to 4 may be as clever as you like, layers 5 to 7 must still work when layer 3 is wrong.</span>
    <span data-lang-vi>Cách chia này chính là thiết kế: lớp 1 đến 4 muốn thông minh cỡ nào cũng được, lớp 5 đến 7 phải còn chạy đúng khi lớp 3 sai.</span>
  </figcaption>
</figure>

<style>
  .p22s { margin: 2em 0; width: 100%; }
  .p22s-scroll { overflow-x: auto; }
  .p22s svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .sub { font-size: 13px; font-weight: 700; fill: var(--text-muted); }
  .t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .n { font-size: 12.5px; fill: var(--text-muted); }
  .own { font-size: 13px; fill: var(--text-body); }
  .grp { font-size: 13px; font-weight: 700; fill: var(--text-muted); }
  .box { fill: var(--card-bg); stroke: var(--border); stroke-width: 1.5; }
  .box.gate { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 2; }
  .arr { fill: var(--text-faint); }
  .tie { stroke: var(--border); stroke-dasharray: 3 4; }
  .brk { fill: none; stroke: var(--text-faint); stroke-width: 1.5; }
  .brk.gold { stroke: var(--gold-icon); }
  .p22s figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
