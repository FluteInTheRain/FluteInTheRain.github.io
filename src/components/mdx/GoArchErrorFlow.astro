---
// 3-tier error flow: handle an error once (wrap with %w or mask with %v) instead of logging at every layer.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 340;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const a1 = arrow(270, 102, 321, 102);
const a2 = arrow(577, 102, 628, 102);
const b1 = arrow(270, 256, 321, 256);
const b2 = arrow(577, 256, 628, 256);
---
<figure class="gaef">
  <div class="gaef-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Showdown between anti-pattern error handling that logs and returns at every layer causing noisy duplicate logs versus idiomatic error wrapping with %w and logging once at the handler boundary.">
      {/* Top: Anti-pattern */}
      <text x="16" y="26" class="gaef-h-red">
        <tspan data-lang-en>1. Anti-pattern: log + return at every layer (3 duplicate alerts, broken errors.Is)</tspan>
        <tspan data-lang-vi>1. Cách sai: vừa log vừa return ở mọi tầng (rác log 3 lần, mất ngữ cảnh)</tspan>
      </text>

      <rect x="16" y="48" width="254" height="106" rx="8" class="gaef-box is-red" />
      <DiagramIcon name="db" x={28} y={70} size={20} />
      <text x="56" y="75" class="gaef-b">Repository</text>
      <text x="30" y="100" class="gaef-m">log.Error(err)</text>
      <text x="30" y="120" class="gaef-m">return fmt.Errorf("%v", err)</text>
      <text x="30" y="140" class="gaef-sm-red">
        <tspan data-lang-en>%v strips sentinel identity</tspan>
        <tspan data-lang-vi>%v làm đứt chuỗi errors.Is</tspan>
      </text>

      <rect x="323" y="48" width="254" height="106" rx="8" class="gaef-box is-red" />
      <DiagramIcon name="server" x={335} y={70} size={20} />
      <text x="363" y="75" class="gaef-b">Service</text>
      <text x="337" y="100" class="gaef-m">log.Error(err)  // 2nd log!</text>
      <text x="337" y="120" class="gaef-m">if err == sql.ErrNoRows</text>
      <text x="337" y="140" class="gaef-sm-red">
        <tspan data-lang-en>== fails on wrapped errors</tspan>
        <tspan data-lang-vi>dùng == trượt khi lỗi đã wrap</tspan>
      </text>

      <rect x="630" y="48" width="254" height="106" rx="8" class="gaef-box is-red" />
      <DiagramIcon name="fail" x={642} y={70} size={20} />
      <text x="670" y="75" class="gaef-b">HTTP Handler</text>
      <text x="644" y="100" class="gaef-m">log.Error(err)  // 3rd log!</text>
      <text x="644" y="120" class="gaef-m">defer f.Close() // unchecked</text>
      <text x="644" y="140" class="gaef-sm-red">
        <tspan data-lang-en>3 log lines for 1 failed call</tspan>
        <tspan data-lang-vi>1 sự cố in ra 3 dòng log rác</tspan>
      </text>

      <path d={a1.line} class="gaef-arrow is-red" /><polygon points={a1.head} class="gaef-head is-red" />
      <path d={a2.line} class="gaef-arrow is-red" /><polygon points={a2.head} class="gaef-head is-red" />

      <line x1="16" x2={W - 16} y1="178" y2="178" class="gaef-rule" />

      {/* Bottom: Idiomatic */}
      <text x="16" y="206" class="gaef-h-ok">
        <tspan data-lang-en>2. Idiomatic Go: add context with %w, inspect with Is/As, log exactly once at boundary</tspan>
        <tspan data-lang-vi>2. Chuẩn Go: bọc ngữ cảnh bằng %w, kiểm tra bằng Is/As, chỉ log 1 lần ở điểm cuối</tspan>
      </text>

      <rect x="16" y="222" width="254" height="98" rx="8" class="gaef-box is-ok" />
      <DiagramIcon name="db" x={28} y={244} size={20} />
      <text x="56" y="249" class="gaef-b">Repository</text>
      <text x="30" y="274" class="gaef-m">return fmt.Errorf(</text>
      <text x="30" y="294" class="gaef-m">  "get user %s: %w", id, err)</text>

      <rect x="323" y="222" width="254" height="98" rx="8" class="gaef-box is-ok" />
      <DiagramIcon name="server" x={335} y={244} size={20} />
      <text x="363" y="249" class="gaef-b">Service</text>
      <text x="337" y="274" class="gaef-m">if errors.Is(err, ErrNotFound)</text>
      <text x="337" y="294" class="gaef-m">  // or errors.As(err, &amp;txErr)</text>

      <rect x="630" y="222" width="254" height="98" rx="8" class="gaef-box is-ok" />
      <DiagramIcon name="ok" x={642} y={244} size={20} />
      <text x="670" y="249" class="gaef-b">HTTP Handler</text>
      <text x="644" y="274" class="gaef-ok">
        <tspan data-lang-en>Logs full chain ONCE here</tspan>
        <tspan data-lang-vi>Log cả chuỗi lỗi ĐÚNG 1 LẦN</tspan>
      </text>
      <text x="644" y="294" class="gaef-m">defer closes with _ or err</text>

      <path d={b1.line} class="gaef-arrow is-ok" /><polygon points={b1.head} class="gaef-head is-ok" />
      <path d={b2.line} class="gaef-arrow is-ok" /><polygon points={b2.head} class="gaef-head is-ok" />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Handle an error once: either log it or wrap and return it. Use %w when callers need errors.Is or errors.As inspection, and %v when intentionally hiding internal dependency types across a public boundary.</span>
    <span data-lang-vi>Mỗi lỗi chỉ xử lý đúng một lần: hoặc log, hoặc bọc ngữ cảnh rồi trả về. Dùng %w khi caller cần kiểm tra bằng errors.Is/As, và dùng %v nếu muốn giấu chi tiết kiểu lỗi bên dưới.</span>
  </figcaption>
</figure>

<style>
  .gaef { margin: 2em 0; width: 100%; }
  .gaef-scroll { overflow-x: auto; }
  .gaef svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gaef text { font-size: 12.5px; fill: var(--text-body); }
  .gaef-h-red { font-size: 14.5px; font-weight: 700; fill: var(--red); }
  .gaef-h-ok { font-size: 14.5px; font-weight: 700; fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gaef-h-ok { fill: rgb(74, 222, 128); }
  .gaef-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .gaef-box.is-red { fill: var(--red-tint-bg); stroke: var(--red); }
  .gaef-box.is-ok { stroke: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gaef-box.is-ok { stroke: rgb(74, 222, 128); }
  .gaef-b { font-weight: 700; fill: var(--text); }
  .gaef-m { font-size: 11px; fill: var(--text-muted); }
  .gaef-sm-red { font-size: 11.5px; font-weight: 700; fill: var(--red); }
  .gaef-ok { font-size: 12px; font-weight: 700; fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gaef-ok { fill: rgb(74, 222, 128); }
  .gaef-rule { stroke: var(--border); }
  .gaef-arrow { fill: none; stroke-width: 1.6; }
  .gaef-arrow.is-red { stroke: var(--red); }
  .gaef-arrow.is-ok { stroke: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gaef-arrow.is-ok { stroke: rgb(74, 222, 128); }
  .gaef-head.is-red { fill: var(--red); }
  .gaef-head.is-ok { fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gaef-head.is-ok { fill: rgb(74, 222, 128); }
  .gaef figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
