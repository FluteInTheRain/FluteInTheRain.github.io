---
// Last write wins with a fast clock: the later write loses. Illustrative times.
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Arrow from './ReplicationBArrow.astro';
import Bi from './ReplicationBBi.astro';
---
<Frame h={330}
  label="Node X has a clock that runs 5 seconds fast. It writes x = 1 at real time 10:00:00 and stamps it 10:00:05. Node Y has a correct clock. It writes x = 2 two seconds later and stamps it 10:00:02. Last write wins compares the stamps and keeps x = 1, so the later write is dropped."
  cap="The times are made up. The point is that a timestamp says what a clock showed, not which write really came last."
  capVi="Các mốc giờ là bịa ra. Ý chính là timestamp chỉ cho biết đồng hồ hiện gì, chứ không cho biết lần ghi nào thật sự tới sau.">
  <Node x={80} y={14} w={240} h={70} icon="server" t="Node X" tv="Node X" s="clock runs 5 s fast" sv="đồng hồ chạy nhanh 5 giây" cls="red" />
  <Node x={440} y={14} w={240} h={70} icon="server" t="Node Y" tv="Node Y" s="clock is correct" sv="đồng hồ đúng" />
  <line x1="40" y1="150" x2="840" y2="150" class="rb-axis" />
  <polygon points="860,150 848,145 848,155" class="rb-head" />
  <text x="860" y="130" text-anchor="end" class="rb-n"><Bi en="real time" vi="thời gian thực" /></text>
  <Arrow x1={200} y1={84} x2={200} y2={142} />
  <Arrow x1={560} y1={84} x2={560} y2={142} />
  <circle cx="200" cy="150" r="6" class="rb-dot red" />
  <circle cx="560" cy="150" r="6" class="rb-dot" />
  <text x="200" y="176" text-anchor="middle" class="rb-h"><Bi en="x = 1 at 10:00:00" vi="x = 1 lúc 10:00:00" /></text>
  <text x="200" y="195" text-anchor="middle" class="rb-n rb-bad"><Bi en="stamped 10:00:05" vi="đóng dấu 10:00:05" /></text>
  <text x="560" y="176" text-anchor="middle" class="rb-h"><Bi en="x = 2 at 10:00:02" vi="x = 2 lúc 10:00:02" /></text>
  <text x="560" y="195" text-anchor="middle" class="rb-n"><Bi en="stamped 10:00:02" vi="đóng dấu 10:00:02" /></text>
  <text x="380" y="140" text-anchor="middle" class="rb-n"><Bi en="2 s later" vi="2 giây sau" /></text>
  <Node x={150} y={226} w={600} h={78} icon="warning" t="Last write wins keeps x = 1" tv="Last write wins giữ x = 1" s="10:00:05 is higher than 10:00:02, so the later write is dropped" sv="10:00:05 lớn hơn 10:00:02, nên lần ghi sau bị bỏ" cls="red" />
</Frame>
