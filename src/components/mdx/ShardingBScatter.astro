---
// Scatter/gather on a local secondary index: the query finishes when the slowest shard does. Illustrative latencies.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
type Lbl = { x: number; y: number; c: string; en: string[]; vi: string[]; a?: string; lh?: number };
const W = 900;
const H = 330;
const x0 = 410;
const k = 4.4; // px per ms
const rows = [
  { yc: 74, en: 'Shard 1', vi: 'Shard 1', ms: 5, hot: false },
  { yc: 110, en: 'Shard 2', vi: 'Shard 2', ms: 5, hot: false },
  { yc: 146, en: 'Shard 3', vi: 'Shard 3', ms: 5, hot: false },
  { yc: 182, en: '96 other shards', vi: '96 shard khác', ms: 5, hot: false },
  { yc: 218, en: 'Shard 73', vi: 'Shard 73', ms: 92, hot: true },
];
const fan = rows.map((r) => arrow(186, 146, 262, r.yc));
const xEnd = x0 + 92 * k;
const labels: Lbl[] = [
  { x: 108, y: 152, c: 'b', en: ['Coordinator'], vi: ['Coordinator'] },
  { x: 108, y: 170, c: 's', en: ['customer_id = 42'], vi: ['customer_id = 42'] },
  { x: 108, y: 186, c: 'sub', en: ['asks every shard'], vi: ['hỏi mọi shard'] },
  { x: xEnd, y: 36, c: 'sub is-hot', en: ['query returns here'], vi: ['truy vấn trả kết quả ở đây'] },
  { x: x0, y: 276, c: 'sub', en: ['0 ms'], vi: ['0 ms'] },
  { x: x0 + 50 * k, y: 276, c: 'sub', en: ['50 ms'], vi: ['50 ms'] },
  { x: x0 + 100 * k, y: 276, c: 'sub', en: ['100 ms'], vi: ['100 ms'] },
  { x: 450, y: 312, c: 'note is-hot', en: ['The query waits for the slowest shard: 92 ms, not 5 ms'], vi: ['Truy vấn phải đợi shard chậm nhất: 92 ms, không phải 5 ms'] },
];
---
<figure class="shbl">
  <div class="shbl-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A coordinator sends a customer_id lookup to every shard in parallel. 99 shards answer in 5 milliseconds but shard 73 takes 92 milliseconds, so the whole query takes 92 milliseconds.">
      <rect x="30" y="96" width="156" height="100" rx="6" class="box" />
      <DiagramIcon name="server" x={108} y={122} size={26} />
      {fan.map((a) => (<g><path d={a.line} class="arrow" /><polygon points={a.head} class="head" /></g>))}
      {rows.map((r) => (
        <g>
          <DiagramIcon name="db" x={282} y={r.yc} size={22} />
          <text x="304" y={r.yc + 4} class={r.hot ? 'b is-hot' : 'b'} data-lang-en>{r.en}</text>
          <text x="304" y={r.yc + 4} class={r.hot ? 'b is-hot' : 'b'} data-lang-vi>{r.vi}</text>
          <rect x={x0} y={r.yc - 11} width={r.ms * k} height="22" rx="3" class={r.hot ? 'box is-hot' : 'box'} />
          <text x={x0 + r.ms * k + 8} y={r.yc + 4} class={r.hot ? 's is-hot' : 's'}>{`${r.ms} ms`}</text>
        </g>
      ))}
      <line x1={xEnd} x2={xEnd} y1="44" y2="258" class="arrow is-hot is-dash" />
      <line x1={x0} x2={x0 + 100 * k} y1="250" y2="250" class="arrow" />
      {[0, 50, 100].map((t) => (<line x1={x0 + t * k} x2={x0 + t * k} y1="246" y2="254" class="arrow" />))}
      {labels.map((l) => (
        <>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-en>{l.en.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-vi>{l.vi.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
        </>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Why a local index makes reads slow at the tail. The numbers are illustrative: 99 shards are fast, one hits a slow disk, and the user waits for that one.</span>
    <span data-lang-vi>Vì sao local index làm đọc chậm ở phần đuôi. Số liệu mang tính minh hoạ: 99 shard nhanh, một shard gặp ổ đĩa chậm, và người dùng phải đợi chính shard đó.</span>
  </figcaption>
</figure>

<style>
  .shbl { margin: 2em 0; width: 100%; }
  .shbl-scroll { overflow-x: auto; }
  .shbl svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shbl text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shbl .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shbl .h.is-hot { fill: var(--red); }
  .shbl .h.is-gold { fill: var(--gold-icon); }
  .shbl .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shbl .sub.is-gold { fill: var(--gold-icon); font-weight: 600; }
  .shbl .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shbl .b.is-hot { fill: var(--red); }
  .shbl .s { font-size: 12px; fill: var(--text-body); }
  .shbl .s.is-hot { fill: var(--red); font-weight: 600; }
  .shbl .note { font-size: 13px; font-weight: 600; fill: var(--text); }
  .shbl .note.is-hot { fill: var(--red); }
  .shbl .note.is-gold { fill: var(--gold-icon); }
  .shbl .num { font-size: 11px; font-weight: 700; fill: var(--text); }
  .shbl .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbl .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shbl .box.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .shbl .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shbl .box.is-dim { opacity: 0.5; }
  .shbl .circ { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbl .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shbl .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shbl .arrow.is-hot { stroke: var(--red); }
  .shbl .arrow.is-gold { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shbl .arrow.is-strong { stroke: var(--text); stroke-width: 1.7; }
  .shbl .arrow.is-dash { stroke-dasharray: 5 4; }
  .shbl .head { fill: var(--text-muted); }
  .shbl .head.is-hot { fill: var(--red); }
  .shbl .head.is-gold { fill: var(--gold-icon); }
  .shbl .head.is-strong { fill: var(--text); }
  .shbl figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>

