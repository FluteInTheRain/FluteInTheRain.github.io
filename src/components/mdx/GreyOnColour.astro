---
// Chapter 2: three ways to de-emphasise supporting text on a coloured panel.
// 1. grey text (looks dirty), 2. white at reduced opacity (washed out, and stripes show through),
// 3. a hand-picked colour of the same hue (lower contrast, still clean).
// The panels use a fixed brand blue on purpose: the point is how text sits on a coloured surface,
// so they do not follow the site theme. Labels below the panels do.

const W = 900;
const H = 300;
const pw = 270;
const ph = 170;
const gap = 30;
const xs = [15, 15 + pw + gap, 15 + 2 * (pw + gap)];
const top = 20;
// Faint vertical stripes inside each panel, so the opacity version visibly lets the background through.
const stripes = Array.from({ length: 12 }, (_, i) => 12 + i * 22);

type Panel = { fill: string; opacity?: number; en: [string, string]; vi: [string, string]; bad: boolean };
const panels: Panel[] = [
  { fill: '#9aa0a6', en: ['Grey text', 'looks dirty on blue'], vi: ['Chữ xám', 'trông bẩn trên nền xanh'], bad: true },
  { fill: '#ffffff', opacity: 0.55, en: ['White at 55% opacity', 'washed out, stripes show through'], vi: ['Trắng, độ mờ 55%', 'nhợt nhạt, sọc lộ qua chữ'], bad: true },
  { fill: '#c3d4f7', en: ['Same hue, lighter', 'quieter, still clean'], vi: ['Cùng tông, sáng hơn', 'dịu hơn mà vẫn sạch'], bad: false },
];
---
<figure class="goc">
  <div class="goc-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three blue panels with the same white headline. The supporting line is grey in the first, white at reduced opacity in the second, where background stripes show through, and a light blue of the same hue in the third.">
      {panels.map((p, i) => (
        <g>
          <rect x={xs[i]} y={top} width={pw} height={ph} rx="10" fill="#2754b8" />
          {stripes.map((s) => (
            <rect x={xs[i] + s} y={top} width="8" height={ph} fill="#3563c6" />
          ))}
          <text x={xs[i] + 24} y={top + 66} class="goc-head">Payment received</text>
          <text x={xs[i] + 24} y={top + 98} class="goc-sub" fill={p.fill} opacity={p.opacity ?? 1}>Invoice #2087 · 14 Nov</text>
          <text x={xs[i] + 24} y={top + 124} class="goc-sub" fill={p.fill} opacity={p.opacity ?? 1}>Paid by card ending 4421</text>
          <text x={xs[i]} y={top + ph + 34} class:list={['goc-label', { 'is-good': !p.bad }]}>
            <tspan data-lang-en>{p.en[0]}</tspan>
            <tspan data-lang-vi>{p.vi[0]}</tspan>
          </text>
          <text x={xs[i]} y={top + ph + 56} class="goc-note">
            <tspan data-lang-en>{p.en[1]}</tspan>
            <tspan data-lang-vi>{p.vi[1]}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>What creates hierarchy is lower contrast with the background, not greyness. Pick a lighter colour of the same hue.</span>
    <span data-lang-vi>Thứ tạo ra thứ bậc là độ tương phản thấp hơn với nền, không phải màu xám. Hãy chọn một màu sáng hơn cùng tông với nền.</span>
  </figcaption>
</figure>

<style>
  .goc {
    margin: 2em 0;
    width: 100%;
  }
  .goc-scroll {
    overflow-x: auto;
  }
  .goc svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .goc text {
    font-size: 14px;
  }
  .goc text.goc-head {
    font-size: 20px;
    font-weight: 700;
    fill: #ffffff;
  }
  .goc text.goc-sub {
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }
  .goc text.goc-label {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .goc text.goc-label.is-good {
    fill: var(--red);
  }
  .goc text.goc-note {
    fill: var(--text-muted);
  }
  .goc figcaption {
    margin-top: 0.6em;
    text-align: center;
    font-size: 14px;
    color: var(--text-muted);
  }
</style>
