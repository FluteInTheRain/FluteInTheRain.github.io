---
// Who runs each layer of a database setup, for four hosting choices with one
// real example each. Cells your team runs are tinted; cells the provider runs are plain.
// Read left to right: each step hands more layers to the provider.
// Plain inline SVG with site tokens; no ids.

type Who = 'y' | 'p';

const W = 900;
const H = 392;

const labelX = 20;
const colX0 = 276;
const colW = 150;
const colGap = 4;
const rowY0 = 76;
const rowH = 38;
const rowGap = 4;

const columns = [
  { en: 'Own servers in colo', vi: 'Server riêng ở colo', exEn: 'e.g. 37signals', exVi: 'ví dụ 37signals' },
  { en: 'Rented VMs', vi: 'Thuê máy ảo (VM)', exEn: 'e.g. AWS EC2', exVi: 'ví dụ AWS EC2' },
  { en: 'Managed database', vi: 'Managed database', exEn: 'e.g. AWS RDS', exVi: 'ví dụ AWS RDS' },
  { en: 'Serverless service', vi: 'Dịch vụ serverless', exEn: 'e.g. Google BigQuery', exVi: 'ví dụ Google BigQuery' },
];

const layers: { en: string; vi: string; who: Who[] }[] = [
  { en: 'Building, power, cooling', vi: 'Tòa nhà, điện, làm mát', who: ['p', 'p', 'p', 'p'] },
  { en: 'Buying and replacing hardware', vi: 'Mua và thay phần cứng', who: ['y', 'p', 'p', 'p'] },
  { en: 'Operating system and patches', vi: 'Hệ điều hành và bản vá', who: ['y', 'y', 'p', 'p'] },
  { en: 'DB install, upgrades, backups', vi: 'Cài, nâng cấp, sao lưu DB', who: ['y', 'y', 'p', 'p'] },
  { en: 'Picking server size and count', vi: 'Chọn cỡ máy và số máy', who: ['y', 'y', 'y', 'p'] },
  { en: 'Your tables, queries and data', vi: 'Bảng, truy vấn, dữ liệu của bạn', who: ['y', 'y', 'y', 'y'] },
];

const colCx = (i: number) => colX0 + i * (colW + colGap) + colW / 2;
const rowTop = (r: number) => rowY0 + r * (rowH + rowGap);
const countY = rowTop(layers.length) + 30;
const ownCount = columns.map((_, ci) => layers.filter((l) => l.who[ci] === 'y').length);
---
<figure class="towho">
  <div class="towho-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A table of six layers, from building and power up to your own tables and queries, and who runs each one for four hosting choices. With your own servers in a colocation datacenter your team runs 5 of 6 layers; with rented VMs 4; with a managed database 2; with a serverless service only your tables and queries.">
    <text x={labelX} y="30" class="towho-h">
      <tspan data-lang-en>Who runs this layer?</tspan>
      <tspan data-lang-vi>Tầng này ai lo?</tspan>
    </text>

    {columns.map((c, ci) => (
      <g>
        <text x={colCx(ci)} y="30" text-anchor="middle" class="towho-col">
          <tspan data-lang-en>{c.en}</tspan>
          <tspan data-lang-vi>{c.vi}</tspan>
        </text>
        <text x={colCx(ci)} y="52" text-anchor="middle" class="towho-ex">
          <tspan data-lang-en>{c.exEn}</tspan>
          <tspan data-lang-vi>{c.exVi}</tspan>
        </text>
      </g>
    ))}

    {layers.map((l, ri) => (
      <g>
        <text x={labelX} y={rowTop(ri) + 24} class="towho-layer">
          <tspan data-lang-en>{l.en}</tspan>
          <tspan data-lang-vi>{l.vi}</tspan>
        </text>
        {l.who.map((w, ci) => (
          <g class={w === 'y' ? 'towho-cell is-you' : 'towho-cell'}>
            <rect x={colX0 + ci * (colW + colGap)} y={rowTop(ri)} width={colW} height={rowH} rx="4" />
            <text x={colCx(ci)} y={rowTop(ri) + 24} text-anchor="middle">
              {w === 'y'
                ? <><tspan data-lang-en>your team</tspan><tspan data-lang-vi>team của bạn</tspan></>
                : <><tspan data-lang-en>provider</tspan><tspan data-lang-vi>nhà cung cấp</tspan></>}
            </text>
          </g>
        ))}
      </g>
    ))}

    <line x1={labelX} x2={W - 16} y1={countY - 22} y2={countY - 22} class="towho-rule" />
    <text x={labelX} y={countY} class="towho-layer is-strong">
      <tspan data-lang-en>Layers your team runs</tspan>
      <tspan data-lang-vi>Số tầng team bạn tự lo</tspan>
    </text>
    {ownCount.map((n, ci) => (
      <text x={colCx(ci)} y={countY} text-anchor="middle" class="towho-count">
        <tspan data-lang-en>{n} of {layers.length}</tspan>
        <tspan data-lang-vi>{n}/{layers.length}</tspan>
      </text>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Each step to the right hands more layers to someone else: less work for your team, less say over how those layers run, and their labour is built into the bill. In the first column the provider is the colocation company. One example per option; other products sit in the same spots.</span>
    <span data-lang-vi>Mỗi bước sang phải là giao thêm vài tầng cho người khác: team bạn đỡ việc, nhưng ít quyền quyết định cách các tầng đó chạy, và công của họ đã nằm sẵn trong hóa đơn. Ở cột đầu, nhà cung cấp là công ty colocation. Mỗi cột chỉ nêu một ví dụ; các sản phẩm khác cùng loại cũng nằm ở vị trí đó.</span>
  </figcaption>
</figure>

<style>
  .towho {
    margin: 2em 0;
    width: 100%;
  }
  .towho-scroll {
    overflow-x: auto;
  }
  .towho svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .towho text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .towho .towho-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .towho .towho-col {
    font-weight: 700;
    fill: var(--text);
  }
  .towho .towho-ex {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .towho .towho-layer.is-strong {
    font-weight: 700;
    fill: var(--text);
  }
  .towho-cell rect {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1;
  }
  .towho .towho-cell text {
    fill: var(--text-faint);
  }
  .towho-cell.is-you rect {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.2;
  }
  .towho .towho-cell.is-you text {
    fill: var(--text);
    font-weight: 600;
  }
  .towho .towho-count {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .towho-rule {
    stroke: var(--border);
  }
  .towho figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
