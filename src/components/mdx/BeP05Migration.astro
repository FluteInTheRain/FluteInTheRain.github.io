---
// create_all vs numbered migrations, from the p05_migrate.py captures.
const W = 900, H = 340;
const left = [
  { en: 'deploy 1: create_all makes cases', vi: 'deploy 1: create_all tạo bảng cases', k: 'box' },
  { en: 'edit the model: add priority', vi: 'sửa model: thêm priority', k: 'box' },
  { en: 'deploy 2: create_all, table exists: no change', vi: 'deploy 2: create_all, bảng đã có: không đổi', k: 'box' },
  { en: 'first INSERT: no column named priority', vi: 'INSERT đầu tiên: no column named priority', k: 'bad' },
];
const right = [
  { en: '1 create cases: applied', vi: '1 create cases: applied', k: 'box' },
  { en: '2 add priority: applied', vi: '2 add priority: applied', k: 'box' },
  { en: 'run again: 1 and 2 already applied', vi: 'chạy lại: 1 và 2 already applied', k: 'good' },
  { en: 'schema_migrations remembers 1, 2', vi: 'schema_migrations nhớ phiên bản 1, 2', k: 'good' },
];
---
<figure class="bep5f">
  <div class="bep5f-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left column, create_all: create the table, edit the model, create_all again changes nothing, the first insert fails with no column named priority. Right column, numbered migrations: migration 1 applied, migration 2 applied, running again skips both, and the schema_migrations table remembers the versions.">
    <text x="40" y="28" class="h"><tspan data-lang-en>create_all</tspan><tspan data-lang-vi>create_all</tspan></text>
    <text x="490" y="28" class="h"><tspan data-lang-en>numbered migrations</tspan><tspan data-lang-vi>migration đánh số</tspan></text>
    {left.map((b, i) => (
      <g>
        <rect x="40" y={44 + i * 70} width="380" height="46" rx="8" class={b.k} />
        <text x="230" y={72 + i * 70} text-anchor="middle" class={b.k === 'bad' ? 'redt' : ''}>
          <tspan data-lang-en>{b.en}</tspan><tspan data-lang-vi>{b.vi}</tspan>
        </text>
        {i < 3 && (
          <g>
            <line x1="230" y1={90 + i * 70} x2="230" y2={104 + i * 70} class="ln" />
            <polygon points={`230,${114 + i * 70} 225,${104 + i * 70} 235,${104 + i * 70}`} class="hd" />
          </g>
        )}
      </g>
    ))}
    {right.map((b, i) => (
      <g>
        <rect x="490" y={44 + i * 70} width="380" height="46" rx="8" class={b.k} />
        <text x="680" y={72 + i * 70} text-anchor="middle" class={b.k === 'good' ? 'goodt' : ''}>
          <tspan data-lang-en>{b.en}</tspan><tspan data-lang-vi>{b.vi}</tspan>
        </text>
        {i < 3 && (
          <g>
            <line x1="680" y1={90 + i * 70} x2="680" y2={104 + i * 70} class="ln" />
            <polygon points={`680,${114 + i * 70} 675,${104 + i * 70} 685,${104 + i * 70}`} class="hd" />
          </g>
        )}
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>create_all only creates what is missing. It never alters a table that already exists. A migration is an ordered, recorded, run-once change to a database that already holds data.</span>
    <span data-lang-vi>create_all chỉ tạo cái còn thiếu, không bao giờ sửa bảng đã tồn tại. Migration là thay đổi có thứ tự, có ghi nhận, chạy đúng một lần lên database đã có dữ liệu.</span>
  </figcaption>
</figure>

<style>
  .bep5f { margin: 2em 0; width: 100%; }
  .bep5f-scroll { overflow-x: auto; }
  .bep5f svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep5f text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep5f .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep5f .nm { font-weight: 700; fill: var(--text); font-size: 14.5px; }
  .bep5f .sub { fill: var(--text-muted); font-size: 12.5px; }
  .bep5f .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12.5px; }
  .bep5f .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep5f .seam { fill: none; stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 6 4; }
  .bep5f .good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .bep5f .bad { fill: none; stroke: var(--red); stroke-width: 1.8; }
  .bep5f .badfill { fill: var(--red); }
  .bep5f .ln { stroke: var(--text-muted); stroke-width: 1.6; fill: none; }
  .bep5f .hd { fill: var(--text-muted); }
  .bep5f .redt { fill: var(--red); font-weight: 700; }
  .bep5f .goodt { fill: var(--gold-icon); font-weight: 700; }
  .bep5f figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
