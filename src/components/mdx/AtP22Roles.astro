---
// The agent roles of TradingAgents (Xiao, Sun, Luo, Wang; arXiv 2412.20138), as described in the paper's Figure 1 and Section 3.
import DiagramIcon from './DiagramIcon.astro';
const W = 900, H = 380;
const cx = [90, 270, 450, 630, 810];
const bw = 144;
const analysts = [
  ['Fundamentals', 'Cơ bản'], ['Sentiment', 'Tâm lý'], ['News', 'Tin tức'], ['Technical', 'Kỹ thuật'],
];
const risk = [['Risky', 'Liều'], ['Neutral', 'Trung lập'], ['Safe', 'An toàn']];
const heads = [
  ['1  Analysts', '1  Nhóm phân tích'], ['2  Researchers', '2  Nhóm nghiên cứu'], ['3  Trader', '3  Trader'], ['4  Risk team', '4  Nhóm rủi ro'], ['5  Fund manager', '5  Quản lý quỹ'],
];
---
<figure class="p22r">
  <div class="p22r-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Five stages of the TradingAgents framework, left to right: four analyst agents (fundamentals, sentiment, news, technical); two researcher agents, bull and bear, who debate; a trader agent; a risk team with risky, neutral and safe views; and a fund manager who approves. Every box is an LLM agent.">
      <text x="20" y="26" class="h"><tspan data-lang-en>A trading firm on paper: every box is an LLM</tspan><tspan data-lang-vi>Một công ty giao dịch trên giấy: mọi ô đều là một LLM</tspan></text>
      {heads.map((t, i) => (
        <text x={cx[i]} y="58" text-anchor="middle" class="col"><tspan data-lang-en>{t[0]}</tspan><tspan data-lang-vi>{t[1]}</tspan></text>
      ))}
      {analysts.map((a, i) => (
        <g>
          <rect x={cx[0] - bw / 2} y={76 + i * 52} width={bw} height="42" rx="6" class="box" />
          <DiagramIcon name="search" x={cx[0] - bw / 2 + 20} y={97 + i * 52} size={20} />
          <text x={cx[0] - bw / 2 + 40} y={102 + i * 52} class="t"><tspan data-lang-en>{a[0]}</tspan><tspan data-lang-vi>{a[1]}</tspan></text>
        </g>
      ))}
      {[['Bull', 'Bull'], ['Bear', 'Bear']].map((a, i) => (
        <g>
          <rect x={cx[1] - bw / 2} y={110 + i * 100} width={bw} height="46" rx="6" class="box" />
          <DiagramIcon name="model" x={cx[1] - bw / 2 + 20} y={133 + i * 100} size={20} />
          <text x={cx[1] - bw / 2 + 40} y={138 + i * 100} class="t">{a[0]}</text>
        </g>
      ))}
      <line x1={cx[1]} x2={cx[1]} y1="160" y2="206" class="dbl" />
      <text x={cx[1] + 8} y="188" class="n"><tspan data-lang-en>debate</tspan><tspan data-lang-vi>tranh luận</tspan></text>
      <rect x={cx[2] - bw / 2} y="150" width={bw} height="56" rx="6" class="box" />
      <DiagramIcon name="chart" x={cx[2] - bw / 2 + 20} y={178} size={20} />
      <text x={cx[2] - bw / 2 + 40} y="183" class="t">Trader</text>
      {risk.map((a, i) => (
        <g>
          <rect x={cx[3] - bw / 2} y={96 + i * 62} width={bw} height="46" rx="6" class="box" />
          <DiagramIcon name="shield" x={cx[3] - bw / 2 + 20} y={119 + i * 62} size={20} />
          <text x={cx[3] - bw / 2 + 40} y={124 + i * 62} class="t"><tspan data-lang-en>{a[0]}</tspan><tspan data-lang-vi>{a[1]}</tspan></text>
        </g>
      ))}
      <rect x={cx[4] - bw / 2} y="150" width={bw} height="56" rx="6" class="box llm" />
      <DiagramIcon name="bank" x={cx[4] - bw / 2 + 20} y={178} size={20} />
      <text x={cx[4] - bw / 2 + 40} y="176" class="t"><tspan data-lang-en>Approves,</tspan><tspan data-lang-vi>Duyệt,</tspan></text>
      <text x={cx[4] - bw / 2 + 40} y="194" class="t"><tspan data-lang-en>executes</tspan><tspan data-lang-vi>thực thi</tspan></text>
      {[0, 1, 2, 3].map((i) => (
        <g>
          <line x1={cx[i] + bw / 2 + 4} x2={cx[i + 1] - bw / 2 - 12} y1="178" y2="178" class="ln" />
          <polygon points={`${cx[i + 1] - bw / 2 - 12},172 ${cx[i + 1] - bw / 2 - 4},178 ${cx[i + 1] - bw / 2 - 12},184`} class="arr" />
        </g>
      ))}
      <text x="20" y="352" class="n"><tspan data-lang-en>In the paper the approving fund manager is also an LLM agent, not a person.</tspan><tspan data-lang-vi>Trong bài báo, người quản lý quỹ duyệt lệnh cũng là một LLM agent, không phải con người.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Redrawn from the paper's Figure 1 and Section 3. The shape copies a real firm; nothing in it is a rule that a model cannot talk its way past.</span>
    <span data-lang-vi>Vẽ lại từ Hình 1 và Mục 3 của bài báo. Hình dạng sao chép một công ty thật; trong đó không có quy tắc nào mà một mô hình không thể lý luận để lách qua.</span>
  </figcaption>
</figure>

<style>
  .p22r { margin: 2em 0; width: 100%; }
  .p22r-scroll { overflow-x: auto; }
  .p22r svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .col { font-size: 13px; font-weight: 700; fill: var(--text-muted); }
  .t { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .n { font-size: 12.5px; fill: var(--text-muted); }
  .box { fill: var(--card-bg); stroke: var(--border); stroke-width: 1.5; }
  .box.llm { stroke: var(--text-faint); stroke-dasharray: 5 4; }
  .ln { stroke: var(--text-faint); stroke-width: 1.5; }
  .dbl { stroke: var(--text-faint); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .arr { fill: var(--text-faint); }
  .p22r figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
