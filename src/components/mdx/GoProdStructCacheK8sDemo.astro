---
import DemoFrame from './DemoFrame.astro';
import GoProdStructCacheK8sDemo from '../demos/GoProdStructCacheK8sDemo.tsx';
---
<figure class="gpsc-figure">
  <DemoFrame title="Interactive lab: Go struct layout & Kubernetes CFS throttling flow" titleVi="Phòng thí nghiệm: Code struct alignment & luồng CPU throttling trên Kubernetes">
    <GoProdStructCacheK8sDemo client:visible />
  </DemoFrame>
  <figcaption>
    <span data-lang-en>Compare Go code directly with live memory words and Kubernetes 100 ms CFS scheduling windows. Reordering fields saves 33% heap footprint, while container-aware GOMAXPROCS eliminates periodic freezes.</span>
    <span data-lang-vi>Đối chiếu trực tiếp code Go với bố cục byte trên RAM và cửa sổ lập lịch CFS 100 ms của Kubernetes. Đổi thứ tự field tiết kiệm ngay 33% RAM, còn chỉnh GOMAXPROCS theo container giúp hết đứng hình theo chu kỳ.</span>
  </figcaption>
</figure>

<style is:global>
  .gpsc-figure { margin: 2em 0; width: 100%; }
  .gpsc-figure > .demo-frame { margin-bottom: 0; }
  .gpsc-figure > figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  .gpsc .sd-stats { grid-template-columns: repeat(auto-fit, minmax(145px, 1fr)); }
  .gpsc .sd-group > span { text-transform: none; letter-spacing: 0; font-size: 13px; font-weight: 600; color: var(--text-muted); }
  .gpsc .sd-stat span { text-transform: none; letter-spacing: 0; font-size: 12px; font-weight: 600; }
  .gpsc .sd-stat b { font-size: 17px; overflow-wrap: anywhere; word-break: break-word; }

  .gpsc-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 12px; margin-bottom: 12px; }
  @media (max-width: 760px) { .gpsc-grid { grid-template-columns: 1fr; } }
  .gpsc-pane { border: 1px solid var(--border); border-radius: 8px; background: var(--bg); overflow: hidden; }
  .gpsc-pane-hdr {
    padding: 7px 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
  }
  .gpsc-code-body {
    padding: 8px 0;
    overflow-x: auto;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 12px;
    line-height: 1.55;
  }
  .gpsc-line { display: flex; gap: 8px; padding: 2px 12px; white-space: pre; color: var(--text-body); }
  .gpsc-ln { color: var(--text-muted); user-select: none; min-width: 18px; }
  .gpsc-line.is-active { background: var(--gold-tint-bg); color: var(--text); font-weight: 700; }
  .gpsc-line.is-active.is-bad { background: var(--red-tint-bg); color: var(--red); }
  .gpsc-line.is-active.is-good { background: rgba(21, 128, 61, 0.14); color: rgb(21, 128, 61); }
  html[data-theme='dark'] .gpsc-line.is-active.is-good { background: rgba(74, 222, 128, 0.15); color: rgb(74, 222, 128); }
  .gpsc-flow-svg { display: block; width: 100%; height: auto; padding: 6px; }
  .gpsc-flow-svg text { font-size: 11px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .gpsc-svg-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .gpsc-svg-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-dasharray: 4 3; }
  .gpsc-svg-box.is-good { stroke: rgb(21, 128, 61); }
  html[data-theme='dark'] .gpsc-svg-box.is-good { stroke: rgb(74, 222, 128); }
  .gpsc-svg-b { font-weight: 700; fill: var(--text); }
  .gpsc-svg-red { font-weight: 700; fill: var(--red); }
  .gpsc-svg-good { font-weight: 700; fill: rgb(21, 128, 61); }
  html[data-theme='dark'] .gpsc-svg-good { fill: rgb(74, 222, 128); }
  .gpsc-svg-sm { font-size: 10.5px; fill: var(--text-muted); }

  .gpsc-words { display: flex; flex-direction: column; gap: 8px; }
  .gpsc-word { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 8px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-alt); }
  .gpsc-wlbl { min-width: 130px; font-size: 12.5px; font-weight: 700; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .gpsc-slots { display: flex; flex-wrap: wrap; gap: 6px; flex: 1; }
  .gpsc-slot { padding: 4px 10px; border-radius: 5px; font-size: 12.5px; font-weight: 600; border: 1px solid var(--border); }
  .gpsc-slot.is-data { background: var(--bg); color: var(--text); border-color: rgb(21, 128, 61); }
  html[data-theme='dark'] .gpsc-slot.is-data { border-color: rgb(74, 222, 128); }
  .gpsc-slot.is-pad { background: var(--red-tint-bg); color: var(--red); border-color: var(--red); border-style: dashed; }
  .gpsc-bar-wrap { display: flex; height: 34px; border-radius: 8px; overflow: hidden; border: 1px solid var(--border); background: var(--bg-alt); font-size: 12px; font-weight: 700; }
  .gpsc-bar-run { background: var(--gold-tint-bg); color: var(--text); display: flex; align-items: center; justify-content: center; transition: width 0.2s; padding: 0 6px; white-space: nowrap; }
  .gpsc-bar-stop { background: var(--red-tint-bg); color: var(--red); border-left: 2px dashed var(--red); display: flex; align-items: center; justify-content: center; transition: width 0.2s; padding: 0 6px; white-space: nowrap; }
</style>
