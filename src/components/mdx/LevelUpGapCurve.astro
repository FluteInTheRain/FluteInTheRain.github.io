---
// Illustrative model of Ira Glass's "The Gap" paired with Ericsson's deliberate practice:
// taste rises ahead of execution; passive browsing / DevTools copying plateaus at competent defaults,
// while blind rebuilds + deliberate study bend execution upward to close the gap.

const W = 900;
const H = 340;
const pad = { l: 74, r: 225, t: 48, b: 56 };
const pw = W - pad.l - pad.r;
const ph = H - pad.t - pad.b;

const xAt = (t: number) => pad.l + t * pw;
const yAt = (v: number) => pad.t + (1 - v) * ph;

// Sample smooth curves deterministically
const pts = (fn: (t: number) => number, steps = 40) => {
  const arr: string[] = [];
  for (let i = 0; i <= steps; i++) {
    const t = i / steps;
    arr.push(`${xAt(t).toFixed(1)},${yAt(fn(t)).toFixed(1)}`);
  }
  return arr.join(' ');
};

// Taste: starts noticeably higher than execution, climbs steadily
const tasteFn = (t: number) => 0.42 + 0.46 * (1 - Math.exp(-2.1 * t));
// Deliberate practice execution: starts low, bends upward, closes the gap
const deliberateFn = (t: number) => 0.14 + 0.71 * Math.pow(t, 1.15) / (0.28 + Math.pow(t, 1.15));
// Passive browsing / DevTools copying: rises quickly to ~0.58 ("competent default"), then flattens
const passiveFn = (t: number) => 0.14 + 0.44 * (1 - Math.exp(-3.4 * t));

const tastePoints = pts(tasteFn);
const deliberatePoints = pts(deliberateFn);
const passivePoints = pts(passiveFn);

// Gap bracket at t = 0.28
const tGap = 0.28;
const xGap = xAt(tGap);
const yGapTop = yAt(tasteFn(tGap));
const yGapBot = yAt(deliberateFn(tGap));

// Plateau marker at t = 0.72
const tPlat = 0.72;
const xPlat = xAt(tPlat);
const yPlat = yAt(passiveFn(tPlat));
---

<figure class="lug">
  <div class="lug-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Chart of taste versus execution over time. Taste stays above execution at first, creating a gap. Passive browsing flattens at a competent default plateau, while deliberate practice and blind rebuilds bend execution upward to close the gap.">
      {/* Subtle horizontal gridlines */}
      {[0.25, 0.5, 0.75, 1].map((g) => (
        <line x1={pad.l} x2={pad.l + pw} y1={yAt(g)} y2={yAt(g)} class="lug-grid" />
      ))}

      {/* Axes */}
      <line x1={pad.l} x2={pad.l} y1={pad.t} y2={pad.t + ph} class="lug-axis" />
      <line x1={pad.l} x2={pad.l + pw} y1={pad.t + ph} y2={pad.t + ph} class="lug-axis" />

      {/* Axis titles */}
      <text x={pad.l} y={pad.t - 18} class="lug-h">
        <tspan data-lang-en>How taste and execution diverge over time (illustrative)</tspan>
        <tspan data-lang-vi>Khoảng cách giữa gu thẩm mỹ và tay nghề theo thời gian (minh họa)</tspan>
      </text>

      <text x={pad.l - 12} y={yAt(0.85)} text-anchor="end" class="lug-tick">
        <tspan data-lang-en>High</tspan>
        <tspan data-lang-vi>Cao</tspan>
      </text>
      <text x={pad.l - 12} y={yAt(0.15)} text-anchor="end" class="lug-tick">
        <tspan data-lang-en>Low</tspan>
        <tspan data-lang-vi>Thấp</tspan>
      </text>

      <text x={pad.l + pw / 2} y={H - 14} text-anchor="middle" class="lug-axis-label">
        <tspan data-lang-en>Volume of interfaces built and studied</tspan>
        <tspan data-lang-vi>Số lượng giao diện tự làm và phân tích</tspan>
      </text>

      {/* The Gap vertical callout */}
      <line x1={xGap} x2={xGap} y1={yGapTop + 4} y2={yGapBot - 4} class="lug-gap-line" />
      <line x1={xGap - 5} x2={xGap + 5} y1={yGapTop + 4} y2={yGapTop + 4} class="lug-gap-line" />
      <line x1={xGap - 5} x2={xGap + 5} y1={yGapBot - 4} y2={yGapBot - 4} class="lug-gap-line" />
      <text x={xGap + 10} y={(yGapTop + yGapBot) / 2 - 4} class="lug-note">
        <tspan data-lang-en>Ira Glass's gap:</tspan>
        <tspan data-lang-vi>Khoảng trống của Ira Glass:</tspan>
      </text>
      <text x={xGap + 10} y={(yGapTop + yGapBot) / 2 + 14} class="lug-note-sub">
        <tspan data-lang-en>you spot flaws you cannot fix yet</tspan>
        <tspan data-lang-vi>nhìn ra chỗ xấu nhưng chưa sửa được</tspan>
      </text>

      {/* Curves */}
      <polyline points={tastePoints} fill="none" class="lug-taste" />
      <polyline points={passivePoints} fill="none" class="lug-passive" />
      <polyline points={deliberatePoints} fill="none" class="lug-deliberate" />

      {/* End dots */}
      <circle cx={xAt(1)} cy={yAt(tasteFn(1))} r="4" class="lug-dot-taste" />
      <circle cx={xAt(1)} cy={yAt(deliberateFn(1))} r="4.5" class="lug-dot-delib" />
      <circle cx={xAt(1)} cy={yAt(passiveFn(1))} r="3.5" class="lug-dot-passive" />

      {/* Right-hand direct labels */}
      <text x={pad.l + pw + 12} y={yAt(tasteFn(1)) + 4} class="lug-lbl-taste">
        <tspan data-lang-en>Taste (what you notice)</tspan>
        <tspan data-lang-vi>Gu nhìn (thứ bạn nhận ra)</tspan>
      </text>

      <text x={pad.l + pw + 12} y={yAt(deliberateFn(1)) + 20} class="lug-lbl-delib">
        <tspan data-lang-en>Deliberate study + rebuilds</tspan>
        <tspan data-lang-vi>Luyện chủ đích + dựng lại</tspan>
      </text>

      <text x={pad.l + pw + 12} y={yAt(passiveFn(1)) + 4} class="lug-lbl-passive">
        <tspan data-lang-en>Passive browsing / AI defaults</tspan>
        <tspan data-lang-vi>Lướt xem thụ động / mặc định AI</tspan>
      </text>

      {/* Plateau annotation */}
      <circle cx={xPlat} cy={yPlat} r="3.5" class="lug-dot-passive" />
      <text x={xPlat - 10} y={yPlat + 22} text-anchor="middle" class="lug-note-sub">
        <tspan data-lang-en>The 80% plateau</tspan>
        <tspan data-lang-vi>Ngưỡng chững 80%</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Illustrative model combining Ira Glass's "The Gap" and Anders Ericsson's deliberate practice framework. Following checklist rules gets you to competent defaults; closing the remaining gap takes active comparison and blind rebuilds.</span>
    <span data-lang-vi>Mô hình minh họa kết hợp "Khoảng trống" của Ira Glass và luyện tập chủ đích của Anders Ericsson. Thuộc quy tắc đưa bạn tới mức "tạm ổn"; để thu hẹp phần còn lại, cần chủ động so sánh và tự dựng lại bằng mắt.</span>
  </figcaption>
</figure>

<style>
  .lug { margin: 2em 0; width: 100%; }
  .lug-scroll { overflow-x: auto; }
  .lug svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .lug text { font-size: 13.5px; fill: var(--text-body); }
  .lug text.lug-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .lug text.lug-tick { font-size: 12.5px; fill: var(--text-faint); }
  .lug text.lug-axis-label { font-size: 13px; fill: var(--text-muted); }
  .lug text.lug-note { font-size: 13px; font-weight: 600; fill: var(--text); }
  .lug text.lug-note-sub { font-size: 12.5px; fill: var(--text-muted); }
  .lug text.lug-lbl-taste { font-size: 13px; font-weight: 600; fill: var(--text); }
  .lug text.lug-lbl-delib { font-size: 13px; font-weight: 700; fill: var(--red); }
  .lug text.lug-lbl-passive { font-size: 13px; fill: var(--text-muted); }
  .lug-grid { stroke: var(--border); stroke-dasharray: 3 4; stroke-width: 1; }
  .lug-axis { stroke: var(--text-muted); stroke-width: 1.25; }
  .lug-gap-line { stroke: var(--text-muted); stroke-width: 1.25; }
  .lug-taste { stroke: var(--text); stroke-width: 2.25; }
  .lug-deliberate { stroke: var(--red); stroke-width: 2.75; }
  .lug-passive { stroke: var(--text-muted); stroke-width: 1.75; stroke-dasharray: 6 5; }
  .lug-dot-taste { fill: var(--text); }
  .lug-dot-delib { fill: var(--red); }
  .lug-dot-passive { fill: var(--text-muted); }
  .lug figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
