---
import DiagramIcon from './DiagramIcon.astro';
// One filtering step, 24 Feb 2020 (S&P 500 return -3.41%), fitted two-state model (python).
// yesterday's belief P(turbulent)=4.5%; after the transition matrix 6.0%; likelihood of -3.41% under
// calm 1.62e-5 vs turbulent 4.86 (densities in 1/return units); posterior 99.995% turbulent.
const W = 900, H = 330;
const cols = [
  { x: 40, title: ['Yesterday’s belief', 'Niềm tin hôm qua'], sub: ['after the 21 Feb close', 'sau phiên 21/2'], p: 0.045, label: '4.5%' },
  { x: 280, title: ['Add one step of drift', 'Cho trạng thái trôi một bước'], sub: ['transition matrix', 'ma trận chuyển'], p: 0.0599, label: '6.0%' },
  { x: 520, title: ['Weigh by what printed', 'Cân theo mức giá vừa in'], sub: ['−3.41% fits turbulence 300,000 times better', '−3,41% hợp với hỗn loạn gấp 300.000 lần'], p: 0.99995, label: '99.995%' },
];
---
<figure class="p5f">
  <div class="p5f-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three horizontal bars of the model's belief that the market is turbulent on 24 February 2020: 4.5 percent after the previous close, 6.0 percent after allowing for a switch, and 99.995 percent after seeing a minus 3.41 percent return.">
    <text x="20" y="26" class="h">
      <tspan data-lang-en>One filtering step, 24 February 2020</tspan>
      <tspan data-lang-vi>Một bước lọc, ngày 24/2/2020</tspan>
    </text>
    {cols.map((c, k) => (
      <g>
        <text x={c.x} y="70" class="t">
          <tspan data-lang-en>{c.title[0]}</tspan>
          <tspan data-lang-vi>{c.title[1]}</tspan>
        </text>
        <text x={c.x} y="90" class="note">
          <tspan data-lang-en>{c.sub[0]}</tspan>
          <tspan data-lang-vi>{c.sub[1]}</tspan>
        </text>
        <rect x={c.x} y="116" width="200" height="30" rx="4" class="track" />
        <rect x={c.x} y="116" width={Math.max(2, 200 * c.p)} height="30" rx="4" class={k === 2 ? 'fill hot' : 'fill'} />
        <text x={c.x} y="172" class="val">{c.label}</text>
        <text x={c.x + 96} y="172" class="note">
          <tspan data-lang-en>turbulent</tspan>
          <tspan data-lang-vi>hỗn loạn</tspan>
        </text>
      </g>
    ))}
    <text x="248" y="138" class="ar">→</text>
    <text x="488" y="138" class="ar">→</text>

    <rect x="40" y="206" width="680" height="96" rx="8" class="box" />
    <DiagramIcon name="model" x="68" y="236" size="24" />
    <text x="92" y="241" class="t">
      <tspan data-lang-en>The arithmetic (Bayes' rule)</tspan>
      <tspan data-lang-vi>Phép tính (quy tắc Bayes)</tspan>
    </text>
    <text x="60" y="268" class="note">
      <tspan data-lang-en>prior 6.0% turbulent × likelihood 4.86  against  prior 94.0% calm × likelihood 0.0000162</tspan>
      <tspan data-lang-vi>tiên nghiệm 6,0% hỗn loạn × khả năng 4,86  so với  tiên nghiệm 94,0% yên × khả năng 0,0000162</tspan>
    </text>
    <text x="60" y="288" class="note">
      <tspan data-lang-en>0.0599 × 4.86 = 0.291 against 0.9401 × 0.0000162 = 0.0000152, so turbulent wins by about 19,000 to 1.</tspan>
      <tspan data-lang-vi>0,0599 × 4,86 = 0,291 so với 0,9401 × 0,0000162 = 0,0000152, nên hỗn loạn thắng cỡ 19.000 trên 1.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The model starts at 4.5%, allows a small chance of switching, then one return of −3.41% settles it. The filter used only information up to that day's close.</span>
    <span data-lang-vi>Mô hình xuất phát từ 4,5%, cho phép một xác suất nhỏ đổi trạng thái, rồi một lợi suất −3,41% chốt luôn. Bộ lọc chỉ dùng thông tin tới giá đóng cửa của ngày đó.</span>
  </figcaption>
</figure>

<style>
  .p5f { margin: 2em 0; width: 100%; }
  .p5f-scroll { overflow-x: auto; }
  .p5f svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .p5f text { fill: var(--text-body); font-size: 13px; }
  .p5f .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p5f .t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .p5f .note { fill: var(--text-muted); font-size: 12.5px; }
  .p5f .val { font-size: 20px; font-weight: 700; fill: var(--text); }
  .p5f .ar { font-size: 22px; fill: var(--text-muted); }
  .p5f .track { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p5f .fill { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .p5f .fill.hot { fill: var(--red); }
  .p5f .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p5f figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
