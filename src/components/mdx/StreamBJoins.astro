---
// The three stream join patterns: what goes in, what the operator keeps, what comes out.
import StreamBFigure from './StreamBFigure.astro';
import StreamBNode from './StreamBNode.astro';
import StreamBArrow from './StreamBArrow.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    rows: [
      { h: 'Stream and stream: window join', a: ['Searches', 'stream', 'log'], b: ['Clicks', 'stream', 'log'], o: ['Window join', 'keeps: both, 1 hour', 'worker'], r: ['Click rate', 'incl. non-clicks', 'chart'] },
      { h: 'Stream and table: enrichment', a: ['Activity', 'stream', 'log'], b: ['Users table', 'as a CDC stream', 'db'], o: ['Enrich', 'keeps: a users copy', 'worker'], r: ['Enriched', 'events + profile', 'log'] },
      { h: 'Table and table: materialized view', a: ['Posts', 'changelog', 'log'], b: ['Follows', 'changelog', 'log'], o: ['Join', 'keeps: both tables', 'worker'], r: ['Timelines', 'live view', 'db'] },
    ],
    alt: 'Three rows, one per join pattern. Stream and stream: searches and clicks go into a window join that keeps both for one hour and outputs a click rate including non-clicks. Stream and table: an activity stream and a users table fed as a CDC stream go into an enrich operator that keeps a local copy of users and outputs enriched events. Table and table: posts and follows changelogs go into a join that keeps both tables and outputs live home timelines.',
    cap: 'Every join keeps state inside the operator, because the streams never end and you cannot wait for the end of the file.',
  },
  vi: {
    rows: [
      { h: 'Stream với stream: window join', a: ['Tìm kiếm', 'stream', 'log'], b: ['Lượt bấm', 'stream', 'log'], o: ['Window join', 'giữ: cả hai, 1 giờ', 'worker'], r: ['Tỷ lệ bấm', 'kể cả không bấm', 'chart'] },
      { h: 'Stream với bảng: làm giàu dữ liệu', a: ['Hoạt động', 'stream', 'log'], b: ['Bảng users', 'dạng stream CDC', 'db'], o: ['Làm giàu', 'giữ: bản sao users', 'worker'], r: ['Đã làm giàu', 'sự kiện + hồ sơ', 'log'] },
      { h: 'Bảng với bảng: materialized view', a: ['Posts', 'changelog', 'log'], b: ['Follows', 'changelog', 'log'], o: ['Join', 'giữ: cả hai bảng', 'worker'], r: ['Timeline', 'view sống', 'db'] },
    ],
    alt: 'Ba hàng, mỗi hàng một kiểu join. Stream với stream: tìm kiếm và lượt bấm vào một window join giữ cả hai trong một giờ và cho ra tỷ lệ bấm kể cả không bấm. Stream với bảng: stream hoạt động và bảng users dạng stream CDC vào toán tử làm giàu giữ bản sao users và cho ra sự kiện đã làm giàu. Bảng với bảng: changelog posts và follows vào một join giữ cả hai bảng và cho ra timeline trang chủ sống.',
    cap: 'Mọi kiểu join đều giữ trạng thái trong toán tử, vì stream không bao giờ kết thúc và bạn không thể chờ tới cuối file.',
  },
}[lang];
const y0 = [20, 140, 260];
---
<StreamBFigure h={360} alt={T.alt} cap={T.cap}>
  {T.rows.map((r, i) => (
    <>
      <text x="20" y={y0[i] + 4} class="h">{r.h}</text>
      <StreamBNode x={20} y={y0[i] + 16} w={185} h={66} icon={r.a[2]} title={r.a[0]} sub={[r.a[1]]} />
      <text x="217" y={y0[i] + 54} text-anchor="middle" class="name">+</text>
      <StreamBNode x={230} y={y0[i] + 16} w={185} h={66} icon={r.b[2]} title={r.b[0]} sub={[r.b[1]]} />
      <StreamBArrow x1={415} y1={y0[i] + 49} x2={465} y2={y0[i] + 49} />
      <StreamBNode x={465} y={y0[i] + 16} w={210} h={66} icon={r.o[2]} title={r.o[0]} sub={[r.o[1]]} kind="good" />
      <StreamBArrow x1={675} y1={y0[i] + 49} x2={705} y2={y0[i] + 49} />
      <StreamBNode x={705} y={y0[i] + 16} w={175} h={66} icon={r.r[2]} title={r.r[0]} sub={[r.r[1]]} />
    </>
  ))}
</StreamBFigure>
