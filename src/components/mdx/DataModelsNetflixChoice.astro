---
import DiagramIcon from './DiagramIcon.astro';
// Why the Netflix downloads team passed on a relational schema and a plain document model, and chose event sourcing (Netflix Tech Blog and QCon 2017 talk).
// Arrowheads are polygons: no SVG ids.
const W = 900;
const H = 320;
type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}
const frames: any[] = [];
const boxes: any[] = [];
const links: any[] = [];
const labels: any[] = [];
const nums: any[] = [];
boxes.push({ x: 10, y: 10, w: 880, h: 66, icon: 'netflix', en: ['Offline downloads launched in November 2016', 'Content rules not decided yet, and millions of members from day one'], vi: ['Tải phim offline ra mắt tháng 11/2016', 'Luật nội dung chưa chốt, mà ngày đầu đã có hàng triệu member'] });
const cols = [
  { icon: 'db', kind: 'bad', t: ['Relational schema', 'Schema quan hệ'], b: ['Fixed structure up front.', 'A migration whenever', 'a rule changes.', '', ''], bv: ['Cấu trúc cố định từ đầu.', 'Mỗi lần luật đổi lại', 'phải migration.', '', ''], v: ['Passed: too many migrations', 'Bỏ qua: quá nhiều migration'] },
  { icon: 'file', kind: 'bad', t: ['Document model', 'Mô hình document'], b: ['Flexible, no migrations.', 'But each update overwrote', 'the data, so nobody could', 'tell why a license was', 'in its current state.'], bv: ['Linh hoạt, không migration.', 'Nhưng mỗi lần cập nhật đều', 'ghi đè dữ liệu, nên không', 'biết vì sao license ở', 'trạng thái hiện tại.'], v: ['Passed: no history of why', 'Bỏ qua: không có lịch sử'] },
  { icon: 'log', kind: 'good', t: ['Event sourcing', 'Event sourcing'], b: ['Every change kept as an', 'event; the state is', 'computed from the log.', 'Rules could change quickly', 'and be debugged over time.'], bv: ['Giữ mọi thay đổi thành', 'event; state tính từ log.', 'Luật có thể đổi nhanh', 'và debug được theo', 'thời gian.', ''], v: ['Chosen', 'Được chọn'] },
];
cols.forEach((c, i) => {
  const x = 10 + i * 309;
  boxes.push({ x, y: 104, w: 262, h: 206, kind: c.kind, flat: true, en: [''], vi: [''] });
  labels.push({ x: x + 50, y: 140, en: c.t[0], vi: c.t[1], cls: 'h' });
  c.b.forEach((l, k) => labels.push({ x: x + 14, y: 176 + k * 18, en: l, vi: c.bv[k], cls: 'muted' }));
  labels.push({ x: x + 14, y: 290, en: c.v[0], vi: c.v[1], cls: c.kind === 'good' ? 'good' : 'bad' });
  if (i < 2) links.push({ pts: [[x + 262, 207], [x + 309, 207]] });
});
---
<figure class="dmnc">
  <div class="dmnc-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Context: offline downloads launched in November 2016 with the content rules not yet decided and millions of members from day one. A relational schema was passed on because every rule change would need a migration. A plain document model was passed on because each update overwrote the data, so they could not tell why a license was in its current state. Event sourcing was chosen: every change kept as an event, with the state computed from the log.">
    {frames.map((f) => (
      <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="6" class={`dmnc-frame ${f.kind ?? ''}`} />
    ))}
    {boxes.map((b) => {
      const n = Math.max(b.en.length, b.vi.length);
      const top = !!b.top;
      const cx = b.x + b.w / 2;
      const x0 = top ? cx : b.icon ? b.x + 46 : b.x + 14;
      const y0 = top ? b.y + (b.icon ? 56 : 24) : b.y + b.h / 2 - ((n - 1) * 17) / 2 + 4;
      return (
        <g class={`dmnc-box ${b.kind ?? ''}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
          {b.icon && <DiagramIcon name={b.icon} x={top ? cx : b.x + 24} y={top ? b.y + 24 : b.y + b.h / 2} size={b.is ?? 26} />}
          {Array.from({ length: n }).map((_, i) => (
            <text x={x0} y={y0 + i * 17} text-anchor={top ? 'middle' : 'start'} class={i === 0 && !b.flat ? 'dmnc-name' : 'dmnc-sub'}>
              <tspan data-lang-en>{b.en[i] ?? ''}</tspan>
              <tspan data-lang-vi>{b.vi[i] ?? ''}</tspan>
            </text>
          ))}
        </g>
      );
    })}
    {links.map((l) => {
      const a = arrow(l.pts);
      return (
        <g>
          <polyline points={l.plain ? l.pts.map((p) => p.join(',')).join(' ') : a.line} class={`dmnc-edge ${l.kind ?? ''}`} fill="none" />
          {!l.plain && <polygon points={a.head} class={`dmnc-head ${l.kind ?? ''}`} />}
        </g>
      );
    })}
    {labels.map((t) => (
      <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`dmnc-lab ${t.cls ?? ''}`}>
        <tspan data-lang-en>{t.en}</tspan>
        <tspan data-lang-vi>{t.vi ?? t.en}</tspan>
      </text>
    ))}
    {nums.map((n) => (
      <g class="dmnc-num">
        <circle cx={n.x} cy={n.y} r="11" />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.n}</text>
      </g>
    ))}
    {cols.map((c, i) => <DiagramIcon name={c.icon} x={10 + i * 309 + 28} y={134} size={28} />)}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Read left to right in the order the team considered them. The last column is the one they shipped.</span>
    <span data-lang-vi>Đọc từ trái sang phải theo thứ tự đội cân nhắc. Cột cuối là cái họ đã đưa vào sản phẩm.</span>
  </figcaption>
</figure>

<style>
  .dmnc { margin: 2em 0; width: 100%; }
  .dmnc-scroll { overflow-x: auto; }
  .dmnc svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dmnc text { font-size: 14px; fill: var(--text-body); }
  .dmnc .dmnc-name { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .dmnc .dmnc-sub { font-size: 12px; fill: var(--text-muted); }
  .dmnc .dmnc-lab { font-size: 13px; }
  .dmnc .dmnc-lab.h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dmnc .dmnc-lab.strong { font-weight: 700; fill: var(--text); }
  .dmnc .dmnc-lab.muted { fill: var(--text-muted); }
  .dmnc .dmnc-lab.bad { font-weight: 700; fill: var(--red); }
  .dmnc .dmnc-lab.good { font-weight: 700; fill: var(--text); }
  .dmnc .dmnc-lab.mono, .dmnc .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .dmnc-frame { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .dmnc-frame.bad { stroke: var(--red); }
  .dmnc-frame.good { stroke: var(--gold); }
  .dmnc-box rect { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmnc-box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dmnc-box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmnc-box.plain rect { fill: none; stroke: var(--border); }
  .dmnc-edge { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmnc-edge.bad { stroke: var(--red); }
  .dmnc-edge.good { stroke: var(--gold-icon); }
  .dmnc-head { fill: var(--text-muted); }
  .dmnc-head.bad { fill: var(--red); }
  .dmnc-head.good { fill: var(--gold-icon); }
  .dmnc-num circle { fill: var(--bg-alt); stroke: var(--text-muted); }
  .dmnc-num text { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dmnc figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
