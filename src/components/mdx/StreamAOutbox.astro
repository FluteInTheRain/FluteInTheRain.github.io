---
// Transactional outbox: the service writes its private tables and an outbox event row in one local transaction;
// Debezium tails only the outbox table, so consumers see a stable event shape, not the internal schema.
import DiagramIcon from './DiagramIcon.astro';
import StreamAFrame from './StreamAFrame.astro';
import { arrow } from './StreamAHelpers';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    h: 'Transactional outbox: one transaction, stable events',
    svc: 'Order service', tx: '1 one local ACID transaction',
    o: 'orders table', os: 'private, may change', b: 'outbox table', bs: 'clean event, stable shape',
    d: 'Debezium', ds: '2 reads outbox only', k: 'Kafka', ks: '3 stable events', c: 'Consumers', cs: '4 stable contract',
    note: 'Schema changes to the orders table stay private. Consumers only ever see outbox events.',
    alt: 'An order service writes its private orders table and an outbox table inside one local transaction. Debezium reads only the outbox table and publishes stable events to Kafka, and downstream consumers read those events without ever seeing the internal orders schema.',
    cap: 'The outbox is a public contract that sits next to private tables. Both are committed together or not at all.',
  },
  vi: {
    h: 'Transactional outbox: một transaction, sự kiện ổn định',
    svc: 'Order service', tx: '1 một transaction ACID cục bộ',
    o: 'bảng orders', os: 'nội bộ, có thể đổi', b: 'bảng outbox', bs: 'sự kiện sạch, hình dạng ổn định',
    d: 'Debezium', ds: '2 chỉ đọc outbox', k: 'Kafka', ks: '3 sự kiện ổn định', c: 'Consumer', cs: '4 hợp đồng ổn định',
    note: 'Đổi schema bảng orders vẫn là chuyện nội bộ. Consumer chỉ thấy các sự kiện trong outbox.',
    alt: 'Một order service ghi bảng orders nội bộ và bảng outbox trong cùng một transaction cục bộ. Debezium chỉ đọc bảng outbox và phát các sự kiện ổn định vào Kafka, còn consumer phía sau đọc các sự kiện đó mà không bao giờ thấy schema orders bên trong.',
    cap: 'Outbox là hợp đồng công khai nằm cạnh các bảng riêng tư. Hai bên cùng commit hoặc cùng không commit.',
  },
}[lang];
const a1 = arrow(326, 192, 392, 192);
const a2 = arrow(532, 192, 576, 192);
const a3 = arrow(706, 192, 742, 192);
---
<StreamAFrame h={292} alt={T.alt} cap={T.cap} title={T.h}>
  <rect x="20" y="44" width="320" height="192" rx="9" class="frame" />
  <DiagramIcon name="server" x={48} y={68} size={26} />
  <text x="72" y="66" class="name">{T.svc}</text>
  <text x="72" y="84" class="sub">{T.tx}</text>
  <g class="box"><rect x="34" y="100" width="292" height="52" rx="6" /></g>
  <DiagramIcon name="db" x={60} y={126} size={26} />
  <text x="86" y="122" class="name">{T.o}</text>
  <text x="86" y="140" class="sub">{T.os}</text>
  <DiagramIcon name="lock" x={300} y={126} size={22} />
  <g class="box good"><rect x="34" y="166" width="292" height="52" rx="6" /></g>
  <DiagramIcon name="db" x={60} y={192} size={26} />
  <text x="86" y="188" class="name">{T.b}</text>
  <text x="86" y="206" class="sub">{T.bs}</text>
  <g class="arr good"><path d={a1.line} /><polygon points={a1.head} /></g>
  <g class="box"><rect x="392" y="156" width="140" height="72" rx="7" /></g>
  <DiagramIcon name="eye" x={418} y={180} size={24} />
  <text x="442" y="185" class="name">{T.d}</text>
  <text x="404" y="212" class="sub">{T.ds}</text>
  <g class="arr good"><path d={a2.line} /><polygon points={a2.head} /></g>
  <g class="box"><rect x="576" y="156" width="130" height="72" rx="7" /></g>
  <DiagramIcon name="kafka" x={602} y={180} size={24} />
  <text x="626" y="185" class="name">{T.k}</text>
  <text x="588" y="212" class="sub">{T.ks}</text>
  <g class="arr good"><path d={a3.line} /><polygon points={a3.head} /></g>
  <g class="box"><rect x="742" y="156" width="138" height="72" rx="7" /></g>
  <DiagramIcon name="worker" x={768} y={180} size={24} />
  <text x="792" y="185" class="name">{T.c}</text>
  <text x="752" y="212" class="sub">{T.cs}</text>
  <text x="20" y="266" class="name" style="font-size:13px">{T.note}</text>
</StreamAFrame>
