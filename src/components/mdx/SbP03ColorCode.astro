---
// The 5 Vietnamese stock board colours decoded using existing site CSS tokens (light + dark safe).
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 310;

const CODES = [
  {
    y: 54, tok: 'var(--act-4)',
    en: 'Purple — Ceiling (+7% HOSE)', vi: 'Tím — Giá trần (+7% HOSE)',
    descEn: 'Highest price allowed today; buys often queue with zero sellers',
    descVi: 'Mức cao nhất trong ngày; bên mua thường xếp hàng dài chờ người bán',
  },
  {
    y: 102, tok: 'var(--act-2)',
    en: 'Green — Above reference', vi: 'Xanh lá — Trên giá tham chiếu',
    descEn: 'Higher than yesterday close (HOSE/HNX) — NOT higher than morning open',
    descVi: 'Cao hơn tham chiếu hôm nay — KHÔNG phải cao hơn giá lúc bạn mua',
  },
  {
    y: 150, tok: 'var(--gold)',
    en: 'Yellow — Reference price', vi: 'Vàng — Giá tham chiếu',
    descEn: 'Baseline for today band and colour (yesterday close on HOSE/HNX)',
    descVi: 'Mốc tính biên độ và màu cả ngày (giá đóng cửa hôm qua trên HOSE/HNX)',
  },
  {
    y: 198, tok: 'var(--red)',
    en: 'Red — Below reference', vi: 'Đỏ — Dưới giá tham chiếu',
    descEn: 'Lower than today reference (note: green/red is opposite to China/Taiwan)',
    descVi: 'Thấp hơn tham chiếu hôm nay (ngược quy ước xanh giảm/đỏ tăng ở Trung Quốc)',
  },
  {
    y: 246, tok: 'var(--act-3)',
    en: 'Cyan / Blue — Floor (−7% HOSE)', vi: 'Xanh dương — Giá sàn (−7% HOSE)',
    descEn: 'Lowest price allowed today; sells pile up if buyers step away',
    descVi: 'Mức thấp nhất trong ngày; bên bán chất đống khi người mua rút lui',
  },
] as const;
---
<figure class="sbp3-col">
  <div class="sbp3-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Five colours on the Vietnamese price board: Purple for ceiling, Green for above reference, Yellow for reference, Red for below reference, and Blue for floor.">
      <text x="20" y="30" class="sbp3-title">
        <tspan data-lang-en>The five board colours measure distance from reference — not your own profit</tspan>
        <tspan data-lang-vi>Năm màu trên bảng điện đo vị trí so với giá tham chiếu — không đo lãi lỗ của bạn</tspan>
      </text>

      {CODES.map((c) => (
        <g>
          <rect x="20" y={c.y} width="860" height="40" rx="8" class="sbp3-row" />
          <circle cx="44" cy={c.y + 20} r="9" style={`fill: ${c.tok};`} />
          <text x="66" y={c.y + 25} class="sbp3-lbl" style={`fill: ${c.tok};`}>
            <tspan data-lang-en>{c.en}</tspan>
            <tspan data-lang-vi>{c.vi}</tspan>
          </text>
          <text x="366" y={c.y + 25} class="sbp3-desc">
            <tspan data-lang-en>{c.descEn}</tspan>
            <tspan data-lang-vi>{c.descVi}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A stock painted red on the board can still be up +15% from what you paid last month, and a green stock can still leave a morning buyer underwater. Colour always compares against today's reference price.</span>
    <span data-lang-vi>Một cổ phiếu hiện màu đỏ trên bảng vẫn có thể đang lãi +15% so với giá bạn mua tháng trước, và mã màu xanh vẫn có thể khiến người mua lúc đỉnh sáng lỗ trong ngày. Màu luôn so với giá tham chiếu hôm nay.</span>
  </figcaption>
</figure>

<style>
  .sbp3-col { margin: 2em 0; width: 100%; }
  .sbp3-scroll { overflow-x: auto; }
  .sbp3-col svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sbp3-col text { font-size: 13px; fill: var(--text-body); }
  .sbp3-title { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sbp3-row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .sbp3-lbl { font-size: 13.5px; font-weight: 700; }
  .sbp3-desc { font-size: 12.5px; fill: var(--text-body); }
  .sbp3-col figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
