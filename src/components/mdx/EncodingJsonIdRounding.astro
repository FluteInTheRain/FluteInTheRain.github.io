---
import EncodingStepCards from './EncodingStepCards.astro';
const props = {
 "arrows": true,
 "title": {
  "en": "Where the ID changes: inside JSON.parse",
  "vi": "ID đổi ở đâu: bên trong JSON.parse"
 },
 "alt": "A 64-bit post ID, 1050118621198921728, is written by the server as digits in JSON text. JavaScript's JSON.parse reads it as a 64-bit float and the last digits are lost, giving 1050118621198921700 with no error. The id_str string keeps the exact value.",
 "cards": [
  {
   "icon": "db",
   "head": {
    "en": [
     "Server writes"
    ],
    "vi": [
     "Server ghi"
    ]
   },
   "lines": {
    "en": [
     "A 64-bit ID, bigger",
     "than 2^53."
    ],
    "vi": [
     "Một ID 64 bit, lớn",
     "hơn 2^53."
    ]
   },
   "tone": "plain",
   "mono": [
    "1050118621198921728"
   ]
  },
  {
   "icon": "network",
   "head": {
    "en": [
     "JSON text"
    ],
    "vi": [
     "Văn bản JSON"
    ]
   },
   "lines": {
    "en": [
     "The number travels as",
     "digits. Nothing is lost yet."
    ],
    "vi": [
     "Số đi dưới dạng chữ số.",
     "Lúc này chưa mất gì."
    ]
   },
   "tone": "plain",
   "mono": [
    "\"id\": 1050118621198921728"
   ]
  },
  {
   "icon": "laptop",
   "head": {
    "en": [
     "JSON.parse in JavaScript"
    ],
    "vi": [
     "JSON.parse trong JavaScript"
    ]
   },
   "lines": {
    "en": [
     "Read as a 64-bit float:",
     "last digits lost, no error.",
     "The id_str string is exact."
    ],
    "vi": [
     "Đọc thành số thực 64 bit:",
     "mất vài chữ số cuối, không",
     "báo lỗi. Chuỗi id_str vẫn đúng."
    ]
   },
   "tone": "bad",
   "mono": [
    "1050118621198921700"
   ]
  }
 ],
 "caption": {
  "en": "Same numbers as the terminal output above. The loss happens on the reading side, which is why X also sends the ID as a string.",
  "vi": "Cùng các con số như kết quả terminal ở trên. Mất mát xảy ra ở phía đọc, nên X còn gửi thêm ID dạng chuỗi."
 }
};
---
<EncodingStepCards {...props} />
