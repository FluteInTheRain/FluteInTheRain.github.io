---
// Four cases where w + r > n still returns an old value, as listed in the post.
import Frame from './ReplicationBFrame.astro';
import DiagramIcon from './DiagramIcon.astro';
import Bi from './ReplicationBBi.astro';

const cards = [
  { ic: 'backup', t: 'Restored from stale', tv: 'Khôi phục từ bản cũ',
    en: ['A node with the new value', 'fails and is rebuilt from', 'a replica that is stale'],
    vi: ['Node giữ giá trị mới hỏng', 'và được dựng lại từ một', 'replica cũ'] },
  { ic: 'fail', t: 'Half-failed write', tv: 'Ghi hỏng một nửa',
    en: ['A write fails on some nodes', 'but is not rolled back', 'on the others'],
    vi: ['Lần ghi lỗi ở vài node', 'nhưng không bị gỡ', 'ở các node còn lại'] },
  { ic: 'sync', t: 'Rebalance', tv: 'Rebalance',
    en: ['Moving data changes', 'which nodes hold', 'a given key'],
    vi: ['Chuyển dữ liệu làm đổi', 'node nào giữ', 'một key nhất định'] },
  { ic: 'clock', t: 'Clocks decide', tv: 'Đồng hồ quyết định',
    en: ['Timestamps pick the', '"newer" write, and', 'clocks can be wrong'],
    vi: ['Timestamp chọn lần ghi', '"mới hơn", mà đồng hồ', 'có thể sai'] },
];
---
<Frame h={250}
  label="Four cases where w + r greater than n can still return an old value: a node with the new value is restored from a stale replica; a write fails on some nodes but is not rolled back on others; a rebalance changes which nodes hold a key; clocks decide which write is newer."
  cap="Treat w and r as a way to make stale reads less likely, not as a guarantee."
  capVi="Hãy coi w và r là cách làm đọc cũ ít xảy ra hơn, chứ không phải lời đảm bảo.">
  <text x="450" y="26" text-anchor="middle" class="rb-title"><Bi en="Four ways w + r > n still returns an old value" vi="Bốn cách w + r > n vẫn trả về giá trị cũ" /></text>
  {cards.map((c, k) => {
    const x = 10 + k * 222;
    return (
      <g>
        <rect x={x} y={46} width={212} height={190} rx="8" class="rb-box" />
        <DiagramIcon name={c.ic} x={x + 106} y={80} size={32} />
        <text x={x + 106} y={128} text-anchor="middle" class="rb-h"><Bi en={c.t} vi={c.tv} /></text>
        {[0, 1, 2].map((i) => (
          <text x={x + 106} y={156 + i * 19} text-anchor="middle" class="rb-n"><Bi en={c.en[i]} vi={c.vi[i]} /></text>
        ))}
      </g>
    );
  })}
</Frame>
