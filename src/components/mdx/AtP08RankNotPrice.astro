---
// One simulated cross-section: 2,000 stocks, one month. Say a model's score has
// a true link to next month's return that explains about 1% of the variance.
// The scatter shows 220 of the 2,000 points; the bars use all 2,000. Numbers
// come from python (numpy seed 8): sample R2 = 1.54%, rank IC = 0.120,
// top-minus-bottom decile = 0.466 standard deviations of the monthly return.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 430;
const pts: [number, number][] = [[-0.224, 0.892], [1.747, 1.209], [-0.718, -0.331], [1.558, 0.797], [0.511, 0.377], [1.496, 1.021], [-0.578, 0.228], [-0.923, 0.334], [0.878, 0.139], [0.937, -0.387], [-1.426, -1.29], [-0.203, 2.084], [-0.238, 0.971], [-0.943, -0.834], [1.211, -0.041], [0.778, -0.771], [0.52, -1.829], [-0.573, -1.89], [0.52, 1.162], [-1.711, -0.419], [-1.108, -0.931], [-0.095, 1.314], [-0.093, 1.474], [-0.438, 1.183], [1.522, -1.044], [-0.641, -0.059], [0.057, 0.778], [0.073, -0.216], [-0.314, 0.936], [0.165, 1.066], [2.554, 0.363], [0.941, 0.205], [-0.132, -0.961], [1.173, 1.243], [0.39, -0.094], [1.561, -2.01], [1.633, -0.355], [2.79, -1.849], [0.877, 0.111], [0.377, 0.087], [-0.211, 0.257], [0.479, -0.387], [0.411, 1.786], [-0.192, 0.187], [1.943, -0.421], [-1.563, 0.322], [-1.542, 0.446], [1.045, -1.408], [0.518, -0.715], [-0.163, -0.076], [0.616, -1.077], [1.471, 0.051], [-0.733, -1.043], [0.736, 0.693], [-0.737, -1.487], [-0.768, 0.408], [0.667, 0.62], [-0.46, -0.735], [-0.666, -0.485], [0.801, -0.375], [0.532, -0.826], [-0.989, 0.229], [-0.776, 0.548], [-0.222, -1.122], [1.681, 1.575], [1.323, 0.8], [-0.409, 1.359], [-0.569, -1.163], [-0.171, 0.111], [2.205, 0.482], [-0.523, -0.414], [-1.133, 0.261], [-0.596, -0.598], [0.938, -2.121], [-1.191, 0.085], [0.327, 1.736], [-1.132, 0.02], [1.85, 2.917], [0.064, -0.133], [0.743, -0.406], [0.33, 0.363], [0.339, -0.891], [-1.036, 0.519], [-1.259, 0.604], [0.989, 0.684], [-0.837, -2.32], [0.271, -2.351], [-0.213, -0.207], [0.14, -1.787], [-0.902, -0.702], [0.836, 0.294], [3.234, -0.204], [-0.121, -0.641], [0.364, 1.071], [-0.542, 0.445], [-0.238, 1.135], [-0.551, 0.344], [-0.538, 1.612], [0.523, -1.607], [0.205, 0.897], [-0.325, -0.948], [-0.185, -0.271], [-0.726, -1.361], [-0.122, 0.158], [0.289, -0.455], [0.759, 1.168], [-0.269, -0.651], [1.636, -1.646], [-0.252, 0.553], [0.729, 1.424], [1.288, -1.168], [0.413, 0.173], [-0.494, -0.591], [-2.49, 1.083], [0.121, 0.569], [0.99, -0.39], [-1.34, 1.662], [0.925, -1.098], [-0.407, -0.329], [0.529, -0.214], [-1.452, 1.058], [-0.911, -0.863], [-0.34, 0.828], [0.958, 1.033], [-0.983, 0.302], [-0.035, 0.885], [-0.569, 0.242], [0.797, 0.683], [-0.758, -0.768], [-0.511, -0.742], [-0.511, 0.702], [-0.524, -1.347], [0.302, -0.016], [0.317, -0.479], [1.219, -1.554], [-1.81, -0.598], [0.14, -0.546], [0.513, -0.821], [-0.561, 0.896], [-1.165, -1.296], [0.416, 0.119], [0.688, -0.325], [0.046, 0.246], [0.005, -1.073], [-1.136, -2.238], [-2.273, 0.303], [0.705, 0.983], [1.345, -0.924], [-0.112, -0.673], [-1.134, 0.987], [-1.734, 0.53], [-2.582, -0.075], [0.72, 0.429], [-0.928, -0.273], [0.809, 1.83], [0.077, -1.473], [-0.239, -1.762], [-0.153, 1.487], [0.938, -2.461], [0.79, 0.207], [0.859, 0.628], [-0.184, 0.422], [-0.44, 2.845], [0.207, -0.024], [1.371, 0.47], [0.606, -1.368], [-0.703, 1.024], [-1.494, 0.622], [-1.608, -1.199], [-1.294, -2.023], [0.418, -0.164], [-0.631, 1.075], [0.332, 0.998], [0.891, 0.383], [0.339, -0.634], [0.442, -1.009], [0.963, -1.187], [-0.427, -0.312], [-1.556, 0.364], [0.219, 1.791], [1.701, 0.619], [-0.741, -1.606], [0.643, -0.659], [0.232, 0.582], [-1.522, 1.242], [-1.369, -0.869], [-2.421, -1.841], [-1.427, -1.389], [0.426, -1.87], [0.122, 0.297], [1.204, 2.134], [-0.509, 0.785], [-1.145, 0.006], [-0.21, 1.022], [-3.104, -0.939], [-0.91, 0.686], [0.77, 0.734], [-0.923, -0.022], [-1.004, -0.672], [1.195, 0.708], [0.383, 0.647], [-0.977, -1.001], [-1.977, -1.144], [-1.484, -1.288], [1.44, -1.304], [1.198, -1.223], [-0.644, -1.523], [-0.166, -0.099], [-0.782, 0.027], [0.279, 0.553], [-0.157, -0.729], [-0.077, -1.295], [1.564, -0.398], [0.347, 0.836], [-0.564, -2.147], [1.082, 0.166], [-1.983, -0.448], [-0.618, -0.667], [-0.781, -1.27], [1.342, -0.94]];
const dec: number[] = [-0.263, -0.152, -0.076, 0.102, 0.044, -0.02, 0.069, 0.14, 0.147, 0.203];
// left panel
const LX = 40, LY = 84, LW = 380, LH = 270;
const sx = (v: number) => LX + (Math.max(-2.9, Math.min(2.9, v)) + 3) / 6 * LW;
const sy = (v: number) => LY + LH / 2 - v / 4 * (LH / 2);
// right panel
const RX = 500, RW = 360;
const ZY = LY + LH / 2;
const BW = RW / 10;
const bh = (v: number) => v * 260;
---
<figure class="atp08-rk">
  <div class="atp08-rk-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: a scatter of 220 simulated stocks, predicted score against next-month return, an almost shapeless cloud with a faint upward tilt; R-squared 1.5 percent. Right: the same 2,000 stocks sorted into ten groups by predicted score; the average realised return rises from about minus 0.26 in the lowest group to plus 0.20 in the highest.">
      <DiagramIcon name="model" x={22} y={22} size={22} />
      <text x="44" y="28" class="h">
        <tspan data-lang-en>A cloud that barely tilts still sorts the stocks</tspan>
        <tspan data-lang-vi>Một đám mây gần như phẳng vẫn xếp hạng được cổ phiếu</tspan>
      </text>
      <text x="20" y="52" class="sub">
        <tspan data-lang-en>Simulated: 2,000 stocks, one month, a score that explains about 1% of the variance</tspan>
        <tspan data-lang-vi>Mô phỏng: 2.000 cổ phiếu, một tháng, điểm số giải thích khoảng 1% phương sai</tspan>
      </text>

      <rect x={LX} y={LY} width={LW} height={LH} rx="6" class="panel" />
      <line x1={LX} y1={ZY} x2={LX + LW} y2={ZY} class="axis" />
      <line x1={sx(-3)} y1={sy(-0.3)} x2={sx(3)} y2={sy(0.3)} class="trend" />
      {pts.map(([a, b]) => <circle cx={sx(a)} cy={sy(Math.max(-3.9, Math.min(3.9, b)))} r="2.6" class="dot" />)}
      <text x={LX + 6} y={LY - 8} class="cap">
        <tspan data-lang-en>Each dot: one stock</tspan>
        <tspan data-lang-vi>Mỗi chấm: một cổ phiếu</tspan>
      </text>
      <text x={LX + LW / 2} y={LY + LH + 22} text-anchor="middle" class="cap">
        <tspan data-lang-en>model score →</tspan>
        <tspan data-lang-vi>điểm của mô hình →</tspan>
      </text>
      <text x={LX + 8} y={LY + 18} class="cap">
        <tspan data-lang-en>↑ next-month return</tspan>
        <tspan data-lang-vi>↑ lợi suất tháng sau</tspan>
      </text>
      <text x={LX + LW - 8} y={LY + LH - 10} text-anchor="end" class="stat">R² = 1.5%</text>

      <line x1={RX - 8} y1={ZY} x2={RX + RW + 8} y2={ZY} class="axis" />
      {dec.map((v, i) => (
        <g>
          <rect x={RX + i * BW + 5} y={v >= 0 ? ZY - bh(v) : ZY} width={BW - 10} height={Math.abs(bh(v))} rx="2" class={`bar ${i === 9 ? 'top' : i === 0 ? 'low' : ''}`} />
          <text x={RX + i * BW + BW / 2} y={LY + LH + 22} text-anchor="middle" class="tick">{i + 1}</text>
        </g>
      ))}
      <text x={RX} y={LY - 8} class="cap">
        <tspan data-lang-en>Average realised return per predicted decile</tspan>
        <tspan data-lang-vi>Lợi suất thực tế trung bình theo decile điểm dự đoán</tspan>
      </text>
      <text x={RX + RW / 2} y={LY + LH + 42} text-anchor="middle" class="cap">
        <tspan data-lang-en>predicted decile: 1 = lowest score, 10 = highest</tspan>
        <tspan data-lang-vi>decile dự đoán: 1 = điểm thấp nhất, 10 = cao nhất</tspan>
      </text>
      <text x={RX + RW} y={LY + 14} text-anchor="end" class="stat">
        <tspan data-lang-en>rank IC 0.12 · decile 10 minus 1 = 0.47</tspan>
        <tspan data-lang-vi>rank IC 0,12 · decile 10 trừ 1 = 0,47</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Simulated data, numpy seed 8. The vertical unit on the right is one standard deviation of a stock's monthly return. A 1% R² looks like nothing in the cloud, yet the ten bars climb almost in order.</span>
    <span data-lang-vi>Số liệu mô phỏng, numpy seed 8. Đơn vị dọc bên phải là một độ lệch chuẩn của lợi suất tháng. R² 1% nhìn trong đám mây gần như không có gì, vậy mà mười cột vẫn leo gần đúng thứ tự.</span>
  </figcaption>
</figure>

<style>
  .atp08-rk { margin: 2em 0; width: 100%; }
  .atp08-rk-scroll { overflow-x: auto; }
  .atp08-rk svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .atp08-rk text { font-size: 14px; fill: var(--text-body); }
  .atp08-rk .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp08-rk .sub, .atp08-rk .cap { fill: var(--text-muted); font-size: 13px; }
  .atp08-rk .tick { font-size: 12px; fill: var(--text-muted); }
  .atp08-rk .stat { font-size: 13px; font-weight: 700; fill: var(--text); }
  .atp08-rk .panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .atp08-rk .axis { stroke: var(--text-muted); stroke-width: 1.2; }
  .atp08-rk .trend { stroke: var(--gold-icon); stroke-width: 2; stroke-dasharray: 5 4; }
  .atp08-rk .dot { fill: var(--text-faint); opacity: 0.75; }
  .atp08-rk .bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .atp08-rk .bar.top { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .atp08-rk .bar.low { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .atp08-rk figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
