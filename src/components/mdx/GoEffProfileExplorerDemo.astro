---
import DemoFrame from './DemoFrame.astro';
import GoEffProfileExplorerDemo from '../demos/GoEffProfileExplorerDemo.tsx';
---
<figure class="geff-figure">
  <DemoFrame title="Interactive pprof & fgprof Flame Graph explorer" titleVi="Khám phá Flame Graph với pprof & fgprof tương tác">
    <GoEffProfileExplorerDemo client:visible />
  </DemoFrame>
  <figcaption>
    <span data-lang-en>Switch between CPU, Off-CPU fgprof, alloc_space, and inuse_space profiles and click stack bars to contrast Flat vs. Cumulative costs and spot real root causes.</span>
    <span data-lang-vi>Đổi qua lại bốn chế độ CPU, fgprof Off-CPU, alloc_space và inuse_space, rồi bấm từng thanh stack để xem tỷ lệ Flat vs. Cum và cách xử lý gốc rễ.</span>
  </figcaption>
</figure>

<style is:global>
  .geff-figure { margin: 2em 0; width: 100%; }
  .geff-figure > .demo-frame { margin-bottom: 0; }
  .geff-figure > figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  .geff .sd-stats { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); }
  .geff .sd-group > span { text-transform: none; letter-spacing: 0; font-size: 13px; font-weight: 600; color: var(--text-muted); }
  .geff .sd-stat span { text-transform: none; letter-spacing: 0; font-size: 12px; font-weight: 600; }
  .geff .sd-stat b { font-size: 16px; overflow-wrap: anywhere; word-break: break-word; }

  .geff-cmd {
    padding: 8px 12px; margin-bottom: 10px; border: 1px solid var(--border); border-radius: 6px;
    background: var(--bg-alt); font-family: var(--font-mono, ui-monospace, monospace); font-size: 12px;
    color: var(--text); overflow-x: auto; white-space: nowrap;
  }
  .geff-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 12px; margin-bottom: 12px; }
  @media (max-width: 760px) { .geff-grid { grid-template-columns: 1fr; } }
  .geff-pane { border: 1px solid var(--border); border-radius: 8px; background: var(--bg); overflow: hidden; }
  .geff-hdr {
    padding: 7px 12px; font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--text-muted); background: var(--bg-alt); border-bottom: 1px solid var(--border);
  }
  .geff-diag, .geff-flame { padding: 12px; font-size: 13.5px; line-height: 1.55; color: var(--text-body); }
  .geff-flame { display: flex; flex-direction: column; gap: 6px; }
  .geff-fbar {
    display: flex; justify-content: space-between; align-items: center; gap: 8px; text-align: left;
    padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-alt);
    color: var(--text); font-size: 12px; font-weight: 600; cursor: pointer; min-width: 180px; max-width: 100%;
  }
  .geff-fbar.is-hot { background: var(--red-tint-bg); border-color: var(--red); color: var(--red); }
  .geff-fbar.is-selected { outline: 2px solid var(--text); }
  .geff-fname { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .geff-fpct { flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .geff-diag-title { font-family: var(--font-mono, ui-monospace, monospace); font-weight: 700; font-size: 12.5px; color: var(--text); margin-bottom: 6px; overflow-wrap: anywhere; }
  .geff-diag-line { margin: 0 0 10px; font-size: 13px; color: var(--text-body); }
  .geff-diag-fix { padding: 8px 10px; border-radius: 6px; background: var(--bg-alt); border: 1px solid var(--border); font-size: 12.5px; }
</style>
