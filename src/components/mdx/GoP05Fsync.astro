---
// Post 5, opener: three places where gVisor's Go code lost a quota error (issue #16043).
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 8 * Math.cos(a - 0.45), y2 - 8 * Math.sin(a - 0.45)];
  const p2 = [x2 - 8 * Math.cos(a + 0.45), y2 - 8 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const lanes = [
  { y: 60, en1: 'Sync file to host', vi1: 'Đồng bộ file xuống host', en2: 'result dropped, always returns nil', vi2: 'bỏ kết quả, luôn trả nil', reach: true },
  { y: 140, en1: 'A second path', vi1: 'Một đường khác', en2: 'never reaches the host flush', vi2: 'không bao giờ chạm tới flush của host', reach: false },
  { y: 220, en1: 'Close host file', vi1: 'Đóng file của host', en2: 'result discarded', vi2: 'vứt kết quả', reach: true },
];
---
<figure class="gp05a">
  <div class="gp05a-scroll">
  <svg viewBox="0 0 900 330" role="img" aria-label="A program calls fsync and close. In gVisor's Go code three paths lose the quota error EDQUOT that the host file reports, so the program sees 0.">
    <rect class="box" x="20" y="60" width="170" height="212" rx="8" />
    <text x="105" y="140" text-anchor="middle" class="b"><tspan data-lang-en>Program</tspan><tspan data-lang-vi>Chương trình</tspan></text>
    <text x="105" y="162" text-anchor="middle" class="m"><tspan data-lang-en>inside the sandbox</tspan><tspan data-lang-vi>chạy trong sandbox</tspan></text>
    <text x="105" y="184" text-anchor="middle" class="m">fsync, close</text>

    <rect class="box" x="720" y="60" width="160" height="212" rx="8" />
    <text x="800" y="132" text-anchor="middle" class="b"><tspan data-lang-en>Host file</tspan><tspan data-lang-vi>File trên host</tspan></text>
    <text x="800" y="154" text-anchor="middle" class="m"><tspan data-lang-en>on the quota mount</tspan><tspan data-lang-vi>trên mount có quota</tspan></text>
    <text x="800" y="184" text-anchor="middle" class="r">EDQUOT</text>

    <text x="410" y="40" text-anchor="middle" class="h"><tspan data-lang-en>Go code in gVisor</tspan><tspan data-lang-vi>Code Go trong gVisor</tspan></text>

    {lanes.map((l) => {
      const mid = l.y + 26;
      const a = arrow(190, mid, 240, mid);
      const b = arrow(620, mid, 720, mid);
      const c = arrow(720, mid + 8, 664, mid + 8);
      return (
        <g>
          <g><path class="ln" d={a.line} /><polygon points={a.head} class="bar" /></g>
          <rect class="box" x="240" y={l.y} width="380" height="52" rx="6" />
          <text x="256" y={l.y + 22} class="b"><tspan data-lang-en>{l.en1}</tspan><tspan data-lang-vi>{l.vi1}</tspan></text>
          <text x="256" y={l.y + 41} class="m"><tspan data-lang-en>{l.en2}</tspan><tspan data-lang-vi>{l.vi2}</tspan></text>
          {l.reach ? (
            <g>
              <path class="ln" d={b.line} /><polygon points={b.head} class="bar" />
              <path class="ln red" d={c.line} /><polygon points={c.head} fill="var(--red)" />
              <text x="652" y={mid + 13} text-anchor="middle" class="r">✕</text>
            </g>
          ) : (
            <path class="ln cut" d={`M 620 ${mid} L 720 ${mid}`} />
          )}
        </g>
      );
    })}

    <text x="450" y="312" text-anchor="middle" class="r"><tspan data-lang-en>The program sees 0, which means success, and the extra data is lost</tspan><tspan data-lang-vi>Chương trình thấy 0, nghĩa là thành công, và phần dữ liệu thừa bị mất</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The host reported the quota error, and three places in gVisor's Go code dropped it before it reached the program. Pull request #15979 fixes the fsync path only, one of the three.</span>
    <span data-lang-vi>Host đã báo lỗi quota, và ba chỗ trong code Go của gVisor đã bỏ nó trước khi tới chương trình. Pull request #15979 chỉ sửa đường fsync, một trong ba chỗ.</span>
  </figcaption>
</figure>

<style>
  .gp05a { margin: 2em 0; width: 100%; }
  .gp05a-scroll { overflow-x: auto; }
  .gp05a svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp05a text { font-size: 14px; fill: var(--text-body); }
  .gp05a .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp05a .b { font-weight: 700; fill: var(--text); }
  .gp05a .m { fill: var(--text-muted); font-size: 13px; }
  .gp05a .n { font-variant-numeric: tabular-nums; }
  .gp05a .r { fill: var(--red); font-weight: 700; }
  .gp05a .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp05a .box.red { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp05a .box.dash { stroke-dasharray: 4 3; }
  .gp05a .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp05a .ln.red { stroke: var(--red); }
  .gp05a .ln.cut { stroke-dasharray: 3 4; opacity: 0.5; }
  .gp05a .hd { fill: var(--text-muted); }
  .gp05a .hd.red { fill: var(--red); }
  .gp05a .rule { stroke: var(--border); }
  .gp05a .bar { fill: var(--text-muted); }
  .gp05a .bar.red { fill: var(--red); }
  .gp05a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
