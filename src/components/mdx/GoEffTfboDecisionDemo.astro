---
import DemoFrame from './DemoFrame.astro';
import GoEffTfboDecisionDemo from '../demos/GoEffTfboDecisionDemo.tsx';
---
<figure class="ge8f-figure">
  <DemoFrame title="Interactive workflow lab: TFBO gates, RAER stops, and Design Level leverage" titleVi="Mô phỏng quy trình: Chốt dừng RAER &amp; chọn đúng Tầng tối ưu">
    <GoEffTfboDecisionDemo client:visible />
  </DemoFrame>
  <figcaption>
    <span data-lang-en>Walk through three everyday engineering gates: stopping cleanly once RAER passes, picking System/Algorithm improvements over noisy micro-tweaks, and looping back to unit tests every sprint.</span>
    <span data-lang-vi>Đi qua 3 cửa kiểm soát thực chiến: biết dừng ngay khi đạt trần RAER, ưu tiên nâng tầng thuật toán/DB trước khi sửa vụn trong Go và luôn kiểm lại correctness qua từng vòng.</span>
  </figcaption>
</figure>

<style is:global>
  .ge8f-figure { margin: 2em 0; width: 100%; }
  .ge8f-figure > .demo-frame { margin-bottom: 0; }
  .ge8f-figure > figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  .ge8f .sd-stats { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); }
  .ge8f .sd-group > span { text-transform: none; letter-spacing: 0; font-size: 13px; font-weight: 600; color: var(--text-muted); }
  .ge8f .sd-stat span { text-transform: none; letter-spacing: 0; font-size: 12px; font-weight: 600; }
  .ge8f .sd-stat b { font-size: 16px; overflow-wrap: anywhere; word-break: break-word; }

  .ge8f-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 12px; margin-bottom: 12px; }
  @media (max-width: 760px) { .ge8f-grid { grid-template-columns: 1fr; } }
  .ge8f-pane { border: 1px solid var(--border); border-radius: 8px; background: var(--bg); overflow: hidden; }
  .ge8f-hdr {
    padding: 7px 12px; font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--text-muted); background: var(--bg-alt); border-bottom: 1px solid var(--border);
  }
  .ge8f-code { padding: 8px 0; overflow-x: auto; font-family: var(--font-mono, ui-monospace, monospace); font-size: 12px; line-height: 1.55; }
  .ge8f-line { display: flex; gap: 8px; padding: 2px 12px; white-space: pre; color: var(--text-body); }
  .ge8f-ln { color: var(--text-muted); user-select: none; min-width: 18px; }
  .ge8f-line.is-active { background: var(--gold-tint-bg); color: var(--text); font-weight: 700; }
  .ge8f-note { padding: 12px; font-size: 13.5px; line-height: 1.55; color: var(--text-body); }
</style>
