---
// Chapter 2, "emphasize by de-emphasizing": the active nav item stays exactly the same in both
// versions; only the inactive items change. Second row: a sidebar with its own background
// competes with the content; without it, the content leads.

const W = 900;
const H = 400;
const items = ['Overview', 'Orders', 'Customers', 'Reports'];
const itemsVi = ['Tổng quan', 'Đơn hàng', 'Khách hàng', 'Báo cáo'];
const navX = [20, 470];
const navY = 56;
const ACTIVE = 1;
---
<figure class="qcp">
  <div class="qcp-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: two navigation bars. In both the active item Orders is the same blue and bold. On the left the other items are a similar blue, so Orders is lost; on the right they are soft grey, so Orders stands out. Bottom: two layouts. On the left the sidebar has a dark background that competes with the main content; on the right the sidebar sits on the page background and the content leads.">
      {navX.map((x, v) => (
        <g>
          <rect x={x} y={navY - 30} width="410" height="48" rx="8" class="qcp-frame" />
          {items.map((it, i) => (
            <text x={x + 18 + i * 98} y={navY} class:list={['qcp-item', { 'is-active': i === ACTIVE, 'is-soft': v === 1 && i !== ACTIVE, 'is-loud': v === 0 && i !== ACTIVE }]}>
              <tspan data-lang-en>{it}</tspan>
              <tspan data-lang-vi>{itemsVi[i]}</tspan>
            </text>
          ))}
          <text x={x} y={navY + 48} class:list={['qcp-label', { 'is-good': v === 1 }]}>
            <tspan data-lang-en>{v === 0 ? 'Others in a similar blue: the active one gets lost' : 'Others softened: the active one stands out'}</tspan>
            <tspan data-lang-vi>{v === 0 ? 'Mục khác cùng tông xanh: mục đang chọn bị lẫn' : 'Mục khác dịu đi: mục đang chọn nổi lên'}</tspan>
          </text>
        </g>
      ))}

      <line x1="20" y1="140" x2="880" y2="140" class="qcp-rule" />

      {navX.map((x, v) => (
        <g>
          <rect x={x} y="160" width="410" height="180" rx="8" class="qcp-frame" />
          <rect x={x} y="160" width="120" height="180" rx="8" class:list={['qcp-side', { 'is-loud': v === 0 }]} />
          {[0, 1, 2, 3].map((i) => (
            <rect x={x + 18} y={186 + i * 26} width={i === 0 ? 70 : 56} height="8" rx="3" class:list={['qcp-side-text', { 'is-on-dark': v === 0 }]} />
          ))}
          <rect x={x + 146} y="184" width="160" height="12" rx="3" class="qcp-head" />
          {[0, 1, 2, 3, 4].map((i) => (
            <rect x={x + 146} y={212 + i * 16} width={i === 4 ? 140 : 240} height="7" rx="3" class="qcp-text" />
          ))}
          <text x={x} y="366" class:list={['qcp-label', { 'is-good': v === 1 }]}>
            <tspan data-lang-en>{v === 0 ? 'Sidebar with its own dark background' : 'Sidebar on the page background'}</tspan>
            <tspan data-lang-vi>{v === 0 ? 'Sidebar có nền tối riêng' : 'Sidebar nằm thẳng trên nền trang'}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>In both pairs the important part did not change. Only its competition got quieter.</span>
    <span data-lang-vi>Ở cả hai cặp, phần quan trọng không hề đổi. Chỉ có đối thủ của nó dịu đi.</span>
  </figcaption>
</figure>

<style>
  .qcp { margin: 2em 0; width: 100%; }
  .qcp-scroll { overflow-x: auto; }
  .qcp svg { display: block; width: 100%; min-width: 680px; height: auto; }
  .qcp text { font-size: 14px; fill: var(--text-body); }
  .qcp-frame { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .qcp text.qcp-item { font-size: 15px; font-weight: 500; }
  .qcp text.qcp-item.is-active { fill: #2f6fd6; font-weight: 700; }
  .qcp text.qcp-item.is-loud { fill: #4d82d9; }
  .qcp text.qcp-item.is-soft { fill: var(--text-faint); }
  .qcp text.qcp-label { font-weight: 600; fill: var(--text); }
  .qcp text.qcp-label.is-good { fill: var(--red); }
  .qcp-rule { stroke: var(--border); }
  .qcp-side { fill: var(--bg-alt); stroke: var(--border); }
  .qcp-side.is-loud { fill: #26303f; stroke: none; }
  .qcp-side-text { fill: var(--text-faint); }
  .qcp-side-text.is-on-dark { fill: #9fb0c8; }
  .qcp-head { fill: var(--text); }
  .qcp-text { fill: var(--text-muted); }
  .qcp figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
