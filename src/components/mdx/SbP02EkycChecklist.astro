---
// Five practical steps when opening your first Vietnamese securities account.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 240;

const STEPS = [
  { x: 96, icon: 'scale', en: '1. Verify license', vi: '1. Kiểm giấy phép', subEn: 'SSC member list', subVi: 'danh sách UBCKNN' },
  { x: 274, icon: 'key', en: '2. eKYC + bank', vi: '2. eKYC + ngân hàng', subEn: 'CCCD + matching name', subVi: 'CCCD trùng chủ TK' },
  { x: 452, icon: 'lock', en: '3. Lock margin', vi: '3. Khoá margin', subEn: 'stay on .1 cash tab', subVi: 'chỉ dùng tiểu khoản .1' },
  { x: 630, icon: 'receipt', en: '4. Read fee table', vi: '4. Đọc biểu phí', subEn: 'real % after promo', subVi: 'phí thật sau ưu đãi' },
  { x: 808, icon: 'ok', en: '5. Test transfer', vi: '5. Nạp thử ít tiền', subEn: '100k in & out first', subVi: 'chuyển thử vào – ra' },
] as const;
---
<figure class="sbp2-ekyc">
  <div class="sbp2-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Five-step onboarding checklist: verify SSC license, complete eKYC with matching bank account, stick to cash sub-account, inspect post-promo fees, and run a small transfer test.">
      <text x="20" y="30" class="sbp2-title">
        <tspan data-lang-en>Five-minute opening checklist before your first deposit</tspan>
        <tspan data-lang-vi>Checklist năm phút trước khi nạp đồng tiền đầu tiên</tspan>
      </text>

      <line x1="96" y1="112" x2="808" y2="112" class="sbp2-line" />

      {STEPS.map((s, i) => (
        <g>
          <rect
            x={s.x - 76}
            y="64"
            width="152"
            height="136"
            rx="10"
            class={i === 2 ? 'sbp2-box sbp2-box-red' : 'sbp2-box'}
          />
          <DiagramIcon name={s.icon} x={s.x} y={98} size={28} />
          <text x={s.x} y="142" text-anchor="middle" class={i === 2 ? 'sbp2-step sbp2-red' : 'sbp2-step'}>
            <tspan data-lang-en>{s.en}</tspan>
            <tspan data-lang-vi>{s.vi}</tspan>
          </text>
          <text x={s.x} y="168" text-anchor="middle" class="sbp2-sub">
            <tspan data-lang-en>{s.subEn}</tspan>
            <tspan data-lang-vi>{s.subVi}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Opening an account takes ten minutes online. Taking five extra minutes to confirm the SSC license, lock into the cash tab, and test a 100,000 VND transfer both ways prevents almost every beginner onboarding headache.</span>
    <span data-lang-vi>Mở tài khoản online mất khoảng mười phút. Bỏ thêm năm phút kiểm giấy phép UBCKNN, giữ nguyên tiểu khoản thường và chuyển thử 100.000 đồng vào – ra giúp tránh hầu hết rắc rối ngày đầu.</span>
  </figcaption>
</figure>

<style>
  .sbp2-ekyc { margin: 2em 0; width: 100%; }
  .sbp2-scroll { overflow-x: auto; }
  .sbp2-ekyc svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sbp2-ekyc text { font-size: 13.5px; fill: var(--text-body); }
  .sbp2-title { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sbp2-line { stroke: var(--border); stroke-width: 2; }
  .sbp2-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .sbp2-box-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .sbp2-step { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .sbp2-red { fill: var(--red); }
  .sbp2-sub { font-size: 12px; fill: var(--text-muted); }
  .sbp2-ekyc figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
