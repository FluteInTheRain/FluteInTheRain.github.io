---
// Interactive sharding & rebalancing playground wrapper with bilingual caption and scoped shrd-* styles.
import DemoFrame from './DemoFrame.astro';
import ShardingRebalanceDemo from '../demos/ShardingRebalanceDemo.tsx';
---
<figure class="shrd-figure">
  <DemoFrame title="Rebalancing strategies and hot-key salting" titleVi="So sánh chiến lược rebalance và thêm muối cho hot key">
    <ShardingRebalanceDemo client:visible />
  </DemoFrame>
  <figcaption>
    <span data-lang-en>60 keys distributed across N nodes using a 32-bit hash (starting right after resizing from 3 to 4 nodes). Outlined red key chips moved on the last resize. Notice how <code>hash(k) % N</code> relocates most keys, while fixed logical shards and consistent hashing move only a proportional slice — yet none of them can prevent a single hot key (<code>@taylor</code>) from overloading one node without salting.</span>
    <span data-lang-vi>60 khoá được rải qua N node bằng hàm băm 32-bit (bắt đầu ngay sau bước đổi từ 3 lên 4 node). Các ô khoá viền đỏ là khoá vừa bị dời sang máy khác. Hãy chú ý <code>hash(k) % N</code> dời phần lớn dữ liệu, trong khi số shard cố định và consistent hashing chỉ dời một phần tỉ lệ — nhưng không chiến lược nào tự chống nổi một hot key (<code>@taylor</code>) dồn tải lên một node nếu không thêm muối.</span>
  </figcaption>
</figure>

<style is:global>
  .shrd-figure {
    margin: 2em 0;
    width: 100%;
  }
  .shrd-figure > .demo-frame {
    margin-bottom: 0;
  }
  .shrd-figure > figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
  .shrd .sd-group > span,
  .shrd .sd-stat span {
    text-transform: none;
    letter-spacing: 0;
    font-size: 12.5px;
    font-weight: 600;
  }
  .shrd .sd-stat b {
    font-size: 19px;
  }
  .shrd .sd-stat b span {
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
  }
  .prose .shrd-msg code {
    background: none;
    border: 0;
    padding: 0;
    font-weight: 600;
    color: var(--text);
  }
  .shrd-msg {
    min-height: 2.6em;
    margin: 0 0 12px;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--text-body);
  }
  .shrd-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(195px, 1fr));
    gap: 10px;
  }
  .shrd-node {
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-alt);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .shrd-node.is-hot {
    border-color: var(--red);
    background: var(--red-tint-bg);
  }
  .shrd-node-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    font-size: 12.5px;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .shrd-node-head strong {
    font-size: 13.5px;
    color: var(--text);
  }
  .shrd-bar {
    height: 6px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
  }
  .shrd-bar-fill {
    height: 100%;
    background: var(--text-muted);
    border-radius: 999px;
    transition: width 0.2s ease;
  }
  .shrd-bar-fill.is-hot {
    background: var(--red);
  }
  .shrd-shards {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }
  .shrd-shard {
    padding: 1px 5px;
    border-radius: 4px;
    border: 1px solid var(--border);
    background: var(--card-bg);
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .shrd-keys {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .shrd-chip {
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--card-bg);
    font-size: 11.5px;
    color: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .shrd-chip.is-moved {
    border-color: var(--red);
    color: var(--red);
    font-weight: 600;
  }
  .shrd-chip.is-hot {
    border-color: var(--red);
    background: var(--red);
    color: #fff;
    font-weight: 700;
  }
</style>
