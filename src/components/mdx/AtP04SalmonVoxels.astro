---
// Many tests, one threshold: the dead-salmon fMRI case (Bennett et al.). 130,000 voxel tests at p < 0.001
// give 130 expected false positives (130,000 x 0.001). The dots are placed with a seeded PRNG.
function mulberry(seed: number) {
  let a = seed;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const r = mulberry(404);
const CX = 655, CY = 208, RX = 190, RY = 108;
const hits: [number, number][] = [];
while (hits.length < 130) {
  const x = (r() * 2 - 1) * RX, y = (r() * 2 - 1) * RY;
  if ((x * x) / (RX * RX) + (y * y) / (RY * RY) <= 0.92) hits.push([CX + x, CY + y]);
}
const faint: [number, number][] = [];
while (faint.length < 520) {
  const x = (r() * 2 - 1) * RX, y = (r() * 2 - 1) * RY;
  if ((x * x) / (RX * RX) + (y * y) / (RY * RY) <= 0.92) faint.push([CX + x, CY + y]);
}
---
<figure class="apsv">
  <div class="apsv-scroll">
  <svg viewBox="0 0 900 390" role="img" aria-label="Left: one test at a 0.1 percent threshold lights up by chance 1 time in 1,000. Right: an outline of a scanned brain volume with 130 red dots, the 130,000 voxel tests times 0.001 expected false positives, even though the subject was a dead salmon.">
    <text x="20" y="28" class="apsv-h">
      <tspan data-lang-en>One test is safe. A hundred thousand tests are not.</tspan>
      <tspan data-lang-vi>Một phép test thì an toàn. Một trăm nghìn phép thì không.</tspan>
    </text>
    <rect x="20" y="56" width="230" height="284" rx="8" class="apsv-panel" />
    <rect x="125" y="110" width="20" height="20" class="apsv-cell" />
    <text x="135" y="166" text-anchor="middle" class="apsv-big">1</text>
    <text x="135" y="196" text-anchor="middle" class="apsv-t">
      <tspan data-lang-en>test at p &lt; 0.001</tspan>
      <tspan data-lang-vi>phép test ở p &lt; 0,001</tspan>
    </text>
    <text x="135" y="238" text-anchor="middle" class="apsv-t">
      <tspan data-lang-en>chance of a false hit:</tspan>
      <tspan data-lang-vi>xác suất báo nhầm:</tspan>
    </text>
    <text x="135" y="262" text-anchor="middle" class="apsv-num">1 in 1,000</text>

    <line x1="262" y1="206" x2="402" y2="206" class="apsv-arrow" />
    <polygon points="402,198 418,206 402,214" class="apsv-arrowhead" />
    <text x="332" y="190" text-anchor="middle" class="apsv-t">× 130,000</text>

    <rect x="430" y="56" width="450" height="284" rx="8" class="apsv-panel" />
    <ellipse cx={CX} cy={CY} rx={RX + 10} ry={RY + 10} class="apsv-brain" />
    <g>
      {faint.map(([x, y]) => <circle cx={x} cy={y} r="1.6" class="apsv-dot" />)}
      {hits.map(([x, y]) => <circle cx={x} cy={y} r="3.4" class="apsv-hit" />)}
    </g>
    <text x="445" y="80" class="apsv-t">
      <tspan data-lang-en>One scan of a dead salmon, 130,000 voxel tests</tspan>
      <tspan data-lang-vi>Một lần quét con cá hồi đã chết, 130.000 phép test voxel</tspan>
    </text>
    <text x="445" y="370" class="apsv-num is-red">
      <tspan data-lang-en>130,000 × 0.001 = 130 voxels light up by chance</tspan>
      <tspan data-lang-vi>130.000 × 0,001 = 130 voxel sáng lên do may rủi</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Bennett and colleagues scanned a dead Atlantic salmon (130,000 voxels in a typical volume). With an uncorrected p &lt; 0.001 threshold, they still found clusters of active voxels in its brain. The 130 is plain arithmetic: tests × threshold.</span>
    <span data-lang-vi>Bennett và cộng sự quét một con cá hồi Đại Tây Dương đã chết (một khối quét điển hình có 130.000 voxel). Với ngưỡng p &lt; 0,001 chưa hiệu chỉnh, họ vẫn thấy các cụm voxel hoạt động trong não nó. Con số 130 chỉ là phép nhân: số phép test × ngưỡng.</span>
  </figcaption>
</figure>

