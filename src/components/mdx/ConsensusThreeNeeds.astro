---
// Picture-first overview of the three backend jobs that need linearizability. Static SVG, site tokens only.
import ConsensusFigure from './ConsensusFigure.astro';
import DiagramIcon from './DiagramIcon.astro';
interface Props { lang: 'en' | 'vi' }
const { lang } = Astro.props;

const T = {
  en: {
    aria: 'Three cards. Locks and leader election: two nodes must never both believe they hold the same lease. Uniqueness: two people must not both get the same username or the last seat. Cross-channel timing: a job on a fast queue must not outrun the file it refers to. Each card ends with what it needs: one current lock owner, one current answer, or reading your own write.',
    cards: [
      { icons: ['server', 'lock', 'server'], title: 'Locks and leader election', body: ['Two nodes must never both', 'believe they hold the same', 'lease (split brain).'], need: 'Needs: one current lock owner' },
      { icons: ['users', 'link'], title: 'Uniqueness', body: ['Two people must not both get', 'the same username, the same', 'path, or the last seat.'], need: 'Needs: one current answer' },
      { icons: ['disk', 'log', 'worker'], title: 'Cross-channel timing', body: ['A job on a fast queue must', 'not outrun the file it', 'refers to.'], need: 'Needs: read your own write' },
    ],
    cap: 'Three jobs where a stale answer corrupts the system instead of just annoying a user.',
  },
  vi: {
    aria: 'Ba thẻ. Khoá và bầu leader: hai node không bao giờ được cùng tin mình giữ một lease. Tính duy nhất: hai người không được cùng nhận một username hay chiếc ghế cuối. Phụ thuộc thời gian giữa các kênh: một job trên hàng đợi nhanh không được chạy trước tệp mà nó nhắc tới. Mỗi thẻ kết bằng điều nó cần: một chủ khoá hiện hành, một đáp án hiện hành, hoặc đọc được cái vừa ghi.',
    cards: [
      { icons: ['server', 'lock', 'server'], title: 'Khoá và bầu leader', body: ['Hai node không bao giờ được', 'cùng tin mình giữ một', 'lease (split brain).'], need: 'Cần: một chủ khoá hiện hành' },
      { icons: ['users', 'link'], title: 'Tính duy nhất', body: ['Hai người không được cùng', 'nhận một username, một', 'đường dẫn, hay ghế cuối.'], need: 'Cần: một đáp án hiện hành' },
      { icons: ['disk', 'log', 'worker'], title: 'Thời gian giữa các kênh', body: ['Job trên hàng đợi nhanh', 'không được chạy trước tệp', 'mà nó nhắc tới.'], need: 'Cần: đọc được cái vừa ghi' },
    ],
    cap: 'Ba việc mà đáp án cũ làm hỏng hệ thống chứ không chỉ làm người dùng khó chịu.',
  },
}[lang];
const cw = 280;
---
<ConsensusFigure aria={T.aria} cap={T.cap} w={900} h={210}>
  {T.cards.map((c, i) => {
    const x = i * 310;
    return (
      <g>
        <rect x={x} y="0" width={cw} height="210" rx="8" class="cfg-box" />
        {c.icons.map((n, k) => <DiagramIcon name={n as any} x={x + 28 + k * 40} y={34} size={28} />)}
        <text x={x + 14} y={86} class="cfg-n" style="font-size:15px">{c.title}</text>
        {c.body.map((t, k) => <text x={x + 14} y={112 + k * 17}>{t}</text>)}
        <rect x={x + 10} y="168" width={cw - 20} height="32" rx="6" class="cfg-box is-ok" />
        <text x={x + cw / 2} y="189" text-anchor="middle" class="cfg-g">{c.need}</text>
      </g>
    );
  })}
</ConsensusFigure>
