---
// Icons: DiagramIcon from diagram-icons.ts. Motion: fig-motion.css classes (fm-*).
// Two ways to use four cores on the Sum job. Times are the medians from the post's -cpu 4 benchstat table
// (Apple M2, Go 1.27.1, 1,000,000 lines). Segment widths and cut positions are illustrative.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const L = 10;
  const w = 5;
  const bx = x2 - L * Math.cos(a);
  const by = y2 - L * Math.sin(a);
  const p1 = `${x2},${y2}`;
  const p2 = `${bx + w * Math.sin(a)},${by - w * Math.cos(a)}`;
  const p3 = `${bx - w * Math.sin(a)},${by + w * Math.cos(a)}`;
  return { x1, y1, x2: bx, y2: by, head: `${p1} ${p2} ${p3}` };
}
// Panel 1: feeder -> channel -> 4 workers
const p1y = 56;
const wy = (k: number) => p1y + 14 + k * 38;
const chanCy = (wy(0) + wy(3) + 26) / 2;
const boxY = chanCy - 31;
const feed = arrow(172, chanCy, 300, chanCy);
const fan = [0, 1, 2, 3].map((k) => arrow(442, chanCy, 630, wy(k) + 13));
// Panel 2: file bar split into four shards
const p2y = 262;
const barY = p2y + 22;
const barX = 20;
const barW = 860;
const cuts = [0, 215, 430, 645, 860];
const snap = [0, 6, 4, 9, 0]; // illustrative shift to the next newline
const wyy = barY + 78;
const totalY = wyy + 50 + 34;
const H = totalY + 34 + 16;
---
<figure class="gp19d">
  <div class="gp19d-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: one feeder goroutine sends every line over one channel to four workers, which took 122.57 ms. Bottom: the file is cut into four byte ranges, each worker reads its own range with its own 8 KiB buffer, and only four partial sums are sent, which took 4.29 ms.">
    <text x="20" y="24" class="h">
      <tspan data-lang-en>Channel workers: one hand-off per line, 122.57 ms</tspan>
      <tspan data-lang-vi>Worker qua channel: mỗi dòng một lần chuyển giao, 122,57 ms</tspan>
    </text>
    <rect x="20" y={boxY} width="150" height="62" rx="8" class="box" />
    <DiagramIcon name="gopher" x={38} y={chanCy - 10} size={24} />
    <text x="60" y={chanCy - 4} class="b">feeder</text>
    <text x="34" y={chanCy + 18} class="m">
      <tspan data-lang-en>scans the lines</tspan>
      <tspan data-lang-vi>quét các dòng</tspan>
    </text>
    <line x1={feed.x1} y1={feed.y1} x2={feed.x2} y2={feed.y2} class="ln red fm-flow" />
    <polygon points={feed.head} class="hd red" />
    <text x="230" y={chanCy - 12} text-anchor="middle" class="r num">
      <tspan data-lang-en>1,000,000 sends</tspan>
      <tspan data-lang-vi>1.000.000 lần gửi</tspan>
    </text>
    <rect x="300" y={boxY} width="140" height="62" rx="8" class="box bad" />
    <DiagramIcon name="chan-in" x={320} y={chanCy - 10} size={26} />
    <text x="342" y={chanCy - 4} class="b">workCh</text>
    <text x="314" y={chanCy + 18} class="m">
      <tspan data-lang-en>one channel</tspan>
      <tspan data-lang-vi>một channel</tspan>
    </text>
    {fan.map((f) => (
      <g>
        <line x1={f.x1} y1={f.y1} x2={f.x2} y2={f.y2} class="ln red fm-flow" />
        <polygon points={f.head} class="hd red" />
      </g>
    ))}
    {[0, 1, 2, 3].map((k) => (
      <g>
        <rect x="630" y={wy(k)} width="250" height="26" rx="6" class="box" />
        <DiagramIcon name="gopher" x={647} y={wy(k) + 13} size={22} />
        <text x="666" y={wy(k) + 18} class="m">
          <tspan data-lang-en>worker {k + 1} parses its lines</tspan>
          <tspan data-lang-vi>worker {k + 1} parse các dòng của nó</tspan>
        </text>
      </g>
    ))}

    <text x="20" y={p2y} class="h">
      <tspan data-lang-en>Sharded: each worker reads its own byte range, 4.29 ms</tspan>
      <tspan data-lang-vi>Chia khúc: mỗi worker đọc một đoạn byte riêng, 4,29 ms</tspan>
    </text>
    {[0, 1, 2, 3].map((k) => {
      const x = barX + cuts[k] + snap[k];
      const x2 = barX + cuts[k + 1] + snap[k + 1];
      return (
        <g>
          <rect x={x} y={barY} width={x2 - x} height="40" class="seg" />
          <text x={(x + x2) / 2} y={barY + 25} text-anchor="middle" class="m num">
            <tspan data-lang-en>bytes of shard {k + 1}</tspan>
            <tspan data-lang-vi>byte của khúc {k + 1}</tspan>
          </text>
        </g>
      );
    })}
    {[1, 2, 3].map((k) => (
      <g>
        <line x1={barX + cuts[k]} x2={barX + cuts[k]} y1={barY - 4} y2={barY + 44} class="cut" />
        <line x1={barX + cuts[k] + snap[k]} x2={barX + cuts[k] + snap[k]} y1={barY - 4} y2={barY + 44} class="snap" />
      </g>
    ))}
    {[0, 1, 2, 3].map((k) => {
      const cx = barX + (cuts[k] + cuts[k + 1]) / 2 + 4;
      return (
        <g>
          <rect x={cx - 100} y={wyy} width="200" height="50" rx="8" class="box" />
          <DiagramIcon name="gopher" x={cx - 36} y={wyy + 15} size={24} />
          <text x={cx - 18} y={wyy + 20} class="b">worker {k + 1}</text>
          <text x={cx} y={wyy + 40} text-anchor="middle" class="m">SectionReader + 8 KiB</text>
          <line x1={cx} y1={wyy + 50} x2={cx} y2={totalY - 10} class="ln" />
          <polygon points={`${cx},${totalY} ${cx - 5},${totalY - 10} ${cx + 5},${totalY - 10}`} class="hd" />
        </g>
      );
    })}
    <text x="20" y={wyy - 8} class="m">
      <tspan data-lang-en>dashed: size / 4. solid: moved to the next newline, so no line is cut in two</tspan>
      <tspan data-lang-vi>nét đứt: size / 4. nét liền: dời tới dấu xuống dòng kế, nên không dòng nào bị cắt đôi</tspan>
    </text>
    <rect x="20" y={totalY} width="860" height="34" rx="8" class="box gold fm-pulse" />
    <DiagramIcon name="chan-out" x={300} y={totalY + 17} size={24} />
    <text x="470" y={totalY + 22} text-anchor="middle" class="b num">
      <tspan data-lang-en>4 sends: one partial sum per worker</tspan>
      <tspan data-lang-vi>4 lần gửi: mỗi worker một tổng riêng</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Both versions parse the same lines. The top one pays a channel hand-off for every line, the bottom one pays four. The times are medians of 10 runs on four of the M2's eight cores.</span>
    <span data-lang-vi>Cả hai phiên bản parse cùng các dòng. Bản trên trả chi phí channel cho mỗi dòng, bản dưới chỉ trả bốn lần. Thời gian là trung vị của 10 lần chạy trên bốn trong tám nhân của M2.</span>
  </figcaption>
</figure>

<style>
  .gp19d { margin: 2em 0; width: 100%; }
  .gp19d-scroll { overflow-x: auto; }
  .gp19d svg { display: block; width: 100%; min-width: 760px; height: auto; }
  .gp19d text { font-size: 14px; fill: var(--text-body); }
  .gp19d .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp19d .b { font-weight: 700; fill: var(--text); }
  .gp19d .m { fill: var(--text-muted); }
  .gp19d .r { fill: var(--red); font-weight: 700; }
  .gp19d .num { font-variant-numeric: tabular-nums; }
  .gp19d .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp19d .box.bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp19d .box.gold { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .gp19d .seg { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp19d .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp19d .ln.red { stroke: var(--red); }
  .gp19d .hd { fill: var(--text-muted); }
  .gp19d .hd.red { fill: var(--red); }
  .gp19d .cut { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp19d .snap { stroke: var(--gold); stroke-width: 2.5; }
  .gp19d figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
