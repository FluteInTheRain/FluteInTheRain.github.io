---
// Memory picture for the Structs section: a, p and zero from the program's main().
// Plain inline SVG with site tokens; arrowheads are polygons, so no ids are needed.
const W = 900;
const H = 290;
import DiagramIcon from './DiagramIcon.astro';
---
<figure class="p04a">
  <div class="p04a-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Variable a holds Owner Lan and Balance 150. Variable p holds the address of a, so p.Balance changes a.Balance. Variable zero holds an empty Owner and Balance 0.">
    <text x="20" y="26" class="h">a</text>
    <text x="40" y="26" class="m">Account</text>
    <DiagramIcon name="struct" x={122} y={20} size={24} />
    <rect x="20" y="40" width="130" height="38" class="cell" />
    <rect x="150" y="40" width="170" height="38" class="cell" />
    <rect x="20" y="78" width="130" height="38" class="cell" />
    <rect x="150" y="78" width="170" height="38" class="hot fm-pulse" />
    <text x="34" y="64" class="m">Owner</text>
    <text x="164" y="64" class="b">"Lan"</text>
    <text x="34" y="102" class="m">Balance</text>
    <text x="164" y="102" class="r">150</text>

    <text x="520" y="26" class="h">p</text>
    <text x="540" y="26" class="m">*Account</text>
    <DiagramIcon name="label" x={632} y={20} size={24} />
    <rect x="520" y="62" width="200" height="38" class="cell" />
    <text x="534" y="86" class="b"><tspan data-lang-en>address of a</tspan><tspan data-lang-vi>địa chỉ của a</tspan></text>
    <path d="M 520 81 L 332 81" class="ln fm-flow" />
    <polygon points="322,81 334,75 334,87" class="ar" />
    <text x="420" y="70" text-anchor="middle" class="m">p := &amp;a</text>

    <text x="340" y="138" class="r"><tspan data-lang-en>p.Balance += 50 changes a.Balance, not a copy</tspan><tspan data-lang-vi>p.Balance += 50 sửa chính a.Balance, không phải bản sao</tspan></text>

    <line x1="20" x2="880" y1="160" y2="160" class="rule" />

    <text x="20" y="190" class="h">zero</text>
    <text x="64" y="190" class="m">Account</text>
    <DiagramIcon name="struct" x={146} y={184} size={24} />
    <rect x="20" y="204" width="130" height="34" class="cell" />
    <rect x="150" y="204" width="170" height="34" class="cell" />
    <rect x="20" y="238" width="130" height="34" class="cell" />
    <rect x="150" y="238" width="170" height="34" class="cell" />
    <text x="34" y="226" class="m">Owner</text>
    <text x="164" y="226" class="b">""</text>
    <text x="34" y="260" class="m">Balance</text>
    <text x="164" y="260" class="b">0</text>
    <text x="340" y="236" class="m"><tspan data-lang-en>var zero Account: every field starts at its zero value.</tspan><tspan data-lang-vi>var zero Account: mọi field bắt đầu bằng giá trị zero.</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The state just before the Println calls. a is the struct itself; p only holds its address, so writing through p changes a.</span>
    <span data-lang-vi>Trạng thái ngay trước các lệnh Println. a là chính struct; p chỉ giữ địa chỉ của nó, nên ghi qua p là sửa a.</span>
  </figcaption>
</figure>

<style>
  .p04a { margin: 2em 0; width: 100%; }
  .p04a-scroll { overflow-x: auto; }
  .p04a svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p04a text { font-size: 14px; fill: var(--text-body); }
  .p04a .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .p04a .m { fill: var(--text-muted); }
  .p04a .b { font-weight: 700; fill: var(--text); }
  .p04a .r { fill: var(--red); font-weight: 700; }
  .p04a .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .p04a .cell { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p04a .hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .p04a .dash { fill: none; stroke: var(--red); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .p04a .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .p04a .ar { fill: var(--text-muted); }
  .p04a .lnr { fill: none; stroke: var(--red); stroke-width: 1.5; }
  .p04a .arr { fill: var(--red); }
  .p04a .rule { stroke: var(--border); stroke-width: 1; }
  .p04a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
