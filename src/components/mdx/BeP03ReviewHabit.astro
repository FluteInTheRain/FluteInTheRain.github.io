---
// The review habit for AI-written endpoints: read the signature, curl some
// garbage, read the response body. The garbage curl is the red row — the one
// check that catches most of it.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 300;
const rows = [
  { mid: 62, icon: 'profiler', disc: false, red: false, title: { en: 'read the signature', vi: 'đọc chữ ký endpoint' }, sub: { en: 'what type in, what type out?', vi: 'nhận type gì, trả type gì?' }, note: { en: 'dict in, dict out — no boundary here', vi: 'dict vào, dict ra — không có cửa nào' } },
  { mid: 150, icon: 'curl', disc: true, red: true, title: { en: 'curl some garbage', vi: 'curl thử dữ liệu rác' }, sub: { en: 'wrong type, wrong range, missing', vi: 'sai kiểu, sai khoảng, thiếu field' }, note: { en: 'a 422 with loc and type is a pass', vi: '422 có loc có type nghĩa là đạt' } },
  { mid: 238, icon: 'scissors', disc: false, red: false, title: { en: 'read the response body', vi: 'đọc thân response' }, sub: { en: 'add a secret field to the result', vi: 'thêm một field bí mật vào result' }, note: { en: 'if it comes back out, there is no mask', vi: 'nếu nó ra được, tức là chưa có mask' } },
];
const a1 = arrow(50, 80, 50, 134);
const a2 = arrow(50, 168, 50, 222);
---
<figure class="bep3f">
  <div class="bep3f-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three checks for any endpoint: read its signature for dict in and dict out, curl garbage and expect a 422 with loc and type, add an internal field to the result and confirm it never reaches the response.">
    <g><path d={a1.line} class="ln" /><polygon points={a1.head} class="hd" /></g>
    <g><path d={a2.line} class="ln" /><polygon points={a2.head} class="hd" /></g>
    {rows.map((r, i) => (
      <g>
        <circle cx="50" cy={r.mid} r="14" class={r.red ? 'ncr' : 'nc'} />
        <text x="50" y={r.mid + 5} text-anchor="middle" class={r.red ? 'n r' : 'n'}>{i + 1}</text>
        <rect x="78" y={r.mid - 32} width="280" height="64" rx="8" class={r.red ? 'boxr' : 'box'} />
        {r.disc && <circle cx="107" cy={r.mid} r="18" class="disc" />}
        <image href={`/icons/flow/${r.icon}.svg`} x="92" y={r.mid - 15} width="30" height="30" class="icn" aria-hidden="true" />
        <text x="136" y={r.mid - 4} class="t"><tspan data-lang-en>{r.title.en}</tspan><tspan data-lang-vi>{r.title.vi}</tspan></text>
        <text x="136" y={r.mid + 18} class="m"><tspan data-lang-en>{r.sub.en}</tspan><tspan data-lang-vi>{r.sub.vi}</tspan></text>
        <text x="385" y={r.mid + 5} class="a"><tspan data-lang-en>{r.note.en}</tspan><tspan data-lang-vi>{r.note.vi}</tspan></text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Three minutes per endpoint: a model in, a model out, a garbage curl that dies at the door, and a response that contains only what the contract declared.</span>
    <span data-lang-vi>Ba phút cho mỗi endpoint: một model vào, một model ra, một cú curl rác chết ngay tại cửa, và một response chỉ chứa đúng những gì contract khai báo.</span>
  </figcaption>
</figure>

<style>
  .bep3f { margin: 2em 0; width: 100%; }
  .bep3f-scroll { overflow-x: auto; }
  .bep3f svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep3f text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep3f .t { font-weight: 700; fill: var(--text); }
  .bep3f .m { fill: var(--text-muted); font-size: 12.5px; }
  .bep3f .a { fill: var(--text-body); font-size: 13.5px; }
  .bep3f .n { font-weight: 700; fill: var(--text); }
  .bep3f .r { fill: var(--red); }
  .bep3f .nc { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; }
  .bep3f .ncr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 2; }
  .bep3f .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep3f .boxr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bep3f .disc { fill: none; }
  .bep3f .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep3f .hd { fill: var(--text-muted); }
  .bep3f figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  :global([data-theme='dark']) .bep3f .disc { fill: rgba(255, 255, 255, 0.88); }
</style>
