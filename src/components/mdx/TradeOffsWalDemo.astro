---
import TradeOffsWalDemoComponent from '../demos/TradeOffsWalDemo.tsx';
---
<figure class="tow-figure">
  <TradeOffsWalDemoComponent client:visible />
  <figcaption>
    <span data-lang-en>Retained WAL grows by the gap between the write rate and the apply rate, until the disk is full or a cap cuts the replica off.</span>
    <span data-lang-vi>WAL bị giữ lại tăng đúng bằng chênh lệch giữa tốc độ ghi và tốc độ áp dụng, cho tới khi đĩa đầy hoặc giới hạn cắt replica ra.</span>
  </figcaption>
</figure>

<style is:global>
  .tow-figure {
    margin: 2em 0;
    width: 100%;
  }
  .tow-figure > figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
  .tow {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 18px 0;
  }
  .tow-controls {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 0.95em;
    color: var(--text-body);
  }
  .tow-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
  }
  .tow-row label {
    min-width: 9.5em;
  }
  .tow-row input[type='range'] {
    flex: 1 1 160px;
    accent-color: var(--red);
  }
  .tow-val {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    color: var(--text);
    min-width: 7ch;
  }
  .tow-check {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tow-check input {
    accent-color: var(--red);
  }
  .tow-verdict {
    margin: 16px 0 10px;
    font-weight: 600;
    color: var(--text);
  }
  .tow-verdict.is-bad {
    color: var(--red);
  }
  .tow-chart {
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
    margin: 0 auto;
  }
  .tow-gridline {
    stroke: var(--border);
    stroke-width: 1;
  }
  .tow-tick {
    font-size: 11px;
    fill: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .tow-curve {
    fill: none;
    stroke: var(--text);
    stroke-width: 2;
  }
  .tow-limit {
    stroke: var(--red);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }
  .tow-limit-label {
    font-size: 11px;
    fill: var(--red);
  }
  .tow-axis-note {
    margin: 6px 0 0;
    font-size: 0.82em;
    color: var(--text-muted);
    text-align: center;
  }
</style>
