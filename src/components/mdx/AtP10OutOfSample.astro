---
// Left: variances reported for the Monte Carlo of Lopez de Prado (2016) as summarised on Wikipedia
//   (10 Gaussian assets, 10,000 repetitions): CLA 0.1157, inverse-variance 0.0928, HRP 0.0671.
// Right: our own run (mc.py, numpy): 12 simulated assets in 3 sectors, 2,000 repetitions, weights estimated on
//   T days, risk measured with the TRUE covariance. Daily volatility in %:
//   T=60:  equal 1.186, inverse-variance 1.016, HRP 1.023, min-variance 1.095
//   T=250: equal 1.186, inverse-variance 1.014, HRP 1.019, min-variance 1.009
const W = 900, H = 400;
const left = [
  { k: 'CLA', v: 0.1157 },
  { k: 'Inv-var', v: 0.0928 },
  { k: 'HRP', v: 0.0671, hl: true },
];
const right = [
  { t: 60, vals: [['Equal', 'Đều', 1.186], ['Inv-var', 'Inv-var', 1.016], ['HRP', 'HRP', 1.023], ['Min-var', 'Min-var', 1.095]] },
  { t: 250, vals: [['Equal', 'Đều', 1.186], ['Inv-var', 'Inv-var', 1.014], ['HRP', 'HRP', 1.019], ['Min-var', 'Min-var', 1.009]] },
];
const LB = 330; // baseline y for bars
const lh = (v: number) => (v / 0.12) * 190;
const rh = (v: number) => (v / 1.3) * 190;
const f3 = (v: number, vi: boolean) => (vi ? String(v).replace('.', ',') : String(v));
---
<figure class="p10os">
  <div class="p10os-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two bar charts of out-of-sample risk. Left, the simulation reported for the original HRP paper: variance 0.1157 for CLA, 0.0928 for inverse-variance and 0.0671 for HRP. Right, a run on 12 simulated stocks: with 60 days of history the daily volatility is 1.19 percent for equal weights, 1.02 for inverse-variance, 1.02 for HRP and 1.10 for minimum variance; with 250 days it is 1.19, 1.01, 1.02 and 1.01.">
    <text x="20" y="28" class="p10os-h">
      <tspan data-lang-en>Out of sample: who held risk down?</tspan>
      <tspan data-lang-vi>Ngoài mẫu: ai giữ được rủi ro thấp?</tspan>
    </text>

    <text x="20" y="58" class="p10os-t">
      <tspan data-lang-en>The paper's simulation (variance)</tspan>
      <tspan data-lang-vi>Mô phỏng của bài gốc (phương sai)</tspan>
    </text>
    {left.map((b, i) => (
      <g>
        <rect x={40 + i * 84} y={LB - lh(b.v)} width="64" height={lh(b.v)} rx="3" class={b.hl ? 'p10os-bar is-hl' : 'p10os-bar'} />
        <text x={72 + i * 84} y={LB - lh(b.v) - 8} text-anchor="middle" class="p10os-v">
          <tspan data-lang-en>{f3(b.v, false)}</tspan><tspan data-lang-vi>{f3(b.v, true)}</tspan>
        </text>
        <text x={72 + i * 84} y={LB + 20} text-anchor="middle" class="p10os-l">
          <tspan data-lang-en>{b.k}</tspan><tspan data-lang-vi>{b.kv ?? b.k}</tspan>
        </text>
      </g>
    ))}

    <line x1="320" y1="46" x2="320" y2="372" class="p10os-sep" />

    <text x="340" y="58" class="p10os-t">
      <tspan data-lang-en>Our run: 12 simulated stocks (daily volatility, %)</tspan>
      <tspan data-lang-vi>Lần chạy của mình: 12 cổ phiếu mô phỏng (biến động ngày, %)</tspan>
    </text>
    {right.map((g, gi) => (
      <g>
        {g.vals.map((b, i) => (
          <g>
            <rect x={350 + gi * 270 + i * 62} y={LB - rh(b[2] as number)} width="48" height={rh(b[2] as number)} rx="3" class={b[0] === 'HRP' ? 'p10os-bar is-hl' : 'p10os-bar'} />
            <text x={374 + gi * 270 + i * 62} y={LB - rh(b[2] as number) - 8} text-anchor="middle" class="p10os-v">
              <tspan data-lang-en>{f3(b[2] as number, false)}</tspan><tspan data-lang-vi>{f3(b[2] as number, true)}</tspan>
            </text>
            <text x={374 + gi * 270 + i * 62} y={LB + 18} text-anchor="middle" class="p10os-l s">
              <tspan data-lang-en>{b[0]}</tspan><tspan data-lang-vi>{b[1]}</tspan>
            </text>
          </g>
        ))}
        <text x={350 + gi * 270} y={LB + 42} class="p10os-t">
          <tspan data-lang-en>{g.t} days of history</tspan><tspan data-lang-vi>{g.t} ngày dữ liệu</tspan>
        </text>
      </g>
    ))}
    <text x="20" y="392" class="p10os-s">
      <tspan data-lang-en>Inv-var = inverse-variance; CLA = Markowitz. Left: Wikipedia's summary. Right: 2,000 runs, true covariance.</tspan>
      <tspan data-lang-vi>Inv-var = nghịch đảo phương sai; CLA = Markowitz. Trái: Wikipedia tóm tắt. Phải: 2.000 lần chạy, hiệp phương sai thật.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>In our setup HRP matched inverse-variance rather than beating it. The minimum-variance portfolio was worst at 60 days and caught up at 250.</span>
    <span data-lang-vi>Trong thiết lập của mình, HRP ngang với nghịch đảo phương sai chứ không hơn. Danh mục phương sai tối thiểu tệ nhất ở 60 ngày và bắt kịp ở 250 ngày.</span>
  </figcaption>
</figure>

<style>
  .p10os { margin: 2em 0; width: 100%; }
  .p10os-scroll { overflow-x: auto; }
  .p10os svg { display: block; width: 100%; min-width: 820px; height: auto; font-variant-numeric: tabular-nums; }
  .p10os text { font-size: 14px; fill: var(--text-body); }
  .p10os .p10os-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p10os .p10os-t { font-weight: 700; fill: var(--text); }
  .p10os .p10os-v { font-size: 13px; font-weight: 700; fill: var(--text); }
  .p10os .p10os-l { font-size: 12.5px; }
  .p10os .p10os-l.s { font-size: 11.5px; }
  .p10os .p10os-s { font-size: 12px; fill: var(--text-muted); }
  .p10os-bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .p10os-bar.is-hl { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.7; }
  .p10os-sep { stroke: var(--border); stroke-width: 1.2; }
  .p10os figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
