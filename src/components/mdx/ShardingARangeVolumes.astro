---
// Key-range sharding as encyclopedia volumes: sorted keys inside each shard, so a scan
// touches only the shards whose range it crosses. Keys are illustrative. Inline SVG, site tokens.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const A = (x1: number, y1: number, x2: number, y2: number, c = '') => {
  const a = arrow(x1, y1, x2, y2);
  return { ...a, c };
};

const W = 900;
const H = 340;
const shards = [
  { x: 20, range: 'A–B', keys: ['ant', 'bee', 'bolt'], on: false },
  { x: 245, range: 'C–D', keys: ['cat', 'cow', 'dog'], on: true },
  { x: 470, range: 'E–S', keys: ['eel', 'fox', 'sun'], on: true },
  { x: 695, range: 'T–Z', keys: ['tea', 'wolf', 'zoo'], on: false },
];
const up = [A(385, 244, 340, 204, 'is-fix'), A(515, 244, 560, 204, 'is-fix')];
---
<figure class="shaa-rv">
  <div class="shaa-rv-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Key-range sharding like encyclopedia volumes. Four shards hold sorted key ranges A to B, C to D, E to S and T to Z. A scan from cow to eel crosses only the C to D and E to S shards, so two of the four shards are read.">
      <text x="20" y="28" class="h"><tspan data-lang-en>Each shard holds one slice of sorted keys</tspan><tspan data-lang-vi>Mỗi shard giữ một dải khoá đã sắp xếp</tspan></text>
      {shards.map((s, i) => (
        <g>
          <rect x={s.x} y="46" width="185" height="150" rx="6" class={s.on ? 'box is-fix' : 'box is-dim'} />
          <DiagramIcon name="db" x={s.x + 26} y={72} size={24} />
          <text x={s.x + 52} y="77" class="b">{`Shard ${i}`}</text>
          <text x={s.x + 92} y="118" text-anchor="middle" class="big">{s.range}</text>
          {s.keys.map((k, j) => (
            <text x={s.x + 92} y={142 + j * 16} text-anchor="middle" class="s">{k}</text>
          ))}
        </g>
      ))}
      <text x="450" y="326" text-anchor="middle" class="sub"><tspan data-lang-en>keys stay in order on disk inside each shard</tspan><tspan data-lang-vi>trong mỗi shard, khoá luôn nằm theo thứ tự trên đĩa</tspan></text>

      <rect x="310" y="244" width="280" height="54" rx="6" class="box is-active" />
      <DiagramIcon name="laptop" x={340} y={271} size={26} />
      <text x="368" y="267" class="b"><tspan data-lang-en>Scan from cow to eel</tspan><tspan data-lang-vi>Quét từ cow đến eel</tspan></text>
      <text x="368" y="285" class="s"><tspan data-lang-en>reads 2 of 4 shards, in order</tspan><tspan data-lang-vi>đọc 2 trong 4 shard, theo thứ tự</tspan></text>
      {up.map((a) => (<g><path d={a.line} class="arrow is-fix" /><polygon points={a.head} class="head is-fix" /></g>))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Like volumes of an encyclopedia, a range scan opens only the volumes it crosses. Real boundaries follow the data, not the alphabet. Keys here are illustrative.</span>
    <span data-lang-vi>Giống các tập bách khoa, một lệnh quét khoảng chỉ mở những tập mà nó đi qua. Ranh giới thật bám theo dữ liệu chứ không theo bảng chữ cái. Các khoá ở đây chỉ để minh hoạ.</span>
  </figcaption>
</figure>

<style>
  .shaa-rv { margin: 2em 0; width: 100%; }
  .shaa-rv-scroll { overflow-x: auto; }
  .shaa-rv svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shaa-rv text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shaa-rv .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shaa-rv .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shaa-rv .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shaa-rv .b.is-hot { fill: var(--red); }
  .shaa-rv .s { font-size: 12px; fill: var(--text-body); }
  .shaa-rv .s.is-hot { fill: var(--red); font-weight: 600; }
  .shaa-rv .big { font-size: 18px; font-weight: 700; fill: var(--text); }
  .shaa-rv .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shaa-rv .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shaa-rv .box.is-fix { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-rv .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shaa-rv .box.is-dim { opacity: 0.45; }
  .shaa-rv .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shaa-rv .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shaa-rv .arrow.is-hot { stroke: var(--red); }
  .shaa-rv .arrow.is-fix { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-rv .head { fill: var(--text-muted); }
  .shaa-rv .head.is-hot { fill: var(--red); }
  .shaa-rv .head.is-fix { fill: var(--gold-icon); }
  .shaa-rv figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
