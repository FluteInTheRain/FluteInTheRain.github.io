---
import DiagramIcon from './DiagramIcon.astro';
// The order book of the worked example in HOSE's trading rules (example 3, stock "C"),
// drawn one row per tick. Quantities are shares. The empty rows are real: with the best ask
// at 40,800 and the best bid at 40,650 there are two price steps (40,750 and 40,700) where nobody waits.
const W = 900, H = 350, X0 = 40, BX = 140, SC = 0.3, Y0 = 62, RH = 32;
const rows = [
  { p: '40,900', q: 200, side: 'ask' }, { p: '40,850', q: 500, side: 'ask' }, { p: '40,800', q: 900, side: 'ask' },
  { p: '40,750', q: 0, side: 'gap' }, { p: '40,700', q: 0, side: 'gap' },
  { p: '40,650', q: 100, side: 'bid' }, { p: '40,600', q: 300, side: 'bid' }, { p: '40,550', q: 500, side: 'bid' },
];
const cy = (i: number) => Y0 + i * RH + 13;
---
<figure class="f">
  <div class="f-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="An order book drawn one row per price step. Sell orders (asks) sit above: 200 shares at 40,900, 500 at 40,850 and 900 at 40,800. Buy orders (bids) sit below: 100 shares at 40,650, 300 at 40,600 and 500 at 40,550. The two rows at 40,750 and 40,700 are empty. The best ask is 40,800, the best bid is 40,650, the spread is 150 dong, which is 3 price steps, and the mid-price is 40,725.">
    <DiagramIcon name="ladder" x={24} y={20} size={22} />
    <text x="46" y="26" class="f-h">
      <tspan data-lang-en>One stock's order book, one row per price step</tspan>
      <tspan data-lang-vi>Sổ lệnh của một cổ phiếu, mỗi hàng là một bước giá</tspan>
    </text>
    <text x={X0} y="52" class="f-sub"><tspan data-lang-en>price (VND)</tspan><tspan data-lang-vi>giá (đồng)</tspan></text>
    <text x={BX} y="52" class="f-sub"><tspan data-lang-en>shares waiting</tspan><tspan data-lang-vi>cổ phiếu đang chờ</tspan></text>
    {rows.map((r, i) => (
      <g>
        <text x={X0} y={cy(i) + 5} class="f-price"><tspan data-lang-en>{r.p}</tspan><tspan data-lang-vi>{r.p.replace(',', '.')}</tspan></text>
        {r.side === 'gap'
          ? <rect x={BX} y={Y0 + i * RH} width="270" height="26" rx="4" class="f-empty" />
          : <rect x={BX} y={Y0 + i * RH} width={r.q * SC} height="26" rx="4" class={r.side === 'ask' ? 'f-ask' : 'f-bid'} />}
        {r.side === 'gap'
          ? <text x={BX + 10} y={cy(i) + 4} class="f-faint"><tspan data-lang-en>nobody waits here</tspan><tspan data-lang-vi>chưa ai chờ ở giá này</tspan></text>
          : <text x={BX + r.q * SC + 8} y={cy(i) + 5} class="f-qty">{r.q}</text>}
      </g>
    ))}
    {/* mid line between rows 3 and 4 */}
    <line x1={X0} x2="430" y1={Y0 + 4 * RH - 3} y2={Y0 + 4 * RH - 3} class="f-mid" />
    {/* annotations */}
    <line x1="470" x2="500" y1={cy(2)} y2={cy(2)} class="f-lead" />
    <line x1="470" x2="500" y1={cy(5)} y2={cy(5)} class="f-lead" />
    <line x1="500" x2="500" y1={cy(2)} y2={cy(5)} class="f-lead" />
    <text x="516" y={cy(2) + 5} class="f-ann is-ask"><tspan data-lang-en>best ask 40,800: the cheapest seller</tspan><tspan data-lang-vi>giá bán tốt nhất 40.800: người bán rẻ nhất</tspan></text>
    <text x="516" y={cy(5) + 5} class="f-ann is-bid"><tspan data-lang-en>best bid 40,650: the highest buyer</tspan><tspan data-lang-vi>giá mua tốt nhất 40.650: người mua cao nhất</tspan></text>
    <text x="516" y={cy(3) + 2} class="f-ann"><tspan data-lang-en>spread = 150 VND = 3 steps</tspan><tspan data-lang-vi>spread = 150 đồng = 3 bước giá</tspan></text>
    <text x="516" y={cy(4) + 2} class="f-ann"><tspan data-lang-en>mid-price = 40,725 (halfway)</tspan><tspan data-lang-vi>giá giữa = 40.725 (chính giữa)</tspan></text>
    <text x={X0} y="334" class="f-sub"><tspan data-lang-en>One price step is 50 VND in this price range, so each row is one step.</tspan><tspan data-lang-vi>Ở vùng giá này một bước giá là 50 đồng, nên mỗi hàng là một bước.</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The book from the worked example in HOSE's own trading rules. Sellers queue above, buyers below, and the gap between the two best prices is the spread.</span>
    <span data-lang-vi>Sổ lệnh trong ví dụ có sẵn ngay trong quy định giao dịch của HOSE. Người bán xếp hàng phía trên, người mua phía dưới, và khoảng trống giữa hai giá tốt nhất là spread.</span>
  </figcaption>
</figure>

<style>
  .f { margin: 2em 0; width: 100%; }
  .f-scroll { overflow-x: auto; }
  .f svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .f text { font-size: 14px; fill: var(--text-body); }
  .f .f-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .f .f-sub { font-size: 12.5px; fill: var(--text-muted); }
  .f .f-price { font-size: 14px; font-weight: 600; fill: var(--text); }
  .f .f-qty { font-size: 13px; font-weight: 600; fill: var(--text); }
  .f .f-faint { font-size: 12px; fill: var(--text-muted); font-style: italic; }
  .f .f-ann { font-size: 13.5px; font-weight: 600; fill: var(--text); }
  .f .f-ann.is-ask { fill: var(--red); }
  .f .f-ann.is-bid { fill: var(--act-2); }
  .f-ask { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; }
  .f-bid { fill: color-mix(in srgb, var(--act-2) 16%, var(--bg)); stroke: var(--act-2); stroke-width: 1.3; }
  .f-empty { fill: none; stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .f-mid { stroke: var(--gold); stroke-width: 1.8; stroke-dasharray: 6 4; }
  .f-lead { stroke: var(--text-muted); stroke-width: 1.2; fill: none; }
  .f figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
