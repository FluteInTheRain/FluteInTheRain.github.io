---
// Three ways a request finds the shard that owns a key. Inline SVG, site CSS tokens only.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900;
const H = 400;
const cols = [20, 320, 620];
const cx = (i: number) => cols[i] + 130;
// col 1: client -> any node -> owner ; col 2: client -> proxy -> owner ; col 3: client -> owner
const c1a = arrow(cx(0), 112, cx(0), 150);
const c1b = arrow(cx(0), 194, cx(0) + 60, 272);
const c2a = arrow(cx(1), 112, cx(1), 150);
const c2b = arrow(cx(1), 194, cx(1) + 60, 272);
const c3 = arrow(cx(2) + 60, 112, cx(2) + 60, 272);
---
<figure class="shrt">
  <div class="shrt-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three ways to route a request for user_42 to the node that owns its shard. Any node forwards: the client calls any node, which forwards the request, costing an extra hop on a miss. Routing tier: the client calls a proxy that knows the shard map and sends the request on, always one proxy hop. Smart client: the client caches the shard map and connects directly to the owner, with no extra hop.">
      {cols.map((x, i) => (
        <g>
          <rect x={x} y="12" width="260" height="378" rx="8" class="rule" />
        </g>
      ))}

      <text x={cx(0)} y="38" text-anchor="middle" class="h"><tspan data-lang-en>Any node forwards</tspan><tspan data-lang-vi>Hỏi node bất kỳ</tspan></text>
      <text x={cx(1)} y="38" text-anchor="middle" class="h"><tspan data-lang-en>Routing tier</tspan><tspan data-lang-vi>Tầng định tuyến</tspan></text>
      <text x={cx(2)} y="38" text-anchor="middle" class="h"><tspan data-lang-en>Smart client</tspan><tspan data-lang-vi>Smart client</tspan></text>
      <text x={cx(0)} y="57" text-anchor="middle" class="sub"><tspan data-lang-en>for example Cassandra</tspan><tspan data-lang-vi>ví dụ Cassandra</tspan></text>
      <text x={cx(1)} y="57" text-anchor="middle" class="sub"><tspan data-lang-en>mongos, Vitess VTGate</tspan><tspan data-lang-vi>mongos, VTGate của Vitess</tspan></text>
      <text x={cx(2)} y="57" text-anchor="middle" class="sub"><tspan data-lang-en>partition-aware driver</tspan><tspan data-lang-vi>driver biết chia shard</tspan></text>

      {cols.map((x, i) => (
        <g>
          <rect x={x + 60} y="72" width="140" height="40" rx="6" class="box" />
          <text x={cx(i)} y="89" text-anchor="middle" class="b"><tspan data-lang-en>Client</tspan><tspan data-lang-vi>Client</tspan></text>
          <text x={cx(i)} y="105" text-anchor="middle" class="s">{i === 2 ? <><tspan data-lang-en>keeps a shard map</tspan><tspan data-lang-vi>giữ bản đồ shard</tspan></> : <><tspan data-lang-en>get user_42</tspan><tspan data-lang-vi>đọc user_42</tspan></>}</text>
        </g>
      ))}

      <rect x={cols[0] + 60} y="150" width="140" height="44" rx="6" class="box" />
      <text x={cx(0)} y="169" text-anchor="middle" class="b"><tspan data-lang-en>Any node</tspan><tspan data-lang-vi>Node bất kỳ</tspan></text>
      <text x={cx(0)} y="185" text-anchor="middle" class="s"><tspan data-lang-en>may not own it</tspan><tspan data-lang-vi>có thể không giữ shard</tspan></text>
      <rect x={cols[1] + 60} y="150" width="140" height="44" rx="6" class="box is-active" />
      <text x={cx(1)} y="169" text-anchor="middle" class="b"><tspan data-lang-en>Proxy</tspan><tspan data-lang-vi>Proxy</tspan></text>
      <text x={cx(1)} y="185" text-anchor="middle" class="s"><tspan data-lang-en>holds the shard map</tspan><tspan data-lang-vi>nắm bản đồ shard</tspan></text>

      <path d={c1a.line} class="arrow is-strong" /><polygon points={c1a.head} class="head is-strong" />
      <path d={c1b.line} class="arrow is-hot" /><polygon points={c1b.head} class="head is-hot" />
      <text x={cx(0) + 8} y="238" text-anchor="end" class="s is-hot"><tspan data-lang-en>forward</tspan><tspan data-lang-vi>chuyển tiếp</tspan></text>
      <path d={c2a.line} class="arrow is-strong" /><polygon points={c2a.head} class="head is-strong" />
      <path d={c2b.line} class="arrow is-strong" /><polygon points={c2b.head} class="head is-strong" />
      <text x={cx(1) + 8} y="238" text-anchor="end" class="s"><tspan data-lang-en>route</tspan><tspan data-lang-vi>điều hướng</tspan></text>
      <path d={c3.line} class="arrow is-strong" /><polygon points={c3.head} class="head is-strong" />
      <text x={cx(2) + 70} y="195" class="s"><tspan data-lang-en>direct</tspan><tspan data-lang-vi>nối thẳng</tspan></text>

      {cols.map((x, i) => (
        <g>
          <rect x={x + 10} y="274" width="115" height="50" rx="6" class="box is-dim" />
          <text x={x + 67} y="296" text-anchor="middle" class="s"><tspan data-lang-en>Other shard</tspan><tspan data-lang-vi>Shard khác</tspan></text>
          <rect x={x + 135} y="274" width="115" height="50" rx="6" class="box is-active" />
          <text x={x + 192} y="294" text-anchor="middle" class="b"><tspan data-lang-en>Owner</tspan><tspan data-lang-vi>Chủ shard</tspan></text>
          <text x={x + 192} y="311" text-anchor="middle" class="s">user_42</text>
        </g>
      ))}

      <text x={cx(0)} y="360" text-anchor="middle" class="note is-hot"><tspan data-lang-en>Extra hop when the guess is wrong</tspan><tspan data-lang-vi>Thêm một hop khi đoán sai node</tspan></text>
      <text x={cx(1)} y="360" text-anchor="middle" class="note"><tspan data-lang-en>One proxy hop, always</tspan><tspan data-lang-vi>Luôn thêm một hop qua proxy</tspan></text>
      <text x={cx(2)} y="360" text-anchor="middle" class="note"><tspan data-lang-en>No extra hop</tspan><tspan data-lang-vi>Không tốn thêm hop</tspan></text>
      <text x={cx(0)} y="379" text-anchor="middle" class="sub"><tspan data-lang-en>simplest client</tspan><tspan data-lang-vi>client đơn giản nhất</tspan></text>
      <text x={cx(1)} y="379" text-anchor="middle" class="sub"><tspan data-lang-en>app code stays clean</tspan><tspan data-lang-vi>code app gọn</tspan></text>
      <text x={cx(2)} y="379" text-anchor="middle" class="sub"><tspan data-lang-en>drivers must stay current</tspan><tspan data-lang-vi>phải cập nhật driver</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Three ways to reach the shard that owns a key. They differ in where the shard map lives: nowhere (ask and forward), in a proxy, or in the client.</span>
    <span data-lang-vi>Ba cách tìm đúng shard giữ một khoá. Chúng khác nhau ở chỗ đặt bản đồ shard: không ở đâu cả (hỏi rồi chuyển tiếp), trong proxy, hoặc trong client.</span>
  </figcaption>
</figure>

<style>
  .shrt { margin: 2em 0; width: 100%; }
  .shrt-scroll { overflow-x: auto; }
  .shrt svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shrt text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shrt .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shrt .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shrt .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shrt .b.is-hot { fill: var(--red); }
  .shrt .s { font-size: 12px; fill: var(--text-body); }
  .shrt .s.is-hot { fill: var(--red); font-weight: 600; }
  .shrt .note { font-size: 13px; font-weight: 600; fill: var(--text); }
  .shrt .note.is-hot { fill: var(--red); }
  .shrt .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shrt .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shrt .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shrt .box.is-dim { opacity: 0.5; }
  .shrt .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shrt .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shrt .arrow.is-hot { stroke: var(--red); }
  .shrt .arrow.is-strong { stroke: var(--text); stroke-width: 1.7; }
  .shrt .head { fill: var(--text-muted); }
  .shrt .head.is-hot { fill: var(--red); }
  .shrt .head.is-strong { fill: var(--text); }
  .shrt figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
