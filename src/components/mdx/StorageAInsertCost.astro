---
// Shopify's key order, step by step: a time-ordered key reuses one page that is already in
// memory; a random key needs a page that is probably on disk. Plain inline SVG, site tokens,
// polygon arrowheads, no ids.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 372;
const EN = { 'data-lang-en': '' };
const VI = { 'data-lang-vi': '' };
const bw = 256;
const bg = 48;
const bx = (i: number) => 20 + i * (bw + bg);
function arrowRight(x1: number, x2: number, y: number, cls: string) {
  return { line: `M${x1},${y} L${x2 - 7},${y}`, head: `${x2 - 8},${y - 5} ${x2 - 8},${y + 5} ${x2},${y}`, cls };
}
type Step = { icon: 'laptop' | 'file' | 'ok' | 'disk' | 'retry'; en: string[]; vi: string[] };
const rows: { y: number; headEn: string; headVi: string; tone: 'good' | 'bad'; steps: Step[] }[] = [
  {
    y: 70, tone: 'good',
    headEn: 'Time-ordered key (ULID): the same page every time',
    headVi: 'Khoá theo thời gian (ULID): lần nào cũng cùng một trang',
    steps: [
      { icon: 'laptop', en: ['New key is the largest', 'so far'], vi: ['Khoá mới là lớn nhất', 'từ trước tới giờ'] },
      { icon: 'file', en: ['It goes into the rightmost', 'leaf page, every time'], vi: ['Nó vào trang lá ngoài cùng', 'bên phải, lần nào cũng vậy'] },
      { icon: 'ok', en: ['That page is already in', 'memory: no disk read'], vi: ['Trang đó nằm sẵn trong RAM,', 'không phải đọc đĩa'] },
    ],
  },
  {
    y: 218, tone: 'bad',
    headEn: 'Random key (UUIDv4): a different page almost every time',
    headVi: 'Khoá ngẫu nhiên (UUIDv4): gần như lần nào cũng khác trang',
    steps: [
      { icon: 'laptop', en: ['New key can land in', 'any leaf page'], vi: ['Khoá mới có thể rơi vào', 'bất kỳ trang lá nào'] },
      { icon: 'disk', en: ['Table is bigger than the', 'cache: the page is on disk'], vi: ['Bảng lớn hơn cache: trang', 'đó đang nằm trên đĩa'] },
      { icon: 'retry', en: ['Fetch the page, change it,', 'write it back'], vi: ['Lấy trang lên, sửa rồi', 'ghi trả xuống'] },
    ],
  },
];
---
<figure class="ins">
  <div class="ins-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Where a new key lands in a B-tree. Time-ordered key, such as a ULID: the key is the largest so far, goes into the rightmost leaf page every time, and that page is already in memory so there is no disk read. Random key, such as a UUIDv4: the key can land in any leaf page, the table is bigger than the cache so that page is on disk, and the engine fetches it, changes it and writes it back.">
    {rows.map((r) => (
      <g>
        <text x="20" y={r.y} class="ins-in-b">
          <tspan data-lang-en>{r.headEn}</tspan>
          <tspan data-lang-vi>{r.headVi}</tspan>
        </text>
        {r.steps.map((s, i) => (
          <g>
            <rect x={bx(i)} y={r.y + 18} width={bw} height="76" rx="4" class={r.tone === 'good' || i === 0 ? (r.tone === 'good' ? 'ins-box is-good' : 'ins-box') : 'ins-box is-bad'} />
            <circle cx={bx(i) + 18} cy={r.y + 36} r="9" class="ins-circle" />
            <text x={bx(i) + 18} y={r.y + 40} text-anchor="middle" class="ins-num">{i + 1}</text>
            <DiagramIcon name={s.icon} x={bx(i) + 48} y={r.y + 62} size={28} />
            <g {...EN}>{s.en.map((t, k) => <text x={bx(i) + 72} y={r.y + 56 + k * 18} class="ins-in-m">{t}</text>)}</g>
            <g {...VI}>{s.vi.map((t, k) => <text x={bx(i) + 72} y={r.y + 56 + k * 18} class="ins-in-m">{t}</text>)}</g>
          </g>
        ))}
        {[0, 1].map((i) => {
          const a = arrowRight(bx(i) + bw + 4, bx(i + 1) - 4, r.y + 56, r.tone);
          return <g><path d={a.line} class="ins-arrow" /><polygon points={a.head} class="ins-head" /></g>;
        })}
      </g>
    ))}
    <text x="20" y="344" class="ins-note">
      <tspan data-lang-en>Once the table is bigger than the cache, the bottom row repeats for almost every insert.</tspan>
      <tspan data-lang-vi>Khi bảng lớn hơn cache, hàng dưới lặp lại ở gần như mọi lần insert.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Why key order changes insert speed: it decides whether the page you need is already in memory. This is the mechanism behind Shopify's 50 percent drop in INSERT duration.</span>
    <span data-lang-vi>Vì sao thứ tự khoá đổi tốc độ insert: nó quyết định trang cần dùng đã nằm sẵn trong RAM hay chưa. Đây là cơ chế đằng sau mức giảm 50% thời gian INSERT của Shopify.</span>
  </figcaption>
</figure>

<style>
  .ins { margin: 2em 0; width: 100%; }
  .ins-scroll { overflow-x: auto; }
  .ins svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .ins text { font-size: 14px; fill: var(--text-body); }
  .ins .ins-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ins .ins-sub { fill: var(--text-muted); }
  .ins-rule { stroke: var(--border); }
  .ins-divider { stroke: var(--border); stroke-dasharray: 6 5; }
  .ins-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .ins-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .ins-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .ins-cell { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .ins-cell.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .ins-cell.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .ins-cell.is-dead { fill: var(--bg-alt); stroke: var(--text-muted); stroke-dasharray: 3 3; }
  .ins .ins-in { font-weight: 600; fill: var(--text); }
  .ins .ins-in-b { font-weight: 700; fill: var(--text); }
  .ins .ins-in-m { font-size: 13px; fill: var(--text-body); }
  .ins .ins-in-s { font-size: 13px; font-weight: 600; fill: var(--text); }
  .ins .ins-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; fill: var(--text-body); }
  .ins .ins-mono.is-good { fill: var(--gold-icon); font-weight: 700; }
  .ins .ins-mono.is-bad { fill: var(--red); font-weight: 700; }
  .ins .ins-note { font-size: 13px; fill: var(--text-muted); }
  .ins .ins-note.is-good { fill: var(--gold-icon); font-weight: 700; }
  .ins .ins-note.is-bad { fill: var(--red); font-weight: 700; }
  .ins .ins-small { font-size: 12px; fill: var(--text-muted); }
  .ins .ins-num { font-size: 12px; font-weight: 700; fill: var(--text); }
  .ins-circle { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .ins-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .ins-arrow.is-good { stroke: var(--gold-icon); stroke-width: 1.8; }
  .ins-arrow.is-bad { stroke: var(--red); stroke-width: 1.8; }
  .ins-head { fill: var(--text-muted); }
  .ins-head.is-good { fill: var(--gold-icon); }
  .ins-head.is-bad { fill: var(--red); }
  .ins figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
