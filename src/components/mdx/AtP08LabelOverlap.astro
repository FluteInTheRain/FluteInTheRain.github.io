---
// Overlapping labels. Each row is one month-end observation of one stock; its
// label is the return of the next 3 months. Neighbouring rows therefore share
// two of their three label months (shaded).
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 350;
const X0 = 170;
const CW = 80;          // month column width
const months = ['M1', 'M2', 'M3', 'M4', 'M5', 'M6', 'M7', 'M8'];
const rows = [0, 1, 2, 3, 4]; // feature month index; label = t+1 .. t+3
const RY = 96;
const RH = 36;
---
<figure class="atp08-lo">
  <div class="atp08-lo-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Five rows, one per month-end observation of the same stock. Each row's features are known at its month end and its label is the return over the next three months, drawn as a three-month bar. Consecutive bars overlap by two months, so five rows contain only about seven distinct months of return.">
      <DiagramIcon name="calendar" x={22} y={22} size={22} />
      <text x="44" y="28" class="h">
        <tspan data-lang-en>A 3-month label makes neighbouring rows near-copies</tspan>
        <tspan data-lang-vi>Nhãn 3 tháng khiến các dòng liền kề gần như bản sao của nhau</tspan>
      </text>
      {months.map((m, i) => (
        <g>
          <line x1={X0 + i * CW} y1={RY - 24} x2={X0 + i * CW} y2={RY + rows.length * RH + 6} class="grid" />
          <text x={X0 + i * CW + CW / 2} y={RY - 30} text-anchor="middle" class="tick">{m}</text>
        </g>
      ))}
      <line x1={X0 + months.length * CW} y1={RY - 24} x2={X0 + months.length * CW} y2={RY + rows.length * RH + 6} class="grid" />
      {rows.map((t) => {
        const y = RY + t * RH;
        return (
          <g>
            <text x={X0 - 12} y={y + 22} text-anchor="end" class="lab">
              <tspan data-lang-en>{`Row ${t + 1}: features at ${months[t]}`}</tspan>
              <tspan data-lang-vi>{`Dòng ${t + 1}: feature tại ${months[t]}`}</tspan>
            </text>
            <circle cx={X0 + t * CW + CW / 2} cy={y + 18} r="5" class="pt" />
            <rect x={X0 + (t + 1) * CW + 3} y={y + 7} width={3 * CW - 6} height="22" rx="4" class="lbl" />
          </g>
        );
      })}
      {/* overlap of row 1 and row 2: months M3 and M4 */}
      <rect x={X0 + 2 * CW + 3} y={RY + 4} width={2 * CW - 6} height={RH + 28} rx="5" class="ovl" />
      <text x={X0 + 3 * CW} y={RY + rows.length * RH + 26} text-anchor="middle" class="note">
        <tspan data-lang-en>Rows 1 and 2 share M3 and M4: two of three label months</tspan>
        <tspan data-lang-vi>Dòng 1 và 2 dùng chung M3 và M4: hai trong ba tháng của nhãn</tspan>
      </text>
      <circle cx="20" cy="324" r="5" class="pt" />
      <text x="32" y="328" class="note">
        <tspan data-lang-en>features known at that month end</tspan>
        <tspan data-lang-vi>feature biết được tại cuối tháng đó</tspan>
      </text>
      <rect x="320" y="316" width="30" height="14" rx="3" class="lbl" />
      <text x="358" y="328" class="note">
        <tspan data-lang-en>label: the next 3 months of return</tspan>
        <tspan data-lang-vi>nhãn: lợi suất 3 tháng kế tiếp</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Five rows, but the labels cover only M2 to M8, seven distinct months. Cut a train/test line through this picture without a gap and the same month of return sits on both sides.</span>
    <span data-lang-vi>Năm dòng, nhưng nhãn chỉ phủ M2 tới M8, tức bảy tháng khác nhau. Kẻ đường chia train/test xuyên qua hình này mà không chừa khoảng trống thì cùng một tháng lợi suất nằm ở cả hai phía.</span>
  </figcaption>
</figure>

<style>
  .atp08-lo { margin: 2em 0; width: 100%; }
  .atp08-lo-scroll { overflow-x: auto; }
  .atp08-lo svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp08-lo text { font-size: 14px; fill: var(--text-body); }
  .atp08-lo .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp08-lo .tick { font-size: 13px; font-weight: 600; fill: var(--text-muted); }
  .atp08-lo .lab { font-size: 13px; fill: var(--text); }
  .atp08-lo .note { font-size: 12.5px; fill: var(--text-muted); }
  .atp08-lo .grid { stroke: var(--border); stroke-width: 1; }
  .atp08-lo .pt { fill: var(--text); }
  .atp08-lo .lbl { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .atp08-lo .ovl { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; stroke-dasharray: 4 3; opacity: 0.8; }
  .atp08-lo figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
