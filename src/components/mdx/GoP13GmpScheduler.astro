---
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 446;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const aGlobalToP0 = arrow(356, 96, 356, 144);
const aSteal = arrow(420, 174, 480, 174);
const aQueueToP0 = arrow(120, 200, 120, 232);
const aQueueToP1 = arrow(660, 200, 660, 232);
const aHandoff = arrow(230, 278, 268, 278);
---
<figure class="g13gmp">
  <div class="g13gmp-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Go GMP scheduler: global run queue, netpoller, local [256]G queues for P0 and P1, work stealing between P0 and P1, and syscall handoff from blocked M0 to M2.">
      {/* Top Row: Global Queue + Netpoller */}
      <text x="20" y="24" class="g13gmp-h">
        <tspan data-lang-en>Global run queue (checked every 61 scheduler ticks)</tspan>
        <tspan data-lang-vi>Hàng đợi toàn cục (kiểm tra mỗi 61 nhịp lịch)</tspan>
      </text>
      <rect x="20" y="36" width="520" height="58" rx="8" class="g13gmp-box" />
      <rect x="38" y="49" width="70" height="32" rx="6" class="g13gmp-g" />
      <text x="73" y="70" text-anchor="middle" class="g13gmp-gt">G7</text>
      <rect x="122" y="49" width="70" height="32" rx="6" class="g13gmp-g" />
      <text x="157" y="70" text-anchor="middle" class="g13gmp-gt">G8</text>
      <rect x="206" y="49" width="70" height="32" rx="6" class="g13gmp-g" />
      <text x="241" y="70" text-anchor="middle" class="g13gmp-gt">G9</text>
      <DiagramIcon name="gopher" x={508} y={65} size={26} />
      <text x="296" y="70" class="g13gmp-sub">
        <tspan data-lang-en>waiting runnable goroutines</tspan>
        <tspan data-lang-vi>goroutine đang chờ lượt chạy</tspan>
      </text>

      <text x="580" y="24" class="g13gmp-h">
        <tspan data-lang-en>OS netpoller (epoll / kqueue)</tspan>
        <tspan data-lang-vi>OS netpoller (epoll / kqueue)</tspan>
      </text>
      <rect x="580" y="36" width="300" height="58" rx="8" class="g13gmp-box" />
      <DiagramIcon name="network" x={604} y={65} size={24} />
      <rect x="628" y="49" width="56" height="32" rx="6" class="g13gmp-g" />
      <text x="656" y="70" text-anchor="middle" class="g13gmp-gt">G10</text>
      <rect x="694" y="49" width="56" height="32" rx="6" class="g13gmp-g" />
      <text x="722" y="70" text-anchor="middle" class="g13gmp-gt">G11</text>
      <text x="762" y="70" class="g13gmp-sub">
        <tspan data-lang-en>0 OS threads</tspan>
        <tspan data-lang-vi>0 OS thread</tspan>
      </text>

      <g class="g13gmp-arrow"><path d={aGlobalToP0.line} /><polygon points={aGlobalToP0.head} /></g>

      {/* Local Queues Row */}
      <text x="20" y="136" class="g13gmp-h">
        <tspan data-lang-en>P0 local queue ([256]G)</tspan>
        <tspan data-lang-vi>Hàng đợi cục bộ P0 ([256]G)</tspan>
      </text>
      <rect x="20" y="148" width="396" height="52" rx="8" class="g13gmp-box" />
      <rect x="38" y="158" width="64" height="32" rx="6" class="g13gmp-g" />
      <text x="70" y="179" text-anchor="middle" class="g13gmp-gt">G1</text>
      <rect x="114" y="158" width="64" height="32" rx="6" class="g13gmp-g" />
      <text x="146" y="179" text-anchor="middle" class="g13gmp-gt">G2</text>
      <rect x="190" y="158" width="64" height="32" rx="6" class="g13gmp-g" />
      <text x="222" y="179" text-anchor="middle" class="g13gmp-gt">G3</text>
      <text x="268" y="179" class="g13gmp-sub">
        <tspan data-lang-en>steals half when idle</tspan>
        <tspan data-lang-vi>lấy một nửa khi rảnh</tspan>
      </text>

      <text x="484" y="136" class="g13gmp-h">
        <tspan data-lang-en>P1 local queue (was empty)</tspan>
        <tspan data-lang-vi>Hàng đợi cục bộ P1 (vừa cạn)</tspan>
      </text>
      <rect x="484" y="148" width="396" height="52" rx="8" class="g13gmp-box" />
      <rect x="502" y="158" width="68" height="32" rx="6" class="g13gmp-g is-gold" />
      <text x="536" y="179" text-anchor="middle" class="g13gmp-gt">G2</text>
      <rect x="582" y="158" width="68" height="32" rx="6" class="g13gmp-g is-gold" />
      <text x="616" y="179" text-anchor="middle" class="g13gmp-gt">G3</text>
      <text x="666" y="179" class="g13gmp-gold">
        <tspan data-lang-en>work stealing from P0</tspan>
        <tspan data-lang-vi>trộm việc từ P0</tspan>
      </text>

      <g class="g13gmp-arrow is-gold"><path class="fm-flow" d={aSteal.line} /><polygon points={aSteal.head} /></g>
      <g class="g13gmp-arrow"><path d={aQueueToP0.line} /><polygon points={aQueueToP0.head} /></g>
      <g class="g13gmp-arrow"><path d={aQueueToP1.line} /><polygon points={aQueueToP1.head} /></g>

      {/* Execution & Handoff Row */}
      {/* Blocked M0 */}
      <rect x="20" y="236" width="206" height="92" rx="8" class="g13gmp-box is-red" />
      <DiagramIcon name="disk" x={44} y={258} size={24} />
      <text x="66" y="263" class="g13gmp-b is-red">M0 (OS thread)</text>
      <text x="34" y="292" class="g13gmp-sub">
        <tspan data-lang-en>G4 blocked on disk syscall</tspan>
        <tspan data-lang-vi>G4 kẹt syscall đọc đĩa</tspan>
      </text>
      <text x="34" y="313" class="g13gmp-red">
        <tspan data-lang-en>P0 detaches (handoff)</tspan>
        <tspan data-lang-vi>P0 tách sang thread khác</tspan>
      </text>

      <g class="g13gmp-arrow is-gold"><path class="fm-flow" d={aHandoff.line} /><polygon points={aHandoff.head} /></g>

      {/* P0 + M2 */}
      <rect x="272" y="236" width="182" height="92" rx="8" class="g13gmp-box is-gold" />
      <DiagramIcon name="cpu" x={296} y={258} size={24} />
      <text x="318" y="263" class="g13gmp-b">P0 + M2</text>
      <text x="286" y="292" class="g13gmp-sub">
        <tspan data-lang-en>Running G1 on core 0</tspan>
        <tspan data-lang-vi>Chạy G1 trên nhân 0</tspan>
      </text>
      <text x="286" y="313" class="g13gmp-gold">
        <tspan data-lang-en>CPU stays busy</tspan>
        <tspan data-lang-vi>CPU không ngồi chơi</tspan>
      </text>

      {/* P1 + M1 */}
      <rect x="484" y="236" width="396" height="92" rx="8" class="g13gmp-box" />
      <DiagramIcon name="cpu" x={508} y={258} size={24} />
      <text x="530" y="263" class="g13gmp-b">P1 + M1 (GOMAXPROCS worker)</text>
      <text x="500" y="292" class="g13gmp-sub">
        <tspan data-lang-en>Executing stolen G2; preempts after ~10 ms</tspan>
        <tspan data-lang-vi>Đang chạy G2 vừa kéo sang; cắt nhịp sau ~10 ms</tspan>
      </text>
      <text x="500" y="313" class="g13gmp-sub">
        <tspan data-lang-en>P count matches GOMAXPROCS (default: CPU cores)</tspan>
        <tspan data-lang-vi>Số lượng P bằng GOMAXPROCS (mặc định: số nhân CPU)</tspan>
      </text>

      {/* Bottom Comparison */}
      <rect x="20" y="360" width="415" height="68" rx="8" class="g13gmp-note" />
      <DiagramIcon name="fast" x={408} y={382} size={26} />
      <text x="36" y="386" class="g13gmp-b">
        <tspan data-lang-en>Goroutine switch (G on M, user space)</tspan>
        <tspan data-lang-vi>Chuyển goroutine (G trên M, user space)</tspan>
      </text>
      <text x="36" y="408" class="g13gmp-sub">
        <tspan data-lang-en>~200 ns, ~2 KiB starting stack, 80–90% faster than OS threads</tspan>
        <tspan data-lang-vi>~200 ns, stack đầu ~2 KiB, nhanh hơn 80–90% so với OS thread</tspan>
      </text>

      <rect x="465" y="360" width="415" height="68" rx="8" class="g13gmp-note" />
      <DiagramIcon name="slow" x={853} y={382} size={26} />
      <text x="481" y="386" class="g13gmp-b">
        <tspan data-lang-en>OS thread switch (M on CPU core, kernel)</tspan>
        <tspan data-lang-vi>Chuyển OS thread (M trên nhân CPU, kernel)</tspan>
      </text>
      <text x="481" y="408" class="g13gmp-sub">
        <tspan data-lang-en>Saves full CPU registers, ~1–8 MiB kernel stack per thread</tspan>
        <tspan data-lang-vi>Phải lưu toàn bộ thanh ghi CPU, tốn ~1–8 MiB stack mỗi thread</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Go maps many goroutines (G) onto GOMAXPROCS logical processors (P) backed by OS threads (M). Network waits park in the OS netpoller without holding a thread, while blocking syscalls detach P to another M so CPU cores keep running.</span>
    <span data-lang-vi>Go ghép nhiều goroutine (G) lên GOMAXPROCS bộ xử lý logic (P) gắn với OS thread (M). Chờ mạng nằm ở OS netpoller không giữ thread, còn syscall chặn ổ đĩa thì tách P sang M khác để nhân CPU chạy tiếp.</span>
  </figcaption>
</figure>

<style>
  .g13gmp { margin: 2em 0; width: 100%; }
  .g13gmp-scroll { overflow-x: auto; }
  .g13gmp svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .g13gmp text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .g13gmp-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .g13gmp-b { font-size: 14px; font-weight: 700; fill: var(--text); }
  .g13gmp-b.is-red { fill: var(--red); }
  .g13gmp-sub { font-size: 13px; fill: var(--text-muted); }
  .g13gmp-gold { font-size: 13px; font-weight: 600; fill: var(--gold-icon); }
  .g13gmp-red { font-size: 13px; font-weight: 600; fill: var(--red); }
  .g13gmp-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .g13gmp-box.is-red { fill: var(--red-tint-bg); stroke: var(--red); }
  .g13gmp-box.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .g13gmp-note { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .g13gmp-g { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.3; }
  .g13gmp-g.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .g13gmp-gt { font-weight: 700; fill: var(--text); }
  .g13gmp-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.6; }
  .g13gmp-arrow polygon { fill: var(--text-muted); }
  .g13gmp-arrow.is-gold path { stroke: var(--gold-icon); }
  .g13gmp-arrow.is-gold polygon { fill: var(--gold-icon); }
  .g13gmp figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
