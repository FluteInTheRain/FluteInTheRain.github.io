---
// Early stopping, drawn from the same Python run as the demo: 60 training rows, 60 validation rows,
// 8 hidden units (65 weights), Adam, 3,000 epochs. Validation error is lowest at epoch 37 (0.357);
// the error on 1,000 unseen rows is 0.383 there and 1.044 at epoch 3000.
import { DATA } from '../demos/AtP14FitDemo.tsx';
const run = DATA.runs['60_8'];
const E = DATA.E;
const W = 900, H = 400;
const pl = 60, pr = 30, pt = 70, pb = 74;
const lx = (e: number) => pl + (Math.log10(e) / Math.log10(3000)) * (W - pl - pr);
const ly = (v: number) => pt + ((1.4 - Math.min(1.4, v)) / 1.4) * (H - pt - pb);
const curve = (ys: number[]) => ys.map((v, i) => `${i ? 'L' : 'M'}${lx(E[i]).toFixed(1)} ${ly(v).toFixed(1)}`).join(' ');
const best = run.best; // 37
const xticks = [1, 10, 100, 1000];
const yticks = [0, 0.4, 0.8, 1.2];
---
<figure class="atp14-es">
  <div class="atp14-es-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Training error and validation error against epochs for a small network on 60 rows. Training error keeps falling toward 0.03. Validation error is lowest at 0.357 around epoch 37, then climbs to 1.06. Stopping at epoch 37 gives 0.383 on unseen rows; training on to epoch 3000 gives 1.044.">
    <text x="20" y="26" class="h">
      <tspan data-lang-en>Early stopping: quit when the held-out error turns around</tspan>
      <tspan data-lang-vi>Early stopping: dừng khi sai số trên tập giữ lại bắt đầu quay đầu</tspan>
    </text>
    <text x="20" y="46" class="sub">
      <tspan data-lang-en>Simulated: 60 training rows, 60 validation rows, 8 hidden units.</tspan>
      <tspan data-lang-vi>Mô phỏng: 60 dòng huấn luyện, 60 dòng validation, 8 nơ-ron ẩn.</tspan>
    </text>
    {yticks.map((v) => (
      <g>
        <line x1={pl} y1={ly(v)} x2={W - pr} y2={ly(v)} class="grid" />
        <text x={pl - 8} y={ly(v) + 4} text-anchor="end" class="tick">{v.toFixed(1)}</text>
      </g>
    ))}
    {xticks.map((e) => (
      <text x={lx(e)} y={H - pb + 20} text-anchor="middle" class="tick">{e}</text>
    ))}
    <text x={lx(3000)} y={H - pb + 20} text-anchor="middle" class="tick">3000</text>
    <text x={(pl + W - pr) / 2} y={H - pb + 42} text-anchor="middle" class="sub">
      <tspan data-lang-en>epochs of training (log scale)</tspan>
      <tspan data-lang-vi>số epoch đã huấn luyện (thang log)</tspan>
    </text>

    <line x1={pl} y1={ly(0.362)} x2={W - pr} y2={ly(0.362)} class="zero" />
    <text x={W - pr - 4} y={ly(0.362) - 6} text-anchor="end" class="sub">
      <tspan data-lang-en>always predicting 0 scores 0.362 on unseen rows</tspan>
      <tspan data-lang-vi>luôn đoán 0 được 0,362 trên dòng chưa thấy</tspan>
    </text>

    <path d={curve(run.train)} class="train" />
    <path d={curve(run.val)} class="val" />

    <line x1={lx(best)} y1={pt - 10} x2={lx(best)} y2={H - pb} class="stop" />
    <text x={lx(best) + 8} y={pt + 4} class="stopT">
      <tspan data-lang-en>stop here: epoch 37, unseen-row error 0.383</tspan>
      <tspan data-lang-vi>dừng ở đây: epoch 37, sai số dòng chưa thấy 0,383</tspan>
    </text>
    <text x={W - pr} y={pt + 26} text-anchor="end" class="late">
      <tspan data-lang-en>train on to epoch 3000: unseen-row error 1.044</tspan>
      <tspan data-lang-vi>huấn luyện tới epoch 3000: sai số dòng chưa thấy 1,044</tspan>
    </text>

    <line x1="540" y1="378" x2="568" y2="378" class="train" />
    <text x="574" y="382" class="sub">
      <tspan data-lang-en>training error</tspan>
      <tspan data-lang-vi>sai số huấn luyện</tspan>
    </text>
    <line x1="730" y1="378" x2="758" y2="378" class="val" />
    <text x="764" y="382" class="sub">
      <tspan data-lang-en>validation error</tspan>
      <tspan data-lang-vi>sai số validation</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The validation rows never touch the weights, so their error stands in for the future. It turns upward while the training error keeps falling; early stopping keeps the weights from the turning point.</span>
    <span data-lang-vi>Các dòng validation không bao giờ chạm vào trọng số, nên sai số của chúng đại diện cho tương lai. Nó quay lên trong khi sai số huấn luyện vẫn giảm; early stopping giữ lại trọng số ở điểm quay đầu.</span>
  </figcaption>
</figure>

<style>
  .atp14-es { margin: 2em 0; width: 100%; }
  .atp14-es-scroll { overflow-x: auto; }
  .atp14-es svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .atp14-es text { font-size: 14px; fill: var(--text-body); }
  .atp14-es .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp14-es .sub { font-size: 13px; fill: var(--text-muted); }
  .atp14-es .tick { font-size: 12px; fill: var(--text-muted); }
  .atp14-es .stopT { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .atp14-es .late { font-size: 13.5px; font-weight: 700; fill: var(--red); }
  .atp14-es .grid { stroke: var(--border); stroke-width: 1; }
  .atp14-es .zero { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .atp14-es .train { fill: none; stroke: var(--gold); stroke-width: 2.4; }
  .atp14-es .val { fill: none; stroke: var(--red); stroke-width: 2.4; }
  .atp14-es .stop { stroke: var(--text); stroke-width: 1.3; stroke-dasharray: 2 3; }
  .atp14-es figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
