---
// How fast the number of correlations to estimate grows with the number of stocks.
// Pairs = N(N-1)/2 (Python: comb(12,2)=66, comb(30,2)=435, comb(100,2)=4950).
// Rank claim: numpy matrix_rank of the sample covariance of 100 random series, 60 days -> 59.
import DiagramIcon from './DiagramIcon.astro';
const W = 900, H = 330;
const rows = [
  { n: 12, pairs: 66, label: { en: '12 stocks (the demo below)', vi: '12 cổ phiếu (demo bên dưới)' } },
  { n: 30, pairs: 435, label: { en: '30 stocks (a VN30-sized basket)', vi: '30 cổ phiếu (cỡ rổ VN30)' } },
  { n: 100, pairs: 4950, label: { en: '100 stocks (VN100-sized)', vi: '100 cổ phiếu (cỡ VN100)' } },
];
const X0 = 250, BW = 520;
const bw = (p: number) => Math.max(3, (p / 4950) * BW);
---
<figure class="p10pc">
  <div class="p10pc-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Bars of the number of pairwise correlations: 66 for 12 stocks, 435 for 30 stocks and 4,950 for 100 stocks. A note says that with 100 stocks and only 60 days of returns, the sample covariance matrix has rank 59, so it cannot be inverted.">
    <text x="20" y="28" class="p10pc-h">
      <tspan data-lang-en>Every pair of stocks is one number to estimate</tspan>
      <tspan data-lang-vi>Mỗi cặp cổ phiếu là một con số phải ước lượng</tspan>
    </text>
    {rows.map((r, k) => (
      <g>
        <text x="20" y={80 + k * 52} class="p10pc-lab">
          <tspan data-lang-en>{r.label.en}</tspan>
          <tspan data-lang-vi>{r.label.vi}</tspan>
        </text>
        <rect x={X0} y={62 + k * 52} width={bw(r.pairs)} height="26" rx="4" class={k === 2 ? 'p10pc-bar is-big' : 'p10pc-bar'} />
        <text x={X0 + bw(r.pairs) + 10} y={80 + k * 52} class="p10pc-num">
          <tspan data-lang-en>{r.pairs.toLocaleString('en-US')} pairs</tspan>
          <tspan data-lang-vi>{r.pairs.toLocaleString('vi-VN')} cặp</tspan>
        </text>
      </g>
    ))}
    <rect x="20" y="226" width="860" height="84" rx="8" class="p10pc-note" />
    <DiagramIcon name="warning" x={50} y={268} size={26} />
    <text x="80" y="256" class="p10pc-t">
      <tspan data-lang-en>With 100 stocks and 60 days of returns, the sample covariance matrix has rank 59:</tspan>
      <tspan data-lang-vi>Với 100 cổ phiếu và 60 ngày lợi suất, ma trận hiệp phương sai mẫu có hạng 59:</tspan>
    </text>
    <text x="80" y="280" class="p10pc-t">
      <tspan data-lang-en>it has no inverse, and Markowitz needs one. Fewer days than stocks always does this.</tspan>
      <tspan data-lang-vi>nó không có nghịch đảo, mà Markowitz cần đúng thứ đó. Số ngày ít hơn số mã luôn gây ra chuyện này.</tspan>
    </text>
    <text x="80" y="300" class="p10pc-s">
      <tspan data-lang-en>Pairs = N(N−1)/2. Rank checked with numpy on 100 random series, 60 days.</tspan>
      <tspan data-lang-vi>Số cặp = N(N−1)/2. Hạng kiểm bằng numpy trên 100 chuỗi ngẫu nhiên, 60 ngày.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The number of pairs grows with the square of the number of stocks, while the days of history do not grow at all.</span>
    <span data-lang-vi>Số cặp tăng theo bình phương số cổ phiếu, còn số ngày dữ liệu thì không tăng.</span>
  </figcaption>
</figure>

<style>
  .p10pc { margin: 2em 0; width: 100%; }
  .p10pc-scroll { overflow-x: auto; }
  .p10pc svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .p10pc text { font-size: 14px; fill: var(--text-body); }
  .p10pc .p10pc-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p10pc .p10pc-lab { font-weight: 600; fill: var(--text); }
  .p10pc .p10pc-num { font-weight: 700; fill: var(--text); }
  .p10pc .p10pc-t { fill: var(--text); font-weight: 600; }
  .p10pc .p10pc-s { font-size: 12.5px; fill: var(--text-muted); }
  .p10pc-bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .p10pc-bar.is-big { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .p10pc-note { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.3; }
  .p10pc figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
