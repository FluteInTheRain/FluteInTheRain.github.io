---
import BatchDiagram from './BatchDiagram.astro';
const boxes = [{"x": 20, "y": 46, "w": 190, "h": 64, "t": ["1. Big input", "1. Đầu vào lớn"], "s": [["107 MiB log", "log 107 MiB"]], "icon": "file"}, {"x": 250, "y": 46, "w": 190, "h": 64, "t": ["2. Sort a chunk", "2. Xếp một đoạn"], "s": [["8 MiB at a time", "8 MiB mỗi lượt"]], "icon": "worker"}, {"x": 480, "y": 46, "w": 190, "h": 64, "t": ["3. Spill to disk", "3. Ghi ra đĩa"], "s": [["sorted runs", "các run đã xếp"]], "icon": "disk"}, {"x": 710, "y": 46, "w": 170, "h": 64, "t": ["4. Merge", "4. Trộn"], "s": [["one sequential pass", "một lượt tuần tự"]], "icon": "sync", "kind": "good"}];
const arrows = [{"x1": 210, "y1": 78, "x2": 250, "y2": 78}, {"x1": 440, "y1": 78, "x2": 480, "y2": 78}, {"x1": 670, "y1": 78, "x2": 710, "y2": 78, "kind": "good"}];
const texts = [{"x": 20, "y": 26, "cls": "h", "t": ["sort -S 8M: sorting more data than fits in RAM", "sort -S 8M: xếp nhiều dữ liệu hơn RAM chứa được"]}, {"x": 20, "y": 160, "cls": "foot", "t": ["uniq -c only compares neighbouring lines, so it holds one counter however many keys exist.", "uniq -c chỉ so sánh các dòng kề nhau, nên chỉ giữ một bộ đếm dù có bao nhiêu khoá."]}, {"x": 20, "y": 184, "cls": "ok", "t": ["Measured peak memory stayed under 18 MiB on 1,000,000 lines.", "Đỉnh RAM đo được luôn dưới 18 MiB trên 1.000.000 dòng."]}];
---
<BatchDiagram
  w={900} h={215}
  aria="External merge sort in four steps: a big input file, sort 8 MiB chunks in RAM, spill sorted runs to disk, then merge the runs in one sequential pass while uniq keeps a single counter."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any} rules={[]} icons={[]}
  caption={["Memory stays near the cap because only one chunk is ever sorted in RAM; everything else waits on disk.", "RAM luôn gần mức trần vì mỗi lúc chỉ có một đoạn được xếp trong RAM; phần còn lại nằm chờ trên đĩa."]}
/>
