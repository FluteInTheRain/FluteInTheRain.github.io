---
// Direct left/right comparison of key-range sharding vs. hash sharding:
// Top half shows write distribution for sequential timestamps; bottom half shows
// how a date range query lands on the shards.
// Plain inline SVG using site CSS tokens; arrowheads are polygons (no SVG ids).

const W = 900;
const H = 472;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const writes = [
  { label: 'Nov 19, 10:01', hashTarget: 2, y: 92 },
  { label: 'Nov 19, 10:02', hashTarget: 0, y: 128 },
  { label: 'Nov 19, 10:03', hashTarget: 3, y: 164 },
  { label: 'Nov 19, 10:04', hashTarget: 1, y: 200 },
];

const rangeShards = [
  { name: 'Shard 0 [Aug]', hot: false, writes: 0 },
  { name: 'Shard 1 [Sep]', hot: false, writes: 0 },
  { name: 'Shard 2 [Oct]', hot: false, writes: 0 },
  { name: 'Shard 3 [Nov]', hot: true, writes: 4 },
];

const hashShards = [
  { name: 'Shard 0 [0–16k]', writes: 1 },
  { name: 'Shard 1 [16k–32k]', writes: 1 },
  { name: 'Shard 2 [32k–49k]', writes: 1 },
  { name: 'Shard 3 [49k–65k]', writes: 1 },
];

const shardY = (i: number) => 88 + i * 38;
const scanY = (i: number) => 302 + i * 30;
---
<figure class="shrk">
  <div class="shrk-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Comparison of key-range sharding and hash sharding. On the left, sequential timestamp writes all land on Shard 3 for November, creating a hot shard, while a November range query touches only that shard. On the right, hashing scatters those writes evenly across all four shards, so a November range query must check every shard.">
      <line x1="450" x2="450" y1="12" y2={H - 12} class="shrk-sep" />

      {/* Headers */}
      <text x="20" y="26" class="shrk-h">
        <tspan data-lang-en>Key-range sharding</tspan>
        <tspan data-lang-vi>Chia theo dải khoá (key range)</tspan>
      </text>
      <text x="20" y="47" class="shrk-sub">
        <tspan data-lang-en>Keys stay sorted; writes in order hit one shard.</tspan>
        <tspan data-lang-vi>Khoá giữ thứ tự; ghi theo giờ dồn vào một shard.</tspan>
      </text>

      <text x="475" y="26" class="shrk-h">
        <tspan data-lang-en>Hash sharding</tspan>
        <tspan data-lang-vi>Chia theo hàm băm (hash)</tspan>
      </text>
      <text x="475" y="47" class="shrk-sub">
        <tspan data-lang-en>Hashes scatter writes, but lose key order.</tspan>
        <tspan data-lang-vi>Hàm băm rải đều lệnh ghi, nhưng mất thứ tự khoá.</tspan>
      </text>

      {/* Top half: Write paths */}
      <text x="20" y="75" class="shrk-lbl">
        <tspan data-lang-en>Sequential writes</tspan>
        <tspan data-lang-vi>Lệnh ghi nối tiếp</tspan>
      </text>
      <text x="475" y="75" class="shrk-lbl">
        <tspan data-lang-en>Same writes, hashed</tspan>
        <tspan data-lang-vi>Cùng lệnh ghi, qua hash</tspan>
      </text>

      {writes.map((w) => {
        const aLeft = arrow(146, w.y + 13, 248, shardY(3) + 16);
        const aRight = arrow(601, w.y + 13, 703, shardY(w.hashTarget) + 16);
        return (
          <g>
            <rect x="20" y={w.y} width="126" height="26" rx="4" class="shrk-pill" />
            <text x="83" y={w.y + 17} text-anchor="middle" class="shrk-pill-txt">{w.label}</text>
            <path d={aLeft.line} class="shrk-arrow is-hot" /><polygon points={aLeft.head} class="shrk-head is-hot" />

            <rect x="475" y={w.y} width="126" height="26" rx="4" class="shrk-pill" />
            <text x="538" y={w.y + 17} text-anchor="middle" class="shrk-pill-txt">{w.label}</text>
            <path d={aRight.line} class="shrk-arrow" /><polygon points={aRight.head} class="shrk-head" />
          </g>
        );
      })}

      {rangeShards.map((s, i) => {
        const y = shardY(i);
        return (
          <g>
            <rect x="250" y={y} width="175" height="32" rx="5" class={s.hot ? 'shrk-box is-hot' : 'shrk-box'} />
            <text x="260" y={y + 20} class={s.hot ? 'shrk-box-txt is-hot' : 'shrk-box-txt'}>{s.name}</text>
            <text x="415" y={y + 20} text-anchor="end" class={s.hot ? 'shrk-cnt is-hot' : 'shrk-cnt'}>{s.writes} w</text>
          </g>
        );
      })}

      {hashShards.map((s, i) => {
        const y = shardY(i);
        return (
          <g>
            <rect x="705" y={y} width="175" height="32" rx="5" class="shrk-box" />
            <text x="715" y={y + 20} class="shrk-box-txt">{s.name}</text>
            <text x="870" y={y + 20} text-anchor="end" class="shrk-cnt">{s.writes} w</text>
          </g>
        );
      })}

      {/* Divider between write and read halves */}
      <line x1="20" x2="425" y1="262" y2="262" class="shrk-rule" />
      <line x1="475" x2="880" y1="262" y2="262" class="shrk-rule" />

      {/* Bottom half: Range query */}
      <text x="20" y="286" class="shrk-lbl">
        <tspan data-lang-en>Range scan: Nov 1 to Nov 15 (1 shard)</tspan>
        <tspan data-lang-vi>Quét khoảng: 1–15 tháng 11 (1 shard)</tspan>
      </text>
      <text x="475" y="286" class="shrk-lbl">
        <tspan data-lang-en>Range scan: Nov 1 to Nov 15 (all 4 shards)</tspan>
        <tspan data-lang-vi>Quét khoảng: 1–15 tháng 11 (cả 4 shard)</tspan>
      </text>

      {/* Left range scan */}
      <rect x="20" y="344" width="126" height="34" rx="5" class="shrk-box" />
      <text x="83" y="365" text-anchor="middle" class="shrk-box-txt">Nov 1 .. Nov 15</text>
      {rangeShards.map((s, i) => {
        const y = scanY(i);
        const active = i === 3;
        const a = active ? arrow(146, 361, 248, y + 12) : null;
        return (
          <g>
            {a && <g><path d={a.line} class="shrk-arrow is-strong" /><polygon points={a.head} class="shrk-head is-strong" /></g>}
            <rect x="250" y={y} width="175" height="24" rx="4" class={active ? 'shrk-box is-active' : 'shrk-box is-dim'} />
            <text x="260" y={y + 16} class={active ? 'shrk-box-txt is-strong' : 'shrk-box-txt is-dim'}>{s.name}</text>
          </g>
        );
      })}

      {/* Right range scan */}
      <rect x="475" y="344" width="126" height="34" rx="5" class="shrk-box" />
      <text x="538" y="365" text-anchor="middle" class="shrk-box-txt">Nov 1 .. Nov 15</text>
      {hashShards.map((s, i) => {
        const y = scanY(i);
        const a = arrow(601, 361, 703, y + 12);
        return (
          <g>
            <path d={a.line} class="shrk-arrow is-hot" /><polygon points={a.head} class="shrk-head is-hot" />
            <rect x="705" y={y} width="175" height="24" rx="4" class="shrk-box is-hot" />
            <text x="715" y={y + 16} class="shrk-box-txt is-hot">{s.name}</text>
          </g>
        );
      })}

      {/* Verdicts */}
      <text x="20" y="454" class="shrk-verdict is-bad">
        <tspan data-lang-en>Fast scans, but ordered writes melt Shard 3.</tspan>
        <tspan data-lang-vi>Quét nhanh, nhưng ghi theo giờ làm nóng Shard 3.</tspan>
      </text>
      <text x="475" y="454" class="shrk-verdict">
        <tspan data-lang-en>Even writes, but range queries hit every shard.</tspan>
        <tspan data-lang-vi>Ghi đều, nhưng quét khoảng phải hỏi mọi shard.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Key-range sharding vs. hash sharding on the same timestamp workload. Compound keys (such as hashing <code>sensor_id</code> or <code>channel_id</code> and sorting by timestamp within that shard) combine both: writes spread across nodes while one entity's time range stays local.</span>
    <span data-lang-vi>So sánh chia theo dải khoá và chia theo hàm băm trên cùng luồng dữ liệu mốc thời gian. Khoá ghép (như băm <code>sensor_id</code> hoặc <code>channel_id</code> rồi sắp theo thời gian bên trong shard) gộp lợi thế cả hai: lệnh ghi rải đều nhiều máy mà lịch sử của từng thực thể vẫn nằm gọn một chỗ.</span>
  </figcaption>
</figure>

<style>
  .shrk {
    margin: 2em 0;
    width: 100%;
  }
  .shrk-scroll {
    overflow-x: auto;
  }
  .shrk svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .shrk text {
    font-size: 13.5px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .shrk .shrk-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .shrk .shrk-sub,
  .shrk .shrk-lbl {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .shrk .shrk-lbl {
    font-weight: 600;
  }
  .shrk-sep {
    stroke: var(--border);
    stroke-dasharray: 5 5;
  }
  .shrk-rule {
    stroke: var(--border);
  }
  .shrk-pill {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.1;
  }
  .shrk .shrk-pill-txt {
    font-size: 12.5px;
    fill: var(--text);
  }
  .shrk-box {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .shrk-box.is-hot {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .shrk-box.is-active {
    stroke: var(--text);
    stroke-width: 1.6;
  }
  .shrk-box.is-dim {
    opacity: 0.45;
  }
  .shrk .shrk-box-txt {
    font-size: 13px;
    font-weight: 600;
    fill: var(--text);
  }
  .shrk .shrk-box-txt.is-hot {
    fill: var(--red);
  }
  .shrk .shrk-box-txt.is-dim {
    fill: var(--text-faint);
  }
  .shrk .shrk-cnt {
    font-size: 12px;
    fill: var(--text-muted);
  }
  .shrk .shrk-cnt.is-hot {
    fill: var(--red);
    font-weight: 700;
  }
  .shrk-arrow {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.3;
  }
  .shrk-arrow.is-hot {
    stroke: var(--red);
    stroke-width: 1.5;
  }
  .shrk-arrow.is-strong {
    stroke: var(--text);
    stroke-width: 1.6;
  }
  .shrk-head {
    fill: var(--text-muted);
  }
  .shrk-head.is-hot {
    fill: var(--red);
  }
  .shrk-head.is-strong {
    fill: var(--text);
  }
  .shrk .shrk-verdict {
    font-size: 13.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .shrk .shrk-verdict.is-bad {
    fill: var(--red);
  }
  .shrk figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
