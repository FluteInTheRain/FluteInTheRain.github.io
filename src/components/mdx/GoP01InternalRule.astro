---
// Icons: terminal = cmd, lock = internal, ok = allowed, stop = rejected. Motion: fm-flow on the allowed import, fm-pulse on the red block.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 320;
---
<figure class="gp1e">
  <div class="gp1e-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Inside module example.com/greeter, cmd/greeter can import internal/greet. From a different module example.com/other the same import is rejected.">
    <rect x="20" y="20" width="540" height="140" rx="8" class="grp" />
    <text x="36" y="46" class="h">module example.com/greeter</text>
    <rect x="40" y="70" width="200" height="60" rx="6" class="box" />
    <DiagramIcon name="terminal" x={66} y={100} size={26} />
    <text x="148" y="106" text-anchor="middle" class="t">cmd/greeter</text>
    <rect x="320" y="70" width="220" height="60" rx="6" class="box" />
    <DiagramIcon name="lock" x={346} y={100} size={26} />
    <text x="446" y="96" text-anchor="middle" class="t">internal/greet</text>
    <text x="446" y="116" text-anchor="middle" class="m"><tspan data-lang-en>inside the tree</tspan><tspan data-lang-vi>nằm trong cây thư mục</tspan></text>
    {(() => { const a = arrow(240, 100, 316, 100); return <g><path d={a.line} class="ln fm-flow" /><polygon points={a.head} class="hd" /></g>; })()}
    <DiagramIcon name="ok" x={592} y={101} size={26} />
    <text x="612" y="106" class="m"><tspan data-lang-en>allowed</tspan><tspan data-lang-vi>được phép</tspan></text>
    <rect x="20" y="200" width="260" height="90" rx="8" class="grp" />
    <text x="36" y="226" class="h">module example.com/other</text>
    <rect x="40" y="240" width="220" height="36" rx="6" class="box" />
    <DiagramIcon name="file" x={62} y={258} size={24} />
    <text x="160" y="264" text-anchor="middle" class="t">main.go</text>
    <path d="M 260 258 L 300 258 L 300 190 L 430 190 L 430 170" class="lnr" />
    <line x1="410" x2="450" y1="166" y2="166" stroke="var(--red)" stroke-width="3" class="fm-pulse" />
    <DiagramIcon name="stop" x={484} y={166} size={26} />
    <text x="330" y="236" class="r"><tspan data-lang-en>use of internal package … not allowed</tspan><tspan data-lang-vi>use of internal package … not allowed</tspan></text>
    <text x="330" y="262" class="m"><tspan data-lang-en>The Go tool rejects the import. No flag turns this off.</tspan><tspan data-lang-vi>Công cụ Go từ chối import. Không có cờ nào để tắt.</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Code inside the parent tree of internal/ can import it. Code in another module cannot, even if it knows the full path.</span>
    <span data-lang-vi>Code nằm trong cây thư mục cha của internal/ import được. Code ở module khác thì không, dù biết đủ đường dẫn.</span>
  </figcaption>
</figure>

<style>
  .gp1e { margin: 2em 0; width: 100%; }
  .gp1e-scroll { overflow-x: auto; }
  .gp1e svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp1e text { font-size: 14px; fill: var(--text-body); }
  .gp1e .t { font-weight: 700; fill: var(--text); }
  .gp1e .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp1e .m { fill: var(--text-muted); }
  .gp1e .r { fill: var(--red); font-weight: 700; }
  .gp1e .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp1e .grp { fill: none; stroke: var(--border); stroke-width: 1.5; }
  .gp1e .bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp1e .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp1e .lnd { stroke: var(--text-muted); stroke-width: 1.5; fill: none; stroke-dasharray: 4 4; }
  .gp1e .lnr { stroke: var(--red); stroke-width: 1.5; fill: none; stroke-dasharray: 5 4; }
  .gp1e .hd { fill: var(--text-muted); }
  .gp1e .hdr { fill: var(--red); }
  .gp1e .axis { stroke: var(--border); stroke-width: 1.5; }
  .gp1e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
