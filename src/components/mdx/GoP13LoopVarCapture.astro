---
const W = 900;
const H = 336;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

// Left side arrows (shared slot -> 3 goroutines)
const aL1 = arrow(170, 174, 86, 212);
const aL2 = arrow(225, 174, 225, 212);
const aL3 = arrow(280, 174, 364, 212);

// Right side arrows (3 distinct slots -> 3 goroutines)
const aR1 = arrow(536, 174, 536, 212);
const aR2 = arrow(675, 174, 675, 212);
const aR3 = arrow(814, 174, 814, 212);
---
<figure class="g13lv">
  <div class="g13lv-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Loop variable capture in Go 1.21 versus Go 1.22 and newer. Left: in go 1.21 mode, all three goroutines point to one shared v slot and print 3 3 3 with a data race. Right: in go 1.27.1 mode, each iteration allocates its own v address and prints 1, 2, 3 without races.">
      {/* Left panel: Go 1.21 */}
      <text x="20" y="24" class="g13lv-h is-red">
        <tspan data-lang-en>go 1.21 module: one shared v slot</tspan>
        <tspan data-lang-vi>Module go 1.21: một biến v dùng chung</tspan>
      </text>
      <rect x="20" y="42" width="410" height="44" rx="8" class="g13lv-code" />
      <text x="225" y="69" text-anchor="middle" class="g13lv-ct">for _, v := range []int{'{'}1, 2, 3{'}'}</text>

      <rect x="76" y="114" width="298" height="58" rx="8" class="g13lv-mem is-red" />
      <text x="225" y="138" text-anchor="middle" class="g13lv-mb is-red">0x...030:  v = 1 → 2 → 3</text>
      <text x="225" y="160" text-anchor="middle" class="g13lv-sub">
        <tspan data-lang-en>loop overwrites the same address</tspan>
        <tspan data-lang-vi>vòng lặp ghi đè đúng một địa chỉ</tspan>
      </text>

      <g class="g13lv-arrow is-red"><path d={aL1.line} /><polygon points={aL1.head} /></g>
      <g class="g13lv-arrow is-red"><path d={aL2.line} /><polygon points={aL2.head} /></g>
      <g class="g13lv-arrow is-red"><path d={aL3.line} /><polygon points={aL3.head} /></g>

      <rect x="26" y="216" width="120" height="46" rx="7" class="g13lv-g is-red" />
      <text x="86" y="236" text-anchor="middle" class="g13lv-gb">g1 reads &amp;v</text>
      <text x="86" y="254" text-anchor="middle" class="g13lv-red">→ 3</text>

      <rect x="165" y="216" width="120" height="46" rx="7" class="g13lv-g is-red" />
      <text x="225" y="236" text-anchor="middle" class="g13lv-gb">g2 reads &amp;v</text>
      <text x="225" y="254" text-anchor="middle" class="g13lv-red">→ 3</text>

      <rect x="304" y="216" width="120" height="46" rx="7" class="g13lv-g is-red" />
      <text x="364" y="236" text-anchor="middle" class="g13lv-gb">g3 reads &amp;v</text>
      <text x="364" y="254" text-anchor="middle" class="g13lv-red">→ 3</text>

      <rect x="20" y="278" width="410" height="42" rx="8" class="g13lv-foot is-red" />
      <text x="225" y="304" text-anchor="middle" class="g13lv-red">
        <tspan data-lang-en>Output: 3 3 3 (data race on go run -race .)</tspan>
        <tspan data-lang-vi>Kết quả: 3 3 3 (dính data race khi chạy -race)</tspan>
      </text>

      {/* Center divider */}
      <line x1="450" y1="16" x2="450" y2="322" class="g13lv-rule" />

      {/* Right panel: Go 1.22+ / 1.27 */}
      <text x="470" y="24" class="g13lv-h">
        <tspan data-lang-en>go 1.22+ (Go 1.27): one v slot per iteration</tspan>
        <tspan data-lang-vi>go 1.22+ (Go 1.27): mỗi lượt lặp một biến v</tspan>
      </text>
      <rect x="470" y="42" width="410" height="44" rx="8" class="g13lv-code" />
      <text x="675" y="69" text-anchor="middle" class="g13lv-ct">for _, v := range []int{'{'}1, 2, 3{'}'}</text>

      <rect x="476" y="114" width="120" height="58" rx="8" class="g13lv-mem is-gold" />
      <text x="536" y="138" text-anchor="middle" class="g13lv-mb">0x...030</text>
      <text x="536" y="160" text-anchor="middle" class="g13lv-gold">v = 1</text>

      <rect x="615" y="114" width="120" height="58" rx="8" class="g13lv-mem is-gold" />
      <text x="675" y="138" text-anchor="middle" class="g13lv-mb">0x...038</text>
      <text x="675" y="160" text-anchor="middle" class="g13lv-gold">v = 2</text>

      <rect x="754" y="114" width="120" height="58" rx="8" class="g13lv-mem is-gold" />
      <text x="814" y="138" text-anchor="middle" class="g13lv-mb">0x...040</text>
      <text x="814" y="160" text-anchor="middle" class="g13lv-gold">v = 3</text>

      <g class="g13lv-arrow is-gold"><path d={aR1.line} /><polygon points={aR1.head} /></g>
      <g class="g13lv-arrow is-gold"><path d={aR2.line} /><polygon points={aR2.head} /></g>
      <g class="g13lv-arrow is-gold"><path d={aR3.line} /><polygon points={aR3.head} /></g>

      <rect x="476" y="216" width="120" height="46" rx="7" class="g13lv-g is-gold" />
      <text x="536" y="236" text-anchor="middle" class="g13lv-gb">g1 reads</text>
      <text x="536" y="254" text-anchor="middle" class="g13lv-gold">→ 1</text>

      <rect x="615" y="216" width="120" height="46" rx="7" class="g13lv-g is-gold" />
      <text x="675" y="236" text-anchor="middle" class="g13lv-gb">g2 reads</text>
      <text x="675" y="254" text-anchor="middle" class="g13lv-gold">→ 2</text>

      <rect x="754" y="216" width="120" height="46" rx="7" class="g13lv-g is-gold" />
      <text x="814" y="236" text-anchor="middle" class="g13lv-gb">g3 reads</text>
      <text x="814" y="254" text-anchor="middle" class="g13lv-gold">→ 3</text>

      <rect x="470" y="278" width="410" height="42" rx="8" class="g13lv-foot is-gold" />
      <text x="675" y="304" text-anchor="middle" class="g13lv-gold">
        <tspan data-lang-en>Output: 1, 2, 3 in any order (-race clean)</tspan>
        <tspan data-lang-vi>Kết quả: đủ 1, 2, 3 mọi thứ tự (-race sạch)</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Running the exact same code on Go 1.27.1 with go 1.21 versus go 1.27 in go.mod: Go 1.21 prints one shared pointer address three times, while Go 1.22+ gives each iteration its own slot (distinct addresses). Declaring var v outside the loop still shares one slot even in Go 1.27.</span>
    <span data-lang-vi>Chạy đúng một file trên Go 1.27.1 khi đổi go 1.21 thành go 1.27 trong go.mod: bản 1.21 in ra cùng một địa chỉ ba lần, còn bản 1.22+ cấp cho mỗi lượt lặp một ô nhớ riêng (địa chỉ khác nhau). Nếu khai báo var v bên ngoài for thì ngay cả Go 1.27 vẫn dùng chung một ô.</span>
  </figcaption>
</figure>

<style>
  .g13lv { margin: 2em 0; width: 100%; }
  .g13lv-scroll { overflow-x: auto; }
  .g13lv svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .g13lv text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .g13lv-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .g13lv-h.is-red { fill: var(--red); }
  .g13lv-code { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .g13lv-ct { font-size: 14px; font-weight: 600; fill: var(--text); }
  .g13lv-mem { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .g13lv-mem.is-red { fill: var(--red-tint-bg); stroke: var(--red); }
  .g13lv-mem.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .g13lv-mb { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .g13lv-mb.is-red { fill: var(--red); }
  .g13lv-sub { font-size: 12.5px; fill: var(--text-muted); }
  .g13lv-g { fill: var(--bg); stroke: var(--border); stroke-width: 1.3; }
  .g13lv-g.is-red { stroke: var(--red); }
  .g13lv-g.is-gold { stroke: var(--gold); }
  .g13lv-gb { font-weight: 700; fill: var(--text); }
  .g13lv-red { fill: var(--red); font-weight: 700; }
  .g13lv-gold { fill: var(--gold-icon); font-weight: 700; }
  .g13lv-foot { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .g13lv-foot.is-red { fill: var(--red-tint-bg); stroke: var(--red); }
  .g13lv-foot.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .g13lv-rule { stroke: var(--border); }
  .g13lv-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.6; }
  .g13lv-arrow polygon { fill: var(--text-muted); }
  .g13lv-arrow.is-red path { stroke: var(--red); }
  .g13lv-arrow.is-red polygon { fill: var(--red); }
  .g13lv-arrow.is-gold path { stroke: var(--gold-icon); }
  .g13lv-arrow.is-gold polygon { fill: var(--gold-icon); }
  .g13lv figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
