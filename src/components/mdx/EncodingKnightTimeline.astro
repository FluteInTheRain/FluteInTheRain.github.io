---
import EncodingStepCards from './EncodingStepCards.astro';
const props = {
 "arrows": true,
 "title": {
  "en": "Knight Capital: from deploy to $460 million",
  "vi": "Knight Capital: từ lúc deploy tới 460 triệu đô"
 },
 "alt": "Timeline of the Knight Capital incident in four steps: on 27 July the deploy starts and one of eight servers is missed; before the open on 1 August 97 automated emails say Power Peg disabled and nobody reads them; orders arrive with the flag set, seven servers read it as new and the eighth runs Power Peg; about 45 minutes later 212 orders have become more than 4 million executions in 154 stocks, a loss of 460 million dollars, and rolling back made it worse.",
 "cards": [
  {
   "icon": "calendar",
   "head": {
    "en": [
     "27 July"
    ],
    "vi": [
     "27/7"
    ]
   },
   "lines": {
    "en": [
     "Deploy starts, a few",
     "servers at a time.",
     "One of 8 is missed;",
     "nobody checks."
    ],
    "vi": [
     "Bắt đầu deploy, mỗi",
     "lần vài server. Một",
     "trong 8 bị bỏ sót;",
     "không ai kiểm tra."
    ]
   },
   "tone": "plain"
  },
  {
   "icon": "mail",
   "head": {
    "en": [
     "Before open, 1 Aug"
    ],
    "vi": [
     "Trước giờ mở cửa, 1/8"
    ]
   },
   "lines": {
    "en": [
     "97 automated emails",
     "say \"Power Peg disabled\".",
     "Nobody reads them."
    ],
    "vi": [
     "97 email tự động ghi",
     "\"Power Peg disabled\".",
     "Không ai đọc chúng."
    ]
   },
   "tone": "plain"
  },
  {
   "icon": "warning",
   "head": {
    "en": [
     "Orders arrive"
    ],
    "vi": [
     "Lệnh đổ về"
    ]
   },
   "lines": {
    "en": [
     "The flag is set. S1-S7",
     "read the new meaning;",
     "S8 runs Power Peg."
    ],
    "vi": [
     "Cờ được bật. S1-S7",
     "hiểu nghĩa mới;",
     "S8 chạy Power Peg."
    ]
   },
   "tone": "bad"
  },
  {
   "icon": "money",
   "head": {
    "en": [
     "About 45 minutes"
    ],
    "vi": [
     "Khoảng 45 phút"
    ]
   },
   "lines": {
    "en": [
     "212 orders become 4M+",
     "executions in 154 stocks.",
     "Loss: $460 million.",
     "Rollback made it worse."
    ],
    "vi": [
     "212 lệnh thành 4 triệu+",
     "lần khớp, 154 mã.",
     "Mất 460 triệu đô.",
     "Rollback còn tệ hơn."
    ]
   },
   "tone": "bad"
  }
 ],
 "caption": {
  "en": "The incident as the SEC order describes it. Read left to right: the quiet signal (the emails) came before the loud one.",
  "vi": "Sự cố theo mô tả trong quyết định của SEC. Đọc từ trái sang: tín hiệu im lặng (các email) đến trước tín hiệu ồn ào."
 }
};
---
<EncodingStepCards {...props} />
