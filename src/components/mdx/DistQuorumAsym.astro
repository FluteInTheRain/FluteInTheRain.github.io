---
import DiagramIcon from './DiagramIcon.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const L = (en: string, vi: string) => (lang === 'vi' ? vi : en);
const W = 900;
const H = 306;
---
<figure class="dqa">
  <div class="dqa-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L("Node E receives every heartbeat from the other four nodes, but its replies are dropped. The four-node majority times out and declares E dead, so E must step down even though it feels healthy.", "Node E nhận đủ heartbeat từ bốn node còn lại nhưng mọi phản hồi bị rớt. Đa số bốn node hết giờ chờ và tuyên bố E đã chết, nên E phải lùi dù tự thấy khỏe.")}>
<text x="20" y="24" class="t-h">{L("A node can hear everyone and still be declared dead","Một node nghe được mọi người vẫn có thể bị tuyên bố đã chết")}</text>
<rect x="20" y="44" width="400" height="160" rx="8" class="box-gd" />
<text x="34" y="64" class="t-b">{L("Majority: 4 of 5 nodes","Đa số: 4 trong 5 node")}</text>
<DiagramIcon name="server" x={70} y={118} size={32} />
<text x="70" y="158" class="t-m" text-anchor="middle">{L("Node A","Node A")}</text>
<DiagramIcon name="server" x={160} y={118} size={32} />
<text x="160" y="158" class="t-m" text-anchor="middle">{L("Node B","Node B")}</text>
<DiagramIcon name="server" x={250} y={118} size={32} />
<text x="250" y="158" class="t-m" text-anchor="middle">{L("Node C","Node C")}</text>
<DiagramIcon name="server" x={340} y={118} size={32} />
<text x="340" y="158" class="t-m" text-anchor="middle">{L("Node D","Node D")}</text>
<rect x="600" y="64" width="280" height="120" rx="6" class="box-r" />
<DiagramIcon name="server" x={634} y={106} size={30} />
<text x="664" y="98" class="t-r">{L("Node E","Node E")}</text>
<text x="664" y="118" class="t-m">{L("hears every heartbeat","nghe đủ mọi heartbeat")}</text>
<text x="664" y="136" class="t-m">{L("but its replies are dropped","nhưng mọi phản hồi bị rớt")}</text>
<text x="664" y="160" class="t-b">{L("It feels healthy.","Nó thấy mình khỏe.")}</text>
<path d="M 420 96 L 588.0 96.0" class="ln" /><polygon points="594,96 586.8,99.5 586.8,92.5" class="hd" />
<text x="507" y="86" class="t-m" text-anchor="middle">{L("1. heartbeats arrive","1. heartbeat tới nơi")}</text>
<path d="M 594 140 L 432.0 140.0" class="ln-d" /><polygon points="426,140 433.2,136.5 433.2,143.5" class="hd" />
<path d="M 504 134 L 516 146 M 504 146 L 516 134" class="ln-r" />
<text x="510" y="166" class="t-m" text-anchor="middle">{L("2. replies dropped","2. phản hồi bị rớt")}</text>
<rect x="20" y="222" width="860" height="64" rx="6" class="box-g" />
<DiagramIcon name="fail" x={46} y={254} size={26} />
<text x="76" y="247" class="t-b">{L("3. The majority hears no replies, times out, and declares E dead.","3. Đa số không nghe thấy phản hồi, hết giờ chờ và tuyên bố E đã chết.")}</text>
<text x="76" y="267" class="t-m">{L("Two majorities cannot exist at once, so E must step down even though it feels fine.","Không thể có hai đa số cùng lúc, nên E phải lùi dù tự thấy ổn.")}</text>
    </svg>
  </div>
  <figcaption>{L("The group's decision beats any single node's opinion of itself. That is what a quorum is for.", "Quyết định của cả nhóm thắng ý kiến của từng node về chính nó. Quorum sinh ra để làm vậy.")}</figcaption>
</figure>

<style>
  .dqa { margin: 2em 0; width: 100%; }
  .dqa-scroll { overflow-x: auto; }
  .dqa svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dqa text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .dqa .t-h { font-size: 15.5px; font-weight: 700; fill: var(--text); }
  .dqa .t-b { font-weight: 700; fill: var(--text); }
  .dqa .t-r { font-weight: 700; fill: var(--red); }
  .dqa .t-m { fill: var(--text-muted); font-size: 12.5px; }
  .dqa .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .dqa .box-r { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dqa .box-g { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.5; }
  .dqa .box-d { fill: transparent; stroke: var(--border); stroke-dasharray: 5 4; stroke-width: 1.2; }
  .dqa .box-gd { fill: transparent; stroke: var(--gold-icon); stroke-dasharray: 5 4; stroke-width: 1.4; }
  .dqa .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .dqa .ln-r { fill: none; stroke: var(--red); stroke-width: 2; }
  .dqa .ln-g { fill: none; stroke: var(--gold-icon); stroke-width: 2; }
  .dqa .ln-d { fill: none; stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .dqa .ln-rd { fill: none; stroke: var(--red); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .dqa .ln-gr { fill: none; stroke: var(--border); stroke-dasharray: 2 4; }
  .dqa .hd { fill: var(--text-muted); }
  .dqa .hd-r { fill: var(--red); }
  .dqa .hd-g { fill: var(--gold-icon); }
  .dqa .dot-g { fill: var(--gold-icon); }
  .dqa figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
