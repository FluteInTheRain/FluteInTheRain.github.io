---
// Which test runs under each command shown in the post. Results come from the four outputs.
// Icons: DiagramIcon (terminal = command, test = the two tests, ok / idle = runs / does not run). Motion: fm-glow on the cells that run.
import DiagramIcon from './DiagramIcon.astro';
const cmds = [
  { c: 'go test -v', a: { en: 'runs, 2.00s', vi: 'chạy, 2.00s', run: true }, b: { en: 'not compiled', vi: 'không được biên dịch', run: false } },
  { c: 'go test -short -v', a: { en: 'skipped, 0.00s', vi: 'bị bỏ qua, 0.00s', run: false }, b: { en: 'not compiled', vi: 'không được biên dịch', run: false } },
  { c: 'go test -tags=integration -v -run Real', a: { en: 'not selected by -run', vi: 'không được -run chọn', run: false }, b: { en: 'runs', vi: 'chạy', run: true } },
];
const top = 70;
const rh = 54;
---
<figure class="p06f">
  <div class="p06f-scroll">
  <svg viewBox="0 0 900 250" role="img" aria-label="Three commands against two tests. go test -v runs TestSlowDatabase for 2.00s and does not compile the tagged file. go test -short -v skips TestSlowDatabase. go test -tags=integration -v -run Real runs only TestAgainstRealDatabase.">
    <text x="20" y="40" class="m"><tspan data-lang-en>Command</tspan><tspan data-lang-vi>Lệnh</tspan></text>
    <DiagramIcon name="test" x={366} y={34} size={24} />
    <text x="390" y="40" class="b">TestSlowDatabase</text>
    <DiagramIcon name="test" x={646} y={34} size={24} />
    <text x="670" y="40" class="b">TestAgainstRealDatabase</text>
    <text x="670" y="58" class="s">//go:build integration</text>
    <line x1="20" x2="880" y1={top - 4} y2={top - 4} class="rule" />
    {cmds.map((r, i) => (
      <g>
        <DiagramIcon name="terminal" x={32} y={top + i * rh + 24} size={24} />
        <text x="52" y={top + i * rh + 30} class="b">{r.c}</text>
        {[{ x: 350, v: r.a }, { x: 630, v: r.b }].map((cell) => (
          <g>
            <rect x={cell.x} y={top + i * rh + 6} width="250" height="36" rx="6" class={cell.v.run ? 'box fm-glow' : 'skip'} />
            <DiagramIcon name={cell.v.run ? 'ok' : 'idle'} x={cell.x + 24} y={top + i * rh + 24} size={22} />
            <text x={cell.x + 137} y={top + i * rh + 29} text-anchor="middle" class={cell.v.run ? 'b' : 'm'}><tspan data-lang-en>{cell.v.en}</tspan><tspan data-lang-vi>{cell.v.vi}</tspan></text>
          </g>
        ))}
        <line x1="20" x2="880" y1={top + (i + 1) * rh - 4} y2={top + (i + 1) * rh - 4} class="rule" />
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>One test file, two ways to keep it out of the fast loop: skip at run time, or leave it out of the build until you pass the tag.</span>
    <span data-lang-vi>Hai cách để test chậm không làm chậm vòng lặp nhanh: bỏ qua lúc chạy, hoặc loại khỏi bản build cho đến khi bạn truyền tag.</span>
  </figcaption>
</figure>

<style>
  .p06f { margin: 2em 0; width: 100%; }
  .p06f-scroll { overflow-x: auto; }
  .p06f svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p06f text { font-size: 14px; fill: var(--text-body); }
  .p06f .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p06f .b { font-weight: 700; fill: var(--text); }
  .p06f .m { fill: var(--text-muted); }
  .p06f .s { font-size: 13px; fill: var(--text-muted); }
  .p06f .r { fill: var(--red); font-weight: 700; }
  .p06f .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .p06f .skip { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .p06f .hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .p06f .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .p06f .ln.cut { stroke-dasharray: 3 4; opacity: 0.5; }
  .p06f .ah { fill: var(--text-muted); }
  .p06f .rule { stroke: var(--border); stroke-width: 1; }
  .p06f .grid { stroke: var(--border); stroke-width: 1; }
  .p06f figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
