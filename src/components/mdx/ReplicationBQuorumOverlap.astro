---
// n = 3, w = 2, r = 2: the write set and the read set always share a replica when w + r > n.
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Bi from './ReplicationBBi.astro';
---
<Frame h={310}
  label="With n = 3, w = 2 and r = 2: a write reached replicas 1 and 2, so they hold v2. Replica 3 missed it and holds v1. A read asks replicas 2 and 3. It gets v2 and v1, keeps the newest, v2. Replica 2 is in both sets, which is guaranteed because w + r is greater than n."
  cap="The write set and the read set must overlap in at least one replica. That replica carries the newest value into the read."
  capVi="Tập ghi và tập đọc buộc phải trùng nhau ít nhất một replica. Replica đó mang giá trị mới nhất vào lần đọc.">
  <text x="300" y="30" text-anchor="middle" class="rb-h"><Bi en="Write reached replicas 1 and 2 (w = 2)" vi="Lần ghi tới replica 1 và 2 (w = 2)" /></text>
  <line x1="40" y1="46" x2="560" y2="46" class="rb-edge gold" />
  <line x1="40" y1="40" x2="40" y2="52" class="rb-edge gold" />
  <line x1="560" y1="40" x2="560" y2="52" class="rb-edge gold" />
  <Node x={40} y={80} w={220} h={96} icon="db" t="Replica 1" tv="Replica 1" s="x = v2" sv="x = v2" />
  <Node x={340} y={80} w={220} h={96} icon="db" t="Replica 2" tv="Replica 2" s="x = v2" sv="x = v2" s2="in both sets" s2v="nằm trong cả hai tập" cls="gold" />
  <Node x={640} y={80} w={220} h={96} icon="db" t="Replica 3" tv="Replica 3" s="x = v1" sv="x = v1" s2="missed the write" s2v="lỡ lần ghi" cls="red" />
  <line x1="340" y1="210" x2="860" y2="210" class="rb-edge" />
  <line x1="340" y1="204" x2="340" y2="216" class="rb-edge" />
  <line x1="860" y1="204" x2="860" y2="216" class="rb-edge" />
  <text x="600" y="236" text-anchor="middle" class="rb-h"><Bi en="Read asks replicas 2 and 3 (r = 2)" vi="Lần đọc hỏi replica 2 và 3 (r = 2)" /></text>
  <text x="450" y="280" text-anchor="middle" class="rb-t"><Bi en="It gets v2 and v1, and keeps the newest: v2. Overlap is guaranteed because 2 + 2 > 3." vi="Nó nhận v2 và v1, giữ cái mới nhất: v2. Trùng nhau là chắc chắn vì 2 + 2 > 3." /></text>
</Frame>
