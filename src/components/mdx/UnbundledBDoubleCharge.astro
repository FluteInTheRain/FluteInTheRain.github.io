---
// Sequence: a transfer commits, the response is lost, the retry commits a second time. Mirrors the SQL example in the post.
// Plain inline SVG with site CSS tokens; polygon arrowheads avoid duplicate marker ids.
import DiagramIcon from './DiagramIcon.astro';
---
<figure class="unb-fig">
  <div class="unb-scroll">
    <svg viewBox="0 0 900 484" role="img" aria-label="Sequence between phone, app server and database. The transfer commits, the 200 OK is lost when the signal drops, the phone retries on a new connection and the database runs a second transaction, so $22 moves instead of $11.">
      <text x="20" y="26" class="unb-h"><tspan data-lang-en>How one tap moves $22 instead of $11</tspan><tspan data-lang-vi>Một lần bấm làm chuyển $22 thay vì $11</tspan></text>
      <DiagramIcon name="phone" x={120} y={56} size={30} />
      <text x="120" y="90" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>Phone app</tspan><tspan data-lang-vi>App điện thoại</tspan></text>
      <DiagramIcon name="server" x={450} y={56} size={30} />
      <text x="450" y="90" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>App server</tspan><tspan data-lang-vi>App server</tspan></text>
      <DiagramIcon name="db" x={780} y={56} size={30} />
      <text x="780" y="90" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>Database</tspan><tspan data-lang-vi>Database</tspan></text>
      <line x1="120" y1="100" x2="120" y2="430" class="unb-solid is-dashedline" />
      <line x1="450" y1="100" x2="450" y2="430" class="unb-solid is-dashedline" />
      <line x1="780" y1="100" x2="780" y2="430" class="unb-solid is-dashedline" />
      <circle cx="40" cy="140" r="11" class="unb-step" /><text x="40" y="144.5" text-anchor="middle" class="unb-step-n">1</text>
      <path d="M120,140 L443,140" class="unb-solid" /><polygon points="442,135.5 442,144.5 450,140" class="unb-head" />
      <text x="285" y="131" text-anchor="middle" class="unb-note"><tspan data-lang-en>POST transfer $11, connection 1</tspan><tspan data-lang-vi>POST chuyển $11, kết nối 1</tspan></text>
      <circle cx="40" cy="194" r="11" class="unb-step" /><text x="40" y="198.5" text-anchor="middle" class="unb-step-n">2</text>
      <path d="M450,194 L773,194" class="unb-solid" /><polygon points="772,189.5 772,198.5 780,194" class="unb-head" />
      <text x="615" y="185" text-anchor="middle" class="unb-note"><tspan data-lang-en>run the transaction and COMMIT</tspan><tspan data-lang-vi>chạy transaction rồi COMMIT</tspan></text>
      <circle cx="40" cy="248" r="11" class="unb-step" /><text x="40" y="252.5" text-anchor="middle" class="unb-step-n">3</text>
      <path d="M780,248 L457,248" class="unb-solid" /><polygon points="458,243.5 458,252.5 450,248" class="unb-head" />
      <text x="615" y="239" text-anchor="middle" class="unb-note"><tspan data-lang-en>committed: $11 moved</tspan><tspan data-lang-vi>đã commit: $11 đã chuyển</tspan></text>
      <circle cx="40" cy="302" r="11" class="unb-step is-hot" /><text x="40" y="306.5" text-anchor="middle" class="unb-step-n is-hot">4</text>
      <path d="M450,302 L127,302" class="unb-dashed is-hot" /><polygon points="128,297.5 128,306.5 120,302" class="unb-head is-hot" />
      <text x="285" y="293" text-anchor="middle" class="unb-note is-hot"><tspan data-lang-en>200 OK is lost: the signal drops</tspan><tspan data-lang-vi>200 OK bị mất: mất sóng</tspan></text>
      <circle cx="40" cy="356" r="11" class="unb-step" /><text x="40" y="360.5" text-anchor="middle" class="unb-step-n">5</text>
      <path d="M120,356 L443,356" class="unb-solid" /><polygon points="442,351.5 442,360.5 450,356" class="unb-head" />
      <text x="285" y="347" text-anchor="middle" class="unb-note"><tspan data-lang-en>timeout: retry on connection 2</tspan><tspan data-lang-vi>hết giờ: thử lại trên kết nối 2</tspan></text>
      <circle cx="40" cy="410" r="11" class="unb-step is-hot" /><text x="40" y="414.5" text-anchor="middle" class="unb-step-n is-hot">6</text>
      <path d="M450,410 L773,410" class="unb-solid is-hot" /><polygon points="772,405.5 772,414.5 780,410" class="unb-head is-hot" />
      <text x="615" y="401" text-anchor="middle" class="unb-note is-hot"><tspan data-lang-en>new transaction runs again</tspan><tspan data-lang-vi>transaction mới chạy lần nữa</tspan></text>
      <text x="450" y="462" text-anchor="middle" class="unb-note is-hot"><tspan data-lang-en>The database sees a fresh connection and moves $11 a second time.</tspan><tspan data-lang-vi>Database thấy một kết nối mới và chuyển thêm $11 lần thứ hai.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>TCP removes duplicates only inside one connection. Once the socket breaks, the retry looks like a brand-new request.</span>
    <span data-lang-vi>TCP chỉ loại bỏ trùng lặp trong một kết nối. Khi socket đứt, lần thử lại trông như một request hoàn toàn mới.</span>
  </figcaption>
</figure>

<style>
  .unb-fig { margin: 2em 0; width: 100%; }
  .unb-scroll { overflow-x: auto; }
  .unb-fig svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .unb-fig text { font-size: 14px; fill: var(--text-body); }
  .unb-fig .unb-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .unb-fig .unb-lane-h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .unb-fig .unb-lane-sub { font-size: 13px; fill: var(--text-muted); }
  .unb-fig .unb-in-b { font-weight: 700; fill: var(--text); font-size: 13.5px; }
  .unb-fig .unb-in-m { font-size: 12.5px; fill: var(--text-muted); }
  .unb-fig .unb-note { font-size: 13px; fill: var(--text-muted); }
  .unb-fig .unb-note.is-hot { fill: var(--red); font-weight: 700; }
  .unb-fig .unb-note.is-good { fill: var(--gold-icon); font-weight: 700; }
  .unb-fig .unb-mono { font-size: 12.5px; fill: var(--text-body); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .unb-fig .unb-tick { font-size: 12.5px; fill: var(--text-muted); }
  .unb-panel { fill: none; stroke: var(--border); stroke-width: 1; }
  .unb-panel.is-fill { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .unb-panel.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .unb-panel.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.4; }
  .unb-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .unb-box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .unb-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .unb-box.is-dash { stroke-dasharray: 5 4; fill: none; }
  .unb-box.is-dash.is-good { fill: none; }
  .unb-box.is-dash.is-hot { fill: none; }
  .unb-solid { fill: none; stroke: var(--text-muted); stroke-width: 1.8; }
  .unb-solid.is-hot { stroke: var(--red); stroke-width: 2; }
  .unb-solid.is-good { stroke: var(--gold-icon); stroke-width: 2; }
  .unb-solid.is-dashedline { stroke-dasharray: 5 4; stroke-width: 1.2; }
  .unb-dashed { fill: none; stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .unb-dashed.is-hot { stroke: var(--red); stroke-width: 1.8; }
  .unb-dashed.is-good { stroke: var(--gold-icon); stroke-width: 1.8; }
  .unb-head { fill: var(--text-muted); }
  .unb-head.is-hot { fill: var(--red); }
  .unb-head.is-good { fill: var(--gold-icon); }
  .unb-step { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; }
  .unb-step.is-hot { fill: var(--red-tint-bg); stroke: var(--red); }
  .unb-step.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); }
  .unb-fig .unb-step-n { font-size: 12.5px; font-weight: 700; fill: var(--text); }
  .unb-fig figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
