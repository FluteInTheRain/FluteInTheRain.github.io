---
// Numbers (5 requests, 5 vs 1 connections, 5,000,000-byte body) come from the program in the post.
const lanes = [
  { y: 40, bad: true,
    en: 'Close with the body unread', vi: 'Close khi body chưa đọc hết',
    res_en: '5 requests, 5 connections', res_vi: '5 request, 5 connection',
    steps: [
      { en: ['Read the headers,', 'call Close'], vi: ['Chỉ đọc header,', 'rồi gọi Close'] },
      { en: ['Close drops the', 'connection'], vi: ['Close ngắt luôn', 'connection'] },
      { en: ['Next request dials', 'a new connection'], vi: ['Request sau phải', 'mở connection mới'] },
    ] },
  { y: 150, bad: false,
    en: 'Read to the end, then Close', vi: 'Đọc hết body rồi mới Close',
    res_en: '5 requests, 1 connection', res_vi: '5 request, 1 connection',
    steps: [
      { en: ['Read the body', 'to the end, Close'], vi: ['Đọc body đến hết,', 'rồi Close'] },
      { en: ['Connection goes back', 'to the idle pool'], vi: ['Connection về lại', 'pool rảnh'] },
      { en: ['Next request', 'reuses it'], vi: ['Request sau', 'dùng lại luôn'] },
    ] },
];
const xs = [20, 340, 660];
---
<figure class="gp14b">
  <div class="gp14b-scroll">
  <svg viewBox="0 0 900 270" role="img" aria-label="Two ways to finish an HTTP response. Closing with the body unread drops the connection, so five requests use five connections. Reading the body to the end returns the connection to the idle pool, so five requests use one.">
    {lanes.map((l) => (
      <g>
        <text x="20" y={l.y + 4} class={l.bad ? 'r' : 'b'}>
          <tspan data-lang-en>{l.en}</tspan><tspan data-lang-vi>{l.vi}</tspan>
        </text>
        <text x="880" y={l.y + 4} text-anchor="end" class="m num">
          <tspan data-lang-en>{l.res_en}</tspan><tspan data-lang-vi>{l.res_vi}</tspan>
        </text>
        {l.steps.map((s, i) => (
          <g>
            <rect x={xs[i]} y={l.y + 20} width="220" height="56" rx="6" class={l.bad && i > 0 ? 'bad' : 'box'} />
            <text x={xs[i] + 110} y={l.y + 44} text-anchor="middle">
              <tspan data-lang-en>{s.en[0]}</tspan><tspan data-lang-vi>{s.vi[0]}</tspan>
            </text>
            <text x={xs[i] + 110} y={l.y + 64} text-anchor="middle">
              <tspan data-lang-en>{s.en[1]}</tspan><tspan data-lang-vi>{s.vi[1]}</tspan>
            </text>
            {i < 2 && (
              <g>
                <line x1={xs[i] + 226} x2={xs[i] + 326} y1={l.y + 48} y2={l.y + 48} class="ln" />
                <polygon points={`${xs[i] + 334},${l.y + 48} ${xs[i] + 325},${l.y + 43} ${xs[i] + 325},${l.y + 53}`} class="ah" />
              </g>
            )}
          </g>
        ))}
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Measured with a 5,000,000-byte body on a local test server (program below). With a 1,000-byte body Go still opened 2 connections for 5 requests when the body was not read, so draining helps even for small answers.</span>
    <span data-lang-vi>Đo với body 5.000.000 byte trên một server thử ở máy local (chương trình ngay bên dưới). Với body 1.000 byte mà không đọc, Go vẫn mở 2 connection cho 5 request, nên đọc cạn có ích cả với phản hồi nhỏ.</span>
  </figcaption>
</figure>

<style>
  .gp14b { margin: 2em 0; width: 100%; }
  .gp14b-scroll { overflow-x: auto; }
  .gp14b svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp14b text { font-size: 14px; fill: var(--text-body); }
  .gp14b .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp14b .b { font-weight: 700; fill: var(--text); }
  .gp14b .m { fill: var(--text-muted); }
  .gp14b .r { fill: var(--red); font-weight: 700; }
  .gp14b .num { font-variant-numeric: tabular-nums; }
  .gp14b .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp14b .own { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp14b .bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
  .gp14b .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp14b .ah { fill: var(--text-muted); }
  .gp14b .grid { stroke: var(--border); stroke-width: 1; }
  .gp14b figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
