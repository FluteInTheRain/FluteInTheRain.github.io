  .bep9n3-scroll { overflow-x: auto; }
  .bep9n3 svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .bep9n3 text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep9n3 .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep9n3 .nm { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep9n3 .bs { fill: var(--text-muted); font-size: 13px; }
  .bep9n3 .redt { fill: var(--red); font-weight: 700; }
  .bep9n3 .code { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12.5px; fill: var(--text); }
  .bep9n3 .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep9n3 .redbox { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 2.2; }
  .bep9n3 .ln { stroke: var(--text-muted); stroke-width: 1.6; }
  .bep9n3 .redln { stroke: var(--red); stroke-width: 2.2; }
  .bep9n3 .hd { fill: var(--text-muted); }
  .bep9n3 .redhd { fill: var(--red); }
  .bep9n3 .bar { fill: var(--text-faint); }
  .bep9n3 .redbar { fill: var(--red); }
