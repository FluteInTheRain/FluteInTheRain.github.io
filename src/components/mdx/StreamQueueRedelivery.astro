---
import DiagramIcon from './DiagramIcon.astro';
// Why a shared queue plus acknowledgments reorders messages: a worker crashes before ACK,
// the broker redelivers its message to another worker, and the processing order flips.
// Plain inline SVG, site CSS tokens, polygon arrowheads (no SVG ids). Labels come from the lang prop.
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const W = 900, H = 330;
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 8 * Math.cos(a - 0.45), y2 - 8 * Math.sin(a - 0.45)];
  const p2 = [x2 - 8 * Math.cos(a + 0.45), y2 - 8 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const T = {
  en: {
    h: 'A crash before the ACK flips the order',
    broker: 'Shared queue', brokerSub: 'AMQP, waits for ACK',
    c1: 'Consumer 1', c2: 'Consumer 2', c2s: 'crashes before ACK',
    a1: '1  gives m3 to Consumer 2', a2: '2  gives m4 to Consumer 1', a4: '3  no ACK, redelivers m3',
    out: 'Consumer 1 finishes m4 first, then m3. The producer sent m3, then m4.',
    alt: 'A broker hands m3 to Consumer 2 and m4 to Consumer 1. Consumer 2 crashes before acknowledging, so the broker redelivers m3 to Consumer 1, which processes m4 and then m3, reversing the original order.',
    cap: 'Load balancing plus acknowledgments: redelivery after a crash scrambles the order the producer sent.',
  },
  vi: {
    h: 'Worker sập trước khi ACK làm đảo thứ tự',
    broker: 'Hàng đợi dùng chung', brokerSub: 'broker AMQP, chờ ACK',
    c1: 'Consumer 1', c2: 'Consumer 2', c2s: 'sập trước khi ACK',
    a1: '1  giao m3 cho Consumer 2', a2: '2  giao m4 cho Consumer 1', a4: '3  không có ACK, gửi lại m3',
    out: 'Consumer 1 xong m4 trước, rồi mới tới m3. Producer gửi m3 trước, m4 sau.',
    alt: 'Broker giao m3 cho Consumer 2 và m4 cho Consumer 1. Consumer 2 sập trước khi xác nhận nên broker gửi lại m3 cho Consumer 1, nơi xử lý m4 rồi m3, đảo ngược thứ tự ban đầu.',
    cap: 'Chia tải kết hợp xác nhận: gửi lại sau khi worker sập làm đảo thứ tự producer đã gửi.',
  },
}[lang];
const br = { x: 20, y: 70, w: 230, h: 130 };
const c1 = { x: 540, y: 40, w: 200, h: 56 };
const c2 = { x: 540, y: 170, w: 200, h: 70 };
const aC2 = arrow(br.x + br.w, 172, c2.x, 200);
const aC1 = arrow(br.x + br.w, 92, c1.x, 66);
const aRe = arrow(br.x + br.w, 128, c1.x, 88);
---
<figure class="sqr">
  <div class="sqr-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={T.alt}>
    <text x="20" y="24" class="h">{T.h}</text>
    <g class="box">
      <rect x={br.x} y={br.y} width={br.w} height={br.h} rx="7" />
      <text x={br.x + 62} y={br.y + 26} class="name">{T.broker}</text>
      <text x={br.x + 62} y={br.y + 46} class="sub">{T.brokerSub}</text>
      <rect x={br.x + 40} y={br.y + 66} width="70" height="36" rx="4" />
      <rect x={br.x + 120} y={br.y + 66} width="70" height="36" rx="4" />
      <text x={br.x + 75} y={br.y + 89} text-anchor="middle" class="num">m3</text>
      <text x={br.x + 155} y={br.y + 89} text-anchor="middle" class="num">m4</text>
    </g>
    <DiagramIcon name="rabbitmq" x={br.x + 32} y={br.y + 32} size={32} />
    <g class="box">
      <rect x={c1.x} y={c1.y} width={c1.w} height={c1.h} rx="7" />
      <text x={c1.x + c1.w / 2 + 14} y={c1.y + 34} text-anchor="middle" class="name">{T.c1}</text>
    </g>
    <DiagramIcon name="worker" x={c1.x + 30} y={c1.y + 28} size={28} />
    <g class="box off">
      <rect x={c2.x} y={c2.y} width={c2.w} height={c2.h} rx="7" />
      <text x={c2.x + c2.w / 2 + 14} y={c2.y + 30} text-anchor="middle" class="name">{T.c2}</text>
      <text x={c2.x + c2.w / 2 + 14} y={c2.y + 51} text-anchor="middle" class="bad">{T.c2s}</text>
    </g>
    <DiagramIcon name="worker" x={c2.x + 30} y={c2.y + 22} size={24} />
    <DiagramIcon name="fail" x={c2.x + 30} y={c2.y + 54} size={14} />
    <g class="arr"><path d={aC2.line} /><polygon points={aC2.head} /></g>
    <g class="arr"><path d={aC1.line} /><polygon points={aC1.head} /></g>
    <g class="arr bad"><path d={aRe.line} /><polygon points={aRe.head} /></g>
    <text x="395" y="216" text-anchor="middle" class="sub">{T.a1}</text>
    <text x="395" y="64" text-anchor="middle" class="sub">{T.a2}</text>
    <text x="395" y="142" text-anchor="middle" class="bad">{T.a4}</text>
    <line x1="20" x2={W - 20} y1="268" y2="268" class="rule" />
    <text x={W / 2} y="302" text-anchor="middle" class="name">{T.out}</text>
  </svg>
  </div>
  <figcaption>{T.cap}</figcaption>
</figure>

<style>
  .sqr { margin: 2em 0; width: 100%; }
  .sqr-scroll { overflow-x: auto; }
  .sqr svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sqr text { font-size: 14px; fill: var(--text-body); }
  .sqr .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sqr .name { font-weight: 700; fill: var(--text); }
  .sqr .sub { font-size: 13px; fill: var(--text-muted); font-variant-numeric: tabular-nums; }
  .sqr .bad { font-size: 13px; fill: var(--red); }
  .sqr .num { font-size: 13px; font-weight: 700; fill: var(--text); font-variant-numeric: tabular-nums; }
  .sqr .box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .sqr .box.off rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .sqr .box.dash rect { stroke-dasharray: 4 4; fill: none; }
  .sqr .arr path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .sqr .arr polygon { fill: var(--text-muted); }
  .sqr .arr.bad path { stroke: var(--red); stroke-dasharray: 5 4; }
  .sqr .arr.bad polygon { fill: var(--red); }
  .sqr .rule { stroke: var(--border); stroke-width: 1; }
  .sqr figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
