---
// Icons: search = a check, warning = early error return, ok = success path. Motion: fm-glow on the highlighted success rows.
import DiagramIcon from './DiagramIcon.astro';
// Same checks as join(s1, s2, max), drawn nested versus flat. Layout is illustrative.
const W = 900;
const H = 330;
const nested = [
  { t: 'if s1 != ""', ind: 0, ic: 'search' },
  { t: 'if s2 != ""', ind: 1, ic: 'search' },
  { t: 'if len(concat) <= max', ind: 2, ic: 'search' },
  { t: 'return concat, nil', ind: 3, ok: true, ic: 'ok' },
];
const flat = [
  { t: 'if s1 == "" { return error }', ic: 'warning' },
  { t: 'if s2 == "" { return error }', ic: 'warning' },
  { t: 'if len(concat) > max { return error }', ic: 'warning' },
  { t: 'return concat, nil', ok: true, ic: 'ok' },
];
---
<figure class="gp02e">
  <div class="gp02e-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: the success path moves further right with every nested if. Right: each check returns early, and the success path stays in one column at the left edge.">
    <text x="20" y="26" class="h"><tspan data-lang-en>Nested: the normal path drifts right</tspan><tspan data-lang-vi>Lồng nhau: đường chạy bình thường trôi sang phải</tspan></text>
    {nested.map((r, k) => {
      const y = 50 + k * 54;
      const x = 24 + r.ind * 34;
      return (
        <g>
          <rect x={x} y={y} width={250} height="40" rx="6" class={r.ok ? 'box hi fm-glow' : 'box'} />
          <DiagramIcon name={r.ic} x={x + 250 - 22} y={y + 20} size={24} />
          <text x={x + 14} y={y + 25} class="strong">{r.t}</text>
        </g>
      );
    })}
    <text x="20" y="290" class="muted"><tspan data-lang-en>To find the success path you follow the staircase.</tspan><tspan data-lang-vi>Muốn thấy đường thành công phải lần theo bậc thang.</tspan></text>

    <line x1="450" y1="14" x2="450" y2="310" style="stroke: var(--border)" />

    <text x="480" y="26" class="h"><tspan data-lang-en>Early return: the normal path stays left</tspan><tspan data-lang-vi>Return sớm: đường bình thường nằm sát trái</tspan></text>
    {flat.map((r, k) => {
      const y = 50 + k * 54;
      return (
        <g>
          <rect x="484" y={y} width={380} height="40" rx="6" class={r.ok ? 'box hi fm-glow' : 'box'} />
          <DiagramIcon name={r.ic} x={842} y={y + 20} size={24} />
          <text x="498" y={y + 25} class="strong">{r.t}</text>
        </g>
      );
    })}
    <text x="480" y="290" class="muted"><tspan data-lang-en>Read down the left edge: that is the success path.</tspan><tspan data-lang-vi>Đọc dọc mép trái: đó là đường thành công.</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Both versions do the same checks as join. Only the shape differs. The highlighted line is the success path. The nested version is a sketch, not code from the post.</span>
    <span data-lang-vi>Hai phiên bản kiểm tra giống hệt hàm join, chỉ khác hình dạng. Dòng được tô là đường thành công. Bản lồng nhau chỉ là hình minh họa, không phải code trong bài.</span>
  </figcaption>
</figure>

<style>
  .gp02e { margin: 2em 0; width: 100%; }
  .gp02e-scroll { overflow-x: auto; }
  .gp02e svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp02e text { font-size: 14px; fill: var(--text-body); }
  .gp02e .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .gp02e .muted { fill: var(--text-muted); }
  .gp02e .strong { font-weight: 700; fill: var(--text); }
  .gp02e .red { fill: var(--red); font-weight: 700; }
  .gp02e .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }

  .gp02e .hi { stroke: var(--text); stroke-width: 2.4; }
  .gp02e .ghost { fill: none; stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .gp02e .axis { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp02e .line { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp02e .line-red { stroke: var(--red); stroke-width: 1.8; fill: none; }
  .gp02e .head { fill: var(--text-muted); }
  .gp02e .head-red { fill: var(--red); }
  .gp02e .num { font-variant-numeric: tabular-nums; }
  .gp02e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
