---
import DiagramIcon from './DiagramIcon.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const L = (en: string, vi: string) => (lang === 'vi' ? vi : en);
const W = 900;
const H = 300;
---
<figure class="dno">
  <div class="dno-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L("Four time servers: three report times within 2 milliseconds of each other, one reports a time more than three minutes off. The NTP client keeps the three that agree and drops the outlier.", "Bốn time server: ba server báo giờ lệch nhau trong 2 mili-giây, một server lệch hơn ba phút. Client NTP giữ ba server khớp nhau và bỏ server lệch.")}>
<text x="20" y="24" class="t-h">{L("Asking several time servers lets one bad clock be outvoted","Hỏi nhiều time server để một đồng hồ sai bị loại theo đa số")}</text>
<rect x="20" y="48" width="290" height="52" rx="6" class="box" />
<DiagramIcon name="server" x={46} y={74} size={26} />
<text x="72" y="70" class="t-b">{L("Time server 1","Time server 1")}</text>
<text x="72" y="88" class="t-m">{L("reports 10:00:42.003","báo 10:00:42.003")}</text>
<DiagramIcon name="ok" x={286} y={74} size={20} />
<path d="M 310 74 L 568.2 148.3" class="ln-g" /><polygon points="574,150 566.1,151.4 568.0,144.7" class="hd-g" />
<rect x="20" y="110" width="290" height="52" rx="6" class="box" />
<DiagramIcon name="server" x={46} y={136} size={26} />
<text x="72" y="132" class="t-b">{L("Time server 2","Time server 2")}</text>
<text x="72" y="150" class="t-m">{L("reports 10:00:42.004","báo 10:00:42.004")}</text>
<DiagramIcon name="ok" x={286} y={136} size={20} />
<path d="M 310 136 L 568.0 163.4" class="ln-g" /><polygon points="574,164 566.5,166.7 567.2,159.8" class="hd-g" />
<rect x="20" y="172" width="290" height="52" rx="6" class="box" />
<DiagramIcon name="server" x={46} y={198} size={26} />
<text x="72" y="194" class="t-b">{L("Time server 3","Time server 3")}</text>
<text x="72" y="212" class="t-m">{L("reports 10:00:42.005","báo 10:00:42.005")}</text>
<DiagramIcon name="ok" x={286} y={198} size={20} />
<path d="M 310 198 L 568.0 178.5" class="ln-g" /><polygon points="574,178 567.1,182.0 566.6,175.1" class="hd-g" />
<rect x="20" y="234" width="290" height="52" rx="6" class="box-r" />
<DiagramIcon name="server" x={46} y={260} size={26} />
<text x="72" y="256" class="t-r">{L("Time server 4","Time server 4")}</text>
<text x="72" y="274" class="t-m">{L("reports 10:03:17.000","báo 10:03:17.000")}</text>
<DiagramIcon name="fail" x={286} y={260} size={20} />
<path d="M 310 260 L 568.2 193.5" class="ln-rd" /><polygon points="574,192 567.9,197.2 566.2,190.4" class="hd-r" />
<rect x="580" y="110" width="300" height="110" rx="6" class="box-g" />
<DiagramIcon name="clock" x={614} y={148} size={32} />
<text x="646" y="140" class="t-b">{L("Your NTP client","Client NTP của bạn")}</text>
<text x="646" y="160" class="t-m">{L("keeps the three that agree","giữ ba server khớp nhau")}</text>
<text x="646" y="178" class="t-m">{L("and drops the outlier","và bỏ server lệch")}</text>
    </svg>
  </div>
  <figcaption>{L("A cheap defence against one kind of lying: never trust a single source of time.", "Một cách phòng thủ rẻ trước một dạng nói dối: đừng bao giờ tin vào một nguồn giờ duy nhất.")}</figcaption>
</figure>

<style>
  .dno { margin: 2em 0; width: 100%; }
  .dno-scroll { overflow-x: auto; }
  .dno svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dno text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .dno .t-h { font-size: 15.5px; font-weight: 700; fill: var(--text); }
  .dno .t-b { font-weight: 700; fill: var(--text); }
  .dno .t-r { font-weight: 700; fill: var(--red); }
  .dno .t-m { fill: var(--text-muted); font-size: 12.5px; }
  .dno .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .dno .box-r { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dno .box-g { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.5; }
  .dno .box-d { fill: transparent; stroke: var(--border); stroke-dasharray: 5 4; stroke-width: 1.2; }
  .dno .box-gd { fill: transparent; stroke: var(--gold-icon); stroke-dasharray: 5 4; stroke-width: 1.4; }
  .dno .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .dno .ln-r { fill: none; stroke: var(--red); stroke-width: 2; }
  .dno .ln-g { fill: none; stroke: var(--gold-icon); stroke-width: 2; }
  .dno .ln-d { fill: none; stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .dno .ln-rd { fill: none; stroke: var(--red); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .dno .ln-gr { fill: none; stroke: var(--border); stroke-dasharray: 2 4; }
  .dno .hd { fill: var(--text-muted); }
  .dno .hd-r { fill: var(--red); }
  .dno .hd-g { fill: var(--gold-icon); }
  .dno .dot-g { fill: var(--gold-icon); }
  .dno figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
