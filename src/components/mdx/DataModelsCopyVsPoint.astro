---
import DiagramIcon from './DiagramIcon.astro';
// Copy a value into every place, or store an id and look it up: same data, two designs, using the Jane example from the Diaspora story.
// Arrowheads are polygons: no SVG ids.
const W = 900;
const H = 350;
type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}
const frames: any[] = [];
const boxes: any[] = [];
const links: any[] = [];
const labels: any[] = [];
const nums: any[] = [];
frames.push({ x: 10, y: 10, w: 430, h: 330, kind: 'bad' }, { x: 460, y: 10, w: 430, h: 330, kind: 'good' });
labels.push(
  { x: 28, y: 42, en: 'Copy the value everywhere', vi: 'Chép giá trị ra mọi chỗ', cls: 'h' },
  { x: 478, y: 42, en: 'Store an id, look it up', vi: 'Lưu id, cần thì tra', cls: 'h' },
  { x: 28, y: 238, en: 'Jane renames herself: 3 records to rewrite', vi: 'Jane đổi tên: phải sửa 3 bản ghi', cls: 'bad' },
  { x: 478, y: 238, en: 'Jane renames herself: 1 record to edit', vi: 'Jane đổi tên: sửa 1 bản ghi', cls: 'good' },
);
const L = [['Post by Jane', 'Bài viết của Jane'], ['Comment by Jane', 'Bình luận của Jane'], ['Like by Jane', 'Lượt thích của Jane']];
const R = [['Post by user 7', 'Bài viết của user 7'], ['Comment by user 7', 'Bình luận của user 7'], ['Like by user 7', 'Lượt thích của user 7']];
L.forEach((t, k) => boxes.push({ x: 28, y: 62 + k * 52, w: 390, h: 38, icon: 'file', is: 20, kind: 'bad', flat: true, en: [t[0]], vi: [t[1]] }));
R.forEach((t, k) => {
  boxes.push({ x: 478, y: 62 + k * 52, w: 220, h: 38, icon: 'file', is: 20, flat: true, en: [t[0]], vi: [t[1]] });
  links.push({ pts: [[698, 81 + k * 52], [736, 112 + k * 22]] });
});
boxes.push({ x: 736, y: 96, w: 136, h: 72, icon: 'db', kind: 'good', en: ['users', '7 = Jane'], vi: ['users', '7 = Jane'] });
boxes.push(
  { x: 28, y: 258, w: 192, h: 62, en: ['Writing: slower', 'every copy must change'], vi: ['Ghi: chậm hơn', 'mọi bản chép đều phải sửa'] },
  { x: 228, y: 258, w: 190, h: 62, en: ['Reading: faster', 'no lookup needed'], vi: ['Đọc: nhanh hơn', 'không cần tra thêm'] },
  { x: 478, y: 258, w: 192, h: 62, en: ['Writing: faster', 'one place to change'], vi: ['Ghi: nhanh hơn', 'chỉ một chỗ để sửa'] },
  { x: 678, y: 258, w: 200, h: 62, en: ['Reading: slower', 'one more lookup (a join)'], vi: ['Đọc: chậm hơn', 'thêm một lần tra (join)'] },
);
---
<figure class="dmcp">
  <div class="dmcp-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two designs for the same data. Left: Jane's name is copied into a post, a comment and a like, so renaming her means rewriting three records; writing is slower, reading is faster. Right: those three records hold user id 7 and point to one users record, so a rename is one edit; writing is faster, reading needs one more lookup, a join.">
    {frames.map((f) => (
      <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="6" class={`dmcp-frame ${f.kind ?? ''}`} />
    ))}
    {boxes.map((b) => {
      const n = Math.max(b.en.length, b.vi.length);
      const top = !!b.top;
      const cx = b.x + b.w / 2;
      const x0 = top ? cx : b.icon ? b.x + 46 : b.x + 14;
      const y0 = top ? b.y + (b.icon ? 56 : 24) : b.y + b.h / 2 - ((n - 1) * 17) / 2 + 4;
      return (
        <g class={`dmcp-box ${b.kind ?? ''}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
          {b.icon && <DiagramIcon name={b.icon} x={top ? cx : b.x + 24} y={top ? b.y + 24 : b.y + b.h / 2} size={b.is ?? 26} />}
          {Array.from({ length: n }).map((_, i) => (
            <text x={x0} y={y0 + i * 17} text-anchor={top ? 'middle' : 'start'} class={i === 0 && !b.flat ? 'dmcp-name' : 'dmcp-sub'}>
              <tspan data-lang-en>{b.en[i] ?? ''}</tspan>
              <tspan data-lang-vi>{b.vi[i] ?? ''}</tspan>
            </text>
          ))}
        </g>
      );
    })}
    {links.map((l) => {
      const a = arrow(l.pts);
      return (
        <g>
          <polyline points={l.plain ? l.pts.map((p) => p.join(',')).join(' ') : a.line} class={`dmcp-edge ${l.kind ?? ''}`} fill="none" />
          {!l.plain && <polygon points={a.head} class={`dmcp-head ${l.kind ?? ''}`} />}
        </g>
      );
    })}
    {labels.map((t) => (
      <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`dmcp-lab ${t.cls ?? ''}`}>
        <tspan data-lang-en>{t.en}</tspan>
        <tspan data-lang-vi>{t.vi ?? t.en}</tspan>
      </text>
    ))}
    {nums.map((n) => (
      <g class="dmcp-num">
        <circle cx={n.x} cy={n.y} r="11" />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.n}</text>
      </g>
    ))}

  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Like a phone contact against the same number written on every sticky note: one edit against a hunt. The price of the single copy is the lookup on every read.</span>
    <span data-lang-vi>Giống danh bạ điện thoại so với việc ghi cùng một số lên mọi tờ giấy nhớ: một lần sửa so với một cuộc đi tìm. Cái giá của bản duy nhất là phải tra mỗi lần đọc.</span>
  </figcaption>
</figure>

<style>
  .dmcp { margin: 2em 0; width: 100%; }
  .dmcp-scroll { overflow-x: auto; }
  .dmcp svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dmcp text { font-size: 14px; fill: var(--text-body); }
  .dmcp .dmcp-name { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .dmcp .dmcp-sub { font-size: 12px; fill: var(--text-muted); }
  .dmcp .dmcp-lab { font-size: 13px; }
  .dmcp .dmcp-lab.h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dmcp .dmcp-lab.strong { font-weight: 700; fill: var(--text); }
  .dmcp .dmcp-lab.muted { fill: var(--text-muted); }
  .dmcp .dmcp-lab.bad { font-weight: 700; fill: var(--red); }
  .dmcp .dmcp-lab.good { font-weight: 700; fill: var(--text); }
  .dmcp .dmcp-lab.mono, .dmcp .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .dmcp-frame { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .dmcp-frame.bad { stroke: var(--red); }
  .dmcp-frame.good { stroke: var(--gold); }
  .dmcp-box rect { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmcp-box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dmcp-box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmcp-box.plain rect { fill: none; stroke: var(--border); }
  .dmcp-edge { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmcp-edge.bad { stroke: var(--red); }
  .dmcp-edge.good { stroke: var(--gold-icon); }
  .dmcp-head { fill: var(--text-muted); }
  .dmcp-head.bad { fill: var(--red); }
  .dmcp-head.good { fill: var(--gold-icon); }
  .dmcp-num circle { fill: var(--bg-alt); stroke: var(--text-muted); }
  .dmcp-num text { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dmcp figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
