---
import DiagramIcon from './DiagramIcon.astro';
// The nine TFBO steps: a functionality phase (1-3) and an efficiency phase (4-8), then release (9).
const W = 900;
const H = 360;
const r1 = [
  { x: 24, en: ['1  Test the', 'behavior'], vi: ['1  Viết test', 'cho hành vi'] },
  { x: 294, en: ['2  Do the', 'tests pass?'], vi: ['2  Test đã', 'qua chưa?'] },
  { x: 564, en: ['3  Fix the code', '(no tuning yet)'], vi: ['3  Sửa code', '(chưa tối ưu)'] },
];
const r2 = [
  { x: 20, en: ['4  Measure a', 'baseline'], vi: ['4  Đo mốc', 'ban đầu'] },
  { x: 198, en: ['5  Within', 'the RAER?'], vi: ['5  Đạt RAER', 'chưa?'] },
  { x: 376, en: ['6  Find the', 'bottleneck'], vi: ['6  Tìm điểm', 'nghẽn'] },
  { x: 554, en: ['7  Pick one', 'level'], vi: ['7  Chọn đúng', 'một tầng'] },
  { x: 732, en: ['8  Optimize,', 'then back to 1'], vi: ['8  Tối ưu, rồi', 'quay lại 1'] },
];
const i1 = ['test', 'question', 'code'] as const;
const i2 = ['measure', 'goal', 'search', 'ladder', 'speedup'] as const;
---
<figure class="gp15d">
  <div class="gp15d-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="TFBO flow. Functionality phase: 1 test the behavior, 2 do the tests pass, if not 3 fix the code and test again. Efficiency phase: 4 measure a baseline, 5 within the RAER, if yes 9 release, if not 6 find the bottleneck, 7 pick one level, 8 optimize, then go back to step 1.">
    <rect x="10" y="16" width="880" height="124" rx="10" class="band" />
    <text x="24" y="34" class="b">
      <tspan data-lang-en>Functionality phase</tspan>
      <tspan data-lang-vi>Giai đoạn chức năng</tspan>
    </text>
    <rect x="10" y="156" width="880" height="124" rx="10" class="band" />
    <text x="24" y="268" class="b">
      <tspan data-lang-en>Efficiency phase</tspan>
      <tspan data-lang-vi>Giai đoạn hiệu năng</tspan>
    </text>

    {r1.map((b) => (
      <g>
        <rect x={b.x} y="64" width="190" height="52" rx="8" class="box" />
        <DiagramIcon name={i1[r1.indexOf(b)]} x={b.x + 28} y={90} size={26} />
        {b.en.map((_, k) => (
          <text x={b.x + 52} y={86 + k * 18} class="body">
            <tspan data-lang-en>{b.en[k]}</tspan>
            <tspan data-lang-vi>{b.vi[k]}</tspan>
          </text>
        ))}
      </g>
    ))}
    {r2.map((b, i) => (
      <g>
        <rect x={b.x} y="180" width="152" height="56" rx="8" class="box" />
        <DiagramIcon name={i2[i]} x={b.x + 24} y={208} size={26} />
        {b.en.map((_, k) => (
          <text x={b.x + 46} y={204 + k * 18} class="body">
            <tspan data-lang-en>{b.en[k]}</tspan>
            <tspan data-lang-vi>{b.vi[k]}</tspan>
          </text>
        ))}
      </g>
    ))}
    <rect x="204" y="300" width="140" height="44" rx="8" class="goldbox" />
    <DiagramIcon name="package" x={228} y={322} size={26} />
    <text x="252" y="327" class="b">
      <tspan data-lang-en>9  Release</tspan>
      <tspan data-lang-vi>9  Phát hành</tspan>
    </text>

    {/* functionality row */}
    <line x1="214" x2="285" y1="90" y2="90" class="ln" />
    <polygon points="294,90 285,85 285,95" class="ah" />
    <line x1="484" x2="555" y1="90" y2="90" class="ln" />
    <polygon points="564,90 555,85 555,95" class="ah" />
    <text x="520" y="82" text-anchor="middle" class="m">
      <tspan data-lang-en>no</tspan>
      <tspan data-lang-vi>chưa</tspan>
    </text>
    {/* loop 3 -> 1 and 8 -> 1 */}
    <polyline points="659,64 659,48 119,48 119,55" class="ln" />
    <polygon points="119,64 114,55 124,55" class="ah" />
    <polyline points="808,180 808,48 659,48" class="ln fm-flow" />
    {/* 2 -> 4 */}
    <polyline points="389,116 389,147 96,147 96,171" class="ln" />
    <polygon points="96,180 91,171 101,171" class="ah" />
    <text x="397" y="136" class="m">
      <tspan data-lang-en>yes</tspan>
      <tspan data-lang-vi>rồi</tspan>
    </text>
    {/* efficiency row */}
    <line x1="172" x2="189" y1="208" y2="208" class="ln" />
    <polygon points="198,208 189,203 189,213" class="ah" />
    <line x1="350" x2="367" y1="208" y2="208" class="ln" />
    <polygon points="376,208 367,203 367,213" class="ah" />
    <text x="363" y="199" text-anchor="middle" class="m">
      <tspan data-lang-en>no</tspan>
      <tspan data-lang-vi>chưa</tspan>
    </text>
    <line x1="528" x2="545" y1="208" y2="208" class="ln" />
    <polygon points="554,208 545,203 545,213" class="ah" />
    <line x1="706" x2="723" y1="208" y2="208" class="ln" />
    <polygon points="732,208 723,203 723,213" class="ah" />
    <line x1="274" x2="274" y1="236" y2="291" class="ln" />
    <polygon points="274,300 269,291 279,291" class="ah" />
    <text x="284" y="270" class="m">
      <tspan data-lang-en>yes</tspan>
      <tspan data-lang-vi>rồi</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>TFBO stands for Test, Fix, Benchmark, Optimize. Every optimization goes back through step 1, so a faster program is also checked for being correct.</span>
    <span data-lang-vi>TFBO là Test, Fix, Benchmark, Optimize. Mỗi lần tối ưu đều quay lại bước 1, nên bản chạy nhanh hơn vẫn được kiểm tra là đúng.</span>
  </figcaption>
</figure>

<style>
  .gp15d { margin: 2em 0; width: 100%; }
  .gp15d-scroll { overflow-x: auto; }
  .gp15d svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .gp15d text { font-size: 14px; fill: var(--text-body); }
  .gp15d .b { font-weight: 700; fill: var(--text); }
  .gp15d .body { font-size: 13.5px; fill: var(--text-body); }
  .gp15d .m { fill: var(--text-muted); font-size: 13px; }
  .gp15d .band { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .gp15d .box { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp15d .goldbox { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.2; }
  .gp15d .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp15d .ah { fill: var(--text-muted); }
  .gp15d figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
