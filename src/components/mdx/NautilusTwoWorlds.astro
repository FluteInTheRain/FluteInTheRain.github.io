---
// Side-by-side showdown:
//  left  = the usual setup: research code in Python, then a hand rewrite into a separate
//          production engine (C++ / Java / Go), so the two copies drift apart (parity drift);
//  right = NautilusTrader: one Python strategy on one shared Rust kernel (NautilusKernel),
//          run either by BacktestNode (Parquet + TestClock) or TradingNode (WebSocket / FIX + LiveClock).
// Plain inline SVG with site tokens; arrowheads are plain polygons, so no ids are needed.

const W = 900;
const H = 404;

// Arrow drawn as a line plus a small filled triangle (no SVG markers needed).
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

// Left column
const LX = 20;
const LW = 400;
const LC = LX + LW / 2;
const research = { y: 56, h: 74 };
const prod = { y: 220, h: 74 };
const rewrite = arrow(LC, research.y + research.h, LC, prod.y);

// Right column
const RX = 480;
const RW = 400;
const RC = RX + RW / 2;
const strat = { y: 56, h: 66 };
const kernel = { y: 146, h: 66 };
const nodeY = 238;
const nodeH = 76;
const nodeW = 192;
const nodes = [
  { x: RX, name: 'BacktestNode', en1: 'historical Parquet data', vi1: 'dữ liệu lịch sử Parquet', two: 'TestClock' },
  { x: RX + RW - nodeW, name: 'TradingNode', en1: 'live WebSocket / FIX', vi1: 'WebSocket / FIX thật', two: 'LiveClock' },
];
const toKernel = arrow(RC, strat.y + strat.h, RC, kernel.y);
const toNodes = nodes.map((n) => arrow(RC + (n.x + nodeW / 2 - RC) * 0.35, kernel.y + kernel.h, n.x + nodeW / 2, nodeY));
---
<figure class="ntw">
  <div class="ntw-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: strategies are researched in Python, then rewritten by hand into a separate C++, Java or Go production engine, and the two copies drift apart. Right: NautilusTrader runs one Python strategy on one shared Rust kernel, used both by BacktestNode with historical data and TradingNode with live venues.">
      <line x1={W / 2} x2={W / 2} y1="10" y2={H - 10} class="ntw-rule" />

      {/* ---------- Left: two codebases ---------- */}
      <text x={LX} y="28" class="ntw-h">
        <tspan data-lang-en>The usual way: two codebases</tspan>
        <tspan data-lang-vi>Cách thường làm: hai codebase</tspan>
      </text>

      <g class="ntw-box">
        <rect x={LX} y={research.y} width={LW} height={research.h} rx="8" />
        <text x={LX + 16} y={research.y + 30} class="ntw-name">
          <tspan data-lang-en>Research: Python / pandas</tspan>
          <tspan data-lang-vi>Nghiên cứu: Python / pandas</tspan>
        </text>
        <text x={LX + 16} y={research.y + 54} class="ntw-sub">
          <tspan data-lang-en>backtests assume zero latency and instant fills</tspan>
          <tspan data-lang-vi>backtest coi như không có độ trễ, lệnh khớp ngay</tspan>
        </text>
      </g>

      <g class="ntw-arrow is-red"><path d={rewrite.line} /><polygon points={rewrite.head} /></g>
      <text x={LC + 16} y={research.y + research.h + 38} class="ntw-red">
        <tspan data-lang-en>rewritten by hand</tspan>
        <tspan data-lang-vi>viết lại bằng tay</tspan>
      </text>
      <text x={LC + 16} y={research.y + research.h + 58} class="ntw-red-sub">
        <tspan data-lang-en>into C++, Java or Go</tspan>
        <tspan data-lang-vi>sang C++, Java hoặc Go</tspan>
      </text>

      <g class="ntw-box">
        <rect x={LX} y={prod.y} width={LW} height={prod.h} rx="8" />
        <text x={LX + 16} y={prod.y + 30} class="ntw-name">
          <tspan data-lang-en>Production: C++ / Java / Go</tspan>
          <tspan data-lang-vi>Chạy thật: C++ / Java / Go</tspan>
        </text>
        <text x={LX + 16} y={prod.y + 54} class="ntw-sub">
          <tspan data-lang-en>live exchange sockets, real risk checks</tspan>
          <tspan data-lang-vi>nối cổng sàn thật, kiểm tra rủi ro thật</tspan>
        </text>
      </g>

      <text x={LX} y="350" class="ntw-bad">
        <tspan data-lang-en>The two copies drift apart: parity drift</tspan>
        <tspan data-lang-vi>Hai bản logic lệch nhau dần: parity drift</tspan>
      </text>
      <text x={LX} y="374" class="ntw-sub">
        <tspan data-lang-en>rounding, fees and order timing differ, so a</tspan>
        <tspan data-lang-vi>làm tròn, phí, thứ tự khớp lệnh khác nhau, nên</tspan>
      </text>
      <text x={LX} y="394" class="ntw-sub">
        <tspan data-lang-en>profitable backtest can lose money live</tspan>
        <tspan data-lang-vi>backtest có lãi mà lên live vẫn có thể lỗ</tspan>
      </text>

      {/* ---------- Right: one engine ---------- */}
      <text x={RX} y="28" class="ntw-h">
        <tspan data-lang-en>NautilusTrader: one engine for both</tspan>
        <tspan data-lang-vi>NautilusTrader: một engine cho cả hai</tspan>
      </text>

      <g class="ntw-box">
        <rect x={RX} y={strat.y} width={RW} height={strat.h} rx="8" />
        <text x={RX + 16} y={strat.y + 27} class="ntw-name">
          <tspan data-lang-en>Strategy, written once in Python</tspan>
          <tspan data-lang-vi>Strategy viết một lần bằng Python</tspan>
        </text>
        <text x={RX + 16} y={strat.y + 50} class="ntw-sub">on_quote_tick(), on_bar(), submit_order()</text>
      </g>

      <g class="ntw-arrow"><path d={toKernel.line} /><polygon points={toKernel.head} /></g>

      <g class="ntw-box is-core">
        <rect x={RX} y={kernel.y} width={RW} height={kernel.h} rx="8" />
        <text x={RX + 16} y={kernel.y + 27} class="ntw-name">
          <tspan data-lang-en>NautilusKernel, the shared Rust core</tspan>
          <tspan data-lang-vi>NautilusKernel, lõi Rust dùng chung</tspan>
        </text>
        <text x={RX + 16} y={kernel.y + 50} class="ntw-sub">
          <tspan data-lang-en>same state machines, risk rules, order checks</tspan>
          <tspan data-lang-vi>cùng máy trạng thái, luật rủi ro, kiểm tra lệnh</tspan>
        </text>
      </g>

      {toNodes.map((a) => <g class="ntw-arrow"><path d={a.line} /><polygon points={a.head} /></g>)}

      {nodes.map((n) => (
        <g class="ntw-box">
          <rect x={n.x} y={nodeY} width={nodeW} height={nodeH} rx="8" />
          <text x={n.x + nodeW / 2} y={nodeY + 25} text-anchor="middle" class="ntw-name">{n.name}</text>
          <text x={n.x + nodeW / 2} y={nodeY + 46} text-anchor="middle" class="ntw-sub">
            <tspan data-lang-en>{n.en1}</tspan>
            <tspan data-lang-vi>{n.vi1}</tspan>
          </text>
          <text x={n.x + nodeW / 2} y={nodeY + 64} text-anchor="middle" class="ntw-sub">+ {n.two}</text>
        </g>
      ))}

      <text x={RX} y="350" class="ntw-good">
        <tspan data-lang-en>Backtest and live run the same code path</tspan>
        <tspan data-lang-vi>Backtest và live chạy cùng một đường code</tspan>
      </text>
      <text x={RX} y="374" class="ntw-sub">
        <tspan data-lang-en>only the adapters and the clock are swapped</tspan>
        <tspan data-lang-vi>chỉ thay adapter kết nối và đồng hồ</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Left: research and production live in two codebases, so every strategy is rewritten and the copies slowly stop matching. Right: one Python strategy runs on the same Rust kernel, whether BacktestNode replays history or TradingNode talks to a real venue. Based on the <a href="https://nautilustrader.io/docs/latest/concepts/architecture/" rel="noopener" target="_blank">NautilusTrader architecture docs</a>.</span>
    <span data-lang-vi>Bên trái: nghiên cứu và chạy thật nằm ở hai codebase, nên chiến lược nào cũng phải viết lại và hai bản dần lệch nhau. Bên phải: một chiến lược Python chạy trên cùng một lõi Rust, dù là BacktestNode phát lại dữ liệu lịch sử hay TradingNode nối với sàn thật. Dựa theo <a href="https://nautilustrader.io/docs/latest/concepts/architecture/" rel="noopener" target="_blank">tài liệu kiến trúc của NautilusTrader</a>.</span>
  </figcaption>
</figure>

<style>
  .ntw {
    margin: 2em 0;
    width: 100%;
  }
  .ntw-scroll {
    overflow-x: auto;
  }
  .ntw svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .ntw text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .ntw .ntw-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .ntw-box rect {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .ntw-box.is-core rect {
    stroke: var(--text);
    stroke-width: 2;
  }
  .ntw .ntw-name {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .ntw .ntw-sub {
    font-size: 13.5px;
    fill: var(--text-muted);
  }
  .ntw-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .ntw-arrow polygon {
    fill: var(--text-muted);
  }
  .ntw-arrow.is-red path {
    stroke: var(--red);
    stroke-dasharray: 5 4;
  }
  .ntw-arrow.is-red polygon {
    fill: var(--red);
  }
  .ntw .ntw-red {
    font-weight: 700;
    fill: var(--red);
  }
  .ntw .ntw-red-sub {
    fill: var(--red);
  }
  .ntw .ntw-bad {
    font-size: 15px;
    font-weight: 700;
    fill: var(--red);
  }
  .ntw .ntw-good {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .ntw-rule {
    stroke: var(--border);
  }
  .ntw figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
  .ntw figcaption a {
    color: inherit;
  }
</style>
