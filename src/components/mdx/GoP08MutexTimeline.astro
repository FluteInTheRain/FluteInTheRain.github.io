---
import DiagramIcon from './DiagramIcon.astro';
// Icons: DiagramIcon (names from diagram-icons.ts). Motion: fig-motion.css.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 8 * Math.cos(a - 0.45), y2 - 8 * Math.sin(a - 0.45)];
  const p2 = [x2 - 8 * Math.cos(a + 0.45), y2 - 8 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
---
<figure class="gp">
  <div class="gp-scroll">
  <svg viewBox="0 0 900 330" role="img" aria-label="Top: without a lock two goroutines are inside the increment at the same time and the program stops with concurrent map writes. Bottom: with a mutex goroutine B waits until goroutine A unlocks, so the increments run one after another.">
    <text x="20" y="22" class="h"><tspan data-lang-en>No lock</tspan><tspan data-lang-vi>Không có khóa</tspan></text>
    <rect x="360" y="34" width="180" height="88" rx="6" class="wait fm-pulse" style="stroke: var(--red)" />
    <DiagramIcon name="gopher" x={32} y={57} size={26} />
    <text x="54" y="62" class="strong">goroutine A</text>
    <rect x="160" y="42" width="380" height="32" rx="6" class="bar" />
    <text x="260" y="63" text-anchor="middle">counts["hits"]++</text>
    <DiagramIcon name="gopher" x={32} y={101} size={26} />
    <text x="54" y="106" class="strong">goroutine B</text>
    <rect x="360" y="82" width="380" height="32" rx="6" class="bar" />
    <text x="640" y="103" text-anchor="middle">counts["hits"]++</text>
    <DiagramIcon name="panic" x={172} y={141} size={24} />
    <text x="194" y="146" class="red"><tspan data-lang-en>Both are inside at once: fatal error: concurrent map writes</tspan><tspan data-lang-vi>Cả hai cùng ở bên trong: fatal error: concurrent map writes</tspan></text>

    <line x1="20" x2="880" y1="172" y2="172" class="rule" />
    <text x="20" y="202" class="h"><tspan data-lang-en>With a Mutex</tspan><tspan data-lang-vi>Có Mutex</tspan></text>
    <g class="fm-bob"><DiagramIcon name="gopher" x={32} y={237} size={26} /></g>
    <text x="54" y="242" class="strong">goroutine A</text>
    <rect x="160" y="222" width="260" height="32" rx="6" class="bar" />
    <text x="290" y="243" text-anchor="middle">Lock · counts["hits"]++ · Unlock</text>
    <DiagramIcon name="gopher" x={32} y={281} size={26} />
    <text x="54" y="286" class="strong">goroutine B</text>
    <rect x="160" y="262" width="260" height="32" rx="6" class="wait" />
    <DiagramIcon name="lock" x={190} y={278} size={22} />
    <text x="298" y="283" text-anchor="middle" class="muted"><tspan data-lang-en>waits in mu.Lock()</tspan><tspan data-lang-vi>chờ ở mu.Lock()</tspan></text>
    <rect x="420" y="262" width="260" height="32" rx="6" class="bar" />
    <text x="550" y="283" text-anchor="middle">Lock · counts["hits"]++ · Unlock</text>
    <DiagramIcon name="ok" x={172} y={315} size={24} />
    <text x="194" y="320" class="strong"><tspan data-lang-en>One at a time: the final count is exactly 100000</tspan><tspan data-lang-vi>Từng goroutine một: kết quả cuối đúng là 100000</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Time runs left to right. What matters is whether the two increments overlap.</span>
    <span data-lang-vi>Thời gian chạy từ trái sang phải. Điều quan trọng là hai lần tăng có chồng lên nhau hay không.</span>
  </figcaption>
</figure>

<style>
  .gp { margin: 2em 0; width: 100%; }
  .gp-scroll { overflow-x: auto; }
  .gp svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp text { font-size: 14px; fill: var(--text-body); }
  .gp .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp .strong { font-weight: 700; fill: var(--text); }
  .gp .muted { fill: var(--text-muted); }
  .gp .red { fill: var(--red); font-weight: 700; }
  .gp .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp .box.bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp .bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp .bar.bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp .wait { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp .rule { stroke: var(--border); stroke-width: 1; }
  .gp .axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .gp .dot { fill: var(--text-muted); }
  .gp .dot.bad { fill: var(--red); }
  .gp .arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp .arrow polygon { fill: var(--text-muted); }
  .gp .arrow.bad path { stroke: var(--red); }
  .gp .arrow.bad polygon { fill: var(--red); }
  .gp figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
