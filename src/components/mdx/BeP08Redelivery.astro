---
// Three worker deaths from the captures beside the figure. Job ids and
// outbox contents are the ones printed there; nothing else is shown.
const W = 900, H = 410;
const X = [15, 240, 465, 690];
const rows = [
  { y: 20, title: { en: 'fire and forget: BRPOP, no ack', vi: 'bắn rồi quên: BRPOP, không ack' }, bad: true, chips: [
    { en: 'job 502842f7 popped', vi: 'job 502842f7 bị lấy ra' },
    { en: 'kill -9 mid-job', vi: 'kill -9 giữa chừng' },
    { en: 'queued 0 · processing 0', vi: 'queued 0 · processing 0' },
    { en: 'job lost, nobody knows', vi: 'job mất, không ai hay' },
  ] },
  { y: 150, title: { en: 'ack, plain handler: mail sent, then kill -9', vi: 'có ack, handler thường: gửi mail, rồi kill -9' }, bad: true, chips: [
    { en: 'job c4074d36: mail sent', vi: 'job c4074d36: đã gửi mail' },
    { en: 'kill -9 before the ack', vi: 'kill -9 trước khi ack' },
    { en: 'restart: requeued 1 orphan', vi: 'chạy lại: requeue 1 orphan' },
    { en: 'sent again: C-3, C-3', vi: 'gửi lần nữa: C-3, C-3' },
  ] },
  { y: 280, title: { en: 'ack, idempotent handler: same kill -9', vi: 'có ack, handler idempotent: cùng cú kill -9' }, bad: false, chips: [
    { en: 'job 0eab7630: mail sent', vi: 'job 0eab7630: đã gửi mail' },
    { en: 'kill -9 before the ack', vi: 'kill -9 trước khi ack' },
    { en: 'restart: requeued 1 orphan', vi: 'chạy lại: requeue 1 orphan' },
    { en: 'already sent, skipping', vi: 'đã gửi rồi, bỏ qua' },
  ] },
];
---
<figure class="bep8r">
  <div class="bep8r-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three rows of four steps. Row one, fire and forget: a job is popped, the worker is killed, both lists are empty, the job is lost. Row two, with an ack but a plain handler: the mail is sent, the worker is killed before the ack, the job is requeued and the mail is sent again. Row three, with an idempotent handler: the same crash, and the retry skips because the mail was already sent.">
    {rows.map((r) => (
      <g>
        <text x="20" y={r.y + 14} class={r.bad ? 'h red' : 'h'}><tspan data-lang-en>{r.title.en}</tspan><tspan data-lang-vi>{r.title.vi}</tspan></text>
        {r.chips.map((c, i) => {
          const last = i === 3;
          const kill = i === 1;
          return (
            <g>
              <rect x={X[i]} y={r.y + 30} width="195" height="64" rx="10" class={last ? (r.bad ? 'box redbox' : 'box goldbox') : 'box'} />
              <text x={X[i] + 97} y={r.y + 68} text-anchor="middle" class={kill ? 'c kill' : last && r.bad ? 'c red' : 'c'}><tspan data-lang-en>{c.en}</tspan><tspan data-lang-vi>{c.vi}</tspan></text>
              {i < 3 && <line x1={X[i] + 195} y1={r.y + 62} x2={X[i + 1] - 12} y2={r.y + 62} class="ln" />}
              {i < 3 && <polygon points={`${X[i + 1]},${r.y + 62} ${X[i + 1] - 12},${r.y + 56} ${X[i + 1] - 12},${r.y + 68}`} class="hd" />}
            </g>
          );
        })}
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Without an ack the job vanishes. With an ack it comes back, so it can run twice; the idempotent handler is what makes the second run harmless.</span>
    <span data-lang-vi>Không ack thì job biến mất. Có ack thì job quay lại, nên có thể chạy hai lần; handler idempotent làm cho lần chạy thứ hai vô hại.</span>
  </figcaption>
</figure>

<style>
  .bep8r { margin: 2em 0; width: 100%; }
  .bep8r-scroll { overflow-x: auto; }
  .bep8r svg { display: block; width: 100%; min-width: 760px; height: auto; }
  .bep8r text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep8r .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep8r .h.red, .bep8r .c.red { fill: var(--red); }
  .bep8r .c { fill: var(--text-body); font-size: 13px; }
  .bep8r .c.kill { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; fill: var(--text); }
  .bep8r .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep8r .box.redbox { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .bep8r .box.goldbox { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.5; }
  .bep8r .ln { stroke: var(--text-muted); stroke-width: 1.6; }
  .bep8r .hd { fill: var(--text-muted); }
  .bep8r figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
