---
import DiagramIcon from './DiagramIcon.astro';
// A recap map from the question you ask about your data to the model that fits, with the real case from the post for each.
// Arrowheads are polygons: no SVG ids.
const W = 900;
const H = 350;
type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}
const frames: any[] = [];
const boxes: any[] = [];
const links: any[] = [];
const labels: any[] = [];
const nums: any[] = [];
const rows = [
  { q: ['Is each record a self-contained tree,', 'loaded whole?'], qv: ['Mỗi bản ghi là một cái cây tự đủ,', 'luôn được tải nguyên?'], icon: 'file', a: ['Document', "Mei's TV-show site, before the actor page"], av: ['Document', 'Site phim của Mei, trước trang diễn viên'] },
  { q: ['Is the same entity referenced', 'from many places?'], qv: ['Cùng một thực thể được tham chiếu', 'từ nhiều chỗ?'], icon: 'db', a: ['Relational: ids and joins', 'Diaspora, after the move to MySQL'], av: ['Quan hệ: id và join', 'Diaspora, sau khi chuyển sang MySQL'] },
  { q: ['Are the links the product, with paths', 'of any length?'], qv: ['Các mối nối chính là sản phẩm, với', 'đường đi dài bất kỳ?'], icon: 'network', a: ['Graph', "Facebook's TAO"], av: ['Graph', 'TAO của Facebook'] },
  { q: ['Must you know why the state', 'changed?'], qv: ['Bạn có cần biết vì sao state', 'thay đổi?'], icon: 'log', a: ['Event log plus views (CQRS)', 'Netflix downloads'], av: ['Event log cùng các view (CQRS)', 'Netflix: tải phim'] },
];
rows.forEach((r, i) => {
  const y = 10 + i * 80;
  boxes.push({ x: 10, y, w: 440, h: 64, en: r.q, vi: r.qv, flat: true });
  boxes.push({ x: 540, y, w: 350, h: 64, icon: r.icon, kind: 'good', en: r.a, vi: r.av });
  links.push({ pts: [[450, y + 32], [540, y + 32]] });
  labels.push({ x: 495, y: y + 24, anchor: 'middle', en: 'yes', vi: 'có', cls: 'muted' });
});
labels.push({ x: 450, y: 338, anchor: 'middle', en: 'Most real systems mix these, and the big databases now support more than one.', vi: 'Hệ thống thật thường trộn các model này, và các database lớn giờ hỗ trợ nhiều hơn một.', cls: 'muted' });
---
<figure class="dmpm">
  <div class="dmpm-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four questions and their answers. Is each record a self-contained tree loaded whole? Use documents, as in Mei's TV-show site before the actor page. Is the same entity referenced from many places? Use relational tables, as in Diaspora after the move to MySQL. Are links the product, with paths of any length? Use a graph, as in Facebook's TAO. Must you know why the state changed? Use an event log plus views, as in Netflix downloads.">
    {frames.map((f) => (
      <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="6" class={`dmpm-frame ${f.kind ?? ''}`} />
    ))}
    {boxes.map((b) => {
      const n = Math.max(b.en.length, b.vi.length);
      const top = !!b.top;
      const cx = b.x + b.w / 2;
      const x0 = top ? cx : b.icon ? b.x + 46 : b.x + 14;
      const y0 = top ? b.y + (b.icon ? 56 : 24) : b.y + b.h / 2 - ((n - 1) * 17) / 2 + 4;
      return (
        <g class={`dmpm-box ${b.kind ?? ''}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
          {b.icon && <DiagramIcon name={b.icon} x={top ? cx : b.x + 24} y={top ? b.y + 24 : b.y + b.h / 2} size={b.is ?? 26} />}
          {Array.from({ length: n }).map((_, i) => (
            <text x={x0} y={y0 + i * 17} text-anchor={top ? 'middle' : 'start'} class={i === 0 && !b.flat ? 'dmpm-name' : 'dmpm-sub'}>
              <tspan data-lang-en>{b.en[i] ?? ''}</tspan>
              <tspan data-lang-vi>{b.vi[i] ?? ''}</tspan>
            </text>
          ))}
        </g>
      );
    })}
    {links.map((l) => {
      const a = arrow(l.pts);
      return (
        <g>
          <polyline points={l.plain ? l.pts.map((p) => p.join(',')).join(' ') : a.line} class={`dmpm-edge ${l.kind ?? ''}`} fill="none" />
          {!l.plain && <polygon points={a.head} class={`dmpm-head ${l.kind ?? ''}`} />}
        </g>
      );
    })}
    {labels.map((t) => (
      <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`dmpm-lab ${t.cls ?? ''}`}>
        <tspan data-lang-en>{t.en}</tspan>
        <tspan data-lang-vi>{t.vi ?? t.en}</tspan>
      </text>
    ))}
    {nums.map((n) => (
      <g class="dmpm-num">
        <circle cx={n.x} cy={n.y} r="11" />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.n}</text>
      </g>
    ))}

  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Answer these in order. If the answer is no, move to the next question; the answers can combine.</span>
    <span data-lang-vi>Trả lời theo thứ tự. Nếu câu trả lời là không, chuyển sang câu tiếp theo; các đáp án có thể kết hợp.</span>
  </figcaption>
</figure>

<style>
  .dmpm { margin: 2em 0; width: 100%; }
  .dmpm-scroll { overflow-x: auto; }
  .dmpm svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dmpm text { font-size: 14px; fill: var(--text-body); }
  .dmpm .dmpm-name { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .dmpm .dmpm-sub { font-size: 12px; fill: var(--text-muted); }
  .dmpm .dmpm-lab { font-size: 13px; }
  .dmpm .dmpm-lab.h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dmpm .dmpm-lab.strong { font-weight: 700; fill: var(--text); }
  .dmpm .dmpm-lab.muted { fill: var(--text-muted); }
  .dmpm .dmpm-lab.bad { font-weight: 700; fill: var(--red); }
  .dmpm .dmpm-lab.good { font-weight: 700; fill: var(--text); }
  .dmpm .dmpm-lab.mono, .dmpm .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .dmpm-frame { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .dmpm-frame.bad { stroke: var(--red); }
  .dmpm-frame.good { stroke: var(--gold); }
  .dmpm-box rect { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmpm-box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dmpm-box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmpm-box.plain rect { fill: none; stroke: var(--border); }
  .dmpm-edge { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmpm-edge.bad { stroke: var(--red); }
  .dmpm-edge.good { stroke: var(--gold-icon); }
  .dmpm-head { fill: var(--text-muted); }
  .dmpm-head.bad { fill: var(--red); }
  .dmpm-head.good { fill: var(--gold-icon); }
  .dmpm-num circle { fill: var(--bg-alt); stroke: var(--text-muted); }
  .dmpm-num text { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dmpm figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
