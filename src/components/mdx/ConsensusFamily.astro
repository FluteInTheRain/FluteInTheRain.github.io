---
// Four formulations of consensus are equivalent (consensus number infinity); fetch-and-add is the
// outlier (consensus number 2). Static SVG, site tokens only.
import ConsensusFigure from './ConsensusFigure.astro';
import DiagramIcon from './DiagramIcon.astro';
import { head } from './consensus-fig';
interface Props { lang: 'en' | 'vi' }
const { lang } = Astro.props;

const T = {
  en: {
    aria: 'A hub labelled equivalent, consensus number infinity, joined to four boxes: single-value consensus (one winning value), linearizable compare-and-set (locks and leases), shared log (same order everywhere), and atomic commit (commit or abort across shards). Solve any one and you can build the rest. Below, a separate dashed box: fetch-and-add has consensus number 2 and stops working at three nodes.',
    hub: ['Equivalent', 'consensus number ∞'], hubSub: 'solve one, get the rest',
    items: [
      { icon: 'users', n: 'Single-value consensus', s: 'one winning value' },
      { icon: 'lock', n: 'Linearizable CAS', s: 'locks and leases' },
      { icon: 'log', n: 'Shared log', s: 'same order everywhere' },
      { icon: 'db', n: 'Atomic commit', s: 'commit or abort, all shards' },
    ],
    fa: 'Fetch-and-add', faS: 'consensus number 2: fine for two nodes, not for three',
    link: 'stops at 2',
    cap: 'Four different-looking problems are really one problem; fetch-and-add looks similar but cannot do it for three nodes.',
  },
  vi: {
    aria: 'Một trung tâm ghi tương đương, consensus number vô cùng, nối với bốn hộp: đồng thuận một giá trị (một giá trị thắng), CAS khả tuyến tính (khoá và lease), nhật ký chung (cùng thứ tự ở mọi nơi), và atomic commit (commit hoặc abort trên mọi shard). Giải được một cái là dựng được các cái còn lại. Bên dưới, một hộp nét đứt riêng: fetch-and-add có consensus number 2 và hết tác dụng từ ba node.',
    hub: ['Tương đương', 'consensus number ∞'], hubSub: 'giải một, có cả bốn',
    items: [
      { icon: 'users', n: 'Đồng thuận một giá trị', s: 'một giá trị thắng' },
      { icon: 'lock', n: 'CAS khả tuyến tính', s: 'khoá và lease' },
      { icon: 'log', n: 'Nhật ký chung', s: 'cùng thứ tự ở mọi nơi' },
      { icon: 'db', n: 'Atomic commit', s: 'commit hoặc abort mọi shard' },
    ],
    fa: 'Fetch-and-add', faS: 'consensus number 2: đủ cho hai node, không đủ cho ba',
    link: 'dừng ở 2',
    cap: 'Bốn bài toán trông khác nhau thật ra là một; fetch-and-add trông giống nhưng không làm nổi với ba node.',
  },
}[lang];
const pos = [[20, 20], [20, 150], [610, 20], [610, 150]];
const bw = 270, bh = 62;
---
<ConsensusFigure aria={T.aria} cap={T.cap} w={900} h={330}>
  {T.items.map((it, i) => {
    const [x, y] = pos[i];
    const left = i < 2;
    const sx = left ? x + bw : x;
    const hx = left ? 355 : 545;
    return (
      <g>
        <path d={`M ${hx} 125 L ${sx} ${y + bh / 2}`} class="cfg-line is-ok" />
        <rect x={x} y={y} width={bw} height={bh} rx="6" class="cfg-box" />
        <DiagramIcon name={it.icon as any} x={x + 26} y={y + bh / 2} size={26} />
        <text x={x + 52} y={y + 26} class="cfg-n">{it.n}</text>
        <text x={x + 52} y={y + 46} class="cfg-m">{it.s}</text>
      </g>
    );
  })}
  <rect x="355" y="94" width="190" height="64" rx="8" class="cfg-box is-ok" />
  <text x="450" y="119" text-anchor="middle" class="cfg-n" style="font-size:14px">{T.hub[0]}</text>
  <text x="450" y="137" text-anchor="middle" class="cfg-g">{T.hub[1]}</text>
  <text x="450" y="152" text-anchor="middle" class="cfg-m" style="font-size:10.5px">{T.hubSub}</text>
  <path d="M 450 160 L 450 246" class="cfg-line is-bad" />
  <text x="460" y="204" class="cfg-r">{T.link}</text>
  <rect x="250" y="250" width="400" height="62" rx="6" class="cfg-box is-bad is-dash" />
  <DiagramIcon name="warning" x={276} y={281} size={26} />
  <text x="302" y="274" class="cfg-n">{T.fa}</text>
  <text x="302" y="294" class="cfg-m" style="font-size:11.5px">{T.faS}</text>
</ConsensusFigure>
