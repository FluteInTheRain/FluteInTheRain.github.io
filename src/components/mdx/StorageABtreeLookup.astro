---
// B-tree, two moves on one tiny tree: a lookup follows one pointer per level,
// and an insert into a full leaf page splits it in two. Keys are illustrative.
// Plain inline SVG, site tokens, polygon arrowheads, no ids.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 372;
function arrowDown(x: number, y1: number, y2: number) {
  return { line: `M${x},${y1} L${x},${y2 - 7}`, head: `${x - 5},${y2 - 8} ${x + 5},${y2 - 8} ${x},${y2}` };
}
function arrowLeft(x1: number, x2: number, y: number) {
  return { line: `M${x1},${y} L${x2 + 7},${y}`, head: `${x2 + 8},${y - 5} ${x2 + 8},${y + 5} ${x2},${y}` };
}
// left panel
const lx = 70;
const lcw = 110;
const lg = 9;
const lcx = (i: number) => lx + i * (lcw + lg);
const leftRoot = ['< 30', '30–59', '60+'];
const leftLeaves = ['3 11 25', '30 42 51', '60 72 90'];
const findArrow = arrowDown(lcx(1) + lcw / 2, 118, 172);
// right panel
const rx = 520;
const rcw = 84;
const rg = 6;
const rcx = (i: number) => rx + i * (rcw + rg);
const rightRoot = ['< 30', '30–44', '45–59', '60+'];
const rightLeaves = ['3 11 25', '30 42', '45 51 58', '60 72 90'];
const insArrow = arrowLeft(746, 682, 96);
---
<figure class="btl">
  <div class="btl-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A tiny B-tree. Left: looking up key 42. The root page splits keys into the ranges below 30, 30 to 59, and 60 and up; 42 falls in the middle range, so one pointer leads to the leaf page holding 30, 42 and 51. Right: inserting 45 into a full leaf page holding 30, 42, 51 and 58 splits it into a page with 30 and 42 and a page with 45, 51 and 58, and the root page gains a pointer for the new range.">
    <text x="20" y="24" class="btl-h">
      <tspan data-lang-en>Find a key: one pointer per level</tspan>
      <tspan data-lang-vi>Tìm một khoá: một con trỏ mỗi tầng</tspan>
    </text>
    <text x="470" y="24" class="btl-h">
      <tspan data-lang-en>Insert into a full page: split it</tspan>
      <tspan data-lang-vi>Chèn vào trang đã đầy: tách nó ra</tspan>
    </text>
    <line x1="445" x2="445" y1="10" y2="350" class="btl-divider" />

    {/* left panel */}
    <DiagramIcon name="laptop" x="104" y="100" size={28} />
    <rect x={lcx(1) + 5} y="86" width="100" height="28" rx="3" class="btl-cell is-good" />
    <text x={lcx(1) + 55} y="105" text-anchor="middle" class="btl-mono is-good">find 42</text>
    <path d={`M122,100 L${lcx(1) + 4},100`} class="btl-arrow" />
    <path d={findArrow.line} class="btl-arrow is-good" /><polygon points={findArrow.head} class="btl-head is-good" />
    <text x="20" y="192" class="btl-small">
      <tspan data-lang-en>root</tspan>
      <tspan data-lang-vi>gốc</tspan>
    </text>
    <text x="20" y="272" class="btl-small">
      <tspan data-lang-en>leaves</tspan>
      <tspan data-lang-vi>lá</tspan>
    </text>
    {leftRoot.map((r, i) => (
      <g>
        <rect x={lcx(i)} y="172" width={lcw} height="30" rx="3" class={i === 1 ? 'btl-cell is-good' : 'btl-cell'} />
        <text x={lcx(i) + lcw / 2} y="192" text-anchor="middle" class={i === 1 ? 'btl-mono is-good' : 'btl-mono'}>{r}</text>
        <line x1={lcx(i) + lcw / 2} y1="202" x2={lcx(i) + lcw / 2} y2="252" class={i === 1 ? 'btl-edge is-good' : 'btl-edge'} />
        <rect x={lcx(i)} y="252" width={lcw} height="30" rx="3" class={i === 1 ? 'btl-box is-good' : 'btl-box'} />
        <text x={lcx(i) + lcw / 2} y="272" text-anchor="middle" class={i === 1 ? 'btl-mono is-good' : 'btl-mono'}>{leftLeaves[i]}</text>
      </g>
    ))}
    <text x="20" y="324" class="btl-note">
      <tspan data-lang-en>42 is in the 30 to 59 range, so follow that pointer.</tspan>
      <tspan data-lang-vi>42 nằm trong khoảng 30 tới 59, nên đi theo con trỏ đó.</tspan>
    </text>
    <text x="20" y="344" class="btl-note">
      <tspan data-lang-en>Each real page has hundreds of children, so trees stay shallow.</tspan>
      <tspan data-lang-vi>Trang thật có hàng trăm trang con, nên cây luôn nông.</tspan>
    </text>

    {/* right panel */}
    <text x="470" y="68" class="btl-in-s">
      <tspan data-lang-en>Before: this leaf page is full</tspan>
      <tspan data-lang-vi>Trước: trang lá này đã đầy</tspan>
    </text>
    {['30', '42', '51', '58'].map((k, i) => (
      <g>
        <rect x={470 + i * 52} y="82" width="48" height="28" rx="3" class="btl-cell is-bad" />
        <text x={470 + i * 52 + 24} y="101" text-anchor="middle" class="btl-mono">{k}</text>
      </g>
    ))}
    <rect x="748" y="82" width="120" height="28" rx="3" class="btl-cell is-good" />
    <text x="808" y="101" text-anchor="middle" class="btl-mono is-good">insert 45</text>
    <path d={insArrow.line} class="btl-arrow is-good" /><polygon points={insArrow.head} class="btl-head is-good" />

    <text x="470" y="156" class="btl-in-s">
      <tspan data-lang-en>After: two pages, one new pointer</tspan>
      <tspan data-lang-vi>Sau: hai trang, thêm một con trỏ</tspan>
    </text>
    <text x="470" y="198" class="btl-small">
      <tspan data-lang-en>root</tspan>
      <tspan data-lang-vi>gốc</tspan>
    </text>
    <text x="470" y="278" class="btl-small">
      <tspan data-lang-en>leaves</tspan>
      <tspan data-lang-vi>lá</tspan>
    </text>
    {rightRoot.map((r, i) => {
      const hot = i === 1 || i === 2;
      return (
        <g>
          <rect x={rcx(i)} y="176" width={rcw} height="30" rx="3" class={hot ? 'btl-cell is-good' : 'btl-cell'} />
          <text x={rcx(i) + rcw / 2} y="196" text-anchor="middle" class={hot ? 'btl-mono is-good' : 'btl-mono'}>{r}</text>
          <line x1={rcx(i) + rcw / 2} y1="206" x2={rcx(i) + rcw / 2} y2="256" class={hot ? 'btl-edge is-good' : 'btl-edge'} />
          <rect x={rcx(i)} y="256" width={rcw} height="30" rx="3" class={hot ? 'btl-box is-good' : 'btl-box'} />
          <text x={rcx(i) + rcw / 2} y="276" text-anchor="middle" class={hot ? 'btl-mono is-good' : 'btl-mono'}>{rightLeaves[i]}</text>
        </g>
      );
    })}
    <text x="470" y="324" class="btl-note">
      <tspan data-lang-en>Two half-full pages replace one full page.</tspan>
      <tspan data-lang-vi>Hai trang đầy nửa thay cho một trang đầy.</tspan>
    </text>
    <text x="470" y="344" class="btl-note">
      <tspan data-lang-en>Every change goes to the write-ahead log first.</tspan>
      <tspan data-lang-vi>Mọi thay đổi đều ghi vào write-ahead log trước.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>A B-tree with made-up keys and tiny pages. Real pages are 4 to 16 KiB and hold hundreds of keys, but the two moves are the same: follow pointers down, split a page when it overflows.</span>
    <span data-lang-vi>Một B-tree với khoá bịa ra và trang cực nhỏ. Trang thật cỡ 4 tới 16 KiB và chứa hàng trăm khoá, nhưng hai động tác thì y hệt: đi theo con trỏ xuống, tách trang khi nó tràn.</span>
  </figcaption>
</figure>

<style>
  .btl { margin: 2em 0; width: 100%; }
  .btl-scroll { overflow-x: auto; }
  .btl svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .btl text { font-size: 14px; fill: var(--text-body); }
  .btl .btl-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .btl .btl-sub { fill: var(--text-muted); }
  .btl-rule { stroke: var(--border); }
  .btl-divider { stroke: var(--border); stroke-dasharray: 6 5; }
  .btl-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .btl-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .btl-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .btl-cell { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .btl-cell.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .btl-cell.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .btl-cell.is-dead { fill: var(--bg-alt); stroke: var(--text-muted); stroke-dasharray: 3 3; }
  .btl .btl-in { font-weight: 600; fill: var(--text); }
  .btl .btl-in-b { font-weight: 700; fill: var(--text); }
  .btl .btl-in-m { font-size: 13px; fill: var(--text-body); }
  .btl .btl-in-s { font-size: 13px; font-weight: 600; fill: var(--text); }
  .btl .btl-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; fill: var(--text-body); }
  .btl .btl-mono.is-good { fill: var(--gold-icon); font-weight: 700; }
  .btl .btl-mono.is-bad { fill: var(--red); font-weight: 700; }
  .btl .btl-note { font-size: 13px; fill: var(--text-muted); }
  .btl .btl-note.is-good { fill: var(--gold-icon); font-weight: 700; }
  .btl .btl-note.is-bad { fill: var(--red); font-weight: 700; }
  .btl .btl-small { font-size: 12px; fill: var(--text-muted); }
  .btl .btl-num { font-size: 12px; font-weight: 700; fill: var(--text); }
  .btl-circle { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .btl-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .btl-arrow.is-good { stroke: var(--gold-icon); stroke-width: 1.8; }
  .btl-arrow.is-bad { stroke: var(--red); stroke-width: 1.8; }
  .btl-head { fill: var(--text-muted); }
  .btl-head.is-good { fill: var(--gold-icon); }
  .btl-head.is-bad { fill: var(--red); }
  .btl figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
<style>
  .btl-edge { stroke: var(--border); stroke-width: 1.4; }
  .btl-edge.is-good { stroke: var(--gold-icon); stroke-width: 1.8; }
</style>
