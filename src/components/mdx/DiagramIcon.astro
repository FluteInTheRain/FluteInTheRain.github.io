---
// A colour icon for on-page system diagrams: place it inside an <svg> figure.
// (x, y) is the icon's centre; size is its width/height in SVG units.
// In dark mode a light disc sits behind it so dark logos stay visible.
import { DIAGRAM_ICONS, type DiagramIconName } from '../../data/diagram-icons';

interface Props { name: DiagramIconName; x: number; y: number; size?: number; title?: string }
const { name, x, y, size = 28, title } = Astro.props;
if (!(name in DIAGRAM_ICONS)) throw new Error(`DiagramIcon: unknown icon "${name}"`);
const r = size / 2;
---
<g class="dicon" aria-hidden={title ? undefined : 'true'}>
  {title && <title>{title}</title>}
  <circle cx={x} cy={y} r={r + 4} class="dicon-bg" />
  <image href={`/icons/sys/${name}.svg`} x={x - r} y={y - r} width={size} height={size} />
</g>

<style>
  .dicon-bg { fill: transparent; }
  :global([data-theme='dark']) .dicon-bg { fill: #ECE7DD; }
</style>
