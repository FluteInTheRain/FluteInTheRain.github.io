---
// Icons: stack = defer list, terminal = printed output. Motion: fm-flow on the return arrow, fm-pulse on the last-added call.
import DiagramIcon from './DiagramIcon.astro';
// LIFO order of the loop example: for i := 1; i <= 3; i++ { defer fmt.Println("deferred", i) }
function head(x2: number, y2: number, a: number) { const l = 9; const p = (d: number) => `${(x2 - l * Math.cos(a + d)).toFixed(1)},${(y2 - l * Math.sin(a + d)).toFixed(1)}`; return `${x2},${y2} ${p(-0.45)} ${p(0.45)}`; }
const W = 900;
const H = 300;
const pushed = [1, 2, 3]; // pushed in this order
const outs = ['function body done', 'deferred 3', 'deferred 2', 'deferred 1'];
---
<figure class="gp02c">
  <div class="gp02c-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three deferred calls are pushed onto a list with i equal to 1, 2 and 3. After the function body finishes they run from the top: deferred 3, deferred 2, deferred 1.">
    <DiagramIcon name="stack" x={42} y={21} size={26} />
    <text x="62" y="26" class="h"><tspan data-lang-en>The list of deferred calls</tspan><tspan data-lang-vi>Danh sách các lệnh defer</tspan></text>
    <text x="30" y="46" class="muted"><tspan data-lang-en>each loop pass adds one on top</tspan><tspan data-lang-vi>mỗi vòng lặp thêm một lệnh lên trên cùng</tspan></text>
    {pushed.map((n, k) => {
      const y = 232 - k * 54;
      return (
        <g>
          <rect x="30" y={y} width="260" height="44" rx="6" class={n === 3 ? 'box-red fm-pulse' : 'box'} />
          <text x="48" y={y + 27} class="strong">fmt.Println("deferred", {n})</text>
          <text x="306" y={y + 27} class="muted num"><tspan data-lang-en>added {k + 1}{k === 0 ? 'st' : k === 1 ? 'nd' : 'rd'}</tspan><tspan data-lang-vi>thêm lần {k + 1}</tspan></text>
        </g>
      );
    })}

    <line x1="470" y1="150" x2="520" y2="150" class="line fm-flow" />
    <polygon points={head(530, 150, 0)} class="head" />
    <text x="500" y="128" text-anchor="middle" class="muted"><tspan data-lang-en>function returns</tspan><tspan data-lang-vi>hàm kết thúc</tspan></text>

    <DiagramIcon name="terminal" x={582} y={21} size={26} />
    <text x="604" y="26" class="h"><tspan data-lang-en>What gets printed, top to bottom</tspan><tspan data-lang-vi>Thứ tự in ra, từ trên xuống</tspan></text>
    {outs.map((o, k) => {
      const y = 62 + k * 54;
      return (
        <g>
          <rect x="570" y={y} width="300" height="44" rx="6" class={k === 1 ? 'box-red' : 'box'} />
          <text x="588" y={y + 27} class="strong">{o}</text>
          <text x="854" y={y + 27} text-anchor="end" class="muted num">{k + 1}</text>
        </g>
      );
    })}
    <text x="570" y="290" class="muted"><tspan data-lang-en>The last call added is the first to run.</tspan><tspan data-lang-vi>Lệnh thêm sau cùng chạy trước tiên.</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Last in, first out, like a stack of plates. The output lines are the ones the program printed above.</span>
    <span data-lang-vi>Vào sau ra trước, như chồng đĩa. Các dòng bên phải đúng là output của chương trình ở trên.</span>
  </figcaption>
</figure>

<style>
  .gp02c { margin: 2em 0; width: 100%; }
  .gp02c-scroll { overflow-x: auto; }
  .gp02c svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp02c text { font-size: 14px; fill: var(--text-body); }
  .gp02c .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .gp02c .muted { fill: var(--text-muted); }
  .gp02c .strong { font-weight: 700; fill: var(--text); }
  .gp02c .red { fill: var(--red); font-weight: 700; }
  .gp02c .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp02c .box-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .gp02c .ghost { fill: none; stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .gp02c .axis { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp02c .line { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp02c .line-red { stroke: var(--red); stroke-width: 1.8; fill: none; }
  .gp02c .head { fill: var(--text-muted); }
  .gp02c .head-red { fill: var(--red); }
  .gp02c .num { font-variant-numeric: tabular-nums; }
  .gp02c figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
