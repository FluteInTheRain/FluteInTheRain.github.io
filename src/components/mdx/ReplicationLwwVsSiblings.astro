---
import DiagramIcon from './DiagramIcon.astro';
// Two concurrent edits to the labels of one issue, resolved two ways (top/bottom showdown):
// last write wins keeps one value and silently drops the other; version tracking keeps both as
// siblings and lets the next writer merge them. Illustrative example, not data.
// Plain inline SVG with site tokens; arrowheads are polygons, so there are no ids.

const W = 900;
const H = 500;
const PANEL_H = 230;

type Box = { x: number; y: number; w: number; h: number };
const mid = (b: Box) => ({ l: b.x, r: b.x + b.w, cy: b.y + b.h / 2 });

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 9;
  const back = { x: x2 - len * Math.cos(a), y: y2 - len * Math.sin(a) };
  const p1 = `${back.x + 4.5 * Math.sin(a)},${back.y - 4.5 * Math.cos(a)}`;
  const p2 = `${back.x - 4.5 * Math.sin(a)},${back.y + 4.5 * Math.cos(a)}`;
  return { line: { x1, y1, x2: back.x, y2: back.y }, head: `${x2},${y2} ${p1} ${p2}` };
}

const panels = [0, 1].map((k) => {
  const oy = 16 + k * (PANEL_H + 22);
  const start: Box = { x: 20, y: oy + 100, w: 150, h: 52 };
  const alice: Box = { x: 240, y: oy + 62, w: 210, h: 52 };
  const bob: Box = { x: 240, y: oy + 140, w: 210, h: 52 };
  return { k, oy, start, alice, bob };
});
---
<figure class="lww">
  <div class="lww-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="An issue starts with the label bug. Alice adds urgent and Bob adds ui at the same time, each on a different replica. With last write wins, the database keeps bug, ui and drops Alice's edit although both writes were acknowledged. With version tracking, the database keeps both versions as siblings and the next writer merges them into bug, urgent, ui.">
    {panels.map(({ k, oy, start, alice, bob }) => {
      const s = mid(start), a = mid(alice), b = mid(bob);
      const toA = arrow(s.r, s.cy, a.l, a.cy);
      const toB = arrow(s.r, s.cy, b.l, b.cy);
      return (
        <g>
          <text x="20" y={oy + 16} class="lww-h">
            {k === 0 ? (
              <><tspan data-lang-en>Last write wins: one edit disappears without an error</tspan><tspan data-lang-vi>Last write wins: một chỉnh sửa biến mất mà không báo lỗi</tspan></>
            ) : (
              <><tspan data-lang-en>Version tracking: keep both, merge on the next write</tspan><tspan data-lang-vi>Theo dõi phiên bản: giữ cả hai, gộp ở lần ghi sau</tspan></>
            )}
          </text>
          <text x="20" y={oy + 40} class="lww-sub">
            {k === 0 ? (
              <><tspan data-lang-en>The write with the higher timestamp wins. Timestamps of concurrent writes say nothing about intent.</tspan><tspan data-lang-vi>Lần ghi có timestamp lớn hơn thắng. Mà timestamp của hai lần ghi đồng thời chẳng nói lên ý định gì.</tspan></>
            ) : (
              <><tspan data-lang-en>Both edits were based on version 1, so the database knows they are concurrent and keeps both.</tspan><tspan data-lang-vi>Cả hai chỉnh sửa đều dựa trên phiên bản 1, nên database biết chúng đồng thời và giữ cả hai.</tspan></>
            )}
          </text>

          <rect x={start.x} y={start.y} width={start.w} height={start.h} rx="4" class="lww-box" />
          <DiagramIcon name="db" x={start.x + 24} y={start.y + start.h / 2} size={24} />
          <text x={s.l + start.w / 2 + 14} y={start.y + 22} text-anchor="middle" class="lww-val">bug</text>
          <text x={s.l + start.w / 2 + 14} y={start.y + 41} text-anchor="middle" class="lww-note">
            <tspan data-lang-en>version 1</tspan><tspan data-lang-vi>phiên bản 1</tspan>
          </text>

          <line {...toA.line} class="lww-edge" /><polygon points={toA.head} class="lww-head" />
          <line {...toB.line} class="lww-edge" /><polygon points={toB.head} class="lww-head" />

          <rect x={alice.x} y={alice.y} width={alice.w} height={alice.h} rx="4" class="lww-box" />
          <DiagramIcon name="user" x={alice.x + 24} y={alice.y + alice.h / 2} size={24} />
          <text x={a.l + alice.w / 2 + 14} y={alice.y + 22} text-anchor="middle" class="lww-val">bug, urgent</text>
          <text x={a.l + alice.w / 2 + 14} y={alice.y + 41} text-anchor="middle" class="lww-note">
            <tspan data-lang-en>Alice, on replica 1: OK</tspan><tspan data-lang-vi>Alice, ở replica 1: OK</tspan>
          </text>
          <rect x={bob.x} y={bob.y} width={bob.w} height={bob.h} rx="4" class="lww-box" />
          <DiagramIcon name="user" x={bob.x + 24} y={bob.y + bob.h / 2} size={24} />
          <text x={b.l + bob.w / 2 + 14} y={bob.y + 22} text-anchor="middle" class="lww-val">bug, ui</text>
          <text x={b.l + bob.w / 2 + 14} y={bob.y + 41} text-anchor="middle" class="lww-note">
            <tspan data-lang-en>Bob, on replica 2: OK</tspan><tspan data-lang-vi>Bob, ở replica 2: OK</tspan>
          </text>

          {k === 0 ? (() => {
            const res: Box = { x: 540, y: oy + 100, w: 160, h: 52 };
            const r = mid(res);
            const fromB = arrow(b.r, b.cy, r.l, r.cy);
            const fromA = arrow(a.r, a.cy, r.l - 2, r.cy - 6);
            return (
              <g>
                <line {...fromA.line} class="lww-edge is-lost" />
                <text x={(a.r + r.l) / 2 - 4} y={a.cy - 6} text-anchor="middle" class="lww-lost">
                  <tspan data-lang-en>dropped</tspan><tspan data-lang-vi>bị bỏ</tspan>
                </text>
                <line {...fromB.line} class="lww-edge" /><polygon points={fromB.head} class="lww-head" />
                <rect x={res.x} y={res.y} width={res.w} height={res.h} rx="4" class="lww-box is-result" />
                <text x={r.l + res.w / 2} y={res.y + 22} text-anchor="middle" class="lww-val">bug, ui</text>
                <text x={r.l + res.w / 2} y={res.y + 41} text-anchor="middle" class="lww-note">
                  <tspan data-lang-en>every replica, forever</tspan><tspan data-lang-vi>mọi replica, mãi mãi</tspan>
                </text>
                <text x="722" y={oy + 118} class="lww-call is-bad">
                  <tspan data-lang-en>"urgent" is gone.</tspan><tspan data-lang-vi>"urgent" đã mất.</tspan>
                </text>
                <text x="722" y={oy + 140} class="lww-call">
                  <tspan data-lang-en>Alice was told OK.</tspan><tspan data-lang-vi>Alice vẫn nhận OK.</tspan>
                </text>
              </g>
            );
          })() : (() => {
            const sibA: Box = { x: 520, y: oy + 62, w: 160, h: 52 };
            const sibB: Box = { x: 520, y: oy + 140, w: 160, h: 52 };
            const merged: Box = { x: 740, y: oy + 100, w: 140, h: 52 };
            const sa = mid(sibA), sb = mid(sibB), m = mid(merged);
            const e1 = arrow(a.r, a.cy, sa.l, sa.cy);
            const e2 = arrow(b.r, b.cy, sb.l, sb.cy);
            const e3 = arrow(sa.r, sa.cy, m.l, m.cy - 8);
            const e4 = arrow(sb.r, sb.cy, m.l, m.cy + 8);
            return (
              <g>
                <rect x={sibA.x - 10} y={sibA.y - 10} width={sibA.w + 20} height={sibB.y + sibB.h - sibA.y + 20} rx="8" class="lww-group" />
                <text x={sibA.x + sibA.w / 2} y={sibB.y + sibB.h + 28} text-anchor="middle" class="lww-note">
                  <tspan data-lang-en>siblings</tspan><tspan data-lang-vi>siblings (bản song song)</tspan>
                </text>
                <line {...e1.line} class="lww-edge" /><polygon points={e1.head} class="lww-head" />
                <line {...e2.line} class="lww-edge" /><polygon points={e2.head} class="lww-head" />
                <rect x={sibA.x} y={sibA.y} width={sibA.w} height={sibA.h} rx="4" class="lww-box" />
                <text x={sa.l + sibA.w / 2} y={sibA.y + 31} text-anchor="middle" class="lww-val">bug, urgent</text>
                <rect x={sibB.x} y={sibB.y} width={sibB.w} height={sibB.h} rx="4" class="lww-box" />
                <text x={sb.l + sibB.w / 2} y={sibB.y + 31} text-anchor="middle" class="lww-val">bug, ui</text>
                <line {...e3.line} class="lww-edge" /><polygon points={e3.head} class="lww-head" />
                <line {...e4.line} class="lww-edge" /><polygon points={e4.head} class="lww-head" />
                <rect x={merged.x} y={merged.y} width={merged.w} height={merged.h} rx="4" class="lww-box is-result is-good" />
                <text x={m.l + merged.w / 2} y={merged.y + 22} text-anchor="middle" class="lww-val">bug, urgent, ui</text>
                <text x={m.l + merged.w / 2} y={merged.y + 41} text-anchor="middle" class="lww-note">
                  <tspan data-lang-en>version 2, merged</tspan><tspan data-lang-vi>phiên bản 2, đã gộp</tspan>
                </text>
              </g>
            );
          })()}
        </g>
      );
    })}
    <line x1="20" x2={W - 20} y1={16 + PANEL_H + 4} y2={16 + PANEL_H + 4} class="lww-rule" />
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>A merge of a set of labels is easy; removals need tombstones, or a removed label comes back, which is what happened to deleted items in Amazon's Dynamo shopping cart.</span>
    <span data-lang-vi>Gộp một tập nhãn thì dễ; còn xoá thì cần tombstone, nếu không nhãn đã xoá sẽ quay lại, đúng như chuyện món hàng đã xoá hiện lại trong giỏ hàng Dynamo của Amazon.</span>
  </figcaption>
</figure>

<style>
  .lww {
    margin: 2em 0;
    width: 100%;
  }
  .lww-scroll {
    overflow-x: auto;
  }
  .lww svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .lww text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .lww .lww-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .lww .lww-sub,
  .lww .lww-note {
    fill: var(--text-muted);
  }
  .lww .lww-note {
    font-size: 12.5px;
  }
  .lww .lww-val {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .lww .lww-call {
    font-size: 14px;
    fill: var(--text-body);
  }
  .lww .lww-call.is-bad,
  .lww .lww-lost {
    fill: var(--red);
    font-weight: 700;
  }
  .lww .lww-lost {
    font-size: 12.5px;
  }
  .lww-box {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .lww-box.is-result {
    stroke-width: 1.8;
    stroke: var(--text);
  }
  .lww-group {
    fill: none;
    stroke: var(--text-faint);
    stroke-dasharray: 5 4;
  }
  .lww-edge {
    stroke: var(--text-muted);
    stroke-width: 1.4;
  }
  .lww-edge.is-lost {
    stroke: var(--red);
    stroke-dasharray: 5 4;
  }
  .lww-head {
    fill: var(--text-muted);
  }
  .lww-rule {
    stroke: var(--border);
  }
  .lww figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
