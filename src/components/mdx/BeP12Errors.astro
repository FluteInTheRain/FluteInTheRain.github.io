---
// Failed requests per second at 20 requests/s, from the three final runs.
// naive: {5:7, 6:10, 7:12, 8:18, 9:13, 10:7} = 67 of 351.
// readiness only: none, 0 of 548. readiness + preStop + graceful: none, 0 of 523.
const W = 900, H = 330;
const data: Record<number, number> = { 5: 7, 6: 10, 7: 12, 8: 18, 9: 13, 10: 7 };
const secs = Array.from({ length: 14 }, (_, i) => i);
const bx = (s: number) => 100 + s * 54;
const by = (n: number) => 190 - n * 7;
---
<figure class="bep12j">
  <div class="bep12j-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Bar chart of failed requests per second during a rollout at 20 requests per second. With no probes the failures sit in seconds 5 to 10, between 7 and 18 per second, 67 in total. With readiness only, and with readiness plus preStop plus graceful shutdown, every second shows zero failures.">
    <text x="40" y="26" class="h"><tspan data-lang-en>failed requests per second during the rollout</tspan><tspan data-lang-vi>request lỗi mỗi giây trong lúc rollout</tspan></text>
    <line x1="90" y1="190" x2="860" y2="190" class="axis" />
    {[0, 10, 20].map((n) => (
      <g>
        <line x1="90" y1={by(n)} x2="860" y2={by(n)} class="grid" />
        <text x="76" y={by(n) + 4} text-anchor="end" class="sm"><tspan data-lang-en>{n}</tspan><tspan data-lang-vi>{n}</tspan></text>
      </g>
    ))}
    {secs.map((s) => (
      <g>
        {data[s] ? <rect x={bx(s)} y={by(data[s])} width="38" height={data[s] * 7} class="bar" /> : <rect x={bx(s)} y="186" width="38" height="4" class="zero" />}
        {data[s] && <text x={bx(s) + 19} y={by(data[s]) - 6} text-anchor="middle" class="val"><tspan data-lang-en>{data[s]}</tspan><tspan data-lang-vi>{data[s]}</tspan></text>}
        <text x={bx(s) + 19} y="210" text-anchor="middle" class="sm"><tspan data-lang-en>{s}</tspan><tspan data-lang-vi>{s}</tspan></text>
      </g>
    ))}
    <text x="40" y="234" class="sm"><tspan data-lang-en>second</tspan><tspan data-lang-vi>giây</tspan></text>
    <rect x="40" y="258" width="14" height="14" class="bar" />
    <text x="62" y="270" class="t red"><tspan data-lang-en>no probes: 67 of 351 failed</tspan><tspan data-lang-vi>không probe: 67 trên 351 lỗi</tspan></text>
    <rect x="320" y="258" width="14" height="14" class="zero" />
    <text x="342" y="270" class="t"><tspan data-lang-en>readiness only: 0 of 548</tspan><tspan data-lang-vi>chỉ readiness: 0 trên 548</tspan></text>
    <text x="620" y="270" class="t"><tspan data-lang-en>all three: 0 of 523</tspan><tspan data-lang-vi>cả ba: 0 trên 523</tspan></text>
    <text x="40" y="306" class="sm"><tspan data-lang-en>one run each, 20 requests per second, new connection per request</tspan><tspan data-lang-vi>mỗi cấu hình chạy một lần, 20 request mỗi giây, mỗi request một connection mới</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The errors line up with the rollout: they start when the first old pod is killed and stop when the last new pod is really up.</span>
    <span data-lang-vi>Lỗi trùng đúng khoảng rollout: bắt đầu khi pod cũ đầu tiên bị giết, hết khi pod mới cuối cùng thật sự chạy.</span>
  </figcaption>
</figure>

<style>
  .bep12j { margin: 2em 0; width: 100%; }
  .bep12j-scroll { overflow-x: auto; }
  .bep12j svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .bep12j text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep12j .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep12j .sm { fill: var(--text-muted); font-size: 13px; }
  .bep12j .val { font-weight: 700; fill: var(--red); font-size: 13px; }
  .bep12j .t { font-weight: 700; fill: var(--text); }
  .bep12j text.red { fill: var(--red); }
  .bep12j .bar { fill: var(--red); }
  .bep12j .zero { fill: var(--gold-icon); }
  .bep12j .axis { stroke: var(--text-muted); stroke-width: 1.4; }
  .bep12j .grid { stroke: var(--border); stroke-width: 1; stroke-dasharray: 3 5; }
  .bep12j figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
