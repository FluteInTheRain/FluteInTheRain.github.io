---
// Sequence of the unfriend / post race. Time runs top to bottom.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 420;
const heads = (x2: number, y: number, dir = 1) => `${x2 - 7 * dir},${y - 4} ${x2 - 7 * dir},${y + 4} ${x2},${y}`;
const cols = [
  { x: 70, icon: 'user', en: 'Alice', vi: 'Alice' },
  { x: 260, icon: 'db', en: 'Messages service', vi: 'Service tin nhắn' },
  { x: 450, icon: 'db', en: 'Friendships service', vi: 'Service bạn bè' },
  { x: 670, icon: 'worker', en: 'Notification worker', vi: 'Worker thông báo' },
  { x: 830, icon: 'user', en: 'Bob', vi: 'Bob' },
];
// [x1, x2, y, en, vi, hot, dashed, labelX]
const msgs: [number, number, number, string, string, boolean, boolean, number][] = [
  [70, 450, 140, '1. unfriend Bob', '1. hủy kết bạn Bob', false, false, 82],
  [70, 260, 186, '2. post for friends only', '2. đăng bài cho bạn bè', false, false, 82],
  [260, 670, 232, '3. post event', '3. sự kiện bài đăng', false, false, 272],
  [670, 830, 346, '5. email', '5. gửi email', true, false, 682],
  [450, 670, 388, '6. unfriend arrives too late', '6. hủy kết bạn tới quá muộn', true, true, 462],
];
---
<figure class="ua-fig">
  <div class="ua-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Alice unfriends Bob and then posts for friends only. The notification worker receives the post event before the unfriend event, reads a stale friend list in which Bob is still a friend, and emails Bob.">
      {cols.map((c) => (
        <>
          <DiagramIcon name={c.icon as any} x={c.x} y={34} size={30} />
          <text x={c.x} y="70" text-anchor="middle" class="ua-b"><tspan data-lang-en>{c.en}</tspan><tspan data-lang-vi>{c.vi}</tspan></text>
          <path d={`M${c.x},82 L${c.x},${H - 10}`} class="ua-life" />
        </>
      ))}
      {msgs.map(([x1, x2, y, en, vi, hot, dashed, lx]) => (
        <>
          <path d={`M${x1},${y} L${x2 - 7},${y}`} class={`${dashed ? 'ua-dashed' : 'ua-solid'}${hot ? ' is-hot' : ''}`} />
          <polygon points={heads(x2, y)} class={hot ? 'ua-head is-hot' : 'ua-head'} />
          <text x={lx} y={y - 7} class={hot ? 'ua-n is-hot' : 'ua-n'}><tspan data-lang-en>{en}</tspan><tspan data-lang-vi>{vi}</tspan></text>
        </>
      ))}
      <rect x="560" y="258" width="220" height="56" rx="4" class="ua-box is-hot" />
      <text x="670" y="280" text-anchor="middle" class="ua-b is-hot"><tspan data-lang-en>4. joins with stale data:</tspan><tspan data-lang-vi>4. join với dữ liệu cũ:</tspan></text>
      <text x="670" y="300" text-anchor="middle" class="ua-m is-hot"><tspan data-lang-en>Bob is still a friend</tspan><tspan data-lang-vi>Bob vẫn còn là bạn</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Time runs downward. The two events travel through different services, and the post wins the race.</span>
    <span data-lang-vi>Thời gian chạy từ trên xuống. Hai sự kiện đi qua hai service khác nhau, và bài đăng về đích trước.</span>
  </figcaption>
</figure>

<style>
  .ua-fig { margin: 2em 0; width: 100%; }
  .ua-scroll { overflow-x: auto; }
  .ua-fig svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .ua-fig text { font-size: 13px; fill: var(--text-body); }
  .ua-fig .ua-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-ph { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-b { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-m { font-size: 12.5px; fill: var(--text-muted); }
  .ua-fig .ua-n { font-size: 12.5px; font-weight: 700; fill: var(--text-muted); }
  .ua-fig .ua-n.is-hot, .ua-fig .ua-b.is-hot, .ua-fig .ua-m.is-hot { fill: var(--red); }
  .ua-fig .ua-n.is-good, .ua-fig .ua-b.is-good, .ua-fig .ua-m.is-good { fill: var(--gold-icon); }
  .ua-fig .ua-q { font-size: 20px; font-weight: 700; fill: var(--red); }
  .ua-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .ua-box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .ua-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .ua-panel { fill: none; stroke: var(--border); stroke-width: 1.2; }
  .ua-life { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .ua-solid { fill: none; stroke: var(--text-muted); stroke-width: 1.8; }
  .ua-dashed { fill: none; stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .ua-head { fill: var(--text-muted); }
  .ua-solid.is-hot, .ua-dashed.is-hot { stroke: var(--red); stroke-width: 1.9; }
  .ua-head.is-hot { fill: var(--red); }
  .ua-solid.is-good { stroke: var(--gold-icon); stroke-width: 2; }
  .ua-head.is-good { fill: var(--gold-icon); }
  .ua-fig figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
