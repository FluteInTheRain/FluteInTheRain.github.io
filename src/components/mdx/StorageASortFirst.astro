---
// LSM-tree, picture first: writes arrive in any order, are logged and sorted in memory,
// then flushed as one sorted, never-changed file. Keys are illustrative.
// Plain inline SVG, site tokens, polygon arrowheads, no ids.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 396;
function arrowRight(x1: number, x2: number, y: number) {
  return { line: `M${x1},${y} L${x2 - 7},${y}`, head: `${x2 - 8},${y - 5} ${x2 - 8},${y + 5} ${x2},${y}` };
}
function arrowDown(x: number, y1: number, y2: number) {
  return { line: `M${x},${y1} L${x},${y2 - 7}`, head: `${x - 5},${y2 - 8} ${x + 5},${y2 - 8} ${x},${y2}` };
}
const toMem = arrowRight(214, 330, 120);
const toWal = arrowDown(110, 166, 252);
const flush = arrowDown(460, 166, 252);
const arrival = ['user9', 'user2', 'user5'];
const sorted = ['user2', 'user5', 'user9'];
---
<figure class="srt">
  <div class="srt-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="How an LSM-tree keeps files sorted without rewriting them. Step 1: writes arrive in any order, here user9, user2, user5. Each is appended to the write-ahead log on disk in arrival order and inserted into the memtable in memory, which keeps keys sorted. Step 2: when the memtable is full it is written to disk in one go as an SSTable, a sorted file that is never changed.">
    <text x="20" y="24" class="srt-h">
      <tspan data-lang-en>Sort in memory, write to disk in one go</tspan>
      <tspan data-lang-vi>Sắp xếp trong RAM, ghi xuống đĩa một lượt</tspan>
    </text>
    <text x="20" y="46" class="srt-sub">
      <tspan data-lang-en>The disk only ever sees appends and whole new files, so sorted order costs no in-place rewrites.</tspan>
      <tspan data-lang-vi>Đĩa chỉ thấy lệnh nối thêm và các file mới nguyên cả cái, nên giữ thứ tự không cần ghi đè tại chỗ.</tspan>
    </text>

    <text x="880" y="74" text-anchor="end" class="srt-small">
      <tspan data-lang-en>memory</tspan>
      <tspan data-lang-vi>bộ nhớ (RAM)</tspan>
    </text>
    <line x1="20" x2="880" y1="206" y2="206" class="srt-divider" />
    <text x="880" y="224" text-anchor="end" class="srt-small">
      <tspan data-lang-en>disk</tspan>
      <tspan data-lang-vi>đĩa</tspan>
    </text>

    {/* writes */}
    <rect x="20" y="66" width="194" height="100" rx="4" class="srt-box" />
    <DiagramIcon name="laptop" x="44" y="90" size={26} />
    <text x="66" y="95" class="srt-in-s">
      <tspan data-lang-en>Writes arrive</tspan>
      <tspan data-lang-vi>Lệnh ghi tới</tspan>
    </text>
    {arrival.map((k, i) => (
      <text x="34" y={120 + i * 16} class="srt-mono">{i + 1}. {k} = ...</text>
    ))}

    {/* memtable */}
    <rect x="330" y="66" width="300" height="100" rx="4" class="srt-box" />
    <DiagramIcon name="index" x="354" y="90" size={26} />
    <text x="376" y="95" class="srt-in-s">
      <tspan data-lang-en>Memtable, kept sorted</tspan>
      <tspan data-lang-vi>Memtable, luôn được sắp xếp</tspan>
    </text>
    {sorted.map((k, i) => (
      <g>
        <rect x={344 + i * 92} y="112" width="82" height="36" rx="3" class="srt-cell" />
        <text x={344 + i * 92 + 41} y="135" text-anchor="middle" class="srt-mono">{k}</text>
      </g>
    ))}
    <path d={toMem.line} class="srt-arrow" /><polygon points={toMem.head} class="srt-head" />
    <text x="222" y="104" class="srt-note">
      <tspan data-lang-en>1b</tspan>
      <tspan data-lang-vi>1b</tspan>
    </text>

    {/* WAL */}
    <path d={toWal.line} class="srt-arrow" /><polygon points={toWal.head} class="srt-head" />
    <text x="122" y="214" class="srt-note">
      <tspan data-lang-en>1a</tspan>
      <tspan data-lang-vi>1a</tspan>
    </text>
    <rect x="20" y="256" width="194" height="100" rx="4" class="srt-box" />
    <DiagramIcon name="log" x="44" y="280" size={26} />
    <text x="66" y="285" class="srt-in-s">
      <tspan data-lang-en>Write-ahead log</tspan>
      <tspan data-lang-vi>Write-ahead log</tspan>
    </text>
    {arrival.map((k, i) => (
      <text x="34" y={310 + i * 16} class="srt-mono">{i + 1}. {k} = ...</text>
    ))}
    <text x="34" y="368" class="srt-note">
      <tspan data-lang-en>arrival order, for crash recovery</tspan>
      <tspan data-lang-vi>theo thứ tự tới, để khôi phục</tspan>
    </text>

    {/* flush */}
    <path d={flush.line} class="srt-arrow is-good" /><polygon points={flush.head} class="srt-head is-good" />
    <text x="474" y="214" class="srt-note is-good">
      <tspan data-lang-en>2: memtable is full, write it out once</tspan>
      <tspan data-lang-vi>2: memtable đầy, ghi ra đĩa một lượt</tspan>
    </text>
    <rect x="330" y="256" width="300" height="100" rx="4" class="srt-box is-good" />
    <DiagramIcon name="disk" x="354" y="280" size={26} />
    <text x="376" y="285" class="srt-in-s">
      <tspan data-lang-en>SSTable: sorted, never changed</tspan>
      <tspan data-lang-vi>SSTable: đã sắp xếp, không sửa</tspan>
    </text>
    {sorted.map((k, i) => (
      <g>
        <rect x={344 + i * 92} y="302" width="82" height="36" rx="3" class="srt-cell is-good" />
        <text x={344 + i * 92 + 41} y="325" text-anchor="middle" class="srt-mono is-good">{k}</text>
      </g>
    ))}

    {/* takeaway */}
    <g data-lang-en>
      <text x="670" y="112" class="srt-in-s">Why this works</text>
      <text x="670" y="134" class="srt-note">A sorted file needs no</text>
      <text x="670" y="152" class="srt-note">rewrite later: sorting</text>
      <text x="670" y="170" class="srt-note">happened in memory first.</text>
    </g>
    <g data-lang-vi>
      <text x="670" y="112" class="srt-in-s">Vì sao cách này chạy được</text>
      <text x="670" y="134" class="srt-note">File đã sắp xếp không cần</text>
      <text x="670" y="152" class="srt-note">viết lại sau: việc sắp xếp</text>
      <text x="670" y="170" class="srt-note">đã xong trong RAM trước.</text>
    </g>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>An LSM-tree in two steps, with made-up keys. Step 1 happens on every write (1a log, 1b memtable); step 2 happens once the memtable has a few megabytes.</span>
    <span data-lang-vi>LSM-tree trong hai bước, với khoá bịa ra. Bước 1 xảy ra ở mỗi lần ghi (1a log, 1b memtable); bước 2 xảy ra khi memtable đầy vài megabyte.</span>
  </figcaption>
</figure>

<style>
  .srt { margin: 2em 0; width: 100%; }
  .srt-scroll { overflow-x: auto; }
  .srt svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .srt text { font-size: 14px; fill: var(--text-body); }
  .srt .srt-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .srt .srt-sub { fill: var(--text-muted); }
  .srt-rule { stroke: var(--border); }
  .srt-divider { stroke: var(--border); stroke-dasharray: 6 5; }
  .srt-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .srt-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .srt-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .srt-cell { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .srt-cell.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .srt-cell.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .srt-cell.is-dead { fill: var(--bg-alt); stroke: var(--text-muted); stroke-dasharray: 3 3; }
  .srt .srt-in { font-weight: 600; fill: var(--text); }
  .srt .srt-in-b { font-weight: 700; fill: var(--text); }
  .srt .srt-in-m { font-size: 13px; fill: var(--text-body); }
  .srt .srt-in-s { font-size: 13px; font-weight: 600; fill: var(--text); }
  .srt .srt-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; fill: var(--text-body); }
  .srt .srt-mono.is-good { fill: var(--gold-icon); font-weight: 700; }
  .srt .srt-mono.is-bad { fill: var(--red); font-weight: 700; }
  .srt .srt-note { font-size: 13px; fill: var(--text-muted); }
  .srt .srt-note.is-good { fill: var(--gold-icon); font-weight: 700; }
  .srt .srt-note.is-bad { fill: var(--red); font-weight: 700; }
  .srt .srt-small { font-size: 12px; fill: var(--text-muted); }
  .srt .srt-num { font-size: 12px; font-weight: 700; fill: var(--text); }
  .srt-circle { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .srt-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .srt-arrow.is-good { stroke: var(--gold-icon); stroke-width: 1.8; }
  .srt-arrow.is-bad { stroke: var(--red); stroke-width: 1.8; }
  .srt-head { fill: var(--text-muted); }
  .srt-head.is-good { fill: var(--gold-icon); }
  .srt-head.is-bad { fill: var(--red); }
  .srt figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
