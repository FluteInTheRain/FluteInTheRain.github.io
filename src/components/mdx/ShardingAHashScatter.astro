---
// Hash sharding picture: neighbouring keys get unrelated hash values and land on different shards.
// Hash values are illustrative (not real MD5 or Murmur3 output). Inline SVG, site tokens.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const A = (x1: number, y1: number, x2: number, y2: number, c = '') => {
  const a = arrow(x1, y1, x2, y2);
  return { ...a, c };
};

const W = 900;
const H = 340;
const rows = [
  { key: 'sensor_1', hash: '52,430', shard: 3, range: '49k–65k' },
  { key: 'sensor_2', hash: '9,118', shard: 0, range: '0–16k' },
  { key: 'sensor_3', hash: '38,220', shard: 2, range: '32k–49k' },
  { key: 'sensor_4', hash: '21,005', shard: 1, range: '16k–32k' },
];
---
<figure class="shaa-hs">
  <div class="shaa-hs-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Hash sharding. Four neighbouring keys, sensor_1 to sensor_4, are hashed to unrelated values 52,430, 9,118, 38,220 and 21,005, which land on shards 3, 0, 2 and 1. Writes spread evenly, but the keys are no longer next to each other.">
      <text x="20" y="32" class="sub"><tspan data-lang-en>Neighbouring keys</tspan><tspan data-lang-vi>Các khoá liền kề</tspan></text>
      <text x="270" y="32" class="sub"><tspan data-lang-en>Hash value</tspan><tspan data-lang-vi>Giá trị băm</tspan></text>
      <text x="600" y="32" class="sub"><tspan data-lang-en>Shard that owns that hash range</tspan><tspan data-lang-vi>Shard giữ dải băm đó</tspan></text>
      {rows.map((r, i) => {
        const y = 50 + i * 56;
        const a1 = A(170, y + 22, 270, y + 22);
        const a2 = A(500, y + 22, 600, y + 22, 'is-fix');
        return (
          <g>
            <rect x="20" y={y} width="150" height="44" rx="6" class="box" />
            <DiagramIcon name="key" x={46} y={y + 22} size={22} />
            <text x="72" y={y + 27} class="b">{r.key}</text>
            <path d={a1.line} class="arrow" /><polygon points={a1.head} class="head" />

            <rect x="270" y={y} width="230" height="44" rx="6" class="box" />
            <text x="385" y={y + 27} text-anchor="middle" class="s">{`hash(${r.key}) = ${r.hash}`}</text>
            <path d={a2.line} class="arrow is-fix" /><polygon points={a2.head} class="head is-fix" />

            <rect x="600" y={y} width="280" height="44" rx="6" class="box is-fix" />
            <DiagramIcon name="db" x={628} y={y + 22} size={24} />
            <text x="656" y={y + 27} class="b">{`Shard ${r.shard}`}</text>
            <text x="730" y={y + 27} class="s">{`[${r.range}]`}</text>
          </g>
        );
      })}
      <DiagramIcon name="warning" x={34} y={298} size={22} />
      <text x="62" y="303" class="s is-hot"><tspan data-lang-en>Writes spread over four shards, but the neighbours are now on four different shards, so a key-range scan has to ask them all.</tspan><tspan data-lang-vi>Lệnh ghi rải ra bốn shard, nhưng các khoá liền kề giờ nằm ở bốn shard khác nhau, nên quét theo khoảng phải hỏi cả bốn.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A hash function throws neighbours far apart on purpose. That evens out writes and gives up the sort order.</span>
    <span data-lang-vi>Hàm băm cố tình ném các khoá liền kề ra xa nhau. Nhờ vậy lệnh ghi đều tay nhưng mất thứ tự sắp xếp.</span>
  </figcaption>
</figure>

<style>
  .shaa-hs { margin: 2em 0; width: 100%; }
  .shaa-hs-scroll { overflow-x: auto; }
  .shaa-hs svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shaa-hs text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shaa-hs .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shaa-hs .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shaa-hs .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shaa-hs .b.is-hot { fill: var(--red); }
  .shaa-hs .s { font-size: 12px; fill: var(--text-body); }
  .shaa-hs .s.is-hot { fill: var(--red); font-weight: 600; }
  .shaa-hs .big { font-size: 18px; font-weight: 700; fill: var(--text); }
  .shaa-hs .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shaa-hs .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shaa-hs .box.is-fix { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-hs .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shaa-hs .box.is-dim { opacity: 0.45; }
  .shaa-hs .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shaa-hs .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shaa-hs .arrow.is-hot { stroke: var(--red); }
  .shaa-hs .arrow.is-fix { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-hs .head { fill: var(--text-muted); }
  .shaa-hs .head.is-hot { fill: var(--red); }
  .shaa-hs .head.is-fix { fill: var(--gold-icon); }
  .shaa-hs figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
