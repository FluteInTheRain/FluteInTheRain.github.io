---
// Cloudflare's 18 Nov 2025 incident, times from the post-mortem as quoted in the
// hook: 11:20 start, 13:37 rollback work, 14:24 propagation stopped, 14:30 core
// traffic mostly normal, 17:06 everything. x is minutes since 11:20 (0..346).
const W = 900, H = 290, x0 = 60, k = 780 / 346, ay = 150;
const X = (m: number) => x0 + m * k;
const ev = [
  { m: 0, t: '11:20 UTC', up: true, ly: 100, anchor: 'start', en: 'incident starts', vi: 'sự cố bắt đầu' },
  { m: 137, t: '13:37', up: true, ly: 100, anchor: 'middle', en: 'rollback of the file', vi: 'rollback file cấu hình' },
  { m: 190, t: '14:30', up: true, ly: 52, anchor: 'start', en: 'core traffic mostly normal', vi: 'lưu lượng chính gần như bình thường' },
  { m: 184, t: '14:24', up: false, ly: 206, anchor: 'start', en: 'new file propagation stopped', vi: 'ngừng phát file mới' },
  { m: 346, t: '17:06', up: true, ly: 100, anchor: 'end', en: 'everything working', vi: 'mọi thứ chạy lại' },
];
---
<figure class="bep10t">
  <div class="bep10t-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A timeline of the 18 November 2025 Cloudflare incident. From 11:20 UTC to 13:37 the stretch is drawn in red: the team suspected a hyper-scale DDoS attack. Then rollback work at 13:37, new file propagation stopped at 14:24, core traffic mostly normal at 14:30 and everything working at 17:06.">
    <line x1={X(0)} y1={ay} x2={X(346)} y2={ay} class="axis" />
    <line x1={X(0)} y1={ay} x2={X(137)} y2={ay} class="redline" />
    {ev.map((e) => (
      <g>
        <circle cx={X(e.m)} cy={ay} r="5" class={e.m === 0 || e.m === 137 ? 'dotr' : 'dot'} />
        <line x1={X(e.m)} y1={ay + (e.up ? -6 : 6)} x2={X(e.m)} y2={e.up ? e.ly + 28 : e.ly - 18} class="ln" />
        <text x={X(e.m)} y={e.ly} text-anchor={e.anchor} class="b">{e.t}</text>
        <text x={X(e.m)} y={e.ly + 18} text-anchor={e.anchor} class="m"><tspan data-lang-en>{e.en}</tspan><tspan data-lang-vi>{e.vi}</tspan></text>
      </g>
    ))}
    <text x={X(137) / 2 + 30} y="190" text-anchor="middle" class="r"><tspan data-lang-en>more than two hours of guessing</tspan><tspan data-lang-vi>hơn hai tiếng đoán mò</tspan></text>
    <text x={X(137) / 2 + 30} y="210" text-anchor="middle" class="m"><tspan data-lang-en>first suspect: a "hyper-scale DDoS attack"</tspan><tspan data-lang-vi>nghi đầu tiên: "hyper-scale DDoS attack"</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The first stretch, in red, is the gap the post is about: the team reached "this file, this limit" only after more than two hours. Times are the ones in Cloudflare's post-mortem.</span>
    <span data-lang-vi>Đoạn đầu, màu đỏ, là khoảng trống mà bài viết nói tới: đội mới tới được "file này, giới hạn này" sau hơn hai tiếng. Các mốc giờ lấy từ post-mortem của Cloudflare.</span>
  </figcaption>
</figure>

<style>
  .bep10t { margin: 2em 0; width: 100%; }
  .bep10t-scroll { overflow-x: auto; }
  .bep10t svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep10t text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep10t .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep10t .m { fill: var(--text-muted); font-size: 13px; }
  .bep10t .b { font-weight: 700; fill: var(--text); }
  .bep10t .r { fill: var(--red); font-weight: 700; }
  .bep10t .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep10t .boxr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .bep10t .ln { stroke: var(--text-faint); stroke-width: 1.4; }
  .bep10t .lnr { stroke: var(--red); stroke-width: 1.6; }
  .bep10t .axis { stroke: var(--border); stroke-width: 2; }
  .bep10t .redline { stroke: var(--red); stroke-width: 5; }
  .bep10t .dot { fill: var(--text-muted); }
  .bep10t .dotr { fill: var(--red); }
  .bep10t .arrow { fill: var(--text-faint); }
  .bep10t .arrowr { fill: var(--red); }
  .bep10t figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
