---
import DiagramIcon from './DiagramIcon.astro';
// Picture-first overview of the four data models the post walks through, each with one real case.
// Arrowheads are polygons: no SVG ids.
const W = 900;
const H = 300;
type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}
const frames: any[] = [];
const boxes: any[] = [];
const links: any[] = [];
const labels: any[] = [];
const nums: any[] = [];
const tiles = [
  { icon: 'db', en: 'Tables', vi: 'Bảng', l1: ['Rows in tables, linked', 'by ids and joins'], v1: ['Dòng trong bảng, nối', 'nhau bằng id và join'], c: 'Diaspora, after the move', cv: 'Diaspora, sau khi chuyển' },
  { icon: 'file', en: 'Documents', vi: 'Document', l1: ['One nested record,', 'read in one go'], v1: ['Một bản ghi lồng nhau,', 'đọc một lần là xong'], c: "Mei's TV-show site", cv: 'Site phim của Mei' },
  { icon: 'network', en: 'Graph', vi: 'Graph', l1: ['Things and the links', 'between them'], v1: ['Các thứ và những mối', 'nối giữa chúng'], c: "Facebook's TAO", cv: 'TAO của Facebook' },
  { icon: 'log', en: 'Event log', vi: 'Event log', l1: ['Every change kept,', 'state computed by replay'], v1: ['Giữ mọi thay đổi, state', 'tính bằng cách replay'], c: 'Netflix downloads', cv: 'Netflix: tải phim' },
];
tiles.forEach((t, i) => {
  const x = 10 + i * 222;
  frames.push({ x, y: 10, w: 208, h: 280 });
  labels.push({ x: x + 54, y: 50, en: t.en, vi: t.vi, cls: 'h' });
  labels.push({ x: x + 14, y: 196, en: t.l1[0], vi: t.v1[0], cls: 'strong' });
  labels.push({ x: x + 14, y: 214, en: t.l1[1], vi: t.v1[1], cls: 'strong' });
  labels.push({ x: x + 14, y: 258, en: t.c, vi: t.cv, cls: 'muted' });
});
const tx = (i: number) => 10 + i * 222;
---
<figure class="dmfs">
  <div class="dmfs-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four ways to shape data. Tables: rows linked by ids and joins, as in Diaspora after the move to MySQL. Documents: one nested record read in one go, as in Mei's TV-show site. Graph: things and the links between them, as in Facebook's TAO. Event log: every change kept and the state computed by replay, as in Netflix downloads.">
    {frames.map((f) => (
      <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="6" class={`dmfs-frame ${f.kind ?? ''}`} />
    ))}
    {boxes.map((b) => {
      const n = Math.max(b.en.length, b.vi.length);
      const top = !!b.top;
      const cx = b.x + b.w / 2;
      const x0 = top ? cx : b.icon ? b.x + 46 : b.x + 14;
      const y0 = top ? b.y + (b.icon ? 56 : 24) : b.y + b.h / 2 - ((n - 1) * 17) / 2 + 4;
      return (
        <g class={`dmfs-box ${b.kind ?? ''}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
          {b.icon && <DiagramIcon name={b.icon} x={top ? cx : b.x + 24} y={top ? b.y + 24 : b.y + b.h / 2} size={b.is ?? 26} />}
          {Array.from({ length: n }).map((_, i) => (
            <text x={x0} y={y0 + i * 17} text-anchor={top ? 'middle' : 'start'} class={i === 0 && !b.flat ? 'dmfs-name' : 'dmfs-sub'}>
              <tspan data-lang-en>{b.en[i] ?? ''}</tspan>
              <tspan data-lang-vi>{b.vi[i] ?? ''}</tspan>
            </text>
          ))}
        </g>
      );
    })}
    {links.map((l) => {
      const a = arrow(l.pts);
      return (
        <g>
          <polyline points={l.plain ? l.pts.map((p) => p.join(',')).join(' ') : a.line} class={`dmfs-edge ${l.kind ?? ''}`} fill="none" />
          {!l.plain && <polygon points={a.head} class={`dmfs-head ${l.kind ?? ''}`} />}
        </g>
      );
    })}
    {labels.map((t) => (
      <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`dmfs-lab ${t.cls ?? ''}`}>
        <tspan data-lang-en>{t.en}</tspan>
        <tspan data-lang-vi>{t.vi ?? t.en}</tspan>
      </text>
    ))}
    {nums.map((n) => (
      <g class="dmfs-num">
        <circle cx={n.x} cy={n.y} r="11" />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.n}</text>
      </g>
    ))}
    {tiles.map((t, i) => <DiagramIcon name={t.icon} x={tx(i) + 28} y={44} size={32} />)}
    {/* tables */}
    {[0, 1, 2].map((r) => [0, 1, 2].map((c) => (
      <rect x={tx(0) + 22 + c * 54} y={80 + r * 24} width="50" height="20" rx="2" class={r === 0 ? 'dmfs-cell is-head' : 'dmfs-cell'} />
    )))}
    <text x={tx(0) + 47} y={94} text-anchor="middle" class="mono">id</text>
    <text x={tx(0) + 101} y={94} text-anchor="middle" class="mono">name</text>
    <text x={tx(0) + 155} y={94} text-anchor="middle" class="mono">user</text>
    {/* documents */}
    <rect x={tx(1) + 24} y={78} width="160" height="92" rx="4" class="dmfs-cell" />
    <rect x={tx(1) + 38} y={104} width="132" height="54" rx="4" class="dmfs-cell is-head" />
    <rect x={tx(1) + 52} y={126} width="104" height="22" rx="3" class="dmfs-cell" />
    {/* graph */}
    <line x1={tx(2) + 50} y1="100" x2={tx(2) + 104} y2="124" class="dmfs-line" />
    <line x1={tx(2) + 104} y1="124" x2={tx(2) + 158} y2="94" class="dmfs-line" />
    <line x1={tx(2) + 104} y1="124" x2={tx(2) + 80} y2="164" class="dmfs-line" />
    <line x1={tx(2) + 50} y1="100" x2={tx(2) + 80} y2="164" class="dmfs-line" />
    {[[50, 100], [104, 124], [158, 94], [80, 164]].map((p) => <circle cx={tx(2) + p[0]} cy={p[1]} r="12" class="dmfs-cell is-head" />)}
    {/* log */}
    {[0, 1, 2, 3].map((k) => (
      <g>
        <rect x={tx(3) + 14 + k * 47} y="108" width="38" height="34" rx="3" class={k === 3 ? 'dmfs-cell is-new' : 'dmfs-cell'} />
        <text x={tx(3) + 33 + k * 47} y="130" text-anchor="middle" class="mono">e{k + 1}</text>
        {k < 3 && <line x1={tx(3) + 52 + k * 47} y1="125" x2={tx(3) + 61 + k * 47} y2="125" class="dmfs-line" />}
      </g>
    ))}
    <text x={tx(3) + 104} y="164" text-anchor="middle" class="dmfs-sub-note">
      <tspan data-lang-en>new events go on the end</tspan>
      <tspan data-lang-vi>event mới nối vào cuối</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Each model suits a different shape of data. The rest of the post follows one real team through each of them.</span>
    <span data-lang-vi>Mỗi model hợp với một hình dạng dữ liệu khác nhau. Phần còn lại của bài đi theo một đội thật qua từng model.</span>
  </figcaption>
</figure>

<style>
  .dmfs { margin: 2em 0; width: 100%; }
  .dmfs-scroll { overflow-x: auto; }
  .dmfs svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dmfs text { font-size: 14px; fill: var(--text-body); }
  .dmfs .dmfs-name { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .dmfs .dmfs-sub { font-size: 12px; fill: var(--text-muted); }
  .dmfs .dmfs-lab { font-size: 13px; }
  .dmfs .dmfs-lab.h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dmfs .dmfs-lab.strong { font-weight: 700; fill: var(--text); }
  .dmfs .dmfs-lab.muted { fill: var(--text-muted); }
  .dmfs .dmfs-lab.bad { font-weight: 700; fill: var(--red); }
  .dmfs .dmfs-lab.good { font-weight: 700; fill: var(--text); }
  .dmfs .dmfs-lab.mono, .dmfs .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .dmfs-frame { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .dmfs-frame.bad { stroke: var(--red); }
  .dmfs-frame.good { stroke: var(--gold); }
  .dmfs-box rect { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmfs-box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dmfs-box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmfs-box.plain rect { fill: none; stroke: var(--border); }
  .dmfs-edge { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmfs-edge.bad { stroke: var(--red); }
  .dmfs-edge.good { stroke: var(--gold-icon); }
  .dmfs-head { fill: var(--text-muted); }
  .dmfs-head.bad { fill: var(--red); }
  .dmfs-head.good { fill: var(--gold-icon); }
  .dmfs-num circle { fill: var(--bg-alt); stroke: var(--text-muted); }
  .dmfs-num text { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dmfs figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  .dmfs-cell { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmfs-cell.is-head { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmfs-cell.is-new { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmfs-line { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmfs .dmfs-sub-note { font-size: 12px; fill: var(--text-muted); }
</style>
