---
// A topic with four partitions read by two consumer groups: fan-out across groups, one reader per partition inside a group.
// Topic, group and worker names are illustrative.
import DiagramIcon from './DiagramIcon.astro';
import StreamAFrame from './StreamAFrame.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    h: 'Four partitions, two consumer groups',
    th: 'Topic: 4 partitions', bh: 'Billing group, 2 workers', sh: 'Search group, 1 worker',
    part: 'Partition', wk: 'Worker', reads: 'reads',
    n1: 'Across groups: each group reads all four partitions (fan-out).',
    n2: 'Inside a group: each partition has exactly one reader, so a 5th billing worker would sit idle.',
    alt: 'A topic with partitions 0 to 3. The billing group has two workers: worker 1 reads partitions 0 and 1, worker 2 reads partitions 2 and 3. The search group has one worker that reads all four partitions.',
    cap: 'Partitions are handed out whole. That is why the number of partitions caps how many workers in one group can do useful work.',
  },
  vi: {
    h: 'Bốn partition, hai consumer group',
    th: 'Topic: 4 partition', bh: 'Nhóm billing, 2 worker', sh: 'Nhóm search, 1 worker',
    part: 'Partition', wk: 'Worker', reads: 'đọc',
    n1: 'Giữa các nhóm: mỗi nhóm đọc cả bốn partition (fan-out).',
    n2: 'Trong một nhóm: mỗi partition chỉ có đúng một bên đọc, nên worker billing thứ 5 sẽ ngồi không.',
    alt: 'Một topic có partition 0 đến 3. Nhóm billing có hai worker: worker 1 đọc partition 0 và 1, worker 2 đọc partition 2 và 3. Nhóm search có một worker đọc cả bốn partition.',
    cap: 'Partition được giao nguyên khối. Vì vậy số partition là trần cho số worker trong một nhóm có việc để làm.',
  },
}[lang];
const ys = [92, 146, 200, 254];
const ch = 46;
const billing = [
  { y: 92, h: 100, r: 'P0, P1', n: 1 },
  { y: 200, h: 100, r: 'P2, P3', n: 2 },
];
---
<StreamAFrame h={366} alt={T.alt} cap={T.cap} title={T.h}>
  <DiagramIcon name="kafka" x={40} y={60} size={26} />
  <text x="64" y="65" class="name" style="font-size:13px">{T.th}</text>
  <DiagramIcon name="card" x={322} y={60} size={26} />
  <text x="346" y="65" class="name" style="font-size:13px">{T.bh}</text>
  <DiagramIcon name="search" x={668} y={60} size={26} />
  <text x="692" y="65" class="name" style="font-size:13px">{T.sh}</text>
  {ys.map((y) => <line x1="190" x2="880" y1={y + ch / 2} y2={y + ch / 2} class="guide" />)}
  {ys.map((y, i) => (
    <g>
      <g class="box"><rect x="20" y={y} width="170" height={ch} rx="6" /></g>
      <DiagramIcon name="log" x={44} y={y + ch / 2} size={24} />
      <text x="68" y={y + ch / 2 + 5} class="name">{`${T.part} ${i}`}</text>
    </g>
  ))}
  {billing.map((b) => (
    <g>
      <g class="box good"><rect x="300" y={b.y} width="260" height={b.h} rx="7" /></g>
      <DiagramIcon name="worker" x={334} y={b.y + b.h / 2} size={28} />
      <text x="364" y={b.y + b.h / 2 - 2} class="name">{`${T.wk} ${b.n}`}</text>
      <text x="364" y={b.y + b.h / 2 + 18} class="sub">{`${T.reads} ${b.r}`}</text>
    </g>
  ))}
  <g class="box good"><rect x="640" y="92" width="240" height="208" rx="7" /></g>
  <DiagramIcon name="worker" x={674} y={196} size={28} />
  <text x="704" y="194" class="name">{`${T.wk} 1`}</text>
  <text x="704" y="214" class="sub">{`${T.reads} P0, P1, P2, P3`}</text>
  <text x="20" y="330" class="name" style="font-size:13px">{T.n1}</text>
  <text x="20" y="350" class="sub">{T.n2}</text>
</StreamAFrame>
