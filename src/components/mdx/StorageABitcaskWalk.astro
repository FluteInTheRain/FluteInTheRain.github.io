---
// Bitcask, one worked example: four appends and a read, then the state they leave behind.
// Offsets and values are illustrative. Plain inline SVG, site tokens, polygon arrowheads, no ids.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 392;
const EN = { 'data-lang-en': '' };
const VI = { 'data-lang-vi': '' };
const steps = [
  { en: ['Write user7 = A', 'append at offset 0'], vi: ['Ghi user7 = A', 'nối thêm tại offset 0'] },
  { en: ['Write user42 = B', 'append at offset 64'], vi: ['Ghi user42 = B', 'nối thêm tại offset 64'] },
  { en: ['Write user42 = C', 'append at offset 128; B is now old'], vi: ['Ghi user42 = C', 'nối thêm tại offset 128; B thành cũ'] },
  { en: ['Delete user7', 'append a tombstone at offset 192'], vi: ['Xoá user7', 'nối thêm tombstone tại offset 192'] },
  { en: ['Read user42', 'keydir says offset 128: one seek'], vi: ['Đọc user42', 'keydir chỉ offset 128: một lần seek'] },
];
const sy = (i: number) => 92 + i * 58;
const cells = [
  { off: '0', k: 'user7', v: '= A', dead: true },
  { off: '64', k: 'user42', v: '= B', dead: true },
  { off: '128', k: 'user42', v: '= C', hit: true },
  { off: '192', k: 'user7', v: 'tombstone', dead: true },
];
const cx0 = 426;
const cw = 106;
const cg = 6;
const cellY = 232;
const cxOf = (i: number) => cx0 + i * (cw + cg);
---
<figure class="bcw">
  <div class="bcw-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Bitcask worked example. Five steps: write user7 at offset 0, write user42 at offset 64, overwrite user42 at offset 128, delete user7 by appending a tombstone at offset 192, read user42 through the keydir in one disk seek. The result is a file with four entries, of which only user42 at offset 128 is the live value, and an in-memory keydir pointing at offset 128 for user42 and offset 192 for user7.">
    <text x="20" y="24" class="bcw-h">
      <tspan data-lang-en>Five steps, one file</tspan>
      <tspan data-lang-vi>Năm bước, một file</tspan>
    </text>
    <text x="20" y="46" class="bcw-sub">
      <tspan data-lang-en>Every change is an append. The keydir always points at the newest entry.</tspan>
      <tspan data-lang-vi>Mọi thay đổi đều là nối thêm. Keydir luôn trỏ tới entry mới nhất.</tspan>
    </text>

    {steps.map((s, i) => (
      <g>
        <circle cx="34" cy={sy(i)} r="12" class="bcw-circle" />
        <text x="34" y={sy(i) + 4} text-anchor="middle" class="bcw-num">{i + 1}</text>
        <g {...EN}>
          <text x="58" y={sy(i) - 2} class="bcw-in-s">{s.en[0]}</text>
          <text x="58" y={sy(i) + 16} class="bcw-note">{s.en[1]}</text>
        </g>
        <g {...VI}>
          <text x="58" y={sy(i) - 2} class="bcw-in-s">{s.vi[0]}</text>
          <text x="58" y={sy(i) + 16} class="bcw-note">{s.vi[1]}</text>
        </g>
      </g>
    ))}

    <line x1="410" x2="410" y1="70" y2="366" class="bcw-divider" />

    <text x={cx0} y="86" class="bcw-in-b">
      <tspan data-lang-en>State after step 4</tspan>
      <tspan data-lang-vi>Trạng thái sau bước 4</tspan>
    </text>

    {/* keydir */}
    <rect x={cx0 - 8} y="100" width={4 * cw + 3 * cg + 16} height="76" rx="4" class="bcw-box" />
    <DiagramIcon name="index" x={cx0 + 14} y="120" size={24} />
    <text x={cx0 + 36} y="125" class="bcw-in-s">
      <tspan data-lang-en>keydir, in memory</tspan>
      <tspan data-lang-vi>keydir, trong RAM</tspan>
    </text>
    <rect x={cxOf(2)} y="136" width={cw} height="28" rx="3" class="bcw-cell is-good" />
    <text x={cxOf(2) + cw / 2} y="155" text-anchor="middle" class="bcw-mono is-good">user42 -&gt; 128</text>
    <rect x={cxOf(3)} y="136" width={cw} height="28" rx="3" class="bcw-cell" />
    <text x={cxOf(3) + cw / 2} y="155" text-anchor="middle" class="bcw-mono">user7 -&gt; 192</text>
    <path d={`M${cxOf(2) + cw / 2},176 L${cxOf(2) + cw / 2},${cellY - 8}`} class="bcw-arrow is-good" />
    <polygon points={`${cxOf(2) + cw / 2 - 5},${cellY - 9} ${cxOf(2) + cw / 2 + 5},${cellY - 9} ${cxOf(2) + cw / 2},${cellY - 1}`} class="bcw-head is-good" />
    <path d={`M${cxOf(3) + cw / 2},176 L${cxOf(3) + cw / 2},${cellY - 8}`} class="bcw-arrow" />
    <polygon points={`${cxOf(3) + cw / 2 - 5},${cellY - 9} ${cxOf(3) + cw / 2 + 5},${cellY - 9} ${cxOf(3) + cw / 2},${cellY - 1}`} class="bcw-head" />

    {/* file 3 */}
    {cells.map((c, i) => (
      <g>
        <rect x={cxOf(i)} y={cellY} width={cw} height="54" rx="3" class={c.hit ? 'bcw-cell is-good' : 'bcw-cell is-dead'} />
        <text x={cxOf(i) + cw / 2} y={cellY + 22} text-anchor="middle" class={c.hit ? 'bcw-mono is-good' : 'bcw-mono'}>{c.k}</text>
        <text x={cxOf(i) + cw / 2} y={cellY + 42} text-anchor="middle" class={c.hit ? 'bcw-mono is-good' : 'bcw-mono'}>{c.v}</text>
        <text x={cxOf(i) + cw / 2} y={cellY + 72} text-anchor="middle" class="bcw-small">
          <tspan data-lang-en>offset {c.off}</tspan>
          <tspan data-lang-vi>offset {c.off}</tspan>
        </text>
      </g>
    ))}
    <DiagramIcon name="disk" x={cx0 + 14} y="318" size={24} />
    <text x={cx0 + 36} y="323" class="bcw-in-s">
      <tspan data-lang-en>file 3, on disk</tspan>
      <tspan data-lang-vi>file 3, trên đĩa</tspan>
    </text>
    <rect x={cx0 + 190} y="308" width="22" height="16" rx="3" class="bcw-cell is-dead" />
    <text x={cx0 + 220} y="321" class="bcw-small">
      <tspan data-lang-en>old or deleted: a merge drops it</tspan>
      <tspan data-lang-vi>cũ hoặc đã xoá: merge sẽ bỏ</tspan>
    </text>
    <text x={cx0} y="352" class="bcw-note">
      <tspan data-lang-en>A tombstone is an entry too: it stays until a merge.</tspan>
      <tspan data-lang-vi>Tombstone cũng là một entry: nằm đó tới khi merge.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Bitcask in a worked example. Offsets and values are made up; the mechanism is the one in the Bitcask paper: append, point the keydir at the newest entry, read with one seek.</span>
    <span data-lang-vi>Bitcask qua một ví dụ cụ thể. Offset và giá trị là bịa ra; cơ chế thì đúng như bài báo Bitcask: nối thêm, cho keydir trỏ tới entry mới nhất, đọc bằng một lần seek.</span>
  </figcaption>
</figure>

<style>
  .bcw { margin: 2em 0; width: 100%; }
  .bcw-scroll { overflow-x: auto; }
  .bcw svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bcw text { font-size: 14px; fill: var(--text-body); }
  .bcw .bcw-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .bcw .bcw-sub { fill: var(--text-muted); }
  .bcw-rule { stroke: var(--border); }
  .bcw-divider { stroke: var(--border); stroke-dasharray: 6 5; }
  .bcw-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bcw-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .bcw-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .bcw-cell { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .bcw-cell.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .bcw-cell.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .bcw-cell.is-dead { fill: var(--bg-alt); stroke: var(--text-muted); stroke-dasharray: 3 3; }
  .bcw .bcw-in { font-weight: 600; fill: var(--text); }
  .bcw .bcw-in-b { font-weight: 700; fill: var(--text); }
  .bcw .bcw-in-m { font-size: 13px; fill: var(--text-body); }
  .bcw .bcw-in-s { font-size: 13px; font-weight: 600; fill: var(--text); }
  .bcw .bcw-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; fill: var(--text-body); }
  .bcw .bcw-mono.is-good { fill: var(--gold-icon); font-weight: 700; }
  .bcw .bcw-mono.is-bad { fill: var(--red); font-weight: 700; }
  .bcw .bcw-note { font-size: 13px; fill: var(--text-muted); }
  .bcw .bcw-note.is-good { fill: var(--gold-icon); font-weight: 700; }
  .bcw .bcw-note.is-bad { fill: var(--red); font-weight: 700; }
  .bcw .bcw-small { font-size: 12px; fill: var(--text-muted); }
  .bcw .bcw-num { font-size: 12px; font-weight: 700; fill: var(--text); }
  .bcw-circle { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .bcw-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .bcw-arrow.is-good { stroke: var(--gold-icon); stroke-width: 1.8; }
  .bcw-arrow.is-bad { stroke: var(--red); stroke-width: 1.8; }
  .bcw-head { fill: var(--text-muted); }
  .bcw-head.is-good { fill: var(--gold-icon); }
  .bcw-head.is-bad { fill: var(--red); }
  .bcw figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
