---
// Three rebalancing strategies at a glance, one small picture each. Inline SVG, site CSS tokens only.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
type Lbl = { x: number; y: number; c: string; en: string[]; vi: string[]; a?: string; lh?: number };
const W = 900;
const H = 340;
const cols = [20, 320, 620];
const cx = (i: number) => cols[i] + 130;
// panel 1: six logical shards onto three nodes
const sq = (j: number) => cols[0] + 25 + j * 36;
const nodeX = [78, 150, 222].map((x) => x + cols[0] - 20);
// panel 2: split
const a1 = arrow(cx(1), 124, cols[1] + 72, 150);
const a2 = arrow(cx(1), 124, cols[1] + 188, 150);
const a3 = arrow(cols[1] + 72, 190, cols[1] + 72, 212);
const a4 = arrow(cols[1] + 188, 190, cols[1] + 188, 212);
// panel 3: ring
const rcx = cx(2);
const rcy = 168;
const R = 56;
const pt = (deg: number) => [rcx + R * Math.cos((deg * Math.PI) / 180), rcy + R * Math.sin((deg * Math.PI) / 180)];
const ringNodes = [-90, 30, 150].map(pt);
const newNode = pt(90);
const labels: Lbl[] = [
  { x: cx(0), y: 38, c: 'h', en: ['Fixed number of shards'], vi: ['Số shard cố định'] },
  { x: cx(1), y: 38, c: 'h', en: ['Split and merge ranges'], vi: ['Tách và gộp dải'] },
  { x: cx(2), y: 38, c: 'h', en: ['Consistent hashing'], vi: ['Consistent hashing'] },
  { x: cx(0), y: 57, c: 'sub', en: ['Riak, Couchbase, Citus, Notion'], vi: ['Riak, Couchbase, Citus, Notion'] },
  { x: cx(1), y: 57, c: 'sub', en: ['HBase, CockroachDB, TiDB'], vi: ['HBase, CockroachDB, TiDB'] },
  { x: cx(2), y: 57, c: 'sub', en: ['Cassandra, ScyllaDB'], vi: ['Cassandra, ScyllaDB'] },
  { x: cx(0), y: 82, c: 'sub', en: ['480 logical shards'], vi: ['480 shard logic'] },
  { x: cx(1), y: 100, c: 's', en: ['Range a to m grew too big'], vi: ['Dải a đến m phình quá to'] },
  { x: cols[1] + 72, y: 266, c: 'sub', en: ['same node'], vi: ['máy cũ'] },
  { x: cols[1] + 188, y: 266, c: 'sub', en: ['quieter node'], vi: ['máy rảnh hơn'] },
  { x: rcx, y: 172, c: 'sub', en: ['hash ring'], vi: ['vòng băm'] },
  { x: newNode[0], y: newNode[1] + 38, c: 'sub', en: ['new node'], vi: ['node mới'] },
  { x: cx(0), y: 292, c: 'note', en: ['Move whole shards'], vi: ['Dời nguyên từng shard'] },
  { x: cx(0), y: 311, c: 'sub', en: ['the hash itself never changes'], vi: ['hàm băm không hề đổi'] },
  { x: cx(1), y: 292, c: 'note', en: ['Split one busy shard in two'], vi: ['Tách đôi một shard bận'] },
  { x: cx(1), y: 311, c: 'sub', en: ['merge tiny ranges after deletes'], vi: ['gộp dải nhỏ sau khi xoá'] },
  { x: cx(2), y: 292, c: 'note', en: ['Only a new slice moves'], vi: ['Chỉ một lát mới được dời'] },
  { x: cx(2), y: 311, c: 'sub', en: ['about 25% when going 3 to 4 nodes'], vi: ['khoảng 25% khi từ 3 lên 4 máy'] },
];
---
<figure class="shbs">
  <div class="shbs-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three rebalancing strategies. Fixed number of shards: six logical shards are mapped in pairs onto three nodes and move as whole shards. Split and merge ranges: one range that grew too big is split in two and one half goes to a quieter node. Consistent hashing: nodes sit on a ring and a new node takes over only a slice of keys from its neighbours.">
      {cols.map((x) => (
        <rect x={x} y="12" width="260" height="316" rx="8" class="rule" />
      ))}

      {/* panel 1 */}
      {[0, 1, 2, 3, 4, 5].map((j) => (
        <g>
          <rect x={sq(j)} y="92" width="30" height="30" rx="4" class="box" />
          <text x={sq(j) + 15} y="112" text-anchor="middle" class="s">{j}</text>
        </g>
      ))}
      {[0, 1, 2, 3, 4, 5].map((j) => {
        const n = nodeX[Math.floor(j / 2)];
        const a = arrow(sq(j) + 15, 122, n + (j % 2 === 0 ? -6 : 6), 202);
        return <g><path d={a.line} class="arrow" /><polygon points={a.head} class="head" /></g>;
      })}
      {nodeX.map((x) => (
        <DiagramIcon name="server" x={x} y={222} size={28} />
      ))}
      {nodeX.map((x, i) => (
        <text x={x} y="266" text-anchor="middle" class="s" data-lang-en>{`Node ${'ABC'[i]}`}</text><text x={x} y="266" text-anchor="middle" class="s" data-lang-vi>{`Máy ${'ABC'[i]}`}</text>
      ))}

      {/* panel 2 */}
      <rect x={cx(1) - 100} y="68" width="200" height="56" rx="6" class="box is-hot" />
      <path d={a1.line} class="arrow" /><polygon points={a1.head} class="head" />
      <path d={a2.line} class="arrow is-gold" /><polygon points={a2.head} class="head is-gold" />
      <rect x={cols[1] + 20} y="150" width="104" height="40" rx="6" class="box" />
      <text x={cols[1] + 72} y="175" text-anchor="middle" class="b">a to f</text>
      <rect x={cols[1] + 136} y="150" width="104" height="40" rx="6" class="box is-gold" />
      <text x={cols[1] + 188} y="175" text-anchor="middle" class="b">g to m</text>
      <path d={a3.line} class="arrow" /><polygon points={a3.head} class="head" />
      <path d={a4.line} class="arrow is-gold" /><polygon points={a4.head} class="head is-gold" />
      <DiagramIcon name="server" x={cols[1] + 72} y={232} size={28} />
      <DiagramIcon name="server" x={cols[1] + 188} y={232} size={28} />

      {/* panel 3 */}
      <circle cx={rcx} cy={rcy} r={R} fill="none" class="arrow" />
      {ringNodes.map((p) => (
        <g>
          <circle cx={p[0]} cy={p[1]} r="19" class="circ" />
          <DiagramIcon name="server" x={p[0]} y={p[1]} size={22} />
        </g>
      ))}
      <circle cx={newNode[0]} cy={newNode[1]} r="21" class="box is-gold" />
      <DiagramIcon name="server" x={newNode[0]} y={newNode[1]} size={22} />
      {labels.map((l) => (
        <>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-en>{l.en.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-vi>{l.vi.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
        </>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Three ways to keep data balanced when the cluster changes size. In each picture, gold shows what moves or what is new.</span>
    <span data-lang-vi>Ba cách giữ dữ liệu cân bằng khi cụm đổi cỡ. Trong mỗi hình, màu vàng là phần được dời hoặc phần mới.</span>
  </figcaption>
</figure>

<style>
  .shbs { margin: 2em 0; width: 100%; }
  .shbs-scroll { overflow-x: auto; }
  .shbs svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shbs text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shbs .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shbs .h.is-hot { fill: var(--red); }
  .shbs .h.is-gold { fill: var(--gold-icon); }
  .shbs .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shbs .sub.is-gold { fill: var(--gold-icon); font-weight: 600; }
  .shbs .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shbs .b.is-hot { fill: var(--red); }
  .shbs .s { font-size: 12px; fill: var(--text-body); }
  .shbs .s.is-hot { fill: var(--red); font-weight: 600; }
  .shbs .note { font-size: 13px; font-weight: 600; fill: var(--text); }
  .shbs .note.is-hot { fill: var(--red); }
  .shbs .note.is-gold { fill: var(--gold-icon); }
  .shbs .num { font-size: 11px; font-weight: 700; fill: var(--text); }
  .shbs .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbs .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shbs .box.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .shbs .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shbs .box.is-dim { opacity: 0.5; }
  .shbs .circ { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbs .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shbs .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shbs .arrow.is-hot { stroke: var(--red); }
  .shbs .arrow.is-gold { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shbs .arrow.is-strong { stroke: var(--text); stroke-width: 1.7; }
  .shbs .arrow.is-dash { stroke-dasharray: 5 4; }
  .shbs .head { fill: var(--text-muted); }
  .shbs .head.is-hot { fill: var(--red); }
  .shbs .head.is-gold { fill: var(--gold-icon); }
  .shbs .head.is-strong { fill: var(--text); }
  .shbs figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>

