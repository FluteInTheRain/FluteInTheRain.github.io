---
import BatchDiagram from './BatchDiagram.astro';
const boxes = [{"x": 20, "y": 46, "w": 150, "h": 64, "t": ["cat", "cat"], "s": [["reads the log", "đọc file log"]], "icon": "file"}, {"x": 260, "y": 46, "w": 150, "h": 64, "t": ["awk", "awk"], "s": [["picks the URL", "lấy URL"]], "icon": "worker"}, {"x": 500, "y": 46, "w": 150, "h": 64, "t": ["sort", "sort"], "s": [["orders lines", "xếp các dòng"]], "icon": "worker"}, {"x": 740, "y": 46, "w": 140, "h": 64, "t": ["uniq -c", "uniq -c"], "s": [["too slow", "quá chậm"]], "icon": "stopwatch", "kind": "hot"}, {"x": 20, "y": 200, "w": 240, "h": 64, "t": ["1. uniq falls behind", "1. uniq bị tụt lại"], "s": [["it reads slower than sort writes", "đọc chậm hơn sort ghi"]], "icon": "stopwatch"}, {"x": 330, "y": 200, "w": 240, "h": 64, "t": ["2. The pipe fills", "2. Ống đầy"], "s": [["the small buffer is full", "bộ đệm nhỏ đã đầy"]], "icon": "warning", "kind": "hot"}, {"x": 640, "y": 200, "w": 240, "h": 64, "t": ["3. The kernel pauses sort", "3. Kernel tạm dừng sort"], "s": [["no extra RAM needed", "không cần thêm RAM"]], "icon": "hourglass", "kind": "good"}];
const arrows = [{"x1": 170, "y1": 78, "x2": 260, "y2": 78}, {"x1": 410, "y1": 78, "x2": 500, "y2": 78}, {"x1": 650, "y1": 78, "x2": 740, "y2": 78, "label": ["pipe is full", "ống đã đầy"], "kind": "hot"}, {"x1": 260, "y1": 232, "x2": 330, "y2": 232}, {"x1": 570, "y1": 232, "x2": 640, "y2": 232, "kind": "good"}];
const texts = [{"x": 20, "y": 26, "cls": "h", "t": ["A pipeline streams lines through small buffers", "Đường ống chuyển từng dòng qua bộ đệm nhỏ"]}, {"x": 20, "y": 170, "cls": "h", "t": ["When one stage is slow", "Khi một bước chạy chậm"]}];
---
<BatchDiagram
  w={900} h={290}
  aria="Four Unix programs joined by pipes: cat, awk, sort, uniq. When uniq falls behind, the pipe buffer fills and the kernel pauses sort. Three steps explain it."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any} rules={[145]} icons={[]}
  caption={["Backpressure: a slow reader automatically slows the writer in front of it, so memory never grows without limit.", "Backpressure: bên đọc chậm sẽ tự làm chậm bên ghi phía trước, nên bộ nhớ không phình vô hạn."]}
/>
