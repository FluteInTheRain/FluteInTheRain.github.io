---
// Straight arrow with a polygon head (no SVG ids). Optional label centred above the midpoint.
interface Props { x1: number; y1: number; x2: number; y2: number; kind?: 'bad' | 'good' | 'dash' | ''; label?: string; dy?: number; anchor?: 'start' | 'middle' | 'end' }
const { x1, y1, x2, y2, kind = '', label, dy = -8, anchor = 'middle' } = Astro.props;
const a = Math.atan2(y2 - y1, x2 - x1);
const p1 = [x2 - 8 * Math.cos(a - 0.45), y2 - 8 * Math.sin(a - 0.45)];
const p2 = [x2 - 8 * Math.cos(a + 0.45), y2 - 8 * Math.sin(a + 0.45)];
const line = `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`;
const head = `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
---
<g class={`arr ${kind}`}>
  <path d={line} /><polygon points={head} />
  {label && <text x={(x1 + x2) / 2} y={(y1 + y2) / 2 + dy} text-anchor={anchor} class="sub">{label}</text>}
</g>
