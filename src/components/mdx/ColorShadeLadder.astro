---
// Visualizes the 3-pass procedure for building a 9-step UI shade ladder up front:
// Pass 1: Base (500) -> Pass 2: Edges (100 & 900) -> Pass 3: Midpoints (300 & 700) -> Pass 4: Gaps (200, 400, 600, 800).
// Swatch colors are intentional HSL blue values illustrating the ladder; all axes, text, and chrome use site CSS tokens.

interface Step {
  stop: number;
  hsl: string;
  pass: number;
  roleEn: string;
  roleVi: string;
  darkText: boolean;
}

const steps: Step[] = [
  { stop: 100, hsl: 'hsl(214, 95%, 94%)', pass: 2, roleEn: 'Alert tint', roleVi: 'Nền cảnh báo', darkText: true },
  { stop: 200, hsl: 'hsl(213, 93%, 86%)', pass: 4, roleEn: 'Subtle border', roleVi: 'Viền nhẹ', darkText: true },
  { stop: 300, hsl: 'hsl(212, 92%, 74%)', pass: 3, roleEn: 'Focus ring', roleVi: 'Vòng focus', darkText: true },
  { stop: 400, hsl: 'hsl(213, 88%, 62%)', pass: 4, roleEn: 'Icon accent', roleVi: 'Điểm nhấn icon', darkText: true },
  { stop: 500, hsl: 'hsl(217, 84%, 50%)', pass: 1, roleEn: 'Primary button', roleVi: 'Nút chính', darkText: false },
  { stop: 600, hsl: 'hsl(221, 83%, 43%)', pass: 4, roleEn: 'Hover state', roleVi: 'Trạng thái hover', darkText: false },
  { stop: 700, hsl: 'hsl(224, 78%, 35%)', pass: 3, roleEn: 'Active / link', roleVi: 'Link / active', darkText: false },
  { stop: 800, hsl: 'hsl(226, 74%, 27%)', pass: 4, roleEn: 'Heading', roleVi: 'Tiêu đề', darkText: false },
  { stop: 900, hsl: 'hsl(228, 70%, 19%)', pass: 2, roleEn: 'Dark text', roleVi: 'Chữ đậm', darkText: false },
];

const W = 900;
const H = 315;
const padL = 24;
const gap = 8;
const swW = Math.floor((W - padL * 2 - gap * (steps.length - 1)) / steps.length);
const swY = 128;
const swH = 88;
const cx = (i: number) => padL + i * (swW + gap) + swW / 2;
---

<figure class="csl">
  <div class="csl-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Nine-step blue shade ladder from 100 to 900 built in four passes: base 500 first, edges 100 and 900 second, midpoints 300 and 700 third, and remaining gaps last.">
      <text x={padL} y="24" class="csl-h">
        <tspan data-lang-en>Build the ladder in four passes: base, edges, midpoints, then gaps</tspan>
        <tspan data-lang-vi>Dựng thang màu theo bốn lượt: màu gốc, hai đầu, điểm giữa, rồi lấp chỗ trống</tspan>
      </text>

      {/* Pass 1 marker: 500 */}
      <line x1={cx(4)} x2={cx(4)} y1="54" y2={swY - 6} class="csl-accent-line" />
      <circle cx={cx(4)} cy="54" r="4" class="csl-accent-dot" />
      <text x={cx(4)} y="44" text-anchor="middle" class="csl-pass-accent">
        <tspan data-lang-en>1. Pick base (500)</tspan>
        <tspan data-lang-vi>1. Chọn màu gốc (500)</tspan>
      </text>

      {/* Pass 2 markers: 100 & 900 */}
      <line x1={cx(0)} x2={cx(0)} y1="80" y2={swY - 6} class="csl-line" />
      <line x1={cx(8)} x2={cx(8)} y1="80" y2={swY - 6} class="csl-line" />
      <line x1={cx(0)} x2={cx(8)} y1="80" y2="80" class="csl-line-dashed" />
      <text x={cx(0)} y="72" text-anchor="start" class="csl-pass">
        <tspan data-lang-en>2. Lightest edge (100)</tspan>
        <tspan data-lang-vi>2. Đầu sáng nhất (100)</tspan>
      </text>
      <text x={cx(8)} y="72" text-anchor="end" class="csl-pass">
        <tspan data-lang-en>2. Darkest edge (900)</tspan>
        <tspan data-lang-vi>2. Đầu tối nhất (900)</tspan>
      </text>

      {/* Pass 3 markers: 300 & 700 */}
      <line x1={cx(2)} x2={cx(2)} y1="106" y2={swY - 6} class="csl-line" />
      <line x1={cx(6)} x2={cx(6)} y1="106" y2={swY - 6} class="csl-line" />
      <text x={cx(2)} y="100" text-anchor="middle" class="csl-pass">
        <tspan data-lang-en>3. Midpoint (300)</tspan>
        <tspan data-lang-vi>3. Điểm giữa (300)</tspan>
      </text>
      <text x={cx(6)} y="100" text-anchor="middle" class="csl-pass">
        <tspan data-lang-en>3. Midpoint (700)</tspan>
        <tspan data-lang-vi>3. Điểm giữa (700)</tspan>
      </text>

      {/* Swatches */}
      {steps.map((s, i) => {
        const x = padL + i * (swW + gap);
        return (
          <g>
            <rect
              x={x}
              y={swY}
              width={swW}
              height={swH}
              rx="6"
              fill={s.hsl}
              class={s.pass === 1 ? 'csl-sw-base' : 'csl-sw'}
            />
            <text
              x={x + swW / 2}
              y={swY + 50}
              text-anchor="middle"
              fill={s.darkText ? '#1e293b' : '#ffffff'}
              class="csl-stop"
            >
              {s.stop}
            </text>
            <text x={x + swW / 2} y={swY + swH + 22} text-anchor="middle" class="csl-role">
              <tspan data-lang-en>{s.roleEn}</tspan>
              <tspan data-lang-vi>{s.roleVi}</tspan>
            </text>
          </g>
        );
      })}

      {/* Pass 4 footer note */}
      <text x={padL} y={H - 18} class="csl-note">
        <tspan data-lang-en>4. Fill the remaining gaps (200, 400, 600, 800) only after the anchors feel balanced to your eye.</tspan>
        <tspan data-lang-vi>4. Lấp các bậc còn lại (200, 400, 600, 800) sau khi các mốc neo đã cân bằng về thị giác.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Locking 500, 100, and 900 first using real UI elements (a button and an alert) prevents ad-hoc hex drift across your stylesheets.</span>
    <span data-lang-vi>Chốt 500, 100 và 900 trước trên thành phần thật (nút bấm và hộp cảnh báo) giúp chặn tình trạng trôi mã hex tùy tiện trong CSS.</span>
  </figcaption>
</figure>

<style>
  .csl { margin: 2em 0; width: 100%; }
  .csl-scroll { overflow-x: auto; }
  .csl svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .csl text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .csl text.csl-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .csl text.csl-pass { font-size: 13px; fill: var(--text-muted); }
  .csl text.csl-pass-accent { font-size: 13px; font-weight: 600; fill: var(--red); }
  .csl text.csl-stop { font-size: 15px; font-weight: 700; }
  .csl text.csl-role { font-size: 12px; fill: var(--text-muted); }
  .csl text.csl-note { font-size: 13px; fill: var(--text-muted); }
  .csl-line { stroke: var(--border); stroke-width: 1.5; }
  .csl-line-dashed { stroke: var(--border); stroke-width: 1; stroke-dasharray: 4 4; }
  .csl-accent-line { stroke: var(--red); stroke-width: 2; }
  .csl-accent-dot { fill: var(--red); }
  .csl-sw { stroke: var(--border); stroke-width: 1; }
  .csl-sw-base { stroke: var(--red); stroke-width: 2.5; }
  .csl figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
