---
// TestExpired: the three moments, on a minutes axis. ttl is 30 minutes.
const x0 = 60;
const px = 19.5; // pixels per minute, 0..40
const X = (m: number) => x0 + m * px;
const pts = [
  { m: 0, nameEn: 'just created', nameVi: 'vừa tạo', want: 'false', anchor: 'middle', dx: 0 },
  { m: 29, nameEn: '29 minutes later', nameVi: '29 phút sau', want: 'false', anchor: 'end', dx: -8 },
  { m: 31, nameEn: '31 minutes later', nameVi: '31 phút sau', want: 'true', anchor: 'start', dx: 8 },
];
const axisY = 170;
---
<figure class="p06e">
  <div class="p06e-scroll">
  <svg viewBox="0 0 900 250" role="img" aria-label="Timeline in minutes after created. The ttl is 30 minutes. Just created and 29 minutes later give Expired false. 31 minutes later gives true.">
    <line x1={X(0)} x2={X(40)} y1={axisY} y2={axisY} class="ln" />
    {[0, 10, 20, 30, 40].map((m) => (
      <g>
        <line x1={X(m)} x2={X(m)} y1={axisY} y2={axisY + 6} class="ln" />
        <text x={X(m)} y={axisY + 24} text-anchor="middle" class="s">{m}</text>
      </g>
    ))}
    <text x={X(20)} y={axisY + 52} text-anchor="middle" class="m"><tspan data-lang-en>minutes after created (now is a value we pass in)</tspan><tspan data-lang-vi>số phút sau created (now là giá trị ta truyền vào)</tspan></text>
    <line x1={X(30)} x2={X(30)} y1="40" y2={axisY} stroke="var(--red)" stroke-width="1.5" stroke-dasharray="5 4" />
    <text x={X(30)} y="28" text-anchor="middle" class="r"><tspan data-lang-en>ttl = 30 minutes</tspan><tspan data-lang-vi>ttl = 30 phút</tspan></text>
    {pts.map((p) => (
      <g>
        <line x1={X(p.m)} x2={X(p.m)} y1={axisY} y2="116" class="ln" />
        <circle cx={X(p.m)} cy={axisY} r="6" fill={p.want === 'true' ? 'var(--red)' : 'var(--text-muted)'} />
        <text x={X(p.m) + p.dx} y="84" text-anchor={p.anchor} class="b"><tspan data-lang-en>{p.nameEn}</tspan><tspan data-lang-vi>{p.nameVi}</tspan></text>
        <text x={X(p.m) + p.dx} y="106" text-anchor={p.anchor} class={p.want === 'true' ? 'r' : 'm'}>Expired = {p.want}</text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Each case is a moment we choose, such as created.Add(31 * time.Minute). Nothing waits, so the three subtests finish in no time.</span>
    <span data-lang-vi>Mỗi case là một thời điểm ta tự chọn, ví dụ created.Add(31 * time.Minute). Không có gì phải chờ, nên ba subtest chạy xong ngay lập tức.</span>
  </figcaption>
</figure>

<style>
  .p06e { margin: 2em 0; width: 100%; }
  .p06e-scroll { overflow-x: auto; }
  .p06e svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p06e text { font-size: 14px; fill: var(--text-body); }
  .p06e .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p06e .b { font-weight: 700; fill: var(--text); }
  .p06e .m { fill: var(--text-muted); }
  .p06e .s { font-size: 13px; fill: var(--text-muted); }
  .p06e .r { fill: var(--red); font-weight: 700; }
  .p06e .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .p06e .skip { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .p06e .hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .p06e .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .p06e .ln.cut { stroke-dasharray: 3 4; opacity: 0.5; }
  .p06e .ah { fill: var(--text-muted); }
  .p06e .rule { stroke: var(--border); stroke-width: 1; }
  .p06e .grid { stroke: var(--border); stroke-width: 1; }
  .p06e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
