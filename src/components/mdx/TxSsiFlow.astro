---
// SSI on the post's on-call doctors example: SIREAD flags, a dangerous rw-cycle, abort at commit.
// Illustrative timeline; names follow the post (Dr. Lan and Dr. Minh).
import DiagramIcon from './DiagramIcon.astro';
const lanes = [
  { x: 150, icon: 'user', en: 'Transaction 1 (Dr. Lan)', vi: 'Transaction 1 (Dr. Lan)' },
  { x: 450, icon: 'db', en: 'Database', vi: 'Database' },
  { x: 750, icon: 'user', en: 'Transaction 2 (Dr. Minh)', vi: 'Transaction 2 (Dr. Minh)' },
];
---
<figure class="txsi">
  <div class="txsi-scroll">
  <svg viewBox="0 0 900 412" role="img" aria-label="Timeline with two transactions and the database. Both transactions read how many doctors are on call and the database leaves a non-blocking SIREAD flag on that read. Transaction 1 writes its own row, then transaction 2 writes a different row. Transaction 1 commits. When transaction 2 tries to commit, the database sees a cycle of read-write conflicts and aborts it with SQLSTATE 40001, and the app retries.">
    <text x="20" y="26" class="h">
      <tspan data-lang-en>SSI: let both run, check at commit</tspan>
      <tspan data-lang-vi>SSI: cho cả hai chạy, kiểm tra lúc commit</tspan>
    </text>
    {lanes.map((l) => (
      <g>
        <DiagramIcon name={l.icon} x={l.x} y={62} size={28} />
        <text x={l.x} y={96} class="b" text-anchor="middle"><tspan data-lang-en>{l.en}</tspan><tspan data-lang-vi>{l.vi}</tspan></text>
        <line x1={l.x} y1="106" x2={l.x} y2="352" class="txsi-life" />
      </g>
    ))}

    <path d="M156,128 L436,128" class="txsi-arrow" /><polygon points="444,128 436,124 436,132" class="txsi-head" />
    <text x="300" y="122" class="note" text-anchor="middle"><tspan data-lang-en>1. read: doctors on call?</tspan><tspan data-lang-vi>1. đọc: bao nhiêu bác sĩ trực?</tspan></text>
    <path d="M744,162 L464,162" class="txsi-arrow" /><polygon points="456,162 464,158 464,166" class="txsi-head" />
    <text x="600" y="156" class="note" text-anchor="middle"><tspan data-lang-en>2. same read</tspan><tspan data-lang-vi>2. cùng câu đọc đó</tspan></text>
    <rect x="360" y="178" width="180" height="46" rx="4" class="txsi-box" />
    <DiagramIcon name="eye" x={384} y={201} size={22} />
    <text x="448" y="198" class="b" text-anchor="middle" dx="12"><tspan data-lang-en>SIREAD flags</tspan><tspan data-lang-vi>Cờ SIREAD</tspan></text>
    <text x="448" y="214" class="note" text-anchor="middle" dx="12"><tspan data-lang-en>nobody is blocked</tspan><tspan data-lang-vi>không ai bị chặn</tspan></text>

    <path d="M156,250 L436,250" class="txsi-arrow" /><polygon points="444,250 436,246 436,254" class="txsi-head" />
    <text x="300" y="244" class="note" text-anchor="middle"><tspan data-lang-en>3. Lan goes off call</tspan><tspan data-lang-vi>3. Lan nghỉ trực</tspan></text>
    <path d="M744,282 L464,282" class="txsi-arrow" /><polygon points="456,282 464,278 464,286" class="txsi-head" />
    <text x="600" y="276" class="note" text-anchor="middle"><tspan data-lang-en>4. Minh goes off call</tspan><tspan data-lang-vi>4. Minh nghỉ trực</tspan></text>

    <path d="M156,314 L436,314" class="txsi-arrow is-ok" /><polygon points="444,314 436,310 436,318" class="txsi-head is-ok" />
    <text x="300" y="308" class="note is-ok" text-anchor="middle"><tspan data-lang-en>5. commit: allowed</tspan><tspan data-lang-vi>5. commit: được phép</tspan></text>
    <path d="M744,346 L464,346" class="txsi-arrow is-bad" /><polygon points="456,346 464,342 464,350" class="txsi-head is-bad" />
    <text x="600" y="340" class="note is-bad" text-anchor="middle"><tspan data-lang-en>6. commit: refused</tspan><tspan data-lang-vi>6. commit: bị từ chối</tspan></text>
    <rect x="590" y="356" width="300" height="44" rx="4" class="txsi-box is-bad" />
    <DiagramIcon name="retry" x={614} y={378} size={20} />
    <text x="760" y="374" class="b" text-anchor="middle"><tspan data-lang-en>Read-write cycle found</tspan><tspan data-lang-vi>Phát hiện vòng đọc-ghi</tspan></text>
    <text x="760" y="391" class="note" text-anchor="middle"><tspan data-lang-en>SQLSTATE 40001, the app retries</tspan><tspan data-lang-vi>SQLSTATE 40001, app thử lại</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Nothing blocks while the two transactions work. Each read leaves a flag, and at commit the database notices that each transaction wrote something the other had read. The second committer is aborted and retried.</span>
    <span data-lang-vi>Không có gì bị chặn khi hai transaction đang chạy. Mỗi lần đọc để lại một lá cờ, và lúc commit database thấy mỗi transaction đã ghi thứ mà bên kia từng đọc. Bên commit sau bị huỷ và thử lại.</span>
  </figcaption>
</figure>

<style>
  .txsi { margin: 2em 0; width: 100%; }
  .txsi-scroll { overflow-x: auto; }
  .txsi svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .txsi text { font-size: 13px; fill: var(--text-body); }
  .txsi .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .txsi .sec { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .txsi .sec.is-bad { fill: var(--red); }
  .txsi .b { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .txsi .m { font-size: 12.5px; fill: var(--text-body); }
  .txsi .mono { font-family: var(--font-mono, ui-monospace, monospace); font-size: 12px; }
  .txsi .note { font-size: 12px; fill: var(--text-muted); }
  .txsi .note.is-bad { fill: var(--red); font-weight: 600; }
  .txsi .note.is-ok { fill: var(--gold-icon); font-weight: 600; }
  .txsi .num { font-size: 12px; font-weight: 700; fill: var(--text); }
  .txsi-panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .txsi-panel.is-bad { stroke: var(--red); }
  .txsi-panel.is-ok { stroke: var(--gold); }
  .txsi-box { fill: var(--card-bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .txsi-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .txsi-box.is-ok { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .txsi-dot { fill: var(--card-bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .txsi-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .txsi-arrow.is-bad { stroke: var(--red); }
  .txsi-arrow.is-ok { stroke: var(--gold); }
  .txsi-dash { stroke-dasharray: 4 4; }
  .txsi-head { fill: var(--text-muted); }
  .txsi-head.is-bad { fill: var(--red); }
  .txsi-head.is-ok { fill: var(--gold); }
  .txsi-life { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .txsi figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.5; }
</style>
