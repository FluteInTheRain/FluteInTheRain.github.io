---
// Photoroom, 2026: step by step, how a slow read replica made the primary keep its WAL.
// Numbers from Photoroom's post (5 GB -> 31.7 TB).
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 300;
const cw = 192;
const gap = 30;
const top = 20;
const ch = 192;
const steps = [
  { icon: 'worker', en: ['A big backfill writes', 'a lot of changes, fast.'], vi: ['Một backfill lớn ghi', 'rất nhiều thay đổi, rất nhanh.'], who: 'Backfill', whoVi: 'Backfill' },
  { icon: 'postgres', en: ['The primary records each', 'change in its WAL.'], vi: ['DB chính ghi từng thay đổi', 'vào WAL của nó.'], who: 'Primary', whoVi: 'DB chính' },
  { icon: 'stopwatch', en: ['The replica applies them', 'more slowly, so it falls', 'behind.'], vi: ['Replica áp dụng chậm hơn', 'nên tụt lại phía sau.'], who: 'Replica', whoVi: 'Replica' },
  { icon: 'disk', en: ['The primary must keep the', 'WAL the replica needs.', '5 GB grew to 31.7 TB.'], vi: ['DB chính phải giữ WAL', 'mà replica còn cần.', '5 GB tăng lên 31,7 TB.'], who: 'Primary disk', whoVi: 'Đĩa DB chính' },
];
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 8 * Math.cos(a - 0.45), y2 - 8 * Math.sin(a - 0.45)];
  const p2 = [x2 - 8 * Math.cos(a + 0.45), y2 - 8 * Math.sin(a + 0.45)];
  return { line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`, head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}` };
}
---
<figure class="tosf">
  <div class="tosf-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four steps. A big backfill writes many changes fast. The primary records them in its write-ahead log. The replica applies them more slowly and falls behind. The primary cannot drop log the replica still needs, so retained log grows from 5 GB to 31.7 TB. A cap, max_slot_wal_keep_size, stops this at the price of a possible replica rebuild.">
    {steps.map((s, i) => {
      const x = 20 + i * (cw + gap);
      const cx = x + cw / 2;
      const a = i < steps.length - 1 ? arrow(x + cw, top + ch / 2, x + cw + gap, top + ch / 2) : null;
      return (
        <g>
          <rect x={x} y={top} width={cw} height={ch} rx="10" class={i === 3 ? 'tosf-card is-hot' : 'tosf-card'} />
          <text x={x + 14} y={top + 26} class="tosf-n">{i + 1}</text>
          <DiagramIcon name={s.icon as any} x={cx} y={top + 54} size={34} />
          <text x={cx} y={top + 96} text-anchor="middle" class="tosf-name"><tspan data-lang-en>{s.who}</tspan><tspan data-lang-vi>{s.whoVi}</tspan></text>
          {s.en.map((l, k) => (
            <text x={cx} y={top + 122 + k * 17} text-anchor="middle" class="tosf-line"><tspan data-lang-en>{l}</tspan><tspan data-lang-vi>{s.vi[k]}</tspan></text>
          ))}
          {a && <g class="tosf-arrow"><path d={a.line} /><polygon points={a.head} /></g>}
        </g>
      );
    })}
    <rect x="20" y="226" width="860" height="56" rx="10" class="tosf-fix" />
    <DiagramIcon name="shield" x={52} y={254} size={28} />
    <text x="84" y="250" class="tosf-fixh"><tspan data-lang-en>The fix: cap the WAL with max_slot_wal_keep_size</tspan><tspan data-lang-vi>Cách chữa: đặt trần cho WAL bằng max_slot_wal_keep_size</tspan></text>
    <text x="84" y="269" class="tosf-line"><tspan data-lang-en>The price: a replica that falls too far behind may have to be rebuilt.</tspan><tspan data-lang-vi>Cái giá: replica tụt quá xa có thể phải dựng lại.</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>One slow reader decides how much disk the primary needs. Follow the numbers 1 to 4.</span>
    <span data-lang-vi>Một bên đọc chậm quyết định DB chính cần bao nhiêu đĩa. Đi theo các số từ 1 đến 4.</span>
  </figcaption>
</figure>

<style>
  .tosf { margin: 2em 0; width: 100%; }
  .tosf-scroll { overflow-x: auto; }
  .tosf svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .tosf text { font-size: 13px; fill: var(--text-body); }
  .tosf .tosf-n { font-size: 16px; font-weight: 700; fill: var(--text-muted); }
  .tosf .tosf-name { font-size: 14px; font-weight: 700; fill: var(--text); }
  .tosf .tosf-fixh { font-size: 14px; font-weight: 700; fill: var(--text); }
  .tosf .tosf-line { fill: var(--text-muted); }
  .tosf-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .tosf-card.is-hot { fill: var(--red-tint-bg); stroke: var(--red); }
  .tosf-fix { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.2; }
  .tosf-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .tosf-arrow polygon { fill: var(--text-muted); }
  .tosf figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
