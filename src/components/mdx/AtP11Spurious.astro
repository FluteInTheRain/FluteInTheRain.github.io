---
// 100 independent random series. Python (numpy default_rng(11), standard normal), histogram of the 4,950 pairwise correlations, bin width 0.05 from -0.6.
// T = 60 days: max |rho| 0.429, 615 pairs with |rho| > 0.2 (12.4%). T = 250 days: max |rho| 0.218, 8 pairs (0.16%).
const W = 900, H = 380;
const bins60 = [0,0,0,3,11,36,89,178,309,488,616,767,735,648,475,297,160,94,35,6,3,0,0,0];
const bins250 = [0,0,0,0,0,0,0,4,43,221,819,1430,1366,785,233,45,4,0,0,0,0,0,0,0];
const panels = [
  { x0: 50, data: bins60, en: '60 days of data', vi: '60 ngày dữ liệu', ben: '615 of 4,950 pairs look related (|ρ| > 0.2)', bvi: '615 trong 4.950 cặp trông như có liên hệ (|ρ| > 0,2)', max: '0.43' },
  { x0: 480, data: bins250, en: '250 days of data', vi: '250 ngày dữ liệu', ben: '8 of 4,950 pairs look related (|ρ| > 0.2)', bvi: '8 trong 4.950 cặp trông như có liên hệ (|ρ| > 0,2)', max: '0.22' },
];
const PW = 380, PH = 190, PY = 78;
const maxCount = 1430;
const bw = PW / 24;
const xAt = (x0: number, r: number) => x0 + ((r + 0.6) / 1.2) * PW;
---
<figure class="atp11-sp">
  <div class="atp11-sp-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two histograms of the correlation between every pair of 100 independent random series. With 60 days of data the correlations spread widely, 615 of 4,950 pairs exceed 0.2 in size and the largest is 0.43. With 250 days they bunch near zero, only 8 pairs exceed 0.2 and the largest is 0.22.">
      <text x="20" y="26" class="h"><tspan data-lang-en>100 stocks with nothing in common still produce "links"</tspan><tspan data-lang-vi>100 mã chẳng liên quan gì nhau vẫn sinh ra "mối nối"</tspan></text>
      {panels.map((p) => (
        <g>
          <text x={p.x0} y="54" class="ph"><tspan data-lang-en>{p.en}</tspan><tspan data-lang-vi>{p.vi}</tspan></text>
          <line x1={p.x0} y1={PY + PH} x2={p.x0 + PW} y2={PY + PH} class="ax" />
          {p.data.map((c, i) => {
            const r0 = -0.6 + i * 0.05;
            const hgt = (c / maxCount) * PH;
            const out = Math.abs(r0 + 0.025) > 0.2;
            return c > 0 ? <rect x={p.x0 + i * bw + 1} y={PY + PH - hgt} width={bw - 2} height={hgt} class={out ? 'b out' : 'b'} /> : null;
          })}
          <line x1={xAt(p.x0, -0.2)} y1={PY} x2={xAt(p.x0, -0.2)} y2={PY + PH} class="thr" />
          <line x1={xAt(p.x0, 0.2)} y1={PY} x2={xAt(p.x0, 0.2)} y2={PY + PH} class="thr" />
          {[-0.6, -0.2, 0, 0.2, 0.6].map((r) => <text x={xAt(p.x0, r)} y={PY + PH + 18} text-anchor="middle" class="tk">{r}</text>)}
          <text x={p.x0} y={PY + PH + 42} class="pn"><tspan data-lang-en>{p.ben}</tspan><tspan data-lang-vi>{p.bvi}</tspan></text>
          <text x={p.x0} y={PY + PH + 62} class="pm"><tspan data-lang-en>largest |ρ| = {p.max}</tspan><tspan data-lang-vi>|ρ| lớn nhất = {p.max.replace('.', ',')}</tspan></text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Simulated data: 100 independent random series, so every true correlation is zero. Red bars are pairs beyond ±0.2. A threshold graph built from 60 days would be full of edges that mean nothing.</span>
    <span data-lang-vi>Số liệu mô phỏng: 100 chuỗi ngẫu nhiên độc lập, nên mọi tương quan thật đều bằng không. Cột đỏ là các cặp vượt ±0,2. Đồ thị ngưỡng dựng từ 60 ngày sẽ đầy những cạnh chẳng có nghĩa gì.</span>
  </figcaption>
</figure>
<style>
  .atp11-sp { margin: 2em 0; width: 100%; }
  .atp11-sp-scroll { overflow-x: auto; }
  .atp11-sp svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .atp11-sp text { font-size: 14px; fill: var(--text-body); }
  .atp11-sp .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp11-sp .ph { font-size: 14px; font-weight: 700; fill: var(--text); }
  .atp11-sp .tk { font-size: 12px; fill: var(--text-muted); }
  .atp11-sp .pn { font-size: 13px; fill: var(--text); }
  .atp11-sp .pm { font-size: 12.5px; fill: var(--text-muted); }
  .atp11-sp .ax { stroke: var(--border); stroke-width: 1.4; }
  .atp11-sp .thr { stroke: var(--text-faint); stroke-width: 1.1; stroke-dasharray: 4 4; }
  .atp11-sp .b { fill: var(--text-faint); opacity: 0.55; }
  .atp11-sp .b.out { fill: var(--red); opacity: 1; }
  .atp11-sp figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
