---
// Bonferroni threshold for a two-sided 5% family-wise error: z = norm.isf(0.05 / N / 2) (scipy):
// N = 1: 1.96, 10: 2.81, 45: 3.26, 50: 3.29, 100: 3.48, 316: 3.78, 1000: 4.06.
// HLZ (Review of Financial Studies 2016): Fama-MacBeth 1973 beta t = 2.57; proposed hurdle for a new factor t > 3.0;
// Holm at 316 factors: 3.64, at 113 factors: 3.29.
const pts = [[1, 1.96], [10, 2.81], [45, 3.26], [100, 3.48], [316, 3.78], [1000, 4.06]];
const X0 = 90, X1 = 840, Y0 = 300, Y1 = 90;
const lx = (n: number) => X0 + (Math.log10(n) / 3) * (X1 - X0);
const ty = (t: number) => Y0 - ((t - 1.5) / (4.5 - 1.5)) * (Y0 - Y1);
const erfcA = (x: number) => { const z = Math.abs(x), t = 1 / (1 + 0.3275911 * z); const y = t * (0.254829592 + t * (-0.284496736 + t * (1.421413741 + t * (-1.453152027 + t * 1.061405429)))); return y * Math.exp(-z * z); };
const zFor = (n: number) => { let lo = 0, hi = 8; const target = 0.05 / n; for (let i = 0; i < 60; i++) { const m = (lo + hi) / 2; if (erfcA(m / Math.SQRT2) > target) lo = m; else hi = m; } return lo; };
let curve = '';
for (let i = 0; i <= 60; i++) {
  const n = Math.pow(10, (3 * i) / 60);
  curve += `${i ? 'L' : 'M'} ${lx(n).toFixed(1)} ${ty(zFor(n)).toFixed(1)} `;
}
const refs = [
  { t: 2.57, en: '2.57: the CAPM beta test of 1973', vi: '2,57: kiểm định beta CAPM năm 1973', cls: '' },
  { t: 3.0, en: '3.0: proposed bar for a new factor', vi: '3,0: ngưỡng đề xuất cho factor mới', cls: 'is-red' },
];
---
<figure class="aphu">
  <div class="aphu-scroll">
  <svg viewBox="0 0 900 380" role="img" aria-label="A curve of the t-statistic needed for 5 percent family-wise significance as the number of tests grows from 1 to 1,000 on a log scale: 1.96 for one test, 2.81 for 10, 3.26 for 45, 3.48 for 100, 3.78 for 316, 4.06 for 1,000. Two dashed lines mark 2.57, the 1973 CAPM beta test, and 3.0, the proposed bar for new factors.">
    <text x="20" y="26" class="aphu-h">
      <tspan data-lang-en>The bar for "significant" rises with every test you ran</tspan>
      <tspan data-lang-vi>Ngưỡng "có ý nghĩa" tăng theo mỗi phép test bạn đã chạy</tspan>
    </text>
    <text x="20" y="46" class="aphu-sub">
      <tspan data-lang-en>t-statistic needed for a 5% two-sided result after N tests (Bonferroni)</tspan>
      <tspan data-lang-vi>t-statistic cần có để đạt mức 5% hai phía sau N phép test (Bonferroni)</tspan>
    </text>
    {[2, 3, 4].map((t) => (
      <g>
        <line x1={X0} x2={X1} y1={ty(t)} y2={ty(t)} class="aphu-grid" />
        <text x={X0 - 10} y={ty(t) + 4} text-anchor="end" class="aphu-tick">{t}</text>
      </g>
    ))}
    {refs.map((r) => (
      <g>
        <line x1={X0} x2={X1} y1={ty(r.t)} y2={ty(r.t)} class={`aphu-ref ${r.cls}`} />
        <text x={X1 - 6} y={ty(r.t) + (r.t < 3 ? 18 : -7)} text-anchor="end" class={`aphu-lab ${r.cls}`}>
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
      </g>
    ))}
    <line x1={X0} x2={X1} y1={Y0 + 10} y2={Y0 + 10} class="aphu-axis" />
    <path d={curve} class="aphu-curve" />
    {pts.map(([n, t]) => (
      <g>
        <circle cx={lx(n)} cy={ty(t)} r="4.5" class="aphu-dot" />
        <text x={lx(n)} y={ty(t) - 12} text-anchor="middle" class="aphu-val">{t.toFixed(2)}</text>
        <text x={lx(n)} y={Y0 + 30} text-anchor="middle" class="aphu-tick">{n.toLocaleString('en-US')}</text>
      </g>
    ))}
    <text x={X0 + 375} y={Y0 + 52} text-anchor="middle" class="aphu-sub">
      <tspan data-lang-en>number of tests N (log scale)</tspan>
      <tspan data-lang-vi>số phép test N (thang log)</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The curve is plain Bonferroni arithmetic: divide 5% by N, then find the matching t. Harvey, Liu and Zhu counted 316 published factors and reached a similar conclusion with their own method (Holm: 3.64).</span>
    <span data-lang-vi>Đường cong là phép tính Bonferroni thuần túy: chia 5% cho N rồi tìm t tương ứng. Harvey, Liu và Zhu đếm được 316 factor đã công bố và đi tới kết luận tương tự bằng phương pháp riêng của họ (Holm: 3,64).</span>
  </figcaption>
</figure>

