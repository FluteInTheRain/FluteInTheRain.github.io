---
import DiagramIcon from './DiagramIcon.astro';
// Three-stage lifecycle of Linux virtual memory (VSS) vs physical DRAM frames (RSS)
// during a traffic spike, GC sweep, and background madvise(MADV_DONTNEED) scavenging.
// Numbers are illustrative to show why container RSS stays high right after GC until scvg runs.
const W = 900;
const H = 290;
const stages = [
  {
    x: 20,
    titleEn: '1. Traffic spike',
    titleVi: '1. Lúc cao điểm tải',
    vss: 'VSS: 420 MiB',
    rss: 'RSS: 420 MiB',
    liveH: 132,
    freedH: 0,
    unbackedH: 0,
    noteEn: 'All pages touched -> mapped in RAM',
    noteVi: 'Mọi trang đã ghi -> nằm trên RAM',
    hot: false,
  },
  {
    x: 315,
    titleEn: '2. Right after GC sweeps',
    titleVi: '2. Ngay sau khi GC quét',
    vss: 'VSS: 420 MiB',
    rss: 'RSS: 420 MiB',
    liveH: 30,
    freedH: 102,
    unbackedH: 0,
    noteEn: '90 MiB live; freed spans kept briefly',
    noteVi: 'Còn 90 MiB sống; trang trống tạm giữ',
    hot: true,
  },
  {
    x: 610,
    titleEn: '3. madvise(MADV_DONTNEED)',
    titleVi: '3. Gọi madvise(MADV_DONTNEED)',
    vss: 'VSS: 420 MiB',
    rss: 'RSS: ~110 MiB',
    liveH: 36,
    freedH: 0,
    unbackedH: 96,
    noteEn: 'Kernel drops physical frames, VSS stays',
    noteVi: 'Kernel thu hồi khung RAM, VSS giữ nguyên',
    hot: false,
  },
];
const stageIcons = ['hot', 'gc', 'recycle'] as const;
const boxW = 260;
const boxTop = 64;
const boxH = 148;
---
<figure class="gp16v">
  <div class="gp16v-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three stages of Go heap memory: during a spike VSS and RSS both hit 420 MiB; right after GC sweeps only 90 MiB is live but RSS stays 420 MiB; after background madvise(MADV_DONTNEED), VSS remains 420 MiB while RSS drops to around 110 MiB.">
    {stages.map((st, idx) => (
      <g>
        <DiagramIcon name={stageIcons[idx]} x={st.x + 12} y={21} size={24} />
        <text x={st.x + 28} y="26" class={st.hot ? 'h r' : 'h'}>
          <tspan data-lang-en>{st.titleEn}</tspan>
          <tspan data-lang-vi>{st.titleVi}</tspan>
        </text>
        <text x={st.x} y="48" class="m num">{st.vss}</text>
        <text x={st.x + boxW} y="48" text-anchor="end" class={st.hot ? 'r num' : 'b num'}>{st.rss}</text>

        {/* Outer virtual address space container */}
        <rect x={st.x} y={boxTop} width={boxW} height={boxH} rx="8" class="vss" />

        {/* Unbacked virtual tail (stage 3) */}
        {st.unbackedH > 0 && (
          <g>
            <rect x={st.x + 8} y={boxTop + 8} width={boxW - 16} height={st.unbackedH} rx="4" class="unbacked" />
            <text x={st.x + boxW / 2} y={boxTop + 8 + st.unbackedH / 2 + 5} text-anchor="middle" class="m">
              <tspan data-lang-en>unbacked virtual pages (0 B RAM)</tspan>
              <tspan data-lang-vi>trang ảo chưa gắn RAM (0 B)</tspan>
            </text>
          </g>
        )}

        {/* Freed spans still resident in RSS (stage 2) */}
        {st.freedH > 0 && (
          <g>
            <rect x={st.x + 8} y={boxTop + 8} width={boxW - 16} height={st.freedH} rx="4" class={st.hot ? 'freed fm-pulse' : 'freed'} />
            <text x={st.x + boxW / 2} y={boxTop + 8 + st.freedH / 2 - 4} text-anchor="middle" class="r">
              <tspan data-lang-en>swept spans still in RSS</tspan>
              <tspan data-lang-vi>vùng trống vẫn nằm trong RSS</tspan>
            </text>
            <text x={st.x + boxW / 2} y={boxTop + 8 + st.freedH / 2 + 16} text-anchor="middle" class="m">
              <tspan data-lang-en>awaiting scavenger</tspan>
              <tspan data-lang-vi>đợi scavenger dọn</tspan>
            </text>
          </g>
        )}

        {/* Live physical RSS data at bottom */}
        <rect x={st.x + 8} y={boxTop + boxH - 8 - st.liveH} width={boxW - 16} height={st.liveH} rx="4" class="live" />
        <text x={st.x + boxW / 2} y={boxTop + boxH - 8 - st.liveH / 2 + 5} text-anchor="middle" class="b">
          <tspan data-lang-en>{st.liveH > 80 ? 'active heap pages in DRAM' : 'live heap + runtime'}</tspan>
          <tspan data-lang-vi>{st.liveH > 80 ? 'trang heap đang dùng trên DRAM' : 'heap sống + runtime'}</tspan>
        </text>

        <text x={st.x} y="236" class="m">
          <tspan data-lang-en>{st.noteEn}</tspan>
          <tspan data-lang-vi>{st.noteVi}</tspan>
        </text>

        {idx < 2 && (
          <g>
            <line x1={st.x + boxW + 4} x2={stages[idx + 1].x - 10} y1={boxTop + boxH / 2} y2={boxTop + boxH / 2} class="ln" />
            <polygon points={`${stages[idx + 1].x - 2},${boxTop + boxH / 2} ${stages[idx + 1].x - 11},${boxTop + boxH / 2 - 5} ${stages[idx + 1].x - 11},${boxTop + boxH / 2 + 5}`} class="hd" />
          </g>
        )}
      </g>
    ))}

    <line x1="20" x2={W - 20} y1="256" y2="256" class="rule" />
    <text x="20" y="278" class="m">
      <tspan data-lang-en>Linux counts resident RSS (via MADV_DONTNEED since Go 1.16), never reserved VSS, toward container limits.</tspan>
      <tspan data-lang-vi>Từ Go 1.16 Linux mặc định dùng MADV_DONTNEED để hạ RSS thật, không tính vùng địa chỉ ảo VSS vào ngưỡng pod.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Virtual memory (<code>VSS</code>) only reserves address ranges; physical DRAM (<code>RSS</code>) is mapped lazily on access in 4 KiB pages. Swept spans stay mapped briefly until Go's scavenger issues <code>madvise(MADV_DONTNEED)</code>.</span>
    <span data-lang-vi>Bộ nhớ ảo (<code>VSS</code>) chỉ là dải địa chỉ đăng ký trước; RAM vật lý (<code>RSS</code>) chỉ được cấp theo từng trang 4 KiB khi code đụng tới. Vùng nhớ GC vừa quét vẫn nằm trong RSS một lúc tới khi scavenger gọi <code>madvise(MADV_DONTNEED)</code>.</span>
  </figcaption>
</figure>

<style>
  .gp16v { margin: 2em 0; width: 100%; }
  .gp16v-scroll { overflow-x: auto; }
  .gp16v svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp16v text { font-size: 13.5px; fill: var(--text-body); }
  .gp16v .h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .gp16v .h.r { fill: var(--red); }
  .gp16v .b { font-weight: 700; fill: var(--text); }
  .gp16v .m { fill: var(--text-muted); }
  .gp16v .r { fill: var(--red); font-weight: 700; }
  .gp16v .num { font-variant-numeric: tabular-nums; }
  .gp16v .vss { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp16v .live { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.2; }
  .gp16v .freed { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp16v .unbacked { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp16v .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp16v .hd { fill: var(--text-muted); }
  .gp16v .rule { stroke: var(--border); stroke-width: 1; }
  .gp16v figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
