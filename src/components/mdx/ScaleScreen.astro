---
// Chapter 4: one dashboard screen built only from steps of the 9-step scale.
// Each element carries a tag with its step, so the reader sees a full hierarchy from 7 sizes.

const rows = [
  { step: 'xs', px: 12, cls: 'ssc-crumb', en: 'Billing / Invoices', vi: 'Thanh toán / Hóa đơn' },
  { step: '3xl', px: 30, cls: 'ssc-title', en: 'Invoices', vi: 'Hóa đơn' },
  { step: 'sm', px: 14, cls: 'ssc-label', en: 'Outstanding this month', vi: 'Chưa thu trong tháng' },
  { step: '5xl', px: 48, cls: 'ssc-metric', en: '$48,210', vi: '$48,210' },
  { step: '2xl', px: 24, cls: 'ssc-section', en: 'Overdue', vi: 'Quá hạn' },
  { step: 'lg', px: 18, cls: 'ssc-card', en: 'Northwind Traders', vi: 'Northwind Traders' },
  { step: 'base', px: 16, cls: 'ssc-body', en: 'Three invoices are past due. The oldest is 21 days late.', vi: 'Ba hóa đơn đã quá hạn. Hóa đơn cũ nhất trễ 21 ngày.' },
  { step: 'sm', px: 14, cls: 'ssc-cell', en: 'INV-1042 · due Oct 14 · $2,400.00', vi: 'INV-1042 · hạn 14/10 · $2,400.00' },
  { step: 'xs', px: 12, cls: 'ssc-badge', en: 'OVERDUE', vi: 'QUÁ HẠN' },
];
const used = [...new Set(rows.map((r) => r.px))].sort((a, b) => a - b);
---
<figure class="ssc">
  <div class="ssc-frame">
    {rows.map((r) => (
      <div class="ssc-row">
        <div class={`ssc-el ${r.cls}`} style={`font-size:${r.px}px`}>
          <span data-lang-en>{r.en}</span>
          <span data-lang-vi>{r.vi}</span>
        </div>
        <span class="ssc-tag">{r.step} · {r.px}</span>
      </div>
    ))}
  </div>
  <figcaption>
    <span data-lang-en>A whole screen from {used.length} of the 9 steps ({used.join(', ')} px). Hierarchy comes from the jumps between steps plus weight and colour, never from a new in-between size.</span>
    <span data-lang-vi>Cả một màn hình chỉ dùng {used.length} trong 9 bậc ({used.join(', ')} px). Phân cấp đến từ bước nhảy giữa các bậc cùng độ đậm và màu chữ, không bao giờ từ một cỡ lưng chừng mới.</span>
  </figcaption>
</figure>

<style>
  .ssc { margin: 2em 0; width: 100%; }
  .ssc-frame { max-width: 560px; margin: 0 auto; padding: 20px; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 12px; }
  .ssc-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 4px 0; border-bottom: 1px dashed var(--border); }
  .ssc-row:last-child { border-bottom: 0; }
  .ssc-el { min-width: 0; color: var(--text); line-height: 1.3; }
  .ssc-tag { flex: none; font-size: 11px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--text-muted); background: var(--bg); border: 1px solid var(--border); border-radius: 4px; padding: 1px 6px; }
  .ssc-crumb { color: var(--text-muted); }
  .ssc-title { font-weight: 700; line-height: 1.15; letter-spacing: -0.025em; }
  .ssc-label { color: var(--text-muted); }
  .ssc-metric { font-weight: 700; line-height: 1.1; letter-spacing: -0.025em; font-variant-numeric: tabular-nums; }
  .ssc-section { font-weight: 700; line-height: 1.2; margin-top: 8px; }
  .ssc-card { font-weight: 600; }
  .ssc-body { color: var(--text-body); line-height: 1.55; }
  .ssc-cell { color: var(--text-body); font-variant-numeric: tabular-nums; }
  .ssc-badge { font-weight: 700; letter-spacing: 0.08em; color: var(--red); }
  .ssc figcaption { margin-top: 0.8em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
