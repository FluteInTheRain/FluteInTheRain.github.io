---
// Six requests against the guard, from the capture next to the figure.
const W = 900, H = 330;
const rows = [
  { y: 50, ok: true, req: ['valid token', 'token hợp lệ'], why: ['signature and exp check out', 'signature và exp đều đúng'], res: '200' },
  { y: 100, ok: false, req: ['no token', 'không có token'], why: ['no Authorization header', 'không có header Authorization'], res: '401' },
  { y: 150, ok: false, req: ['expired token', 'token hết hạn'], why: ['exp is in the past', 'exp đã qua'], res: '401' },
  { y: 200, ok: false, req: ['tampered payload', 'payload bị sửa'], why: ['signature no longer matches', 'signature không còn khớp'], res: '401' },
  { y: 250, ok: false, req: ['alg=none', 'alg=none'], why: ['claims it needs no signature', 'tự nhận không cần signature'], res: '401' },
  { y: 300, ok: false, req: ['wrong password', 'sai mật khẩu'], why: ['refused at the token endpoint', 'bị từ chối ở endpoint cấp token'], res: '401' },
];
---
<figure class="bep7a">
  <div class="bep7a-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Six requests against the guard. A valid token gets 200. No token, an expired token, a tampered payload, an alg none token and a wrong password each get 401, each for a different reason.">
    <text x="40" y="26" class="sub"><tspan data-lang-en>request</tspan><tspan data-lang-vi>request</tspan></text>
    <text x="300" y="26" class="sub"><tspan data-lang-en>what the guard sees</tspan><tspan data-lang-vi>guard thấy gì</tspan></text>
    <text x="720" y="26" class="sub"><tspan data-lang-en>answer</tspan><tspan data-lang-vi>kết quả</tspan></text>
    {rows.map((r) => (
      <g>
        <line x1="40" y1={r.y - 18} x2="860" y2={r.y - 18} class="rule" />
        <text x="40" y={r.y + 4} class="nm"><tspan data-lang-en>{r.req[0]}</tspan><tspan data-lang-vi>{r.req[1]}</tspan></text>
        <text x="300" y={r.y + 4} class="sub"><tspan data-lang-en>{r.why[0]}</tspan><tspan data-lang-vi>{r.why[1]}</tspan></text>
        <text x="720" y={r.y + 4} class={'nm num'}>{r.res}</text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Five different ways to fail, one dependency catching all of them. Only the valid token gets through.</span>
    <span data-lang-vi>Năm cách thất bại khác nhau, một dependency chặn tất cả. Chỉ token hợp lệ đi qua được.</span>
  </figcaption>
</figure>

<style>
  .bep7a { margin: 2em 0; width: 100%; }
  .bep7a-scroll { overflow-x: auto; }
  .bep7a svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .bep7a text { font-size: 14px; fill: var(--text-body); }
  .bep7a .nm { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep7a .sub { fill: var(--text-muted); font-size: 12.5px; }
  .bep7a .mono { fill: var(--text-muted); font-size: 12.5px; font-family: 'JetBrains Mono', monospace; }
  .bep7a .big { font-size: 40px; font-weight: 700; fill: var(--red); font-variant-numeric: tabular-nums; }
  .bep7a .rd { fill: var(--red); font-weight: 700; }
  .bep7a .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep7a .badbox { fill: var(--bg-alt); stroke: var(--red); stroke-width: 2; }
  .bep7a .ln { stroke: var(--text-muted); stroke-width: 1.6; }
  .bep7a .bad { stroke: var(--red); stroke-width: 3; }
  .bep7a .dot { fill: var(--text-muted); }
  .bep7a .baddot { fill: var(--red); }
  .bep7a .hd { fill: var(--text-muted); }
  .bep7a .badhd { fill: var(--red); }
  .bep7a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
<style>.bep7a .rule { stroke: var(--border); stroke-width: 1; } .bep7a .num { font-variant-numeric: tabular-nums; font-size: 17px; }</style>
