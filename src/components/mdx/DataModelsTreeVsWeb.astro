---
// Tree vs web, as a left/right showdown, after Sarah Mei's Diaspora write-up:
//   left:  a TV-show page, where every level is a different kind of thing -> one document
//   right: a social stream, where the same person (Jane) turns up in three places
//          -> either copy her into each spot, or keep her id and look her up (a join in app code)
// Plain inline SVG with site tokens; arrowheads are polygons, so there are no ids to clash
// between the hidden EN/VI copies.

const W = 900;
const H = 560;

type TreeNode = { en: string; vi: string; x: number; y: number; w: number; parent?: number };
const nodeH = 30;
const tree: TreeNode[] = [
  { en: 'TV show: Babylon 5', vi: 'Phim: Babylon 5', x: 40, y: 128, w: 210 },
  { en: 'Season 1', vi: 'Mùa 1', x: 72, y: 170, w: 170, parent: 0 },
  { en: 'Episode 1', vi: 'Tập 1', x: 104, y: 212, w: 170, parent: 1 },
  { en: 'Reviews', vi: 'Bài đánh giá', x: 136, y: 254, w: 160, parent: 2 },
  { en: 'Cast members', vi: 'Diễn viên', x: 136, y: 296, w: 160, parent: 2 },
  { en: 'Episode 2 …', vi: 'Tập 2 …', x: 104, y: 338, w: 170, parent: 1 },
  { en: 'Season 2 …', vi: 'Mùa 2 …', x: 72, y: 380, w: 170, parent: 0 },
];

// Elbow connector from a parent's left side down to the child's left edge.
function elbow(p: TreeNode, c: TreeNode) {
  const x = p.x + 14;
  const y0 = p.y + nodeH;
  const y1 = c.y + nodeH / 2;
  return `M ${x} ${y0} V ${y1} H ${c.x}`;
}

type StreamRow = { en: string; vi: string; who: string; jane: boolean; indent: boolean; y: number };
const stream: StreamRow[] = [
  { en: 'Post, written by', vi: 'Bài viết, tác giả', who: 'Jane', jane: true, indent: false, y: 128 },
  { en: 'Like, by', vi: 'Lượt thích, của', who: 'Joe', jane: false, indent: true, y: 170 },
  { en: 'Post, written by', vi: 'Bài viết, tác giả', who: 'Ali', jane: false, indent: false, y: 212 },
  { en: 'Comment, by', vi: 'Bình luận, của', who: 'Jane', jane: true, indent: true, y: 254 },
  { en: 'Post, written by', vi: 'Bài viết, tác giả', who: 'Kim', jane: false, indent: false, y: 296 },
  { en: 'Like, by', vi: 'Lượt thích, của', who: 'Jane', jane: true, indent: true, y: 338 },
];
const chipX = 712;
const chipW = 104;
const lane = 862;
const usersBox = { x: 470, y: 400, w: 200, h: 34 };
const usersMidY = usersBox.y + usersBox.h / 2;
const janeYs = stream.filter((r) => r.jane).map((r) => r.y + nodeH / 2);

// Small arrowhead pointing left, ending at (x, y).
const arrowLeft = (x: number, y: number) => `${x},${y} ${x + 9},${y - 5} ${x + 9},${y + 5}`;

const leftNotes = [
  { en: 'One document fits.', vi: 'Một document là vừa.', strong: true },
  { en: 'The page loads the whole tree in one read.', vi: 'Trang tải cả cây trong một lần đọc.', strong: false },
  { en: 'Nothing points outside the tree,', vi: 'Không ô nào trỏ ra ngoài cây,', strong: false },
  { en: 'so nothing is stored twice.', vi: 'nên không có gì bị lưu hai lần.', strong: false },
];
const rightNotes = [
  { en: 'Option A: copy Jane into every spot.', vi: 'Cách A: chép Jane vào mọi chỗ.', bad: true },
  { en: 'She changes her name: rewrite every stream she is in.', vi: 'Jane đổi tên: phải sửa mọi stream có cô ấy.', bad: false },
  { en: 'Option B: keep only her id 7, fetch her separately.', vi: 'Cách B: chỉ giữ id 7, đọc Jane ở chỗ khác.', bad: false },
  { en: 'One copy, but now the app code does the join.', vi: 'Chỉ một bản, nhưng code app phải tự join.', bad: false },
];
const noteY = [470, 492, 518, 540];
---
<figure class="dmtw">
  <div class="dmtw-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: a TV show page stored as one nested document, show to season to episode to reviews and cast, where every level is a different kind of thing. Right: a social stream where the same user, Jane, appears as a post author, a commenter and a liker. She can be copied into each spot, or stored once as id 7 and looked up separately.">
    {/* Panel headers */}
    <text x="20" y="24" class="dmtw-h">
      <tspan data-lang-en>A TV show site: a tree</tspan>
      <tspan data-lang-vi>Trang phim truyền hình: một cái cây</tspan>
    </text>
    <text x="20" y="46" class="dmtw-sub">
      <tspan data-lang-en>Every level is a different kind of thing.</tspan>
      <tspan data-lang-vi>Mỗi tầng là một loại dữ liệu khác nhau.</tspan>
    </text>
    <text x="470" y="24" class="dmtw-h">
      <tspan data-lang-en>A social stream: a web</tspan>
      <tspan data-lang-vi>Bảng tin mạng xã hội: một mạng lưới</tspan>
    </text>
    <text x="470" y="46" class="dmtw-sub">
      <tspan data-lang-en>The same person turns up in many places.</tspan>
      <tspan data-lang-vi>Cùng một người xuất hiện ở nhiều chỗ.</tspan>
    </text>
    <line x1="20" x2={W - 20} y1="66" y2="66" class="dmtw-rule" />

    {/* Left: one document holding the whole tree */}
    <rect x="20" y="88" width="410" height="338" rx="6" class="dmtw-doc" />
    <text x="34" y="110" class="dmtw-doclabel">
      <tspan data-lang-en>one document</tspan>
      <tspan data-lang-vi>một document</tspan>
    </text>
    {tree.map((n) => n.parent !== undefined && <path d={elbow(tree[n.parent], n)} class="dmtw-link" />)}
    {tree.map((n) => (
      <g class="dmtw-node">
        <rect x={n.x} y={n.y} width={n.w} height={nodeH} rx="3" />
        <text x={n.x + 12} y={n.y + 20}>
          <tspan data-lang-en>{n.en}</tspan>
          <tspan data-lang-vi>{n.vi}</tspan>
        </text>
      </g>
    ))}

    {/* Right: one stream document, Jane in three places */}
    <rect x="470" y="88" width="410" height="290" rx="6" class="dmtw-doc" />
    <text x="484" y="110" class="dmtw-doclabel">
      <tspan data-lang-en>Joe's stream, one document</tspan>
      <tspan data-lang-vi>Stream của Joe, một document</tspan>
    </text>
    {stream.map((r) => {
      const x = r.indent ? 516 : 486;
      return (
        <g>
          <g class="dmtw-node">
            <rect x={x} y={r.y} width={chipX - 12 - x} height={nodeH} rx="3" />
            <text x={x + 12} y={r.y + 20}>
              <tspan data-lang-en>{r.en}</tspan>
              <tspan data-lang-vi>{r.vi}</tspan>
            </text>
          </g>
          <g class={r.jane ? 'dmtw-chip is-jane' : 'dmtw-chip'}>
            <rect x={chipX} y={r.y} width={chipW} height={nodeH} rx="3" />
            <text x={chipX + chipW / 2} y={r.y + 20} text-anchor="middle">{r.who}</text>
          </g>
        </g>
      );
    })}

    {/* Option B: the three Jane spots point at one users record */}
    {janeYs.map((y) => <line x1={chipX + chipW} x2={lane} y1={y} y2={y} class="dmtw-ref" />)}
    <path d={`M ${lane} ${janeYs[0]} V ${usersMidY} H ${usersBox.x + usersBox.w + 9}`} class="dmtw-ref" />
    <polygon points={arrowLeft(usersBox.x + usersBox.w, usersMidY)} class="dmtw-head" />
    <g class="dmtw-node is-user">
      <rect x={usersBox.x} y={usersBox.y} width={usersBox.w} height={usersBox.h} rx="3" />
      <text x={usersBox.x + 12} y={usersBox.y + 22}>
        <tspan data-lang-en>users: id 7, Jane</tspan>
        <tspan data-lang-vi>users: id 7, Jane</tspan>
      </text>
    </g>

    {/* Verdicts */}
    {leftNotes.map((n, i) => (
      <text x="20" y={noteY[i]} class={n.strong ? 'dmtw-note is-strong' : 'dmtw-note'}>
        <tspan data-lang-en>{n.en}</tspan>
        <tspan data-lang-vi>{n.vi}</tspan>
      </text>
    ))}
    {rightNotes.map((n, i) => (
      <text x="470" y={noteY[i]} class={n.bad ? 'dmtw-note is-bad' : i === 2 ? 'dmtw-note is-strong' : 'dmtw-note'}>
        <tspan data-lang-en>{n.en}</tspan>
        <tspan data-lang-vi>{n.vi}</tspan>
      </text>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Both look like nested data at first. The difference is on the right: Jane is one person who appears three times, so a single document either copies her or points out of itself. Example shapes follow Sarah Mei's account of Diaspora; names are illustrative.</span>
    <span data-lang-vi>Lúc đầu cả hai trông đều như dữ liệu lồng nhau. Khác biệt nằm bên phải: Jane là một người nhưng xuất hiện ba lần, nên một document đơn lẻ hoặc phải chép cô ấy ra, hoặc phải trỏ ra ngoài chính nó. Hình dạng dữ liệu theo bài viết của Sarah Mei về Diaspora; tên người chỉ để minh hoạ.</span>
  </figcaption>
</figure>

<style>
  .dmtw {
    margin: 2em 0;
    width: 100%;
  }
  .dmtw-scroll {
    overflow-x: auto;
  }
  .dmtw svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .dmtw text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .dmtw .dmtw-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .dmtw .dmtw-sub,
  .dmtw .dmtw-doclabel {
    fill: var(--text-muted);
  }
  .dmtw .dmtw-doclabel {
    font-size: 13px;
  }
  .dmtw-rule {
    stroke: var(--border);
  }
  .dmtw-doc {
    fill: none;
    stroke: var(--text-faint);
    stroke-width: 1.2;
    stroke-dasharray: 5 4;
  }
  .dmtw-link {
    fill: none;
    stroke: var(--text-faint);
    stroke-width: 1.2;
  }
  .dmtw-node rect,
  .dmtw-chip rect {
    fill: var(--bg-alt);
    stroke: var(--border);
  }
  .dmtw .dmtw-chip text {
    font-weight: 600;
  }
  .dmtw-chip.is-jane rect {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .dmtw .dmtw-chip.is-jane text {
    fill: var(--red);
  }
  .dmtw-node.is-user rect {
    stroke: var(--text-muted);
    stroke-width: 1.4;
  }
  .dmtw .dmtw-node.is-user text {
    font-weight: 600;
    fill: var(--text);
  }
  .dmtw-ref {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.3;
    stroke-dasharray: 4 3;
  }
  .dmtw-head {
    fill: var(--text-muted);
  }
  .dmtw .dmtw-note.is-strong {
    font-weight: 700;
    fill: var(--text);
  }
  .dmtw .dmtw-note.is-bad {
    font-weight: 700;
    fill: var(--red);
  }
  .dmtw figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
