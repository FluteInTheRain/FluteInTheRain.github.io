---
import DemoFrame from './DemoFrame.astro';
import GoHttpPoolLeakDemo from '../demos/GoHttpPoolLeakDemo.tsx';
---
<figure class="ghpl-figure">
  <DemoFrame title="Interactive tracer: Keep-Alive socket drop on unread Body.Close vs Transport tuning" titleVi="Trình mô phỏng: Quên đọc cạn resp.Body phá Keep-Alive & cấu hình Timeout chuẩn">
    <GoHttpPoolLeakDemo client:visible />
  </DemoFrame>
  <figcaption>
    <span data-lang-en>Compare closing unread HTTP responses (dropping live TCP/TLS sockets into TIME_WAIT every request) against bounded io.Discard draining + custom Transport Keep-Alive tuning and Timeout guards.</span>
    <span data-lang-vi>So sánh việc gọi Close() khi còn dữ liệu chưa đọc (làm rớt socket TCP/TLS phải bắt tay lại từ đầu) với mẹo đọc cạn có trần 1 MiB qua io.Discard kèm mở rộng MaxIdleConnsPerHost.</span>
  </figcaption>
</figure>

<style is:global>
  .ghpl-figure { margin: 2em 0; width: 100%; }
  .ghpl-figure > .demo-frame { margin-bottom: 0; }
  .ghpl-figure > figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  .ghpl .sd-stats { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); }
  .ghpl .sd-group > span { text-transform: none; letter-spacing: 0; font-size: 13px; font-weight: 600; color: var(--text-muted); }
  .ghpl .sd-stat span { text-transform: none; letter-spacing: 0; font-size: 12px; font-weight: 600; }
  .ghpl .sd-stat b { font-size: 15px; overflow-wrap: anywhere; word-break: break-word; }

  .ghpl-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 12px; margin-bottom: 12px; }
  @media (max-width: 760px) { .ghpl-grid { grid-template-columns: 1fr; } }
  .ghpl-pane { border: 1px solid var(--border); border-radius: 8px; background: var(--bg); overflow: hidden; }
  .ghpl-hdr {
    padding: 7px 12px; font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--text-muted); background: var(--bg-alt); border-bottom: 1px solid var(--border);
  }
  .ghpl-code { padding: 8px 0; overflow-x: auto; font-family: var(--font-mono, ui-monospace, monospace); font-size: 12px; line-height: 1.55; }
  .ghpl-line { display: flex; gap: 8px; padding: 2px 12px; white-space: pre; color: var(--text-body); }
  .ghpl-ln { color: var(--text-muted); user-select: none; min-width: 22px; }
  .ghpl-line.is-active { background: var(--gold-tint-bg); color: var(--text); font-weight: 700; }
  .ghpl-note { padding: 12px; font-size: 13.5px; line-height: 1.55; color: var(--text-body); }
  .ghpl-note p { margin: 0 0 10px 0; }
  .ghpl-sock {
    padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-alt);
    font-family: var(--font-mono, ui-monospace, monospace); font-size: 11.5px; font-weight: 700; color: var(--text);
  }
</style>
