---
import DiagramIcon from './DiagramIcon.astro';
// The N+1 problem in GraphQL: one database call per repository against one batched call, for the issues query from the post. The batched count is illustrative.
// Arrowheads are polygons: no SVG ids.
const W = 900;
const H = 330;
type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}
const frames: any[] = [];
const boxes: any[] = [];
const links: any[] = [];
const labels: any[] = [];
const nums: any[] = [];
frames.push({ x: 10, y: 10, w: 880, h: 150, kind: 'bad' }, { x: 10, y: 170, w: 880, h: 150, kind: 'good' });
const lanes = [
  { y: 10, tEn: 'The resolver asks once per repository', tVi: 'Resolver hỏi một lần cho mỗi repository', a: ['1 call: the repositories', '1 lời gọi: các repository'], b: ['50 calls: issues, one per repository', '50 lời gọi: issues, mỗi repository một lần'], tot: ['Total: 51 database calls', 'Tổng: 51 lời gọi database'], kind: 'bad' },
  { y: 170, tEn: 'The resolver batches the lookups', tVi: 'Resolver gom các lần tra lại', a: ['1 call: the repositories', '1 lời gọi: các repository'], b: ['1 batched call: issues of all 50', '1 lời gọi gộp: issues của cả 50'], tot: ['Total: 2 database calls', 'Tổng: 2 lời gọi database'], kind: 'good' },
];
lanes.forEach((l) => {
  labels.push({ x: 28, y: l.y + 28, en: l.tEn, vi: l.tVi, cls: 'h' });
  boxes.push(
    { x: 28, y: l.y + 46, w: 196, h: 60, icon: 'laptop', en: ['Client', 'one GraphQL query'], vi: ['Client', 'một truy vấn GraphQL'] },
    { x: 290, y: l.y + 46, w: 150, h: 60, icon: 'server', en: ['Server', 'resolvers'], vi: ['Server', 'các resolver'] },
    { x: 720, y: l.y + 46, w: 150, h: 60, icon: 'db', en: ['Database'], vi: ['Database'] },
  );
  links.push({ pts: [[224, l.y + 76], [290, l.y + 76]] });
  links.push({ pts: [[440, l.y + 62], [720, l.y + 62]], kind: l.kind });
  links.push({ pts: [[440, l.y + 92], [720, l.y + 92]], kind: l.kind });
  labels.push({ x: 580, y: l.y + 56, anchor: 'middle', en: l.a[0], vi: l.a[1], cls: 'muted' });
  labels.push({ x: 580, y: l.y + 86, anchor: 'middle', en: l.b[0], vi: l.b[1], cls: 'muted' });
  labels.push({ x: 28, y: l.y + 134, en: l.tot[0], vi: l.tot[1], cls: l.kind });
});
---
<figure class="dmgr">
  <div class="dmgr-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two lanes. One query per repository: the client sends one GraphQL query, the resolvers make 1 call for the repositories and 50 calls for the issues, 51 database calls in total. Batched: 1 call for the repositories and 1 batched call for the issues of all 50 repositories, 2 database calls in total.">
    {frames.map((f) => (
      <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="6" class={`dmgr-frame ${f.kind ?? ''}`} />
    ))}
    {boxes.map((b) => {
      const n = Math.max(b.en.length, b.vi.length);
      const top = !!b.top;
      const cx = b.x + b.w / 2;
      const x0 = top ? cx : b.icon ? b.x + 46 : b.x + 14;
      const y0 = top ? b.y + (b.icon ? 56 : 24) : b.y + b.h / 2 - ((n - 1) * 17) / 2 + 4;
      return (
        <g class={`dmgr-box ${b.kind ?? ''}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
          {b.icon && <DiagramIcon name={b.icon} x={top ? cx : b.x + 24} y={top ? b.y + 24 : b.y + b.h / 2} size={b.is ?? 26} />}
          {Array.from({ length: n }).map((_, i) => (
            <text x={x0} y={y0 + i * 17} text-anchor={top ? 'middle' : 'start'} class={i === 0 && !b.flat ? 'dmgr-name' : 'dmgr-sub'}>
              <tspan data-lang-en>{b.en[i] ?? ''}</tspan>
              <tspan data-lang-vi>{b.vi[i] ?? ''}</tspan>
            </text>
          ))}
        </g>
      );
    })}
    {links.map((l) => {
      const a = arrow(l.pts);
      return (
        <g>
          <polyline points={l.plain ? l.pts.map((p) => p.join(',')).join(' ') : a.line} class={`dmgr-edge ${l.kind ?? ''}`} fill="none" />
          {!l.plain && <polygon points={a.head} class={`dmgr-head ${l.kind ?? ''}`} />}
        </g>
      );
    })}
    {labels.map((t) => (
      <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`dmgr-lab ${t.cls ?? ''}`}>
        <tspan data-lang-en>{t.en}</tspan>
        <tspan data-lang-vi>{t.vi ?? t.en}</tspan>
      </text>
    ))}
    {nums.map((n) => (
      <g class="dmgr-num">
        <circle cx={n.x} cy={n.y} r="11" />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.n}</text>
      </g>
    ))}

  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Same query, same answer. Batching turns 51 round trips into 2, the same trick Twitter uses when it hydrates a timeline.</span>
    <span data-lang-vi>Cùng truy vấn, cùng kết quả. Gom lô biến 51 lượt gọi thành 2, cùng mẹo Twitter dùng khi hydrate một timeline.</span>
  </figcaption>
</figure>

<style>
  .dmgr { margin: 2em 0; width: 100%; }
  .dmgr-scroll { overflow-x: auto; }
  .dmgr svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dmgr text { font-size: 14px; fill: var(--text-body); }
  .dmgr .dmgr-name { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .dmgr .dmgr-sub { font-size: 12px; fill: var(--text-muted); }
  .dmgr .dmgr-lab { font-size: 13px; }
  .dmgr .dmgr-lab.h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dmgr .dmgr-lab.strong { font-weight: 700; fill: var(--text); }
  .dmgr .dmgr-lab.muted { fill: var(--text-muted); }
  .dmgr .dmgr-lab.bad { font-weight: 700; fill: var(--red); }
  .dmgr .dmgr-lab.good { font-weight: 700; fill: var(--text); }
  .dmgr .dmgr-lab.mono, .dmgr .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .dmgr-frame { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .dmgr-frame.bad { stroke: var(--red); }
  .dmgr-frame.good { stroke: var(--gold); }
  .dmgr-box rect { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmgr-box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dmgr-box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmgr-box.plain rect { fill: none; stroke: var(--border); }
  .dmgr-edge { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmgr-edge.bad { stroke: var(--red); }
  .dmgr-edge.good { stroke: var(--gold-icon); }
  .dmgr-head { fill: var(--text-muted); }
  .dmgr-head.bad { fill: var(--red); }
  .dmgr-head.good { fill: var(--gold-icon); }
  .dmgr-num circle { fill: var(--bg-alt); stroke: var(--text-muted); }
  .dmgr-num text { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dmgr figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
