---
import DiagramIcon from './DiagramIcon.astro';
// Raft/Paxos epoch fencing and overlapping quorums on a 5-node cluster (quorum = 3).
// Top: partition isolates old leader N1 (Term 4) with only N2; majority {N3, N4, N5} elects N3 in Term 5.
// Bottom: partition heals; N3 replicates entry #42 via write quorum {N2, N3, N4}, overlapping
// the Term 5 election quorum on N3 and N4, so zombie leader N1's Term 4 write is rejected.
// Plain inline SVG with site tokens and polygon arrowheads (no SVG marker ids).

const W = 900;
const H = 480;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const nodeXs = [45, 200, 420, 580, 740];
const nodeW = 120;
const nodeH = 54;

const v4 = arrow(nodeXs[3], 117, nodeXs[2] + nodeW, 117);

// Bottom row arrows: N3 sends AppendEntries(#42, T5) to N2 and N4
const propToN2 = arrow(nodeXs[2], 320, nodeXs[1] + nodeW, 320);
const propToN4 = arrow(nodeXs[2] + nodeW, 320, nodeXs[3], 320);
// Stale N1 sends Term 4 write to N3 (or N2? Wait: N1 -> N2 shows Term 4 rejected because N2/N3 saw Term 5!)
// Even clearer: N1 sends Term 4 write toward N3/N2 -> arrow stops at N2 with red X!
const staleToN2 = arrow(nodeXs[0] + nodeW, 338, nodeXs[1], 338);
---
<figure class="cre">
  <div class="cre-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: a network partition splits a 5-node cluster into minority {N1, N2} where old leader N1 sits in Term 4, and majority {N3, N4, N5} which elects N3 in Term 5. Bottom: after the partition heals, N3 replicates entry #42 via write quorum {N2, N3, N4}. Because that write quorum overlaps the Term 5 election quorum on N3 and N4, zombie leader N1's Term 4 write is rejected.">
      {/* ---------- Phase 1: Election ---------- */}
      <text x="20" y="24" class="cre-h">
        <tspan data-lang-en>1. Partition &amp; Round 1 (leader election): majority {`{N3, N4, N5}`} elects N3 in Term 5</tspan>
        <tspan data-lang-vi>1. Chia cắt mạng &amp; Vòng 1 (bầu leader): đa số {`{N3, N4, N5}`} bầu N3 ở nhiệm kỳ 5</tspan>
      </text>
      <text x="20" y="45" class="cre-sub">
        <tspan data-lang-en>N1 is isolated with N2 (2/5 nodes) and still thinks it leads Term 4. It cannot reach a quorum of 3.</tspan>
        <tspan data-lang-vi>N1 bị cô lập cùng N2 (2/5 node) và vẫn tưởng mình làm leader nhiệm kỳ 4. Nó không gom đủ quorum 3 node.</tspan>
      </text>

      {/* Minority dashed box */}
      <rect x="28" y="68" width="308" height="122" rx="8" class="cre-zone" />
      <text x="42" y="178" class="cre-zone-lbl">
        <tspan data-lang-en>minority (2/5): stalled</tspan>
        <tspan data-lang-vi>thiểu số (2/5): kẹt cứng</tspan>
      </text>

      {/* Partition wall */}
      <line x1="364" x2="364" y1="62" y2="196" class="cre-part" />
      <text x="364" y="212" text-anchor="middle" class="cre-part-lbl">
        <tspan data-lang-en>network partition</tspan>
        <tspan data-lang-vi>đứt mạng</tspan>
      </text>

      {/* Majority quorum box */}
      <rect x="392" y="68" width="486" height="122" rx="8" class="cre-zone is-quorum" />
      <text x="408" y="178" class="cre-zone-lbl is-ok">
        <tspan data-lang-en>Round 1 quorum (3/5): elected N3 at Term 5</tspan>
        <tspan data-lang-vi>Quorum vòng 1 (3/5): bầu N3 tại nhiệm kỳ 5</tspan>
      </text>

      {/* Top nodes */}
      <g>
        <rect x={nodeXs[0]} y="90" width={nodeW} height={nodeH} rx="6" class="cre-node is-stale" />
        <DiagramIcon name="server" x={nodeXs[0] + 17} y="117" size={18} />
        <text x={nodeXs[0] + nodeW / 2 + 10} y="113" text-anchor="middle" class="cre-node-name">N1 (zombie)</text>
        <text x={nodeXs[0] + nodeW / 2 + 10} y="132" text-anchor="middle" class="cre-node-sub">
          <tspan data-lang-en>Leader · Term 4</tspan>
          <tspan data-lang-vi>Leader · Kỳ 4</tspan>
        </text>
      </g>
      <g>
        <rect x={nodeXs[1]} y="90" width={nodeW} height={nodeH} rx="6" class="cre-node" />
        <DiagramIcon name="server" x={nodeXs[1] + 17} y="117" size={18} />
        <text x={nodeXs[1] + nodeW / 2 + 10} y="113" text-anchor="middle" class="cre-node-name">N2</text>
        <text x={nodeXs[1] + nodeW / 2 + 10} y="132" text-anchor="middle" class="cre-node-sub">
          <tspan data-lang-en>Follower · Term 4</tspan>
          <tspan data-lang-vi>Follower · Kỳ 4</tspan>
        </text>
      </g>
      <g>
        <rect x={nodeXs[2]} y="90" width={nodeW} height={nodeH} rx="6" class="cre-node is-leader" />
        <DiagramIcon name="server" x={nodeXs[2] + 17} y="117" size={18} />
        <text x={nodeXs[2] + nodeW / 2 + 10} y="113" text-anchor="middle" class="cre-node-name">N3</text>
        <text x={nodeXs[2] + nodeW / 2 + 10} y="132" text-anchor="middle" class="cre-node-sub is-red">
          <tspan data-lang-en>Leader · Term 5</tspan>
          <tspan data-lang-vi>Leader · Kỳ 5</tspan>
        </text>
      </g>
      <g>
        <rect x={nodeXs[3]} y="90" width={nodeW} height={nodeH} rx="6" class="cre-node" />
        <DiagramIcon name="server" x={nodeXs[3] + 17} y="117" size={18} />
        <text x={nodeXs[3] + nodeW / 2 + 10} y="113" text-anchor="middle" class="cre-node-name">N4</text>
        <text x={nodeXs[3] + nodeW / 2 + 10} y="132" text-anchor="middle" class="cre-node-sub">
          <tspan data-lang-en>Voted T5</tspan>
          <tspan data-lang-vi>Bầu kỳ 5</tspan>
        </text>
      </g>
      <g>
        <rect x={nodeXs[4]} y="90" width={nodeW} height={nodeH} rx="6" class="cre-node" />
        <DiagramIcon name="server" x={nodeXs[4] + 17} y="117" size={18} />
        <text x={nodeXs[4] + nodeW / 2 + 10} y="113" text-anchor="middle" class="cre-node-name">N5</text>
        <text x={nodeXs[4] + nodeW / 2 + 10} y="132" text-anchor="middle" class="cre-node-sub">
          <tspan data-lang-en>Voted T5</tspan>
          <tspan data-lang-vi>Bầu kỳ 5</tspan>
        </text>
      </g>

      {/* Vote arrows from N4 and N5 to N3 */}
      <path d={v4.line} class="cre-arrow" /><polygon points={v4.head} class="cre-head" />
      <path d={`M ${nodeXs[4] + nodeW / 2} 90 L ${nodeXs[4] + nodeW / 2} 78 L ${nodeXs[2] + nodeW / 2} 78 L ${nodeXs[2] + nodeW / 2} 84`} class="cre-arrow" />
      <polygon points={`${nodeXs[2] + nodeW / 2},90 ${nodeXs[2] + nodeW / 2 - 4},82 ${nodeXs[2] + nodeW / 2 + 4},82`} class="cre-head" />

      {/* ---------- Divider ---------- */}
      <line x1="20" x2={W - 20} y1="232" y2="232" class="cre-rule" />

      {/* ---------- Phase 2: Log Quorum & Fencing ---------- */}
      <text x="20" y="260" class="cre-h">
        <tspan data-lang-en>2. Round 2 (log proposal) &amp; epoch fencing: quorums overlap, so Term 4 is rejected</tspan>
        <tspan data-lang-vi>2. Vòng 2 (đề xuất log) &amp; chặn nhiệm kỳ cũ: hai quorum giao nhau nên nhiệm kỳ 4 bị từ chối</tspan>
      </text>
      <text x="20" y="281" class="cre-sub">
        <tspan data-lang-en>Every write needs a quorum too. Any two majorities overlap on at least one node (here N3 and N4 know Term 5).</tspan>
        <tspan data-lang-vi>Mỗi lần ghi log cũng cần quorum. Hai nhóm đa số bất kỳ luôn giao nhau ít nhất một node (ở đây N3 và N4 đều biết kỳ 5).</tspan>
      </text>

      {/* Write quorum box {N2, N3, N4} */}
      <rect x="184" y="294" width="532" height="140" rx="8" class="cre-zone is-quorum" />
      <text x="450" y="422" text-anchor="middle" class="cre-zone-lbl is-ok">
        <tspan data-lang-en>Round 2 write quorum {`{N2, N3, N4}`}: overlaps Round 1 on N3 &amp; N4 → #42 committed</tspan>
        <tspan data-lang-vi>Quorum ghi vòng 2 {`{N2, N3, N4}`}: giao vòng 1 tại N3 &amp; N4 → chốt mục #42</tspan>
      </text>

      {/* Bottom nodes */}
      <g>
        <rect x={nodeXs[0]} y="314" width={nodeW} height={nodeH} rx="6" class="cre-node is-stale" />
        <DiagramIcon name="server" x={nodeXs[0] + 17} y="341" size={18} />
        <text x={nodeXs[0] + nodeW / 2 + 10} y="337" text-anchor="middle" class="cre-node-name">N1 (Term 4)</text>
        <text x={nodeXs[0] + nodeW / 2 + 10} y="356" text-anchor="middle" class="cre-node-sub is-red">
          <tspan data-lang-en>Steps down</tspan>
          <tspan data-lang-vi>Thoái vị</tspan>
        </text>
      </g>
      <g>
        <rect x={nodeXs[1]} y="314" width={nodeW} height={nodeH} rx="6" class="cre-node" />
        <DiagramIcon name="server" x={nodeXs[1] + 17} y="341" size={18} />
        <text x={nodeXs[1] + nodeW / 2 + 10} y="337" text-anchor="middle" class="cre-node-name">N2</text>
        <text x={nodeXs[1] + nodeW / 2 + 10} y="356" text-anchor="middle" class="cre-node-sub">
          <tspan data-lang-en>Sees T5 · ACK</tspan>
          <tspan data-lang-vi>Biết kỳ 5 · OK</tspan>
        </text>
      </g>
      <g>
        <rect x={nodeXs[2]} y="314" width={nodeW} height={nodeH} rx="6" class="cre-node is-leader" />
        <DiagramIcon name="server" x={nodeXs[2] + 17} y="341" size={18} />
        <text x={nodeXs[2] + nodeW / 2 + 10} y="337" text-anchor="middle" class="cre-node-name">N3 (overlap)</text>
        <text x={nodeXs[2] + nodeW / 2 + 10} y="356" text-anchor="middle" class="cre-node-sub is-red">
          <tspan data-lang-en>Appends #42</tspan>
          <tspan data-lang-vi>Ghi #42</tspan>
        </text>
      </g>
      <g>
        <rect x={nodeXs[3]} y="314" width={nodeW} height={nodeH} rx="6" class="cre-node is-overlap" />
        <DiagramIcon name="server" x={nodeXs[3] + 17} y="341" size={18} />
        <text x={nodeXs[3] + nodeW / 2 + 10} y="337" text-anchor="middle" class="cre-node-name">N4 (overlap)</text>
        <text x={nodeXs[3] + nodeW / 2 + 10} y="356" text-anchor="middle" class="cre-node-sub">
          <tspan data-lang-en>Knows T5 · ACK</tspan>
          <tspan data-lang-vi>Biết kỳ 5 · OK</tspan>
        </text>
      </g>
      <g>
        <rect x={nodeXs[4]} y="314" width={nodeW} height={nodeH} rx="6" class="cre-node is-muted" />
        <DiagramIcon name="server" x={nodeXs[4] + 17} y="341" size={18} />
        <text x={nodeXs[4] + nodeW / 2 + 10} y="337" text-anchor="middle" class="cre-node-name">N5</text>
        <text x={nodeXs[4] + nodeW / 2 + 10} y="356" text-anchor="middle" class="cre-node-sub">
          <tspan data-lang-en>Catches up later</tspan>
          <tspan data-lang-vi>Đồng bộ sau</tspan>
        </text>
      </g>

      {/* Replicate #42 arrows */}
      <path d={propToN2.line} class="cre-arrow" /><polygon points={propToN2.head} class="cre-head" />
      <text x={(nodeXs[1] + nodeW + nodeXs[2]) / 2} y="312" text-anchor="middle" class="cre-edge-lbl">#42 (T5)</text>
      <path d={propToN4.line} class="cre-arrow" /><polygon points={propToN4.head} class="cre-head" />
      <text x={(nodeXs[2] + nodeW + nodeXs[3]) / 2} y="312" text-anchor="middle" class="cre-edge-lbl">#42 (T5)</text>

      {/* Stale N1 write rejected at N2 */}
      <path d={staleToN2.line} class="cre-arrow is-bad" /><polygon points={staleToN2.head} class="cre-head is-bad" />
      <text x="98" y="392" text-anchor="middle" class="cre-bad-lbl">
        <tspan data-lang-en>Write T4 rejected (4 &lt; 5)</tspan>
        <tspan data-lang-vi>Từ chối kỳ 4 (4 &lt; 5)</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Raft, Multi-Paxos, and Zab all guarantee at most one leader per epoch (term/ballot) and use overlapping majority quorums across election and log replication. Once N2 learns of Term 5, even a healed zombie leader from Term 4 cannot overwrite committed log entries.</span>
    <span data-lang-vi>Raft, Multi-Paxos và Zab đều đảm bảo tối đa một leader trong mỗi nhiệm kỳ (epoch/term) và dùng hai vòng quorum đa số bắt buộc phải giao nhau giữa bầu cử và ghi log. Khi N2 đã biết nhiệm kỳ 5, ngay cả leader cũ từ nhiệm kỳ 4 sống lại cũng bị chặn, không thể ghi đè log đã chốt.</span>
  </figcaption>
</figure>

<style>
  .cre {
    margin: 2em 0;
    width: 100%;
  }
  .cre-scroll {
    overflow-x: auto;
  }
  .cre svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .cre text {
    font-size: 14px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .cre .cre-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .cre .cre-sub {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .cre-rule {
    stroke: var(--border);
  }
  .cre-zone {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.4;
    stroke-dasharray: 5 4;
  }
  .cre-zone.is-quorum {
    stroke: var(--text-muted);
  }
  .cre .cre-zone-lbl {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .cre .cre-zone-lbl.is-ok {
    font-weight: 600;
    fill: var(--text);
  }
  .cre-part {
    stroke: var(--red);
    stroke-width: 1.8;
    stroke-dasharray: 6 4;
  }
  .cre .cre-part-lbl,
  .cre .cre-bad-lbl {
    font-size: 12.5px;
    font-weight: 700;
    fill: var(--red);
  }
  .cre-node {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.3;
  }
  .cre-node.is-leader {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.8;
  }
  .cre-node.is-overlap {
    stroke: var(--text);
    stroke-width: 1.8;
  }
  .cre-node.is-stale {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-dasharray: 4 3;
    stroke-width: 1.4;
  }
  .cre-node.is-muted {
    opacity: 0.65;
  }
  .cre .cre-node-name {
    font-size: 13.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .cre .cre-node-sub {
    font-size: 12px;
    fill: var(--text-muted);
  }
  .cre .cre-node-sub.is-red {
    fill: var(--red);
    font-weight: 600;
  }
  .cre .cre-edge-lbl {
    font-size: 12px;
    font-weight: 600;
    fill: var(--text);
  }
  .cre-arrow {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
  }
  .cre-head {
    fill: var(--text);
  }
  .cre-arrow.is-bad {
    stroke: var(--red);
    stroke-dasharray: 4 3;
  }
  .cre-head.is-bad {
    fill: var(--red);
  }
  .cre figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
