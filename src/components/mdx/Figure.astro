---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  altVi?: string;
  caption?: string;
  captionVi?: string;
  width?: number;
  sourceTitle?: string;
  sourceUrl?: string;
}

const { src, alt, altVi, caption, captionVi, width, sourceTitle, sourceUrl } = Astro.props;
---
<figure class="figure figure-zoomable">
  {typeof src === 'string'
    ? <img src={src} alt={alt} loading="lazy" decoding="async" width={width} data-zoomable />
    : <Image src={src} alt={alt} widths={[480, 800, 1200, 1600]} sizes="(max-width: 768px) 100vw, (max-width: 1200px) 1000px, 1200px" loading="lazy" data-zoomable />}
  {(caption || captionVi || sourceTitle) && (
    <figcaption>
      {caption && captionVi && caption !== captionVi ? (
        <>
          <span data-lang-en>{caption}</span>
          <span data-lang-vi>{captionVi}</span>
        </>
      ) : (
        <span>{caption || captionVi}</span>
      )}
      {sourceTitle && (
        <span class="figure-source">
          {(caption || captionVi) ? ' — ' : ''}
          <span class="source-badge">
            <svg class="source-icon" viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true">
              <path d="M4.75 3.5a.75.75 0 0 0 0 1.5h4.69L2.22 12.22a.75.75 0 1 0 1.06 1.06L10.5 6.06v4.69a.75.75 0 0 0 1.5 0v-6.5a.75.75 0 0 0-.75-.75h-6.5Z"/>
            </svg>
            <span data-lang-en>Verified Source: </span>
            <span data-lang-vi>Tài liệu kiểm chứng: </span>
            {sourceUrl ? <a href={sourceUrl} rel="noopener" target="_blank">{sourceTitle}</a> : sourceTitle}
          </span>
        </span>
      )}
    </figcaption>
  )}
</figure>
