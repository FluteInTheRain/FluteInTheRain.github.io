---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  width?: number;
  sourceTitle?: string;
  sourceUrl?: string;
}
const { src, alt, caption, width, sourceTitle, sourceUrl } = Astro.props;
---
<figure class="figure">
  {typeof src === 'string'
    ? <img src={src} alt={alt} loading="lazy" decoding="async" width={width} />
    : <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 800px) 100vw, 760px" loading="lazy" />}
  {(caption || sourceTitle) && (
    <figcaption>
      {caption}
      {sourceTitle && (
        <span class="figure-source">
          {caption ? ' · Source: ' : 'Source: '}
          {sourceUrl ? <a href={sourceUrl} rel="noopener" target="_blank">{sourceTitle}</a> : sourceTitle}
        </span>
      )}
    </figcaption>
  )}
</figure>
