---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  altVi?: string;
  caption?: string;
  captionVi?: string;
  width?: number;
  sourceTitle?: string;
  sourceUrl?: string;
}

const { src, alt, altVi, caption, captionVi, width, sourceTitle, sourceUrl } = Astro.props;
---
<figure class="figure">
  {typeof src === 'string'
    ? <img src={src} alt={alt} loading="lazy" decoding="async" width={width} />
    : <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 800px) 100vw, 760px" loading="lazy" />}
  {(caption || captionVi || sourceTitle) && (
    <figcaption>
      {caption && captionVi && caption !== captionVi ? (
        <>
          <span data-lang-en>{caption}</span>
          <span data-lang-vi>{captionVi}</span>
        </>
      ) : (
        <span>{caption || captionVi}</span>
      )}
      {sourceTitle && (
        <span class="figure-source">
          {(caption || captionVi) ? ' · ' : ''}
          <span data-lang-en>Source: </span>
          <span data-lang-vi>Nguồn: </span>
          {sourceUrl ? <a href={sourceUrl} rel="noopener" target="_blank">{sourceTitle}</a> : sourceTitle}
        </span>
      )}
    </figcaption>
  )}
</figure>
