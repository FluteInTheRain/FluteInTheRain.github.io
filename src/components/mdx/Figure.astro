---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata | string; alt: string; caption?: string; width?: number }
const { src, alt, caption, width } = Astro.props;
---
<figure class="figure">
  {typeof src === 'string'
    ? <img src={src} alt={alt} loading="lazy" decoding="async" width={width} />
    : <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 800px) 100vw, 760px" loading="lazy" />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
