---
// A poison-pill message crashes every worker; a dead-letter queue parks it so the queue keeps moving.
import DiagramIcon from './DiagramIcon.astro';
import StreamAFrame from './StreamAFrame.astro';
import { arrow, elbow } from './StreamAHelpers';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    h: 'A poison pill, and where a dead-letter queue sends it',
    q: 'Queue', w: 'Worker', ws: 'crashes on m7', d: 'Dead-letter queue', ds: 'm7 is parked here',
    s1: '1 takes m7', s2: '2 crash, retry, crash, retry ...', s3: '3 after a few retries',
    op: ['Operators inspect', 'it later'],
    no: 'Without a DLQ, the ordered queue stalls for good or burns CPU in a crash loop.',
    yes: 'With a DLQ, m8 and everything behind it keeps flowing.',
    alt: 'A queue holds m6, a bad message m7, and m8. A worker takes m7 and crashes, and the message goes back to the queue to be retried. After a few retries the worker moves m7 to a dead-letter queue, where operators inspect it later, and the main queue keeps flowing.',
    cap: 'One malformed message (here m7, a JSON event missing a required field) should cost a few retries, not the whole queue.',
  },
  vi: {
    h: 'Một poison pill, và dead-letter queue đưa nó đi đâu',
    q: 'Queue', w: 'Worker', ws: 'sập khi gặp m7', d: 'Dead-letter queue', ds: 'm7 được cất riêng ở đây',
    s1: '1 lấy m7', s2: '2 sập, thử lại, lại sập ...', s3: '3 sau vài lần thử lại',
    op: ['Người vận hành', 'kiểm tra sau'],
    no: 'Không có DLQ, queue có thứ tự sẽ kẹt vĩnh viễn hoặc đốt CPU trong vòng lặp sập.',
    yes: 'Có DLQ, m8 và mọi tin nằm sau nó vẫn chạy tiếp.',
    alt: 'Queue chứa m6, một tin lỗi m7 và m8. Worker lấy m7 rồi sập, tin nhắn quay lại queue để thử lại. Sau vài lần thử, worker chuyển m7 sang dead-letter queue để người vận hành kiểm tra sau, còn queue chính vẫn chạy tiếp.',
    cap: 'Một tin nhắn hỏng (ở đây là m7, sự kiện JSON thiếu trường bắt buộc) chỉ nên tốn vài lần thử lại, không phải cả queue.',
  },
}[lang];
const a1 = arrow(220, 112, 360, 112);
const a3 = arrow(530, 112, 680, 112);
const re = elbow([[445, 154], [445, 200], [120, 200], [120, 158]]);
---
<StreamAFrame h={320} alt={T.alt} cap={T.cap} title={T.h}>
  <g class="box"><rect x="20" y="70" width="200" height="84" rx="7" /></g>
  <DiagramIcon name="rabbitmq" x={50} y={98} size={24} />
  <text x="74" y="103" class="name">{T.q}</text>
  {['m6', 'm7', 'm8'].map((m, k) => (
    <g class={m === 'm7' ? 'box off' : 'box'}>
      <rect x={36 + k * 56} y="112" width="44" height="30" rx="4" />
      <text x={58 + k * 56} y="132" text-anchor="middle" class="num">{m}</text>
    </g>
  ))}
  <g class="arr"><path d={a1.line} /><polygon points={a1.head} /></g>
  <text x="290" y="100" text-anchor="middle" class="sub">{T.s1}</text>
  <g class="box off"><rect x="360" y="70" width="170" height="84" rx="7" /></g>
  <DiagramIcon name="worker" x={386} y={98} size={26} />
  <text x="410" y="103" class="name">{T.w}</text>
  <DiagramIcon name="fail" x={380} y={132} size={18} />
  <text x="396" y="137" class="bad">{T.ws}</text>
  <g class="arr bad"><path d={re.line} /><polygon points={re.head} /></g>
  <text x="282" y="222" text-anchor="middle" class="bad">{T.s2}</text>
  <g class="arr good"><path d={a3.line} /><polygon points={a3.head} /></g>
  <text x="605" y="100" text-anchor="middle" class="sub">{T.s3}</text>
  <g class="box good"><rect x="680" y="70" width="200" height="84" rx="7" /></g>
  <DiagramIcon name="folder" x={708} y={98} size={26} />
  <text x="732" y="103" class="name">{T.d}</text>
  <text x="694" y="140" class="sub">{T.ds}</text>
  <DiagramIcon name="user" x={700} y={196} size={26} />
  <text x="724" y="196" class="sub">{T.op[0]}</text>
  <text x="724" y="213" class="sub">{T.op[1]}</text>
  <line x1="20" x2="880" y1="250" y2="250" class="rule" />
  <text x="20" y="278" class="bad">{T.no}</text>
  <text x="20" y="300" class="name">{T.yes}</text>
</StreamAFrame>
