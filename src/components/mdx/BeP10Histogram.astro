---
// Per-bucket request counts for /cases/{case_id}/report, derived from the
// cumulative le= lines in the capture (0, 0, 35, 35, 35, 35, 40 → 0, 0, 35, 0,
// 0, 0, 5). The average printed by the same run, 200 ms, falls in the 0.25 s
// bucket, which holds nothing. That empty bucket is the red part.
const W = 900, H = 330;
const buckets = [
  { le: '0.01', n: 0 }, { le: '0.05', n: 0 }, { le: '0.1', n: 35 }, { le: '0.25', n: 0 },
  { le: '0.5', n: 0 }, { le: '1.0', n: 0 }, { le: '2.5', n: 5 },
];
const x0 = 80, step = 110, base = 262, scale = 5.4;
---
<figure class="bep10c">
  <div class="bep10c-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A bar chart of 40 requests in seven latency buckets. 35 requests fall in the 0.1 second bucket, 5 fall in the 2.5 second bucket, and the buckets between hold none. A red marker for the 200 millisecond average sits in the empty 0.25 second bucket.">
    <text x="40" y="26" class="h"><tspan data-lang-en>40 report requests, counted per bucket</tspan><tspan data-lang-vi>40 request report, đếm theo bucket</tspan></text>
    <line x1="60" y1={base} x2="860" y2={base} class="axis" />
    {buckets.map((b, i) => (
      <g>
        {b.n > 0 && <rect x={x0 + i * step} y={base - b.n * scale} width="70" height={b.n * scale} class="bar" />}
        <text x={x0 + i * step + 35} y={b.n > 0 ? base - b.n * scale - 8 : base - 8} text-anchor="middle" class="cnt"><tspan data-lang-en>{b.n}</tspan><tspan data-lang-vi>{b.n}</tspan></text>
        <text x={x0 + i * step + 35} y={base + 22} text-anchor="middle" class="tick"><tspan data-lang-en>≤ {b.le} s</tspan><tspan data-lang-vi>≤ {b.le} s</tspan></text>
      </g>
    ))}
    <line x1={x0 + 3 * step + 35} y1="60" x2={x0 + 3 * step + 35} y2={base} class="avg" />
    <text x={x0 + 3 * step + 35} y="48" text-anchor="middle" class="avgt"><tspan data-lang-en>average = 200 ms</tspan><tspan data-lang-vi>trung bình = 200 ms</tspan></text>
    <text x={x0 + 3 * step + 35} y="84" text-anchor="middle" class="note"><tspan data-lang-en>no request lives here</tspan><tspan data-lang-vi>không request nào nằm ở đây</tspan></text>
    <text x="40" y="312" class="note"><tspan data-lang-en>bucket counts = differences of the cumulative le= lines in the scrape</tspan><tspan data-lang-vi>số trong bucket = hiệu của các dòng le= cộng dồn trong scrape</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Thirty-five fast requests and five slow ones. The average describes neither group; the buckets show both.</span>
    <span data-lang-vi>Ba mươi lăm request nhanh và năm request chậm. Con số trung bình không mô tả nhóm nào; các bucket thì thấy cả hai.</span>
  </figcaption>
</figure>

<style>
  .bep10c { margin: 2em 0; width: 100%; }
  .bep10c-scroll { overflow-x: auto; }
  .bep10c svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep10c text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep10c .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep10c .bar { fill: var(--text-muted); }
  .bep10c .cnt { font-weight: 700; fill: var(--text); }
  .bep10c .tick { fill: var(--text-muted); font-size: 13px; }
  .bep10c .note { fill: var(--text-muted); font-size: 13px; }
  .bep10c .avg { stroke: var(--red); stroke-width: 2; stroke-dasharray: 5 4; }
  .bep10c .avgt { fill: var(--red); font-weight: 700; }
  .bep10c .axis { stroke: var(--border); stroke-width: 1.4; }
  .bep10c figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
