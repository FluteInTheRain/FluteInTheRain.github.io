---
import DiagramIcon from './DiagramIcon.astro';
// The three relationship types as tiny pictures: one-to-many, many-to-one, many-to-many.
// Arrowheads are polygons: no SVG ids.
const W = 900;
const H = 290;
type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}
const frames: any[] = [];
const boxes: any[] = [];
const links: any[] = [];
const labels: any[] = [];
const nums: any[] = [];
const panels = [
  { icon: 'file', en: 'One-to-many', vi: 'Một-nhiều', se: 'A show has seasons', sv: 'Một phim có nhiều mùa', ve: 'A tree: fits one document', vv: 'Một cái cây: vừa một document', good: true },
  { icon: 'link', en: 'Many-to-one', vi: 'Nhiều-một', se: 'Many posts, one author', sv: 'Nhiều bài, một tác giả', ve: 'Copy the author, or store an id', vv: 'Chép tác giả, hoặc lưu id', good: false },
  { icon: 'users', en: 'Many-to-many', vi: 'Nhiều-nhiều', se: 'People like posts', sv: 'Người thích bài viết', ve: 'Needs ids and joins, or a graph', vv: 'Cần id và join, hoặc graph', good: false },
];
panels.forEach((p, i) => {
  const x = 10 + i * 300;
  frames.push({ x, y: 10, w: 280, h: 270 });
  labels.push({ x: x + 48, y: 40, en: p.en, vi: p.vi, cls: 'h' });
  labels.push({ x: x + 16, y: 64, en: p.se, vi: p.sv, cls: 'muted' });
  labels.push({ x: x + 16, y: 262, en: p.ve, vi: p.vv, cls: p.good ? 'good' : 'strong' });
});
const px = (i: number) => 10 + i * 300;
// one-to-many
boxes.push({ x: px(0) + 90, y: 90, w: 100, h: 34, flat: true, en: ['Show'], vi: ['Phim'] });
[0, 1, 2].forEach((k) => {
  const cx = px(0) + 48 + k * 92;
  boxes.push({ x: cx - 38, y: 190, w: 76, h: 34, flat: true, en: ['Season ' + (k + 1)], vi: ['Mùa ' + (k + 1)] });
  links.push({ pts: [[px(0) + 140, 124], [px(0) + 140, 157], [cx, 157], [cx, 190]] });
});
// many-to-one
[0, 1, 2].forEach((k) => {
  boxes.push({ x: px(1) + 14, y: 94 + k * 50, w: 90, h: 34, flat: true, en: ['Post ' + (k + 1)], vi: ['Bài ' + (k + 1)] });
  links.push({ pts: [[px(1) + 104, 111 + k * 50], [px(1) + 186, 150 + k * 11]] });
});
boxes.push({ x: px(1) + 186, y: 144, w: 80, h: 34, flat: true, en: ['Author'], vi: ['Tác giả'] });
// many-to-many
const who = [['Mai', 'Mai'], ['Tom', 'Tom'], ['Ana', 'Ana']];
[0, 1, 2].forEach((k) => {
  boxes.push({ x: px(2) + 14, y: 94 + k * 50, w: 76, h: 34, flat: true, en: [who[k][0]], vi: [who[k][1]] });
  boxes.push({ x: px(2) + 190, y: 94 + k * 50, w: 76, h: 34, flat: true, en: ['Post ' + (k + 1)], vi: ['Bài ' + (k + 1)] });
});
[[0, 0], [0, 1], [1, 1], [1, 2], [2, 0], [2, 2]].forEach((e) => {
  links.push({ plain: true, pts: [[px(2) + 90, 111 + e[0] * 50], [px(2) + 190, 111 + e[1] * 50]] });
});
---
<figure class="dmrl">
  <div class="dmrl-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three kinds of relationship. One-to-many: a show has seasons, a tree that fits one document. Many-to-one: many posts have one author, so you copy the author or store an id. Many-to-many: people like posts and posts are liked by people, which needs ids and joins or a graph.">
    {frames.map((f) => (
      <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="6" class={`dmrl-frame ${f.kind ?? ''}`} />
    ))}
    {boxes.map((b) => {
      const n = Math.max(b.en.length, b.vi.length);
      const top = !!b.top;
      const cx = b.x + b.w / 2;
      const x0 = top ? cx : b.icon ? b.x + 46 : b.x + 14;
      const y0 = top ? b.y + (b.icon ? 56 : 24) : b.y + b.h / 2 - ((n - 1) * 17) / 2 + 4;
      return (
        <g class={`dmrl-box ${b.kind ?? ''}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
          {b.icon && <DiagramIcon name={b.icon} x={top ? cx : b.x + 24} y={top ? b.y + 24 : b.y + b.h / 2} size={b.is ?? 26} />}
          {Array.from({ length: n }).map((_, i) => (
            <text x={x0} y={y0 + i * 17} text-anchor={top ? 'middle' : 'start'} class={i === 0 && !b.flat ? 'dmrl-name' : 'dmrl-sub'}>
              <tspan data-lang-en>{b.en[i] ?? ''}</tspan>
              <tspan data-lang-vi>{b.vi[i] ?? ''}</tspan>
            </text>
          ))}
        </g>
      );
    })}
    {links.map((l) => {
      const a = arrow(l.pts);
      return (
        <g>
          <polyline points={l.plain ? l.pts.map((p) => p.join(',')).join(' ') : a.line} class={`dmrl-edge ${l.kind ?? ''}`} fill="none" />
          {!l.plain && <polygon points={a.head} class={`dmrl-head ${l.kind ?? ''}`} />}
        </g>
      );
    })}
    {labels.map((t) => (
      <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`dmrl-lab ${t.cls ?? ''}`}>
        <tspan data-lang-en>{t.en}</tspan>
        <tspan data-lang-vi>{t.vi ?? t.en}</tspan>
      </text>
    ))}
    {nums.map((n) => (
      <g class="dmrl-num">
        <circle cx={n.x} cy={n.y} r="11" />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.n}</text>
      </g>
    ))}
    {panels.map((p, i) => <DiagramIcon name={p.icon} x={px(i) + 28} y={34} size={24} />)}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Before choosing a database, name which of these three each link in your data is.</span>
    <span data-lang-vi>Trước khi chọn database, hãy gọi tên xem mỗi mối nối trong dữ liệu của bạn thuộc loại nào trong ba loại này.</span>
  </figcaption>
</figure>

<style>
  .dmrl { margin: 2em 0; width: 100%; }
  .dmrl-scroll { overflow-x: auto; }
  .dmrl svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dmrl text { font-size: 14px; fill: var(--text-body); }
  .dmrl .dmrl-name { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .dmrl .dmrl-sub { font-size: 12px; fill: var(--text-muted); }
  .dmrl .dmrl-lab { font-size: 13px; }
  .dmrl .dmrl-lab.h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dmrl .dmrl-lab.strong { font-weight: 700; fill: var(--text); }
  .dmrl .dmrl-lab.muted { fill: var(--text-muted); }
  .dmrl .dmrl-lab.bad { font-weight: 700; fill: var(--red); }
  .dmrl .dmrl-lab.good { font-weight: 700; fill: var(--text); }
  .dmrl .dmrl-lab.mono, .dmrl .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .dmrl-frame { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .dmrl-frame.bad { stroke: var(--red); }
  .dmrl-frame.good { stroke: var(--gold); }
  .dmrl-box rect { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmrl-box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dmrl-box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmrl-box.plain rect { fill: none; stroke: var(--border); }
  .dmrl-edge { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmrl-edge.bad { stroke: var(--red); }
  .dmrl-edge.good { stroke: var(--gold-icon); }
  .dmrl-head { fill: var(--text-muted); }
  .dmrl-head.bad { fill: var(--red); }
  .dmrl-head.good { fill: var(--gold-icon); }
  .dmrl-num circle { fill: var(--bg-alt); stroke: var(--text-muted); }
  .dmrl-num text { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dmrl figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
