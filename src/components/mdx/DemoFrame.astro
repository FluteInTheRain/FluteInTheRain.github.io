---
// Wrapper that labels an interactive demo so readers know it is live.
import T from '../T.astro';
interface Props { title: string; titleVi?: string }
const { title, titleVi } = Astro.props;
---
<section class="demo-frame">
  <p class="demo-label"><span class="demo-dot"></span><T en="Live demo" vi="Demo trực tiếp" /> &middot; <T en={title} vi={titleVi} /></p>
  <slot />
</section>
