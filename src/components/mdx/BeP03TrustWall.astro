---
// The trust boundary of one endpoint: every request hits the Pydantic model
// first. Bad input bounces back as a 422 before the handler ever runs; the
// handler only meets checked data. The wall is the one red thing you own.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 250;
const f = arrow(95, 118, 295, 118);
const b = arrow(305, 80, 160, 36);
const p = arrow(495, 118, 604, 118);
---
<figure class="bep3a">
  <div class="bep3a-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A request from the caller must pass the CaseCreate model before the handler; invalid input bounces back as a 422 before your code runs, valid input continues as checked values.">
    <path d="M 400 18 L 400 64" class="wl" />
    <path d="M 400 180 L 400 222" class="wl" />
    <g><path d={f.line} class="ln" /><polygon points={f.head} class="hd" /></g>
    <g><path d={b.line} class="lnr" /><polygon points={b.head} class="hdr" /></g>
    <g><path d={p.line} class="ln" /><polygon points={p.head} class="hd" /></g>
    <image href="/icons/flow/envelope.svg" x="185" y="88" width="20" height="20" class="icn" aria-hidden="true" />
    <circle cx="70" cy="118" r="16" class="st" />
    <circle cx="70" cy="118" r="18" class="disc" />
    <image href="/icons/flow/curl.svg" x="55" y="103" width="30" height="30" class="icn" aria-hidden="true" />
    <text x="70" y="158" text-anchor="middle" class="t"><tspan data-lang-en>the caller</tspan><tspan data-lang-vi>client</tspan></text>
    <text x="70" y="176" text-anchor="middle" class="m"><tspan data-lang-en>sends any bytes</tspan><tspan data-lang-vi>gửi byte gì cũng được</tspan></text>
    <text x="195" y="142" text-anchor="middle" class="m"><tspan data-lang-en>still just claims</tspan><tspan data-lang-vi>vẫn chỉ là lời khai</tspan></text>
    <text x="232" y="22" text-anchor="middle" class="rr"><tspan data-lang-en>422 · rejected before your code</tspan><tspan data-lang-vi>422 · chặn trước khi vào code</tspan></text>
    <rect x="305" y="64" width="190" height="116" rx="8" class="boxr" />
    <image href="/icons/flow/detective.svg" x="385" y="76" width="30" height="30" class="icn" aria-hidden="true" />
    <text x="400" y="132" text-anchor="middle" class="tt">CaseCreate</text>
    <text x="400" y="152" text-anchor="middle" class="m"><tspan data-lang-en>checks every field</tspan><tspan data-lang-vi>kiểm từng field</tspan></text>
    <rect x="610" y="64" width="180" height="116" rx="8" class="box" />
    <image href="/icons/flow/python.svg" x="685" y="76" width="30" height="30" class="icn" aria-hidden="true" />
    <text x="700" y="132" text-anchor="middle" class="t"><tspan data-lang-en>your handler</tspan><tspan data-lang-vi>handler của bạn</tspan></text>
    <text x="700" y="152" text-anchor="middle" class="m"><tspan data-lang-en>only meets checked data</tspan><tspan data-lang-vi>chỉ gặp dữ liệu đã kiểm</tspan></text>
    <text x="552" y="144" text-anchor="middle" class="sm"><tspan data-lang-en>checked values</tspan><tspan data-lang-vi>dữ liệu đã kiểm</tspan></text>
    <text x="400" y="240" text-anchor="middle" class="m"><tspan data-lang-en>the trust boundary</tspan><tspan data-lang-vi>ranh giới niềm tin</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Everything from the network stops at the model first — bad input bounces back as a 422 before your code runs; the handler only ever meets checked data.</span>
    <span data-lang-vi>Mọi thứ từ mạng đều dừng ở model trước — input xấu bật lại thành 422 trước khi code bạn chạy; handler chỉ gặp dữ liệu đã qua kiểm tra.</span>
  </figcaption>
</figure>

<style>
  .bep3a { margin: 2em 0; width: 100%; }
  .bep3a-scroll { overflow-x: auto; }
  .bep3a svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep3a text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep3a .t { font-weight: 700; fill: var(--text); }
  .bep3a .tt { font-weight: 700; fill: var(--red); font-size: 15px; }
  .bep3a .m { fill: var(--text-muted); font-size: 12.5px; }
  .bep3a .sm { fill: var(--text-muted); font-size: 12px; }
  .bep3a .rr { font-weight: 700; fill: var(--red); font-size: 13px; }
  .bep3a .st { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; }
  .bep3a .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep3a .boxr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bep3a .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep3a .hd { fill: var(--text-muted); }
  .bep3a .lnr { stroke: var(--red); stroke-width: 1.5; fill: none; }
  .bep3a .hdr { fill: var(--red); }
  .bep3a .wl { stroke: var(--text-muted); stroke-width: 1.2; fill: none; }
  .bep3a .disc { fill: none; }
  .bep3a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  :global([data-theme='dark']) .bep3a .disc { fill: rgba(255, 255, 255, 0.88); }
</style>
