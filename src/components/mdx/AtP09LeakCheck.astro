---
// Permutation importance (drop in test R-squared when one column is shuffled), same simulated data, two models.
// Python run (numpy default_rng(42), n=3000, GradientBoostingRegressor, test = last 1000 rows):
// clean:     R2 0.0248, mom12 0.0634, value 0.0229, vol 0.0181, size -0.0057
// with leak: R2 0.5888, mom12 0.0152, value 0.0048, vol 0.0035, size -0.0039, leak 1.1046
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 400;
const clean = [
  { k: 'mom', en: '12-month momentum', vi: 'Momentum 12 tháng', v: 0.0634 },
  { k: 'val', en: 'value', vi: 'value', v: 0.0229 },
  { k: 'vol', en: 'volatility', vi: 'biến động', v: 0.0181 },
  { k: 'size', en: 'size', vi: 'quy mô', v: -0.0057 },
];
const leak = [
  { en: '12-month momentum', vi: 'Momentum 12 tháng', v: 0.0152 },
  { en: 'value', vi: 'value', v: 0.0048 },
  { en: 'volatility', vi: 'biến động', v: 0.0035 },
  { en: 'size', vi: 'quy mô', v: -0.0039 },
  { en: 'next-week price (leak)', vi: 'giá tuần sau (rò rỉ)', v: 1.1046, key: true },
];
const X0 = 230, S = 480;
const L = (v: number) => Math.max(1, v * S);
const LX = (v: number) => X0 + Math.max(0, v) * S + 8;
const f = (n: number) => (n < 0 ? '-' : '') + Math.abs(n).toFixed(4);
const fv = (n: number) => f(n).replace('.', ',');
---
<figure class="atp09-lk">
  <div class="atp09-lk-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Permutation importance on simulated data. Without a leaked column the test R-squared is 0.0248 and 12-month momentum leads with a drop of 0.0634. With a leaked column the R-squared jumps to 0.5888 and the leaked column accounts for a drop of 1.1046, while every honest feature falls below 0.016.">
      <text x="20" y="26" class="h">
        <tspan data-lang-en>The importance chart that gave the leak away</tspan>
        <tspan data-lang-vi>Biểu đồ importance làm lộ ra chỗ rò rỉ</tspan>
      </text>
      <text x="20" y="46" class="sub">
        <tspan data-lang-en>Simulated: 3,000 stock-months, 1,000 held out. Bar = how much test R² drops when that column is shuffled.</tspan>
        <tspan data-lang-vi>Mô phỏng: 3.000 mã-tháng, giữ lại 1.000 để kiểm tra. Thanh = R² kiểm tra tụt bao nhiêu khi xáo trộn cột đó.</tspan>
      </text>

      <rect x="20" y="60" width="860" height="124" rx="8" class="card" />
      <DiagramIcon name="ok" x={44} y={84} size={22} />
      <text x="70" y="90" class="t">
        <tspan data-lang-en>Honest features only. Test R² 0.0248</tspan>
        <tspan data-lang-vi>Chỉ feature trung thực. R² kiểm tra 0,0248</tspan>
      </text>
      {clean.map((r, i) => (
        <g>
          <text x="40" y={116 + i * 20} class="lab">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          <rect x={X0} y={104 + i * 20} width={L(r.v)} height="12" class="bar" />
          <text x={LX(r.v)} y={115 + i * 20} class="val">
            <tspan data-lang-en>{f(r.v)}</tspan>
            <tspan data-lang-vi>{fv(r.v)}</tspan>
          </text>
        </g>
      ))}

      <rect x="20" y="196" width="860" height="156" rx="8" class="card is-key" />
      <DiagramIcon name="warning" x={44} y={220} size={22} />
      <text x="70" y="226" class="t">
        <tspan data-lang-en>One column added. Test R² 0.5888, about 24 times higher</tspan>
        <tspan data-lang-vi>Thêm một cột. R² kiểm tra 0,5888, gấp khoảng 24 lần</tspan>
      </text>
      {leak.map((r, i) => (
        <g>
          <text x="40" y={252 + i * 20} class={r.key ? 'lab is-key' : 'lab'}>
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          <rect x={X0} y={240 + i * 20} width={L(r.v)} height="12" class={r.key ? 'bar is-key' : 'bar'} />
          <text x={LX(r.v)} y={251 + i * 20} class={r.key ? 'val is-key' : 'val'}>
            <tspan data-lang-en>{f(r.v)}</tspan>
            <tspan data-lang-vi>{fv(r.v)}</tspan>
          </text>
        </g>
      ))}

      <text x="20" y="384" class="n">
        <tspan data-lang-en>The leaked column is a price that is only known after the prediction date. A score that good is a reason to open the importance chart before celebrating.</tspan>
        <tspan data-lang-vi>Cột rò rỉ là một mức giá chỉ biết được sau ngày dự đoán. Điểm cao tới vậy là lý do để mở biểu đồ importance ra xem trước khi ăn mừng.</tspan>
      </text>
    </svg>
  </div>
</figure>

<style>
  .atp09-lk { margin: 2em 0; width: 100%; }
  .atp09-lk-scroll { overflow-x: auto; }
  .atp09-lk svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .atp09-lk text { fill: var(--text-body); font-size: 13.5px; }
  .atp09-lk .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp09-lk .sub { font-size: 12.5px; fill: var(--text-muted); }
  .atp09-lk .t { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .atp09-lk .lab { fill: var(--text); }
  .atp09-lk .lab.is-key { font-weight: 700; fill: var(--red); }
  .atp09-lk .val { font-size: 12.5px; font-weight: 700; fill: var(--text-muted); }
  .atp09-lk .val.is-key { fill: var(--red); }
  .atp09-lk .n { font-size: 13px; fill: var(--text-muted); }
  .atp09-lk .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .atp09-lk .card.is-key { stroke: var(--red); stroke-width: 1.8; }
  .atp09-lk .bar { fill: var(--act-2); }
  .atp09-lk .bar.is-key { fill: var(--red); }
</style>
