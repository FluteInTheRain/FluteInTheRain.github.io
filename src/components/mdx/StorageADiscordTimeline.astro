---
// Discord's message cluster in three stops, using only numbers quoted in the post:
// 2017 tombstones, early 2022 compaction behind, after May 2022 ScyllaDB.
// Plain inline SVG, site tokens, no ids.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 396;
const EN = { 'data-lang-en': '' };
const VI = { 'data-lang-vi': '' };
type Item = { tone: 'bad' | 'good' | 'muted'; en: string[]; vi: string[] };
const cols: { x: number; icon: 'cassandra' | 'db'; headEn: string; headVi: string; items: Item[] }[] = [
  {
    x: 20, icon: 'cassandra', headEn: '2017: tombstones pile up', headVi: '2017: tombstone chất đống',
    items: [
      { tone: 'muted', en: ['Null columns became tombstones:', '12 per message write, most times'], vi: ['Cột null thành tombstone: 12', 'cái mỗi lần ghi, phần lớn thời gian'] },
      { tone: 'bad', en: ['Millions of messages deleted:', 'one channel took 20 s to load'], vi: ['Xoá hàng triệu tin nhắn: một', 'kênh mất 20 giây để tải'] },
      { tone: 'good', en: ['Fix: tombstone lifetime cut', 'from 10 days to 2'], vi: ['Cách sửa: rút thời gian sống của', 'tombstone từ 10 ngày xuống 2'] },
    ],
  },
  {
    x: 320, icon: 'cassandra', headEn: 'Early 2022: compaction behind', headVi: 'Đầu 2022: compaction tụt lại',
    items: [
      { tone: 'muted', en: ['177 nodes, trillions of', 'messages'], vi: ['177 node, hàng nghìn tỉ', 'tin nhắn'] },
      { tone: 'bad', en: ['Compactions kept falling behind', ''], vi: ['Compaction liên tục tụt lại', ''] },
      { tone: 'muted', en: ['Workaround, the gossip dance:', 'take a node out, let it compact,', 'bring it back, repeat'], vi: ['Cách chữa cháy, gossip dance:', 'rút node ra cho compact, đưa', 'vào lại, lặp lại'] },
      { tone: 'bad', en: ['In the migration, last token', 'ranges timed out: tombstones', 'never compacted away'], vi: ['Lúc migrate, dải token cuối bị', 'timeout: tombstone chưa bao giờ', 'được compact đi'] },
    ],
  },
  {
    x: 620, icon: 'db', headEn: 'After May 2022: ScyllaDB', headVi: 'Sau tháng 5/2022: ScyllaDB',
    items: [
      { tone: 'good', en: ['72 nodes, 9 TB each', '(was 177 nodes, about 4 TB)'], vi: ['72 node, mỗi node 9 TB', '(trước: 177 node, khoảng 4 TB)'] },
      { tone: 'good', en: ['p99 reading old messages:', '15 ms (was 40 to 125 ms)'], vi: ['p99 đọc tin cũ: 15 ms', '(trước: 40 tới 125 ms)'] },
      { tone: 'good', en: ['p99 inserting a message:', '5 ms (was 5 to 70 ms)'], vi: ['p99 ghi một tin: 5 ms', '(trước: 5 tới 70 ms)'] },
      { tone: 'muted', en: ['Also changed: C++ with no GC,', 'and Rust services in front'], vi: ['Cũng đổi: C++ không có GC,', 'và các service Rust phía trước'] },
    ],
  },
];
const cw = 260;
const lh = 16;
const cardY = 150;
// y offset of each item inside a column, from the card top
function layout(items: Item[]) {
  let y = 58;
  return items.map((it) => {
    const at = y;
    y += it.en.filter((l) => l).length * lh + 14;
    return at;
  });
}
---
<figure class="dtl">
  <div class="dtl-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Discord's message cluster in three stops. 2017: null columns produced 12 tombstones per write, one channel with millions of deleted messages took 20 seconds to load, and the fix was cutting tombstone lifetime from 10 days to 2. Early 2022: 177 Cassandra nodes holding trillions of messages kept falling behind on compaction, handled by a manual gossip dance, and the last token ranges timed out during migration because of tombstones never compacted away. After May 2022: ScyllaDB with 72 nodes of 9 TB each, p99 read of old messages 15 ms and p99 insert 5 ms.">
    <text x="20" y="24" class="dtl-h">
      <tspan data-lang-en>Discord's message cluster, three stops</tspan>
      <tspan data-lang-vi>Cụm tin nhắn của Discord, ba chặng</tspan>
    </text>
    <text x="20" y="46" class="dtl-sub">
      <tspan data-lang-en>Deletes are writes, so old data keeps costing until compaction catches up.</tspan>
      <tspan data-lang-vi>Xoá là ghi, nên dữ liệu cũ vẫn tốn kém cho tới khi compaction đuổi kịp.</tspan>
    </text>

    <line x1="20" x2="880" y1="114" y2="114" class="dtl-axis" />
    {cols.map((c) => {
      const pos = layout(c.items);
      return (
        <g>
          <DiagramIcon name={c.icon} x={c.x + 30} y={80} size={30} />
          <circle cx={c.x + 30} cy="114" r="6" class="dtl-dot" />
          <text x={c.x + 62} y="86" class="dtl-in-b">
            <tspan data-lang-en>{c.headEn}</tspan>
            <tspan data-lang-vi>{c.headVi}</tspan>
          </text>
          <rect x={c.x} y={cardY - 18} width={cw} height="236" rx="6" class="dtl-card" />
          {c.items.map((it, i) => (
            <g>
              <rect x={c.x + 12} y={cardY + pos[i] - 50 - 0} width="3" height={it.en.filter((l) => l).length * lh - 2} class={`dtl-bar is-${it.tone}`} />
              <g {...EN}>{it.en.filter((l) => l).map((t, k) => <text x={c.x + 24} y={cardY + pos[i] - 38 + k * lh} class={`dtl-t is-${it.tone}`}>{t}</text>)}</g>
              <g {...VI}>{it.vi.filter((l) => l).map((t, k) => <text x={c.x + 24} y={cardY + pos[i] - 38 + k * lh} class={`dtl-t is-${it.tone}`}>{t}</text>)}</g>
            </g>
          ))}
        </g>
      );
    })}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>From Discord's 2017 and 2022 engineering posts. Red marks what went wrong, gold what improved. ScyllaDB is also an LSM engine, so the numbers mix engine, language and new Rust services, not LSM design alone.</span>
    <span data-lang-vi>Lấy từ các bài kỹ thuật của Discord năm 2017 và 2022. Màu đỏ là chỗ hỏng, màu vàng là chỗ tốt lên. ScyllaDB cũng là engine LSM, nên các con số là kết quả của cả engine, ngôn ngữ và các service Rust mới, chứ không riêng thiết kế LSM.</span>
  </figcaption>
</figure>

<style>
  .dtl { margin: 2em 0; width: 100%; }
  .dtl-scroll { overflow-x: auto; }
  .dtl svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dtl text { font-size: 14px; fill: var(--text-body); }
  .dtl .dtl-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dtl .dtl-sub { fill: var(--text-muted); }
  .dtl-rule { stroke: var(--border); }
  .dtl-divider { stroke: var(--border); stroke-dasharray: 6 5; }
  .dtl-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .dtl-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .dtl-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .dtl-cell { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .dtl-cell.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .dtl-cell.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .dtl-cell.is-dead { fill: var(--bg-alt); stroke: var(--text-muted); stroke-dasharray: 3 3; }
  .dtl .dtl-in { font-weight: 600; fill: var(--text); }
  .dtl .dtl-in-b { font-weight: 700; fill: var(--text); }
  .dtl .dtl-in-m { font-size: 13px; fill: var(--text-body); }
  .dtl .dtl-in-s { font-size: 13px; font-weight: 600; fill: var(--text); }
  .dtl .dtl-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; fill: var(--text-body); }
  .dtl .dtl-mono.is-good { fill: var(--gold-icon); font-weight: 700; }
  .dtl .dtl-mono.is-bad { fill: var(--red); font-weight: 700; }
  .dtl .dtl-note { font-size: 13px; fill: var(--text-muted); }
  .dtl .dtl-note.is-good { fill: var(--gold-icon); font-weight: 700; }
  .dtl .dtl-note.is-bad { fill: var(--red); font-weight: 700; }
  .dtl .dtl-small { font-size: 12px; fill: var(--text-muted); }
  .dtl .dtl-num { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dtl-circle { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .dtl-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .dtl-arrow.is-good { stroke: var(--gold-icon); stroke-width: 1.8; }
  .dtl-arrow.is-bad { stroke: var(--red); stroke-width: 1.8; }
  .dtl-head { fill: var(--text-muted); }
  .dtl-head.is-good { fill: var(--gold-icon); }
  .dtl-head.is-bad { fill: var(--red); }
  .dtl figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
<style>
  .dtl-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .dtl-axis { stroke: var(--text-muted); stroke-width: 1.4; }
  .dtl-dot { fill: var(--text-muted); }
  .dtl .dtl-t { font-size: 13px; fill: var(--text-body); }
  .dtl .dtl-t.is-bad { fill: var(--red); font-weight: 600; }
  .dtl .dtl-t.is-good { fill: var(--gold-icon); font-weight: 600; }
  .dtl-bar { fill: var(--border); }
  .dtl-bar.is-bad { fill: var(--red); }
  .dtl-bar.is-good { fill: var(--gold-icon); }
</style>
