---
// Two ways an LSM engine can pick files to merge, side by side. File sizes and key ranges
// are illustrative; the trade-offs are the ones in the post's table.
// Plain inline SVG, site tokens, polygon arrowheads, no ids.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 372;
const EN = { 'data-lang-en': '' };
const VI = { 'data-lang-vi': '' };
function arrowDown(x: number, y1: number, y2: number) {
  return { line: `M${x},${y1} L${x},${y2 - 7}`, head: `${x - 5},${y2 - 8} ${x + 5},${y2 - 8} ${x},${y2}` };
}
const lx = 20;   // left panel x
const rx = 470;  // right panel x
const pw = 410;
const a1 = arrowDown(lx + 205, 156, 196);
const a2 = arrowDown(rx + 205, 156, 196);
const tiered = [
  { en: ['Good for: mostly writes, few reads', 'Disk: more, especially during a big merge', 'Reads: check more files'], vi: ['Hợp với: chủ yếu ghi, ít đọc', 'Đĩa: tốn hơn, nhất là lúc trộn file lớn', 'Đọc: phải xem nhiều file hơn'] },
];
const leveled = [
  { en: ['Good for: reads dominate', 'Disk: less', 'Reads: check fewer files'], vi: ['Hợp với: đọc là chính', 'Đĩa: ít hơn', 'Đọc: xem ít file hơn'] },
];
const ranges = ['a–f', 'g–m', 'n–s', 't–z'];
---
<figure class="cmp">
  <div class="cmp-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two compaction strategies. Size-tiered: four similar-sized SSTables are merged into one bigger file. It suits mostly writes, uses more disk space during a big merge, and reads check more files. Leveled: files from level 0 are merged down into fixed-size files in level 1, each covering its own key range, a to f, g to m, n to s and t to z. It suits read-heavy workloads, uses less disk, and reads check fewer files.">
    <text x={lx} y="24" class="cmp-h">
      <tspan data-lang-en>Size-tiered: group files of similar size</tspan>
      <tspan data-lang-vi>Size-tiered: gom file cỡ gần nhau</tspan>
    </text>
    <text x={rx} y="24" class="cmp-h">
      <tspan data-lang-en>Leveled: fixed-size files in levels</tspan>
      <tspan data-lang-vi>Leveled: file cỡ cố định xếp theo tầng</tspan>
    </text>
    <line x1="445" x2="445" y1="10" y2="350" class="cmp-divider" />

    {/* size-tiered */}
    <DiagramIcon name="disk" x={lx + 16} y="70" size={24} />
    <text x={lx + 40} y="75" class="cmp-in-s">
      <tspan data-lang-en>SSTables of about the same size</tspan>
      <tspan data-lang-vi>Các SSTable cỡ gần bằng nhau</tspan>
    </text>
    {[0, 1, 2, 3].map((i) => (
      <rect x={lx + 8 + i * 98} y="100" width="88" height="40" rx="3" class="cmp-cell" />
    ))}
    <path d={a1.line} class="cmp-arrow" /><polygon points={a1.head} class="cmp-head" />
    <text x={lx + 216} y="180" class="cmp-note">
      <tspan data-lang-en>merge into one</tspan>
      <tspan data-lang-vi>trộn thành một</tspan>
    </text>
    <rect x={lx + 8} y="200" width="394" height="40" rx="3" class="cmp-cell is-good" />
    <text x={lx + 205} y="225" text-anchor="middle" class="cmp-in-s">
      <tspan data-lang-en>one bigger file</tspan>
      <tspan data-lang-vi>một file lớn hơn</tspan>
    </text>
    <g {...EN}>{tiered[0].en.map((t, i) => <text x={lx + 8} y={278 + i * 22} class="cmp-in-m">{t}</text>)}</g>
    <g {...VI}>{tiered[0].vi.map((t, i) => <text x={lx + 8} y={278 + i * 22} class="cmp-in-m">{t}</text>)}</g>

    {/* leveled */}
    <DiagramIcon name="disk" x={rx + 16} y="70" size={24} />
    <text x={rx + 40} y="75" class="cmp-in-s">
      <tspan data-lang-en>Level 0: files that overlap</tspan>
      <tspan data-lang-vi>Tầng 0: các file chồng dải khoá</tspan>
    </text>
    {[0, 1].map((i) => (
      <g>
        <rect x={rx + 8 + i * 98} y="100" width="88" height="40" rx="3" class="cmp-cell" />
        <text x={rx + 8 + i * 98 + 44} y="125" text-anchor="middle" class="cmp-mono">a–z</text>
      </g>
    ))}
    <path d={a2.line} class="cmp-arrow" /><polygon points={a2.head} class="cmp-head" />
    <text x={rx + 216} y="180" class="cmp-note">
      <tspan data-lang-en>merged down into level 1</tspan>
      <tspan data-lang-vi>trộn xuống tầng 1</tspan>
    </text>
    {ranges.map((r, i) => (
      <g>
        <rect x={rx + 8 + i * 98} y="200" width="88" height="40" rx="3" class="cmp-cell is-good" />
        <text x={rx + 8 + i * 98 + 44} y="225" text-anchor="middle" class="cmp-mono is-good">{r}</text>
      </g>
    ))}
    <g {...EN}>{leveled[0].en.map((t, i) => <text x={rx + 8} y={278 + i * 22} class="cmp-in-m">{t}</text>)}</g>
    <g {...VI}>{leveled[0].vi.map((t, i) => <text x={rx + 8} y={278 + i * 22} class="cmp-in-m">{t}</text>)}</g>
    <text x={rx + 8} y="344" class="cmp-note">
      <tspan data-lang-en>Level 1: each file owns one key range, no overlap</tspan>
      <tspan data-lang-vi>Tầng 1: mỗi file giữ một dải khoá, không chồng</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The two compaction strategies as shapes. The trade-offs are the ones in the table above.</span>
    <span data-lang-vi>Hai chiến lược compaction dưới dạng hình dạng. Các đánh đổi là những gì trong bảng ở trên.</span>
  </figcaption>
</figure>

<style>
  .cmp { margin: 2em 0; width: 100%; }
  .cmp-scroll { overflow-x: auto; }
  .cmp svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .cmp text { font-size: 14px; fill: var(--text-body); }
  .cmp .cmp-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .cmp .cmp-sub { fill: var(--text-muted); }
  .cmp-rule { stroke: var(--border); }
  .cmp-divider { stroke: var(--border); stroke-dasharray: 6 5; }
  .cmp-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .cmp-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .cmp-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .cmp-cell { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .cmp-cell.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .cmp-cell.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .cmp-cell.is-dead { fill: var(--bg-alt); stroke: var(--text-muted); stroke-dasharray: 3 3; }
  .cmp .cmp-in { font-weight: 600; fill: var(--text); }
  .cmp .cmp-in-b { font-weight: 700; fill: var(--text); }
  .cmp .cmp-in-m { font-size: 13px; fill: var(--text-body); }
  .cmp .cmp-in-s { font-size: 13px; font-weight: 600; fill: var(--text); }
  .cmp .cmp-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; fill: var(--text-body); }
  .cmp .cmp-mono.is-good { fill: var(--gold-icon); font-weight: 700; }
  .cmp .cmp-mono.is-bad { fill: var(--red); font-weight: 700; }
  .cmp .cmp-note { font-size: 13px; fill: var(--text-muted); }
  .cmp .cmp-note.is-good { fill: var(--gold-icon); font-weight: 700; }
  .cmp .cmp-note.is-bad { fill: var(--red); font-weight: 700; }
  .cmp .cmp-small { font-size: 12px; fill: var(--text-muted); }
  .cmp .cmp-num { font-size: 12px; font-weight: 700; fill: var(--text); }
  .cmp-circle { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .cmp-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .cmp-arrow.is-good { stroke: var(--gold-icon); stroke-width: 1.8; }
  .cmp-arrow.is-bad { stroke: var(--red); stroke-width: 1.8; }
  .cmp-head { fill: var(--text-muted); }
  .cmp-head.is-good { fill: var(--gold-icon); }
  .cmp-head.is-bad { fill: var(--red); }
  .cmp figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
