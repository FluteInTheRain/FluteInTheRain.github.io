---
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 290;
---
<figure class="gp1d">
  <div class="gp1d-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="package main can call greet.Hello, whose name starts with a capital letter. A call to greet.defaultName is rejected because the name starts with a lowercase letter.">
    <rect x="20" y="50" width="250" height="180" rx="8" class="grp" />
    <text x="36" y="76" class="h">package main</text>
    <text x="36" y="112">greet.Hello(name)</text>
    <text x="36" y="188">greet.defaultName</text>
    <rect x="560" y="50" width="320" height="180" rx="8" class="grp" />
    <text x="576" y="76" class="h">package greet</text>
    <rect x="580" y="88" width="280" height="58" rx="6" class="box" />
    <text x="596" y="110" class="t">func Hello</text>
    <text x="596" y="132" class="m"><tspan data-lang-en>capital H: exported</tspan><tspan data-lang-vi>H hoa: được xuất ra</tspan></text>
    <rect x="580" y="158" width="280" height="58" rx="6" class="bad" />
    <text x="596" y="180" class="t">const defaultName</text>
    <text x="596" y="202" class="r"><tspan data-lang-en>lowercase d: private</tspan><tspan data-lang-vi>d thường: riêng tư</tspan></text>
    {(() => { const a = arrow(200, 108, 576, 112); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
    <text x="300" y="100" class="m"><tspan data-lang-en>compiles</tspan><tspan data-lang-vi>biên dịch được</tspan></text>
    <path d="M 200 184 L 520 188" class="lnr" />
    <line x1="522" x2="522" y1="168" y2="208" stroke="var(--red)" stroke-width="3" />
    <text x="232" y="216" class="r">undefined: greet.defaultName</text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The first letter decides. From outside the package, a lowercase name does not exist, so the compiler reports it as undefined.</span>
    <span data-lang-vi>Chữ cái đầu quyết định. Nhìn từ ngoài package, tên viết thường coi như không tồn tại, nên compiler báo undefined.</span>
  </figcaption>
</figure>

<style>
  .gp1d { margin: 2em 0; width: 100%; }
  .gp1d-scroll { overflow-x: auto; }
  .gp1d svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp1d text { font-size: 14px; fill: var(--text-body); }
  .gp1d .t { font-weight: 700; fill: var(--text); }
  .gp1d .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp1d .m { fill: var(--text-muted); }
  .gp1d .r { fill: var(--red); font-weight: 700; }
  .gp1d .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp1d .grp { fill: none; stroke: var(--border); stroke-width: 1.5; }
  .gp1d .bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp1d .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp1d .lnd { stroke: var(--text-muted); stroke-width: 1.5; fill: none; stroke-dasharray: 4 4; }
  .gp1d .lnr { stroke: var(--red); stroke-width: 1.5; fill: none; stroke-dasharray: 5 4; }
  .gp1d .hd { fill: var(--text-muted); }
  .gp1d .hdr { fill: var(--red); }
  .gp1d .axis { stroke: var(--border); stroke-width: 1.5; }
  .gp1d figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
