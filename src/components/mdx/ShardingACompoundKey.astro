---
// Compound key (partition key, sort key): hash the first part to pick a shard, sort by the
// second part inside it. Modelled on Discord's PRIMARY KEY ((channel_id, bucket), message_id).
// Ids are illustrative. Inline SVG, site tokens.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const A = (x1: number, y1: number, x2: number, y2: number, c = '') => {
  const a = arrow(x1, y1, x2, y2);
  return { ...a, c };
};

const W = 900;
const H = 350;
const shards = [
  { x: 20, name: 'Shard 1', part: 'channel_id 7, bucket 3', ids: ['101', '103', '105'] },
  { x: 460, name: 'Shard 2', part: 'channel_id 9, bucket 1', ids: ['38', '40', '44'] },
];
const down = [A(300, 100, 230, 158, 'is-fix'), A(300, 100, 670, 158, 'is-fix')];
---
<figure class="shaa-ck">
  <div class="shaa-ck-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A compound key in two parts. The partition key, channel_id plus bucket, is hashed to pick one shard. The sort key, message_id, keeps rows in order inside that shard. Example: channel 7 bucket 3 lives on shard 1 with messages 101, 103, 105 in order; channel 9 bucket 1 lives on shard 2 with messages 38, 40, 44.">
      <text x="20" y="30" class="b">PRIMARY KEY ((channel_id, bucket), message_id)</text>

      <rect x="100" y="46" width="400" height="54" rx="6" class="box is-fix" />
      <text x="300" y="70" text-anchor="middle" class="b">(channel_id, bucket)</text>
      <text x="300" y="89" text-anchor="middle" class="s"><tspan data-lang-en>partition key: hashed, picks the shard</tspan><tspan data-lang-vi>partition key: đem băm, chọn shard</tspan></text>
      <rect x="560" y="46" width="320" height="54" rx="6" class="box" />
      <text x="720" y="70" text-anchor="middle" class="b">message_id</text>
      <text x="720" y="89" text-anchor="middle" class="s"><tspan data-lang-en>sort key: orders rows inside the shard</tspan><tspan data-lang-vi>sort key: sắp thứ tự trong shard</tspan></text>
      {down.map((a) => (<g><path d={a.line} class="arrow is-fix" /><polygon points={a.head} class="head is-fix" /></g>))}

      {shards.map((s) => (
        <g>
          <rect x={s.x} y="160" width="420" height="150" rx="6" class="box" />
          <DiagramIcon name="db" x={s.x + 28} y={190} size={26} />
          <text x={s.x + 58} y="187" class="b">{s.name}</text>
          <text x={s.x + 58} y="205" class="s">{s.part}</text>
          <line x1={s.x + 12} x2={s.x + 408} y1="222" y2="222" class="rule" />
          {s.ids.map((id, j) => (
            <g>
              <rect x={s.x + 20 + j * 124} y="236" width="110" height="34" rx="5" class="box is-active" />
              <text x={s.x + 75 + j * 124} y="258" text-anchor="middle" class="b">{`message_id ${id}`}</text>
            </g>
          ))}
          <text x={s.x + 20} y="296" class="s"><tspan data-lang-en>stored in order: one sequential read for the channel</tspan><tspan data-lang-vi>lưu theo thứ tự: đọc một lèo cả kênh</tspan></text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Hash the first part to spread channels across machines; sort by the second part to keep one channel's history in order. The key shape is Discord's.</span>
    <span data-lang-vi>Băm phần đầu để rải các kênh ra nhiều máy; sắp theo phần sau để lịch sử một kênh luôn có thứ tự. Dạng khoá là của Discord.</span>
  </figcaption>
</figure>

<style>
  .shaa-ck { margin: 2em 0; width: 100%; }
  .shaa-ck-scroll { overflow-x: auto; }
  .shaa-ck svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shaa-ck text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shaa-ck .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shaa-ck .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shaa-ck .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shaa-ck .b.is-hot { fill: var(--red); }
  .shaa-ck .s { font-size: 12px; fill: var(--text-body); }
  .shaa-ck .s.is-hot { fill: var(--red); font-weight: 600; }
  .shaa-ck .big { font-size: 18px; font-weight: 700; fill: var(--text); }
  .shaa-ck .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shaa-ck .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shaa-ck .box.is-fix { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-ck .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shaa-ck .box.is-dim { opacity: 0.45; }
  .shaa-ck .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shaa-ck .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shaa-ck .arrow.is-hot { stroke: var(--red); }
  .shaa-ck .arrow.is-fix { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-ck .head { fill: var(--text-muted); }
  .shaa-ck .head.is-hot { fill: var(--red); }
  .shaa-ck .head.is-fix { fill: var(--gold-icon); }
  .shaa-ck figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
