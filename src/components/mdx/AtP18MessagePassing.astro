---
// One graph layer = every stock replaces its number with the average over itself and its neighbours.
// Toy data, stated in the post: 8 stocks, made-up 1-day returns, edges as in the demo.
// Numbers match calc.py (D^-1 (A+I) x): HPG 3.0 -> 2.0, HSG 2.4 -> 2.733, ...
const names = ['HPG', 'HSG', 'NKG', 'VCB', 'BID', 'CTG', 'FPT', 'MWG'];
const x0 = [3.0, 2.4, 2.8, -0.4, -0.2, 0.1, 1.2, -1.5];
const edges: [number, number][] = [[0, 1], [0, 2], [1, 2], [3, 4], [3, 5], [4, 5], [6, 7], [0, 4], [6, 3]];
const n = names.length;
const nb: number[][] = names.map((_, i) => [i]);
edges.forEach(([a, b]) => { nb[a].push(b); nb[b].push(a); });
const x1 = nb.map((l) => l.reduce((s, j) => s + x0[j], 0) / l.length);
const W = 900;
const H = 372;
const SC = 40; // px per 1.0 of return
const ZERO = 722;
const fmt = (v: number) => v.toFixed(2);
---
<figure class="atp18-mp">
  <div class="atp18-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="One graph layer on a toy set of eight stocks. HPG has three neighbours, HSG at 2.4, NKG at 2.8 and BID at minus 0.2, and itself at 3.0. Averaging the four numbers gives 2.0. On the right, the eight stocks before and after the layer: HPG falls from 3.0 to 2.0 and the top stock changes from HPG to HSG and NKG, both at 2.73.">
      <text x="20" y="24" class="h">
        <tspan data-lang-en>One layer: each stock takes the average of its neighbourhood</tspan>
        <tspan data-lang-vi>Một lớp: mỗi mã lấy trung bình của vùng lân cận</tspan>
      </text>
      <rect x="20" y="42" width="386" height="300" rx="8" class="panel" />
      <line x1="90" y1="104" x2="178" y2="170" class="edge fm-flow" />
      <line x1="90" y1="256" x2="178" y2="196" class="edge fm-flow" />
      <line x1="332" y1="180" x2="238" y2="180" class="edge fm-flow" />
      <polygon points="178,170 166,168 172,158" class="arrow" />
      <polygon points="178,196 168,201 166,190" class="arrow" />
      <polygon points="238,180 250,174 250,186" class="arrow" />
      <g>
        <circle cx="70" cy="90" r="24" class="node" />
        <text x="70" y="86" text-anchor="middle" class="nl">HSG</text>
        <text x="70" y="101" text-anchor="middle" class="nv">2.4</text>
        <circle cx="70" cy="270" r="24" class="node" />
        <text x="70" y="266" text-anchor="middle" class="nl">NKG</text>
        <text x="70" y="281" text-anchor="middle" class="nv">2.8</text>
        <circle cx="356" cy="180" r="24" class="node" />
        <text x="356" y="176" text-anchor="middle" class="nl">BID</text>
        <text x="356" y="191" text-anchor="middle" class="nv">−0.2</text>
        <circle cx="208" cy="183" r="32" class="node hot" />
        <text x="208" y="178" text-anchor="middle" class="nl">HPG</text>
        <text x="208" y="195" text-anchor="middle" class="nv">3.0</text>
      </g>
      <text x="36" y="312" class="sm">
        <tspan data-lang-en>(3.0 + 2.4 + 2.8 − 0.2) ÷ 4 = 2.0</tspan>
        <tspan data-lang-vi>(3,0 + 2,4 + 2,8 − 0,2) ÷ 4 = 2,0</tspan>
      </text>
      <text x="36" y="330" class="sm muted">
        <tspan data-lang-en>HPG counts itself, so it is one of the four numbers.</tspan>
        <tspan data-lang-vi>HPG tính cả chính nó, nên là một trong bốn số.</tspan>
      </text>

      <rect x="430" y="42" width="450" height="300" rx="8" class="panel" />
      <text x="446" y="66" class="t">
        <tspan data-lang-en>All eight stocks, before and after one layer</tspan>
        <tspan data-lang-vi>Cả tám mã, trước và sau một lớp</tspan>
      </text>
      <line x1={ZERO} x2={ZERO} y1="78" y2="316" class="zero" />
      {names.map((nm, i) => (
        <g>
          <text x="446" y={106 + i * 29} class="lab">{nm}</text>
          <rect x={x0[i] >= 0 ? ZERO : ZERO + x0[i] * SC} y={92 + i * 29} width={Math.abs(x0[i]) * SC} height="9" rx="2" class="b0" />
          <rect x={x1[i] >= 0 ? ZERO : ZERO + x1[i] * SC} y={102 + i * 29} width={Math.abs(x1[i]) * SC} height="9" rx="2" class="b1" />
          <text x="494" y={106 + i * 29} class="num">
            <tspan data-lang-en>{fmt(x0[i])} → {fmt(x1[i])}</tspan>
            <tspan data-lang-vi>{fmt(x0[i]).replace('.', ',')} → {fmt(x1[i]).replace('.', ',')}</tspan>
          </text>
        </g>
      ))}
      <text x="446" y="336" class="sm muted">
        <tspan data-lang-en>Grey: before. Gold: after (HSG and NKG now lead).</tspan>
        <tspan data-lang-vi>Xám: trước. Vàng: sau (HSG và NKG giờ dẫn đầu).</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Toy numbers: eight tickers with made-up one-day returns in percent, joined by the edges of the demo below. A layer never adds information from outside the graph; it blends what the neighbours already say.</span>
    <span data-lang-vi>Số giả định: tám mã với lợi suất một ngày tự đặt (phần trăm), nối bằng các cạnh của demo bên dưới. Một lớp không thêm thông tin từ ngoài graph; nó trộn những gì láng giềng đã nói.</span>
  </figcaption>
</figure>

<style>
  .atp18-mp { margin: 2em 0; width: 100%; }
  .atp18-scroll { overflow-x: auto; }
  .atp18-mp svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp18-mp .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .atp18-mp .t { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .atp18-mp .sm { font-size: 13px; fill: var(--text); }
  .atp18-mp .sm.muted { fill: var(--text-muted); font-size: 12px; }
  .atp18-mp .lab { font-size: 12px; font-weight: 700; fill: var(--text-body); }
  .atp18-mp .num { font-size: 11.5px; fill: var(--text-muted); }
  .atp18-mp .nl { font-size: 11px; font-weight: 700; fill: var(--text); }
  .atp18-mp .nv { font-size: 12px; fill: var(--text-body); }
  .atp18-mp .panel { fill: var(--bg-alt); stroke: var(--border); }
  .atp18-mp .edge { stroke: var(--text-muted); stroke-width: 2; fill: none; }
  .atp18-mp .arrow { fill: var(--text-muted); }
  .atp18-mp .node { fill: var(--card-bg); stroke: var(--text-muted); stroke-width: 1.6; }
  .atp18-mp .node.hot { stroke: var(--gold); stroke-width: 2.6; fill: var(--gold-tint-bg); }
  .atp18-mp .zero { stroke: var(--text-faint); stroke-width: 1; }
  .atp18-mp .b0 { fill: var(--text-faint); opacity: 0.55; }
  .atp18-mp .b1 { fill: var(--gold); }
  .atp18-mp figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
