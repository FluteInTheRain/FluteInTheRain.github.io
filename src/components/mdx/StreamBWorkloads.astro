---
// Four things people run on top of streams, one cell each. Examples come from the post text.
import StreamBFigure from './StreamBFigure.astro';
import StreamBNode from './StreamBNode.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    cells: [
      { icon: 'card', t: 'Complex event processing', a: 'Standing rule over events', b: 'card swiped in 2 countries in 10 min' },
      { icon: 'chart', t: 'Stream analytics', a: 'Rolling counts and percentiles', b: 'p99 over millions of events' },
      { icon: 'search', t: 'Search on streams', a: 'Saved queries match new documents', b: 'alert when a new listing matches' },
      { icon: 'db', t: 'Incremental view maintenance', a: 'A live SQL view, updated per change', b: 'orders per country, always current' },
    ],
    alt: 'Four kinds of stream processing in a grid: complex event processing with a card icon, stream analytics with a chart icon, search on streams with a magnifier icon, and incremental view maintenance with a database icon. Each shows what it does and one example.',
    cap: 'All four read the same stream. They differ in what they keep in memory: rules, counters, saved queries, or a table.',
  },
  vi: {
    cells: [
      { icon: 'card', t: 'Xử lý sự kiện phức hợp (CEP)', a: 'Luật đứng yên chạy trên sự kiện', b: 'thẻ quẹt ở 2 nước trong 10 phút' },
      { icon: 'chart', t: 'Phân tích stream', a: 'Đếm và phân vị chạy liên tục', b: 'p99 trên hàng triệu sự kiện' },
      { icon: 'search', t: 'Tìm kiếm trên stream', a: 'Truy vấn đã lưu khớp tài liệu mới', b: 'báo khi có tin đăng mới khớp' },
      { icon: 'db', t: 'Incremental view maintenance', a: 'View SQL sống, cập nhật theo từng thay đổi', b: 'số đơn theo quốc gia, luôn mới' },
    ],
    alt: 'Bốn loại xử lý stream trong một lưới: xử lý sự kiện phức hợp với biểu tượng thẻ, phân tích stream với biểu tượng biểu đồ, tìm kiếm trên stream với biểu tượng kính lúp, và incremental view maintenance với biểu tượng database. Mỗi ô nêu việc nó làm và một ví dụ.',
    cap: 'Cả bốn đều đọc cùng một stream. Khác nhau ở thứ chúng giữ trong bộ nhớ: luật, bộ đếm, truy vấn đã lưu, hoặc một bảng.',
  },
}[lang];
const pos = [[20, 20], [460, 20], [20, 130], [460, 130]];
---
<StreamBFigure h={240} alt={T.alt} cap={T.cap}>
  {T.cells.map((c, i) => (
    <StreamBNode x={pos[i][0]} y={pos[i][1]} w={420} h={92} icon={c.icon} title={c.t} sub={[c.a, `${lang === "vi" ? "vd" : "e.g."}: ${c.b}`]} />
  ))}
</StreamBFigure>
