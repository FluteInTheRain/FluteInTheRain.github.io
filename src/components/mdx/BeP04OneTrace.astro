---
// One POST /cases from the layered app, read as a stack — every line
// matches the terminal capture beside it (C-1, 201, 6.64 ms are the real
// values from that run). The service step is the red one: yours.
const W = 900, H = 268;
const steps = [
  {
    y: 62, layer: 'web', icon: 'fastapi', iconW: 56, iconH: 10.4, red: false,
    en: 'dispatch POST /cases to a handler', vi: 'đưa POST /cases cho một handler',
  },
  {
    y: 107, layer: 'web', icon: null, red: false,
    en: 'parse and validate the title — then stop', vi: 'parse và validate title — rồi dừng lại',
  },
  {
    y: 152, layer: 'service', icon: 'engine', iconW: 22, iconH: 22, red: true,
    en: 'the id and the open status are ours to set', vi: 'id và trạng thái open do service đặt',
  },
  {
    y: 197, layer: 'data', icon: 'database', iconW: 22, iconH: 22, disc: true, red: false,
    en: 'add(C-1) → the store, and nothing else', vi: 'add(C-1) → kho lưu trữ, chỉ vậy thôi',
  },
  {
    y: 242, layer: 'web', icon: null, red: false,
    en: '201 back through the stack · 6.64 ms', vi: '201 quay về · 6.64 ms',
  },
];
---
<figure class="bep4d">
  <div class="bep4d-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Five steps of one request: the web layer dispatches and validates, the service layer sets the id and open status, the data layer adds case C-1 to the store, and the web layer answers 201 in 6.64 milliseconds. The service step is drawn in red.">
    <text x="56" y="28" class="h">
      <tspan data-lang-en>one POST /cases, read as a stack</tspan>
      <tspan data-lang-vi>một POST /cases, đọc theo tầng</tspan>
    </text>

    <line x1="42" y1="52" x2="42" y2="238" class="spine" />

    {steps.map((s, i) => (
      <g>
        <circle cx="42" cy={s.y - 5} r="5" class={s.red ? 'dot red' : 'dot'} />
        {s.icon && (s.disc ? (
          <g>
            <circle cx="150" cy={s.y - 5} r="15" class="disc" />
            <image href={`/icons/flow/${s.icon}.svg`} x="139" y={s.y - 5 - s.iconH / 2} width={s.iconW} height={s.iconH} aria-hidden="true" />
          </g>
        ) : (
          <image href={`/icons/flow/${s.icon}.svg`} x={150 - s.iconW / 2} y={s.y - 5 - s.iconH / 2} width={s.iconW} height={s.iconH} aria-hidden="true" />
        ))}
        <text x="182" y={s.y} class={s.red ? 'ln red' : 'ln'}>
          <tspan data-lang-en>{s.layer}</tspan><tspan data-lang-vi>{s.layer}</tspan>
        </text>
        <text x="250" y={s.y} class="msg">
          <tspan data-lang-en>{s.en}</tspan><tspan data-lang-vi>{s.vi}</tspan>
        </text>
        {i < steps.length - 1 && (
          <line x1="42" y1={s.y + 2} x2="42" y2={steps[i + 1].y - 13} class="spine" />
        )}
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Every line is a layer boundary the request crosses — and the numbers are the ones from the capture above. The web layer appears three times because it owns the door; the rules run once, in red, where you can test them.</span>
    <span data-lang-vi>Mỗi dòng là một ranh giới tầng mà request băng qua — và con số lấy đúng từ capture phía trên. Tầng web xuất hiện ba lần vì nó giữ cửa; luật chỉ chạy một lần, ở ô đỏ, nơi bạn test được.</span>
  </figcaption>
</figure>

<style>
  .bep4d { margin: 2em 0; width: 100%; }
  .bep4d-scroll { overflow-x: auto; }
  .bep4d svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep4d text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep4d .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep4d .ln { font-weight: 700; fill: var(--text); font-size: 13.5px; }
  .bep4d .ln.red { fill: var(--red); }
  .bep4d .msg { fill: var(--text-body); }
  .bep4d .spine { stroke: var(--border); stroke-width: 1.6; }
  .bep4d .dot { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; }
  .bep4d .dot.red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 2; }
  .bep4d .disc { fill: none; }
  :global([data-theme='dark']) .bep4d .disc { fill: rgba(255, 255, 255, 0.88); }
  .bep4d figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
