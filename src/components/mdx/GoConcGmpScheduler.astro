---
// Go GMP Scheduler architecture: G (goroutine), M (OS thread), P (logical processor), local run queues, work stealing, and syscall handoff.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 350;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const stealArrow = arrow(284, 172, 323, 172);
const sysArrow = arrow(745, 226, 745, 212);
---
<figure class="gcgmp">
  <div class="gcgmp-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Go GMP scheduler diagram showing logical processors P0 and P1 paired with OS threads M0 and M1, local goroutine run queues, work stealing across processors, and detaching M during a blocking syscall.">
      {/* Global Run Queue */}
      <rect x="14" y="16" width="872" height="58" rx="8" class="gcgmp-grq" />
      <text x="30" y="42" class="gcgmp-b">
        <tspan data-lang-en>Global Run Queue (GRQ)</tspan>
        <tspan data-lang-vi>Hàng đợi toàn cục (Global Run Queue)</tspan>
      </text>
      <text x="30" y="60" class="gcgmp-sm">
        <tspan data-lang-en>Overflow runnable goroutines waiting when local P queues fill (256 slots)</tspan>
        <tspan data-lang-vi>Chứa các goroutine tràn khỏi hàng đợi cục bộ của từng P</tspan>
      </text>
      {['G7', 'G8', 'G9'].map((g, i) => (
        <g>
          <rect x={614 + i * 86} y="28" width="70" height="34" rx="5" class="gcgmp-g" />
          <text x={649 + i * 86} y="50" text-anchor="middle" class="gcgmp-gt">{g}</text>
        </g>
      ))}

      {/* P0 Column */}
      <rect x="14" y="96" width="282" height="236" rx="10" class="gcgmp-p" />
      <DiagramIcon name="worker" x={28} y={118} size={20} />
      <text x="56" y="123" class="gcgmp-b">P0 (Logical Processor)</text>
      <text x="28" y="144" class="gcgmp-sm">
        <tspan data-lang-en>Local Run Queue (LRQ) — busy</tspan>
        <tspan data-lang-vi>Hàng đợi cục bộ (LRQ) — đang bận</tspan>
      </text>
      {['G1', 'G2', 'G3', 'G4'].map((g, i) => (
        <g>
          <rect x={28 + i * 64} y="156" width="56" height="32" rx="4" class="gcgmp-g" />
          <text x={56 + i * 64} y="177" text-anchor="middle" class="gcgmp-gt">{g}</text>
        </g>
      ))}
      <rect x="28" y="210" width="254" height="106" rx="8" class="gcgmp-mnode" />
      <text x="42" y="234" class="gcgmp-b">M0 (OS Thread) ↔ G0 running</text>
      <text x="42" y="256" class="gcgmp-sm">
        <tspan data-lang-en>2 KiB initial goroutine stack</tspan>
        <tspan data-lang-vi>Stack khởi đầu của G chỉ 2 KiB</tspan>
      </text>
      <text x="42" y="276" class="gcgmp-sm">
        <tspan data-lang-en>User-space switch (~100 ns)</tspan>
        <tspan data-lang-vi>Chuyển ngữ cảnh cực nhẹ (~100 ns)</tspan>
      </text>
      <text x="42" y="298" class="gcgmp-ok">
        <tspan data-lang-en>GOMAXPROCS limits active Ps</tspan>
        <tspan data-lang-vi>GOMAXPROCS giới hạn số P</tspan>
      </text>

      {/* P1 Column (Work Stealing) */}
      <rect x="309" y="96" width="282" height="236" rx="10" class="gcgmp-p" />
      <DiagramIcon name="worker" x={323} y={118} size={20} />
      <text x="351" y="123" class="gcgmp-b">P1 (Idle → Work Stealing)</text>
      <text x="323" y="144" class="gcgmp-sm">
        <tspan data-lang-en>Local queue empty; steals half of P0's LRQ</tspan>
        <tspan data-lang-vi>Hàng đợi rỗng; kéo bớt một nửa từ P0</tspan>
      </text>
      <rect x="323" y="156" width="254" height="32" rx="4" class="gcgmp-empty" />
      <text x="450" y="177" text-anchor="middle" class="gcgmp-warn">
        <tspan data-lang-en>steals G3, G4 from P0</tspan>
        <tspan data-lang-vi>kéo G3, G4 từ P0 sang</tspan>
      </text>
      <rect x="323" y="210" width="254" height="106" rx="8" class="gcgmp-mnode" />
      <text x="337" y="234" class="gcgmp-b">M1 (OS Thread)</text>
      <text x="337" y="258" class="gcgmp-sm">
        <tspan data-lang-en>Keeps CPU cores saturated without</tspan>
        <tspan data-lang-vi>Giữ các nhân CPU luôn bận đều,</tspan>
      </text>
      <text x="337" y="278" class="gcgmp-sm">
        <tspan data-lang-en>blocking on a central global lock</tspan>
        <tspan data-lang-vi>không kẹt ở một khóa toàn cục</tspan>
      </text>

      <path d={stealArrow.line} class="gcgmp-arrow-gold" /><polygon points={stealArrow.head} class="gcgmp-head-gold" />

      {/* Syscall handoff */}
      <rect x="604" y="96" width="282" height="236" rx="10" class="gcgmp-p is-sys" />
      <DiagramIcon name="hourglass" x={618} y={118} size={20} />
      <text x="646" y="123" class="gcgmp-b">
        <tspan data-lang-en>P2 · Blocking syscall handoff</tspan>
        <tspan data-lang-vi>P2 · Tách M khi gặp syscall nghẽn</tspan>
      </text>
      <text x="618" y="144" class="gcgmp-sm">
        <tspan data-lang-en>P2 detaches M2 and grabs idle M3</tspan>
        <tspan data-lang-vi>P2 tách M2 kẹt I/O, gắn sang M3</tspan>
      </text>
      <rect x="618" y="158" width="254" height="54" rx="6" class="gcgmp-mnode is-ok" />
      <text x="632" y="180" class="gcgmp-ok">M3 (fresh OS thread) → G6</text>
      <text x="632" y="200" class="gcgmp-sm">
        <tspan data-lang-en>P2 keeps executing other Gs</tspan>
        <tspan data-lang-vi>P2 tiếp tục chạy goroutine khác</tspan>
      </text>
      <rect x="618" y="226" width="254" height="90" rx="6" class="gcgmp-mnode is-warn" />
      <text x="632" y="250" class="gcgmp-warn">M2 + G5 (blocked in disk I/O)</text>
      <text x="632" y="272" class="gcgmp-sm">
        <tspan data-lang-en>Network I/O uses netpoller instead</tspan>
        <tspan data-lang-vi>I/O mạng đi qua netpoller nên</tspan>
      </text>
      <text x="632" y="292" class="gcgmp-sm">
        <tspan data-lang-en>so 10k sockets barely need extra Ms</tspan>
        <tspan data-lang-vi>10k socket chỉ tốn vài OS thread</tspan>
      </text>

      <path d={sysArrow.line} class="gcgmp-arrow-gold" /><polygon points={sysArrow.head} class="gcgmp-head-gold" />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Go multiplexes thousands of lightweight goroutines (G) across GOMAXPROCS logical processors (P) backed by OS threads (M). Network waits park G in the netpoller without holding an OS thread, while idle Ps steal work from busy ones.</span>
    <span data-lang-vi>Go phân phối hàng nghìn goroutine nhẹ (G) lên GOMAXPROCS bộ xử lý logic (P) gắn với OS thread (M). Chờ mạng sẽ đẩy G vào netpoller mà không chiếm OS thread, còn P rảnh tự động kéo bớt G từ P đang bận.</span>
  </figcaption>
</figure>

<style>
  .gcgmp { margin: 2em 0; width: 100%; }
  .gcgmp-scroll { overflow-x: auto; }
  .gcgmp svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gcgmp text { font-size: 12.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .gcgmp-grq { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .gcgmp-p { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; }
  .gcgmp-p.is-sys { stroke: var(--gold); }
  .gcgmp-g { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; }
  .gcgmp-gt { font-weight: 700; fill: var(--red); }
  .gcgmp-mnode { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .gcgmp-mnode.is-ok { stroke: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gcgmp-mnode.is-ok { stroke: rgb(74, 222, 128); }
  .gcgmp-mnode.is-warn { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .gcgmp-empty { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-dasharray: 4 3; }
  .gcgmp-b { font-weight: 700; fill: var(--text); }
  .gcgmp-sm { font-size: 11px; fill: var(--text-muted); }
  .gcgmp-warn { font-size: 12px; font-weight: 700; fill: var(--gold-icon); }
  .gcgmp-ok { font-size: 12px; font-weight: 700; fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gcgmp-ok { fill: rgb(74, 222, 128); }
  .gcgmp-arrow-gold { fill: none; stroke: var(--gold-icon); stroke-width: 1.8; stroke-dasharray: 4 3; }
  .gcgmp-head-gold { fill: var(--gold-icon); }
  .gcgmp-pulse-gold { fill: var(--gold-icon); }
  .gcgmp-pulse-ok { fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gcgmp-pulse-ok { fill: rgb(74, 222, 128); }
  .gcgmp figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
