---
// Why fetch-and-add solves consensus for two nodes but not three: with three, the two losers cannot
// tell who drew 0 if the winner crashes silently. Static SVG, site tokens only.
import ConsensusFigure from './ConsensusFigure.astro';
import DiagramIcon from './DiagramIcon.astro';
import { head } from './consensus-fig';
interface Props { lang: 'en' | 'vi' }
const { lang } = Astro.props;

const T = {
  en: {
    aria: 'Two panels. Left, two nodes: a shared counter starts at 0 and each node adds 1 and keeps what it drew. P draws 0 and Q draws 1, so Q knows P won and adopts P\'s proposal. Right, three nodes: P draws 0 and then crashes silently before telling anyone; Q draws 1 and R draws 2. Q and R both know they did not win, but neither can tell whether P or the other one drew 0.',
    lT: 'Two nodes: it works', rT: 'Three nodes: it breaks',
    sub: 'Nodes draw from a shared counter that starts at 0; 0 wins.',
    draws: (n: number) => `draws ${n}`,
    crashed: 'crashed, silent',
    lRes: ['Q drew 1, so P must have drawn 0.', 'Q adopts P\'s proposal.'],
    rRes: ['Q drew 1, R drew 2. Who drew 0: P,', 'or the other one? Nobody can tell.'],
    cap: 'With two nodes "I lost" already names the winner; with three it does not.',
  },
  vi: {
    aria: 'Hai khung. Trái, hai node: bộ đếm chung bắt đầu từ 0, mỗi node cộng 1 và giữ số mình rút được. P rút 0 và Q rút 1, nên Q biết P thắng và nhận đề xuất của P. Phải, ba node: P rút 0 rồi sập im lặng trước khi báo ai; Q rút 1 và R rút 2. Q và R đều biết mình không thắng, nhưng không ai biết P hay người còn lại rút 0.',
    lT: 'Hai node: chạy được', rT: 'Ba node: hỏng',
    sub: 'Các node rút từ bộ đếm chung bắt đầu từ 0; rút 0 là thắng.',
    draws: (n: number) => `rút ${n}`,
    crashed: 'sập, im lặng',
    lRes: ['Q rút 1 nên P chắc chắn rút 0.', 'Q nhận đề xuất của P.'],
    rRes: ['Q rút 1, R rút 2. Ai rút 0: P hay', 'người còn lại? Không ai biết.'],
    cap: 'Với hai node, "tôi thua" đã chỉ ra người thắng; với ba node thì không.',
  },
}[lang];

const bw = 120, bh = 62;
const panels = [
  { ox: 10, title: T.lT, nodes: [['P', 0, 'ok'], ['Q', 1, '']], xs: [60, 250], res: T.lRes, kind: 'is-ok' },
  { ox: 460, title: T.rT, nodes: [['P', 0, 'dead'], ['Q', 1, ''], ['R', 2, '']], xs: [10, 150, 290], res: T.rRes, kind: 'is-bad' },
];
---
<ConsensusFigure aria={T.aria} cap={T.cap} w={900} h={290}>
  <line x1="450" x2="450" y1="10" y2="270" class="cfg-rule" />
  {panels.map((p) => (
    <g>
      <text x={p.ox + 10} y="24" class="cfg-t">{p.title}</text>
      <text x={p.ox + 10} y="44" class="cfg-s" style="font-size:12px">{T.sub}</text>
      {p.nodes.map((n, i) => {
        const x = p.ox + p.xs[i];
        const dead = n[2] === 'dead';
        return (
          <g>
            <rect x={x} y="70" width={bw} height={bh} rx="6" class={`cfg-box ${dead ? 'is-bad is-dash' : n[2] === 'ok' ? 'is-ok' : ''}`} />
            <DiagramIcon name="server" x={x + 24} y={101} size={24} />
            <text x={x + 48} y="94" class="cfg-n">{n[0]}</text>
            <text x={x + 48} y="112" class="cfg-m">{T.draws(n[1] as number)}</text>
            {dead && <text x={x + bw / 2} y="150" text-anchor="middle" class="cfg-r" style="font-size:11.5px">{T.crashed}</text>}
          </g>
        );
      })}
      <rect x={p.ox + 10} y="180" width="420" height="68" rx="6" class={`cfg-box ${p.kind}`} />
      <text x={p.ox + 220} y="208" text-anchor="middle" class="cfg-g">{p.res[0]}</text>
      <text x={p.ox + 220} y="228" text-anchor="middle" class="cfg-g">{p.res[1]}</text>
    </g>
  ))}
</ConsensusFigure>
