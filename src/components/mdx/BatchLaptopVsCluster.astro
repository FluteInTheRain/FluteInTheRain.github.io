---
import BatchDiagram from './BatchDiagram.astro';
const boxes = [{"x": 20, "y": 46, "w": 240, "h": 64, "t": ["Laptop", "Laptop"], "s": [["one machine, 1.75 GB of games", "một máy, 1,75 GB ván cờ"]], "icon": "laptop"}, {"x": 330, "y": 46, "w": 240, "h": 64, "t": ["find | xargs | mawk", "find | xargs | mawk"], "s": [["Unix pipes, no cluster", "Unix pipe, không cụm"]], "icon": "worker"}, {"x": 640, "y": 46, "w": 240, "h": 64, "t": ["12 seconds", "12 giây"], "s": [["about 270 MB/s", "khoảng 270 MB/s"]], "icon": "stopwatch", "kind": "good"}, {"x": 20, "y": 170, "w": 240, "h": 64, "t": ["7 EMR nodes", "7 node EMR"], "s": [["same 1.75 GB of games", "cùng 1,75 GB ván cờ"]], "icon": "server"}, {"x": 330, "y": 170, "w": 240, "h": 64, "t": ["Hadoop job", "Job Hadoop"], "s": [["startup, JVM, network", "khởi động, JVM, mạng"]], "icon": "hadoop"}, {"x": 640, "y": 170, "w": 240, "h": 64, "t": ["26 minutes", "26 phút"], "s": [["about 1.14 MB/s", "khoảng 1,14 MB/s"]], "icon": "stopwatch", "kind": "hot"}];
const arrows = [{"x1": 260, "y1": 78, "x2": 330, "y2": 78}, {"x1": 570, "y1": 78, "x2": 640, "y2": 78, "kind": "good"}, {"x1": 260, "y1": 202, "x2": 330, "y2": 202}, {"x1": 570, "y1": 202, "x2": 640, "y2": 202, "kind": "hot"}];
const texts = [{"x": 20, "y": 26, "cls": "h", "t": ["Adam Drake's laptop pipeline", "Đường ống trên laptop của Adam Drake"]}, {"x": 20, "y": 150, "cls": "h", "t": ["The seven-node cluster", "Cụm Hadoop 7 máy"]}, {"x": 20, "y": 266, "cls": "foot", "t": ["The cluster paid startup, JVM, serialization and network costs on data that fits on one SSD.", "Cụm máy trả phí khởi động, JVM, tuần tự hóa và mạng cho dữ liệu vừa trọn một ổ SSD."]}, {"x": 20, "y": 286, "cls": "ok", "t": ["235 times faster on the laptop.", "Nhanh hơn 235 lần trên laptop."]}];
---
<BatchDiagram
  w={900} h={300}
  aria="Same 1.75 GB of chess games two ways. A laptop chaining find, xargs and mawk with Unix pipes finished in 12 seconds. A seven-node Hadoop cluster on Amazon EMR took 26 minutes."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any} rules={[130]} icons={[]}
  caption={["Same data, same question: the plain pipe on one laptop beat the cluster because the data never needed a cluster.", "Cùng dữ liệu, cùng câu hỏi: đường ống đơn giản trên một laptop thắng cụm máy vì dữ liệu vốn không cần cụm."]}
/>
