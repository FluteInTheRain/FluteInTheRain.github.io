---
// What Mantegna found: a tree of 443 S&P 500 stocks (July 1989 - October 1995, daily returns) groups by industry.
// Groups named in the paper (arXiv cond-mat/9802256, opened 2026-11-28): I financial services, capital goods, retailing,
// food/drink/tobacco, consumer nondurables; II oil companies; III communication and electrical utilities; IV raw materials;
// and a group made only of gold-mining companies. The drawing is schematic: dots are not specific stocks.
const W = 900, H = 380;
const groups = [
  { x: 130, y: 150, c: 'g0', en: 'Oil companies', vi: 'Công ty dầu khí', n: 6 },
  { x: 450, y: 110, c: 'g1', en: 'Communication and electrical utilities', vi: 'Viễn thông và điện lực', n: 7 },
  { x: 750, y: 150, c: 'g2', en: 'Raw materials', vi: 'Nguyên vật liệu', n: 6 },
  { x: 330, y: 245, c: 'g3', en: 'Financial services, capital goods, retailing, food and drink, consumer goods', vi: 'Dịch vụ tài chính, tư liệu sản xuất, bán lẻ, thực phẩm đồ uống, hàng tiêu dùng', n: 9 },
  { x: 700, y: 262, c: 'g4', en: 'Gold mining only', vi: 'Chỉ có khai thác vàng', n: 4 },
];
const dot = (g: any, i: number) => {
  const a = (2 * Math.PI * i) / g.n + 0.4;
  const r = 16 + (i % 2) * 14 + g.n * 1.5;
  return [g.x + r * Math.cos(a), g.y + r * Math.sin(a)] as [number, number];
};
---
<figure class="atp11-mg">
  <div class="atp11-mg-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A schematic spanning tree of 443 US stocks. Stocks of the same industry sit together: oil companies, communication and electrical utilities, raw materials, a mixed cluster of financial services, capital goods, retailing and consumer goods, and a group made only of gold-mining companies.">
      <text x="20" y="26" class="h"><tspan data-lang-en>Stocks that move together turn out to share an industry</tspan><tspan data-lang-vi>Những mã đi cùng nhau hóa ra chung một ngành</tspan></text>
      {groups.map((g) => (
        <g>
          <circle cx={g.x} cy={g.y} r={g.n * 4 + 28} class={`bg ${g.c}`} />
          {Array.from({ length: g.n }, (_, i) => dot(g, i)).map(([x, y]) => <line x1={g.x} y1={g.y} x2={x} y2={y} class="sp" />)}
          {Array.from({ length: g.n }, (_, i) => dot(g, i)).map(([x, y]) => <circle cx={x} cy={y} r="5" class={`d ${g.c}`} />)}
        </g>
      ))}
      <foreignObject x="30" y="205" width="150" height="40"><p xmlns="http://www.w3.org/1999/xhtml" class="gl"><span data-lang-en>{groups[0].en}</span><span data-lang-vi>{groups[0].vi}</span></p></foreignObject>
      <foreignObject x="360" y="172" width="180" height="40"><p xmlns="http://www.w3.org/1999/xhtml" class="gl"><span data-lang-en>{groups[1].en}</span><span data-lang-vi>{groups[1].vi}</span></p></foreignObject>
      <foreignObject x="690" y="206" width="170" height="30"><p xmlns="http://www.w3.org/1999/xhtml" class="gl"><span data-lang-en>{groups[2].en}</span><span data-lang-vi>{groups[2].vi}</span></p></foreignObject>
      <foreignObject x="30" y="312" width="470" height="44"><p xmlns="http://www.w3.org/1999/xhtml" class="gl gl-l"><span data-lang-en>{groups[3].en}</span><span data-lang-vi>{groups[3].vi}</span></p></foreignObject>
      <foreignObject x="590" y="318" width="230" height="30"><p xmlns="http://www.w3.org/1999/xhtml" class="gl gl-l"><span data-lang-en>{groups[4].en}</span><span data-lang-vi>{groups[4].vi}</span></p></foreignObject>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Schematic of the groups Mantegna reports for 443 S&amp;P 500 stocks, July 1989 to October 1995. The groups are the paper's; the dots are not specific stocks.</span>
    <span data-lang-vi>Sơ đồ các nhóm Mantegna báo cáo cho 443 mã trong S&amp;P 500, từ tháng 7/1989 đến tháng 10/1995. Các nhóm là của bài báo; các chấm không đại diện mã cụ thể nào.</span>
  </figcaption>
</figure>
<style>
  .atp11-mg { margin: 2em 0; width: 100%; }
  .atp11-mg-scroll { overflow-x: auto; }
  .atp11-mg svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp11-mg text { font-size: 14px; fill: var(--text-body); }
  .atp11-mg .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp11-mg .gl { margin: 0; font-size: 12.5px; line-height: 1.35; font-weight: 600; color: var(--text); text-align: center; }
  .atp11-mg .gl-l { text-align: left; }
  .atp11-mg .l { stroke: var(--text-faint); stroke-width: 1.6; stroke-dasharray: 5 4; }
  .atp11-mg .sp { stroke: var(--text-muted); stroke-width: 1.2; }
  .atp11-mg .bg { opacity: 0.16; }
  .atp11-mg .g0 { fill: var(--act-0); } .atp11-mg .g1 { fill: var(--act-3); } .atp11-mg .g2 { fill: var(--act-2); } .atp11-mg .g3 { fill: var(--act-4); } .atp11-mg .g4 { fill: var(--act-1); }
  .atp11-mg figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
