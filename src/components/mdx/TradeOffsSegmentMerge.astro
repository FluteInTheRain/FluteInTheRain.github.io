---
// Segment, 2017: from over 140 services (one per destination) to one service.
// Numbers from the Segment write-up cited in the post.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 340;
const before = [
  { icon: 'users', en: '3 engineers mostly keeping it alive', vi: '3 kỹ sư chủ yếu lo giữ cho nó sống' },
  { icon: 'folder', en: 'A fix meant touching dozens of repos', vi: 'Một bản sửa phải đụng hàng chục repo' },
  { icon: 'hourglass', en: 'Full test suite took up to an hour', vi: 'Chạy hết test mất tới một giờ' },
];
const after = [
  { icon: 'stopwatch', en: 'Tests for 140+ destinations: milliseconds', vi: 'Test cho 140+ đích: vài mili-giây' },
  { icon: 'user', en: 'One engineer deploys in minutes', vi: 'Một kỹ sư deploy trong vài phút' },
  { icon: 'package', en: 'Library improvements: 32, then 46', vi: 'Cải tiến thư viện chung: 32, rồi 46' },
];
const cols = 10;
const rows = 4;
---
<figure class="tosm">
  <div class="tosm-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Segment before and after merging. Before: over 140 services, three engineers mostly keeping it alive, a fix touching dozens of repos, a test suite taking up to an hour. After 2017: one service, tests for all destinations in milliseconds, one engineer deploying in minutes, shared-library improvements rising from 32 to 46 the next year.">
    <text x="20" y="26" class="tosm-h"><tspan data-lang-en>Before: over 140 services, one per destination</tspan><tspan data-lang-vi>Trước: hơn 140 service, mỗi đích một cái</tspan></text>
    <rect x="20" y="40" width="420" height="116" rx="10" class="tosm-box is-bad" />
    {Array.from({ length: rows * cols }).map((_, i) => (
      <DiagramIcon name="server" x={52 + (i % cols) * 37} y={62 + Math.floor(i / cols) * 25} size={16} />
    ))}
    {before.map((b, i) => (
      <g>
        <DiagramIcon name={b.icon as any} x={42} y={190 + i * 40} size={22} />
        <text x="68" y={195 + i * 40} class="tosm-line"><tspan data-lang-en>{b.en}</tspan><tspan data-lang-vi>{b.vi}</tspan></text>
      </g>
    ))}

    <line x1="450" x2="450" y1="20" y2="310" class="tosm-rule" />

    <text x="470" y="26" class="tosm-h"><tspan data-lang-en>After (2017): one service</tspan><tspan data-lang-vi>Sau (2017): một service</tspan></text>
    <rect x="470" y="40" width="410" height="116" rx="10" class="tosm-box is-good" />
    <DiagramIcon name="server" x={675} y={98} size={52} />
    {after.map((b, i) => (
      <g>
        <DiagramIcon name={b.icon as any} x={492} y={190 + i * 40} size={22} />
        <text x="518" y={195 + i * 40} class="tosm-line"><tspan data-lang-en>{b.en}</tspan><tspan data-lang-vi>{b.vi}</tspan></text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Same product, one deployable unit. The 40 icons in the top box stand in for the 140+ services.</span>
    <span data-lang-vi>Cùng một sản phẩm nhưng chỉ còn một đơn vị deploy. 40 icon ở khung trên đại diện cho hơn 140 service.</span>
  </figcaption>
</figure>

<style>
  .tosm { margin: 2em 0; width: 100%; }
  .tosm-scroll { overflow-x: auto; }
  .tosm svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .tosm text { font-size: 13.5px; fill: var(--text-body); }
  .tosm .tosm-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .tosm-box { fill: var(--bg-alt); stroke-width: 1.2; }
  .tosm-box.is-bad { stroke: var(--red); fill: var(--red-tint-bg); }
  .tosm-box.is-good { stroke: var(--gold-icon); fill: var(--gold-tint-bg); }
  .tosm-rule { stroke: var(--border); }
  .tosm figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
