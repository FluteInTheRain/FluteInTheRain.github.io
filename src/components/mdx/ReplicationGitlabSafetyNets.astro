---
import DiagramIcon from './DiagramIcon.astro';
// GitLab, 31 Jan 2017: every safety net the postmortem lists, and what state each was in.
// Source: GitLab postmortem of the database outage of January 31. Plain inline SVG with site tokens.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 9;
  const bx = x2 - len * Math.cos(a), by = y2 - len * Math.sin(a);
  const head = `${x2},${y2} ${bx + 4.5 * Math.sin(a)},${by - 4.5 * Math.cos(a)} ${bx - 4.5 * Math.sin(a)},${by + 4.5 * Math.cos(a)}`;
  return { line: { x1, y1, x2: bx, y2: by }, head };
}
const W = 900, H = 420;
const db1 = { x: 20, y: 40, w: 200, h: 90 };
const db2 = { x: 20, y: 250, w: 200, h: 90 };
const nets = [
  { y: 20, icon: 'db', bad: true, en: ['Replica db2', 'fell behind at about 23:00; WAL it needed was gone; being rebuilt'], vi: ['Replica db2', 'tụt lại lúc khoảng 23:00; WAL cần đã mất; đang dựng lại'], tag: ['empty', 'trống'] },
  { y: 118, icon: 's3', bad: true, en: ['pg_dump to S3', 'ran 9.2 against a 9.6 database; error emails rejected by DMARC'], vi: ['pg_dump lên S3', 'chạy bản 9.2 với database 9.6; email báo lỗi bị DMARC từ chối'], tag: ['failing', 'hỏng'] },
  { y: 216, icon: 'disk', bad: true, en: ['Azure disk snapshots', 'not enabled for the database servers'], vi: ['Snapshot đĩa Azure', 'chưa bật cho các server database'], tag: ['off', 'tắt'] },
  { y: 314, icon: 'backup', bad: false, en: ['LVM snapshot', 'taken for staging, about 6 hours before the outage'], vi: ['LVM snapshot', 'chụp để làm staging, khoảng 6 giờ trước sự cố'], tag: ['used', 'dùng được'] },
];
const NX = 330, NW = 550, NH = 78;
---
<figure class="rf">
  <div class="rf-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="At GitLab, the primary db1 had its data directory wiped by mistake. Four possible recovery sources: the replica db2 was empty because it was being rebuilt, the daily pg_dump to S3 was failing, Azure disk snapshots were not enabled, and only an LVM snapshot taken about six hours earlier for staging could be used.">
    <rect x={db1.x} y={db1.y} width={db1.w} height={db1.h} rx="4" class="box bad" />
    <text x="120" y="80" text-anchor="middle" class="t-h">db1 primary</text>
    <text x="120" y="102" text-anchor="middle" class="t-bad"><tspan data-lang-en>data directory wiped</tspan><tspan data-lang-vi>thư mục data bị xoá</tspan></text>
    <text x="120" y="120" text-anchor="middle" class="t-note"><tspan data-lang-en>about 300 GB gone</tspan><tspan data-lang-vi>mất khoảng 300 GB</tspan></text>
    <DiagramIcon name="postgres" x={db1.x + db1.w - 18} y={db1.y + db1.h} size={26} />
    <text x="120" y="24" text-anchor="middle" class="t-note"><tspan data-lang-en>Where can we recover from?</tspan><tspan data-lang-vi>Khôi phục từ đâu?</tspan></text>

    {nets.map((n) => {
      const e = arrow(db1.x + db1.w, db1.y + db1.h / 2 + 10, NX, n.y + NH / 2);
      return (
        <g>
          <line {...e.line} class={n.bad ? 'edge bad' : 'edge'} /><polygon points={e.head} class={n.bad ? 'head bad' : 'head'} />
          <rect x={NX} y={n.y} width={NW} height={NH} rx="4" class={n.bad ? 'box' : 'box strong'} />
          <DiagramIcon name={n.icon} x={NX + 30} y={n.y + NH / 2} size={28} />
          <text x={NX + 58} y={n.y + 30} class="t-h"><tspan data-lang-en>{n.en[0]}</tspan><tspan data-lang-vi>{n.vi[0]}</tspan></text>
          <text x={NX + 58} y={n.y + 54} class="t-note"><tspan data-lang-en>{n.en[1]}</tspan><tspan data-lang-vi>{n.vi[1]}</tspan></text>
          <text x={NX + NW - 16} y={n.y + 30} text-anchor="end" class={n.bad ? 't-bad' : 't-ok'}><tspan data-lang-en>{n.tag[0]}</tspan><tspan data-lang-vi>{n.tag[1]}</tspan></text>
        </g>
      );
    })}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Redrawn from the timeline in GitLab's postmortem. A healthy replica would have copied the wipe within seconds, so only a snapshot older than the mistake could help.</span>
    <span data-lang-vi>Vẽ lại từ timeline trong postmortem của GitLab. Một replica khoẻ mạnh sẽ chép luôn cú xoá trong vài giây, nên chỉ có snapshot cũ hơn lỗi mới cứu được.</span>
  </figcaption>
</figure>

<style>
  .rf { margin: 2em 0; width: 100%; }
  .rf-scroll { overflow-x: auto; }
  .rf svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .rf text { font-size: 14px; fill: var(--text-body); }
  .rf .t-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .rf .t-note { font-size: 12.5px; fill: var(--text-muted); }
  .rf .t-bad { fill: var(--red); font-weight: 700; font-size: 13px; }
  .rf .t-ok { fill: var(--text); font-weight: 700; font-size: 13px; }
  .rf .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .rf .box.strong { stroke: var(--text); stroke-width: 1.8; }
  .rf .box.bad { stroke: var(--red); stroke-width: 1.8; }
  .rf .edge { stroke: var(--text-muted); stroke-width: 1.4; fill: none; }
  .rf .edge.dash { stroke-dasharray: 5 4; }
  .rf .edge.bad { stroke: var(--red); stroke-dasharray: 5 4; }
  .rf .head { fill: var(--text-muted); }
  .rf .head.bad { fill: var(--red); }
  .rf figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
