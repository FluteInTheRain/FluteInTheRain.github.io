---
// Same query, two loads: one user on a laptop versus 300,000 users at once. Numbers come from the post text.
import DiagramIcon from './DiagramIcon.astro';
import NfrText from './NfrText.astro';
import NfrArrow from './NfrArrow.astro';
import './nfr-fig.css';
const W = 900;
const H = 230;
---
<figure class="nf">
  <div class="nf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: on a laptop, one user runs a query and the database answers in 2 milliseconds. Right: in production, 300,000 users refresh at once and the same database locks up.">
      <rect x="20" y="16" width="410" height="190" rx="8" class="panel" />
      <NfrText x={38} y={42} cls="h" en="On your laptop" vi="Trên máy của bạn" />
      <DiagramIcon name="laptop" x={90} y={112} size={34} />
      <NfrText x={90} y={152} anchor="middle" cls="n" en="One user" vi="Một người dùng" />
      <NfrArrow x1={126} y1={112} x2={318} y2={112} />
      <NfrText x={222} y={98} anchor="middle" cls="num" en="one query: 2 ms" vi="một truy vấn: 2 ms" />
      <DiagramIcon name="db" x={352} y={112} size={34} />
      <NfrText x={352} y={152} anchor="middle" cls="n" en="Database" vi="Database" />
      <NfrText x={38} y={186} cls="s" en="Everything feels fast." vi="Mọi thứ đều nhanh." />

      <rect x="470" y="16" width="410" height="190" rx="8" class="panel" />
      <NfrText x={488} y={42} cls="h" en="In production" vi="Trên production" />
      <DiagramIcon name="users" x={540} y={112} size={34} />
      <NfrText x={540} y={152} anchor="middle" cls="n" en="300,000 users" vi="300,000 người dùng" />
      <NfrArrow x1={580} y1={112} x2={758} y2={112} tone="red" />
      <NfrText x={668} y={98} anchor="middle" cls="num" en="all refresh at once" vi="cùng làm mới một lúc" />
      <rect x="772" y="86" width="56" height="52" rx="8" class="box is-red" />
      <DiagramIcon name="db" x={800} y={112} size={34} />
      <NfrText x={800} y={158} anchor="middle" cls="is-red" en="Locks up" vi="Bị khóa cứng" />
      <NfrText x={488} y={186} cls="s" en="Same query, same code. Only the load changed." vi="Cùng câu truy vấn, cùng code. Chỉ có tải là khác." />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Nothing in the code is wrong. The load is what breaks it.</span>
    <span data-lang-vi>Code không sai chỗ nào. Chính tải mới làm nó đổ.</span>
  </figcaption>
</figure>
