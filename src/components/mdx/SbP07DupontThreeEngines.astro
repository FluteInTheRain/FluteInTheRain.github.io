---
// DuPont decomposition of an identical 20% ROE across three different business engines.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 285;

const ENGINES = [
  {
    x: 20, w: 268, accent: false, icon: 'layers',
    tEn: '1. Wide-Moat Software', tVi: '1. Phần mềm biên dày',
    mEn: 'Net Margin: 20.0%', mVi: 'Biên lãi ròng: 20,0%',
    aEn: 'Asset Turnover: 0.80×', aVi: 'Vòng quay TS: 0,80×',
    lEn: 'Leverage (Assets/Eq): 1.25×', lVi: 'Đòn bẩy (TS/VCSH): 1,25×',
    rEn: 'ROE = 20% (Fortress cash)', rVi: 'ROE = 20% (Rất an toàn)',
  },
  {
    x: 316, w: 268, accent: false, icon: 'coin',
    tEn: '2. High-Velocity Retail', tVi: '2. Bán lẻ quay vòng nhanh',
    mEn: 'Net Margin: 4.0%', mVi: 'Biên lãi ròng: 4,0%',
    aEn: 'Asset Turnover: 2.50×', aVi: 'Vòng quay TS: 2,50×',
    lEn: 'Leverage (Assets/Eq): 2.00×', lVi: 'Đòn bẩy (TS/VCSH): 2,00×',
    rEn: 'ROE = 20% (Fast inventory)', rVi: 'ROE = 20% (Xoay hàng nhanh)',
  },
  {
    x: 612, w: 268, accent: true, icon: 'warning',
    tEn: '3. Heavily Leveraged Firm', tVi: '3. Dùng đòn bẩy nợ cực cao',
    mEn: 'Net Margin: 4.0%', mVi: 'Biên lãi ròng: 4,0%',
    aEn: 'Asset Turnover: 0.625×', aVi: 'Vòng quay TS: 0,625×',
    lEn: 'Leverage (Assets/Eq): 8.00×', lVi: 'Đòn bẩy (TS/VCSH): 8,00×',
    rEn: 'ROE = 20% (Thin equity!)', rVi: 'ROE = 20% (Rủi ro đòn bẩy!)',
  },
] as const;
---
<figure class="sbp7-dup">
  <div class="sbp7-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three firms all earning 20% ROE via DuPont (Margin × Turnover × Leverage): wide-moat software (20% margin × 0.8 × 1.25), fast retail (4% × 2.5 × 2.0), and high-leverage borrower (4% × 0.625 × 8.0).">
      <text x="20" y="30" class="sbp7-title">
        <tspan data-lang-en>Same 20% ROE, three completely different risks (DuPont = Margin × Turnover × Leverage)</tspan>
        <tspan data-lang-vi>Cùng đạt ROE 20%, ba rủi ro khác hẳn nhau (DuPont = Biên lãi × Vòng quay × Đòn bẩy)</tspan>
      </text>

      {ENGINES.map((e) => (
        <g>
          <rect x={e.x} y="56" width={e.w} height="206" rx="10" class={e.accent ? 'sbp7-card-red' : 'sbp7-card'} />
          <DiagramIcon name={e.icon} x={e.x + 28} y={84} size={22} />
          <text x={e.x + 50} y="88" class={e.accent ? 'sbp7-hdr sbp7-red' : 'sbp7-hdr'}>
            <tspan data-lang-en>{e.tEn}</tspan>
            <tspan data-lang-vi>{e.tVi}</tspan>
          </text>
          <text x={e.x + 18} y="126" class="sbp7-body">
            <tspan data-lang-en>{e.mEn}</tspan>
            <tspan data-lang-vi>{e.mVi}</tspan>
          </text>
          <text x={e.x + 18} y="156" class="sbp7-body">
            <tspan data-lang-en>{e.aEn}</tspan>
            <tspan data-lang-vi>{e.aVi}</tspan>
          </text>
          <text x={e.x + 18} y="186" class={e.accent ? 'sbp7-body sbp7-red' : 'sbp7-body'}>
            <tspan data-lang-en>{e.lEn}</tspan>
            <tspan data-lang-vi>{e.lVi}</tspan>
          </text>
          <line x1={e.x + 16} y1="208" x2={e.x + e.w - 16} y2="208" class="sbp7-sep" />
          <text x={e.x + 18} y="238" class={e.accent ? 'sbp7-sub sbp7-red' : 'sbp7-sub'}>
            <tspan data-lang-en>{e.rEn}</tspan>
            <tspan data-lang-vi>{e.rVi}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Never worship headline ROE blindly. Two companies both posting 20% ROE can represent either a fortress cash-rich software moat (1.25× leverage) or an exposed operator stretched 8× on borrowed money (outside regulated deposit banks).</span>
    <span data-lang-vi>Đừng nhìn con số ROE 20% một cách máy móc. Hai công ty cùng có ROE 20% có thể là một hãng phần mềm ít nợ vay (đòn bẩy 1,25×) hoặc một công ty phi tài chính đang gồng đòn bẩy nợ tới 8×.</span>
  </figcaption>
</figure>

<style>
  .sbp7-dup { margin: 2em 0; width: 100%; }
  .sbp7-scroll { overflow-x: auto; }
  .sbp7-dup svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sbp7-dup text { font-size: 12.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .sbp7-title { font-size: 15.5px; font-weight: 700; fill: var(--text); }
  .sbp7-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .sbp7-card-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .sbp7-hdr { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .sbp7-red { fill: var(--red); }
  .sbp7-body { font-size: 12.8px; fill: var(--text-body); }
  .sbp7-sub { font-size: 12.5px; font-weight: 700; fill: var(--text); }
  .sbp7-sep { stroke: var(--border); stroke-width: 1; }
  .sbp7-dup figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
