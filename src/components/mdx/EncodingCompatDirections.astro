---
// Picture-first overview of the two compatibility directions. Plain inline SVG, site tokens, no ids.
import DiagramIcon from './DiagramIcon.astro';

const panels = [
  { x: 20, data: ['Old data', 'Dữ liệu cũ'], code: ['New code', 'Code mới'], ver: 'v2', dataVer: 'v1',
    h: ['Backward compatible', 'Tương thích ngược'], s: ['New code reads old data.', 'Code mới đọc dữ liệu cũ.'],
    s2: ['Usually easy: you knew the old format.', 'Thường dễ: bạn đã biết định dạng cũ.'] },
  { x: 460, data: ['New data', 'Dữ liệu mới'], code: ['Old code', 'Code cũ'], ver: 'v1', dataVer: 'v2',
    h: ['Forward compatible', 'Tương thích xuôi'], s: ['Old code reads new data.', 'Code cũ đọc dữ liệu mới.'],
    s2: ['Harder: it meets things it never saw.', 'Khó hơn: nó gặp thứ chưa từng thấy.'] },
];
---
<figure class="cd">
  <div class="cd-scroll">
  <svg viewBox="0 0 900 230" role="img" aria-label="Two compatibility directions. Backward compatible: new code on version 2 reads old data written by version 1, which is usually easy. Forward compatible: old code on version 1 reads new data written by version 2, which is harder because it meets fields it has never seen.">
    {panels.map((p) => (
      <g>
        <rect x={p.x} y="20" width="420" height="190" rx="5" class="cd-panel" />
        <text x={p.x + 16} y="46" class="cd-h">
          <tspan data-lang-en>{p.h[0]}</tspan>
          <tspan data-lang-vi>{p.h[1]}</tspan>
        </text>
        <rect x={p.x + 16} y="68" width="150" height="64" rx="5" class="cd-box" />
        <DiagramIcon name="file" x={p.x + 44} y={100} size={28} />
        <text x={p.x + 68} y="96" class="cd-title">
          <tspan data-lang-en>{p.data[0]}</tspan>
          <tspan data-lang-vi>{p.data[1]}</tspan>
        </text>
        <text x={p.x + 68} y="116" class="cd-small">{`schema ${p.dataVer}`}</text>
        <path d={`M${p.x + 168},100 L${p.x + 218},100`} class="cd-arrow" />
        <polygon points={`${p.x + 217},95 ${p.x + 217},105 ${p.x + 226},100`} class="cd-head" />
        <text x={p.x + 197} y="90" text-anchor="middle" class="cd-small">
          <tspan data-lang-en>read by</tspan>
          <tspan data-lang-vi>đọc bởi</tspan>
        </text>
        <rect x={p.x + 228} y="68" width="176" height="64" rx="5" class="cd-box" />
        <DiagramIcon name="server" x={p.x + 256} y={100} size={28} />
        <text x={p.x + 280} y="96" class="cd-title">
          <tspan data-lang-en>{p.code[0]}</tspan>
          <tspan data-lang-vi>{p.code[1]}</tspan>
        </text>
        <text x={p.x + 280} y="116" class="cd-small">{`schema ${p.ver}`}</text>
        <text x={p.x + 16} y="166" class="cd-title">
          <tspan data-lang-en>{p.s[0]}</tspan>
          <tspan data-lang-vi>{p.s[1]}</tspan>
        </text>
        <text x={p.x + 16} y="188" class="cd-small">
          <tspan data-lang-en>{p.s2[0]}</tspan>
          <tspan data-lang-vi>{p.s2[1]}</tspan>
        </text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Both directions happen during any rolling deploy, rollback or slow client update. Knight Capital broke the right-hand one.</span>
    <span data-lang-vi>Cả hai chiều đều xảy ra trong mọi đợt rolling deploy, rollback hay lúc client cập nhật chậm. Knight Capital làm hỏng chiều bên phải.</span>
  </figcaption>
</figure>

<style>
  .cd { margin: 2em 0; width: 100%; }
  .cd-scroll { overflow-x: auto; }
  .cd svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .cd text { font-size: 13px; fill: var(--text-body); }
  .cd .cd-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .cd .cd-title { font-size: 14px; font-weight: 700; fill: var(--text); }
  .cd .cd-small { font-size: 12.5px; fill: var(--text-muted); }
  .cd-panel { fill: none; stroke: var(--border); stroke-width: 1.2; }
  .cd-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .cd-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .cd-head { fill: var(--text-muted); }
  .cd figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
