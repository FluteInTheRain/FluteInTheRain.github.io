---
// Hedged request path: the client asks replica A; A is stalled (e.g. a GC pause).
// After a short wait the client asks replica B, takes the first answer and cancels the other.
// Schematic: no real timings. The real numbers are in the post text.
const W = 900;
const H = 300;
const L = 150;
const R = W - 30;
const rows = [
  { y: 70, en: 'Client', vi: 'Client' },
  { y: 150, en: 'Replica A', vi: 'Replica A' },
  { y: 230, en: 'Replica B', vi: 'Replica B' },
];
const x0 = L + 20; // request sent
const xHedge = L + 250; // wait expires
const xB = L + 470; // B answers
---
<figure class="hedge">
  <div class="hedge-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A hedged request: the client sends a request to replica A, which is stalled. After a short wait the client sends the same request to replica B. B answers first, the client uses that answer and cancels the request to A.">
      <defs>
        <marker id="hedge-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" class="hedge-arrowhead" />
        </marker>
      </defs>
      {rows.map((r) => (
        <g>
          <text x="20" y={r.y + 5} class="hedge-h">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          <line x1={L} x2={R} y1={r.y} y2={r.y} class="hedge-lane" />
        </g>
      ))}

      {/* request to A */}
      <line x1={x0} y1="70" x2={x0 + 8} y2="150" class="hedge-msg" marker-end="url(#hedge-arrow)" />
      <rect x={x0 + 8} y="136" width={R - x0 - 40} height="28" rx="4" class="hedge-slow" />
      <text x={xB + 16} y="155" class="hedge-note">
        <tspan data-lang-en>Stalled: GC pause or a long queue</tspan>
        <tspan data-lang-vi>Bị kẹt (GC pause, hàng đợi)</tspan>
      </text>

      {/* wait */}
      <rect x={x0} y="52" width={xHedge - x0} height="36" rx="4" class="hedge-wait" />
      <text x={(x0 + xHedge) / 2} y="75" text-anchor="middle" class="hedge-note">
        <tspan data-lang-en>Wait up to p95</tspan>
        <tspan data-lang-vi>Chờ tới mốc p95</tspan>
      </text>

      {/* hedge to B */}
      <line x1={xHedge} y1="70" x2={xHedge + 8} y2="230" class="hedge-msg" marker-end="url(#hedge-arrow)" />
      <rect x={xHedge + 8} y="216" width={xB - xHedge - 8} height="28" rx="4" class="hedge-fast" />
      <text x={(xHedge + 8 + xB) / 2} y="235" text-anchor="middle" class="hedge-note">
        <tspan data-lang-en>Same request, runs normally</tspan>
        <tspan data-lang-vi>Cùng request, chạy bình thường</tspan>
      </text>

      {/* answer back */}
      <line x1={xB} y1="230" x2={xB + 8} y2="74" class="hedge-ok" marker-end="url(#hedge-arrow)" />
      <text x={xB + 20} y="60" class="hedge-h">
        <tspan data-lang-en>First answer wins</tspan>
        <tspan data-lang-vi>Ai trả lời trước thì dùng</tspan>
      </text>
      <text x={xB + 20} y="104" class="hedge-note">
        <tspan data-lang-en>Cancel the request to A</tspan>
        <tspan data-lang-vi>Hủy request gửi A</tspan>
      </text>
    </svg>
  </div>
</figure>

<style>
  .hedge { margin: 2em 0; width: 100%; }
  .hedge-scroll { overflow-x: auto; }
  .hedge svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .hedge text { font-size: 14px; fill: var(--text-body); }
  .hedge .hedge-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .hedge .hedge-note { font-size: 13px; fill: var(--text-body); }
  .hedge-lane { stroke: var(--border); stroke-width: 1; stroke-dasharray: 3 4; }
  .hedge-msg { stroke: var(--text-muted); stroke-width: 1.8; }
  .hedge-ok { stroke: var(--text); stroke-width: 2.2; }
  .hedge-arrowhead { fill: var(--text-muted); }
  .hedge-slow { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1; }
  .hedge-fast { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1; }
  .hedge-wait { fill: none; stroke: var(--border); stroke-width: 1; stroke-dasharray: 4 3; }
</style>
