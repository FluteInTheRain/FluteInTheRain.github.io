---
// The anatomy of one real error object from the 422 body (captured in the
// post): loc points at the field, type names the broken rule, msg is the
// human sentence. The three key names are the only red.
const W = 900, H = 290;
const lines = [
  { y: 96, key: '{', rest: '' },
  { y: 123, key: '"type"', rest: ': "string_too_short",' },
  { y: 150, key: '"loc"', rest: ': ["body", "title"],' },
  { y: 177, key: '"msg"', rest: ': "String should have at least 3 characters",' },
  { y: 204, key: '"input"', rest: ': "??"' },
  { y: 231, key: '}', rest: '' },
];
const notes = [
  { lineY: 123, rowY: 123, key: 'type', head: { en: ' — which rule failed', vi: ' — luật nào bị vi phạm' }, sub: { en: 'stable and machine-readable — branch on it', vi: 'ổn định, máy đọc được — cứ rẽ nhánh theo nó' } },
  { lineY: 150, rowY: 162, key: 'loc', head: { en: ' — where in the request', vi: ' — nằm đâu trong request' }, sub: { en: 'body → the title field', vi: 'body → field title' } },
  { lineY: 177, rowY: 201, key: 'msg', head: { en: ' — a sentence for humans', vi: ' — câu viết cho người đọc' }, sub: { en: 'show it, don\u2019t parse it', vi: 'hiển thị, đừng parse nó' } },
  { lineY: 204, rowY: 240, key: 'input', head: { en: ' — the offending value', vi: ' — giá trị gây lỗi' }, sub: { en: 'echoed back for debugging', vi: 'trả lại để dễ debug' } },
];
const leaders = notes.map((n) =>
  n.lineY === n.rowY
    ? `M 452 ${n.lineY} L 492 ${n.rowY}`
    : `M 452 ${n.lineY} L 472 ${n.lineY} L 472 ${n.rowY} L 492 ${n.rowY}`,
);
---
<figure class="bep3c">
  <div class="bep3c-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="One error object from the real 422 response: type names the failed rule, loc points at the body's title field, msg is the human sentence, input echoes the offending value.">
    <rect x="40" y="36" width="410" height="218" rx="8" class="card" />
    <text x="58" y="62" class="m"><tspan data-lang-en>one error object from the 422 body</tspan><tspan data-lang-vi>một object lỗi trong body 422</tspan></text>
    {lines.map((l) => (
      <text x="58" y={l.y} class="j">
        <tspan class={l.key.startsWith('"') ? 'rk' : ''}>{l.key}</tspan><tspan>{l.rest}</tspan>
      </text>
    ))}
    {leaders.map((d, i) => (<path d={d} class="ld" />))}
    {notes.map((n) => (
      <g>
        <text x="500" y={n.rowY} class="t"><tspan class="rk">{n.key}</tspan><tspan data-lang-en>{n.head.en}</tspan><tspan data-lang-vi>{n.head.vi}</tspan></text>
        <text x="500" y={n.rowY + 20} class="m"><tspan data-lang-en>{n.sub.en}</tspan><tspan data-lang-vi>{n.sub.vi}</tspan></text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The 422 body is not a string — it's a list of these objects, one per broken rule. Your frontend can branch on type, jump to loc, and show msg as-is.</span>
    <span data-lang-vi>Body của 422 không phải một chuỗi — nó là danh sách các object kiểu này, mỗi object một luật bị vi phạm. Frontend có thể rẽ nhánh theo type, nhảy tới loc, và hiển thị msg nguyên xi.</span>
  </figcaption>
</figure>

<style>
  .bep3c { margin: 2em 0; width: 100%; }
  .bep3c-scroll { overflow-x: auto; }
  .bep3c svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep3c text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep3c .j { fill: var(--text-body); }
  .bep3c .rk { fill: var(--red); font-weight: 700; }
  .bep3c .t { font-weight: 700; fill: var(--text); }
  .bep3c .m { fill: var(--text-muted); font-size: 12.5px; }
  .bep3c .card { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep3c .ld { stroke: var(--text-muted); stroke-width: 1.2; fill: none; }
  .bep3c figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
