---
import DiagramIcon from './DiagramIcon.astro';
// The same four events replayed from the HOSE example book (python, ofi.py):
//   start bid 100@40,650 / ask 900@40,800
//   1 buy 1,000        -> e=+900, cum +900,  best ask 40,850 x400, mid +25
//   2 new sell 300 at best ask -> e=-300, cum +600, mid +25
//   3 cancel 100 at best bid   -> e=-100, cum +500, best bid 40,600 x300, mid 0
//   4 new buy 500 inside the spread (40,650) -> e=+500, cum +1000, mid +25
// Queue imbalance I = (bid qty - ask qty)/(bid qty + ask qty) at the best prices.
const W = 900, H = 436;
const cols = [
  { en: 'start', vi: 'bắt đầu', I: -0.8, e: null, cum: 0, mid: 0 },
  { en: 'buy 1,000', vi: 'mua 1.000', I: -0.6, e: 900, cum: 900, mid: 25 },
  { en: 'new sell 300', vi: 'bán mới 300', I: -0.75, e: -300, cum: 600, mid: 25 },
  { en: 'cancel bid 100', vi: 'huỷ mua 100', I: -0.4, e: -100, cum: 500, mid: 0 },
  { en: 'new bid 500', vi: 'mua mới 500', I: -0.167, e: 500, cum: 1000, mid: 25 },
];
const cx = (i: number) => 280 + i * 138;
const sgn = (n: number) => (n > 0 ? '+' : n < 0 ? '−' : '') + Math.abs(n).toLocaleString('en-US');
const sgnVi = (n: number) => sgn(n).replace(/,/g, '.');
---
<figure class="f">
  <div class="f-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four order book events in a row, with three readings after each. Queue imbalance at the best prices stays negative the whole time: minus 0.8, minus 0.6, minus 0.75, minus 0.4, minus 0.17. Cumulative order flow imbalance goes 0, plus 900, plus 600, plus 500, plus 1,000 shares. The mid-price relative to the start goes 0, plus 25, plus 25, 0, plus 25 dong.">
    <DiagramIcon name="scale" x={24} y={20} size={22} />
    <text x="46" y="26" class="f-h"><tspan data-lang-en>A snapshot and a flow can disagree</tspan><tspan data-lang-vi>Ảnh chụp và dòng chảy có thể nói khác nhau</tspan></text>
    {cols.map((c, i) => (
      <g>
        <text x={cx(i)} y="58" text-anchor="middle" class="f-ann"><tspan data-lang-en>{c.en}</tspan><tspan data-lang-vi>{c.vi}</tspan></text>
        <text x={cx(i)} y="76" text-anchor="middle" class="f-sub">{i === 0 ? '' : <><tspan data-lang-en>{`event ${i}`}</tspan><tspan data-lang-vi>{`sự kiện ${i}`}</tspan></>}</text>
      </g>
    ))}

    <text x="20" y="116" class="f-ann"><tspan data-lang-en>Queue imbalance</tspan><tspan data-lang-vi>Mất cân bằng hàng chờ</tspan></text>
    <text x="20" y="134" class="f-sub"><tspan data-lang-en>(bid − ask)/(bid + ask),</tspan><tspan data-lang-vi>(mua − bán)/(mua + bán),</tspan></text>
    <text x="20" y="150" class="f-sub"><tspan data-lang-en>best prices only</tspan><tspan data-lang-vi>chỉ ở giá tốt nhất</tspan></text>
    <line x1="230" x2="880" y1="104" y2="104" class="f-axis" />
    {cols.map((c, i) => (
      <g>
        <rect x={cx(i) - 22} y="104" width="44" height={-c.I * 70} class="f-ask" />
        <text x={cx(i)} y={104 + -c.I * 70 + 16} text-anchor="middle" class="f-qty">{c.I.toFixed(2).replace('-', '−')}</text>
      </g>
    ))}

    <text x="20" y="262" class="f-ann"><tspan data-lang-en>Cumulative order flow</tspan><tspan data-lang-vi>Dòng lệnh cộng dồn</tspan></text>
    <text x="20" y="280" class="f-sub"><tspan data-lang-en>imbalance (shares)</tspan><tspan data-lang-vi>mất cân bằng (cổ phiếu)</tspan></text>
    <line x1="230" x2="880" y1="300" y2="300" class="f-axis" />
    {cols.map((c, i) => (
      <g>
        <rect x={cx(i) - 22} y={300 - c.cum * 0.06} width="44" height={Math.max(c.cum * 0.06, 1)} class="f-bid" />
        <text x={cx(i)} y={300 - c.cum * 0.06 - 8} text-anchor="middle" class="f-qty"><tspan data-lang-en>{c.cum === 0 ? '0' : sgn(c.cum)}</tspan><tspan data-lang-vi>{c.cum === 0 ? '0' : sgnVi(c.cum)}</tspan></text>
        {c.e !== null && <text x={cx(i)} y="320" text-anchor="middle" class="f-sub"><tspan data-lang-en>this event {sgn(c.e)}</tspan><tspan data-lang-vi>lệnh này {sgnVi(c.e)}</tspan></text>}
      </g>
    ))}

    <text x="20" y="372" class="f-ann"><tspan data-lang-en>Mid-price vs start</tspan><tspan data-lang-vi>Giá giữa so với lúc đầu</tspan></text>
    <text x="20" y="390" class="f-sub"><tspan data-lang-en>(VND)</tspan><tspan data-lang-vi>(đồng)</tspan></text>
    <line x1="230" x2="880" y1="404" y2="404" class="f-axis" />
    {cols.map((c, i) => (
      <g>
        <rect x={cx(i) - 22} y={404 - c.mid * 0.9} width="44" height={Math.max(c.mid * 0.9, 1.5)} class="f-bid" />
        <text x={cx(i)} y={404 - c.mid * 0.9 - 6} text-anchor="middle" class="f-qty">{c.mid === 0 ? '0' : sgn(c.mid)}</text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Each event comes from the same book as the previous figure. The snapshot says the ask side is heavier at every step, while the flow of events leans toward buying and the mid-price ends half a price step higher.</span>
    <span data-lang-vi>Mỗi sự kiện lấy từ cùng cuốn sổ lệnh ở hình trước. Ảnh chụp luôn nói phía bán nặng hơn, trong khi dòng sự kiện nghiêng về phía mua và giá giữa cuối cùng cao hơn nửa bước giá.</span>
  </figcaption>
</figure>

<style>
  .f { margin: 2em 0; width: 100%; }
  .f-scroll { overflow-x: auto; }
  .f svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .f text { font-size: 14px; fill: var(--text-body); }
  .f .f-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .f .f-sub { font-size: 12.5px; fill: var(--text-muted); }
  .f .f-price { font-size: 14px; font-weight: 600; fill: var(--text); }
  .f .f-qty { font-size: 13px; font-weight: 600; fill: var(--text); }
  .f .f-faint { font-size: 12px; fill: var(--text-muted); font-style: italic; }
  .f .f-ann { font-size: 13.5px; font-weight: 600; fill: var(--text); }
  .f .f-ann.is-ask, .f .f-ann.is-red { fill: var(--red); }
  .f .f-ann.is-bid, .f .f-ann.is-green { fill: var(--act-2); }
  .f .f-ann.is-gold { fill: var(--gold-icon); }
  .f .f-mid-t { font-size: 13px; font-weight: 700; fill: var(--text); }
  .f-ask { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; }
  .f-bid { fill: color-mix(in srgb, var(--act-2) 16%, var(--bg)); stroke: var(--act-2); stroke-width: 1.3; }
  .f-empty { fill: none; stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .f-gone { fill: none; stroke: var(--red); stroke-width: 1.3; stroke-dasharray: 4 4; }
  .f-mid { stroke: var(--gold); stroke-width: 1.8; stroke-dasharray: 6 4; }
  .f-lead { stroke: var(--text-muted); stroke-width: 1.2; fill: none; }
  .f-panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .f-card { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .f-arrow { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.3; }
  .f-axis { stroke: var(--border); stroke-width: 1.4; }
  .f-grid { stroke: var(--border); stroke-width: 1; stroke-dasharray: 3 4; }
  .f figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
