---
// Chapter 8: Four ways to separate items — borders everywhere (noisy)
// vs box shadow, alternating surface tone, and extra whitespace.
// Plain inline SVG using site CSS tokens; unique SVG filter ID per instance.

const W = 900;
const H = 350;
const uid = Math.random().toString(36).slice(2, 8);
const shadowId = `fba-shadow-${uid}`;
---
<figure class="fba">
  <div class="fba-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four-panel comparison showing the same three-item list separated by heavy 1px borders everywhere, subtle drop shadows, alternating background tones, and generous whitespace alone.">
      <defs>
        <filter id={shadowId} x="-10%" y="-15%" width="120%" height="145%">
          <feDropShadow dx="0" dy="3" stdDeviation="4" flood-color="#000000" flood-opacity="0.10" />
        </filter>
      </defs>

      {/* Panel 1: Borders everywhere (avoid) */}
      <g transform="translate(16, 16)">
        <text x="0" y="16" class="fba-title is-warn">
          <tspan data-lang-en>1. Borders everywhere</tspan>
          <tspan data-lang-vi>1. Viền bao quanh mọi thứ</tspan>
        </text>
        <rect x="0" y="30" width="204" height="248" rx="8" class="fba-canvas" />
        {[0, 1, 2].map((i) => (
          <g transform={`translate(12, ${46 + i * 74})`}>
            <rect x="0" y="0" width="180" height="62" rx="4" class="fba-box-heavy" />
            <text x="12" y="25" class="fba-item-title">
              <tspan data-lang-en>{i === 0 ? 'Billing webhook' : i === 1 ? 'Auth token sync' : 'Daily digest'}</tspan>
              <tspan data-lang-vi>{i === 0 ? 'Webhook thanh toán' : i === 1 ? 'Đồng bộ token' : 'Báo cáo ngày'}</tspan>
            </text>
            <text x="12" y="46" class="fba-item-sub">
              <tspan data-lang-en>{i === 0 ? '2 ms ago' : i === 1 ? '14 min ago' : '2 hr ago'}</tspan>
              <tspan data-lang-vi>{i === 0 ? '2 ms trước' : i === 1 ? '14 phút trước' : '2 giờ trước'}</tspan>
            </text>
          </g>
        ))}
        <text x="0" y="302" class="fba-foot is-warn">
          <tspan data-lang-en>Visual cage of lines</tspan>
          <tspan data-lang-vi>Rối mắt vì quá nhiều đường kẻ</tspan>
        </text>
      </g>

      {/* Panel 2: Subtle shadow */}
      <g transform="translate(238, 16)">
        <text x="0" y="16" class="fba-title">
          <tspan data-lang-en>2. Subtle elevation</tspan>
          <tspan data-lang-vi>2. Đổ bóng nhẹ</tspan>
        </text>
        <rect x="0" y="30" width="204" height="248" rx="8" class="fba-canvas-tint" />
        {[0, 1, 2].map((i) => (
          <g transform={`translate(12, ${46 + i * 74})`}>
            <rect x="0" y="0" width="180" height="60" rx="6" class="fba-box-card" filter={`url(#${shadowId})`} />
            <text x="12" y="25" class="fba-item-title">
              <tspan data-lang-en>{i === 0 ? 'Billing webhook' : i === 1 ? 'Auth token sync' : 'Daily digest'}</tspan>
              <tspan data-lang-vi>{i === 0 ? 'Webhook thanh toán' : i === 1 ? 'Đồng bộ token' : 'Báo cáo ngày'}</tspan>
            </text>
            <text x="12" y="45" class="fba-item-sub">
              <tspan data-lang-en>{i === 0 ? '2 ms ago' : i === 1 ? '14 min ago' : '2 hr ago'}</tspan>
              <tspan data-lang-vi>{i === 0 ? '2 ms trước' : i === 1 ? '14 phút trước' : '2 giờ trước'}</tspan>
            </text>
          </g>
        ))}
        <text x="0" y="302" class="fba-foot">
          <tspan data-lang-en>Edges feel light, not boxed</tspan>
          <tspan data-lang-vi>Tách khối nhẹ, không bị đóng khung</tspan>
        </text>
      </g>

      {/* Panel 3: Adjacent background tones */}
      <g transform="translate(460, 16)">
        <text x="0" y="16" class="fba-title">
          <tspan data-lang-en>3. Surface tone shift</tspan>
          <tspan data-lang-vi>3. Đổi tông màu nền</tspan>
        </text>
        <rect x="0" y="30" width="204" height="248" rx="8" class="fba-canvas" />
        {[0, 1, 2].map((i) => (
          <g transform={`translate(10, ${44 + i * 72})`}>
            <rect x="0" y="0" width="184" height="66" rx="6" class={i % 2 === 0 ? 'fba-band-alt' : 'fba-band-plain'} />
            <text x="12" y="26" class="fba-item-title">
              <tspan data-lang-en>{i === 0 ? 'Billing webhook' : i === 1 ? 'Auth token sync' : 'Daily digest'}</tspan>
              <tspan data-lang-vi>{i === 0 ? 'Webhook thanh toán' : i === 1 ? 'Đồng bộ token' : 'Báo cáo ngày'}</tspan>
            </text>
            <text x="12" y="47" class="fba-item-sub">
              <tspan data-lang-en>{i === 0 ? '2 ms ago' : i === 1 ? '14 min ago' : '2 hr ago'}</tspan>
              <tspan data-lang-vi>{i === 0 ? '2 ms trước' : i === 1 ? '14 phút trước' : '2 giờ trước'}</tspan>
            </text>
          </g>
        ))}
        <text x="0" y="302" class="fba-foot">
          <tspan data-lang-en>Zero lines, clear rows</tspan>
          <tspan data-lang-vi>Không đường kẻ, vẫn rõ hàng</tspan>
        </text>
      </g>

      {/* Panel 4: Extra whitespace */}
      <g transform="translate(682, 16)">
        <text x="0" y="16" class="fba-title">
          <tspan data-lang-en>4. Extra spacing</tspan>
          <tspan data-lang-vi>4. Tăng khoảng trống</tspan>
        </text>
        <rect x="0" y="30" width="202" height="248" rx="8" class="fba-canvas" />
        {[0, 1, 2].map((i) => (
          <g transform={`translate(16, ${54 + i * 74})`}>
            <text x="0" y="14" class="fba-item-title">
              <tspan data-lang-en>{i === 0 ? 'Billing webhook' : i === 1 ? 'Auth token sync' : 'Daily digest'}</tspan>
              <tspan data-lang-vi>{i === 0 ? 'Webhook thanh toán' : i === 1 ? 'Đồng bộ token' : 'Báo cáo ngày'}</tspan>
            </text>
            <text x="0" y="34" class="fba-item-sub">
              <tspan data-lang-en>{i === 0 ? '2 ms ago' : i === 1 ? '14 min ago' : '2 hr ago'}</tspan>
              <tspan data-lang-vi>{i === 0 ? '2 ms trước' : i === 1 ? '14 phút trước' : '2 giờ trước'}</tspan>
            </text>
          </g>
        ))}
        <text x="0" y="302" class="fba-foot">
          <tspan data-lang-en>Proximity groups each row</tspan>
          <tspan data-lang-vi>Khoảng cách tự tách nhóm</tspan>
        </text>
      </g>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Three borderless ways to separate the exact same list. Reserve 1px dividers for places where shadow, surface tone, and spacing cannot carry the separation alone.</span>
    <span data-lang-vi>Ba cách tách cùng một danh sách mà không cần viền. Chỉ dùng đường kẻ 1px khi đổ bóng, đổi nền và khoảng trắng vẫn chưa đủ rõ ràng.</span>
  </figcaption>
</figure>

<style>
  .fba { margin: 2em 0; width: 100%; }
  .fba-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .fba svg { width: 100%; min-width: 640px; height: auto; display: block; font-family: inherit; }

  .fba-title { font-size: 14.5px; font-weight: 600; fill: var(--text); }
  .fba-title.is-warn { fill: var(--red); }

  .fba-canvas { fill: var(--bg); stroke: var(--border); stroke-width: 1; }
  .fba-canvas-tint { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }

  .fba-box-heavy { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.4; }
  .fba-box-card { fill: var(--bg); stroke: var(--border); stroke-width: 0.75; }

  .fba-band-alt { fill: var(--bg-alt); }
  .fba-band-plain { fill: transparent; }

  .fba-item-title { font-size: 13.5px; font-weight: 600; fill: var(--text); }
  .fba-item-sub { font-size: 12.5px; fill: var(--text-muted); }

  .fba-foot { font-size: 12.5px; fill: var(--text-muted); }
  .fba-foot.is-warn { fill: var(--red); }

  .fba figcaption { margin-top: 0.8em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
