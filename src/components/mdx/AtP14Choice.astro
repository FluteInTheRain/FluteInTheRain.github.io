---
// A decision strip: what the rows look like decides whether a deep net is worth trying.
// Sourced facts: Gu, Kelly & Xiu (2020): trees and neural networks were the best performers on tabular stock data;
// Grinsztajn, Oyallon & Varoquaux (2022): tree-based models stay state of the art on medium-sized (about 10K samples) tabular data.
// The row thresholds are the post's own reading, not a figure from either paper.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 380;
const cards = [
  {
    x: 20, icon: 'stop', tone: 'bad',
    q: { en: 'A few hundred to a few thousand rows', vi: 'Vài trăm đến vài nghìn dòng' },
    a: { en: 'Skip the net', vi: 'Bỏ qua mạng nơ-ron' },
    why: { en: 'Weights outnumber rows (Section 3). Use a linear model or a shallow tree.', vi: 'Trọng số nhiều hơn dòng (Mục 3). Dùng mô hình tuyến tính hoặc cây nông.' },
  },
  {
    x: 315, icon: 'tree', tone: 'mid',
    q: { en: 'A table: one row per stock-month, many columns', vi: 'Một bảng: mỗi dòng một cổ phiếu-tháng, nhiều cột' },
    a: { en: 'Trees and linear first; net as a challenger', vi: 'Cây và tuyến tính trước; mạng làm đối thủ' },
    why: { en: 'Trees and nets led in Gu-Kelly-Xiu; trees still win on tabular data of about 10K rows (Grinsztajn).', vi: 'Cây và mạng dẫn đầu ở Gu-Kelly-Xiu; cây vẫn thắng trên dữ liệu bảng cỡ 10 nghìn dòng (Grinsztajn).' },
  },
  {
    x: 610, icon: 'model', tone: 'good',
    q: { en: 'Raw streams: tick prices, an order book', vi: 'Dữ liệu thô liên tục: giá từng tick, sổ lệnh' },
    a: { en: 'A net earns its cost', vi: 'Mạng nơ-ron xứng đáng với chi phí' },
    why: { en: 'Millions of rows and structure no hand-made feature captures. The next posts: sequence models, order flow.', vi: 'Hàng triệu dòng và cấu trúc mà feature làm tay không bắt được. Các bài sau: mô hình chuỗi, dòng lệnh.' },
  },
];
---
<figure class="atp14-ch">
  <div class="atp14-ch-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three cases. A few hundred to a few thousand rows: skip the net. A table with one row per stock-month: try linear models and trees first, with a net as a challenger. Raw streams such as tick prices or an order book: a deep net earns its cost.">
    <text x="20" y="26" class="h">
      <tspan data-lang-en>Look at the rows before you pick the model</tspan>
      <tspan data-lang-vi>Nhìn các dòng dữ liệu trước khi chọn mô hình</tspan>
    </text>
    <text x="20" y="46" class="sub">
      <tspan data-lang-en>A rule of thumb for this series, not a law.</tspan>
      <tspan data-lang-vi>Quy tắc ngón tay cái cho series này, không phải định luật.</tspan>
    </text>
    {cards.map((c) => (
      <g>
        <rect x={c.x} y="66" width="270" height="290" rx="6" class={`card ${c.tone}`} />
        <DiagramIcon name={c.icon as 'stop' | 'tree' | 'model'} x={c.x + 36} y={104} size={32} />
        <foreignObject x={c.x + 70} y="80" width="190" height="60">
          <div xmlns="http://www.w3.org/1999/xhtml" class="q">
            <span data-lang-en>{c.q.en}</span>
            <span data-lang-vi>{c.q.vi}</span>
          </div>
        </foreignObject>
        <line x1={c.x + 16} y1="156" x2={c.x + 254} y2="156" class="rule" />
        <foreignObject x={c.x + 16} y="166" width="240" height="56">
          <div xmlns="http://www.w3.org/1999/xhtml" class="a">
            <span data-lang-en>{c.a.en}</span>
            <span data-lang-vi>{c.a.vi}</span>
          </div>
        </foreignObject>
        <foreignObject x={c.x + 16} y="226" width="240" height="124">
          <div xmlns="http://www.w3.org/1999/xhtml" class="why">
            <span data-lang-en>{c.why.en}</span>
            <span data-lang-vi>{c.why.vi}</span>
          </div>
        </foreignObject>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Depth is not a goal. A net is a tool for inputs that a table cannot hold.</span>
    <span data-lang-vi>Độ sâu không phải mục tiêu. Mạng nơ-ron là công cụ cho loại đầu vào mà một cái bảng không chứa nổi.</span>
  </figcaption>
</figure>

<style>
  .atp14-ch { margin: 2em 0; width: 100%; }
  .atp14-ch-scroll { overflow-x: auto; }
  .atp14-ch svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp14-ch text { font-size: 14px; fill: var(--text-body); }
  .atp14-ch .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp14-ch .sub { font-size: 13px; fill: var(--text-muted); }
  .atp14-ch .card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .atp14-ch .card.bad { stroke: var(--red); stroke-dasharray: 4 3; }
  .atp14-ch .card.good { stroke: var(--gold); stroke-width: 1.8; }
  .atp14-ch .rule { stroke: var(--border); stroke-width: 1.2; }
  .atp14-ch .q { font-size: 13.5px; font-weight: 600; line-height: 1.35; color: var(--text-muted); font-family: inherit; }
  .atp14-ch .a { font-size: 16px; font-weight: 700; line-height: 1.3; color: var(--text); font-family: inherit; }
  .atp14-ch .why { font-size: 13.5px; line-height: 1.5; color: var(--text-body); font-family: inherit; }
  .atp14-ch figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
