---
// Same 12 stocks, only 20 days of returns, cut into 3 groups.
// Python (own agglomerative code, heights equal to scipy's):
//  single: [R4 R1 R2 R3] [B4] [S4 S2 S1 S3 B2 B1 B3]  -> 3 stocks in the wrong group
//  ward:   [R4 R1 R2 R3] [S4 S2 S1 S3] [B4 B2 B1 B3]  -> 0 wrong
const cols = { B: 'var(--act-3)', S: 'var(--act-1)', R: 'var(--act-2)' } as Record<string, string>;
const single = [['R4','R1','R2','R3'], ['B4'], ['S4','S2','S1','S3','B2','B1','B3']];
const ward = [['R4','R1','R2','R3'], ['S4','S2','S1','S3'], ['B4','B2','B1','B3']];
const W = 900, H = 340;
const panels = [
  { x: 20, groups: single, en: 'Single linkage, 20 days', vi: 'Single linkage, 20 ngày', bad: true,
    sumEn: 'Sizes 7, 4 and 1: steel and three banks end up together', sumVi: 'Cỡ 7, 4 và 1: thép và ba ngân hàng bị gộp chung' },
  { x: 460, groups: ward, en: 'Ward linkage, 20 days', vi: 'Ward linkage, 20 ngày', bad: false,
    sumEn: 'Groups of 4, 4 and 4: the three sectors, found exactly', sumVi: 'Các nhóm 4, 4 và 4: đúng ba ngành' },
];
const CHIP = 38;
---
<figure class="p10lk">
  <div class="p10lk-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two panels. With single linkage on 20 days the three groups have sizes 7, 4 and 1, and one group mixes four steel stocks with three bank stocks. With Ward linkage on the same 20 days the three groups are the three sectors, four stocks each.">
    <text x="20" y="28" class="p10lk-h">
      <tspan data-lang-en>Same data, two linkage rules, different answers</tspan>
      <tspan data-lang-vi>Cùng dữ liệu, hai cách nối cụm, hai đáp án</tspan>
    </text>
    {panels.map((p) => (
      <g>
        <rect x={p.x} y="46" width="420" height="234" rx="8" class={p.bad ? 'p10lk-panel is-bad' : 'p10lk-panel is-good'} />
        <text x={p.x + 16} y="74" class="p10lk-t">
          <tspan data-lang-en>{p.en}</tspan>
          <tspan data-lang-vi>{p.vi}</tspan>
        </text>
        {p.groups.map((g, gi) => (
          <g>
            {g.map((n, ni) => (
              <g>
                <rect x={p.x + 16 + (ni % 7) * (CHIP + 4)} y={92 + gi * 52 + Math.floor(ni / 7) * 0} width={CHIP} height="32" rx="16" class="p10lk-chip" style={`stroke:${cols[n[0]]}`} />
                <text x={p.x + 16 + (ni % 7) * (CHIP + 4) + CHIP / 2} y={113 + gi * 52} text-anchor="middle" class="p10lk-cn" style={`fill:${cols[n[0]]}`}>{n}</text>
              </g>
            ))}
          </g>
        ))}
        <text x={p.x + 16} y="264" class={p.bad ? 'p10lk-sum is-bad' : 'p10lk-sum'}>
          <tspan data-lang-en>{p.sumEn}</tspan>
          <tspan data-lang-vi>{p.sumVi}</tspan>
        </text>
      </g>
    ))}
    <text x="20" y="306" class="p10lk-s">
      <tspan data-lang-en>Single linkage joins two groups as soon as one pair is close, so a noisy pair can chain them. Ward weighs the whole group.</tspan>
      <tspan data-lang-vi>Single linkage nối hai nhóm ngay khi có một cặp gần nhau, nên một cặp nhiễu có thể kéo chúng thành dây chuyền. Ward cân cả nhóm.</tspan>
    </text>
    <text x="20" y="326" class="p10lk-s">
      <tspan data-lang-en>Colour = real sector: banks blue, steel olive, retail green.</tspan>
      <tspan data-lang-vi>Màu = ngành thật: ngân hàng xanh dương, thép vàng olive, bán lẻ xanh lá.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>With enough days (60 or more in this run) every linkage found the three sectors, so the damage comes from short history.</span>
    <span data-lang-vi>Có đủ ngày (từ 60 trở lên trong lần chạy này) thì mọi cách nối đều tìm đúng ba ngành, nên hại đến từ dữ liệu ngắn.</span>
  </figcaption>
</figure>

<style>
  .p10lk { margin: 2em 0; width: 100%; }
  .p10lk-scroll { overflow-x: auto; }
  .p10lk svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .p10lk text { font-size: 14px; fill: var(--text-body); }
  .p10lk .p10lk-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p10lk .p10lk-t { font-weight: 700; fill: var(--text); }
  .p10lk .p10lk-cn { font-size: 13px; font-weight: 700; }
  .p10lk .p10lk-sum { font-size: 13px; font-weight: 600; fill: var(--text); }
  .p10lk .p10lk-sum.is-bad { fill: var(--red); }
  .p10lk .p10lk-s { font-size: 12.5px; fill: var(--text-muted); }
  .p10lk-panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p10lk-panel.is-bad { stroke: var(--red); stroke-dasharray: 4 3; }
  .p10lk-panel.is-good { stroke: var(--gold); }
  .p10lk-chip { fill: var(--bg); stroke-width: 1.8; }
  .p10lk figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
