---
import DiagramIcon from './DiagramIcon.astro';
import NfrText from './NfrText.astro';
import NfrArrow from './NfrArrow.astro';
import NfrStep from './NfrStep.astro';
import './nfr-fig.css';
// The BigTable benchmark setup: one client read touches 100 servers, so the slowest one sets the time.
const W = 900;
const H = 320;
const CELL = 15;
const PITCH = 21;
const GX = 330;
const GY = 70;
const SLOW = 39;
const cells = Array.from({ length: 100 }, (_, i) => ({ x: GX + (i % 10) * PITCH, y: GY + Math.floor(i / 10) * PITCH, slow: i === SLOW }));
const sx = cells[SLOW].x + CELL / 2;
const sy = cells[SLOW].y + CELL / 2;
---
<figure class="nf">
  <div class="nf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A client reads 1,000 keys from a BigTable table spread over 100 servers, drawn as a 10 by 10 grid. 99 servers answer fast and 1 is slow. The read is only done when the slowest server answers.">
      <DiagramIcon name="laptop" x={60} y={178} size={34} />
      <NfrText x={60} y={218} anchor="middle" cls="n" en="Client" vi="Client" />
      <NfrText x={60} y={236} anchor="middle" cls="s" en="reads 1,000 keys" vi="đọc 1,000 key" />
      <NfrArrow x1={96} y1={178} x2={318} y2={178} />
      <DiagramIcon name="server" x={GX + 105} y={34} size={26} />
      <NfrText x={GX + 128} y={39} cls="h" en="100 BigTable servers" vi="100 server BigTable" />
      <rect x={GX - 8} y={GY - 8} width={10 * PITCH + 8} height={10 * PITCH + 8} rx="6" class="panel" />
      {cells.map((c) => <rect x={c.x} y={c.y} width={CELL} height={CELL} rx="2" class={c.slow ? 'bar is-red' : 'bar'} opacity={c.slow ? 1 : 0.55} />)}

      <NfrArrow x1={620} y1={sy} x2={sx + 12} y2={sy} tone="red" />
      <NfrText x={632} y={sy + 5} cls="is-red" en="1 slow server" vi="1 server chậm" />
      <NfrText x={632} y={sy + 22} cls="s" en="a queue or a pause" vi="hàng đợi hoặc một lần pause" />
      <NfrText x={632} y={80} cls="n" en="99 servers answer fast" vi="99 server trả lời nhanh" />
      <NfrText x={632} y={206} lh={18} en={['One read touches every server,', 'so the slowest one decides', 'when the answer is ready.']} vi={['Một lần đọc chạm mọi server,', 'nên server chậm nhất quyết định', 'khi nào có câu trả lời.']} />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>This is the 63% effect from earlier, set up as a real benchmark: 100 servers, one read.</span>
    <span data-lang-vi>Đây là hiệu ứng 63% ở trên, dựng thành một benchmark thật: 100 server, một lần đọc.</span>
  </figcaption>
</figure>
