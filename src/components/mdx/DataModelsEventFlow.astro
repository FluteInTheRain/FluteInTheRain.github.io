---
import DiagramIcon from './DiagramIcon.astro';
// Netflix downloads license service as the post describes it (Netflix Tech Blog, "Scaling Event
// Sourcing for Netflix Downloads"): client command -> command handler checks the rules ->
// event appended to the event store -> views built from the log, one per question.
// Arrowheads are polygons: no SVG ids.

const W = 900;
const H = 330;

type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}

type Box = { x: number; y: number; w: number; en: string; vi: string; subEn: string; subVi: string; hot?: boolean; icon: 'laptop' | 'worker' | 'log' | 'file' | 'chart' };
const bh = 60;
const boxes: Box[] = [
  { x: 20, y: 110, w: 168, en: 'Client', vi: 'Client', subEn: 'sends a command', subVi: 'gửi một command', icon: 'laptop' },
  { x: 212, y: 110, w: 190, en: 'Command handler', vi: 'Command handler', subEn: 'checks the rules', subVi: 'kiểm tra các luật', icon: 'worker' },
  { x: 445, y: 110, w: 190, en: 'Event store', vi: 'Event store', subEn: 'append-only log', subVi: 'log chỉ ghi nối thêm', hot: true, icon: 'log' },
  { x: 690, y: 52, w: 200, en: 'License view', vi: 'View license', subEn: 'current state', subVi: 'trạng thái hiện tại', icon: 'file' },
  { x: 690, y: 168, w: 200, en: 'Downloads view', vi: 'View lượt tải', subEn: 'by member and title', subVi: 'theo member và phim', icon: 'chart' },
];
const links: Pt[][] = [
  [[188, 140], [212, 140]],
  [[400, 140], [445, 140]],
  [[635, 130], [662, 130], [662, 82], [690, 82]],
  [[635, 150], [662, 150], [662, 198], [690, 198]],
];
---
<figure class="dmev">
  <div class="dmev-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The Netflix downloads license service as an event-sourced system. A client sends a command such as renew this license. The command handler checks the business rules against current state. If allowed, an event such as License Renewed is appended to the event store. Separate views, one for license state and one for downloads by member and title, are built from the events.">
    <text x="20" y="28" class="dmev-h">
      <tspan data-lang-en>Write side</tspan>
      <tspan data-lang-vi>Phía ghi</tspan>
    </text>
    <text x="690" y="28" class="dmev-h">
      <tspan data-lang-en>Read side</tspan>
      <tspan data-lang-vi>Phía đọc</tspan>
    </text>

    {boxes.map((b) => (
      <g class={b.hot ? 'dmev-box is-hot' : 'dmev-box'}>
        <rect x={b.x} y={b.y} width={b.w} height={bh} rx="4" />
        <DiagramIcon name={b.icon} x={b.x + 24} y={b.y + bh / 2} size={24} />
        <text x={b.x + 44 + (b.w - 44) / 2} y={b.y + 26} text-anchor="middle" class="dmev-name">
          <tspan data-lang-en>{b.en}</tspan>
          <tspan data-lang-vi>{b.vi}</tspan>
        </text>
        <text x={b.x + 44 + (b.w - 44) / 2} y={b.y + 46} text-anchor="middle" class="dmev-sub">
          <tspan data-lang-en>{b.subEn}</tspan>
          <tspan data-lang-vi>{b.subVi}</tspan>
        </text>
      </g>
    ))}

    {links.map((p) => {
      const a = arrow(p);
      return (
        <g>
          <polyline points={a.line} class="dmev-edge" fill="none" />
          <polygon points={a.head} class="dmev-head" />
        </g>
      );
    })}

    <line x1="20" x2={W - 20} y1="262" y2="262" class="dmev-rule" />
    <text x="20" y="290" class="dmev-good">
      <tspan data-lang-en>Rules are checked before the append. Once an event is in the log, no view may reject it.</tspan>
      <tspan data-lang-vi>Luật được kiểm tra trước khi ghi. Event đã vào log thì không view nào được từ chối.</tspan>
    </text>
    <text x="20" y="312" class="dmev-note">
      <tspan data-lang-en>Each question gets its own view, so the twice-a-year check never replays a whole year of licenses.</tspan>
      <tspan data-lang-vi>Mỗi câu hỏi có view riêng, nên kiểm tra "hai lần mỗi năm" không phải replay cả năm license.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The path of one change through an event-sourced service, as the Netflix team describes their downloads license service. Box names follow the post; the layout is simplified.</span>
    <span data-lang-vi>Đường đi của một thay đổi trong service event sourcing, theo cách team Netflix mô tả service license cho tính năng tải phim. Tên các ô theo bài viết; bố cục đã được đơn giản hoá.</span>
  </figcaption>
</figure>

<style>
  .dmev {
    margin: 2em 0;
    width: 100%;
  }
  .dmev-scroll {
    overflow-x: auto;
  }
  .dmev svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .dmev text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .dmev .dmev-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .dmev-rule {
    stroke: var(--border);
  }
  .dmev-edge {
    stroke: var(--text-muted);
    stroke-width: 1.4;
  }
  .dmev-head {
    fill: var(--text-muted);
  }
  .dmev .dmev-elabel {
    font-size: 12.5px;
    font-weight: 600;
    fill: var(--text-muted);
  }
  .dmev-box rect {
    fill: var(--bg-alt);
    stroke: var(--text-faint);
  }
  .dmev-box.is-hot rect {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .dmev .dmev-name {
    font-weight: 700;
    fill: var(--text);
  }
  .dmev .dmev-sub {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .dmev .dmev-good {
    fill: var(--text);
    font-weight: 600;
  }
  .dmev .dmev-note {
    fill: var(--text-muted);
  }
  .dmev figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
