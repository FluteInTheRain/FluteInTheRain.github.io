---
// Point-in-time data: the same company row seen from two dates.
// Left: what a screening dataset showed in late October 2001 (as filed).
// Right: the same row after Enron's November 2001 restatement.
// A small vanilla-JS toggle highlights one side; without JS both show.
const uid = Math.random().toString(36).slice(2, 8);
const EN = { 'data-lang-en': '' };
const VI = { 'data-lang-vi': '' };
const W = 900;
const H = 400;
---
<figure class="pit" id={`pit-${uid}`}>
  <div class="pit-bar">
    <button type="button" class="pit-btn" data-mode="filed">
      <span data-lang-en>Backtest date: October 2001</span>
      <span data-lang-vi>Ngày backtest: tháng 10/2001</span>
    </button>
    <button type="button" class="pit-btn" data-mode="restated">
      <span data-lang-en>After the restatement</span>
      <span data-lang-vi>Sau khi soát xét lại</span>
    </button>
    <button type="button" class="pit-btn" data-mode="both">
      <span data-lang-en>Show both</span>
      <span data-lang-vi>Xem cả hai</span>
    </button>
  </div>
  <div class="pit-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The same Enron row as seen from two dates. As of October 2001, the filed numbers show a record net income of about 1.3 billion US dollars for 2000 and steady growth from 1997 to 2000, so a high-earnings screen passes the stock. After the November 2001 restatement, the same years carry 591 million dollars less net income, and the same screen now returns a different answer.">
    <text x="20" y="26" class="pit-h">
      <tspan data-lang-en>One company row, two honest answers</tspan>
      <tspan data-lang-vi>Một dòng dữ liệu, hai câu trả lời đều "đúng"</tspan>
    </text>
    <text x="20" y="48" class="pit-sub">
      <tspan data-lang-en>Enron's 1997–2000 earnings, before and after the November 2001 restatement.</tspan>
      <tspan data-lang-vi>Lợi nhuận 1997–2000 của Enron, trước và sau đợt soát xét lại tháng 11/2001.</tspan>
    </text>

    {/* left panel: as filed */}
    <rect x="20" y="64" width="410" height="270" rx="6" class="pit-panel" data-panel="filed" />
    <text x="36" y="88" class="pit-title">
      <tspan data-lang-en>As of 31 Oct 2001 — what you could know</tspan>
      <tspan data-lang-vi>Tại 31/10/2001 — những gì bạn biết được</tspan>
    </text>
    {[
      { k: 0, en: 'FY2000 net income (as filed):  $1.30 billion', vi: 'Lợi nhuận ròng 2000 (theo BCTC đã nộp):  1,30 tỷ USD' },
      { k: 1, en: '1997–2000: rising every year', vi: '1997–2000: tăng đều mỗi năm' },
    ].map((r) => (
      <g>
        <rect x="36" y={102 + r.k * 30} width="378" height="24" rx="4" class="pit-row" />
        <text x="48" y={119 + r.k * 30} class="pit-num">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
      </g>
    ))}
    <text x="36" y={102 + 66} class="pit-q">
      <tspan data-lang-en>Screen "high earnings, growing":</tspan>
      <tspan data-lang-vi>Bộ lọc "lợi nhuận cao, đang tăng":</tspan>
    </text>
    <polygon points="40,180 40,192 76,192 76,200 92,186 76,172 76,180" class="pit-arrow is-good" />
    <text x="100" y="190" class="pit-verdict is-good">
      <tspan data-lang-en>passes — Enron looks like a winner</tspan>
      <tspan data-lang-vi>vượt qua — Enron trông như một lựa chọn tốt</tspan>
    </text>

    {/* right panel: restated */}
    <rect x="470" y="64" width="410" height="270" rx="6" class="pit-panel is-restated" data-panel="restated" />
    <text x="486" y="88" class="pit-title">
      <tspan data-lang-en>Same row, after the restatement</tspan>
      <tspan data-lang-vi>Cùng dòng dữ liệu, sau khi soát xét</tspan>
    </text>
    {[
      { k: 0, en: '1997–2000 net income cut by $591 million', vi: 'Lợi nhuận 1997–2000 bị cắt giảm 591 triệu USD' },
      { k: 1, en: 'Debt for 2000 up by $658 million', vi: 'Nợ năm 2000 tăng thêm 658 triệu USD' },
    ].map((r) => (
      <g>
        <rect x="486" y={102 + r.k * 30} width="378" height="24" rx="4" class="pit-row" />
        <text x="498" y={119 + r.k * 30} class="pit-num">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
      </g>
    ))}
    <text x="486" y={102 + 66} class="pit-q">
      <tspan data-lang-en>Same screen, same company:</tspan>
      <tspan data-lang-vi>Cùng bộ lọc, cùng công ty:</tspan>
    </text>
    <polygon points="490,180 490,192 526,192 526,200 542,186 526,172 526,180" class="pit-arrow is-bad" />
    <text x="550" y="190" class="pit-verdict is-bad">
      <tspan data-lang-en>the answer flips</tspan>
      <tspan data-lang-vi>câu trả lời đảo chiều</tspan>
    </text>

    <text x="20" y="362" class="pit-note">
      <tspan data-lang-en>Both answers were "correct" on their own date. A point-in-time database keeps both, tagged with when each was knowable.</tspan>
      <tspan data-lang-vi>Cả hai câu trả lời đều "đúng" đúng vào ngày của nó. Database point-in-time giữ cả hai, gắn kèm mốc thời gian mỗi số biết đến.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The restatement cut Enron's 1997–2000 net income by $591 million, about a fifth of reported profits (New York Times, 9 Nov 2001); the 2000 annual report had put net income at a record $1.3 billion. Toggle the buttons to highlight one view; without JavaScript both are shown.</span>
    <span data-lang-vi>Đợt soát xét lại cắt giảm lợi nhuận 1997–2000 của Enron 591 triệu USD, khoảng một phần năm lợi nhuận đã báo cáo (New York Times, 9/11/2001); báo cáo thường niên 2000 từng ghi nhận lợi nhuận kỷ lục 1,3 tỷ USD. Bấm nút để nổi bật một bên; không có JavaScript thì cả hai đều hiển thị.</span>
  </figcaption>
</figure>

<style>
  .pit { margin: 2em 0; width: 100%; }
  .pit-scroll { overflow-x: auto; }
  .pit svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .pit text { font-size: 14px; fill: var(--text-body); }
  .pit .pit-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .pit .pit-sub { fill: var(--text-muted); }
  .pit .pit-title { font-size: 14px; font-weight: 700; fill: var(--text); }
  .pit .pit-num { font-size: 13px; fill: var(--text); }
  .pit .pit-q { font-size: 13px; font-weight: 600; fill: var(--text); }
  .pit .pit-verdict { font-size: 13.5px; font-weight: 700; }
  .pit .pit-verdict.is-good { fill: var(--gold-icon); }
  .pit .pit-verdict.is-bad { fill: var(--red); }
  .pit .pit-note { font-size: 12.5px; fill: var(--text-muted); }
  .pit-panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; transition: opacity 0.2s; }
  .pit-panel.is-restated { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .pit-row { fill: var(--bg); stroke: var(--border); stroke-width: 1.1; }
  .pit-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .pit-arrow.is-good { stroke: var(--gold-icon); stroke-width: 1.8; }
  .pit-arrow.is-bad { stroke: var(--red); stroke-width: 1.8; }
  .pit figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  .pit-bar { display: flex; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
  .pit-btn { font: inherit; font-size: 13px; padding: 4px 12px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg-alt); color: var(--text); cursor: pointer; }
  .pit-btn[aria-pressed='true'] { border-color: var(--red); color: var(--red); }
  /* mode highlighting: dim the panel that is not selected */
  .pit[data-mode='filed'] svg [data-panel='restated'], .pit[data-mode='restated'] svg [data-panel='filed'] { opacity: 0.25; }
</style>

<script>
  document.querySelectorAll('.pit').forEach((fig) => {
    const buttons = fig.querySelectorAll('.pit-btn');
    const press = (mode: string) => {
      buttons.forEach((b) => {
        const on = (b as HTMLElement).dataset.mode === mode;
        if (on) b.setAttribute('aria-pressed', 'true'); else b.removeAttribute('aria-pressed');
      });
      if (mode === 'both') fig.removeAttribute('data-mode');
      else fig.setAttribute('data-mode', mode);
    };
    buttons.forEach((b) => {
      b.addEventListener('click', () => press((b as HTMLElement).dataset.mode || 'both'));
    });
    press('both');
  });
</script>
