---
// Demonstrates proportional vs tabular numbers in data tables.
// Proportional numbers cause decimal points to wobble, making numeric scanning difficult.
// font-variant-numeric: tabular-nums with right-alignment locks columns into straight vertical lines.

const rows = [
  { item: "Server Cluster US-East", amount: 11111.11, status: "Active" },
  { item: "PostgreSQL Replica 01", amount: 8888.88, status: "Active" },
  { item: "Cloud Storage (Hot tier)", amount: 142.10, status: "Active" },
  { item: "Egress Bandwidth APAC", amount: 18181.80, status: "Active" },
  { item: "Log Analytics Ingestion", amount: 777.77, status: "Active" },
];
---

<figure class="tnc">
  <div class="tnc-grid">
    <!-- Proportional Numbers (Wrong) -->
    <div class="tnc-card is-wrong">
      <div class="tnc-header">
        <span class="tnc-badge tnc-badge-wrong">
          <span data-lang-en>Proportional & Left-aligned</span>
          <span data-lang-vi>Số tỷ lệ & Căn trái (Lỗi thường gặp)</span>
        </span>
        <code>text-left normal-nums</code>
      </div>

      <div class="tnc-table-wrap">
        <table class="tnc-table tnc-prop">
          <thead>
            <tr>
              <th><span data-lang-en>Resource</span><span data-lang-vi>Tài nguyên</span></th>
              <th class="tnc-th-left"><span data-lang-en>Cost ($)</span><span data-lang-vi>Chi phí ($)</span></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td>{r.item}</td>
                <td class="tnc-num-prop">{r.amount.toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="tnc-desc">
        <span data-lang-en>Digit widths vary: "1" is skinny while "8" is wide. Decimal points zigzag horizontally; scanning magnitudes takes conscious effort.</span>
        <span data-lang-vi>Chiều rộng các chữ số không đều: số "1" hẹp, số "8" rộng. Dấu phẩy thập phân thụt thò; việc so sánh độ lớn phải tính nhẩm thay vì nhìn lướt.</span>
      </p>
    </div>

    <!-- Tabular Numbers (Correct) -->
    <div class="tnc-card is-correct">
      <div class="tnc-header">
        <span class="tnc-badge tnc-badge-correct">
          <span data-lang-en>Tabular-nums & Right-aligned</span>
          <span data-lang-vi>Tabular-nums & Căn phải (Chuẩn mực)</span>
        </span>
        <code>text-right tabular-nums</code>
      </div>

      <div class="tnc-table-wrap">
        <table class="tnc-table tnc-tab">
          <thead>
            <tr>
              <th><span data-lang-en>Resource</span><span data-lang-vi>Tài nguyên</span></th>
              <th class="tnc-th-right"><span data-lang-en>Cost ($)</span><span data-lang-vi>Chi phí ($)</span></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td>{r.item}</td>
                <td class="tnc-num-tab">{r.amount.toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="tnc-desc">
        <span data-lang-en>All digits share identical width. Decimal points align in a razor-sharp vertical line, making order-of-magnitude differences instantly visible.</span>
        <span data-lang-vi>Mọi chữ số đều có cùng chiều rộng. Dấu thập phân khóa thẳng tắp theo trục đứng; người dùng nhận biết ngay độ lớn chỉ trong một cái liếc mắt.</span>
      </p>
    </div>
  </div>

  <figcaption>
    <span data-lang-en>Tabular numerals in data grids. Left: numbers drift horizontally. Right: font-variant-numeric: tabular-nums with right-align locks the decimal column.</span>
    <span data-lang-vi>Chữ số dạng tabular trong bảng dữ liệu. Bên trái: số dao động ngang. Bên phải: font-variant-numeric: tabular-nums kèm căn phải giúp cố định cột số thẳng tắp.</span>
  </figcaption>
</figure>

<style>
  .tnc { margin: 2em 0; width: 100%; }
  .tnc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px; }
  .tnc-card { background: var(--bg-alt); border: 1px solid var(--border); border-radius: 10px; padding: 18px; }
  .tnc-card.is-correct { border-color: rgba(16, 185, 129, 0.4); }
  .tnc-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .tnc-badge { font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 2px 8px; border-radius: 4px; }
  .tnc-badge-wrong { background: rgba(239, 68, 68, 0.15); color: var(--red); }
  .tnc-badge-correct { background: rgba(16, 185, 129, 0.15); color: var(--green, #10b981); }
  .tnc code { font-size: 12px; color: var(--text-muted); background: var(--bg); padding: 2px 6px; border-radius: 4px; }
  
  .tnc-table-wrap { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin-bottom: 12px; }
  .tnc-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .tnc-table th, .tnc-table td { padding: 9px 12px; border-bottom: 1px solid var(--border); }
  .tnc-table tbody tr:last-child td { border-bottom: none; }
  .tnc-table th { background: var(--bg-alt); font-weight: 600; text-align: left; color: var(--text); font-size: 12px; text-transform: uppercase; }
  
  .tnc-th-left { text-align: left !important; }
  .tnc-th-right { text-align: right !important; }
  
  .tnc-num-prop { text-align: left; font-variant-numeric: normal; font-weight: 600; color: var(--text); }
  .tnc-num-tab { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; color: var(--text); }
  
  .tnc-desc { margin: 0; font-size: 13px; line-height: 1.5; color: var(--text-body); }
  .tnc figcaption { margin-top: 0.8em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
