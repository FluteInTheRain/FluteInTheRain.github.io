---
// The agent loop: task -> model picks a step -> tool runs -> result comes back -> model again, until it answers.
// The stop rules (step limit, budget, human sign-off) live outside the model.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 372;
const BW = 140;
const GAP = 40;
const X0 = 20;
const Y = 82;
const BH = 86;
const boxes = [
  { icon: 'goal', en: ['Task', 'from you'], vi: ['Việc bạn', 'giao'] },
  { icon: 'model', en: ['Model picks', 'the next step'], vi: ['Model chọn', 'bước kế tiếp'] },
  { icon: 'terminal', en: ['A tool runs', '(code, not model)'], vi: ['Một tool chạy', '(là code)'] },
  { icon: 'eye', en: ['Result comes', 'back as text'], vi: ['Kết quả về', 'dưới dạng chữ'] },
  { icon: 'doc', en: ['Final answer', 'with sources'], vi: ['Câu trả lời', 'kèm nguồn'] },
] as const;
const bx = (i: number) => X0 + i * (BW + GAP);
const guards = [
  { en: 'Step limit', vi: 'Giới hạn số bước' },
  { en: 'Token and cost budget', vi: 'Ngân sách token và tiền' },
  { en: 'Human sign-off on writes', vi: 'Người duyệt trước khi ghi' },
];
---
<figure class="a21l">
  <div class="a21l-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The agent loop. A task goes to the model, which picks a step; a tool runs; the result comes back as text and goes to the model again. When the model decides it is done, it writes the final answer. Three rules outside the model stop the loop: a step limit, a budget, and human sign-off before any write.">
      <text x="20" y="28" class="a21l-h">
        <tspan data-lang-en>An agent is a loop, and the model is only one box in it</tspan>
        <tspan data-lang-vi>Agent là một vòng lặp, và model chỉ là một ô trong đó</tspan>
      </text>
      {boxes.map((b, i) => (
        <g>
          <rect x={bx(i)} y={Y} width={BW} height={BH} rx="8" class={i === 1 ? 'a21l-box is-key' : i === 4 ? 'a21l-box is-end' : 'a21l-box'} />
          <DiagramIcon name={b.icon} x={bx(i) + 24} y={Y + 24} size={22} />
          <text x={bx(i) + 12} y={Y + 58} class="a21l-t">
            <tspan data-lang-en>{b.en[0]}</tspan><tspan data-lang-vi>{b.vi[0]}</tspan>
          </text>
          <text x={bx(i) + 12} y={Y + 75} class="a21l-t2">
            <tspan data-lang-en>{b.en[1]}</tspan><tspan data-lang-vi>{b.vi[1]}</tspan>
          </text>
        </g>
      ))}
      {[0, 1, 2].map((i) => (
        <g>
          <line x1={bx(i) + BW + 4} y1={Y + BH / 2} x2={bx(i + 1) - 8} y2={Y + BH / 2} class={i === 1 ? 'a21l-arrow fm-flow' : 'a21l-arrow'} />
          <polygon points={`${bx(i + 1) - 2},${Y + BH / 2} ${bx(i + 1) - 10},${Y + BH / 2 - 5} ${bx(i + 1) - 10},${Y + BH / 2 + 5}`} class="a21l-head" />
        </g>
      ))}
      {/* result -> model: the return lap */}
      <path d={`M ${bx(3) + BW / 2} ${Y + BH + 4} L ${bx(3) + BW / 2} ${Y + BH + 44} L ${bx(1) + BW / 2} ${Y + BH + 44} L ${bx(1) + BW / 2} ${Y + BH + 10}`} class="a21l-loop fm-flow" />
      <polygon points={`${bx(1) + BW / 2},${Y + BH + 4} ${bx(1) + BW / 2 - 5},${Y + BH + 12} ${bx(1) + BW / 2 + 5},${Y + BH + 12}`} class="a21l-head" />
      <text x={bx(1) + BW / 2 + 70} y={Y + BH + 62} class="a21l-note">
        <tspan data-lang-en>The result is added to the model's context, then it picks again</tspan>
        <tspan data-lang-vi>Kết quả được thêm vào context của model, rồi nó chọn tiếp</tspan>
      </text>
      {/* model -> answer: done */}
      <path d={`M ${bx(1) + BW / 2} ${Y - 4} L ${bx(1) + BW / 2} ${Y - 22} L ${bx(4) + BW / 2} ${Y - 22} L ${bx(4) + BW / 2} ${Y - 8}`} class="a21l-done" />
      <polygon points={`${bx(4) + BW / 2},${Y - 2} ${bx(4) + BW / 2 - 5},${Y - 10} ${bx(4) + BW / 2 + 5},${Y - 10}`} class="a21l-head is-done" />
      <text x={bx(3) - 10} y={Y - 30} class="a21l-note is-done">
        <tspan data-lang-en>when it decides it is done</tspan>
        <tspan data-lang-vi>khi nó quyết định là xong</tspan>
      </text>

      <rect x="20" y="244" width="860" height="112" rx="8" class="a21l-guard" />
      <text x="36" y="270" class="a21l-gt">
        <tspan data-lang-en>Rules that live outside the model, in plain code</tspan>
        <tspan data-lang-vi>Các luật nằm ngoài model, viết bằng code thường</tspan>
      </text>
      {guards.map((g, i) => (
        <g>
          <rect x={36 + i * 280} y="290" width="260" height="44" rx="6" class="a21l-chip" />
          <DiagramIcon name={i === 0 ? 'stop' : i === 1 ? 'money' : 'shield'} x={36 + i * 280 + 24} y="312" size={20} />
          <text x={36 + i * 280 + 46} y="317" class="a21l-t">
            <tspan data-lang-en>{g.en}</tspan><tspan data-lang-vi>{g.vi}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>One lap = the model chooses, a tool runs, the result returns. A fixed workflow draws the same boxes but the code, not the model, picks the order.</span>
    <span data-lang-vi>Một vòng = model chọn, tool chạy, kết quả quay về. Workflow cố định vẽ cùng các ô đó nhưng thứ tự do code chọn, không phải model.</span>
  </figcaption>
</figure>

<style>
  .a21l { margin: 2em 0; width: 100%; }
  .a21l-scroll { overflow-x: auto; }
  .a21l svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .a21l text { font-size: 14px; fill: var(--text-body); }
  .a21l .a21l-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .a21l .a21l-t { font-size: 13px; font-weight: 700; fill: var(--text); }
  .a21l .a21l-t2 { font-size: 12px; fill: var(--text-muted); }
  .a21l .a21l-note { font-size: 12.5px; fill: var(--text-muted); }
  .a21l .a21l-note.is-done { fill: var(--gold-icon); font-weight: 600; }
  .a21l .a21l-gt { font-size: 13px; font-weight: 700; fill: var(--text); }
  .a21l-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .a21l-box.is-key { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .a21l-box.is-end { stroke: var(--gold-icon); }
  .a21l-arrow { stroke: var(--text-muted); stroke-width: 1.6; }
  .a21l-loop { stroke: var(--text-muted); stroke-width: 1.6; fill: none; }
  .a21l-done { stroke: var(--gold-icon); stroke-width: 1.6; fill: none; stroke-dasharray: 5 4; }
  .a21l-head { fill: var(--text-muted); }
  .a21l-head.is-done { fill: var(--gold-icon); }
  .a21l-guard { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .a21l-chip { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .a21l figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
