---
// DynamoDB: the read choice. Default eventually consistent (half the price), or ConsistentRead
// (strongly consistent, twice the price).
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Arrow from './ReplicationBArrow.astro';
import Bi from './ReplicationBBi.astro';
---
<Frame h={270}
  label="Two kinds of DynamoDB read. Default: the read may be answered by any replica, which might not reflect a recent write, at half the price. With ConsistentRead: the read goes to the leader and sees the latest write, at twice the price."
  cap="The choice is in the API call, per read. Global secondary indexes and streams only offer the left-hand kind."
  capVi="Lựa chọn nằm ngay trong lời gọi API, cho từng lượt đọc. Global secondary index và stream chỉ có loại bên trái.">
  <rect x="10" y="10" width="430" height="250" rx="8" class="rb-panel" />
  <text x="225" y="38" text-anchor="middle" class="rb-h"><Bi en="Default: eventually consistent" vi="Mặc định: eventually consistent" /></text>
  <Node x={28} y={100} w={120} h={60} icon="laptop" t="App" tv="App" />
  <Node x={236} y={64} w={186} h={62} icon="dynamodb" t="Any replica" tv="Replica bất kỳ" s="has the write" sv="đã có lần ghi" />
  <Node x={236} y={140} w={186} h={62} icon="dynamodb" t="Any replica" tv="Replica bất kỳ" s="still behind" sv="còn chậm" cls="red" />
  <Arrow x1={148} y1={118} x2={236} y2={95} cls="dash" />
  <Arrow x1={148} y1={142} x2={236} y2={171} cls="dash" />
  <text x="225" y="236" text-anchor="middle" class="rb-t"><Bi en="Half the price. Might miss a recent write." vi="Rẻ bằng một nửa. Có thể bỏ lỡ lần ghi mới." /></text>

  <rect x="460" y="10" width="430" height="250" rx="8" class="rb-panel" />
  <text x="675" y="38" text-anchor="middle" class="rb-h"><Bi en="ConsistentRead: strongly consistent" vi="ConsistentRead: strongly consistent" /></text>
  <Node x={478} y={100} w={120} h={60} icon="laptop" t="App" tv="App" />
  <Node x={686} y={102} w={186} h={62} icon="dynamodb" t="Leader" tv="Leader" s="has the latest write" sv="có lần ghi mới nhất" cls="gold" />
  <Arrow x1={598} y1={132} x2={686} y2={132} cls="gold" />
  <text x="675" y="236" text-anchor="middle" class="rb-t"><Bi en="Twice the price. Sees the latest write." vi="Gấp đôi giá. Thấy lần ghi mới nhất." /></text>
</Frame>
