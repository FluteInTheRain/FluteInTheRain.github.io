---
// Distributed sort-merge join with secondary sort:
// Mappers emit (user_id, tag) where 0_prof precedes 1_<ts> events.
// Hash partitioning routes matching keys across shards to the same reducer,
// so the reducer merges sorted runs sequentially with O(1) memory per user
// and zero RPC lookups to a production database.
// Plain inline SVG with site tokens; polygon arrowheads avoid duplicate marker ids.

const W = 900;
const H = 472;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const dx = x2 - x1;
  const dy = y2 - y1;
  const len = Math.hypot(dx, dy) || 1;
  const ux = dx / len;
  const uy = dy / len;
  const px = -uy;
  const py = ux;
  const bx = x2 - ux * 8;
  const by = y2 - uy * 8;
  return {
    line: `M${x1},${y1} L${bx + ux * 1},${by + uy * 1}`,
    head: `${bx + px * 4.5},${by + py * 4.5} ${bx - px * 4.5},${by - py * 4.5} ${x2},${y2}`,
  };
}

const a17top = arrow(278, 190, 336, 134);
const a17bot = arrow(278, 298, 336, 146);
const a42top = arrow(278, 158, 336, 230);
const a42bot = arrow(278, 276, 336, 246);
const aMerge = arrow(538, 238, 590, 238);
import DiagramIcon from './DiagramIcon.astro';
---
<figure class="bsm">
  <div class="bsm-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Distributed sort-merge join with secondary sort. Activity events are tagged 1_timestamp and user profiles are tagged 0_prof. Mappers sort by (user_id, tag) and hash-partition keys to reducers. Reducer 1 merges sorted segments for user_id 42, reads the profile first, stores date of birth in a single local variable, and streams matching clicks without network RPCs.">
    <text x="20" y="26" class="bsm-h">
      <tspan data-lang-en>Distributed sort-merge join with secondary sort</tspan>
      <tspan data-lang-vi>Sort-merge join phân tán kèm sắp xếp phụ (secondary sort)</tspan>
    </text>
    <text x="20" y="48" class="bsm-sub">
      <tspan data-lang-en>Tagging profiles with 0_ and events with 1_ guarantees each user profile arrives right before their clicks.</tspan>
      <tspan data-lang-vi>Gắn thẻ 0_ cho hồ sơ và 1_ cho sự kiện bảo đảm hồ sơ luôn đứng ngay trước lượt click của user đó.</tspan>
    </text>

    {/* Column titles */}
    <text x="20" y="84" class="bsm-colh">
      <tspan data-lang-en>1. Map &amp; sort by (user_id, tag)</tspan>
      <tspan data-lang-vi>1. Map &amp; xếp theo (user_id, tag)</tspan>
    </text>
    <text x="338" y="84" class="bsm-colh">
      <tspan data-lang-en>2. Shuffle by hash(user_id)</tspan>
      <tspan data-lang-vi>2. Shuffle theo hash(user_id)</tspan>
    </text>
    <text x="590" y="84" class="bsm-colh">
      <tspan data-lang-en>3. Merge &amp; join in one pass</tspan>
      <tspan data-lang-vi>3. Trộn &amp; join trong 1 lượt</tspan>
    </text>

    {/* Left: Fact events */}
    <rect x="20" y="102" width="258" height="114" rx="4" class="bsm-box" />
    <text x="34" y="125" class="bsm-in-b">
      <tspan data-lang-en>Activity events (shards m1, m2)</tspan>
      <tspan data-lang-vi>Sự kiện click (mảnh m1, m2)</tspan>
    </text>
    <text x="34" y="150" class="bsm-rec is-hot">(42, 1_10:02) → /pricing</text>
    <text x="34" y="172" class="bsm-rec is-hot">(42, 1_10:09) → /cart</text>
    <text x="34" y="194" class="bsm-rec">(17, 1_10:05) → /docs</text>

    {/* Left: Dimension table */}
    <rect x="20" y="232" width="258" height="90" rx="4" class="bsm-box" />
    <text x="34" y="255" class="bsm-in-b">
      <tspan data-lang-en>User profiles (shard m3)</tspan>
      <tspan data-lang-vi>Hồ sơ user (mảnh m3)</tspan>
    </text>
    <text x="34" y="280" class="bsm-rec is-hot">(42, 0_prof) → dob = 1994</text>
    <text x="34" y="302" class="bsm-rec">(17, 0_prof) → dob = 1989</text>

    <text x="20" y="346" class="bsm-note">
      <tspan data-lang-en>If RAM buffer fills, mappers spill</tspan>
      <tspan data-lang-vi>Tràn RAM thì mapper ghi thành</tspan>
    </text>
    <text x="20" y="364" class="bsm-note">
      <tspan data-lang-en>sorted segments to local disk.</tspan>
      <tspan data-lang-vi>các đoạn đã xếp ra đĩa cục bộ.</tspan>
    </text>

    {/* Middle: Partition buckets */}
    <rect x="338" y="102" width="200" height="68" rx="4" class="bsm-box" />
    <text x="352" y="125" class="bsm-in-b">Reducer 0 · user 17</text>
    <text x="352" y="149" class="bsm-rec">0_prof → 1_10:05</text>

    <rect x="338" y="186" width="200" height="106" rx="4" class="bsm-box is-hot" />
    <text x="352" y="209" class="bsm-in-b is-hot">Reducer 1 · user 42</text>
    <text x="352" y="233" class="bsm-rec is-hot">0_prof: dob = 1994</text>
    <text x="352" y="254" class="bsm-rec is-hot">1_10:02: /pricing</text>
    <text x="352" y="275" class="bsm-rec is-hot">1_10:09: /cart</text>

    <rect x="338" y="308" width="200" height="58" rx="4" class="bsm-box" />
    <text x="352" y="330" class="bsm-in-b">
      <tspan data-lang-en>Reducer 2 · other keys</tspan>
      <tspan data-lang-vi>Reducer 2 · khác</tspan>
    </text>
    <text x="352" y="350" class="bsm-note">
      <tspan data-lang-en>sorted segments merged</tspan>
      <tspan data-lang-vi>trộn các đoạn đã xếp</tspan>
    </text>

    {/* Cross arrows */}
    <path d={a17top.line} class="bsm-arrow" /><polygon points={a17top.head} class="bsm-head" />
    <path d={a17bot.line} class="bsm-arrow" /><polygon points={a17bot.head} class="bsm-head" />
    <path d={a42top.line} class="bsm-arrow is-hot" /><polygon points={a42top.head} class="bsm-head is-hot" />
    <path d={a42bot.line} class="bsm-arrow is-hot" /><polygon points={a42bot.head} class="bsm-head is-hot" />
    <path d={aMerge.line} class="bsm-arrow is-hot" /><polygon points={aMerge.head} class="bsm-head is-hot" />

    {/* Right: Reducer 1 sequential pass */}
    <rect x="590" y="102" width="290" height="264" rx="4" class="bsm-box" />
    <text x="606" y="128" class="bsm-in-b">
      <tspan data-lang-en>Reducer 1: 1 pass, O(1) RAM</tspan>
      <tspan data-lang-vi>Reducer 1: 1 lượt, RAM O(1)</tspan>
    </text>

    <rect x="606" y="144" width="258" height="36" rx="3" class="bsm-step is-hot" />
    <text x="618" y="167" class="bsm-rec is-hot">1. 0_prof → dob = 1994</text>

    <rect x="606" y="190" width="258" height="36" rx="3" class="bsm-step" />
    <text x="618" y="213" class="bsm-rec">2. 1_10:02 → (/pricing, 1994)</text>

    <rect x="606" y="236" width="258" height="36" rx="3" class="bsm-step" />
    <text x="618" y="259" class="bsm-rec">3. 1_10:09 → (/cart, 1994)</text>

    <line x1="606" x2="864" y1="290" y2="290" class="bsm-rule" />
    <text x="606" y="316" class="bsm-warn">
      <tspan data-lang-en>Zero RPC calls to user DB</tspan>
      <tspan data-lang-vi>Không gọi RPC ngẫu nhiên vào DB</tspan>
    </text>
    <text x="606" y="338" class="bsm-note">
      <tspan data-lang-en>Holds 1 user record in RAM at a time</tspan>
      <tspan data-lang-vi>Chỉ giữ đúng 1 hồ sơ user trong RAM</tspan>
    </text>

    {/* Footer takeaway */}
    <line x1="20" x2={W - 20} y1="394" y2="394" class="bsm-rule" />
    <text x="20" y="422" class="bsm-foot">
      <tspan data-lang-en>Why this works: sequential merges handle petabytes without touching OLTP — until key skew strikes.</tspan>
      <tspan data-lang-vi>Điểm mấu chốt: trộn tuần tự xử lý được cỡ petabyte mà không đụng OLTP — cho tới khi khoá bị lệch (skew).</tspan>
    </text>
    <text x="20" y="444" class="bsm-foot">
      <tspan data-lang-en>If one celebrity user_id generates 70% of clicks, Reducer 1 becomes a straggler that stalls the whole stage.</tspan>
      <tspan data-lang-vi>Nếu một user nổi tiếng tạo 70% lượng click, Reducer 1 sẽ thành kẻ tụt hậu kéo chậm cả stage.</tspan>
    </text>
    {/* icons */}
    <DiagramIcon name="log" x={252} y={172} size={20} />
    <DiagramIcon name="file" x={250} y={254} size={20} />
    <DiagramIcon name="server" x={510} y={124} size={20} />
    <DiagramIcon name="server" x={510} y={208} size={20} />
    <DiagramIcon name="server" x={510} y={330} size={20} />
    <DiagramIcon name="server" x={854} y={128} size={20} />
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>How a shuffle turns random database lookups into sequential disk merges. Mappers from both datasets tag keys with a sort order (0_ before 1_), so each reducer receives the user profile right before that user's events.</span>
    <span data-lang-vi>Cách shuffle biến các lần tra cứu database ngẫu nhiên thành phép trộn tuần tự trên đĩa. Mapper ở cả hai tập dữ liệu gắn thêm thẻ thứ tự (0_ trước 1_), nên mỗi reducer nhận hồ sơ user ngay trước toàn bộ sự kiện của họ.</span>
  </figcaption>
</figure>

<style>
  .bsm {
    margin: 2em 0;
    width: 100%;
  }
  .bsm-scroll {
    overflow-x: auto;
  }
  .bsm svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .bsm text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .bsm .bsm-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .bsm .bsm-sub {
    fill: var(--text-muted);
  }
  .bsm .bsm-colh {
    font-size: 13.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .bsm-rule {
    stroke: var(--border);
  }
  .bsm-box {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .bsm-box.is-hot {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .bsm-step {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 1.1;
  }
  .bsm-step.is-hot {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.4;
  }
  .bsm .bsm-in-b {
    font-size: 13.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .bsm .bsm-in-b.is-hot {
    fill: var(--red);
  }
  .bsm .bsm-rec {
    font-size: 13px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .bsm .bsm-rec.is-hot {
    font-weight: 600;
    fill: var(--text);
  }
  .bsm .bsm-note {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .bsm .bsm-warn {
    font-size: 13px;
    font-weight: 700;
    fill: var(--red);
  }
  .bsm .bsm-foot {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .bsm-arrow {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.3;
  }
  .bsm-arrow.is-hot {
    stroke: var(--red);
    stroke-width: 1.8;
  }
  .bsm-head {
    fill: var(--text-muted);
  }
  .bsm-head.is-hot {
    fill: var(--red);
  }
  .bsm figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
