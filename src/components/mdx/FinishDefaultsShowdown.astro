---
// Chapter 8: Direct visual showdown between untouched browser defaults
// and upgraded defaults (custom icon bullets, styled link, brand checkbox, promoted quote).
// Plain inline SVG using site CSS tokens; no <defs> IDs needed so EN/VI copies cannot collide.

const W = 900;
const H = 370;
---
<figure class="fds">
  <div class="fds-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: raw browser defaults with plain disc bullets, unstyled checkbox, blue link, and plain blockquote. Right: upgraded defaults with check icons, brand-coloured checkbox, accented link underline, and promoted quote mark.">
      {/* Column headers */}
      <text x="24" y="28" class="fds-head is-muted">
        <tspan data-lang-en>Raw browser defaults</tspan>
        <tspan data-lang-vi>Mặc định trình duyệt</tspan>
      </text>
      <text x="474" y="28" class="fds-head is-accent">
        <tspan data-lang-en>Upgraded defaults</tspan>
        <tspan data-lang-vi>Mặc định đã nâng cấp</tspan>
      </text>

      {/* Left card: raw defaults */}
      <rect x="24" y="42" width="414" height="304" rx="10" class="fds-card" />

      {/* Left: plain bullets */}
      <circle cx="52" cy="82" r="3.5" class="fds-bullet-raw" />
      <text x="68" y="87" class="fds-text">
        <tspan data-lang-en>Automatic daily backups</tspan>
        <tspan data-lang-vi>Sao lưu tự động hàng ngày</tspan>
      </text>
      <circle cx="52" cy="112" r="3.5" class="fds-bullet-raw" />
      <text x="68" y="117" class="fds-text">
        <tspan data-lang-en>Role-based access control</tspan>
        <tspan data-lang-vi>Phân quyền theo vai trò</tspan>
      </text>

      {/* Left: plain checkbox */}
      <rect x="46" y="142" width="16" height="16" rx="3" class="fds-check-raw" />
      <path d="M 49.5 150 L 52.5 153.5 L 58.5 146.5" class="fds-checkmark-raw" />
      <text x="72" y="155" class="fds-text">
        <tspan data-lang-en>Send deploy alerts to Slack</tspan>
        <tspan data-lang-vi>Gửi cảnh báo deploy sang Slack</tspan>
      </text>

      {/* Left: default link */}
      <text x="46" y="200" class="fds-text-muted">
        <tspan data-lang-en>Read the </tspan>
        <tspan data-lang-vi>Đọc thêm </tspan>
        <tspan class="fds-link-raw" data-lang-en>security policy</tspan>
        <tspan class="fds-link-raw" data-lang-vi>chính sách bảo mật</tspan>
      </text>

      {/* Left: plain blockquote */}
      <line x1="46" y1="234" x2="46" y2="294" class="fds-quote-bar-raw" />
      <text x="62" y="256" class="fds-quote-raw">
        <tspan data-lang-en>"Checkout latency dropped in half</tspan>
        <tspan data-lang-vi>"Độ trễ thanh toán giảm một nửa</tspan>
      </text>
      <text x="62" y="278" class="fds-quote-raw">
        <tspan data-lang-en>the week we switched."</tspan>
        <tspan data-lang-vi>ngay tuần đầu chuyển đổi."</tspan>
      </text>

      <text x="46" y="326" class="fds-note">
        <tspan data-lang-en>Functional, but looks identical to an unstyled form.</tspan>
        <tspan data-lang-vi>Đủ chức năng, nhưng trông như biểu mẫu chưa chỉnh sửa.</tspan>
      </text>

      {/* Right card: upgraded defaults */}
      <rect x="474" y="42" width="402" height="304" rx="10" class="fds-card is-polished" />

      {/* Right: icon bullets */}
      <circle cx="504" cy="82" r="9" class="fds-icon-bg" />
      <path d="M 499.5 82 L 502.5 85 L 508.5 79" class="fds-icon-check" />
      <text x="524" y="87" class="fds-text is-strong">
        <tspan data-lang-en>Automatic daily backups</tspan>
        <tspan data-lang-vi>Sao lưu tự động hàng ngày</tspan>
      </text>

      <circle cx="504" cy="114" r="9" class="fds-icon-bg" />
      <path d="M 499.5 114 L 502.5 117 L 508.5 111" class="fds-icon-check" />
      <text x="524" y="119" class="fds-text is-strong">
        <tspan data-lang-en>Role-based access control</tspan>
        <tspan data-lang-vi>Phân quyền theo vai trò</tspan>
      </text>

      {/* Right: brand checkbox */}
      <rect x="496" y="144" width="17" height="17" rx="4" class="fds-check-brand" />
      <path d="M 500 152.5 L 503.2 155.8 L 509 149.2" class="fds-checkmark-white" />
      <text x="524" y="157" class="fds-text is-strong">
        <tspan data-lang-en>Send deploy alerts to Slack</tspan>
        <tspan data-lang-vi>Gửi cảnh báo deploy sang Slack</tspan>
      </text>

      {/* Right: thick partial-overlap link */}
      <rect x="556" y="196" width="110" height="6" rx="2" class="fds-link-highlight" />
      <text x="496" y="200" class="fds-text-muted">
        <tspan data-lang-en>Read the </tspan>
        <tspan data-lang-vi>Đọc thêm </tspan>
        <tspan class="fds-link-brand" data-lang-en>security policy</tspan>
        <tspan class="fds-link-brand" data-lang-vi>chính sách bảo mật</tspan>
      </text>

      {/* Right: promoted quotation mark */}
      <text x="492" y="270" class="fds-big-quote">“</text>
      <text x="524" y="256" class="fds-quote-brand">
        <tspan data-lang-en>Checkout latency dropped in half</tspan>
        <tspan data-lang-vi>Độ trễ thanh toán giảm một nửa</tspan>
      </text>
      <text x="524" y="278" class="fds-quote-brand">
        <tspan data-lang-en>the week we switched.</tspan>
        <tspan data-lang-vi>ngay tuần đầu chuyển đổi.</tspan>
      </text>

      <text x="496" y="326" class="fds-note is-accent">
        <tspan data-lang-en>Same markup and copy; four small CSS upgrades.</tspan>
        <tspan data-lang-vi>Cùng nội dung; chỉ bốn nâng cấp nhỏ bằng CSS.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Upgrading existing elements (bullets, checkboxes, links, quotes) adds brand character before you draw a single custom illustration.</span>
    <span data-lang-vi>Nâng cấp những thành phần có sẵn (dấu đầu dòng, ô chọn, liên kết, trích dẫn) tạo dấu ấn sản phẩm mà chưa cần vẽ thêm minh họa phức tạp.</span>
  </figcaption>
</figure>

<style>
  .fds { margin: 2em 0; width: 100%; }
  .fds-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .fds svg { width: 100%; min-width: 640px; height: auto; display: block; font-family: inherit; }

  .fds-head { font-size: 15px; font-weight: 600; }
  .fds-head.is-muted { fill: var(--text-muted); }
  .fds-head.is-accent { fill: var(--red); }

  .fds-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.25; }
  .fds-card.is-polished { stroke: var(--red); stroke-opacity: 0.45; }

  .fds-bullet-raw { fill: var(--text-muted); }
  .fds-check-raw { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.25; }
  .fds-checkmark-raw { fill: none; stroke: var(--text-muted); stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }

  .fds-icon-bg { fill: var(--red-tint-bg); }
  .fds-icon-check { fill: none; stroke: var(--red); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .fds-check-brand { fill: var(--red); }
  .fds-checkmark-white { fill: none; stroke: #ffffff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .fds-text { font-size: 14px; fill: var(--text-body); }
  .fds-text.is-strong { fill: var(--text); font-weight: 500; }
  .fds-text-muted { font-size: 14px; fill: var(--text-muted); }

  .fds-link-raw { fill: var(--text-muted); text-decoration: underline; }
  .fds-link-highlight { fill: var(--red-tint-bg); }
  .fds-link-brand { fill: var(--text); font-weight: 600; }

  .fds-quote-bar-raw { stroke: var(--border); stroke-width: 3; }
  .fds-quote-raw { font-size: 14px; fill: var(--text-muted); font-style: italic; }

  .fds-big-quote { font-size: 56px; font-weight: 700; fill: var(--red); fill-opacity: 0.35; }
  .fds-quote-brand { font-size: 14.5px; fill: var(--text); font-weight: 500; }

  .fds-note { font-size: 13px; fill: var(--text-muted); }
  .fds-note.is-accent { fill: var(--red); }

  .fds figcaption { margin-top: 0.8em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
