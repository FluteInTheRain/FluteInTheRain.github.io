---
// Demo wrapper: the React island plus a no-JS table. Table values = Python run (see report): s = p + (1-p)*c*p, task = s**n.
import DemoFrame from './DemoFrame.astro';
import AtP21CompoundDemo, { GRID, taskSuccess } from '../demos/AtP21CompoundDemo.tsx';
const pct = (x: number) => `${(x * 100).toFixed(1)}%`;
---
<figure class="p21-demo">
  <DemoFrame title="How errors pile up over the steps of a task" titleVi="Lỗi dồn lại thế nào qua các bước của một việc">
    <AtP21CompoundDemo client:visible />
    <noscript>
      <table class="p21-table">
        <thead>
          <tr>
            <th><span data-lang-en>Step right</span><span data-lang-vi>Mỗi bước đúng</span></th>
            <th><span data-lang-en>Steps</span><span data-lang-vi>Số bước</span></th>
            <th><span data-lang-en>No check</span><span data-lang-vi>Không kiểm</span></th>
            <th><span data-lang-en>Check catches 80%</span><span data-lang-vi>Kiểm bắt 80%</span></th>
          </tr>
        </thead>
        <tbody>
          {GRID.ps.flatMap((p) => GRID.ns.map((n) => (
            <tr>
              <td>{Math.round(p * 100)}%</td>
              <td>{n}</td>
              <td>{pct(taskSuccess(p, n, 0))}</td>
              <td>{pct(taskSuccess(p, n, 0.8))}</td>
            </tr>
          )))}
        </tbody>
      </table>
    </noscript>
  </DemoFrame>
  <figcaption>
    <span data-lang-en>Say an agent answers a research question in 10 steps and each step is right 95% of the time. With no check the whole task works 59.9% of the time; with a check that catches 80% of wrong steps, 88.6%.</span>
    <span data-lang-vi>Giả sử một agent trả lời câu hỏi nghiên cứu qua 10 bước và mỗi bước đúng 95%. Không kiểm thì cả việc đúng 59,9%; có bước kiểm bắt 80% bước sai thì 88,6%.</span>
  </figcaption>
</figure>

<style is:global>
  .p21-demo { margin: 2em 0; width: 100%; }
  .p21-demo > .demo-frame { margin-bottom: 0; }
  .p21-demo > figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  .p21d-ctl { display: grid; gap: 4px; }
  .p21d-ctl label { display: flex; gap: 6px; align-items: baseline; font-size: 13px; font-weight: 600; color: var(--text-muted); margin-top: 8px; }
  .p21d-ctl label b { margin-left: auto; color: var(--text); font-variant-numeric: tabular-nums; }
  .p21d-ctl input[type='range'] { width: 100%; accent-color: var(--gold-icon); }
  .p21d-bars { display: grid; gap: 10px; margin-top: 16px; }
  .p21d-bar { display: grid; grid-template-columns: 1fr auto; gap: 4px 10px; align-items: center; }
  .p21d-bl { grid-column: 1 / -1; font-size: 13px; font-weight: 600; color: var(--text); }
  .p21d-track { height: 18px; border-radius: 4px; background: var(--bg-alt); border: 1px solid var(--border); overflow: hidden; }
  .p21d-fill { display: block; height: 100%; }
  .p21d-fill.is-bare { background: var(--red); }
  .p21d-fill.is-chk { background: var(--gold-icon); }
  .p21d-val { font-size: 16px; min-width: 56px; text-align: right; font-variant-numeric: tabular-nums; color: var(--text); }
  .p21d-note { margin: 12px 0 0; font-size: 12.5px; color: var(--text-muted); line-height: 1.5; }
  .p21-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .p21-table th, .p21-table td { border: 1px solid var(--border); padding: 4px 8px; text-align: left; }
</style>
