---
import DiagramIcon from './DiagramIcon.astro';
// Netflix's twice-a-year download rule answered two ways: replaying a year of license events, or looking up a view built for the question. Values in the right lane are illustrative.
// Arrowheads are polygons: no SVG ids.
const W = 900;
const H = 330;
type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}
const frames: any[] = [];
const boxes: any[] = [];
const links: any[] = [];
const labels: any[] = [];
const nums: any[] = [];
frames.push({ x: 10, y: 50, w: 430, h: 270, kind: 'bad' }, { x: 460, y: 50, w: 430, h: 270, kind: 'good' });
labels.push(
  { x: 46, y: 28, en: 'The rule: some titles can be downloaded only twice a year', vi: 'Luật: một số phim chỉ được tải hai lần mỗi năm', cls: 'h' },
  { x: 28, y: 80, en: 'Replay the whole year', vi: 'Replay cả năm', cls: 'strong' },
  { x: 478, y: 80, en: 'Look up a view built for this question', vi: 'Tra một view dựng riêng cho câu hỏi này', cls: 'strong' },
);
boxes.push(
  { x: 28, y: 96, w: 394, h: 50, icon: 'log', en: ['Read every license event of the year'], vi: ['Đọc mọi event license trong năm'] },
  { x: 28, y: 166, w: 394, h: 50, icon: 'search', en: ['Keep only the events for this title'], vi: ['Chỉ giữ event của phim này'] },
  { x: 28, y: 236, w: 394, h: 64, icon: 'warning', kind: 'bad', en: ['Count the downloads', 'a lot of processing, on every check'], vi: ['Đếm số lượt tải', 'xử lý rất nhiều, ở mỗi lần kiểm tra'] },
  { x: 478, y: 96, w: 394, h: 50, icon: 'chart', en: ['Downloads view', 'indexed by member and title'], vi: ['View lượt tải', 'đánh index theo member và phim'] },
  { x: 478, y: 166, w: 394, h: 50, icon: 'search', en: ['Look up: member 7, title Z', 'result: 2 downloads this year'], vi: ['Tra: member 7, phim Z', 'kết quả: 2 lượt tải trong năm'] },
  { x: 478, y: 236, w: 394, h: 64, icon: 'lock', kind: 'good', en: ['Two already: refuse the third', 'one lookup, no replay'], vi: ['Đã đủ hai: từ chối lượt thứ ba', 'một lần tra, không replay'] },
);
links.push({ pts: [[225, 146], [225, 166]], plain: true }, { pts: [[225, 216], [225, 236]], plain: true }, { pts: [[675, 146], [675, 166]], plain: true }, { pts: [[675, 216], [675, 236]], plain: true });
---
<figure class="dmdl">
  <div class="dmdl-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The rule: some titles may be downloaded only twice a year. Left lane: read every license event of the year, filter by title and count, which is a lot of processing on every check. Right lane: look up a downloads view indexed by member and title; member 7 and title Z already has 2 downloads this year, so refuse the third.">
    {frames.map((f) => (
      <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="6" class={`dmdl-frame ${f.kind ?? ''}`} />
    ))}
    {boxes.map((b) => {
      const n = Math.max(b.en.length, b.vi.length);
      const top = !!b.top;
      const cx = b.x + b.w / 2;
      const x0 = top ? cx : b.icon ? b.x + 46 : b.x + 14;
      const y0 = top ? b.y + (b.icon ? 56 : 24) : b.y + b.h / 2 - ((n - 1) * 17) / 2 + 4;
      return (
        <g class={`dmdl-box ${b.kind ?? ''}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
          {b.icon && <DiagramIcon name={b.icon} x={top ? cx : b.x + 24} y={top ? b.y + 24 : b.y + b.h / 2} size={b.is ?? 26} />}
          {Array.from({ length: n }).map((_, i) => (
            <text x={x0} y={y0 + i * 17} text-anchor={top ? 'middle' : 'start'} class={i === 0 && !b.flat ? 'dmdl-name' : 'dmdl-sub'}>
              <tspan data-lang-en>{b.en[i] ?? ''}</tspan>
              <tspan data-lang-vi>{b.vi[i] ?? ''}</tspan>
            </text>
          ))}
        </g>
      );
    })}
    {links.map((l) => {
      const a = arrow(l.pts);
      return (
        <g>
          <polyline points={l.plain ? l.pts.map((p) => p.join(',')).join(' ') : a.line} class={`dmdl-edge ${l.kind ?? ''}`} fill="none" />
          {!l.plain && <polygon points={a.head} class={`dmdl-head ${l.kind ?? ''}`} />}
        </g>
      );
    })}
    {labels.map((t) => (
      <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`dmdl-lab ${t.cls ?? ''}`}>
        <tspan data-lang-en>{t.en}</tspan>
        <tspan data-lang-vi>{t.vi ?? t.en}</tspan>
      </text>
    ))}
    {nums.map((n) => (
      <g class="dmdl-num">
        <circle cx={n.x} cy={n.y} r="11" />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.n}</text>
      </g>
    ))}
    <DiagramIcon name="calendar" x={26} y={22} size={22} />
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The view is kept up to date from its own events, so the check reads one row instead of a year of history.</span>
    <span data-lang-vi>View này được cập nhật từ chính các event của nó, nên việc kiểm tra chỉ đọc một dòng thay vì cả năm lịch sử.</span>
  </figcaption>
</figure>

<style>
  .dmdl { margin: 2em 0; width: 100%; }
  .dmdl-scroll { overflow-x: auto; }
  .dmdl svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dmdl text { font-size: 14px; fill: var(--text-body); }
  .dmdl .dmdl-name { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .dmdl .dmdl-sub { font-size: 12px; fill: var(--text-muted); }
  .dmdl .dmdl-lab { font-size: 13px; }
  .dmdl .dmdl-lab.h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dmdl .dmdl-lab.strong { font-weight: 700; fill: var(--text); }
  .dmdl .dmdl-lab.muted { fill: var(--text-muted); }
  .dmdl .dmdl-lab.bad { font-weight: 700; fill: var(--red); }
  .dmdl .dmdl-lab.good { font-weight: 700; fill: var(--text); }
  .dmdl .dmdl-lab.mono, .dmdl .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .dmdl-frame { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .dmdl-frame.bad { stroke: var(--red); }
  .dmdl-frame.good { stroke: var(--gold); }
  .dmdl-box rect { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmdl-box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dmdl-box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmdl-box.plain rect { fill: none; stroke: var(--border); }
  .dmdl-edge { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmdl-edge.bad { stroke: var(--red); }
  .dmdl-edge.good { stroke: var(--gold-icon); }
  .dmdl-head { fill: var(--text-muted); }
  .dmdl-head.bad { fill: var(--red); }
  .dmdl-head.good { fill: var(--gold-icon); }
  .dmdl-num circle { fill: var(--bg-alt); stroke: var(--text-muted); }
  .dmdl-num text { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dmdl figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
