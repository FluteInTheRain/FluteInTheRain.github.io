---
// If the true Sharpe is zero, the measured annual Sharpe over T years falls within +-1.96/sqrt(T) 95% of the time.
// Python simulation (20,000 runs per row): 1y [-1.96, 2.00], 2y [-1.38, 1.38], 5y [-0.87, 0.89], 10y [-0.61, 0.62], 20y [-0.44, 0.45].
const rows = [[1, 1.96], [2, 1.39], [5, 0.88], [10, 0.62], [20, 0.44]];
const X0 = 480, SC = 130; // x of Sharpe 0, pixels per Sharpe unit
const x = (v: number) => X0 + v * SC;
---
<figure class="aplb">
  <div class="aplb-scroll">
  <svg viewBox="0 0 900 380" role="img" aria-label="For a strategy with zero true edge, the range of annual Sharpe ratios that luck alone produces 95 percent of the time: plus or minus 1.96 after 1 year, 1.39 after 2, 0.88 after 5, 0.62 after 10 and 0.44 after 20. A vertical line at a measured Sharpe of 1.0 is inside the band for 1 and 2 years and outside it from 5 years on.">
    <text x="20" y="26" class="aplb-h">
      <tspan data-lang-en>How much Sharpe can luck alone produce?</tspan>
      <tspan data-lang-vi>Riêng may rủi có thể cho ra Sharpe bao nhiêu?</tspan>
    </text>
    <text x="20" y="46" class="aplb-sub">
      <tspan data-lang-en>Range of measured Sharpe in 95% of cases when the true edge is zero</tspan>
      <tspan data-lang-vi>Khoảng Sharpe đo được trong 95% trường hợp khi lợi thế thật bằng 0</tspan>
    </text>
    <line x1={x(1)} x2={x(1)} y1="62" y2="312" class="aplb-mark" />
    <text x={x(1) + 8} y="76" class="aplb-lab">
      <tspan data-lang-en>measured Sharpe 1.0</tspan>
      <tspan data-lang-vi>Sharpe đo được 1,0</tspan>
    </text>
    <line x1={x(0)} x2={x(0)} y1="62" y2="312" class="aplb-axis" />
    {rows.map(([y, w], i) => (
      <g>
        <text x="110" y={110 + i * 46} text-anchor="end" class="aplb-yr">
          <tspan data-lang-en>{y} {y === 1 ? 'year' : 'years'}</tspan>
          <tspan data-lang-vi>{y} năm</tspan>
        </text>
        <rect x={x(-w)} y={92 + i * 46} width={2 * w * SC} height="26" rx="4" class={`aplb-band ${w < 1 ? 'is-out' : ''}`} />
        <text x={x(2.2)} y={110 + i * 46} class="aplb-val">±{w.toFixed(2)}</text>
      </g>
    ))}
    {[-2, -1, 0, 1, 2].map((v) => (
      <text x={x(v)} y="338" text-anchor="middle" class="aplb-tick">{v}</text>
    ))}
    <text x={x(0)} y="362" text-anchor="middle" class="aplb-sub">
      <tspan data-lang-en>annual Sharpe ratio</tspan>
      <tspan data-lang-vi>Sharpe ratio năm</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The width is 1.96 ÷ √years. A measured Sharpe of 1.0 sits inside luck's band for one or two years of data and outside it from five years on (red bands).</span>
    <span data-lang-vi>Độ rộng bằng 1,96 ÷ √số năm. Sharpe đo được 1,0 nằm trong dải của may rủi khi có một hoặc hai năm dữ liệu và nằm ngoài từ năm năm trở lên (các dải đỏ).</span>
  </figcaption>
</figure>

<style>
  .aplb { margin: 2em 0; width: 100%; }
  .aplb-scroll { overflow-x: auto; }
  .aplb svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .aplb text { font-size: 14px; fill: var(--text-body); }
  .aplb .aplb-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .aplb .aplb-sub { font-size: 13px; fill: var(--text-muted); }
  .aplb .aplb-yr { font-size: 14px; font-weight: 600; fill: var(--text); }
  .aplb .aplb-val { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .aplb .aplb-lab { font-size: 13px; font-weight: 600; fill: var(--red); }
  .aplb .aplb-tick { font-size: 12.5px; fill: var(--text-muted); }
  .aplb-band { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .aplb-band.is-out { fill: var(--red-tint-bg); stroke: var(--red); }
  .aplb-axis { stroke: var(--text-muted); stroke-width: 1.2; }
  .aplb-mark { stroke: var(--red); stroke-width: 1.8; stroke-dasharray: 5 4; }
  .aplb figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
