---
// The six statements of Parse and which ones ran when the only test is Parse("8080").
// Icons: DiagramIcon (ok = ran, warning = never ran, test = the go test result). Motion: fm-glow on the two rows no test reaches.
import DiagramIcon from './DiagramIcon.astro';
const stmts = [
  { code: 'n, err := strconv.Atoi(s)', ran: true },
  { code: 'if err != nil {', ran: true },
  { code: 'return 0, fmt.Errorf("port %q is not a number", s)', ran: false },
  { code: 'if n < 1 || n > 65535 {', ran: true },
  { code: 'return 0, fmt.Errorf("port %d is out of range 1-65535", n)', ran: false },
  { code: 'return n, nil', ran: true },
];
const top = 52;
const rh = 36;
---
<figure class="p06d">
  <div class="p06d-scroll">
  <svg viewBox="0 0 900 290" role="img" aria-label="Six statements of Parse. With only the test Parse(8080), four ran and the two error returns did not, which is 66.7 percent.">
    <text x="20" y="24" class="h"><tspan data-lang-en>The six statements in Parse, with one test: Parse("8080")</tspan><tspan data-lang-vi>Sáu câu lệnh trong Parse, với một test: Parse("8080")</tspan></text>
    {stmts.map((s, i) => (
      <g>
        <rect x="20" y={top + i * rh} width="640" height={rh - 4} rx="4" class={s.ran ? 'box' : 'hot fm-glow'} />
        <DiagramIcon name={s.ran ? 'ok' : 'warning'} x={642} y={top + i * rh + 16} size={22} />
        <text x="34" y={top + i * rh + 21} class="s">{i + 1}</text>
        <text x="62" y={top + i * rh + 21} class={s.ran ? 'b' : 'r'}>{s.code}</text>
        <text x="624" y={top + i * rh + 21} text-anchor="end" class={s.ran ? 'm' : 'r'}>
          {s.ran
            ? <><tspan data-lang-en>ran</tspan><tspan data-lang-vi>đã chạy</tspan></>
            : <><tspan data-lang-en>never ran</tspan><tspan data-lang-vi>chưa chạy</tspan></>}
        </text>
      </g>
    ))}
    <DiagramIcon name="test" x={704} y={79} size={26} />
    <text x="730" y="84" class="b"><tspan data-lang-en>4 ran, 2 did not</tspan><tspan data-lang-vi>4 đã chạy, 2 chưa</tspan></text>
    <text x="730" y="108" class="m"><tspan data-lang-en>go test -cover prints:</tspan><tspan data-lang-vi>go test -cover in ra:</tspan></text>
    <text x="730" y="130" class="b">coverage: 66.7%</text>
    <text x="730" y="152" class="b">of statements</text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Coverage counts statements that ran. The two lines in red are the code no test touches yet; they are where the next test cases belong.</span>
    <span data-lang-vi>Coverage đếm các câu lệnh đã chạy. Hai dòng màu đỏ là code chưa test nào chạm tới; case test tiếp theo nên nhắm vào đó.</span>
  </figcaption>
</figure>

<style>
  .p06d { margin: 2em 0; width: 100%; }
  .p06d-scroll { overflow-x: auto; }
  .p06d svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p06d text { font-size: 14px; fill: var(--text-body); }
  .p06d .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p06d .b { font-weight: 700; fill: var(--text); }
  .p06d .m { fill: var(--text-muted); }
  .p06d .s { font-size: 13px; fill: var(--text-muted); }
  .p06d .r { fill: var(--red); font-weight: 700; }
  .p06d .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .p06d .skip { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .p06d .hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .p06d .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .p06d .ln.cut { stroke-dasharray: 3 4; opacity: 0.5; }
  .p06d .ah { fill: var(--text-muted); }
  .p06d .rule { stroke: var(--border); stroke-width: 1; }
  .p06d .grid { stroke: var(--border); stroke-width: 1; }
  .p06d figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
