---
// Jepsen's 2013 Cassandra test: 2,000 writes, 1,009 acknowledged, 724 survived, 285 lost.
// Bar widths are proportional to the counts (0.35 px per write).
import Frame from './ReplicationBFrame.astro';
import DiagramIcon from './DiagramIcon.astro';
import Bi from './ReplicationBBi.astro';
const k = 0.35, x0 = 190;
const sent = 2000, acked = 1009, kept = 724, lost = acked - kept;
---
<Frame h={215}
  label="Jepsen test of Cassandra, 2013. Of 2,000 writes to one cell, 1,009 were acknowledged and 724 survived. 285 acknowledged writes were lost, about 28 percent."
  cap="Writes the database said yes to, then lost. Test setup: the same cell mutated repeatedly, with perfectly synchronized clocks and QUORUM consistency."
  capVi="Những lần ghi database đã nói đồng ý, rồi vẫn mất. Cách test: sửa đi sửa lại cùng một ô, với đồng hồ đồng bộ hoàn hảo và consistency QUORUM.">
  <DiagramIcon name="cassandra" x={34} y={28} size={30} />
  <text x="64" y="34" class="rb-title"><Bi en="Cassandra, 2013: one cell, written 2,000 times" vi="Cassandra, 2013: một ô, ghi 2.000 lần" /></text>
  <text x="170" y="86" text-anchor="end" class="rb-h"><Bi en="Sent" vi="Đã gửi" /></text>
  <rect x={x0} y={66} width={sent * k} height={28} rx="3" class="rb-box" />
  <text x={x0 + sent * k - 8} y={85} text-anchor="end" class="rb-h"><Bi en="2,000" vi="2.000" /></text>
  <text x="170" y="136" text-anchor="end" class="rb-h"><Bi en="Acknowledged" vi="Đã xác nhận" /></text>
  <rect x={x0} y={116} width={kept * k} height={28} rx="3" fill="var(--gold-icon)" />
  <rect x={x0 + kept * k} y={116} width={lost * k} height={28} rx="3" fill="var(--red)" />
  <text x={x0 + kept * k / 2} y={168} text-anchor="middle" class="rb-n"><Bi en="724 survived" vi="724 còn lại" /></text>
  <text x={x0 + kept * k + lost * k / 2} y={168} text-anchor="middle" class="rb-n rb-bad"><Bi en="285 lost" vi="285 mất" /></text>
  <text x={x0 + acked * k + 12} y={136} class="rb-h"><Bi en="1,009" vi="1.009" /></text>
  <text x={x0 + acked * k + 12} y={156} class="rb-n rb-bad"><Bi en="about 28% of them lost" vi="khoảng 28% bị mất" /></text>
</Frame>
