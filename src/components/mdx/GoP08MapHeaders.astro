---
import DiagramIcon from './DiagramIcon.astro';
// Icons: DiagramIcon (names from diagram-icons.ts). Motion: fig-motion.css.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 8 * Math.cos(a - 0.45), y2 - 8 * Math.sin(a - 0.45)];
  const p2 = [x2 - 8 * Math.cos(a + 0.45), y2 - 8 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
---
<figure class="gp">
  <div class="gp-scroll">
  <svg viewBox="0 0 900 250" role="img" aria-label="c.balances and balances both point at the same map data, so the loop over balances reads the map that other goroutines may write.">
    {[
      { y: 30, name: 'c.balances', bad: false },
      { y: 130, name: 'balances := c.balances', bad: true },
    ].map((v) => {
      const a = arrow(340, v.y + 25, 520, 110 + (v.y < 100 ? 0 : 50));
      return (
        <g>
          <rect x="20" y={v.y} width="320" height="50" rx="8" class="box" />
          <DiagramIcon name="link" x={40} y={v.y + 25} size={24} />
          <text x="62" y={v.y + 30} class="strong">{v.name}</text>
          <text x="324" y={v.y + 30} text-anchor="end" class="muted"><tspan data-lang-en>small header</tspan><tspan data-lang-vi>header nhỏ</tspan></text>
          <g class="arrow"><path d={a.line} /><polygon points={a.head} /></g>
        </g>
      );
    })}
    <rect x="520" y="70" width="240" height="120" rx="8" class="box bad fm-pulse" />
    <DiagramIcon name="db" x={640} y={50} size={26} />
    <text x="640" y="98" text-anchor="middle" class="strong"><tspan data-lang-en>one map, one set of entries</tspan><tspan data-lang-vi>một map, một bộ entry</tspan></text>
    <text x="640" y="130" text-anchor="middle">"a": 10</text>
    <text x="640" y="154" text-anchor="middle">"b": 20</text>
    <text x="640" y="226" text-anchor="middle" class="red"><tspan data-lang-en>the loop reads here while another goroutine may write</tspan><tspan data-lang-vi>vòng lặp đọc ở đây trong khi goroutine khác có thể ghi</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Assigning a map copies the header, not the entries. Both names lead to the same data, so the RUnlock above protects nothing for the loop below it.</span>
    <span data-lang-vi>Gán một map chỉ copy header, không copy entry. Cả hai tên cùng dẫn tới một dữ liệu, nên RUnlock phía trên không bảo vệ gì cho vòng lặp bên dưới.</span>
  </figcaption>
</figure>

<style>
  .gp { margin: 2em 0; width: 100%; }
  .gp-scroll { overflow-x: auto; }
  .gp svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp text { font-size: 14px; fill: var(--text-body); }
  .gp .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp .strong { font-weight: 700; fill: var(--text); }
  .gp .muted { fill: var(--text-muted); }
  .gp .red { fill: var(--red); font-weight: 700; }
  .gp .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp .box.bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp .bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp .bar.bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp .wait { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp .rule { stroke: var(--border); stroke-width: 1; }
  .gp .axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .gp .dot { fill: var(--text-muted); }
  .gp .dot.bad { fill: var(--red); }
  .gp .arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp .arrow polygon { fill: var(--text-muted); }
  .gp .arrow.bad path { stroke: var(--red); }
  .gp .arrow.bad polygon { fill: var(--red); }
  .gp figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
