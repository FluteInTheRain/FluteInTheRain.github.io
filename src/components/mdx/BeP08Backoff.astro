---
// C-BAD, every timestamp from the capture beside the figure (seconds on the
// worker's own clock). Each attempt runs 2 s and fails; waits are drawn to scale.
const W = 900, H = 300;
const X0 = 40, T0 = 11.4, PER_S = 42;
const x = (t: number) => X0 + (t - T0) * PER_S;
const attempts = [
  { n: 1, start: 11.86, end: 13.86, wait: '1 s' },
  { n: 2, start: 14.92, end: 16.94, wait: '2 s' },
  { n: 3, start: 18.99, end: 21.00, wait: '4 s' },
  { n: 4, start: 25.05, end: 27.05, wait: null },
];
const ticks = [12, 14, 16, 18, 20, 22, 24, 26];
---
<figure class="bep8b">
  <div class="bep8b-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A timeline for job C-BAD. Four attempts, each two seconds long and each failing, separated by waits of 1, 2 and 4 seconds. After the fourth failure at 27.05 seconds the job is dead-lettered.">
    {attempts.map((a) => (
      <g>
        <rect x={x(a.start)} y="70" width={(a.end - a.start) * PER_S} height="46" rx="6" class="run" />
        <text x={x(a.start) + ((a.end - a.start) * PER_S) / 2} y="98" text-anchor="middle" class="h"><tspan data-lang-en>attempt {a.n}</tspan><tspan data-lang-vi>lần {a.n}</tspan></text>
        <text x={x(a.start) + ((a.end - a.start) * PER_S) / 2} y="138" text-anchor="middle" class="s"><tspan data-lang-en>fails</tspan><tspan data-lang-vi>lỗi</tspan></text>
        {a.wait && (
          <g>
            <line x1={x(a.end) + 3} y1="93" x2={x(attempts[a.n].start) - 3} y2="93" class="wait" />
            <text x={(x(a.end) + x(attempts[a.n].start)) / 2} y="62" text-anchor="middle" class="code">retry in {a.wait}</text>
          </g>
        )}
      </g>
    ))}
    <rect x={x(27.05) + 14} y="70" width="150" height="46" rx="10" class="dead" />
    <text x={x(27.05) + 89} y="98" text-anchor="middle" class="h red"><tspan data-lang-en>dead-lettered</tspan><tspan data-lang-vi>vào dead-letter</tspan></text>

    <line x1={X0} y1="190" x2={x(27.9)} y2="190" class="axis" />
    {ticks.map((t) => (
      <g>
        <line x1={x(t)} y1="190" x2={x(t)} y2="198" class="axis" />
        <text x={x(t)} y="216" text-anchor="middle" class="s">+{t} s</text>
      </g>
    ))}
    <text x={X0} y="260" class="s"><tspan data-lang-en>time on the worker's own log clock; the waits are a little longer than 1, 2, 4 s because the worker checks the delayed set once a second</tspan><tspan data-lang-vi>thời gian theo đồng hồ log của worker; các khoảng chờ dài hơn 1, 2, 4 s một chút vì worker kiểm tra tập delayed mỗi giây một lần</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Retries with doubling waits, then a cap. The job that cannot succeed ends in a list a human can read, and stops costing worker time.</span>
    <span data-lang-vi>Retry với thời gian chờ nhân đôi, rồi dừng ở mức trần. Job không thể thành công sẽ nằm trong một list để người đọc, và thôi ngốn thời gian của worker.</span>
  </figcaption>
</figure>

<style>
  .bep8b { margin: 2em 0; width: 100%; }
  .bep8b-scroll { overflow-x: auto; }
  .bep8b svg { display: block; width: 100%; min-width: 760px; height: auto; }
  .bep8b text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep8b .h { font-weight: 700; fill: var(--text); font-size: 14px; }
  .bep8b .h.red { fill: var(--red); }
  .bep8b .s { fill: var(--text-muted); font-size: 12.5px; }
  .bep8b .code { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12.5px; fill: var(--text); }
  .bep8b .run { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; }
  .bep8b .dead { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .bep8b .wait { stroke: var(--text-muted); stroke-width: 1.6; stroke-dasharray: 4 4; }
  .bep8b .axis { stroke: var(--text-muted); stroke-width: 1.4; }
  .bep8b figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
