---
// Split-brain (two owners) versus a single consensus-backed authority. Inline SVG, site CSS tokens only.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
type Lbl = { x: number; y: number; c: string; en: string[]; vi: string[]; a?: string; lh?: number };
const W = 900;
const H = 364;
const l1 = arrow(130, 124, 130, 250);
const l2 = arrow(330, 124, 330, 250);
const r1 = arrow(610, 124, 590, 170);
const r2 = arrow(730, 124, 750, 170);
const r3 = arrow(590, 214, 650, 250);
const r4 = arrow(750, 214, 690, 250);
const labels: Lbl[] = [
  { x: 230, y: 38, c: 'h is-hot', en: ['Two owners: split-brain'], vi: ['Hai chủ: split-brain'] },
  { x: 230, y: 57, c: 'sub', en: ['each controller believes it is in charge'], vi: ['mỗi controller tưởng mình đang nắm quyền'] },
  { x: 670, y: 38, c: 'h is-gold', en: ['One authority decides'], vi: ['Một nguồn quyết định duy nhất'] },
  { x: 670, y: 57, c: 'sub', en: ['ZooKeeper, etcd or built-in Raft'], vi: ['ZooKeeper, etcd hoặc Raft tích hợp'] },
  { x: 98, y: 90, c: 'b', a: 'start', en: ['Controller 1'], vi: ['Controller 1'] },
  { x: 98, y: 106, c: 's', a: 'start', en: ['shard 17 is on A'], vi: ['shard 17 ở máy A'] },
  { x: 298, y: 90, c: 'b', a: 'start', en: ['Controller 2'], vi: ['Controller 2'] },
  { x: 298, y: 106, c: 's', a: 'start', en: ['shard 17 is on B'], vi: ['shard 17 ở máy B'] },
  { x: 130, y: 332, c: 'note is-hot', en: ['Writes for shard 17 land on both'], vi: ['Ghi cho shard 17 rơi vào cả hai'] },
  { x: 330, y: 332, c: 'note is-hot', en: ['so the data diverges'], vi: ['nên dữ liệu lệch nhau'] },
  { x: 670, y: 332, c: 'note is-gold', en: ['Everyone follows the same answer: node B'], vi: ['Mọi bên theo cùng một đáp án: node B'] },
  { x: 590, y: 90, c: 'b', a: 'start', en: ['Consensus store'], vi: ['Kho đồng thuận'] },
  { x: 590, y: 106, c: 's', a: 'start', en: ['shard 17 is on B'], vi: ['shard 17 ở máy B'] },
  { x: 572, y: 196, c: 'b', a: 'start', en: ['Router 1'], vi: ['Router 1'] },
  { x: 732, y: 196, c: 'b', a: 'start', en: ['Router 2'], vi: ['Router 2'] },
  { x: 670, y: 143, c: 'sub', en: ['watch'], vi: ['theo dõi'] },
  { x: 140, y: 192, c: 'sub is-hot', a: 'start', en: ['both accept writes'], vi: ['cả hai nhận ghi'] },
];
---
<figure class="shbp">
  <div class="shbp-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: two controllers disagree about shard 17. One says it lives on node A and the other says node B, so writes land on both nodes and the data diverges. Right: a consensus store holds one answer, shard 17 is on node B. Routers watch the store and all send traffic to node B.">
      <rect x="20" y="12" width="420" height="340" rx="8" class="rule" />
      <rect x="460" y="12" width="420" height="340" rx="8" class="rule" />

      <rect x="45" y="68" width="170" height="52" rx="6" class="box is-hot" />
      <DiagramIcon name="server" x={72} y={94} size={26} />
      <rect x="245" y="68" width="170" height="52" rx="6" class="box is-hot" />
      <DiagramIcon name="server" x={272} y={94} size={26} />
      <path d={l1.line} class="arrow is-hot" /><polygon points={l1.head} class="head is-hot" />
      <path d={l2.line} class="arrow is-hot" /><polygon points={l2.head} class="head is-hot" />
      <rect x="55" y="254" width="150" height="46" rx="6" class="box is-hot" />
      <DiagramIcon name="db" x={84} y={277} size={26} />
      <text x="108" y="282" class="b">Node A</text>
      <rect x="255" y="254" width="150" height="46" rx="6" class="box is-hot" />
      <DiagramIcon name="db" x={284} y={277} size={26} />
      <text x="308" y="282" class="b">Node B</text>

      <rect x="540" y="68" width="260" height="56" rx="6" class="box is-gold" />
      <DiagramIcon name="etcd" x={566} y={96} size={28} />
      <path d={r1.line} class="arrow is-gold" /><polygon points={r1.head} class="head is-gold" />
      <path d={r2.line} class="arrow is-gold" /><polygon points={r2.head} class="head is-gold" />
      <rect x="520" y="170" width="140" height="44" rx="6" class="box" />
      <rect x="680" y="170" width="140" height="44" rx="6" class="box" />
      <DiagramIcon name="server" x={548} y={192} size={24} />
      <DiagramIcon name="server" x={708} y={192} size={24} />
      <path d={r3.line} class="arrow is-gold" /><polygon points={r3.head} class="head is-gold" />
      <path d={r4.line} class="arrow is-gold" /><polygon points={r4.head} class="head is-gold" />
      <rect x="595" y="254" width="150" height="46" rx="6" class="box is-gold" />
      <DiagramIcon name="db" x={624} y={277} size={26} />
      <text x="648" y="282" class="b">Node B</text>
      {labels.map((l) => (
        <>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-en>{l.en.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-vi>{l.vi.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
        </>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Left: two controllers give different answers, so shard 17 has two owners. Right: routers read one answer from a consensus store, so there is only ever one owner.</span>
    <span data-lang-vi>Trái: hai controller trả lời khác nhau nên shard 17 có hai chủ. Phải: các router đọc một đáp án duy nhất từ kho đồng thuận, nên luôn chỉ có một chủ.</span>
  </figcaption>
</figure>

<style>
  .shbp { margin: 2em 0; width: 100%; }
  .shbp-scroll { overflow-x: auto; }
  .shbp svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shbp text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shbp .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shbp .h.is-hot { fill: var(--red); }
  .shbp .h.is-gold { fill: var(--gold-icon); }
  .shbp .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shbp .sub.is-gold { fill: var(--gold-icon); font-weight: 600; }
  .shbp .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shbp .b.is-hot { fill: var(--red); }
  .shbp .s { font-size: 12px; fill: var(--text-body); }
  .shbp .s.is-hot { fill: var(--red); font-weight: 600; }
  .shbp .note { font-size: 13px; font-weight: 600; fill: var(--text); }
  .shbp .note.is-hot { fill: var(--red); }
  .shbp .note.is-gold { fill: var(--gold-icon); }
  .shbp .num { font-size: 11px; font-weight: 700; fill: var(--text); }
  .shbp .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbp .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shbp .box.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .shbp .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shbp .box.is-dim { opacity: 0.5; }
  .shbp .circ { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbp .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shbp .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shbp .arrow.is-hot { stroke: var(--red); }
  .shbp .arrow.is-gold { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shbp .arrow.is-strong { stroke: var(--text); stroke-width: 1.7; }
  .shbp .arrow.is-dash { stroke-dasharray: 5 4; }
  .shbp .head { fill: var(--text-muted); }
  .shbp .head.is-hot { fill: var(--red); }
  .shbp .head.is-gold { fill: var(--gold-icon); }
  .shbp .head.is-strong { fill: var(--text); }
  .shbp figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>

