---
// Version vectors on two replicas, A and B: one write overwrites, two others are concurrent.
// Illustrative example.
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Arrow from './ReplicationBArrow.astro';
import Bi from './ReplicationBBi.astro';
---
<Frame h={300}
  label="Version vectors with replicas A and B. Write 1 via A has vector A:1. Write 2 via B, from a client that had seen A:1, has A:1 B:1 and overwrites write 1. Write 3 via A, from another client that had seen A:1, has A:2. Write 2 and write 3 are concurrent: write 3 is higher on A, write 2 is higher on B, so neither covers the other."
  cap="Comparing the counters tells any replica whether a write overwrites another or is concurrent with it. Illustrative values."
  capVi="So sánh các bộ đếm cho phép bất kỳ replica nào biết một lần ghi là ghi đè hay đồng thời. Giá trị minh hoạ.">
  <Node x={20} y={110} w={250} h={74} icon="db" t="Write 1 via replica A" tv="Ghi 1 qua replica A" s="vector {A:1}" sv="vector {A:1}" />
  <Node x={550} y={14} w={330} h={84} icon="db" t="Write 2 via replica B" tv="Ghi 2 qua replica B" s="vector {A:1, B:1}" sv="vector {A:1, B:1}" s2="client had seen {A:1}" s2v="client đã thấy {A:1}" cls="gold" />
  <Node x={550} y={196} w={330} h={84} icon="db" t="Write 3 via replica A" tv="Ghi 3 qua replica A" s="vector {A:2}" sv="vector {A:2}" s2="another client had seen {A:1}" s2v="client khác đã thấy {A:1}" cls="red" />
  <Arrow x1={270} y1={135} x2={550} y2={64} />
  <text x="430" y="82" text-anchor="end" class="rb-n"><Bi en="every counter is at least as high" vi="mọi bộ đếm đều không nhỏ hơn" /></text>
  <Arrow x1={270} y1={160} x2={550} y2={236} />
  <text x="430" y="232" text-anchor="end" class="rb-n"><Bi en="builds on {A:1} too" vi="cũng xây trên {A:1}" /></text>
  <Arrow x1={700} y1={98} x2={700} y2={196} cls="red" />
  <Arrow x1={730} y1={196} x2={730} y2={98} cls="red" />
  <text x="690" y="152" text-anchor="end" class="rb-n rb-bad"><Bi en="concurrent: neither covers the other" vi="đồng thời: không bên nào bao bên kia" /></text>
</Frame>
