---
import BatchDiagram from './BatchDiagram.astro';
const X = [20, 250, 480, 710];
const W = 170;
const row = (y: number) => [0, 1, 2].map((i) => ({ x1: X[i] + W, y1: y + 30, x2: X[i + 1], y2: y + 30 }));
const boxes = [
  { x: X[0], y: 62, w: W, h: 60, t: ['Task, attempt 1', 'Task, lần chạy 1'], s: [['sends email #1', 'gửi email #1']] },
  { x: X[1], y: 62, w: W, h: 60, t: ['Spot VM reclaimed', 'VM spot bị thu hồi'], s: [['at 99% done', 'khi xong 99%']], kind: 'hot' },
  { x: X[2], y: 62, w: W, h: 60, t: ['Task, attempt 2', 'Task, lần chạy 2'], s: [['same partition again', 'lại đúng phân mảnh đó']] },
  { x: X[3], y: 62, w: W, h: 60, t: ['Customer inbox', 'Hộp thư khách'], s: [['gets 2 emails', 'nhận 2 email']], kind: 'hot' },
  { x: X[0], y: 236, w: W, h: 60, t: ['Task, attempt 1', 'Task, lần chạy 1'], s: [['writes staged file', 'ghi file tạm']] },
  { x: X[1], y: 236, w: W, h: 60, t: ['Spot VM reclaimed', 'VM spot bị thu hồi'], s: [['staged file dropped', 'file tạm bị bỏ']], kind: 'hot' },
  { x: X[2], y: 236, w: W, h: 60, t: ['Task, attempt 2', 'Task, lần chạy 2'], s: [['rewrites same file', 'ghi lại file đó']] },
  { x: X[3], y: 236, w: W, h: 60, t: ['Stage commit', 'Commit cả stage'], s: [['publish once, atomically', 'công bố 1 lần, nguyên tử']], kind: 'good' },
];
const arrows = [
  ...row(62).map((a, i) => ({ ...a, kind: i === 2 ? ('hot' as const) : undefined })),
  ...row(236).map((a, i) => ({ ...a, kind: i === 2 ? ('good' as const) : undefined })),
];
const texts = [
  { x: 20, y: 26, cls: 'h', t: ['Unsafe: the task sends the email itself', 'Không an toàn: chính task gửi email'] },
  { x: 20, y: 202, cls: 'h', t: ['Safe: the task only writes a staged file', 'An toàn: task chỉ ghi file tạm'] },
  { x: 20, y: 150, cls: 'warn', t: ['A retry repeats the side effect', 'Chạy lại là lặp luôn tác dụng phụ'] },
  { x: 20, y: 326, cls: 'ok', t: ['A retry just overwrites the same staged file; nothing leaks out', 'Chạy lại chỉ ghi đè file tạm; không có gì lọt ra ngoài'] },
] as const;
---
<BatchDiagram
  w={900} h={346}
  aria="Two rows. Top: a Spark task sends an email, its spot VM is reclaimed, the retry sends it again and the customer gets two emails. Bottom: the task writes a staged file, the retry rewrites it, and the stage commits once."
  boxes={boxes} arrows={arrows} texts={texts as any} rules={[172]}
  caption={['Why a spot retry is safe only when tasks have no side effects until the stage commits.', 'Vì sao chạy lại trên máy spot chỉ an toàn khi task không có tác dụng phụ cho tới lúc commit cả stage.']}
/>
