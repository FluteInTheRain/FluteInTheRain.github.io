---
// Realised volatility of the minimum-variance weights when the covariance is estimated from 60 months of 40 assets
// (shrink.py, default_rng(5), 1,000 trials; true volatility 15% to 30%, correlation 0.35).
import DiagramIcon from './DiagramIcon.astro';
const rows = [
  { en: 'Sample covariance', vi: 'Covariance mẫu', v: 16.1, c: 'redf' },
  { en: 'Equal weight (no estimate at all)', vi: 'Chia đều (không ước lượng gì)', v: 13.6, c: 'grey' },
  { en: 'Shrunk covariance (Ledoit-Wolf)', vi: 'Covariance co lại (Ledoit-Wolf)', v: 11.5, c: 'gold' },
  { en: 'Best possible (true covariance)', vi: 'Tốt nhất có thể (covariance thật)', v: 9.3, c: 'grey' },
];
const W = 900, H = 270;
const sx = (v: number) => v * 30;
---
<figure class="p07d">
  <div class="p07d-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four horizontal bars of realised annual volatility for minimum-variance portfolios of 40 assets built from 60 months of data: sample covariance 16.1 percent, equal weight 13.6 percent, shrunk covariance 11.5 percent, best possible with the true covariance 9.3 percent.">
    <text x="20" y="26" class="h"><tspan data-lang-en>40 assets, 5 years of data: the sample covariance misleads the optimizer</tspan><tspan data-lang-vi>40 tài sản, 5 năm dữ liệu: covariance mẫu đánh lừa optimizer</tspan></text>
    <text x="20" y="48" class="m"><tspan data-lang-en>Realised annual volatility of the portfolio, % (lower is better)</tspan><tspan data-lang-vi>Độ biến động thực tế của danh mục mỗi năm, % (càng thấp càng tốt)</tspan></text>
    {rows.map((r, i) => (
      <g>
        <text x="20" y={90 + i * 54} class="lab"><tspan data-lang-en>{r.en}</tspan><tspan data-lang-vi>{r.vi}</tspan></text>
        <rect x="20" y={98 + i * 54} width={sx(r.v)} height="20" rx="3" class={r.c} />
        <text x={sx(r.v) + 30} y={113 + i * 54} class="num">{r.v}%</text>
      </g>
    ))}
    <DiagramIcon name="warning" x="600" y="104" size="22" />
    <text x="620" y="108" class="sub"><tspan data-lang-en>Worse than not optimizing</tspan><tspan data-lang-vi>Tệ hơn cả khi không tối ưu</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Simulated. With 40 assets and only 60 observations the sample covariance is so noisy that the optimizer loses to 1/N. Shrinking it toward a simple target fixes most of the damage.</span>
    <span data-lang-vi>Mô phỏng. Với 40 tài sản và chỉ 60 quan sát, covariance mẫu nhiễu tới mức optimizer thua cách chia đều 1/N. Co nó về một mục tiêu đơn giản sửa được phần lớn thiệt hại.</span>
  </figcaption>
</figure>

<style>

  .p07d { margin: 2em 0; width: 100%; }
  .p07d-scroll { overflow-x: auto; }
  .p07d svg { display: block; width: 100%; min-width: 600px; height: auto; font-variant-numeric: tabular-nums; }
  .p07d text { font-size: 14px; fill: var(--text-body); }
  .p07d .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p07d .sub { font-size: 12.5px; fill: var(--text-muted); }
  .p07d .m { font-size: 12.5px; fill: var(--text-muted); }
  .p07d .lab { font-size: 13px; font-weight: 600; fill: var(--text); }
  .p07d .bt { font-size: 14px; font-weight: 700; fill: var(--text); }
  .p07d .num { font-size: 13px; font-weight: 700; fill: var(--text); }
  .p07d .num.red { fill: var(--red); }
  .p07d .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p07d .boxred { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .p07d .grid { stroke: var(--border); stroke-width: 1; }
  .p07d .arrow { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.3; }
  .p07d .gold { fill: var(--gold); }
  .p07d .grey { fill: var(--text-muted); opacity: 0.55; }
  .p07d .redf { fill: var(--red); }
  .p07d .line-gold { stroke: var(--gold); stroke-width: 2.5; fill: none; }
  .p07d .line-red { stroke: var(--red); stroke-width: 2.5; fill: none; }
  .p07d .dash { stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 5 4; fill: none; }
  .p07d .dashred { stroke: var(--red); stroke-width: 1.8; stroke-dasharray: 5 4; fill: none; }
  .p07d figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
