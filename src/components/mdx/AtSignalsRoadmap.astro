---
// Maps the three difficulties of Sections 1–3 onto how the rest of the series
// answers them: the Statistics post (Market act) for the faint signal, the
// Regime post for data that never repeats, RL & agents for a market that
// fights back. Act names match src/data/series.ts (Market / ML / DL / RL & Agents).

const W = 900;
const H = 356;

const rows = [
  {
    y: 22,
    diffEn: 'The signal is faint',
    diffVi: 'Tín hiệu mỏng tanh',
    ansEn: [
      'The Statistics post (Market act) — measure the signal first,',
      'then let the Machine learning & Deep learning acts dig where',
      'hand-made features stop',
    ],
    ansVi: [
      'Bài Thống kê (act Thị trường) — đo tín hiệu cho ra ngô ra khoai trước,',
      'rồi để hai act Machine learning & học sâu mò tới nơi feature',
      'thủ công không với tới',
    ],
  },
  {
    y: 130,
    diffEn: 'The data never repeats',
    diffVi: 'Dữ liệu không bao giờ lặp lại',
    ansEn: [
      'The Regime post (Market act) — EWMA to HMM:',
      'detect that the market changed personality',
      'before the old rules cost you money',
    ],
    ansVi: [
      'Bài Regime (act Thị trường) — từ EWMA tới HMM:',
      'nhận ra thị trường đổi tính cách',
      'trước khi luật cũ đốt tiền',
    ],
  },
  {
    y: 238,
    diffEn: 'Everyone fights back',
    diffVi: 'Ai cũng phản công',
    ansEn: [
      'RL & agents act — policies and agent teams that',
      'adapt as the market adapts (DQN/PPO, alpha mining,',
      'agentic investment team)',
    ],
    ansVi: [
      'Act RL & Agent — policy và đội agent tự',
      'thích nghi cùng thị trường (DQN/PPO, khai phá alpha,',
      'đội đầu tư agentic)',
    ],
  },
];

const CX = 236; // chip right edge
const AX = 330; // answer box left edge
const AW = W - AX - 18;
const CHIP_W = 214;
---

<figure class="atsig-road">
  <div class="atsig-road-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Each difficulty of trading on signals maps to how the series answers it: the Statistics post for the faint signal, the Regime post for data that never repeats, RL and agents for a market that fights back.">
      <text x={18} y={14} class="h">
        <tspan data-lang-en>The problem, then the tool</tspan>
        <tspan data-lang-vi>Vấn đề, rồi tới công cụ</tspan>
      </text>
      {rows.map((r) => (
        <g>
          {/* difficulty chip */}
          <rect x={18} y={r.y} width={CHIP_W} height={52} rx="8" class="diff" />
          <text x={18 + CHIP_W / 2} y={r.y + 31} text-anchor="middle" class="diff-label">
            <tspan data-lang-en>{r.diffEn}</tspan>
            <tspan data-lang-vi>{r.diffVi}</tspan>
          </text>
          {/* arrow: plain polygon head, no ids */}
          <line x1={CX + 8} x2={AX - 16} y1={r.y + 26} y2={r.y + 26} class="arrow" />
          <polygon points={`${AX - 10},${r.y + 26} ${AX - 20},${r.y + 21.5} ${AX - 20},${r.y + 30.5}`} class="arrow-head" />
          {/* answer box: three pre-split lines per language */}
          <rect x={AX} y={r.y} width={AW} height={52} rx="8" class="ans" />
          <text x={AX + 14} y={r.y + 21} class="ans-label">
            {(r as { ansEn: string[] }).ansEn.map((line, i) => (
              <tspan x={AX + 14} dy={i === 0 ? 0 : 16} data-lang-en>{line}</tspan>
            ))}
          </text>
          <text x={AX + 14} y={r.y + 21} class="ans-label">
            {(r as { ansVi: string[] }).ansVi.map((line, i) => (
              <tspan x={AX + 14} dy={i === 0 ? 0 : 16} data-lang-vi>{line}</tspan>
            ))}
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>How the rest of the series is built: each difficulty gets the tool that answers it, in the series' reading order.</span>
    <span data-lang-vi>Cách phần còn lại của series được dựng: mỗi khó khăn nhận đúng công cụ để trả lời nó, theo thứ tự đọc của series.</span>
  </figcaption>
</figure>

<style>
  .atsig-road {
    margin: 2em 0;
    width: 100%;
  }
  .atsig-road-scroll {
    overflow-x: auto;
  }
  .atsig-road svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .atsig-road .h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .atsig-road .diff {
    fill: var(--red-tint-bg);
    stroke: var(--red);
  }
  .atsig-road .diff-label {
    font-size: 14.5px;
    font-weight: 700;
    fill: var(--red);
  }
  .atsig-road .ans {
    fill: var(--bg-alt);
    stroke: var(--border);
  }
  .atsig-road .ans-label {
    font-size: 13px;
    fill: var(--text-body);
  }
  .atsig-road .arrow {
    stroke: var(--text-muted);
    stroke-width: 1.4;
  }
  .atsig-road .arrow-head {
    fill: var(--text-muted);
  }
  .atsig-road figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
