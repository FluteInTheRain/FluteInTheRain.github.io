---
// One stock, one year, seen through the four data types the post covers:
// ticks, daily candles, quarterly fundamentals, corporate actions.
// All numbers are illustrative. Bilingual tspans, site CSS tokens, no ids.
const EN = { 'data-lang-en': '' };
const VI = { 'data-lang-vi': '' };
const W = 900;
const H = 470;

// lane tops
const L1 = 72, L2 = 170, L3 = 268, L4 = 366;
const LH = 88; // lane height
const ticks = [
  { en: '09:15:02   27.3   × 1,200', vi: '09:15:02   27,3   × 1.200' },
  { en: '09:15:07   27.3   × 500', vi: '09:15:07   27,3   × 500' },
  { en: '09:15:11   27.4   × 2,000', vi: '09:15:11   27,4   × 2.000' },
  { en: '09:15:15   27.4   × 300', vi: '09:15:15   27,4   × 300' },
];
// three candles: [x, open, close, high, low] in illustrative scale
const candles = [
  { x: 210, o: 27.3, c: 27.6, h: 27.85, l: 27.1 },
  { x: 240, o: 27.6, c: 27.5, h: 27.7, l: 27.35 },
  { x: 270, o: 27.5, c: 28.2, h: 28.4, l: 27.4 },
];
const top = 268, bot = 336, scale = (bot - top) / 1.6; // price range 27.0..28.6
const yOf = (p: number) => bot - (p - 27.0) * scale;
---
<figure class="ads">
  <div class="ads-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The same stock year seen through four data types. Tick data: every trade with its time, price and size, several per minute. Daily candles: one row per day with open, high, low, close and volume. Fundamentals: one row per quarter, revenue and profit, with long gaps in between. Corporate actions: dividend and split events that rewrite past prices.">
    <text x="20" y="26" class="ads-h">
      <tspan data-lang-en>The same stock, through four datasets</tspan>
      <tspan data-lang-vi>Cùng một cổ phiếu, nhìn qua bốn loại dữ liệu</tspan>
    </text>
    <text x="20" y="48" class="ads-sub">
      <tspan data-lang-en>Same company, same period — four different shapes, four different speeds.</tspan>
      <tspan data-lang-vi>Cùng công ty, cùng giai đoạn — bốn hình dạng khác nhau, bốn nhịp cập nhật khác nhau.</tspan>
    </text>

    {/* lane backgrounds */}
    <rect x="14" y={L1 - 22} width={W - 28} height={LH} rx="6" class="ads-lane" />
    <rect x="14" y={L2 - 22} width={W - 28} height={LH} rx="6" class="ads-lane" />
    <rect x="14" y={L3 - 22} width={W - 28} height={LH} rx="6" class="ads-lane" />
    <rect x="14" y={L4 - 22} width={W - 28} height={LH} rx="6" class="ads-lane" />

    {/* lane 1: ticks */}
    <text x="26" y={L1 - 2} class="ads-label">
      <tspan data-lang-en>Tick data</tspan>
      <tspan data-lang-vi>Dữ liệu tick</tspan>
    </text>
    <g {...EN}>{ticks.map((t, k) => <text x="176" y={L1 + 4 + k * 17} class="ads-num">{t.en}</text>)}</g>
    <g {...VI}>{ticks.map((t, k) => <text x="176" y={L1 + 4 + k * 17} class="ads-num">{t.vi}</text>)}</g>
    <text x="470" y={L1 + 22} class="ads-note">
      <tspan data-lang-en>every trade: time, price, size — several per minute</tspan>
      <tspan data-lang-vi>mỗi lệnh khớp: giờ, giá, khối lượng — vài lệnh mỗi phút</tspan>
    </text>

    {/* lane 2: candles */}
    <text x="26" y={L2 - 2} class="ads-label">
      <tspan data-lang-en>Daily candle (OHLCV)</tspan>
      <tspan data-lang-vi>Nến ngày (OHLCV)</tspan>
    </text>
    {candles.map((cd) => (
      <g>
        <line x1={cd.x} y1={yOf(cd.h)} x2={cd.x} y2={yOf(cd.l)} class="ads-wick" />
        <rect x={cd.x - 8} y={Math.min(yOf(cd.o), yOf(cd.c))} width="16" height={Math.max(4, Math.abs(yOf(cd.o) - yOf(cd.c)))} rx="1.5" class={cd.c >= cd.o ? 'ads-body is-up' : 'ads-body is-down'} />
      </g>
    ))}
    <text x="330" y={L2 + 22} class="ads-num">
      <tspan data-lang-en>O 27.30   H 27.85   L 27.10   C 27.60   V 12,400,000</tspan>
      <tspan data-lang-vi>O 27,30   H 27,85   L 27,10   C 27,60   V 12.400.000</tspan>
    </text>
    <text x="660" y={L2 + 22} class="ads-note">
      <tspan data-lang-en>one row per day</tspan>
      <tspan data-lang-vi>một dòng mỗi ngày</tspan>
    </text>

    {/* lane 3: fundamentals */}
    <text x="26" y={L3 - 2} class="ads-label">
      <tspan data-lang-en>Fundamentals</tspan>
      <tspan data-lang-vi>Số liệu tài chính</tspan>
    </text>
    <line x1="176" y1={L3 + 30} x2="846" y2={L3 + 30} class="ads-axis" />
    {[
      { x: 230, en: 'Q1', vi: 'Q1' },
      { x: 356, en: 'Q2', vi: 'Q2' },
      { x: 482, en: 'Q3', vi: 'Q3' },
      { x: 608, en: 'Q4', vi: 'Q4' },
    ].map((q) => (
      <g>
        <circle cx={q.x} cy={L3 + 30} r="5" class="ads-dot" />
        <text x={q.x} y={L3 + 14} text-anchor="middle" class="ads-num">{q.en}</text>
      </g>
    ))}
    <text x="680" y={L3 + 22} class="ads-note">
      <tspan data-lang-en>one row per quarter, weeks late</tspan>
      <tspan data-lang-vi>một dòng mỗi quý, tới chậm vài tuần</tspan>
    </text>

    {/* lane 4: corporate actions */}
    <text x="26" y={L4 - 2} class="ads-label">
      <tspan data-lang-en>Corporate actions</tspan>
      <tspan data-lang-vi>Sự kiện doanh nghiệp</tspan>
    </text>
    <line x1="176" y1={L4 + 30} x2="846" y2={L4 + 30} class="ads-axis" />
    <g>
      <circle cx="300" cy={L4 + 30} r="5" class="ads-dot is-event" />
      <text x="300" y={L4 + 14} text-anchor="middle" class="ads-num">
        <tspan data-lang-en>dividend</tspan>
        <tspan data-lang-vi>cổ tức</tspan>
      </text>
    </g>
    <g>
      <circle cx="560" cy={L4 + 30} r="5" class="ads-dot is-event" />
      <text x="560" y={L4 + 14} text-anchor="middle" class="ads-num">
        <tspan data-lang-en>1.5-for-1 bonus issue</tspan>
        <tspan data-lang-vi>cổ tức cổ phiếu 1.5:1</tspan>
      </text>
    </g>
    <text x="690" y={L4 + 22} class="ads-note">
      <tspan data-lang-en>each event rewrites past prices</tspan>
      <tspan data-lang-vi>mỗi sự kiện viết lại giá trong quá khứ</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Four datasets describe one stock over the same period. Ticks arrive every few seconds, candles once a day, fundamentals once a quarter, corporate actions whenever the company acts. Values shown are illustrative.</span>
    <span data-lang-vi>Bốn bộ dữ liệu mô tả cùng một cổ phiếu trong cùng giai đoạn. Tick về vài giây một lần, nến ngày một dòng mỗi ngày, tài chính một dòng mỗi quý, sự kiện doanh nghiệp tới khi công ty hành động. Số liệu trong hình chỉ để minh hoạ.</span>
  </figcaption>
</figure>

<style>
  .ads { margin: 2em 0; width: 100%; }
  .ads-scroll { overflow-x: auto; }
  .ads svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .ads text { font-size: 14px; fill: var(--text-body); }
  .ads .ads-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ads .ads-sub { fill: var(--text-muted); }
  .ads .ads-label { font-size: 14px; font-weight: 700; fill: var(--text); }
  .ads .ads-note { font-size: 12.5px; fill: var(--text-muted); }
  .ads .ads-num { font-size: 13px; fill: var(--text); }
  .ads-lane { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .ads-axis { stroke: var(--border); stroke-width: 1.2; }
  .ads-dot { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.4; }
  .ads-dot.is-event { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .ads-wick { stroke: var(--text); stroke-width: 1.4; }
  .ads-body { stroke: var(--text); stroke-width: 1.2; }
  .ads-body.is-up { fill: var(--gold-tint-bg); }
  .ads-body.is-down { fill: var(--red-tint-bg); }
  .ads figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
