---
// Same 60 simulated points, two trees. Say the true link is a straight line,
// y = 0.6x plus noise of standard deviation 1. A depth-2 tree (4 leaves) draws
// a four-step staircase; a tree grown until every leaf holds one point (60
// leaves) touches every dot. Rank correlation (python, numpy seed 5): depth 2
// 0.72 on the 60 training points and 0.54 on 5,000 fresh points; full tree 1.00
// and 0.40; the true line itself 0.58 on the fresh points.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 396;
const pts: [number, number][] = [[-1.995, -0.352], [-1.942, -0.324], [-1.926, -1.762], [-1.819, -1.161], [-1.805, 0.267], [-1.784, -1.467], [-1.757, -0.865], [-1.743, -1.067], [-1.657, -0.385], [-1.404, -1.207], [-1.187, -0.865], [-1.091, -0.412], [-1.062, -0.534], [-1.058, -1.5], [-1.055, 0.263], [-1.039, -1.922], [-0.914, -1.75], [-0.857, -1.797], [-0.734, 0.526], [-0.721, -0.793], [-0.7, -1.391], [-0.528, -1.453], [-0.467, 0.141], [-0.43, -1.313], [-0.402, -1.513], [-0.366, 0.394], [-0.26, -1.353], [-0.253, -0.474], [-0.206, -0.13], [-0.028, -0.462], [0.013, -0.046], [0.026, 1.354], [0.028, -0.5], [0.061, -1.223], [0.222, -1.703], [0.225, -0.07], [0.609, 0.013], [0.698, 0.684], [0.707, -0.04], [0.717, -0.049], [0.794, -0.245], [0.83, -0.022], [0.966, 0.74], [1.196, 0.337], [1.2, 0.82], [1.22, 2.633], [1.225, 1.214], [1.232, -0.837], [1.377, 2.56], [1.38, 1.176], [1.48, -0.053], [1.489, 1.8], [1.519, 0.929], [1.582, 0.334], [1.591, 0.321], [1.733, 0.046], [1.746, 1.096], [1.804, 2.151], [1.897, 0.813], [1.997, 1.619]];
const d2: number[] = [-0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.905, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, -0.228, 0.874, 0.874, 0.874, 0.874, 0.874, 0.874, 0.874, 0.874, 0.874, 0.874, 0.874, 0.874, 0.874, 0.874, 0.874, 0.874, 0.874, 0.874, 1.528, 1.528, 1.528, 1.528, 1.528];
const full: number[] = [-0.352, -0.324, -1.762, -1.161, 0.267, -0.865, -1.067, -0.385, -0.385, -0.385, -1.207, -1.207, -1.207, -1.207, -1.207, -0.865, -0.865, -0.865, -0.412, 0.263, -1.922, -1.75, -1.75, -1.797, -1.797, 0.526, -1.391, -1.391, -1.453, -1.453, -1.453, 0.141, -1.513, 0.394, -1.353, -0.474, -0.13, -0.13, -0.462, -0.462, -0.046, -1.223, -1.223, -1.703, -1.703, -0.07, -0.07, -0.07, -0.07, 0.013, 0.013, 0.013, 0.013, 0.013, 0.684, -0.049, -0.245, -0.022, 0.74, 0.74, 0.74, 0.74, 0.337, 0.337, 0.82, -0.837, -0.837, 2.56, 1.176, -0.053, 1.8, 0.929, 0.321, 0.321, 0.046, 1.096, 2.151, 2.151, 0.813, 1.619, 1.619];
const PW = 400, PH = 220, PY = 84;
const panels = [{ x: 20, k: 'd2' }, { x: 480, k: 'full' }];
const sx = (v: number, x0: number) => x0 + (v + 2) / 4 * PW;
const sy = (v: number) => PY + PH / 2 - v / 4 * (PH / 2);
const clamp = (v: number) => Math.max(-3.9, Math.min(3.9, v));
const path = (arr: number[], x0: number) =>
  arr.map((v, i) => `${i ? 'L' : 'M'} ${sx(-2 + i * 0.05, x0).toFixed(1)} ${sy(v).toFixed(1)}`).join(' ');
---
<figure class="atp08-st">
  <div class="atp08-st-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two panels with the same 60 noisy points around a rising line. Left: a depth-2 tree draws a four-step staircase that follows the trend; its rank correlation is 0.72 on these points and 0.54 on fresh ones. Right: a tree grown until every leaf has one point jumps to every dot; its rank correlation is 1.00 here and 0.40 on fresh points.">
      <DiagramIcon name="model" x={22} y={22} size={22} />
      <text x="44" y="28" class="h">
        <tspan data-lang-en>A tree can draw the trend, or memorise the dots</tspan>
        <tspan data-lang-vi>Một cây có thể vẽ xu hướng, hoặc thuộc lòng từng chấm</tspan>
      </text>
      {panels.map((p) => (
        <g>
          <rect x={p.x} y={PY} width={PW} height={PH} rx="6" class="panel" />
          <line x1={p.x} y1={PY + PH / 2} x2={p.x + PW} y2={PY + PH / 2} class="axis" />
          {pts.map(([a, b]) => <circle cx={sx(a, p.x)} cy={sy(clamp(b))} r="3" class="dot" />)}
          <path d={path(p.k === 'd2' ? d2 : full, p.x)} class={`fit ${p.k}`} />
          <text x={p.x} y={PY - 10} class="t">
            {p.k === 'd2' ? (
              <>
                <tspan data-lang-en>Depth 2: 4 leaves</tspan>
                <tspan data-lang-vi>Độ sâu 2: 4 lá</tspan>
              </>
            ) : (
              <>
                <tspan data-lang-en>Grown until each leaf has one point: 60 leaves</tspan>
                <tspan data-lang-vi>Cho mọc tới khi mỗi lá một điểm: 60 lá</tspan>
              </>
            )}
          </text>
          <text x={p.x} y={PY + PH + 26} class="stat">
            {p.k === 'd2' ? (
              <>
                <tspan data-lang-en>rank correlation: 0.72 on these points, 0.54 on fresh ones</tspan>
                <tspan data-lang-vi>tương quan hạng: 0,72 trên các điểm này, 0,54 trên điểm mới</tspan>
              </>
            ) : (
              <>
                <tspan data-lang-en>rank correlation: 1.00 on these points, 0.40 on fresh ones</tspan>
                <tspan data-lang-vi>tương quan hạng: 1,00 trên các điểm này, 0,40 trên điểm mới</tspan>
              </>
            )}
          </text>
        </g>
      ))}
      <text x="20" y="372" class="note">
        <tspan data-lang-en>For reference, the true straight line scores 0.58 on fresh points: the ceiling nobody can see in real data.</tspan>
        <tspan data-lang-vi>Để so: đường thẳng thật đạt 0,58 trên điểm mới. Đó là trần mà dữ liệu thật không bao giờ cho ta thấy.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Simulated: y = 0.6x plus noise, 60 points. The deep tree scores a perfect 1.00 on the points it has seen and falls below the shallow one on new data.</span>
    <span data-lang-vi>Mô phỏng: y = 0,6x cộng nhiễu, 60 điểm. Cây sâu đạt 1,00 hoàn hảo trên các điểm nó đã thấy, rồi tụt xuống dưới cây nông khi gặp dữ liệu mới.</span>
  </figcaption>
</figure>

<style>
  .atp08-st { margin: 2em 0; width: 100%; }
  .atp08-st-scroll { overflow-x: auto; }
  .atp08-st svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp08-st text { font-size: 14px; fill: var(--text-body); }
  .atp08-st .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp08-st .t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .atp08-st .stat { font-size: 13px; fill: var(--text); }
  .atp08-st .note { font-size: 12.5px; fill: var(--text-muted); }
  .atp08-st .panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .atp08-st .axis { stroke: var(--border); stroke-width: 1.2; }
  .atp08-st .dot { fill: var(--text-faint); opacity: 0.8; }
  .atp08-st .fit { fill: none; stroke-width: 2.4; stroke-linejoin: round; }
  .atp08-st .fit.d2 { stroke: var(--gold-icon); }
  .atp08-st .fit.full { stroke: var(--red); stroke-width: 1.6; }
  .atp08-st figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
