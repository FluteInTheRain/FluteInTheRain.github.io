---
// The trace-first habit: see where the trace pauses, read the receipt,
// open the profiler only if the receipt says the time is yours.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 300;
const rows = [
  { y: 30, icon: 'curl', disc: true, title: 'curl -v', sub: { en: 'where does the trace pause?', vi: 'trace dừng ở đâu?' }, note: { en: 'resolve · connect · TLS · first byte', vi: 'resolve · connect · TLS · byte đầu tiên' }, red: false },
  { y: 118, icon: 'log', disc: false, title: 'access log', sub: { en: 'the receipt from your red box', vi: 'biên lai từ ô đỏ của bạn' }, note: { en: 'did the request arrive? how long was your part?', vi: 'request có tới không? phần của bạn mất bao lâu?' }, red: true },
  { y: 206, icon: 'profiler', disc: false, title: 'profiler', sub: { en: 'open it last, not first', vi: 'mở sau cùng, đừng mở trước' }, note: { en: 'only if the receipt says the time is yours', vi: 'chỉ khi biên lai nói thời gian là của bạn' }, red: false },
];
---
<figure class="bep1e">
  <div class="bep1e-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The trace-first habit: run curl -v and see where the trace pauses, read the access log receipt, and open the profiler only if the receipt says the time is yours.">
    {(() => { const a = arrow(50, 78, 50, 134); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
    {(() => { const a = arrow(50, 166, 50, 222); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
    {rows.map((r, i) => (
      <g>
        <circle cx="50" cy={r.y + 32} r="14" class={r.red ? 'ncr' : 'nc'} />
        <text x="50" y={r.y + 37} text-anchor="middle" class={r.red ? 'n r' : 'n'}>{i + 1}</text>
        <rect x="78" y={r.y} width="260" height="64" rx="8" class={r.red ? 'boxr' : 'box'} />
        {r.disc && <circle cx="107" cy={r.y + 32} r="18" class="disc" />}
        <image href={`/icons/flow/${r.icon}.svg`} x="92" y={r.y + 17} width="30" height="30" class="icn" aria-hidden="true" />
        <text x="136" y={r.y + 28} class="t">{r.title}</text>
        <text x="136" y={r.y + 50} class="m"><tspan data-lang-en>{r.sub.en}</tspan><tspan data-lang-vi>{r.sub.vi}</tspan></text>
        <text x="360" y={r.y + 32} class="a"><tspan data-lang-en>{r.note.en}</tspan><tspan data-lang-vi>{r.note.vi}</tspan></text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>When something is slow, walk the stations in order — find the station first, then fix the right box.</span>
    <span data-lang-vi>Có gì chậm, đi từng trạm theo thứ tự — tìm đúng trạm trước, rồi sửa đúng ô.</span>
  </figcaption>
</figure>

<style>
  .bep1e { margin: 2em 0; width: 100%; }
  .bep1e-scroll { overflow-x: auto; }
  .bep1e svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep1e text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep1e .t { font-weight: 700; fill: var(--text); }
  .bep1e .m { fill: var(--text-muted); font-size: 12.5px; }
  .bep1e .a { fill: var(--text-body); font-size: 13.5px; }
  .bep1e .n { font-weight: 700; fill: var(--text); }
  .bep1e .r { fill: var(--red); }
  .bep1e .nc { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; }
  .bep1e .ncr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 2; }
  .bep1e .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep1e .boxr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bep1e .disc { fill: none; }
  .bep1e .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep1e .hd { fill: var(--text-muted); }
  .bep1e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  :global([data-theme='dark']) .bep1e .disc { fill: rgba(255, 255, 255, 0.88); }
</style>
