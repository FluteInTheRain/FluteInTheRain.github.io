---
// gen -> in -> three copies of square (a, b, c) -> merge -> out -> main. Names from the fan-out program in the post.
// Icons: DiagramIcon (gopher = goroutine, stream = merge). Motion: fm-flow on every data arrow (direction of the values).
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const W = 900;
const H = 262;
const gen = { x: 20, y: 92, w: 110, h: 52 };
const sq = [
  { n: 'a', y: 24 },
  { n: 'b', y: 92 },
  { n: 'c', y: 160 },
];
const sqX = 270;
const sqW = 170;
const sqH = 52;
const mg = { x: 580, y: 92, w: 110, h: 52 };
const mn = { x: 780, y: 92, w: 100, h: 52 };
const midY = 118;
---
<figure class="gp09fan">
  <div class="gp09fan-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="gen sends values into the channel in. Three copies of square, a, b and c, read from in, each value goes to one of them. merge copies the three outputs into out, and main reads out.">
    <g class="gp09fan-box">
      <rect x={gen.x} y={gen.y} width={gen.w} height={gen.h} rx="8" />
      <DiagramIcon name="gopher" x={gen.x + 24} y={gen.y + 26} size={28} />
      <text x={gen.x + 68} y={gen.y + 31} text-anchor="middle" class="gp09fan-name">gen</text>
    </g>
    {sq.map((s) => {
      const a = arrow(gen.x + gen.w + 6, midY, sqX - 8, s.y + sqH / 2);
      const b = arrow(sqX + sqW + 8, s.y + sqH / 2, mg.x - 8, midY);
      return (
        <g>
          <g class="gp09fan-arrow"><path class="fm-flow" d={a.line} /><polygon points={a.head} /></g>
          <g class="gp09fan-arrow"><path class="fm-flow" d={b.line} /><polygon points={b.head} /></g>
          <g class="gp09fan-box">
            <rect x={sqX} y={s.y} width={sqW} height={sqH} rx="8" />
            <DiagramIcon name="gopher" x={sqX + 24} y={s.y + 26} size={28} />
            <text x={sqX + 48} y={s.y + 22} class="gp09fan-name">square ({s.n})</text>
            <text x={sqX + 48} y={s.y + 41} class="gp09fan-muted">
              <tspan data-lang-en>50 ms per value</tspan>
              <tspan data-lang-vi>50 ms mỗi giá trị</tspan>
            </text>
          </g>
        </g>
      );
    })}
    <g class="gp09fan-box">
      <rect x={mg.x} y={mg.y} width={mg.w} height={mg.h} rx="8" />
      <DiagramIcon name="stream" x={mg.x + 24} y={mg.y + 26} size={28} />
      <text x={mg.x + 68} y={mg.y + 31} text-anchor="middle" class="gp09fan-name">merge</text>
    </g>
    {(() => { const a = arrow(mg.x + mg.w + 8, midY, mn.x - 8, midY); return <g class="gp09fan-arrow"><path class="fm-flow" d={a.line} /><polygon points={a.head} /></g>; })()}
    <text x={(mg.x + mg.w + mn.x) / 2} y={midY - 10} text-anchor="middle" class="gp09fan-muted">out</text>
    <g class="gp09fan-box">
      <rect x={mn.x} y={mn.y} width={mn.w} height={mn.h} rx="8" />
      <DiagramIcon name="gopher" x={mn.x + 24} y={mn.y + 26} size={28} />
      <text x={mn.x + 62} y={mn.y + 31} text-anchor="middle" class="gp09fan-name">main</text>
    </g>

    <text x="200" y="240" text-anchor="middle" class="gp09fan-h">
      <tspan data-lang-en>Fan-out: one channel, three readers</tspan>
      <tspan data-lang-vi>Fan-out: một channel, ba bên đọc</tspan>
    </text>
    <text x="585" y="240" text-anchor="middle" class="gp09fan-h">
      <tspan data-lang-en>Fan-in: three channels into one</tspan>
      <tspan data-lang-vi>Fan-in: ba channel thành một</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The channel in is shared: each value is taken by exactly one copy of square, so three copies share the nine values. merge gives main one channel to read, in whatever order values finish.</span>
    <span data-lang-vi>Channel in được dùng chung: mỗi giá trị chỉ do đúng một bản square lấy, nên ba bản chia nhau chín giá trị. merge đưa cho main một channel duy nhất để đọc, theo thứ tự giá trị xong.</span>
  </figcaption>
</figure>

<style>
  .gp09fan { margin: 2em 0; width: 100%; }
  .gp09fan-scroll { overflow-x: auto; }
  .gp09fan svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp09fan text { font-size: 14px; fill: var(--text-body); }
  .gp09fan .gp09fan-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp09fan-box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp09fan-box.is-bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-dasharray: 4 3; }
  .gp09fan .gp09fan-name { font-weight: 700; fill: var(--text); }
  .gp09fan .gp09fan-bad { fill: var(--red); font-weight: 700; }
  .gp09fan .gp09fan-muted { fill: var(--text-muted); }
  .gp09fan-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp09fan-arrow polygon { fill: var(--text-muted); }
  .gp09fan-rule { stroke: var(--border); }
  .gp09fan figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
