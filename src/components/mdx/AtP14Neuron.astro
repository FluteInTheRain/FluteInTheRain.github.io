---
// One artificial neuron, with numbers. Say three features of a stock on one day
// go in: momentum 0.8, volume change -0.3, volatility 0.5. The weights (0.9, 0.4, -0.7)
// and the bias (0.1) are made up for the picture; the arithmetic is checked in Python:
// 0.8*0.9 + (-0.3)*0.4 + 0.5*(-0.7) + 0.1 = 0.35, ReLU(0.35) = 0.35;
// second day (-0.5, 0.6, 0.9) gives -0.74, ReLU(-0.74) = 0.
const W = 900;
const H = 380;
const ins = [
  { y: 84, en: 'momentum', vi: 'đà tăng', v: '0.8', w: '0.9' },
  { y: 156, en: 'volume change', vi: 'thay đổi khối lượng', v: '-0.3', w: '0.4' },
  { y: 228, en: 'volatility', vi: 'biến động', v: '0.5', w: '-0.7' },
];
// ReLU mini plot box: x 600..720, y 100..210, zero line at y=190
const rx = (t: number) => 610 + (t + 1) * 50; // t in [-1, 1]
const ry = (v: number) => 190 - v * 80;
---
<figure class="atp14-neu">
  <div class="atp14-neu-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="One artificial neuron. Three inputs (momentum 0.8, volume change -0.3, volatility 0.5) are multiplied by weights 0.9, 0.4 and -0.7, added together with a bias of 0.1 to give 0.35, and passed through ReLU, which keeps 0.35. On another day the sum is -0.74 and ReLU outputs 0.">
    <text x="20" y="28" class="h">
      <tspan data-lang-en>A neuron is a weighted sum with a floor</tspan>
      <tspan data-lang-vi>Một nơ-ron là tổng có trọng số, kèm một cái sàn</tspan>
    </text>
    <text x="20" y="50" class="sub">
      <tspan data-lang-en>Weights and bias are made up for the picture; training is what sets them.</tspan>
      <tspan data-lang-vi>Trọng số và bias là số tự đặt cho hình; huấn luyện mới là bước đặt chúng.</tspan>
    </text>

    {ins.map((r) => (
      <g>
        <rect x="20" y={r.y - 22} width="190" height="44" rx="6" class="box" />
        <text x="32" y={r.y - 3} class="lab">
          <tspan data-lang-en>{r.en}</tspan>
          <tspan data-lang-vi>{r.vi}</tspan>
        </text>
        <text x="32" y={r.y + 14} class="val">{r.v}</text>
        <line x1="212" y1={r.y} x2="402" y2={156 + (r.y - 156) * 0.35} class="wire" />
        <text x="240" y={r.y + (156 - r.y) * 0.1 - 14} class="wlab">× {r.w}</text>
      </g>
    ))}

    <circle cx="430" cy="156" r="34" class="node" />
    <text x="430" y="152" text-anchor="middle" class="nodeT">Σ + 0.1</text>
    <text x="430" y="170" text-anchor="middle" class="nodeS">= 0.35</text>
    <text x="430" y="206" text-anchor="middle" class="sub">
      <tspan data-lang-en>bias 0.1</tspan>
      <tspan data-lang-vi>bias 0,1</tspan>
    </text>

    <line x1="466" y1="156" x2="590" y2="156" class="wire" />
    <polygon points="590,151 600,156 590,161" class="arrow" />

    <rect x="602" y="92" width="136" height="126" rx="6" class="box" />
    <line x1="610" y1="190" x2="730" y2="190" class="axis" />
    <line x1="660" y1="100" x2="660" y2="206" class="axis" />
    <polyline points={`${rx(-1)},${ry(0)} ${rx(0)},${ry(0)} ${rx(1)},${ry(1)}`} class="relu" />
    <text x="670" y="112" class="tick">ReLU</text>
    <text x="670" y="208" class="tick">
      <tspan data-lang-en>max(0, sum)</tspan>
      <tspan data-lang-vi>max(0, tổng)</tspan>
    </text>

    <line x1="740" y1="156" x2="800" y2="156" class="wire" />
    <polygon points="800,151 810,156 800,161" class="arrow" />
    <rect x="812" y="128" width="68" height="56" rx="6" class="box good" />
    <text x="846" y="154" text-anchor="middle" class="valBig">0.35</text>
    <text x="846" y="172" text-anchor="middle" class="tick">
      <tspan data-lang-en>output</tspan>
      <tspan data-lang-vi>đầu ra</tspan>
    </text>


    <rect x="20" y="288" width="860" height="68" rx="6" class="panel" />
    <text x="36" y="312" class="lab">
      <tspan data-lang-en>Another day: momentum -0.5, volume change 0.6, volatility 0.9.</tspan>
      <tspan data-lang-vi>Một ngày khác: đà tăng -0.5, thay đổi khối lượng 0.6, biến động 0.9.</tspan>
    </text>
    <text x="36" y="338" class="note">
      <tspan data-lang-en>-0.5×0.9 + 0.6×0.4 + 0.9×(-0.7) + 0.1 = -0.74, and ReLU turns it into 0. The neuron stays silent.</tspan>
      <tspan data-lang-vi>-0.5×0.9 + 0.6×0.4 + 0.9×(-0.7) + 0.1 = -0.74, và ReLU biến nó thành 0. Nơ-ron im lặng.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>One neuron: multiply each input by its weight, add the bias, clip anything below zero. A layer is a row of these, each with its own weights.</span>
    <span data-lang-vi>Một nơ-ron: nhân mỗi đầu vào với trọng số của nó, cộng bias, cắt mọi giá trị dưới 0. Một layer là một hàng nơ-ron như vậy, mỗi cái có trọng số riêng.</span>
  </figcaption>
</figure>

<style>
  .atp14-neu { margin: 2em 0; width: 100%; }
  .atp14-neu-scroll { overflow-x: auto; }
  .atp14-neu svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .atp14-neu text { font-size: 14px; fill: var(--text-body); }
  .atp14-neu .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp14-neu .sub { font-size: 13px; fill: var(--text-muted); }
  .atp14-neu .lab { font-size: 13px; font-weight: 600; fill: var(--text-muted); }
  .atp14-neu .val { font-size: 15px; font-weight: 700; fill: var(--text); }
  .atp14-neu .valBig { font-size: 20px; font-weight: 700; fill: var(--text); }
  .atp14-neu .wlab { font-size: 13px; font-weight: 700; fill: var(--text); }
  .atp14-neu .nodeT { font-size: 14px; font-weight: 700; fill: var(--text); }
  .atp14-neu .nodeS { font-size: 13px; fill: var(--text-muted); }
  .atp14-neu .tick { font-size: 12px; fill: var(--text-muted); }
  .atp14-neu .note { font-size: 13.5px; fill: var(--text-body); }
  .atp14-neu .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .atp14-neu .box.good { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .atp14-neu .panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .atp14-neu .node { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.4; }
  .atp14-neu .wire { stroke: var(--text-muted); stroke-width: 1.3; fill: none; }
  .atp14-neu .arrow { fill: var(--text-muted); }
  .atp14-neu .axis { stroke: var(--border); stroke-width: 1.2; }
  .atp14-neu .relu { fill: none; stroke: var(--red); stroke-width: 2.4; }
  .atp14-neu figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
