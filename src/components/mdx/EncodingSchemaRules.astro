---
import EncodingStepCards from './EncodingStepCards.astro';
const props = {
 "arrows": false,
 "title": {
  "en": "What a reader does when the two schemas differ",
  "vi": "Bên đọc làm gì khi hai schema khác nhau"
 },
 "alt": "Four cases. Protocol Buffers skips an unknown tag because the wire type says how long the value is. Protocol Buffers gives a missing tag the type's default. Avro ignores a field only the writer has. Avro gives a field only the reader has the default declared in the reader's schema, and fails if there is no default.",
 "cards": [
  {
   "icon": "ok",
   "head": {
    "en": [
     "Protobuf: unknown tag"
    ],
    "vi": [
     "Protobuf: tag lạ"
    ]
   },
   "lines": {
    "en": [
     "Skipped. The wire type",
     "says how long the value",
     "is."
    ],
    "vi": [
     "Bị bỏ qua. Wire type",
     "cho biết giá trị dài",
     "bao nhiêu."
    ]
   },
   "tone": "plain"
  },
  {
   "icon": "ok",
   "head": {
    "en": [
     "Protobuf: tag missing"
    ],
    "vi": [
     "Protobuf: thiếu tag"
    ]
   },
   "lines": {
    "en": [
     "The reader gets the type's",
     "default: 0, an empty",
     "string, false."
    ],
    "vi": [
     "Bên đọc nhận giá trị",
     "mặc định của kiểu: 0,",
     "chuỗi rỗng, false."
    ]
   },
   "tone": "plain"
  },
  {
   "icon": "ok",
   "head": {
    "en": [
     "Avro: writer-only field"
    ],
    "vi": [
     "Avro: chỉ bên ghi có"
    ]
   },
   "lines": {
    "en": [
     "Ignored by the reader."
    ],
    "vi": [
     "Bên đọc bỏ qua."
    ]
   },
   "tone": "plain"
  },
  {
   "icon": "warning",
   "head": {
    "en": [
     "Avro: reader-only field"
    ],
    "vi": [
     "Avro: chỉ bên đọc có"
    ]
   },
   "lines": {
    "en": [
     "Gets the default from the",
     "reader's schema. With no",
     "default, decoding fails."
    ],
    "vi": [
     "Nhận default trong schema",
     "của bên đọc. Không có",
     "default thì giải mã lỗi."
    ]
   },
   "tone": "plain"
  }
 ],
 "note": {
  "en": "So in Avro, add or remove only fields that have a default.",
  "vi": "Vì vậy ở Avro, chỉ thêm hoặc bớt trường có default."
 },
 "caption": {
  "en": "The two formats fail differently: protobuf quietly fills in, while Avro fails only when a field the reader expects has no default.",
  "vi": "Hai định dạng hỏng theo hai cách: protobuf lặng lẽ điền vào, còn Avro chỉ lỗi khi trường bên đọc cần không có default."
 }
};
---
<EncodingStepCards {...props} />
