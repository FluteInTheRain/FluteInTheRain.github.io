---
import BatchDiagram from './BatchDiagram.astro';
const boxes = [{"x": 20, "y": 170, "w": 150, "h": 64, "t": ["One big file", "Một file lớn"], "s": [["e.g. 384 MB", "ví dụ 384 MB"]], "icon": "file"}, {"x": 505, "y": 36, "w": 300, "h": 56, "t": ["NameNode (metadata)", "NameNode (metadata)"], "s": [["which node holds which block", "node nào giữ block nào"]], "icon": "server"}, {"x": 270, "y": 170, "w": 130, "h": 64, "t": ["Node A", "Node A"], "s": [["B1 · B3", "B1 · B3"]], "icon": "server"}, {"x": 430, "y": 170, "w": 130, "h": 64, "t": ["Node B", "Node B"], "s": [["B1 · B2", "B1 · B2"]], "icon": "server"}, {"x": 590, "y": 170, "w": 130, "h": 64, "t": ["Node C", "Node C"], "s": [["B1 · B2 · B3", "B1 · B2 · B3"]], "icon": "server"}, {"x": 750, "y": 170, "w": 130, "h": 64, "t": ["Node D", "Node D"], "s": [["B2 · B3", "B2 · B3"]], "icon": "server"}];
const arrows = [{"x1": 170, "y1": 202, "x2": 270, "y2": 202, "label": ["split", "chia nhỏ"], "lx": 220, "ly": 184}, {"x1": 655, "y1": 92, "x2": 655, "y2": 170, "label": ["tracks locations", "theo dõi vị trí"], "kind": "dash", "lx": 735, "ly": 136}];
const texts = [{"x": 20, "y": 270, "cls": "foot", "t": ["Block B1 sits on nodes A, B and C; B2 on B, C and D; B3 on C, D and A in this layout.", "Block B1 nằm ở node A, B, C; B2 ở B, C, D; B3 ở C, D, A theo cách xếp này."]}, {"x": 20, "y": 294, "cls": "ok", "t": ["Three copies on different machines: one dead disk loses nothing.", "Ba bản trên các máy khác nhau: hỏng một đĩa không mất gì."]}, {"x": 20, "y": 316, "cls": "foot", "t": ["Erasure coding keeps parity shards instead, at about 1.5x storage rather than 3x.", "Erasure coding giữ các mảnh parity thay vì bản sao, tốn khoảng 1,5 lần dung lượng thay vì 3 lần."]}];
---
<BatchDiagram
  w={900} h={330}
  aria="A big file is split into 128 MB blocks. Each block is copied to three of four data nodes. A NameNode tracks where every block lives."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any} rules={[]} icons={[]}
  caption={["A distributed filesystem trades many tiny blocks for a few huge ones, and copies each across machines.", "Hệ thống file phân tán đổi vô số block nhỏ lấy ít block lớn, rồi sao mỗi block ra nhiều máy."]}
/>
