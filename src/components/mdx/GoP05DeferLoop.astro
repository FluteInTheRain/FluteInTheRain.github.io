---
// Post 5, defer in a loop: events in the order printed by the example, plus how many files stay open.
const top = ['open a', 'open b', 'open c', 'all processed', 'close c', 'close b', 'close a'];
const topOpen = [1, 2, 3, 3, 2, 1, 0];
const bottom = ['open a', 'close a', 'open b', 'close b', 'open c', 'close c'];
const bottomOpen = [1, 0, 1, 0, 1, 0];
const rows = [
  { y: 22, items: top, open: topOpen, en: 'defer inside the loop (processAll)', vi: 'defer trong vòng lặp (processAll)' },
  { y: 182, items: bottom, open: bottomOpen, en: 'Loop body in its own function (processOne)', vi: 'Thân vòng lặp tách thành hàm riêng (processOne)' },
];
const slot = 124;
---
<figure class="gp05c">
  <div class="gp05c-scroll">
  <svg viewBox="0 0 900 340" role="img" aria-label="With defer inside the loop, all three opens happen before any close, so up to three files are open at once. With the body in its own function, at most one file is open.">
    {rows.map((r) => (
      <g>
        <text x="20" y={r.y} class="h"><tspan data-lang-en>{r.en}</tspan><tspan data-lang-vi>{r.vi}</tspan></text>
        {r.items.map((t, i) => (
          <g>
            <rect class={t === 'all processed' ? 'box dash' : 'box'} x={20 + i * slot} y={r.y + 16} width={slot - 12} height="30" rx="5" />
            <text x={20 + i * slot + (slot - 12) / 2} y={r.y + 36} text-anchor="middle" class={t === 'all processed' ? 'm' : ''}>{t}</text>
            {r.open[i] > 0 && <rect class={r.open[i] >= 3 ? 'bar red' : 'bar'} x={20 + i * slot + (slot - 12) / 2 - 20} y={r.y + 130 - r.open[i] * 16} width="40" height={r.open[i] * 16} />}
            <text x={20 + i * slot + (slot - 12) / 2} y={r.y + 130 - r.open[i] * 16 - 6} text-anchor="middle" class={r.open[i] >= 3 ? 'r n' : 'm n'}>{r.open[i]}</text>
          </g>
        ))}
        <line class="rule" x1="20" x2="880" y1={r.y + 130} y2={r.y + 130} />
        <text x="20" y={r.y + 82} class="m"><tspan data-lang-en>files open:</tspan><tspan data-lang-vi>số file đang mở:</tspan></text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The events are the output of the example above, left to right. The bars count files still open after each line, assuming every open keeps a real file open until its close.</span>
    <span data-lang-vi>Các sự kiện là output của ví dụ trên, từ trái sang phải. Cột đếm số file còn mở sau mỗi dòng, giả sử mỗi lần open giữ một file thật cho tới khi close.</span>
  </figcaption>
</figure>

<style>
  .gp05c { margin: 2em 0; width: 100%; }
  .gp05c-scroll { overflow-x: auto; }
  .gp05c svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp05c text { font-size: 14px; fill: var(--text-body); }
  .gp05c .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp05c .b { font-weight: 700; fill: var(--text); }
  .gp05c .m { fill: var(--text-muted); font-size: 13px; }
  .gp05c .n { font-variant-numeric: tabular-nums; }
  .gp05c .r { fill: var(--red); font-weight: 700; }
  .gp05c .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp05c .box.red { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp05c .box.dash { stroke-dasharray: 4 3; }
  .gp05c .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp05c .ln.red { stroke: var(--red); }
  .gp05c .ln.cut { stroke-dasharray: 3 4; opacity: 0.5; }
  .gp05c .hd { fill: var(--text-muted); }
  .gp05c .hd.red { fill: var(--red); }
  .gp05c .rule { stroke: var(--border); }
  .gp05c .bar { fill: var(--text-muted); }
  .gp05c .bar.red { fill: var(--red); }
  .gp05c figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
