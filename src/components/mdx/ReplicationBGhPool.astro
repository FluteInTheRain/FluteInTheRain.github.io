---
// GitHub, 22 Oct 2018, 11:12 UTC: primaries are back but dozens of replicas are hours behind, and
// reads are spread across the pool. The number of squares drawn is illustrative.
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Arrow from './ReplicationBArrow.astro';
import DiagramIcon from './DiagramIcon.astro';
import Bi from './ReplicationBBi.astro';
const cols = [0, 1, 2, 3, 4];
const rows = [64, 140];
---
<Frame h={250}
  label="GitHub, 22 October 2018, 11:12 UTC. The primaries are up to date. Reads are spread across a large pool of read replicas, and many of them are hours behind, so any request can land on a stale one."
  cap="Because reads are spread across the pool, each request has a good chance of hitting a stale replica. The number of squares is only for illustration."
  capVi="Vì lệnh đọc được rải khắp pool, mỗi request có nhiều khả năng rơi vào một replica cũ. Số ô vuông chỉ để minh hoạ.">
  <Node x={20} y={90} w={190} h={70} icon="users" t="Many users" tv="Nhiều người dùng" s="reads spread out" sv="đọc được rải ra" />
  <Arrow x1={210} y1={125} x2={300} y2={125} />
  <rect x="300" y="14" width="390" height="214" rx="8" class="rb-box dash" />
  <text x="495" y="38" text-anchor="middle" class="rb-h"><Bi en="Read replicas" vi="Các read replica" /></text>
  {rows.map((y) => cols.map((c) => (
    <g>
      <rect x={316 + c * 72} y={y} width="60" height="56" rx="5" class="rb-box red" />
      <DiagramIcon name="db" x={346 + c * 72} y={y + 28} size={28} />
    </g>
  )))}
  <text x="495" y="218" text-anchor="middle" class="rb-n rb-bad"><Bi en="hours behind the primary" vi="chậm hơn primary vài giờ" /></text>
  <Node x={720} y={90} w={170} h={70} icon="db" t="Primary" tv="Primary" s="up to date" sv="đã cập nhật" s2="11:12 UTC, 22 Oct" s2v="11:12 UTC, 22/10" cls="gold" />
  <Arrow x1={720} y1={125} x2={692} y2={125} cls="dash" />
</Frame>
