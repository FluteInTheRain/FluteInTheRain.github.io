---
// Visual capstone for Parts 1–8: a single realistic UI card annotated with
// 6 numbered diagnostic callouts linking back to hierarchy, spacing, type,
// colour, depth, and finishing touches.

const W = 900;
const H = 436;
---

<figure class="lac">
  <div class="lac-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Annotated UI card showing six diagnostic checkpoints from Parts 1 through 8: visual hierarchy, grouped spacing, typography scale, tinted colour contrast, two-part depth shadow, and finishing details.">
      <text x="20" y="26" class="lac-h">
        <tspan data-lang-en>Six-point design-eye audit on a single UI card (Parts 1–8 in one glance)</tspan>
        <tspan data-lang-vi>Kiểm tra 6 điểm bằng mắt trên một thẻ giao diện (tổng hợp Bài 1–8)</tspan>
      </text>

      {/* Center UI card with layered two-part shadow illusion (no SVG filter ID needed) */}
      <rect x="266" y="66" width="368" height="328" rx="12" class="lac-shadow-wide" />
      <rect x="266" y="60" width="368" height="328" rx="12" class="lac-shadow-tight" />
      <rect x="266" y="56" width="368" height="328" rx="12" class="lac-card" />
      {/* Subtle top accent stripe */}
      <rect x="267" y="57" width="366" height="4" rx="2" class="lac-accent-bar" />

      {/* Card Header (Hierarchy target #1) */}
      <text x="292" y="92" class="lac-eyebrow">
        <tspan data-lang-en>Production cluster · ap-southeast-1</tspan>
        <tspan data-lang-vi>Cụm chạy thật · ap-southeast-1</tspan>
      </text>
      <text x="292" y="118" class="lac-card-title">
        <tspan data-lang-en>Checkout API gateway</tspan>
        <tspan data-lang-vi>Cổng API thanh toán</tspan>
      </text>
      <text x="292" y="139" class="lac-card-sub">
        <tspan data-lang-en>Rolling deploy v2.14 finished 4 min ago</tspan>
        <tspan data-lang-vi>Cập nhật v2.14 hoàn tất 4 phút trước</tspan>
      </text>

      {/* Visual spacing bracket inside card between header and metrics (Spacing target #2) */}
      <line x1="292" x2="608" y1="162" y2="162" class="lac-card-sep" />

      {/* Metrics row (Typography target #3 & Colour target #4) */}
      <g transform="translate(292, 180)">
        <rect x="0" y="0" width="148" height="72" rx="8" class="lac-metric-box" />
        <text x="14" y="23" class="lac-metric-lbl">
          <tspan data-lang-en>Uptime (30d)</tspan>
          <tspan data-lang-vi>Ổn định (30 ngày)</tspan>
        </text>
        <text x="14" y="54" class="lac-metric-val">99.98%</text>

        <rect x="164" y="0" width="152" height="72" rx="8" class="lac-metric-box" />
        <text x="178" y="23" class="lac-metric-lbl">
          <tspan data-lang-en>p95 latency</tspan>
          <tspan data-lang-vi>Độ trễ p95</tspan>
        </text>
        <text x="178" y="54" class="lac-metric-val">42 ms</text>
      </g>

      {/* Status note row (Colour target #4) */}
      <rect x="292" y="270" width="316" height="40" rx="7" class="lac-note-box" />
      <circle cx="310" cy="290" r="4.5" class="lac-dot-accent" />
      <text x="323" y="295" class="lac-note-txt">
        <tspan data-lang-en>Zero failed health checks since cutover</tspan>
        <tspan data-lang-vi>Không có lỗi kiểm tra sức khỏe sau chuyển đổi</tspan>
      </text>

      {/* Footer row (Finishing target #6) */}
      <line x1="292" x2="608" y1="328" y2="328" class="lac-card-sep" />
      <text x="292" y="361" class="lac-footer-link">
        <tspan data-lang-en>View logs</tspan>
        <tspan data-lang-vi>Xem nhật ký</tspan>
      </text>
      <rect x="488" y="341" width="120" height="30" rx="6" class="lac-btn" />
      <text x="548" y="361" text-anchor="middle" class="lac-btn-txt">
        <tspan data-lang-en>Promote build</tspan>
        <tspan data-lang-vi>Đẩy lên chính</tspan>
      </text>

      {/* ================= LEFT CALLOUTS (1, 2, 3) ================= */}

      {/* Callout 1: Hierarchy (Part 2) */}
      <g>
        <line x1="224" x2="286" y1="112" y2="112" class="lac-leader" />
        <circle cx="286" cy="112" r="3.5" class="lac-pin" />
        <circle cx="30" cy="100" r="11" class="lac-badge" />
        <text x="30" y="105" text-anchor="middle" class="lac-badge-num">1</text>
        <text x="48" y="104" class="lac-call-h">
          <tspan data-lang-en>Part 2 · Hierarchy</tspan>
          <tspan data-lang-vi>Bài 2 · Phân cấp</tspan>
        </text>
        <text x="19" y="124" class="lac-call-d">
          <tspan data-lang-en>One strong title, muted subtitle,</tspan>
          <tspan data-lang-vi>Tiêu đề rõ, mô tả dịu sắc độ,</tspan>
        </text>
        <text x="19" y="141" class="lac-call-d">
          <tspan data-lang-en>and one primary CTA button.</tspan>
          <tspan data-lang-vi>chỉ giữ một nút hành động chính.</tspan>
        </text>
      </g>

      {/* Callout 2: Spacing (Part 3) */}
      <g>
        <line x1="224" x2="286" y1="170" y2="162" class="lac-leader" />
        <circle cx="286" cy="162" r="3.5" class="lac-pin" />
        <circle cx="30" cy="200" r="11" class="lac-badge" />
        <text x="30" y="205" text-anchor="middle" class="lac-badge-num">2</text>
        <text x="48" y="204" class="lac-call-h">
          <tspan data-lang-en>Part 3 · Spacing</tspan>
          <tspan data-lang-vi>Bài 3 · Khoảng cách</tspan>
        </text>
        <text x="19" y="224" class="lac-call-d">
          <tspan data-lang-en>More space between groups</tspan>
          <tspan data-lang-vi>Khoảng trống giữa các khối</tspan>
        </text>
        <text x="19" y="241" class="lac-call-d">
          <tspan data-lang-en>than between related lines.</tspan>
          <tspan data-lang-vi>rộng hơn khoảng cách bên trong.</tspan>
        </text>
      </g>

      {/* Callout 3: Typography (Part 4) */}
      <g>
        <line x1="224" x2="292" y1="308" y2="232" class="lac-leader" />
        <circle cx="292" cy="232" r="3.5" class="lac-pin" />
        <circle cx="30" cy="306" r="11" class="lac-badge" />
        <text x="30" y="311" text-anchor="middle" class="lac-badge-num">3</text>
        <text x="48" y="310" class="lac-call-h">
          <tspan data-lang-en>Part 4 · Typography</tspan>
          <tspan data-lang-vi>Bài 4 · Chữ & số</tspan>
        </text>
        <text x="19" y="330" class="lac-call-d">
          <tspan data-lang-en>Snapped type scale, tight heading</tspan>
          <tspan data-lang-vi>Cỡ chữ theo thang, số liệu</tspan>
        </text>
        <text x="19" y="347" class="lac-call-d">
          <tspan data-lang-en>leading, and tabular figures.</tspan>
          <tspan data-lang-vi>căn thẳng hàng bằng tabular-nums.</tspan>
        </text>
      </g>

      {/* ================= RIGHT CALLOUTS (4, 5, 6) ================= */}

      {/* Callout 4: Depth (Part 6) */}
      <g>
        <line x1="636" x2="674" y1="84" y2="104" class="lac-leader" />
        <circle cx="636" cy="84" r="3.5" class="lac-pin" />
        <circle cx="690" cy="100" r="11" class="lac-badge" />
        <text x="690" y="105" text-anchor="middle" class="lac-badge-num">4</text>
        <text x="708" y="104" class="lac-call-h">
          <tspan data-lang-en>Part 6 · Depth</tspan>
          <tspan data-lang-vi>Bài 6 · Chiều sâu</tspan>
        </text>
        <text x="679" y="124" class="lac-call-d">
          <tspan data-lang-en>Soft two-part shadow + thin top</tspan>
          <tspan data-lang-vi>Bóng hai lớp mềm + viền nhấn</tspan>
        </text>
        <text x="679" y="141" class="lac-call-d">
          <tspan data-lang-en>accent instead of a heavy border.</tspan>
          <tspan data-lang-vi>mảnh thay cho khung viền thô.</tspan>
        </text>
      </g>

      {/* Callout 5: Colour (Part 5) */}
      <g>
        <line x1="610" x2="674" y1="286" y2="210" class="lac-leader" />
        <circle cx="610" cy="286" r="3.5" class="lac-pin" />
        <circle cx="690" cy="200" r="11" class="lac-badge" />
        <text x="690" y="205" text-anchor="middle" class="lac-badge-num">5</text>
        <text x="708" y="204" class="lac-call-h">
          <tspan data-lang-en>Part 5 · Colour</tspan>
          <tspan data-lang-vi>Bài 5 · Màu sắc</tspan>
        </text>
        <text x="679" y="224" class="lac-call-d">
          <tspan data-lang-en>Tinted neutral surfaces and one</tspan>
          <tspan data-lang-vi>Nền trung tính pha nhẹ sắc độ,</tspan>
        </text>
        <text x="679" y="241" class="lac-call-d">
          <tspan data-lang-en>accent colour reserved for focus.</tspan>
          <tspan data-lang-vi>dành màu nhấn cho đúng điểm chính.</tspan>
        </text>
      </g>

      {/* Callout 6: Finishing (Part 8) */}
      <g>
        <line x1="610" x2="674" y1="356" y2="316" class="lac-leader" />
        <circle cx="610" cy="356" r="3.5" class="lac-pin" />
        <circle cx="690" cy="306" r="11" class="lac-badge" />
        <text x="690" y="311" text-anchor="middle" class="lac-badge-num">6</text>
        <text x="708" y="310" class="lac-call-h">
          <tspan data-lang-en>Part 8 · Finishing</tspan>
          <tspan data-lang-vi>Bài 8 · Hoàn thiện</tspan>
        </text>
        <text x="679" y="330" class="lac-call-d">
          <tspan data-lang-en>De-emphasised secondary link</tspan>
          <tspan data-lang-vi>Liên kết phụ giảm nhấn mạnh,</tspan>
        </text>
        <text x="679" y="347" class="lac-call-d">
          <tspan data-lang-en>balanced against a crisp action.</tspan>
          <tspan data-lang-vi>cân đối gọn gàng với nút chính.</tspan>
        </text>
      </g>

      {/* Bottom footer note linking Part 1 & Part 9 */}
      <text x="450" y="420" text-anchor="middle" class="lac-bottom-note">
        <tspan data-lang-en>Start feature-first in greyscale (Part 1), verify all six checkpoints, then sharpen the rest with blind rebuilds (Part 9).</tspan>
        <tspan data-lang-vi>Dựng tính năng trước bằng tông xám (Bài 1), soát 6 điểm trên, rồi rèn tiếp bằng bài tập dựng mù (Bài 9).</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>One component is enough to exercise the whole Refactoring UI toolkit: every visual detail maps cleanly back to a specific chapter.</span>
    <span data-lang-vi>Chỉ một component nhỏ đã đủ dùng trọn bộ công cụ Refactoring UI: mỗi chi tiết thị giác đều khớp thẳng về một chương cụ thể.</span>
  </figcaption>
</figure>

<style>
  .lac { margin: 2em 0; width: 100%; }
  .lac-scroll { overflow-x: auto; }
  .lac svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .lac text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .lac text.lac-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .lac-shadow-wide { fill: var(--text); opacity: 0.05; }
  .lac-shadow-tight { fill: var(--text); opacity: 0.07; }
  .lac-card { fill: var(--bg); stroke: var(--border); stroke-width: 1.25; }
  .lac-accent-bar { fill: var(--red); }
  .lac text.lac-eyebrow { font-size: 11.5px; font-weight: 600; fill: var(--red); }
  .lac text.lac-card-title { font-size: 19px; font-weight: 700; fill: var(--text); }
  .lac text.lac-card-sub { font-size: 12.5px; fill: var(--text-muted); }
  .lac-card-sep { stroke: var(--border); stroke-width: 1; }
  .lac-metric-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .lac text.lac-metric-lbl { font-size: 11.5px; fill: var(--text-muted); }
  .lac text.lac-metric-val { font-size: 21px; font-weight: 700; fill: var(--text); }
  .lac-note-box { fill: var(--red-tint-bg); stroke: var(--border); stroke-width: 1; }
  .lac-dot-accent { fill: var(--red); }
  .lac text.lac-note-txt { font-size: 12px; font-weight: 500; fill: var(--text); }
  .lac text.lac-footer-link { font-size: 13px; font-weight: 600; fill: var(--text-muted); }
  .lac-btn { fill: var(--red); }
  .lac text.lac-btn-txt { font-size: 12.5px; font-weight: 600; fill: #ffffff; }
  .lac-leader { stroke: var(--red); stroke-width: 1.25; stroke-dasharray: 4 3; opacity: 0.75; }
  .lac-pin { fill: var(--red); }
  .lac-badge { fill: var(--red); }
  .lac text.lac-badge-num { font-size: 12px; font-weight: 700; fill: #ffffff; }
  .lac text.lac-call-h { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .lac text.lac-call-d { font-size: 12px; fill: var(--text-muted); }
  .lac text.lac-bottom-note { font-size: 12.5px; font-weight: 600; fill: var(--text-muted); }
  .lac figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
