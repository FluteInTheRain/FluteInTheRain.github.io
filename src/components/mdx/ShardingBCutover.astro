---
// Moving shard 17 from node A to node B: before, during and after the cutover. Illustrative.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
type Lbl = { x: number; y: number; c: string; en: string[]; vi: string[]; a?: string; lh?: number };
const W = 900;
const H = 372;
const cols = [20, 320, 620];
const cx = (i: number) => cols[i] + 130;
const cl = (i: number) => ({ x: cols[i] + 30, y: 78 });
const aX = (i: number) => cols[i] + 5;
const bX = (i: number) => cols[i] + 150;
const nodeY = 218;
const c0 = arrow(cx(0), 132, aX(0) + 52, nodeY - 3);
const c1 = arrow(cx(1), 132, aX(1) + 52, nodeY - 3);
const c2 = arrow(cx(2), 132, bX(2) + 52, nodeY - 3);
const redirect = (i: number) => `M ${aX(i) + 52} ${nodeY + 52} L ${aX(i) + 52} ${nodeY + 76} L ${bX(i) + 52} ${nodeY + 76} L ${bX(i) + 52} ${nodeY + 58}`;
const redirHead = arrow(bX(1) + 52, nodeY + 76, bX(1) + 52, nodeY + 52).head;
const labels: Lbl[] = [
  { x: cx(0), y: 38, c: 'h', en: ['Before the cutover'], vi: ['Trước khi chuyển'] },
  { x: cx(1), y: 38, c: 'h is-hot', en: ['During the cutover'], vi: ['Đúng lúc chuyển'] },
  { x: cx(2), y: 38, c: 'h is-gold', en: ['After the cutover'], vi: ['Sau khi chuyển'] },
  { x: cx(0), y: 57, c: 'sub', en: ['shard 17 lives on node A'], vi: ['shard 17 nằm ở node A'] },
  { x: cx(1), y: 57, c: 'sub', en: ['shard 17 is handed to node B'], vi: ['shard 17 được giao cho node B'] },
  { x: cx(2), y: 57, c: 'sub', en: ['shard 17 lives on node B'], vi: ['shard 17 nằm ở node B'] },
  { x: cx(0), y: 340, c: 'note', en: ['Requests go to A'], vi: ['Request đi tới A'] },
  { x: cx(1), y: 340, c: 'note is-hot', en: ['In-flight requests still hit A'], vi: ['Request đang bay vẫn tới A'] },
  { x: cx(2), y: 340, c: 'note is-gold', en: ['New requests go straight to B'], vi: ['Request mới đi thẳng tới B'] },
  { x: cx(1), y: nodeY + 96, c: 'sub is-hot', en: ['A must redirect them or the client retries'], vi: ['A phải chuyển hướng, hoặc client retry'] },
];
const maps = ['map: shard 17 → A', 'map: shard 17 → A', 'map: shard 17 → B'];
const mapsVi = ['bản đồ: shard 17 → A', 'bản đồ: shard 17 → A', 'bản đồ: shard 17 → B'];
const tone = ['box', 'box is-hot', 'box is-gold'];
---
<figure class="shbk">
  <div class="shbk-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three snapshots of moving shard 17 from node A to node B. Before: the client's map says A and requests go to A. During: the map still says A, a request in flight reaches A just after it handed the shard to B, so A must redirect it or the client retries. After: the map says B and requests go straight to B.">
      {cols.map((x) => (<rect x={x} y="12" width="260" height="348" rx="8" class="rule" />))}
      {[0, 1, 2].map((i) => (
        <g>
          <rect x={cl(i).x} y={cl(i).y} width="200" height="54" rx="6" class={tone[i]} />
          <DiagramIcon name="laptop" x={cl(i).x + 24} y={cl(i).y + 27} size={26} />
          <text x={cl(i).x + 48} y={cl(i).y + 23} class="b">Client</text>
          <text x={cl(i).x + 48} y={cl(i).y + 41} class="s" data-lang-en>{maps[i]}</text>
          <text x={cl(i).x + 48} y={cl(i).y + 41} class="s" data-lang-vi>{mapsVi[i]}</text>
          <rect x={aX(i)} y={nodeY} width="105" height="52" rx="6" class={i === 1 ? 'box is-hot' : i === 0 ? 'box is-gold' : 'box is-dim'} />
          <DiagramIcon name="db" x={aX(i) + 24} y={nodeY + 26} size={24} />
          <text x={aX(i) + 46} y={nodeY + 30} class="b">Node A</text>
          <rect x={bX(i)} y={nodeY} width="105" height="52" rx="6" class={i === 2 ? 'box is-gold' : 'box is-dim'} />
          <DiagramIcon name="db" x={bX(i) + 24} y={nodeY + 26} size={24} />
          <text x={bX(i) + 46} y={nodeY + 30} class="b">Node B</text>
        </g>
      ))}
      <path d={c0.line} class="arrow is-gold" /><polygon points={c0.head} class="head is-gold" />
      <path d={c1.line} class="arrow is-hot" /><polygon points={c1.head} class="head is-hot" />
      <path d={c2.line} class="arrow is-gold" /><polygon points={c2.head} class="head is-gold" />
      <path d={redirect(1)} class="arrow is-hot is-dash" />
      <polygon points={redirHead} class="head is-hot" />
      {labels.map((l) => (
        <>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-en>{l.en.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-vi>{l.vi.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
        </>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Moving one shard from A to B. The risky moment is the middle one: the map and the data change owners at slightly different times, so requests already on their way need a clean redirect or a retry.</span>
    <span data-lang-vi>Dời một shard từ A sang B. Thời điểm rủi ro là ở giữa: bản đồ và dữ liệu đổi chủ lệch nhau chút xíu, nên các request đã gửi đi cần được chuyển hướng gọn gàng hoặc retry.</span>
  </figcaption>
</figure>

<style>
  .shbk { margin: 2em 0; width: 100%; }
  .shbk-scroll { overflow-x: auto; }
  .shbk svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shbk text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shbk .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shbk .h.is-hot { fill: var(--red); }
  .shbk .h.is-gold { fill: var(--gold-icon); }
  .shbk .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shbk .sub.is-gold { fill: var(--gold-icon); font-weight: 600; }
  .shbk .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shbk .b.is-hot { fill: var(--red); }
  .shbk .s { font-size: 12px; fill: var(--text-body); }
  .shbk .s.is-hot { fill: var(--red); font-weight: 600; }
  .shbk .note { font-size: 13px; font-weight: 600; fill: var(--text); }
  .shbk .note.is-hot { fill: var(--red); }
  .shbk .note.is-gold { fill: var(--gold-icon); }
  .shbk .num { font-size: 11px; font-weight: 700; fill: var(--text); }
  .shbk .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbk .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shbk .box.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .shbk .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shbk .box.is-dim { opacity: 0.5; }
  .shbk .circ { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbk .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shbk .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shbk .arrow.is-hot { stroke: var(--red); }
  .shbk .arrow.is-gold { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shbk .arrow.is-strong { stroke: var(--text); stroke-width: 1.7; }
  .shbk .arrow.is-dash { stroke-dasharray: 5 4; }
  .shbk .head { fill: var(--text-muted); }
  .shbk .head.is-hot { fill: var(--red); }
  .shbk .head.is-gold { fill: var(--gold-icon); }
  .shbk .head.is-strong { fill: var(--text); }
  .shbk figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>

