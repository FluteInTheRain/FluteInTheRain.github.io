---
import EncodingStepCards from './EncodingStepCards.astro';
const props = {
 "arrows": true,
 "title": {
  "en": "Why changed code breaks a replay",
  "vi": "Vì sao đổi code làm replay hỏng"
 },
 "alt": "Temporal example. The recorded history says a timer was started first. The new code, deployed while the run waits, calls an activity first. When the worker replays, the ScheduleActivityTask command does not match the TimerStarted event, and the run fails with a non-determinism error.",
 "cards": [
  {
   "icon": "clock",
   "head": {
    "en": [
     "The history says"
    ],
    "vi": [
     "History ghi"
    ]
   },
   "lines": {
    "en": [
     "The old run started a timer",
     "first, and is still waiting."
    ],
    "vi": [
     "Lần chạy cũ bắt đầu bằng một",
     "timer và vẫn đang chờ."
    ]
   },
   "tone": "plain",
   "mono": [
    "TimerStarted"
   ]
  },
  {
   "icon": "worker",
   "head": {
    "en": [
     "The new code says"
    ],
    "vi": [
     "Code mới nói"
    ]
   },
   "lines": {
    "en": [
     "Deployed while the run waits:",
     "it calls the activity first."
    ],
    "vi": [
     "Deploy trong lúc run đang chờ:",
     "nó gọi activity trước."
    ]
   },
   "tone": "plain",
   "mono": [
    "ScheduleActivityTask"
   ]
  },
  {
   "icon": "fail",
   "head": {
    "en": [
     "The worker replays"
    ],
    "vi": [
     "Worker chạy lại"
    ]
   },
   "lines": {
    "en": [
     "The command does not match",
     "the history, so the run fails."
    ],
    "vi": [
     "Lệnh không khớp với history,",
     "nên lần chạy bị lỗi."
    ]
   },
   "tone": "bad",
   "mono": [
    "non-determinism error"
   ]
  }
 ],
 "caption": {
  "en": "Your code is the schema and the event history is the old data.",
  "vi": "Code của bạn là schema, còn event history là dữ liệu cũ."
 }
};
---
<EncodingStepCards {...props} />
