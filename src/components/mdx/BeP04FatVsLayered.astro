---
// The fat router before, the three layers after — same six jobs, two homes.
// The tangled lines on the left are the point: one function, every concern.
const W = 900, H = 300;
const col1 = [
  { y: 150, en: 'parse', vi: 'parse' },
  { y: 182, en: 'validate', vi: 'validate' },
  { y: 214, en: 'rules + ids', vi: 'luật + id' },
];
const col2 = [
  { y: 150, en: 'storage', vi: 'lưu trữ' },
  { y: 182, en: 'status codes', vi: 'status code' },
  { y: 214, en: 'response', vi: 'response' },
];
const tangle = [
  'M 160 146 L 310 218',
  'M 160 186 L 310 150',
  'M 160 218 L 310 186',
  'M 160 218 L 310 218',
];
const layers = [
  { y: 46, icon: 'fastapi', iconW: 62, iconH: 11.5, red: false,
    en: 'web — parse, validate, respond', vi: 'web — parse, validate, respond' },
  { y: 124, icon: 'engine', iconW: 22, iconH: 22, red: true, disc: false,
    en: 'service — the case rules', vi: 'service — luật nghiệp vụ' },
  { y: 202, icon: 'database', iconW: 22, iconH: 22, red: false, disc: true,
    en: 'data — where records live', vi: 'data — nơi record nằm' },
];
---
<figure class="bep4a">
  <div class="bep4a-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: one fat endpoint function containing parsing, validation, rules, ids, storage and response shaping, with lines crossing between them. Right: three stacked boxes — web, service, data — with one arrow down between neighbours.">
    <text x="220" y="30" text-anchor="middle" class="h">
      <tspan data-lang-en>before: the fat router</tspan><tspan data-lang-vi>trước: router béo</tspan>
    </text>
    <text x="690" y="30" text-anchor="middle" class="h">
      <tspan data-lang-en>after: three layers</tspan><tspan data-lang-vi>sau: ba tầng</tspan>
    </text>

    <rect x="20" y="46" width="400" height="208" rx="10" class="box" />
    <image href="/icons/flow/fastapi.svg" x="189" y="64" width="62" height="11.5" aria-hidden="true" />
    <text x="220" y="100" text-anchor="middle" class="bt">
      <tspan data-lang-en>one endpoint function</tspan><tspan data-lang-vi>một hàm endpoint</tspan>
    </text>
    {tangle.map((d) => <path d={d} class="tangle" />)}
    {col1.map((c) => (
      <text x="52" y={c.y + 4} class="it"><tspan data-lang-en>{c.en}</tspan><tspan data-lang-vi>{c.vi}</tspan></text>
    ))}
    {col2.map((c) => (
      <text x="388" y={c.y + 4} text-anchor="end" class="it"><tspan data-lang-en>{c.en}</tspan><tspan data-lang-vi>{c.vi}</tspan></text>
    ))}

    <text x="220" y="276" text-anchor="middle" class="m">
      <tspan data-lang-en>every change edits this one function</tspan>
      <tspan data-lang-vi>mọi thay đổi đều sửa vào một hàm duy nhất</tspan>
    </text>

    {layers.map((l, i) => (
      <g>
        <rect x="480" y={l.y} width="400" height="52" rx="10" class={l.red ? 'box red' : 'box'} />
        {l.disc && <circle cx="527" cy={l.y + 26} r="15" class="disc" />}
        <image href={`/icons/flow/${l.icon}.svg`} x={516} y={l.y + 26 - l.iconH / 2} width={l.iconW} height={l.iconH} aria-hidden="true" />
        <text x="590" y={l.y + 31} class="bt">
          <tspan data-lang-en>{l.en}</tspan><tspan data-lang-vi>{l.vi}</tspan>
        </text>
        {i < 2 && (
          <g>
            <line x1="680" y1={l.y + 52} x2="680" y2={layers[i + 1].y - 9} class="ln" />
            <polygon points={`680,${layers[i + 1].y} 675,${layers[i + 1].y - 9} 685,${layers[i + 1].y - 9}`} class="hd" />
          </g>
        )}
      </g>
    ))}
    <text x="690" y="276" text-anchor="middle" class="m">
      <tspan data-lang-en>one change, one layer</tspan>
      <tspan data-lang-vi>một thay đổi, đúng một tầng</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Same six jobs, two homes. On the left every concern shares one function, so every change meets every other change; on the right each concern has its own file, and the arrows only point down.</span>
    <span data-lang-vi>Cùng sáu việc, hai cách tổ chức. Bên trái mọi thứ chồng lên một hàm, nên thay đổi nào cũng đụng thay đổi nào; bên phải mỗi việc một file, và mũi tên chỉ đi xuống.</span>
  </figcaption>
</figure>

<style>
  .bep4a { margin: 2em 0; width: 100%; }
  .bep4a-scroll { overflow-x: auto; }
  .bep4a svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep4a text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep4a .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep4a .bt { font-weight: 700; fill: var(--text); }
  .bep4a .m { fill: var(--text-muted); font-size: 13px; }
  .bep4a .it { fill: var(--text-body); font-size: 13.5px; }
  .bep4a .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep4a .box.red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .bep4a .tangle { stroke: var(--text-muted); stroke-width: 1; fill: none; opacity: 0.75; }
  .bep4a .ln { stroke: var(--text-muted); stroke-width: 1.6; }
  .bep4a .hd { fill: var(--text-muted); }
  .bep4a .disc { fill: none; }
  :global([data-theme='dark']) .bep4a .disc { fill: rgba(255, 255, 255, 0.88); }
  .bep4a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
