---
// An order book snapshot flattened to one row of 40 numbers; 100 such rows stacked make the model input.
// Layout follows DeepLOB (Zhang, Zohren & Roberts 2019): per level i = 1..10, ask price, ask volume, bid price, bid volume.
const asks = [3, 5, 4, 7, 6, 9, 5, 8, 10, 7];
const bids = [6, 8, 5, 7, 9, 4, 8, 6, 5, 7];
const BX = 215; // book centre line
const RH = 13;
---
<figure class="p15l">
  <div class="scroll">
  <svg viewBox="0 0 900 360" role="img" aria-label="Left: an order book with ten ask levels above and ten bid levels below the best prices, drawn as horizontal volume bars. An arrow points to one row of 40 numbers: for each of the ten levels, an ask price, ask volume, bid price and bid volume. Right: 100 such rows stacked from oldest to newest form a 100 by 40 input matrix.">
    <text x="20" y="26" class="h"><tspan data-lang-en>From an order book to the model's input</tspan><tspan data-lang-vi>Từ sổ lệnh tới đầu vào của mô hình</tspan></text>
    <text x="20" y="48" class="sub"><tspan data-lang-en>One snapshot is 10 levels × 4 numbers. The model reads the last 100 snapshots.</tspan><tspan data-lang-vi>Một ảnh chụp sổ lệnh là 10 mức × 4 số. Mô hình đọc 100 ảnh chụp gần nhất.</tspan></text>

    {asks.map((v, i) => (
      <rect x={BX} y={72 + (9 - i) * RH} width={v * 14} height={RH - 2} class="ask" />
    ))}
    {bids.map((v, i) => (
      <rect x={BX - v * 14} y={72 + 10 * RH + 6 + i * RH} width={v * 14} height={RH - 2} class="bid" />
    ))}
    <line x1={BX} y1="68" x2={BX} y2={72 + 20 * RH + 10} class="mid" />
    <text x={BX + 8} y="66" class="side ask-t"><tspan data-lang-en>asks (sellers)</tspan><tspan data-lang-vi>bên bán</tspan></text>
    <text x={BX - 8} y={72 + 20 * RH + 24} class="side bid-t" text-anchor="end"><tspan data-lang-en>bids (buyers)</tspan><tspan data-lang-vi>bên mua</tspan></text>
    <text x="20" y={72 + 10 * RH + 2} class="lab"><tspan data-lang-en>best prices →</tspan><tspan data-lang-vi>giá tốt nhất →</tspan></text>

    <polygon points="372,200 400,200 400,194 416,206 400,218 400,212 372,212" class="arrow" />

    <rect x="430" y="74" width="440" height="30" rx="4" class="row" />
    {[0, 1, 2, 3].map((k) => (
      <rect x={440 + k * 36} y="80" width="30" height="18" rx="2" class={`c${k}`} />
    ))}
    <text x="596" y="94" class="dots">… × 10 <tspan data-lang-en>levels</tspan><tspan data-lang-vi>mức</tspan></text>
    <text x="430" y="122" class="lab"><tspan data-lang-en>one row: ask price, ask volume, bid price, bid volume</tspan><tspan data-lang-vi>một dòng: giá bán, KL bán, giá mua, KL mua</tspan></text>
    <text x="430" y="138" class="lab"><tspan data-lang-en>for level 1, then level 2, … level 10 = 40 numbers</tspan><tspan data-lang-vi>của mức 1, rồi mức 2, … mức 10 = 40 số</tspan></text>

    {[0, 1, 2, 3, 4, 5].map((r) => (
      <rect x="430" y={150 + r * 14} width="440" height="11" rx="2" class="stack" opacity={0.35 + r * 0.13} />
    ))}
    <text x="650" y="258" text-anchor="middle" class="dots">⋮</text>
    <rect x="430" y="268" width="440" height="11" rx="2" class="stack now" />
    <text x="430" y="304" class="shape"><tspan data-lang-en>100 rows × 40 columns = 4,000 numbers per example</tspan><tspan data-lang-vi>100 dòng × 40 cột = 4.000 số cho mỗi ví dụ</tspan></text>
    <text x="430" y="326" class="lab"><tspan data-lang-en>top row: 100 updates ago; bottom row: the latest</tspan><tspan data-lang-vi>dòng trên: cách đây 100 lần cập nhật; dòng dưới: mới nhất</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The input shape (100 × 40) is the one DeepLOB uses. Say a bid-side level holds 8 units of volume; the bar is only for orientation.</span>
    <span data-lang-vi>Kích thước đầu vào (100 × 40) là kích thước DeepLOB dùng. Giả sử một mức bên mua có khối lượng 8 đơn vị; thanh vẽ chỉ để dễ hình dung.</span>
  </figcaption>
</figure>

<style>
  .p15l { margin: 2em 0; width: 100%; }
  .p15l .scroll { overflow-x: auto; }
  .p15l svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p15l text { font-size: 13.5px; fill: var(--text-body); }
  .p15l .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p15l .sub, .p15l .lab { fill: var(--text-muted); }
  .p15l .ask { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.1; }
  .p15l .bid { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.1; }
  .p15l .mid { stroke: var(--text-muted); stroke-width: 1.2; }
  .p15l .side { font-weight: 700; }
  .p15l .ask-t { fill: var(--red); }
  .p15l .bid-t { fill: var(--gold-icon); }
  .p15l .arrow { fill: var(--text-muted); }
  .p15l .row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p15l .c0 { fill: var(--red-tint-bg); stroke: var(--red); }
  .p15l .c1 { fill: var(--red-tint-bg); stroke: var(--red); stroke-dasharray: 3 2; }
  .p15l .c2 { fill: var(--gold-tint-bg); stroke: var(--gold-icon); }
  .p15l .c3 { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-dasharray: 3 2; }
  .p15l .dots { fill: var(--text-muted); font-size: 14px; }
  .p15l .stack { fill: var(--text-muted); }
  .p15l .stack.now { fill: var(--text); }
  .p15l .shape { fill: var(--text); font-weight: 700; }
  .p15l figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
