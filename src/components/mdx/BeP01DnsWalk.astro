---
// The resolver's asking order: cache, then the router, then the hierarchy —
// and every answer is cached for its TTL.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 352;
const stack = [
  { y: 16, icon: 'cache', title: 'cache', sub: { en: 'asked first', vi: 'hỏi đầu tiên' } },
  { y: 128, icon: 'satellite', title: 'router', sub: { en: 'asked next', vi: 'hỏi kế tiếp' } },
  { y: 240, icon: 'dns', title: '', sub: { en: 'asked last', vi: 'hỏi sau cùng' } },
];
---
<figure class="bep1b">
  <div class="bep1b-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="How the resolver looks up a name: curl asks the resolver, which asks the cache first, then the router, then the DNS hierarchy — and every answer is cached for its TTL.">
    <rect x="20" y="120" width="200" height="92" rx="8" class="box" />
    <circle cx="120" cy="145" r="18" class="disc" />
    <image href="/icons/flow/curl.svg" x="105" y="130" width="30" height="30" class="icn" aria-hidden="true" />
    <text x="120" y="180" text-anchor="middle" class="t"><tspan data-lang-en>curl asks for an IP</tspan><tspan data-lang-vi>curl hỏi địa chỉ</tspan></text>
    <text x="120" y="198" text-anchor="middle" class="m">fastapi.tiangolo.com</text>
    {(() => { const a = arrow(220, 166, 294, 166); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
    <rect x="300" y="120" width="180" height="92" rx="8" class="box" />
    <image href="/icons/flow/detective.svg" x="375" y="130" width="30" height="30" class="icn" aria-hidden="true" />
    <text x="390" y="180" text-anchor="middle" class="t">resolver</text>
    <text x="390" y="198" text-anchor="middle" class="m"><tspan data-lang-en>asks around for you</tspan><tspan data-lang-vi>đi hỏi giúp bạn</tspan></text>
    {(() => { const a = arrow(480, 150, 564, 72); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
    {stack.map((s) => (
      <g>
        <rect x="570" y={s.y} width="310" height="92" rx="8" class="box" />
        <image href={`/icons/flow/${s.icon}.svg`} x="710" y={s.y + 10} width="30" height="30" class="icn" aria-hidden="true" />
        {s.title ? <text x="725" y={s.y + 60} text-anchor="middle" class="t">{s.title}</text> : (
          <text x="725" y={s.y + 60} text-anchor="middle" class="t"><tspan data-lang-en>the DNS hierarchy</tspan><tspan data-lang-vi>cây DNS</tspan></text>
        )}
        <text x="725" y={s.y + 78} text-anchor="middle" class="m"><tspan data-lang-en>{s.sub.en}</tspan><tspan data-lang-vi>{s.sub.vi}</tspan></text>
      </g>
    ))}
    {(() => { const a = arrow(590, 108, 590, 124); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
    <text x="602" y="121" class="s"><tspan data-lang-en>miss</tspan><tspan data-lang-vi>chưa có</tspan></text>
    {(() => { const a = arrow(590, 220, 590, 236); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
    <text x="602" y="233" class="s"><tspan data-lang-en>miss</tspan><tspan data-lang-vi>chưa có</tspan></text>
    <path d="M 570 286 C 525 290 505 262 492 224" class="ret" />
    {(() => { const a = arrow(493, 223, 489, 219); return <polygon points={a.head} class="hdr" />; })()}
    <text x="440" y="348" text-anchor="middle" class="rl"><tspan data-lang-en>every answer is cached for its TTL</tspan><tspan data-lang-vi>câu trả lời nào cũng được lưu theo TTL</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The resolver always asks in the same order — cache first, then the router, then the hierarchy — and remembers every answer for its TTL.</span>
    <span data-lang-vi>Resolver luôn hỏi theo đúng thứ tự — cache trước, router kế tiếp, rồi cả cây DNS — và nhớ lại từng câu trả lời theo TTL của nó.</span>
  </figcaption>
</figure>

<style>
  .bep1b { margin: 2em 0; width: 100%; }
  .bep1b-scroll { overflow-x: auto; }
  .bep1b svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep1b text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep1b .t { font-weight: 700; fill: var(--text); }
  .bep1b .m { fill: var(--text-muted); font-size: 12px; }
  .bep1b .s { fill: var(--text-muted); font-size: 12px; }
  .bep1b .rl { fill: var(--red); font-weight: 700; font-size: 13px; }
  .bep1b .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep1b .disc { fill: none; }
  .bep1b .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep1b .hd { fill: var(--text-muted); }
  .bep1b .ret { stroke: var(--red); stroke-width: 1.5; fill: none; stroke-dasharray: 5 4; }
  .bep1b .hdr { fill: var(--red); }
  .bep1b figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  :global([data-theme='dark']) .bep1b .disc { fill: rgba(255, 255, 255, 0.88); }
</style>
