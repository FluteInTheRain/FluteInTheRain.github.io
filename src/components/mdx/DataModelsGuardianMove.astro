---
import DiagramIcon from './DiagramIcon.astro';
// The Guardian's 2018 move from MongoDB to PostgreSQL on Amazon RDS, with the reasons and what they kept (The Guardian, 2018).
// Arrowheads are polygons: no SVG ids.
const W = 900;
const H = 330;
type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}
const frames: any[] = [];
const boxes: any[] = [];
const links: any[] = [];
const labels: any[] = [];
const nums: any[] = [];
boxes.push(
  { x: 10, y: 50, w: 320, h: 110, icon: 'mongodb', en: ['MongoDB', 'about 2.3 million content items', "in The Guardian's CMS"], vi: ['MongoDB', 'khoảng 2,3 triệu bài nội dung', 'trong CMS của The Guardian'] },
  { x: 570, y: 50, w: 320, h: 110, icon: 'postgres', kind: 'good', en: ['PostgreSQL on Amazon RDS', 'same documents in a JSONB column', 'with indexes on fields inside'], vi: ['PostgreSQL trên Amazon RDS', 'cùng các document trong cột JSONB', 'có index trên trường bên trong'] },
  { x: 10, y: 200, w: 320, h: 56, icon: 'warning', kind: 'bad', en: ['Two outages, each stopped', 'publishing for at least an hour'], vi: ['Hai lần sự cố, mỗi lần dừng', 'đăng bài ít nhất một giờ'] },
  { x: 10, y: 266, w: 320, h: 56, icon: 'clock', kind: 'bad', en: ['At least 2 months a year', 'of engineering time on the database'], vi: ['Ít nhất 2 tháng công mỗi năm', 'để chăm database'] },
  { x: 570, y: 200, w: 320, h: 122, icon: 'ok', kind: 'good', en: ['Why it works', 'The reason was operations,', 'not the data model. They can', 'go more relational later.'], vi: ['Vì sao ổn', 'Lý do là vận hành, không phải', 'data model. Sau này muốn', 'quan hệ hơn vẫn được.'] },
);
links.push({ pts: [[330, 105], [570, 105]] }, { pts: [[170, 160], [170, 200]], plain: true });
labels.push(
  { x: 450, y: 92, anchor: 'middle', en: '2018: the move', vi: '2018: chuyển sang', cls: 'strong' },
  { x: 450, y: 128, anchor: 'middle', en: 'documents kept as they were', vi: 'giữ nguyên các document', cls: 'muted' },
  { x: 10, y: 30, en: 'Before', vi: 'Trước', cls: 'h' },
  { x: 570, y: 30, en: 'After', vi: 'Sau', cls: 'h' },
);
---
<figure class="dmgm">
  <div class="dmgm-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The Guardian's CMS held about 2.3 million content items in MongoDB. Two outages each stopped publishing for at least an hour, and at least two months a year of engineering time went on running the database. In 2018 they moved to PostgreSQL on Amazon RDS and kept the documents as they were in a JSONB column with indexes on fields inside the JSON.">
    {frames.map((f) => (
      <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="6" class={`dmgm-frame ${f.kind ?? ''}`} />
    ))}
    {boxes.map((b) => {
      const n = Math.max(b.en.length, b.vi.length);
      const top = !!b.top;
      const cx = b.x + b.w / 2;
      const x0 = top ? cx : b.icon ? b.x + 46 : b.x + 14;
      const y0 = top ? b.y + (b.icon ? 56 : 24) : b.y + b.h / 2 - ((n - 1) * 17) / 2 + 4;
      return (
        <g class={`dmgm-box ${b.kind ?? ''}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
          {b.icon && <DiagramIcon name={b.icon} x={top ? cx : b.x + 24} y={top ? b.y + 24 : b.y + b.h / 2} size={b.is ?? 26} />}
          {Array.from({ length: n }).map((_, i) => (
            <text x={x0} y={y0 + i * 17} text-anchor={top ? 'middle' : 'start'} class={i === 0 && !b.flat ? 'dmgm-name' : 'dmgm-sub'}>
              <tspan data-lang-en>{b.en[i] ?? ''}</tspan>
              <tspan data-lang-vi>{b.vi[i] ?? ''}</tspan>
            </text>
          ))}
        </g>
      );
    })}
    {links.map((l) => {
      const a = arrow(l.pts);
      return (
        <g>
          <polyline points={l.plain ? l.pts.map((p) => p.join(',')).join(' ') : a.line} class={`dmgm-edge ${l.kind ?? ''}`} fill="none" />
          {!l.plain && <polygon points={a.head} class={`dmgm-head ${l.kind ?? ''}`} />}
        </g>
      );
    })}
    {labels.map((t) => (
      <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`dmgm-lab ${t.cls ?? ''}`}>
        <tspan data-lang-en>{t.en}</tspan>
        <tspan data-lang-vi>{t.vi ?? t.en}</tspan>
      </text>
    ))}
    {nums.map((n) => (
      <g class="dmgm-num">
        <circle cx={n.x} cy={n.y} r="11" />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.n}</text>
      </g>
    ))}

  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The data model was not the problem. Running the database was, and a JSONB column let them keep the documents while changing the engine.</span>
    <span data-lang-vi>Data model không phải vấn đề. Vận hành database mới là vấn đề, và cột JSONB cho họ giữ nguyên document trong khi đổi engine.</span>
  </figcaption>
</figure>

<style>
  .dmgm { margin: 2em 0; width: 100%; }
  .dmgm-scroll { overflow-x: auto; }
  .dmgm svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dmgm text { font-size: 14px; fill: var(--text-body); }
  .dmgm .dmgm-name { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .dmgm .dmgm-sub { font-size: 12px; fill: var(--text-muted); }
  .dmgm .dmgm-lab { font-size: 13px; }
  .dmgm .dmgm-lab.h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dmgm .dmgm-lab.strong { font-weight: 700; fill: var(--text); }
  .dmgm .dmgm-lab.muted { fill: var(--text-muted); }
  .dmgm .dmgm-lab.bad { font-weight: 700; fill: var(--red); }
  .dmgm .dmgm-lab.good { font-weight: 700; fill: var(--text); }
  .dmgm .dmgm-lab.mono, .dmgm .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .dmgm-frame { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .dmgm-frame.bad { stroke: var(--red); }
  .dmgm-frame.good { stroke: var(--gold); }
  .dmgm-box rect { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmgm-box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dmgm-box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmgm-box.plain rect { fill: none; stroke: var(--border); }
  .dmgm-edge { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmgm-edge.bad { stroke: var(--red); }
  .dmgm-edge.good { stroke: var(--gold-icon); }
  .dmgm-head { fill: var(--text-muted); }
  .dmgm-head.bad { fill: var(--red); }
  .dmgm-head.good { fill: var(--gold-icon); }
  .dmgm-num circle { fill: var(--bg-alt); stroke: var(--text-muted); }
  .dmgm-num text { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dmgm figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
