---
// Four concurrent requests, each ~0.5 s of pure-Python arithmetic.
// Two measurements per option: total wall time, and how long a /health ping
// sent 0.2 s later had to wait. All numbers are from the capture beside it.
const W = 900, H = 330;
const XA = 300, PA = 120;  // wall-time bars: 0..2.1 s over 252 px
const XB = 640, PB = 100;  // health bars: 0..1.9 s over 190 px
type Row = { code: string; wall: number; health: number; bad: boolean };
const rows: Row[] = [
  { code: 'async def + burn()', wall: 2.0, health: 1.8, bad: true },
  { code: 'run_in_threadpool(burn)', wall: 1.97, health: 0.09, bad: false },
  { code: 'process pool, first run', wall: 0.91, health: 0.0, bad: false },
  { code: 'process pool, warm', wall: 0.62, health: 0.0, bad: false },
];
---
<figure class="bep6d">
  <div class="bep6d-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four CPU-bound requests. Running the work inline in async def: 2.00 seconds total, and a health check waited 1.80 seconds. Running it in a thread: 1.97 seconds total, health check 0.09 seconds. Process pool first run: 0.91 total, health 0.00. Process pool warm: 0.62 total, health 0.00.">
    <text x={XA} y="34" class="gt"><tspan data-lang-en>all 4 requests done after</tspan><tspan data-lang-vi>cả 4 request xong sau</tspan></text>
    <text x={XB} y="34" class="gt"><tspan data-lang-en>/health had to wait</tspan><tspan data-lang-vi>/health phải chờ</tspan></text>
    {rows.map((r, i) => (
      <g>
        <text x="20" y={88 + i * 62} class="code">{r.code}</text>
        <rect x={XA} y={68 + i * 62} width={r.wall * PA} height="26" rx="3" class={r.bad ? 'bad' : 'ok'} />
        <text x={XA + r.wall * PA + 10} y={87 + i * 62} class={r.bad ? 'vr' : 'v'}>{r.wall.toFixed(2)} s</text>
        <rect x={XB} y={68 + i * 62} width={Math.max(r.health * PB, 2)} height="26" rx="3" class={r.bad ? 'bad' : 'ok'} />
        <text x={XB + Math.max(r.health * PB, 2) + 10} y={87 + i * 62} class={r.bad ? 'vr' : 'v'}>{r.health.toFixed(2)} s</text>
      </g>
    ))}
    <line x1={XA} y1="52" x2={XA} y2="300" class="axis" />
    <line x1={XB} y1="52" x2={XB} y2="300" class="axis" />
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Four requests, each 0.5 s of pure-Python arithmetic (Apple M2, 8 cores, Python 3.13). A thread keeps the server answering but does not finish the work sooner; a process does both.</span>
    <span data-lang-vi>Bốn request, mỗi cái 0.5 s tính toán thuần Python (Apple M2, 8 core, Python 3.13). Thread giữ cho server còn trả lời được nhưng không làm xong việc sớm hơn; process thì được cả hai.</span>
  </figcaption>
</figure>

<style>
  .bep6d { margin: 2em 0; width: 100%; }
  .bep6d-scroll { overflow-x: auto; }
  .bep6d svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .bep6d text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep6d .gt { font-weight: 700; fill: var(--text); font-size: 14.5px; }
  .bep6d .code { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; fill: var(--text); }
  .bep6d .v { fill: var(--text); font-weight: 700; }
  .bep6d .vr { fill: var(--red); font-weight: 700; }
  .bep6d .axis { stroke: var(--text-muted); stroke-width: 1.4; }
  .bep6d .ok { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.3; }
  .bep6d .bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; }
  .bep6d figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
