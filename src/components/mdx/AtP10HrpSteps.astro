---
// The three steps of hierarchical risk parity (Lopez de Prado 2016; steps as described by
// Hudson & Thames and Wikipedia). Flow drawn left to right.
import DiagramIcon from './DiagramIcon.astro';
const W = 900, H = 300;
const steps = [
  { icon: 'tree', x: 20, en: '1. Tree clustering', vi: '1. Dựng cây phân cụm',
    a: ['Correlation → distance,', 'merge the closest groups', 'until one tree is left'], b: ['Tương quan → khoảng cách,', 'nhập các nhóm gần nhất', 'cho tới còn một cây'] },
  { icon: 'index', x: 320, en: '2. Quasi-diagonalisation', vi: '2. Sắp lại ma trận',
    a: ['Reorder the covariance rows', 'by the tree so similar', 'stocks sit side by side'], b: ['Sắp lại hàng của ma trận', 'hiệp phương sai theo cây để', 'cổ phiếu giống nhau nằm cạnh'] },
  { icon: 'scale', x: 620, en: '3. Recursive bisection', vi: '3. Chia đôi đệ quy',
    a: ['Split the ordered list in half,', 'give the calmer half more,', 'repeat inside each half'], b: ['Chia đôi danh sách đã sắp,', 'phần êm hơn được nhiều hơn,', 'lặp lại trong từng nửa'] },
];
---
<figure class="p10hs">
  <div class="p10hs-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three boxes joined by arrows. Step 1, tree clustering: turn correlation into distance and merge the closest groups into one tree. Step 2, quasi-diagonalisation: reorder the covariance matrix by the tree. Step 3, recursive bisection: split the ordered list in half, give the calmer half more weight, and repeat inside each half. Output: weights, with no matrix inverse and no expected returns.">
    <text x="20" y="28" class="p10hs-h">
      <tspan data-lang-en>Hierarchical risk parity in three steps</tspan>
      <tspan data-lang-vi>Hierarchical risk parity trong ba bước</tspan>
    </text>
    {steps.map((s, k) => (
      <g>
        <rect x={s.x} y="50" width="260" height="170" rx="10" class="p10hs-box" />
        <DiagramIcon name={s.icon} x={s.x + 28} y={82} size={26} />
        <text x={s.x + 52} y="88" class="p10hs-t">
          <tspan data-lang-en>{s.en}</tspan>
          <tspan data-lang-vi>{s.vi}</tspan>
        </text>
        {[0, 1, 2].map((i) => (
          <text x={s.x + 18} y={128 + i * 26} class="p10hs-b">
            <tspan data-lang-en>{s.a[i]}</tspan>
            <tspan data-lang-vi>{s.b[i]}</tspan>
          </text>
        ))}
        {k < 2 && <polygon points={`${s.x + 264},135 ${s.x + 286},135 ${s.x + 286},125 ${s.x + 312},140 ${s.x + 286},155 ${s.x + 286},145 ${s.x + 264},145`} class="p10hs-arrow" />}
      </g>
    ))}
    <rect x="20" y="240" width="860" height="44" rx="8" class="p10hs-out" />
    <text x="38" y="268" class="p10hs-o">
      <tspan data-lang-en>Output: one weight per stock. No matrix inverse, and no forecast of expected returns.</tspan>
      <tspan data-lang-vi>Kết quả: một tỷ trọng cho mỗi cổ phiếu. Không nghịch đảo ma trận, không dự báo lợi suất kỳ vọng.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The original paper also builds a second distance between the distance profiles of two assets; the demo and the numbers in this post skip that refinement.</span>
    <span data-lang-vi>Bài gốc còn dựng thêm khoảng cách thứ hai giữa hồ sơ khoảng cách của hai tài sản; demo và các con số trong bài này bỏ qua phần tinh chỉnh đó.</span>
  </figcaption>
</figure>

<style>
  .p10hs { margin: 2em 0; width: 100%; }
  .p10hs-scroll { overflow-x: auto; }
  .p10hs svg { display: block; width: 100%; min-width: 720px; height: auto; }
  .p10hs text { font-size: 14px; fill: var(--text-body); }
  .p10hs .p10hs-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p10hs .p10hs-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .p10hs .p10hs-o { font-weight: 600; fill: var(--text); }
  .p10hs-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .p10hs-arrow { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.3; }
  .p10hs-out { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.3; }
  .p10hs figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
