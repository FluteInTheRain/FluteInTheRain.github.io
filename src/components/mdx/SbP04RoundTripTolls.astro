---
// Every layer of friction on a round-trip Vietnamese stock trade:
// Buy commission -> Monthly VSDC custody -> Sell commission + 0.1% PIT tax.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 290;

const STAGES = [
  {
    x: 20, w: 264, icon: 'receipt', accent: false,
    titleEn: '1. Buy leg (Day T)', titleVi: '1. Chiều Mua (Ngày T)',
    line1En: 'Broker fee: ~0.03% – 0.25%', line1Vi: 'Phí CTCK: ~0,03% – 0,25%',
    line2En: 'Includes ~0.027% exchange fee', line2Vi: 'Thường gồm ~0,027% phí trả sở',
    line3En: 'Tax: 0% on buying', line3Vi: 'Thuế TNCN: 0% khi mua',
  },
  {
    x: 318, w: 264, icon: 'calendar', accent: false,
    titleEn: '2. Holding (Monthly)', titleVi: '2. Nắm giữ (Hằng tháng)',
    line1En: 'VSDC custody: 0.27 đ / share / mo', line1Vi: 'Lưu ký VSDC: 0,27 đ / CP / tháng',
    line2En: 'Example: 4,000 CP = 1,080 đ / mo', line2Vi: 'Ví dụ: 4.000 CP = 1.080 đ / tháng',
    line3En: 'Deducted from cash balance', line3Vi: 'Trừ trực tiếp vào tiền mặt',
  },
  {
    x: 616, w: 264, icon: 'money', accent: true,
    titleEn: '3. Sell leg (Exit)', titleVi: '3. Chiều Bán (Thoát lệnh)',
    line1En: 'Broker fee: ~0.03% – 0.25%', line1Vi: 'Phí CTCK: ~0,03% – 0,25%',
    line2En: 'PIT tax: 0.1% of gross sale value', line2Vi: 'Thuế TNCN: 0,1% tổng giá trị bán',
    line3En: 'Charged whether you win or lose', line3Vi: 'Thu cả khi lãi lẫn khi lỗ',
  },
] as const;
---
<figure class="sbp4-tolls">
  <div class="sbp4-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three cost stages of a round-trip Vietnamese stock trade: buy commission (with 0% buy tax), monthly VSDC custody fee (0.27 VND per share per month), and sell commission plus 0.1% gross personal income tax.">
      <text x="20" y="30" class="sbp4-title">
        <tspan data-lang-en>Three tollgates on every round-trip stock trade in Vietnam</tspan>
        <tspan data-lang-vi>Ba trạm thu phí trên mỗi vòng mua – nắm giữ – bán cổ phiếu ở Việt Nam</tspan>
      </text>

      {STAGES.map((s) => (
        <g>
          <rect
            x={s.x}
            y="56"
            width={s.w}
            height="205"
            rx="10"
            class={s.accent ? 'sbp4-card sbp4-card-red' : 'sbp4-card'}
          />
          <DiagramIcon name={s.icon} x={s.x + 30} y={88} size={26} />
          <text x={s.x + 54} y="93" class={s.accent ? 'sbp4-hdr sbp4-red' : 'sbp4-hdr'}>
            <tspan data-lang-en>{s.titleEn}</tspan>
            <tspan data-lang-vi>{s.titleVi}</tspan>
          </text>
          <line x1={s.x + 18} y1="112" x2={s.x + s.w - 18} y2="112" class="sbp4-sep" />
          <text x={s.x + 20} y="144" class="sbp4-body">
            <tspan data-lang-en>{s.line1En}</tspan>
            <tspan data-lang-vi>{s.line1Vi}</tspan>
          </text>
          <text x={s.x + 20} y="178" class="sbp4-body">
            <tspan data-lang-en>{s.line2En}</tspan>
            <tspan data-lang-vi>{s.line2Vi}</tspan>
          </text>
          <text x={s.x + 20} y="222" class={s.accent ? 'sbp4-note sbp4-red' : 'sbp4-note'}>
            <tspan data-lang-en>{s.line3En}</tspan>
            <tspan data-lang-vi>{s.line3Vi}</tspan>
          </text>
        </g>
      ))}

      {/* Arrows between stages */}
      <line x1="288" y1="158" x2="310" y2="158" class="sbp4-arr" />
      <polygon points="316,158 308,153 308,163" class="sbp4-hd" />

      <line x1="586" y1="158" x2="608" y2="158" class="sbp4-arr fm-flow" />
      <polygon points="614,158 606,153 606,163" class="sbp4-hd" />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Buying pays only the brokerage commission; holding pays VSDC 0.27 VND per share per month; selling pays both the exit commission and a flat 0.1% personal income tax on the entire sale amount.</span>
    <span data-lang-vi>Chiều mua chỉ trả phí CTCK; lúc nắm giữ trả phí lưu ký VSDC 0,27 đồng/CP/tháng; chiều bán trả thêm phí CTCK lần hai cộng 0,1% thuế TNCN trên toàn bộ tiền bán.</span>
  </figcaption>
</figure>

<style>
  .sbp4-tolls { margin: 2em 0; width: 100%; }
  .sbp4-scroll { overflow-x: auto; }
  .sbp4-tolls svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sbp4-tolls text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .sbp4-title { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sbp4-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .sbp4-card-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .sbp4-hdr { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .sbp4-red { fill: var(--red); }
  .sbp4-sep { stroke: var(--border); stroke-width: 1; }
  .sbp4-body { font-size: 13px; fill: var(--text-body); }
  .sbp4-note { font-size: 12.5px; font-weight: 700; fill: var(--text-muted); }
  .sbp4-arr { stroke: var(--text-muted); stroke-width: 1.6; }
  .sbp4-hd { fill: var(--text-muted); }
  .sbp4-tolls figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
