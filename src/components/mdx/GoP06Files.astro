---
// Which files go/build and go test compile for the port folder.
// Icons: DiagramIcon (file / test = the two files, build / test = the command, folder = the directory). Motion: fm-flow on the arrow from the files into the command.
import DiagramIcon from './DiagramIcon.astro';
const rows = [
  { y: 44, cmd: 'go build', testFile: false },
  { y: 150, cmd: 'go test', testFile: true },
];
---
<figure class="p06a">
  <div class="p06a-scroll">
  <svg viewBox="0 0 900 250" role="img" aria-label="Folder port holds port.go and port_test.go. go build compiles only port.go and produces your program. go test compiles both files and reports PASS or FAIL for each test.">
    <DiagramIcon name="folder" x={32} y={17} size={24} />
    <text x="52" y="22" class="h"><tspan data-lang-en>Folder port/ holds two files</tspan><tspan data-lang-vi>Thư mục port/ có hai file</tspan></text>
    {rows.map((r) => (
      <g>
        <rect x="20" y={r.y} width="130" height="40" rx="6" class="box" />
        <DiagramIcon name="file" x={40} y={r.y + 20} size={24} />
        <text x="96" y={r.y + 25} text-anchor="middle" class="b">port.go</text>
        <rect x="165" y={r.y} width="170" height="40" rx="6" class={r.testFile ? 'box' : 'skip'} />
        <DiagramIcon name="test" x={187} y={r.y + 20} size={24} />
        <text x="258" y={r.y + 25} text-anchor="middle" class={r.testFile ? 'b' : 'm'}>port_test.go</text>
        <text x="250" y={r.y + 62} text-anchor="middle" class="s">
          {r.testFile
            ? <><tspan data-lang-en>compiled</tspan><tspan data-lang-vi>được biên dịch</tspan></>
            : <><tspan data-lang-en>not compiled</tspan><tspan data-lang-vi>không được biên dịch</tspan></>}
        </text>
        <text x="85" y={r.y + 62} text-anchor="middle" class="s"><tspan data-lang-en>compiled</tspan><tspan data-lang-vi>được biên dịch</tspan></text>
        <path d={`M 340 ${r.y + 20} L 412 ${r.y + 20}`} class="ln fm-flow" />
        <polygon points={`420,${r.y + 20} 411,${r.y + 15} 411,${r.y + 25}`} class="ah" />
        <rect x="425" y={r.y} width="140" height="40" rx="6" class="box" />
        <DiagramIcon name={r.testFile ? 'test' : 'build'} x={447} y={r.y + 20} size={24} />
        <text x="506" y={r.y + 25} text-anchor="middle" class="b">{r.cmd}</text>
        <path d={`M 570 ${r.y + 20} L 642 ${r.y + 20}`} class="ln" />
        <polygon points={`650,${r.y + 20} 641,${r.y + 15} 641,${r.y + 25}`} class="ah" />
        <text x="660" y={r.y + 25}>
          {r.testFile
            ? <><tspan data-lang-en>PASS or FAIL for each test</tspan><tspan data-lang-vi>PASS hoặc FAIL cho từng test</tspan></>
            : <><tspan data-lang-en>your program</tspan><tspan data-lang-vi>chương trình của bạn</tspan></>}
        </text>
      </g>
    ))}
    <line x1="20" x2="880" y1="124" y2="124" class="rule" />
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The test file sits next to the code it checks, but only go test compiles it, so it never ships in your program.</span>
    <span data-lang-vi>File test nằm cạnh code mà nó kiểm tra, nhưng chỉ go test mới biên dịch nó, nên nó không bao giờ có mặt trong chương trình của bạn.</span>
  </figcaption>
</figure>

<style>
  .p06a { margin: 2em 0; width: 100%; }
  .p06a-scroll { overflow-x: auto; }
  .p06a svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p06a text { font-size: 14px; fill: var(--text-body); }
  .p06a .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p06a .b { font-weight: 700; fill: var(--text); }
  .p06a .m { fill: var(--text-muted); }
  .p06a .s { font-size: 13px; fill: var(--text-muted); }
  .p06a .r { fill: var(--red); font-weight: 700; }
  .p06a .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .p06a .skip { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .p06a .hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .p06a .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .p06a .ln.cut { stroke-dasharray: 3 4; opacity: 0.5; }
  .p06a .ah { fill: var(--text-muted); }
  .p06a .rule { stroke: var(--border); stroke-width: 1; }
  .p06a .grid { stroke: var(--border); stroke-width: 1; }
  .p06a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
