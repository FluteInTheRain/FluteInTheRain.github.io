---
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 398;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

// Top row arrows
const aTopPtr = arrow(202, 84, 256, 84);
const aTopG1 = arrow(378, 74, 444, 68);
const aTopG2 = arrow(378, 96, 444, 126);

// Bottom row arrows
const aBotPtr = arrow(202, 278, 256, 278);
const aBotG1 = arrow(444, 260, 384, 270);
const aBotG2 = arrow(444, 318, 384, 286);
---
<figure class="g13app">
  <div class="g13app-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Concurrent append on a slice. Top: s := make([]int, 1) has len=1, cap=1 so each goroutine allocates a fresh backing array without a race. Bottom: s := make([]int, 0, 1) has len=0, cap=1 so both goroutines write to slot 0 of the same backing array simultaneously, triggering a data race.">
      {/* Row 1: make([]int, 1) full */}
      <text x="20" y="24" class="g13app-h">
        <tspan data-lang-en>1. s := make([]int, 1) — full slice (len = 1, cap = 1)</tspan>
        <tspan data-lang-vi>1. s := make([]int, 1) — slice đã đầy (len = 1, cap = 1)</tspan>
      </text>

      <rect x="20" y="54" width="182" height="58" rx="8" class="g13app-box" />
      <DiagramIcon name="struct" x={38} y={83} size={24} />
      <text x="111" y="77" text-anchor="middle" class="g13app-b">slice header s</text>
      <text x="111" y="99" text-anchor="middle" class="g13app-sub">ptr · len=1 · cap=1</text>

      <g class="g13app-arrow"><path d={aTopPtr.line} /><polygon points={aTopPtr.head} /></g>

      <rect x="260" y="54" width="118" height="58" rx="8" class="g13app-box" />
      <DiagramIcon name="heap" x={282} y={83} size={24} />
      <text x="324" y="88" text-anchor="middle" class="g13app-b">[ 0 ]</text>

      <g class="g13app-arrow is-gold"><path d={aTopG1.line} /><polygon points={aTopG1.head} /></g>
      <g class="g13app-arrow is-gold"><path d={aTopG2.line} /><polygon points={aTopG2.head} /></g>

      <rect x="448" y="42" width="204" height="48" rx="7" class="g13app-box is-gold" />
      <DiagramIcon name="gopher" x={466} y={60} size={24} />
      <text x="556" y="63" text-anchor="middle" class="g13app-b">g1: append(s, 10)</text>
      <text x="556" y="81" text-anchor="middle" class="g13app-gold">→ [ 0 | 10 ] (new array)</text>

      <rect x="448" y="102" width="204" height="48" rx="7" class="g13app-box is-gold" />
      <DiagramIcon name="gopher" x={466} y={120} size={24} />
      <text x="556" y="123" text-anchor="middle" class="g13app-b">g2: append(s, 20)</text>
      <text x="556" y="141" text-anchor="middle" class="g13app-gold">→ [ 0 | 20 ] (new array)</text>

      <rect x="676" y="48" width="204" height="96" rx="8" class="g13app-box is-gold" />
      <DiagramIcon name="ok" x={706} y={96} size={24} />
      <text x="788" y="84" text-anchor="middle" class="g13app-b">
        <tspan data-lang-en>Separate arrays</tspan>
        <tspan data-lang-vi>Hai mảng tách rời</tspan>
      </text>
      <text x="788" y="110" text-anchor="middle" class="g13app-gold">
        <tspan data-lang-en>-race passes cleanly</tspan>
        <tspan data-lang-vi>-race chạy qua sạch</tspan>
      </text>

      <line x1="20" y1="180" x2="880" y2="180" class="g13app-rule" />

      {/* Row 2: make([]int, 0, 1) spare capacity */}
      <text x="20" y="212" class="g13app-h is-red">
        <tspan data-lang-en>2. s := make([]int, 0, 1) — spare capacity (len = 0, cap = 1)</tspan>
        <tspan data-lang-vi>2. s := make([]int, 0, 1) — còn sức chứa thừa (len = 0, cap = 1)</tspan>
      </text>

      <rect x="20" y="248" width="182" height="58" rx="8" class="g13app-box" />
      <DiagramIcon name="struct" x={38} y={277} size={24} />
      <text x="111" y="271" text-anchor="middle" class="g13app-b">slice header s</text>
      <text x="111" y="293" text-anchor="middle" class="g13app-sub">ptr · len=0 · cap=1</text>

      <g class="g13app-arrow"><path d={aBotPtr.line} /><polygon points={aBotPtr.head} /></g>

      <rect x="260" y="248" width="120" height="58" rx="8" class="g13app-box is-red fm-pulse" />
      <DiagramIcon name="heap" x={282} y={266} size={22} />
      <text x="328" y="273" text-anchor="middle" class="g13app-b is-red">slot [0]</text>
      <text x="320" y="294" text-anchor="middle" class="g13app-red">
        <tspan data-lang-en>both write here</tspan>
        <tspan data-lang-vi>cả hai ghi vào</tspan>
      </text>

      <g class="g13app-arrow is-red"><path class="fm-flow" d={aBotG1.line} /><polygon points={aBotG1.head} /></g>
      <g class="g13app-arrow is-red"><path class="fm-flow" d={aBotG2.line} /><polygon points={aBotG2.head} /></g>

      <rect x="448" y="234" width="204" height="48" rx="7" class="g13app-box is-red" />
      <DiagramIcon name="gopher" x={466} y={252} size={24} />
      <text x="556" y="255" text-anchor="middle" class="g13app-b">g1: append(s, 10)</text>
      <text x="556" y="273" text-anchor="middle" class="g13app-red">writes backing[0] = 10</text>

      <rect x="448" y="294" width="204" height="48" rx="7" class="g13app-box is-red" />
      <DiagramIcon name="gopher" x={466} y={312} size={24} />
      <text x="556" y="315" text-anchor="middle" class="g13app-b">g2: append(s, 20)</text>
      <text x="556" y="333" text-anchor="middle" class="g13app-red">writes backing[0] = 20</text>

      <rect x="676" y="234" width="204" height="108" rx="8" class="g13app-box is-red" />
      <DiagramIcon name="bug" x={702} y={278} size={24} />
      <text x="788" y="266" text-anchor="middle" class="g13app-b is-red">
        <tspan data-lang-en>Data race on slot 0</tspan>
        <tspan data-lang-vi>Data race ngay ô số 0</tspan>
      </text>
      <text x="788" y="290" text-anchor="middle" class="g13app-red">go run -race fails</text>
      <text x="788" y="320" text-anchor="middle" class="g13app-sub">
        <tspan data-lang-en>Fix: s[:len:len] or copy</tspan>
        <tspan data-lang-vi>Sửa: s[:len:len] hoặc copy</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Calling append concurrently on a shared slice is only race-free by accident when len == cap. With spare capacity, both goroutines write to the same backing-array slot. Cap capacity with s[:len(s):len(s)] or copy into a fresh slice first.</span>
    <span data-lang-vi>Gọi append đồng thời trên cùng một slice chỉ vô tình không race khi len == cap. Còn sức chứa thừa là cả hai goroutine ghi đè lên đúng cùng một ô mảng nền. Hãy khóa sức chứa bằng s[:len(s):len(s)] hoặc copy ra slice riêng.</span>
  </figcaption>
</figure>

<style>
  .g13app { margin: 2em 0; width: 100%; }
  .g13app-scroll { overflow-x: auto; }
  .g13app svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .g13app text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .g13app-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .g13app-h.is-red { fill: var(--red); }
  .g13app-b { font-size: 14px; font-weight: 700; fill: var(--text); }
  .g13app-b.is-red { fill: var(--red); }
  .g13app-sub { font-size: 12.5px; fill: var(--text-muted); }
  .g13app-red { font-size: 12.5px; font-weight: 600; fill: var(--red); }
  .g13app-gold { font-size: 12.5px; font-weight: 600; fill: var(--gold-icon); }
  .g13app-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .g13app-box.is-red { fill: var(--red-tint-bg); stroke: var(--red); }
  .g13app-box.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .g13app-rule { stroke: var(--border); }
  .g13app-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.6; }
  .g13app-arrow polygon { fill: var(--text-muted); }
  .g13app-arrow.is-red path { stroke: var(--red); }
  .g13app-arrow.is-red polygon { fill: var(--red); }
  .g13app-arrow.is-gold path { stroke: var(--gold-icon); }
  .g13app-arrow.is-gold polygon { fill: var(--gold-icon); }
  .g13app figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
