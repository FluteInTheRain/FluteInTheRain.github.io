---
// Log compaction: keep only the latest value per key; a null value (tombstone) deletes the key.
// Keys, values and offsets are an illustrative example.
import DiagramIcon from './DiagramIcon.astro';
import StreamAFrame from './StreamAFrame.astro';
import { arrow } from './StreamAHelpers';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    h: 'Log compaction: keep the latest value for each key',
    r1: 'Before compaction', r2: 'After compaction',
    off: 'offset',
    mid: 'compaction keeps the latest value per key',
    n1: 'A tombstone (null value) marks a deleted key; compaction drops it later, once it has propagated.',
    n2: 'A new index reads from offset 0 and ends with k1 = F, k2 = E and k3 deleted.',
    alt: 'Before compaction a topic holds seven records at offsets 0 to 6: k1=A, k2=B, k1=C, k3=D, k2=E, k1=F and k3=null. After compaction only offsets 4, 5 and 6 remain: k2=E, k1=F and the k3 tombstone; offsets 0 to 3 are removed.',
    cap: 'Illustrative keys and values. Offsets never change, older records for the same key simply disappear.',
  },
  vi: {
    h: 'Log compaction: giữ giá trị mới nhất của mỗi key',
    r1: 'Trước khi compaction', r2: 'Sau khi compaction',
    off: 'offset',
    mid: 'compaction giữ giá trị mới nhất của mỗi key',
    n1: 'Tombstone (giá trị null) đánh dấu key đã bị xoá; compaction sẽ bỏ nó sau, khi đã lan tới các bên nhận.',
    n2: 'Index mới đọc từ offset 0 và kết thúc với k1 = F, k2 = E và k3 đã bị xoá.',
    alt: 'Trước compaction, topic có bảy bản ghi ở offset 0 đến 6: k1=A, k2=B, k1=C, k3=D, k2=E, k1=F và k3=null. Sau compaction chỉ còn offset 4, 5 và 6: k2=E, k1=F và tombstone của k3; offset 0 đến 3 bị loại.',
    cap: 'Key và giá trị chỉ là ví dụ minh hoạ. Offset không đổi, các bản ghi cũ của cùng một key đơn giản là biến mất.',
  },
}[lang];
const recs = ['k1 = A', 'k2 = B', 'k1 = C', 'k3 = D', 'k2 = E', 'k1 = F', 'k3 = null'];
const x = (i: number) => 30 + i * 120;
const keep = (i: number) => i >= 4;
const mid = arrow(450, 152, 450, 190);
---
<StreamAFrame h={356} alt={T.alt} cap={T.cap} title={T.h}>
  <DiagramIcon name="kafka" x={40} y={56} size={24} />
  <text x="62" y="61" class="name">{T.r1}</text>
  {recs.map((r, i) => (
    <g>
      <g class={keep(i) ? 'box good' : 'box'}>
        <rect x={x(i)} y="74" width="112" height="48" rx="6" />
        <text x={x(i) + 56} y="103" text-anchor="middle" class="num">{r}</text>
      </g>
      <text x={x(i) + 56} y="140" text-anchor="middle" class="sub">{`${T.off} ${i}`}</text>
    </g>
  ))}
  <g class="arr good"><path d={mid.line} /><polygon points={mid.head} /></g>
  <text x="464" y="176" class="name" style="font-size:13px">{T.mid}</text>
  <DiagramIcon name="kafka" x={40} y={212} size={24} />
  <text x="62" y="217" class="name">{T.r2}</text>
  {recs.map((r, i) => (
    <g>
      <g class={keep(i) ? 'box good' : 'box ghost'}>
        <rect x={x(i)} y="230" width="112" height="48" rx="6" />
        {keep(i) && <text x={x(i) + 56} y="259" text-anchor="middle" class="num">{r}</text>}
      </g>
      <text x={x(i) + 56} y="296" text-anchor="middle" class="sub">{`${T.off} ${i}`}</text>
    </g>
  ))}
  <text x="20" y="328" class="sub">{T.n1}</text>
  <text x="20" y="346" class="sub">{T.n2}</text>
</StreamAFrame>
