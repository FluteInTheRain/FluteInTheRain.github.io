---
// Hashing spreads keys, not traffic: ten shards, one celebrity key takes 90% of requests.
// The 90% and lane count come from the post's toll-plaza analogy and are illustrative.
// Inline SVG, site tokens.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const A = (x1: number, y1: number, x2: number, y2: number, c = '') => {
  const a = arrow(x1, y1, x2, y2);
  return { ...a, c };
};

const W = 900;
const H = 310;
const bars = Array.from({ length: 10 }, (_, i) => ({
  x: 440 + i * 44,
  h: i === 2 ? 135 : 3,
  hot: i === 2,
}));
const a1 = A(170, 125, 210, 125);
const a2 = A(360, 125, 420, 125);
---
<figure class="shaa-sk">
  <div class="shaa-sk-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A hot key. Requests pass through a hash function that spreads keys evenly over ten shards, but one celebrity key receives 90 percent of all requests, so shard 3 is overloaded while the other nine each get about 1 percent. Numbers are illustrative.">
      <rect x="20" y="85" width="150" height="80" rx="6" class="box" />
      <DiagramIcon name="users" x={95} y={110} size={26} />
      <text x="95" y="148" text-anchor="middle" class="b"><tspan data-lang-en>All requests</tspan><tspan data-lang-vi>Mọi request</tspan></text>
      <path d={a1.line} class="arrow" /><polygon points={a1.head} class="head" />

      <rect x="210" y="85" width="150" height="80" rx="6" class="box" />
      <DiagramIcon name="key" x={285} y={110} size={26} />
      <text x="285" y="146" text-anchor="middle" class="b">hash(key)</text>
      <text x="285" y="158" text-anchor="middle" class="s" style="font-size:11px"><tspan data-lang-en>keys spread evenly</tspan><tspan data-lang-vi>khoá rải đều</tspan></text>
      <path d={a2.line} class="arrow" /><polygon points={a2.head} class="head" />

      <text x="440" y="30" class="h"><tspan data-lang-en>Share of requests per shard (illustrative)</tspan><tspan data-lang-vi>Tỉ lệ request mỗi shard (minh hoạ)</tspan></text>
      <line x1="430" x2="880" y1="250" y2="250" class="rule" />
      {bars.map((b, i) => (
        <g>
          <rect x={b.x} y={250 - b.h} width="30" height={b.h} rx="3" class={b.hot ? 'box is-hot' : 'box'} />
          <text x={b.x + 15} y="270" text-anchor="middle" class="s">{i + 1}</text>
        </g>
      ))}
      <text x={440 + 2 * 44 + 15} y="95" text-anchor="middle" class="b is-hot"><tspan data-lang-en>celebrity key</tspan><tspan data-lang-vi>khoá nổi tiếng</tspan></text>
      <text x={440 + 2 * 44 + 15} y="111" text-anchor="middle" class="b is-hot">90%</text>
      <text x="715" y="228" text-anchor="middle" class="s"><tspan data-lang-en>about 1% each on the other nine</tspan><tspan data-lang-vi>khoảng 1% mỗi shard còn lại</tspan></text>
      <text x="655" y="293" text-anchor="middle" class="sub"><tspan data-lang-en>Shard number</tspan><tspan data-lang-vi>Số thứ tự shard</tspan></text>
      <DiagramIcon name="warning" x={34} y={235} size={22} />
      <text x="62" y="240" class="s is-hot"><tspan data-lang-en>One shard is the bottleneck.</tspan><tspan data-lang-vi>Một shard thành nút cổ chai.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A hash function spreads different keys, not the traffic of one key. The ten shards and the 90% are the toll-plaza example made literal, not measured data.</span>
    <span data-lang-vi>Hàm băm rải các khoá khác nhau, không rải được lưu lượng của một khoá. Mười shard và con số 90% là ví dụ trạm thu phí vẽ ra, không phải số đo thật.</span>
  </figcaption>
</figure>

<style>
  .shaa-sk { margin: 2em 0; width: 100%; }
  .shaa-sk-scroll { overflow-x: auto; }
  .shaa-sk svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shaa-sk text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shaa-sk .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shaa-sk .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shaa-sk .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shaa-sk .b.is-hot { fill: var(--red); }
  .shaa-sk .s { font-size: 12px; fill: var(--text-body); }
  .shaa-sk .s.is-hot { fill: var(--red); font-weight: 600; }
  .shaa-sk .big { font-size: 18px; font-weight: 700; fill: var(--text); }
  .shaa-sk .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shaa-sk .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shaa-sk .box.is-fix { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-sk .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shaa-sk .box.is-dim { opacity: 0.45; }
  .shaa-sk .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shaa-sk .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shaa-sk .arrow.is-hot { stroke: var(--red); }
  .shaa-sk .arrow.is-fix { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-sk .head { fill: var(--text-muted); }
  .shaa-sk .head.is-hot { fill: var(--red); }
  .shaa-sk .head.is-fix { fill: var(--gold-icon); }
  .shaa-sk figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
