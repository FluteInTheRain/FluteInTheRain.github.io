---
import TailAmplificationComponent from '../demos/TailAmplification.tsx';

interface Props {
  initialN?: number;
}
const { initialN = 100 } = Astro.props;
---
<figure class="ta-figure">
  <TailAmplificationComponent client:visible initialN={initialN} />
  <figcaption>
    <span data-lang-en>Drag N to change how many backend calls one page needs. Based on the example in <a href="https://cacm.acm.org/research/the-tail-at-scale/" target="_blank" rel="noopener">The Tail at Scale</a> (Dean &amp; Barroso, CACM 2013).</span>
    <span data-lang-vi>Kéo N để đổi số backend call mà một trang cần. Dựa trên ví dụ trong <a href="https://cacm.acm.org/research/the-tail-at-scale/" target="_blank" rel="noopener">The Tail at Scale</a> (Dean &amp; Barroso, CACM 2013).</span>
  </figcaption>
</figure>

<style is:global>
  .ta-figure {
    margin: 2em 0;
    width: 100%;
  }
  .ta-figure > figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
  .ta {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 18px 0;
  }
  .ta-control {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    font-size: 0.95em;
    color: var(--text-body);
  }
  .ta-control input[type='range'] {
    flex: 1 1 180px;
    accent-color: var(--red);
  }
  .ta-n {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700;
    color: var(--text);
    min-width: 6ch;
  }
  .ta-headline {
    margin: 16px 0 2px;
    font-size: 1.1em;
    color: var(--text);
  }
  .ta-headline strong {
    font-size: 1.6em;
    color: var(--red);
    font-variant-numeric: tabular-nums;
  }
  .ta-formula {
    margin: 0 0 14px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    color: var(--text-muted);
  }
  .ta-panels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
  }
  .ta-panel-title {
    margin: 0 0 10px;
    font-size: 0.85em;
    font-weight: 600;
    color: var(--text-muted);
  }
  .ta-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }
  .ta-cell {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    background: var(--border);
  }
  .ta-cell.is-slow {
    background: var(--red);
  }
  .ta-result {
    margin: 12px 0 10px;
    font-size: 0.92em;
    color: var(--text-body);
  }
  .ta-result.is-slow {
    color: var(--red);
    font-weight: 600;
  }
  .ta-btn {
    font: inherit;
    font-size: 0.85em;
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
  }
  .ta-btn:hover {
    border-color: var(--text-muted);
  }
  .ta-chart {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 10px;
  }
  .ta-gridline {
    stroke: var(--border);
    stroke-width: 1;
  }
  .ta-tick {
    font-size: 11px;
    fill: var(--text-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .ta-curve {
    fill: none;
    stroke: var(--text);
    stroke-width: 2;
  }
  .ta-guide {
    stroke: var(--red);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }
  .ta-point {
    fill: var(--red);
  }
  .ta-sim {
    margin: 10px 0 0;
    font-size: 0.88em;
    color: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
</style>
