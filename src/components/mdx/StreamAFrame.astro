---
// Shared frame for the StreamA* figures: figure + horizontally scrollable svg + caption.
// Child shapes use the classes defined below (box, arr, name, sub, bad ...). Colours are site tokens only.
interface Props { w?: number; h: number; alt: string; cap: string; title?: string }
const { w = 900, h, alt, cap, title } = Astro.props;
---
<figure class="sa">
  <div class="sa-scroll">
    <svg viewBox={`0 0 ${w} ${h}`} role="img" aria-label={alt}>
      {title && <text x="20" y="26" class="h">{title}</text>}
      <slot />
    </svg>
  </div>
  <figcaption>{cap}</figcaption>
</figure>

<style>
  .sa { margin: 2em 0; width: 100%; }
  .sa-scroll { overflow-x: auto; }
  .sa svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sa :global(text) { font-size: 14px; fill: var(--text-body); }
  .sa :global(.h) { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sa :global(.name) { font-weight: 700; fill: var(--text); }
  .sa :global(.sub) { font-size: 13px; fill: var(--text-muted); font-variant-numeric: tabular-nums; }
  .sa :global(.bad) { font-size: 13px; fill: var(--red); }
  .sa :global(.num) { font-size: 13px; font-weight: 700; fill: var(--text); font-variant-numeric: tabular-nums; }
  .sa :global(.box rect) { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .sa :global(.box.off rect) { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .sa :global(.box.good rect) { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .sa :global(.box.dash rect) { stroke-dasharray: 4 4; fill: none; }
  .sa :global(.box.ghost rect) { stroke-dasharray: 4 4; fill: none; stroke: var(--border); }
  .sa :global(.box.ghost text) { fill: var(--text-muted); font-weight: 400; }
  .sa :global(.frame) { fill: none; stroke: var(--gold); stroke-width: 1.5; stroke-dasharray: 6 4; }
  .sa :global(.arr path) { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .sa :global(.arr polygon) { fill: var(--text-muted); }
  .sa :global(.arr.bad path) { stroke: var(--red); stroke-dasharray: 5 4; }
  .sa :global(.arr.bad polygon) { fill: var(--red); }
  .sa :global(.arr.good path) { stroke: var(--gold); stroke-width: 2; }
  .sa :global(.arr.good polygon) { fill: var(--gold); }
  .sa :global(.rule) { stroke: var(--border); stroke-width: 1; }
  .sa :global(.guide) { stroke: var(--border); stroke-width: 1; stroke-dasharray: 2 4; }
  .sa figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
