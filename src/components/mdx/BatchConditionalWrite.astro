---
import BatchDiagram from './BatchDiagram.astro';
const boxes = [{"x": 20, "y": 46, "w": 200, "h": 64, "t": ["Writer A", "Writer A"], "s": [["put If-None-Match: *", "put If-None-Match: *"]], "icon": "worker"}, {"x": 20, "y": 196, "w": 200, "h": 64, "t": ["Writer B", "Writer B"], "s": [["put If-None-Match: *", "put If-None-Match: *"]], "icon": "worker"}, {"x": 335, "y": 121, "w": 230, "h": 64, "t": ["metadata/v7.json", "metadata/v7.json"], "s": [["key does not exist yet", "khoá chưa tồn tại"]], "icon": "s3"}, {"x": 640, "y": 46, "w": 240, "h": 64, "t": ["200 OK", "200 OK"], "s": [["A creates v7", "A tạo v7"]], "icon": "ok", "kind": "good"}, {"x": 640, "y": 196, "w": 240, "h": 64, "t": ["412 Precondition Failed", "412 Precondition Failed"], "s": [["B reads v7, retries on v8", "B đọc v7, thử lại v8"]], "icon": "fail", "kind": "hot"}];
const arrows = [{"x1": 220, "y1": 78, "x2": 335, "y2": 138, "lx": 270, "ly": 96}, {"x1": 220, "y1": 228, "x2": 335, "y2": 168, "lx": 270, "ly": 222}, {"x1": 565, "y1": 138, "x2": 640, "y2": 78, "kind": "good", "lx": 620, "ly": 94}, {"x1": 565, "y1": 168, "x2": 640, "y2": 228, "kind": "hot", "lx": 620, "ly": 222}];
const texts = [{"x": 20, "y": 26, "cls": "h", "t": ["Two writers race to create the same key", "Hai writer cùng tranh tạo một khoá"]}, {"x": 20, "y": 296, "cls": "foot", "t": ["Until August 2024 S3 could not do this, so Iceberg leaned on DynamoDB or an external catalog.", "Trước tháng 8/2024 S3 chưa làm được, nên Iceberg phải nhờ DynamoDB hoặc catalog ngoài."]}, {"x": 20, "y": 320, "cls": "ok", "t": ["Now the object store itself rejects the loser: no lock service needed.", "Giờ chính object store từ chối bên thua: không cần dịch vụ khoá."]}];
---
<BatchDiagram
  w={900} h={340}
  aria="Two writers race to create the same key on S3 with If-None-Match. The first gets 200 OK, the second gets 412 Precondition Failed and retries."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any} rules={[]} icons={[]}
  caption={["A conditional write turns \"create if absent\" into one atomic step, so only one racing writer wins.", "Ghi có điều kiện biến \"tạo nếu chưa có\" thành một bước nguyên tử, nên chỉ một writer thắng."]}
/>
