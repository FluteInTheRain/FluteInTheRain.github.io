---
// Real sourced incident (golang/go#79392): passing a typed-nil *os.File into tls.Config.KeyLogWriter
// makes c.KeyLogWriter == nil evaluate to false, aborting TLS handshakes with invalid argument.
const W = 900;
const H = 306;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const a1 = arrow(212, 78, 242, 78);
const a2 = arrow(472, 78, 502, 78);
const a3 = arrow(686, 78, 716, 78);

const b1 = arrow(250, 246, 286, 246);
const b2 = arrow(516, 246, 552, 246);
---
<figure class="gp12a">
  <div class="gp12a-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: returning a nil *os.File pointer populates KeyLogWriter with a non-nil type, so crypto/tls calls Write on nil and aborts the handshake. Bottom: returning untyped nil leaves both interface words nil and skips logging.">
    {/* Row 1: typed nil path */}
    <text x="20" y="26" class="h">
      <tspan data-lang-en>1. Typed nil *os.File assigned to tls.Config.KeyLogWriter</tspan>
      <tspan data-lang-vi>1. Gán con trỏ *os.File bằng nil vào tls.Config.KeyLogWriter</tspan>
    </text>

    <rect x="20" y="44" width="192" height="68" rx="6" class="box" />
    <text x="116" y="70" text-anchor="middle" class="b">getKeyLogWriter()</text>
    <text x="116" y="94" text-anchor="middle" class="m">
      <tspan data-lang-en>returns (*os.File)(nil)</tspan>
      <tspan data-lang-vi>trả về (*os.File)(nil)</tspan>
    </text>

    <g><path d={a1.line} class="ln" /><polygon points={a1.head} class="ar" /></g>

    <rect x="242" y="44" width="230" height="68" rx="6" class="hot" />
    <text x="357" y="70" text-anchor="middle" class="b">KeyLogWriter (io.Writer)</text>
    <text x="357" y="94" text-anchor="middle" class="r">tab = *os.File, data = nil</text>

    <g><path d={a2.line} class="lnr" /><polygon points={a2.head} class="arr" /></g>

    <rect x="502" y="44" width="184" height="68" rx="6" class="hot" />
    <text x="594" y="70" text-anchor="middle" class="b">KeyLogWriter == nil</text>
    <text x="594" y="94" text-anchor="middle" class="r">
      <tspan data-lang-en>evaluates to false</tspan>
      <tspan data-lang-vi>cho kết quả false</tspan>
    </text>

    <g><path d={a3.line} class="lnr" /><polygon points={a3.head} class="arr" /></g>

    <rect x="716" y="44" width="164" height="68" rx="6" class="hot" />
    <text x="798" y="70" text-anchor="middle" class="b">(*os.File).Write</text>
    <text x="798" y="94" text-anchor="middle" class="r">os.ErrInvalid</text>

    <text x="20" y="138" class="r">
      <tspan data-lang-en>Handshake aborts: tls: KeyLogWriter: invalid argument (Go issue #79392)</tspan>
      <tspan data-lang-vi>Handshake bị ngắt: tls: KeyLogWriter: invalid argument (Go issue #79392)</tspan>
    </text>

    <line x1="20" x2={W - 20} y1="164" y2="164" class="rule" />

    {/* Row 2: untyped nil fix */}
    <text x="20" y="194" class="h">
      <tspan data-lang-en>2. Return io.Writer with untyped nil (or guard w != nil first)</tspan>
      <tspan data-lang-vi>2. Trả về kiểu io.Writer với nil thuần (hoặc kiểm tra w != nil trước)</tspan>
    </text>

    <rect x="20" y="212" width="230" height="68" rx="6" class="box" />
    <text x="135" y="238" text-anchor="middle" class="b">getKeyLogWriter() io.Writer</text>
    <text x="135" y="262" text-anchor="middle" class="m">
      <tspan data-lang-en>returns untyped nil</tspan>
      <tspan data-lang-vi>trả về nil thuần</tspan>
    </text>

    <g><path d={b1.line} class="ln" /><polygon points={b1.head} class="ar" /></g>

    <rect x="286" y="212" width="230" height="68" rx="6" class="box" />
    <text x="401" y="238" text-anchor="middle" class="b">KeyLogWriter (io.Writer)</text>
    <text x="401" y="262" text-anchor="middle" class="m">tab = nil, data = nil</text>

    <g><path d={b2.line} class="ln" /><polygon points={b2.head} class="ar" /></g>

    <rect x="552" y="212" width="328" height="68" rx="6" class="box" />
    <text x="716" y="238" text-anchor="middle" class="b">c.KeyLogWriter == nil  -&gt;  true</text>
    <text x="716" y="262" text-anchor="middle" class="m">
      <tspan data-lang-en>skips key log, handshake succeeds</tspan>
      <tspan data-lang-vi>bỏ qua ghi log, handshake thành công</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>A typed nil pointer fills the interface's type word, so <code>c.KeyLogWriter == nil</code> is false inside <code>crypto/tls</code> and the handshake aborts when <code>(*os.File).Write</code> sees a nil receiver.</span>
    <span data-lang-vi>Con trỏ typed nil điền sẵn phần kiểu vào interface, nên phép kiểm tra <code>c.KeyLogWriter == nil</code> bên trong <code>crypto/tls</code> cho ra <code>false</code> và làm hỏng handshake khi <code>(*os.File).Write</code> nhận receiver nil.</span>
  </figcaption>
</figure>

<style>
  .gp12a { margin: 2em 0; width: 100%; }
  .gp12a-scroll { overflow-x: auto; }
  .gp12a svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp12a text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .gp12a .h { font-size: 15.5px; font-weight: 700; fill: var(--text); }
  .gp12a .b { font-weight: 700; fill: var(--text); }
  .gp12a .m { fill: var(--text-muted); font-size: 13px; }
  .gp12a .r { fill: var(--red); font-weight: 700; font-size: 13px; }
  .gp12a .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp12a .hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .gp12a .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp12a .ar { fill: var(--text-muted); }
  .gp12a .lnr { fill: none; stroke: var(--red); stroke-width: 1.5; }
  .gp12a .arr { fill: var(--red); }
  .gp12a .rule { stroke: var(--border); stroke-width: 1; }
  .gp12a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
