---
// Two lanes from the capture beside the figure (cap_stale): the same three
// steps with assign-stale (database only) and assign (database + delete).
const W = 900, H = 400;
const lanes = [
  {
    x: 20, red: true,
    title: { en: 'write the database only', vi: 'chỉ ghi database' },
    code: '/assign-stale',
    steps: [
      { a: { en: 'read: MISS, 55.9 ms', vi: 'đọc: MISS, 55.9 ms' }, b: { en: 'cache now holds detective=Hale', vi: 'cache giờ giữ detective=Hale' } },
      { a: { en: 'database now says Wren', vi: 'database giờ ghi Wren' }, b: { en: 'the cached copy is not told', vi: 'bản trong cache không được báo' } },
      { a: { en: 'read: HIT, 1.1 ms', vi: 'đọc: HIT, 1.1 ms' }, b: { en: 'answers detective=Hale: stale', vi: 'trả detective=Hale: cũ' } },
    ],
  },
  {
    x: 470, red: false,
    title: { en: 'write, then delete the key', vi: 'ghi, rồi xoá key' },
    code: '/assign',
    steps: [
      { a: { en: 'read: MISS, 57.0 ms', vi: 'đọc: MISS, 57.0 ms' }, b: { en: 'cache now holds detective=Wren', vi: 'cache giờ giữ detective=Wren' } },
      { a: { en: 'database now says Okafor', vi: 'database giờ ghi Okafor' }, b: { en: 'DEL case:C-1 right after', vi: 'DEL case:C-1 ngay sau đó' } },
      { a: { en: 'read: MISS, 58.1 ms', vi: 'đọc: MISS, 58.1 ms' }, b: { en: 'answers detective=Okafor: fresh', vi: 'trả detective=Okafor: mới' } },
    ],
  },
];
---
<figure class="bep8s">
  <div class="bep8s-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two lanes of three steps. Left, assign-stale writes only the database: the cache holds Hale, the database says Wren, and the next read is a hit that answers Hale, which is stale. Right, assign writes the database and deletes the cache key: the next read is a miss that answers Okafor, the fresh value.">
    {lanes.map((l) => (
      <g>
        <text x={l.x + 205} y="26" text-anchor="middle" class="h"><tspan data-lang-en>{l.title.en}</tspan><tspan data-lang-vi>{l.title.vi}</tspan></text>
        <text x={l.x + 205} y="46" text-anchor="middle" class="code">POST {l.code}</text>
        {l.steps.map((s, i) => {
          const y = 66 + i * 104;
          const bad = l.red && i === 2;
          const good = !l.red && i === 2;
          return (
            <g>
              <rect x={l.x} y={y} width="410" height="76" rx="10" class={bad ? 'box redbox' : good ? 'box goldbox' : 'box'} />
              <text x={l.x + 20} y={y + 32} class={bad ? 'h red' : 'h'}><tspan data-lang-en>{s.a.en}</tspan><tspan data-lang-vi>{s.a.vi}</tspan></text>
              <text x={l.x + 20} y={y + 56} class={bad ? 's red' : 's'}><tspan data-lang-en>{s.b.en}</tspan><tspan data-lang-vi>{s.b.vi}</tspan></text>
              {i < 2 && <line x1={l.x + 205} y1={y + 76} x2={l.x + 205} y2={y + 92} class="ln" />}
              {i < 2 && <polygon points={`${l.x + 205},${y + 104} ${l.x + 199},${y + 92} ${l.x + 211},${y + 92}`} class="hd" />}
            </g>
          );
        })}
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Same three steps, one line of difference. Without the delete, the cache keeps answering with the old value until its TTL runs out.</span>
    <span data-lang-vi>Cùng ba bước, khác nhau một dòng. Không có lệnh xoá, cache cứ trả giá trị cũ cho đến khi TTL hết.</span>
  </figcaption>
</figure>

<style>
  .bep8s { margin: 2em 0; width: 100%; }
  .bep8s-scroll { overflow-x: auto; }
  .bep8s svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .bep8s text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep8s .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep8s .s { fill: var(--text-muted); font-size: 13px; }
  .bep8s .h.red, .bep8s .s.red { fill: var(--red); }
  .bep8s .code { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; fill: var(--text-muted); }
  .bep8s .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep8s .box.redbox { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .bep8s .box.goldbox { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.5; }
  .bep8s .ln { stroke: var(--text-muted); stroke-width: 1.6; }
  .bep8s .hd { fill: var(--text-muted); }
  .bep8s figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
