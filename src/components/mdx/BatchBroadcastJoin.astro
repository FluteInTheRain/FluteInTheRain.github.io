---
import BatchDiagram from './BatchDiagram.astro';
const boxes = [{"x": 20, "y": 46, "w": 240, "h": 64, "t": ["Clicks and users", "Clicks và users"], "s": [["both sharded by key", "cùng chia theo khoá"]], "icon": "log"}, {"x": 330, "y": 46, "w": 240, "h": 64, "t": ["Network shuffle", "Shuffle qua mạng"], "s": [["the giant table moves too", "bảng khổng lồ cũng bị chuyển"]], "icon": "network", "kind": "hot"}, {"x": 640, "y": 46, "w": 240, "h": 64, "t": ["Reducers", "Các reducer"], "s": [["join one key range each", "mỗi cái join một dải khoá"]], "icon": "server"}, {"x": 20, "y": 250, "w": 200, "h": 64, "t": ["Users table", "Bảng users"], "s": [["small, under 10 MB", "nhỏ, dưới 10 MB"]], "icon": "db", "kind": "good"}, {"x": 330, "y": 214, "w": 240, "h": 56, "t": ["Mapper 1", "Mapper 1"], "s": [["clicks slice + users copy", "mảnh clicks + bản users"]], "icon": "server"}, {"x": 330, "y": 294, "w": 240, "h": 56, "t": ["Mapper 2", "Mapper 2"], "s": [["clicks slice + users copy", "mảnh clicks + bản users"]], "icon": "server"}, {"x": 640, "y": 250, "w": 240, "h": 64, "t": ["Joined output", "Đầu ra đã join"], "s": [["no shuffle of clicks", "không shuffle clicks"]], "icon": "package", "kind": "good"}];
const arrows = [{"x1": 260, "y1": 78, "x2": 330, "y2": 78, "kind": "hot"}, {"x1": 570, "y1": 78, "x2": 640, "y2": 78}, {"x1": 220, "y1": 272, "x2": 330, "y2": 246, "label": ["copy", "sao chép"], "kind": "good", "lx": 270, "ly": 250}, {"x1": 220, "y1": 292, "x2": 330, "y2": 322, "kind": "good"}, {"x1": 570, "y1": 242, "x2": 640, "y2": 272, "kind": "good"}, {"x1": 570, "y1": 322, "x2": 640, "y2": 292, "kind": "good"}];
const texts = [{"x": 20, "y": 26, "cls": "h", "t": ["Shuffle join: both sides cross the network", "Shuffle join: cả hai bên đi qua mạng"]}, {"x": 20, "y": 194, "cls": "h", "t": ["Broadcast join: copy the small table everywhere", "Broadcast join: sao bảng nhỏ tới mọi nơi"]}, {"x": 20, "y": 386, "cls": "ok", "t": ["Spark broadcasts automatically below 10 MB (autoBroadcastJoinThreshold).", "Spark tự broadcast khi bảng dưới 10 MB (autoBroadcastJoinThreshold)."]}];
---
<BatchDiagram
  w={900} h={400}
  aria="Top: a shuffle join moves both tables across the network to reducers. Bottom: a broadcast join copies the small users table into every mapper, which joins its local slice of clicks with no shuffle."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any} rules={[160]} icons={[]}
  caption={["A broadcast join trades a little memory on each worker for skipping the expensive shuffle of the big table.", "Broadcast join đổi một chút RAM trên mỗi worker để khỏi phải shuffle bảng lớn."]}
/>
