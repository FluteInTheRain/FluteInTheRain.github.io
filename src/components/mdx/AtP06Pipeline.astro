---
import DiagramIcon from './DiagramIcon.astro';
// The factor pipeline, with the step where the Data post's rules apply marked on each box.
const steps = [
  { icon: 'calendar', en: ['Universe', 'as of the date'], vi: ['Danh sách mã', 'đúng ngày đó'], noteEn: 'includes the dead', noteVi: 'gồm cả mã đã chết' },
  { icon: 'clock', en: ['Characteristic', 'known_at ≤ date'], vi: ['Đặc trưng', 'known_at ≤ ngày'], noteEn: 'no look-ahead', noteVi: 'không nhìn trước' },
  { icon: 'index', en: ['Rank', 'top to bottom'], vi: ['Xếp hạng', 'từ cao xuống thấp'], noteEn: 'one rule, set first', noteVi: 'một luật, chốt trước' },
  { icon: 'scale', en: ['Long top,', 'short bottom'], vi: ['Mua nhóm đầu,', 'bán nhóm cuối'], noteEn: 'or long-only', noteVi: 'hoặc chỉ mua' },
  { icon: 'retry', en: ['Hold, then', 'rebalance'], vi: ['Giữ, rồi', 'cân lại'], noteEn: 'costs come here', noteVi: 'phí tính ở đây' },
  { icon: 'chart', en: ['Factor return', 'every month'], vi: ['Lợi nhuận factor', 'mỗi tháng'], noteEn: 'the series you test', noteVi: 'chuỗi để kiểm định' },
];
---
<figure class="p06g">
  <div class="p06g-scroll">
    <svg viewBox="0 0 900 250" role="img" aria-label="Six steps that turn a characteristic into a factor return series: universe as of the date, characteristic known on that date, rank, long the top and short the bottom, hold and rebalance, factor return every month.">
      <text x="20" y="26" class="h"><tspan data-lang-en>From a column in a table to a factor series</tspan><tspan data-lang-vi>Từ một cột trong bảng tới một chuỗi factor</tspan></text>
      {steps.map((s, i) => {
        const x = 14 + i * 148;
        return (
          <g>
            <rect x={x} y="50" width="132" height="160" rx="8" class="box" />
            <DiagramIcon name={s.icon} x={x + 66} y={84} size={26} />
            <text x={x + 66} y="130" class="t" text-anchor="middle"><tspan data-lang-en>{s.en[0]}</tspan><tspan data-lang-vi>{s.vi[0]}</tspan></text>
            <text x={x + 66} y="148" class="t" text-anchor="middle"><tspan data-lang-en>{s.en[1]}</tspan><tspan data-lang-vi>{s.vi[1]}</tspan></text>
            <text x={x + 66} y="190" class="k" text-anchor="middle"><tspan data-lang-en>{s.noteEn}</tspan><tspan data-lang-vi>{s.noteVi}</tspan></text>
            {i < 5 && <polygon points={`${x + 134},130 ${x + 144},130 ${x + 144},125 ${x + 148},130 ${x + 144},135 ${x + 144},130`} class="arr" />}
          </g>
        );
      })}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Every step has a place where the data rules from the Data post apply: the membership table, the as-of date, and the trading costs.</span>
    <span data-lang-vi>Mỗi bước đều có chỗ cần các quy tắc dữ liệu của bài Dữ liệu: bảng thành viên, ngày as-of và phí giao dịch.</span>
  </figcaption>
</figure>
<style>
  .p06g { margin: 2em 0; width: 100%; }
  .p06g-scroll { overflow-x: auto; }
  .p06g svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p06g text { font-size: 13px; fill: var(--text-body); }
  .p06g .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p06g .t { font-size: 13px; font-weight: 700; fill: var(--text); }
  .p06g .k { font-size: 12px; fill: var(--text-muted); }
  .p06g .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p06g .arr { fill: var(--text-muted); stroke: var(--text-muted); stroke-width: 1.5; }
  .p06g figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
