---
// 37signals' yearly cloud bill before and after leaving the cloud, plus the one-off
// Dell hardware purchase, on one dollar scale. Numbers as reported by DHH (Oct 2024).
// Plain inline SVG with site tokens; no ids.

const W = 900;
const H = 312;

const L = 220; // bars start here
const PER_M = 131.25; // px per million USD (3.2M -> 640)
const bx = (m: number) => L + m * PER_M;

const BEFORE = 3.2;
const NOW = 1.3;
const DELL = 0.7;
const GAP = BEFORE - NOW; // ~1.9M a year

const vi = (n: number) => n.toLocaleString('vi-VN');

const row1 = { y: 48, h: 40 };
const row2 = { y: 108, h: 40 };
const row3 = { y: 238, h: 32 };
const axisY = 296;
const ticks = [0, 1, 2, 3];
---
<figure class="cexit">
  <div class="cexit-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="37signals' yearly cloud bill: 3.2 million dollars a year before the exit, 1.3 million in 2024, all of it S3 storage. The gap is about 1.9 million dollars a year. The Dell servers they bought cost about 700 thousand dollars once and were paid back from the savings within 2023.">
    <text x="20" y="28" class="cexit-h">
      <tspan data-lang-en>Yearly cloud bill</tspan>
      <tspan data-lang-vi>Hóa đơn cloud mỗi năm</tspan>
    </text>

    {/* gridlines, kept out of the annotation band */}
    {ticks.map((t) => (
      <g>
        <line x1={bx(t)} x2={bx(t)} y1={row1.y - 6} y2={row2.y + row2.h + 4} class="cexit-grid" />
        <line x1={bx(t)} x2={bx(t)} y1={row3.y - 6} y2={row3.y + row3.h + 6} class="cexit-grid" />
      </g>
    ))}

    {/* row 1: before */}
    <text x="20" y={row1.y + 17} class="cexit-label">
      <tspan data-lang-en>Before the move</tspan>
      <tspan data-lang-vi>Trước khi rời cloud</tspan>
    </text>
    <text x="20" y={row1.y + 35} class="cexit-sub">
      <tspan data-lang-en>original run rate</tspan>
      <tspan data-lang-vi>mức chi ban đầu</tspan>
    </text>
    <rect x={L} y={row1.y} width={bx(BEFORE) - L} height={row1.h} rx="3" class="cexit-bar" />
    <text x={bx(BEFORE) - 10} y={row1.y + 25} text-anchor="end" class="cexit-in">
      <tspan data-lang-en>${BEFORE}M</tspan>
      <tspan data-lang-vi>{vi(BEFORE)} triệu USD</tspan>
    </text>

    {/* row 2: 2024 */}
    <text x="20" y={row2.y + 17} class="cexit-label">
      <tspan data-lang-en>In 2024</tspan>
      <tspan data-lang-vi>Năm 2024</tspan>
    </text>
    <text x="20" y={row2.y + 35} class="cexit-sub">
      <tspan data-lang-en>after leaving the cloud</tspan>
      <tspan data-lang-vi>sau khi rời cloud</tspan>
    </text>
    <rect x={L} y={row2.y} width={bx(NOW) - L} height={row2.h} rx="3" class="cexit-bar" />
    <text x={bx(NOW) - 10} y={row2.y + 25} text-anchor="end" class="cexit-in">
      <tspan data-lang-en>${NOW}M</tspan>
      <tspan data-lang-vi>{vi(NOW)} triệu USD</tspan>
    </text>
    <rect x={bx(NOW) + 2} y={row2.y + 1} width={bx(BEFORE) - bx(NOW) - 3} height={row2.h - 2} rx="3" class="cexit-gap" />
    <text x={bx(BEFORE) + 12} y={row2.y + 17} class="cexit-gap-label">
      <tspan data-lang-en>about ${GAP.toFixed(1)}M less</tspan>
      <tspan data-lang-vi>bớt khoảng {vi(Number(GAP.toFixed(1)))} triệu USD</tspan>
    </text>
    <text x={bx(BEFORE) + 12} y={row2.y + 35} class="cexit-gap-sub">
      <tspan data-lang-en>every year</tspan>
      <tspan data-lang-vi>mỗi năm</tspan>
    </text>
    <text x={L} y={row2.y + row2.h + 22} class="cexit-sub">
      <tspan data-lang-en>all of it S3, which they planned to leave in 2025</tspan>
      <tspan data-lang-vi>toàn bộ là tiền S3, thứ họ định rời bỏ trong năm 2025</tspan>
    </text>

    {/* row 3: one-off hardware */}
    <line x1="20" x2={W - 20} y1="194" y2="194" class="cexit-rule" />
    <text x="20" y="222" class="cexit-h">
      <tspan data-lang-en>Paid once</tspan>
      <tspan data-lang-vi>Khoản trả một lần</tspan>
    </text>
    <text x="20" y={row3.y + 22} class="cexit-label">
      <tspan data-lang-en>New Dell servers</tspan>
      <tspan data-lang-vi>Server Dell mới</tspan>
    </text>
    <rect x={L} y={row3.y} width={bx(DELL) - L} height={row3.h} rx="3" class="cexit-bar is-once" />
    <text x={bx(DELL) + 12} y={row3.y + 21} class="cexit-val">
      <tspan data-lang-en>about $700k, paid back from the savings within 2023</tspan>
      <tspan data-lang-vi>khoảng 700.000 USD, đã hoàn vốn từ khoản tiết kiệm ngay trong 2023</tspan>
    </text>

    {/* axis */}
    {ticks.map((t) => (
      <text x={bx(t)} y={axisY} text-anchor="middle" class="cexit-tick">
        {t === 0 ? '0' : <><tspan data-lang-en>${t}M</tspan><tspan data-lang-vi>{t} triệu</tspan></>}
      </text>
    ))}
    <text x={W - 20} y={axisY} text-anchor="end" class="cexit-tick">
      <tspan data-lang-en>US dollars</tspan>
      <tspan data-lang-vi>đô la Mỹ (USD)</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>37signals moved everything except file storage off AWS onto its own servers. The earlier estimate was $7 million saved over five years; by October 2024 it was "well over ten million". Numbers as reported by 37signals; they do not include their own ops staff, which they say did not grow. Source: DHH, <a href="https://world.hey.com/dhh/our-cloud-exit-savings-will-now-top-10-million-over-five-years-c7d9b5bd" rel="noopener" target="_blank">Our cloud-exit savings will now top ten million over five years</a> (Oct 2024).</span>
    <span data-lang-vi>37signals chuyển mọi thứ, trừ phần lưu trữ file, ra khỏi AWS sang server của chính họ. Ước tính ban đầu là tiết kiệm 7 triệu USD trong năm năm; tới tháng 10/2024 con số đã "hơn hẳn 10 triệu". Số liệu do 37signals tự công bố; chưa tính đội vận hành của họ, mà theo họ đội này không tăng người. Nguồn: DHH, <a href="https://world.hey.com/dhh/our-cloud-exit-savings-will-now-top-10-million-over-five-years-c7d9b5bd" rel="noopener" target="_blank">Our cloud-exit savings will now top ten million over five years</a> (10/2024).</span>
  </figcaption>
</figure>

<style>
  .cexit {
    margin: 2em 0;
    width: 100%;
  }
  .cexit-scroll {
    overflow-x: auto;
  }
  .cexit svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .cexit text {
    font-size: 14px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .cexit .cexit-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .cexit .cexit-label {
    font-weight: 700;
    fill: var(--text);
  }
  .cexit .cexit-sub {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .cexit-grid,
  .cexit-rule {
    stroke: var(--border);
  }
  .cexit-bar {
    fill: var(--text-muted);
  }
  .cexit-bar.is-once {
    fill: var(--text-faint);
  }
  .cexit .cexit-in {
    font-weight: 700;
    fill: var(--bg);
  }
  .cexit-gap {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.2;
    stroke-dasharray: 5 4;
  }
  .cexit .cexit-gap-label {
    font-size: 15px;
    font-weight: 700;
    fill: var(--red);
  }
  .cexit .cexit-gap-sub {
    font-size: 13px;
    fill: var(--red);
  }
  .cexit .cexit-val {
    fill: var(--text-body);
  }
  .cexit .cexit-tick {
    font-size: 12px;
    fill: var(--text-muted);
  }
  .cexit figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
