---
import DiagramIcon from './DiagramIcon.astro';
// Two questions before copying a value: how often the original changes, and how many places hold a copy. Examples are the post's own.
// Arrowheads are polygons: no SVG ids.
const W = 900;
const H = 340;
type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}
const frames: any[] = [];
const boxes: any[] = [];
const links: any[] = [];
const labels: any[] = [];
const nums: any[] = [];
labels.push(
  { x: 337, y: 36, anchor: 'middle', en: 'The original rarely changes', vi: 'Bản gốc hiếm khi đổi', cls: 'strong' },
  { x: 702, y: 36, anchor: 'middle', en: 'The original changes often', vi: 'Bản gốc hay đổi', cls: 'strong' },
  { x: 12, y: 112, en: 'Few places', vi: 'Ít chỗ', cls: 'strong' },
  { x: 12, y: 130, en: 'hold a copy', vi: 'giữ bản chép', cls: 'muted' },
  { x: 12, y: 252, en: 'Many places', vi: 'Nhiều chỗ', cls: 'strong' },
  { x: 12, y: 270, en: 'hold a copy', vi: 'giữ bản chép', cls: 'muted' },
);
boxes.push(
  { x: 160, y: 50, w: 355, h: 130, icon: 'file', en: ['Copy it', 'Little to rewrite, and it', 'rarely needs rewriting'], vi: ['Chép ra', 'Ít chỗ phải sửa, mà cũng', 'hiếm khi phải sửa'] },
  { x: 525, y: 50, w: 365, h: 130, icon: 'sync', en: ['Either works', 'A rewrite touches only', 'a few places'], vi: ['Cách nào cũng được', 'Một lần sửa chỉ đụng', 'vài chỗ'] },
  { x: 160, y: 190, w: 355, h: 130, icon: 'ok', kind: 'good', en: ['Copy it', "A product name on last year's sales rows", 'Tweet ids in a cached timeline'], vi: ['Chép ra', 'Tên sản phẩm trên các dòng bán năm ngoái', 'Id tweet trong timeline đã cache'] },
  { x: 525, y: 190, w: 365, h: 130, icon: 'link', kind: 'bad', en: ['Store an id, look it up', 'A username on millions of timelines', 'Like counts, profile photos'], vi: ['Lưu id, cần thì tra', 'Username trên hàng triệu timeline', 'Số like, ảnh đại diện'] },
);
---
<figure class="dmcd">
  <div class="dmcd-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A two-by-two grid. If the original rarely changes and few places hold a copy, copying is fine. If it rarely changes but many places hold a copy, copy it, for example a product name on last year's sales rows or tweet ids in a cached timeline. If it changes often and few places hold a copy, either works. If it changes often and many places hold a copy, store an id and look it up, for example a username on millions of cached timelines, like counts and profile photos.">
    {frames.map((f) => (
      <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="6" class={`dmcd-frame ${f.kind ?? ''}`} />
    ))}
    {boxes.map((b) => {
      const n = Math.max(b.en.length, b.vi.length);
      const top = !!b.top;
      const cx = b.x + b.w / 2;
      const x0 = top ? cx : b.icon ? b.x + 46 : b.x + 14;
      const y0 = top ? b.y + (b.icon ? 56 : 24) : b.y + b.h / 2 - ((n - 1) * 17) / 2 + 4;
      return (
        <g class={`dmcd-box ${b.kind ?? ''}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
          {b.icon && <DiagramIcon name={b.icon} x={top ? cx : b.x + 24} y={top ? b.y + 24 : b.y + b.h / 2} size={b.is ?? 26} />}
          {Array.from({ length: n }).map((_, i) => (
            <text x={x0} y={y0 + i * 17} text-anchor={top ? 'middle' : 'start'} class={i === 0 && !b.flat ? 'dmcd-name' : 'dmcd-sub'}>
              <tspan data-lang-en>{b.en[i] ?? ''}</tspan>
              <tspan data-lang-vi>{b.vi[i] ?? ''}</tspan>
            </text>
          ))}
        </g>
      );
    })}
    {links.map((l) => {
      const a = arrow(l.pts);
      return (
        <g>
          <polyline points={l.plain ? l.pts.map((p) => p.join(',')).join(' ') : a.line} class={`dmcd-edge ${l.kind ?? ''}`} fill="none" />
          {!l.plain && <polygon points={a.head} class={`dmcd-head ${l.kind ?? ''}`} />}
        </g>
      );
    })}
    {labels.map((t) => (
      <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`dmcd-lab ${t.cls ?? ''}`}>
        <tspan data-lang-en>{t.en}</tspan>
        <tspan data-lang-vi>{t.vi ?? t.en}</tspan>
      </text>
    ))}
    {nums.map((n) => (
      <g class="dmcd-num">
        <circle cx={n.x} cy={n.y} r="11" />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.n}</text>
      </g>
    ))}

  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The red cell is where copies go stale and cost the most to fix. The bottom-left cell is why a warehouse can denormalize freely.</span>
    <span data-lang-vi>Ô đỏ là chỗ bản chép dễ cũ đi và sửa tốn nhất. Ô dưới bên trái là lý do warehouse có thể denormalize thoải mái.</span>
  </figcaption>
</figure>

<style>
  .dmcd { margin: 2em 0; width: 100%; }
  .dmcd-scroll { overflow-x: auto; }
  .dmcd svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dmcd text { font-size: 14px; fill: var(--text-body); }
  .dmcd .dmcd-name { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .dmcd .dmcd-sub { font-size: 12px; fill: var(--text-muted); }
  .dmcd .dmcd-lab { font-size: 13px; }
  .dmcd .dmcd-lab.h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dmcd .dmcd-lab.strong { font-weight: 700; fill: var(--text); }
  .dmcd .dmcd-lab.muted { fill: var(--text-muted); }
  .dmcd .dmcd-lab.bad { font-weight: 700; fill: var(--red); }
  .dmcd .dmcd-lab.good { font-weight: 700; fill: var(--text); }
  .dmcd .dmcd-lab.mono, .dmcd .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .dmcd-frame { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .dmcd-frame.bad { stroke: var(--red); }
  .dmcd-frame.good { stroke: var(--gold); }
  .dmcd-box rect { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmcd-box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dmcd-box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmcd-box.plain rect { fill: none; stroke: var(--border); }
  .dmcd-edge { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmcd-edge.bad { stroke: var(--red); }
  .dmcd-edge.good { stroke: var(--gold-icon); }
  .dmcd-head { fill: var(--text-muted); }
  .dmcd-head.bad { fill: var(--red); }
  .dmcd-head.good { fill: var(--gold-icon); }
  .dmcd-num circle { fill: var(--bg-alt); stroke: var(--text-muted); }
  .dmcd-num text { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dmcd figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
