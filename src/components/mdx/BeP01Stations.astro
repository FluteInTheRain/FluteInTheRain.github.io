---
// The six stations of one request, drawn as a journey — mirroring the real
// curl trace in the post. Station 5 (your code) is the only red one.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 200;
const st = [50, 205, 360, 515, 670, 825];
const icons = ['dns', 'plug', 'lock', 'envelope', 'python', 'envelope-arrow'];
const frags = ['172.66.46.235', 'Connected :443', 'TLSv1.3', 'GET / HTTP/2 200', '', 'left intact'];
---
<figure class="bep1a">
  <div class="bep1a-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Timeline of one request's six stations, each with an icon: DNS, TCP, TLS, HTTP, your code, and the response riding back on the same connection — mirroring the curl trace.">
    <text x="282" y="28" text-anchor="middle" class="m"><tspan data-lang-en>the four stations before your process</tspan><tspan data-lang-vi>bốn trạm trước process của bạn</tspan></text>
    <path d="M 50 42 L 50 36 L 515 36 L 515 42" class="br" />
    {st.map((x, i) => (
      <image href={`/icons/flow/${icons[i]}.svg`} x={x - 15} y="56" width="30" height="30" class="icn" aria-hidden="true" />
    ))}
    <text x={st[0]} y="112" text-anchor="middle" class="t">DNS</text>
    <text x={st[1]} y="112" text-anchor="middle" class="t">TCP</text>
    <text x={st[2]} y="112" text-anchor="middle" class="t">TLS</text>
    <text x={st[3]} y="112" text-anchor="middle" class="t">HTTP</text>
    <text x={st[4]} y="112" text-anchor="middle" class="t"><tspan data-lang-en>your code</tspan><tspan data-lang-vi>code của bạn</tspan></text>
    <text x={st[5]} y="112" text-anchor="middle" class="t"><tspan data-lang-en>response back</tspan><tspan data-lang-vi>đi ngược lại</tspan></text>
    {(() => { const a = arrow(25, 140, 838, 140); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
    {st.map((x, i) => (
      <g>
        <circle cx={x} cy="140" r="14" class={i === 4 ? 'str' : 'st'} />
        <text x={x} y="145" text-anchor="middle" class={i === 4 ? 'n r' : 'n'}>{i + 1}</text>
      </g>
    ))}
    <text x={st[0]} y="174" text-anchor="middle" class="fr">{frags[0]}</text>
    <text x={st[1]} y="174" text-anchor="middle" class="fr">{frags[1]}</text>
    <text x={st[2]} y="174" text-anchor="middle" class="fr">{frags[2]}</text>
    <text x={st[3]} y="174" text-anchor="middle" class="fr">{frags[3]}</text>
    <text x={st[4]} y="174" text-anchor="middle" class="fr r"><tspan data-lang-en>uvicorn + your app</tspan><tspan data-lang-vi>uvicorn + app của bạn</tspan></text>
    <text x={st[5]} y="174" text-anchor="middle" class="fr">{frags[5]}</text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>One request, six stations — five of them outside your process. The curl trace above is this line, read top to bottom.</span>
    <span data-lang-vi>Một request, sáu trạm — năm trạm nằm ngoài process của bạn. Trace curl phía trên chính là dòng này, đọc từ trên xuống.</span>
  </figcaption>
</figure>

<style>
  .bep1a { margin: 2em 0; width: 100%; }
  .bep1a-scroll { overflow-x: auto; }
  .bep1a svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep1a text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep1a .t { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep1a .m { fill: var(--text-muted); font-size: 13px; }
  .bep1a .n { font-weight: 700; fill: var(--text); }
  .bep1a .r { fill: var(--red); }
  .bep1a .fr { fill: var(--text-muted); font-size: 13px; }
  .bep1a .st { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; }
  .bep1a .str { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 2; }
  .bep1a .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep1a .hd { fill: var(--text-muted); }
  .bep1a .br { stroke: var(--text-muted); stroke-width: 1.2; fill: none; }
  .bep1a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
