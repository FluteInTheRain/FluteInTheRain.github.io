---
// One leader, three followers: the write path and when the client hears "OK".
// Illustrative architecture, not data. Plain inline SVG with site tokens.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 9;
  const bx = x2 - len * Math.cos(a), by = y2 - len * Math.sin(a);
  const head = `${x2},${y2} ${bx + 4.5 * Math.sin(a)},${by - 4.5 * Math.cos(a)} ${bx - 4.5 * Math.sin(a)},${by + 4.5 * Math.cos(a)}`;
  return { line: { x1, y1, x2: bx, y2: by }, head };
}
const W = 900, H = 360;
const client = { x: 20, y: 150, w: 160, h: 60 };
const leader = { x: 260, y: 150, w: 210, h: 60 };
const fs = [
  { x: 650, y: 20, w: 230, h: 66, k: 'sync' },
  { x: 650, y: 147, w: 230, h: 66, k: 'async' },
  { x: 650, y: 274, w: 230, h: 66, k: 'async' },
];
const c1 = arrow(client.x + client.w, 170, leader.x, 170);
const c2 = arrow(leader.x, 195, client.x + client.w, 195);
const toF = fs.map((f) => arrow(leader.x + leader.w, 180, f.x, f.y + f.h / 2));
---
<figure class="rf">
  <div class="rf-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A client sends a write to the leader. The leader replicates it through the replication log to three followers. It waits for the synchronous follower's confirmation before answering OK to the client. The two asynchronous followers receive the change in the background without being waited for.">
    <rect x={client.x} y={client.y} width={client.w} height={client.h} rx="4" class="box" />
    <text x={client.x + client.w / 2} y="176" text-anchor="middle" class="t-h">Client</text>
    <text x={client.x + client.w / 2} y="195" text-anchor="middle" class="t-note"><tspan data-lang-en>app or user</tspan><tspan data-lang-vi>app hoặc người dùng</tspan></text>

    <rect x={leader.x} y={leader.y} width={leader.w} height={leader.h} rx="4" class="box strong" />
    <text x={leader.x + leader.w / 2} y="176" text-anchor="middle" class="t-h">Leader</text>
    <text x={leader.x + leader.w / 2} y="195" text-anchor="middle" class="t-note"><tspan data-lang-en>writes locally, appends to log</tspan><tspan data-lang-vi>ghi cục bộ, thêm vào log</tspan></text>

    <line {...c1.line} class="edge" /><polygon points={c1.head} class="head" />
    <text x="180" y="140" text-anchor="middle" class="t-note"><tspan data-lang-en>1. write</tspan><tspan data-lang-vi>1. ghi</tspan></text>
    <line {...c2.line} class="edge dash" /><polygon points={c2.head} class="head" />
    <text x="220" y="228" text-anchor="middle" class="t-note"><tspan data-lang-en>4. "OK"</tspan><tspan data-lang-vi>4. "OK"</tspan></text>

    {fs.map((f, i) => (
      <g>
        <line {...toF[i].line} class={f.k === 'sync' ? 'edge' : 'edge dash'} /><polygon points={toF[i].head} class="head" />
        <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="4" class="box" />
        <text x={f.x + f.w / 2} y={f.y + 28} text-anchor="middle" class="t-h">Follower {i + 1}</text>
        <text x={f.x + f.w / 2} y={f.y + 48} text-anchor="middle" class="t-note">
          {f.k === 'sync'
            ? <><tspan data-lang-en>synchronous: leader waits for it</tspan><tspan data-lang-vi>đồng bộ: leader chờ nó</tspan></>
            : <><tspan data-lang-en>asynchronous: no wait, may lag</tspan><tspan data-lang-vi>bất đồng bộ: có thể trễ</tspan></>}
        </text>
      </g>
    ))}
    <text x="610" y="62" text-anchor="end" class="t-note"><tspan data-lang-en>2. replication log, waits for ack</tspan><tspan data-lang-vi>2. replication log, chờ ack</tspan></text>
    <text x="610" y="300" text-anchor="end" class="t-note"><tspan data-lang-en>3. same log, in the background</tspan><tspan data-lang-vi>3. cùng log, chạy nền</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The semi-synchronous setup in the table: the client hears "OK" once the leader and one follower have the write. Reads can go to any of the four nodes.</span>
    <span data-lang-vi>Cấu hình bán đồng bộ trong bảng: client nhận "OK" khi leader và một follower đã có lần ghi. Đọc thì có thể đi tới bất kỳ node nào trong bốn node.</span>
  </figcaption>
</figure>

<style>
  .rf { margin: 2em 0; width: 100%; }
  .rf-scroll { overflow-x: auto; }
  .rf svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .rf text { font-size: 14px; fill: var(--text-body); }
  .rf .t-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .rf .t-note { font-size: 12.5px; fill: var(--text-muted); }
  .rf .t-bad { fill: var(--red); font-weight: 700; font-size: 13px; }
  .rf .t-ok { fill: var(--text); font-weight: 700; font-size: 13px; }
  .rf .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .rf .box.strong { stroke: var(--text); stroke-width: 1.8; }
  .rf .box.bad { stroke: var(--red); stroke-width: 1.8; }
  .rf .edge { stroke: var(--text-muted); stroke-width: 1.4; fill: none; }
  .rf .edge.dash { stroke-dasharray: 5 4; }
  .rf .edge.bad { stroke: var(--red); stroke-dasharray: 5 4; }
  .rf .head { fill: var(--text-muted); }
  .rf .head.bad { fill: var(--red); }
  .rf figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
