---
// What CREATE INDEX does, in three steps, and where else the same recipe appears.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 318;
const heads = (x2: number, y: number) => `${x2 - 7},${y - 4} ${x2 - 7},${y + 4} ${x2},${y}`;
type Step = { icon: string; en: string; vi: string; l1: [string, string]; l2: [string, string] };
const steps: Step[] = [
  { icon: 'db', en: '1. Snapshot', vi: '1. Bản chụp', l1: ['scan a consistent snapshot,', 'quét bản chụp nhất quán,'], l2: ['sort values, write the tree', 'sắp xếp, ghi cây index'] },
  { icon: 'retry', en: '2. Catch up', vi: '2. Đuổi kịp', l1: ['apply the transactions that', 'xử lý các giao dịch đã commit'], l2: ['committed during the scan', 'trong lúc đang quét'] },
  { icon: 'log', en: '3. Follow the stream', vi: '3. Theo dõi luồng ghi', l1: ['apply every future write', 'áp mọi lệnh ghi về sau'], l2: ['so the index stays fresh', 'để index luôn tươi'] },
];
const same = [
  { icon: 'index', en: 'CREATE INDEX', vi: 'CREATE INDEX' },
  { icon: 'sync', en: 'Add a follower replica', vi: 'Thêm follower replica' },
  { icon: 'kafka', en: 'Start CDC into Kafka', vi: 'Bật CDC sang Kafka' },
];
const cw = 270;
const gap = 25;
---
<figure class="ua-fig">
  <div class="ua-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="CREATE INDEX runs three steps: scan a snapshot, catch up on transactions committed meanwhile, then follow the change stream. Adding a follower replica and starting change data capture into Kafka use the same three steps.">
      <text x="20" y="24" class="ua-h"><tspan data-lang-en>One recipe, three names</tspan><tspan data-lang-vi>Một công thức, ba cái tên</tspan></text>
      {steps.map((s, i) => {
        const x = 20 + i * (cw + gap);
        const cx = x + cw / 2;
        return (
          <>
            <rect x={x} y="40" width={cw} height="132" rx="4" class="ua-box" />
            <DiagramIcon name={s.icon as any} x={cx} y={72} size={32} />
            <text x={cx} y="112" text-anchor="middle" class="ua-b"><tspan data-lang-en>{s.en}</tspan><tspan data-lang-vi>{s.vi}</tspan></text>
            <text x={cx} y="133" text-anchor="middle" class="ua-m"><tspan data-lang-en>{s.l1[0]}</tspan><tspan data-lang-vi>{s.l1[1]}</tspan></text>
            <text x={cx} y="151" text-anchor="middle" class="ua-m"><tspan data-lang-en>{s.l2[0]}</tspan><tspan data-lang-vi>{s.l2[1]}</tspan></text>
            {i < 2 && (
              <>
                <path d={`M${x + cw},106 L${x + cw + gap - 7},106`} class="ua-solid" />
                <polygon points={heads(x + cw + gap, 106)} class="ua-head" />
              </>
            )}
          </>
        );
      })}
      <text x="20" y="208" class="ua-n is-good"><tspan data-lang-en>The same three steps also appear when you:</tspan><tspan data-lang-vi>Cùng ba bước này cũng xuất hiện khi bạn:</tspan></text>
      {same.map((s, i) => {
        const x = 20 + i * (cw + gap);
        return (
          <>
            <rect x={x} y="222" width={cw} height="56" rx="4" class="ua-box is-good" />
            <DiagramIcon name={s.icon as any} x={x + 32} y={250} size={28} />
            <text x={x + 62} y="255" class="ua-b"><tspan data-lang-en>{s.en}</tspan><tspan data-lang-vi>{s.vi}</tspan></text>
          </>
        );
      })}
      <text x="450" y="304" text-anchor="middle" class="ua-m"><tspan data-lang-en>snapshot + backlog + ongoing change stream</tspan><tspan data-lang-vi>bản chụp + backlog + luồng thay đổi liên tục</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Once you see the recipe in one place, you can spot it everywhere databases copy their own data.</span>
    <span data-lang-vi>Thấy công thức này ở một nơi rồi, bạn sẽ nhận ra nó ở mọi chỗ database sao chép dữ liệu của chính nó.</span>
  </figcaption>
</figure>

<style>
  .ua-fig { margin: 2em 0; width: 100%; }
  .ua-scroll { overflow-x: auto; }
  .ua-fig svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .ua-fig text { font-size: 13px; fill: var(--text-body); }
  .ua-fig .ua-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-ph { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-b { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-m { font-size: 12.5px; fill: var(--text-muted); }
  .ua-fig .ua-n { font-size: 12.5px; font-weight: 700; fill: var(--text-muted); }
  .ua-fig .ua-n.is-hot, .ua-fig .ua-b.is-hot, .ua-fig .ua-m.is-hot { fill: var(--red); }
  .ua-fig .ua-n.is-good, .ua-fig .ua-b.is-good, .ua-fig .ua-m.is-good { fill: var(--gold-icon); }
  .ua-fig .ua-q { font-size: 20px; font-weight: 700; fill: var(--red); }
  .ua-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .ua-box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .ua-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .ua-panel { fill: none; stroke: var(--border); stroke-width: 1.2; }
  .ua-life { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .ua-solid { fill: none; stroke: var(--text-muted); stroke-width: 1.8; }
  .ua-dashed { fill: none; stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .ua-head { fill: var(--text-muted); }
  .ua-solid.is-hot, .ua-dashed.is-hot { stroke: var(--red); stroke-width: 1.9; }
  .ua-head.is-hot { fill: var(--red); }
  .ua-solid.is-good { stroke: var(--gold-icon); stroke-width: 2; }
  .ua-head.is-good { fill: var(--gold-icon); }
  .ua-fig figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
