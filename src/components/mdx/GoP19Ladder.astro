---
// Icons: DiagramIcon from diagram-icons.ts. Motion: fig-motion.css classes (fm-*).
// The four levels of the series plus the interview step. Level promises are the series page's own one-line blurbs.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const top = 48;
const rowH = 56;
const gap = 10;
const step = 50;
const levels = [
  { n: 5, tone: 'next', icon: 'test', en: 'Check yourself', vi: 'Tự kiểm tra', posts: 'Post 20', postsVi: 'Bài 20', pr: 'You can answer and code it under interview pressure.', prVi: 'Bạn trả lời và viết code được dưới áp lực phỏng vấn.', tag: 'next', tagVi: 'tiếp theo' },
  { n: 4, tone: 'here', icon: 'measure', en: 'Measure, then optimize', vi: 'Đo rồi mới tối ưu', posts: 'Posts 15 to 19', postsVi: 'Bài 15 đến 19', pr: 'You can prove a speed-up with numbers.', prVi: 'Bạn chứng minh được một lần tăng tốc bằng số đo.', tag: 'you are here', tagVi: 'bạn đang ở đây' },
  { n: 3, tone: 'done', icon: 'bug', en: 'Under the hood and traps', vi: 'Bên dưới và các cái bẫy', posts: 'Posts 11 to 14', postsVi: 'Bài 11 đến 14', pr: 'You know why the classic Go bugs happen.', prVi: 'Bạn hiểu vì sao các lỗi Go kinh điển xảy ra.', tag: '', tagVi: '' },
  { n: 2, tone: 'done', icon: 'parallel', en: 'Run things at once', vi: 'Chạy nhiều việc cùng lúc', posts: 'Posts 7 to 10', postsVi: 'Bài 7 đến 10', pr: 'You can run work concurrently and ship a small service.', prVi: 'Bạn chạy được công việc đồng thời và đưa một service nhỏ lên chạy.', tag: '', tagVi: '' },
  { n: 1, tone: 'done', icon: 'code', en: 'Write Go', vi: 'Viết Go', posts: 'Posts 1 to 6', postsVi: 'Bài 1 đến 6', pr: 'You can write, structure and test a Go program.', prVi: 'Bạn viết, tổ chức và kiểm thử được một chương trình Go.', tag: '', tagVi: '' },
];
const H = top + levels.length * (rowH + gap) + 4;
---
<figure class="gp19e">
  <div class="gp19e-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A staircase of five levels. Level 1 Write Go, posts 1 to 6. Level 2 Run things at once, posts 7 to 10. Level 3 Under the hood and traps, posts 11 to 14. Level 4 Measure, then optimize, posts 15 to 19, marked as the current level. Level 5 Check yourself, post 20, marked as next.">
    <text x="20" y="24" class="h">
      <tspan data-lang-en>The ladder, from the bottom</tspan>
      <tspan data-lang-vi>Cái thang, đi từ dưới lên</tspan>
    </text>
    {levels.map((l, i) => {
      const y = top + i * (rowH + gap);
      const off = (l.n - 1) * step;
      const x = 20 + off;
      const w = W - 40 - off;
      return (
        <g>
          <rect x={x} y={y} width={w} height={rowH} rx="8" class={'row ' + l.tone + (l.tone === 'here' ? ' fm-glow' : '')} />
          <DiagramIcon name={l.icon} x={x + 30} y={y + rowH / 2} size={28} />
          <text x={x + 58} y={y + 23} class="b">
            <tspan data-lang-en>Level {l.n}: {l.en}</tspan>
            <tspan data-lang-vi>Cấp {l.n}: {l.vi}</tspan>
          </text>
          <text x={x + 58} y={y + 44} class="m">
            <tspan data-lang-en>{l.posts}. {l.pr}</tspan>
            <tspan data-lang-vi>{l.postsVi}. {l.prVi}</tspan>
          </text>
          {l.tag !== '' && (
            <text x={x + w - 16} y={y + 23} text-anchor="end" class="b tag">
              <tspan data-lang-en>{l.tag}</tspan>
              <tspan data-lang-vi>{l.tagVi}</tspan>
            </text>
          )}
        </g>
      );
    })}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Levels 1 to 4 are behind you. Level 5 is one post of interview questions, each answer pointing back to the post that teaches it.</span>
    <span data-lang-vi>Bạn đã đi qua cấp 1 đến 4. Cấp 5 là một bài câu hỏi phỏng vấn, mỗi câu trả lời trỏ về bài dạy nó.</span>
  </figcaption>
</figure>

<style>
  .gp19e { margin: 2em 0; width: 100%; }
  .gp19e-scroll { overflow-x: auto; }
  .gp19e svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .gp19e text { font-size: 14px; fill: var(--text-body); }
  .gp19e .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp19e .b { font-weight: 700; fill: var(--text); }
  .gp19e .m { fill: var(--text-muted); }
  .gp19e .row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .gp19e .row.here { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .gp19e .row.next { fill: var(--bg); stroke: var(--text-muted); stroke-dasharray: 5 4; }
  .gp19e .tag { font-weight: 700; }
  .gp19e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
