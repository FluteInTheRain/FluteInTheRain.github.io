---
// How dropping sensitive columns fails when correlated proxy features leak them
// back into the model ("money laundering for bias").
// Plain inline SVG with site CSS tokens; polygon arrowheads (no marker ids).

const W = 900;
const H = 448;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const leftArrows = [
  arrow(285, 243, 336, 169),
  arrow(285, 287, 336, 255),
  arrow(285, 331, 336, 341),
];

const rightArrows = [
  arrow(606, 169, 652, 206),
  arrow(606, 255, 652, 236),
  arrow(606, 341, 652, 266),
];
---
<figure class="epc">
  <div class="epc-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Diagram showing that deleting race, nationality, or gender columns does not remove bias because kept columns like postal code, resume club names, and IP subnets correlate with them and produce a biased numeric risk score.">
      <text x="20" y="24" class="epc-h">
        <tspan data-lang-en>Deleting protected columns does not remove bias</tspan>
        <tspan data-lang-vi>Xóa cột nhạy cảm không làm hết thiên kiến</tspan>
      </text>
      <text x="20" y="46" class="epc-sub">
        <tspan data-lang-en>Correlated proxies silently reconstruct deleted traits and launder prejudice into a single numeric score.</tspan>
        <tspan data-lang-vi>Các biến đại diện âm thầm dựng lại đặc điểm đã xóa, rồi "rửa" thiên kiến cũ thành một con số.</tspan>
      </text>

      {/* Column 1: Applicant record */}
      <rect x="20" y="70" width="265" height="308" rx="8" class="epc-box" />
      <text x="34" y="95" class="epc-box-h">
        <tspan data-lang-en>1. Applicant record</tspan>
        <tspan data-lang-vi>1. Hồ sơ đầu vào</tspan>
      </text>

      <rect x="34" y="108" width="237" height="34" rx="4" class="epc-row is-dropped" />
      <text x="44" y="130" class="epc-row-txt is-muted">
        <tspan data-lang-en>race / nationality</tspan>
        <tspan data-lang-vi>chủng tộc / quốc tịch</tspan>
      </text>
      <line data-lang-en x1="42" x2="152" y1="125" y2="125" class="epc-strike" />
      <line data-lang-vi x1="42" x2="178" y1="125" y2="125" class="epc-strike" />
      <text x="261" y="130" text-anchor="end" class="epc-tag-red">
        <tspan data-lang-en>dropped</tspan>
        <tspan data-lang-vi>đã xóa</tspan>
      </text>

      <rect x="34" y="148" width="237" height="34" rx="4" class="epc-row is-dropped" />
      <text x="44" y="170" class="epc-row-txt is-muted">
        <tspan data-lang-en>gender</tspan>
        <tspan data-lang-vi>giới tính</tspan>
      </text>
      <line data-lang-en x1="42" x2="90" y1="165" y2="165" class="epc-strike" />
      <line data-lang-vi x1="42" x2="104" y1="165" y2="165" class="epc-strike" />
      <text x="261" y="170" text-anchor="end" class="epc-tag-red">
        <tspan data-lang-en>dropped</tspan>
        <tspan data-lang-vi>đã xóa</tspan>
      </text>

      <line x1="34" x2="271" y1="198" y2="198" class="epc-divider" />
      <text x="34" y="216" class="epc-small">
        <tspan data-lang-en>Kept columns fed to model</tspan>
        <tspan data-lang-vi>Các cột giữ lại đưa vào mô hình</tspan>
      </text>

      <rect x="34" y="226" width="237" height="34" rx="4" class="epc-row" />
      <text x="44" y="248" class="epc-row-txt">
        <tspan data-lang-en>postal code: 10027</tspan>
        <tspan data-lang-vi>mã bưu chính: 10027</tspan>
      </text>

      <rect x="34" y="270" width="237" height="34" rx="4" class="epc-row" />
      <text x="44" y="292" class="epc-row-txt">
        <tspan data-lang-en>"women's chess club"</tspan>
        <tspan data-lang-vi>"CLB cờ vua nữ"</tspan>
      </text>

      <rect x="34" y="314" width="237" height="34" rx="4" class="epc-row" />
      <text x="44" y="336" class="epc-row-txt">
        <tspan data-lang-en>IP subnet / credit gap</tspan>
        <tspan data-lang-vi>dải IP / kỳ gián đoạn</tspan>
      </text>

      {/* Column 2: Proxy correlation */}
      <text x="336" y="95" class="epc-box-h">
        <tspan data-lang-en>2. Model infers proxies</tspan>
        <tspan data-lang-vi>2. Mô hình suy ra biến đại diện</tspan>
      </text>

      <rect x="336" y="132" width="270" height="74" rx="6" class="epc-proxy" />
      <text x="350" y="158" class="epc-proxy-h">
        <tspan data-lang-en>Segregated neighborhood</tspan>
        <tspan data-lang-vi>Phân tách khu dân cư</tspan>
      </text>
      <text x="350" y="180" class="epc-small">
        <tspan data-lang-en>Postal code &amp; IP predict race</tspan>
        <tspan data-lang-vi>Mã vùng &amp; IP dự đoán chủng tộc</tspan>
      </text>

      <rect x="336" y="218" width="270" height="74" rx="6" class="epc-proxy" />
      <text x="350" y="244" class="epc-proxy-h">
        <tspan data-lang-en>Historical hiring skew</tspan>
        <tspan data-lang-vi>Lệch giới tính trong tuyển dụng cũ</tspan>
      </text>
      <text x="350" y="266" class="epc-small">
        <tspan data-lang-en>Club &amp; college names leak gender</tspan>
        <tspan data-lang-vi>Tên CLB &amp; trường làm lộ giới tính</tspan>
      </text>

      <rect x="336" y="304" width="270" height="74" rx="6" class="epc-proxy" />
      <text x="350" y="330" class="epc-proxy-h">
        <tspan data-lang-en>Socioeconomic history</tspan>
        <tspan data-lang-vi>Lịch sử kinh tế - xã hội</tspan>
      </text>
      <text x="350" y="352" class="epc-small">
        <tspan data-lang-en>Missing records reflect prior bias</tspan>
        <tspan data-lang-vi>Dữ liệu khuyết mang định kiến sẵn</tspan>
      </text>

      {/* Column 3: Model output */}
      <rect x="652" y="132" width="228" height="208" rx="8" class="epc-result" />
      <text x="668" y="160" class="epc-box-h">
        <tspan data-lang-en>3. "Neutral" output</tspan>
        <tspan data-lang-vi>3. Kết quả "khách quan"</tspan>
      </text>
      <text x="668" y="202" class="epc-score">
        <tspan data-lang-en>Risk score: 84 / 100</tspan>
        <tspan data-lang-vi>Điểm rủi ro: 84 / 100</tspan>
      </text>
      <text x="668" y="228" class="epc-decision">
        <tspan data-lang-en>Decision: Denied</tspan>
        <tspan data-lang-vi>Quyết định: Từ chối</tspan>
      </text>
      <line x1="668" x2="864" y1="252" y2="252" class="epc-divider" />
      <text x="668" y="278" class="epc-small">
        <tspan data-lang-en>Prejudice is now hidden</tspan>
        <tspan data-lang-vi>Thiên kiến cũ giờ được giấu</tspan>
      </text>
      <text x="668" y="298" class="epc-small">
        <tspan data-lang-en>inside opaque math, with</tspan>
        <tspan data-lang-vi>sau lớp toán học khó giải trình</tspan>
      </text>
      <text x="668" y="318" class="epc-small">
        <tspan data-lang-en>no simple path to appeal.</tspan>
        <tspan data-lang-vi>và rất khó để khiếu nại.</tspan>
      </text>

      {/* Arrows */}
      {leftArrows.map((a) => (
        <g class="epc-arrow">
          <path d={a.line} />
          <polygon points={a.head} />
        </g>
      ))}
      {rightArrows.map((a) => (
        <g class="epc-arrow is-red">
          <path d={a.line} />
          <polygon points={a.head} />
        </g>
      ))}

      {/* Bottom takeaway */}
      <line x1="20" x2={W - 20} y1="402" y2="402" class="epc-divider" />
      <text x="20" y="428" class="epc-takeaway">
        <tspan data-lang-en>Takeaway: fairness requires auditing outcome disparities across groups, not just deleting columns from the schema.</tspan>
        <tspan data-lang-vi>Điểm mấu chốt: muốn công bằng phải kiểm toán chênh lệch đầu ra giữa các nhóm, chứ không chỉ xóa vài cột khỏi bảng.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Why "fairness through unawareness" breaks down in practice, illustrated from DDIA chapter 14 and Reuters' report on Amazon's scrapped recruiting model. Even when protected attributes are removed, correlated features let gradient-boosted trees or neural networks relearn the same splits.</span>
    <span data-lang-vi>Vì sao cách "nhắm mắt làm ngơ bằng cách xóa cột nhạy cảm" thất bại trên thực tế, minh họa theo chương 14 DDIA và vụ công cụ tuyển dụng Amazon. Dù bỏ cột chủng tộc hay giới tính, mô hình vẫn suy lại đúng ranh giới đó qua các biến đại diện.</span>
  </figcaption>
</figure>

<style>
  .epc {
    margin: 2em 0;
    width: 100%;
  }
  .epc-scroll {
    overflow-x: auto;
  }
  .epc svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .epc text {
    font-size: 14px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .epc .epc-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .epc .epc-sub {
    font-size: 13.5px;
    fill: var(--text-muted);
  }
  .epc-box,
  .epc-proxy {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .epc .epc-box-h {
    font-weight: 700;
    fill: var(--text);
  }
  .epc-row {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 1;
  }
  .epc-row.is-dropped {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-dasharray: 4 3;
  }
  .epc .epc-row-txt {
    font-size: 13px;
    fill: var(--text);
  }
  .epc .epc-row-txt.is-muted {
    fill: var(--text-muted);
  }
  .epc-strike {
    stroke: var(--red);
    stroke-width: 1.5;
  }
  .epc .epc-tag-red {
    font-size: 12px;
    font-weight: 700;
    fill: var(--red);
  }
  .epc-divider {
    stroke: var(--border);
    stroke-width: 1;
  }
  .epc .epc-small {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .epc .epc-proxy-h {
    font-size: 13.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .epc-result {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.5;
  }
  .epc .epc-score {
    font-size: 19px;
    font-weight: 700;
    fill: var(--red);
  }
  .epc .epc-decision {
    font-size: 14px;
    font-weight: 600;
    fill: var(--text);
  }
  .epc-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .epc-arrow polygon {
    fill: var(--text-muted);
  }
  .epc-arrow.is-red path {
    stroke: var(--red);
  }
  .epc-arrow.is-red polygon {
    fill: var(--red);
  }
  .epc .epc-takeaway {
    font-size: 13.5px;
    fill: var(--text);
  }
  .epc figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
