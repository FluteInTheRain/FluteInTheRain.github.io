---
// What an interface variable holds for the Incrementer/Counter example.
// Row 1 compiles; row 2 is the line the compiler rejects, drawn to show why.
const W = 900;
const H = 272;
import DiagramIcon from './DiagramIcon.astro';
---
<figure class="p04d">
  <div class="p04d-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: a holds the type *Counter and the address of your Counter, so a.Inc() changes it. Bottom: b would hold the type Counter and a copy of Counter{}, so b.Inc() would change only the copy.">
    <text x="20" y="26" class="h">var a Incrementer = &amp;Counter{'{}'}</text>
    <DiagramIcon name="ok" x={380} y={21} size={24} />
    <text x="400" y="26" class="m"><tspan data-lang-en>compiles</tspan><tspan data-lang-vi>biên dịch được</tspan></text>
    <rect x="20" y="42" width="90" height="34" class="cell" />
    <rect x="110" y="42" width="190" height="34" class="cell" />
    <rect x="20" y="76" width="90" height="34" class="cell" />
    <rect x="110" y="76" width="190" height="34" class="cell" />
    <text x="32" y="64" class="m"><tspan data-lang-en>type</tspan><tspan data-lang-vi>kiểu</tspan></text>
    <text x="124" y="64" class="b">*Counter</text>
    <text x="32" y="98" class="m"><tspan data-lang-en>value</tspan><tspan data-lang-vi>giá trị</tspan></text>
    <text x="124" y="98" class="b"><tspan data-lang-en>address</tspan><tspan data-lang-vi>địa chỉ</tspan></text>
    <path d="M 300 93 L 470 93" class="ln fm-flow" />
    <polygon points="480,93 468,87 468,99" class="ar" />
    <rect x="490" y="76" width="140" height="34" class="cell" />
    <text x="504" y="98" class="b">Counter{'{n: 0}'}</text>
    <DiagramIcon name="struct" x={664} y={93} size={24} />
    <text x="686" y="98" class="m"><tspan data-lang-en>your Counter</tspan><tspan data-lang-vi>Counter của bạn</tspan></text>
    <text x="320" y="64" class="b"><tspan data-lang-en>a.Inc() changes your Counter.</tspan><tspan data-lang-vi>a.Inc() sửa Counter của bạn.</tspan></text>

    <line x1="20" x2="880" y1="136" y2="136" class="rule" />

    <text x="20" y="166" class="h">var b Incrementer = Counter{'{}'}</text>
    <DiagramIcon name="fail" x={380} y={161} size={24} />
    <text x="400" y="166" class="r"><tspan data-lang-en>compile error</tspan><tspan data-lang-vi>lỗi biên dịch</tspan></text>
    <rect x="20" y="182" width="90" height="34" class="cell" />
    <rect x="110" y="182" width="190" height="34" class="cell" />
    <rect x="20" y="216" width="90" height="34" class="cell" />
    <rect x="110" y="216" width="190" height="34" class="hot fm-pulse" />
    <text x="32" y="204" class="m"><tspan data-lang-en>type</tspan><tspan data-lang-vi>kiểu</tspan></text>
    <text x="124" y="204" class="b">Counter</text>
    <text x="32" y="238" class="m"><tspan data-lang-en>value</tspan><tspan data-lang-vi>giá trị</tspan></text>
    <text x="124" y="238" class="r"><tspan data-lang-en>a copy</tspan><tspan data-lang-vi>một bản sao</tspan></text>
    <path d="M 300 233 L 470 233" class="lnr" stroke-dasharray="4 4" />
    <rect x="490" y="216" width="140" height="34" class="cell" />
    <text x="504" y="238" class="b">Counter{'{n: 0}'}</text>
    <DiagramIcon name="struct" x={664} y={233} size={24} />
    <text x="686" y="238" class="m"><tspan data-lang-en>your Counter</tspan><tspan data-lang-vi>Counter của bạn</tspan></text>
    <text x="320" y="204" class="r"><tspan data-lang-en>b.Inc() would change only the copy.</tspan><tspan data-lang-vi>b.Inc() chỉ sửa bản sao.</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>An interface variable holds a type and a value. A struct value goes in as a copy, so a pointer-receiver method could never reach your original. The compiler refuses instead.</span>
    <span data-lang-vi>Biến interface giữ một kiểu và một giá trị. Struct đưa vào là một bản sao, nên method pointer receiver không bao giờ chạm tới bản gốc của bạn. Compiler từ chối thay vì để chuyện đó xảy ra.</span>
  </figcaption>
</figure>

<style>
  .p04d { margin: 2em 0; width: 100%; }
  .p04d-scroll { overflow-x: auto; }
  .p04d svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p04d text { font-size: 14px; fill: var(--text-body); }
  .p04d .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .p04d .m { fill: var(--text-muted); }
  .p04d .b { font-weight: 700; fill: var(--text); }
  .p04d .r { fill: var(--red); font-weight: 700; }
  .p04d .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .p04d .cell { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p04d .hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .p04d .dash { fill: none; stroke: var(--red); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .p04d .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .p04d .ar { fill: var(--text-muted); }
  .p04d .lnr { fill: none; stroke: var(--red); stroke-width: 1.5; }
  .p04d .arr { fill: var(--red); }
  .p04d .rule { stroke: var(--border); stroke-width: 1; }
  .p04d figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
