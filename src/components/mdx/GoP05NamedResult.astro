---
// Post 5, named results: which variable the return line sends out.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 8 * Math.cos(a - 0.45), y2 - 8 * Math.sin(a - 0.45)];
  const p2 = [x2 - 8 * Math.cos(a + 0.45), y2 - 8 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const a1 = arrow(220, 99, 640, 99);
const a2 = arrow(220, 277, 640, 277);
---
<figure class="gp05e">
  <div class="gp05e-scroll">
  <svg viewBox="0 0 900 330" role="img" aria-label="As written, check returns err, the named result that was never set, so the caller sees nil while e holds the failure. Fixed, err is assigned with = and the caller sees negative input.">
    <text x="20" y="24" class="h"><tspan data-lang-en>As written: the if body returns err</tspan><tspan data-lang-vi>Như đã viết: thân if trả về err</tspan></text>
    <rect class="box" x="20" y="40" width="200" height="34" rx="5" /><text x="34" y="62" class="b">msg</text><text x="206" y="62" text-anchor="end">""</text>
    <rect class="box red" x="20" y="82" width="200" height="34" rx="5" /><text x="34" y="104" class="b">err</text><text x="206" y="104" text-anchor="end" class="r">&lt;nil&gt;</text>
    <rect class="box dash" x="20" y="124" width="200" height="34" rx="5" /><text x="34" y="146" class="b">e</text><text x="206" y="146" text-anchor="end">negative input</text>
    <text x="240" y="122" class="m"><tspan data-lang-en>named result, never assigned</tspan><tspan data-lang-vi>named result, chưa từng được gán</tspan></text>
    <text x="240" y="150" class="m"><tspan data-lang-en>holds the failure, but nothing returns it</tspan><tspan data-lang-vi>giữ lỗi, nhưng không có gì trả nó về</tspan></text>
    <text x="430" y="90" text-anchor="middle" class="m">return "", err</text>
    <path class="ln red" d={a1.line} /><polygon points={a1.head} fill="var(--red)" />
    <rect class="box" x="640" y="74" width="240" height="50" rx="6" />
    <text x="760" y="95" text-anchor="middle" class="m"><tspan data-lang-en>caller prints</tspan><tspan data-lang-vi>nơi gọi in ra</tspan></text>
    <text x="760" y="114" text-anchor="middle" class="r n">msg="" err=&lt;nil&gt;</text>

    <line class="rule" x1="20" x2="880" y1="184" y2="184" />
    <text x="20" y="212" class="h"><tspan data-lang-en>Fixed: assign with =, no new variable</tspan><tspan data-lang-vi>Đã sửa: gán bằng =, không tạo biến mới</tspan></text>
    <rect class="box" x="20" y="224" width="200" height="34" rx="5" /><text x="34" y="246" class="b">msg</text><text x="206" y="246" text-anchor="end">""</text>
    <rect class="box" x="20" y="266" width="200" height="34" rx="5" /><text x="34" y="288" class="b">err</text><text x="206" y="288" text-anchor="end" class="b">negative input</text>
    <text x="240" y="246" class="m"><tspan data-lang-en>err = validate(n) writes into the named result</tspan><tspan data-lang-vi>err = validate(n) ghi thẳng vào named result</tspan></text>
    <text x="430" y="268" text-anchor="middle" class="m">return "", err</text>
    <path class="ln" d={a2.line} /><polygon points={a2.head} class="bar" />
    <rect class="box" x="640" y="252" width="240" height="50" rx="6" />
    <text x="760" y="273" text-anchor="middle" class="m"><tspan data-lang-en>caller prints</tspan><tspan data-lang-vi>nơi gọi in ra</tspan></text>
    <text x="760" y="292" text-anchor="middle" class="b n">msg="" err=negative input</text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Variables inside check(-5), drawn from the example above. The return line sends out whichever variable it names, and err was never set.</span>
    <span data-lang-vi>Các biến bên trong check(-5), vẽ theo ví dụ ở trên. Dòng return gửi ra đúng biến nó nêu tên, và err chưa từng được gán.</span>
  </figcaption>
</figure>

<style>
  .gp05e { margin: 2em 0; width: 100%; }
  .gp05e-scroll { overflow-x: auto; }
  .gp05e svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp05e text { font-size: 14px; fill: var(--text-body); }
  .gp05e .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp05e .b { font-weight: 700; fill: var(--text); }
  .gp05e .m { fill: var(--text-muted); font-size: 13px; }
  .gp05e .n { font-variant-numeric: tabular-nums; }
  .gp05e .r { fill: var(--red); font-weight: 700; }
  .gp05e .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp05e .box.red { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp05e .box.dash { stroke-dasharray: 4 3; }
  .gp05e .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp05e .ln.red { stroke: var(--red); }
  .gp05e .ln.cut { stroke-dasharray: 3 4; opacity: 0.5; }
  .gp05e .hd { fill: var(--text-muted); }
  .gp05e .hd.red { fill: var(--red); }
  .gp05e .rule { stroke: var(--border); }
  .gp05e .bar { fill: var(--text-muted); }
  .gp05e .bar.red { fill: var(--red); }
  .gp05e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
