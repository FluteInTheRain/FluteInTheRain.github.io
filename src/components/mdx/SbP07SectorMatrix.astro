---
// Sector matrix showing which primary valuation lens fits which Vietnamese industry group.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 290;

const SECTORS = [
  {
    x: 20, y: 54, w: 420, h: 100, red: false, icon: 'chart',
    sEn: 'Consumer / IT / Utilities (Steady)', sVi: 'Tiêu dùng / CNTT / Điện nước (Ổn định)',
    lEn: 'Primary lens: P/E + EPS Growth + Cash Yield', lVi: 'Thước đo chính: P/E + Tăng trưởng + Cổ tức',
    nEn: 'Predictable earnings make P/E & E/P reliable anchors', nVi: 'Lợi nhuận đều giúp P/E và E/P bám sát thực tế',
  },
  {
    x: 460, y: 54, w: 420, h: 100, red: false, icon: 'bank',
    sEn: 'Commercial Banks & Securities Brokers', sVi: 'Ngân hàng & Công ty chứng khoán',
    lEn: 'Primary lens: P/B paired with sustainable ROE', lVi: 'Thước đo chính: P/B đi kèm độ bền ROE',
    nEn: 'Balance sheet capital drives lending capacity & book', nVi: 'Vốn chủ là nguyên liệu cho vay & dự phòng rủi ro',
  },
  {
    x: 20, y: 170, w: 420, h: 100, red: true, icon: 'warning',
    sEn: 'Heavy Cyclicals (Steel, Fertilizer, Shipping)', sVi: 'Chu kỳ nặng (Thép, Phân bón, Vận tải biển)',
    lEn: 'Primary lens: P/B + Mid-Cycle Normalized P/E', lVi: 'Thước đo chính: P/B + P/E lợi nhuận trung bình',
    nEn: 'Headline trailing P/E tricks you backwards at peaks!', nVi: 'Nhìn P/E 4 quý dễ bị lừa mua đúng đỉnh lãi đột biến!',
  },
  {
    x: 460, y: 170, w: 420, h: 100, red: false, icon: 'shield',
    sEn: 'Real Estate Developers / Land Banks', sVi: 'Bất động sản / Khu công nghiệp',
    lEn: 'Primary lens: RNAV + P/B + Net Debt / Pre-sales', lVi: 'Thước đo chính: RNAV + P/B + Nợ vay / Người mua trả trước',
    nEn: 'Bookings recognize only at project handover years later', nVi: 'Doanh thu dồn cục lúc bàn giao nhà nên P/E giật cục',
  },
] as const;
---
<figure class="sbp7-sec">
  <div class="sbp7-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Sector valuation matrix: P/E and EPS growth for steady Consumer/IT/Utilities; P/B paired with ROE for Banks/Brokers; P/B and mid-cycle normalized earnings for Steel/Shipping cyclicals; RNAV/P/B and pre-sales for Real Estate.">
      <text x="20" y="30" class="sbp7-title">
        <tspan data-lang-en>Right ratio, right sector: match the yardstick to how the business makes money</tspan>
        <tspan data-lang-vi>Đúng thước đo cho đúng ngành: không dùng chung một kính hiển vi cho mọi cổ phiếu</tspan>
      </text>

      {SECTORS.map((s) => (
        <g>
          <rect x={s.x} y={s.y} width={s.w} height={s.h} rx="10" class={s.red ? 'sbp7-card-red' : 'sbp7-card'} />
          <DiagramIcon name={s.icon} x={s.x + 26} y={s.y + 30} size={22} />
          <text x={s.x + 50} y={s.y + 34} class={s.red ? 'sbp7-hdr sbp7-red' : 'sbp7-hdr'}>
            <tspan data-lang-en>{s.sEn}</tspan>
            <tspan data-lang-vi>{s.sVi}</tspan>
          </text>
          <text x={s.x + 18} y={s.y + 62} class="sbp7-body">
            <tspan data-lang-en>{s.lEn}</tspan>
            <tspan data-lang-vi>{s.lVi}</tspan>
          </text>
          <text x={s.x + 18} y={s.y + 86} class="sbp7-sub">
            <tspan data-lang-en>{s.nEn}</tspan>
            <tspan data-lang-vi>{s.nVi}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Applying consumer-style trailing P/E directly to steelmakers or real estate developers is the #1 valuation mistake beginners make on HOSE.</span>
    <span data-lang-vi>Mang P/E 4 quý gần nhất kiểu bán lẻ áp thẳng vào cổ phiếu thép hay bất động sản là lỗi định giá phổ biến nhất của người mới trên sàn.</span>
  </figcaption>
</figure>

<style>
  .sbp7-sec { margin: 2em 0; width: 100%; }
  .sbp7-scroll { overflow-x: auto; }
  .sbp7-sec svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sbp7-sec text { font-size: 12.5px; fill: var(--text-body); }
  .sbp7-title { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sbp7-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .sbp7-card-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .sbp7-hdr { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .sbp7-red { fill: var(--red); }
  .sbp7-body { font-size: 12.5px; font-weight: 600; fill: var(--text); }
  .sbp7-sub { font-size: 12px; fill: var(--text-muted); }
  .sbp7-sec figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
