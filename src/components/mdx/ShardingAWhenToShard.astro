---
// A three-step ladder: stay on one machine, add read replicas, shard last.
// Plain inline SVG, site CSS tokens, DiagramIcon for nodes.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const A = (x1: number, y1: number, x2: number, y2: number, c = '') => {
  const a = arrow(x1, y1, x2, y2);
  return { ...a, c };
};

const W = 900;
const H = 300;
const xs = [20, 325, 630];
const arrows = [A(270, 120, 322, 120), A(575, 120, 627, 120)];
---
<figure class="shaa-wts">
  <div class="shaa-wts-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three steps for scaling a database. Step one: one machine, stay there while it handles your writes and storage. Step two: add read replicas if only reads are slow. Step three: shard when writes or storage no longer fit on one machine. Sharding has costs: the partition key is hard to change, joins cross the network and multi-shard transactions are slow.">
      {xs.map((x, i) => (
        <rect x={x} y="20" width="250" height="190" rx="6" class={i === 2 ? 'box is-active' : 'box'} />
      ))}

      <DiagramIcon name="server" x={145} y={58} size={32} />
      <text x="145" y="104" text-anchor="middle" class="b"><tspan data-lang-en>1. One machine</tspan><tspan data-lang-vi>1. Một máy</tspan></text>
      <text x="145" y="132" text-anchor="middle" class="s"><tspan data-lang-en>Handles your writes</tspan><tspan data-lang-vi>Gánh nổi lệnh ghi</tspan></text>
      <text x="145" y="150" text-anchor="middle" class="s"><tspan data-lang-en>and storage?</tspan><tspan data-lang-vi>và dung lượng?</tspan></text>
      <text x="145" y="176" text-anchor="middle" class="b"><tspan data-lang-en>Stay here.</tspan><tspan data-lang-vi>Cứ ở yên đó.</tspan></text>

      <DiagramIcon name="sync" x={450} y={58} size={32} />
      <text x="450" y="104" text-anchor="middle" class="b"><tspan data-lang-en>2. Add read replicas</tspan><tspan data-lang-vi>2. Thêm read replica</tspan></text>
      <text x="450" y="132" text-anchor="middle" class="s"><tspan data-lang-en>Only reads are slow?</tspan><tspan data-lang-vi>Chỉ đọc bị chậm?</tspan></text>
      <text x="450" y="150" text-anchor="middle" class="s"><tspan data-lang-en>Copy data to more nodes.</tspan><tspan data-lang-vi>Chép dữ liệu sang thêm máy.</tspan></text>
      <text x="450" y="176" text-anchor="middle" class="b"><tspan data-lang-en>Still no sharding.</tspan><tspan data-lang-vi>Vẫn chưa cần shard.</tspan></text>

      <DiagramIcon name="network" x={755} y={58} size={32} />
      <text x="755" y="104" text-anchor="middle" class="b"><tspan data-lang-en>3. Shard</tspan><tspan data-lang-vi>3. Chia shard</tspan></text>
      <text x="755" y="132" text-anchor="middle" class="s"><tspan data-lang-en>Writes or storage no longer</tspan><tspan data-lang-vi>Lệnh ghi hay dung lượng không</tspan></text>
      <text x="755" y="150" text-anchor="middle" class="s"><tspan data-lang-en>fit on one machine?</tspan><tspan data-lang-vi>còn vừa một máy?</tspan></text>
      <text x="755" y="176" text-anchor="middle" class="b"><tspan data-lang-en>Split the data.</tspan><tspan data-lang-vi>Xé nhỏ dữ liệu.</tspan></text>

      {arrows.map((a) => (<g><path d={a.line} class="arrow" /><polygon points={a.head} class="head" /></g>))}

      <rect x="20" y="232" width="860" height="50" rx="6" class="box is-hot" />
      <DiagramIcon name="warning" x={48} y={257} size={24} />
      <text x="78" y="262" class="s is-hot"><tspan data-lang-en>Once you shard: the partition key is hard to change, joins cross the network, multi-shard transactions slow down.</tspan><tspan data-lang-vi>Khi đã chia shard: khó đổi partition key, JOIN phải đi qua mạng, giao dịch nhiều shard chậm hẳn.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Move down the ladder only when the step above stops working. Each step costs more complexity than the last.</span>
    <span data-lang-vi>Chỉ xuống bậc tiếp theo khi bậc trên hết tác dụng. Mỗi bậc tốn thêm độ phức tạp so với bậc trước.</span>
  </figcaption>
</figure>

<style>
  .shaa-wts { margin: 2em 0; width: 100%; }
  .shaa-wts-scroll { overflow-x: auto; }
  .shaa-wts svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shaa-wts text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shaa-wts .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shaa-wts .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shaa-wts .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shaa-wts .b.is-hot { fill: var(--red); }
  .shaa-wts .s { font-size: 12px; fill: var(--text-body); }
  .shaa-wts .s.is-hot { fill: var(--red); font-weight: 600; }
  .shaa-wts .big { font-size: 18px; font-weight: 700; fill: var(--text); }
  .shaa-wts .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shaa-wts .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shaa-wts .box.is-fix { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-wts .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shaa-wts .box.is-dim { opacity: 0.45; }
  .shaa-wts .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shaa-wts .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shaa-wts .arrow.is-hot { stroke: var(--red); }
  .shaa-wts .arrow.is-fix { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-wts .head { fill: var(--text-muted); }
  .shaa-wts .head.is-hot { fill: var(--red); }
  .shaa-wts .head.is-fix { fill: var(--gold-icon); }
  .shaa-wts figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
