---
// Where each test layer enters clue.api and what it swaps. Red = the service:
// the thing under test is the one box a test never fakes.
const W = 900, H = 340;
const boxes = [
  { y: 50, icon: 'fastapi', iconW: 56, iconH: 10.4, disc: false, name: { en: 'web', vi: 'web' } },
  { y: 150, icon: 'engine', iconW: 22, iconH: 22, disc: false, name: { en: 'service', vi: 'service' }, red: true },
  { y: 250, icon: 'database', iconW: 22, iconH: 22, disc: true, name: { en: 'data', vi: 'data' } },
];
const enters = [
  { y: 66, en: 'end to end: real HTTP', vi: 'end to end: HTTP thật' },
  { y: 90, en: 'API: TestClient, in-process', vi: 'API: TestClient, chạy trong process' },
  { y: 180, en: 'unit: a plain call', vi: 'unit: gọi hàm trực tiếp' },
];
const swaps = [
  { y: 79, code: 'dependency_overrides[get_current_user]', en: 'swap the guard', vi: 'thay lớp bảo vệ' },
  { y: 179, code: '', en: 'never swapped: this is what is under test', vi: 'không bao giờ thay: đây là thứ đang được test', red: true },
  { y: 279, code: 'FakeCaseRepository / SQLite file', en: 'swap the storage', vi: 'thay tầng lưu trữ' },
];
---
<figure class="bep9b">
  <div class="bep9b-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The three layers web, service, data in a column. From the left, end to end and API tests enter at web and unit tests enter at service. On the right, the guard at web can be swapped through dependency_overrides, the storage at data can be swapped for a fake or a SQLite file, and the service is never swapped.">
    <text x="115" y="28" text-anchor="middle" class="h">
      <tspan data-lang-en>where a test enters</tspan><tspan data-lang-vi>test đi vào từ đâu</tspan>
    </text>
    <text x="760" y="28" text-anchor="middle" class="h">
      <tspan data-lang-en>what it swaps</tspan><tspan data-lang-vi>nó thay cái gì</tspan>
    </text>
    {boxes.map((b) => (
      <g>
        <rect x="330" y={b.y} width="240" height="58" rx="10" class={b.red ? 'box redbox' : 'box'} />
        {b.disc && <circle cx="372" cy={b.y + 29} r="15" class="disc" />}
        <image href={`/icons/flow/${b.icon}.svg`} x={372 - b.iconW / 2} y={b.y + 29 - b.iconH / 2} width={b.iconW} height={b.iconH} aria-hidden="true" />
        <text x="418" y={b.y + 34} class="nm">
          <tspan data-lang-en>{b.name.en}</tspan><tspan data-lang-vi>{b.name.vi}</tspan>
        </text>
      </g>
    ))}
    {enters.map((e) => (
      <g>
        <text x="20" y={e.y - 6} class="bs">
          <tspan data-lang-en>{e.en}</tspan><tspan data-lang-vi>{e.vi}</tspan>
        </text>
        <line x1="20" y1={e.y} x2="316" y2={e.y} class="ln" />
        <polygon points={`328,${e.y} 316,${e.y - 5} 316,${e.y + 5}`} class="hd" />
      </g>
    ))}
    {swaps.map((s) => (
      <g>
        <line x1="572" y1={s.y} x2="600" y2={s.y} class={s.red ? 'sw red' : 'sw'} />
        {s.code && <text x="610" y={s.y - 4} class="code">{s.code}</text>}
        <text x="610" y={s.code ? s.y + 16 : s.y + 4} class={s.red ? 'bs redt' : 'bs'}>
          <tspan data-lang-en>{s.en}</tspan><tspan data-lang-vi>{s.vi}</tspan>
        </text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The layering from post 4 hands every test a place to enter and a place to swap. Whatever you swap is something you chose not to test here; the service is the one box that is never on that list.</span>
    <span data-lang-vi>Cách chia tầng từ bài 4 cho mỗi loại test một chỗ để đi vào và một chỗ để thay. Thứ gì bạn thay là thứ bạn chọn không test ở đây; service là ô duy nhất không bao giờ nằm trong danh sách đó.</span>
  </figcaption>
</figure>

<style>
  .bep9b { margin: 2em 0; width: 100%; }
  .bep9b-scroll { overflow-x: auto; }
  .bep9b svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .bep9b text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep9b .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep9b .nm { font-weight: 700; fill: var(--text); font-size: 16px; }
  .bep9b .bs { fill: var(--text-muted); font-size: 13px; }
  .bep9b .redt { fill: var(--red); font-weight: 700; }
  .bep9b .code { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12.5px; fill: var(--text); }
  .bep9b .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep9b .redbox { stroke: var(--red); stroke-width: 2.2; }
  .bep9b .ln { stroke: var(--text-muted); stroke-width: 1.6; }
  .bep9b .hd { fill: var(--text-muted); }
  .bep9b .sw { stroke: var(--text-muted); stroke-width: 1.6; stroke-dasharray: 4 3; }
  .bep9b .sw.red { stroke: var(--red); }
  .bep9b .disc { fill: none; }
  :global([data-theme='dark']) .bep9b .disc { fill: rgba(255, 255, 255, 0.88); }
  .bep9b figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
