---
// Notion's path: one Postgres, then 480 logical shards on 32 hosts, then the same
// 480 shards on 96 hosts. Facts are the ones stated in the post text. Inline SVG, site tokens.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const A = (x1: number, y1: number, x2: number, y2: number, c = '') => {
  const a = arrow(x1, y1, x2, y2);
  return { ...a, c };
};

const W = 900;
const H = 230;
const xs = [20, 248, 476, 704];
const arrows = [0, 1, 2].map((i) => A(xs[i] + 188, 110, xs[i + 1], 110));
---
<figure class="shaa-nt">
  <div class="shaa-nt-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Notion timeline. Before 2021: one Postgres database on Amazon RDS, where VACUUM falls behind and transaction ID wraparound looms. 2021: sharded by workspace into 480 logical shards on 32 Postgres hosts. Late 2022: hosts run hot, peak CPU over 90 percent. 2023: the same 480 shards move to 96 hosts with no downtime.">
      <rect x={xs[0]} y="20" width="188" height="190" rx="6" class="box is-hot" />
      <text x={xs[0] + 94} y="44" text-anchor="middle" class="h"><tspan data-lang-en>Before 2021</tspan><tspan data-lang-vi>Trước 2021</tspan></text>
      <DiagramIcon name="postgres" x={xs[0] + 94} y={86} size={30} />
      <text x={xs[0] + 94} y="134" text-anchor="middle" class="b is-hot"><tspan data-lang-en>One Postgres on RDS</tspan><tspan data-lang-vi>Một Postgres trên RDS</tspan></text>
      <text x={xs[0] + 94} y="158" text-anchor="middle" class="s"><tspan data-lang-en>VACUUM falls behind</tspan><tspan data-lang-vi>VACUUM chạy không kịp</tspan></text>
      <text x={xs[0] + 94} y="176" text-anchor="middle" class="s"><tspan data-lang-en>TXID wraparound looms</tspan><tspan data-lang-vi>nguy cơ tràn TXID</tspan></text>

      <rect x={xs[1]} y="20" width="188" height="190" rx="6" class="box is-fix" />
      <text x={xs[1] + 94} y="44" text-anchor="middle" class="h">2021</text>
      <DiagramIcon name="postgres" x={xs[1] + 94} y={86} size={30} />
      <text x={xs[1] + 94} y="134" text-anchor="middle" class="b"><tspan data-lang-en>Shard by workspace</tspan><tspan data-lang-vi>Chia shard theo workspace</tspan></text>
      <text x={xs[1] + 94} y="158" text-anchor="middle" class="s"><tspan data-lang-en>480 logical shards</tspan><tspan data-lang-vi>480 shard logic</tspan></text>
      <text x={xs[1] + 94} y="176" text-anchor="middle" class="s"><tspan data-lang-en>on 32 Postgres hosts</tspan><tspan data-lang-vi>trên 32 máy Postgres</tspan></text>

      <rect x={xs[2]} y="20" width="188" height="190" rx="6" class="box is-hot" />
      <text x={xs[2] + 94} y="44" text-anchor="middle" class="h"><tspan data-lang-en>Late 2022</tspan><tspan data-lang-vi>Cuối 2022</tspan></text>
      <DiagramIcon name="warning" x={xs[2] + 94} y={86} size={30} />
      <text x={xs[2] + 94} y="134" text-anchor="middle" class="b is-hot"><tspan data-lang-en>Hosts run hot</tspan><tspan data-lang-vi>Các máy chạy nóng</tspan></text>
      <text x={xs[2] + 94} y="158" text-anchor="middle" class="s"><tspan data-lang-en>peak CPU over 90%</tspan><tspan data-lang-vi>CPU đỉnh vượt 90%</tspan></text>
      <text x={xs[2] + 94} y="176" text-anchor="middle" class="s"><tspan data-lang-en>on the 32 hosts</tspan><tspan data-lang-vi>trên 32 máy</tspan></text>

      <rect x={xs[3]} y="20" width="188" height="190" rx="6" class="box is-fix" />
      <text x={xs[3] + 94} y="44" text-anchor="middle" class="h">2023</text>
      <DiagramIcon name="postgres" x={xs[3] + 94} y={86} size={30} />
      <text x={xs[3] + 94} y="134" text-anchor="middle" class="b"><tspan data-lang-en>Re-shard, no downtime</tspan><tspan data-lang-vi>Re-shard, không downtime</tspan></text>
      <text x={xs[3] + 94} y="158" text-anchor="middle" class="s"><tspan data-lang-en>same 480 shards</tspan><tspan data-lang-vi>480 shard cũ</tspan></text>
      <text x={xs[3] + 94} y="176" text-anchor="middle" class="s"><tspan data-lang-en>moved to 96 hosts</tspan><tspan data-lang-vi>dời lên 96 máy</tspan></text>

      {arrows.map((a) => (<g><path d={a.line} class="arrow" /><polygon points={a.head} class="head" /></g>))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Notion hit the wall twice. Splitting into many logical shards from the start meant the second fix only moved whole shards onto new hosts.</span>
    <span data-lang-vi>Notion đụng tường hai lần. Nhờ chia sẵn nhiều shard logic, lần sửa thứ hai chỉ cần dời nguyên các shard sang máy mới.</span>
  </figcaption>
</figure>

<style>
  .shaa-nt { margin: 2em 0; width: 100%; }
  .shaa-nt-scroll { overflow-x: auto; }
  .shaa-nt svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shaa-nt text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shaa-nt .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shaa-nt .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shaa-nt .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shaa-nt .b.is-hot { fill: var(--red); }
  .shaa-nt .s { font-size: 12px; fill: var(--text-body); }
  .shaa-nt .s.is-hot { fill: var(--red); font-weight: 600; }
  .shaa-nt .big { font-size: 18px; font-weight: 700; fill: var(--text); }
  .shaa-nt .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shaa-nt .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shaa-nt .box.is-fix { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-nt .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shaa-nt .box.is-dim { opacity: 0.45; }
  .shaa-nt .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shaa-nt .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shaa-nt .arrow.is-hot { stroke: var(--red); }
  .shaa-nt .arrow.is-fix { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-nt .head { fill: var(--text-muted); }
  .shaa-nt .head.is-hot { fill: var(--red); }
  .shaa-nt .head.is-fix { fill: var(--gold-icon); }
  .shaa-nt figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
