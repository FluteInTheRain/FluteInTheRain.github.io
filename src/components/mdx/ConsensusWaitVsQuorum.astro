---
// Why a "lowest ticket wins" scheme needs consensus: waiting for every node freezes on one dead peer,
// while a majority quorum decides as soon as 2 of 3 nodes answer. Static SVG, site tokens only.
import DiagramIcon from './DiagramIcon.astro';
interface Props { lang: 'en' | 'vi' }
const { lang } = Astro.props;

const T = {
  en: {
    aria: 'Two panels with three nodes each. Left: node A waits for answers from every node; node C is silent, so A cannot tell whether C is dead or slow and the whole cluster freezes. Right: node A needs only a majority, 2 of 3; B answers, the decision is made, and C catches up later.',
    lTitle: 'Wait for every node',
    lSub: 'One silent peer blocks everybody.',
    rTitle: 'Wait for a majority (2 of 3)',
    rSub: 'The decision survives one dead or slow peer.',
    asks: 'asks everyone',
    ack: 'answers',
    none: 'no answer',
    skip: 'not awaited',
    cap: 'Waiting for every node stalls on one silent peer; a majority decides with one node missing.',
    bSub: 'alive',
    cSubL: 'dead or slow?',
    cSubR: 'not needed',
    lRes: ['Cannot decide: C might still hold a', 'lower ticket, so A waits forever.'],
    rRes: ['A and B form a majority and decide.', 'C reads the decision when it returns.'],
  },
  vi: {
    aria: 'Hai khung, mỗi khung ba node. Trái: node A chờ trả lời từ mọi node; node C im lặng nên A không biết C chết hay chỉ chậm, cả cụm bị đứng. Phải: node A chỉ cần đa số, 2 trên 3; B trả lời là chốt được quyết định, C bắt kịp sau.',
    lTitle: 'Chờ mọi node trả lời',
    lSub: 'Một node im lặng chặn cả cụm.',
    rTitle: 'Chờ đa số (2 trên 3)',
    rSub: 'Quyết định sống sót qua một node chết hoặc chậm.',
    asks: 'hỏi tất cả',
    ack: 'trả lời',
    none: 'không trả lời',
    skip: 'không chờ',
    cap: 'Chờ mọi node thì kẹt vì một node im lặng; đa số thì vẫn chốt được khi thiếu một node.',
    bSub: 'còn sống',
    cSubL: 'chết hay chậm?',
    cSubR: 'không cần chờ',
    lRes: ['Không chốt được: C có thể vẫn giữ', 'vé nhỏ hơn nên A chờ mãi.'],
    rRes: ['A và B đủ đa số nên chốt luôn.', 'C đọc lại quyết định khi quay lại.'],
  },
}[lang];

const W = 900;
const H = 330;

function head(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const l = 8;
  const p1 = [x2 - l * Math.cos(a - 0.45), y2 - l * Math.sin(a - 0.45)];
  const p2 = [x2 - l * Math.cos(a + 0.45), y2 - l * Math.sin(a + 0.45)];
  return `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
}

const panels = [
  { ox: 20, title: T.lTitle, sub: T.lSub, cSub: T.cSubL, res: T.lRes, bad: true },
  { ox: 470, title: T.rTitle, sub: T.rSub, cSub: T.cSubR, res: T.rRes, bad: false },
];
const nw = 130;
const nh = 54;
---
<figure class="cwq">
  <div class="cwq-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={T.aria}>
      <line x1="450" x2="450" y1="14" y2={H - 14} class="cwq-rule" />
      {panels.map((p) => {
        const ax = p.ox + 140, ay = 82;       // node A top-left
        const bx = p.ox + 20, by = 186;       // node B
        const cx = p.ox + 260, cy = 186;      // node C
        const aBot = [ax + nw / 2, ay + nh];
        const bTop = [bx + nw / 2, by];
        const cTop = [cx + nw / 2, cy];
        return (
          <g>
            <text x={p.ox} y="26" class="cwq-h">{p.title}</text>
            <text x={p.ox} y="46" class="cwq-sub">{p.sub}</text>

            <path d={`M ${aBot[0]} ${aBot[1]} L ${bTop[0]} ${bTop[1] - 6}`} class="cwq-arrow" />
            <polygon points={head(aBot[0], aBot[1], bTop[0], bTop[1])} class="cwq-head" />
            <path d={`M ${aBot[0]} ${aBot[1]} L ${cTop[0]} ${cTop[1] - 6}`} class={`cwq-arrow ${p.bad ? 'is-bad' : 'is-soft'}`} />
            <polygon points={head(aBot[0], aBot[1], cTop[0], cTop[1])} class={`cwq-head ${p.bad ? 'is-bad' : 'is-soft'}`} />
            <text x={bTop[0] + 50} y="160" text-anchor="end" class="cwq-edge">{T.ack}</text>
            <text x={cTop[0] - 50} y="160" class={`cwq-edge ${p.bad ? 'is-bad' : 'is-muted'}`}>{p.bad ? T.none : T.skip}</text>

            <rect x={ax} y={ay} width={nw} height={nh} rx="6" class="cwq-node" />
            <DiagramIcon name="server" x={ax + 22} y={ay + nh / 2} size={22} />
            <text x={ax + nw / 2 + 14} y={ay + 24} text-anchor="middle" class="cwq-name">A</text>
            <text x={ax + nw / 2 + 14} y={ay + 42} text-anchor="middle" class="cwq-nsub">{T.asks}</text>

            <rect x={bx} y={by} width={nw} height={nh} rx="6" class="cwq-node" />
            <DiagramIcon name="server" x={bx + 22} y={by + nh / 2} size={22} />
            <text x={bx + nw / 2 + 14} y={by + 24} text-anchor="middle" class="cwq-name">B</text>
            <text x={bx + nw / 2 + 14} y={by + 42} text-anchor="middle" class="cwq-nsub">{T.bSub}</text>

            <rect x={cx} y={cy} width={nw} height={nh} rx="6" class={`cwq-node ${p.bad ? 'is-dead' : 'is-muted'}`} />
            <DiagramIcon name="server" x={cx + 22} y={cy + nh / 2} size={22} />
            <text x={cx + nw / 2 + 14} y={cy + 24} text-anchor="middle" class="cwq-name">C</text>
            <text x={cx + nw / 2 + 14} y={cy + 42} text-anchor="middle" class={`cwq-nsub ${p.bad ? 'is-red' : ''}`}>{p.cSub}</text>

            <rect x={p.ox + 10} y="262" width="400" height="50" rx="6" class={`cwq-res ${p.bad ? 'is-bad' : 'is-ok'}`} />
            <text x={p.ox + 210} y="283" text-anchor="middle" class="cwq-restxt">{p.res[0]}</text>
            <text x={p.ox + 210} y="301" text-anchor="middle" class="cwq-restxt">{p.res[1]}</text>
          </g>
        );
      })}
    </svg>
  </div>
  <figcaption>{T.cap}</figcaption>
</figure>
<style>
  .cwq { margin: 2em 0; width: 100%; }
  .cwq-scroll { overflow-x: auto; }
  .cwq svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .cwq text { font-size: 14px; fill: var(--text-body); }
  .cwq .cwq-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .cwq .cwq-sub { font-size: 12.5px; fill: var(--text-muted); }
  .cwq-rule { stroke: var(--border); }
  .cwq-node { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .cwq-node.is-dead { fill: var(--red-tint-bg); stroke: var(--red); stroke-dasharray: 4 3; }
  .cwq-node.is-muted { opacity: 0.6; stroke-dasharray: 4 3; }
  .cwq .cwq-name { font-size: 14px; font-weight: 700; fill: var(--text); }
  .cwq .cwq-nsub { font-size: 12px; fill: var(--text-muted); }
  .cwq .cwq-nsub.is-red { fill: var(--red); font-weight: 600; }
  .cwq .cwq-edge { font-size: 12px; font-weight: 600; fill: var(--text); }
  .cwq .cwq-edge.is-bad { fill: var(--red); }
  .cwq .cwq-edge.is-muted { fill: var(--text-muted); font-weight: 500; }
  .cwq-arrow { fill: none; stroke: var(--text); stroke-width: 1.5; }
  .cwq-head { fill: var(--text); }
  .cwq-arrow.is-bad { stroke: var(--red); stroke-dasharray: 4 3; }
  .cwq-head.is-bad { fill: var(--red); }
  .cwq-arrow.is-soft { stroke: var(--text-muted); stroke-dasharray: 4 3; }
  .cwq-head.is-soft { fill: var(--text-muted); }
  .cwq-res { fill: var(--bg-alt); stroke-width: 1.5; }
  .cwq-res.is-bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .cwq-res.is-ok { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .cwq .cwq-restxt { font-size: 13px; font-weight: 600; fill: var(--text); }
  .cwq figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
