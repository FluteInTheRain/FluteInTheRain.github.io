---
// The four real cases the post is built on, one card each: what went wrong, what the team did.
// All facts come from the post's own text (Hex, Prime Video, 37signals, Spotify write-ups).
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 352;
const cardW = 200;
const gap = 20;
const top = 16;
const cardH = 322;

const cards = [
  {
    icon: 'postgres', name: 'Hex', year: 'November 2022', yearVi: 'Tháng 11/2022',
    badEn: ['Sync job failed silently;', 'unread WAL filled the disk.', 'App down 2 h 40 min.'],
    badVi: ['Job đồng bộ lỗi âm thầm,', 'WAL chưa đọc làm đầy đĩa.', 'App sập 2 giờ 40 phút.'],
    fixEn: ['Alerts back on, and a cap', 'on how much WAL is kept.'],
    fixVi: ['Bật lại cảnh báo, đặt trần', 'cho lượng WAL được giữ.'],
    tagEn: '2. Truth or copy', tagVi: '2. Bản gốc hay bản sao',
  },
  {
    icon: 'lambda', name: 'Amazon Prime Video', year: '2023', yearVi: '2023',
    badEn: ['Serverless design hit a', 'hard limit at about 5%', 'of the expected load.'],
    badVi: ['Thiết kế serverless đụng', 'giới hạn cứng ở khoảng 5%', 'tải dự kiến.'],
    fixEn: ['One process on ECS and EC2.', 'Infra cost down over 90%.'],
    fixVi: ['Gom về một process, chi phí', 'hạ tầng giảm hơn 90%.'],
    tagEn: '4. One machine or many', tagVi: '4. Một máy hay nhiều máy',
  },
  {
    icon: 'server', name: '37signals', year: '2023 and 2024', yearVi: '2023 và 2024',
    badEn: ['Steady load, yet a $3.2M', 'a year cloud bill.'],
    badVi: ['Tải đều mà hóa đơn cloud', 'vẫn 3,2 triệu USD mỗi năm.'],
    fixEn: ['Bought about $700,000 of', 'Dell servers. Bill now', '$1.3M a year.'],
    fixVi: ['Mua khoảng 700.000 USD', 'máy chủ Dell. Hóa đơn còn', '1,3 triệu USD mỗi năm.'],
    tagEn: '3. Rent or own', tagVi: '3. Thuê hay tự sở hữu',
  },
  {
    icon: 'key', name: 'Spotify', year: '2018', yearVi: '2018',
    badEn: ['Over 1,000 microservices.', 'Asking each to delete a', 'user was "not viable".'],
    badVi: ['Hơn 1.000 microservice.', 'Bắt từng cái xóa dữ liệu', 'user là "không khả thi".'],
    fixEn: ['Store personal data', 'encrypted, then delete the', "user's keys."],
    fixVi: ['Lưu dữ liệu cá nhân đã mã', 'hóa, rồi xóa khóa của', 'user.'],
    tagEn: '5. Data about people', tagVi: '5. Dữ liệu về con người',
  },
];
---
<figure class="tofc">
  <div class="tofc-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four cards. Hex 2022: a silently failing sync job let unread write-ahead log fill the disk; app down 2 hours 40 minutes. Prime Video 2023: serverless design hit a limit at about 5% of expected load; one process cut infrastructure cost over 90%. 37signals: a 3.2 million dollar yearly cloud bill fell to 1.3 million after buying about 700,000 dollars of servers. Spotify 2018: deletion across over a thousand microservices was not viable, so they deleted per-user encryption keys.">
    {cards.map((c, i) => {
      const x = 20 + i * (cardW + gap);
      const cx = x + cardW / 2;
      return (
        <g>
          <rect x={x} y={top} width={cardW} height={cardH} rx="10" class="tofc-card" />
          <DiagramIcon name={c.icon as any} x={cx} y={top + 36} size={32} />
          <text x={cx} y={top + 84} text-anchor="middle" class="tofc-name">{c.name}</text>
          <text x={cx} y={top + 102} text-anchor="middle" class="tofc-small"><tspan data-lang-en>{c.year}</tspan><tspan data-lang-vi>{c.yearVi}</tspan></text>

          <text x={x + 12} y={top + 134} class="tofc-bad"><tspan data-lang-en>What went wrong</tspan><tspan data-lang-vi>Chuyện gì xảy ra</tspan></text>
          {c.badEn.map((l, k) => (
            <text x={x + 12} y={top + 154 + k * 16} class="tofc-line"><tspan data-lang-en>{l}</tspan><tspan data-lang-vi>{c.badVi[k]}</tspan></text>
          ))}

          <text x={x + 12} y={top + 220} class="tofc-good"><tspan data-lang-en>What they did</tspan><tspan data-lang-vi>Họ đã làm gì</tspan></text>
          {c.fixEn.map((l, k) => (
            <text x={x + 12} y={top + 240 + k * 16} class="tofc-line"><tspan data-lang-en>{l}</tspan><tspan data-lang-vi>{c.fixVi[k]}</tspan></text>
          ))}

          <line x1={x + 12} x2={x + cardW - 12} y1={top + 288} y2={top + 288} class="tofc-rule" />
          <text x={cx} y={top + 308} text-anchor="middle" class="tofc-tag"><tspan data-lang-en>{c.tagEn}</tspan><tspan data-lang-vi>{c.tagVi}</tspan></text>
        </g>
      );
    })}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Four real cases, each with the problem in red and the fix in gold. The last line of each card says which trade-off below it belongs to.</span>
    <span data-lang-vi>Bốn vụ thật, mỗi vụ có vấn đề màu đỏ và cách xử lý màu vàng. Dòng cuối mỗi thẻ cho biết vụ đó thuộc sự đánh đổi nào ở dưới.</span>
  </figcaption>
</figure>

<style>
  .tofc { margin: 2em 0; width: 100%; }
  .tofc-scroll { overflow-x: auto; }
  .tofc svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .tofc text { font-size: 12.5px; fill: var(--text-body); }
  .tofc .tofc-name { font-size: 15px; font-weight: 700; fill: var(--text); }
  .tofc .tofc-small { font-size: 12.5px; fill: var(--text-muted); }
  .tofc .tofc-bad { font-weight: 700; fill: var(--red); }
  .tofc .tofc-good { font-weight: 700; fill: var(--gold-icon); }
  .tofc .tofc-tag { font-weight: 700; fill: var(--text); }
  .tofc-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .tofc-rule { stroke: var(--border); }
  .tofc figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
