---
import BatchDiagram from './BatchDiagram.astro';
const boxes = [{"x": 20, "y": 46, "w": 190, "h": 64, "t": ["App server", "App server"], "s": [["writes in place", "ghi đè tại chỗ"]], "icon": "server"}, {"x": 250, "y": 46, "w": 190, "h": 64, "t": ["Live database", "Database sống"], "s": [["prices overwritten", "giá bị ghi đè"]], "icon": "db"}, {"x": 480, "y": 46, "w": 190, "h": 64, "t": ["Wrong prices", "Giá sai"], "s": [["for ten minutes", "suốt mười phút"]], "icon": "warning", "kind": "hot"}, {"x": 710, "y": 46, "w": 170, "h": 64, "t": ["Roll back", "Rollback"], "s": [["bad rows stay", "dòng hỏng còn"]], "icon": "retry", "kind": "hot"}, {"x": 20, "y": 230, "w": 190, "h": 64, "t": ["Input files", "File đầu vào"], "s": [["read-only", "chỉ đọc"]], "icon": "file"}, {"x": 250, "y": 230, "w": 190, "h": 64, "t": ["Batch job", "Job batch"], "s": [["buggy version", "bản có lỗi"]], "icon": "worker"}, {"x": 480, "y": 230, "w": 190, "h": 64, "t": ["New output", "Đầu ra mới"], "s": [["wrong, kept apart", "sai, nằm riêng"]], "icon": "package", "kind": "hot"}, {"x": 710, "y": 230, "w": 170, "h": 64, "t": ["Yesterday's", "Bản chụp"], "s": [["snapshot, in use", "đang dùng"]], "icon": "backup", "kind": "good"}];
const arrows = [{"x1": 210, "y1": 78, "x2": 250, "y2": 78}, {"x1": 440, "y1": 78, "x2": 480, "y2": 78, "kind": "hot"}, {"x1": 670, "y1": 78, "x2": 710, "y2": 78, "kind": "hot"}, {"x1": 210, "y1": 262, "x2": 250, "y2": 262}, {"x1": 440, "y1": 262, "x2": 480, "y2": 262, "kind": "hot"}];
const texts = [{"x": 20, "y": 26, "cls": "h", "t": ["Online service: writes in place", "Dịch vụ online: ghi đè tại chỗ"]}, {"x": 20, "y": 150, "cls": "warn", "t": ["Fixing the code does not fix the rows already written.", "Sửa code không sửa được các dòng đã ghi."]}, {"x": 20, "y": 210, "cls": "h", "t": ["Batch job: reads one place, writes another", "Job batch: đọc một nơi, ghi nơi khác"]}, {"x": 20, "y": 330, "cls": "ok", "t": ["Fix the code, rerun on the same input, publish a clean output.", "Sửa code, chạy lại trên cùng đầu vào, công bố đầu ra sạch."]}, {"x": 20, "y": 352, "cls": "foot", "t": ["Nothing was overwritten, so a rerun costs time, not data.", "Không có gì bị ghi đè, nên chạy lại chỉ tốn thời gian, không mất dữ liệu."]}];
---
<BatchDiagram
  w={900} h={375}
  aria="Top row: an online service overwrites a live database, a bug writes wrong prices for ten minutes, and rolling back the code leaves bad rows. Bottom row: a batch job reads read-only input and writes a new output; the bad output is replaced after a fix and readers use yesterday's snapshot meanwhile."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any} rules={[180]} icons={[]}
  caption={["Human fault tolerance in one picture: the batch job never touches its input, so a bug is a cheap rerun.", "Khả năng chịu lỗi do con người trong một hình: job batch không đụng vào đầu vào, nên lỗi chỉ là một lần chạy lại."]}
/>
