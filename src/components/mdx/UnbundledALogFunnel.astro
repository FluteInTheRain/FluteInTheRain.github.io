---
// One log fans out to every derived store, in the same order.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 330;
const heads = (x2: number, y: number) => `${x2 - 7},${y - 4} ${x2 - 7},${y + 4} ${x2},${y}`;
const stores = [
  { y: 44, icon: 'postgres', en: 'PostgreSQL', vi: 'PostgreSQL', sen: 'orders', svi: 'đơn hàng' },
  { y: 118, icon: 'elasticsearch', en: 'Elasticsearch', vi: 'Elasticsearch', sen: 'keyword search', svi: 'tìm kiếm từ khoá' },
  { y: 192, icon: 'redis', en: 'Redis', vi: 'Redis', sen: 'hot sessions', svi: 'phiên đăng nhập nóng' },
  { y: 266, icon: 'chart', en: 'Warehouse', vi: 'Data warehouse', sen: 'revenue reports', svi: 'báo cáo doanh thu' },
];
const cells = ['w1', 'w2', 'w3', 'w4'];
---
<figure class="ua-fig">
  <div class="ua-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Application writes go into one log with offsets 0 to 3; PostgreSQL, Elasticsearch, Redis and a warehouse each read that log in the same order.">
      <text x="20" y="24" class="ua-h"><tspan data-lang-en>Write once, derive everything</tspan><tspan data-lang-vi>Ghi một lần, suy xuất mọi thứ</tspan></text>
      <rect x="20" y="130" width="140" height="70" rx="4" class="ua-box" />
      <DiagramIcon name="server" x={52} y={165} size={30} />
      <text x="82" y="170" class="ua-b"><tspan data-lang-en>App writes</tspan><tspan data-lang-vi>App ghi</tspan></text>
      <path d="M160,165 L213,165" class="ua-solid is-good" />
      <polygon points={heads(220, 165)} class="ua-head is-good" />
      <rect x="220" y="92" width="290" height="146" rx="4" class="ua-box is-good" />
      <DiagramIcon name="log" x={252} y={120} size={28} />
      <text x="280" y="125" class="ua-b"><tspan data-lang-en>One log, one order</tspan><tspan data-lang-vi>Một log, một thứ tự</tspan></text>
      {cells.map((c, i) => (
        <>
          <rect x={240 + i * 62} y="146" width="54" height="34" rx="3" class="ua-box" />
          <text x={267 + i * 62} y="168" text-anchor="middle" class="ua-b">{c}</text>
          <text x={267 + i * 62} y="196" text-anchor="middle" class="ua-m">{`offset ${i}`}</text>
        </>
      ))}
      <text x="365" y="222" text-anchor="middle" class="ua-m"><tspan data-lang-en>every store reads this order</tspan><tspan data-lang-vi>mọi kho đọc đúng thứ tự này</tspan></text>
      {stores.map((s) => (
        <>
          <path d={`M510,165 L560,165 L560,${s.y + 26} L603,${s.y + 26}`} class="ua-solid is-good" />
          <polygon points={heads(610, s.y + 26)} class="ua-head is-good" />
          <rect x="610" y={s.y} width="270" height="52" rx="4" class="ua-box" />
          <DiagramIcon name={s.icon as any} x={642} y={s.y + 26} size={28} />
          <text x="674" y={s.y + 23} class="ua-b"><tspan data-lang-en>{s.en}</tspan><tspan data-lang-vi>{s.vi}</tspan></text>
          <text x="674" y={s.y + 41} class="ua-m"><tspan data-lang-en>{s.sen}</tspan><tspan data-lang-vi>{s.svi}</tspan></text>
        </>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Like the ledger and its summary sheets: every derived store replays the same entries in the same order.</span>
    <span data-lang-vi>Giống sổ cái và các bảng tổng hợp: mọi kho suy xuất đọc lại cùng các dòng theo cùng thứ tự.</span>
  </figcaption>
</figure>

<style>
  .ua-fig { margin: 2em 0; width: 100%; }
  .ua-scroll { overflow-x: auto; }
  .ua-fig svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .ua-fig text { font-size: 13px; fill: var(--text-body); }
  .ua-fig .ua-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-ph { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-b { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-m { font-size: 12.5px; fill: var(--text-muted); }
  .ua-fig .ua-n { font-size: 12.5px; font-weight: 700; fill: var(--text-muted); }
  .ua-fig .ua-n.is-hot, .ua-fig .ua-b.is-hot, .ua-fig .ua-m.is-hot { fill: var(--red); }
  .ua-fig .ua-n.is-good, .ua-fig .ua-b.is-good, .ua-fig .ua-m.is-good { fill: var(--gold-icon); }
  .ua-fig .ua-q { font-size: 20px; font-weight: 700; fill: var(--red); }
  .ua-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .ua-box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .ua-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .ua-panel { fill: none; stroke: var(--border); stroke-width: 1.2; }
  .ua-life { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .ua-solid { fill: none; stroke: var(--text-muted); stroke-width: 1.8; }
  .ua-dashed { fill: none; stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .ua-head { fill: var(--text-muted); }
  .ua-solid.is-hot, .ua-dashed.is-hot { stroke: var(--red); stroke-width: 1.9; }
  .ua-head.is-hot { fill: var(--red); }
  .ua-solid.is-good { stroke: var(--gold-icon); stroke-width: 2; }
  .ua-head.is-good { fill: var(--gold-icon); }
  .ua-fig figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
