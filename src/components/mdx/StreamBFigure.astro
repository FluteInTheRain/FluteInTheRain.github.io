---
// Shared frame for the StreamB* figures: figure + sideways-scroll wrapper + svg + caption.
// Global styles are namespaced under .sb so StreamBNode/StreamBArrow/StreamBNum can share them.
interface Props { w?: number; h: number; alt: string; cap: string }
const { w = 900, h, alt, cap } = Astro.props;
---
<figure class="sb">
  <div class="sb-scroll">
    <svg viewBox={`0 0 ${w} ${h}`} role="img" aria-label={alt}>
      <slot />
    </svg>
  </div>
  <figcaption>{cap}</figcaption>
</figure>

<style is:global>
  .sb { margin: 2em 0; width: 100%; }
  .sb .sb-scroll { overflow-x: auto; }
  .sb svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sb text { font-size: 14px; fill: var(--text-body); }
  .sb .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .sb .name { font-weight: 700; fill: var(--text); }
  .sb .sub { font-size: 13px; fill: var(--text-muted); font-variant-numeric: tabular-nums; }
  .sb .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; fill: var(--text); }
  .sb .bad-t { fill: var(--red); font-size: 13px; }
  .sb .box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .sb .box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .sb .box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.5; }
  .sb .box.dash rect { fill: none; stroke-dasharray: 4 4; }
  .sb .arr path, .sb .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .sb .arr polygon { fill: var(--text-muted); }
  .sb .arr.bad path, .sb .ln.bad { stroke: var(--red); }
  .sb .arr.bad polygon { fill: var(--red); }
  .sb .arr.good path, .sb .ln.good { stroke: var(--gold-icon); }
  .sb .arr.good polygon { fill: var(--gold-icon); }
  .sb .arr.dash path, .sb .ln.dash { stroke-dasharray: 5 4; }
  .sb .rule { stroke: var(--border); stroke-width: 1; }
  .sb .num circle { fill: var(--text); }
  .sb .num text { fill: var(--bg); font-size: 12px; font-weight: 700; }
  .sb .dot { fill: var(--text-muted); }
  .sb .dot.bad { fill: var(--red); }
  .sb .dot.good { fill: var(--gold-icon); }
  .sb .win { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.3; }
  .sb .strike { text-decoration: line-through; }
  .sb figcaption, figcaption { }
  .sb > figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
