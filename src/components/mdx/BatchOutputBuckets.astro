---
import BatchDiagram from './BatchDiagram.astro';
const boxes = [{"x": 20, "y": 126, "w": 200, "h": 64, "t": ["Batch job", "Job batch"], "s": [["bounded input, offline", "đầu vào hữu hạn, offline"]], "icon": "worker"}, {"x": 380, "y": 30, "w": 500, "h": 64, "t": ["1. ETL and lakehouse layers", "1. ETL và lớp lakehouse"], "s": [["cleaned, curated Iceberg tables", "bảng Iceberg đã làm sạch"]], "icon": "db"}, {"x": 380, "y": 114, "w": 500, "h": 64, "t": ["2. Analytics", "2. Phân tích"], "s": [["OLAP cubes (Pinot, Druid), DuckDB, Trino", "khối OLAP (Pinot, Druid), DuckDB, Trino"]], "icon": "chart"}, {"x": 380, "y": 198, "w": 500, "h": 64, "t": ["3. AI training and graphs", "3. Huấn luyện AI và đồ thị"], "s": [["LLM text prep on Ray, Pregel supersteps", "chuẩn bị text LLM trên Ray, Pregel"]], "icon": "model"}, {"x": 380, "y": 282, "w": 500, "h": 64, "t": ["4. Derived data for users", "4. Dữ liệu dẫn xuất cho người dùng"], "s": [["search indexes, recommendations, features", "chỉ mục tìm kiếm, gợi ý, feature"]], "icon": "search", "kind": "hot"}];
const arrows = [{"x1": 220, "y1": 158, "x2": 380, "y2": 62}, {"x1": 220, "y1": 158, "x2": 380, "y2": 146}, {"x1": 220, "y1": 158, "x2": 380, "y2": 230}, {"x1": 220, "y1": 158, "x2": 380, "y2": 314, "kind": "hot"}];
const texts = [{"x": 20, "y": 372, "cls": "warn", "t": ["Bucket 4 is where row-by-row writes into a live database hurt.", "Nhóm 4 là nơi ghi từng dòng vào database sống gây hại."]}];
---
<BatchDiagram
  w={900} h={380}
  aria="A batch job sends output to four kinds of destination: ETL and lakehouse tables, analytics systems, AI training and graph jobs, and derived data served to users. The fourth is where writing straight into an OLTP database goes wrong."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any} rules={[]} icons={[]}
  caption={["Where batch output ends up. Only the last bucket sits next to live users.", "Đầu ra của batch đi đâu. Chỉ nhóm cuối nằm sát người dùng thật."]}
/>
