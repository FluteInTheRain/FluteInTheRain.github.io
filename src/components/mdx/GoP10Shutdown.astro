---
// Shutdown timeline: signal at t=0, running request finishes (illustrative 3 s), 10 s cap from run().
// Icons: DiagramIcon (signal = SIGTERM, timer = 10 s cap, server = listener, web = running request, hourglass = Server.Shutdown waiting). Motion: fm-pulse on the red 10 s cap line.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const x0 = 250;
const sc = 50;
const X = (s: number) => x0 + s * sc;
const xb = 200; // start of "before the signal" area
const top = 74;
const rowH = 64;
const axisY = top + 3 * rowH + 6;
const H = axisY + 54;
const done = 3;
---
<figure class="gp10s">
  <div class="gp10s-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Timeline after SIGTERM: the listener stops accepting at once, Server.Shutdown waits for the running request to finish, and a 10 second cap ends the wait with an error.">
    <text x="20" y="24" class="h">
      <tspan data-lang-en>What happens after the signal</tspan>
      <tspan data-lang-vi>Điều xảy ra sau khi có tín hiệu</tspan>
    </text>
    <text x={X(0) - 8} y="50" text-anchor="end" class="b">
      <tspan data-lang-en>SIGTERM or Ctrl+C: ctx.Done()</tspan>
      <tspan data-lang-vi>SIGTERM hoặc Ctrl+C: ctx.Done()</tspan>
    </text>
    <text x={X(10) - 8} y="50" text-anchor="end" class="r">
      <tspan data-lang-en>10 s cap</tspan>
      <tspan data-lang-vi>Mức trần 10 giây</tspan>
    </text>
    <DiagramIcon name="signal" x={X(0) + 16} y={44} size={24} />
    <DiagramIcon name="timer" x={X(10) + 16} y={44} size={24} />
    <line x1={X(0)} x2={X(0)} y1="58" y2={axisY} class="grid" style="stroke: var(--text-muted)" />
    <line x1={X(10)} x2={X(10)} y1="58" y2={axisY} class="redline fm-pulse" />

    {[0, 2, 4, 6, 8, 10].map((s) => (
      <text x={X(s)} y={axisY + 20} text-anchor="middle" class="m num">{s}</text>
    ))}

    <DiagramIcon name="server" x={32} y={top + 29} size={26} />
    <text x="54" y={top + 34} class="b">Listener</text>
    <rect x={xb} y={top + 20} width={X(0) - xb} height="20" rx="3" class="bar" />
    <rect x={X(0)} y={top + 20} width={X(10) - X(0)} height="20" rx="3" class="own" />
    <text x={X(0) + 10} y={top + 35} class="m"><tspan data-lang-en>closed: new connections are refused</tspan><tspan data-lang-vi>đã đóng: connection mới bị từ chối</tspan></text>

    <DiagramIcon name="web" x={32} y={top + rowH + 29} size={26} />
    <text x="54" y={top + rowH + 34} class="b"><tspan data-lang-en>Running request</tspan><tspan data-lang-vi>Request đang chạy</tspan></text>
    <rect x={xb} y={top + rowH + 20} width={X(done) - xb} height="20" rx="3" class="bar" />
    <text x={X(done) + 10} y={top + rowH + 35} class="m"><tspan data-lang-en>finishes at 3 s</tspan><tspan data-lang-vi>xong ở giây thứ 3</tspan></text>

    <DiagramIcon name="hourglass" x={32} y={top + 2 * rowH + 29} size={26} />
    <text x="54" y={top + 2 * rowH + 34} class="b">Server.Shutdown</text>
    <rect x={X(0)} y={top + 2 * rowH + 20} width={X(done) - X(0)} height="20" rx="3" class="limit" />
    <text x={X(done) + 10} y={top + 2 * rowH + 35} class="m"><tspan data-lang-en>waits, then returns nil and the process exits</tspan><tspan data-lang-vi>chờ xong, trả về nil rồi tiến trình thoát</tspan></text>

    <text x={X(0)} y={axisY + 44} class="m">
      <tspan data-lang-en>Seconds after the signal</tspan>
      <tspan data-lang-vi>Số giây sau khi có tín hiệu</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Shutdown stops the listener first, then waits only for requests already running. The 10 s cap is the <code>context.WithTimeout</code> in <code>run</code>: if a request is still going at that point, <code>Shutdown</code> returns an error instead of waiting longer. Say the running request finishes at 3 s.</span>
    <span data-lang-vi>Shutdown đóng listener trước, rồi chỉ chờ các request đang chạy. Mức trần 10 giây là <code>context.WithTimeout</code> trong <code>run</code>: nếu lúc đó request vẫn chưa xong, <code>Shutdown</code> trả về lỗi thay vì chờ thêm. Giả sử request đang chạy xong ở giây thứ 3.</span>
  </figcaption>
</figure>

<style>
  .gp10s { margin: 2em 0; width: 100%; }
  .gp10s-scroll { overflow-x: auto; }
  .gp10s svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp10s text { font-size: 14px; fill: var(--text-body); }
  .gp10s .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp10s .b { font-weight: 700; fill: var(--text); }
  .gp10s .m { fill: var(--text-muted); }
  .gp10s .r { fill: var(--red); font-weight: 700; }
  .gp10s .num { font-variant-numeric: tabular-nums; }
  .gp10s .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp10s .own { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp10s .bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
  .gp10s .bar { fill: var(--text-muted); }
  .gp10s .limit { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp10s .grid { stroke: var(--border); stroke-width: 1; }
  .gp10s .redline { stroke: var(--red); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .gp10s .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp10s .ln.dash { stroke-dasharray: 3 4; }
  .gp10s .ln.red { stroke: var(--red); }
  .gp10s .hd { fill: var(--text-muted); }
  .gp10s .hd.red { fill: var(--red); }
  .gp10s figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
