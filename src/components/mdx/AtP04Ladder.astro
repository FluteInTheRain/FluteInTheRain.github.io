---
import DiagramIcon from './DiagramIcon.astro';
// From a column of daily returns to a p-value. Worked numbers: a strategy with annual Sharpe 1.0 over 5 years:
// t = 1.0 x sqrt(5) = 2.236; two-sided p = 0.0254 (scipy). All steps assume roughly independent daily returns.
const steps = [
  { icon: 'chart', en: 'Daily returns', vi: 'Lợi suất ngày', en2: '1,260 numbers', vi2: '1.260 con số' },
  { icon: 'measure', en: 'Sharpe ratio', vi: 'Sharpe ratio', en2: 'mean ÷ spread × √252', vi2: 'trung bình ÷ độ lệch × √252' },
  { icon: 'scale', en: 't-statistic', vi: 't-statistic', en2: 'Sharpe × √years', vi2: 'Sharpe × √số năm' },
  { icon: 'question', en: 'p-value', vi: 'p-value', en2: 'chance of this by luck', vi2: 'xác suất có kết quả này do may' },
];
const ex = [
  { en: 'Sharpe 1.0, 5 years', vi: 'Sharpe 1,0 trong 5 năm' },
  { en: '1.0', vi: '1,0' },
  { en: '1.0 × √5 = 2.24', vi: '1,0 × √5 = 2,24' },
  { en: '0.025', vi: '0,025' },
];
const W = 900, BX = 20, BW = 190, GAP = 40;
---
<figure class="aplad">
  <div class="aplad-scroll">
  <svg viewBox="0 0 900 250" role="img" aria-label="Four boxes joined by arrows: daily returns, Sharpe ratio, t-statistic, p-value. Below them, a worked example: a strategy with Sharpe 1.0 over 5 years has t equal to 1.0 times the square root of 5, which is 2.24, and a p-value of 0.025.">
    <text x="20" y="26" class="aplad-h">
      <tspan data-lang-en>Four steps from a return series to "could this be luck?"</tspan>
      <tspan data-lang-vi>Bốn bước từ chuỗi lợi suất tới câu hỏi "có thể là may không?"</tspan>
    </text>
    {steps.map((s, i) => (
      <g>
        <rect x={BX + i * (BW + GAP)} y="46" width={BW} height="112" rx="8" class="aplad-box" />
        <DiagramIcon name={s.icon as any} x={BX + i * (BW + GAP) + 28} y="76" size={26} />
        <text x={BX + i * (BW + GAP) + 52} y="82" class="aplad-name">
          <tspan data-lang-en>{s.en}</tspan>
          <tspan data-lang-vi>{s.vi}</tspan>
        </text>
        <text x={BX + i * (BW + GAP) + 14} y="122" class="aplad-how">
          <tspan data-lang-en>{s.en2}</tspan>
          <tspan data-lang-vi>{s.vi2}</tspan>
        </text>
        {i < 3 && (
          <g>
            <line x1={BX + i * (BW + GAP) + BW + 6} y1="102" x2={BX + (i + 1) * (BW + GAP) - 12} y2="102" class="aplad-arrow" />
            <polygon points={`${BX + (i + 1) * (BW + GAP) - 12},96 ${BX + (i + 1) * (BW + GAP) - 2},102 ${BX + (i + 1) * (BW + GAP) - 12},108`} class="aplad-head" />
          </g>
        )}
        <text x={BX + i * (BW + GAP) + BW / 2} y="200" text-anchor="middle" class="aplad-ex">
          <tspan data-lang-en>{ex[i].en}</tspan>
          <tspan data-lang-vi>{ex[i].vi}</tspan>
        </text>
      </g>
    ))}
    <text x="20" y="232" class="aplad-sub">
      <tspan data-lang-en>Worked example, one strategy tested once: it clears the 5% bar, barely.</tspan>
      <tspan data-lang-vi>Ví dụ: một chiến lược chỉ test một lần, qua ngưỡng 5%, sát nút.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Each step throws information away on purpose: 1,260 numbers become one, and that one is compared with what luck alone would produce.</span>
    <span data-lang-vi>Mỗi bước cố ý bỏ bớt thông tin: 1.260 con số thành một, rồi con số đó được so với những gì riêng may rủi sẽ cho ra.</span>
  </figcaption>
</figure>

<style>
  .aplad { margin: 2em 0; width: 100%; }
  .aplad-scroll { overflow-x: auto; }
  .aplad svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .aplad text { font-size: 14px; fill: var(--text-body); }
  .aplad .aplad-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .aplad .aplad-name { font-size: 15px; font-weight: 700; fill: var(--text); }
  .aplad .aplad-how { font-size: 12.5px; fill: var(--text-muted); }
  .aplad .aplad-ex { font-size: 14px; font-weight: 700; fill: var(--text); }
  .aplad .aplad-sub { font-size: 13px; fill: var(--text-muted); }
  .aplad-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .aplad-arrow { stroke: var(--text-muted); stroke-width: 1.6; }
  .aplad-head { fill: var(--text-muted); }
  .aplad figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
