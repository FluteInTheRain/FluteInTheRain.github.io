---
import DiagramIcon from './DiagramIcon.astro';
// Icons: DiagramIcon (names from diagram-icons.ts). Motion: fig-motion.css.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 8 * Math.cos(a - 0.45), y2 - 8 * Math.sin(a - 0.45)];
  const p2 = [x2 - 8 * Math.cos(a + 0.45), y2 - 8 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
---
<figure class="gp">
  <div class="gp-scroll">
  <svg viewBox="0 0 900 270" role="img" aria-label="Each call to c.Inc with a value receiver works on its own copy of c, including its own mutex. The original c in main keeps n equal to 0.">
    <rect x="20" y="70" width="210" height="100" rx="8" class="box" />
    <DiagramIcon name="struct" x={206} y={92} size={24} />
    <text x="36" y="96" class="strong"><tspan data-lang-en>c in main</tspan><tspan data-lang-vi>c trong main</tspan></text>
    <text x="36" y="126">mu</text>
    <text x="36" y="150">n = 0</text>
    <text x="125" y="204" text-anchor="middle" class="red"><tspan data-lang-en>main prints n = 0</tspan><tspan data-lang-vi>main in ra n = 0</tspan></text>
    {[
      { y: 20, en: 'Inc call 1: a copy of c', vi: 'Lời gọi Inc thứ 1: bản copy của c', n: '1' },
      { y: 100, en: 'Inc call 2: a copy of c', vi: 'Lời gọi Inc thứ 2: bản copy của c', n: '1' },
      { y: 180, en: 'Inc call 100: a copy of c', vi: 'Lời gọi Inc thứ 100: bản copy của c', n: '1' },
    ].map((k) => {
      const a = arrow(230, 120, 400, k.y + 30);
      return (
        <g>
          <g class="arrow"><path class="fm-flow-slow" d={a.line} /><polygon points={a.head} /></g>
          <rect x="400" y={k.y} width="280" height="60" rx="8" class="box" />
          <text x="414" y={k.y + 24} class="strong"><tspan data-lang-en>{k.en}</tspan><tspan data-lang-vi>{k.vi}</tspan></text>
          <text x="414" y={k.y + 46}><tspan data-lang-en>its own mu, n becomes 1</tspan><tspan data-lang-vi>mu riêng, n thành 1</tspan></text>
          <DiagramIcon name="garbage" x={810} y={k.y + 30} size={26} />
          <text x="696" y={k.y + 35} class="muted"><tspan data-lang-en>discarded</tspan><tspan data-lang-vi>bị bỏ đi</tspan></text>
        </g>
      );
    })}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>A value receiver copies the whole struct on every call, mutex included. The lock protects only the copy, and the incremented copy is thrown away.</span>
    <span data-lang-vi>Value receiver copy cả struct ở mỗi lời gọi, kể cả mutex. Khóa chỉ bảo vệ bản copy, và bản copy đã tăng thì bị bỏ đi.</span>
  </figcaption>
</figure>

<style>
  .gp { margin: 2em 0; width: 100%; }
  .gp-scroll { overflow-x: auto; }
  .gp svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp text { font-size: 14px; fill: var(--text-body); }
  .gp .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp .strong { font-weight: 700; fill: var(--text); }
  .gp .muted { fill: var(--text-muted); }
  .gp .red { fill: var(--red); font-weight: 700; }
  .gp .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp .box.bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp .bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp .bar.bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp .wait { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp .rule { stroke: var(--border); stroke-width: 1; }
  .gp .axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .gp .dot { fill: var(--text-muted); }
  .gp .dot.bad { fill: var(--red); }
  .gp .arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp .arrow polygon { fill: var(--text-muted); }
  .gp .arrow.bad path { stroke: var(--red); }
  .gp .arrow.bad polygon { fill: var(--red); }
  .gp figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
