---
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 372;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const aWaitB = arrow(346, 124, 554, 124);
const aWaitA = arrow(554, 178, 346, 178);
---
<figure class="g13etcd">
  <div class="g13etcd-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Deadlock cycle in etcd pull request 11817 (mvcc/kvstore.go). Goroutine A in store.Restore holds s.mu.Lock and blocks in fifoSched.Stop waiting for compaction jobs. Goroutine B in compactBarrier runs on fifoSched and blocks in s.mu.Lock before checking stopc. Moving s.mu.Lock inside the select default branch breaks the cycle.">
      <DiagramIcon name="etcd" x={32} y={24} size={22} />
      <text x="52" y="29" class="g13etcd-h is-red">
        <tspan data-lang-en>Deadlock cycle in etcd-io/etcd#11817 (mvcc/kvstore.go)</tspan>
        <tspan data-lang-vi>Vòng khóa chết trong etcd-io/etcd#11817 (mvcc/kvstore.go)</tspan>
      </text>

      {/* Goroutine A */}
      <rect x="20" y="54" width="322" height="162" rx="8" class="g13etcd-box is-red" />
      <DiagramIcon name="lock" x={42} y={82} size={18} />
      <text x="58" y="87" class="g13etcd-b">Goroutine A: store.Restore()</text>
      <text x="36" y="114" class="g13etcd-line">1. s.mu.Lock()  (held)</text>
      <text x="36" y="138" class="g13etcd-line">2. close(s.stopc)</text>
      <text x="36" y="164" class="g13etcd-red">
        <tspan data-lang-en>3. s.fifoSched.Stop() → blocks</tspan>
        <tspan data-lang-vi>3. s.fifoSched.Stop() → đứng chờ</tspan>
      </text>
      <text x="36" y="192" class="g13etcd-sub">
        <tspan data-lang-en>cannot unlock until fifo finishes</tspan>
        <tspan data-lang-vi>chưa trả s.mu tới khi fifo chạy xong</tspan>
      </text>

      {/* Center arrows */}
      <text x="450" y="112" text-anchor="middle" class="g13etcd-red">
        <tspan data-lang-en>waits for worker</tspan>
        <tspan data-lang-vi>đợi worker thoát</tspan>
      </text>
      <g class="g13etcd-arrow is-red"><path d={aWaitB.line} /><polygon points={aWaitB.head} /></g>

      <g class="g13etcd-arrow is-red"><path d={aWaitA.line} /><polygon points={aWaitA.head} /></g>
      <text x="450" y="200" text-anchor="middle" class="g13etcd-red">
        <tspan data-lang-en>waits for s.mu</tspan>
        <tspan data-lang-vi>đợi s.mu được mở</tspan>
      </text>

      {/* Goroutine B */}
      <rect x="558" y="54" width="322" height="162" rx="8" class="g13etcd-box is-red" />
      <DiagramIcon name="worker" x={580} y={82} size={18} />
      <text x="596" y="87" class="g13etcd-b">Goroutine B: compactBarrier()</text>
      <text x="574" y="114" class="g13etcd-line">
        <tspan data-lang-en>1. running on fifoSched worker</tspan>
        <tspan data-lang-vi>1. đang chạy trên worker fifoSched</tspan>
      </text>
      <text x="574" y="140" class="g13etcd-red">
        <tspan data-lang-en>2. calls s.mu.Lock() first → blocks</tspan>
        <tspan data-lang-vi>2. gọi s.mu.Lock() trước → kẹt cứng</tspan>
      </text>
      <text x="574" y="166" class="g13etcd-sub">
        <tspan data-lang-en>3. never reaches select &lt;-s.stopc</tspan>
        <tspan data-lang-vi>3. không bao giờ tới select &lt;-s.stopc</tspan>
      </text>
      <text x="574" y="192" class="g13etcd-sub">
        <tspan data-lang-en>worker stays busy forever</tspan>
        <tspan data-lang-vi>worker kẹt mãi trong fifoSched</tspan>
      </text>

      {/* Fix box */}
      <rect x="20" y="246" width="860" height="106" rx="8" class="g13etcd-box is-gold" />
      <DiagramIcon name="ok" x={42} y={276} size={20} />
      <text x="60" y="281" class="g13etcd-b">
        <tspan data-lang-en>Fix merged in PR #11817: check stopc before taking s.mu.Lock()</tspan>
        <tspan data-lang-vi>Cách sửa trong PR #11817: kiểm tra stopc trước khi gọi s.mu.Lock()</tspan>
      </text>
      <text x="36" y="308" class="g13etcd-line">
        <tspan data-lang-en>select {'{'} case &lt;-s.stopc: return  |  default: s.mu.Lock(); s.fifoSched.Schedule(...); s.mu.Unlock() {'}'}</tspan>
        <tspan data-lang-vi>select {'{'} case &lt;-s.stopc: thoát ngay  |  default: s.mu.Lock(); s.fifoSched.Schedule(...); s.mu.Unlock() {'}'}</tspan>
      </text>
      <text x="36" y="334" class="g13etcd-sub">
        <tspan data-lang-en>When Restore closes stopc, compactBarrier exits immediately without touching s.mu, so fifoSched.Stop() completes.</tspan>
        <tspan data-lang-vi>Khi Restore đóng stopc, compactBarrier thoát ngay mà không xin s.mu, giúp fifoSched.Stop() kết thúc bình thường.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Verified from etcd-io/etcd#11817: holding a mutex while waiting on a worker queue deadlocks if a worker on that queue needs the same mutex before checking the shutdown channel.</span>
    <span data-lang-vi>Kiểm chứng từ etcd-io/etcd#11817: giữ mutex trong lúc chờ hàng đợi worker dừng sẽ gây deadlock nếu worker bên trong lại xin đúng mutex đó trước khi đọc kênh tín hiệu dừng.</span>
  </figcaption>
</figure>

<style>
  .g13etcd { margin: 2em 0; width: 100%; }
  .g13etcd-scroll { overflow-x: auto; }
  .g13etcd svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .g13etcd text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .g13etcd-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .g13etcd-h.is-red { fill: var(--red); }
  .g13etcd-b { font-size: 14px; font-weight: 700; fill: var(--text); }
  .g13etcd-line { font-size: 13px; fill: var(--text-body); }
  .g13etcd-sub { font-size: 12.5px; fill: var(--text-muted); }
  .g13etcd-red { font-size: 13px; font-weight: 600; fill: var(--red); }
  .g13etcd-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .g13etcd-box.is-red { fill: var(--red-tint-bg); stroke: var(--red); }
  .g13etcd-box.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .g13etcd-arrow path { fill: none; stroke: var(--red); stroke-width: 1.8; }
  .g13etcd-arrow polygon { fill: var(--red); }
  .g13etcd figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
