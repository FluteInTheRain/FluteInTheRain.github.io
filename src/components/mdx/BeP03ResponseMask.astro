---
// response_model as a mask: the handler's dict holds nine fields, two of them
// internal; CaseOut declares seven, and only the declared ones cross. The
// leaked fields are the only red — struck through where they get cut.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 310;
const left = [
  { key: 'case_id', val: '"1b68a63a"', cut: false },
  { key: 'title', val: '"The case of the stolen schema"', cut: false },
  { key: 'case_code', val: '"CLUE-1902"', cut: false },
  { key: 'priority', val: '3', cut: false },
  { key: 'reward', val: '5000.0', cut: false },
  { key: 'status', val: '"open"', cut: false },
  { key: 'opened_at', val: '"2026-11-23T07:41:58Z"', cut: false },
  { key: 'reporter_ip', val: '"203.0.113.7"', cut: true },
  { key: 'triage_score', val: '87', cut: true },
];
const right = left.filter((f) => !f.cut);
const f = arrow(332, 168, 386, 168);
const p = arrow(514, 168, 566, 168);
---
<figure class="bep3e">
  <div class="bep3e-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The handler's dict holds nine fields including reporter_ip and triage_score; the CaseOut response model acts as a mask and only the seven declared fields reach the caller.">
    <rect x="50" y="40" width="280" height="250" rx="8" class="card" />
    <text x="68" y="66" class="t"><tspan data-lang-en>the handler returns</tspan><tspan data-lang-vi>handler trả về</tspan></text>
    {left.map((fld, i) => (
      <text x="68" y={100 + i * 22} class={fld.cut ? 'fr cut' : 'fr'}>
        <tspan class={fld.cut ? 'rk' : 'k'}>{fld.key}</tspan><tspan>: {fld.val}</tspan>
      </text>
    ))}
    <g><path d={f.line} class="ln" /><polygon points={f.head} class="hd" /></g>
    <image href="/icons/flow/scissors.svg" x="438" y="118" width="24" height="24" class="icn" aria-hidden="true" />
    <rect x="390" y="150" width="120" height="40" rx="8" class="box" />
    <text x="450" y="168" text-anchor="middle" class="t">CaseOut</text>
    <text x="450" y="186" text-anchor="middle" class="m"><tspan data-lang-en>the contract</tspan><tspan data-lang-vi>contract</tspan></text>
    <text x="450" y="214" text-anchor="middle" class="rr"><tspan data-lang-en>not declared — dropped here</tspan><tspan data-lang-vi>chưa khai báo — cắt ở đây</tspan></text>
    <g><path d={p.line} class="ln" /><polygon points={p.head} class="hd" /></g>
    <rect x="570" y="40" width="280" height="204" rx="8" class="card" />
    <text x="588" y="66" class="t"><tspan data-lang-en>the caller receives</tspan><tspan data-lang-vi>caller nhận được</tspan></text>
    {right.map((fld, i) => (
      <text x="588" y={100 + i * 22} class="fr">
        <tspan class="k">{fld.key}</tspan><tspan>: {fld.val}</tspan>
      </text>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The handler's dict is not the contract — only what CaseOut declares crosses the line. Add a field to the dict and nothing leaks unless the model says so.</span>
    <span data-lang-vi>Dict trong handler không phải contract — chỉ những field CaseOut khai báo mới qua được cửa. Thêm field vào dict cũng không lộ ra, trừ khi model cho phép.</span>
  </figcaption>
</figure>

<style>
  .bep3e { margin: 2em 0; width: 100%; }
  .bep3e-scroll { overflow-x: auto; }
  .bep3e svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep3e text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep3e .t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .bep3e .m { fill: var(--text-muted); font-size: 12.5px; }
  .bep3e .rr { font-weight: 700; fill: var(--red); font-size: 12.5px; }
  .bep3e .fr { fill: var(--text-body); }
  .bep3e .k { fill: var(--text-muted); }
  .bep3e .rk { fill: var(--red); font-weight: 700; }
  .bep3e .cut { text-decoration: line-through; }
  .bep3e .card { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep3e .box { fill: var(--bg); stroke: var(--red); stroke-width: 1.5; }
  .bep3e .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep3e .hd { fill: var(--text-muted); }
  .bep3e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
