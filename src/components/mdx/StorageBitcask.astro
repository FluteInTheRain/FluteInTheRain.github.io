---
// Bitcask: a write appends to the active file and updates the in-memory keydir;
// a read looks the key up in the keydir and does one disk seek; a background
// merge rewrites closed files and writes a hint file.
// Plain inline SVG with site tokens, polygon arrowheads, no ids.
const W = 900;
const H = 500;
function arrowDown(x: number, y1: number, y2: number) {
  return { line: `M${x},${y1} L${x},${y2 - 7}`, head: `${x - 5},${y2 - 8} ${x + 5},${y2 - 8} ${x},${y2}` };
}
function arrowRight(x1: number, x2: number, y: number) {
  return { line: `M${x1},${y} L${x2 - 7},${y}`, head: `${x2 - 8},${y - 5} ${x2 - 8},${y + 5} ${x2},${y}` };
}

const files = [
  { x: 200, en: 'file 3 (active)', vi: 'file 3 (đang ghi)', hit: false },
  { x: 420, en: 'file 2 (closed)', vi: 'file 2 (đã đóng)', hit: true },
  { x: 640, en: 'file 1 (closed)', vi: 'file 1 (đã đóng)', hit: false },
];
const toActive = arrowRight(170, 200, 255);
const read = arrowDown(520, 168, 225);
const merge1 = arrowRight(250, 300, 440);
const merge2 = arrowRight(550, 600, 440);
---
<figure class="bc">
  <div class="bc-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Bitcask. A write is appended to the active data file and also updates the keydir, a hash table in memory that maps each key to a file, offset and size. A read looks the key up in the keydir and then reads that spot in one disk seek. In the background a merge rewrites closed files, keeping the newest value of each key, and writes a hint file so a restart can rebuild the keydir without reading every value.">
    <text x="20" y="24" class="bc-h">
      <tspan data-lang-en>Writes and reads</tspan>
      <tspan data-lang-vi>Đường ghi và đường đọc</tspan>
    </text>
    <text x="20" y="46" class="bc-sub">
      <tspan data-lang-en>Every key points straight at its newest value, so a read never scans.</tspan>
      <tspan data-lang-vi>Mỗi khoá trỏ thẳng tới giá trị mới nhất của nó, nên đọc không bao giờ phải quét.</tspan>
    </text>

    <text x={W - 20} y="76" text-anchor="end" class="bc-zone">
      <tspan data-lang-en>memory</tspan>
      <tspan data-lang-vi>bộ nhớ (RAM)</tspan>
    </text>
    <line x1="20" x2={W - 20} y1="190" y2="190" class="bc-divider" />
    <text x={W - 20} y="208" text-anchor="end" class="bc-zone">
      <tspan data-lang-en>disk</tspan>
      <tspan data-lang-vi>đĩa</tspan>
    </text>

    {/* keydir */}
    <rect x="200" y="60" width="500" height="108" rx="4" class="bc-box" />
    <text x="214" y="82" class="bc-in-b">
      <tspan data-lang-en>keydir (hash table)</tspan>
      <tspan data-lang-vi>keydir (bảng băm)</tspan>
    </text>
    <text x="690" y="82" text-anchor="end" class="bc-note">
      <tspan data-lang-en>example values</tspan>
      <tspan data-lang-vi>giá trị minh hoạ</tspan>
    </text>
    <rect x="208" y="112" width="484" height="24" rx="3" class="bc-cell is-hit" />
    <text x="220" y="104" class="bc-mono">user7  -&gt; file 3, offset 0, size 64</text>
    <text x="220" y="129" class="bc-mono is-hit">user42 -&gt; file 2, offset 8192, size 64</text>
    <text x="220" y="154" class="bc-mono">user9  -&gt; file 1, offset 4096, size 64</text>

    {/* write */}
    <rect x="20" y="225" width="150" height="60" rx="4" class="bc-box" />
    <text x="95" y="250" text-anchor="middle" class="bc-in">
      <tspan data-lang-en>New write</tspan>
      <tspan data-lang-vi>Lệnh ghi mới</tspan>
    </text>
    <text x="95" y="270" text-anchor="middle" class="bc-in-m">user7 = ...</text>
    <path d={toActive.line} class="bc-arrow" /><polygon points={toActive.head} class="bc-head" />
    <path d="M95,225 L95,100 L193,100" class="bc-arrow" /><polygon points="192,95 192,105 200,100" class="bc-head" />
    <text x="104" y="212" class="bc-note">
      <tspan data-lang-en>and updates the keydir</tspan>
      <tspan data-lang-vi>và cập nhật keydir</tspan>
    </text>

    {/* data files */}
    {files.map((f) => (
      <g>
        <rect x={f.x} y="225" width="200" height="60" rx="4" class="bc-box" />
        <text x={f.x + 12} y="245" class="bc-in-s">
          <tspan data-lang-en>{f.en}</tspan>
          <tspan data-lang-vi>{f.vi}</tspan>
        </text>
        {[0, 1, 2, 3].map((i) => (
          <rect x={f.x + 12 + i * 44} y="254" width="38" height="22" rx="3" class={f.hit && i === 2 ? 'bc-cell is-hit' : 'bc-cell'} />
        ))}
      </g>
    ))}
    <path d={read.line} class="bc-arrow is-hit" /><polygon points={read.head} class="bc-head is-hit" />
    <text x="532" y="212" class="bc-note is-hit">
      <tspan data-lang-en>read: one disk seek</tspan>
      <tspan data-lang-vi>đọc: một lần seek đĩa</tspan>
    </text>
    <text x="200" y="306" class="bc-note">
      <tspan data-lang-en>append only</tspan>
      <tspan data-lang-vi>chỉ nối thêm</tspan>
    </text>
    <text x="420" y="306" class="bc-note">
      <tspan data-lang-en>closed files are never written again</tspan>
      <tspan data-lang-vi>file đã đóng không bao giờ ghi lại</tspan>
    </text>

    {/* merge */}
    <line x1="20" x2={W - 20} y1="338" y2="338" class="bc-rule" />
    <text x="20" y="366" class="bc-h">
      <tspan data-lang-en>Merge, in the background</tspan>
      <tspan data-lang-vi>Merge, chạy ngầm</tspan>
    </text>
    <text x="20" y="388" class="bc-sub">
      <tspan data-lang-en>Old values pile up, so closed files are rewritten with only the newest value of each key.</tspan>
      <tspan data-lang-vi>Giá trị cũ tích tụ, nên các file đã đóng được viết lại, mỗi khoá chỉ giữ giá trị mới nhất.</tspan>
    </text>

    <rect x="20" y="412" width="230" height="56" rx="4" class="bc-box" />
    <text x="135" y="436" text-anchor="middle" class="bc-in-s">
      <tspan data-lang-en>Closed files 1 and 2</tspan>
      <tspan data-lang-vi>Các file đã đóng 1 và 2</tspan>
    </text>
    <text x="135" y="455" text-anchor="middle" class="bc-in-m">
      <tspan data-lang-en>old and new values mixed</tspan>
      <tspan data-lang-vi>giá trị cũ lẫn mới</tspan>
    </text>
    <rect x="300" y="412" width="250" height="56" rx="4" class="bc-box" />
    <text x="425" y="436" text-anchor="middle" class="bc-in-s">
      <tspan data-lang-en>Merged file</tspan>
      <tspan data-lang-vi>File đã trộn</tspan>
    </text>
    <text x="425" y="455" text-anchor="middle" class="bc-in-m">
      <tspan data-lang-en>newest value of each key</tspan>
      <tspan data-lang-vi>giá trị mới nhất của mỗi khoá</tspan>
    </text>
    <rect x="600" y="412" width="250" height="56" rx="4" class="bc-box" />
    <text x="725" y="436" text-anchor="middle" class="bc-in-s">
      <tspan data-lang-en>Hint file</tspan>
      <tspan data-lang-vi>Hint file</tspan>
    </text>
    <text x="725" y="455" text-anchor="middle" class="bc-in-m">
      <tspan data-lang-en>keys and offsets, for restarts</tspan>
      <tspan data-lang-vi>khoá và offset, để khởi động lại</tspan>
    </text>
    <path d={merge1.line} class="bc-arrow" /><polygon points={merge1.head} class="bc-head" />
    <path d={merge2.line} class="bc-arrow" /><polygon points={merge2.head} class="bc-head" />
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Bitcask, simplified. The keydir lives entirely in RAM, one entry per key, which is why a read needs at most one disk seek and also why the number of keys is limited by memory.</span>
    <span data-lang-vi>Bitcask, đã giản lược. Keydir nằm hoàn toàn trong RAM, mỗi khoá một entry, nên đọc chỉ cần tối đa một lần seek đĩa, và cũng vì thế số khoá bị giới hạn bởi bộ nhớ.</span>
  </figcaption>
</figure>

<style>
  .bc { margin: 2em 0; width: 100%; }
  .bc-scroll { overflow-x: auto; }
  .bc svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bc text { font-size: 14px; fill: var(--text-body); }
  .bc .bc-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .bc .bc-sub, .bc .bc-zone { fill: var(--text-muted); }
  .bc .bc-zone { font-size: 13px; }
  .bc-divider { stroke: var(--border); stroke-dasharray: 6 5; }
  .bc-rule { stroke: var(--border); }
  .bc-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bc-box.is-hot, .bc-box.is-hit { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .bc-cell { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .bc-cell.is-hit { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .bc-cell.is-dead { fill: var(--bg-alt); stroke: var(--text-muted); stroke-dasharray: 3 3; }
  .bc .bc-in { font-weight: 600; fill: var(--text); }
  .bc .bc-in-b { font-weight: 700; fill: var(--text); }
  .bc .bc-in-m { font-size: 13px; fill: var(--text-body); }
  .bc .bc-in-s { font-size: 13px; font-weight: 600; fill: var(--text); }
  .bc .bc-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; fill: var(--text-body); }
  .bc .bc-mono.is-hit { fill: var(--gold-icon); font-weight: 700; }
  .bc .bc-note { font-size: 13px; fill: var(--text-muted); }
  .bc .bc-note.is-hit { fill: var(--gold-icon); font-weight: 700; }
  .bc-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .bc-arrow.is-hit { stroke: var(--gold-icon); stroke-width: 1.8; }
  .bc-head { fill: var(--text-muted); }
  .bc-head.is-hit { fill: var(--gold-icon); }
  .bc figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
