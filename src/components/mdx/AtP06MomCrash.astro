---
// Real data: Mom (winners minus losers) and the market's excess return, monthly, Jan 2008 to Dec 2010.
// Source: Ken French data library (F-F_Momentum_Factor, F-F_Research_Data_Factors, CRSP 202609 vintage).
// Python: Mar-May 2009 Mom = -11.80, -34.36, -12.54 -> compounded 0.5063 (-49.4%); market excess +9.01, +10.17, +5.21 -> 1.2635 (+26.4%).
const mom = [-7.78,6.13,4.25,-0.31,3.38,12.73,-5.02,-4.5,0.78,7.84,7.26,-5.08,-2.16,4.34,-11.8,-34.36,-12.54,5.4,-5.61,-9.11,-4.83,2.58,0.39,2.97,-5.31,3.7,3.58,3.19,-0.18,-2.7,1.77,-0.06,1.35,1.5,2.71,-3.0];
const mkt = [-6.33,-3.09,-0.94,4.61,1.87,-8.43,-0.75,1.53,-9.35,-17.2,-7.74,1.77,-8.09,-10.14,9.01,10.17,5.21,0.42,7.74,3.33,4.08,-2.53,5.63,2.8,-3.35,3.39,6.3,1.99,-7.9,-5.56,6.92,-4.78,9.55,3.87,0.59,6.82];
const L = 70, R = 880, W = (R - L) / 36;
const x = (i: number) => L + i * W;
const sc = 2.6;
const Z1 = 110, Z2 = 292;
---
<figure class="p06d">
  <div class="p06d-scroll">
    <svg viewBox="0 0 900 420" role="img" aria-label="Two bar charts by month, January 2008 to December 2010. Top: the momentum factor, with a drop of 11.8 percent in March 2009, 34.4 percent in April 2009 and 12.5 percent in May 2009. Bottom: the market's excess return, which rose 9.0, 10.2 and 5.2 percent in those same three months.">
      <text x="20" y="26" class="h"><tspan data-lang-en>Momentum crashed while the market rebounded (monthly, %)</tspan><tspan data-lang-vi>Momentum sập đúng lúc thị trường hồi phục (theo tháng, %)</tspan></text>
      <rect x={x(14) - 2} y="64" width={W * 3 + 4} height="296" class="shade" />
      <line x1={L} x2={R} y1={Z1} y2={Z1} class="zero" /><line x1={L} x2={R} y1={Z2} y2={Z2} class="zero" />
      <text x="14" y="54" class="m"><tspan data-lang-en>Momentum (winners − losers)</tspan><tspan data-lang-vi>Momentum (mã thắng − mã thua)</tspan></text>
      <text x="14" y="228" class="m"><tspan data-lang-en>Market excess return</tspan><tspan data-lang-vi>Lợi nhuận vượt trội của thị trường</tspan></text>
      {mom.map((v, i) => (<rect x={x(i) + 2} y={v >= 0 ? Z1 - v * sc : Z1} width={W - 4} height={Math.abs(v) * sc} class={i >= 14 && i <= 16 ? 'bar red' : 'bar'} />))}
      {mkt.map((v, i) => (<rect x={x(i) + 2} y={v >= 0 ? Z2 - v * sc : Z2} width={W - 4} height={Math.abs(v) * sc} class={i >= 14 && i <= 16 ? 'bar gold' : 'bar mk'} />))}
      <text x={x(15) + W / 2} y={Z1 + 34.36 * sc + 16} class="n red" text-anchor="middle"><tspan data-lang-en>−34.4% in April 2009</tspan><tspan data-lang-vi>−34,4% tháng 4/2009</tspan></text>
      <text x={x(15) + W / 2} y={Z2 - 10.17 * sc - 8} class="n" text-anchor="middle"><tspan data-lang-en>+10.2% for the market</tspan><tspan data-lang-vi>thị trường +10,2%</tspan></text>
      {[0, 12, 24].map((i) => (<text x={x(i) + 2} y="388" class="m">{2008 + i / 12}</text>))}
      <text x={x(14) + W * 1.5} y="410" class="m" text-anchor="middle"><tspan data-lang-en>Mar–May 2009: Mom −49.4%, market +26.4%</tspan><tspan data-lang-vi>3–5/2009: Mom −49,4%, thị trường +26,4%</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Real data from the Ken French data library. In March, April and May 2009 the market rebounded, and the series that buys past winners and sells past losers lost about half its value. The rebound came right after the market's big fall.</span>
    <span data-lang-vi>Số liệu thật từ thư viện dữ liệu của Ken French. Tháng 3, 4, 5/2009 thị trường hồi phục, còn chuỗi mua mã thắng và bán mã thua mất khoảng một nửa giá trị. Đợt hồi phục đó đến ngay sau cú giảm lớn của thị trường.</span>
  </figcaption>
</figure>
<style>
  .p06d { margin: 2em 0; width: 100%; }
  .p06d-scroll { overflow-x: auto; }
  .p06d svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .p06d text { font-size: 12.5px; fill: var(--text-body); }
  .p06d .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p06d .m { fill: var(--text-muted); }
  .p06d .n { font-size: 13px; font-weight: 700; fill: var(--text); }
  .p06d .n.red { fill: var(--red); }
  .p06d .shade { fill: var(--bg-alt); stroke: var(--border); }
  .p06d .zero { stroke: var(--text-faint); stroke-width: 1.2; }
  .p06d .bar { fill: var(--text-faint); }
  .p06d .bar.mk { fill: var(--text-faint); opacity: 0.7; }
  .p06d .bar.red { fill: var(--red); }
  .p06d .bar.gold { fill: var(--gold); }
  .p06d figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
