---
// Chapter 3, "don't shrink an element until you need to": card width as the screen grows,
// for two strategies. Grid: 8 of 12 columns on medium screens, 6 of 12 from 1024px up.
// Max-width: the card takes the space it has up to 500px and stops there.
// Assumptions (stated in the caption): 24px page padding on each side, breakpoint at 1024px,
// gutters ignored. Computed at build time, drawn with site tokens.

const W = 900;
const H = 380;
const pad = { l: 70, r: 30, t: 30, b: 60 };
const xMin = 640;
const xMax = 1600;
const yMax = 1100;
const sx = (v: number) => pad.l + ((v - xMin) / (xMax - xMin)) * (W - pad.l - pad.r);
const sy = (v: number) => H - pad.b - (v / yMax) * (H - pad.t - pad.b);

const inner = (vw: number) => vw - 48;
const grid = (vw: number) => (vw < 1024 ? (8 / 12) * inner(vw) : (6 / 12) * inner(vw));
const maxw = (vw: number) => Math.min(500, inner(vw));

const step = 8;
const xs: number[] = [];
for (let v = xMin; v <= xMax; v += step) xs.push(v);

const gridPath = [
  xs.filter((v) => v < 1024).map((v, i) => `${i === 0 ? 'M' : 'L'} ${sx(v).toFixed(1)} ${sy(grid(v)).toFixed(1)}`).join(' '),
  `L ${sx(1023.9).toFixed(1)} ${sy(grid(1023.9)).toFixed(1)}`,
  `M ${sx(1024).toFixed(1)} ${sy(grid(1024)).toFixed(1)}`,
  xs.filter((v) => v >= 1024).map((v) => `L ${sx(v).toFixed(1)} ${sy(grid(v)).toFixed(1)}`).join(' '),
].join(' ');
const maxPath = xs.map((v, i) => `${i === 0 ? 'M' : 'L'} ${sx(v).toFixed(1)} ${sy(maxw(v)).toFixed(1)}`).join(' ');

const before = Math.round(grid(1023.9));
const after = Math.round(grid(1024));
// The first screen width at which the large-screen card is as wide as the medium one was at 1023px.
const catchUp = Math.ceil((before * 2) + 48);

const yTicks = [0, 250, 500, 750, 1000];
const xTicks = [640, 800, 1024, 1200, 1400, 1600];
---
<figure class="gvm">
  <div class="gvm-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Card width against screen width. The grid card grows to ${before}px at 1023px, drops to ${after}px at 1024px, and only gets back to that width at about ${catchUp}px. The max-width card grows to 500px and stays there.`}>
      {yTicks.map((t) => (
        <g>
          <line x1={pad.l} x2={W - pad.r} y1={sy(t)} y2={sy(t)} class="gvm-grid" />
          <text x={pad.l - 10} y={sy(t) + 5} text-anchor="end" class="gvm-tick">{t}</text>
        </g>
      ))}
      {xTicks.map((t) => (
        <text x={sx(t)} y={H - pad.b + 22} text-anchor="middle" class="gvm-tick">{t}</text>
      ))}
      <text x={(pad.l + W - pad.r) / 2} y={H - 12} text-anchor="middle" class="gvm-axis">
        <tspan data-lang-en>Screen width (px)</tspan>
        <tspan data-lang-vi>Độ rộng màn hình (px)</tspan>
      </text>
      <text x="16" y={pad.t - 8} class="gvm-axis">
        <tspan data-lang-en>Card width (px)</tspan>
        <tspan data-lang-vi>Độ rộng thẻ (px)</tspan>
      </text>

      <rect x={sx(1024)} y={pad.t} width={sx(catchUp) - sx(1024)} height={H - pad.t - pad.b} class="gvm-band" />
      <line x1={sx(1024)} x2={sx(1024)} y1={pad.t} y2={H - pad.b} class="gvm-break" />

      <path d={gridPath} class="gvm-line is-grid" />
      <path d={maxPath} class="gvm-line is-max" />

      <text x={sx(1023.9) - 8} y={sy(before) - 12} text-anchor="end" class="gvm-label is-grid">
        <tspan data-lang-en>Grid: 8 of 12 columns, {before}px</tspan>
        <tspan data-lang-vi>Lưới: 8/12 cột, {before}px</tspan>
      </text>
      <text x={sx(1030)} y={sy(after) + 24} class="gvm-label is-grid">
        <tspan data-lang-en>6 of 12 from 1024px: drops to {after}px</tspan>
        <tspan data-lang-vi>6/12 từ 1024px: tụt còn {after}px</tspan>
      </text>
      <text x={W - pad.r} y={sy(500) - 12} text-anchor="end" class="gvm-label is-max">
        <tspan data-lang-en>max-width: 500px, never shrinks early</tspan>
        <tspan data-lang-vi>max-width: 500px, không co sớm</tspan>
      </text>
      <text x={(sx(1024) + sx(catchUp)) / 2} y={pad.t + 18} text-anchor="middle" class="gvm-band-label">
        <tspan data-lang-en>bigger screen, smaller card</tspan>
        <tspan data-lang-vi>màn to hơn, thẻ lại nhỏ hơn</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Say the page has 24px padding on each side, one breakpoint at 1024px, and gutters are ignored. Between 1024px and about {catchUp}px the grid card is narrower than it was on a smaller screen.</span>
    <span data-lang-vi>Giả sử lề trang 24px mỗi bên, một breakpoint ở 1024px, bỏ qua khoảng cách giữa cột. Từ 1024px tới khoảng {catchUp}px, thẻ theo lưới hẹp hơn chính nó trên màn hình nhỏ hơn.</span>
  </figcaption>
</figure>

<style>
  .gvm {
    margin: 2em 0;
    width: 100%;
  }
  .gvm-scroll {
    overflow-x: auto;
  }
  .gvm svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .gvm text {
    font-size: 14px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .gvm-grid {
    stroke: var(--border);
  }
  .gvm text.gvm-tick {
    fill: var(--text-muted);
    font-size: 13px;
  }
  .gvm text.gvm-axis {
    fill: var(--text-muted);
  }
  .gvm-band {
    fill: var(--red-tint-bg);
    opacity: 0.7;
  }
  .gvm text.gvm-band-label {
    fill: var(--red);
    font-weight: 600;
  }
  .gvm-break {
    stroke: var(--text-faint);
    stroke-dasharray: 4 4;
  }
  .gvm-line {
    fill: none;
    stroke-width: 3;
  }
  .gvm-line.is-grid {
    stroke: var(--red);
  }
  .gvm-line.is-max {
    stroke: var(--text);
  }
  .gvm text.gvm-label {
    font-weight: 600;
  }
  .gvm text.gvm-label.is-grid {
    fill: var(--red);
  }
  .gvm text.gvm-label.is-max {
    fill: var(--text);
  }
  .gvm figcaption {
    margin-top: 0.6em;
    text-align: center;
    font-size: 14px;
    color: var(--text-muted);
  }
</style>
