---
import DiagramIcon from './DiagramIcon.astro';
// Offsets from the watch captures (seconds from the first new pod's creation).
// naive: new pods 1/1 at 1.9, 2.8, 4.8; old pods Terminating at 1.9, 2.8, 4.9.
// graceful: new pods 1/1 at 4.6, 9.0, 13.6; old pods Terminating at the same moments.
// Failed / sent: naive 67 / 351, graceful 0 / 523 (final-naive, final-graceful runs).
const W = 900, H = 400;
const sx = (s: number) => 150 + s * 36; // 36 px per second, 0..14 s
const naive = [[0, 1.9], [2.0, 2.8], [2.9, 4.8]];
const good = [[0, 4.6], [4.6, 9.0], [9.1, 13.6]];
---
<figure class="bep12i">
  <div class="bep12i-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two rollout timelines for three new pods. Top, no probes: each new pod is marked ready 1.9, 2.8 and 4.8 seconds after it is created, while its app is still warming up for 3 seconds, and the old pods are killed at once; 67 of 351 requests failed. Bottom, with probes and preStop: each pod becomes ready only 4.6, 9.0 and 13.6 seconds in, after the warm-up, and no request failed out of 523.">
    <text x="40" y="26" class="h red"><tspan data-lang-en>no probes: Ready the moment the container starts</tspan><tspan data-lang-vi>không probe: Ready ngay khi container chạy</tspan></text>
    {naive.map((p, i) => (
      <g>
        <text x="40" y={64 + i * 36} class="sm"><tspan data-lang-en>new pod {i + 1}</tspan><tspan data-lang-vi>pod mới {i + 1}</tspan></text>
        <rect x={sx(p[0])} y={50 + i * 36} width={(p[1] - p[0]) * 36} height="20" class="bar" />
        <rect x={sx(p[1])} y={50 + i * 36} width={3 * 36} height="20" class="warm" />
        <circle cx={sx(p[1])} cy={60 + i * 36} r="5" class="dot red-d" />
      </g>
    ))}
    <text x={sx(7.2)} y="56" class="sm red"><tspan data-lang-en>hatched = app warming up, but already in rotation</tspan><tspan data-lang-vi>vùng gạch = app đang warm-up mà đã nhận traffic</tspan></text>
    <text x="660" y="116" class="num red"><tspan data-lang-en>67 of 351 failed</tspan><tspan data-lang-vi>67 trên 351 lỗi</tspan></text>
    <line x1="40" y1="190" x2="860" y2="190" class="axis" />
    <text x="40" y="218" class="h"><tspan data-lang-en>readiness + preStop + graceful exit</tspan><tspan data-lang-vi>readiness + preStop + thoát êm</tspan></text>
    {good.map((p, i) => (
      <g>
        <text x="40" y={264 + i * 36} class="sm"><tspan data-lang-en>new pod {i + 1}</tspan><tspan data-lang-vi>pod mới {i + 1}</tspan></text>
        <rect x={sx(p[0])} y={250 + i * 36} width={(p[1] - p[0]) * 36} height="20" class="bar not" />
        <circle cx={sx(p[1])} cy={260 + i * 36} r="5" class="dot" />
      </g>
    ))}
    <text x={sx(8)} y="256" class="sm"><tspan data-lang-en>dot = Ready, and only now the old pod starts leaving</tspan><tspan data-lang-vi>chấm = Ready, đến lúc này pod cũ mới bắt đầu rút</tspan></text>
    <line x1={sx(0)} y1="356" x2={sx(14)} y2="356" class="axis" />
    {[0, 2, 4, 6, 8, 10, 12, 14].map((t) => (
      <g>
        <line x1={sx(t)} y1="356" x2={sx(t)} y2="362" class="axis" />
        <text x={sx(t)} y="380" text-anchor="middle" class="sm"><tspan data-lang-en>{t}</tspan><tspan data-lang-vi>{t}</tspan></text>
      </g>
    ))}
    <text x={sx(14) + 20} y="380" class="sm"><tspan data-lang-en>s after the first new pod appeared</tspan><tspan data-lang-vi>s kể từ lúc pod mới đầu tiên xuất hiện</tspan></text>
    <text x="660" y="300" class="num"><tspan data-lang-en>0 of 523 failed</tspan><tspan data-lang-vi>0 trên 523 lỗi</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The only difference between the two manifests is whether Kubernetes is told when a pod can take traffic. Timings come from the two kubectl watch captures.</span>
    <span data-lang-vi>Khác biệt duy nhất giữa hai manifest là Kubernetes có được báo khi nào pod nhận được traffic hay không. Thời gian lấy từ hai capture kubectl watch.</span>
  </figcaption>
</figure>

<style>
  .bep12i { margin: 2em 0; width: 100%; }
  .bep12i-scroll { overflow-x: auto; }
  .bep12i svg { display: block; width: 100%; min-width: 760px; height: auto; }
  .bep12i text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep12i .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep12i .sm { fill: var(--text-muted); font-size: 13px; }
  .bep12i .num { font-weight: 700; fill: var(--text); font-size: 20px; }
  .bep12i text.red { fill: var(--red); }
  .bep12i .bar { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.4; }
  .bep12i .bar.not { fill: var(--gold-tint-bg); }
  .bep12i .warm { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; stroke-dasharray: 4 3; }
  .bep12i .dot { fill: var(--gold-icon); }
  .bep12i .dot.red-d { fill: var(--red); }
  .bep12i .axis { stroke: var(--border); stroke-width: 1.4; }
  .bep12i figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
