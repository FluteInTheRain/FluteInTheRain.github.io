---
// n-gram lookup: the query is cut into trigrams, each trigram has a postings list,
// the lists are intersected, and only the survivors are checked for real.
// Plain inline SVG with site tokens, polygon arrowheads, no ids.
const W = 900;
const H = 380;
const grams = [
  { g: 'cac', ids: '3, 8, 41, 97…' },
  { g: 'ach', ids: '3, 8, 12, 41…' },
  { g: 'che', ids: '3, 8, 41, 63…' },
];
function arrowRight(x1: number, x2: number, y: number) {
  return { line: `M${x1},${y} L${x2 - 7},${y}`, head: `${x2 - 8},${y - 5} ${x2 - 8},${y + 5} ${x2},${y}` };
}
const rowY = (i: number) => 104 + i * 62;
const toGram = grams.map((_, i) => arrowRight(150, 200, rowY(i) + 22));
const toLists = grams.map((_, i) => arrowRight(330, 380, rowY(i) + 22));
const toInter = grams.map((_, i) => `M620,${rowY(i) + 22} L655,${rowY(i) + 22} L655,170 L683,170`);
---
<figure class="ng">
  <div class="ng-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="An n-gram search. The query cache is cut into three trigrams: cac, ach and che. Each trigram has a postings list of document numbers. The three lists are intersected, leaving documents 3, 8 and 41, and only those documents are read to confirm the match.">
    <text x="20" y="24" class="ng-h">
      <tspan data-lang-en>Searching for cache</tspan>
      <tspan data-lang-vi>Tìm chữ cache</tspan>
    </text>
    <text x="20" y="46" class="ng-sub">
      <tspan data-lang-en>Cut the query into trigrams, fetch one postings list for each, then keep only the documents in all of them.</tspan>
      <tspan data-lang-vi>Cắt câu tìm thành các trigram, lấy một postings list cho mỗi trigram, rồi chỉ giữ tài liệu có mặt ở tất cả.</tspan>
    </text>

    <rect x="20" y="104" width="130" height="144" rx="4" class="ng-box" />
    <text x="85" y="170" text-anchor="middle" class="ng-in">
      <tspan data-lang-en>Query</tspan>
      <tspan data-lang-vi>Câu tìm</tspan>
    </text>
    <text x="85" y="194" text-anchor="middle" class="ng-mono">cache</text>

    {grams.map((r, i) => (
      <g>
        <rect x="200" y={rowY(i)} width="130" height="44" rx="4" class="ng-box" />
        <text x="265" y={rowY(i) + 28} text-anchor="middle" class="ng-mono">{r.g}</text>
        <rect x="380" y={rowY(i)} width="240" height="44" rx="4" class="ng-box" />
        <text x="394" y={rowY(i) + 28} class="ng-mono">{r.ids}</text>
        <path d={toGram[i].line} class="ng-arrow" /><polygon points={toGram[i].head} class="ng-head" />
        <path d={toLists[i].line} class="ng-arrow" /><polygon points={toLists[i].head} class="ng-head" />
        <path d={toInter[i]} class="ng-arrow" />
      </g>
    ))}
    <polygon points="682,165 682,175 690,170" class="ng-head" />

    <text x="265" y="94" text-anchor="middle" class="ng-note">trigram</text>
    <text x="500" y="94" text-anchor="middle" class="ng-note">
      <tspan data-lang-en>postings list: documents with it</tspan>
      <tspan data-lang-vi>postings list: tài liệu chứa nó</tspan>
    </text>

    <rect x="690" y="130" width="190" height="80" rx="4" class="ng-box is-hit" />
    <text x="785" y="156" text-anchor="middle" class="ng-in">
      <tspan data-lang-en>In all three lists</tspan>
      <tspan data-lang-vi>Có trong cả ba list</tspan>
    </text>
    <text x="785" y="184" text-anchor="middle" class="ng-mono is-hit">3, 8, 41</text>
    <text x="785" y="234" text-anchor="middle" class="ng-note">
      <tspan data-lang-en>only these are read</tspan>
      <tspan data-lang-vi>chỉ đọc mấy tài liệu này</tspan>
    </text>
    <text x="785" y="252" text-anchor="middle" class="ng-note">
      <tspan data-lang-en>to confirm the match</tspan>
      <tspan data-lang-vi>để xác nhận khớp thật</tspan>
    </text>

    <line x1="20" x2={W - 20} y1="304" y2="304" class="ng-rule" />
    <text x="20" y="332" class="ng-in-m">
      <tspan data-lang-en>Document numbers are made up. The index is split across shards, and each shard runs this lookup on its own slice.</tspan>
      <tspan data-lang-vi>Số tài liệu chỉ để minh hoạ. Index chia ra nhiều shard, mỗi shard tự chạy phép tra này trên phần của mình.</tspan>
    </text>
    <text x="20" y="354" class="ng-note">
      <tspan data-lang-en>A trigram found in many documents filters poorly, so GitHub uses grams of varying length.</tspan>
      <tspan data-lang-vi>Trigram có ở nhiều tài liệu thì lọc yếu, nên GitHub dùng gram có độ dài thay đổi.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The lookup behind an n-gram index: one postings list per trigram, then an intersection, then a real check of the few survivors.</span>
    <span data-lang-vi>Phép tra phía sau một index n-gram: mỗi trigram một postings list, rồi lấy giao, rồi kiểm tra thật vài tài liệu sống sót.</span>
  </figcaption>
</figure>

<style>
  .ng { margin: 2em 0; width: 100%; }
  .ng-scroll { overflow-x: auto; }
  .ng svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .ng text { font-size: 14px; fill: var(--text-body); }
  .ng .ng-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ng .ng-sub, .ng .ng-zone { fill: var(--text-muted); }
  .ng .ng-zone { font-size: 13px; }
  .ng-divider { stroke: var(--border); stroke-dasharray: 6 5; }
  .ng-rule { stroke: var(--border); }
  .ng-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .ng-box.is-hot, .ng-box.is-hit { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .ng-cell { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .ng-cell.is-hit { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .ng-cell.is-dead { fill: var(--bg-alt); stroke: var(--text-muted); stroke-dasharray: 3 3; }
  .ng .ng-in { font-weight: 600; fill: var(--text); }
  .ng .ng-in-b { font-weight: 700; fill: var(--text); }
  .ng .ng-in-m { font-size: 13px; fill: var(--text-body); }
  .ng .ng-in-s { font-size: 13px; font-weight: 600; fill: var(--text); }
  .ng .ng-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; fill: var(--text-body); }
  .ng .ng-mono.is-hit { fill: var(--gold-icon); font-weight: 700; }
  .ng .ng-note { font-size: 13px; fill: var(--text-muted); }
  .ng .ng-note.is-hit { fill: var(--gold-icon); font-weight: 700; }
  .ng-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .ng-arrow.is-hit { stroke: var(--gold-icon); stroke-width: 1.8; }
  .ng-head { fill: var(--text-muted); }
  .ng-head.is-hit { fill: var(--gold-icon); }
  .ng figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
