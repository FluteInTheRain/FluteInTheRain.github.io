---
import DiagramIcon from './DiagramIcon.astro';
import NfrText from './NfrText.astro';
import NfrArrow from './NfrArrow.astro';
import NfrStep from './NfrStep.astro';
import './nfr-fig.css';
// Ten made-up requests sorted fastest to slowest, to show how the mean and the percentiles read the same list.
const W = 900;
const H = 330;
const vals = [8, 9, 9, 10, 11, 12, 13, 15, 22, 960];
const mean = vals.reduce((a, b) => a + b, 0) / vals.length; // 106.9
const X0 = 70;
const S = 560 / 960;
const TOP = 62;
const RH = 22;
---
<figure class="nf">
  <div class="nf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Ten example requests sorted from fastest to slowest, with bar length equal to response time. The mean of 106.9 ms is higher than nine of the ten requests. The median is about 11.5 ms. The slowest request took 960 ms.">
      <NfrText x={20} y={24} cls="h" en="Ten requests, sorted (made-up times, in ms)" vi="Mười request đã xếp thứ tự (thời gian tự đặt, đơn vị ms)" />
      <line x1={X0 + mean * S} y1={TOP - 8} x2={X0 + mean * S} y2={TOP + 10 * RH + 4} class="edge is-dash" />
      <NfrText x={X0 + mean * S + 8} y={TOP - 14} cls="n" en="mean 106.9 ms: nine of ten requests are faster than this" vi="trung bình 106,9 ms: chín trong mười request nhanh hơn mức này" />
      {vals.map((v, i) => (
        <g>
          <text x="52" y={TOP + i * RH + 15} text-anchor="end" class="s">{i + 1}</text>
          <rect x={X0} y={TOP + i * RH + 3} width={Math.max(v * S, 3)} height="16" rx="2" class={i === 9 ? 'bar is-red' : i === 4 || i === 5 ? 'bar is-gold' : 'bar'} />
          <text x={X0 + v * S + 8} y={TOP + i * RH + 15} class={i === 9 ? 'num is-red' : 'num'}>{v} ms</text>
        </g>
      ))}
      <NfrText x={X0 + 90} y={TOP + 4 * RH + 26} cls="n" en="p50 (median) is about 11.5 ms: the middle of the list" vi="p50 (trung vị) khoảng 11,5 ms: giá trị ở giữa danh sách" />
      <NfrText x={X0 + 90} y={TOP + 8 * RH + 15} cls="n" en="p90: 22 ms, the 9th of 10" vi="p90: 22 ms, request thứ 9 trên 10" />
      <NfrText x={X0 + 650} y={TOP + 9 * RH + 15} cls="is-red" en="the tail" vi="phần đuôi" />
      <NfrText x={20} y={H - 22} cls="s" en="One slow request drags the mean up to a number almost nobody saw. Percentiles read the list itself." vi="Một request chậm kéo số trung bình lên mức gần như không ai thực sự gặp. Percentile đọc chính danh sách." />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Bar length is the response time. The gold bars are the two middle requests that set the median.</span>
    <span data-lang-vi>Độ dài cột là thời gian phản hồi. Hai cột vàng là hai request ở giữa, quyết định trung vị.</span>
  </figcaption>
</figure>
