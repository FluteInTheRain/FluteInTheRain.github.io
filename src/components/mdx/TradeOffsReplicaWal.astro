---
// Photoroom, 2026: a lagging read replica made the primary keep its write-ahead log (WAL).
// Top: the path (backfill -> primary -> replica). Bottom: the disk, drawn to scale from the
// numbers in Photoroom's post: WAL 5 GB -> 31.7 TB, disk grown to about 43 TB, hard limit 60 TB.
// Plain inline SVG with site tokens; arrowheads are polygons, so no ids.

const W = 900;
const H = 336;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const rowY = 56;
const boxH = 64;
const bf = { x: 20, w: 170 };
const pr = { x: 330, w: 220 };
const rp = { x: 690, w: 190 };
const a1 = arrow(bf.x + bf.w, rowY + boxH / 2, pr.x, rowY + boxH / 2);
const a2 = arrow(pr.x + pr.w, rowY + boxH / 2, rp.x, rowY + boxH / 2);

// Disk bar, scale 0 to 60 TB across 860 px
const X0 = 20;
const PX = 860 / 60;
const tx = (tb: number) => X0 + tb * PX;
const barY = 232;
const barH = 34;
---
<figure class="torw">
  <div class="torw-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A large backfill job writes to the primary Postgres faster than the read replica, which serves a few BI and ETL connections, can apply the changes. The primary keeps the write-ahead log the replica still needs. That retained log grew from about 5 GB to 31.7 TB, the disk had grown to about 43 TB, and the hard limit was 60 TB.">
    <text x="20" y="26" class="torw-h">
      <tspan data-lang-en>Where the pressure came from</tspan>
      <tspan data-lang-vi>Áp lực đến từ đâu</tspan>
    </text>

    <g class="torw-box">
      <rect x={bf.x} y={rowY} width={bf.w} height={boxH} rx="8" />
      <text x={bf.x + bf.w / 2} y={rowY + 28} text-anchor="middle" class="torw-name"><tspan data-lang-en>Large backfill</tspan><tspan data-lang-vi>Backfill lớn</tspan></text>
      <text x={bf.x + bf.w / 2} y={rowY + 48} text-anchor="middle" class="torw-small"><tspan data-lang-en>many changes, fast</tspan><tspan data-lang-vi>nhiều thay đổi, rất nhanh</tspan></text>
    </g>
    <g class="torw-box is-hot">
      <rect x={pr.x} y={rowY} width={pr.w} height={boxH} rx="8" />
      <text x={pr.x + pr.w / 2} y={rowY + 28} text-anchor="middle" class="torw-name"><tspan data-lang-en>Primary Postgres</tspan><tspan data-lang-vi>Postgres chính</tspan></text>
      <text x={pr.x + pr.w / 2} y={rowY + 48} text-anchor="middle" class="torw-small"><tspan data-lang-en>keeps WAL the replica still needs</tspan><tspan data-lang-vi>giữ WAL mà replica còn cần</tspan></text>
    </g>
    <g class="torw-box">
      <rect x={rp.x} y={rowY} width={rp.w} height={boxH} rx="8" />
      <text x={rp.x + rp.w / 2} y={rowY + 28} text-anchor="middle" class="torw-name">Read replica</text>
      <text x={rp.x + rp.w / 2} y={rowY + 48} text-anchor="middle" class="torw-small"><tspan data-lang-en>a few BI and ETL jobs</tspan><tspan data-lang-vi>vài job BI và ETL</tspan></text>
    </g>
    <g class="torw-arrow"><path d={a1.line} /><polygon points={a1.head} /></g>
    <g class="torw-arrow is-slow"><path d={a2.line} /><polygon points={a2.head} /></g>
    <text x={(pr.x + pr.w + rp.x) / 2} y={rowY - 10} text-anchor="middle" class="torw-bad">
      <tspan data-lang-en>applies changes more slowly</tspan>
      <tspan data-lang-vi>áp dụng thay đổi chậm hơn</tspan>
    </text>
    <text x={(pr.x + pr.w + rp.x) / 2} y={rowY + boxH + 22} text-anchor="middle" class="torw-note">
      <tspan data-lang-en>lag grew by about 0.7 days per day</tspan>
      <tspan data-lang-vi>độ trễ tăng khoảng 0,7 ngày mỗi ngày</tspan>
    </text>

    <line x1="20" x2={W - 16} y1="176" y2="176" class="torw-rule" />
    <text x="20" y="204" class="torw-h">
      <tspan data-lang-en>The primary's disk, drawn to scale (0 to 60 TB)</tspan>
      <tspan data-lang-vi>Đĩa của DB chính, vẽ theo tỉ lệ (0 đến 60 TB)</tspan>
    </text>

    <rect x={X0} y={barY} width={tx(60) - X0} height={barH} class="torw-track" />
    <rect x={X0} y={barY} width={tx(43) - X0} height={barH} class="torw-prov" />
    <rect x={X0} y={barY} width={tx(31.7) - X0} height={barH} class="torw-wal" />
    <rect x={X0} y={barY} width={Math.max(2, tx(0.005) - X0)} height={barH} class="torw-before" />
    <line x1={tx(60)} x2={tx(60)} y1={barY - 8} y2={barY + barH + 8} class="torw-limit" />

    <text x={tx(31.7) / 2 + X0 / 2} y={barY + 22} text-anchor="middle" class="torw-inbar">
      <tspan data-lang-en>retained WAL: 31.7 TB</tspan>
      <tspan data-lang-vi>WAL bị giữ lại: 31,7 TB</tspan>
    </text>
    <text x={tx(43)} y={barY - 12} text-anchor="middle" class="torw-note">
      <tspan data-lang-en>disk grew by itself to about 43 TB</tspan>
      <tspan data-lang-vi>đĩa tự nới lên khoảng 43 TB</tspan>
    </text>
    <text x={tx(60)} y={barY + barH + 28} text-anchor="end" class="torw-bad">
      <tspan data-lang-en>hard limit: 60 TB</tspan>
      <tspan data-lang-vi>giới hạn cứng: 60 TB</tspan>
    </text>
    <text x={X0} y={barY + barH + 28} class="torw-note">
      <tspan data-lang-en>before the backfill the retained WAL was about 5 GB</tspan>
      <tspan data-lang-vi>trước backfill, WAL bị giữ chỉ khoảng 5 GB</tspan>
    </text>
    <text x={X0} y={barY + barH + 56} class="torw-note">
      <tspan data-lang-en>Estimate at the time: five to seven days until the limit, with weeks of backfill left.</tspan>
      <tspan data-lang-vi>Ước tính lúc đó: còn năm đến bảy ngày là chạm giới hạn, trong khi backfill còn chạy nhiều tuần.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>A slow follower can fill the leader's disk. Numbers are from Photoroom's post (see References); the bar is drawn to scale from them.</span>
    <span data-lang-vi>Một bản sao chạy chậm vẫn có thể làm đầy đĩa của bản chính. Số liệu lấy từ bài của Photoroom (xem Tài liệu tham khảo); thanh bên trên vẽ đúng tỉ lệ theo các số đó.</span>
  </figcaption>
</figure>

<style>
  .torw {
    margin: 2em 0;
    width: 100%;
  }
  .torw-scroll {
    overflow-x: auto;
  }
  .torw svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .torw text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .torw .torw-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .torw .torw-name {
    font-weight: 700;
    fill: var(--text);
  }
  .torw .torw-small,
  .torw .torw-note {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .torw .torw-bad {
    fill: var(--red);
    font-weight: 700;
  }
  .torw .torw-inbar {
    font-weight: 700;
    fill: var(--text);
  }
  .torw-box rect {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .torw-box.is-hot rect {
    fill: var(--red-tint-bg);
    stroke: var(--red);
  }
  .torw-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .torw-arrow polygon {
    fill: var(--text-muted);
  }
  .torw-arrow.is-slow path {
    stroke: var(--red);
    stroke-dasharray: 4 4;
  }
  .torw-arrow.is-slow polygon {
    fill: var(--red);
  }
  .torw-rule {
    stroke: var(--border);
  }
  .torw-track {
    fill: var(--bg-alt);
    stroke: var(--border);
  }
  .torw-prov {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .torw-wal {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.2;
  }
  .torw-before {
    fill: var(--text);
  }
  .torw-limit {
    stroke: var(--red);
    stroke-width: 2;
  }
  .torw figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
