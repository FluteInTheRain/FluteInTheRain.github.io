---
import BatchDiagram from './BatchDiagram.astro';
const boxes = [
  { x: 20, y: 30, w: 190, h: 64, t: ['Nearline writes', 'Ghi gần thời gian thực'], s: [['recent stream updates', 'cập nhật stream mới nhất']] },
  { x: 20, y: 210, w: 190, h: 64, t: ['Hadoop dataset', 'Dataset trên Hadoop'], s: [['computed by batch', 'do batch tính ra']] },
  { x: 320, y: 120, w: 210, h: 64, t: ['New version', 'Phiên bản mới'], s: [['loading in the background', 'nạp ngầm ở nền']] },
  { x: 650, y: 120, w: 230, h: 64, t: ['Live version', 'Phiên bản đang chạy'], s: [['all reads go here', 'mọi lượt đọc đi vào đây']], kind: 'good' },
  { x: 650, y: 250, w: 230, h: 64, t: ['Previous version', 'Phiên bản trước'], s: [['kept as a backup', 'giữ lại làm bản dự phòng']] },
];
const arrows = [
  { x1: 210, y1: 62, x2: 320, y2: 136, label: ['replay', 'phát lại'], lx: 300, ly: 100 },
  { x1: 210, y1: 242, x2: 320, y2: 168, label: ['Push Job', 'Push Job'], lx: 300, ly: 218 },
  { x1: 530, y1: 152, x2: 650, y2: 152, kind: 'good', label: ['swap', 'tráo'] },
  { x1: 765, y1: 184, x2: 765, y2: 250, kind: 'dash', label: ['demoted', 'hạ xuống'], lx: 800, ly: 222 },
];
const texts = [
  { x: 320, y: 262, cls: 'foot', t: ['Each data center swaps after its own load finishes.', 'Mỗi data center tráo khi nạp xong.'] },
  { x: 320, y: 284, cls: 'foot', t: ['Bad data? Point reads back at the previous version.', 'Dữ liệu lỗi? Trỏ luồng đọc về bản trước.'] },
] as const;
---
<BatchDiagram
  w={900} h={338}
  aria="Venice version swap. A Hadoop dataset is pushed into a new version that loads in the background while recent nearline writes are replayed on top. Reads then swap to the new version, and the previous version stays as a backup."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any}
  caption={['How Venice swaps in a batch-built dataset while reads keep running, as described in LinkedIn’s open-sourcing post.', 'Cách Venice tráo một dataset do batch dựng mà luồng đọc vẫn chạy liên tục, theo bài mở mã nguồn của LinkedIn.']}
/>
