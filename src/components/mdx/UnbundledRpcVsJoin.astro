---
import DiagramIcon from './DiagramIcon.astro';
// Checkout pricing: synchronous exchange-rate RPC versus a locally joined rate stream.
// Plain inline SVG with site CSS tokens; polygon arrowheads avoid duplicate marker ids.
const W = 900;
const H = 404;

type Box = { x: number; y: number; w: number; h: number; en: string; vi: string; sen?: string; svi?: string; hot?: boolean; good?: boolean; icon?: string };
const boxes: Box[] = [{"x": 20, "y": 98, "w": 150, "h": 56, "en": "Purchase", "vi": "Đơn mua", "icon": "receipt"}, {"x": 230, "y": 98, "w": 190, "h": 56, "en": "Checkout", "vi": "Thanh toán", "sen": "calls out per purchase", "svi": "gọi ra ngoài mỗi đơn", "icon": "server"}, {"x": 520, "y": 98, "w": 200, "h": 56, "en": "Rate service", "vi": "Dịch vụ tỷ giá", "sen": "separate team", "svi": "nhóm khác quản lý", "hot": true, "icon": "money"}, {"x": 20, "y": 288, "w": 170, "h": 60, "en": "Rate change stream", "vi": "Luồng đổi tỷ giá", "sen": "subscribed in advance", "svi": "đăng ký từ trước", "icon": "log"}, {"x": 260, "y": 288, "w": 230, "h": 60, "en": "Checkout shard", "vi": "Shard thanh toán", "sen": "keeps latest rate locally", "svi": "giữ tỷ giá mới nhất tại chỗ", "good": true, "icon": "db"}, {"x": 560, "y": 288, "w": 170, "h": 60, "en": "Priced order", "vi": "Đơn đã quy đổi", "sen": "local lookup", "svi": "tra cứu cục bộ", "icon": "receipt"}];
// [x1, y, x2, dashed, hot]
const arrows: [number, number, number, boolean, boolean | string][] = [[170, 126, 230, false, false], [420, 126, 520, true, true], [190, 318, 260, false, "good"], [490, 318, 560, false, "good"]];
// [x, y, en, vi, anchor, hot]
const notes: [number, number, string, string, string, boolean | string][] = [[20, 192, "Every purchase waits on a network call; if the rate service is slow, checkout stalls.", "Mỗi đơn đều chờ một lời gọi mạng; dịch vụ tỷ giá chậm thì thanh toán nghẽn theo.", "start", true], [20, 382, "No network hop at purchase time. On replay, join with the rate valid at the purchase time.", "Không có bước gọi mạng khi mua. Khi chạy lại, join với tỷ giá có hiệu lực lúc mua.", "start", "good"]];
const heads = (x2: number, y: number) => `${x2 - 8},${y - 4.5} ${x2 - 8},${y + 4.5} ${x2},${y}`;
---
<figure class="unb-fig">
  <div class="unb-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two ways to convert prices: a synchronous call to an exchange-rate service per purchase, versus checkout subscribing to a rate stream and joining locally.">
      <text x="20" y="26" class="unb-h"><tspan data-lang-en>Fetching the rate versus subscribing to it</tspan><tspan data-lang-vi>Gọi lấy tỷ giá hay đăng ký nhận tỷ giá</tspan></text>
      <text x="20" y="52" class="unb-lane-h"><tspan data-lang-en>Synchronous call</tspan><tspan data-lang-vi>Gọi đồng bộ</tspan></text>
      <text x="20" y="242" class="unb-lane-h"><tspan data-lang-en>Stream join</tspan><tspan data-lang-vi>Stream join</tspan></text>
      {boxes.map((b) => (
        <>
          <DiagramIcon name={b.icon} x={b.x + b.w / 2} y={b.y - 17} size={26} />
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" class={b.hot ? 'unb-box is-hot' : b.good ? 'unb-box is-good' : 'unb-box'} />
          <text x={b.x + b.w / 2} y={b.y + (b.sen ? b.h / 2 - 3 : b.h / 2 + 5)} text-anchor="middle" class="unb-in-b"><tspan data-lang-en>{b.en}</tspan><tspan data-lang-vi>{b.vi}</tspan></text>
          {b.sen && <text x={b.x + b.w / 2} y={b.y + b.h / 2 + 15} text-anchor="middle" class="unb-in-m"><tspan data-lang-en>{b.sen}</tspan><tspan data-lang-vi>{b.svi}</tspan></text>}
        </>
      ))}
      {arrows.map(([x1, y, x2, dashed, hot]) => (
        <>
          <path d={`M${x1},${y} L${x2 - 7},${y}`} class={`${dashed ? 'unb-dashed' : 'unb-solid'}${hot === 'good' ? ' is-good' : hot ? ' is-hot' : ''}`} />
          <polygon points={heads(x2, y)} class={hot === 'good' ? 'unb-head is-good' : hot ? 'unb-head is-hot' : 'unb-head'} />
        </>
      ))}
      {notes.map(([x, y, en, vi, anchor, hot]) => (
        <text x={x} y={y} text-anchor={anchor} class={hot === 'good' ? 'unb-note is-good' : hot ? 'unb-note is-hot' : 'unb-note'}><tspan data-lang-en>{en}</tspan><tspan data-lang-vi>{vi}</tspan></text>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A stream join turns a remote call into a local lookup, so checkout keeps working when the rate service is down.</span>
    <span data-lang-vi>Stream join biến lời gọi từ xa thành tra cứu cục bộ, nên thanh toán vẫn chạy khi dịch vụ tỷ giá gặp sự cố.</span>
  </figcaption>
</figure>

<style>
  .unb-fig {
    margin: 2em 0;
    width: 100%;
  }
  .unb-scroll {
    overflow-x: auto;
  }
  .unb-fig svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .unb-fig text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .unb-fig .unb-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .unb-fig .unb-sub {
    font-size: 13.5px;
    fill: var(--text-muted);
  }
  .unb-fig .unb-lane-h {
    font-size: 14.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .unb-fig .unb-lane-sub {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .unb-rule {
    stroke: var(--border);
  }
  .unb-box {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .unb-box.is-hot {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .unb-fig .unb-in-b {
    font-weight: 700;
    fill: var(--text);
    font-size: 13.5px;
  }
  .unb-fig .unb-in-m {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .unb-boundary {
    stroke: var(--red);
    stroke-width: 1.6;
    stroke-dasharray: 5 4;
  }
  .unb-fig .unb-boundary-lbl {
    font-size: 12.5px;
    font-weight: 700;
    fill: var(--red);
  }
  .unb-solid {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.8;
  }
  .unb-solid.is-hot {
    stroke: var(--red);
    stroke-width: 2;
  }
  .unb-dashed {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.4;
    stroke-dasharray: 5 4;
  }
  .unb-head {
    fill: var(--text-muted);
  }
  .unb-head.is-hot {
    fill: var(--red);
  }
  .unb-fig figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
  .unb-fig .unb-note { font-size: 13px; fill: var(--text-muted); }
  .unb-fig .unb-note.is-hot { fill: var(--red); font-weight: 700; }
  .unb-dashed.is-hot { stroke: var(--red); stroke-width: 1.8; }
  .unb-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .unb-solid.is-good { stroke: var(--gold-icon); stroke-width: 2; }
  .unb-head.is-good { fill: var(--gold-icon); }
  .unb-fig .unb-note.is-good { fill: var(--gold-icon); font-weight: 700; }
</style>
