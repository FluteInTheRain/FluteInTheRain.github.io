---
// Picture first: replication copies everything to every node, sharding splits the data.
// Plain inline SVG, site CSS tokens, DiagramIcon for nodes. Numbers are illustrative.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const A = (x1: number, y1: number, x2: number, y2: number, c = '') => {
  const a = arrow(x1, y1, x2, y2);
  return { ...a, c };
};

const W = 900;
const H = 330;
const rowsY = [80, 150, 220];
const left = rowsY.map((y) => A(140, 165, 225, y + 28, 'is-hot'));
const right = rowsY.map((y) => A(570, 165, 660, y + 28, 'is-fix'));
---
<figure class="shaa-one">
  <div class="shaa-one-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Replication versus sharding. With replication, an app sends every write to three replicas, and each replica holds all the data, so every copy hits the same disk and write limit. With sharding, the same writes are split across three shards, and each shard holds and writes about a third.">
      <line x1="450" x2="450" y1="12" y2={H - 12} class="rule" />

      <text x="20" y="26" class="h"><tspan data-lang-en>Replication: copies of everything</tspan><tspan data-lang-vi>Replication: bản sao của tất cả</tspan></text>
      <text x="20" y="46" class="sub"><tspan data-lang-en>Every replica still takes every write.</tspan><tspan data-lang-vi>Replica nào cũng vẫn nhận mọi lệnh ghi.</tspan></text>
      <text x="475" y="26" class="h"><tspan data-lang-en>Sharding: slices of the data</tspan><tspan data-lang-vi>Sharding: mỗi máy một phần dữ liệu</tspan></text>
      <text x="475" y="46" class="sub"><tspan data-lang-en>Each shard takes only its own writes.</tspan><tspan data-lang-vi>Mỗi shard chỉ nhận lệnh ghi của mình.</tspan></text>

      <rect x="20" y="125" width="120" height="80" rx="6" class="box" />
      <DiagramIcon name="laptop" x={80} y={150} size={26} />
      <text x="80" y="188" text-anchor="middle" class="b"><tspan data-lang-en>App writes</tspan><tspan data-lang-vi>App ghi</tspan></text>
      {left.map((a) => (<g><path d={a.line} class="arrow is-hot" /><polygon points={a.head} class="head is-hot" /></g>))}
      {rowsY.map((y, i) => (
        <g>
          <rect x="225" y={y} width="215" height="56" rx="6" class="box is-hot" />
          <DiagramIcon name="db" x={255} y={y + 28} size={26} />
          <text x="283" y={y + 24} class="b is-hot"><tspan data-lang-en>{`Replica ${i + 1}`}</tspan><tspan data-lang-vi>{`Replica ${i + 1}`}</tspan></text>
          <text x="283" y={y + 42} class="s"><tspan data-lang-en>all data, all writes</tspan><tspan data-lang-vi>đủ dữ liệu, đủ lệnh ghi</tspan></text>
        </g>
      ))}

      <rect x="470" y="125" width="100" height="80" rx="6" class="box" />
      <DiagramIcon name="laptop" x={520} y={150} size={26} />
      <text x="520" y="188" text-anchor="middle" class="b"><tspan data-lang-en>App writes</tspan><tspan data-lang-vi>App ghi</tspan></text>
      {right.map((a) => (<g><path d={a.line} class="arrow is-fix" /><polygon points={a.head} class="head is-fix" /></g>))}
      {rowsY.map((y, i) => (
        <g>
          <rect x="660" y={y} width="220" height="56" rx="6" class="box is-fix" />
          <DiagramIcon name="db" x={690} y={y + 28} size={26} />
          <text x="718" y={y + 24} class="b"><tspan data-lang-en>{`Shard ${i + 1}`}</tspan><tspan data-lang-vi>{`Shard ${i + 1}`}</tspan></text>
          <text x="718" y={y + 42} class="s"><tspan data-lang-en>1/3 of data and writes</tspan><tspan data-lang-vi>1/3 dữ liệu và lệnh ghi</tspan></text>
        </g>
      ))}

      <text x="20" y="312" class="s is-hot"><tspan data-lang-en>Disk and write limit are hit on every copy at once.</tspan><tspan data-lang-vi>Ổ đĩa và giới hạn ghi chạm trần trên mọi bản sao cùng lúc.</tspan></text>
      <text x="475" y="312" class="b"><tspan data-lang-en>Each node stays under its own limit.</tspan><tspan data-lang-vi>Mỗi máy vẫn dưới giới hạn của riêng nó.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Replicas multiply copies but not write capacity; shards divide the work. The thirds are illustrative: real shards are rarely this even.</span>
    <span data-lang-vi>Replica chỉ nhân bản sao chứ không nhân khả năng ghi; shard mới chia việc ra. Con số một phần ba chỉ để minh hoạ: shard thật hiếm khi đều như vậy.</span>
  </figcaption>
</figure>

<style>
  .shaa-one { margin: 2em 0; width: 100%; }
  .shaa-one-scroll { overflow-x: auto; }
  .shaa-one svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shaa-one text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shaa-one .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shaa-one .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shaa-one .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shaa-one .b.is-hot { fill: var(--red); }
  .shaa-one .s { font-size: 12px; fill: var(--text-body); }
  .shaa-one .s.is-hot { fill: var(--red); font-weight: 600; }
  .shaa-one .big { font-size: 18px; font-weight: 700; fill: var(--text); }
  .shaa-one .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shaa-one .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shaa-one .box.is-fix { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-one .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shaa-one .box.is-dim { opacity: 0.45; }
  .shaa-one .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shaa-one .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shaa-one .arrow.is-hot { stroke: var(--red); }
  .shaa-one .arrow.is-fix { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-one .head { fill: var(--text-muted); }
  .shaa-one .head.is-hot { fill: var(--red); }
  .shaa-one .head.is-fix { fill: var(--gold-icon); }
  .shaa-one figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
