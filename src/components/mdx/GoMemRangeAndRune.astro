---
// Showdown: range loop value copy vs index mutation, and UTF-8 bytes vs Unicode runes for "Phở".
const W = 900;
const H = 370;

const utf8Bytes = [
  { idx: '0', hex: '0x50', char: 'P', group: 'r0' },
  { idx: '1', hex: '0x68', char: 'h', group: 'r1' },
  { idx: '2', hex: '0xE1', char: 'ở (1/3)', group: 'r2' },
  { idx: '3', hex: '0xBB', char: 'ở (2/3)', group: 'r2' },
  { idx: '4', hex: '0x9F', char: 'ở (3/3)', group: 'r2' },
];
---
<figure class="gmrr">
  <div class="gmrr-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: range loop copies each struct into a loop variable so mutations stay local. Bottom: the string Phở occupies 5 UTF-8 bytes across 3 runes.">
      {/* Top: range value copy */}
      <text x="20" y="26" class="gmrr-h">
        <tspan data-lang-en>1. Every Go range loop copies elements by value: mutating v leaves accounts[i] untouched</tspan>
        <tspan data-lang-vi>1. Vòng lặp range luôn sao chép giá trị: sửa biến v không làm thay đổi accounts[i] gốc</tspan>
      </text>

      <rect x="16" y="44" width="236" height="82" rx="8" class="gmrr-box" />
      <text x="30" y="68" class="gmrr-b">accounts[0]</text>
      <text x="30" y="89" class="gmrr-m">balance: 100.0 (original)</text>
      <text x="30" y="110" class="gmrr-m">
        <tspan data-lang-en>lives in slice backing array</tspan>
        <tspan data-lang-vi>nằm trong mảng gốc của slice</tspan>
      </text>

      {/* Arrow copy */}
      <line x1="256" y1="84" x2="332" y2="84" class="gmrr-arrow is-red" />
      <polygon points="338,84 329,79 329,89" class="gmrr-head is-red" />
      <text x="296" y="74" text-anchor="middle" class="gmrr-sm-red">
        <tspan data-lang-en>copy</tspan>
        <tspan data-lang-vi>sao chép</tspan>
      </text>

      <rect x="342" y="44" width="260" height="82" rx="8" class="gmrr-box is-red" />
      <text x="356" y="68" class="gmrr-b-red">for _, v := range accounts</text>
      <text x="356" y="89" class="gmrr-m">v.balance += 50 → 150.0</text>
      <text x="356" y="110" class="gmrr-b-red">
        <tspan data-lang-en>Discarded next iteration</tspan>
        <tspan data-lang-vi>Mất sạch ở vòng lặp kế tiếp</tspan>
      </text>

      <rect x="622" y="44" width="264" height="82" rx="8" class="gmrr-box is-ok" />
      <text x="636" y="68" class="gmrr-b-ok">for i := range accounts</text>
      <text x="636" y="89" class="gmrr-m">accounts[i].balance += 50</text>
      <text x="636" y="110" class="gmrr-b-ok">
        <tspan data-lang-en>Mutates slice element in place</tspan>
        <tspan data-lang-vi>Sửa trực tiếp phần tử gốc</tspan>
      </text>

      <line x1="20" x2={W - 20} y1="150" y2="150" class="gmrr-rule" />

      {/* Bottom: String UTF-8 bytes vs runes */}
      <text x="20" y="180" class="gmrr-h">
        <tspan data-lang-en>2. Strings hold UTF-8 bytes, not characters: len("Phở") is 5 bytes across 3 runes</tspan>
        <tspan data-lang-vi>2. String lưu byte UTF-8 chứ không lưu ký tự: len("Phở") là 5 byte nhưng chỉ có 3 rune</tspan>
      </text>

      {utf8Bytes.map((b, i) => {
        const x = 20 + i * 172;
        const isMulti = b.group === 'r2';
        return (
          <g>
            <rect x={x} y="200" width="160" height="78" rx="6" class={isMulti ? 'gmrr-byte is-red' : 'gmrr-byte'} />
            <text x={x + 80} y="222" text-anchor="middle" class="gmrr-idx">byte [{b.idx}]</text>
            <text x={x + 80} y="245" text-anchor="middle" class={isMulti ? 'gmrr-b-red' : 'gmrr-b'}>{b.hex}</text>
            <text x={x + 80} y="266" text-anchor="middle" class="gmrr-m">{b.char}</text>
          </g>
        );
      })}

      {/* Rune spans below */}
      <rect x="20" y="294" width="160" height="48" rx="6" class="gmrr-rune" />
      <text x="100" y="315" text-anchor="middle" class="gmrr-b">Rune 0: 'P'</text>
      <text x="100" y="333" text-anchor="middle" class="gmrr-m">index i = 0 (1 byte)</text>

      <rect x="192" y="294" width="160" height="48" rx="6" class="gmrr-rune" />
      <text x="272" y="315" text-anchor="middle" class="gmrr-b">Rune 1: 'h'</text>
      <text x="272" y="333" text-anchor="middle" class="gmrr-m">index i = 1 (1 byte)</text>

      <rect x="364" y="294" width="504" height="48" rx="6" class="gmrr-rune is-red" />
      <text x="616" y="315" text-anchor="middle" class="gmrr-b-red">Rune 2: 'ở' (U+1EDF)</text>
      <text x="616" y="333" text-anchor="middle" class="gmrr-m">
        <tspan data-lang-en>range yields i = 2 · s[:3] cuts mid-rune into broken bytes</tspan>
        <tspan data-lang-vi>range trả về i = 2 · cắt s[:3] sẽ chặt đôi ký tự gây lỗi font</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Top: range always evaluates its target expression once and copies each element by value. Bottom: indexing a Go string reads raw bytes, so byte slicing breaks multi-byte UTF-8 runes like Vietnamese diacritics.</span>
    <span data-lang-vi>Trên: range chỉ tính biểu thức đích một lần và luôn copy từng phần tử theo giá trị. Dưới: truy cập s[i] đọc byte thô nên cắt byte trực tiếp dễ chặt đứt rune tiếng Việt nhiều byte.</span>
  </figcaption>
</figure>

<style>
  .gmrr { margin: 2em 0; width: 100%; }
  .gmrr-scroll { overflow-x: auto; }
  .gmrr svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gmrr text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .gmrr-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .gmrr-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .gmrr-box.is-red { fill: var(--red-tint-bg); stroke: var(--red); }
  .gmrr-box.is-ok { stroke: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gmrr-box.is-ok { stroke: rgb(74, 222, 128); }
  .gmrr-byte { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .gmrr-byte.is-red { fill: var(--red-tint-bg); stroke: var(--red); }
  .gmrr-rune { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .gmrr-rune.is-red { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .gmrr-b { font-weight: 700; fill: var(--text); }
  .gmrr-b-red { font-weight: 700; fill: var(--red); }
  .gmrr-b-ok { font-weight: 700; fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gmrr-b-ok { fill: rgb(74, 222, 128); }
  .gmrr-m { font-size: 11.5px; fill: var(--text-muted); }
  .gmrr-idx { font-size: 11px; fill: var(--text-muted); }
  .gmrr-sm-red { font-size: 11.5px; font-weight: 700; fill: var(--red); }
  .gmrr-rule { stroke: var(--border); }
  .gmrr-arrow { stroke: var(--red); stroke-width: 1.6; }
  .gmrr-head { fill: var(--red); }
  .gmrr figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
