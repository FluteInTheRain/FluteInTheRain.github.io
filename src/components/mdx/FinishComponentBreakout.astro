---
// Chapter 8: Thinking outside component conventions —
// Top: plain radio list vs selectable cards.
// Bottom: plain text dropdown vs sectioned panel with icons and descriptions.
// Plain inline SVG using site CSS tokens; no <defs> IDs needed.

const W = 900;
const H = 380;
---
<figure class="fcb">
  <div class="fcb-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left column shows plain radio buttons and a single-column text dropdown. Right column shows the same choices redesigned as selectable cards and a structured two-column menu with icons and short descriptions.">
      {/* Column titles */}
      <text x="20" y="26" class="fcb-head is-muted">
        <tspan data-lang-en>Default component habit</tspan>
        <tspan data-lang-vi>Component theo thói quen cũ</tspan>
      </text>
      <text x="350" y="26" class="fcb-head is-accent">
        <tspan data-lang-en>Designed around the user's decision</tspan>
        <tspan data-lang-vi>Thiết kế theo quyết định của người dùng</tspan>
      </text>

      {/* Row 1: Radio group vs Selectable cards */}
      <rect x="20" y="42" width="296" height="140" rx="9" class="fcb-box" />
      <text x="38" y="68" class="fcb-label">
        <tspan data-lang-en>Billing tier</tspan>
        <tspan data-lang-vi>Gói dịch vụ</tspan>
      </text>
      <circle cx="46" cy="96" r="7" class="fcb-radio" />
      <text x="62" y="101" class="fcb-item">
        <tspan data-lang-en>Hobby ($0 / mo)</tspan>
        <tspan data-lang-vi>Cá nhân ($0 / tháng)</tspan>
      </text>
      <circle cx="46" cy="128" r="7" class="fcb-radio is-on" />
      <circle cx="46" cy="128" r="3" class="fcb-radio-dot" />
      <text x="62" y="133" class="fcb-item is-strong">
        <tspan data-lang-en>Team ($29 / mo)</tspan>
        <tspan data-lang-vi>Nhóm ($29 / tháng)</tspan>
      </text>
      <circle cx="46" cy="160" r="7" class="fcb-radio" />
      <text x="62" y="165" class="fcb-item">
        <tspan data-lang-en>Scale ($99 / mo)</tspan>
        <tspan data-lang-vi>Doanh nghiệp ($99 / tháng)</tspan>
      </text>

      {/* Right: Selectable cards */}
      <g transform="translate(350, 42)">
        <rect x="0" y="0" width="166" height="140" rx="9" class="fcb-card" />
        <text x="16" y="34" class="fcb-card-title">
          <tspan data-lang-en>Hobby</tspan>
          <tspan data-lang-vi>Cá nhân</tspan>
        </text>
        <text x="16" y="64" class="fcb-price">$0</text>
        <text x="16" y="92" class="fcb-sub">
          <tspan data-lang-en>3 projects</tspan>
          <tspan data-lang-vi>3 dự án</tspan>
        </text>
        <text x="16" y="114" class="fcb-sub">
          <tspan data-lang-en>Community support</tspan>
          <tspan data-lang-vi>Hỗ trợ cộng đồng</tspan>
        </text>

        <rect x="182" y="0" width="174" height="140" rx="9" class="fcb-card is-selected" />
        <circle cx="334" cy="24" r="9" class="fcb-check-circle" />
        <path d="M 330 24 L 333 27 L 338.5 21.5" class="fcb-check-mark" />
        <text x="198" y="34" class="fcb-card-title is-accent">
          <tspan data-lang-en>Team</tspan>
          <tspan data-lang-vi>Nhóm</tspan>
        </text>
        <text x="198" y="64" class="fcb-price">$29</text>
        <text x="198" y="92" class="fcb-sub">
          <tspan data-lang-en>Unlimited projects</tspan>
          <tspan data-lang-vi>Không giới hạn dự án</tspan>
        </text>
        <text x="198" y="114" class="fcb-sub">
          <tspan data-lang-en>Audit logs + SSO</tspan>
          <tspan data-lang-vi>Nhật ký + SSO</tspan>
        </text>

        <rect x="372" y="0" width="158" height="140" rx="9" class="fcb-card" />
        <text x="388" y="34" class="fcb-card-title">
          <tspan data-lang-en>Scale</tspan>
          <tspan data-lang-vi>Doanh nghiệp</tspan>
        </text>
        <text x="388" y="64" class="fcb-price">$99</text>
        <text x="388" y="92" class="fcb-sub">
          <tspan data-lang-en>Custom SLA</tspan>
          <tspan data-lang-vi>Cam kết SLA riêng</tspan>
        </text>
        <text x="388" y="114" class="fcb-sub">
          <tspan data-lang-en>Dedicated region</tspan>
          <tspan data-lang-vi>Vùng máy chủ riêng</tspan>
        </text>
      </g>

      {/* Row 2: Plain dropdown vs Rich multi-column panel */}
      <rect x="20" y="210" width="296" height="148" rx="9" class="fcb-box" />
      <text x="38" y="236" class="fcb-label">
        <tspan data-lang-en>Plain menu list</tspan>
        <tspan data-lang-vi>Menu danh sách trơn</tspan>
      </text>
      <text x="38" y="268" class="fcb-item">
        <tspan data-lang-en>Webhooks</tspan>
        <tspan data-lang-vi>Webhooks</tspan>
      </text>
      <text x="38" y="296" class="fcb-item">
        <tspan data-lang-en>API keys</tspan>
        <tspan data-lang-vi>Khóa API</tspan>
      </text>
      <text x="38" y="324" class="fcb-item">
        <tspan data-lang-en>Audit logs</tspan>
        <tspan data-lang-vi>Nhật ký hệ thống</tspan>
      </text>
      <text x="38" y="346" class="fcb-sub">
        <tspan data-lang-en>No context on what each link opens.</tspan>
        <tspan data-lang-vi>Không rõ mỗi mục dẫn tới đâu.</tspan>
      </text>

      {/* Right: Rich two-column menu panel */}
      <rect x="350" y="210" width="530" height="148" rx="9" class="fcb-box is-polished" />
      <rect x="366" y="226" width="242" height="52" rx="6" class="fcb-menu-item is-hover" />
      <circle cx="388" cy="252" r="11" class="fcb-icon-bg" />
      <path d="M 384 252 L 388 248 L 392 252 L 388 256 Z" class="fcb-icon-fg" />
      <text x="408" y="247" class="fcb-item is-strong">
        <tspan data-lang-en>Webhooks</tspan>
        <tspan data-lang-vi>Webhooks</tspan>
      </text>
      <text x="408" y="266" class="fcb-sub">
        <tspan data-lang-en>Push events to your server</tspan>
        <tspan data-lang-vi>Đẩy sự kiện về server</tspan>
      </text>

      <rect x="622" y="226" width="242" height="52" rx="6" class="fcb-menu-item" />
      <circle cx="644" cy="252" r="11" class="fcb-icon-bg-muted" />
      <circle cx="644" cy="252" r="4" class="fcb-icon-fg-muted" />
      <text x="664" y="247" class="fcb-item is-strong">
        <tspan data-lang-en>API keys</tspan>
        <tspan data-lang-vi>Khóa API</tspan>
      </text>
      <text x="664" y="266" class="fcb-sub">
        <tspan data-lang-en>Scoped tokens &amp; rotation</tspan>
        <tspan data-lang-vi>Token phân quyền &amp; xoay vòng</tspan>
      </text>

      <rect x="366" y="290" width="242" height="52" rx="6" class="fcb-menu-item" />
      <circle cx="388" cy="316" r="11" class="fcb-icon-bg-muted" />
      <rect x="383" y="311" width="10" height="10" rx="2" class="fcb-icon-fg-muted" />
      <text x="408" y="311" class="fcb-item is-strong">
        <tspan data-lang-en>Audit logs</tspan>
        <tspan data-lang-vi>Nhật ký hệ thống</tspan>
      </text>
      <text x="408" y="330" class="fcb-sub">
        <tspan data-lang-en>Who changed what, and when</tspan>
        <tspan data-lang-vi>Ai sửa gì và vào lúc nào</tspan>
      </text>

      <rect x="622" y="290" width="242" height="52" rx="6" class="fcb-menu-item" />
      <circle cx="644" cy="316" r="11" class="fcb-icon-bg-muted" />
      <path d="M 639 316 H 649 M 644 311 V 321" class="fcb-icon-stroke-muted" />
      <text x="664" y="311" class="fcb-item is-strong">
        <tspan data-lang-en>CLI &amp; SDKs</tspan>
        <tspan data-lang-vi>CLI &amp; SDKs</tspan>
      </text>
      <text x="664" y="330" class="fcb-sub">
        <tspan data-lang-en>Test events locally</tspan>
        <tspan data-lang-vi>Chạy thử sự kiện ở local</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A radio group does not have to stay three circles, and a dropdown does not have to stay a single stack of plain words. Match the control's shape to the decision it helps the user make.</span>
    <span data-lang-vi>Nhóm radio không bắt buộc phải là ba dấu chấm tròn, và dropdown không nhất thiết phải là một cột chữ trơn. Hãy định hình component theo quyết định mà người dùng đang cần cân nhắc.</span>
  </figcaption>
</figure>

<style>
  .fcb { margin: 2em 0; width: 100%; }
  .fcb-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .fcb svg { width: 100%; min-width: 640px; height: auto; display: block; font-family: inherit; }

  .fcb-head { font-size: 15px; font-weight: 600; }
  .fcb-head.is-muted { fill: var(--text-muted); }
  .fcb-head.is-accent { fill: var(--red); }

  .fcb-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.25; }
  .fcb-box.is-polished { stroke: var(--red); stroke-opacity: 0.45; }

  .fcb-label { font-size: 13px; font-weight: 600; fill: var(--text-muted); }
  .fcb-item { font-size: 14px; fill: var(--text-body); }
  .fcb-item.is-strong { fill: var(--text); font-weight: 600; }
  .fcb-sub { font-size: 12.5px; fill: var(--text-muted); }

  .fcb-radio { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.4; }
  .fcb-radio.is-on { stroke: var(--red); }
  .fcb-radio-dot { fill: var(--red); }

  .fcb-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.25; }
  .fcb-card.is-selected { fill: var(--bg); stroke: var(--red); stroke-width: 2; }
  .fcb-card-title { font-size: 14.5px; font-weight: 600; fill: var(--text); }
  .fcb-card-title.is-accent { fill: var(--red); }
  .fcb-price { font-size: 22px; font-weight: 700; fill: var(--text); font-variant-numeric: tabular-nums; }

  .fcb-check-circle { fill: var(--red); }
  .fcb-check-mark { fill: none; stroke: #ffffff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .fcb-menu-item { fill: transparent; }
  .fcb-menu-item.is-hover { fill: var(--bg); stroke: var(--border); stroke-width: 1; }

  .fcb-icon-bg { fill: var(--red-tint-bg); }
  .fcb-icon-fg { fill: var(--red); }
  .fcb-icon-bg-muted { fill: var(--bg); stroke: var(--border); stroke-width: 1; }
  .fcb-icon-fg-muted { fill: var(--text-muted); }
  .fcb-icon-stroke-muted { stroke: var(--text-muted); stroke-width: 1.6; stroke-linecap: round; }

  .fcb figcaption { margin-top: 0.8em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
