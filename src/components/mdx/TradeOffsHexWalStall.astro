---
// How a silently failing sync filled Hex's production disk (Hex engineering blog, Nov 2022).
// Top: the stores involved, with the broken Fivetran connection in red.
// Bottom: the timeline from the tunnel rebuild to the outage.
// Plain inline SVG with site tokens; arrowheads are polygons, so no ids.

const W = 900;
const H = 372;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const rowY = 62;
const boxH = 64;
const app = { x: 20, w: 140 };
const pg = { x: 250, w: 230 };
const fv = { x: 590, w: 120 };
const sf = { x: 760, w: 120 };
const replica = { x: 250, y: 168, w: 230, h: 48 };

const aApp = arrow(app.x + app.w, rowY + boxH / 2, pg.x, rowY + boxH / 2);
const aFv = arrow(pg.x + pg.w, rowY + boxH / 2, fv.x, rowY + boxH / 2);
const aSf = arrow(fv.x + fv.w, rowY + boxH / 2, sf.x, rowY + boxH / 2);
const aRep = arrow(pg.x + pg.w / 2, rowY + boxH, replica.x + replica.w / 2, replica.y);

const tl = 276;
const events = [
  {
    x: 20,
    dayEn: 'Thu 3 Nov',
    dayVi: 'Thứ Năm 3/11',
    en: ['Tunnel rebuilt. New host,', 'new fingerprint: sync', 'fails without a sound.'],
    vi: ['Dựng lại tunnel. Máy mới,', 'fingerprint mới: đồng bộ', 'lỗi mà không báo gì.'],
  },
  {
    x: 242,
    dayEn: 'Next days',
    dayVi: 'Mấy ngày sau',
    en: ['WAL piles up on the primary.', 'Free-disk alert was muted,', 'no alert on sync failure.'],
    vi: ['WAL chất đống trên DB chính.', 'Cảnh báo đĩa trống đã tắt,', 'không có cảnh báo sync lỗi.'],
  },
  {
    x: 464,
    dayEn: 'Mon 7 Nov',
    dayVi: 'Thứ Hai 7/11',
    en: ['Disk full. RDS scales up once,', 'WAL fills the new space and', 'the resize lock holds.'],
    vi: ['Đĩa đầy. RDS nới đĩa một lần,', 'WAL lấp đầy chỗ mới và', 'khoá nới đĩa vẫn đang giữ.'],
  },
  {
    x: 686,
    dayEn: 'Recovery',
    dayVi: 'Khôi phục',
    en: ['Replica backup finishes,', 'replica is promoted.', 'About 2 h 40 min down.'],
    vi: ['Backup replica xong,', 'replica được thăng cấp.', 'Sập khoảng 2 giờ 40 phút.'],
  },
];
---
<figure class="tohw">
  <div class="tohw-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Hex's setup: the app writes to production Postgres; Fivetran reads the write-ahead log from Postgres and loads Snowflake; a read replica follows Postgres. After the tunnel was rebuilt the Fivetran connection failed, so the log was never consumed and kept growing on Postgres. Timeline: Thursday 3 November the tunnel is rebuilt; over the next days the log piles up; Monday 7 November the disk is full; the replica is promoted and the app returns after about 2 hours 40 minutes.">
    <text x="20" y="28" class="tohw-h">
      <tspan data-lang-en>What was connected</tspan>
      <tspan data-lang-vi>Các thành phần nối với nhau thế nào</tspan>
    </text>

    <g class="tohw-box">
      <rect x={app.x} y={rowY} width={app.w} height={boxH} rx="8" />
      <text x={app.x + app.w / 2} y={rowY + 28} text-anchor="middle" class="tohw-name"><tspan data-lang-en>Hex app</tspan><tspan data-lang-vi>App Hex</tspan></text>
      <text x={app.x + app.w / 2} y={rowY + 48} text-anchor="middle" class="tohw-small"><tspan data-lang-en>serves users</tspan><tspan data-lang-vi>phục vụ người dùng</tspan></text>
    </g>
    <g class="tohw-box is-hot">
      <rect x={pg.x} y={rowY} width={pg.w} height={boxH} rx="8" />
      <text x={pg.x + pg.w / 2} y={rowY + 28} text-anchor="middle" class="tohw-name"><tspan data-lang-en>Production Postgres (RDS)</tspan><tspan data-lang-vi>Postgres production (RDS)</tspan></text>
      <text x={pg.x + pg.w / 2} y={rowY + 48} text-anchor="middle" class="tohw-small"><tspan data-lang-en>WAL waits to be read</tspan><tspan data-lang-vi>WAL chờ được đọc</tspan></text>
    </g>
    <g class="tohw-box">
      <rect x={fv.x} y={rowY} width={fv.w} height={boxH} rx="8" />
      <text x={fv.x + fv.w / 2} y={rowY + 28} text-anchor="middle" class="tohw-name">Fivetran</text>
      <text x={fv.x + fv.w / 2} y={rowY + 48} text-anchor="middle" class="tohw-small"><tspan data-lang-en>sync job</tspan><tspan data-lang-vi>job đồng bộ</tspan></text>
    </g>
    <g class="tohw-box">
      <rect x={sf.x} y={rowY} width={sf.w} height={boxH} rx="8" />
      <text x={sf.x + sf.w / 2} y={rowY + 28} text-anchor="middle" class="tohw-name">Snowflake</text>
      <text x={sf.x + sf.w / 2} y={rowY + 48} text-anchor="middle" class="tohw-small"><tspan data-lang-en>analytics</tspan><tspan data-lang-vi>phân tích</tspan></text>
    </g>
    <g class="tohw-box">
      <rect x={replica.x} y={replica.y} width={replica.w} height={replica.h} rx="8" />
      <text x={replica.x + replica.w / 2} y={replica.y + 29} text-anchor="middle" class="tohw-name"><tspan data-lang-en>Read replica</tspan><tspan data-lang-vi>Read replica</tspan></text>
    </g>

    <g class="tohw-arrow"><path d={aApp.line} /><polygon points={aApp.head} /></g>
    <g class="tohw-arrow is-broken"><path d={aFv.line} /><polygon points={aFv.head} /></g>
    <g class="tohw-arrow"><path d={aSf.line} /><polygon points={aSf.head} /></g>
    <g class="tohw-arrow"><path d={aRep.line} /><polygon points={aRep.head} /></g>

    <text x="535" y={rowY - 8} text-anchor="middle" class="tohw-bad">
      <tspan data-lang-en>✕ connection fails</tspan>
      <tspan data-lang-vi>✕ kết nối lỗi</tspan>
    </text>
    <text x="535" y={rowY + boxH + 20} text-anchor="middle" class="tohw-note">
      <tspan data-lang-en>nothing reads the WAL</tspan>
      <tspan data-lang-vi>không ai đọc WAL</tspan>
    </text>
    <text x={replica.x + replica.w + 16} y={replica.y + 29} class="tohw-note">
      <tspan data-lang-en>about a minute behind, kept for analytics queries</tspan>
      <tspan data-lang-vi>chậm khoảng một phút, dành cho query phân tích</tspan>
    </text>

    <line x1="20" x2={W - 16} y1="236" y2="236" class="tohw-rule" />
    <text x="20" y="262" class="tohw-h">
      <tspan data-lang-en>What happened</tspan>
      <tspan data-lang-vi>Chuyện đã xảy ra</tspan>
    </text>
    <line x1="20" x2={W - 20} y1={tl + 4} y2={tl + 4} class="tohw-axis" />
    {events.map((e, i) => (
      <g>
        <circle cx={e.x + 5} cy={tl + 4} r="5" class={i === 2 ? 'tohw-dot is-bad' : 'tohw-dot'} />
        <text x={e.x} y={tl + 28} class="tohw-day"><tspan data-lang-en>{e.dayEn}</tspan><tspan data-lang-vi>{e.dayVi}</tspan></text>
        {e.en.map((line, k) => (
          <text x={e.x} y={tl + 48 + k * 18} class="tohw-note"><tspan data-lang-en>{line}</tspan><tspan data-lang-vi>{e.vi[k]}</tspan></text>
        ))}
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The sync job only read from production, yet its silent failure filled production's disk. Source: Hex's own write-up of the incident (see References).</span>
    <span data-lang-vi>Job đồng bộ chỉ đọc từ production, vậy mà việc nó lỗi âm thầm đã làm đầy đĩa của production. Nguồn: bài kể lại sự cố của chính Hex (xem Tài liệu tham khảo).</span>
  </figcaption>
</figure>

<style>
  .tohw {
    margin: 2em 0;
    width: 100%;
  }
  .tohw-scroll {
    overflow-x: auto;
  }
  .tohw svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .tohw text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .tohw .tohw-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .tohw .tohw-name {
    font-weight: 700;
    fill: var(--text);
  }
  .tohw .tohw-small,
  .tohw .tohw-note {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .tohw .tohw-day {
    font-weight: 700;
    fill: var(--text);
  }
  .tohw .tohw-bad {
    fill: var(--red);
    font-weight: 700;
  }
  .tohw-box rect {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .tohw-box.is-hot rect {
    fill: var(--red-tint-bg);
    stroke: var(--red);
  }
  .tohw-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .tohw-arrow polygon {
    fill: var(--text-muted);
  }
  .tohw-arrow.is-broken path {
    stroke: var(--red);
    stroke-dasharray: 4 4;
  }
  .tohw-arrow.is-broken polygon {
    fill: var(--red);
  }
  .tohw-rule {
    stroke: var(--border);
  }
  .tohw-axis {
    stroke: var(--text-faint);
    stroke-width: 1;
  }
  .tohw-dot {
    fill: var(--text-muted);
  }
  .tohw-dot.is-bad {
    fill: var(--red);
  }
  .tohw figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
