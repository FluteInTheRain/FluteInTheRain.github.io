---
// Wrap-around on two number lines. Positions are computed from the real ranges.
function head(x2: number, y2: number, a: number) { const l = 9; const p = (d: number) => `${(x2 - l * Math.cos(a + d)).toFixed(1)},${(y2 - l * Math.sin(a + d)).toFixed(1)}`; return `${x2},${y2} ${p(-0.45)} ${p(0.45)}`; }
const W = 900;
const H = 330;
// uint8 line
const u0 = 90, u1 = 810; // x of 0 and 255
// int16 line: min -32768 .. max 32767 spans 65536 values over 650px
const i0 = 100, iw = 650;
const px = (v: number) => i0 + ((v + 32768) / 65536) * iw;
const xOver = px(40000); // right of the end of the range
const xWrap = px(40000 - 65536); // -25536
---
<figure class="gp02b">
  <div class="gp02b-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two number lines. uint8 runs from 0 to 255, and 255 plus 1 wraps back to 0. int16 runs from -32768 to 32767, and 40000 is past the right end, so it wraps round to -25536.">
    <text x="20" y="24" class="h"><tspan data-lang-en>uint8: 0 to 255</tspan><tspan data-lang-vi>uint8: từ 0 đến 255</tspan></text>
    <line x1={u0} y1="92" x2={u1} y2="92" class="axis" />
    <line x1={u0} y1="84" x2={u0} y2="100" class="axis" />
    <line x1={u1} y1="84" x2={u1} y2="100" class="axis" />
    <text x={u0} y="120" text-anchor="middle" class="num strong">0</text>
    <text x={u1} y="120" text-anchor="middle" class="num strong">255</text>
    <path d={`M ${u1} 80 C ${u1} 4, ${u0} 4, ${u0 + 2} 74`} class="line-red" />
    <polygon points={head(u0, 82, Math.PI / 2 + 0.15)} class="head-red" />
    <text x="450" y="52" text-anchor="middle" class="red num"><tspan data-lang-en>255 + 1 gives 0</tspan><tspan data-lang-vi>255 + 1 ra 0</tspan></text>

    <line x1="20" x2="880" y1="152" y2="152" style="stroke: var(--border)" />

    <text x="20" y="184" class="h"><tspan data-lang-en>int16: -32768 to 32767</tspan><tspan data-lang-vi>int16: từ -32768 đến 32767</tspan></text>
    <line x1={i0} y1="262" x2={i0 + iw} y2="262" class="axis" />
    <line x1={i0 + iw} y1="262" x2={xOver} y2="262" class="ghost" />
    <line x1={i0} y1="254" x2={i0} y2="270" class="axis" />
    <line x1={i0 + iw} y1="254" x2={i0 + iw} y2="270" class="axis" />
    <text x={i0} y="292" text-anchor="middle" class="num strong">-32768</text>
    <text x={i0 + iw} y="292" text-anchor="middle" class="num strong">32767</text>
    <circle cx={xOver} cy="262" r="5" style="fill: var(--red)" />
    <text x={xOver} y="292" text-anchor="middle" class="num red">40000</text>
    <circle cx={xWrap} cy="262" r="5" style="fill: var(--text)" />
    <text x={xWrap} y="292" text-anchor="middle" class="num strong">-25536</text>
    <path d={`M ${xOver} 250 C ${xOver} 150, ${xWrap} 150, ${xWrap} 248`} class="line-red" />
    <polygon points={head(xWrap, 252, Math.PI / 2)} class="head-red" />
    <text x={(xOver + xWrap) / 2} y="204" text-anchor="middle" class="red num">
      <tspan data-lang-en>int16(40000) gives -25536</tspan><tspan data-lang-vi>int16(40000) ra -25536</tspan>
    </text>
    <text x={xOver} y="316" text-anchor="middle" class="muted">
      <tspan data-lang-en>past the end</tspan><tspan data-lang-vi>vượt quá cuối</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Past the largest value, a number goes round to the smallest. For int16 there are 65,536 slots, so 40000 lands on 40000 - 65536 = -25536. Both results match the program output above.</span>
    <span data-lang-vi>Vượt quá giá trị lớn nhất thì số quay về đầu bên kia. int16 có 65.536 ô, nên 40000 rơi vào 40000 - 65536 = -25536. Cả hai kết quả khớp output của chương trình ở trên.</span>
  </figcaption>
</figure>

<style>
  .gp02b { margin: 2em 0; width: 100%; }
  .gp02b-scroll { overflow-x: auto; }
  .gp02b svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp02b text { font-size: 14px; fill: var(--text-body); }
  .gp02b .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .gp02b .muted { fill: var(--text-muted); }
  .gp02b .strong { font-weight: 700; fill: var(--text); }
  .gp02b .red { fill: var(--red); font-weight: 700; }
  .gp02b .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp02b .box-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .gp02b .ghost { fill: none; stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .gp02b .axis { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp02b .line { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp02b .line-red { stroke: var(--red); stroke-width: 1.8; fill: none; }
  .gp02b .head { fill: var(--text-muted); }
  .gp02b .head-red { fill: var(--red); }
  .gp02b .num { font-variant-numeric: tabular-nums; }
  .gp02b figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
