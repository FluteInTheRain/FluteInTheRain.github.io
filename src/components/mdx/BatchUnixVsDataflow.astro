---
// Three ways to chain batch stages: Unix pipes (in-memory stream with backpressure),
// Hadoop MapReduce (replicated HDFS barriers between jobs), and modern Dataflow
// engines like Spark & Flink (operator fusion + local shuffle + lineage/snapshots).
// Plain inline SVG with site tokens; polygon arrowheads avoid duplicate marker ids.

const W = 900;
const H = 532;

function arrowRight(x1: number, x2: number, y: number) {
  return {
    line: `M${x1},${y} L${x2 - 7},${y}`,
    head: `${x2 - 8},${y - 4.5} ${x2 - 8},${y + 4.5} ${x2},${y}`,
  };
}

const uArrows = [
  arrowRight(136, 166, 94),
  arrowRight(276, 356, 94),
  arrowRight(502, 532, 94),
  arrowRight(662, 694, 94),
];

const mArrows = [
  { ...arrowRight(138, 168, 244), hot: false },
  { ...arrowRight(358, 390, 244), hot: true },
  { ...arrowRight(556, 588, 244), hot: true },
  { ...arrowRight(744, 774, 244), hot: false },
];

const dArrows = [
  arrowRight(182, 210, 424),
  arrowRight(418, 514, 424),
  arrowRight(722, 752, 424),
];
import DiagramIcon from './DiagramIcon.astro';
---
<figure class="bvd">
  <div class="bvd-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Comparison of Unix pipes, Hadoop MapReduce, and modern Dataflow engines like Spark and Flink. Unix pipes stream records through RAM buffers. MapReduce writes replicated HDFS files and stalls at a barrier between jobs. Dataflow engines fuse operators and pipeline shuffle data locally or over memory.">
    {/* 1. Unix pipe */}
    <text x="20" y="26" class="bvd-h">
      <tspan data-lang-en>1. Unix pipe (single machine)</tspan>
      <tspan data-lang-vi>1. Unix pipe (một máy đơn)</tspan>
    </text>
    <text x="20" y="48" class="bvd-sub">
      <tspan data-lang-en>Streams records line-by-line through small RAM buffers with automatic backpressure.</tspan>
      <tspan data-lang-vi>Đẩy từng dòng qua bộ đệm nhỏ trong RAM, tự điều tiết ngược (backpressure) khi bị nghẽn.</tspan>
    </text>

    <rect x="20" y="70" width="116" height="48" rx="4" class="bvd-box" />
    <text x="90" y="90" text-anchor="middle" class="bvd-in-b">access.log</text>
    <text x="90" y="108" text-anchor="middle" class="bvd-in-m">
      <tspan data-lang-en>raw text file</tspan>
      <tspan data-lang-vi>file log thô</tspan>
    </text>

    <rect x="166" y="70" width="110" height="48" rx="4" class="bvd-box" />
    <text x="231" y="90" text-anchor="middle" class="bvd-in-b">awk</text>
    <text x="231" y="108" text-anchor="middle" class="bvd-in-m">
      <tspan data-lang-en>extract URL</tspan>
      <tspan data-lang-vi>tách URL</tspan>
    </text>

    <text x="316" y="83" text-anchor="middle" class="bvd-note">
      <tspan data-lang-en>RAM pipe</tspan>
      <tspan data-lang-vi>ống RAM</tspan>
    </text>

    <rect x="356" y="70" width="146" height="48" rx="4" class="bvd-box" />
    <text x="439" y="90" text-anchor="middle" class="bvd-in-b">sort -S 8M</text>
    <text x="439" y="108" text-anchor="middle" class="bvd-in-m">
      <tspan data-lang-en>spill if &gt; 8 MiB</tspan>
      <tspan data-lang-vi>tràn ra đĩa</tspan>
    </text>

    <rect x="532" y="70" width="130" height="48" rx="4" class="bvd-box" />
    <text x="607" y="90" text-anchor="middle" class="bvd-in-b">uniq -c</text>
    <text x="607" y="108" text-anchor="middle" class="bvd-in-m">
      <tspan data-lang-en>count adjacent</tspan>
      <tspan data-lang-vi>đếm dòng kề</tspan>
    </text>

    <rect x="694" y="70" width="186" height="48" rx="4" class="bvd-box" />
    <text x="797" y="90" text-anchor="middle" class="bvd-in-b">sort -rn | head</text>
    <text x="797" y="108" text-anchor="middle" class="bvd-in-m">
      <tspan data-lang-en>top 5 URLs</tspan>
      <tspan data-lang-vi>5 URL đầu bảng</tspan>
    </text>

    {uArrows.map((a) => (
      <g><path d={a.line} class="bvd-arrow" /><polygon points={a.head} class="bvd-head" /></g>
    ))}

    <line x1="20" x2={W - 20} y1="146" y2="146" class="bvd-rule" />

    {/* 2. MapReduce */}
    <text x="20" y="176" class="bvd-h">
      <tspan data-lang-en>2. Hadoop MapReduce (hard job barriers)</tspan>
      <tspan data-lang-vi>2. Hadoop MapReduce (rào chắn cứng giữa các job)</tspan>
    </text>
    <text x="20" y="198" class="bvd-sub">
      <tspan data-lang-en>Every step writes intermediate output back to replicated HDFS and stalls the next job until all tasks finish.</tspan>
      <tspan data-lang-vi>Mỗi bước ghi dữ liệu trung gian ra HDFS (nhân 3 bản) rồi chặn job sau tới khi mọi task xong hết.</tspan>
    </text>

    <rect x="20" y="218" width="118" height="52" rx="4" class="bvd-box" />
    <text x="93" y="240" text-anchor="middle" class="bvd-in-b">HDFS input</text>
    <text x="93" y="258" text-anchor="middle" class="bvd-in-m">
      <tspan data-lang-en>3× blocks</tspan>
      <tspan data-lang-vi>3× block</tspan>
    </text>

    <rect x="168" y="218" width="190" height="52" rx="4" class="bvd-box" />
    <text x="273" y="240" text-anchor="middle" class="bvd-in-b">
      <tspan data-lang-en>Job 1: map + reduce</tspan>
      <tspan data-lang-vi>Job 1: map + reduce</tspan>
    </text>
    <text x="273" y="258" text-anchor="middle" class="bvd-in-m">
      <tspan data-lang-en>new JVM per task</tspan>
      <tspan data-lang-vi>bật JVM mới mỗi task</tspan>
    </text>

    <rect x="390" y="218" width="166" height="52" rx="4" class="bvd-box is-hot" />
    <text x="483" y="240" text-anchor="middle" class="bvd-in-b is-hot">HDFS temp (3×)</text>
    <text x="483" y="258" text-anchor="middle" class="bvd-in-m">
      <tspan data-lang-en>full stage barrier</tspan>
      <tspan data-lang-vi>rào chắn toàn job</tspan>
    </text>

    <rect x="588" y="218" width="156" height="52" rx="4" class="bvd-box" />
    <text x="676" y="240" text-anchor="middle" class="bvd-in-b">
      <tspan data-lang-en>Job 2: top 5 sort</tspan>
      <tspan data-lang-vi>Job 2: top 5</tspan>
    </text>
    <text x="676" y="258" text-anchor="middle" class="bvd-in-m">
      <tspan data-lang-en>new JVM startup</tspan>
      <tspan data-lang-vi>khởi động lại JVM</tspan>
    </text>

    <rect x="774" y="218" width="106" height="52" rx="4" class="bvd-box" />
    <text x="841" y="240" text-anchor="middle" class="bvd-in-b">HDFS out</text>
    <text x="841" y="258" text-anchor="middle" class="bvd-in-m">
      <tspan data-lang-en>3× blocks</tspan>
      <tspan data-lang-vi>3× block</tspan>
    </text>

    {mArrows.map((a) => (
      <g>
        <path d={a.line} class={a.hot ? 'bvd-arrow is-hot' : 'bvd-arrow'} />
        <polygon points={a.head} class={a.hot ? 'bvd-head is-hot' : 'bvd-head'} />
      </g>
    ))}

    <text x="473" y="294" text-anchor="middle" class="bvd-warn">
      <tspan data-lang-en>Bottleneck: Job 2 sits idle while intermediate files write 3× across the network</tspan>
      <tspan data-lang-vi>Nút thắt: Job 2 ngồi chờ trong lúc dữ liệu trung gian ghi nhân 3 bản qua mạng</tspan>
    </text>

    <line x1="20" x2={W - 20} y1="322" y2="322" class="bvd-rule" />

    {/* 3. Dataflow engine */}
    <text x="20" y="352" class="bvd-h">
      <tspan data-lang-en>3. Dataflow engine (Spark, Flink)</tspan>
      <tspan data-lang-vi>3. Engine dataflow (Spark, Flink)</tspan>
    </text>
    <text x="20" y="374" class="bvd-sub">
      <tspan data-lang-en>Treats the whole DAG as one job, fuses narrow operators, and avoids 3× DFS writes between stages.</tspan>
      <tspan data-lang-vi>Chạy cả DAG như một job duy nhất, gộp các bước cùng shard và bỏ ghi trung gian 3× lên DFS.</tspan>
    </text>

    <rect x="20" y="396" width="162" height="54" rx="4" class="bvd-box" />
    <text x="111" y="418" text-anchor="middle" class="bvd-in-b">Object store</text>
    <text x="111" y="436" text-anchor="middle" class="bvd-in-m">Parquet / Iceberg</text>

    <rect x="210" y="396" width="208" height="54" rx="4" class="bvd-box" />
    <text x="314" y="418" text-anchor="middle" class="bvd-in-b">Stage 1: scan + filter + map</text>
    <text x="314" y="436" text-anchor="middle" class="bvd-in-m">
      <tspan data-lang-en>fused in one process</tspan>
      <tspan data-lang-vi>gộp trong một tiến trình</tspan>
    </text>

    <text x="466" y="412" text-anchor="middle" class="bvd-note">shuffle</text>
    <text x="466" y="445" text-anchor="middle" class="bvd-note">
      <tspan data-lang-en>RAM / disk</tspan>
      <tspan data-lang-vi>RAM / đĩa</tspan>
    </text>

    <rect x="514" y="396" width="208" height="54" rx="4" class="bvd-box" />
    <text x="618" y="418" text-anchor="middle" class="bvd-in-b">Stage 2: agg + top 5</text>
    <text x="618" y="436" text-anchor="middle" class="bvd-in-m">
      <tspan data-lang-en>starts as blocks stream in</tspan>
      <tspan data-lang-vi>chạy ngay khi dữ liệu tới</tspan>
    </text>

    <rect x="752" y="396" width="128" height="54" rx="4" class="bvd-box" />
    <text x="830" y="418" text-anchor="middle" class="bvd-in-b">
      <tspan data-lang-en>Final output</tspan>
      <tspan data-lang-vi>Đầu ra cuối</tspan>
    </text>
    <text x="830" y="436" text-anchor="middle" class="bvd-in-m">
      <tspan data-lang-en>one commit</tspan>
      <tspan data-lang-vi>commit 1 lần</tspan>
    </text>

    {dArrows.map((a) => (
      <g><path d={a.line} class="bvd-arrow" /><polygon points={a.head} class="bvd-head" /></g>
    ))}

    <text x="20" y="482" class="bvd-foot">
      <tspan data-lang-en>Preemption recovery: if a spot worker is killed mid-stage, Spark recomputes only the lost partition from</tspan>
      <tspan data-lang-vi>Khôi phục khi bị thu hồi spot: nếu một worker bị ngắt giữa chừng, Spark tính lại đúng phân mảnh bị mất</tspan>
    </text>
    <text x="20" y="502" class="bvd-foot">
      <tspan data-lang-en>its lineage graph; Flink rolls back to periodic asynchronous task snapshots.</tspan>
      <tspan data-lang-vi>từ đồ thị phả hệ (lineage); còn Flink lùi về bản chụp (snapshot) định kỳ bất đồng bộ.</tspan>
    </text>
    {/* icons */}
    <DiagramIcon name="file" x={36} y={94.0} size={20} />
    <DiagramIcon name="worker" x={185} y={94.0} size={22} />
    <DiagramIcon name="worker" x={551} y={94.0} size={22} />
    <DiagramIcon name="chart" x={713} y={94.0} size={22} />
    <DiagramIcon name="hadoop" x={36} y={244.0} size={20} />
    <DiagramIcon name="worker" x={187} y={244.0} size={22} />
    <DiagramIcon name="hadoop" x={409} y={244.0} size={22} />
    <DiagramIcon name="worker" x={607} y={244.0} size={22} />
    <DiagramIcon name="hadoop" x={790} y={244.0} size={20} />
    <DiagramIcon name="s3" x={39} y={423.0} size={22} />
    <DiagramIcon name="package" x={770} y={423.0} size={20} />
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Why Google retired MapReduce in favor of dataflow engines: MapReduce treats each stage boundary as a hard HDFS barrier, multiplying network and disk writes by the replication factor. Dataflow engines bring back Unix-style pipelining across cluster nodes.</span>
    <span data-lang-vi>Lý do Google khai tử MapReduce để chuyển sang engine dataflow: MapReduce biến mỗi ranh giới job thành một rào chắn ghi xuống HDFS, nhân khối lượng I/O đĩa và mạng lên theo hệ số sao chép. Engine dataflow mang luồng xử lý kiểu Unix lên quy mô cụm máy.</span>
  </figcaption>
</figure>

<style>
  .bvd {
    margin: 2em 0;
    width: 100%;
  }
  .bvd-scroll {
    overflow-x: auto;
  }
  .bvd svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .bvd text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .bvd .bvd-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .bvd .bvd-sub {
    fill: var(--text-muted);
  }
  .bvd-rule {
    stroke: var(--border);
  }
  .bvd-box {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .bvd-box.is-hot {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .bvd .bvd-in-b {
    font-size: 13.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .bvd .bvd-in-b.is-hot {
    fill: var(--red);
  }
  .bvd .bvd-in-m {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .bvd .bvd-note {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .bvd .bvd-warn {
    font-size: 13px;
    font-weight: 600;
    fill: var(--red);
  }
  .bvd .bvd-foot {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .bvd-arrow {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.4;
  }
  .bvd-arrow.is-hot {
    stroke: var(--red);
    stroke-width: 1.8;
  }
  .bvd-head {
    fill: var(--text-muted);
  }
  .bvd-head.is-hot {
    fill: var(--red);
  }
  .bvd figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
