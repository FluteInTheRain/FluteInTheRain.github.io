---
// Values come from the output shown in the post: arrays: [1 2 3] [99 2 3], slices: [99 2 3] [99 2 3].
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

---
<figure class="gp03a">
  <div class="gp03a-scroll">
  <svg viewBox="0 0 900 260" role="img" aria-label="Left: an array assignment makes a second, separate list of three numbers. Right: a slice assignment gives a second name for the same list.">
<text x="20" y="22" class="h"><tspan data-lang-en>Array: assignment copies</tspan><tspan data-lang-vi>Array: phép gán sao chép</tspan></text>
    <text x="470" y="22" class="h"><tspan data-lang-en>Slice: assignment shares</tspan><tspan data-lang-vi>Slice: phép gán dùng chung</tspan></text>
    <line x1="450" x2="450" y1="10" y2="250" class="ln thin" />
    <text x="20" y="85" class="strong">arr</text>
    <rect x="90" y="60" width="64" height="40" rx="4" class="cell" />
    <text x="122.0" y="85.0" text-anchor="middle" class="num">1</text>
    <rect x="154" y="60" width="64" height="40" rx="4" class="cell" />
    <text x="186.0" y="85.0" text-anchor="middle" class="num">2</text>
    <rect x="218" y="60" width="64" height="40" rx="4" class="cell" />
    <text x="250.0" y="85.0" text-anchor="middle" class="num">3</text>
    <text x="20" y="175" class="strong">arr2</text>
    <rect x="90" y="150" width="64" height="40" rx="4" class="cell hot" />
    <text x="122.0" y="175.0" text-anchor="middle" class="num hot">99</text>
    <rect x="154" y="150" width="64" height="40" rx="4" class="cell" />
    <text x="186.0" y="175.0" text-anchor="middle" class="num">2</text>
    <rect x="218" y="150" width="64" height="40" rx="4" class="cell" />
    <text x="250.0" y="175.0" text-anchor="middle" class="num">3</text>
    <text x="90" y="125" class="mut"><tspan data-lang-en>two separate lists</tspan><tspan data-lang-vi>hai danh sách riêng</tspan></text>
    <text x="90" y="215" class="mut"><tspan data-lang-en>changing arr2 leaves arr alone</tspan><tspan data-lang-vi>sửa arr2 không đụng tới arr</tspan></text>
    <rect x="580" y="100" width="64" height="40" rx="4" class="cell hot" />
    <text x="612.0" y="125.0" text-anchor="middle" class="num hot">99</text>
    <rect x="644" y="100" width="64" height="40" rx="4" class="cell" />
    <text x="676.0" y="125.0" text-anchor="middle" class="num">2</text>
    <rect x="708" y="100" width="64" height="40" rx="4" class="cell" />
    <text x="740.0" y="125.0" text-anchor="middle" class="num">3</text>
    <rect x="580" y="40" width="64" height="30" rx="4" class="box" />
    <text x="612" y="60" text-anchor="middle" class="strong">s</text>
    {(() => { const a = arrow(612, 70, 612, 96); return <g><path d={a.line} class="ln" /><polygon points={a.head} fill="var(--text-muted)" /></g>; })()}
    <rect x="580" y="170" width="64" height="30" rx="4" class="box" />
    <text x="612" y="190" text-anchor="middle" class="strong">s2</text>
    {(() => { const a = arrow(612, 170, 612, 144); return <g><path d={a.line} class="ln" /><polygon points={a.head} fill="var(--text-muted)" /></g>; })()}
    <text x="680" y="75" class="mut"><tspan data-lang-en>one list, two names</tspan><tspan data-lang-vi>một danh sách, hai tên</tspan></text>
    <text x="680" y="215" class="mut"><tspan data-lang-en>changing s2 changes s too</tspan><tspan data-lang-vi>sửa s2 là sửa luôn s</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Assigning an array copies the numbers, so arr2[0] = 99 changes only arr2. Assigning a slice copies nothing: s and s2 are two names for the same elements.</span>
    <span data-lang-vi>Gán array là sao chép các số, nên arr2[0] = 99 chỉ đổi arr2. Gán slice không sao chép gì: s và s2 là hai tên của cùng một dãy phần tử.</span>
  </figcaption>
</figure>

<style>
  .gp03a { margin: 2em 0; width: 100%; }
  .gp03a-scroll { overflow-x: auto; }
  .gp03a svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp03a text { font-size: 14px; fill: var(--text-body); }
  .gp03a .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp03a .mut { fill: var(--text-muted); }
  .gp03a .strong { font-weight: 700; fill: var(--text); }
  .gp03a .num { font-variant-numeric: tabular-nums; font-weight: 700; fill: var(--text); }
  .gp03a .cell { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp03a .cell.free { fill: none; stroke-dasharray: 4 3; stroke: var(--border); }
  .gp03a .cell.hot { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp03a text.hot { fill: var(--red); font-weight: 700; }
  .gp03a .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp03a .box.hot { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp03a .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp03a .ln.thin { stroke: var(--border); stroke-width: 1; }
  .gp03a .ln.dash { stroke-dasharray: 3 4; }
  .gp03a .ln.hot { stroke: var(--red); }
  .gp03a .hd { fill: var(--text-muted); }
  .gp03a .hd.hot { fill: var(--red); }
  .gp03a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
