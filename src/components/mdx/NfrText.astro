---
// Bilingual SVG text. `en` / `vi` are a string or an array of lines (each line is its own tspan row).
interface Props { x: number; y: number; en: string | string[]; vi?: string | string[]; cls?: string; anchor?: 'start' | 'middle' | 'end'; lh?: number }
const { x, y, en, vi = en, cls = '', anchor = 'start', lh = 15 } = Astro.props;
const lines = (v: string | string[]) => (Array.isArray(v) ? v : [v]);
---
<text x={x} y={y} class={cls} text-anchor={anchor}>
  {lines(en).map((l, i) => <tspan data-lang-en x={x} dy={i ? lh : 0}>{l}</tspan>)}
  {lines(vi).map((l, i) => <tspan data-lang-vi x={x} dy={i ? lh : 0}>{l}</tspan>)}
</text>
