---
// Values come from the output shown in the post: len=0 nil=true / len=0 nil=false, and {"items":null} {"items":[]}.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

import DiagramIcon from './DiagramIcon.astro';
---
<figure class="gp03d">
  <div class="gp03d-scroll">
  <svg viewBox="0 0 900 225" role="img" aria-label="Two zero-length slices. The nil slice made with var s []string becomes null in JSON. The empty slice made with []string{} becomes an empty array.">
<text x="20" y="22" class="hd"><tspan data-lang-en>How it was made</tspan><tspan data-lang-vi>Cách tạo</tspan></text>
    <text x="330" y="22" class="hd"><tspan data-lang-en>What the program sees</tspan><tspan data-lang-vi>Chương trình thấy gì</tspan></text>
    <text x="640" y="22" class="hd"><tspan data-lang-en>JSON the client gets</tspan><tspan data-lang-vi>JSON client nhận được</tspan></text>
    <rect x="20" y="40" width="230" height="50" rx="6" class="box" />
    <DiagramIcon name="code" x={46} y={65} size={26} />
    <text x="145" y="70" text-anchor="middle" class="strong">var s []string</text>
    {(() => { const a = arrow(250, 65, 320, 65); return <g><path d={a.line} class="ln" /><polygon points={a.head} fill="var(--text-muted)" /></g>; })()}
    <rect x="330" y="40" width="230" height="50" rx="6" class="box" />
    <DiagramIcon name="struct" x={356} y={65} size={26} />
    <text x="458" y="70" text-anchor="middle" class="strong">len=0 nil=true</text>
    {(() => { const a = arrow(560, 65, 630, 65); return <g><path d={a.line} class="ln hot fm-flow" /><polygon points={a.head} fill="var(--red)" /></g>; })()}
    <rect x="640" y="40" width="240" height="50" rx="6" class="box hot fm-pulse" />
    <DiagramIcon name="doc" x={666} y={65} size={26} />
    <text x="772" y="70" text-anchor="middle" class="strong hot">{'{"items":null}'}</text>
    <rect x="20" y="130" width="230" height="50" rx="6" class="box" />
    <DiagramIcon name="code" x={46} y={155} size={26} />
    <text x="145" y="160" text-anchor="middle" class="strong">{'s = []string{}'}</text>
    {(() => { const a = arrow(250, 155, 320, 155); return <g><path d={a.line} class="ln" /><polygon points={a.head} fill="var(--text-muted)" /></g>; })()}
    <rect x="330" y="130" width="230" height="50" rx="6" class="box" />
    <DiagramIcon name="struct" x={356} y={155} size={26} />
    <text x="458" y="160" text-anchor="middle" class="strong">len=0 nil=false</text>
    {(() => { const a = arrow(560, 155, 630, 155); return <g><path d={a.line} class="ln" /><polygon points={a.head} fill="var(--text-muted)" /></g>; })()}
    <rect x="640" y="130" width="240" height="50" rx="6" class="box" />
    <DiagramIcon name="doc" x={666} y={155} size={26} />
    <text x="772" y="160" text-anchor="middle" class="strong">{'{"items":[]}'}</text>
    <text x="880" y="104" text-anchor="end" class="hot"><tspan data-lang-en>a client loop over this breaks</tspan><tspan data-lang-vi>vòng lặp ở client sẽ hỏng</tspan></text>
    <text x="640" y="194" class="mut"><tspan data-lang-en>an empty list</tspan><tspan data-lang-vi>một danh sách rỗng</tspan></text>
    <text x="20" y="104" class="mut"><tspan data-lang-en>nothing created yet</tspan><tspan data-lang-vi>chưa tạo gì cả</tspan></text>
    <text x="20" y="194" class="mut"><tspan data-lang-en>created, holds zero items</tspan><tspan data-lang-vi>đã tạo, chứa 0 phần tử</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Both slices have len 0, but encoding/json writes the nil one as null and the empty one as []. A client that loops over the response needs the second.</span>
    <span data-lang-vi>Cả hai slice đều có len 0, nhưng encoding/json ghi slice nil thành null và slice rỗng thành []. Client lặp qua kết quả cần dạng thứ hai.</span>
  </figcaption>
</figure>

<style>
  .gp03d { margin: 2em 0; width: 100%; }
  .gp03d-scroll { overflow-x: auto; }
  .gp03d svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp03d text { font-size: 14px; fill: var(--text-body); }
  .gp03d .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp03d .mut { fill: var(--text-muted); }
  .gp03d .strong { font-weight: 700; fill: var(--text); }
  .gp03d .num { font-variant-numeric: tabular-nums; font-weight: 700; fill: var(--text); }
  .gp03d .cell { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp03d .cell.free { fill: none; stroke-dasharray: 4 3; stroke: var(--border); }
  .gp03d .cell.hot { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp03d text.hot { fill: var(--red); font-weight: 700; }
  .gp03d .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp03d .box.hot { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp03d .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp03d .ln.thin { stroke: var(--border); stroke-width: 1; }
  .gp03d .ln.dash { stroke-dasharray: 3 4; }
  .gp03d .ln.hot { stroke: var(--red); }
  .gp03d .hd { fill: var(--text-muted); }
  .gp03d .hd.hot { fill: var(--red); }
  .gp03d figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
