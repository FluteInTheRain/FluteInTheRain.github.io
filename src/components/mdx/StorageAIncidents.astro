---
// Four incidents from the post, one card each: who, what the engine did, what it cost.
// Numbers are the ones quoted in the post's own text. Plain inline SVG, site tokens, no ids.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 372;
const EN = { 'data-lang-en': '' };
const VI = { 'data-lang-vi': '' };
const cw = 198;
const gap = 28;
const x0 = 20;
const cards = [
  {
    icon: 'discord',
    nameEn: 'Discord, 2017', nameVi: 'Discord, 2017',
    causeEn: ['Millions of deletes left', 'tombstones. Cassandra had', 'to step over every one.'],
    causeVi: ['Hàng triệu lệnh xoá để lại', 'tombstone. Cassandra phải', 'bước qua từng cái.'],
    resEn: ['One message left in the', 'channel took 20 s to load'],
    resVi: ['Kênh chỉ còn một tin mà', 'tải mất 20 giây'],
    tone: 'bad', secEn: 'Read in section 2', secVi: 'Đọc ở mục 2',
  },
  {
    icon: 'car',
    nameEn: 'Uber, 2016', nameVi: 'Uber, 2016',
    causeEn: ['Postgres wrote a new copy', 'of the row plus an entry', 'in every index.'],
    causeVi: ['Postgres ghi bản sao mới', 'của dòng, cộng một entry', 'trong mọi index.'],
    resEn: ['One column changed,', 'all 12 indexes written'],
    resVi: ['Sửa một cột mà cả 12', 'index đều bị ghi'],
    tone: 'bad', secEn: 'Read in section 4', secVi: 'Đọc ở mục 4',
  },
  {
    icon: 'shopify',
    nameEn: 'Shopify, 2022', nameVi: 'Shopify, 2022',
    causeEn: ['Random UUIDv4 keys land in', 'any B-tree page. ULIDs land', 'in the last one.'],
    causeVi: ['UUIDv4 ngẫu nhiên rơi vào', 'trang B-tree bất kỳ. ULID', 'rơi vào trang cuối.'],
    resEn: ['Switching to ULIDs cut', 'INSERT duration by 50%'],
    resVi: ['Đổi sang ULID giúp thời', 'gian INSERT giảm 50%'],
    tone: 'good', secEn: 'Read in section 3', secVi: 'Đọc ở mục 3',
  },
  {
    icon: 'github',
    nameEn: 'GitHub, 2023', nameVi: 'GitHub, 2023',
    causeEn: ['grep reads all 115 TB of', 'code on every query: 2,048', 'cores busy for 96 seconds.'],
    causeVi: ['grep đọc hết 115 TB code', 'ở mỗi truy vấn: 2.048 nhân', 'bận trong 96 giây.'],
    resEn: ['An n-gram index answers', 'in about 100 ms', 'per shard'],
    resVi: ['Index n-gram trả lời', 'trong khoảng 100 ms', 'mỗi shard'],
    tone: 'good', secEn: 'Read in section 6', secVi: 'Đọc ở mục 6',
  },
];
---
<figure class="inc">
  <div class="inc-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four production incidents. Discord, 2017: millions of deleted messages left tombstones and one remaining message took 20 seconds to load. Uber, 2016: changing one column in Postgres wrote a new row copy and updated all 12 indexes. Shopify, 2022: switching from random UUIDv4 to time-ordered ULID keys cut INSERT duration by 50 percent. GitHub, 2023: grep over 115 TB of code would keep 2,048 cores busy for 96 seconds, while an n-gram index answers in about 100 milliseconds per shard.">
    <text x="20" y="24" class="inc-h">
      <tspan data-lang-en>Four teams, four surprises</tspan>
      <tspan data-lang-vi>Bốn team, bốn bất ngờ</tspan>
    </text>
    <text x="20" y="46" class="inc-sub">
      <tspan data-lang-en>Each one traces back to how the storage engine lays out data.</tspan>
      <tspan data-lang-vi>Chuyện nào cũng lần ngược về cách storage engine xếp dữ liệu.</tspan>
    </text>
    {cards.map((c, i) => {
      const x = x0 + i * (cw + gap);
      return (
        <g>
          <rect x={x} y="64" width={cw} height="296" rx="6" class="inc-box" />
          <DiagramIcon name={c.icon} x={x + 30} y={96} size={30} />
          <text x={x + 58} y="102" class="inc-in-b">
            <tspan data-lang-en>{c.nameEn}</tspan>
            <tspan data-lang-vi>{c.nameVi}</tspan>
          </text>
          <text x={x + 14} y="140" class="inc-small">
            <tspan data-lang-en>What the engine did</tspan>
            <tspan data-lang-vi>Engine đã làm gì</tspan>
          </text>
          <g {...EN}>{c.causeEn.map((t, k) => <text x={x + 14} y={162 + k * 18} class="inc-in-m">{t}</text>)}</g>
          <g {...VI}>{c.causeVi.map((t, k) => <text x={x + 14} y={162 + k * 18} class="inc-in-m">{t}</text>)}</g>
          <rect x={x + 10} y="226" width={cw - 20} height="94" rx="4" class={c.tone === 'bad' ? 'inc-box is-bad' : 'inc-box is-good'} />
          <text x={x + 22} y="248" class="inc-small">
            <tspan data-lang-en>What it cost, or saved</tspan>
            <tspan data-lang-vi>Cái giá, hoặc cái đã đỡ</tspan>
          </text>
          <g {...EN}>{c.resEn.map((t, k) => <text x={x + 22} y={270 + k * 18} class="inc-in-s">{t}</text>)}</g>
          <g {...VI}>{c.resVi.map((t, k) => <text x={x + 22} y={270 + k * 18} class="inc-in-s">{t}</text>)}</g>
          <text x={x + 14} y="346" class="inc-note">
            <tspan data-lang-en>{c.secEn}</tspan>
            <tspan data-lang-vi>{c.secVi}</tspan>
          </text>
        </g>
      );
    })}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The four cases at a glance. Red boxes are the problem the team hit; gold boxes are what a better layout of data bought them.</span>
    <span data-lang-vi>Bốn vụ việc trong một hình. Ô đỏ là vấn đề team gặp; ô vàng là thứ họ có được nhờ xếp dữ liệu tốt hơn.</span>
  </figcaption>
</figure>

<style>
  .inc { margin: 2em 0; width: 100%; }
  .inc-scroll { overflow-x: auto; }
  .inc svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .inc text { font-size: 14px; fill: var(--text-body); }
  .inc .inc-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .inc .inc-sub { fill: var(--text-muted); }
  .inc-rule { stroke: var(--border); }
  .inc-divider { stroke: var(--border); stroke-dasharray: 6 5; }
  .inc-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .inc-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .inc-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .inc-cell { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .inc-cell.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .inc-cell.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .inc-cell.is-dead { fill: var(--bg-alt); stroke: var(--text-muted); stroke-dasharray: 3 3; }
  .inc .inc-in { font-weight: 600; fill: var(--text); }
  .inc .inc-in-b { font-weight: 700; fill: var(--text); }
  .inc .inc-in-m { font-size: 13px; fill: var(--text-body); }
  .inc .inc-in-s { font-size: 13px; font-weight: 600; fill: var(--text); }
  .inc .inc-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; fill: var(--text-body); }
  .inc .inc-mono.is-good { fill: var(--gold-icon); font-weight: 700; }
  .inc .inc-mono.is-bad { fill: var(--red); font-weight: 700; }
  .inc .inc-note { font-size: 13px; fill: var(--text-muted); }
  .inc .inc-note.is-good { fill: var(--gold-icon); font-weight: 700; }
  .inc .inc-note.is-bad { fill: var(--red); font-weight: 700; }
  .inc .inc-small { font-size: 12px; fill: var(--text-muted); }
  .inc .inc-num { font-size: 12px; font-weight: 700; fill: var(--text); }
  .inc-circle { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .inc-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .inc-arrow.is-good { stroke: var(--gold-icon); stroke-width: 1.8; }
  .inc-arrow.is-bad { stroke: var(--red); stroke-width: 1.8; }
  .inc-head { fill: var(--text-muted); }
  .inc-head.is-good { fill: var(--gold-icon); }
  .inc-head.is-bad { fill: var(--red); }
  .inc figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
