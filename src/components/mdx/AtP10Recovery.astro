---
// Output of demo/ai-trading/p10_recovery.py (100 simulated stocks, 7 sectors, mean of 100 runs).
// Adjusted Rand index against the true sectors, cut at 7 groups.
const days = [20, 60, 250, 1000];
const series = [
  { k: 'single', en: 'Single', vi: 'Single', cls: 'is-s', v: [0.001, 0.015, 0.904, 1.0] },
  { k: 'average', en: 'Average', vi: 'Average', cls: 'is-a', v: [0.230, 0.735, 1.0, 1.0] },
  { k: 'ward', en: 'Ward', vi: 'Ward', cls: 'is-w', v: [0.332, 0.831, 1.0, 1.0] },
];
const W = 900, H = 380, X0 = 90, Y0 = 50, PH = 240, GW = 190, BW = 46;
---
<figure class="p10rc">
  <div class="p10rc-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Grouped bars of how well a correlation tree recovers 7 sectors among 100 simulated stocks, by history length. At 20 days the score is 0.001 for single linkage, 0.23 for average and 0.33 for Ward. At 60 days: 0.015, 0.74 and 0.83. At 250 days: 0.90, 1.00 and 1.00. At 1000 days all three score 1.00.">
    <text x="20" y="28" class="p10rc-h">
      <tspan data-lang-en>100 stocks, 7 sectors: how many days does the tree need?</tspan>
      <tspan data-lang-vi>100 cổ phiếu, 7 ngành: cái cây cần bao nhiêu ngày?</tspan>
    </text>
    {[0, 0.5, 1].map((t) => (
      <g>
        <line x1={X0} x2={W - 20} y1={Y0 + PH - t * PH} y2={Y0 + PH - t * PH} class="p10rc-grid" />
        <text x={X0 - 10} y={Y0 + PH - t * PH + 4} text-anchor="end" class="p10rc-s">{t.toFixed(1)}</text>
      </g>
    ))}
    <text x="20" y={Y0 + PH / 2} class="p10rc-s" transform={`rotate(-90 20 ${Y0 + PH / 2})`} text-anchor="middle">
      <tspan data-lang-en>match with true sectors</tspan>
      <tspan data-lang-vi>độ khớp với ngành thật</tspan>
    </text>
    {days.map((d, i) => (
      <g>
        {series.map((s, j) => (
          <g>
            <rect x={X0 + 20 + i * GW + j * (BW + 6)} y={Y0 + PH - Math.max(s.v[i], 0.004) * PH} width={BW} height={Math.max(s.v[i], 0.004) * PH} rx="3" class={`p10rc-bar ${s.cls}`} />
            <text x={X0 + 20 + i * GW + j * (BW + 6) + BW / 2} y={Y0 + PH - Math.max(s.v[i], 0.004) * PH - 6} text-anchor="middle" class="p10rc-n">{s.v[i].toFixed(s.v[i] < 0.1 ? 3 : 2)}</text>
          </g>
        ))}
        <text x={X0 + 20 + i * GW + (3 * BW + 12) / 2} y={Y0 + PH + 22} text-anchor="middle" class="p10rc-t">
          <tspan data-lang-en>{d} days</tspan>
          <tspan data-lang-vi>{d} ngày</tspan>
        </text>
      </g>
    ))}
    {series.map((s, j) => (
      <g>
        <rect x={X0 + j * 150} y="336" width="16" height="16" rx="3" class={`p10rc-bar ${s.cls}`} />
        <text x={X0 + j * 150 + 24} y="349" class="p10rc-s">
          <tspan data-lang-en>{s.en} linkage</tspan>
          <tspan data-lang-vi>{s.vi} linkage</tspan>
        </text>
      </g>
    ))}
    <text x="560" y="349" class="p10rc-s">
      <tspan data-lang-en>1 = exact sectors, 0 = no better than chance</tspan>
      <tspan data-lang-vi>1 = đúng ngành, 0 = không hơn đoán mò</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Simulated market: 7 sectors of 14 or 15 stocks, a market factor, a sector factor and noise. With 100 stocks the tree needs far more than 60 days before the sectors come out.</span>
    <span data-lang-vi>Thị trường mô phỏng: 7 ngành, mỗi ngành 14 hoặc 15 mã, một nhân tố thị trường, một nhân tố ngành và nhiễu. Với 100 cổ phiếu, cái cây cần nhiều hơn hẳn 60 ngày mới ra đúng ngành.</span>
  </figcaption>
</figure>

<style>
  .p10rc { margin: 2em 0; width: 100%; }
  .p10rc-scroll { overflow-x: auto; }
  .p10rc svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .p10rc text { font-size: 14px; fill: var(--text-body); }
  .p10rc .p10rc-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p10rc .p10rc-t { font-weight: 700; fill: var(--text); }
  .p10rc .p10rc-s { font-size: 13px; fill: var(--text-muted); }
  .p10rc .p10rc-n { font-size: 12px; fill: var(--text); }
  .p10rc-grid { stroke: var(--border); stroke-width: 1; }
  .p10rc-bar { stroke-width: 1.4; }
  .p10rc-bar.is-s { fill: var(--bg-alt); stroke: var(--text-muted); }
  .p10rc-bar.is-a { fill: var(--bg-alt); stroke: var(--act-1); }
  .p10rc-bar.is-w { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .p10rc figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
