---
// Showdown: Keeping a small sub-slice or substring pins the full 64 MB backing buffer on the heap vs copying it cleanly.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 370;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const aPin = arrow(264, 108, 314, 108);
const aCopy = arrow(264, 294, 314, 294);
---
<figure class="gmcl">
  <div class="gmcl-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Showdown between slicing a 64 MB buffer and keeping all 64 MB pinned in heap memory versus copying the 5-byte prefix so GC can free the 64 MB buffer.">
      {/* Top: Leaking capacity */}
      <text x="16" y="26" class="gmcl-h">
        <tspan data-lang-en>1. Direct slice or substring: header := buf[:5] pins the entire 64 MiB buffer</tspan>
        <tspan data-lang-vi>1. Cắt trực tiếp slice hoặc string: header := buf[:5] giữ chặt cả cục 64 MiB</tspan>
      </text>

      <rect x="16" y="54" width="248" height="106" rx="8" class="gmcl-card is-red" />
      <DiagramIcon name="warning" x={28} y={76} size={20} />
      <text x="56" y="81" class="gmcl-b-red">
        <tspan data-lang-en>Retained handle</tspan>
        <tspan data-lang-vi>Biến còn giữ tham chiếu</tspan>
      </text>
      <text x="30" y="108" class="gmcl-m">header := buf[:5]</text>
      <text x="30" y="128" class="gmcl-m">len: 5 · cap: 67,108,864</text>
      <text x="30" y="147" class="gmcl-b-red">
        <tspan data-lang-en>Points to byte 0 of 64 MiB</tspan>
        <tspan data-lang-vi>Trỏ thẳng vào byte 0 của 64 MiB</tspan>
      </text>

      <rect x="318" y="54" width="568" height="106" rx="8" class="gmcl-heap is-red" />
      <rect x="330" y="72" width="76" height="52" rx="4" class="gmcl-used" />
      <text x="368" y="96" text-anchor="middle" class="gmcl-b">5 B</text>
      <text x="368" y="114" text-anchor="middle" class="gmcl-sm">
        <tspan data-lang-en>needed</tspan>
        <tspan data-lang-vi>cần dùng</tspan>
      </text>
      <rect x="412" y="72" width="460" height="52" rx="4" class="gmcl-wasted" />
      <text x="642" y="102" text-anchor="middle" class="gmcl-b-red">
        <tspan data-lang-en>63.99 MiB unreachable by app, yet GC cannot collect it</tspan>
        <tspan data-lang-vi>63,99 MiB không dùng nữa, nhưng GC không thể thu hồi</tspan>
      </text>
      <text x="602" y="146" text-anchor="middle" class="gmcl-sm">
        <tspan data-lang-en>Same trap applies to pointers inside a shrunk slice unless cleared with s[i] = nil</tspan>
        <tspan data-lang-vi>Lỗi tương tự xảy ra với slice chứa con trỏ nếu không gán s[i] = nil khi cắt bớt</tspan>
      </text>

      <path d={aPin.line} class="gmcl-arrow is-red" /><polygon points={aPin.head} class="gmcl-head is-red" />

      <line x1="16" x2={W - 16} y1="186" y2="186" class="gmcl-rule" />

      {/* Bottom: Isolated copy */}
      <text x="16" y="216" class="gmcl-h">
        <tspan data-lang-en>2. Copy or strings.Clone: allocate 5 fresh bytes, let GC reclaim the 64 MiB buffer</tspan>
        <tspan data-lang-vi>2. Dùng copy hoặc strings.Clone: cấp phát đúng 5 byte mới, trả 64 MiB cho GC dọn</tspan>
      </text>

      <rect x="16" y="240" width="248" height="106" rx="8" class="gmcl-card is-ok" />
      <DiagramIcon name="ok" x={28} y={262} size={20} />
      <text x="56" y="267" class="gmcl-b-ok">
        <tspan data-lang-en>Detached copy</tspan>
        <tspan data-lang-vi>Bản sao tách biệt</tspan>
      </text>
      <text x="30" y="294" class="gmcl-m">dst := make([]byte, 5)</text>
      <text x="30" y="314" class="gmcl-m">copy(dst, buf[:5])</text>
      <text x="30" y="333" class="gmcl-b-ok">len: 5 · cap: 5</text>

      <rect x="318" y="240" width="128" height="106" rx="8" class="gmcl-heap is-ok" />
      <rect x="334" y="268" width="96" height="50" rx="4" class="gmcl-ok-box" />
      <text x="382" y="290" text-anchor="middle" class="gmcl-b-ok">5 B</text>
      <text x="382" y="308" text-anchor="middle" class="gmcl-sm">
        <tspan data-lang-en>new array</tspan>
        <tspan data-lang-vi>mảng mới</tspan>
      </text>

      <rect x="462" y="240" width="424" height="106" rx="8" class="gmcl-freed" />
      <text x="674" y="286" text-anchor="middle" class="gmcl-b-ok">
        <tspan data-lang-en>64 MiB backing buffer has zero live pointers</tspan>
        <tspan data-lang-vi>Mảng 64 MiB không còn bất kỳ con trỏ nào trỏ tới</tspan>
      </text>
      <text x="674" y="312" text-anchor="middle" class="gmcl-sm">
        <tspan data-lang-en>Freed on the next garbage collection cycle</tspan>
        <tspan data-lang-vi>Được GC giải phóng ngay ở chu kỳ dọn rác tiếp theo</tspan>
      </text>

      <path d={aCopy.line} class="gmcl-arrow is-ok" /><polygon points={aCopy.head} class="gmcl-head is-ok" />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Go's garbage collector tracks reachability at the backing-array level, not element by element. Slicing a tiny prefix out of a large buffer keeps the entire allocation alive until you copy it.</span>
    <span data-lang-vi>Bộ dọn rác của Go theo dõi khả năng truy cập theo cả khối mảng nền chứ không theo từng phần tử lẻ. Giữ một lát cắt nhỏ từ buffer lớn sẽ ghim cả vùng nhớ đó cho tới khi bạn chủ động sao chép.</span>
  </figcaption>
</figure>

<style>
  .gmcl { margin: 2em 0; width: 100%; }
  .gmcl-scroll { overflow-x: auto; }
  .gmcl svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gmcl text { font-size: 12.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .gmcl .gmcl-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .gmcl-card { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; }
  .gmcl-card.is-red { fill: var(--red-tint-bg); stroke: var(--red); }
  .gmcl-card.is-ok { fill: var(--bg-alt); stroke: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gmcl-card.is-ok { stroke: rgb(74, 222, 128); }
  .gmcl-heap { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .gmcl-heap.is-red { stroke: var(--red); }
  .gmcl-heap.is-ok { stroke: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gmcl-heap.is-ok { stroke: rgb(74, 222, 128); }
  .gmcl-used { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .gmcl-wasted { fill: var(--red-tint-bg); stroke: var(--red); stroke-dasharray: 5 3; stroke-width: 1.3; }
  .gmcl-ok-box { fill: var(--bg); stroke: rgb(21, 128, 61); stroke-width: 1.4; }
  :global(html[data-theme='dark']) .gmcl-ok-box { stroke: rgb(74, 222, 128); }
  .gmcl-freed { fill: transparent; stroke: rgb(21, 128, 61); stroke-dasharray: 5 4; stroke-width: 1.4; }
  :global(html[data-theme='dark']) .gmcl-freed { stroke: rgb(74, 222, 128); }
  .gmcl-b { font-weight: 700; fill: var(--text); }
  .gmcl-b-red { font-size: 12px; font-weight: 700; fill: var(--red); }
  .gmcl-b-ok { font-size: 12px; font-weight: 700; fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gmcl-b-ok { fill: rgb(74, 222, 128); }
  .gmcl-m { font-size: 11.5px; fill: var(--text-body); }
  .gmcl-sm { font-size: 11.5px; fill: var(--text-muted); }
  .gmcl-rule { stroke: var(--border); }
  .gmcl-arrow { fill: none; stroke-width: 1.6; }
  .gmcl-arrow.is-red { stroke: var(--red); }
  .gmcl-arrow.is-ok { stroke: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gmcl-arrow.is-ok { stroke: rgb(74, 222, 128); }
  .gmcl-head.is-red { fill: var(--red); }
  .gmcl-head.is-ok { fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gmcl-head.is-ok { fill: rgb(74, 222, 128); }
  .gmcl-pulse-red { fill: var(--red); }
  .gmcl-pulse-ok { fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gmcl-pulse-ok { fill: rgb(74, 222, 128); }
  .gmcl figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
