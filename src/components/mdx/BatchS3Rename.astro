---
import BatchDiagram from './BatchDiagram.astro';
const boxes = [{"x": 20, "y": 46, "w": 240, "h": 64, "t": ["output/_tmp", "output/_tmp"], "s": [["10,000 Parquet files", "10.000 file Parquet"]], "icon": "folder"}, {"x": 330, "y": 46, "w": 240, "h": 64, "t": ["Metadata server", "Máy chủ metadata"], "s": [["changes one entry", "đổi một mục"]], "icon": "db"}, {"x": 640, "y": 46, "w": 240, "h": 64, "t": ["output", "output"], "s": [["all files appear at once", "mọi file hiện cùng lúc"]], "icon": "folder", "kind": "good"}, {"x": 20, "y": 200, "w": 240, "h": 64, "t": ["tmp/ keys", "Khoá tmp/"], "s": [["10,000 objects", "10.000 object"]], "icon": "s3"}, {"x": 330, "y": 200, "w": 240, "h": 64, "t": ["Copy to new keys", "Chép sang khoá mới"], "s": [["10,000 copies, one by one", "10.000 bản, từng cái"]], "icon": "s3", "kind": "hot"}, {"x": 640, "y": 200, "w": 240, "h": 64, "t": ["Delete old keys", "Xoá khoá cũ"], "s": [["10,000 deletes", "10.000 lệnh xoá"]], "icon": "s3"}];
const arrows = [{"x1": 260, "y1": 78, "x2": 330, "y2": 78}, {"x1": 570, "y1": 78, "x2": 640, "y2": 78, "kind": "good"}, {"x1": 260, "y1": 232, "x2": 330, "y2": 232}, {"x1": 570, "y1": 232, "x2": 640, "y2": 232, "kind": "hot"}];
const texts = [{"x": 20, "y": 26, "cls": "h", "t": ["HDFS: rename is one step", "HDFS: đổi tên chỉ một bước"]}, {"x": 20, "y": 180, "cls": "h", "t": ["S3: rename is copy plus delete", "S3: đổi tên là chép rồi xoá"]}, {"x": 20, "y": 306, "cls": "warn", "t": ["A crash or a reader in the middle sees half the files.", "Gặp sự cố hoặc có người đọc giữa chừng sẽ thấy một nửa số file."]}];
---
<BatchDiagram
  w={900} h={330}
  aria="Top: on HDFS, renaming a folder is one atomic metadata update. Bottom: on S3 there are no folders, so a rename copies 10,000 objects to new keys then deletes the old ones, and a reader in the middle sees partial output."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any} rules={[145]} icons={[]}
  caption={["Why renaming a folder is safe on a filesystem but not on an object store: S3 has no real folders to rename.", "Vì sao đổi tên thư mục an toàn trên filesystem nhưng không trên object store: S3 không có thư mục thật để đổi."]}
/>
