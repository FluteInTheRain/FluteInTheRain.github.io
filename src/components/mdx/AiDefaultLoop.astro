---
// The feedback loop behind "every AI-built UI looks the same":
// a placeholder default is copied, learned, generated, published, and learned again.
// Plain inline SVG styled with site tokens; arrowheads are polygons (no <marker>), so the
// hidden EN/VI copies cannot clash on ids.

const W = 900;
const H = 330;
const bw = 250;
const bh = 76;
const top = 46;
const bottom = 196;

type Node = { x: number; y: number; en: [string, string]; vi: [string, string]; hot?: boolean };
const nodes: Node[] = [
  { x: 30, y: top, en: ['A placeholder default is picked', 'for demos: indigo-500'], vi: ['Chọn một mặc định tạm', 'cho bản demo: indigo-500'], hot: true },
  { x: 325, y: top, en: ['Tutorials and templates', 'copy it as it is'], vi: ['Tutorial và template', 'chép lại y nguyên'] },
  { x: 620, y: top, en: ['Models train on', 'all that code'], vi: ['Model học từ', 'đống code đó'] },
  { x: 620, y: bottom, en: ['Models hand the same default', 'to everyone who asks'], vi: ['Model đưa cùng một mặc định', 'cho ai hỏi cũng vậy'] },
  { x: 325, y: bottom, en: ['Those apps go online and', 'become data for the next model'], vi: ['Các app đó lên mạng, thành', 'dữ liệu cho model đời sau'] },
];

function head(x: number, y: number, dir: 'r' | 'd' | 'l' | 'u') {
  const s = 7;
  if (dir === 'r') return `${x},${y} ${x - s * 1.4},${y - s} ${x - s * 1.4},${y + s}`;
  if (dir === 'l') return `${x},${y} ${x + s * 1.4},${y - s} ${x + s * 1.4},${y + s}`;
  if (dir === 'd') return `${x},${y} ${x - s},${y - s * 1.4} ${x + s},${y - s * 1.4}`;
  return `${x},${y} ${x - s},${y + s * 1.4} ${x + s},${y + s * 1.4}`;
}

const midTop = top + bh / 2;
const midBottom = bottom + bh / 2;
const arrows = [
  { d: `M ${30 + bw} ${midTop} L ${325 - 10} ${midTop}`, p: head(325 - 1, midTop, 'r') },
  { d: `M ${325 + bw} ${midTop} L ${620 - 10} ${midTop}`, p: head(620 - 1, midTop, 'r') },
  { d: `M ${620 + bw / 2} ${top + bh} L ${620 + bw / 2} ${bottom - 10}`, p: head(620 + bw / 2, bottom - 1, 'd') },
  { d: `M ${620} ${midBottom} L ${325 + bw + 10} ${midBottom}`, p: head(325 + bw + 1, midBottom, 'l') },
];
// Closing arrow: from the last box back up to the first one. This is the loop, so it is the red one.
const closeD = `M ${325} ${midBottom} L ${30 + bw / 2} ${midBottom} L ${30 + bw / 2} ${top + bh + 10}`;
const closeP = head(30 + bw / 2, top + bh + 1, 'u');
---
<figure class="adl">
  <div class="adl-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A loop in five steps: a placeholder default is picked, tutorials and templates copy it, models train on that code, models hand the same default to everyone, and those apps go online and become training data again.">
      {nodes.map((n) => (
        <g class:list={['adl-box', { 'is-hot': n.hot }]}>
          <rect x={n.x} y={n.y} width={bw} height={bh} rx="8" />
          <text x={n.x + bw / 2} y={n.y + 31} text-anchor="middle">
            <tspan data-lang-en>{n.en[0]}</tspan>
            <tspan data-lang-vi>{n.vi[0]}</tspan>
          </text>
          <text x={n.x + bw / 2} y={n.y + 53} text-anchor="middle">
            <tspan data-lang-en>{n.en[1]}</tspan>
            <tspan data-lang-vi>{n.vi[1]}</tspan>
          </text>
        </g>
      ))}

      {arrows.map((a) => (
        <g class="adl-arrow"><path d={a.d} /><polygon points={a.p} /></g>
      ))}
      <g class="adl-arrow is-red"><path d={closeD} /><polygon points={closeP} /></g>

      <text x="30" y="300" class="adl-note">
        <tspan data-lang-en>Nobody chose purple. Each step only repeated the step before it.</tspan>
        <tspan data-lang-vi>Không ai chọn màu tím. Mỗi bước chỉ lặp lại bước trước đó.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>How a placeholder turns into everyone's default. This is the mechanism widely told for Tailwind's indigo; treat it as a plausible explanation, not a measured cause.</span>
    <span data-lang-vi>Một giá trị tạm trở thành mặc định của cả thế giới như thế nào. Đây là cách giải thích được kể nhiều về màu indigo của Tailwind, nên hiểu là giải thích hợp lý, không phải nguyên nhân đã đo đạc.</span>
  </figcaption>
</figure>

<style>
  .adl {
    margin: 2em 0;
    width: 100%;
  }
  .adl-scroll {
    overflow-x: auto;
  }
  .adl svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .adl text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .adl-box rect {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .adl-box.is-hot rect {
    fill: var(--red-tint-bg);
    stroke: var(--red);
  }
  .adl-box text {
    fill: var(--text);
    font-weight: 600;
  }
  .adl-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .adl-arrow polygon {
    fill: var(--text-muted);
  }
  .adl-arrow.is-red path {
    stroke: var(--red);
    stroke-width: 2;
  }
  .adl-arrow.is-red polygon {
    fill: var(--red);
  }
  .adl text.adl-note {
    font-size: 15px;
    font-weight: 600;
    fill: var(--red);
  }
  .adl figcaption {
    margin-top: 0.6em;
    text-align: center;
    font-size: 14px;
    color: var(--text-muted);
  }
</style>
