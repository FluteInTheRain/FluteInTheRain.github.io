---
// B-tree inserts, as a top/bottom showdown: time-ordered keys all land in the
// rightmost leaf page, random keys land in leaves all over the tree. The numbers
// are from the SQLite run shown in the post (500,000 inserts, WAL bytes written).
// Plain inline SVG with site tokens; no ids.

const W = 900;
const H = 470;

const leafCount = 8;
const leafW = 66;
const leafGap = 10;
const leafX0 = 20;
const treeMid = leafX0 + (leafCount * (leafW + leafGap) - leafGap) / 2;

type Panel = {
  top: number;
  headEn: string;
  headVi: string;
  subEn: string;
  subVi: string;
  touched: number[];
  walEn: string;
  walVi: string;
  bad: boolean;
};

const panels: Panel[] = [
  {
    top: 24,
    headEn: 'Time-ordered keys (auto-increment, ULID, UUIDv7)',
    headVi: 'Khoá tăng theo thời gian (auto-increment, ULID, UUIDv7)',
    subEn: 'Every new key is bigger than the last, so it goes to the rightmost leaf.',
    subVi: 'Khoá mới luôn lớn hơn khoá trước, nên luôn rơi vào lá ngoài cùng bên phải.',
    touched: [7],
    walEn: '24.5 MB',
    walVi: '24,5 MB',
    bad: false,
  },
  {
    top: 244,
    headEn: 'Random keys (UUIDv4)',
    headVi: 'Khoá ngẫu nhiên (UUIDv4)',
    subEn: 'New keys land anywhere, so almost every leaf page gets changed again.',
    subVi: 'Khoá mới rơi vào bất cứ đâu, nên gần như trang lá nào cũng bị sửa lại.',
    touched: [0, 1, 3, 4, 6, 7],
    walEn: '545.4 MB',
    walVi: '545,4 MB',
    bad: true,
  },
];

const rootW = 120;
const rootH = 30;
---
<figure class="bti">
  <div class="bti-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two B-trees receiving a batch of inserts. With time-ordered keys only the rightmost leaf page changes. With random UUIDv4 keys six of eight leaf pages change. In the SQLite test, 500,000 inserts wrote 24.5 MB to the write-ahead log with time-ordered keys and 545.4 MB with random keys.">
    {panels.map((p) => {
      const rootY = p.top + 52;
      const leafY = rootY + 86;
      return (
        <g>
          <text x="20" y={p.top} class="bti-h">
            <tspan data-lang-en>{p.headEn}</tspan>
            <tspan data-lang-vi>{p.headVi}</tspan>
          </text>
          <text x="20" y={p.top + 22} class="bti-sub">
            <tspan data-lang-en>{p.subEn}</tspan>
            <tspan data-lang-vi>{p.subVi}</tspan>
          </text>

          {/* root and edges */}
          {Array.from({ length: leafCount }, (_, i) => (
            <line x1={treeMid} y1={rootY + rootH} x2={leafX0 + i * (leafW + leafGap) + leafW / 2} y2={leafY} class="bti-edge" />
          ))}
          <rect x={treeMid - rootW / 2} y={rootY} width={rootW} height={rootH} rx="3" class="bti-page" />
          <text x={treeMid} y={rootY + 20} text-anchor="middle" class="bti-in">
            <tspan data-lang-en>root page</tspan>
            <tspan data-lang-vi>trang gốc</tspan>
          </text>

          {/* leaves */}
          {Array.from({ length: leafCount }, (_, i) => {
            const hot = p.touched.includes(i);
            const x = leafX0 + i * (leafW + leafGap);
            return (
              <g>
                <rect x={x} y={leafY} width={leafW} height="40" rx="3" class={hot ? 'bti-page is-hot' : 'bti-page'} />
                <text x={x + leafW / 2} y={leafY + 25} text-anchor="middle" class={hot ? 'bti-in is-hot' : 'bti-in is-cold'}>
                  <tspan data-lang-en>{hot ? 'changed' : 'leaf'}</tspan>
                  <tspan data-lang-vi>{hot ? 'bị sửa' : 'lá'}</tspan>
                </text>
              </g>
            );
          })}

          {/* measured WAL bytes */}
          <text x="670" y={rootY + 14} class="bti-label">
            <tspan data-lang-en>Written to the WAL</tspan>
            <tspan data-lang-vi>Ghi vào WAL</tspan>
          </text>
          <text x="670" y={rootY + 34} class="bti-label">
            <tspan data-lang-en>for 500,000 inserts</tspan>
            <tspan data-lang-vi>cho 500.000 lệnh insert</tspan>
          </text>
          <text x="670" y={rootY + 78} class={p.bad ? 'bti-num is-bad' : 'bti-num'}>
            <tspan data-lang-en>{p.walEn}</tspan>
            <tspan data-lang-vi>{p.walVi}</tspan>
          </text>
        </g>
      );
    })}
    <line x1="20" x2={W - 20} y1="220" y2="220" class="bti-rule" />

    {/* legend */}
    <line x1="20" x2={W - 20} y1="432" y2="432" class="bti-rule" />
    <rect x="20" y="444" width="30" height="18" rx="3" class="bti-page is-hot" />
    <text x="58" y="458" class="bti-label">
      <tspan data-lang-en>leaf page changed by the latest batch of inserts</tspan>
      <tspan data-lang-vi>trang lá bị sửa bởi đợt insert gần nhất</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Same table, same row count, only the key order differs. Each changed page is written to the log again at the next commit, so scattered keys multiply the bytes written. Numbers from the SQLite run below (Apple M2, SQLite 3.54.1, 32-character keys, 10,000 rows per commit).</span>
    <span data-lang-vi>Cùng bảng, cùng số dòng, chỉ khác thứ tự khoá. Trang nào bị sửa thì lần commit sau lại được ghi vào log, nên khoá rải rác làm số byte ghi ra tăng lên nhiều lần. Số liệu lấy từ lần chạy SQLite bên dưới (Apple M2, SQLite 3.54.1, khoá 32 ký tự, mỗi commit 10.000 dòng).</span>
  </figcaption>
</figure>

<style>
  .bti {
    margin: 2em 0;
    width: 100%;
  }
  .bti-scroll {
    overflow-x: auto;
  }
  .bti svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .bti text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .bti .bti-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .bti .bti-sub,
  .bti .bti-label {
    fill: var(--text-muted);
  }
  .bti-edge {
    stroke: var(--text-faint);
    stroke-opacity: 0.55;
    stroke-width: 1.2;
  }
  .bti-rule {
    stroke: var(--border);
  }
  .bti-page {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .bti-page.is-hot {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .bti .bti-in {
    font-size: 13px;
    fill: var(--text);
  }
  .bti .bti-in.is-cold {
    fill: var(--text-faint);
  }
  .bti .bti-in.is-hot {
    font-weight: 700;
  }
  .bti .bti-num {
    font-size: 30px;
    font-weight: 700;
    fill: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .bti .bti-num.is-bad {
    fill: var(--red);
  }
  .bti figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
