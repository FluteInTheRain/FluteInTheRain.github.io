---
// How Spotify forgets a user without rewriting immutable datasets
// (Bram Leenders, "Scalable User Privacy", Spotify Engineering, 2018).
// Personal data is stored only encrypted, with per-user keys held in one key service
// (Padlock). Deleting user B's keys leaves B's rows on disk but unreadable everywhere.
// Plain inline SVG with site tokens; no ids (hatching is drawn as plain line segments).

import DiagramIcon from './DiagramIcon.astro';

type User = 'A' | 'B' | 'C';

const W = 900;
const PANEL_H = 250;
const H = PANEL_H * 2 + 4;

const keyBox = { x: 20, w: 200 };
const dsBoxes = [
  { icon: 'log', x: 285, en: 'Append-only log', vi: 'Append-only log', rows: ['A', 'B', 'C', 'B'] as User[] },
  { icon: 'db', x: 590, en: 'Copy in another dataset', vi: 'Bản sao ở dataset khác', rows: ['C', 'A', 'B', 'A'] as User[] },
];
const dsW = 290;
const boxTop = 42; // relative to the panel
const boxH = 160;
const rowH = 24;
const rowPitch = 30;

// Arrow drawn as a line plus a small filled triangle (no SVG markers needed).
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

// 45-degree hatch lines clipped to a rectangle, as one path.
function hatch(x: number, y: number, w: number, h: number, step = 8) {
  const parts: string[] = [];
  for (let c = -h; c < w; c += step) {
    const s0 = Math.max(0, -c);
    const s1 = Math.min(h, w - c);
    if (s1 <= s0) continue;
    parts.push(`M ${(x + c + s0).toFixed(1)} ${(y + h - s0).toFixed(1)} L ${(x + c + s1).toFixed(1)} ${(y + h - s1).toFixed(1)}`);
  }
  return parts.join(' ');
}

const panels = [
  {
    oy: 0,
    forgotten: false,
    titleEn: 'Before deletion',
    titleVi: 'Trước khi xóa',
    noteEn: "To read a row, a service fetches that user's key from the key service, then decrypts the row.",
    noteVi: 'Muốn đọc một dòng, service lấy key của user đó từ key service rồi mới giải mã.',
  },
  {
    oy: PANEL_H + 4,
    forgotten: true,
    titleEn: 'After user B asks to be forgotten',
    titleVi: 'Sau khi user B yêu cầu xóa dữ liệu của mình',
    noteEn: "B's rows are still on disk, but no key is left to decrypt them. No dataset was rewritten.",
    noteVi: 'Dòng của B vẫn nằm trên đĩa, nhưng không còn key nào để giải mã. Không dataset nào phải ghi lại.',
  },
];
const users: User[] = ['A', 'B', 'C'];
---
<figure class="cshred">
  <div class="cshred-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: a key service called Padlock holds keys for users A, B and C; an append-only log and a copy in another dataset hold rows encrypted with those keys, and readers fetch the key to decrypt. Bottom: after user B asks to be forgotten, only B's keys are deleted. B's rows stay in both datasets but can no longer be decrypted, and no dataset is rewritten.">
    <line x1="20" x2={W - 20} y1={PANEL_H - 6} y2={PANEL_H - 6} class="cshred-rule" />

    {panels.map((p) => {
      const top = p.oy + boxTop;
      const mid = top + boxH / 2;
      const a = arrow(keyBox.x + keyBox.w, mid, dsBoxes[0].x, mid);
      return (
        <g>
          <text x="20" y={p.oy + 26} class="cshred-h">
            <tspan data-lang-en>{p.titleEn}</tspan>
            <tspan data-lang-vi>{p.titleVi}</tspan>
          </text>

          {/* key service */}
          <rect x={keyBox.x} y={top} width={keyBox.w} height={boxH} rx="8" class="cshred-box" />
          <DiagramIcon name="key" x={keyBox.x + 24} y={top + 19} size={20} />
          <text x={keyBox.x + 42} y={top + 24} class="cshred-box-h">
            <tspan data-lang-en>Key service (Padlock)</tspan>
            <tspan data-lang-vi>Key service (Padlock)</tspan>
          </text>
          {users.map((u, i) => {
            const y = top + 40 + i * (rowH + 12);
            const gone = p.forgotten && u === 'B';
            const tx = keyBox.x + 22;
            return (
              <g class={gone ? 'cshred-key is-gone' : 'cshred-key'}>
                <rect x={keyBox.x + 12} y={y} width={keyBox.w - 24} height={rowH + 4} rx="4" />
                <text x={tx} y={y + 19}>
                  <tspan data-lang-en>user {u}'s keys</tspan>
                  <tspan data-lang-vi>keys của user {u}</tspan>
                </text>
                {gone && (
                  <g>
                    <line data-lang-en x1={tx - 3} x2={tx + 84} y1={y + 14} y2={y + 14} class="cshred-strike" />
                    <line data-lang-vi x1={tx - 3} x2={tx + 101} y1={y + 14} y2={y + 14} class="cshred-strike" />
                    <text x={keyBox.x + keyBox.w - 22} y={y + 19} text-anchor="end" class="cshred-gone">
                      <tspan data-lang-en>deleted</tspan>
                      <tspan data-lang-vi>đã xóa</tspan>
                    </text>
                  </g>
                )}
              </g>
            );
          })}

          <g class="cshred-arrow"><path d={a.line} /><polygon points={a.head} /></g>
          <text x={(keyBox.x + keyBox.w + dsBoxes[0].x) / 2} y={mid - 8} text-anchor="middle" class="cshred-small">key</text>

          {/* immutable datasets */}
          {dsBoxes.map((d) => (
            <g>
              <rect x={d.x} y={top} width={dsW} height={boxH} rx="8" class="cshred-box" />
              <DiagramIcon name={d.icon as any} x={d.x + 24} y={top + 19} size={20} />
              <text x={d.x + 42} y={top + 24} class="cshred-box-h">
                <tspan data-lang-en>{d.en}</tspan>
                <tspan data-lang-vi>{d.vi}</tspan>
              </text>
              {d.rows.map((u, i) => {
                const y = top + 36 + i * rowPitch;
                const rx = d.x + 10;
                const rw = dsW - 20;
                const dead = p.forgotten && u === 'B';
                return (
                  <g class={dead ? 'cshred-row is-dead' : 'cshred-row'}>
                    <rect x={rx} y={y} width={rw} height={rowH} rx="3" />
                    {dead && <path d={hatch(rx, y, rw, rowH)} class="cshred-hatch" />}
                    <text x={rx + 10} y={y + 17} class="cshred-who">user {u}</text>
                    <text x={rx + rw - 10} y={y + 17} text-anchor="end" class="cshred-state">
                      {dead
                        ? <><tspan data-lang-en>still on disk, unreadable</tspan><tspan data-lang-vi>vẫn trên đĩa, không đọc được</tspan></>
                        : <><tspan data-lang-en>encrypted</tspan><tspan data-lang-vi>đã mã hóa</tspan></>}
                    </text>
                  </g>
                );
              })}
            </g>
          ))}

          <text x="20" y={top + boxH + 26} class={p.forgotten ? 'cshred-note is-after' : 'cshred-note'}>
            <tspan data-lang-en>{p.noteEn}</tspan>
            <tspan data-lang-vi>{p.noteVi}</tspan>
          </text>
        </g>
      );
    })}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Spotify lets personal data be stored only in encrypted form, and each user has their own set of keys. Deleting one user's keys makes every copy of their data unreadable at once, across all datasets, without asking each of more than a thousand microservices to delete it, and without rewriting immutable data. The technique is often called crypto-shredding; Spotify's post does not use that name. Source: Bram Leenders, <a href="https://engineering.atspotify.com/2018/09/scalable-user-privacy" rel="noopener" target="_blank">Scalable User Privacy</a> (Spotify Engineering, 2018).</span>
    <span data-lang-vi>Spotify chỉ cho phép lưu dữ liệu cá nhân ở dạng đã mã hóa, và mỗi user có một bộ key riêng. Xóa key của một user là mọi bản sao dữ liệu của người đó, ở mọi dataset, cùng lúc không đọc được nữa, mà không cần bắt từng microservice trong hơn một nghìn cái tự xóa, cũng không phải ghi lại dữ liệu immutable. Kỹ thuật này thường được gọi là crypto-shredding; bài của Spotify không dùng tên đó. Nguồn: Bram Leenders, <a href="https://engineering.atspotify.com/2018/09/scalable-user-privacy" rel="noopener" target="_blank">Scalable User Privacy</a> (Spotify Engineering, 2018).</span>
  </figcaption>
</figure>

<style>
  .cshred {
    margin: 2em 0;
    width: 100%;
  }
  .cshred-scroll {
    overflow-x: auto;
  }
  .cshred svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .cshred text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .cshred .cshred-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .cshred-box {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .cshred .cshred-box-h {
    font-weight: 700;
    fill: var(--text);
  }
  .cshred-key rect,
  .cshred-row rect {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 1;
  }
  .cshred .cshred-key text {
    font-size: 13px;
    fill: var(--text);
  }
  .cshred-key.is-gone rect {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-dasharray: 4 3;
  }
  .cshred .cshred-key.is-gone text {
    fill: var(--text-muted);
  }
  .cshred-strike {
    stroke: var(--red);
    stroke-width: 1.5;
  }
  .cshred .cshred-key .cshred-gone {
    font-weight: 700;
    fill: var(--red);
  }
  .cshred .cshred-who {
    font-size: 13px;
    font-weight: 600;
    fill: var(--text);
  }
  .cshred .cshred-state {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .cshred-row.is-dead rect {
    fill: var(--bg-alt);
    stroke: var(--text-faint);
    stroke-dasharray: 3 3;
  }
  .cshred-hatch {
    stroke: var(--text-faint);
    stroke-width: 1;
    opacity: 0.45;
  }
  .cshred .cshred-row.is-dead text {
    paint-order: stroke;
    stroke: var(--bg-alt);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  .cshred .cshred-row.is-dead .cshred-who {
    fill: var(--text-muted);
  }
  .cshred .cshred-row.is-dead .cshred-state {
    font-weight: 700;
    fill: var(--red);
  }
  .cshred-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .cshred-arrow polygon {
    fill: var(--text-muted);
  }
  .cshred .cshred-small {
    font-size: 12px;
    fill: var(--text-muted);
  }
  .cshred .cshred-note {
    font-size: 14px;
    fill: var(--text-muted);
  }
  .cshred .cshred-note.is-after {
    fill: var(--text);
  }
  .cshred figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
