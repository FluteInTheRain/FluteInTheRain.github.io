---
// Chapter 3: a linear 4px scale vs a scale whose neighbours are at least ~25% apart.
// Squares are drawn at their real pixel size, so the reader sees how alike 40, 44 and 48 look.

const W = 900;
const H = 350;
const linear = Array.from({ length: 16 }, (_, i) => (i + 1) * 4);
const spaced = [4, 8, 12, 16, 24, 32, 48, 64];

function layout(values: number[], gap: number, x0: number) {
  let x = x0;
  return values.map((v) => {
    const item = { v, x };
    x += v + gap;
    return item;
  });
}
const rowA = layout(linear, 9, 30);
const rowB = layout(spaced, 22, 30);
const baseA = 120;
const baseB = 290;
const hotA = new Set([44, 48]);
---
<figure class="scb">
  <div class="scb-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top row: sixteen squares from 4 to 64 pixels, each 4 pixels bigger than the last; above 40 pixels neighbours look almost the same. Bottom row: eight squares, 4, 8, 12, 16, 24, 32, 48 and 64 pixels, each clearly bigger than the one before.">
      <text x="30" y="26" class="scb-h">
        <tspan data-lang-en>Every 4px: 16 steps</tspan>
        <tspan data-lang-vi>Cứ thêm 4px: 16 bậc</tspan>
      </text>
      {rowA.map(({ v, x }) => (
        <rect x={x} y={baseA - v} width={v} height={v} rx="2" class:list={['scb-sq', { 'is-hot': hotA.has(v) }]} />
      ))}
      <text x={rowA[10].x - 4} y={baseA + 24} class="scb-hot">
        <tspan data-lang-en>44px vs 48px: +9%, hard to tell apart</tspan>
        <tspan data-lang-vi>44px và 48px: +9%, khó phân biệt</tspan>
      </text>

      <line x1="30" y1="166" x2="870" y2="166" class="scb-rule" />

      <text x="30" y="194" class="scb-h">
        <tspan data-lang-en>Neighbours at least ~25% apart: 8 steps</tspan>
        <tspan data-lang-vi>Hai bậc liền kề chênh ít nhất ~25%: 8 bậc</tspan>
      </text>
      {rowB.map(({ v, x }) => (
        <g>
          <rect x={x} y={baseB - v} width={v} height={v} rx="2" class="scb-sq is-good" />
          <text x={x + v / 2} y={baseB + 20} text-anchor="middle" class="scb-num">{v}</text>
        </g>
      ))}
      <text x={rowB[7].x + 90} y={baseB - 26} class="scb-note">
        <tspan data-lang-en>Each step is visibly bigger,</tspan>
        <tspan data-lang-vi>Mỗi bậc to hơn thấy rõ,</tspan>
      </text>
      <text x={rowB[7].x + 90} y={baseB - 6} class="scb-note">
        <tspan data-lang-en>so "the next one" is a real choice</tspan>
        <tspan data-lang-vi>nên "bậc kế tiếp" là lựa chọn thật</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Squares at real pixel size. More steps do not give you more choice when neighbours look the same.</span>
    <span data-lang-vi>Các ô vuông ở đúng kích thước pixel. Nhiều bậc hơn không cho bạn thêm lựa chọn khi các bậc cạnh nhau trông như nhau.</span>
  </figcaption>
</figure>

<style>
  .scb { margin: 2em 0; width: 100%; }
  .scb-scroll { overflow-x: auto; }
  .scb svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .scb text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .scb text.scb-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .scb-sq { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .scb-sq.is-hot { fill: var(--red-tint-bg); stroke: var(--red); }
  .scb-sq.is-good { stroke: var(--text); }
  .scb text.scb-hot { fill: var(--red); font-weight: 600; }
  .scb text.scb-num { font-size: 13px; fill: var(--text-muted); }
  .scb text.scb-note { fill: var(--text-muted); }
  .scb-rule { stroke: var(--border); }
  .scb figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
