---
// Federated (unify reads) vs unbundled (unify writes), same three stores underneath.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 372;
const heads = (x2: number, y: number, up = false) => up ? `${x2 - 4},${y + 7} ${x2 + 4},${y + 7} ${x2},${y}` : `${x2 - 4},${y - 7} ${x2 + 4},${y - 7} ${x2},${y}`;
const stores = [
  { icon: 'postgres', en: 'PostgreSQL', vi: 'PostgreSQL' },
  { icon: 'elasticsearch', en: 'Elasticsearch', vi: 'Elasticsearch' },
  { icon: 'redis', en: 'Redis', vi: 'Redis' },
];
const panels = [
  { x0: 20, good: false, up: true, title: ['Federated: unify reads', 'Liên kết: hợp nhất đường đọc'], top: { icon: 'laptop', en: 'Analyst query', vi: 'Truy vấn phân tích' }, mid: { icon: 'search', en: 'One SQL engine', vi: 'Một engine SQL', sen: 'FDW, Trino', svi: 'FDW, Trino' }, note: ['Good for read-only queries, weak at syncing writes', 'Tốt cho truy vấn chỉ đọc; yếu ở đồng bộ lệnh ghi'] },
  { x0: 460, good: true, up: false, title: ['Unbundled: unify writes', 'Tháo rời: hợp nhất đường ghi'], top: { icon: 'log', en: 'Ordered event log', vi: 'Log sự kiện có thứ tự' }, mid: { icon: 'worker', en: 'Stream operators', vi: 'Stream operator', sen: 'like Unix filters', svi: 'như bộ lọc Unix' }, note: ['The log is the pipe; consumers are idempotent', 'Log là ống dẫn; consumer chống lặp'] },
];
---
<figure class="ua-fig">
  <div class="ua-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Federated databases put one SQL engine in front of PostgreSQL, Elasticsearch and Redis so reads flow up to the analyst. Unbundled databases put an ordered event log and stream operators in front of the same stores so writes flow down into them.">
      {panels.map((p) => {
        const cx = p.x0 + 210;
        const cls = p.good ? 'ua-box is-good' : 'ua-box';
        const ln = p.good ? 'ua-solid is-good' : 'ua-solid';
        const hd = p.good ? 'ua-head is-good' : 'ua-head';
        return (
          <>
            <rect x={p.x0} y="12" width="420" height="348" rx="6" class="ua-panel" />
            <text x={p.x0 + 20} y="40" class="ua-ph"><tspan data-lang-en>{p.title[0]}</tspan><tspan data-lang-vi>{p.title[1]}</tspan></text>
            <rect x={cx - 100} y="56" width="200" height="46" rx="4" class="ua-box" />
            <DiagramIcon name={p.top.icon as any} x={cx - 72} y={79} size={26} />
            <text x={cx - 48} y="84" class="ua-b"><tspan data-lang-en>{p.top.en}</tspan><tspan data-lang-vi>{p.top.vi}</tspan></text>
            <path d={p.up ? `M${cx},148 L${cx},109` : `M${cx},102 L${cx},141`} class={ln} />
            <polygon points={p.up ? heads(cx, 102, true) : heads(cx, 148)} class={hd} />
            <rect x={cx - 120} y="148" width="240" height="60" rx="4" class={cls} />
            <DiagramIcon name={p.mid.icon as any} x={cx - 92} y={178} size={28} />
            <text x={cx - 64} y="174" class="ua-b"><tspan data-lang-en>{p.mid.en}</tspan><tspan data-lang-vi>{p.mid.vi}</tspan></text>
            <text x={cx - 64} y="192" class="ua-m"><tspan data-lang-en>{p.mid.sen}</tspan><tspan data-lang-vi>{p.mid.svi}</tspan></text>
            {stores.map((s, k) => {
              const sx = p.x0 + 20 + k * 135;
              const scx = sx + 60;
              return (
                <>
                  <path d={p.up ? `M${scx},258 L${scx},${233} L${cx},233 L${cx},215` : `M${cx},208 L${cx},233 L${scx},233 L${scx},251`} class={ln} />
                  <polygon points={p.up ? heads(cx, 208, true) : heads(scx, 258)} class={hd} />
                  <rect x={sx} y="258" width="120" height="66" rx="4" class="ua-box" />
                  <DiagramIcon name={s.icon as any} x={scx} y={281} size={26} />
                  <text x={scx} y="314" text-anchor="middle" class="ua-m"><tspan data-lang-en>{s.en}</tspan><tspan data-lang-vi>{s.vi}</tspan></text>
                </>
              );
            })}
            <text x={cx} y="346" text-anchor="middle" class={p.good ? 'ua-n is-good' : 'ua-n'}><tspan data-lang-en>{p.note[0]}</tspan><tspan data-lang-vi>{p.note[1]}</tspan></text>
          </>
        );
      })}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Same three stores in both pictures. Look at the arrows: reads flow up on the left, writes flow down on the right.</span>
    <span data-lang-vi>Cả hai hình dùng cùng ba kho. Nhìn mũi tên: bên trái đường đọc đi lên, bên phải đường ghi đi xuống.</span>
  </figcaption>
</figure>

<style>
  .ua-fig { margin: 2em 0; width: 100%; }
  .ua-scroll { overflow-x: auto; }
  .ua-fig svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .ua-fig text { font-size: 13px; fill: var(--text-body); }
  .ua-fig .ua-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-ph { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-b { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-m { font-size: 12.5px; fill: var(--text-muted); }
  .ua-fig .ua-n { font-size: 12.5px; font-weight: 700; fill: var(--text-muted); }
  .ua-fig .ua-n.is-hot, .ua-fig .ua-b.is-hot, .ua-fig .ua-m.is-hot { fill: var(--red); }
  .ua-fig .ua-n.is-good, .ua-fig .ua-b.is-good, .ua-fig .ua-m.is-good { fill: var(--gold-icon); }
  .ua-fig .ua-q { font-size: 20px; font-weight: 700; fill: var(--red); }
  .ua-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .ua-box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .ua-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .ua-panel { fill: none; stroke: var(--border); stroke-width: 1.2; }
  .ua-life { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .ua-solid { fill: none; stroke: var(--text-muted); stroke-width: 1.8; }
  .ua-dashed { fill: none; stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .ua-head { fill: var(--text-muted); }
  .ua-solid.is-hot, .ua-dashed.is-hot { stroke: var(--red); stroke-width: 1.9; }
  .ua-head.is-hot { fill: var(--red); }
  .ua-solid.is-good { stroke: var(--gold-icon); stroke-width: 2; }
  .ua-head.is-good { fill: var(--gold-icon); }
  .ua-fig figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
