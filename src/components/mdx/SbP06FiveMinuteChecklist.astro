---
// The 5-minute sequential scan order through a Vietnamese company's financial statement.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 250;

const MINS = [
  { x: 20, w: 158, min: 'Min 1', icon: 'shield', tEn: 'Audit + Scope', tVi: 'Kiểm toán', dEn: 'Consolidated & clean opinion', dVi: 'Hợp nhất & chấp nhận', red: false },
  { x: 195, w: 158, min: 'Min 2', icon: 'bank', tEn: 'Cash vs Debt', tVi: 'Tiền vs Nợ', dEn: 'Deposits > short debt?', dVi: 'Tiền gửi vs Nợ vay', red: false },
  { x: 370, w: 158, min: 'Min 3', icon: 'chart', tEn: 'Core Margin', tVi: 'Biên lãi gộp', dEn: 'Gross profit vs one-offs', dVi: 'Lãi cốt lõi vs đột biến', red: false },
  { x: 545, w: 158, min: 'Min 4', icon: 'coin', tEn: 'CFO Test', tVi: 'Kiểm tra CFO', dEn: 'CFO >= Net Profit?', dVi: 'Tiền CFO >= LNST?', red: true },
  { x: 720, w: 160, min: 'Min 5', icon: 'warning', tEn: 'Footnotes', tVi: 'Thuyết minh', dEn: 'Receivables & related', dVi: 'Phải thu & bên liên quan', red: false },
] as const;
---
<figure class="sbp6-5m">
  <div class="sbp6-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Five-minute BCTC scanning sequence: Minute 1 audit opinion and consolidated scope, Minute 2 cash vs financial debt, Minute 3 revenue and gross margin vs one-off gains, Minute 4 operating cash flow vs net profit, Minute 5 receivables and footnotes.">
      <text x="20" y="30" class="sbp6-title">
        <tspan data-lang-en>The 5-minute financial statement checklist (read in this exact order)</tspan>
        <tspan data-lang-vi>Quy trình đọc BCTC trong 5 phút (đi đúng theo 5 trạm từ trái sang phải)</tspan>
      </text>

      {MINS.map((m, i) => (
        <g>
          <rect
            x={m.x}
            y="56"
            width={m.w}
            height="168"
            rx="10"
            class={m.red ? 'sbp6-card-red' : 'sbp6-card'}
          />
          <text x={m.x + 16} y="80" class={m.red ? 'sbp6-min sbp6-red' : 'sbp6-min'}>{m.min}</text>
          <DiagramIcon name={m.icon} x={m.x + m.w / 2} y={114} size={24} />
          <text x={m.x + m.w / 2} y="154" text-anchor="middle" class={m.red ? 'sbp6-hdr sbp6-red' : 'sbp6-hdr'}>
            <tspan data-lang-en>{m.tEn}</tspan>
            <tspan data-lang-vi>{m.tVi}</tspan>
          </text>
          <text x={m.x + m.w / 2} y="184" text-anchor="middle" class="sbp6-sub">
            <tspan data-lang-en>{m.dEn}</tspan>
            <tspan data-lang-vi>{m.dVi}</tspan>
          </text>
          {i < 4 && (
            <g>
              <line x1={m.x + m.w + 2} y1="140" x2={m.x + m.w + 11} y2="140" class="sbp6-line" />
              <polygon points={`${m.x + m.w + 11},136 ${m.x + m.w + 16},140 ${m.x + m.w + 11},144`} class="sbp6-arrow" />
            </g>
          )}
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>You do not need an accounting degree to eliminate risky stocks fast: start with the auditor paragraph, compare real cash against financial debt, verify gross profit vs one-offs, confirm operating cash flow, then peek at footnotes.</span>
    <span data-lang-vi>Không cần bằng kế toán để lọc bỏ công ty rủi ro: đi lần lượt từ ý kiến kiểm toán, tiền mặt đối đầu nợ vay, lãi gộp vs thu nhập đột biến, dòng tiền CFO rồi lướt qua thuyết minh.</span>
  </figcaption>
</figure>

<style>
  .sbp6-5m { margin: 2em 0; width: 100%; }
  .sbp6-scroll { overflow-x: auto; }
  .sbp6-5m svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sbp6-5m text { font-size: 12.5px; fill: var(--text-body); }
  .sbp6-title { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sbp6-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .sbp6-card-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .sbp6-min { font-size: 12px; font-weight: 700; fill: var(--text-muted); }
  .sbp6-hdr { font-size: 14px; font-weight: 700; fill: var(--text); }
  .sbp6-red { fill: var(--red); }
  .sbp6-sub { font-size: 11.5px; fill: var(--text-muted); }
  .sbp6-line { stroke: var(--text-muted); stroke-width: 1.8; }
  .sbp6-arrow { fill: var(--text-muted); }
  .sbp6-5m figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
