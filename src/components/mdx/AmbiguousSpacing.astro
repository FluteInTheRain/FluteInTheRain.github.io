---
// Chapter 3, "avoid ambiguous spacing": four places the book names (forms, article headings,
// bulleted lists, horizontal components), each drawn twice: even spacing on top, grouped below.
// Grey bars stand for text. Gaps are drawn at real pixel values.

const W = 900;
const H = 420;
const colX = [20, 245, 470, 695];
const cw = 190;
const rowY = [52, 236];
const cols = [
  { en: 'Form', vi: 'Form' },
  { en: 'Article heading', vi: 'Tiêu đề bài viết' },
  { en: 'Bulleted list', vi: 'Danh sách' },
  { en: 'Row of stats', vi: 'Hàng chỉ số' },
];
---
<figure class="amb">
  <div class="amb-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four pairs of small mock-ups. Top row, ambiguous: form labels equally close to the input above and below, a heading as close to the paragraph above as below, list items spaced like lines, and stat numbers evenly spaced from all labels. Bottom row, grouped: more space between groups than inside them.">
      {cols.map((c, i) => (
        <text x={colX[i]} y="22" class="amb-col">
          <tspan data-lang-en>{c.en}</tspan>
          <tspan data-lang-vi>{c.vi}</tspan>
        </text>
      ))}
      <text x="20" y={rowY[0] - 10} class="amb-row is-bad">
        <tspan data-lang-en>Even spacing: which goes with which?</tspan>
        <tspan data-lang-vi>Cách đều: cái nào đi với cái nào?</tspan>
      </text>
      <text x="20" y={rowY[1] - 10} class="amb-row is-good">
        <tspan data-lang-en>More space around groups than inside them</tspan>
        <tspan data-lang-vi>Khoảng quanh nhóm lớn hơn khoảng trong nhóm</tspan>
      </text>

      {[false, true].map((good, r) => {
        const y0 = rowY[r] + 8;
        // Form: label + input, three times
        const inGap = good ? 4 : 10;
        const between = good ? 18 : 10;
        const form = [0, 1, 2].map((i) => {
          const y = y0 + i * (8 + inGap + 22 + between);
          return { ly: y, iy: y + 8 + inGap };
        });
        // Article: paragraph, heading, paragraph
        const above = good ? 26 : 10;
        const below = good ? 8 : 10;
        // List: three items of two lines each
        const lineGap = 12;
        const itemGap = good ? 12 : 0;
        // Stats: three number+label pairs in a row
        const statInner = good ? 4 : 12;
        const statGap = good ? 22 : 12;
        return (
          <g>
            {form.map((f) => (
              <g>
                <rect x={colX[0]} y={f.ly} width="56" height="8" rx="3" class="amb-text" />
                <rect x={colX[0]} y={f.iy} width={cw - 20} height="22" rx="4" class="amb-input" />
              </g>
            ))}

            {[0, 1, 2].map((i) => <rect x={colX[1]} y={y0 + i * 12} width={i === 2 ? 110 : cw - 10} height="6" rx="3" class="amb-text is-soft" />)}
            <rect x={colX[1]} y={y0 + 24 + 6 + above} width="120" height="11" rx="3" class="amb-head" />
            {[0, 1, 2].map((i) => <rect x={colX[1]} y={y0 + 24 + 6 + above + 11 + below + i * 12} width={i === 2 ? 90 : cw - 10} height="6" rx="3" class="amb-text is-soft" />)}

            {[0, 1, 2].map((i) => {
              const y = y0 + i * (2 * lineGap + itemGap);
              return (
                <g>
                  <circle cx={colX[2] + 4} cy={y + 3} r="3" class="amb-head" />
                  <rect x={colX[2] + 14} y={y} width={cw - 24} height="6" rx="3" class="amb-text is-soft" />
                  <rect x={colX[2] + 14} y={y + lineGap} width={110} height="6" rx="3" class="amb-text is-soft" />
                </g>
              );
            })}

            {[0, 1, 2].map((i) => {
              // number + label pairs laid out in one row; only the gaps differ
              const numW = 18;
              const labW = 26;
              const x = colX[3] + i * (numW + statInner + labW + statGap);
              return (
                <g>
                  <text x={x} y={y0 + 20} class="amb-num">{[12, 48, 7][i]}</text>
                  <rect x={x + numW + statInner} y={y0 + 12} width={labW} height="7" rx="3" class="amb-text" />
                </g>
              );
            })}
            <text x={colX[3]} y={y0 + 52} class="amb-hint">
              <tspan data-lang-en>{good ? 'Three clear pairs' : 'Six evenly spaced items'}</tspan>
              <tspan data-lang-vi>{good ? 'Ba cặp rõ ràng' : 'Sáu thứ cách đều nhau'}</tspan>
            </text>
          </g>
        );
      })}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Grey bars stand for text. Nothing moved except the gaps, and the groups appear.</span>
    <span data-lang-vi>Các thanh xám thay cho chữ. Không có gì di chuyển ngoài khoảng cách, vậy mà các nhóm hiện ra.</span>
  </figcaption>
</figure>

<style>
  .amb { margin: 2em 0; width: 100%; }
  .amb-scroll { overflow-x: auto; }
  .amb svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .amb text { font-size: 14px; fill: var(--text-body); }
  .amb text.amb-col { font-size: 15px; font-weight: 700; fill: var(--text); }
  .amb text.amb-row { font-weight: 600; }
  .amb text.amb-row.is-bad { fill: var(--text-muted); }
  .amb text.amb-row.is-good { fill: var(--red); }
  .amb-text { fill: var(--text-muted); }
  .amb-text.is-soft { fill: var(--text-faint); }
  .amb-head { fill: var(--text); }
  .amb-input { fill: none; stroke: var(--text-muted); stroke-width: 1.2; }
  .amb text.amb-num { font-size: 16px; font-weight: 700; fill: var(--text); font-variant-numeric: tabular-nums; }
  .amb text.amb-hint { font-size: 13px; fill: var(--text-muted); }
  .amb figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
