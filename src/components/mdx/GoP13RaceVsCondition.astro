---
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 432;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const aTop = arrow(186, 174, 672, 174);
const aBot = arrow(186, 396, 672, 396);
---
<figure class="g13rvc">
  <div class="g13rvc-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Comparison between a data race and a race condition. Top: unprotected i++ reads 0 twice and overwrites i=1; caught by -race. Bottom: mutex-protected assignments i=1 and i=2 pass -race yet final i still varies by execution order.">
      {/* Row 1: Data race */}
      <text x="20" y="24" class="g13rvc-h is-red">
        <tspan data-lang-en>1. Data race: unprotected i++ loses an update</tspan>
        <tspan data-lang-vi>1. Data race: i++ không khóa làm mất một lần tăng</tspan>
      </text>

      <DiagramIcon name="gopher" x={31} y={73} size={24} />
      <text x="48" y="78" class="g13rvc-lane">G1 (i++)</text>
      <DiagramIcon name="gopher" x={31} y={127} size={24} />
      <text x="48" y="132" class="g13rvc-lane">G2 (i++)</text>
      <text x="20" y="178" class="g13rvc-sub">
        <tspan data-lang-en>time (i starts at 0)</tspan>
        <tspan data-lang-vi>thời gian (i ban đầu = 0)</tspan>
      </text>

      <line x1="118" y1="73" x2="668" y2="73" class="g13rvc-track" />
      <line x1="118" y1="127" x2="668" y2="127" class="g13rvc-track" />
      <g class="g13rvc-arrow"><path class="fm-flow-slow" d={aTop.line} /><polygon points={aTop.head} /></g>

      {/* G1 steps */}
      <rect x="130" y="54" width="126" height="36" rx="6" class="g13rvc-step" />
      <text x="193" y="77" text-anchor="middle">read i → 0</text>
      <rect x="392" y="54" width="126" height="36" rx="6" class="g13rvc-step is-red" />
      <text x="455" y="77" text-anchor="middle" class="is-red">write i = 1</text>

      {/* G2 steps */}
      <rect x="262" y="108" width="126" height="36" rx="6" class="g13rvc-step" />
      <text x="325" y="131" text-anchor="middle">read i → 0</text>
      <rect x="528" y="108" width="126" height="36" rx="6" class="g13rvc-step is-red" />
      <text x="591" y="131" text-anchor="middle" class="is-red">write i = 1</text>

      {/* Outcome 1 */}
      <rect x="684" y="52" width="196" height="94" rx="8" class="g13rvc-out is-red fm-pulse" />
      <DiagramIcon name="bug" x={702} y={99} size={24} />
      <text x="790" y="82" text-anchor="middle" class="g13rvc-out-b is-red">
        <tspan data-lang-en>Final i = 1 (not 2)</tspan>
        <tspan data-lang-vi>Kết quả i = 1 (sai)</tspan>
      </text>
      <text x="790" y="108" text-anchor="middle" class="g13rvc-sub">
        <tspan data-lang-en>Unsynchronized write</tspan>
        <tspan data-lang-vi>Ghi đụng ô nhớ</tspan>
      </text>
      <text x="790" y="130" text-anchor="middle" class="is-red">go run -race fails</text>

      <line x1="20" y1="202" x2="880" y2="202" class="g13rvc-rule" />

      {/* Row 2: Race condition */}
      <text x="20" y="230" class="g13rvc-h">
        <tspan data-lang-en>2. Race condition: mutex protects memory, yet order decides result</tspan>
        <tspan data-lang-vi>2. Race condition: có mutex bảo vệ nhưng thứ tự chạy vẫn quyết định kết quả</tspan>
      </text>

      <DiagramIcon name="gopher" x={31} y={297} size={24} />
      <text x="48" y="302" class="g13rvc-lane">G1 (i = 1)</text>
      <DiagramIcon name="gopher" x={31} y={351} size={24} />
      <text x="48" y="356" class="g13rvc-lane">G2 (i = 2)</text>
      <text x="20" y="400" class="g13rvc-sub">
        <tspan data-lang-en>two valid runs</tspan>
        <tspan data-lang-vi>hai lượt chạy hợp lệ</tspan>
      </text>

      <line x1="118" y1="297" x2="668" y2="297" class="g13rvc-track" />
      <line x1="118" y1="351" x2="668" y2="351" class="g13rvc-track" />
      <g class="g13rvc-arrow"><path class="fm-flow-slow" d={aBot.line} /><polygon points={aBot.head} /></g>

      {/* Run A: G1 first then G2 -> i = 2 */}
      <rect x="130" y="278" width="136" height="36" rx="6" class="g13rvc-step is-gold" />
      <text x="198" y="301" text-anchor="middle">Lock · i=1 · Unlock</text>
      <rect x="276" y="332" width="136" height="36" rx="6" class="g13rvc-step is-gold" />
      <text x="344" y="355" text-anchor="middle">Lock · i=2 · Unlock</text>
      <text x="276" y="266" text-anchor="middle" class="g13rvc-sub">
        <tspan data-lang-en>Run A: i ends at 2</tspan>
        <tspan data-lang-vi>Lượt A: cuối i = 2</tspan>
      </text>

      {/* Divider between Run A and Run B */}
      <line x1="426" y1="258" x2="426" y2="374" class="g13rvc-rule" />

      {/* Run B: G2 first then G1 -> i = 1 */}
      <rect x="440" y="332" width="110" height="36" rx="6" class="g13rvc-step" />
      <text x="495" y="355" text-anchor="middle">Lock · i=2</text>
      <rect x="558" y="278" width="110" height="36" rx="6" class="g13rvc-step" />
      <text x="613" y="301" text-anchor="middle">Lock · i=1</text>
      <text x="554" y="266" text-anchor="middle" class="g13rvc-sub">
        <tspan data-lang-en>Run B: i ends at 1</tspan>
        <tspan data-lang-vi>Lượt B: cuối i = 1</tspan>
      </text>

      {/* Outcome 2 */}
      <rect x="684" y="274" width="196" height="96" rx="8" class="g13rvc-out is-gold" />
      <DiagramIcon name="ok" x={702} y={322} size={24} />
      <text x="790" y="304" text-anchor="middle" class="g13rvc-out-b">
        <tspan data-lang-en>Final i = 1 or 2</tspan>
        <tspan data-lang-vi>Kết quả i = 1 hoặc 2</tspan>
      </text>
      <text x="790" y="330" text-anchor="middle" class="g13rvc-sub">
        <tspan data-lang-en>No memory corruption</tspan>
        <tspan data-lang-vi>Không đụng ô nhớ</tspan>
      </text>
      <text x="790" y="352" text-anchor="middle" class="g13rvc-gold">
        <tspan data-lang-en>-race prints 0 warnings</tspan>
        <tspan data-lang-vi>-race báo 0 cảnh báo</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A clean go test -race run only proves there is no data race. When correctness depends on which goroutine acquires the mutex first, the program still has a race condition.</span>
    <span data-lang-vi>Chạy go test -race xanh chỉ chứng minh không có data race ở tầng bộ nhớ. Khi kết quả đúng sai vẫn phụ thuộc goroutine nào lấy được mutex trước, code vẫn còn race condition.</span>
  </figcaption>
</figure>

<style>
  .g13rvc { margin: 2em 0; width: 100%; }
  .g13rvc-scroll { overflow-x: auto; }
  .g13rvc svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .g13rvc text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .g13rvc-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .g13rvc-h.is-red { fill: var(--red); }
  .g13rvc-lane { font-size: 14px; font-weight: 700; fill: var(--text); }
  .g13rvc-sub { font-size: 12.5px; fill: var(--text-muted); }
  .g13rvc-track { stroke: var(--border); stroke-width: 2; }
  .g13rvc-rule { stroke: var(--border); }
  .g13rvc-step { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .g13rvc-step.is-red { fill: var(--red-tint-bg); stroke: var(--red); }
  .g13rvc-step.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .g13rvc-out { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .g13rvc-out.is-red { fill: var(--red-tint-bg); stroke: var(--red); }
  .g13rvc-out.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .g13rvc-out-b { font-size: 14px; font-weight: 700; fill: var(--text); }
  .g13rvc-out-b.is-red { fill: var(--red); }
  .g13rvc text.is-red { fill: var(--red); font-weight: 600; }
  .g13rvc-gold { fill: var(--gold-icon); font-weight: 600; }
  .g13rvc-arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .g13rvc-arrow polygon { fill: var(--text-muted); }
  .g13rvc figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
