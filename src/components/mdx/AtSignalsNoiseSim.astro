---
// The SAME simulated signal, generated once, then covered by four different
// noise realisations. A dashed line marks the true signal that generated the
// points; a red curve shows what a very flexible model "learns" from that one
// realisation — it follows the noise, not the truth. A re-roll button draws
// four new realisations. Static render is seeded, so the first picture is
// deterministic; the script only runs when the reader asks for new noise.

const W = 900;
const H = 452;
const PL = 52;      // panel left edge (col 1)
const PW = 392;     // panel width
const COL2 = 478;   // panel left edge (col 2)
const ROW1 = 40;
const ROW2 = 240;
const PH = 158;     // panel height (plot area)

const N = 60;

// the underlying signal, identical in every panel
const truth = (t: number) => 34 * Math.sin(2 * Math.PI * t) + 13 * Math.sin(4 * Math.PI * t + 1.2);

function mulberry(seed: number) {
  let a = seed;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const gauss = (r: () => number) => (r() + r() + r() + r() - 2) * 1.3;

function panelPoints(seed: number) {
  const r = mulberry(seed);
  const pts: [number, number][] = [];
  for (let i = 0; i <= N; i++) {
    const t = i / N;
    pts.push([t, truth(t) + gauss(r) * 16]);
  }
  return pts;
}

const px = (t: number, x0: number) => x0 + 8 + t * (PW - 24);
const py = (v: number, y0: number) => y0 + PH / 2 - v * 1.35;

// Catmull-Rom through the noisy points -> what an over-flexible model "learns"
function overfitPath(pts: [number, number][], x0: number, y0: number) {
  const p = pts.map(([t, v]) => [px(t, x0), py(v, y0)] as [number, number]);
  let d = `M ${p[0][0].toFixed(1)} ${p[0][1].toFixed(1)}`;
  for (let i = 0; i < p.length - 1; i++) {
    const p0 = p[Math.max(0, i - 1)];
    const p1 = p[i];
    const p2 = p[i + 1];
    const p3 = p[Math.min(p.length - 1, i + 2)];
    const c1x = p1[0] + (p2[0] - p0[0]) / 6;
    const c1y = p1[1] + (p2[1] - p0[1]) / 6;
    const c2x = p2[0] - (p3[0] - p1[0]) / 6;
    const c2y = p2[1] - (p3[1] - p1[1]) / 6;
    d += ` C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
  }
  return d;
}

function truthPath(x0: number, y0: number) {
  let d = '';
  for (let i = 0; i <= 120; i++) {
    const t = i / 120;
    d += `${i ? 'L' : 'M'} ${px(t, x0).toFixed(1)} ${py(truth(t), y0).toFixed(1)}`;
  }
  return d;
}

function noisyPath(pts: [number, number][], x0: number, y0: number) {
  return pts.map(([t, v], i) => `${i ? 'L' : 'M'} ${px(t, x0).toFixed(1)} ${py(v, y0).toFixed(1)}`).join(' ');
}

const SEEDS = [301, 302, 303, 304];
const panels = [
  { x0: PL, y0: ROW1, seed: SEEDS[0], n: 1 },
  { x0: COL2, y0: ROW1, seed: SEEDS[1], n: 2 },
  { x0: PL, y0: ROW2, seed: SEEDS[2], n: 3 },
  { x0: COL2, y0: ROW2, seed: SEEDS[3], n: 4 },
];
---

<figure class="atsig-ns">
  <div class="atsig-ns-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The same simulated signal under four different noise realisations. The dashed line is the true signal; the red curve is what a very flexible model learns from each realisation, and it follows the noise.">
      <text x={PL} y={20} class="h">
        <tspan data-lang-en>One signal, four rolls of the noise</tspan>
        <tspan data-lang-vi>Một tín hiệu, bốn lần xào nhiễu</tspan>
      </text>
      <defs>
        {panels.map((p) => (
          <clipPath id={`atsig-ns-clip-${p.n}`}>
            <rect x={p.x0 + 1} y={p.y0 + 1} width={PW - 2} height={PH - 2} rx="6" />
          </clipPath>
        ))}
      </defs>
      {panels.map((p) => {
        const pts = panelPoints(p.seed);
        return (
          <g>
            <rect x={p.x0} y={p.y0} width={PW} height={PH} rx="6" class="panel" />
            <g clip-path={`url(#atsig-ns-clip-${p.n})`}>
              <path d={truthPath(p.x0, p.y0)} class="truth" />
              <path d={noisyPath(pts, p.x0, p.y0)} class="noisy" data-noise={p.n} />
              <path d={overfitPath(pts, p.x0, p.y0)} class="overfit" data-overfit={p.n} />
            </g>
            <text x={p.x0 + 10} y={p.y0 + 18} class="tick">
              <tspan data-lang-en>{`Roll ${p.n}`}</tspan>
              <tspan data-lang-vi>{`Lần ${p.n}`}</tspan>
            </text>
          </g>
        );
      })}
      <text x={COL2 + 10} y={ROW1 + 40} class="legend truth-legend">
        <tspan data-lang-en>dashed: the signal that generated the data</tspan>
        <tspan data-lang-vi>đường đứt: tín hiệu thật tạo ra dữ liệu</tspan>
      </text>
      <text x={COL2 + 10} y={ROW1 + 60} class="legend overfit-legend">
        <tspan data-lang-en>red: what a flexible model "learns"</tspan>
        <tspan data-lang-vi>đỏ: cái mô hình linh hoạt "học" được</tspan>
      </text>
    </svg>
  </div>
  <button type="button" class="atsig-ns-reroll">
    <span data-lang-en>Deal new noise</span>
    <span data-lang-vi>Xào bộ nhiễu mới</span>
  </button>
  <figcaption>
    <span data-lang-en>Simulated data. Same truth four times; only the noise changes. A flexible model trained on one roll finds confident patterns that exist only in that roll — and every roll "explains" its noise just as well.</span>
    <span data-lang-vi>Số liệu mô phỏng. Cùng một tín hiệu thật bốn lần; chỉ nhiễu thay đổi. Mô hình đủ linh hoạt huấn luyện trên một lần xào sẽ tìm ra các "quy luật" tồn tại duy nhất trong lần xào đó — và lần nào nó cũng giải thích nhiễu của mình không kém cỏi.</span>
  </figcaption>
</figure>

<style>
  .atsig-ns {
    margin: 2em 0;
    width: 100%;
  }
  .atsig-ns-scroll {
    overflow-x: auto;
  }
  .atsig-ns svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .atsig-ns .h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .atsig-ns .tick {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .atsig-ns .legend {
    font-size: 12.5px;
  }
  .atsig-ns .truth-legend {
    fill: var(--text-muted);
  }
  .atsig-ns .overfit-legend {
    fill: var(--red);
  }
  .atsig-ns .panel {
    fill: var(--bg-alt);
    stroke: var(--border);
  }
  .atsig-ns .truth {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.2;
    stroke-dasharray: 4 4;
  }
  .atsig-ns .noisy {
    fill: none;
    stroke: var(--text-faint);
    stroke-width: 1;
  }
  .atsig-ns .overfit {
    fill: none;
    stroke: var(--red);
    stroke-width: 1.8;
  }
  .atsig-ns-reroll {
    display: block;
    margin: 10px auto 0;
    padding: 7px 16px;
    font: inherit;
    font-size: 14px;
    color: var(--text);
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
  }
  .atsig-ns-reroll:hover {
    border-color: var(--red);
    color: var(--red);
  }
  .atsig-ns figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>

<script>
  // Re-roll: same truth, four new noise realisations. Runs only on click,
  // so the static render stays the deterministic, seeded first picture.
  document.querySelectorAll('.atsig-ns').forEach((root) => {
    const btn = root.querySelector('.atsig-ns-reroll') as HTMLButtonElement | null;
    if (!btn) return;
    let base = 301;

    function mulberry(seed: number) {
      let a = seed;
      return () => {
        a = (a + 0x6d2b79f5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    const gauss = (r: () => number) => (r() + r() + r() + r() - 2) * 1.3;
    const truth = (t: number) => 34 * Math.sin(2 * Math.PI * t) + 13 * Math.sin(4 * Math.PI * t + 1.2);
    const N = 60;
    const PL = 52, PW = 392, COL2 = 478, ROW1 = 40, ROW2 = 240, PH = 158;
    const px = (t: number, x0: number) => x0 + 8 + t * (PW - 24);
    const py = (v: number, y0: number) => y0 + PH / 2 - v * 1.35;

    function overfitPath(pts: [number, number][], x0: number, y0: number) {
      const p = pts.map(([t, v]) => [px(t, x0), py(v, y0)] as [number, number]);
      let d = `M ${p[0][0].toFixed(1)} ${p[0][1].toFixed(1)}`;
      for (let i = 0; i < p.length - 1; i++) {
        const p0 = p[Math.max(0, i - 1)];
        const p1 = p[i];
        const p2 = p[i + 1];
        const p3 = p[Math.min(p.length - 1, i + 2)];
        const c1x = p1[0] + (p2[0] - p0[0]) / 6;
        const c1y = p1[1] + (p2[1] - p0[1]) / 6;
        const c2x = p2[0] - (p3[0] - p1[0]) / 6;
        const c2y = p2[1] - (p3[1] - p1[1]) / 6;
        d += ` C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
      }
      return d;
    }
    const noisyPath = (pts: [number, number][], x0: number, y0: number) =>
      pts.map(([t, v], i) => `${i ? 'L' : 'M'} ${px(t, x0).toFixed(1)} ${py(v, y0).toFixed(1)}`).join(' ');

    function points(seed: number) {
      const r = mulberry(seed);
      const pts: [number, number][] = [];
      for (let i = 0; i <= N; i++) {
        const t = i / N;
        pts.push([t, truth(t) + gauss(r) * 16]);
      }
      return pts;
    }

    const xs = [PL, COL2, PL, COL2];
    const ys = [ROW1, ROW1, ROW2, ROW2];

    btn.addEventListener('click', () => {
      base += 17;
      for (let k = 0; k < 4; k++) {
        const pts = points(base + k + 1);
        const noiseEl = root.querySelector(`[data-noise="${k + 1}"]`) as SVGPathElement | null;
        const overfitEl = root.querySelector(`[data-overfit="${k + 1}"]`) as SVGPathElement | null;
        if (noiseEl) noiseEl.setAttribute('d', noisyPath(pts, xs[k], ys[k]));
        if (overfitEl) overfitEl.setAttribute('d', overfitPath(pts, xs[k], ys[k]));
      }
    });
  });
</script>
