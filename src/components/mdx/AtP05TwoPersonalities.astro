---
import DiagramIcon from './DiagramIcon.astro';
// Two fitted normal curves for S&P 500 daily log returns, Dec 2016 - Nov 2026 (FRED SP500).
// Parameters come from a 2-state Gaussian HMM fitted with EM (python, see the post's sources note):
// calm sigma 0.639% a day (10.1% a year), turbulent sigma 1.935% a day (30.7% a year).
// Only fitted parameters are drawn, not the index series itself (S&P data is licensed).
const W = 900, H = 350;
const x0 = 60, x1 = 840, base = 300;
const lo = -6, hi = 6;
const X = (v: number) => x0 + ((v - lo) / (hi - lo)) * (x1 - x0);
const calm = { mu: 0.110, sd: 0.639 };
const turb = { mu: -0.119, sd: 1.935 };
const pdf = (v: number, m: number, s: number) => Math.exp(-0.5 * ((v - m) / s) ** 2) / (s * Math.sqrt(2 * Math.PI));
const scale = 190 / pdf(0, 0, calm.sd);
function path(m: number, s: number, close = false) {
  let d = '';
  for (let i = 0; i <= 240; i++) {
    const v = lo + (i / 240) * (hi - lo);
    d += `${i ? 'L' : 'M'} ${X(v).toFixed(1)} ${(base - pdf(v, m, s) * scale).toFixed(1)} `;
  }
  return close ? d + `L ${X(hi)} ${base} L ${X(lo)} ${base} Z` : d;
}
const ticks = [-6, -4, -2, 0, 2, 4, 6];
---
<figure class="p5a">
  <div class="p5a-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two bell curves of daily S&P 500 returns. A tall narrow curve for the calm state, about 0.64 percent a day, and a low wide curve for the turbulent state, about 1.93 percent a day. A marker at minus 3.41 percent, the return of 24 February 2020, sits far out on the calm curve and well inside the turbulent one.">
    <text x="20" y="26" class="h">
      <tspan data-lang-en>One index, two personalities</tspan>
      <tspan data-lang-vi>Một chỉ số, hai tính cách</tspan>
    </text>
    <text x="20" y="46" class="sub">
      <tspan data-lang-en>Daily S&amp;P 500 returns, Dec 2016 to Nov 2026, split by a two-state model</tspan>
      <tspan data-lang-vi>Lợi suất ngày của S&amp;P 500, 12/2016 tới 11/2026, tách bằng mô hình hai trạng thái</tspan>
    </text>
    <path d={path(turb.mu, turb.sd, true)} class="area-t" />
    <path d={path(calm.mu, calm.sd, true)} class="area-c" />
    <path d={path(turb.mu, turb.sd)} class="line-t" />
    <path d={path(calm.mu, calm.sd)} class="line-c" />
    <line x1={x0} y1={base} x2={x1} y2={base} class="axis" />
    {ticks.map((t) => (
      <g>
        <line x1={X(t)} y1={base} x2={X(t)} y2={base + 5} class="axis" />
        <text x={X(t)} y={base + 22} text-anchor="middle" class="tick">{t > 0 ? '+' : ''}{t}%</text>
      </g>
    ))}
    <text x={(x0 + x1) / 2} y={base + 44} text-anchor="middle" class="sub">
      <tspan data-lang-en>return in one day</tspan>
      <tspan data-lang-vi>lợi suất trong một ngày</tspan>
    </text>

    <line x1={X(-3.41)} y1="78" x2={X(-3.41)} y2={base} class="mark" />
    <text x={X(-3.41) - 8} y="94" text-anchor="end" class="mark-t">
      <tspan data-lang-en>24 Feb 2020: −3.41%</tspan>
      <tspan data-lang-vi>24/2/2020: −3,41%</tspan>
    </text>

    <DiagramIcon name="ok" x={X(0.9) + 24} y="92" size="22" />
    <text x={X(0.9) + 44} y="88" class="lab-c">
      <tspan data-lang-en>Calm: ±0.64% a day</tspan>
      <tspan data-lang-vi>Yên: ±0,64% mỗi ngày</tspan>
    </text>
    <text x={X(0.9) + 44} y="106" class="note">
      <tspan data-lang-en>10.1% a year, about 72% of days long run</tspan>
      <tspan data-lang-vi>10,1% một năm, khoảng 72% số ngày về lâu dài</tspan>
    </text>
    <DiagramIcon name="warning" x={X(2.6) + 24} y="180" size="22" />
    <text x={X(2.6) + 44} y="176" class="lab-t">
      <tspan data-lang-en>Turbulent: ±1.93%</tspan>
      <tspan data-lang-vi>Hỗn loạn: ±1,93%</tspan>
    </text>
    <text x={X(2.6) + 44} y="194" class="note">
      <tspan data-lang-en>30.7% a year, about 28% of days</tspan>
      <tspan data-lang-vi>30,7% một năm, khoảng 28% số ngày</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Fitted from real S&amp;P 500 closes (FRED). In the calm state, a −3.41% day lies 5.3 standard deviations out, roughly one day in ten million. In the turbulent state it is ordinary.</span>
    <span data-lang-vi>Khớp từ giá đóng cửa thật của S&amp;P 500 (FRED). Ở trạng thái yên, một ngày −3,41% nằm cách trung bình 5,3 độ lệch chuẩn, cỡ một ngày trong mười triệu ngày. Ở trạng thái hỗn loạn, nó là chuyện thường.</span>
  </figcaption>
</figure>

<style>
  .p5a { margin: 2em 0; width: 100%; }
  .p5a-scroll { overflow-x: auto; }
  .p5a svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .p5a text { fill: var(--text-body); font-size: 13px; }
  .p5a .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p5a .sub, .p5a .note { fill: var(--text-muted); font-size: 12.5px; }
  .p5a .tick { fill: var(--text-muted); font-size: 12px; }
  .p5a .lab-c, .p5a .lab-t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .p5a .mark-t { font-size: 13px; font-weight: 700; fill: var(--red); }
  .p5a .axis { stroke: var(--border); stroke-width: 1.3; }
  .p5a .mark { stroke: var(--red); stroke-width: 1.5; stroke-dasharray: 4 4; }
  .p5a .area-c { fill: var(--gold-tint-bg); }
  .p5a .area-t { fill: var(--red-tint-bg); opacity: 0.8; }
  .p5a .line-c { fill: none; stroke: var(--gold); stroke-width: 2; }
  .p5a .line-t { fill: none; stroke: var(--red); stroke-width: 2; }
  .p5a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
