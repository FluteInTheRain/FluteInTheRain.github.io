---
// A box with an optional icon on the left, a title and up to two note lines.
// Part of the ReplicationB figure kit; style classes live in ReplicationBFrame.astro.
import DiagramIcon from './DiagramIcon.astro';
import Bi from './ReplicationBBi.astro';
import type { DiagramIconName } from '../../data/diagram-icons';

interface Props {
  x: number; y: number; w: number; h: number;
  icon?: DiagramIconName; iconSize?: number;
  t: string; tv?: string;
  s?: string; sv?: string;
  s2?: string; s2v?: string;
  cls?: string;
}
const { x, y, w, h, icon, iconSize = 26, t, tv, s, sv, s2, s2v, cls = '' } = Astro.props;
const tx = icon ? x + 46 : x + w / 2;
const anchor = icon ? 'start' : 'middle';
const lines = 1 + (s ? 1 : 0) + (s2 ? 1 : 0);
const top = y + h / 2 - ((lines - 1) * 17) / 2 + 5;
---
<rect x={x} y={y} width={w} height={h} rx="5" class={`rb-box ${cls}`} />
{icon && <DiagramIcon name={icon} x={x + 24} y={y + h / 2} size={iconSize} />}
<text x={tx} y={top} text-anchor={anchor} class="rb-h"><Bi en={t} vi={tv} /></text>
{s && <text x={tx} y={top + 17} text-anchor={anchor} class="rb-n"><Bi en={s} vi={sv} /></text>}
{s2 && <text x={tx} y={top + 34} text-anchor={anchor} class="rb-n"><Bi en={s2} vi={s2v} /></text>}
