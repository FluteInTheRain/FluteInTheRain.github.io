---
// A window closes when the watermark passes its end; a straggler arriving afterwards forces a choice. Numbers illustrative.
import StreamBFigure from './StreamBFigure.astro';
import StreamBNode from './StreamBNode.astro';
import StreamBArrow from './StreamBArrow.astro';
import StreamBNum from './StreamBNum.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    n1: ['Window 10:00 to 10:01', 'groups events by timestamp'],
    n2: ['Watermark passes 10:01', 'window closes, emits count 41'],
    n3: ['Straggler arrives', 'stamped 10:00:40, sent late'],
    o1: ['Option 1: ignore it', 'count it in a', 'dropped-late metric'],
    o2: ['Option 2: update', 'retract 41, then emit 42'],
    pick: 'choose one',
    alt: 'Three steps left to right. A window for 10:00 to 10:01 collects events by timestamp. The watermark passes 10:01 so the window closes and emits a count of 41. Then a straggler stamped 10:00:40 arrives late. Two options follow: ignore it and count it in a dropped-late metric, or emit an update that retracts 41 and emits 42.',
    cap: 'Illustrative numbers. The watermark is a promise that nothing older is still coming; a straggler is an event that breaks that promise.',
  },
  vi: {
    n1: ['Cửa sổ 10:00 đến 10:01', 'gom sự kiện theo mốc giờ'],
    n2: ['Watermark vượt qua 10:01', 'cửa sổ đóng, phát số đếm 41'],
    n3: ['Sự kiện lạc tới nơi', 'đóng dấu 10:00:40, gửi muộn'],
    o1: ['Lựa chọn 1: bỏ qua', 'ghi vào metric', 'sự kiện muộn bị bỏ'],
    o2: ['Lựa chọn 2: cập nhật', 'thu hồi 41, rồi phát 42'],
    pick: 'chọn một',
    alt: 'Ba bước từ trái sang phải. Cửa sổ 10:00 đến 10:01 gom sự kiện theo mốc giờ. Watermark vượt qua 10:01 nên cửa sổ đóng và phát số đếm 41. Rồi một sự kiện lạc đóng dấu 10:00:40 tới muộn. Có hai lựa chọn: bỏ qua và ghi vào metric sự kiện muộn bị bỏ, hoặc phát bản cập nhật thu hồi 41 và phát 42.',
    cap: 'Số liệu minh hoạ. Watermark là lời hứa rằng không còn sự kiện nào cũ hơn đang tới; sự kiện lạc là sự kiện phá lời hứa đó.',
  },
}[lang];
---
<StreamBFigure h={290} alt={T.alt} cap={T.cap}>
  <StreamBNum x={31} y={30} n={1} />
  <StreamBNum x={331} y={30} n={2} />
  <StreamBNum x={631} y={30} n={3} />
  <StreamBNode x={20} y={50} w={250} h={72} icon="clock" title={T.n1[0]} sub={[T.n1[1]]} />
  <StreamBNode x={320} y={50} w={250} h={72} icon="chart" title={T.n2[0]} sub={[T.n2[1]]} />
  <StreamBNode x={620} y={50} w={260} h={72} icon="phone" title={T.n3[0]} sub={[T.n3[1]]} kind="bad" />
  <StreamBArrow x1={270} y1={86} x2={320} y2={86} />
  <StreamBArrow x1={570} y1={86} x2={620} y2={86} />
  <StreamBArrow x1={750} y1={122} x2={470} y2={172} />
  <StreamBArrow x1={750} y1={122} x2={750} y2={172} />
  <text x="762" y="152" class="sub">{T.pick}</text>
  <StreamBNode x={330} y={172} w={280} h={84} icon="fail" title={T.o1[0]} sub={[T.o1[1], T.o1[2]]} />
  <StreamBNode x={640} y={172} w={240} h={84} icon="retry" title={T.o2[0]} sub={[T.o2[1]]} />
</StreamBFigure>
