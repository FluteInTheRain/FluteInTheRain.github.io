---
// What to do when a producer outruns a consumer: drop, buffer, or push back (backpressure).
// Message counts are illustrative.
import DiagramIcon from './DiagramIcon.astro';
import StreamAFrame from './StreamAFrame.astro';
import { arrow, elbow } from './StreamAHelpers';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    h: 'A fast producer, a slow consumer: three choices',
    p: 'Producer', c: 'Consumer',
    rows: [
      { n: 'Drop', s: 'Throw extra messages away', r: 'Some messages are lost' },
      { n: 'Buffer', s: 'Queue them up and wait', r: 'Memory or disk can run out' },
      { n: 'Backpressure', s: 'Tell the producer to slow down', r: 'Nothing lost, producer waits' },
    ],
    slow: 'slow down',
    alt: 'Three rows, each a producer on the left and a consumer on the right. Drop: two messages arrive and two fall away. Buffer: messages pile up in a queue between them. Backpressure: the consumer sends a slow-down signal back to the producer.',
    cap: 'Each row is one answer to the same problem. Only backpressure keeps every message without needing unlimited storage; TCP and Unix pipes work this way.',
  },
  vi: {
    h: 'Producer nhanh, consumer chậm: ba lựa chọn',
    p: 'Producer', c: 'Consumer',
    rows: [
      { n: 'Bỏ bớt (drop)', s: 'Vứt phần tin nhắn thừa', r: 'Một số tin nhắn bị mất' },
      { n: 'Đệm (buffer)', s: 'Xếp hàng chờ xử lý', r: 'RAM hoặc đĩa có thể cạn' },
      { n: 'Backpressure', s: 'Bảo producer chậm lại', r: 'Không mất gì, producer chờ' },
    ],
    slow: 'chậm lại',
    alt: 'Ba hàng, mỗi hàng có producer bên trái và consumer bên phải. Drop: hai tin nhắn tới nơi và hai tin nhắn rơi mất. Buffer: tin nhắn chất đống trong hàng đợi ở giữa. Backpressure: consumer gửi tín hiệu chậm lại về cho producer.',
    cap: 'Mỗi hàng là một cách trả lời cho cùng một vấn đề. Chỉ backpressure giữ được mọi tin nhắn mà không cần bộ nhớ vô hạn; TCP và Unix pipe chạy theo cách này.',
  },
}[lang];
const rowY = [74, 164, 254];
const px = 316, cx = 636;
const e = elbow([[cx - 6, rowY[2] + 11], [cx - 6, rowY[2] + 2], [px + 6, rowY[2] + 2], [px + 6, rowY[2] + 11]]);
---
<StreamAFrame h={340} alt={T.alt} cap={T.cap} title={T.h}>
  <text x={px} y="52" text-anchor="middle" class="sub">{T.p}</text>
  <text x={cx} y="52" text-anchor="middle" class="sub">{T.c}</text>
  {rowY.map((y, i) => {
    const cy = y + 28;
    const a = arrow(px + 24, cy, cx - 24, cy);
    return (
      <g>
        {i > 0 && <line x1="20" x2="880" y1={y - 14} y2={y - 14} class="rule" />}
        <text x="20" y={cy - 4} class="name">{T.rows[i].n}</text>
        <text x="20" y={cy + 16} class="sub">{T.rows[i].s}</text>
        <DiagramIcon name="server" x={px} y={cy} size={30} />
        <DiagramIcon name="worker" x={cx} y={cy} size={30} />
        <g class={i === 2 ? 'arr good' : 'arr'}><path d={a.line} /><polygon points={a.head} /></g>
        <text x="676" y={cy + 5} class={i === 2 ? 'name' : 'bad'} style={i === 2 ? 'font-size:13px' : undefined}>{T.rows[i].r}</text>
      </g>
    );
  })}
  <g class="box"><rect x="352" y={rowY[0] + 14} width="34" height="28" rx="4" /><rect x="392" y={rowY[0] + 14} width="34" height="28" rx="4" /></g>
  <g class="box off"><rect x="436" y={rowY[0] + 30} width="34" height="28" rx="4" /><rect x="476" y={rowY[0] + 38} width="34" height="28" rx="4" /></g>
  <DiagramIcon name="fail" x={540} y={rowY[0] + 50} size={20} />
  <g class="box"><rect x="352" y={rowY[1] + 8} width="204" height="40" rx="5" /></g>
  {[0, 1, 2, 3, 4].map((k) => <g class="box"><rect x={360 + k * 38} y={rowY[1] + 14} width="32" height="28" rx="4" /></g>)}
  <g class="arr good"><path d={e.line} /><polygon points={e.head} /></g>
  <text x={(px + cx) / 2} y={rowY[2] - 2} text-anchor="middle" class="name" style="font-size:13px">{T.slow}</text>
  <g class="box"><rect x="394" y={rowY[2] + 14} width="34" height="28" rx="4" /><rect x="436" y={rowY[2] + 14} width="34" height="28" rx="4" /></g>
</StreamAFrame>
