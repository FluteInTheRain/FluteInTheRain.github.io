---
// MVCC snapshot visibility rules: one row (acct #7) with four physical tuple versions
// in the heap, evaluated against reader tx 50 whose snapshot captured active tx {48}.
// Plain inline SVG using site tokens; no ids so EN/VI copies cannot collide.

const W = 900;
const H = 448;

type TupleRow = {
  val: string;
  insTx: string;
  insNoteEn: string;
  insNoteVi: string;
  delTx: string;
  delNoteEn: string;
  delNoteVi: string;
  statusEn: string;
  statusVi: string;
  state: 'hit' | 'hidden' | 'dead';
};

const rows: TupleRow[] = [
  {
    val: 'acct #7 · $250',
    insTx: 'tx 42',
    insNoteEn: 'committed before 50',
    insNoteVi: 'đã commit trước 50',
    delTx: 'tx 48',
    delNoteEn: 'active at snapshot → ignore',
    delNoteVi: 'đang chạy → bỏ qua',
    statusEn: 'Visible — read returns $250',
    statusVi: 'Thấy — lệnh đọc trả về $250',
    state: 'hit',
  },
  {
    val: 'acct #7 · $600',
    insTx: 'tx 48',
    insNoteEn: 'active when 50 started',
    insNoteVi: 'đang chạy khi 50 bắt đầu',
    delTx: '—',
    delNoteEn: 'not deleted',
    delNoteVi: 'chưa xoá',
    statusEn: 'Hidden — in-progress tx (rule 1)',
    statusVi: 'Ẩn — tx đang chạy lúc đầu (luật 1)',
    state: 'hidden',
  },
  {
    val: 'acct #7 · $100',
    insTx: 'tx 49',
    insNoteEn: 'rolled back',
    insNoteVi: 'đã abort',
    delTx: '—',
    delNoteEn: 'not deleted',
    delNoteVi: 'chưa xoá',
    statusEn: 'Hidden — aborted tx (rule 3)',
    statusVi: 'Ẩn — tx đã abort (luật 3)',
    state: 'dead',
  },
  {
    val: 'acct #7 · $900',
    insTx: 'tx 52',
    insNoteEn: 'started after tx 50',
    insNoteVi: 'bắt đầu sau tx 50',
    delTx: '—',
    delNoteEn: 'not deleted',
    delNoteVi: 'chưa xoá',
    statusEn: 'Hidden — newer tx > 50 (rule 2)',
    statusVi: 'Ẩn — tx > 50 mới hơn (luật 2)',
    state: 'hidden',
  },
];

const rowY = (i: number) => 164 + i * 64;
---
<figure class="txm">
  <div class="txm-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="MVCC snapshot visibility table for reader transaction 50. Four versions of account 7 sit in the heap with inserted_by and deleted_by transaction IDs. Reader 50 sees the 250 dollar version inserted by committed tx 42 because its deletion by tx 48 was still in progress when tx 50 started, while ignoring versions from active tx 48, aborted tx 49, and later tx 52.">
    <text x="20" y="26" class="txm-h">
      <tspan data-lang-en>MVCC visibility rules for reader tx 50</tspan>
      <tspan data-lang-vi>Quy tắc hiển thị MVCC cho giao dịch đọc tx 50</tspan>
    </text>
    <text x="20" y="48" class="txm-sub">
      <tspan data-lang-en>At BEGIN, tx 50 records who is still uncommitted ({'{48}'}). It ignores them, aborted txs, and anything with txid &gt; 50.</tspan>
      <tspan data-lang-vi>Lúc BEGIN, tx 50 ghi lại ai đang chạy dở ({'{48}'}). Nó bỏ qua nhóm đó, mọi tx đã abort, và mọi txid &gt; 50.</tspan>
    </text>

    {/* Snapshot context strip */}
    <rect x="20" y="64" width="274" height="44" rx="4" class="txm-strip" />
    <text x="34" y="91" class="txm-in-b">
      <tspan data-lang-en>Reader snapshot: tx 50</tspan>
      <tspan data-lang-vi>Snapshot người đọc: tx 50</tspan>
    </text>

    <rect x="313" y="64" width="274" height="44" rx="4" class="txm-strip" />
    <text x="327" y="91" class="txm-in">
      <tspan data-lang-en>Active at start: {'{48}'}</tspan>
      <tspan data-lang-vi>Đang chạy lúc đầu: {'{48}'}</tspan>
    </text>

    <rect x="606" y="64" width="274" height="44" rx="4" class="txm-strip" />
    <text x="620" y="91" class="txm-in">
      <tspan data-lang-en>Later cutoff: ignore tx &gt; 50</tspan>
      <tspan data-lang-vi>Mốc cắt sau: bỏ qua tx &gt; 50</tspan>
    </text>

    {/* Table column headings */}
    <text x="36" y="138" class="txm-colh">
      <tspan data-lang-en>Heap tuple</tspan>
      <tspan data-lang-vi>Bản ghi trong heap</tspan>
    </text>
    <text x="206" y="138" class="txm-colh">inserted_by</text>
    <text x="404" y="138" class="txm-colh">deleted_by</text>
    <text x="596" y="138" class="txm-colh">
      <tspan data-lang-en>Result for tx 50</tspan>
      <tspan data-lang-vi>Kết quả với tx 50</tspan>
    </text>
    <line x1="20" x2={W - 20} y1="149" y2="149" class="txm-rule" />

    {rows.map((r, i) => {
      const y = rowY(i);
      return (
        <g>
          <rect x="20" y={y} width="860" height="52" rx="4" class={`txm-row is-${r.state}`} />
          <text x="36" y={y + 31} class="txm-in-b">{r.val}</text>

          <text x="206" y={y + 23} class="txm-in">{r.insTx}</text>
          <text x="206" y={y + 41} class="txm-note">
            <tspan data-lang-en>{r.insNoteEn}</tspan>
            <tspan data-lang-vi>{r.insNoteVi}</tspan>
          </text>

          <text x="404" y={y + 23} class="txm-in">{r.delTx}</text>
          <text x="404" y={y + 41} class="txm-note">
            <tspan data-lang-en>{r.delNoteEn}</tspan>
            <tspan data-lang-vi>{r.delNoteVi}</tspan>
          </text>

          <text x="596" y={y + 31} class={r.state === 'hit' ? 'txm-verdict is-hit' : 'txm-verdict'}>
            <tspan data-lang-en>{r.statusEn}</tspan>
            <tspan data-lang-vi>{r.statusVi}</tspan>
          </text>
        </g>
      );
    })}

    <text x="20" y="434" class="txm-foot">
      <tspan data-lang-en>An UPDATE marks the old tuple with deleted_by and appends a new tuple; vacuum or GC cleans dead tuples once no snapshot needs them.</tspan>
      <tspan data-lang-vi>Một lệnh UPDATE gắn deleted_by lên bản cũ rồi thêm bản mới; vacuum hay GC dọn bản thừa khi không còn snapshot nào cần đọc nữa.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>How multiversion concurrency control (MVCC) serves consistent snapshots without read locks. Every transaction sees the state committed before it began, so long analytical queries and backups run alongside concurrent writes.</span>
    <span data-lang-vi>Cách multiversion concurrency control (MVCC) phục vụ snapshot nhất quán mà không cần lock đọc. Giao dịch nào cũng nhìn thấy đúng trạng thái đã commit trước khi nó bắt đầu, nên báo cáo hay sao lưu chạy dài không bị kẹt bởi lệnh ghi song song.</span>
  </figcaption>
</figure>

<style>
  .txm {
    margin: 2em 0;
    width: 100%;
  }
  .txm-scroll {
    overflow-x: auto;
  }
  .txm svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .txm text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .txm .txm-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .txm .txm-sub,
  .txm .txm-foot {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .txm .txm-colh {
    font-size: 13px;
    font-weight: 700;
    fill: var(--text-muted);
  }
  .txm-strip {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .txm-rule {
    stroke: var(--border);
  }
  .txm-row {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .txm-row.is-hit {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .txm-row.is-dead {
    stroke-dasharray: 5 4;
  }
  .txm .txm-in {
    font-weight: 600;
    fill: var(--text);
  }
  .txm .txm-in-b {
    font-weight: 700;
    fill: var(--text);
  }
  .txm .txm-note {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .txm .txm-verdict {
    font-size: 13.5px;
    font-weight: 600;
    fill: var(--text-muted);
  }
  .txm .txm-verdict.is-hit {
    font-weight: 700;
    fill: var(--red);
  }
  .txm figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
