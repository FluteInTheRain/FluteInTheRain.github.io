---
// Renting changes the question you ask, not the fact that someone has to operate things.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 290;
const still = [
  { icon: 'cloud', en: ['Pick services'], vi: ['Chọn dịch vụ'] },
  { icon: 'network', en: ['Wire them together'], vi: ['Nối chúng lại'] },
  { icon: 'eye', en: ['Watch the load'], vi: ['Theo dõi tải'] },
  { icon: 'bell', en: ['Chase outages'], vi: ['Lần theo sự cố'] },
];
---
<figure class="toos">
  <div class="toos-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Renting turns capacity planning, where you ask whether the disk will fill up, into financial planning, where you ask why the bill doubled. Either way, someone still picks services, wires them together, watches the load and chases outages.">
    <rect x="20" y="16" width="380" height="104" rx="10" class="toos-box" />
    <DiagramIcon name="disk" x={56} y={52} size={30} />
    <text x="90" y="48" class="toos-small"><tspan data-lang-en>Own machines: capacity planning</tspan><tspan data-lang-vi>Máy tự sở hữu: tính dung lượng</tspan></text>
    <text x="90" y="76" class="toos-q"><tspan data-lang-en>"Will the disk fill up?"</tspan><tspan data-lang-vi>"Đĩa có đầy không?"</tspan></text>
    <text x="40" y="104" class="toos-small"><tspan data-lang-en>You watch gigabytes.</tspan><tspan data-lang-vi>Bạn theo dõi số gigabyte.</tspan></text>

    <text x="450" y="74" text-anchor="middle" class="toos-arrow">&rarr;</text>
    <text x="450" y="96" text-anchor="middle" class="toos-small">FinOps</text>

    <rect x="500" y="16" width="380" height="104" rx="10" class="toos-box is-key" />
    <DiagramIcon name="money" x={536} y={52} size={30} />
    <text x="570" y="48" class="toos-small"><tspan data-lang-en>Rented: financial planning</tspan><tspan data-lang-vi>Đi thuê: tính tiền</tspan></text>
    <text x="570" y="76" class="toos-q"><tspan data-lang-en>"Why did the bill double?"</tspan><tspan data-lang-vi>"Sao hóa đơn tăng gấp đôi?"</tspan></text>
    <text x="520" y="104" class="toos-small"><tspan data-lang-en>You watch dollars.</tspan><tspan data-lang-vi>Bạn theo dõi số đô la.</tspan></text>

    <text x="20" y="162" class="toos-h"><tspan data-lang-en>Still on your team either way</tspan><tspan data-lang-vi>Dù thế nào cũng vẫn là việc của team</tspan></text>
    {still.map((s, i) => {
      const x = 20 + i * 220;
      return (
        <g>
          <rect x={x} y="180" width="200" height="80" rx="10" class="toos-box" />
          <DiagramIcon name={s.icon as any} x={x + 100} y={208} size={28} />
          <text x={x + 100} y="248" text-anchor="middle" class="toos-name"><tspan data-lang-en>{s.en[0]}</tspan><tspan data-lang-vi>{s.vi[0]}</tspan></text>
        </g>
      );
    })}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Renting removes the machines, not the work. The question changes from gigabytes to dollars.</span>
    <span data-lang-vi>Đi thuê bỏ được máy móc chứ không bỏ được công việc. Câu hỏi đổi từ gigabyte sang đô la.</span>
  </figcaption>
</figure>

<style>
  .toos { margin: 2em 0; width: 100%; }
  .toos-scroll { overflow-x: auto; }
  .toos svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .toos text { font-size: 13px; fill: var(--text-body); }
  .toos .toos-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .toos .toos-q { font-size: 17px; font-weight: 700; fill: var(--text); }
  .toos .toos-name { font-weight: 700; fill: var(--text); }
  .toos .toos-small { fill: var(--text-muted); }
  .toos .toos-arrow { font-size: 26px; fill: var(--text-muted); }
  .toos-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .toos-box.is-key { stroke: var(--text-muted); }
  .toos figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
