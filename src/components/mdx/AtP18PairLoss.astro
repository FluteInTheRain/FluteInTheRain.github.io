---
// Pairwise ranking loss on three stocks, toy numbers. Python check (calc.py):
//   r_hat = [0.5, 0.2, -0.1], r = [0.3, 0.6, -0.2]
//   pair (HPG, HSG): max(0, -(0.5-0.2)*(0.3-0.6)) = 0.09; the other two pairs are 0; squared error = 0.21
const W = 900;
const H = 330;
const pred = [['HPG', 0.5], ['HSG', 0.2], ['VCB', -0.1]] as [string, number][];
const act = [['HSG', 0.6], ['HPG', 0.3], ['VCB', -0.2]] as [string, number][];
const py = (name: string) => 100 + pred.findIndex((p) => p[0] === name) * 52;
const ay = (name: string) => 100 + act.findIndex((p) => p[0] === name) * 52;
const LX = 150;
const RX = 410;
---
<figure class="atp18-pair">
  <div class="atp18-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Predicted order HPG, HSG, VCB against actual order HSG, HPG, VCB. The lines for HPG and HSG cross, so that pair is penalised 0.09; the other two pairs keep their order and cost nothing.">
      <text x="20" y="24" class="h">
        <tspan data-lang-en>A ranking loss charges only for pairs in the wrong order</tspan>
        <tspan data-lang-vi>Hàm mất mát xếp hạng chỉ phạt các cặp sai thứ tự</tspan>
      </text>
      <rect x="20" y="42" width="560" height="248" rx="8" class="panel" />
      <text x={LX - 70} y="72" class="col">
        <tspan data-lang-en>model says (return)</tspan>
        <tspan data-lang-vi>mô hình nói (lợi suất)</tspan>
      </text>
      <text x={RX - 40} y="72" class="col">
        <tspan data-lang-en>what happened</tspan>
        <tspan data-lang-vi>thực tế</tspan>
      </text>
      {pred.map(([nm]) => {
        const cross = nm !== 'VCB';
        return <line x1={LX + 36} x2={RX - 14} y1={py(nm)} y2={ay(nm)} class={cross ? 'ln bad' : 'ln ok'} />;
      })}
      {pred.map(([nm, v], i) => (
        <g>
          <rect x={LX - 70} y={py(nm) - 16} width="106" height="32" rx="6" class="chip" />
          <text x={LX - 60} y={py(nm) + 5} class="lab">{nm}</text>
          <text x={LX + 30} y={py(nm) + 5} text-anchor="end" class="num">
            <tspan data-lang-en>{v.toFixed(1)}</tspan>
            <tspan data-lang-vi>{v.toFixed(1).replace('.', ',')}</tspan>
          </text>
        </g>
      ))}
      {act.map(([nm, v]) => (
        <g>
          <rect x={RX - 14} y={ay(nm) - 16} width="106" height="32" rx="6" class="chip" />
          <text x={RX - 4} y={ay(nm) + 5} class="lab">{nm}</text>
          <text x={RX + 86} y={ay(nm) + 5} text-anchor="end" class="num">
            <tspan data-lang-en>{v.toFixed(1)}</tspan>
            <tspan data-lang-vi>{v.toFixed(1).replace('.', ',')}</tspan>
          </text>
        </g>
      ))}
      <text x="36" y="276" class="sm">
        <tspan data-lang-en>Red lines cross: HPG and HSG are swapped. VCB is last in both lists.</tspan>
        <tspan data-lang-vi>Hai đường đỏ cắt nhau: HPG và HSG bị đổi chỗ. VCB đứng cuối ở cả hai danh sách.</tspan>
      </text>

      <rect x="604" y="42" width="276" height="248" rx="8" class="panel" />
      <text x="620" y="72" class="t">
        <tspan data-lang-en>Penalty per pair</tspan>
        <tspan data-lang-vi>Phạt từng cặp</tspan>
      </text>
      {[['HPG, HSG', '0.09'], ['HPG, VCB', '0'], ['HSG, VCB', '0']].map(([pair, pen], i) => (
        <g>
          <text x="620" y={108 + i * 30} class="lab">{pair}</text>
          <text x="860" y={108 + i * 30} text-anchor="end" class={i === 0 ? 'num bad' : 'num'}>
            <tspan data-lang-en>{pen}</tspan>
            <tspan data-lang-vi>{pen.replace('.', ',')}</tspan>
          </text>
        </g>
      ))}
      <line x1="620" x2="860" y1="196" y2="196" class="rule" />
      <text x="620" y="220" class="sm">
        <tspan data-lang-en>0.09 = max(0, −(0.5 − 0.2)(0.3 − 0.6))</tspan>
        <tspan data-lang-vi>0,09 = max(0, −(0,5 − 0,2)(0,3 − 0,6))</tspan>
      </text>
      <text x="620" y="244" class="sm muted">
        <tspan data-lang-en>Squared error alone: 0.21</tspan>
        <tspan data-lang-vi>Chỉ sai số bình phương: 0,21</tspan>
      </text>
      <text x="620" y="266" class="sm muted">
        <tspan data-lang-en>Paper counts (A,B) and (B,A): 0.18</tspan>
        <tspan data-lang-vi>Bài báo đếm cả (A,B) và (B,A): 0,18</tspan>
      </text>
      <text x="20" y="316" class="muted">
        <tspan data-lang-en>Toy returns (percent) for three tickers, made up for the example.</tspan>
        <tspan data-lang-vi>Lợi suất giả định (phần trăm) của ba mã, đặt ra cho ví dụ.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Squared error rewards getting each number close. The pairwise term rewards getting the order right, which is what you trade on when you buy the top of a list.</span>
    <span data-lang-vi>Sai số bình phương thưởng cho việc từng con số đến gần. Số hạng theo cặp thưởng cho việc xếp đúng thứ tự, thứ bạn thực sự giao dịch khi mua mã đầu danh sách.</span>
  </figcaption>
</figure>

<style>
  .atp18-pair { margin: 2em 0; width: 100%; }
  .atp18-scroll { overflow-x: auto; }
  .atp18-pair svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp18-pair .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .atp18-pair .t { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .atp18-pair .col { font-size: 12px; font-weight: 600; fill: var(--text-muted); }
  .atp18-pair .lab { font-size: 13px; font-weight: 700; fill: var(--text); }
  .atp18-pair .num { font-size: 13px; fill: var(--text-body); }
  .atp18-pair .num.bad { fill: var(--red); font-weight: 700; }
  .atp18-pair .sm { font-size: 12.5px; fill: var(--text-body); }
  .atp18-pair .sm.muted, .atp18-pair .muted { fill: var(--text-muted); font-size: 12px; }
  .atp18-pair .panel { fill: var(--bg-alt); stroke: var(--border); }
  .atp18-pair .chip { fill: var(--card-bg); stroke: var(--border); }
  .atp18-pair .ln { fill: none; stroke-width: 2.4; }
  .atp18-pair .ln.bad { stroke: var(--red); }
  .atp18-pair .ln.ok { stroke: var(--text-faint); }
  .atp18-pair .rule { stroke: var(--border); }
  .atp18-pair figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
