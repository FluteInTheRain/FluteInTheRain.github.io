---
// Correlation to distance: d = sqrt(2(1 - rho)). Values from Python: 1 -> 0, 0.8 -> 0.632, 0.5 -> 1.0, 0 -> 1.414, -1 -> 2.
const W = 900, H = 380;
const PX = 90, PY = 60, PW = 480, PH = 250;
const x = (r: number) => PX + ((r + 1) / 2) * PW;
const y = (d: number) => PY + PH - (d / 2) * PH;
let curve = '';
for (let i = 0; i <= 80; i++) { const r = -1 + (2 * i) / 80; curve += `${i ? 'L' : 'M'} ${x(r).toFixed(1)} ${y(Math.sqrt(2 * (1 - r))).toFixed(1)} `; }
const pts = [
  { r: 1, d: 0, en: 'ρ = 1.0 → 0', vi: 'ρ = 1,0 → 0', dx: -14, anchor: 'end', dy: -22 },
  { r: 0.8, d: 0.632, en: 'ρ = 0.8 → 0.63', vi: 'ρ = 0,8 → 0,63', dx: -12, anchor: 'end', dy: 22 },
  { r: 0.5, d: 1.0, en: 'ρ = 0.5 → 1.00', vi: 'ρ = 0,5 → 1,00', dx: 10, anchor: 'start', dy: -10 },
  { r: 0, d: 1.414, en: 'ρ = 0 → 1.41', vi: 'ρ = 0 → 1,41', dx: 10, anchor: 'start', dy: -10 },
  { r: -1, d: 2, en: 'ρ = −1 → 2', vi: 'ρ = −1 → 2', dx: 14, anchor: 'start', dy: 36 },
];
---
<figure class="atp11-di">
  <div class="atp11-di-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A curve of distance against correlation. Distance is the square root of two times one minus the correlation: perfectly correlated stocks are 0 apart, correlation 0.8 gives 0.63, 0.5 gives 1.0, uncorrelated stocks are 1.41 apart and perfectly opposite stocks are 2 apart.">
      <text x="20" y="26" class="h"><tspan data-lang-en>Turning "move together" into "close"</tspan><tspan data-lang-vi>Biến "đi cùng nhau" thành "ở gần nhau"</tspan></text>
      <line x1={PX} y1={PY + PH} x2={PX + PW} y2={PY + PH} class="ax" />
      <line x1={PX} y1={PY} x2={PX} y2={PY + PH} class="ax" />
      <text x={PX + PW / 2} y={PY + PH + 34} text-anchor="middle" class="sub"><tspan data-lang-en>correlation ρ between two stocks</tspan><tspan data-lang-vi>tương quan ρ giữa hai mã</tspan></text>
      <text x="26" y={PY + PH / 2} class="sub" transform={`rotate(-90 26 ${PY + PH / 2})`} text-anchor="middle"><tspan data-lang-en>distance d</tspan><tspan data-lang-vi>khoảng cách d</tspan></text>
      {[-1, 0, 1].map((r) => <text x={x(r)} y={PY + PH + 16} text-anchor="middle" class="tick">{r}</text>)}
      {[0, 1, 2].map((d) => <text x={PX - 8} y={y(d) + 4} text-anchor="end" class="tick">{d}</text>)}
      <path d={curve} class="curve" />
      {pts.map((p) => (
        <g>
          <circle cx={x(p.r)} cy={y(p.d)} r="5" class="pt" />
          <text x={x(p.r) + p.dx} y={y(p.d) + p.dy} text-anchor={p.anchor} class="pl"><tspan data-lang-en>{p.en}</tspan><tspan data-lang-vi>{p.vi}</tspan></text>
        </g>
      ))}
      <rect x="610" y="70" width="270" height="190" rx="8" class="box" />
      <text x="626" y="96" class="bh">d = √(2 × (1 − ρ))</text>
      <text x="626" y="124" class="bt"><tspan data-lang-en>Move together: d is small.</tspan><tspan data-lang-vi>Đi cùng nhau: d nhỏ.</tspan></text>
      <text x="626" y="148" class="bt"><tspan data-lang-en>Unrelated: d is about 1.4.</tspan><tspan data-lang-vi>Không liên quan: d khoảng 1,4.</tspan></text>
      <text x="626" y="172" class="bt"><tspan data-lang-en>Mirror images: d = 2.</tspan><tspan data-lang-vi>Đối xứng: d = 2.</tspan></text>
      <text x="626" y="206" class="bs"><tspan data-lang-en>Raw ρ is not a distance: it can be</tspan><tspan data-lang-vi>ρ thô chưa là khoảng cách: nó có</tspan></text>
      <text x="626" y="224" class="bs"><tspan data-lang-en>negative and breaks the triangle rule.</tspan><tspan data-lang-vi>thể âm và phá luật tam giác.</tspan></text>
      <text x="626" y="242" class="bs"><tspan data-lang-en>This d does not.</tspan><tspan data-lang-vi>Còn d này thì không.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The formula is Mantegna's correlation distance. Values come from a Python run of the formula.</span>
    <span data-lang-vi>Công thức này là khoảng cách tương quan của Mantegna. Các giá trị lấy từ một lần chạy Python.</span>
  </figcaption>
</figure>
<style>
  .atp11-di { margin: 2em 0; width: 100%; }
  .atp11-di-scroll { overflow-x: auto; }
  .atp11-di svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .atp11-di text { font-size: 14px; fill: var(--text-body); }
  .atp11-di .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp11-di .sub { font-size: 13px; fill: var(--text-muted); }
  .atp11-di .tick { font-size: 12.5px; fill: var(--text-muted); }
  .atp11-di .pl { font-size: 13px; font-weight: 600; fill: var(--text); }
  .atp11-di .bh { font-size: 17px; font-weight: 700; fill: var(--text); }
  .atp11-di .bt { font-size: 13.5px; fill: var(--text); }
  .atp11-di .bs { font-size: 12.5px; fill: var(--text-muted); }
  .atp11-di .ax { stroke: var(--border); stroke-width: 1.4; }
  .atp11-di .curve { fill: none; stroke: var(--gold-icon); stroke-width: 2.6; }
  .atp11-di .pt { fill: var(--bg); stroke: var(--text); stroke-width: 1.8; }
  .atp11-di .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .atp11-di figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
