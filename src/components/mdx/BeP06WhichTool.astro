---
// A decision tree: what is this function waiting on? Gold = the fitting
// choice; red = the trap that AI-written code most often falls into.
const W = 900, H = 420;
const cols = [
  {
    x: 20,
    q: [{ en: 'waiting on the network or disk', vi: 'đang chờ network hoặc đĩa' }, { en: 'through an async library', vi: 'qua một thư viện async' }],
    code: 'async def + await',
    a: [{ en: 'the loop serves others meanwhile', vi: 'loop phục vụ request khác trong lúc chờ' }],
    red: false,
  },
  {
    x: 310,
    q: [{ en: 'waiting on the network or disk', vi: 'đang chờ network hoặc đĩa' }, { en: 'through a sync library', vi: 'qua một thư viện sync' }],
    code: 'def  (not async def)',
    a: [{ en: 'FastAPI runs it in a thread', vi: 'FastAPI chạy nó trong một thread' }, { en: 'or swap in an async library', vi: 'hoặc đổi sang thư viện async' }],
    red: false,
  },
  {
    x: 600,
    q: [{ en: 'computing on the CPU', vi: 'đang tính toán trên CPU' }, { en: 'for more than a blink', vi: 'lâu hơn một cái chớp mắt' }],
    code: 'another process',
    a: [{ en: 'process pool, or a separate worker', vi: 'process pool, hoặc một worker riêng' }, { en: 'a thread cannot beat the GIL', vi: 'thread không thắng được GIL' }],
    red: false,
  },
];
---
<figure class="bep6f">
  <div class="bep6f-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Decision tree starting from: what is this function waiting on. Network or disk through an async library leads to async def with await. Network or disk through a sync library leads to a plain def. CPU work leads to another process. A red note: a sync call inside async def stalls everything.">
    <rect x="300" y="12" width="300" height="48" rx="10" class="box" />
    <text x="450" y="42" text-anchor="middle" class="h"><tspan data-lang-en>what does this function wait on?</tspan><tspan data-lang-vi>hàm này đang chờ cái gì?</tspan></text>

    {cols.map((c) => {
      const cx = c.x + 140;
      return (
        <g>
          <polyline points={`450,60 450,84 ${cx},84 ${cx},112`} class="ln" />
          <polygon points={`${cx},124 ${cx - 5},112 ${cx + 5},112`} class="hd" />
          <rect x={c.x} y="124" width="280" height="76" rx="10" class="box" />
          {c.q.map((l, j) => <text x={cx} y={152 + j * 22} text-anchor="middle" class="b"><tspan data-lang-en>{l.en}</tspan><tspan data-lang-vi>{l.vi}</tspan></text>)}
          <line x1={cx} y1="200" x2={cx} y2="224" class="ln" />
          <polygon points={`${cx},236 ${cx - 5},224 ${cx + 5},224`} class="hd" />
          <rect x={c.x} y="236" width="280" height="42" rx="10" class="ans" />
          <text x={cx} y="263" text-anchor="middle" class="code">{c.code}</text>
          {c.a.map((l, j) => <text x={cx} y={302 + j * 20} text-anchor="middle" class="s"><tspan data-lang-en>{l.en}</tspan><tspan data-lang-vi>{l.vi}</tspan></text>)}
        </g>
      );
    })}

    <rect x="20" y="348" width="860" height="56" rx="10" class="trap" />
    <text x="450" y="372" text-anchor="middle" class="tr"><tspan data-lang-en>the trap: a sync call (requests, a sync driver, time.sleep) inside async def</tspan><tspan data-lang-vi>cái bẫy: một lời gọi sync (requests, driver sync, time.sleep) bên trong async def</tspan></text>
    <text x="450" y="392" text-anchor="middle" class="s"><tspan data-lang-en>it looks like column 1 and behaves like a stuck loop</tspan><tspan data-lang-vi>nhìn giống cột 1 nhưng chạy như một cái loop bị kẹt</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Ask what the function waits on before you pick between def and async def.</span>
    <span data-lang-vi>Hỏi hàm đó đang chờ cái gì trước khi chọn giữa def và async def.</span>
  </figcaption>
</figure>

<style>
  .bep6f { margin: 2em 0; width: 100%; }
  .bep6f-scroll { overflow-x: auto; }
  .bep6f svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .bep6f text { font-size: 13.5px; fill: var(--text-body); }
  .bep6f .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep6f .b { fill: var(--text); font-size: 14px; }
  .bep6f .s { fill: var(--text-muted); font-size: 12.5px; }
  .bep6f .code { font-family: 'JetBrains Mono', ui-monospace, monospace; font-weight: 700; fill: var(--text); font-size: 14.5px; }
  .bep6f .tr { fill: var(--red); font-weight: 700; font-size: 14px; }
  .bep6f .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep6f .ans { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.4; }
  .bep6f .trap { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; stroke-dasharray: 6 4; }
  .bep6f .ln { stroke: var(--text-muted); stroke-width: 1.6; fill: none; }
  .bep6f .hd { fill: var(--text-muted); }
  .bep6f figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
