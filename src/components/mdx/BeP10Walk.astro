---
// The three signals, in the order the walk-through used them. Every number is
// from a capture in the post: the walk run (35 of 40 under 0.1 s, 5 over 1 s,
// average 200 ms, request 94520390 at 1205.2 / 1202.9 ms) and the trace run
// (evidence-lab span 1218.59 of 1227.08 ms, SQL spans 0.08 and 0.07 ms).
const W = 900, H = 330;
const steps = [
  { y: 70, icon: 'profiler', sig: { en: 'metrics', vi: 'metrics' },
    q: { en: 'is it slow, and how often?', vi: 'chậm không, và bao nhiêu lần?' },
    a: { en: '5 of 40 reports took over 1 s; the average said 200 ms', vi: '5 trong 40 report mất hơn 1 s; trung bình báo 200 ms' } },
  { y: 150, icon: 'log', sig: { en: 'logs', vi: 'log' },
    q: { en: 'which request, which service?', vi: 'request nào, service nào?' },
    a: { en: 'id 94520390: clue-api 1205.2 ms, evidence-lab 1202.9 ms', vi: 'id 94520390: clue-api 1205.2 ms, evidence-lab 1202.9 ms' } },
  { y: 230, icon: 'satellite', sig: { en: 'traces', vi: 'trace' }, red: true,
    q: { en: 'where inside it?', vi: 'nằm ở đâu bên trong?' },
    a: { en: 'evidence-lab span 1218.59 of 1227.08 ms; the SQL spans 0.08 and 0.07 ms', vi: 'span evidence-lab 1218.59 trên 1227.08 ms; các span SQL 0.08 và 0.07 ms' } },
];
---
<figure class="bep10e">
  <div class="bep10e-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three steps narrowing a slow request. Metrics show 5 of 40 requests took over one second. Logs find the request id and show the time sits in evidence-lab. Traces show the evidence-lab span takes 1218.59 of 1227.08 milliseconds, and the database spans are under a tenth of a millisecond. The trace step is drawn in red.">
    {steps.map((s, i) => (
      <g>
        <image href={`/icons/flow/${s.icon}.svg`} x="40" y={s.y - 24} width="34" height="34" aria-hidden="true" />
        <text x="90" y={s.y - 2} class={s.red ? 'sig red' : 'sig'}><tspan data-lang-en>{s.sig.en}</tspan><tspan data-lang-vi>{s.sig.vi}</tspan></text>
        <text x="200" y={s.y - 4} class="q"><tspan data-lang-en>{s.q.en}</tspan><tspan data-lang-vi>{s.q.vi}</tspan></text>
        <text x="200" y={s.y + 22} class={s.red ? 'a red' : 'a'}><tspan data-lang-en>{s.a.en}</tspan><tspan data-lang-vi>{s.a.vi}</tspan></text>
        {i < steps.length - 1 && <polygon points={`57,${s.y + 30} 69,${s.y + 30} 63,${s.y + 42}`} class="arrow" />}
      </g>
    ))}
    <text x="40" y="306" class="note"><tspan data-lang-en>each step uses the previous step's answer as its filter</tspan><tspan data-lang-vi>mỗi bước lấy câu trả lời của bước trước làm bộ lọc</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Metrics tell you it happened, logs tell you which request, a trace tells you where the time went. The numbers come from the three captures in this post.</span>
    <span data-lang-vi>Metrics cho biết có chuyện, log cho biết request nào, trace cho biết thời gian đi đâu. Các con số lấy từ ba capture trong bài.</span>
  </figcaption>
</figure>

<style>
  .bep10e { margin: 2em 0; width: 100%; }
  .bep10e-scroll { overflow-x: auto; }
  .bep10e svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep10e text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep10e .sig { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep10e .sig.red, .bep10e .a.red { fill: var(--red); }
  .bep10e .a.red { font-weight: 700; }
  .bep10e .q { fill: var(--text-muted); }
  .bep10e .note { fill: var(--text-muted); font-size: 13px; }
  .bep10e .arrow { fill: var(--text-faint); }
  .bep10e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
