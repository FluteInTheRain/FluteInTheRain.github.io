---
// Two pictures of the same kind of event:
//  1. a fault that is contained (one server dies, the others absorb its traffic);
//  2. a fault that spreads (the same bug hits replica after replica: cascading failure).
// Plain inline SVG styled with site tokens; no <marker>/<defs>, so hidden EN/VI copies cannot break it.

type Server = { name: string; load: number; down?: boolean };

const W = 900;
const H = 390;

// Arrow drawn as a line plus a small filled triangle (no SVG markers needed).
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

// Row 1: contained fault
const lb = { x: 170, y: 82, w: 140, h: 46 };
const rowServers: (Server & { y: number })[] = [
  { name: 'Server A', load: 0, down: true, y: 44 },
  { name: 'Server B', load: 75, y: 90 },
  { name: 'Server C', load: 75, y: 136 },
];
const srvX = 380;
const srvW = 210;
const srvH = 36;

// Row 2: cascading failure, three moments in time
const frames: { titleEn: string; titleVi: string; servers: Server[] }[] = [
  {
    titleEn: 't1 · runaway query kills A',
    titleVi: 't1 · truy vấn nặng làm A chết',
    servers: [
      { name: 'A', load: 0, down: true },
      { name: 'B', load: 85 },
      { name: 'C', load: 85 },
    ],
  },
  {
    titleEn: 't2 · same query hits B',
    titleVi: 't2 · cùng truy vấn đánh vào B',
    servers: [
      { name: 'A', load: 0, down: true },
      { name: 'B', load: 0, down: true },
      { name: 'C', load: 100 },
    ],
  },
  {
    titleEn: 't3 · C cannot carry it all',
    titleVi: 't3 · C không gánh nổi',
    servers: [
      { name: 'A', load: 0, down: true },
      { name: 'B', load: 0, down: true },
      { name: 'C', load: 0, down: true },
    ],
  },
];
const frameX = [20, 320, 620];
const frameW = 260;
const frameTop = 252;
const rowGap = 34;
const barW = 110;
---
<figure class="ffviz">
  <div class="ffviz-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: one server fails and the other two absorb its traffic, users are still served. Bottom: the same bug crashes replicas A, B and C one after another until no server is left.">
    {/* ---------- Row 1: contained fault ---------- */}
    <text x="20" y="22" class="ffviz-h">
      <tspan data-lang-en>1. A fault that stays small</tspan>
      <tspan data-lang-vi>1. Một fault được giữ nhỏ</tspan>
    </text>

    <g class="ffviz-box">
      <rect x="20" y={lb.y} width="110" height={lb.h} rx="8" />
      <text x="75" y={lb.y + 28} text-anchor="middle">
        <tspan data-lang-en>Users</tspan>
        <tspan data-lang-vi>Người dùng</tspan>
      </text>
    </g>
    {(() => { const a = arrow(130, lb.y + 23, lb.x, lb.y + 23); return <g class="ffviz-arrow"><path d={a.line} /><polygon points={a.head} /></g>; })()}

    <g class="ffviz-box">
      <rect x={lb.x} y={lb.y} width={lb.w} height={lb.h} rx="8" />
      <text x={lb.x + lb.w / 2} y={lb.y + 28} text-anchor="middle">Load balancer</text>
    </g>

    {rowServers.map((s) => {
      const a = arrow(lb.x + lb.w, lb.y + 23, srvX, s.y + srvH / 2);
      return (
        <g>
          <g class={s.down ? 'ffviz-arrow is-cut' : 'ffviz-arrow'}><path d={a.line} />{!s.down && <polygon points={a.head} />}</g>
          <g class={s.down ? 'ffviz-srv is-down' : 'ffviz-srv'}>
            <rect x={srvX} y={s.y} width={srvW} height={srvH} rx="6" />
            <text x={srvX + 12} y={s.y + 23} class="ffviz-name">{s.name}</text>
            {s.down ? (
              <text x={srvX + srvW - 12} y={s.y + 23} text-anchor="end" class="ffviz-down">
                <tspan data-lang-en>✕ disk died</tspan>
                <tspan data-lang-vi>✕ hỏng ổ đĩa</tspan>
              </text>
            ) : (
              <g>
                <rect x={srvX + 96} y={s.y + 13} width={60} height="10" rx="2" class="ffviz-track" />
                <rect x={srvX + 96} y={s.y + 13} width={(60 * s.load) / 100} height="10" rx="2" class="ffviz-bar" />
                <text x={srvX + srvW - 10} y={s.y + 23} text-anchor="end" class="ffviz-pct">{s.load}%</text>
              </g>
            )}
          </g>
        </g>
      );
    })}

    <text x="620" y="98" class="ffviz-ok">
      <tspan data-lang-en>✓ Users are still served</tspan>
      <tspan data-lang-vi>✓ Người dùng vẫn được phục vụ</tspan>
    </text>
    <text x="620" y="122" class="ffviz-sub">
      <tspan data-lang-en>B and C take over A's traffic.</tspan>
      <tspan data-lang-vi>B và C gánh luôn phần của A.</tspan>
    </text>
    <text x="620" y="142" class="ffviz-sub">
      <tspan data-lang-en>Fault, but no failure.</tspan>
      <tspan data-lang-vi>Có fault, nhưng không có failure.</tspan>
    </text>

    {/* ---------- Row 2: cascading failure ---------- */}
    <line x1="20" x2={W - 20} y1="196" y2="196" class="ffviz-rule" />
    <text x="20" y="226" class="ffviz-h">
      <tspan data-lang-en>2. A fault that spreads: cascading failure</tspan>
      <tspan data-lang-vi>2. Một fault lan ra: cascading failure (sập dây chuyền)</tspan>
    </text>

    {frames.map((f, fi) => (
      <g>
        <text x={frameX[fi]} y={frameTop} class="ffviz-ft">
          <tspan data-lang-en>{f.titleEn}</tspan>
          <tspan data-lang-vi>{f.titleVi}</tspan>
        </text>
        {f.servers.map((s, si) => {
          const y = frameTop + 14 + si * rowGap;
          return (
            <g class={s.down ? 'ffviz-srv is-down' : 'ffviz-srv'}>
              <rect x={frameX[fi]} y={y} width={frameW - 40} height="26" rx="5" />
              <text x={frameX[fi] + 10} y={y + 18} class="ffviz-name">{s.name}</text>
              {s.down ? (
                <text x={frameX[fi] + frameW - 52} y={y + 18} text-anchor="end" class="ffviz-down">
                  <tspan data-lang-en>✕ down</tspan>
                  <tspan data-lang-vi>✕ chết</tspan>
                </text>
              ) : (
                <g>
                  <rect x={frameX[fi] + 34} y={y + 8} width={barW} height="10" rx="2" class="ffviz-track" />
                  <rect x={frameX[fi] + 34} y={y + 8} width={(barW * s.load) / 100} height="10" rx="2" class={s.load >= 100 ? 'ffviz-bar is-hot' : 'ffviz-bar'} />
                  <text x={frameX[fi] + frameW - 52} y={y + 18} text-anchor="end" class={s.load >= 100 ? 'ffviz-pct is-hot' : 'ffviz-pct'}>{s.load}%</text>
                </g>
              )}
            </g>
          );
        })}
        {fi < frames.length - 1 && (() => {
          const a = arrow(frameX[fi] + frameW - 32, frameTop + 48, frameX[fi + 1] - 12, frameTop + 48);
          return <g class="ffviz-arrow is-red"><path d={a.line} /><polygon points={a.head} /></g>;
        })()}
      </g>
    ))}

    <text x={W - 20} y={H - 12} text-anchor="end" class="ffviz-bad">
      <tspan data-lang-en>No server left: users get errors. Failure.</tspan>
      <tspan data-lang-vi>Không còn server nào: người dùng nhận lỗi. Failure.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The difference is not whether something breaks, but whether the break stays local. A dead disk is independent of its neighbours, so spare capacity absorbs it. A bug is the same on every replica, so moving traffic just moves the problem.</span>
    <span data-lang-vi>Khác biệt không nằm ở chuyện có thứ gì hỏng hay không, mà ở chỗ cái hỏng có bị giữ lại một chỗ hay không. Một ổ đĩa chết không kéo ổ bên cạnh theo, nên phần dư công suất gánh được. Một bug thì giống hệt nhau trên mọi replica, nên chuyển traffic đi chỉ là chuyển vấn đề đi.</span>
  </figcaption>
</figure>

<style>
  .ffviz {
    margin: 2em 0;
    width: 100%;
  }
  .ffviz-scroll {
    overflow-x: auto;
  }
  .ffviz svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .ffviz text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .ffviz .ffviz-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .ffviz .ffviz-ft {
    font-size: 14px;
    font-weight: 600;
    fill: var(--text-muted);
  }
  .ffviz-box rect,
  .ffviz-srv rect:first-child {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .ffviz-box text {
    fill: var(--text);
    font-weight: 600;
  }
  .ffviz .ffviz-name {
    font-weight: 700;
    fill: var(--text);
  }
  .ffviz-srv.is-down rect:first-child {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-dasharray: 4 3;
  }
  .ffviz .ffviz-down {
    fill: var(--red);
    font-weight: 700;
  }
  .ffviz-track {
    fill: var(--border);
  }
  .ffviz-bar {
    fill: var(--text-muted);
  }
  .ffviz-bar.is-hot {
    fill: var(--red);
  }
  .ffviz .ffviz-pct {
    font-variant-numeric: tabular-nums;
    font-size: 13px;
    fill: var(--text-muted);
  }
  .ffviz .ffviz-pct.is-hot {
    fill: var(--red);
    font-weight: 700;
  }
  .ffviz-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .ffviz-arrow polygon {
    fill: var(--text-muted);
  }
  .ffviz-arrow.is-cut path {
    stroke-dasharray: 3 4;
    opacity: 0.5;
  }
  .ffviz-arrow.is-red path {
    stroke: var(--red);
  }
  .ffviz-arrow.is-red polygon {
    fill: var(--red);
  }
  .ffviz .ffviz-ok {
    font-size: 16px;
    font-weight: 700;
    fill: #15803d;
  }
  :global(html[data-theme='dark']) .ffviz .ffviz-ok {
    fill: #4ade80;
  }
  .ffviz .ffviz-sub {
    fill: var(--text-muted);
  }
  .ffviz .ffviz-bad {
    font-size: 15px;
    font-weight: 700;
    fill: var(--red);
  }
  .ffviz-rule {
    stroke: var(--border);
  }
  .ffviz figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
