---
// Where each of the 22 posts of the series sits in the seven-layer system. Post numbers follow the series order.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const layers = [
  { icon: 'db', en: 'Data', vi: 'Dữ liệu', chips: [['1 The Market', '1 Thị trường'], ['3 Data', '3 Dữ liệu'], ['16 Order Flow', '16 Dòng lệnh']] },
  { icon: 'model', en: 'Signals and models', vi: 'Tín hiệu và mô hình', chips: [['2 Signals', '2 Tín hiệu'], ['4 Statistics', '4 Thống kê'], ['5 Regime', '5 Chu kỳ'], ['6 Factors', '6 Factor'], ['8 Prediction', '8 Dự đoán'], ['9 Explainable AI', '9 AI giải thích'], ['11 Graphs', '11 Đồ thị'], ['14 Deep Learning', '14 Học sâu'], ['15 Sequence', '15 Chuỗi'], ['18 GNN', '18 GNN'], ['20 Alpha', '20 Alpha']] },
  { icon: 'search', en: 'Research agents', vi: 'Agent nghiên cứu', chips: [['17 Financial NLP', '17 NLP tài chính'], ['21 Agents', '21 Agent']] },
  { icon: 'scale', en: 'Portfolio', vi: 'Danh mục', chips: [['7 Portfolio', '7 Danh mục'], ['10 Clustering', '10 Phân cụm'], ['19 Reinforcement Learning', '19 Học tăng cường']] },
  { icon: 'shield', en: 'Risk gate and testing', vi: 'Cổng rủi ro và kiểm thử', chips: [['12 Backtest', '12 Backtest']] },
  { icon: 'server', en: 'Execution and monitoring', vi: 'Thực thi và giám sát', chips: [['13 Production', '13 Triển khai']] },
];
// lay chips out left to right, wrapping at the row's right edge
const x0 = 250, xmax = 880, ch = 28, gap = 8;
const w = (c: string[]) => Math.round(Math.max(c[0].length, c[1].length) * 7 + 22);
let y = 56;
const rows = layers.map((l) => {
  let x = x0, line = 0;
  const placed = l.chips.map((c) => {
    const cw = w(c);
    if (x + cw > xmax) { x = x0; line++; }
    const p = { c, x, y: line * (ch + 8), cw };
    x += cw + gap;
    return p;
  });
  const h = (line + 1) * (ch + 8) + 10;
  const row = { l, placed, y, h };
  y += h + 6;
  return row;
});
const H = y + 56;
---
<figure class="p22m">
  <div class="p22m-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The 22 posts of the series placed on the seven layers of an investment system: data, signals and models, research agents, portfolio, risk gate and testing, execution and monitoring. Post 22, Investment OS, spans all layers.">
      <text x="20" y="28" class="h"><tspan data-lang-en>The 21 earlier posts, placed on the layers</tspan><tspan data-lang-vi>21 bài trước, xếp lên các lớp</tspan></text>
      {rows.map((r) => (
        <g>
          <rect x="20" y={r.y} width="860" height={r.h} rx="6" class={r.l.icon === 'shield' ? 'band gate' : 'band'} />
          <DiagramIcon name={r.l.icon} x={44} y={r.y + r.h / 2} size={24} />
          <text x="72" y={r.y + r.h / 2 + 5} class="t"><tspan data-lang-en>{r.l.en}</tspan><tspan data-lang-vi>{r.l.vi}</tspan></text>
          {r.placed.map((p) => (
            <g>
              <rect x={p.x} y={r.y + 6 + p.y} width={p.cw} height={ch} rx="14" class="chip" />
              <text x={p.x + p.cw / 2} y={r.y + 6 + p.y + 18.5} text-anchor="middle" class="c"><tspan data-lang-en>{p.c[0]}</tspan><tspan data-lang-vi>{p.c[1]}</tspan></text>
            </g>
          ))}
        </g>
      ))}
      <rect x="20" y={y + 2} width="860" height="34" rx="6" class="all" />
      <text x="450" y={y + 24} text-anchor="middle" class="t"><tspan data-lang-en>22 Investment OS: all layers, plus who is allowed to say no</tspan><tspan data-lang-vi>22 Hệ thống đầu tư: mọi lớp, cộng với ai được quyền nói không</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A rough placement: most posts touch more than one layer.</span>
    <span data-lang-vi>Xếp tương đối: phần lớn bài đụng tới nhiều hơn một lớp.</span>
  </figcaption>
</figure>

<style>
  .p22m { margin: 2em 0; width: 100%; }
  .p22m-scroll { overflow-x: auto; }
  .p22m svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .c { font-size: 12.5px; fill: var(--text-body); }
  .band { fill: var(--card-bg); stroke: var(--border); stroke-width: 1.5; }
  .band.gate { fill: var(--gold-tint-bg); stroke: var(--gold-icon); }
  .chip { fill: var(--bg-alt); stroke: var(--border); }
  .all { fill: var(--bg-alt); stroke: var(--text-faint); stroke-dasharray: 5 4; }
  .p22m figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
