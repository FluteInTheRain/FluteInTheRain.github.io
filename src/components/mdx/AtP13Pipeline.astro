---
import DiagramIcon from './DiagramIcon.astro';
// The path from a notebook to a live strategy: every box is a place where a number can go wrong.
const W = 900;
const H = 352;
const top = [
  { icon: 'db', en: ['Data'], vi: ['Dữ liệu'], se: 'fresh? complete?', sv: 'mới? đủ?' },
  { icon: 'index', en: ['Features'], vi: ['Feature'], se: 'same as training', sv: 'giống lúc train' },
  { icon: 'model', en: ['Model'], vi: ['Mô hình'], se: 'versioned', sv: 'có phiên bản' },
  { icon: 'scale', en: ['Target', 'weights'], vi: ['Tỉ trọng', 'mục tiêu'], se: 'what to hold', sv: 'muốn giữ gì' },
  { icon: 'receipt', en: ['Orders'], vi: ['Lệnh'], se: 'target - holdings', sv: 'mục tiêu - đang giữ' },
  { icon: 'shield', en: ['Pre-trade', 'checks'], vi: ['Kiểm tra', 'trước lệnh'], se: 'size, price, limits', sv: 'cỡ, giá, hạn mức' },
  { icon: 'bank', en: ['Broker,', 'exchange'], vi: ['Broker,', 'sàn'], se: 'fills come back', sv: 'khớp quay về' },
];
const bot = [
  { icon: 'file', en: 'Fills and positions', vi: 'Khớp và vị thế', se: 'what we actually hold', sv: 'thực tế đang giữ' },
  { icon: 'scale', en: 'Holdings vs target', vi: 'Đang giữ so với mục tiêu', se: 'reconcile every day', sv: 'đối chiếu hằng ngày' },
  { icon: 'eye', en: 'Monitoring', vi: 'Giám sát', se: 'alerts a person reads', sv: 'cảnh báo có người đọc' },
  { icon: 'stop', en: 'Kill switch', vi: 'Công tắc dừng', se: 'stops orders, cancels open ones', sv: 'dừng lệnh, huỷ lệnh đang chờ' },
];
const bw = 118, gap = 8, x0 = 13;
const bw2 = 190, gap2 = 26;
const tx = (i: number) => x0 + i * (bw + gap);
const bx = (i: number) => 870 - bw2 - i * (bw2 + gap2);
---
<figure class="atp13-pl">
  <div class="atp13-pl-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Pipeline of a live strategy. Top row, left to right: data, features, model, target weights, orders, pre-trade checks, broker and exchange. Bottom row, right to left: fills and positions, holdings compared with target, monitoring, kill switch.">
      <text x="13" y="26" class="h">
        <tspan data-lang-en>Each box is a place where a live strategy can fail</tspan>
        <tspan data-lang-vi>Mỗi ô là một chỗ chiến lược chạy thật có thể hỏng</tspan>
      </text>
      {top.map((b, i) => (
        <g>
          <rect x={tx(i)} y="46" width={bw} height="116" rx="10" class={i === 5 ? 'box good' : 'box'} />
          <DiagramIcon name={b.icon} x={tx(i) + bw / 2} y={72} size={24} />
          <text x={tx(i) + bw / 2} y="108" text-anchor="middle" class="lab">
            <tspan data-lang-en>{b.en[0]}</tspan>
            <tspan data-lang-vi>{b.vi[0]}</tspan>
          </text>
          <text x={tx(i) + bw / 2} y="124" text-anchor="middle" class="lab">
            <tspan data-lang-en>{b.en[1] ?? ''}</tspan>
            <tspan data-lang-vi>{b.vi[1] ?? ''}</tspan>
          </text>
          <text x={tx(i) + bw / 2} y="148" text-anchor="middle" class="sub">
            <tspan data-lang-en>{b.se}</tspan>
            <tspan data-lang-vi>{b.sv}</tspan>
          </text>
          {i < 6 && <line x1={tx(i) + bw} x2={tx(i + 1) - 4} y1="104" y2="104" class="arrow fm-flow" />}
          {i < 6 && <polygon points={`${tx(i + 1)},104 ${tx(i + 1) - 6},100 ${tx(i + 1) - 6},108`} class="head" />}
        </g>
      ))}
      <path d={`M ${tx(6) + bw / 2} 162 V 184 H ${bx(0) + bw2 / 2} V 200`} class="arrow" fill="none" />
      <polygon points={`${bx(0) + bw2 / 2},206 ${bx(0) + bw2 / 2 - 4},199 ${bx(0) + bw2 / 2 + 4},199`} class="head" />
      {bot.map((b, i) => (
        <g>
          <rect x={bx(i)} y="206" width={bw2} height="100" rx="10" class={i === 3 ? 'box good' : 'box'} />
          <DiagramIcon name={b.icon} x={bx(i) + bw2 / 2} y={230} size={24} />
          <text x={bx(i) + bw2 / 2} y="268" text-anchor="middle" class="lab">
            <tspan data-lang-en>{b.en}</tspan>
            <tspan data-lang-vi>{b.vi}</tspan>
          </text>
          <text x={bx(i) + bw2 / 2} y="288" text-anchor="middle" class="sub">
            <tspan data-lang-en>{b.se}</tspan>
            <tspan data-lang-vi>{b.sv}</tspan>
          </text>
          {i < 3 && <line x1={bx(i)} x2={bx(i + 1) + bw2 + 4} y1="256" y2="256" class="arrow" />}
          {i < 3 && <polygon points={`${bx(i + 1) + bw2},256 ${bx(i + 1) + bw2 + 6},252 ${bx(i + 1) + bw2 + 6},260`} class="head" />}
        </g>
      ))}
      <text x="13" y="338" class="note">
        <tspan data-lang-en>A notebook covers the first three boxes. The rest is what makes it a system.</tspan>
        <tspan data-lang-vi>Notebook chỉ lo ba ô đầu. Phần còn lại mới biến nó thành một hệ thống.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The pre-trade checks and the kill switch (gold) are the two boxes Knight Capital did not have in a working form.</span>
    <span data-lang-vi>Kiểm tra trước khi gửi và công tắc dừng (màu vàng) là hai ô mà Knight Capital không có ở dạng chạy được.</span>
  </figcaption>
</figure>

<style>
  .atp13-pl { margin: 2em 0; width: 100%; }
  .atp13-pl-scroll { overflow-x: auto; }
  .atp13-pl svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp13-pl .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .atp13-pl .lab { font-size: 12.5px; font-weight: 700; fill: var(--text); }
  .atp13-pl .sub { font-size: 11.5px; fill: var(--text-muted); }
  .atp13-pl .note { font-size: 13px; fill: var(--text-body); }
  .atp13-pl .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .atp13-pl .box.good { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .atp13-pl .head { fill: var(--text-muted); }
  .atp13-pl .arrow { stroke: var(--text-muted); stroke-width: 1.5; }
  .atp13-pl figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
