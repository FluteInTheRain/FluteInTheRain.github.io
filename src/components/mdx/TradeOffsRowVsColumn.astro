---
// Row store vs column store, as a 2x2 showdown: the same four orders laid out
// both ways, and what each layout has to read for two queries:
//   1. Bob opens his order (one whole row)       -> row store wins
//   2. SUM(amount) over all orders (one column)  -> column store wins
// Plain inline SVG with site tokens; no ids, so the hidden EN/VI copy cannot break it.

type Cell = 'need' | 'waste' | 'skip';

const W = 900;
const H = 612;

const fields = ['id', 'name', 'city', 'card', 'amount'];
const rows = [
  ['1', 'Alice', 'Lyon', '•••• 4242', '$35'],
  ['2', 'Bob', 'Oslo', '•••• 1881', '$12'],
  ['3', 'Carol', 'Rome', '•••• 5100', '$50'],
  ['4', 'Dan', 'Kyiv', '•••• 7337', '$15'],
];

// Row store: one strip per order, cells in field order.
const rowCellW = [44, 78, 72, 110, 70];
const rowGap = 6;
const stripH = 28;
const leftX = 20;

// Column store: one strip per column, cells in order id order.
const rightX = 470;
const colLabelW = 72;
const colCellW = 82;

const panelH = 5 * (stripH + rowGap);

type Query = {
  headEn: string;
  headVi: string;
  rowCell: (r: number, f: number) => Cell;
  colCell: (f: number, r: number) => Cell;
  rowVerdict: { en: string; vi: string; bad: boolean };
  colVerdict: { en: string; vi: string; bad: boolean };
};

const queries: Query[] = [
  {
    headEn: 'Query 1 · Bob opens his order: SELECT * FROM orders WHERE id = 2',
    headVi: 'Truy vấn 1 · Bob mở xem đơn của mình: SELECT * FROM orders WHERE id = 2',
    rowCell: (r) => (r === 1 ? 'need' : 'skip'),
    colCell: (_f, r) => (r === 1 ? 'need' : 'skip'),
    rowVerdict: { en: '1 read: everything about Bob sits together', vi: '1 lần đọc: mọi thứ của Bob nằm liền nhau', bad: false },
    colVerdict: { en: '5 reads: one from each column file', vi: '5 lần đọc: mỗi file cột một lần', bad: false },
  },
  {
    headEn: 'Query 2 · Finance report: SELECT SUM(amount) FROM orders',
    headVi: 'Truy vấn 2 · Báo cáo tài chính: SELECT SUM(amount) FROM orders',
    rowCell: (_r, f) => (f === 4 ? 'need' : 'waste'),
    colCell: (f) => (f === 4 ? 'need' : 'skip'),
    rowVerdict: { en: 'Reads every field of every order to use one', vi: 'Đọc hết mọi trường của mọi đơn chỉ để dùng một', bad: true },
    colVerdict: { en: 'Reads only the amount file, skips the rest', vi: 'Chỉ đọc file amount, bỏ qua các cột khác', bad: false },
  },
];

const qTop = [92, 340];

function rowCellX(f: number) {
  let x = leftX;
  for (let i = 0; i < f; i++) x += rowCellW[i] + 4;
  return x;
}
---
<figure class="tocol">
  <div class="tocol-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The same four orders stored by row and by column. Fetching Bob's order reads one row in the row store but five separate column files in the column store. Summing the amount reads every field of every order in the row store but only the amount file in the column store.">
    {/* Panel headers */}
    <text x={leftX} y="24" class="tocol-h">
      <tspan data-lang-en>Row store (PostgreSQL, MySQL)</tspan>
      <tspan data-lang-vi>Lưu theo dòng (PostgreSQL, MySQL)</tspan>
    </text>
    <text x={leftX} y="46" class="tocol-sub">
      <tspan data-lang-en>Each order is stored in one piece, one after another.</tspan>
      <tspan data-lang-vi>Mỗi đơn hàng nằm liền một khối, nối tiếp nhau.</tspan>
    </text>
    <text x={rightX} y="24" class="tocol-h">
      <tspan data-lang-en>Column store (ClickHouse, BigQuery)</tspan>
      <tspan data-lang-vi>Lưu theo cột (ClickHouse, BigQuery)</tspan>
    </text>
    <text x={rightX} y="46" class="tocol-sub">
      <tspan data-lang-en>Each column is stored in its own file.</tspan>
      <tspan data-lang-vi>Mỗi cột nằm trong một file riêng.</tspan>
    </text>
    <line x1="20" x2={W - 20} y1="64" y2="64" class="tocol-rule" />

    {queries.map((q, qi) => {
      const top = qTop[qi];
      const panelY = top + 18;
      const verdictY = panelY + panelH + 22;
      return (
        <g>
          <text x="20" y={top} class="tocol-q">
            <tspan data-lang-en>{q.headEn}</tspan>
            <tspan data-lang-vi>{q.headVi}</tspan>
          </text>

          {/* Row store: field names, then one strip per order */}
          {fields.map((f, fi) => (
            <text x={rowCellX(fi) + rowCellW[fi] / 2} y={panelY + 12} text-anchor="middle" class="tocol-field">{f}</text>
          ))}
          {rows.map((row, ri) => {
            const y = panelY + 22 + ri * (stripH + rowGap);
            return (
              <g>
                {row.map((v, fi) => {
                  const state = q.rowCell(ri, fi);
                  return (
                    <g class={`tocol-cell is-${state}`}>
                      <rect x={rowCellX(fi)} y={y} width={rowCellW[fi]} height={stripH} rx="3" />
                      <text x={rowCellX(fi) + rowCellW[fi] / 2} y={y + 19} text-anchor="middle">{v}</text>
                    </g>
                  );
                })}
              </g>
            );
          })}

          {/* Column store: one strip per column */}
          {fields.map((f, fi) => {
            const y = panelY + 4 + fi * (stripH + rowGap);
            return (
              <g>
                <text x={rightX} y={y + 19} class="tocol-field">{f}</text>
                {rows.map((row, ri) => {
                  const state = q.colCell(fi, ri);
                  const x = rightX + colLabelW + ri * (colCellW + 4);
                  return (
                    <g class={`tocol-cell is-${state}`}>
                      <rect x={x} y={y} width={colCellW} height={stripH} rx="3" />
                      <text x={x + colCellW / 2} y={y + 19} text-anchor="middle">{row[fi]}</text>
                    </g>
                  );
                })}
              </g>
            );
          })}

          <text x={leftX} y={verdictY} class={q.rowVerdict.bad ? 'tocol-verdict is-bad' : 'tocol-verdict'}>
            <tspan data-lang-en>{q.rowVerdict.en}</tspan>
            <tspan data-lang-vi>{q.rowVerdict.vi}</tspan>
          </text>
          <text x={rightX} y={verdictY} class={q.colVerdict.bad ? 'tocol-verdict is-bad' : 'tocol-verdict'}>
            <tspan data-lang-en>{q.colVerdict.en}</tspan>
            <tspan data-lang-vi>{q.colVerdict.vi}</tspan>
          </text>
        </g>
      );
    })}

    {/* Legend */}
    <line x1="20" x2={W - 20} y1="572" y2="572" class="tocol-rule" />
    <g class="tocol-cell is-need"><rect x="20" y="586" width="30" height="18" rx="3" /></g>
    <text x="58" y="600" class="tocol-legend">
      <tspan data-lang-en>read and used</tspan>
      <tspan data-lang-vi>đọc và dùng tới</tspan>
    </text>
    <g class="tocol-cell is-waste"><rect x="230" y="586" width="30" height="18" rx="3" /></g>
    <text x="268" y="600" class="tocol-legend">
      <tspan data-lang-en>read from disk, then thrown away</tspan>
      <tspan data-lang-vi>đọc từ đĩa lên rồi bỏ đi</tspan>
    </text>
    <g class="tocol-cell is-skip"><rect x="560" y="586" width="30" height="18" rx="3" /></g>
    <text x="598" y="600" class="tocol-legend">
      <tspan data-lang-en>not touched</tspan>
      <tspan data-lang-vi>không đụng tới</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Same four orders, two layouts. Each layout wins one query. Simplified to five columns: the orders table in the text has about 50, so the thrown-away part on the left grows with every extra column.</span>
    <span data-lang-vi>Cùng bốn đơn hàng, hai cách xếp. Mỗi cách thắng một truy vấn. Hình chỉ vẽ năm cột cho gọn: bảng orders trong bài có khoảng 50 cột, nên phần bị đọc rồi bỏ ở bên trái còn lớn hơn nhiều.</span>
  </figcaption>
</figure>

<style>
  .tocol {
    margin: 2em 0;
    width: 100%;
  }
  .tocol-scroll {
    overflow-x: auto;
  }
  .tocol svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .tocol text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .tocol .tocol-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .tocol .tocol-sub {
    fill: var(--text-muted);
  }
  .tocol .tocol-q {
    font-size: 15px;
    font-weight: 600;
    fill: var(--text);
  }
  .tocol .tocol-field {
    font-size: 13px;
    font-weight: 600;
    fill: var(--text-muted);
  }
  .tocol-rule {
    stroke: var(--border);
  }
  .tocol-cell rect {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1;
  }
  .tocol .tocol-cell text {
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .tocol-cell.is-need rect {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .tocol .tocol-cell.is-need text {
    fill: var(--text);
    font-weight: 700;
  }
  .tocol-cell.is-waste rect {
    fill: var(--red-tint-bg);
  }
  .tocol .tocol-cell.is-waste text {
    fill: var(--text-muted);
  }
  .tocol .tocol-cell.is-skip text {
    fill: var(--text-faint);
    opacity: 0.6;
  }
  .tocol .tocol-verdict {
    font-weight: 600;
    fill: var(--text);
  }
  .tocol .tocol-verdict.is-bad {
    fill: var(--red);
    font-weight: 700;
  }
  .tocol .tocol-legend {
    fill: var(--text-muted);
  }
  .tocol figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
