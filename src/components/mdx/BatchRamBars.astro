---
import BatchDiagram from './BatchDiagram.astro';
const boxes = [{"x": 230, "y": 52, "w": 39, "h": 22, "t": ["", ""]}, {"x": 230, "y": 88, "w": 48, "h": 22, "t": ["", ""], "kind": "good"}, {"x": 230, "y": 188, "w": 520, "h": 22, "t": ["", ""], "kind": "hot"}, {"x": 230, "y": 224, "w": 37, "h": 22, "t": ["", ""], "kind": "good"}];
const arrows = [];
const texts = [{"x": 20, "y": 28, "cls": "h", "t": ["Peak memory on 1,000,000 log lines (measured)", "Đỉnh RAM trên 1.000.000 dòng log (đo thực tế)"]}, {"x": 20, "y": 48, "cls": "sub", "t": ["500 unique URLs", "500 URL riêng biệt"]}, {"x": 20, "y": 68, "cls": "foot", "t": ["Python hash table", "Bảng băm Python"]}, {"x": 20, "y": 104, "cls": "foot", "t": ["sort -S 8M pipe", "Đường ống sort -S 8M"]}, {"x": 20, "y": 168, "cls": "sub", "t": ["1,000,000 unique URLs", "1.000.000 URL riêng biệt"]}, {"x": 20, "y": 204, "cls": "foot", "t": ["Python hash table", "Bảng băm Python"]}, {"x": 20, "y": 240, "cls": "foot", "t": ["sort -S 8M pipe", "Đường ống sort -S 8M"]}, {"x": 276, "y": 68, "cls": "note", "t": ["14.2 MiB", "14,2 MiB"], "anchor": "start"}, {"x": 286, "y": 104, "cls": "note", "t": ["17.7 MiB", "17,7 MiB"], "anchor": "start"}, {"x": 758, "y": 204, "cls": "note", "t": ["191.6 MiB", "191,6 MiB"], "anchor": "start"}, {"x": 275, "y": 240, "cls": "note", "t": ["13.8 MiB", "13,8 MiB"], "anchor": "start"}, {"x": 20, "y": 300, "cls": "foot", "t": ["Fewer keys: the hash table is smaller and faster. Every row a new key: it grows 13.5 times, the pipe does not.", "Ít khoá: bảng băm nhỏ và nhanh hơn. Mỗi dòng một khoá mới: nó phình 13,5 lần, còn đường ống thì không."]}];
---
<BatchDiagram
  w={900} h={330}
  aria="Bar chart of peak memory on 1,000,000 log lines. With 500 unique URLs: Python hash table 14.2 MiB, sort pipeline 17.7 MiB. With 1,000,000 unique URLs: Python hash table 191.6 MiB, sort pipeline 13.8 MiB."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any} rules={[]} icons={[]}
  caption={["Same 107 MiB file, same machine: only the number of distinct keys changed, and only the hash table paid for it.", "Cùng file 107 MiB, cùng máy: chỉ số khoá khác nhau đổi, và chỉ bảng băm phải trả giá."]}
/>
