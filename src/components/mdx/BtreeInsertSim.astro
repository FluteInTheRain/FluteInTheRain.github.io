---
// B-tree insert simulator: a DemoFrame around the BtreeInsertDemo island, plus its caption and styles.
// Shared .sd-stat label overrides live in LsmPlayground.astro's global styles too; repeated here so
// this component works on its own.
import DemoFrame from './DemoFrame.astro';
import BtreeInsertDemo from '../demos/BtreeInsertDemo.tsx';
---
<figure class="bts-figure">
  <DemoFrame title="Where each new key lands in a B-tree" titleVi="Khoá mới rơi vào đâu trong B-tree">
    <BtreeInsertDemo client:visible />
  </DemoFrame>
  <figcaption>
    <span data-lang-en>These numbers are simulated: leaf pages hold 8 keys, each commit writes every page it changed once, and a split also rewrites the parent page. When a key is the largest so far, the full page is left alone and a new page starts on the right, which is why MySQL's docs say sequential inserts leave InnoDB pages about 15/16 full. Real pages hold hundreds of keys, so the real gap is much wider than here; the SQLite run above shows it.</span>
    <span data-lang-vi>Đây là mô phỏng, không phải số đo: mỗi trang lá chứa 8 khoá, mỗi commit ghi mỗi trang đã sửa đúng một lần, và khi tách trang thì trang cha cũng bị ghi lại. Khi khoá mới là khoá lớn nhất từ trước tới giờ, trang đầy được để nguyên và một trang mới mở ra bên phải; đó là lý do tài liệu MySQL nói insert tuần tự để lại các trang InnoDB đầy khoảng 15/16. Trang thật chứa hàng trăm khoá, nên khoảng cách thật lớn hơn nhiều so với ở đây; lần chạy SQLite phía trên cho thấy điều đó.</span>
  </figcaption>
</figure>

<style is:global>
  .bts-figure {
    margin: 2em 0;
    width: 100%;
  }
  .bts-figure > .demo-frame {
    margin-bottom: 0;
  }
  .bts-figure > figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
  .bts .sd-stat span {
    text-transform: none;
    letter-spacing: 0;
    font-size: 12.5px;
    font-weight: 600;
  }
  .bts .sd-stat b span {
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
  }
  .bts-msg {
    min-height: 2.8em;
    margin: 0 0 10px;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--text-body);
  }
  .bts-root {
    margin: 0 0 6px;
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .bts-leaves {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .bts-leaf {
    display: grid;
    grid-template-columns: repeat(4, 9px);
    gap: 2px;
    padding: 4px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-alt);
  }
  .bts-leaf span {
    width: 9px;
    height: 9px;
    border-radius: 1px;
    background: transparent;
    outline: 1px solid var(--border);
  }
  .bts-leaf span.is-used {
    background: var(--text-muted);
    outline: none;
  }
  .bts-leaf.is-hot {
    border-color: var(--red);
    background: var(--red-tint-bg);
    box-shadow: 0 0 0 1px var(--red);
  }
  .bts-leaf.is-hot span.is-used {
    background: var(--red);
  }
  .bts-leaf.is-new {
    border-style: dashed;
    box-shadow: none;
  }
  .bts-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    margin: 10px 0 0;
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .bts-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-right: 14px;
  }
  .bts-legend-swatch {
    display: inline-block;
    width: 18px;
    height: 14px;
    padding: 0;
  }
</style>
