---
// The private-photo leak with the numbers used in the text (200 ms, 130 ms, 150 ms). Illustrative
// timestamps, not measurements. Static SVG, site tokens only.
import ConsensusFigure from './ConsensusFigure.astro';
import DiagramIcon from './DiagramIcon.astro';
interface Props { lang: 'en' | 'vi' }
const { lang } = Astro.props;

const T = {
  en: {
    aria: 'A time axis in milliseconds with two writes. On the laptop, node A, the user sets the account to private first and node A stamps it 200 ms. Then on the phone, node B, whose clock runs 120 ms behind, uploads a photo and stamps it 130 ms. A stranger reads a snapshot at 150 ms and sees the photo but not the privacy switch, so the account still looks public.',
    laptop: ['Laptop, node A', '1  set account to private'], phone: ['Phone, node B', '2  upload photo'],
    laptopStamp: 'stamped 200 ms', phoneStamp: 'stamped 130 ms (clock 120 ms behind)',
    stranger: 'Stranger reads a snapshot at 150 ms',
    axis: 'timestamp (ms)',
    res: ['The snapshot at 150 ms holds the photo but not the privacy switch:', 'the account still looks public.'],
    cap: 'The photo really happened after the privacy switch, but its lower timestamp puts it before.',
  },
  vi: {
    aria: 'Trục thời gian tính bằng mili giây với hai lần ghi. Trên laptop, node A, người dùng đặt tài khoản ở chế độ riêng tư trước và node A đóng dấu 200 ms. Sau đó trên điện thoại, node B có đồng hồ chậm 120 ms, đăng ảnh và đóng dấu 130 ms. Một người lạ đọc snapshot tại 150 ms và thấy ảnh nhưng không thấy lần đổi chế độ, nên tài khoản vẫn trông như công khai.',
    laptop: ['Laptop, node A', '1  đặt tài khoản riêng tư'], phone: ['Điện thoại, node B', '2  đăng ảnh'],
    laptopStamp: 'đóng dấu 200 ms', phoneStamp: 'đóng dấu 130 ms (đồng hồ chậm 120 ms)',
    stranger: 'Người lạ đọc snapshot tại 150 ms',
    axis: 'timestamp (ms)',
    res: ['Snapshot tại 150 ms có ảnh nhưng chưa có lần đổi chế độ riêng tư:', 'tài khoản vẫn trông như công khai.'],
    cap: 'Ảnh thật ra được đăng sau lần đổi chế độ, nhưng timestamp thấp hơn xếp nó lên trước.',
  },
}[lang];

const X = (t: number) => 300 + (t - 100) * 5; // 100 ms -> 300, 220 ms -> 900
---
<ConsensusFigure aria={T.aria} cap={T.cap} w={900} h={330}>
  <DiagramIcon name="laptop" x={34} y={78} size={26} />
  <text x="62" y="74" class="cfg-n">{T.laptop[0]}</text>
  <text x="62" y="92" class="cfg-m">{T.laptop[1]}</text>
  <line x1="300" x2="880" y1="84" y2="84" class="cfg-line is-dash" />
  <circle cx={X(200)} cy="84" r="7" class="cfg-dot" />
  <text x={X(200)} y="68" text-anchor="middle" class="cfg-g">{T.laptopStamp}</text>
  <DiagramIcon name="phone" x={34} y={148} size={26} />
  <text x="62" y="144" class="cfg-n">{T.phone[0]}</text>
  <text x="62" y="162" class="cfg-m">{T.phone[1]}</text>
  <line x1="300" x2="880" y1="154" y2="154" class="cfg-line is-dash" />
  <circle cx={X(130)} cy="154" r="7" class="cfg-dot is-bad" />
  <text x={X(130) - 6} y="178" text-anchor="end" class="cfg-r">{T.phoneStamp}</text>
  <line x1={X(150)} x2={X(150)} y1="50" y2="196" class="cfg-cut" />
  <DiagramIcon name="user" x={X(150)} y={34} size={24} />
  <text x={X(150) + 22} y="38" class="cfg-m" style="fill:var(--text)">{T.stranger}</text>
  <line x1="300" x2="880" y1="200" y2="200" class="cfg-line" />
  {[100, 130, 150, 200].map((t) => (
    <g>
      <line x1={X(t)} x2={X(t)} y1="196" y2="206" class="cfg-line" />
      <text x={X(t)} y="222" text-anchor="middle" class="cfg-m">{t}</text>
    </g>
  ))}
  <text x="880" y="240" text-anchor="end" class="cfg-m">{T.axis}</text>
  <rect x="20" y="256" width="860" height="56" rx="6" class="cfg-box is-bad" />
  <text x="450" y="279" text-anchor="middle" class="cfg-g">{T.res[0]}</text>
  <text x="450" y="298" text-anchor="middle" class="cfg-g">{T.res[1]}</text>
</ConsensusFigure>
