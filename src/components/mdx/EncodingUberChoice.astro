---
import EncodingStepCards from './EncodingStepCards.astro';
const props = {
 "arrows": true,
 "title": {
  "en": "Why Uber picked MessagePack over the smallest option",
  "vi": "Vì sao Uber chọn MessagePack thay vì cái nhỏ nhất"
 },
 "alt": "Uber's choice. Trips were stored as JSON blobs of about 20 KB in Schemaless, with no strict schema between services until autumn 2014. Protocol Buffers with zlib was the smallest, just above 8 percent of raw JSON, but needs schemas to be written and enforced first. MessagePack with zlib gave 18.3 MB against 132.9 MB of raw JSON and needs no schema, so it fit the data they had.",
 "cards": [
  {
   "icon": "db",
   "head": {
    "en": [
     "Trips as JSON"
    ],
    "vi": [
     "Chuyến đi dạng JSON"
    ]
   },
   "lines": {
    "en": [
     "About 20 KB each, stored in",
     "Schemaless. 2,219 test trips.",
     "No strict schema between",
     "services until autumn 2014."
    ],
    "vi": [
     "Mỗi chuyến khoảng 20 KB, lưu ở",
     "Schemaless. 2.219 chuyến test.",
     "Không có schema chặt giữa",
     "các service tới mùa thu 2014."
    ]
   },
   "tone": "plain"
  },
  {
   "icon": "file",
   "head": {
    "en": [
     "Protocol Buffers + zlib"
    ],
    "vi": [
     "Protocol Buffers + zlib"
    ]
   },
   "lines": {
    "en": [
     "Smallest: just above 8%",
     "of the raw JSON size. But",
     "schemas must be written and",
     "enforced first."
    ],
    "vi": [
     "Nhỏ nhất: nhỉnh hơn 8% so",
     "với JSON gốc. Nhưng phải",
     "viết và áp schema",
     "trước đã."
    ]
   },
   "tone": "plain"
  },
  {
   "icon": "ok",
   "head": {
    "en": [
     "MessagePack + zlib"
    ],
    "vi": [
     "MessagePack + zlib"
    ]
   },
   "lines": {
    "en": [
     "18.3 MB against 132.9 MB",
     "of raw JSON. No schema",
     "needed, so it fit the data",
     "they already had."
    ],
    "vi": [
     "18,3 MB so với 132,9 MB",
     "JSON gốc. Không cần schema,",
     "nên hợp với dữ liệu",
     "họ đang có."
    ]
   },
   "tone": "good"
  }
 ],
 "note": {
  "en": "The format choice was really a choice about schemas.",
  "vi": "Chọn định dạng thật ra là chọn chuyện schema."
 },
 "caption": {
  "en": "Numbers are from Uber Engineering's 2016 post. The picked option is highlighted.",
  "vi": "Số liệu lấy từ bài năm 2016 của Uber Engineering. Lựa chọn cuối được tô nổi."
 }
};
---
<EncodingStepCards {...props} />
