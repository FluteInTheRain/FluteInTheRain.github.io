---
// A write conflict between two leaders, step by step. Illustrative example.
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Arrow from './ReplicationBArrow.astro';
import Bi from './ReplicationBBi.astro';
---
<Frame h={330}
  label="Two leaders start with title equal to Draft. At the same time, leader 1 accepts Plan A and leader 2 accepts Plan B, and each tells its user OK. When they exchange changes, each overwrites its value with the other one, so leader 1 holds Plan B, leader 2 holds Plan A, and they stay different."
  cap="If each leader simply applies what arrives, the two copies swap values and never agree. That is a write conflict."
  capVi="Nếu mỗi leader chỉ việc áp dụng thứ vừa tới, hai bản sao đổi giá trị cho nhau và không bao giờ khớp. Đó là xung đột ghi.">
  <Node x={40} y={20} w={300} h={50} icon="server" t="Leader 1: title = Draft" tv="Leader 1: title = Draft" />
  <Node x={560} y={20} w={300} h={50} icon="server" t="Leader 2: title = Draft" tv="Leader 2: title = Draft" />
  <text x="450" y="50" text-anchor="middle" class="rb-step"><Bi en="1. same start" vi="1. cùng điểm xuất phát" /></text>
  <Arrow x1={190} y1={70} x2={190} y2={120} />
  <Arrow x1={710} y1={70} x2={710} y2={120} />
  <Node x={40} y={120} w={300} h={60} icon="server" t="Leader 1: title = Plan A" tv="Leader 1: title = Plan A" s="user 1 was told OK" sv="user 1 đã nhận OK" cls="strong" />
  <Node x={560} y={120} w={300} h={60} icon="server" t="Leader 2: title = Plan B" tv="Leader 2: title = Plan B" s="user 2 was told OK" sv="user 2 đã nhận OK" cls="strong" />
  <text x="450" y="155" text-anchor="middle" class="rb-step"><Bi en="2. writes at the same time" vi="2. ghi cùng lúc" /></text>
  <Arrow x1={190} y1={180} x2={700} y2={240} />
  <Arrow x1={710} y1={180} x2={200} y2={240} />
  <Node x={40} y={240} w={300} h={60} icon="server" t="Leader 1: title = Plan B" tv="Leader 1: title = Plan B" s="Plan A is overwritten" sv="Plan A bị ghi đè" cls="red" />
  <Node x={560} y={240} w={300} h={60} icon="server" t="Leader 2: title = Plan A" tv="Leader 2: title = Plan A" s="Plan B is overwritten" sv="Plan B bị ghi đè" cls="red" />
  <text x="450" y="275" text-anchor="middle" class="rb-step"><Bi en="3. they swap changes" vi="3. trao đổi thay đổi" /></text>
</Frame>
