---
// The TCP three-way handshake: SYN, SYN-ACK, ACK — one round trip —
// then the pipe is open and bytes flow both ways.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 290;
---
<figure class="bep1c">
  <div class="bep1c-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The TCP three-way handshake between curl and the FastAPI server: SYN, SYN-ACK and ACK take one round trip, then bytes flow both ways over the open pipe.">
    <rect x="115" y="16" width="170" height="60" rx="8" class="box" />
    <circle cx="141" cy="46" r="18" class="disc" />
    <image href="/icons/flow/curl.svg" x="126" y="31" width="30" height="30" class="icn" aria-hidden="true" />
    <text x="173" y="51" class="t">client (curl)</text>
    <rect x="575" y="16" width="210" height="60" rx="8" class="box" />
    <image href="/icons/flow/fastapi.svg" x="591" y="31" width="30" height="30" class="icn" aria-hidden="true" />
    <text x="640" y="42" class="t">server</text>
    <text x="640" y="60" class="m">fastapi.tiangolo.com</text>
    <path d="M 200 80 L 200 270" class="ll" />
    <path d="M 700 80 L 700 270" class="ll" />
    {(() => { const a = arrow(200, 110, 700, 110); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
    <text x="450" y="102" text-anchor="middle" class="p">SYN</text>
    {(() => { const a = arrow(700, 140, 200, 140); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
    <text x="450" y="132" text-anchor="middle" class="p">SYN-ACK</text>
    {(() => { const a = arrow(200, 170, 700, 170); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
    <text x="450" y="162" text-anchor="middle" class="p">ACK</text>
    <path d="M 752 110 L 760 110 L 760 170 L 752 170" class="br" />
    <text x="768" y="145" class="m"><tspan data-lang-en>one round trip</tspan><tspan data-lang-vi>một round trip</tspan></text>
    <path d="M 160 200 L 740 200" class="sep" />
    <text x="450" y="222" text-anchor="middle" class="m"><tspan data-lang-en>handshake done — the pipe is open</tspan><tspan data-lang-vi>handshake xong — ống đã mở</tspan></text>
    {(() => { const a = arrow(200, 240, 700, 240); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
    {(() => { const a = arrow(700, 268, 200, 268); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
    <text x="450" y="259" text-anchor="middle" class="t"><tspan data-lang-en>bytes flow both ways</tspan><tspan data-lang-vi>byte chạy hai chiều</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Three packets, one round trip — then the pipe is open and bytes flow both ways.</span>
    <span data-lang-vi>Ba gói, một round trip — xong thì ống mở, byte chạy hai chiều.</span>
  </figcaption>
</figure>

<style>
  .bep1c { margin: 2em 0; width: 100%; }
  .bep1c-scroll { overflow-x: auto; }
  .bep1c svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep1c text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep1c .t { font-weight: 700; fill: var(--text); }
  .bep1c .p { font-weight: 700; fill: var(--text); font-size: 13.5px; }
  .bep1c .m { fill: var(--text-muted); font-size: 13px; }
  .bep1c .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep1c .disc { fill: none; }
  .bep1c .ll { stroke: var(--border); stroke-width: 1.5; }
  .bep1c .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep1c .hd { fill: var(--text-muted); }
  .bep1c .br { stroke: var(--text-muted); stroke-width: 1.2; fill: none; }
  .bep1c .sep { stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 4 4; fill: none; }
  .bep1c figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  :global([data-theme='dark']) .bep1c .disc { fill: rgba(255, 255, 255, 0.88); }
</style>
