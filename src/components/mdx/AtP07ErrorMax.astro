---
// One simulated five-year history of ten assets (numpy default_rng(11)). Left: the true annual mean return of each asset
// (known only because we simulated it) next to the mean the optimizer estimated; right: the weights unconstrained
// mean-variance picked from those estimates. Values from final.py (see verifiedBy in the quiz).
const trueMu = [8.4, 4.0, 7.9, 4.6, 5.7, 7.3, 5.1, 6.2, 6.8, 9.0];
const estMu = [19.1, 6.4, 17.9, 8.4, 13.7, 4.8, 7.6, 32.1, 8.2, 7.7];
const w = [95, 1, 51, -22, 20, -26, -12, 22, -20, -10];
const W = 900, H = 410;
const x0 = 56, sx = (v: number) => v * 7.2;
const wx0 = 700, sw = (v: number) => v * 1.45;
const ry = (i: number) => 74 + i * 28;
---
<figure class="p07b">
  <div class="p07b-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Ten simulated assets. For each, a bar for the true average return, between 4 and 9 percent, and a longer bar for the return estimated from five years of data, up to 32.1 percent. On the right, the weights an unconstrained optimizer chose: 95 percent in the first asset, 51 percent in the third, and short positions down to minus 26 percent.">
    <text x="20" y="26" class="h">
      <tspan data-lang-en>One five-year history, ten assets: what the optimizer believed</tspan>
      <tspan data-lang-vi>Một lịch sử năm năm, mười tài sản: điều optimizer tin</tspan>
    </text>
    <text x="20" y="52" class="m"><tspan data-lang-en>Average annual return, % (grey = true, gold = estimated)</tspan><tspan data-lang-vi>Lợi suất trung bình mỗi năm, % (xám = thật, vàng = ước lượng)</tspan></text>
    <text x="660" y="52" class="m"><tspan data-lang-en>Weight picked, %</tspan><tspan data-lang-vi>Trọng số được chọn, %</tspan></text>
    {trueMu.map((t, i) => (
      <g>
        <text x="20" y={ry(i) + 8} class="lab">{i + 1}</text>
        <rect x={x0} y={ry(i) - 4} width={sx(t)} height="9" rx="2" class="grey" />
        <rect x={x0} y={ry(i) + 6} width={sx(estMu[i])} height="9" rx="2" class="gold" />
        <text x={x0 + sx(Math.max(estMu[i], trueMu[i])) + 6} y={ry(i) + 14} class="num">{estMu[i]}</text>
        <rect x={w[i] >= 0 ? wx0 : wx0 + sw(w[i])} y={ry(i) - 2} width={Math.abs(sw(w[i]))} height="16" rx="2" class={w[i] >= 0 ? 'gold' : 'redf'} />
        <text x={w[i] >= 0 ? wx0 + sw(w[i]) + 6 : wx0 + 6} y={ry(i) + 12} class={w[i] >= 0 ? 'num' : 'num red'}>{w[i]}</text>
      </g>
    ))}
    <line x1={wx0} x2={wx0} y1="60" y2="352" class="grid" />
    <text x="20" y="378" class="sub">
      <tspan data-lang-en>True returns sit between 4% and 9%; the estimates run up to 32.1%.</tspan>
      <tspan data-lang-vi>Lợi suất thật nằm trong khoảng 4% đến 9%; ước lượng lên tới 32,1%.</tspan>
    </text>
    <text x="20" y="396" class="sub">
      <tspan data-lang-en>The weights add up to 100% only because the shorts pay for the longs.</tspan>
      <tspan data-lang-vi>Trọng số cộng lại bằng 100% chỉ vì các vị thế bán khống trả cho các vị thế mua.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Simulated: the optimizer treats each estimate as fact and puts 95% in asset 1, whose true return is 8.4%.</span>
    <span data-lang-vi>Mô phỏng: optimizer coi mỗi ước lượng là sự thật và dồn 95% vào tài sản 1, vốn chỉ có lợi suất thật 8,4%.</span>
  </figcaption>
</figure>

<style>

  .p07b { margin: 2em 0; width: 100%; }
  .p07b-scroll { overflow-x: auto; }
  .p07b svg { display: block; width: 100%; min-width: 600px; height: auto; font-variant-numeric: tabular-nums; }
  .p07b text { font-size: 14px; fill: var(--text-body); }
  .p07b .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p07b .sub { font-size: 12.5px; fill: var(--text-muted); }
  .p07b .m { font-size: 12.5px; fill: var(--text-muted); }
  .p07b .lab { font-size: 13px; font-weight: 600; fill: var(--text); }
  .p07b .num { font-size: 13px; font-weight: 700; fill: var(--text); }
  .p07b .num.red { fill: var(--red); }
  .p07b .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p07b .grid { stroke: var(--border); stroke-width: 1; }
  .p07b .arrow { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.3; }
  .p07b .gold { fill: var(--gold); }
  .p07b .grey { fill: var(--text-muted); opacity: 0.55; }
  .p07b .redf { fill: var(--red); }
  .p07b .redt { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
  .p07b .line-gold { stroke: var(--gold); stroke-width: 2.5; fill: none; }
  .p07b .line-red { stroke: var(--red); stroke-width: 2.5; fill: none; }
  .p07b .dash { stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 5 4; fill: none; }
  .p07b figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
