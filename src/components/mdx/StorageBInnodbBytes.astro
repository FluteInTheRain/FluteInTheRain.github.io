---
// Four small panels, one per reason InnoDB wrote or stored extra bytes in
// Facebook's user database tier (Matsunobu, 2016). Numbers (16 KB, 5 KB, 8 KB, 13 bytes)
// come from the post; the drawing is schematic.
// Plain inline SVG with site tokens, polygon arrowheads, no ids.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 326;
const pw = 205;
const px = [20, 238, 456, 674];
const py = 66;
const ph = 240;

function down(x: number, y1: number, y2: number) {
  return { line: `M${x},${y1} L${x},${y2 - 7}`, head: `${x - 5},${y2 - 8} ${x + 5},${y2 - 8} ${x},${y2}` };
}
const a1 = [0, 1, 2].map((i) => down(px[0] + 40 + i * 62, 154, 196));
const a2 = down(px[1] + 102, 154, 190);
const a2b = down(px[1] + 102, 236, 270);
---
<figure class="ib">
  <div class="ib-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four reasons InnoDB used more bytes at Facebook: random key order rewrites the same page again and again; each dirty page is written twice; compressed pages have a fixed size so a 16 KB page that compresses to 5 KB still takes 8 KB; and every row carries 13 bytes of uncompressed metadata.">
    <text x="20" y="24" class="ib-h">
      <tspan data-lang-en>Where InnoDB's extra bytes came from</tspan>
      <tspan data-lang-vi>Các byte thừa của InnoDB đến từ đâu</tspan>
    </text>
    <text x="20" y="46" class="ib-sub">
      <tspan data-lang-en>Four causes Facebook listed for its user database tier.</tspan>
      <tspan data-lang-vi>Bốn nguyên nhân Facebook liệt kê cho tầng database người dùng của họ.</tspan>
    </text>

    {px.map((x) => (<rect x={x} y={py} width={pw} height={ph} rx="4" class="ib-panel" />))}

    <!-- 1: random order, same page rewritten -->
    <DiagramIcon name="disk" x={px[0] + 24} y={py + 28} size={26} />
    <text x={px[0] + 48} y={py + 24} class="ib-t">
      <tspan data-lang-en>Random key order</tspan>
      <tspan data-lang-vi>Khoá ngẫu nhiên</tspan>
    </text>
    <text x={px[0] + 48} y={py + 42} class="ib-t2">
      <tspan data-lang-en>on a big working set</tspan>
      <tspan data-lang-vi>trên tập dữ liệu lớn</tspan>
    </text>
    {[0, 1, 2].map((i) => (
      <g>
        <rect x={px[0] + 14 + i * 62} y="118" width="52" height="30" rx="3" class="ib-cell" />
        <text x={px[0] + 40 + i * 62} y="138" text-anchor="middle" class="ib-s">
          <tspan data-lang-en>write</tspan>
          <tspan data-lang-vi>ghi</tspan>
        </text>
        <path d={a1[i].line} class="ib-arrow is-hot" /><polygon points={a1[i].head} class="ib-head is-hot" />
      </g>
    ))}
    <rect x={px[0] + 14} y="196" width="176" height="40" rx="3" class="ib-cell is-hot" />
    <text x={px[0] + 102} y="221" text-anchor="middle" class="ib-s is-hot">
      <tspan data-lang-en>the same page</tspan>
      <tspan data-lang-vi>cùng một trang</tspan>
    </text>
    <text x={px[0] + 14} y="268" class="ib-n">
      <tspan data-lang-en>Pages are written again</tspan>
      <tspan data-lang-vi>Trang bị ghi đi ghi lại</tspan>
    </text>
    <text x={px[0] + 14} y="286" class="ib-n">
      <tspan data-lang-en>and again.</tspan>
      <tspan data-lang-vi>nhiều lần.</tspan>
    </text>

    <!-- 2: dirty page written twice -->
    <DiagramIcon name="log" x={px[1] + 24} y={py + 28} size={26} />
    <text x={px[1] + 48} y={py + 24} class="ib-t">
      <tspan data-lang-en>Written twice</tspan>
      <tspan data-lang-vi>Ghi hai lần</tspan>
    </text>
    <text x={px[1] + 48} y={py + 42} class="ib-t2">
      <tspan data-lang-en>every dirty page</tspan>
      <tspan data-lang-vi>mỗi trang bẩn</tspan>
    </text>
    <rect x={px[1] + 14} y="118" width="176" height="36" rx="3" class="ib-cell" />
    <text x={px[1] + 102} y="141" text-anchor="middle" class="ib-s">
      <tspan data-lang-en>dirty page in memory</tspan>
      <tspan data-lang-vi>trang bẩn trong RAM</tspan>
    </text>
    <path d={a2.line} class="ib-arrow" /><polygon points={a2.head} class="ib-head" />
    <rect x={px[1] + 14} y="190" width="176" height="46" rx="3" class="ib-cell is-hot" />
    <text x={px[1] + 102} y="210" text-anchor="middle" class="ib-s is-hot">
      <tspan data-lang-en>copy 1: safety area</tspan>
      <tspan data-lang-vi>bản 1: vùng an toàn</tspan>
    </text>
    <text x={px[1] + 102} y="226" text-anchor="middle" class="ib-s is-hot">
      <tspan data-lang-en>copy 2: table file</tspan>
      <tspan data-lang-vi>bản 2: file bảng</tspan>
    </text>
    <text x={px[1] + 14} y="268" class="ib-n">
      <tspan data-lang-en>Protects against a page</tspan>
      <tspan data-lang-vi>Để cứu trang chỉ ghi dở</tspan>
    </text>
    <text x={px[1] + 14} y="286" class="ib-n">
      <tspan data-lang-en>half written at a crash.</tspan>
      <tspan data-lang-vi>khi máy chết.</tspan>
    </text>

    <!-- 3: fixed-size compressed page -->
    <DiagramIcon name="file" x={px[2] + 24} y={py + 28} size={26} />
    <text x={px[2] + 48} y={py + 24} class="ib-t">
      <tspan data-lang-en>Fixed-size pages</tspan>
      <tspan data-lang-vi>Trang cỡ cố định</tspan>
    </text>
    <text x={px[2] + 48} y={py + 42} class="ib-t2">
      <tspan data-lang-en>compressed tables</tspan>
      <tspan data-lang-vi>bảng có nén</tspan>
    </text>
    <text x={px[2] + 14} y="124" class="ib-s">
      <tspan data-lang-en>page: 16 KB</tspan>
      <tspan data-lang-vi>trang: 16 KB</tspan>
    </text>
    <rect x={px[2] + 14} y="132" width="176" height="18" rx="2" class="ib-cell" />
    <text x={px[2] + 14} y="172" class="ib-s">
      <tspan data-lang-en>compressed: 5 KB</tspan>
      <tspan data-lang-vi>sau nén: 5 KB</tspan>
    </text>
    <rect x={px[2] + 14} y="180" width="55" height="18" rx="2" class="ib-cell is-fill" />
    <text x={px[2] + 14} y="220" class="ib-s">
      <tspan data-lang-en>on disk: 8 KB</tspan>
      <tspan data-lang-vi>trên đĩa: 8 KB</tspan>
    </text>
    <rect x={px[2] + 14} y="228" width="88" height="18" rx="2" class="ib-cell is-hot" />
    <rect x={px[2] + 14} y="228" width="55" height="18" rx="2" class="ib-cell is-fill" />
    <text x={px[2] + 14} y="268" class="ib-n">
      <tspan data-lang-en>The unused part of the</tspan>
      <tspan data-lang-vi>Phần không dùng của trang</tspan>
    </text>
    <text x={px[2] + 14} y="286" class="ib-n">
      <tspan data-lang-en>page is still paid for.</tspan>
      <tspan data-lang-vi>vẫn chiếm chỗ trên đĩa.</tspan>
    </text>

    <!-- 4: 13 bytes per row -->
    <DiagramIcon name="db" x={px[3] + 24} y={py + 28} size={26} />
    <text x={px[3] + 48} y={py + 24} class="ib-t">
      <tspan data-lang-en>Metadata per row</tspan>
      <tspan data-lang-vi>Metadata mỗi dòng</tspan>
    </text>
    <text x={px[3] + 48} y={py + 42} class="ib-t2">
      <tspan data-lang-en>not compressed</tspan>
      <tspan data-lang-vi>không được nén</tspan>
    </text>
    {[0, 1, 2].map((i) => (
      <g>
        <rect x={px[3] + 14} y={118 + i * 40} width="62" height="30" rx="3" class="ib-cell is-hot" />
        <text x={px[3] + 45} y={138 + i * 40} text-anchor="middle" class="ib-s is-hot">13 B</text>
        <rect x={px[3] + 76} y={118 + i * 40} width="114" height="30" rx="3" class="ib-cell" />
        <text x={px[3] + 133} y={138 + i * 40} text-anchor="middle" class="ib-s">
          <tspan data-lang-en>small row</tspan>
          <tspan data-lang-vi>dòng nhỏ</tspan>
        </text>
      </g>
    ))}
    <text x={px[3] + 14} y="268" class="ib-n">
      <tspan data-lang-en>A big share of a small row.</tspan>
      <tspan data-lang-vi>Chiếm tỉ lệ lớn của dòng nhỏ.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Each panel is one cost. Red marks the bytes that carry no new data. Drawn from the list in Yoshinori Matsunobu's 2016 post on MyRocks.</span>
    <span data-lang-vi>Mỗi khung là một khoản tốn. Màu đỏ đánh dấu các byte không mang dữ liệu mới. Vẽ lại từ danh sách trong bài năm 2016 của Yoshinori Matsunobu về MyRocks.</span>
  </figcaption>
</figure>

<style>
  .ib { margin: 2em 0; width: 100%; }
  .ib-scroll { overflow-x: auto; }
  .ib svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .ib text { font-size: 14px; fill: var(--text-body); }
  .ib .ib-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ib .ib-sub { fill: var(--text-muted); }
  .ib-panel { fill: none; stroke: var(--border); stroke-width: 1.2; }
  .ib .ib-t { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .ib .ib-t2 { font-size: 12.5px; fill: var(--text-muted); }
  .ib .ib-s { font-size: 12px; fill: var(--text-body); }
  .ib .ib-s.is-hot { fill: var(--red); font-weight: 600; }
  .ib .ib-n { font-size: 12.5px; fill: var(--text-muted); }
  .ib-cell { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .ib-cell.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .ib-cell.is-fill { fill: var(--text-muted); stroke: var(--text-muted); }
  .ib-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .ib-arrow.is-hot { stroke: var(--red); }
  .ib-head { fill: var(--text-muted); }
  .ib-head.is-hot { fill: var(--red); }
  .ib figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
