---
// Computed by demo/ai-trading/p11_community_noise.py (200 seeded markets, 30 stocks, 5 sectors, no edge anywhere).
// Rule: every 60 days pick the best 300-day Sharpe stock per community, equal weights. Sharpe annualised.
// Groups on the left (steel HPG, HSG, NKG; banks VCB, BID, CTG) are a stated assumption, not a result.
import DiagramIcon from './DiagramIcon.astro';
const W = 900, H = 400;
const rows = [
  { n: 'Community rule', nv: 'Quy tắc cộng đồng', m: '−0.01', p: '0.61', b: '1.52', d: '−16.1' },
  { n: 'Equal weight', nv: 'Tỷ trọng đều', m: '0.02', p: '0.67', b: '1.54', d: '−12.3' },
];
---
<figure class="atp11-cm">
  <div class="atp11-cm-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: say a VN100 correlation graph has a steel community (HPG, HSG, NKG) and a bank community (VCB, BID, CTG), with one stock chosen per community by its 300-day Sharpe ratio. Right: across 200 simulated markets with no edge, the community rule has a median Sharpe of −0.01, a 90th percentile of 0.61 and a best of 1.52; equal weight has 0.02, 0.67 and 1.54; median maximum drawdown is −16.1% for the rule and −12.3% for equal weight.">
      <text x="20" y="26" class="h"><tspan data-lang-en>Say: one stock per community, rebuilt every 60 days</tspan><tspan data-lang-vi>Giả sử: mỗi cộng đồng một mã, dựng lại sau mỗi 60 ngày</tspan></text>
      <rect x="20" y="52" width="170" height="130" rx="10" class="grp g-a" />
      <text x="105" y="74" text-anchor="middle" class="gt"><tspan data-lang-en>Steel</tspan><tspan data-lang-vi>Thép</tspan></text>
      <line x1="55" y1="120" x2="105" y2="150" class="e" /><line x1="105" y1="150" x2="155" y2="120" class="e" /><line x1="55" y1="120" x2="155" y2="120" class="e" />
      {[['HPG', 55, 120], ['NKG', 155, 120], ['HSG', 105, 150]].map(([t, x, yy]) => <g><circle cx={x} cy={yy} r="15" class="n" /><text x={x} y={Number(yy) + 4} text-anchor="middle" class="nt">{t}</text></g>)}
      <rect x="220" y="52" width="170" height="130" rx="10" class="grp g-b" />
      <text x="305" y="74" text-anchor="middle" class="gt"><tspan data-lang-en>Banks</tspan><tspan data-lang-vi>Ngân hàng</tspan></text>
      <line x1="255" y1="120" x2="305" y2="150" class="e" /><line x1="305" y1="150" x2="355" y2="120" class="e" /><line x1="255" y1="120" x2="355" y2="120" class="e" />
      {[['VCB', 255, 120], ['BID', 355, 120], ['CTG', 305, 150]].map(([t, x, yy]) => <g><circle cx={x} cy={yy} r="15" class="n" /><text x={x} y={Number(yy) + 4} text-anchor="middle" class="nt">{t}</text></g>)}
      <DiagramIcon name="search" x={60} y={222} size={22} />
      <text x="84" y="220" class="step"><tspan data-lang-en>Every 60 days, in each community:</tspan><tspan data-lang-vi>Mỗi 60 ngày, trong mỗi cộng đồng:</tspan></text>
      <text x="84" y="240" class="step"><tspan data-lang-en>pick the stock with the best Sharpe</tspan><tspan data-lang-vi>chọn mã có Sharpe tốt nhất</tspan></text>
      <text x="84" y="260" class="step"><tspan data-lang-en>over the last 300 days, equal weights.</tspan><tspan data-lang-vi>trong 300 ngày gần nhất, tỷ trọng đều.</tspan></text>
      <text x="20" y="306" class="sub"><tspan data-lang-en>One pick per community: more communities,</tspan><tspan data-lang-vi>Mỗi cộng đồng một mã: nhiều cộng đồng hơn,</tspan></text>
      <text x="20" y="326" class="sub"><tspan data-lang-en>more stocks held.</tspan><tspan data-lang-vi>nhiều mã được nắm hơn.</tspan></text>
      <text x="430" y="64" class="sh"><tspan data-lang-en>200 simulated markets with no edge</tspan><tspan data-lang-vi>200 thị trường mô phỏng không có lợi thế</tspan></text>
      <g class="tbl">
        <text x="430" y="94" class="th">Sharpe</text>
        <text x="620" y="94" class="th" text-anchor="end"><tspan data-lang-en>median</tspan><tspan data-lang-vi>trung vị</tspan></text>
        <text x="705" y="94" class="th" text-anchor="end"><tspan data-lang-en>90th pct</tspan><tspan data-lang-vi>phân vị 90</tspan></text>
        <text x="775" y="94" class="th" text-anchor="end"><tspan data-lang-en>best</tspan><tspan data-lang-vi>tốt nhất</tspan></text>
        <text x="880" y="94" class="th" text-anchor="end"><tspan data-lang-en>median DD %</tspan><tspan data-lang-vi>sụt TV %</tspan></text>
        {rows.map((r, i) => (
          <g>
            <rect x="424" y={104 + i * 34} width="460" height="28" rx="5" class="row" />
            <text x="436" y={123 + i * 34} class="td"><tspan data-lang-en>{r.n}</tspan><tspan data-lang-vi>{r.nv}</tspan></text>
            <text x="620" y={123 + i * 34} class="td" text-anchor="end"><tspan data-lang-en>{r.m}</tspan><tspan data-lang-vi>{r.m.replace('.', ',')}</tspan></text>
            <text x="705" y={123 + i * 34} class="td" text-anchor="end"><tspan data-lang-en>{r.p}</tspan><tspan data-lang-vi>{r.p.replace('.', ',')}</tspan></text>
            <text x="775" y={123 + i * 34} class="td" text-anchor="end"><tspan data-lang-en>{r.b}</tspan><tspan data-lang-vi>{r.b.replace('.', ',')}</tspan></text>
            <text x="880" y={123 + i * 34} class="td" text-anchor="end"><tspan data-lang-en>{r.d}</tspan><tspan data-lang-vi>{r.d.replace('.', ',')}</tspan></text>
          </g>
        ))}
      </g>
      <DiagramIcon name="warning" x={444} y={250} size={22} />
      <text x="466" y="246" class="warn"><tspan data-lang-en>No stock has any edge, yet 32 of 200 runs</tspan><tspan data-lang-vi>Không mã nào có lợi thế, vậy mà 32 trong 200 lần</tspan></text>
      <text x="466" y="266" class="warn"><tspan data-lang-en>show a rule Sharpe above 0.5.</tspan><tspan data-lang-vi>cho Sharpe của quy tắc trên 0,5.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Left: groups are an assumption. Right: computed with demo/ai-trading/p11_community_noise.py on simulated markets of 30 stocks in 5 sectors. Nothing here is a recommendation.</span>
    <span data-lang-vi>Trái: các nhóm là giả định. Phải: tính bằng demo/ai-trading/p11_community_noise.py trên thị trường mô phỏng 30 mã, 5 ngành. Không có gì ở đây là khuyến nghị đầu tư.</span>
  </figcaption>
</figure>
<style>
  .atp11-cm { margin: 2em 0; width: 100%; }
  .atp11-cm-scroll { overflow-x: auto; }
  .atp11-cm svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .atp11-cm text { font-size: 14px; fill: var(--text-body); }
  .atp11-cm .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp11-cm .sh { font-size: 14px; font-weight: 700; fill: var(--text); }
  .atp11-cm .gt { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .atp11-cm .nt { font-size: 10.5px; font-weight: 700; fill: var(--text); }
  .atp11-cm .step { font-size: 13px; fill: var(--text); }
  .atp11-cm .sub { font-size: 12.5px; fill: var(--text-muted); }
  .atp11-cm .th { font-size: 12px; fill: var(--text-muted); }
  .atp11-cm .td { font-size: 13px; fill: var(--text); }
  .atp11-cm .warn { font-size: 12.5px; fill: var(--text); }
  .atp11-cm .grp { stroke-width: 1.2; }
  .atp11-cm .g-a { fill: var(--gold-tint-bg); stroke: var(--gold-icon); }
  .atp11-cm .g-b { fill: var(--bg-alt); stroke: var(--act-3); }
  .atp11-cm .e { stroke: var(--text-muted); stroke-width: 1.4; }
  .atp11-cm .n { fill: var(--bg); stroke: var(--text); stroke-width: 1.4; }
  .atp11-cm .row { fill: var(--bg-alt); stroke: var(--border); }
  .atp11-cm .row.hi { fill: var(--gold-tint-bg); stroke: var(--gold-icon); }
  .atp11-cm figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
