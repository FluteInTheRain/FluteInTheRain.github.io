  .bep2j .f { fill: var(--text-faint); font-size: 12px; }
  .bep2j .r { fill: var(--red); font-weight: 700; }
  .bep2j .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep2j .boxr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bep2j .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep2j .lnr { stroke: var(--red); stroke-width: 1.5; fill: none; }
  .bep2j .d { stroke-dasharray: 5 4; }
  .bep2j .hd { fill: var(--text-muted); }
  .bep2j .hdr { fill: var(--red); }
  .bep2j .xr { stroke: var(--red); stroke-width: 2.2; fill: none; }
  .bep2j .ok { stroke: var(--text-muted); stroke-width: 2.2; fill: none; }
  .bep2j .band { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep2j .bandr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bep2j .dot { fill: var(--text-muted); }
  .bep2j .dotr { fill: var(--red); }
  .bep2j figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
