---
// Same stock, same score, two baselines. Python run (exact Shapley, model "both", stock D):
// all 8 background stocks: base -0.066, contributions [0.549, 0.178, 0.446, 0.016, 0.417]
// 4 lowest-volatility background stocks: base 0.376, contributions [0.534, 0.148, 0.249, -0.159, 0.392]
// Both sum to the score 1.540.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 400;
const feats = [
  { en: '12-month momentum', vi: 'Momentum 12 tháng', all: 0.549, low: 0.534 },
  { en: '6-month momentum', vi: 'Momentum 6 tháng', all: 0.178, low: 0.148 },
  { en: 'value', vi: 'value', all: 0.446, low: 0.249 },
  { en: 'volatility', vi: 'biến động', all: 0.016, low: -0.159 },
  { en: 'size', vi: 'quy mô', all: 0.417, low: 0.392 },
];
const X0 = 520, S = 330;
const f = (n: number) => (n >= 0 ? '+' : '-') + Math.abs(n).toFixed(3);
const fv = (n: number) => f(n).replace('.', ',');
---
<figure class="atp09-bl">
  <div class="atp09-bl-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Stock D explained against two baselines. Against all 8 stocks the average score is -0.066 and volatility adds 0.016. Against only the 4 lowest-volatility stocks the average is 0.376 and volatility subtracts 0.159. The score of 1.540 is the same in both.">
      <text x="20" y="26" class="h">
        <tspan data-lang-en>Same stock, same score, two different baselines</tspan>
        <tspan data-lang-vi>Cùng cổ phiếu, cùng điểm, hai mốc so sánh khác nhau</tspan>
      </text>

      <rect x="20" y="44" width="860" height="40" rx="6" class="head" />
      <DiagramIcon name="scale" x={44} y={64} size={22} />
      <text x="70" y="69" class="sb">
        <tspan data-lang-en>Baseline = average score of the comparison stocks</tspan>
        <tspan data-lang-vi>Mốc so sánh = điểm trung bình của nhóm cổ phiếu đối chứng</tspan>
      </text>

      <line x1={X0} x2={X0} y1="100" y2="316" class="zero" />
      {feats.map((r, i) => {
        const y = 108 + i * 42;
        return (
          <g>
            <text x="20" y={y + 22} class="lab">
              <tspan data-lang-en>{r.en}</tspan>
              <tspan data-lang-vi>{r.vi}</tspan>
            </text>
            <rect x={r.all >= 0 ? X0 : X0 + r.all * S} y={y + 2} width={Math.max(2, Math.abs(r.all) * S)} height="14" class="bar is-all" />
            <rect x={r.low >= 0 ? X0 : X0 + r.low * S} y={y + 19} width={Math.max(2, Math.abs(r.low) * S)} height="14" class="bar is-low" />
            <text x={X0 + Math.max(r.all, 0) * S + 8} y={y + 14} class="val is-all">
              <tspan data-lang-en>{f(r.all)}</tspan>
              <tspan data-lang-vi>{fv(r.all)}</tspan>
            </text>
            <text x={r.low >= 0 ? X0 + r.low * S + 8 : X0 + 8} y={y + 31} class={r.low < 0 ? 'val is-neg' : 'val is-low'}>
              <tspan data-lang-en>{f(r.low)}</tspan>
              <tspan data-lang-vi>{fv(r.low)}</tspan>
            </text>
          </g>
        );
      })}

      <rect x="20" y="326" width="14" height="14" class="bar is-all" />
      <text x="42" y="338" class="leg">
        <tspan data-lang-en>all 8 stocks: average -0.066</tspan>
        <tspan data-lang-vi>cả 8 cổ phiếu: trung bình -0,066</tspan>
      </text>
      <rect x="330" y="326" width="14" height="14" class="bar is-low" />
      <text x="352" y="338" class="leg">
        <tspan data-lang-en>4 lowest-volatility stocks: average 0.376</tspan>
        <tspan data-lang-vi>4 cổ phiếu biến động thấp nhất: trung bình 0,376</tspan>
      </text>
      <text x="20" y="372" class="n">
        <tspan data-lang-en>D's score is 1.540 either way. Against calm stocks, D's volatility counts against it (-0.159); against the whole group it is neutral.</tspan>
        <tspan data-lang-vi>Điểm của D vẫn là 1,540. So với nhóm ít biến động, độ biến động của D bị tính là điểm trừ (-0,159); so với cả nhóm thì gần như trung tính.</tspan>
      </text>
    </svg>
  </div>
</figure>

<style>
  .atp09-bl { margin: 2em 0; width: 100%; }
  .atp09-bl-scroll { overflow-x: auto; }
  .atp09-bl svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .atp09-bl text { fill: var(--text-body); font-size: 14px; }
  .atp09-bl .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp09-bl .sb { font-size: 13.5px; font-weight: 600; fill: var(--text); }
  .atp09-bl .lab { fill: var(--text); }
  .atp09-bl .val { font-size: 12.5px; font-weight: 700; }
  .atp09-bl .val.is-all { fill: var(--text-muted); }
  .atp09-bl .val.is-low { fill: var(--gold-icon); }
  .atp09-bl .val.is-neg { fill: var(--red); }
  .atp09-bl .leg { font-size: 13px; fill: var(--text); }
  .atp09-bl .n { font-size: 13px; fill: var(--text-muted); }
  .atp09-bl .head { fill: var(--bg-alt); stroke: var(--border); }
  .atp09-bl .zero { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .atp09-bl .bar.is-all { fill: var(--text-faint); }
  .atp09-bl .bar.is-low { fill: var(--gold); }
</style>
