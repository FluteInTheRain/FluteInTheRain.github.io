---
import EncodingStepCards from './EncodingStepCards.astro';
const props = {
 "arrows": true,
 "title": {
  "en": "What happens inside pickle.loads",
  "vi": "Chuyện gì xảy ra bên trong pickle.loads"
 },
 "alt": "Four steps of a pickle attack: a sender builds bytes whose __reduce__ names any function to call; 97 bytes arrive over the network; the receiver calls pickle.loads, which follows the recipe and calls the function; the code has already run before any object is returned, and with os.system that is a shell command on the receiver's machine.",
 "cards": [
  {
   "icon": "user",
   "head": {
    "en": [
     "1. Sender builds bytes"
    ],
    "vi": [
     "1. Bên gửi dựng byte"
    ]
   },
   "lines": {
    "en": [
     "The object's __reduce__",
     "names any function",
     "to call."
    ],
    "vi": [
     "__reduce__ của object",
     "chỉ tên một hàm bất",
     "kỳ để gọi."
    ]
   },
   "tone": "plain"
  },
  {
   "icon": "network",
   "head": {
    "en": [
     "2. Bytes arrive"
    ],
    "vi": [
     "2. Byte đến nơi"
    ]
   },
   "lines": {
    "en": [
     "97 bytes cross the",
     "network (the size of the",
     "demo payload)."
    ],
    "vi": [
     "97 byte đi qua mạng",
     "(đúng cỡ payload",
     "của đoạn demo)."
    ]
   },
   "tone": "plain"
  },
  {
   "icon": "worker",
   "head": {
    "en": [
     "3. You call loads()"
    ],
    "vi": [
     "3. Bạn gọi loads()"
    ]
   },
   "lines": {
    "en": [
     "pickle follows the recipe",
     "and calls that function."
    ],
    "vi": [
     "pickle làm theo công thức",
     "và gọi hàm đó."
    ]
   },
   "tone": "plain"
  },
  {
   "icon": "warning",
   "head": {
    "en": [
     "4. Code has run"
    ],
    "vi": [
     "4. Code đã chạy"
    ]
   },
   "lines": {
    "en": [
     "Before you see any object.",
     "With os.system: a shell",
     "command on your machine."
    ],
    "vi": [
     "Trước khi bạn thấy object.",
     "Với os.system: một lệnh",
     "shell trên máy bạn."
    ]
   },
   "tone": "bad"
  }
 ],
 "caption": {
  "en": "The recipe is chosen by whoever wrote the bytes. Step 4 happens inside loads, so there is no moment to check first.",
  "vi": "Công thức do người ghi byte chọn. Bước 4 xảy ra ngay trong loads, nên không có lúc nào để kiểm tra trước."
 }
};
---
<EncodingStepCards {...props} />
