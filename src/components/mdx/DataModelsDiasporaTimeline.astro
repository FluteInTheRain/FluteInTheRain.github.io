---
import DiagramIcon from './DiagramIcon.astro';
// Diaspora's story as Sarah Mei tells it: Kickstarter, MongoDB, complaints, the move to MySQL, and the size of the migration.
// Arrowheads are polygons: no SVG ids.
const W = 900;
const H = 336;
type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}
const frames: any[] = [];
const boxes: any[] = [];
const links: any[] = [];
const labels: any[] = [];
const nums: any[] = [];
const row = [
  { en: ['2010', 'Four students ask', 'for $10,000 to build', 'an open alternative', 'to Facebook'], vi: ['2010', '4 sinh viên xin', '10.000 USD để dựng', 'một bản thay thế mở', 'cho Facebook'], icon: 'users' },
  { en: ['Kickstarter', 'Raised over $200,000', 'from about 6,400', 'people'], vi: ['Kickstarter', 'Gọi được hơn 200.000', 'USD từ khoảng', '6.400 người'], icon: 'money' },
  { en: ['Built on Rails', 'and MongoDB', 'A feed looks nested,', 'so a document fits'], vi: ['Dựng trên Rails', 'và MongoDB', 'Feed trông lồng nhau,', 'nên document có vẻ hợp'], icon: 'mongodb' },
  { en: ['About six months in', 'A lot of user', 'complaints show the', 'fit was wrong'], vi: ['Sau khoảng sáu tháng', 'người dùng phàn nàn', 'rất nhiều, cho thấy', 'chọn sai model'], icon: 'warning', kind: 'bad' },
  { en: ['The move to MySQL', 'Sarah Mei writes it', 'up in 2013', ''], vi: ['Chuyển sang MySQL', 'Sarah Mei viết lại', 'câu chuyện năm 2013', ''], icon: 'mysql', kind: 'good' },
];
row.forEach((r, i) => {
  boxes.push({ x: 10 + i * 178, y: 14, w: 164, h: 150, top: true, ...r });
  if (i < 4) links.push({ pts: [[10 + i * 178 + 164, 89], [10 + (i + 1) * 178, 89]] });
});
frames.push({ x: 10, y: 192, w: 880, h: 130 });
labels.push({ x: 24, y: 214, en: "The migration, in Mei's numbers", vi: 'Cuộc migration, theo số liệu của Mei', cls: 'strong' });
links.push({ pts: [[812, 164], [812, 192]] });
boxes.push(
  { x: 24, y: 228, w: 270, h: 80, icon: 'db', en: ['Eight months of data', 'about 1.2 million rows', 'once it was in MySQL'], vi: ['Dữ liệu của tám tháng', 'khoảng 1,2 triệu dòng', 'khi đã nằm trong MySQL'] },
  { x: 316, y: 228, w: 270, h: 80, icon: 'users', en: ['Four pair-weeks', 'of work'], vi: ['Bốn pair-week', 'công việc'] },
  { x: 608, y: 228, w: 270, h: 80, icon: 'clock', en: ['About two hours', 'of downtime'], vi: ['Khoảng hai giờ', 'downtime'] },
);
---
<figure class="dmdt">
  <div class="dmdt-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Timeline of Diaspora. 2010: four students ask for 10,000 dollars on Kickstarter. They raise over 200,000 dollars from about 6,400 people. They build on Rails and MongoDB. About six months in, user complaints show the fit was wrong. Mei writes it up in 2013. The migration moved eight months of data, about 1.2 million rows in MySQL, took four pair-weeks and about two hours of downtime.">
    {frames.map((f) => (
      <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="6" class={`dmdt-frame ${f.kind ?? ''}`} />
    ))}
    {boxes.map((b) => {
      const n = Math.max(b.en.length, b.vi.length);
      const top = !!b.top;
      const cx = b.x + b.w / 2;
      const x0 = top ? cx : b.icon ? b.x + 46 : b.x + 14;
      const y0 = top ? b.y + (b.icon ? 56 : 24) : b.y + b.h / 2 - ((n - 1) * 17) / 2 + 4;
      return (
        <g class={`dmdt-box ${b.kind ?? ''}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
          {b.icon && <DiagramIcon name={b.icon} x={top ? cx : b.x + 24} y={top ? b.y + 24 : b.y + b.h / 2} size={b.is ?? 26} />}
          {Array.from({ length: n }).map((_, i) => (
            <text x={x0} y={y0 + i * 17} text-anchor={top ? 'middle' : 'start'} class={i === 0 && !b.flat ? 'dmdt-name' : 'dmdt-sub'}>
              <tspan data-lang-en>{b.en[i] ?? ''}</tspan>
              <tspan data-lang-vi>{b.vi[i] ?? ''}</tspan>
            </text>
          ))}
        </g>
      );
    })}
    {links.map((l) => {
      const a = arrow(l.pts);
      return (
        <g>
          <polyline points={l.plain ? l.pts.map((p) => p.join(',')).join(' ') : a.line} class={`dmdt-edge ${l.kind ?? ''}`} fill="none" />
          {!l.plain && <polygon points={a.head} class={`dmdt-head ${l.kind ?? ''}`} />}
        </g>
      );
    })}
    {labels.map((t) => (
      <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`dmdt-lab ${t.cls ?? ''}`}>
        <tspan data-lang-en>{t.en}</tspan>
        <tspan data-lang-vi>{t.vi ?? t.en}</tspan>
      </text>
    ))}
    {nums.map((n) => (
      <g class="dmdt-num">
        <circle cx={n.x} cy={n.y} r="11" />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.n}</text>
      </g>
    ))}

  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Read left to right: a plausible choice, six months of pain, then a move that cost real work. All numbers are from Sarah Mei's 2013 write-up.</span>
    <span data-lang-vi>Đọc từ trái sang phải: một lựa chọn nghe hợp lý, sáu tháng chịu khổ, rồi một cuộc chuyển tốn công thật. Mọi con số lấy từ bài viết năm 2013 của Sarah Mei.</span>
  </figcaption>
</figure>

<style>
  .dmdt { margin: 2em 0; width: 100%; }
  .dmdt-scroll { overflow-x: auto; }
  .dmdt svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dmdt text { font-size: 14px; fill: var(--text-body); }
  .dmdt .dmdt-name { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .dmdt .dmdt-sub { font-size: 12px; fill: var(--text-muted); }
  .dmdt .dmdt-lab { font-size: 13px; }
  .dmdt .dmdt-lab.h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dmdt .dmdt-lab.strong { font-weight: 700; fill: var(--text); }
  .dmdt .dmdt-lab.muted { fill: var(--text-muted); }
  .dmdt .dmdt-lab.bad { font-weight: 700; fill: var(--red); }
  .dmdt .dmdt-lab.good { font-weight: 700; fill: var(--text); }
  .dmdt .dmdt-lab.mono, .dmdt .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .dmdt-frame { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .dmdt-frame.bad { stroke: var(--red); }
  .dmdt-frame.good { stroke: var(--gold); }
  .dmdt-box rect { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmdt-box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dmdt-box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmdt-box.plain rect { fill: none; stroke: var(--border); }
  .dmdt-edge { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmdt-edge.bad { stroke: var(--red); }
  .dmdt-edge.good { stroke: var(--gold-icon); }
  .dmdt-head { fill: var(--text-muted); }
  .dmdt-head.bad { fill: var(--red); }
  .dmdt-head.good { fill: var(--gold-icon); }
  .dmdt-num circle { fill: var(--bg-alt); stroke: var(--text-muted); }
  .dmdt-num text { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dmdt figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
