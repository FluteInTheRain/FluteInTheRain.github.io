---
import DemoFrame from './DemoFrame.astro';
import GoSatisfyCheckerDemo from '../demos/GoSatisfyCheckerDemo.tsx';
---
<figure class="gsc-figure">
  <DemoFrame title="Which type satisfies which interface?" titleVi="Kiểu nào thỏa interface nào?">
    <GoSatisfyCheckerDemo client:visible />
  </DemoFrame>
  <figcaption>
    <span data-lang-en>Every message is the real Go 1.27.1 compiler output for that exact line. The table below the verdict shows all twelve cases at once.</span>
    <span data-lang-vi>Mỗi thông báo là output thật của compiler Go 1.27.1 cho đúng dòng đó. Bảng bên dưới kết luận cho thấy cả mười hai trường hợp cùng lúc.</span>
  </figcaption>
</figure>

<style is:global>
  .gsc-figure { margin: 2em 0; width: 100%; }
  .gsc-figure > .demo-frame { margin-bottom: 0; }
  .gsc-figure > figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  .gsc .sd-group > span { text-transform: none; letter-spacing: 0; font-size: 12px; font-weight: 600; }
  .gsc-code { margin: 0 0 12px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); font-family: var(--font-mono, ui-monospace, monospace); font-size: 12px; line-height: 1.55; color: var(--text-body); overflow-x: auto; white-space: pre; }
  .gsc-verdict { display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 12px; font-size: 13px; line-height: 1.5; color: var(--text-body); }
  .gsc-verdict b { font-size: 18px; line-height: 1.2; }
  .gsc-verdict code { font-size: 12px; overflow-wrap: anywhere; white-space: normal; }
  .gsc-verdict.is-ok { border-color: var(--gold); background: var(--gold-tint-bg); }
  .gsc-verdict.is-no { border-color: var(--red); background: var(--red-tint-bg); }
  .gsc-verdict.is-no b { color: var(--red); }
  .gsc-table { width: 100%; border-collapse: collapse; font-size: 12px; display: table; }
  .gsc-table th, .gsc-table td { padding: 5px 6px; border: 1px solid var(--border); text-align: center; }
  .gsc-table td.is-ok { background: var(--gold-tint-bg); color: var(--text); font-weight: 700; }
  .gsc-table td.is-no { color: var(--text-muted); }
  .gsc-table td.is-cur { outline: 2px solid var(--red); outline-offset: -2px; }
  @media (max-width: 520px) { .gsc-table { font-size: 11px; } .gsc-table th, .gsc-table td { padding: 4px 3px; } }
</style>
