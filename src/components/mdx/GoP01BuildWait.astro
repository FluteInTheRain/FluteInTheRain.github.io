---
// Icons: hourglass = the wait. Motion: fm-pulse on the red 45-minute bar.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 190;
const x0 = 60, x1 = 840;
const px = (m: number) => x0 + ((x1 - x0) * m) / 45;
const ticks = [0, 15, 30, 45];
---
<figure class="gp1a">
  <div class="gp1a-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A time axis from 0 to 45 minutes with one bar covering all 45 minutes: one major Google C++ binary build in 2007.">
    <text x="60" y="28" class="h"><tspan data-lang-en>One build of a major Google C++ binary, 2007</tspan><tspan data-lang-vi>Một lần build file nhị phân C++ lớn của Google, 2007</tspan></text>
    <rect x={x0} y="50" width={x1 - x0} height="34" rx="4" class="bad fm-pulse" />
    <DiagramIcon name="hourglass" x={x0 + 24} y={67} size={26} />
    <text x={x0 + 46} y="72" class="r"><tspan data-lang-en>45 minutes, even with a precursor distributed build system</tspan><tspan data-lang-vi>45 phút, dù đã dùng hệ build phân tán đời trước</tspan></text>
    <line x1={x0} x2={x1} y1="100" y2="100" class="axis" />
    {ticks.map((t) => (<g><line x1={px(t)} x2={px(t)} y1="100" y2="108" class="axis" /><text x={px(t)} y="126" text-anchor="middle" class="m">{t}</text></g>))}
    <text x={x1} y="148" text-anchor="end" class="m"><tspan data-lang-en>minutes</tspan><tspan data-lang-vi>phút</tspan></text>
    <text x={x0} y="172" class="t"><tspan data-lang-en>"The origin myth for Go states that it was during one of those 45 minute builds that Go was conceived."</tspan><tspan data-lang-vi>Theo giai thoại, Go được nghĩ ra ngay trong một lần chờ build 45 phút như thế.</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The 45 minutes and the quote are from Rob Pike's talk Go at Google. Pike traces the wait to how C++ handles dependencies.</span>
    <span data-lang-vi>Con số 45 phút và câu trích lấy từ bài nói Go at Google của Rob Pike. Ông truy nguyên nhân chờ lâu về cách C++ xử lý phụ thuộc.</span>
  </figcaption>
</figure>

<style>
  .gp1a { margin: 2em 0; width: 100%; }
  .gp1a-scroll { overflow-x: auto; }
  .gp1a svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp1a text { font-size: 14px; fill: var(--text-body); }
  .gp1a .t { font-weight: 700; fill: var(--text); }
  .gp1a .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp1a .m { fill: var(--text-muted); }
  .gp1a .r { fill: var(--red); font-weight: 700; }
  .gp1a .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp1a .grp { fill: none; stroke: var(--border); stroke-width: 1.5; }
  .gp1a .bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp1a .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .gp1a .lnd { stroke: var(--text-muted); stroke-width: 1.5; fill: none; stroke-dasharray: 4 4; }
  .gp1a .lnr { stroke: var(--red); stroke-width: 1.5; fill: none; stroke-dasharray: 5 4; }
  .gp1a .hd { fill: var(--text-muted); }
  .gp1a .hdr { fill: var(--red); }
  .gp1a .axis { stroke: var(--border); stroke-width: 1.5; }
  .gp1a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
