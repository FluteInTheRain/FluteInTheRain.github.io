---
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 8 * Math.cos(a - 0.45), y2 - 8 * Math.sin(a - 0.45)];
  const p2 = [x2 - 8 * Math.cos(a + 0.45), y2 - 8 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
---
<figure class="gp">
  <div class="gp-scroll">
  <svg viewBox="0 0 900 312" role="img" aria-label="Two timelines. With r.Context(), the handler returns, the context is canceled, and 50 ms later the background work sees context canceled. With context.WithoutCancel, the same background work sees nil.">
    {[
      { y: 0, titleEn: 'Using r.Context()', titleVi: 'Dùng r.Context()', bad: true,
        e2En: 'Handler returns: context is canceled', e2Vi: 'Handler return: context bị hủy',
        e3En: 'Background work sees: context canceled', e3Vi: 'Việc chạy nền thấy: context canceled' },
      { y: 164, titleEn: 'Using context.WithoutCancel(r.Context())', titleVi: 'Dùng context.WithoutCancel(r.Context())', bad: false,
        e2En: 'Handler returns: r.Context() is canceled, ctx is not', e2Vi: 'Handler return: r.Context() bị hủy, ctx thì không',
        e3En: 'Background work sees: <nil>', e3Vi: 'Việc chạy nền thấy: <nil>' },
    ].map((p) => (
      <g>
        <text x="20" y={p.y + 24} class="h"><tspan data-lang-en>{p.titleEn}</tspan><tspan data-lang-vi>{p.titleVi}</tspan></text>
        <line x1="40" x2="860" y1={p.y + 66} y2={p.y + 66} class="axis" />
        <circle cx="40" cy={p.y + 66} r="6" class="dot" />
        <circle cx="300" cy={p.y + 66} r="6" class={p.bad ? 'dot bad' : 'dot'} />
        <circle cx="860" cy={p.y + 66} r="6" class={p.bad ? 'dot bad' : 'dot'} />
        <text x="40" y={p.y + 94} class="strong"><tspan data-lang-en>Goroutine starts</tspan><tspan data-lang-vi>Goroutine bắt đầu</tspan></text>
        <text x="40" y={p.y + 114} class="muted"><tspan data-lang-en>and sleeps 50 ms</tspan><tspan data-lang-vi>và ngủ 50 ms</tspan></text>
        <text x="300" y={p.y + 94} class={p.bad ? 'red' : 'strong'}><tspan data-lang-en>{p.e2En}</tspan><tspan data-lang-vi>{p.e2Vi}</tspan></text>
        <text x="300" y={p.y + 114} class="muted"><tspan data-lang-en>after the response is written</tspan><tspan data-lang-vi>sau khi đã ghi response</tspan></text>
        <text x="860" y={p.y + 140} text-anchor="end" class={p.bad ? 'red' : 'strong'}><tspan data-lang-en>{p.e3En}</tspan><tspan data-lang-vi>{p.e3Vi}</tspan></text>
      </g>
    ))}
    <line x1="20" x2="880" y1="156" y2="156" class="rule" />
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Time runs left to right, not to scale. The only difference between the two runs is the one line that builds ctx.</span>
    <span data-lang-vi>Thời gian chạy từ trái sang phải, không theo tỉ lệ. Hai lần chạy chỉ khác nhau đúng một dòng tạo ctx.</span>
  </figcaption>
</figure>

<style>
  .gp { margin: 2em 0; width: 100%; }
  .gp-scroll { overflow-x: auto; }
  .gp svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp text { font-size: 14px; fill: var(--text-body); }
  .gp .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp .strong { font-weight: 700; fill: var(--text); }
  .gp .muted { fill: var(--text-muted); }
  .gp .red { fill: var(--red); font-weight: 700; }
  .gp .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp .box.bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp .bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp .bar.bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .gp .wait { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp .rule { stroke: var(--border); stroke-width: 1; }
  .gp .axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .gp .dot { fill: var(--text-muted); }
  .gp .dot.bad { fill: var(--red); }
  .gp .arrow path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp .arrow polygon { fill: var(--text-muted); }
  .gp .arrow.bad path { stroke: var(--red); }
  .gp .arrow.bad polygon { fill: var(--red); }
  .gp figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
