---
import DiagramIcon from './DiagramIcon.astro';
// Three sources feed one Settings object at import time (demo/p12_settings.py,
// demo/p12/k8s/config.yaml). The red path is the capture in the post: with
// CLUE_DATABASE_URL missing, Settings() raises and the process never starts.
const W = 900, H = 320;
const layers = [
  { y: 50, icon: 'file', en: 'defaults in code', vi: 'giá trị mặc định trong code', sub: { en: 'release = "dev", work_ms = 50', vi: 'release = "dev", work_ms = 50' } },
  { y: 130, icon: 'config', en: 'environment (ConfigMap)', vi: 'biến môi trường (ConfigMap)', sub: { en: 'CLUE_WORK_MS, CLUE_STARTUP_DELAY_S', vi: 'CLUE_WORK_MS, CLUE_STARTUP_DELAY_S' } },
  { y: 210, icon: 'key', en: 'secret (Secret)', vi: 'bí mật (Secret)', sub: { en: 'CLUE_DATABASE_URL, no default', vi: 'CLUE_DATABASE_URL, không có mặc định' } },
];
---
<figure class="bep12b">
  <div class="bep12b-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three sources of config, defaults in code, environment variables from a ConfigMap, and a secret, flow into one Settings object that is validated when the process starts. If every value is valid the service boots. If the required database url is missing, validation fails, the container exits and the rollout stops, drawn in red.">
    {layers.map((l, i) => (
      <g>
        <rect x="40" y={l.y} width="330" height="60" rx="8" class={i === 2 ? 'box key' : 'box'} />
        <DiagramIcon name={l.icon} x="72" y={l.y + 30} size={24} />
        <text x="104" y={l.y + 26} class="t"><tspan data-lang-en>{l.en}</tspan><tspan data-lang-vi>{l.vi}</tspan></text>
        <text x="104" y={l.y + 46} class="sm"><tspan data-lang-en>{l.sub.en}</tspan><tspan data-lang-vi>{l.sub.vi}</tspan></text>
        <polyline points={`370,${l.y + 30} 430,${l.y + 30} 430,140 456,140`} class="line" fill="none" />
      </g>
    ))}
    <polygon points="456,132 472,140 456,148" class="arrow" />
    <rect x="476" y="100" width="200" height="80" rx="8" class="box main" />
    <DiagramIcon name="config" x="510" y="140" size={26} />
    <text x="540" y="136" class="t"><tspan data-lang-en>Settings()</tspan><tspan data-lang-vi>Settings()</tspan></text>
    <text x="540" y="156" class="sm"><tspan data-lang-en>checked at import</tspan><tspan data-lang-vi>kiểm tra lúc import</tspan></text>
    <polyline points="676,128 712,128 712,70 744,70" class="line" fill="none" />
    <polygon points="744,62 760,70 744,78" class="arrow" />
    <polyline points="676,152 712,152 712,222 744,222" class="line red-l" fill="none" />
    <polygon points="744,214 760,222 744,230" class="arrow red-a" />
    <DiagramIcon name="ok" x="784" y="70" size={22} />
    <text x="808" y="66" class="t"><tspan data-lang-en>boots</tspan><tspan data-lang-vi>chạy lên</tspan></text>
    <text x="808" y="84" class="sm"><tspan data-lang-en>all valid</tspan><tspan data-lang-vi>đủ và hợp lệ</tspan></text>
    <DiagramIcon name="fail" x="784" y="222" size={22} />
    <text x="808" y="218" class="t red"><tspan data-lang-en>exits</tspan><tspan data-lang-vi>thoát ngay</tspan></text>
    <text x="808" y="236" class="sm red"><tspan data-lang-en>value missing</tspan><tspan data-lang-vi>thiếu giá trị</tspan></text>
    <text x="40" y="304" class="note"><tspan data-lang-en>a pod that exits never becomes ready</tspan><tspan data-lang-vi>pod đã thoát thì không bao giờ ready</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Config is read once, at boot, from outside the image. A missing required value stops the process before it can serve anything.</span>
    <span data-lang-vi>Config được đọc một lần lúc khởi động, từ bên ngoài image. Thiếu giá trị bắt buộc thì process dừng ngay, chưa kịp phục vụ gì.</span>
  </figcaption>
</figure>

<style>
  .bep12b { margin: 2em 0; width: 100%; }
  .bep12b-scroll { overflow-x: auto; }
  .bep12b svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .bep12b text { font-size: 14px; fill: var(--text-body); }
  .bep12b .t { font-weight: 700; fill: var(--text); }
  .bep12b .sm, .bep12b .note { fill: var(--text-muted); font-size: 13px; }
  .bep12b text.red { fill: var(--red); }
  .bep12b .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep12b .box.key { stroke: var(--red); stroke-width: 2; }
  .bep12b .box.main { stroke: var(--text-muted); stroke-width: 1.8; }
  .bep12b .line { stroke: var(--text-faint); stroke-width: 1.6; fill: none; }
  .bep12b .line.red-l { stroke: var(--red); stroke-width: 2.2; }
  .bep12b .arrow { fill: var(--text-faint); }
  .bep12b .arrow.red-a { fill: var(--red); }
  .bep12b figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
