---
// Four concrete accounting red flags beginners can spot in Minute 5 without deep CPA training.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 290;

const FLAGS = [
  {
    x: 20, y: 54, w: 420, h: 100,
    tEn: '1. Profit UP while CFO negative 4+ quarters',
    tVi: '1. Báo lãi liên tục nhưng CFO âm nhiều quý',
    dEn: 'Booked credit sales nobody ever pays back in cash',
    dVi: 'Bán chịu ghi doanh thu trên giấy nhưng khách không trả tiền',
  },
  {
    x: 460, y: 54, w: 420, h: 100,
    tEn: '2. Giant "Other Receivables" / cash advances',
    tVi: '2. "Phải thu khác" hoặc ủy thác đầu tư phình to',
    dEn: 'Cash quietly lent out to insiders or unlisted shell firms',
    dVi: 'Tiền công ty bị rút đi cho đối tác liên quan mượn mù mờ',
  },
  {
    x: 20, y: 170, w: 420, h: 100,
    tEn: '3. Qualified audit opinion or auditor exits',
    tVi: '3. Kiểm toán "Ngoại trừ" hoặc liên tục đổi kiểm toán',
    dEn: 'Auditors refused to sign clean numbers on key balances',
    dVi: 'Kiểm toán viên không dám xác nhận số dư khoản mục trọng yếu',
  },
  {
    x: 460, y: 170, w: 420, h: 100,
    tEn: '4. Big "Cash" next to sky-high short debt',
    tVi: '4. Vừa gửi nhiều tiền vừa vay ngắn hạn lãi cao ngất',
    dEn: 'Why pay 9% debt interest while holding idle cash?',
    dVi: 'Nếu có tiền mặt thật sao phải đi vay ngân hàng lãi cao?',
  },
] as const;
---
<figure class="sbp6-rf">
  <div class="sbp6-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four red flags on Vietnamese financial statements: persistent positive profit with negative CFO, huge Other Receivables, qualified audit opinion, and holding large idle cash alongside heavy expensive debt.">
      <text x="20" y="30" class="sbp6-title">
        <tspan data-lang-en>Minute 5 Footnote Smell Test: four red flags that scream "walk away"</tspan>
        <tspan data-lang-vi>Phút 5 Bốn mùi khét trên BCTC &amp; Thuyết minh báo hiệu nên tránh xa</tspan>
      </text>

      {FLAGS.map((f) => (
        <g>
          <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="10" class="sbp6-card-red" />
          <DiagramIcon name="warning" x={f.x + 26} y={f.y + 34} size={22} />
          <text x={f.x + 50} y={f.y + 38} class="sbp6-hdr sbp6-red">
            <tspan data-lang-en>{f.tEn}</tspan>
            <tspan data-lang-vi>{f.tVi}</tspan>
          </text>
          <text x={f.x + 18} y={f.y + 72} class="sbp6-body">
            <tspan data-lang-en>{f.dEn}</tspan>
            <tspan data-lang-vi>{f.dVi}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>With over 1,500 stocks listed across HOSE, HNX, and UPCoM, you never need to gamble on a statement that fails even one of these four basic smell tests.</span>
    <span data-lang-vi>Trên ba sàn Việt Nam có hơn 1.500 mã cổ phiếu: bạn không bao giờ cần đánh cược tiền tiết kiệm vào một BCTC dính dù chỉ một trong bốn mùi khét trên.</span>
  </figcaption>
</figure>

<style>
  .sbp6-rf { margin: 2em 0; width: 100%; }
  .sbp6-scroll { overflow-x: auto; }
  .sbp6-rf svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sbp6-rf text { font-size: 13px; fill: var(--text-body); }
  .sbp6-title { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sbp6-card-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .sbp6-hdr { font-size: 13.5px; font-weight: 700; }
  .sbp6-red { fill: var(--red); }
  .sbp6-body { font-size: 12.8px; fill: var(--text-body); }
  .sbp6-rf figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
