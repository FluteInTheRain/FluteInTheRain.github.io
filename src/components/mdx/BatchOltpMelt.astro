---
import BatchDiagram from './BatchDiagram.astro';
const boxes = [{"x": 20, "y": 46, "w": 220, "h": 64, "t": ["200 Spark tasks", "200 task Spark"], "s": [["INSERT row by row", "INSERT từng dòng"]], "icon": "spark"}, {"x": 330, "y": 46, "w": 240, "h": 64, "t": ["Connection pool", "Connection pool"], "s": [["no free connection left", "hết kết nối trống"]], "icon": "network", "kind": "hot"}, {"x": 660, "y": 46, "w": 220, "h": 64, "t": ["Production Postgres", "Postgres production"], "s": [["serving live traffic", "đang phục vụ khách"]], "icon": "postgres"}, {"x": 330, "y": 170, "w": 240, "h": 64, "t": ["Checkout and login", "Thanh toán và đăng nhập"], "s": [["wait in line, p99 spikes", "xếp hàng chờ, p99 tăng"]], "icon": "users", "kind": "hot"}];
const arrows = [{"x1": 240, "y1": 78, "x2": 330, "y2": 78, "kind": "hot"}, {"x1": 570, "y1": 78, "x2": 660, "y2": 78, "kind": "hot"}, {"x1": 450, "y1": 170, "x2": 450, "y2": 110, "label": ["stuck behind batch", "kẹt sau batch"], "kind": "hot", "lx": 540, "ly": 146}];
const texts = [{"x": 20, "y": 26, "cls": "h", "t": ["What happens when batch writes straight to OLTP", "Chuyện xảy ra khi batch ghi thẳng vào OLTP"]}, {"x": 20, "y": 276, "cls": "foot", "t": ["1. 200 tasks send writes at once and take every connection.", "1. 200 task gửi ghi cùng lúc và chiếm hết kết nối."]}, {"x": 20, "y": 300, "cls": "foot", "t": ["2. Live queries from real users queue behind them.", "2. Truy vấn thật của người dùng phải xếp hàng sau."]}, {"x": 20, "y": 324, "cls": "warn", "t": ["3. A task that retries repeats its INSERTs: duplicate or half-written rows.", "3. Task chạy lại sẽ lặp INSERT: dòng bị trùng hoặc ghi dở."]}];
---
<BatchDiagram
  w={900} h={350}
  aria="200 Spark tasks write row by row through one connection pool into production Postgres. Live checkout and login queries wait in the same pool, so p99 latency spikes, and a retried task repeats its inserts."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any} rules={[]} icons={[]}
  caption={["Three steps from a harmless-looking batch write to a slow checkout page.", "Ba bước từ một lệnh ghi batch tưởng vô hại tới trang thanh toán chậm."]}
/>
