---
// Cascading failure across two replicas behind a load balancer. Three steps, schematic.
const steps = [
  { x: 20, a: 'ok', b: 'ok', la: '50%', lb: '50%', en: 'Normal: load is shared', vi: 'Bình thường: tải chia đều' },
  { x: 310, a: 'down', b: 'hot', la: '', lb: '100%', en: 'A crashes: B takes all the traffic', vi: 'A chết: B gánh toàn bộ tải' },
  { x: 600, a: 'down', b: 'down', la: '', lb: '', en: 'B overloads and crashes: outage', vi: 'B quá tải rồi chết: sập hệ thống' },
];
const W = 900;
const H = 250;
const cls = (s: string) => `nfr-casc-node is-${s}`;
---
<figure class="casc">
  <div class="casc-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Cascading failure in three steps: two replicas share the load; replica A crashes and replica B receives all traffic; B is overloaded and crashes too, so the service is down.">
      {steps.map((s, i) => (
        <g>
          <text x={s.x} y="26" class="casc-h">
            <tspan data-lang-en>{s.en}</tspan>
            <tspan data-lang-vi>{s.vi}</tspan>
          </text>
          <rect x={s.x + 85} y="52" width="90" height="34" rx="5" class="casc-lb" />
          <text x={s.x + 130} y="74" text-anchor="middle" class="casc-n">
            <tspan data-lang-en>Load balancer</tspan>
            <tspan data-lang-vi>Load balancer</tspan>
          </text>
          <line x1={s.x + 105} y1="86" x2={s.x + 55} y2="150" class={s.a === 'down' ? 'casc-edge is-off' : 'casc-edge'} />
          <line x1={s.x + 155} y1="86" x2={s.x + 205} y2="150" class={s.b === 'down' && s.lb === '' ? 'casc-edge is-off' : s.lb === '100%' ? 'casc-edge is-heavy' : 'casc-edge'} />
          <rect x={s.x + 10} y="150" width="90" height="46" rx="5" class={cls(s.a)} />
          <text x={s.x + 55} y="178" text-anchor="middle" class="casc-n">Replica A</text>
          <rect x={s.x + 160} y="150" width="90" height="46" rx="5" class={cls(s.b)} />
          <text x={s.x + 205} y="178" text-anchor="middle" class="casc-n">Replica B</text>
          {s.la && <text x={s.x + 52} y="124" text-anchor="end" class="casc-pct">{s.la}</text>}
          {s.lb && <text x={s.x + 212} y="124" class="casc-pct">{s.lb}</text>}
          {s.a === 'down' && (
            <text x={s.x + 55} y="218" text-anchor="middle" class="casc-note">
              <tspan data-lang-en>down</tspan>
              <tspan data-lang-vi>đã chết</tspan>
            </text>
          )}
          {s.b === 'down' && (
            <text x={s.x + 205} y="218" text-anchor="middle" class="casc-note">
              <tspan data-lang-en>down</tspan>
              <tspan data-lang-vi>đã chết</tspan>
            </text>
          )}
          {i < 2 && <path d={`M ${s.x + 262} 173 L ${s.x + 296} 173`} class="casc-next" />}
        </g>
      ))}
    </svg>
  </div>
</figure>

<style>
  .casc { margin: 2em 0; width: 100%; }
  .casc-scroll { overflow-x: auto; }
  .casc svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .casc text { font-size: 13px; fill: var(--text-body); }
  .casc .casc-h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .casc .casc-pct { font-size: 13px; font-weight: 700; fill: var(--text); font-variant-numeric: tabular-nums; }
  .casc .casc-note { fill: var(--red); font-weight: 700; }
  .casc-lb { fill: var(--bg-alt); stroke: var(--border); }
  .casc-edge { stroke: var(--text-muted); stroke-width: 1.8; }
  .casc-edge.is-heavy { stroke: var(--red); stroke-width: 4; }
  .casc-edge.is-off { stroke: var(--border); stroke-dasharray: 3 4; }
  .casc-next { stroke: var(--text-muted); stroke-width: 1.5; fill: none; stroke-dasharray: 2 3; }
  .nfr-casc-node { stroke-width: 1.2; }
  .nfr-casc-node.is-ok { fill: var(--bg-alt); stroke: var(--text-muted); }
  .nfr-casc-node.is-hot { fill: var(--red-tint-bg); stroke: var(--red); }
  .nfr-casc-node.is-down { fill: var(--red-tint-bg); stroke: var(--red); stroke-dasharray: 4 3; }
</style>
