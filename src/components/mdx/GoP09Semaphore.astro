---
// sem := make(chan struct{}, 3), 8 tasks, each sleeps 100 ms. Three slots, three waves (3 + 3 + 2).
// Which task lands in which slot changes every run; the numbers below follow the order in the shown output.
import DiagramIcon from './DiagramIcon.astro';
// Icons: key = a slot (a permit in sem), gopher = a task goroutine. Motion: fm-bob on the goroutines that hold a slot at 0 ms.
const x0 = 120;
const k = 2;
const X = (ms: number) => x0 + ms * k;
const laneY = (i: number) => 52 + i * 46;
const bh = 34;
const waves = [
  [8, 4, 1],
  [2, 3, 6],
  [5, 7],
];
const axisY = laneY(3) - 6;
const W = 900;
const H = axisY + 40;
---
<figure class="gp09sem">
  <div class="gp09sem-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three slots over time. Eight tasks of 100 ms each run in three waves of 3, 3 and 2 tasks, so the program takes about 300 ms.">
    <text x="20" y="24" class="gp09sem-h">
      <tspan data-lang-en>All 8 goroutines exist at 0 ms; 3 hold a slot, 5 wait at sem &lt;-</tspan>
      <tspan data-lang-vi>Cả 8 goroutine đã có từ 0 ms; 3 cái giữ slot, 5 cái chờ ở sem &lt;-</tspan>
    </text>
    {[0, 1, 2].map((s) => (
      <g>
        <DiagramIcon name="key" x={32} y={laneY(s) + 17} size={24} />
        <text x="52" y={laneY(s) + 22} class="gp09sem-name">
          <tspan data-lang-en>slot {s + 1}</tspan>
          <tspan data-lang-vi>slot {s + 1}</tspan>
        </text>
        {waves.map((w, wi) => w[s] !== undefined && (
          <g>
            <rect x={X(wi * 100) + 1} y={laneY(s)} width={98 * k} height={bh} rx="4" class="gp09sem-bar" />
            <g class={wi === 0 ? 'fm-bob' : undefined}><DiagramIcon name="gopher" x={X(wi * 100) + 22} y={laneY(s) + 17} size={24} /></g>
            <text x={X(wi * 100) + 42} y={laneY(s) + 22} class="gp09sem-onbar">task {w[s]}</text>
          </g>
        ))}
      </g>
    ))}
    <line x1={x0} x2={X(300)} y1={axisY} y2={axisY} class="gp09sem-rule" />
    {[0, 100, 200, 300].map((ms) => (
      <g>
        <line x1={X(ms)} x2={X(ms)} y1={axisY} y2={axisY + 5} class="gp09sem-rule" />
        <text x={X(ms)} y={axisY + 24} text-anchor="middle" class="gp09sem-muted">{ms} ms</text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Each task holds its slot for the 100 ms sleep, then &lt;-sem gives it back and a waiting task takes it. The task numbers follow the order in the output above, but the order differs on every run.</span>
    <span data-lang-vi>Mỗi task giữ slot trong 100 ms ngủ, rồi &lt;-sem trả slot lại và một task đang chờ lấy nó. Số task theo thứ tự trong output ở trên, nhưng thứ tự khác nhau mỗi lần chạy.</span>
  </figcaption>
</figure>

<style>
  .gp09sem { margin: 2em 0; width: 100%; }
  .gp09sem-scroll { overflow-x: auto; }
  .gp09sem svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp09sem text { font-size: 14px; fill: var(--text-body); }
  .gp09sem .gp09sem-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp09sem .gp09sem-name { font-weight: 700; fill: var(--text); }
  .gp09sem .gp09sem-bad { fill: var(--red); font-weight: 700; }
  .gp09sem .gp09sem-muted { fill: var(--text-muted); }
  .gp09sem-rule { stroke: var(--border); }
  .gp09sem figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  .gp09sem-bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp09sem .gp09sem-onbar { fill: var(--text); font-weight: 600; }
</style>
