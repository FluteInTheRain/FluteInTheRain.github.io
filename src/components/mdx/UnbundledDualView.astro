---
// Two derived views fed by one log; a router shifts traffic from the old to the new view.
// Plain inline SVG with site CSS tokens; polygon arrowheads avoid duplicate marker ids.
const W = 900;
const H = 330;

type Box = { x: number; y: number; w: number; h: number; en: string; vi: string; sen?: string; svi?: string; hot?: boolean };
const boxes: Box[] = [{"x": 20, "y": 50, "w": 170, "h": 230, "en": "Event log", "vi": "Log sự kiện", "sen": "retained history", "svi": "lịch sử được giữ lại"}, {"x": 300, "y": 50, "w": 210, "h": 64, "en": "Old view", "vi": "Khung nhìn cũ", "sen": "current schema", "svi": "schema hiện tại"}, {"x": 300, "y": 216, "w": 210, "h": 64, "en": "New view", "vi": "Khung nhìn mới", "sen": "replayed from offset 0", "svi": "chạy lại từ offset 0", "hot": true}, {"x": 620, "y": 50, "w": 130, "h": 230, "en": "Router", "vi": "Bộ định tuyến", "sen": "by user", "svi": "theo người dùng"}, {"x": 780, "y": 50, "w": 100, "h": 230, "en": "Users", "vi": "Người dùng"}];
// [x1, y, x2, dashed, hot]
const arrows: [number, number, number, boolean, boolean][] = [[190, 82, 300, false, false], [190, 248, 300, false, true], [510, 82, 620, false, false], [510, 248, 620, false, true], [750, 165, 780, false, false]];
// [x, y, en, vi, anchor, hot]
const notes: [number, number, string, string, string, boolean][] = [[20, 306, "Raise the new view's share step by step; drop the old view once it serves everyone. Each step can be undone by flipping the router back.", "Tăng dần tỉ lệ khung nhìn mới; tắt khung nhìn cũ khi nó phục vụ toàn bộ. Mỗi bước đều quay lại được bằng cách chuyển router về.", "start", false], [610, 72, "99%", "99%", "end", false], [610, 270, "1%, then more", "1%, tăng dần", "end", true]];
const heads = (x2: number, y: number) => `${x2 - 8},${y - 4.5} ${x2 - 8},${y + 4.5} ${x2},${y}`;
---
<figure class="unb-fig">
  <div class="unb-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="One event log feeds an old and a new derived view; a router sends most users to the old view and a small share to the new one.">
      <text x="20" y="26" class="unb-h"><tspan data-lang-en>Two views, one log</tspan><tspan data-lang-vi>Hai khung nhìn, một log</tspan></text>

      {boxes.map((b) => (
        <>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" class={b.hot ? 'unb-box is-hot' : 'unb-box'} />
          <text x={b.x + b.w / 2} y={b.y + (b.sen ? b.h / 2 - 3 : b.h / 2 + 5)} text-anchor="middle" class="unb-in-b"><tspan data-lang-en>{b.en}</tspan><tspan data-lang-vi>{b.vi}</tspan></text>
          {b.sen && <text x={b.x + b.w / 2} y={b.y + b.h / 2 + 15} text-anchor="middle" class="unb-in-m"><tspan data-lang-en>{b.sen}</tspan><tspan data-lang-vi>{b.svi}</tspan></text>}
        </>
      ))}
      {arrows.map(([x1, y, x2, dashed, hot]) => (
        <>
          <path d={`M${x1},${y} L${x2 - 7},${y}`} class={`${dashed ? 'unb-dashed' : 'unb-solid'}${hot ? ' is-hot' : ''}`} />
          <polygon points={heads(x2, y)} class={hot ? 'unb-head is-hot' : 'unb-head'} />
        </>
      ))}
      {notes.map(([x, y, en, vi, anchor, hot]) => (
        <text x={x} y={y} text-anchor={anchor} class={hot ? 'unb-note is-hot' : 'unb-note'}><tspan data-lang-en>{en}</tspan><tspan data-lang-vi>{vi}</tspan></text>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Like dual-gauge track, both views run off the same log until the new one is trusted. Percentages are illustrative.</span>
    <span data-lang-vi>Giống đường ray khổ kép, cả hai khung nhìn cùng chạy từ một log cho tới khi tin tưởng khung nhìn mới. Tỉ lệ phần trăm chỉ để minh hoạ.</span>
  </figcaption>
</figure>

<style>
  .unb-fig {
    margin: 2em 0;
    width: 100%;
  }
  .unb-scroll {
    overflow-x: auto;
  }
  .unb-fig svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .unb-fig text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .unb-fig .unb-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .unb-fig .unb-sub {
    font-size: 13.5px;
    fill: var(--text-muted);
  }
  .unb-fig .unb-lane-h {
    font-size: 14.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .unb-fig .unb-lane-sub {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .unb-rule {
    stroke: var(--border);
  }
  .unb-box {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .unb-box.is-hot {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.6;
  }
  .unb-fig .unb-in-b {
    font-weight: 700;
    fill: var(--text);
    font-size: 13.5px;
  }
  .unb-fig .unb-in-m {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .unb-boundary {
    stroke: var(--red);
    stroke-width: 1.6;
    stroke-dasharray: 5 4;
  }
  .unb-fig .unb-boundary-lbl {
    font-size: 12.5px;
    font-weight: 700;
    fill: var(--red);
  }
  .unb-solid {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.8;
  }
  .unb-solid.is-hot {
    stroke: var(--red);
    stroke-width: 2;
  }
  .unb-dashed {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.4;
    stroke-dasharray: 5 4;
  }
  .unb-head {
    fill: var(--text-muted);
  }
  .unb-head.is-hot {
    fill: var(--red);
  }
  .unb-fig figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
  .unb-fig .unb-note { font-size: 13px; fill: var(--text-muted); }
  .unb-fig .unb-note.is-hot { fill: var(--red); font-weight: 700; }
</style>
