---
// A Kafka-style partition: an append-only log with integer offsets. Three consumer groups hold
// independent read positions, and a new group can start from an old offset to replay history.
// Plain inline SVG, site CSS tokens (no SVG ids). Labels come from the lang prop.
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const W = 900, H = 330;
const T = {
  en: {
    h: 'One partition: an append-only log, many independent readers',
    next: 'next write',
    billing: 'Billing group: read up to 8', search: 'Search group: read up to 5', replay: 'New group: replays from 2',
    note: 'Reading never removes a record. Each group only remembers one number: its offset.',
    alt: 'A partition drawn as nine records with offsets 0 to 8 and an empty slot for the next write. Three consumer groups point at different offsets: billing at 8, search at 5, and a new replay group at 2.',
    cap: 'Every group tracks its own offset in the same log, so a slow reader never blocks a fast one and a fixed consumer can start over from an older offset.',
  },
  vi: {
    h: 'Một partition: log chỉ nối thêm, nhiều bên đọc độc lập',
    next: 'ghi tiếp',
    billing: 'Nhóm billing: đã đọc tới 8', search: 'Nhóm search: đã đọc tới 5', replay: 'Nhóm mới: phát lại từ 2',
    note: 'Đọc không làm mất bản ghi. Mỗi nhóm chỉ nhớ một con số: offset của mình.',
    alt: 'Một partition vẽ thành chín bản ghi với offset từ 0 đến 8 và một ô trống cho lần ghi tiếp theo. Ba nhóm consumer trỏ vào các offset khác nhau: billing ở 8, search ở 5 và một nhóm phát lại mới ở 2.',
    cap: 'Mỗi nhóm giữ offset riêng trên cùng một log, nên bên đọc chậm không cản bên đọc nhanh và consumer đã sửa lỗi có thể bắt đầu lại từ offset cũ.',
  },
}[lang];
const x0 = 40, cw = 72, cy = 60, ch = 44;
const cx = (i: number) => x0 + i * cw + cw / 2;
const groups = [
  { off: 8, label: T.billing, y: 256 },
  { off: 5, label: T.search, y: 206 },
  { off: 2, label: T.replay, y: 156 },
];
---
<figure class="slp">
  <div class="slp-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={T.alt}>
    <text x="20" y="28" class="h">{T.h}</text>
    {Array.from({ length: 9 }, (_, i) => (
      <g class="box">
        <rect x={x0 + i * cw} y={cy} width={cw - 6} height={ch} rx="5" />
        <text x={cx(i) - 3} y={cy + 27} text-anchor="middle" class="name">e{i}</text>
        <text x={cx(i) - 3} y={cy + ch + 20} text-anchor="middle" class="num">{i}</text>
      </g>
    ))}
    <g class="box dash">
      <rect x={x0 + 9 * cw} y={cy} width={cw - 6} height={ch} rx="5" />
    </g>
    <text x={x0 + 9 * cw + (cw - 6) / 2} y={cy + 27} text-anchor="middle" class="sub">{T.next}</text>
    {groups.map((g) => (
      <g>
        <line x1={cx(g.off) - 3} x2={cx(g.off) - 3} y1={cy + ch + 30} y2={g.y - 18} class="ptr" />
        <polygon points={`${cx(g.off) - 3},${cy + ch + 28} ${cx(g.off) - 8},${cy + ch + 38} ${cx(g.off) + 2},${cy + ch + 38}`} class="tip" />
        <text x={cx(g.off) - 3} y={g.y} text-anchor="middle" class="name">{g.label}</text>
      </g>
    ))}
    <text x={W / 2} y="312" text-anchor="middle" class="sub">{T.note}</text>
  </svg>
  </div>
  <figcaption>{T.cap}</figcaption>
</figure>

<style>
  .slp { margin: 2em 0; width: 100%; }
  .slp-scroll { overflow-x: auto; }
  .slp svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .slp text { font-size: 14px; fill: var(--text-body); }
  .slp .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .slp .name { font-weight: 700; fill: var(--text); }
  .slp .sub { font-size: 13px; fill: var(--text-muted); font-variant-numeric: tabular-nums; }
  .slp .bad { font-size: 13px; fill: var(--red); }
  .slp .num { font-size: 13px; font-weight: 700; fill: var(--text); font-variant-numeric: tabular-nums; }
  .slp .box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .slp .box.off rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .slp .box.dash rect { stroke-dasharray: 4 4; fill: none; }
  .slp .arr path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .slp .arr polygon { fill: var(--text-muted); }
  .slp .arr.bad path { stroke: var(--red); stroke-dasharray: 5 4; }
  .slp .arr.bad polygon { fill: var(--red); }
  .slp .rule { stroke: var(--border); stroke-width: 1; }
  .slp figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
  .slp .ptr { stroke: var(--text-muted); stroke-width: 1.5; }
  .slp .tip { fill: var(--text-muted); }
</style>
