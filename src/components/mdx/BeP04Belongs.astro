---
// What lives in each of the three layers — the reference card. The service
// column is red: that is the layer the reader owns, the only home of the
// business meaning (both neighbours explicitly say "never" it).
const W = 900, H = 330;
const cols = [
  {
    x: 30, icon: 'fastapi', iconW: 62, iconH: 11.5, disc: false, red: false,
    name: { en: 'web', vi: 'web' },
    lives: [
      { en: 'parse the request', vi: 'parse request' },
      { en: 'validate the shape', vi: 'validate hình dạng' },
      { en: 'map errors to status codes', vi: 'đổi lỗi thành status code' },
      { en: 'shape the JSON response', vi: 'định hình JSON trả về' },
    ],
    never: { en: 'never: what closing a case means', vi: 'không bao giờ: luật đóng case' },
  },
  {
    x: 320, icon: 'engine', iconW: 22, iconH: 22, disc: false, red: true,
    name: { en: 'service', vi: 'service' },
    lives: [
      { en: 'the workflow: open → assign → close', vi: 'luồng việc: open → assign → close' },
      { en: 'which moves the rules refuse', vi: 'nước đi nào bị luật chặn' },
      { en: 'ids the client never picks', vi: 'id client không được tự chọn' },
      { en: 'one place for a new rule', vi: 'một chỗ để thêm luật mới' },
    ],
    never: { en: 'never: HTTP status codes', vi: 'không bao giờ: status code HTTP' },
  },
  {
    x: 610, icon: 'database', iconW: 22, iconH: 22, disc: true, red: false,
    name: { en: 'data', vi: 'data' },
    lives: [
      { en: 'where records live', vi: 'record nằm ở đâu' },
      { en: 'how they are written back', vi: 'ghi lại như thế nào' },
      { en: 'today: one in-memory dict', vi: 'hôm nay: một dict trong bộ nhớ' },
      { en: 'later: a real database', vi: 'sau này: database thật' },
    ],
    never: { en: 'never: what closing a case means', vi: 'không bao giờ: luật đóng case' },
  },
];
---
<figure class="bep4b">
  <div class="bep4b-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three columns — web, service, data — each with an icon, a list of what lives there, and one line naming what never lives there. The service column is outlined in red.">
    {cols.map((c) => (
      <g>
        <rect x={c.x} y="34" width="260" height="252" rx="10" class={c.red ? 'box red' : 'box'} />
        {c.disc && <circle cx={c.x + 130} cy="62" r="16" class="disc" />}
        <image href={`/icons/flow/${c.icon}.svg`} x={c.x + 130 - c.iconW / 2} y={62 - c.iconH / 2} width={c.iconW} height={c.iconH} aria-hidden="true" />
        <text x={c.x + 130} y="94" text-anchor="middle" class="nm">
          <tspan data-lang-en>{c.name.en}</tspan><tspan data-lang-vi>{c.name.vi}</tspan>
        </text>
        {c.lives.map((l, i) => (
          <text x={c.x + 130} y={128 + i * 30} text-anchor="middle" class="li">
            <tspan data-lang-en>{l.en}</tspan><tspan data-lang-vi>{l.vi}</tspan>
          </text>
        ))}
        <line x1={c.x + 20} y1="248" x2={c.x + 240} y2="248" class="sep" />
        <text x={c.x + 130} y="272" text-anchor="middle" class="nv">
          <tspan data-lang-en>{c.never.en}</tspan><tspan data-lang-vi>{c.never.vi}</tspan>
        </text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The deal each layer makes: do your own job, and refuse the neighbours' — "what closing a case means" appears in exactly one column, and both other layers say never to it.</span>
    <span data-lang-vi>Thoả ước của từng tầng: làm việc của mình, từ chối việc của tầng khác — "ý nghĩa của việc đóng case" chỉ xuất hiện ở đúng một cột, hai cột còn lại đều ghi "không bao giờ".</span>
  </figcaption>
</figure>

<style>
  .bep4b { margin: 2em 0; width: 100%; }
  .bep4b-scroll { overflow-x: auto; }
  .bep4b svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep4b text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep4b .nm { font-weight: 700; fill: var(--text); font-size: 16px; }
  .bep4b .li { fill: var(--text-body); }
  .bep4b .nv { fill: var(--text-muted); font-size: 12.5px; }
  .bep4b .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep4b .box.red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .bep4b .sep { stroke: var(--border); stroke-width: 1; }
  .bep4b .disc { fill: none; }
  :global([data-theme='dark']) .bep4b .disc { fill: rgba(255, 255, 255, 0.88); }
  .bep4b figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
