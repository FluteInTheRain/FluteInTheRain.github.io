---
// Visual side-by-side: opaque Hex/RGB codes across button states vs. HSL dials
// where a single hue stays anchored and only lightness/saturation move predictably.

const hexStates = [
  {
    en: 'Default',
    vi: 'Mặc định',
    bg: '#3B82F6',
    fg: '#ffffff',
    code: '#3B82F6 · rgb(59, 130, 246)',
    noteEn: 'Starting button color',
    noteVi: 'Màu nút ban đầu',
  },
  {
    en: 'Hover',
    vi: 'Di chuột',
    bg: '#2563EB',
    fg: '#ffffff',
    code: '#2563EB · rgb(37, 99, 235)',
    noteEn: 'Same hue? How much darker?',
    noteVi: 'Cùng tông không? Tối hơn mấy?',
  },
  {
    en: 'Active',
    vi: 'Nhấn giữ',
    bg: '#1D4ED8',
    fg: '#ffffff',
    code: '#1D4ED8 · rgb(29, 78, 216)',
    noteEn: 'All three channels jump unevenly',
    noteVi: 'Cả ba kênh nhảy số khó đoán',
  },
  {
    en: 'Disabled',
    vi: 'Vô hiệu',
    bg: '#93C5FD',
    fg: '#1e3a8a',
    code: '#93C5FD · rgb(147, 197, 253)',
    noteEn: 'Hard to desaturate by eye in hex',
    noteVi: 'Khó hạ độ bão hòa bằng mã hex',
  },
];

const hslStates = [
  {
    en: 'Default',
    vi: 'Mặc định',
    h: 217,
    s: 91,
    l: 60,
    fg: '#ffffff',
    deltaEn: 'Base stop (500)',
    deltaVi: 'Bậc gốc (500)',
  },
  {
    en: 'Hover',
    vi: 'Di chuột',
    h: 217,
    s: 91,
    l: 52,
    fg: '#ffffff',
    deltaEn: 'Lightness −8%',
    deltaVi: 'Giảm sáng −8%',
  },
  {
    en: 'Active',
    vi: 'Nhấn giữ',
    h: 217,
    s: 91,
    l: 44,
    fg: '#ffffff',
    deltaEn: 'Lightness −16%',
    deltaVi: 'Giảm sáng −16%',
  },
  {
    en: 'Disabled',
    vi: 'Vô hiệu',
    h: 217,
    s: 32,
    l: 74,
    fg: '#334155',
    deltaEn: 'Sat −59%, Light +14%',
    deltaVi: 'Bão hòa −59%, Sáng +14%',
  },
];

const W = 900;
const H = 336;
const padL = 24;
const colW = 412;
const rightX = padL + colW + 28;
---

<figure class="chvh">
  <div class="chvh-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Side-by-side comparison of button states defined in Hex and RGB versus HSL. In Hex and RGB, all three numbers change unpredictably; in HSL, hue stays fixed at 217 degrees while lightness and saturation adjust predictably.">
      {/* Column headers */}
      <text x={padL} y="24" class="chvh-h-bad">
        <tspan data-lang-en>Hex / RGB: opaque numbers, guesswork per state</tspan>
        <tspan data-lang-vi>Hex / RGB: mã khó đọc, phải đoán mò từng trạng thái</tspan>
      </text>
      <text x={rightX} y="24" class="chvh-h-good">
        <tspan data-lang-en>HSL: lock hue (217°), adjust lightness and saturation</tspan>
        <tspan data-lang-vi>HSL: khóa sắc (217°), chỉ chỉnh độ sáng và bão hòa</tspan>
      </text>

      {/* Left card: Hex / RGB */}
      <rect x={padL} y="40" width={colW} height="280" rx="8" fill="var(--bg-alt)" class="chvh-frame" />
      {hexStates.map((st, i) => {
        const y = 58 + i * 65;
        return (
          <g>
            <rect x={padL + 16} y={y + 4} width="102" height="36" rx="6" fill={st.bg} />
            <text x={padL + 67} y={y + 27} text-anchor="middle" fill={st.fg} class="chvh-btn">
              <tspan data-lang-en>{st.en}</tspan>
              <tspan data-lang-vi>{st.vi}</tspan>
            </text>
            <text x={padL + 132} y={y + 19} class="chvh-code">{st.code}</text>
            <text x={padL + 132} y={y + 38} class="chvh-note">
              <tspan data-lang-en>{st.noteEn}</tspan>
              <tspan data-lang-vi>{st.noteVi}</tspan>
            </text>
          </g>
        );
      })}

      {/* Right card: HSL */}
      <rect x={rightX} y="40" width={colW} height="280" rx="8" fill="var(--bg-alt)" class="chvh-frame" />
      {hslStates.map((st, i) => {
        const y = 58 + i * 65;
        const barX = rightX + 318;
        const barW = 78;
        const hPos = barX + (st.h / 360) * barW;
        const sPos = barX + (st.s / 100) * barW;
        const lPos = barX + (st.l / 100) * barW;
        return (
          <g>
            <rect x={rightX + 16} y={y + 4} width="102" height="36" rx="6" fill={`hsl(${st.h}, ${st.s}%, ${st.l}%)`} />
            <text x={rightX + 67} y={y + 27} text-anchor="middle" fill={st.fg} class="chvh-btn">
              <tspan data-lang-en>{st.en}</tspan>
              <tspan data-lang-vi>{st.vi}</tspan>
            </text>
            <text x={rightX + 132} y={y + 19} class="chvh-code">
              H {st.h}° · S {st.s}% · L {st.l}%
            </text>
            <text x={rightX + 132} y={y + 38} class="chvh-delta">
              <tspan data-lang-en>{st.deltaEn}</tspan>
              <tspan data-lang-vi>{st.deltaVi}</tspan>
            </text>

            {/* Mini H / S / L dial tracks */}
            <text x={barX - 12} y={y + 10} text-anchor="end" class="chvh-axis">H</text>
            <line x1={barX} x2={barX + barW} y1={y + 6} y2={y + 6} class="chvh-track" />
            <circle cx={hPos} cy={y + 6} r="3.5" fill="var(--text-muted)" />

            <text x={barX - 12} y={y + 24} text-anchor="end" class="chvh-axis">S</text>
            <line x1={barX} x2={barX + barW} y1={y + 20} y2={y + 20} class="chvh-track" />
            <circle cx={sPos} cy={y + 20} r="3.5" fill={st.s !== 91 ? 'var(--red)' : 'var(--text-muted)'} />

            <text x={barX - 12} y={y + 38} text-anchor="end" class="chvh-axis">L</text>
            <line x1={barX} x2={barX + barW} y1={y + 34} y2={y + 34} class="chvh-track" />
            <circle cx={lPos} cy={y + 34} r="3.5" fill={st.l !== 60 ? 'var(--red)' : 'var(--text-muted)'} />
          </g>
        );
      })}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>In Hex and RGB, darkening a button scrambles all three channels. In HSL, hue stays pinned at 217° and each state maps to one clear dial movement.</span>
    <span data-lang-vi>Với Hex và RGB, làm tối nút bấm khiến cả ba kênh đổi số hỗn loạn. Với HSL, góc sắc giữ cố định ở 217° và mỗi trạng thái chỉ là một thao tác vặn rõ ràng.</span>
  </figcaption>
</figure>

<style>
  .chvh { margin: 2em 0; width: 100%; }
  .chvh-scroll { overflow-x: auto; }
  .chvh svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .chvh text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .chvh text.chvh-h-bad { font-size: 14.5px; font-weight: 700; fill: var(--red); }
  .chvh text.chvh-h-good { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .chvh text.chvh-btn { font-size: 13.5px; font-weight: 600; }
  .chvh text.chvh-code { font-size: 13px; font-weight: 600; fill: var(--text); }
  .chvh text.chvh-note { font-size: 12px; fill: var(--text-muted); }
  .chvh text.chvh-delta { font-size: 12px; font-weight: 600; fill: var(--red); }
  .chvh text.chvh-axis { font-size: 10.5px; fill: var(--text-muted); }
  .chvh-frame { stroke: var(--border); stroke-width: 1; }
  .chvh-track { stroke: var(--border); stroke-width: 2.5; stroke-linecap: round; }
  .chvh figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
