---
// Natural visibility graph of the 8-value series [5,2,4,1,3,6,2,4]. Python check (point a sees b when every point between
// lies strictly below the straight line a-b): 13 edges, degrees [3,2,5,3,3,6,2,2]. Series made up for the drawing.
const W = 900, H = 380;
const y = [5, 2, 4, 1, 3, 6, 2, 4];
const E: [number, number][] = [[0,1],[0,2],[0,5],[1,2],[2,3],[2,4],[2,5],[3,4],[3,5],[4,5],[5,6],[5,7],[6,7]];
const deg = [3, 2, 5, 3, 3, 6, 2, 2];
const X0 = 50, DX = 62, BASE = 300, U = 36;
const bx = (i: number) => X0 + i * DX;
const by = (v: number) => BASE - v * U;
---
<figure class="atp11-vg">
  <div class="atp11-vg-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Eight daily prices drawn as bars. Two days are linked when the straight line between their tops is not blocked by any bar in between. The highest day, day 6, sees six others; the low days see two.">
      <text x="20" y="26" class="h"><tspan data-lang-en>A price series turned into a graph: who can see whom</tspan><tspan data-lang-vi>Chuỗi giá thành đồ thị: ngày nào nhìn thấy ngày nào</tspan></text>
      {y.map((v, i) => <rect x={bx(i) - 14} y={by(v)} width="28" height={BASE - by(v)} rx="3" class="bar" />)}
      {E.map(([a, b]) => <line x1={bx(a)} y1={by(y[a])} x2={bx(b)} y2={by(y[b])} class="vl" />)}
      {y.map((v, i) => <circle cx={bx(i)} cy={by(v)} r="5" class={deg[i] >= 5 ? 'pt hub' : 'pt'} />)}
      {y.map((_, i) => <text x={bx(i)} y={BASE + 20} text-anchor="middle" class="tk">{i + 1}</text>)}
      <text x={bx(7) + 28} y={BASE + 20} class="sub"><tspan data-lang-en>day</tspan><tspan data-lang-vi>ngày</tspan></text>
      <rect x="580" y="60" width="300" height="236" rx="8" class="box" />
      <text x="598" y="88" class="bh"><tspan data-lang-en>How many days each day sees</tspan><tspan data-lang-vi>Mỗi ngày nhìn thấy bao nhiêu ngày</tspan></text>
      {deg.map((d, i) => (
        <g>
          <text x="598" y={118 + i * 21} class="dl"><tspan data-lang-en>day {i + 1}</tspan><tspan data-lang-vi>ngày {i + 1}</tspan></text>
          <rect x="660" y={106 + i * 21} width={d * 28} height="12" rx="3" class={d >= 5 ? 'db hub' : 'db'} />
          <text x={660 + d * 28 + 6} y={117 + i * 21} class="dv">{d}</text>
        </g>
      ))}
      <text x="20" y="356" class="sub"><tspan data-lang-en>Prices are made up for the drawing: 8 days, 13 links. Peaks (days 1, 3, 6) see far; valleys see little.</tspan><tspan data-lang-vi>Giá là số dựng cho hình: 8 ngày, 13 liên kết. Đỉnh (ngày 1, 3, 6) nhìn xa; đáy nhìn được ít.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A natural visibility graph: two days are linked when every day between them sits below the straight line joining them. Graph statistics of this network (diameter, betweenness) then describe the shape of the price path.</span>
    <span data-lang-vi>Đồ thị tầm nhìn tự nhiên: hai ngày được nối khi mọi ngày nằm giữa đều thấp hơn đường thẳng nối chúng. Các thống kê của mạng này (đường kính, betweenness) mô tả hình dạng đường giá.</span>
  </figcaption>
</figure>
<style>
  .atp11-vg { margin: 2em 0; width: 100%; }
  .atp11-vg-scroll { overflow-x: auto; }
  .atp11-vg svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .atp11-vg text { font-size: 14px; fill: var(--text-body); }
  .atp11-vg .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp11-vg .bh { font-size: 14px; font-weight: 700; fill: var(--text); }
  .atp11-vg .sub { font-size: 13px; fill: var(--text-muted); }
  .atp11-vg .tk { font-size: 12.5px; fill: var(--text-muted); }
  .atp11-vg .dl { font-size: 12.5px; fill: var(--text); }
  .atp11-vg .dv { font-size: 12.5px; font-weight: 700; fill: var(--text); }
  .atp11-vg .bar { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .atp11-vg .vl { stroke: var(--text-muted); stroke-width: 1.3; opacity: 0.8; }
  .atp11-vg .pt { fill: var(--bg); stroke: var(--text); stroke-width: 1.6; }
  .atp11-vg .pt.hub { stroke: var(--gold-icon); fill: var(--gold-tint-bg); stroke-width: 2.2; }
  .atp11-vg .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .atp11-vg .db { fill: var(--text-faint); }
  .atp11-vg .db.hub { fill: var(--gold-icon); }
  .atp11-vg figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
