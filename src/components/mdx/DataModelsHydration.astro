---
import DiagramIcon from './DiagramIcon.astro';
// How a Twitter home timeline is read: the cache holds ids only, and the service fetches tweets and authors in two batches (Krikorian 2012, via High Scalability). Entry ids here are illustrative.
// Arrowheads are polygons: no SVG ids.
const W = 900;
const H = 360;
type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}
const frames: any[] = [];
const boxes: any[] = [];
const links: any[] = [];
const labels: any[] = [];
const nums: any[] = [];
boxes.push(
  { x: 10, y: 40, w: 250, h: 196, flat: true, en: [''], vi: [''] },
  { x: 360, y: 40, w: 230, h: 80, icon: 'db', en: ['Tweet store', 'one batch lookup', 'for all tweet ids'], vi: ['Kho tweet', 'một lần tra theo lô', 'cho mọi id tweet'] },
  { x: 360, y: 156, w: 230, h: 80, icon: 'db', en: ['User store', 'one batch lookup', 'for all author ids'], vi: ['Kho user', 'một lần tra theo lô', 'cho mọi id tác giả'] },
  { x: 680, y: 80, w: 210, h: 120, icon: 'phone', kind: 'good', en: ['Your screen', 'tweet text, like counts,', 'author name and photo'], vi: ['Màn hình của bạn', 'nội dung tweet, số like,', 'tên và ảnh tác giả'] },
);
['tweet 9001 · author 4 · flags', 'tweet 8977 · author 12 · flags', 'tweet 8950 · author 4 · flags'].forEach((t, k) => {
  boxes.push({ x: 24, y: 100 + k * 28, w: 222, h: 22, flat: true, en: [t], vi: [t], kind: 'plain' });
});
labels.push(
  { x: 56, y: 69, en: 'Timeline cache', vi: 'Cache timeline', cls: 'strong' },
  { x: 56, y: 87, en: "user 7's home timeline", vi: 'timeline nhà của user 7', cls: 'muted' },
  { x: 24, y: 208, en: 'up to 800 entries, ids only', vi: 'tối đa 800 mục, chỉ có id', cls: 'muted' },
  { x: 310, y: 72, anchor: 'middle', en: 'tweet ids', vi: 'id tweet', cls: 'muted' },
  { x: 310, y: 188, anchor: 'middle', en: 'author ids', vi: 'id tác giả', cls: 'muted' },
  { x: 450, y: 262, anchor: 'middle', en: 'Cached: ids only. Fetched fresh on every read: text, like counts, names, photos.', vi: 'Cache chỉ giữ id. Mỗi lần đọc mới lấy: nội dung, số like, tên, ảnh.', cls: 'strong' },
);
nums.push({ x: 28, y: 26, n: 1 }, { x: 374, y: 26, n: 2 }, { x: 374, y: 142, n: 3 });
links.push(
  { pts: [[260, 80], [360, 80]] }, { pts: [[260, 196], [360, 196]] },
  { pts: [[590, 80], [635, 80], [635, 125], [680, 125]] }, { pts: [[590, 196], [635, 196], [635, 155], [680, 155]] },
);
boxes.push({ x: 10, y: 290, w: 880, h: 50, icon: 'warning', kind: 'bad', flat: true, en: ['The slow version asks the store once per entry: N + 1 round trips instead of 2'], vi: ['Bản chậm hỏi kho một lần cho mỗi mục: N + 1 lượt gọi thay vì 2'] });
---
<figure class="dmhy">
  <div class="dmhy-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Reading a home timeline. 1: the cached timeline in Redis holds up to 800 entries, each a tweet id, an author id and 4 bytes of flags. 2: one batch lookup fetches all the tweets. 3: another batch lookup fetches all the authors. The screen shows tweet text, like counts, author names and photos, which are always current. Doing one query per entry instead is the N+1 problem.">
    {frames.map((f) => (
      <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="6" class={`dmhy-frame ${f.kind ?? ''}`} />
    ))}
    {boxes.map((b) => {
      const n = Math.max(b.en.length, b.vi.length);
      const top = !!b.top;
      const cx = b.x + b.w / 2;
      const x0 = top ? cx : b.icon ? b.x + 46 : b.x + 14;
      const y0 = top ? b.y + (b.icon ? 56 : 24) : b.y + b.h / 2 - ((n - 1) * 17) / 2 + 4;
      return (
        <g class={`dmhy-box ${b.kind ?? ''}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
          {b.icon && <DiagramIcon name={b.icon} x={top ? cx : b.x + 24} y={top ? b.y + 24 : b.y + b.h / 2} size={b.is ?? 26} />}
          {Array.from({ length: n }).map((_, i) => (
            <text x={x0} y={y0 + i * 17} text-anchor={top ? 'middle' : 'start'} class={i === 0 && !b.flat ? 'dmhy-name' : 'dmhy-sub'}>
              <tspan data-lang-en>{b.en[i] ?? ''}</tspan>
              <tspan data-lang-vi>{b.vi[i] ?? ''}</tspan>
            </text>
          ))}
        </g>
      );
    })}
    {links.map((l) => {
      const a = arrow(l.pts);
      return (
        <g>
          <polyline points={l.plain ? l.pts.map((p) => p.join(',')).join(' ') : a.line} class={`dmhy-edge ${l.kind ?? ''}`} fill="none" />
          {!l.plain && <polygon points={a.head} class={`dmhy-head ${l.kind ?? ''}`} />}
        </g>
      );
    })}
    {labels.map((t) => (
      <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`dmhy-lab ${t.cls ?? ''}`}>
        <tspan data-lang-en>{t.en}</tspan>
        <tspan data-lang-vi>{t.vi ?? t.en}</tspan>
      </text>
    ))}
    {nums.map((n) => (
      <g class="dmhy-num">
        <circle cx={n.x} cy={n.y} r="11" />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.n}</text>
      </g>
    ))}
    <DiagramIcon name="redis" x={36} y={64} size={24} />
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The cache keeps what never changes (ids) and the screen is built from what does. The ids are illustrative; the 800-entry cap and the 4 bytes of flags are from Raffi Krikorian's 2012 talk.</span>
    <span data-lang-vi>Cache giữ thứ không bao giờ đổi (id), còn màn hình được dựng từ thứ hay đổi. Các id ở đây chỉ để minh hoạ; mức 800 mục và 4 byte cờ lấy từ bài nói năm 2012 của Raffi Krikorian.</span>
  </figcaption>
</figure>

<style>
  .dmhy { margin: 2em 0; width: 100%; }
  .dmhy-scroll { overflow-x: auto; }
  .dmhy svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dmhy text { font-size: 14px; fill: var(--text-body); }
  .dmhy .dmhy-name { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .dmhy .dmhy-sub { font-size: 12px; fill: var(--text-muted); }
  .dmhy .dmhy-lab { font-size: 13px; }
  .dmhy .dmhy-lab.h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dmhy .dmhy-lab.strong { font-weight: 700; fill: var(--text); }
  .dmhy .dmhy-lab.muted { fill: var(--text-muted); }
  .dmhy .dmhy-lab.bad { font-weight: 700; fill: var(--red); }
  .dmhy .dmhy-lab.good { font-weight: 700; fill: var(--text); }
  .dmhy .dmhy-lab.mono, .dmhy .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .dmhy-frame { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .dmhy-frame.bad { stroke: var(--red); }
  .dmhy-frame.good { stroke: var(--gold); }
  .dmhy-box rect { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmhy-box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dmhy-box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmhy-box.plain rect { fill: none; stroke: var(--border); }
  .dmhy-edge { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmhy-edge.bad { stroke: var(--red); }
  .dmhy-edge.good { stroke: var(--gold-icon); }
  .dmhy-head { fill: var(--text-muted); }
  .dmhy-head.bad { fill: var(--red); }
  .dmhy-head.good { fill: var(--gold-icon); }
  .dmhy-num circle { fill: var(--bg-alt); stroke: var(--text-muted); }
  .dmhy-num text { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dmhy figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
