---
// Anatomy of one FIX 4.4 NewOrderSingle (35=D) in tag=value form: the raw wire bytes on top,
// then every field explained, grouped into header, body and trailer.
// BodyLength (9) and CheckSum (10) are computed here from the real bytes, so they are correct.

const SOH = '\x01';
type Field = [string, string];

const headerRest: Field[] = [
  ['35', 'D'],
  ['49', 'CLIENT_ALGO'],
  ['56', 'BROKER_GW'],
  ['34', '105'],
  ['52', '20261117-03:52:10.124'],
];
const body: Field[] = [
  ['11', 'ORD_001'],
  ['55', 'HPG'],
  ['54', '1'],
  ['60', '20261117-03:52:10.120'],
  ['38', '1000'],
  ['40', '2'],
  ['44', '28.50'],
];

const enc = (fs: Field[]) => fs.map(([t, v]) => `${t}=${v}${SOH}`).join('');
// BodyLength: bytes from the field after 9= up to and including the SOH before 10=.
const bodyLength = enc([...headerRest, ...body]).length;
const header: Field[] = [['8', 'FIX.4.4'], ['9', String(bodyLength)], ...headerRest];
// CheckSum: sum of every byte before 10=, modulo 256, written as three digits.
let sum = 0;
for (const ch of enc([...header, ...body])) sum += ch.charCodeAt(0);
const checkSum = String(sum % 256).padStart(3, '0');
const trailer: Field[] = [['10', checkSum]];

const meaning: Record<string, { name: string; en: string; vi: string }> = {
  '8': { name: 'BeginString', en: 'protocol version; always the first field', vi: 'phiên bản giao thức; luôn là field đầu tiên' },
  '9': { name: 'BodyLength', en: `${bodyLength} bytes, counted from 35= up to the SOH before 10=`, vi: `${bodyLength} byte, đếm từ 35= tới byte SOH ngay trước 10=` },
  '35': { name: 'MsgType', en: 'D = NewOrderSingle, a new order', vi: 'D = NewOrderSingle, một lệnh mới' },
  '49': { name: 'SenderCompID', en: 'who is sending', vi: 'bên gửi' },
  '56': { name: 'TargetCompID', en: 'who should receive it', vi: 'bên nhận' },
  '34': { name: 'MsgSeqNum', en: "this message's sequence number", vi: 'số thứ tự của tin nhắn này' },
  '52': { name: 'SendingTime', en: 'when it was sent, in UTC', vi: 'thời điểm gửi, theo giờ UTC' },
  '11': { name: 'ClOrdID', en: "the client's own ID for this order", vi: 'mã lệnh do client tự đặt' },
  '55': { name: 'Symbol', en: 'what to trade', vi: 'mã chứng khoán' },
  '54': { name: 'Side', en: '1 = buy, 2 = sell', vi: '1 = mua, 2 = bán' },
  '60': { name: 'TransactTime', en: 'when the client created the order', vi: 'thời điểm client tạo lệnh' },
  '38': { name: 'OrderQty', en: 'how many shares', vi: 'khối lượng (số cổ phiếu)' },
  '40': { name: 'OrdType', en: '2 = limit order', vi: '2 = lệnh giới hạn (limit)' },
  '44': { name: 'Price', en: 'the limit price', vi: 'giá đặt' },
  '10': { name: 'CheckSum', en: `sum of every byte before 10=, mod 256 (here ${checkSum})`, vi: `tổng mọi byte trước 10=, chia lấy dư 256 (ở đây là ${checkSum})` },
};

const W = 900;
const wireLines = [
  { en: 'header', vi: 'phần đầu', fields: header },
  { en: 'body', vi: 'phần thân', fields: body },
  { en: 'trailer', vi: 'phần đuôi', fields: trailer },
];
const stripTop = 38;
const lineGap = 26;
const stripH = 14 + wireLines.length * lineGap;

const rowGap = 23;
const groups = [
  { en: 'Standard header: the envelope', vi: 'Standard header: phong bì (ai gửi, tin gì, số mấy)', fields: header },
  { en: 'Application body: the order itself', vi: 'Application body: nội dung lệnh', fields: body },
  { en: 'Standard trailer: the closing check', vi: 'Standard trailer: phần kiểm tra cuối', fields: trailer },
];
let y = stripTop + stripH + 38;
const layout = groups.map((g) => {
  const headY = y;
  const rows = g.fields.map((f, i) => ({ f, y: headY + 26 + i * rowGap }));
  y = headY + 26 + (g.fields.length - 1) * rowGap + 36;
  return { ...g, headY, rows };
});
const H = y - 14;
---
<figure class="fixmsg">
  <div class="fixmsg-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`A FIX 4.4 NewOrderSingle as raw tag=value bytes separated by SOH, split into header, body and trailer, with every field explained. BodyLength is ${bodyLength} and CheckSum is ${checkSum}.`}>
      <text x="20" y="24" class="fixmsg-h">
        <tspan data-lang-en>On the wire (each red | is the invisible SOH byte, 0x01)</tspan>
        <tspan data-lang-vi>Trên đường truyền (mỗi dấu | đỏ là byte SOH vô hình, 0x01)</tspan>
      </text>
      <rect x="20" y={stripTop} width={W - 40} height={stripH} rx="6" class="fixmsg-strip" />
      {wireLines.map((l, i) => {
        const ly = stripTop + 26 + i * lineGap;
        return (
          <g>
            <text x="36" y={ly} class="fixmsg-part">
              <tspan data-lang-en>{l.en}</tspan>
              <tspan data-lang-vi>{l.vi}</tspan>
            </text>
            <text x="130" y={ly} class="fixmsg-wire">{l.fields.map(([t, v]) => (<><tspan>{`${t}=${v}`}</tspan><tspan class="fixmsg-soh">|</tspan></>))}</text>
          </g>
        );
      })}

      {layout.map((g) => (
        <g>
          <text x="20" y={g.headY} class="fixmsg-group">
            <tspan data-lang-en>{g.en}</tspan>
            <tspan data-lang-vi>{g.vi}</tspan>
          </text>
          <line x1="26" x2="26" y1={g.headY + 10} y2={g.rows[g.rows.length - 1].y + 6} class="fixmsg-bracket" />
          {g.rows.map(({ f: [t, v], y: ry }) => (
            <g>
              <text x="40" y={ry}><tspan class="fixmsg-tag">{t}</tspan>={v}</text>
              <text x="260" y={ry} class="fixmsg-name">{meaning[t].name}</text>
              <text x="410" y={ry} class="fixmsg-means">
                <tspan data-lang-en>{meaning[t].en}</tspan>
                <tspan data-lang-vi>{meaning[t].vi}</tspan>
              </text>
            </g>
          ))}
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>One buy order for 1,000 HPG at 28.50, as a FIX 4.4 NewOrderSingle. Every field is a number, an equals sign and a value. BodyLength and CheckSum here are computed from these exact bytes; the IDs and times are made up for the example.</span>
    <span data-lang-vi>Một lệnh mua 1.000 cổ phiếu HPG giá 28,50, viết thành NewOrderSingle FIX 4.4. Mỗi field là một con số, dấu bằng và giá trị. BodyLength và CheckSum ở đây được tính từ đúng các byte này; mã định danh và thời gian là giá trị minh họa.</span>
  </figcaption>
</figure>

<style>
  .fixmsg {
    margin: 2em 0;
    width: 100%;
  }
  .fixmsg-scroll {
    overflow-x: auto;
  }
  .fixmsg svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .fixmsg text {
    font-size: 14px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .fixmsg .fixmsg-h {
    font-weight: 600;
    fill: var(--text-muted);
  }
  .fixmsg-strip {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .fixmsg .fixmsg-part {
    font-size: 13px;
    fill: var(--text-muted);
  }
  /* The one place monospace is allowed: literal wire bytes. */
  .fixmsg .fixmsg-wire {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 13.5px;
    fill: var(--text);
  }
  .fixmsg .fixmsg-soh {
    fill: var(--red);
    font-weight: 700;
  }
  .fixmsg .fixmsg-group {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .fixmsg-bracket {
    stroke: var(--border);
    stroke-width: 2;
  }
  .fixmsg .fixmsg-tag {
    font-weight: 700;
    fill: var(--red);
  }
  .fixmsg .fixmsg-name {
    font-weight: 600;
    fill: var(--text);
  }
  .fixmsg .fixmsg-means {
    fill: var(--text-muted);
  }
  .fixmsg figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
