---
// Side-by-side comparison of Vietnam's three equity trading venues: HOSE, HNX, and UPCoM.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 370;

const VENUES = [
  {
    x: 20, w: 274, name: 'HOSE', accent: false,
    subEn: 'Main board (Ho Chi Minh)', subVi: 'Sàn chính (TP.HCM)',
    band: '±7%', firstDay: '±20%',
    tickEn: '10 / 50 / 100 VND', tickVi: '10 / 50 / 100 đồng',
    refEn: 'Prior close', refVi: 'Giá đóng cửa trước',
    sessEn: 'ATO + Continuous + ATC', sessVi: 'ATO + Liên tục + ATC',
  },
  {
    x: 313, w: 274, name: 'HNX', accent: false,
    subEn: 'Listed board (Hanoi)', subVi: 'Sàn niêm yết (Hà Nội)',
    band: '±10%', firstDay: '±30%',
    tickEn: '100 VND (all prices)', tickVi: '100 đồng (mọi mức giá)',
    refEn: 'Prior close', refVi: 'Giá đóng cửa trước',
    sessEn: 'Continuous + ATC + PLO', sessVi: 'Liên tục + ATC + PLO',
  },
  {
    x: 606, w: 274, name: 'UPCoM', accent: true,
    subEn: 'Unlisted public companies', subVi: 'Đại chúng chưa niêm yết',
    band: '±15%', firstDay: '±40%',
    tickEn: '100 VND (all prices)', tickVi: '100 đồng (mọi mức giá)',
    refEn: 'Prior weighted avg', refVi: 'Bình quân gia quyền trước',
    sessEn: 'Continuous only (no ATO/ATC)', sessVi: 'Chỉ liên tục (không ATO/ATC)',
  },
] as const;
---
<figure class="sbp2-venues">
  <div class="sbp2-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Comparison of HOSE (±7% band, 10/50/100 VND ticks, ATO/ATC), HNX (±10%, 100 VND tick, ATC/PLO), and UPCoM (±15%, 100 VND tick, weighted-average reference price, continuous only).">
      <text x="20" y="30" class="sbp2-title">
        <tspan data-lang-en>Three venues, three different rulebooks (board lot = 100 shares on all three)</tspan>
        <tspan data-lang-vi>Ba sàn, ba bộ luật chơi (lô chuẩn = 100 cổ phiếu ở cả ba sàn)</tspan>
      </text>

      {VENUES.map((v) => (
        <g>
          <rect
            x={v.x}
            y="52"
            width={v.w}
            height="295"
            rx="12"
            class={v.accent ? 'sbp2-card sbp2-card-red' : 'sbp2-card'}
          />
          <DiagramIcon name={v.accent ? 'warning' : 'bank'} x={v.x + 32} y={84} size={26} />
          <text x={v.x + 56} y="88" class={v.accent ? 'sbp2-vname sbp2-red' : 'sbp2-vname'}>{v.name}</text>
          <text x={v.x + 20} y="114" class="sbp2-sub">
            <tspan data-lang-en>{v.subEn}</tspan>
            <tspan data-lang-vi>{v.subVi}</tspan>
          </text>
          <line x1={v.x + 18} y1="128" x2={v.x + v.w - 18} y2="128" class="sbp2-sep" />

          {/* Daily band */}
          <text x={v.x + 20} y="156" class="sbp2-lbl">
            <tspan data-lang-en>Daily band</tspan>
            <tspan data-lang-vi>Biên độ ngày</tspan>
          </text>
          <text x={v.x + v.w - 20} y="156" text-anchor="end" class={v.accent ? 'sbp2-val sbp2-red' : 'sbp2-val'}>{v.band}</text>

          {/* First trading day */}
          <text x={v.x + 20} y="192" class="sbp2-lbl">
            <tspan data-lang-en>First trading day</tspan>
            <tspan data-lang-vi>Phiên chào sàn</tspan>
          </text>
          <text x={v.x + v.w - 20} y="192" text-anchor="end" class="sbp2-val">{v.firstDay}</text>

          {/* Tick size */}
          <text x={v.x + 20} y="228" class="sbp2-lbl">
            <tspan data-lang-en>Tick size</tspan>
            <tspan data-lang-vi>Bước giá</tspan>
          </text>
          <text x={v.x + v.w - 20} y="228" text-anchor="end" class="sbp2-val">
            <tspan data-lang-en>{v.tickEn}</tspan>
            <tspan data-lang-vi>{v.tickVi}</tspan>
          </text>

          {/* Reference price */}
          <text x={v.x + 20} y="264" class="sbp2-lbl">
            <tspan data-lang-en>Reference</tspan>
            <tspan data-lang-vi>Tham chiếu</tspan>
          </text>
          <text x={v.x + v.w - 20} y="264" text-anchor="end" class={v.accent ? 'sbp2-val sbp2-red' : 'sbp2-val'}>
            <tspan data-lang-en>{v.refEn}</tspan>
            <tspan data-lang-vi>{v.refVi}</tspan>
          </text>

          {/* Session shape */}
          <text x={v.x + 20} y="300" class="sbp2-lbl">
            <tspan data-lang-en>Sessions</tspan>
            <tspan data-lang-vi>Phiên khớp</tspan>
          </text>
          <text x={v.x + 20} y="322" class="sbp2-sub">
            <tspan data-lang-en>{v.sessEn}</tspan>
            <tspan data-lang-vi>{v.sessVi}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Same 100-share board lot, very different daily risk. Moving from HOSE (±7%) to UPCoM (±15%) more than doubles the single-day price band and changes how tomorrow's reference price is calculated.</span>
    <span data-lang-vi>Cùng lô chuẩn 100 cổ phiếu nhưng biên độ rủi ro rất khác nhau. Chuyển từ HOSE (±7%) sang UPCoM (±15%) làm biên độ dao động ngày tăng hơn gấp đôi và đổi luôn cách tính giá tham chiếu hôm sau.</span>
  </figcaption>
</figure>

<style>
  .sbp2-venues { margin: 2em 0; width: 100%; }
  .sbp2-scroll { overflow-x: auto; }
  .sbp2-venues svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sbp2-venues text { font-size: 13.5px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .sbp2-title { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sbp2-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .sbp2-card-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .sbp2-vname { font-size: 18px; font-weight: 700; fill: var(--text); }
  .sbp2-red { fill: var(--red); }
  .sbp2-sub { font-size: 12.5px; fill: var(--text-muted); }
  .sbp2-sep { stroke: var(--border); stroke-width: 1; }
  .sbp2-lbl { font-size: 12.5px; fill: var(--text-muted); }
  .sbp2-val { font-size: 13px; font-weight: 700; fill: var(--text); }
  .sbp2-venues figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
