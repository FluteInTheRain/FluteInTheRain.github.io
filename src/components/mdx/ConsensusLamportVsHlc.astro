---
// Compares Wall-Clock (NTP), Lamport Clock (counter, nodeId), and Hybrid Logical Clock (HLC)
// across two nodes when a user sets their account private on Node A (acct) and then uploads
// a photo 50 ms later on Node B (photo) whose physical clock lags by 120 ms.
// Plain inline SVG with site tokens and polygon arrowheads (no SVG marker ids).

const W = 900;
const H = 430;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const msgArrow = (y: number) => arrow(420, y, 470, y);

const lanes = [
  {
    y: 66,
    titleEn: '1. Wall clock (NTP)',
    titleVi: '1. Đồng hồ vật lý (NTP)',
    subEn: 'Photo node clock lags 120 ms',
    subVi: 'Đồng hồ node ảnh chậm 120 ms',
    msgEn: 'none',
    msgVi: 'không',
    dashedMsg: true,
    ts1: 'ts = 200 ms',
    ts2: 'ts = 130 ms',
    bad: true,
    verdict1En: '130 ms < 200 ms',
    verdict1Vi: '130 ms < 200 ms',
    verdict2En: 'Causal reversal: photo looks older',
    verdict2Vi: 'Đảo nhân quả: ảnh trông cũ hơn khoá',
  },
  {
    y: 192,
    titleEn: '2. Lamport clock',
    titleVi: '2. Đồng hồ Lamport',
    subEn: 'Pair of (counter, node ID)',
    subVi: 'Cặp số (counter, node ID)',
    msgEn: 'c = 1',
    msgVi: 'c = 1',
    dashedMsg: false,
    ts1: '(1, "acct")',
    ts2: '(2, "photo")',
    bad: false,
    verdict1En: '(1, "acct") < (2, "photo")',
    verdict1Vi: '(1, "acct") < (2, "photo")',
    verdict2En: 'Causal order kept, no real time',
    verdict2Vi: 'Đúng thứ tự, không gắn giờ thực',
  },
  {
    y: 318,
    titleEn: '3. Hybrid logical clock',
    titleVi: '3. Đồng hồ logic lai (HLC)',
    subEn: 'Max wall time + logical tick',
    subVi: 'Max(giờ vật lý) + đếm logic',
    msgEn: '(200, 0)',
    msgVi: '(200, 0)',
    dashedMsg: false,
    ts1: '(200 ms, 0)',
    ts2: '(200 ms, 1)',
    bad: false,
    verdict1En: '(200, 0) < (200, 1)',
    verdict1Vi: '(200, 0) < (200, 1)',
    verdict2En: 'Causal order kept + tracks wall time',
    verdict2Vi: 'Đúng thứ tự + bám sát giờ thực',
  },
];
---
<figure class="clh">
  <div class="clh-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Comparison of wall clock, Lamport clock, and Hybrid Logical Clock across two nodes with 120 ms clock skew. Wall clock assigns 200 ms to the earlier privacy update and 130 ms to the later photo upload, reversing order. Passing causal timestamps lets Lamport assign (1, acct) then (2, photo), and HLC assign (200 ms, 0) then (200 ms, 1).">
      <text x="20" y="24" class="clh-h">
        <tspan data-lang-en>Two events, 50 ms apart: set account private on Node A, then upload photo on Node B</tspan>
        <tspan data-lang-vi>Hai sự kiện cách nhau 50 ms: đặt riêng tư ở Node A, rồi đăng ảnh ở Node B</tspan>
      </text>
      <text x="20" y="45" class="clh-sub">
        <tspan data-lang-en>Node A physical clock = 200 ms (on time). Node B physical clock = 130 ms (lags 120 ms behind real time 250 ms).</tspan>
        <tspan data-lang-vi>Đồng hồ vật lý Node A = 200 ms (đúng giờ). Node B = 130 ms (chậm 120 ms so với thời gian thực 250 ms).</tspan>
      </text>

      {lanes.map((ln, idx) => {
        const a = msgArrow(ln.y + 38);
        return (
          <g>
            {idx > 0 && <line x1="20" x2={W - 20} y1={ln.y - 20} y2={ln.y - 20} class="clh-rule" />}

            {/* Left label */}
            <text x="20" y={ln.y + 32} class="clh-lane">
              <tspan data-lang-en>{ln.titleEn}</tspan>
              <tspan data-lang-vi>{ln.titleVi}</tspan>
            </text>
            <text x="20" y={ln.y + 52} class="clh-lane-sub">
              <tspan data-lang-en>{ln.subEn}</tspan>
              <tspan data-lang-vi>{ln.subVi}</tspan>
            </text>

            {/* Box 1: Node A */}
            <rect x="248" y={ln.y + 4} width="172" height="68" rx="6" class="clh-box" />
            <text x="334" y={ln.y + 26} text-anchor="middle" class="clh-box-title">
              <tspan data-lang-en>Node A: set private</tspan>
              <tspan data-lang-vi>Node A: đặt riêng tư</tspan>
            </text>
            <text x="334" y={ln.y + 45} text-anchor="middle" class="clh-box-meta">t_real = 200 ms</text>
            <text x="334" y={ln.y + 63} text-anchor="middle" class="clh-ts">{ln.ts1}</text>

            {/* Message arrow */}
            <path d={a.line} class={ln.dashedMsg ? 'clh-arrow is-dash' : 'clh-arrow'} />
            <polygon points={a.head} class={ln.dashedMsg ? 'clh-head is-muted' : 'clh-head'} />
            <text x="445" y={ln.y + 27} text-anchor="middle" class="clh-msg">
              <tspan data-lang-en>{ln.msgEn}</tspan>
              <tspan data-lang-vi>{ln.msgVi}</tspan>
            </text>

            {/* Box 2: Node B */}
            <rect x="470" y={ln.y + 4} width="176" height="68" rx="6" class={ln.bad ? 'clh-box is-bad' : 'clh-box is-ok'} />
            <text x="558" y={ln.y + 26} text-anchor="middle" class="clh-box-title">
              <tspan data-lang-en>Node B: upload photo</tspan>
              <tspan data-lang-vi>Node B: đăng ảnh</tspan>
            </text>
            <text x="558" y={ln.y + 45} text-anchor="middle" class="clh-box-meta">t_real = 250 ms (130)</text>
            <text x="558" y={ln.y + 63} text-anchor="middle" class={ln.bad ? 'clh-ts is-bad' : 'clh-ts'}>{ln.ts2}</text>

            {/* Right verdict */}
            <text x="664" y={ln.y + 33} class={ln.bad ? 'clh-verdict is-bad' : 'clh-verdict'}>
              <tspan data-lang-en>{ln.verdict1En}</tspan>
              <tspan data-lang-vi>{ln.verdict1Vi}</tspan>
            </text>
            <text x="664" y={ln.y + 53} class={ln.bad ? 'clh-verdict-sub is-bad' : 'clh-verdict-sub'}>
              <tspan data-lang-en>{ln.verdict2En}</tspan>
              <tspan data-lang-vi>{ln.verdict2Vi}</tspan>
            </text>
          </g>
        );
      })}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Both Lamport clocks and HLC keep causal order when nodes pass timestamps on messages or tokens: Node B adopts the larger value instead of trusting its slow wall clock. If two separate shards never communicate, neither logical clock can enforce cross-shard real-time order.</span>
    <span data-lang-vi>Cả đồng hồ Lamport và HLC đều giữ đúng thứ tự nhân quả khi các node truyền timestamp kèm thông điệp: Node B nhận giá trị lớn hơn thay vì tin mù quáng vào đồng hồ chậm của mình. Nếu hai shard tách biệt không bao giờ trao đổi với nhau, cả hai loại đồng hồ logic đều không ép được thứ tự thời gian thực giữa hai bên.</span>
  </figcaption>
</figure>

<style>
  .clh {
    margin: 2em 0;
    width: 100%;
  }
  .clh-scroll {
    overflow-x: auto;
  }
  .clh svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .clh text {
    font-size: 14px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .clh .clh-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .clh .clh-sub,
  .clh .clh-lane-sub,
  .clh .clh-box-meta {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .clh .clh-lane {
    font-size: 14.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .clh-rule {
    stroke: var(--border);
  }
  .clh-box {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .clh-box.is-ok {
    stroke: var(--text);
    stroke-width: 1.5;
  }
  .clh-box.is-bad {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.7;
  }
  .clh .clh-box-title {
    font-size: 13px;
    font-weight: 600;
    fill: var(--text);
  }
  .clh .clh-ts {
    font-size: 13.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .clh .clh-ts.is-bad,
  .clh .clh-verdict.is-bad,
  .clh .clh-verdict-sub.is-bad {
    fill: var(--red);
  }
  .clh .clh-msg {
    font-size: 12px;
    fill: var(--text-muted);
  }
  .clh-arrow {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
  }
  .clh-arrow.is-dash {
    stroke: var(--text-muted);
    stroke-dasharray: 4 3;
  }
  .clh-head {
    fill: var(--text);
  }
  .clh-head.is-muted {
    fill: var(--text-muted);
  }
  .clh .clh-verdict {
    font-size: 13.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .clh .clh-verdict-sub {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .clh figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
