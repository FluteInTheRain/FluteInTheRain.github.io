---
// Four checks for an agent, cheapest first. Each catches a different kind of failure.
import DiagramIcon from './DiagramIcon.astro';
const rungs = [
  { icon: 'test', t: { en: '1. Test each tool', vi: '1. Kiểm thử từng tool' }, c: { en: 'Plain unit tests. A wrong band or a bad date format shows up here.', vi: 'Unit test thường. Biên độ sai hay định dạng ngày hỏng lộ ra ở đây.' } },
  { icon: 'eye', t: { en: '2. Read the trace', vi: '2. Đọc vết chạy' }, c: { en: 'Open every step, not only the answer. Did it call the tool, or invent the number?', vi: 'Mở từng bước, không chỉ câu trả lời. Nó đã gọi tool hay bịa con số?' } },
  { icon: 'doc', t: { en: '3. Questions with known answers', vi: '3. Câu hỏi có đáp án sẵn' }, c: { en: 'A fixed set, scored by a person. FinanceBench is one such set for filings.', vi: 'Một bộ cố định, người chấm. FinanceBench là một bộ như vậy cho báo cáo tài chính.' } },
  { icon: 'clock', t: { en: '4. Run it forward in time', vi: '4. Chạy tiến theo thời gian' }, c: { en: 'Paper trade with timestamps after the model cutoff. Only this removes look-ahead.', vi: 'Chạy giao dịch giả lập với mốc thời gian sau mốc cắt của model. Chỉ cách này loại được look-ahead.' } },
] as const;
---
<figure class="a21e">
  <div class="a21e-scroll">
    <svg viewBox="0 0 900 396" role="img" aria-label="Four checks for an agent, cheapest first: test each tool, read the trace step by step, run questions with known answers, and run it forward in time after the model cutoff.">
      <text x="20" y="28" class="a21e-h"><tspan data-lang-en>Four checks, cheapest first; each catches something the others miss</tspan><tspan data-lang-vi>Bốn lần kiểm, rẻ nhất trước; mỗi lần bắt được thứ các lần khác bỏ sót</tspan></text>
      {rungs.map((r, i) => (
        <g>
          <rect x="20" y={48 + i * 82} width="860" height="72" rx="8" class={i === 3 ? 'a21e-row is-key' : 'a21e-row'} />
          <rect x="20" y={48 + i * 82} width={(i + 1) * 40} height="4" class="a21e-cost" />
          <DiagramIcon name={r.icon} x="52" y={84 + i * 82} size={24} />
          <text x="86" y={80 + i * 82} class="a21e-t"><tspan data-lang-en>{r.t.en}</tspan><tspan data-lang-vi>{r.t.vi}</tspan></text>
          <foreignObject x="330" y={52 + i * 82} width="540" height="64">
            <p xmlns="http://www.w3.org/1999/xhtml" class="a21e-fp"><span data-lang-en>{r.c.en}</span><span data-lang-vi>{r.c.vi}</span></p>
          </foreignObject>
        </g>
      ))}
      <text x="20" y="388" class="a21e-s"><tspan data-lang-en>The thin bar on each row grows with the cost of running that check.</tspan><tspan data-lang-vi>Thanh mỏng trên mỗi dòng dài ra theo chi phí chạy lần kiểm đó.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A good score on check 3 says the agent answers known questions. Only check 4 says anything about next month.</span>
    <span data-lang-vi>Điểm tốt ở lần kiểm 3 chỉ nói agent trả lời được câu hỏi đã biết. Chỉ lần kiểm 4 mới nói được gì đó về tháng sau.</span>
  </figcaption>
</figure>

<style>
  .a21e { margin: 2em 0; width: 100%; }
  .a21e-scroll { overflow-x: auto; }
  .a21e svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .a21e text { font-size: 13px; fill: var(--text-body); }
  .a21e .a21e-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .a21e .a21e-t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .a21e .a21e-s { font-size: 12.5px; fill: var(--text-muted); }
  .a21e .a21e-fp { margin: 0; font-size: 13px; line-height: 1.4; color: var(--text-body); font-family: inherit; }
  .a21e-row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .a21e-row.is-key { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .a21e-cost { fill: var(--text-muted); }
  .a21e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
