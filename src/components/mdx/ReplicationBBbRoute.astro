---
// Bitbucket's routing rule with concrete (illustrative) log positions: the primary's position is
// saved after a write, and the next read goes only to a replica that has replayed at least that far.
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Arrow from './ReplicationBArrow.astro';
import Bi from './ReplicationBBi.astro';
---
<Frame h={270}
  label="Bitbucket routing with example log positions. A user's write goes to the primary, which is at position 3/9A1C2B40. That position is saved in Redis. On the next request, replica 1 has only replayed to 3/9A1C1000 so it is skipped; replica 2 has replayed to 3/9A1C3000 so it serves the read."
  cap="The mechanism follows Atlassian's post; the position numbers are made up for the example."
  capVi="Cơ chế theo bài của Atlassian; các số vị trí là số bịa ra cho ví dụ.">
  <Node x={20} y={20} w={190} h={64} icon="laptop" t="User" tv="Người dùng" s="creates a pull request" sv="tạo một pull request" />
  <Node x={300} y={20} w={230} h={64} icon="postgres" t="Primary" tv="Primary" s="write done at 3/9A1C2B40" sv="ghi xong ở 3/9A1C2B40" />
  <Node x={640} y={20} w={240} h={64} icon="redis" t="Redis" tv="Redis" s="saves 3/9A1C2B40 for the user" sv="lưu 3/9A1C2B40 cho người dùng" cls="gold" />
  <Arrow x1={210} y1={52} x2={300} y2={52} />
  <text x="255" y="42" text-anchor="middle" class="rb-step"><Bi en="1. write" vi="1. ghi" /></text>
  <Arrow x1={530} y1={52} x2={640} y2={52} />
  <text x="585" y="42" text-anchor="middle" class="rb-step"><Bi en="2. save" vi="2. lưu" /></text>
  <text x="450" y="124" text-anchor="middle" class="rb-t"><Bi en="3. next request: only a replica that has replayed to 3/9A1C2B40 or later may answer" vi="3. request kế tiếp: chỉ replica đã replay tới 3/9A1C2B40 trở lên mới được trả lời" /></text>
  <Node x={20} y={160} w={190} h={80} icon="laptop" t="Same user" tv="Cùng người dùng" s="next request" sv="request kế tiếp" />
  <Node x={300} y={160} w={230} h={80} icon="postgres" t="Replica 1" tv="Replica 1" s="replayed to 3/9A1C1000" sv="đã replay tới 3/9A1C1000" s2="behind: skipped" s2v="còn chậm: bị bỏ qua" cls="red" />
  <Node x={640} y={160} w={240} h={80} icon="postgres" t="Replica 2" tv="Replica 2" s="replayed to 3/9A1C3000" sv="đã replay tới 3/9A1C3000" s2="far enough: serves the read" s2v="đủ xa: trả lời lần đọc" cls="gold" />
  <Arrow x1={210} y1={200} x2={300} y2={200} cls="red" />
  <text x="255" y="190" text-anchor="middle" class="rb-step"><Bi en="4. check" vi="4. kiểm tra" /></text>
  <Arrow x1={530} y1={200} x2={640} y2={200} cls="gold" />
  <text x="585" y="190" text-anchor="middle" class="rb-step"><Bi en="5. try next" vi="5. thử tiếp" /></text>
</Frame>
