    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .atsig-faint .h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .atsig-faint .note {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .atsig-faint .tick {
    font-size: 12px;
    fill: var(--text-muted);
  }
  .atsig-faint .axis {
    stroke: var(--border);
  }
  .atsig-faint .noise-line {
    fill: none;
    stroke: var(--text-body);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .atsig-faint .signal-line-faint {
    fill: none;
    stroke: var(--red);
