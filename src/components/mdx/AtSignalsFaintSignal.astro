---
// One trading year of one stock, simulated twice. Top: the price path you
// actually see, daily noise doing most of the drawing. Bottom: the same year
// with only the predictable part (the drift a model could hope to learn),
// zoomed to fill its panel — inside the top chart it is the thin red line.
// Seeded PRNG so every build renders the same picture.

const W = 900;
const H = 380;
const L = 60;
const R = W - 26;

// --- seeded PRNG (mulberry32) ---
function rng(a: number) {
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(11);

const DAYS = 250;
// gaussian-ish noise: mean of 4 uniforms, centred
const g = () => (rand() + rand() + rand() + rand() - 2) * 1.35;

const DRIFT = 0.04; // tiny learnable trend per day
const NOISE = 1.0;  // daily wiggle, far larger than the drift

// top panel
const topY0 = 30;
const topY1 = 176;
// bottom panel
const botY0 = 248;
const botY1 = 348;

// price = noise + drift, drawn together with the drift alone, SAME scale
const price: number[] = [];
const drift: number[] = [];
let acc = 100;
for (let i = 0; i <= DAYS; i++) {
  acc += g() * NOISE;
  price.push(acc + DRIFT * i);
  drift.push(DRIFT * i);
}
const allMin = Math.min(...price, ...drift);
const allMax = Math.max(...price, ...drift);
const x = (i: number) => L + (i / DAYS) * (R - L);
const py = (v: number) => topY1 - ((v - allMin) / (allMax - allMin)) * (topY1 - topY0);

// the learnable part zoomed to its own panel
const dy = (v: number) => botY1 - ((v - drift[0]) / (drift[DAYS] - drift[0])) * (botY1 - botY0);

const pricePath = price.map((v, i) => `${i ? 'L' : 'M'} ${x(i).toFixed(1)} ${py(v).toFixed(1)}`).join(' ');
const driftTopPath = drift.map((v, i) => `${i ? 'L' : 'M'} ${x(i).toFixed(1)} ${py(v).toFixed(1)}`).join(' ');
const driftPath = drift.map((v, i) => `${i ? 'L' : 'M'} ${x(i).toFixed(1)} ${dy(v).toFixed(1)}`).join(' ');
---

<figure class="atsig-faint">
  <div class="atsig-faint-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A simulated trading year of one stock. The daily path is almost all noise; the predictable part is a nearly flat line that only becomes visible when drawn on its own, magnified.">
      {/* top panel */}
      <text x={L} y={topY0 - 8} class="h">
        <tspan data-lang-en>One stock, one trading year — what you see</tspan>
        <tspan data-lang-vi>Một cổ phiếu, một năm giao dịch — cái bạn nhìn thấy</tspan>
      </text>
      <line x1={L} x2={R} y1={topY1} y2={topY1} class="axis" />
      <text x={R} y={topY1 + 16} text-anchor="end" class="tick">
        <tspan data-lang-en>price</tspan>
        <tspan data-lang-vi>giá</tspan>
      </text>
      <path d={pricePath} class="noise-line" />
      <path d={driftTopPath} class="signal-line-faint" />

      <text x={R - 4} y={py(price[DAYS]) - 12} text-anchor="end" class="note">
        <tspan data-lang-en>daily moves, mostly noise</tspan>
        <tspan data-lang-vi>biên độ ngày, phần lớn là nhiễu</tspan>
      </text>

      {/* bottom panel */}
      <text x={L} y={botY0 - 10} class="h">
        <tspan data-lang-en>The same year — only the predictable part</tspan>
        <tspan data-lang-vi>Cùng năm đó — chỉ phần có thể dự đoán</tspan>
      </text>
      <line x1={L} x2={R} y1={botY1} y2={botY1} class="axis" />
      <text x={R} y={botY1 + 16} text-anchor="end" class="tick">
        <tspan data-lang-en>magnified so it fills the panel</tspan>
        <tspan data-lang-vi>phóng to cho vừa khung</tspan>
      </text>
      <path d={driftPath} class="signal-line" />
      <text x={L + 6} y={botY0 + 26} class="note">
        <tspan data-lang-en>the learnable signal — the thin red line above, now zoomed in</tspan>
        <tspan data-lang-vi>tín hiệu học được — đường đỏ mảnh phía trên, giờ phóng to</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Simulated data (seeded random walk, daily wiggle far larger than the learnable trend; both drawn on the same scale). A model's whole job is to find the bottom line while living inside the top one.</span>
    <span data-lang-vi>Số liệu mô phỏng (random walk gieo hạt cố định, biên độ ngày lớn hơn nhiều so với xu hướng học được; vẽ chung một thang đo). Công việc của mô hình là tìm đường dưới trong khi sống bên trong đường trên.</span>
  </figcaption>
</figure>

<style>
  .atsig-faint {
    margin: 2em 0;
    width: 100%;
  }
  .atsig-faint-scroll {
    overflow-x: auto;
  }
