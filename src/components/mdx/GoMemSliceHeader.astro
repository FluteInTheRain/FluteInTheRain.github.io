---
// Showdown: Go's 24-byte slice header sharing a backing array vs full slice expression s[low:high:max].
// Uses site CSS tokens only (zero hex colors) and polygon arrowheads.
const W = 900;
const H = 430;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const pTopS1 = arrow(196, 118, 340, 118);
const pTopS2 = arrow(196, 165, 422, 146);
const pBotS1 = arrow(196, 314, 340, 314);
const pBotS2 = arrow(196, 360, 340, 360);

const valsTop = [
  { idx: '0', v: '10', tone: 'base' },
  { idx: '1', v: '20', tone: 'shared' },
  { idx: '2', v: '30', tone: 'shared' },
  { idx: '3', v: '99', tone: 'danger' },
  { idx: '4', v: '50', tone: 'base' },
];
const valsBotOrig = [
  { idx: '0', v: '10', tone: 'base' },
  { idx: '1', v: '20', tone: 'shared' },
  { idx: '2', v: '30', tone: 'shared' },
  { idx: '3', v: '40', tone: 'ok' },
  { idx: '4', v: '50', tone: 'base' },
];
const valsBotNew = [
  { idx: '0', v: '20', tone: 'ok' },
  { idx: '1', v: '30', tone: 'ok' },
  { idx: '2', v: '99', tone: 'ok' },
  { idx: '3', v: '—', tone: 'empty' },
];
---
<figure class="gmsh">
  <div class="gmsh-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Comparison of s1[1:3] sharing capacity and overwriting s1[3] on append versus s1[1:3:3] capping capacity and forcing a fresh allocation.">
      <text x="20" y="28" class="gmsh-h">
        <tspan data-lang-en>1. Uncapped sub-slice: s2 := s1[1:3] inherits spare capacity, so append(s2, 99) overwrites s1[3]</tspan>
        <tspan data-lang-vi>1. Không khóa cap: s2 := s1[1:3] thừa hưởng phần dư của mảng, append(s2, 99) ghi đè lên s1[3]</tspan>
      </text>

      {/* Top left headers */}
      <rect x="16" y="54" width="180" height="72" rx="6" class="gmsh-hdr" />
      <text x="28" y="74" class="gmsh-b">s1 ([]int)</text>
      <text x="28" y="95" class="gmsh-m">ptr: &amp;arr[0]</text>
      <text x="28" y="114" class="gmsh-m">len: 5 · cap: 5</text>

      <rect x="16" y="138" width="180" height="72" rx="6" class="gmsh-hdr is-red" />
      <text x="28" y="158" class="gmsh-b-red">s2 := s1[1:3]</text>
      <text x="28" y="179" class="gmsh-m">ptr: &amp;arr[1]</text>
      <text x="28" y="198" class="gmsh-b-red">len: 2 · cap: 4</text>

      {/* Top backing array */}
      <text x="342" y="76" class="gmsh-lbl">
        <tspan data-lang-en>Shared backing array on the heap (after append(s2, 99))</tspan>
        <tspan data-lang-vi>Mảng nền dùng chung trên heap (sau khi chạy append(s2, 99))</tspan>
      </text>
      {valsTop.map((c, i) => {
        const x = 342 + i * 96;
        return (
          <g>
            <rect x={x} y="92" width="90" height="54" rx="5" class={`gmsh-cell is-${c.tone}`} />
            <text x={x + 45} y="114" text-anchor="middle" class="gmsh-idx">[{c.idx}]</text>
            <text x={x + 45} y="135" text-anchor="middle" class={c.tone === 'danger' ? 'gmsh-val-red' : 'gmsh-val'}>{c.v}</text>
          </g>
        );
      })}
      <text x="675" y="168" text-anchor="middle" class="gmsh-note-red">
        <tspan data-lang-en>was 40 — silently overwritten</tspan>
        <tspan data-lang-vi>vốn là 40 — bị ghi đè lên luôn</tspan>
      </text>

      <path d={pTopS1.line} class="gmsh-arrow" /><polygon points={pTopS1.head} class="gmsh-head" />
      <path d={pTopS2.line} class="gmsh-arrow is-red" /><polygon points={pTopS2.head} class="gmsh-head is-red" />

      <line x1="16" x2={W - 16} y1="226" y2="226" class="gmsh-rule" />

      {/* Bottom panel */}
      <text x="16" y="256" class="gmsh-h">
        <tspan data-lang-en>2. Full slice expression: s2 := s1[1:3:3] pins cap = 2, forcing append to allocate a new array</tspan>
        <tspan data-lang-vi>2. Khóa chặt cap: s2 := s1[1:3:3] giới hạn cap = 2, ép append cấp phát mảng mới tách biệt</tspan>
      </text>

      <rect x="16" y="276" width="180" height="62" rx="6" class="gmsh-hdr" />
      <text x="28" y="297" class="gmsh-b">s1 ([]int)</text>
      <text x="28" y="317" class="gmsh-m">len: 5 · cap: 5</text>

      <rect x="16" y="348" width="180" height="66" rx="6" class="gmsh-hdr is-ok" />
      <text x="28" y="369" class="gmsh-b-ok">s2 := s1[1:3:3]</text>
      <text x="28" y="388" class="gmsh-m">len: 2 · cap: 2</text>
      <text x="28" y="405" class="gmsh-b-ok">
        <tspan data-lang-en>append → new ptr</tspan>
        <tspan data-lang-vi>append → đổi ptr</tspan>
      </text>

      {/* Bottom arrays */}
      <text x="342" y="286" class="gmsh-lbl">
        <tspan data-lang-en>Original array untouched</tspan>
        <tspan data-lang-vi>Mảng gốc giữ nguyên</tspan>
      </text>
      {valsBotOrig.map((c, i) => {
        const x = 342 + i * 96;
        return (
          <g>
            <rect x={x} y="294" width="90" height="44" rx="5" class={`gmsh-cell is-${c.tone}`} />
            <text x={x + 45} y="312" text-anchor="middle" class="gmsh-idx">[{c.idx}]</text>
            <text x={x + 45} y="329" text-anchor="middle" class={c.tone === 'ok' ? 'gmsh-val-ok' : 'gmsh-val'}>{c.v}</text>
          </g>
        );
      })}

      <text x="342" y="358" class="gmsh-lbl-ok">
        <tspan data-lang-en>New array allocated by append(s2, 99)</tspan>
        <tspan data-lang-vi>Mảng mới được cấp phát khi append(s2, 99)</tspan>
      </text>
      {valsBotNew.map((c, i) => {
        const x = 342 + i * 96;
        return (
          <g>
            <rect x={x} y="366" width="90" height="44" rx="5" class={`gmsh-cell is-${c.tone}`} />
            <text x={x + 45} y="384" text-anchor="middle" class="gmsh-idx">[{c.idx}]</text>
            <text x={x + 45} y="401" text-anchor="middle" class={c.tone === 'ok' ? 'gmsh-val-ok' : 'gmsh-val'}>{c.v}</text>
          </g>
        );
      })}

      <path d={pBotS1.line} class="gmsh-arrow" /><polygon points={pBotS1.head} class="gmsh-head" />
      <path d={pBotS2.line} class="gmsh-arrow is-ok" /><polygon points={pBotS2.head} class="gmsh-head is-ok" />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A Go slice value is only a 24-byte header (pointer, length, capacity). When a sub-slice inherits spare capacity from its parent, calling append mutates the shared backing array in place.</span>
    <span data-lang-vi>Một biến slice thực chất chỉ là header 24 byte (con trỏ, độ dài, sức chứa). Khi slice con kế thừa sức chứa dư của slice cha, hàm append sẽ ghi đè trực tiếp lên vùng nhớ chung.</span>
  </figcaption>
</figure>

<style>
  .gmsh { margin: 2em 0; width: 100%; }
  .gmsh-scroll { overflow-x: auto; }
  .gmsh svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gmsh text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .gmsh .gmsh-h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .gmsh .gmsh-lbl { font-size: 12.5px; font-weight: 600; fill: var(--text-muted); }
  .gmsh .gmsh-lbl-ok { font-size: 12.5px; font-weight: 700; fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gmsh .gmsh-lbl-ok { fill: rgb(74, 222, 128); }
  .gmsh-hdr { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .gmsh-hdr.is-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .gmsh-hdr.is-ok { fill: var(--bg-alt); stroke: rgb(21, 128, 61); stroke-width: 1.6; }
  :global(html[data-theme='dark']) .gmsh-hdr.is-ok { stroke: rgb(74, 222, 128); }
  .gmsh-cell { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .gmsh-cell.is-shared { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .gmsh-cell.is-danger { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .gmsh-cell.is-ok { fill: var(--bg-alt); stroke: rgb(21, 128, 61); stroke-width: 1.5; }
  :global(html[data-theme='dark']) .gmsh-cell.is-ok { stroke: rgb(74, 222, 128); }
  .gmsh-cell.is-empty { fill: transparent; stroke: var(--border); stroke-dasharray: 4 3; }
  .gmsh-b { font-weight: 700; fill: var(--text); }
  .gmsh-b-red { font-weight: 700; fill: var(--red); }
  .gmsh-b-ok { font-weight: 700; fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gmsh-b-ok { fill: rgb(74, 222, 128); }
  .gmsh-m { fill: var(--text-muted); font-size: 12px; }
  .gmsh-idx { font-size: 11px; fill: var(--text-muted); }
  .gmsh-val { font-size: 15px; font-weight: 700; fill: var(--text); }
  .gmsh-val-red { font-size: 15px; font-weight: 800; fill: var(--red); }
  .gmsh-val-ok { font-size: 15px; font-weight: 800; fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gmsh-val-ok { fill: rgb(74, 222, 128); }
  .gmsh-note-red { font-size: 12.5px; font-weight: 700; fill: var(--red); }
  .gmsh-rule { stroke: var(--border); }
  .gmsh-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.6; }
  .gmsh-arrow.is-red { stroke: var(--red); }
  .gmsh-arrow.is-ok { stroke: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gmsh-arrow.is-ok { stroke: rgb(74, 222, 128); }
  .gmsh-head { fill: var(--text-muted); }
  .gmsh-head.is-red { fill: var(--red); }
  .gmsh-head.is-ok { fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gmsh-head.is-ok { fill: rgb(74, 222, 128); }
  .gmsh figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
