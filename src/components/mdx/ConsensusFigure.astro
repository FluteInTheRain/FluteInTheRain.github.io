---
// Frame for the Consensus* figures: scrolls sideways on phones, shows a plain-words caption,
// and holds the shared drawing classes (cfg-*). Site tokens only.
interface Props { aria: string; cap: string; w: number; h: number }
const { aria, cap, w, h } = Astro.props;
---
<figure class="cfg">
  <div class="cfg-scroll">
    <svg viewBox={`0 0 ${w} ${h}`} role="img" aria-label={aria}>
      <slot />
    </svg>
  </div>
  <figcaption>{cap}</figcaption>
</figure>
<style is:global>
  .cfg { margin: 2em 0; width: 100%; }
  .cfg-scroll { overflow-x: auto; }
  .cfg svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .cfg text { font-size: 13px; fill: var(--text-body); }
  .cfg .cfg-t { font-size: 16px; font-weight: 700; fill: var(--text); }
  .cfg .cfg-s { font-size: 12.5px; fill: var(--text-muted); }
  .cfg .cfg-n { font-size: 13px; font-weight: 700; fill: var(--text); }
  .cfg .cfg-m { font-size: 12px; fill: var(--text-muted); }
  .cfg .cfg-r { fill: var(--red); font-weight: 600; }
  .cfg .cfg-g { fill: var(--text); font-weight: 600; }
  .cfg .cfg-code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; fill: var(--text); }
  .cfg .cfg-step { font-size: 12px; font-weight: 700; fill: var(--text-muted); }
  .cfg-rule { stroke: var(--border); }
  .cfg-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .cfg-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .cfg-box.is-ok { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .cfg-box.is-dash { stroke-dasharray: 4 3; }
  .cfg-box.is-muted { opacity: 0.6; stroke-dasharray: 4 3; }
  .cfg-line { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .cfg-line.is-bad { stroke: var(--red); stroke-dasharray: 4 3; }
  .cfg-line.is-ok { stroke: var(--gold); }
  .cfg-line.is-dash { stroke-dasharray: 4 3; }
  .cfg-arrow { fill: none; stroke: var(--text); stroke-width: 1.5; }
  .cfg-arrow.is-bad { stroke: var(--red); }
  .cfg-arrow.is-ok { stroke: var(--gold-icon); }
  .cfg-arrow.is-dash { stroke-dasharray: 4 3; }
  .cfg-head { fill: var(--text); }
  .cfg-head.is-bad { fill: var(--red); }
  .cfg-head.is-ok { fill: var(--gold-icon); }
  .cfg-dot { fill: var(--text); }
  .cfg-dot.is-bad { fill: var(--red); }
  .cfg-dot.is-ok { fill: var(--gold-icon); }
  .cfg-cut { stroke: var(--red); stroke-width: 2; stroke-dasharray: 5 4; }
  .cfg figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
