---
// Years of data needed before an annualised Sharpe ratio S clears t = 2: years = (2 / S)^2.
// Python check: [(s, (2/s)**2) for s in (0.5, 1, 2, 3, 4, 8.21)] -> 16.0, 4.0, 1.0, 0.444, 0.25, 0.0593
const W = 900, H = 400;
const L = 90, R = 840, T = 84, B = 336;
const smin = 0.5, smax = 9;
const ymin = Math.log10(0.04), ymax = Math.log10(20);
const X = (s: number) => L + ((s - smin) / (smax - smin)) * (R - L);
const Y = (yr: number) => B - ((Math.log10(yr) - ymin) / (ymax - ymin)) * (B - T);
const pts: string[] = [];
for (let s = smin; s <= smax + 1e-9; s += 0.1) pts.push(`${pts.length ? 'L' : 'M'}${X(s).toFixed(1)} ${Y(Math.pow(2 / s, 2)).toFixed(1)}`);
const yt = [0.0625, 0.25, 1, 4, 16];
const ytl = [['3 weeks', '3 tuần'], ['3 months', '3 tháng'], ['1 year', '1 năm'], ['4 years', '4 năm'], ['16 years', '16 năm']];
const marks = [
  { s: 0.5, yr: 16, en: 'Sharpe 0.5: 16 years', vi: 'Sharpe 0.5: 16 năm', dx: 10, dy: -8, a: 'start' },
  { s: 1, yr: 4, en: 'Sharpe 1: 4 years', vi: 'Sharpe 1: 4 năm', dx: 10, dy: -10, a: 'start' },
  { s: 2, yr: 1, en: 'Sharpe 2: 1 year', vi: 'Sharpe 2: 1 năm', dx: 10, dy: -10, a: 'start' },
  { s: 4, yr: 0.25, en: 'Sharpe 4: 3 months', vi: 'Sharpe 4: 3 tháng', dx: 10, dy: -12, a: 'start' },
];
---
<figure class="p22t">
  <div class="p22t-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Curve of years of data needed for a Sharpe ratio to reach a t-statistic of 2. Sharpe 0.5 needs 16 years, 1 needs 4 years, 2 needs 1 year, 4 needs 3 months. The paper's reported Sharpe of 8.21 sits near 3 weeks of data.">
      <text x="20" y="28" class="h"><tspan data-lang-en>How long a record you need before a Sharpe ratio means something</tspan><tspan data-lang-vi>Cần chuỗi dữ liệu dài bao lâu thì một con số Sharpe mới có nghĩa</tspan></text>
      {yt.map((v, i) => (
        <g>
          <line x1={L} x2={R} y1={Y(v)} y2={Y(v)} class="grid" />
          <text x={L - 10} y={Y(v) + 4} text-anchor="end" class="tick"><tspan data-lang-en>{ytl[i][0]}</tspan><tspan data-lang-vi>{ytl[i][1]}</tspan></text>
        </g>
      ))}
      {[1, 2, 3, 4, 5, 6, 7, 8, 9].map((s) => (
        <text x={X(s)} y={B + 20} text-anchor="middle" class="tick">{s}</text>
      ))}
      <text x={R} y={B + 44} text-anchor="end" class="n"><tspan data-lang-en>Annualised Sharpe ratio of the strategy</tspan><tspan data-lang-vi>Sharpe quy năm của chiến lược</tspan></text>
      <text x="20" y="46" class="n"><tspan data-lang-en>Data needed for t = 2 (log scale)</tspan><tspan data-lang-vi>Dữ liệu cần cho t = 2 (thang log)</tspan></text>
      <path d={pts.join(' ')} class="curve" />
      {marks.map((m) => (
        <g>
          <circle cx={X(m.s)} cy={Y(m.yr)} r="4.5" class="dot" />
          <text x={X(m.s) + m.dx} y={Y(m.yr) + m.dy} text-anchor={m.a} class="lbl"><tspan data-lang-en>{m.en}</tspan><tspan data-lang-vi>{m.vi}</tspan></text>
        </g>
      ))}
      <line x1={L} x2={R} y1={Y(0.25)} y2={Y(0.25)} class="win" />
      <text x={L + 8} y={Y(0.25) - 8} class="win-t"><tspan data-lang-en>the paper's window: 3 months</tspan><tspan data-lang-vi>cửa sổ của bài báo: 3 tháng</tspan></text>
      <circle cx={X(8.21)} cy={Y(Math.pow(2 / 8.21, 2))} r="5" class="dot red" />
      <line x1={X(8.21)} x2={X(8.21)} y1={Y(Math.pow(2 / 8.21, 2)) - 7} y2={Y(Math.pow(2 / 8.21, 2)) - 30} class="lead" />
      <text x={R} y={Y(Math.pow(2 / 8.21, 2)) - 36} text-anchor="end" class="lbl red-t"><tspan data-lang-en>reported Sharpe 8.21</tspan><tspan data-lang-vi>Sharpe báo cáo 8,21</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Computed as years = (2 / Sharpe)², which assumes independent daily returns. In three months only a true Sharpe of 4 or more clears t = 2.</span>
    <span data-lang-vi>Tính bằng số năm = (2 / Sharpe)², giả sử lợi suất ngày độc lập. Trong ba tháng, chỉ Sharpe thật từ 4 trở lên mới đạt t = 2.</span>
  </figcaption>
</figure>

<style>
  .p22t { margin: 2em 0; width: 100%; }
  .p22t-scroll { overflow-x: auto; }
  .p22t svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .tick { font-size: 12.5px; fill: var(--text-muted); }
  .n { font-size: 12.5px; fill: var(--text-muted); }
  .lbl { font-size: 13px; font-weight: 700; fill: var(--text); }
  .red-t { fill: var(--red); }
  .grid { stroke: var(--border); }
  .lead { stroke: var(--red); stroke-width: 1.2; }
  .curve { fill: none; stroke: var(--text); stroke-width: 2.4; }
  .dot { fill: var(--text); }
  .dot.red { fill: var(--red); }
  .win { stroke: var(--gold-icon); stroke-width: 1.8; stroke-dasharray: 6 4; }
  .win-t { font-size: 12.5px; font-weight: 700; fill: var(--gold-icon); }
  .p22t figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
