---
// One item URL from the demo, read left to right: host, version,
// collection, one case. The noun part (collection + id) is the red
// accent — it is the part you design and clients depend on.
const segs = [
  {
    x: 165, w: 210, text: 'https://clue.api',
    l1: { en: 'which server', vi: 'server nào' },
    l2: { en: 'the host', vi: 'máy chủ' },
    red: false,
  },
  {
    x: 395, w: 80, text: '/v1',
    l1: { en: 'the version', vi: 'phiên bản' },
    l2: { en: 'of the contract', vi: 'của hợp đồng' },
    red: false,
  },
  {
    x: 495, w: 150, text: '/cases',
    l1: { en: 'the collection', vi: 'bộ sưu tập' },
    l2: { en: 'a plural noun', vi: 'danh từ số nhiều' },
    red: true,
  },
  {
    x: 665, w: 70, text: '/3',
    l1: { en: 'one case', vi: 'một vụ việc' },
    l2: { en: 'by its id', vi: 'theo id' },
    red: true,
  },
];
const W = 900, H = 236;
---
<figure class="bep2a">
  <div class="bep2a-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="The URL https://clue.api/v1/cases/3 split into four labeled parts: the host, the version of the contract, the collection cases, and one case by its id. The URL names a thing; the verb travels in the HTTP method.">
    {segs.map((s) => (
      <g>
        <rect x={s.x} y="24" width={s.w} height="48" rx="8" class={s.red ? 'boxr' : 'box'} />
        <text x={s.x + s.w / 2} y="54" text-anchor="middle" class="url">{s.text}</text>
        <path d={`M ${s.x + s.w / 2} 72 L ${s.x + s.w / 2} 86`} class="br" />
        <text x={s.x + s.w / 2} y="104" text-anchor="middle" class="l1"><tspan data-lang-en>{s.l1.en}</tspan><tspan data-lang-vi>{s.l1.vi}</tspan></text>
        <text x={s.x + s.w / 2} y="122" text-anchor="middle" class="l2"><tspan data-lang-en>{s.l2.en}</tspan><tspan data-lang-vi>{s.l2.vi}</tspan></text>
      </g>
    ))}
    <text x="450" y="176" text-anchor="middle" class="take"><tspan data-lang-en>the URL names a thing —</tspan><tspan data-lang-vi>URL gọi tên một thứ —</tspan></text>
    <text x="450" y="198" text-anchor="middle" class="take"><tspan data-lang-en>what you do with it travels in the method</tspan><tspan data-lang-vi>việc bạn LÀM GÌ với nó đi trong method</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>An item URL from the demo, read left to right: which server, which version of the contract, which collection, which one case. The verb is not in the URL — that slot belongs to the method.</span>
    <span data-lang-vi>URL một item của demo, đọc từ trái sang: server nào, phiên bản hợp đồng nào, bộ sưu tập nào, vụ việc số mấy. Verb không nằm trong URL — ô đó dành cho method.</span>
  </figcaption>
</figure>

<style>
  .bep2a { margin: 2em 0; width: 100%; }
  .bep2a-scroll { overflow-x: auto; }
  .bep2a svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep2a text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep2a .url { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep2a .l1 { fill: var(--text-body); font-size: 13.5px; }
  .bep2a .l2 { fill: var(--text-muted); font-size: 12.5px; }
  .bep2a .take { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep2a .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep2a .boxr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bep2a .br { stroke: var(--text-muted); stroke-width: 1.2; fill: none; }
  .bep2a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
