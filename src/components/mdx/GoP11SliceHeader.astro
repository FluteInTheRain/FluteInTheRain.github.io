---
// 24-byte runtime.slice header layout + shared capacity overwrite (s1[1:3]) vs full slice expression (s1[1:3:3]).
// Values match the standalone Go 1.27.1 run in Section 1.
const W = 900;
const H = 436;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const topArr = [
  { idx: '0', val: '10', tone: 'base' },
  { idx: '1', val: '20', tone: 'gold' },
  { idx: '2', val: '30', tone: 'gold' },
  { idx: '3', val: '99', tone: 'red' },
  { idx: '4', val: '50', tone: 'base' },
];

const botOrig = [
  { idx: '0', val: '10', tone: 'base' },
  { idx: '1', val: '20', tone: 'gold' },
  { idx: '2', val: '30', tone: 'gold' },
  { idx: '3', val: '40', tone: 'base' },
  { idx: '4', val: '50', tone: 'base' },
];

const botNew = [
  { idx: '0', val: '20', tone: 'gold' },
  { idx: '1', val: '30', tone: 'gold' },
  { idx: '2', val: '99', tone: 'gold' },
  { idx: '3', val: '—', tone: 'free' },
];

const aTopS1 = arrow(266, 79, 368, 79);
const aTopS2 = arrow(266, 152, 468, 128);
const aBotS1 = arrow(266, 290, 368, 290);
const aBotS2 = arrow(266, 368, 368, 368);
---
<figure class="gp11sh">
  <div class="gp11sh-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: s1 and s2 := s1[1:3] share one 5-slot backing array, so append(s2, 99) overwrites s1[3] from 40 to 99. Bottom: s2 := base[1:3:3] caps capacity at 2, so append allocates a new 4-slot array and leaves base[3] as 40.">
      {/* Panel 1: uncapped sub-slice */}
      <text x="16" y="26" class="h">
        <tspan data-lang-en>1. Uncapped slice: s2 := s1[1:3] inherits cap 4, so append overwrites s1[3]</tspan>
        <tspan data-lang-vi>1. Không khóa cap: s2 := s1[1:3] thừa hưởng cap 4, nên append ghi đè s1[3]</tspan>
      </text>

      <rect x="16" y="46" width="250" height="66" rx="6" class="box" />
      <text x="28" y="68" class="b">s1 (24-byte header)</text>
      <text x="28" y="92" class="m num">array: &amp;s1[0] · len: 5 · cap: 5</text>

      <rect x="16" y="122" width="250" height="66" rx="6" class="box bad" />
      <text x="28" y="144" class="r">s2 := s1[1:3]</text>
      <text x="28" y="168" class="m num">array: &amp;s1[1] · len: 2 · cap: 4</text>

      <text x="370" y="64" class="m">
        <tspan data-lang-en>Shared backing array after s2 = append(s2, 99)</tspan>
        <tspan data-lang-vi>Mảng nền dùng chung sau lệnh s2 = append(s2, 99)</tspan>
      </text>
      {topArr.map((c, i) => {
        const x = 370 + i * 102;
        return (
          <g>
            <rect x={x} y="76" width="90" height="50" rx="5" class={`cell ${c.tone}`} />
            <text x={x + 45} y="95" text-anchor="middle" class="m num">[{c.idx}]</text>
            <text x={x + 45} y="116" text-anchor="middle" class={c.tone === 'red' ? 'r num' : 'b num'}>{c.val}</text>
          </g>
        );
      })}
      <text x="721" y="152" text-anchor="middle" class="r">
        <tspan data-lang-en>was 40, overwritten in place</tspan>
        <tspan data-lang-vi>vốn là 40, bị ghi đè tại chỗ</tspan>
      </text>

      <path d={aTopS1.line} class="ln" /><polygon points={aTopS1.head} class="hd" />
      <path d={aTopS2.line} class="ln red" /><polygon points={aTopS2.head} class="hd red" />

      <line x1="16" x2={W - 16} y1="212" y2="212" class="rule" />

      {/* Panel 2: full slice expression */}
      <text x="16" y="244" class="h">
        <tspan data-lang-en>2. Full slice expression: safe := base[1:3:3] pins cap 2, forcing a new array</tspan>
        <tspan data-lang-vi>2. Khóa trần cap: safe := base[1:3:3] giữ cap 2, ép append xin mảng mới</tspan>
      </text>

      <rect x="16" y="264" width="250" height="62" rx="6" class="box" />
      <text x="28" y="286" class="b">base (24-byte header)</text>
      <text x="28" y="309" class="m num">array: &amp;base[0] · len: 5 · cap: 5</text>

      <rect x="16" y="338" width="250" height="72" rx="6" class="box gold" />
      <text x="28" y="360" class="b">safe := base[1:3:3]</text>
      <text x="28" y="381" class="m num">
        <tspan data-lang-en>before append: len 2 · cap 2</tspan>
        <tspan data-lang-vi>trước append: len 2 · cap 2</tspan>
      </text>
      <text x="28" y="400" class="g num">
        <tspan data-lang-en>after append: new array · cap 4</tspan>
        <tspan data-lang-vi>sau append: mảng mới · cap 4</tspan>
      </text>

      <text x="370" y="274" class="m">
        <tspan data-lang-en>Original backing array untouched</tspan>
        <tspan data-lang-vi>Mảng gốc giữ nguyên không đổi</tspan>
      </text>
      {botOrig.map((c, i) => {
        const x = 370 + i * 102;
        return (
          <g>
            <rect x={x} y="282" width="90" height="44" rx="5" class={`cell ${c.tone}`} />
            <text x={x + 45} y="300" text-anchor="middle" class="m num">[{c.idx}]</text>
            <text x={x + 45} y="318" text-anchor="middle" class="b num">{c.val}</text>
          </g>
        );
      })}

      <text x="370" y="348" class="g">
        <tspan data-lang-en>New array from append(safe, 99)</tspan>
        <tspan data-lang-vi>Mảng mới do append(safe, 99) cấp phát</tspan>
      </text>
      {botNew.map((c, i) => {
        const x = 370 + i * 102;
        return (
          <g>
            <rect x={x} y="356" width="90" height="44" rx="5" class={`cell ${c.tone}`} />
            <text x={x + 45} y="374" text-anchor="middle" class="m num">[{c.idx}]</text>
            <text x={x + 45} y="392" text-anchor="middle" class={c.tone === 'free' ? 'm num' : 'b num'}>{c.val}</text>
          </g>
        );
      })}

      <path d={aBotS1.line} class="ln" /><polygon points={aBotS1.head} class="hd" />
      <path d={aBotS2.line} class="ln gold" /><polygon points={aBotS2.head} class="hd gold" />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A slice variable is a 24-byte header (<code>array</code> pointer, <code>len</code>, <code>cap</code>). When <code>s2 := s1[1:3]</code> keeps spare capacity (<code>cap 4</code>), <code>append</code> writes <code>99</code> straight into <code>s1[3]</code>; pinning capacity with <code>base[1:3:3]</code> forces <code>append</code> to allocate a separate array.</span>
    <span data-lang-vi>Biến slice chỉ là header 24 byte (con trỏ <code>array</code>, <code>len</code>, <code>cap</code>). Khi <code>s2 := s1[1:3]</code> còn thừa sức chứa (<code>cap 4</code>), <code>append</code> ghi thẳng <code>99</code> đè lên <code>s1[3]</code>; khóa trần bằng <code>base[1:3:3]</code> buộc <code>append</code> xin mảng mới tách biệt.</span>
  </figcaption>
</figure>

<style>
  .gp11sh { margin: 2em 0; width: 100%; }
  .gp11sh-scroll { overflow-x: auto; }
  .gp11sh svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp11sh text { font-size: 14px; fill: var(--text-body); }
  .gp11sh .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp11sh .b { font-weight: 700; fill: var(--text); }
  .gp11sh .m { fill: var(--text-muted); }
  .gp11sh .r { fill: var(--red); font-weight: 700; }
  .gp11sh .g { fill: var(--gold-icon); font-weight: 700; }
  .gp11sh .num { font-variant-numeric: tabular-nums; }
  .gp11sh .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp11sh .box.bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .gp11sh .box.gold { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.4; }
  .gp11sh .cell { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .gp11sh .cell.gold { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .gp11sh .cell.red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .gp11sh .cell.free { fill: none; stroke: var(--border); stroke-dasharray: 4 3; }
  .gp11sh .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp11sh .ln.red { stroke: var(--red); }
  .gp11sh .ln.gold { stroke: var(--gold-icon); }
  .gp11sh .hd { fill: var(--text-muted); }
  .gp11sh .hd.red { fill: var(--red); }
  .gp11sh .hd.gold { fill: var(--gold-icon); }
  .gp11sh .rule { stroke: var(--border); stroke-width: 1; }
  .gp11sh figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
