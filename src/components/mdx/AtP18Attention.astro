---
// Mean aggregation vs attention for the same node (HPG). Scores are made up for the example; in a real
// graph attention network they come from a small learned function of both stocks' features.
// softmax([2.0, 0.5, -1.0, 0.0]) = [0.710, 0.158, 0.035, 0.096] and the weighted sum is 2.590 (calc.py).
const rows = [
  { n: 'HPG', en: 'itself', vi: 'chính nó', v: 3.0, s: 2.0 },
  { n: 'HSG', en: 'neighbour', vi: 'láng giềng', v: 2.4, s: 0.5 },
  { n: 'NKG', en: 'neighbour', vi: 'láng giềng', v: 2.8, s: -1.0 },
  { n: 'BID', en: 'neighbour', vi: 'láng giềng', v: -0.2, s: 0.0 },
];
const ex = rows.map((r) => Math.exp(r.s));
const tot = ex.reduce((a, b) => a + b, 0);
const att = ex.map((e) => e / tot);
const W = 900;
const H = 330;
const BX = 470; // bars start
const BW = 300; // width for weight 1.0
const f3 = (v: number) => v.toFixed(3);
const fmtVi = (s: string) => s.replace('.', ',');
const result = rows.reduce((a, r, i) => a + att[i] * r.v, 0);
---
<figure class="atp18-att">
  <div class="atp18-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Mean aggregation gives each of HPG's four inputs a weight of 0.25 and returns 2.0. Attention first scores each input, then turns the scores into weights that add to one: 0.710 for HPG itself, 0.158 for HSG, 0.035 for NKG and 0.096 for BID. The weighted sum is 2.59.">
      <text x="20" y="24" class="h">
        <tspan data-lang-en>Attention: the same neighbours, but the weights are learned</tspan>
        <tspan data-lang-vi>Attention: cùng láng giềng, nhưng trọng số được học</tspan>
      </text>
      <rect x="20" y="42" width="860" height="236" rx="8" class="panel" />
      <text x="36" y="68" class="col">
        <tspan data-lang-en>input to HPG</tspan>
        <tspan data-lang-vi>đầu vào của HPG</tspan>
      </text>
      <text x="190" y="68" class="col">
        <tspan data-lang-en>value</tspan>
        <tspan data-lang-vi>giá trị</tspan>
      </text>
      <text x="256" y="68" class="col">
        <tspan data-lang-en>score</tspan>
        <tspan data-lang-vi>điểm</tspan>
      </text>
      <text x={BX} y="68" class="col">
        <tspan data-lang-en>weight: mean (grey) vs attention (gold)</tspan>
        <tspan data-lang-vi>trọng số: trung bình (xám) so với attention (vàng)</tspan>
      </text>
      {rows.map((r, i) => (
        <g>
          <text x="36" y={104 + i * 40} class="lab">{r.n}</text>
          <text x="82" y={104 + i * 40} class="muted">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          <text x="190" y={104 + i * 40} class="num">
            <tspan data-lang-en>{r.v.toFixed(1)}</tspan>
            <tspan data-lang-vi>{fmtVi(r.v.toFixed(1))}</tspan>
          </text>
          <text x="256" y={104 + i * 40} class="num">
            <tspan data-lang-en>{r.s.toFixed(1)}</tspan>
            <tspan data-lang-vi>{fmtVi(r.s.toFixed(1))}</tspan>
          </text>
          <rect x={BX} y={90 + i * 40} width={0.25 * BW} height="8" rx="2" class="bm" />
          <rect x={BX} y={100 + i * 40} width={att[i] * BW} height="8" rx="2" class="ba" />
          <text x={BX + Math.max(0.25, att[i]) * BW + 10} y={104 + i * 40} class="muted">
            <tspan data-lang-en>0.250 vs {f3(att[i])}</tspan>
            <tspan data-lang-vi>0,250 so với {fmtVi(f3(att[i]))}</tspan>
          </text>
        </g>
      ))}
      <line x1="36" x2="864" y1="252" y2="252" class="rule" />
      <text x="36" y="270" class="res">
        <tspan data-lang-en>Mean of the four values: 2.00. Attention-weighted sum: {result.toFixed(2)}.</tspan>
        <tspan data-lang-vi>Trung bình bốn giá trị: 2,00. Tổng có trọng số attention: {fmtVi(result.toFixed(2))}.</tspan>
      </text>
      <text x="20" y="306" class="muted">
        <tspan data-lang-en>Weights = softmax of the scores, so they add up to 1. Scores are made up for the example.</tspan>
        <tspan data-lang-vi>Trọng số = softmax của các điểm, nên cộng lại bằng 1. Các điểm là số giả định cho ví dụ.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A graph attention network (Veličković et al., 2018) lets each stock decide how much to listen to each neighbour. The score is computed from the features of both stocks, not from the edge alone.</span>
    <span data-lang-vi>Graph attention network (Veličković và cộng sự, 2018) cho mỗi mã tự quyết nghe từng láng giềng bao nhiêu. Điểm được tính từ đặc trưng của cả hai mã, chứ không chỉ từ cạnh nối.</span>
  </figcaption>
</figure>

<style>
  .atp18-att { margin: 2em 0; width: 100%; }
  .atp18-scroll { overflow-x: auto; }
  .atp18-att svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp18-att .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .atp18-att .col { font-size: 12px; font-weight: 600; fill: var(--text-muted); }
  .atp18-att .lab { font-size: 13px; font-weight: 700; fill: var(--text); }
  .atp18-att .num { font-size: 13px; fill: var(--text-body); }
  .atp18-att .muted { font-size: 12px; fill: var(--text-muted); }
  .atp18-att .res { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .atp18-att .panel { fill: var(--bg-alt); stroke: var(--border); }
  .atp18-att .rule { stroke: var(--border); }
  .atp18-att .bm { fill: var(--text-faint); opacity: 0.6; }
  .atp18-att .ba { fill: var(--gold); }
  .atp18-att figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
