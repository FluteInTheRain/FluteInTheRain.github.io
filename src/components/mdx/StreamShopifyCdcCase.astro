---
// Shopify's move from query-based extraction (Longboat) to log-based CDC (Debezium + Kafka).
// Source: Shopify Engineering, "Capturing Every Change From Shopify's Sharded Monolith" (2021).
// Plain inline SVG, site CSS tokens, polygon arrowheads (no SVG ids). Labels come from the lang prop.
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const W = 900, H = 388;
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 8 * Math.cos(a - 0.45), y2 - 8 * Math.sin(a - 0.45)];
  const p2 = [x2 - 8 * Math.cos(a + 0.45), y2 - 8 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const T = {
  en: {
    h1: 'Before: Longboat polls the replicas for changed rows',
    h2: 'After: Debezium reads each shard\'s binlog into Kafka',
    shards: '100+ MySQL shards', replicas: 'read replicas',
    lb: 'Longboat', lbs: 'updated_at > last run, hourly',
    cs: 'Cloud storage', cs2: 'batch files',
    dw: 'Data warehouse', dw2: 'snapshots',
    b1: 'Hard deletes never show up', b2: 'Data is at least 1 hour old', b3: 'Edits between two runs are lost',
    my: 'MySQL shards', mys: 'binlog',
    db: 'Debezium', dbs: 'connector per shard',
    ts: 'Kafka topic', tss: 'one per shard',
    ks: 'Kafka Streams', kss: 'split by table',
    tt: 'Table topics', tts: 'keyed by PK',
    g1: 'Deletes and every intermediate edit arrive as events', g2: 'p99 from MySQL insert to Kafka: under 10 seconds',
    alt: 'Top: Longboat queries 100+ MySQL shard replicas with updated_at, at most once an hour, and writes batch files to cloud storage for the data warehouse, missing hard deletes and intermediate edits. Bottom: one Debezium connector per shard reads the binlog into a Kafka topic per shard, a Kafka Streams app splits records into one compacted topic per table keyed by primary key.',
    cap: 'Shopify\'s data extraction before and after log-based CDC. Redrawn from the description in the Shopify Engineering post.',
  },
  vi: {
    h1: 'Trước: Longboat quét replica tìm dòng đã đổi',
    h2: 'Sau: Debezium đọc binlog từng shard đẩy vào Kafka',
    shards: 'Hơn 100 shard MySQL', replicas: 'replica chỉ đọc',
    lb: 'Longboat', lbs: 'updated_at > lần chạy trước',
    cs: 'Cloud storage', cs2: 'file theo lô',
    dw: 'Kho dữ liệu', dw2: 'bản snapshot',
    b1: 'Lệnh xoá cứng không bao giờ hiện ra', b2: 'Dữ liệu trễ ít nhất 1 giờ', b3: 'Sửa giữa hai lần chạy bị mất',
    my: 'Các shard MySQL', mys: 'binlog',
    db: 'Debezium', dbs: 'connector mỗi shard',
    ts: 'Topic Kafka', tss: 'một topic mỗi shard',
    ks: 'Kafka Streams', kss: 'tách theo bảng',
    tt: 'Topic theo bảng', tts: 'khoá là PK',
    g1: 'Lệnh xoá và mọi lần sửa trung gian đều thành sự kiện', g2: 'p99 từ lúc MySQL ghi tới lúc vào Kafka: dưới 10 giây',
    alt: 'Trên: Longboat truy vấn replica của hơn 100 shard MySQL bằng updated_at, tối đa mỗi giờ một lần, ghi file theo lô vào cloud storage cho kho dữ liệu, bỏ sót lệnh xoá cứng và các lần sửa trung gian. Dưới: mỗi shard có một connector Debezium đọc binlog vào một topic Kafka, rồi ứng dụng Kafka Streams tách thành mỗi bảng một topic compacted với khoá là primary key.',
    cap: 'Cách Shopify lấy dữ liệu trước và sau khi dùng CDC dựa trên log. Vẽ lại theo mô tả trong bài của Shopify Engineering.',
  },
}[lang];
const bh = 66;
const row1 = [
  { x: 20, w: 190, n: T.shards, s: T.replicas },
  { x: 262, w: 230, n: T.lb, s: T.lbs, off: true },
  { x: 544, w: 150, n: T.cs, s: T.cs2 },
  { x: 746, w: 134, n: T.dw, s: T.dw2 },
];
const y1 = 44;
const row2x = [20, 197, 374, 551, 728];
const row2 = [[T.my, T.mys], [T.db, T.dbs], [T.ts, T.tss], [T.ks, T.kss], [T.tt, T.tts]];
const y2 = 250, w2 = 152;
const ar1 = row1.slice(0, -1).map((b, i) => arrow(b.x + b.w, y1 + bh / 2, row1[i + 1].x, y1 + bh / 2));
const ar2 = row2x.slice(0, -1).map((x, i) => arrow(x + w2, y2 + bh / 2, row2x[i + 1], y2 + bh / 2));
---
<figure class="ssc">
  <div class="ssc-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={T.alt}>
    <text x="20" y="24" class="h">{T.h1}</text>
    {row1.map((b) => (
      <g class={b.off ? 'box off' : 'box'}>
        <rect x={b.x} y={y1} width={b.w} height={bh} rx="7" />
        <text x={b.x + b.w / 2} y={y1 + 28} text-anchor="middle" class="name">{b.n}</text>
        <text x={b.x + b.w / 2} y={y1 + 48} text-anchor="middle" class="sub">{b.s}</text>
      </g>
    ))}
    {ar1.map((a) => (<g class="arr"><path d={a.line} /><polygon points={a.head} /></g>))}
    <text x="262" y="148" class="bad">{T.b1}</text>
    <text x="262" y="168" class="bad">{T.b2}</text>
    <text x="262" y="188" class="bad">{T.b3}</text>
    <line x1="20" x2={W - 20} y1="212" y2="212" class="rule" />
    <text x="20" y="238" class="h">{T.h2}</text>
    {row2x.map((x, i) => (
      <g class="box">
        <rect x={x} y={y2 + 0} width={w2} height={bh} rx="7" />
        <text x={x + w2 / 2} y={y2 + 28} text-anchor="middle" class="name">{row2[i][0]}</text>
        <text x={x + w2 / 2} y={y2 + 48} text-anchor="middle" class="sub">{row2[i][1]}</text>
      </g>
    ))}
    {ar2.map((a) => (<g class="arr"><path d={a.line} /><polygon points={a.head} /></g>))}
    <text x="20" y="348" class="name">{T.g1}</text>
    <text x="20" y="370" class="sub">{T.g2}</text>
  </svg>
  </div>
  <figcaption>{T.cap}</figcaption>
</figure>

<style>
  .ssc { margin: 2em 0; width: 100%; }
  .ssc-scroll { overflow-x: auto; }
  .ssc svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .ssc text { font-size: 14px; fill: var(--text-body); }
  .ssc .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ssc .name { font-weight: 700; fill: var(--text); }
  .ssc .sub { font-size: 13px; fill: var(--text-muted); font-variant-numeric: tabular-nums; }
  .ssc .bad { font-size: 13px; fill: var(--red); }
  .ssc .num { font-size: 13px; font-weight: 700; fill: var(--text); font-variant-numeric: tabular-nums; }
  .ssc .box rect { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .ssc .box.off rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .ssc .box.dash rect { stroke-dasharray: 4 4; fill: none; }
  .ssc .arr path { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .ssc .arr polygon { fill: var(--text-muted); }
  .ssc .arr.bad path { stroke: var(--red); stroke-dasharray: 5 4; }
  .ssc .arr.bad polygon { fill: var(--red); }
  .ssc .rule { stroke: var(--border); stroke-width: 1; }
  .ssc figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
