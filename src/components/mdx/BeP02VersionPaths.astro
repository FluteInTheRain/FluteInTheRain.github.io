---
// A version is a promise. The /v1 box is the red accent: the surface
// clients coded against, which keeps its shape. The new shape ships
// beside it as /v2 for clients that opt in.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 280;
---
<figure class="bep2f">
  <div class="bep2f-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="One service, two versioned paths. The v1 box keeps the response shape clients coded against — same fields, same types, same meaning. The v2 box carries the new shape, for clients that opt in. A version is a promise.">
    <rect x="60" y="30" width="170" height="56" rx="8" class="svc" />
    <circle cx="89" cy="58" r="16" class="disc" />
    <image href="/icons/flow/fastapi.svg" x="76" y="45" width="26" height="26" class="icn" aria-hidden="true" />
    <text x="112" y="63" class="t">clue.api</text>
    {(() => { const a = arrow(230, 58, 344, 58); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
    {(() => { const a = arrow(230, 58, 344, 188); return <g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>; })()}
    <rect x="350" y="30" width="260" height="56" rx="8" class="boxr" />
    <text x="480" y="55" text-anchor="middle" class="ver">/v1/cases</text>
    <text x="480" y="74" text-anchor="middle" class="sub"><tspan data-lang-en>the version clients coded against</tspan><tspan data-lang-vi>phiên bản client đã code theo</tspan></text>
    <text x="480" y="106" text-anchor="middle" class="an"><tspan data-lang-en>same fields, same types, same meaning</tspan><tspan data-lang-vi>vẫn field đó, kiểu đó, nghĩa đó</tspan></text>
    <text x="480" y="124" text-anchor="middle" class="an"><tspan data-lang-en>no renames, no removals, no type flips</tspan><tspan data-lang-vi>không đổi tên, không bỏ field, không đổi kiểu</tspan></text>
    <rect x="350" y="160" width="260" height="56" rx="8" class="box" />
    <text x="480" y="185" text-anchor="middle" class="ver">/v2/cases</text>
    <text x="480" y="204" text-anchor="middle" class="sub"><tspan data-lang-en>the new shape, for those who opt in</tspan><tspan data-lang-vi>hình dạng mới, muốn thì chuyển</tspan></text>
    <text x="480" y="236" text-anchor="middle" class="an"><tspan data-lang-en>the change that would break v1 clients</tspan><tspan data-lang-vi>thay đổi vốn làm gãy client v1</tspan></text>
    <text x="450" y="262" text-anchor="middle" class="take r"><tspan data-lang-en>a version is a promise — responses keep their shape until clients choose to move</tspan><tspan data-lang-vi>một phiên bản là một lời hứa — response giữ nguyên hình dạng cho tới khi client chọn chuyển</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The promise, drawn: /v1 keeps answering with the shape clients depend on — that is what "coded against it" means. The new shape ships beside it as /v2, and each client moves when its own code is ready. Change the shape under a live version and every client breaks at once.</span>
    <span data-lang-vi>Lời hứa, vẽ ra: /v1 vẫn trả đúng hình dạng mà client đang dựa vào — đó là nghĩa của "đã code theo nó". Hình mới phát hành cạnh đó thành /v2, client nào sẵn sàng thì tự chuyển. Đổi hình dạng dưới một version đang sống là gãy hết mọi client cùng một lúc.</span>
  </figcaption>
</figure>

<style>
  .bep2f { margin: 2em 0; width: 100%; }
  .bep2f-scroll { overflow-x: auto; }
  .bep2f svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep2f text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep2f .t { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep2f .ver { font-weight: 700; fill: var(--text); font-size: 16px; }
  .bep2f .sub { fill: var(--text-body); font-size: 12px; }
  .bep2f .an { fill: var(--text-muted); font-size: 12.5px; }
  .bep2f .take { font-weight: 700; fill: var(--text); font-size: 14.5px; }
  .bep2f .r { fill: var(--red); }
  .bep2f .svc { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep2f .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep2f .boxr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bep2f .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep2f .hd { fill: var(--text-muted); }
  .bep2f .disc { fill: none; }
  .bep2f figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  :global([data-theme='dark']) .bep2f .disc { fill: rgba(255, 255, 255, 0.88); }
</style>
