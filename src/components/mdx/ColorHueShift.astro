---
// Visual showdown: naive linear HSL lightness vs hue-shifted + saturation-boosted yellow ladder,
// plus cool vs pure vs warm grey comparison. Swatches show real HSL colors; all chrome uses site tokens.

const naiveYellow = [
  { stop: 100, h: 48, s: 85, l: 92 },
  { stop: 300, h: 48, s: 85, l: 74 },
  { stop: 500, h: 48, s: 85, l: 52 },
  { stop: 700, h: 48, s: 85, l: 34 },
  { stop: 900, h: 48, s: 85, l: 18 },
];

const shiftedYellow = [
  { stop: 100, h: 54, s: 96, l: 92 },
  { stop: 300, h: 50, s: 94, l: 72 },
  { stop: 500, h: 45, s: 92, l: 50 },
  { stop: 700, h: 35, s: 90, l: 36 },
  { stop: 900, h: 26, s: 86, l: 21 },
];

const greys = [
  {
    nameEn: 'Pure neutral (0% sat)',
    nameVi: 'Xám trung tính (0% bão hòa)',
    swatches: ['hsl(0, 0%, 94%)', 'hsl(0, 0%, 74%)', 'hsl(0, 0%, 48%)', 'hsl(0, 0%, 26%)', 'hsl(0, 0%, 13%)'],
  },
  {
    nameEn: 'Cool slate (215° blue tint)',
    nameVi: 'Xám lạnh (pha xanh 215°)',
    swatches: ['hsl(214, 24%, 94%)', 'hsl(215, 18%, 74%)', 'hsl(215, 16%, 47%)', 'hsl(217, 22%, 26%)', 'hsl(220, 30%, 13%)'],
  },
  {
    nameEn: 'Warm stone (35° amber tint)',
    nameVi: 'Xám ấm (pha vàng cam 35°)',
    swatches: ['hsl(36, 22%, 94%)', 'hsl(34, 15%, 74%)', 'hsl(32, 12%, 47%)', 'hsl(30, 14%, 26%)', 'hsl(28, 18%, 13%)'],
  },
];

const W = 900;
const H = 375;
const padL = 24;
const swW = 160;
const gap = 13;
---

<figure class="chs">
  <div class="chs-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Comparison of naive linear HSL yellow turning muddy olive in dark shades versus hue-shifted yellow rotating toward warm amber, followed by pure, cool, and warm grey strips.">
      {/* Top showdown: Naive HSL */}
      <text x={padL} y="24" class="chs-h">
        <tspan data-lang-en>Fixed hue (48°), linear lightness — dark yellows turn muddy olive</tspan>
        <tspan data-lang-vi>Giữ nguyên sắc (48°), giảm sáng tuyến tính — vàng đậm biến thành nâu bùn</tspan>
      </text>
      {naiveYellow.map((c, i) => {
        const x = padL + i * (swW + gap);
        return (
          <g>
            <rect x={x} y="36" width={swW} height="54" rx="6" fill={`hsl(${c.h}, ${c.s}%, ${c.l}%)`} class="chs-sw" />
            <text x={x + 10} y="58" fill={c.l > 55 ? '#1f2937' : '#ffffff'} class="chs-stop">{c.stop}</text>
            <text x={x + 10} y="78" fill={c.l > 55 ? '#374151' : '#f3f4f6'} class="chs-meta">{c.h}° · {c.s}% · {c.l}%</text>
          </g>
        );
      })}

      {/* Bottom showdown: Hue-shifted */}
      <text x={padL} y="122" class="chs-h-accent">
        <tspan data-lang-en>Hue rotated toward orange (54° → 26°) + boosted saturation — stays warm and rich</tspan>
        <tspan data-lang-vi>Xoay sắc về cam (54° → 26°) + tăng bão hòa — giữ trọn độ ấm và độ tươi</tspan>
      </text>
      {shiftedYellow.map((c, i) => {
        const x = padL + i * (swW + gap);
        return (
          <g>
            <rect x={x} y="134" width={swW} height="54" rx="6" fill={`hsl(${c.h}, ${c.s}%, ${c.l}%)`} class="chs-sw" />
            <text x={x + 10} y="156" fill={c.l > 55 ? '#1f2937' : '#ffffff'} class="chs-stop">{c.stop}</text>
            <text x={x + 10} y="176" fill={c.l > 55 ? '#374151' : '#f3f4f6'} class="chs-meta">{c.h}° · {c.s}% · {c.l}%</text>
          </g>
        );
      })}

      {/* Divider */}
      <line x1={padL} x2={W - padL} y1="214" y2="214" class="chs-div" />

      {/* Grey temperature section */}
      <text x={padL} y="242" class="chs-h">
        <tspan data-lang-en>Greys carry temperature: tint with blue for cool, amber for warm</tspan>
        <tspan data-lang-vi>Màu xám có nhiệt độ: pha xanh để mát mắt, pha vàng cam để ấm áp</tspan>
      </text>
      {greys.map((g, row) => {
        const y = 258 + row * 38;
        return (
          <g>
            <text x={padL} y={y + 19} class="chs-glabel">
              <tspan data-lang-en>{g.nameEn}</tspan>
              <tspan data-lang-vi>{g.nameVi}</tspan>
            </text>
            {g.swatches.map((color, col) => (
              <rect x={300 + col * 114} y={y} width="106" height="28" rx="4" fill={color} class="chs-sw" />
            ))}
          </g>
        );
      })}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Two knobs control perceived brightness: lightness and hue. Rotating yellow 20–25° toward orange keeps dark shades crisp instead of muddy, and a subtle hue tint gives greys real character.</span>
    <span data-lang-vi>Độ sáng cảm nhận có hai nút vặn: lightness và hue. Xoay vàng 20–25° về phía cam giúp sắc tối gọn sạch thay vì xỉn đục, còn pha nhẹ sắc độ giúp bộ xám có cá tính hơn.</span>
  </figcaption>
</figure>

<style>
  .chs { margin: 2em 0; width: 100%; }
  .chs-scroll { overflow-x: auto; }
  .chs svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .chs text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .chs text.chs-h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .chs text.chs-h-accent { font-size: 14.5px; font-weight: 700; fill: var(--red); }
  .chs text.chs-stop { font-size: 14px; font-weight: 700; }
  .chs text.chs-meta { font-size: 12px; }
  .chs text.chs-glabel { font-size: 13px; fill: var(--text-muted); }
  .chs-sw { stroke: var(--border); stroke-width: 1; }
  .chs-div { stroke: var(--border); stroke-width: 1; }
  .chs figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
