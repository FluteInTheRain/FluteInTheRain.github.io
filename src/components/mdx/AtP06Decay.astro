---
// McLean & Pontiff (2016, Journal of Finance 71(1)): 97 return predictors. Average monthly portfolio return per period,
// as reported in the CFA Institute digest of the paper: 0.582% in the original sample, 0.402% after the sample but before publication,
// 0.264% after publication.
const bars = [
  { en: 'Original sample', vi: 'Mẫu gốc của bài báo', v: 0.582 },
  { en: 'After the sample, before publication', vi: 'Sau mẫu, trước khi công bố', v: 0.402 },
  { en: 'After publication', vi: 'Sau khi công bố', v: 0.264 },
];
const L = 60, BASE = 286, S = 300;
---
<figure class="p06i">
  <div class="p06i-scroll">
    <svg viewBox="0 0 900 330" role="img" aria-label="Average monthly return of 97 published stock-return predictors: 0.582 percent in the original sample, 0.402 percent after the sample but before publication, 0.264 percent after publication.">
      <text x="20" y="26" class="h"><tspan data-lang-en>97 published predictors lose strength once they are known</tspan><tspan data-lang-vi>97 yếu tố dự báo đã công bố yếu đi khi mọi người biết tới</tspan></text>
      <text x="20" y="48" class="m"><tspan data-lang-en>Average monthly portfolio return (%), McLean and Pontiff</tspan><tspan data-lang-vi>Lợi nhuận danh mục trung bình mỗi tháng (%), McLean và Pontiff</tspan></text>
      <line x1={L} x2="860" y1={BASE} y2={BASE} class="axis" />
      {bars.map((b, i) => (
        <g>
          <rect x={L + 40 + i * 260} y={BASE - b.v * S} width="150" height={b.v * S} rx="3" class={i === 2 ? 'bar red' : 'bar'} />
          <text x={L + 115 + i * 260} y={BASE - b.v * S - 8} class="n" text-anchor="middle">{b.v.toFixed(3)}</text>
          <text x={L + 115 + i * 260} y={BASE + 20} class="m" text-anchor="middle"><tspan data-lang-en>{b.en}</tspan><tspan data-lang-vi>{b.vi}</tspan></text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Figures from the CFA Institute digest of the paper. The digest states the drops as 26 and 58 percentage points for out of sample and after publication.</span>
    <span data-lang-vi>Số liệu từ bản tóm tắt của CFA Institute về bài báo. Bản tóm tắt nêu mức giảm là 26 và 58 điểm phần trăm cho giai đoạn ngoài mẫu và sau khi công bố.</span>
  </figcaption>
</figure>
<style>
  .p06i { margin: 2em 0; width: 100%; }
  .p06i-scroll { overflow-x: auto; }
  .p06i svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .p06i text { font-size: 13px; fill: var(--text-body); }
  .p06i .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p06i .m { fill: var(--text-muted); font-size: 12.5px; }
  .p06i .n { font-size: 14px; font-weight: 700; fill: var(--text); }
  .p06i .axis { stroke: var(--text-faint); stroke-width: 1.2; }
  .p06i .bar { fill: var(--text-faint); }
  .p06i .bar.red { fill: var(--red); }
  .p06i figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
