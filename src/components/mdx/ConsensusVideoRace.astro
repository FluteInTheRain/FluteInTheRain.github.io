---
// Cross-channel race: the job on the fast queue arrives before the file reaches its read replica.
// Static SVG, site tokens only. Ordering only; no timings are claimed.
import ConsensusFigure from './ConsensusFigure.astro';
import DiagramIcon from './DiagramIcon.astro';
import { head } from './consensus-fig';
interface Props { lang: 'en' | 'vi' }
const { lang } = Astro.props;

const T = {
  en: {
    aria: 'Four numbered steps. 1: the web server uploads a video to object storage. Replication to the read replica is slow. 2: the web server puts a transcode job on the queue, which is fast. 3: the worker pulls the job at once. 4: the worker reads the video from the read replica, where it has not arrived yet, so it transcodes an old file or fails.',
    web: 'Web server', store: 'Object storage', repl: 'Read replica', queue: 'Job queue', worker: 'Worker',
    storeSub: 'has the video', replSub: 'video not here yet', queueSub: 'fast', workerSub: 'transcode job',
    a1: '1  upload video', a1r: 'replication: slow', a2: '2  enqueue job', a3: '3  pulls job at once', a4: '4  reads the video',
    res: ['The job outran the video: the worker transcodes an old file or fails.'],
    cap: 'The queue is faster than storage replication, so the second channel overtakes the first.',
  },
  vi: {
    aria: 'Bốn bước đánh số. 1: web server tải video lên object storage. Việc sao chép sang bản đọc rất chậm. 2: web server đưa job transcode vào hàng đợi, rất nhanh. 3: worker lấy job ngay. 4: worker đọc video từ bản đọc, nơi video chưa tới, nên nó transcode tệp cũ hoặc lỗi.',
    web: 'Web server', store: 'Object storage', repl: 'Bản đọc', queue: 'Hàng đợi job', worker: 'Worker',
    storeSub: 'đã có video', replSub: 'chưa có video', queueSub: 'nhanh', workerSub: 'job transcode',
    a1: '1  tải video lên', a1r: 'sao chép: chậm', a2: '2  đưa job vào', a3: '3  lấy job ngay', a4: '4  đọc video',
    res: ['Job chạy trước video: worker transcode tệp cũ hoặc bị lỗi.'],
    cap: 'Hàng đợi nhanh hơn việc sao chép của storage, nên kênh thứ hai vượt mặt kênh thứ nhất.',
  },
}[lang];

const bw = 170, bh = 58;
const nodes = [
  { id: 'web', x: 20, y: 40, icon: 'server', name: T.web, sub: '', kind: '' },
  { id: 'store', x: 365, y: 40, icon: 'disk', name: T.store, sub: T.storeSub, kind: '' },
  { id: 'repl', x: 710, y: 40, icon: 'db', name: T.repl, sub: T.replSub, kind: 'is-bad' },
  { id: 'queue', x: 365, y: 190, icon: 'log', name: T.queue, sub: T.queueSub, kind: '' },
  { id: 'worker', x: 710, y: 190, icon: 'worker', name: T.worker, sub: T.workerSub, kind: '' },
];
---
<ConsensusFigure aria={T.aria} cap={T.cap} w={900} h={320}>
  {nodes.map((n) => (
    <g>
      <rect x={n.x} y={n.y} width={bw} height={bh} rx="6" class={`cfg-box ${n.kind}`} />
      <DiagramIcon name={n.icon as any} x={n.x + 26} y={n.y + bh / 2} size={26} />
      <text x={n.x + 52} y={n.y + (n.sub ? 25 : 34)} class="cfg-n">{n.name}</text>
      {n.sub && <text x={n.x + 52} y={n.y + 44} class={`cfg-m ${n.kind === 'is-bad' ? 'cfg-r' : ''}`}>{n.sub}</text>}
    </g>
  ))}
  {/* 1 web -> storage */}
  <path d="M 190 69 L 357 69" class="cfg-arrow" /><polygon points={head(190, 69, 365, 69)} class="cfg-head" />
  <text x="277" y="60" text-anchor="middle" class="cfg-g">{T.a1}</text>
  {/* storage -> replica, slow */}
  <path d="M 535 69 L 702 69" class="cfg-arrow is-dash" /><polygon points={head(535, 69, 710, 69)} class="cfg-head" />
  <text x="622" y="60" text-anchor="middle" class="cfg-m">{T.a1r}</text>
  <DiagramIcon name="hourglass" x={622} y={88} size={18} />
  {/* 2 web -> queue */}
  <path d="M 105 98 L 105 219 L 357 219" class="cfg-arrow" /><polygon points={head(300, 219, 365, 219)} class="cfg-head" />
  <text x="115" y="170" class="cfg-g">{T.a2}</text>
  {/* 3 queue -> worker */}
  <path d="M 535 219 L 702 219" class="cfg-arrow" /><polygon points={head(535, 219, 710, 219)} class="cfg-head" />
  <text x="622" y="210" text-anchor="middle" class="cfg-g">{T.a3}</text>
  {/* 4 worker -> replica */}
  <path d="M 795 190 L 795 106" class="cfg-arrow is-bad" /><polygon points={head(795, 190, 795, 98)} class="cfg-head is-bad" />
  <text x="785" y="150" text-anchor="end" class="cfg-r">{T.a4}</text>
  <rect x="20" y="272" width="860" height="38" rx="6" class="cfg-box is-bad" />
  <text x="450" y="296" text-anchor="middle" class="cfg-g">{T.res[0]}</text>
</ConsensusFigure>
