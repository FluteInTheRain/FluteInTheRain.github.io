---
// Type switch walk-through for the second describe() program: which case each input reaches.
// Cases are checked top to bottom; cells after the first match are blank (never checked).
const W = 900;
const H = 320;
const cases = ['int', 'string', 'Circle', 'fmt.Stringer', 'nil', 'default'];
const inputs = [
  { v: '41', match: 0, out: 'int 42' },
  { v: '"Phở"', match: 1, out: 'string of length 5' },
  { v: 'Circle{R: 2}', match: 2, out: 'circle radius 2.0' },
  { v: 'Square{Side: 3}', match: 5, out: 'unknown main.Square', hot: true },
  { v: 'nil', match: 4, out: 'nothing' },
];
const x0 = 160;
const cw = 88;
const top = 84;
const rh = 40;
---
<figure class="p04e">
  <div class="p04e-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="For each input to describe, the cases int, string, Circle, fmt.Stringer, nil and default are tried top to bottom and the first match runs. 41 matches int, Phở matches string, Circle matches Circle, Square matches none and reaches default, nil matches nil.">
    <text x="20" y="46" class="m"><tspan data-lang-en>Input</tspan><tspan data-lang-vi>Đầu vào</tspan></text>
    {cases.map((c, i) => (
      <g>
        <text x={x0 + i * cw + cw / 2} y="30" text-anchor="middle" class="m">{c === 'default' ? '' : 'case'}</text>
        <text x={x0 + i * cw + cw / 2} y="50" text-anchor="middle" class="b">{c}</text>
      </g>
    ))}
    <text x="710" y="46" class="m"><tspan data-lang-en>describe returns</tspan><tspan data-lang-vi>describe trả về</tspan></text>
    <line x1="20" x2="880" y1="64" y2="64" class="rule" />
    {inputs.map((r, ri) => {
      const y = top + ri * rh;
      return (
        <g>
          <text x="20" y={y + 24} class="b">{r.v}</text>
          {cases.map((c, ci) => {
            if (ci > r.match) return null;
            const cx = x0 + ci * cw + cw / 2;
            return ci === r.match ? (
              <g>
                <rect x={x0 + ci * cw + 8} y={y + 4} width={cw - 16} height="28" rx="5" class={r.hot ? 'hot' : 'cell'} />
                <text x={cx} y={y + 23} text-anchor="middle" class={r.hot ? 'r' : 'b'}>
                  <tspan data-lang-en>match</tspan><tspan data-lang-vi>khớp</tspan>
                </text>
              </g>
            ) : (
              <text x={cx} y={y + 23} text-anchor="middle" class="m">
                <tspan data-lang-en>no</tspan><tspan data-lang-vi>không</tspan>
              </text>
            );
          })}
          <text x="710" y={y + 24} class={r.hot ? 'r' : 'b'}>{r.out}</text>
        </g>
      );
    })}
    <text x="20" y="306" class="m"><tspan data-lang-en>Square has no String method, so it fails every case and reaches default.</tspan><tspan data-lang-vi>Square không có method String, nên trượt mọi case và rơi vào default.</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Cases are tried from top to bottom and the first match wins. A blank cell means that case was never checked.</span>
    <span data-lang-vi>Các case được thử từ trên xuống và case khớp đầu tiên thắng. Ô trống nghĩa là case đó chưa bao giờ được kiểm tra.</span>
  </figcaption>
</figure>

<style>
  .p04e { margin: 2em 0; width: 100%; }
  .p04e-scroll { overflow-x: auto; }
  .p04e svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p04e text { font-size: 14px; fill: var(--text-body); }
  .p04e .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .p04e .m { fill: var(--text-muted); }
  .p04e .b { font-weight: 700; fill: var(--text); }
  .p04e .r { fill: var(--red); font-weight: 700; }
  .p04e .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .p04e .cell { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p04e .hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .p04e .dash { fill: none; stroke: var(--red); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .p04e .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .p04e .ar { fill: var(--text-muted); }
  .p04e .lnr { fill: none; stroke: var(--red); stroke-width: 1.5; }
  .p04e .arr { fill: var(--red); }
  .p04e .rule { stroke: var(--border); stroke-width: 1; }
  .p04e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
