---
// One Pydantic class, three jobs: it validates what arrives, filters what
// leaves (response_model), and publishes itself to /docs. The class card is
// the one red thing — one place to write the rules.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 300;
const rows = [
  { mid: 62, icon: 'detective', disc: false, title: { en: 'validates what arrives', vi: 'kiểm thứ gửi tới' }, sub: { en: 'the 422 at the door', vi: '422 ngay tại cửa' }, note: { en: 'bad input never reaches you', vi: 'input xấu không tới nổi tay bạn' } },
  { mid: 152, icon: 'scissors', disc: false, title: { en: 'filters what leaves', vi: 'lọc thứ gửi đi' }, sub: { en: 'response_model = CaseOut', vi: 'response_model = CaseOut' }, note: { en: 'internal fields are dropped', vi: 'field nội bộ bị cắt bỏ' } },
  { mid: 242, icon: 'swagger', disc: true, title: { en: 'publishes itself to /docs', vi: 'tự xuất bản lên /docs' }, sub: { en: 'openapi.json, generated', vi: 'openapi.json, tự sinh' }, note: { en: 'callers see the rules up front', vi: 'caller thấy luật trước khi gửi' } },
];
const paths = [
  'M 290 130 L 335 130 L 335 62 L 380 62',
  'M 290 152 L 380 152',
  'M 290 180 L 335 180 L 335 242 L 380 242',
];
const heads = [arrow(335, 62, 380, 62).head, arrow(290, 152, 380, 152).head, arrow(335, 242, 380, 242).head];
---
<figure class="bep3d">
  <div class="bep3d-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="One Pydantic class does three jobs: validates incoming requests, filters the outgoing response through response_model, and publishes its own schema to the /docs page.">
    <rect x="50" y="110" width="240" height="90" rx="8" class="boxr" />
    <image href="/icons/flow/python.svg" x="155" y="122" width="30" height="30" class="icn" aria-hidden="true" />
    <text x="170" y="170" text-anchor="middle" class="tt">CaseCreate</text>
    <text x="170" y="190" text-anchor="middle" class="m"><tspan data-lang-en>one class, written once</tspan><tspan data-lang-vi>một class, viết đúng một lần</tspan></text>
    {paths.map((d, i) => (
      <g>
        <path d={d} class="ln" />
        <polygon points={heads[i]} class="hd" />
      </g>
    ))}
    {rows.map((r) => (
      <g>
        <rect x="380" y={r.mid - 32} width="280" height="64" rx="8" class="box" />
        <circle cx="408" cy={r.mid} r="14" class="st" />
        {r.disc && <circle cx="408" cy={r.mid} r="18" class="disc" />}
        <image href={`/icons/flow/${r.icon}.svg`} x="394" y={r.mid - 14} width="28" height="28" class="icn" aria-hidden="true" />
        <text x="436" y={r.mid - 2} class="t"><tspan data-lang-en>{r.title.en}</tspan><tspan data-lang-vi>{r.title.vi}</tspan></text>
        <text x="436" y={r.mid + 20} class="m"><tspan data-lang-en>{r.sub.en}</tspan><tspan data-lang-vi>{r.sub.vi}</tspan></text>
        <text x="680" y={r.mid + 5} class="a"><tspan data-lang-en>{r.note.en}</tspan><tspan data-lang-vi>{r.note.vi}</tspan></text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Write the rules once, in the model — validation, response filtering and the /docs contract all read from the same class.</span>
    <span data-lang-vi>Viết luật một lần, ngay trong model — validation, lọc response và contract trên /docs cùng đọc từ đúng class đó.</span>
  </figcaption>
</figure>

<style>
  .bep3d { margin: 2em 0; width: 100%; }
  .bep3d-scroll { overflow-x: auto; }
  .bep3d svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep3d text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep3d .t { font-weight: 700; fill: var(--text); }
  .bep3d .tt { font-weight: 700; fill: var(--red); font-size: 15px; }
  .bep3d .m { fill: var(--text-muted); font-size: 12.5px; }
  .bep3d .a { fill: var(--text-body); font-size: 13.5px; }
  .bep3d .st { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; }
  .bep3d .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep3d .boxr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bep3d .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep3d .hd { fill: var(--text-muted); }
  .bep3d .disc { fill: none; }
  .bep3d figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
  :global([data-theme='dark']) .bep3d .disc { fill: rgba(255, 255, 255, 0.88); }
</style>
