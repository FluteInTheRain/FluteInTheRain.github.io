---
// Assumed record: an index-future rule, long at the open and out at the close, six years of daily data:
// 783 up days and 717 down days = 1,500 days. A fair coin over 1,500 flips: mean 750, sd = sqrt(1500 x 0.25) = 19.36.
// Exact two-sided binomial p for 783 or 717: 0.093 (scipy). The bell curve is the normal approximation.
const N = 1500, MEAN = N / 2, SD = Math.sqrt(N * 0.25);
const X0 = 60, X1 = 860, K0 = MEAN - 3.2 * SD, K1 = MEAN + 3.2 * SD, YB = 290, YH = 190;
const kx = (k: number) => X0 + ((k - K0) / (K1 - K0)) * (X1 - X0);
const pdf = (k: number) => Math.exp(-0.5 * ((k - MEAN) / SD) ** 2);
const ky = (k: number) => YB - pdf(k) * YH;
function area(a: number, b: number) {
  let d = `M ${kx(a).toFixed(1)} ${YB}`;
  for (let i = 0; i <= 40; i++) { const k = a + ((b - a) * i) / 40; d += ` L ${kx(k).toFixed(1)} ${ky(k).toFixed(1)}`; }
  return d + ` L ${kx(b).toFixed(1)} ${YB} Z`;
}
let curve = '';
for (let i = 0; i <= 120; i++) { const k = K0 + ((K1 - K0) * i) / 120; curve += `${i ? 'L' : 'M'} ${kx(k).toFixed(1)} ${ky(k).toFixed(1)} `; }
const ticks = [700, 720, 750, 780, 800];
---
<figure class="apcd">
  <div class="apcd-scroll">
  <svg viewBox="0 0 900 380" role="img" aria-label="A bell curve of the number of up days a fair coin gives over 1,500 flips, centred on 750. The observed 783 up days sits just right of the centre. The two tails beyond 783 and 717 are shaded and together hold 28 percent of the probability.">
    <text x="20" y="28" class="apcd-h">
      <tspan data-lang-en>52% up days is what a fair coin does</tspan>
      <tspan data-lang-vi>52% ngày tăng là chuyện đồng xu công bằng vẫn làm</tspan>
    </text>
    <text x="20" y="50" class="apcd-sub">
      <tspan data-lang-en>Up days out of 1,500 flips of a fair coin</tspan>
      <tspan data-lang-vi>Số ngày tăng trong 1.500 lần tung đồng xu công bằng</tspan>
    </text>
    <path d={area(K0, MEAN - 33)} class="apcd-tail" />
    <path d={area(MEAN + 33, K1)} class="apcd-tail" />
    <path d={curve} class="apcd-curve" />
    <line x1={X0} x2={X1} y1={YB} y2={YB} class="apcd-axis" />
    {ticks.map((k) => (
      <g>
        <line x1={kx(k)} x2={kx(k)} y1={YB} y2={YB + 5} class="apcd-axis" />
        <text x={kx(k)} y={YB + 22} text-anchor="middle" class="apcd-tick">{k}</text>
      </g>
    ))}
    <line x1={kx(MEAN + 33)} x2={kx(MEAN + 33)} y1="70" y2={YB} class="apcd-obs" />
    <text x={kx(MEAN + 33) + 8} y="84" class="apcd-lab is-red">
      <tspan data-lang-en>783 up days (52.2%)</tspan>
      <tspan data-lang-vi>783 ngày tăng (52,2%)</tspan>
    </text>
    <text x={kx(MEAN + 33) + 8} y="102" class="apcd-sub2">
      <tspan data-lang-en>the strategy's record</tspan>
      <tspan data-lang-vi>kết quả của chiến lược</tspan>
    </text>
    <line x1={kx(MEAN - 33)} x2={kx(MEAN - 33)} y1="120" y2={YB} class="apcd-obs is-dash" />
    <text x={kx(MEAN - 33) - 8} y="134" text-anchor="end" class="apcd-lab">
      <tspan data-lang-en>717: the mirror image</tspan>
      <tspan data-lang-vi>717: phía đối xứng</tspan>
    </text>
    <text x={kx(MEAN)} y="340" text-anchor="middle" class="apcd-num">
      <tspan data-lang-en>Shaded tails: a fair coin lands there 9% of the time (p = 0.09)</tspan>
      <tspan data-lang-vi>Phần tô: đồng xu công bằng rơi vào đó 9% số lần (p = 0,09)</tspan>
    </text>
    <text x={kx(MEAN)} y="362" text-anchor="middle" class="apcd-sub2">
      <tspan data-lang-en>z = (783 − 750) ÷ 19.4 = 1.70, well under the usual 1.96</tspan>
      <tspan data-lang-vi>z = (783 − 750) ÷ 19,4 = 1,70, thấp xa mức 1,96 thường dùng</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Say a rule on an index future buys at the open and sells at the close every day for six years and logs 783 up days and 717 down days. Taken as a coin-flip test, that record is ordinary.</span>
    <span data-lang-vi>Giả sử một quy tắc trên hợp đồng tương lai chỉ số mua ở giá mở cửa, bán ở giá đóng cửa mỗi ngày trong sáu năm và ghi 783 ngày tăng, 717 ngày giảm. Nhìn như một bài test tung đồng xu, kết quả đó rất bình thường.</span>
  </figcaption>
</figure>

<style>
  .apcd { margin: 2em 0; width: 100%; }
  .apcd-scroll { overflow-x: auto; }
  .apcd svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .apcd text { font-size: 14px; fill: var(--text-body); }
  .apcd .apcd-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .apcd .apcd-sub, .apcd .apcd-sub2 { fill: var(--text-muted); font-size: 13px; }
  .apcd .apcd-tick { fill: var(--text-muted); font-size: 12.5px; }
  .apcd .apcd-lab { font-size: 13.5px; font-weight: 600; fill: var(--text); }
  .apcd .apcd-lab.is-red { fill: var(--red); }
  .apcd .apcd-num { font-size: 14px; font-weight: 700; fill: var(--text); }
  .apcd-tail { fill: var(--red-tint-bg); stroke: none; }
  .apcd-curve { fill: none; stroke: var(--text); stroke-width: 1.8; }
  .apcd-axis { stroke: var(--text-muted); stroke-width: 1.2; }
  .apcd-obs { stroke: var(--red); stroke-width: 2; }
  .apcd-obs.is-dash { stroke-dasharray: 4 4; stroke-width: 1.5; }
  .apcd figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
