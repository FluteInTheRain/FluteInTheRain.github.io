---
// Four systems on one line, from "code decides every step" to "the model decides". Definitions follow
// Anthropic's "Building effective agents": workflows run predefined code paths; agents direct their own process.
import DiagramIcon from './DiagramIcon.astro';
const rows = [
  { icon: 'model', t: { en: 'One call', vi: 'Một lần gọi' }, who: { en: 'Code decides', vi: 'Code quyết' }, ex: { en: 'Summarise this filing', vi: 'Tóm tắt báo cáo này' } },
  { icon: 'link', t: { en: 'Fixed chain', vi: 'Chuỗi cố định' }, who: { en: 'Code decides', vi: 'Code quyết' }, ex: { en: 'Extract figures, check them, then write', vi: 'Trích số, kiểm tra, rồi viết' } },
  { icon: 'tree', t: { en: 'Router', vi: 'Bộ định tuyến' }, who: { en: 'Model picks a branch', vi: 'Model chọn nhánh' }, ex: { en: 'Classify a headline, send it to the right handler', vi: 'Phân loại tiêu đề, chuyển đúng bộ xử lý' } },
  { icon: 'loop', t: { en: 'Agent', vi: 'Agent' }, who: { en: 'Model decides every step', vi: 'Model quyết từng bước' }, ex: { en: 'Find out why margins fell, however many steps it takes', vi: 'Tìm vì sao biên lợi nhuận giảm, bao nhiêu bước cũng được' } },
] as const;
const W = 900;
const H = 280;
---
<figure class="a21s">
  <div class="a21s-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four systems from least to most autonomous: one call, a fixed chain, a router, and an agent. In the first two, code decides every step. In a router the model picks a branch. In an agent the model decides each step. Predictability falls and cost and error risk rise from left to right.">
      <text x="20" y="28" class="a21s-h">
        <tspan data-lang-en>Who decides the next step?</tspan>
        <tspan data-lang-vi>Ai quyết định bước kế tiếp?</tspan>
      </text>
      {rows.map((r, i) => (
        <g>
          <rect x={20 + i * 218} y="52" width="202" height="150" rx="8" class={i === 3 ? 'a21s-card is-key' : 'a21s-card'} />
          <DiagramIcon name={r.icon} x={20 + i * 218 + 26} y="78" size={22} />
          <text x={20 + i * 218 + 48} y="83" class="a21s-t"><tspan data-lang-en>{r.t.en}</tspan><tspan data-lang-vi>{r.t.vi}</tspan></text>
          <text x={20 + i * 218 + 14} y="116" class={i === 3 ? 'a21s-who is-key' : 'a21s-who'}><tspan data-lang-en>{r.who.en}</tspan><tspan data-lang-vi>{r.who.vi}</tspan></text>
          <foreignObject x={20 + i * 218 + 10} y="128" width="182" height="70">
            <p xmlns="http://www.w3.org/1999/xhtml" class="a21s-ex"><span data-lang-en>{r.ex.en}</span><span data-lang-vi>{r.ex.vi}</span></p>
          </foreignObject>
        </g>
      ))}
      <line x1="30" y1="236" x2="860" y2="236" class="a21s-axis" />
      <polygon points="872,236 860,230 860,242" class="a21s-axish" />
      <text x="30" y="262" class="a21s-ax"><tspan data-lang-en>More predictable, easier to test</tspan><tspan data-lang-vi>Dễ đoán, dễ kiểm thử hơn</tspan></text>
      <text x="870" y="262" text-anchor="end" class="a21s-ax is-key"><tspan data-lang-en>More flexible, more ways to go wrong</tspan><tspan data-lang-vi>Linh hoạt hơn, nhiều cách sai hơn</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The first two are workflows; the last one is an agent. Anthropic's advice: use the simplest one that does the job, and move right only when the task needs it.</span>
    <span data-lang-vi>Hai ô đầu là workflow; ô cuối là agent. Lời khuyên của Anthropic: dùng loại đơn giản nhất làm được việc, chỉ dịch sang phải khi việc đòi hỏi.</span>
  </figcaption>
</figure>

<style>
  .a21s { margin: 2em 0; width: 100%; }
  .a21s-scroll { overflow-x: auto; }
  .a21s svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .a21s text { font-size: 13px; fill: var(--text-body); }
  .a21s .a21s-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .a21s .a21s-t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .a21s .a21s-who { font-size: 12.5px; font-weight: 700; fill: var(--text-muted); }
  .a21s .a21s-who.is-key { fill: var(--gold-icon); }
  .a21s .a21s-ax { font-size: 12.5px; fill: var(--text-muted); }
  .a21s .a21s-ax.is-key { fill: var(--red); }
  .a21s .a21s-ex { margin: 0; font-size: 13px; line-height: 1.4; color: var(--text-body); font-family: inherit; }
  .a21s-card { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .a21s-card.is-key { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .a21s-axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .a21s-axish { fill: var(--text-muted); }
  .a21s figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
