---
// Self-hosted clip. Keep files small (a few MB); use <YouTube> for anything long.
interface Props { src: string; poster?: string; caption?: string; loop?: boolean; autoplay?: boolean }
const { src, poster, caption, loop = false, autoplay = false } = Astro.props;
---
<figure class="figure">
  <video src={src} poster={poster} controls={!autoplay} muted={autoplay} autoplay={autoplay} loop={loop} playsinline preload="metadata"></video>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
