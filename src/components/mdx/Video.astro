---
// Self-hosted clip. Keep files small (a few MB); use <YouTube> for anything long.
interface Props {
  src: string;
  poster?: string;
  caption?: string;
  loop?: boolean;
  autoplay?: boolean;
  sourceTitle?: string;
  sourceUrl?: string;
}
const { src, poster, caption, loop = false, autoplay = false, sourceTitle, sourceUrl } = Astro.props;
---
<figure class="figure">
  <video src={src} poster={poster} controls={!autoplay} muted={autoplay} autoplay={autoplay} loop={loop} playsinline preload="metadata"></video>
  {(caption || sourceTitle) && (
    <figcaption>
      {caption}
      {sourceTitle && (
        <span class="figure-source">
          {caption ? ' · Source: ' : 'Source: '}
          {sourceUrl ? <a href={sourceUrl} rel="noopener" target="_blank">{sourceTitle}</a> : sourceTitle}
        </span>
      )}
    </figcaption>
  )}
</figure>
