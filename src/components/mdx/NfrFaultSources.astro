---
import DiagramIcon from './DiagramIcon.astro';
import NfrText from './NfrText.astro';
import NfrArrow from './NfrArrow.astro';
import NfrStep from './NfrStep.astro';
import './nfr-fig.css';
// Three places faults come from: what it looks like and how it behaves. All claims are from the post text.
const W = 900;
const H = 230;
const cards = [
  { x: 20, icon: 'disk', en: 'Hardware', vi: 'Phần cứng', a: ['A disk dies. With 10,000 disks,', 'expect one every single day.'], av: ['Một ổ đĩa chết. Với 10,000 ổ,', 'mỗi ngày đều có một ổ chết.'], b: ['Independent: neighbours', 'are fine.'], bv: ['Độc lập: các ổ bên cạnh', 'vẫn ổn.'] },
  { x: 320, icon: 'warning', en: 'Software', vi: 'Phần mềm', a: ['A leap second, a runaway', 'query, a thundering herd.'], av: ['Giây nhuận, truy vấn nặng,', 'thundering herd.'], b: ['Correlated: the same bug', 'hits every replica.'], bv: ['Tương quan: cùng một bug', 'đánh mọi replica.'] },
  { x: 620, icon: 'user', en: 'Human', vi: 'Con người', a: ['An operator pushes a wrong', 'configuration.'], av: ['Người vận hành đẩy một', 'cấu hình sai.'], b: ['Leading cause of outages:', 'over 70% of downtime.'], bv: ['Nguyên nhân hàng đầu gây sập:', 'hơn 70% thời gian ngừng.'] },
] as const;
const L = (v: readonly string[]) => v as unknown as string[];
---
<figure class="nf">
  <div class="nf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three sources of faults. Hardware: a disk dies, independent of its neighbours. Software: the same bug hits every replica. Human: operator configuration errors cause over 70% of downtime.">
      {cards.map((c) => (
        <g>
          <rect x={c.x} y="10" width="260" height="206" rx="8" class="box" />
          <DiagramIcon name={c.icon} x={c.x + 34} y={44} size={30} />
          <NfrText x={c.x + 64} y={50} cls="h" en={c.en} vi={c.vi} />
          <NfrText x={c.x + 18} y={96} cls="s" en="What happens" vi="Chuyện gì xảy ra" />
          <NfrText x={c.x + 18} y={114} lh={16} en={L(c.a)} vi={L(c.av)} />
          <NfrText x={c.x + 18} y={160} cls="s" en="How it behaves" vi="Nó lan thế nào" />
          <NfrText x={c.x + 18} y={178} lh={16} cls="n" en={L(c.b)} vi={L(c.bv)} />
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The three need different defences, which is why the post treats them one by one.</span>
    <span data-lang-vi>Ba nguồn này cần ba cách phòng thủ khác nhau, nên bài xử lý từng nguồn một.</span>
  </figcaption>
</figure>
