---
import BatchDiagram from './BatchDiagram.astro';
const X = [20, 345, 670];
const W = 210;
const boxes = [
  { x: X[0], y: 46, w: W, h: 56, icon: 'spark', t: ['200 Spark tasks', '200 task Spark'], s: [['in parallel', 'chạy song song']] },
  { x: 670, y: 46, w: W, h: 56, icon: 'postgres', t: ['Production Postgres', 'Postgres production'], s: [['serving live traffic', 'đang phục vụ khách']], kind: 'hot' },
  { x: X[0], y: 190, w: W, h: 56, icon: 'worker', t: ['Batch job', 'Job batch'], s: [['runs to the end', 'chạy tới khi xong']] },
  { x: X[1], y: 190, w: W, h: 56, icon: 'kafka', t: ['Kafka topic', 'Kafka topic'], s: [['buffer between networks', 'vùng đệm giữa hai mạng']] },
  { x: X[2], y: 190, w: W, h: 56, icon: 'db', t: ['Serving database', 'Database phục vụ'], s: [['pulls at its own pace', 'tự kéo theo nhịp riêng']] },
  { x: X[0], y: 334, w: W, h: 56, icon: 'worker', t: ['Batch job', 'Job batch'], s: [['builds the whole dataset', 'dựng trọn bộ dữ liệu']] },
  { x: X[1], y: 334, w: W, h: 56, icon: 's3', t: ['Immutable files', 'File bất biến'], s: [['SSTables / segments in S3', 'SSTable/segment trên S3']] },
  { x: X[2], y: 334, w: W, h: 56, icon: 'db', t: ['Serving store', 'Kho phục vụ'], s: [['swaps to new version', 'tráo sang bản mới']], kind: 'good' },
];
const arrows = [
  { x1: 230, y1: 74, x2: 670, y2: 74, kind: 'hot', label: ['row-by-row INSERT / UPDATE', 'INSERT / UPDATE từng dòng'] },
  { x1: 230, y1: 218, x2: 345, y2: 218, label: ['publish', 'đẩy vào'] },
  { x1: 555, y1: 218, x2: 670, y2: 218, label: ['pull', 'kéo về'] },
  { x1: 230, y1: 362, x2: 345, y2: 362, label: ['write', 'ghi ra'] },
  { x1: 555, y1: 362, x2: 670, y2: 362, kind: 'good', label: ['ingest + swap', 'nạp + tráo'] },
];
const texts = [
  { x: 20, y: 26, cls: 'h', t: ['A. Direct writes (avoid)', 'A. Ghi thẳng vào OLTP (nên tránh)'] },
  { x: 20, y: 126, cls: 'warn', t: ['Connection pools saturate, p99 spikes, and a retried task duplicates rows.', 'Connection pool nghẽn, p99 tăng vọt, task chạy lại thì lặp dòng.'] },
  { x: 20, y: 170, cls: 'h', t: ['B. Kafka buffer plus a commit signal', 'B. Đệm qua Kafka kèm tín hiệu commit'] },
  { x: 20, y: 270, cls: 'foot', t: ['Consumers hide the new data until the "done" event arrives.', 'Bên nhận ẩn dữ liệu mới cho tới khi có sự kiện "xong".'] },
  { x: 20, y: 314, cls: 'h', t: ['C. Bulk-built immutable files', 'C. Dựng sẵn file bất biến'] },
  { x: 20, y: 414, cls: 'ok', t: ['Live reads are untouched; rolling back means swapping to the old version.', 'Luồng đọc không bị đụng tới; muốn lùi chỉ cần tráo về bản cũ.'] },
] as const;
---
<BatchDiagram
  w={900} h={430}
  aria="Three ways to deliver batch output. A: 200 Spark tasks write row by row into production Postgres, which hurts live traffic. B: the batch job publishes to Kafka and the serving database pulls at its own pace. C: the batch job builds immutable files in S3 and the serving store swaps to the new version atomically."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any} rules={[150, 294]}
  caption={['Three ways to hand batch output to a serving system. Only B and C keep a batch retry away from live users.', 'Ba cách giao đầu ra batch cho hệ thống phục vụ. Chỉ B và C giữ cho việc chạy lại job batch không chạm tới người dùng thật.']}
/>
