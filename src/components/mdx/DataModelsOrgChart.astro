---
import DiagramIcon from './DiagramIcon.astro';
// The org-chart question from the post, everyone who reports to Ana at any depth, shown as a small tree and the two ways to ask it.
// Arrowheads are polygons: no SVG ids.
const W = 900;
const H = 330;
type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}
const frames: any[] = [];
const boxes: any[] = [];
const links: any[] = [];
const labels: any[] = [];
const nums: any[] = [];
frames.push({ x: 10, y: 10, w: 362, h: 310 });
boxes.push(
  { x: 140, y: 30, w: 110, h: 36, icon: 'user', is: 20, flat: true, en: ['Ana'], vi: ['Ana'] },
  { x: 30, y: 110, w: 110, h: 36, icon: 'user', is: 20, kind: 'good', flat: true, en: ['Ben'], vi: ['Ben'] },
  { x: 250, y: 110, w: 110, h: 36, icon: 'user', is: 20, kind: 'good', flat: true, en: ['Cho'], vi: ['Cho'] },
  { x: 30, y: 180, w: 110, h: 36, icon: 'user', is: 20, kind: 'good', flat: true, en: ['Dee'], vi: ['Dee'] },
  { x: 30, y: 250, w: 110, h: 36, icon: 'user', is: 20, kind: 'good', flat: true, en: ['Eli'], vi: ['Eli'] },
);
links.push(
  { pts: [[85, 110], [85, 88], [195, 88], [195, 66]] },
  { pts: [[305, 110], [305, 88], [195, 88], [195, 66]], plain: true },
  { pts: [[85, 180], [85, 146]] },
  { pts: [[85, 250], [85, 216]] },
);
labels.push(
  { x: 96, y: 104, en: 'reports to', vi: 'báo cáo cho', cls: 'muted' },
  { x: 160, y: 202, en: 'Ben, Cho, Dee and Eli all', vi: 'Ben, Cho, Dee và Eli đều', cls: 'strong' },
  { x: 160, y: 220, en: 'report to Ana, at depths', vi: 'báo cáo cho Ana, ở độ sâu', cls: 'strong' },
  { x: 160, y: 238, en: '1, 1, 2 and 3.', vi: '1, 1, 2 và 3.', cls: 'strong' },
);
boxes.push(
  { x: 390, y: 10, w: 500, h: 100, kind: 'good', flat: true, en: [''], vi: [''] },
  { x: 390, y: 130, w: 500, h: 190, flat: true, en: [''], vi: [''] },
);
labels.push(
  { x: 432, y: 38, en: 'Cypher: 2 lines', vi: 'Cypher: 2 dòng', cls: 'h' },
  { x: 408, y: 66, en: "MATCH (e:Employee)-[:REPORTS_TO*1..]->(:Employee {name: 'Ana'})", cls: 'mono' },
  { x: 408, y: 88, en: 'RETURN e.name;', cls: 'mono' },
  { x: 432, y: 158, en: 'SQL: a recursive CTE, 7 lines', vi: 'SQL: recursive CTE, 7 dòng', cls: 'h' },
  { x: 408, y: 186, en: 'WITH RECURSIVE under_ana(id) AS (', cls: 'mono' },
  { x: 408, y: 206, en: '  SELECT id FROM employees WHERE manager_id = …', cls: 'mono' },
  { x: 408, y: 226, en: '  UNION', cls: 'mono' },
  { x: 408, y: 246, en: '  SELECT e.id FROM employees e JOIN under_ana u …', cls: 'mono' },
  { x: 408, y: 266, en: ')', cls: 'mono' },
  { x: 408, y: 286, en: 'SELECT name FROM employees WHERE id IN (…);', cls: 'mono' },
  { x: 408, y: 308, en: 'You write the loop yourself (abridged).', vi: 'Bạn tự viết vòng lặp (đã rút gọn).', cls: 'muted' },
);
---
<figure class="dmoc">
  <div class="dmoc-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A small org chart: Ben and Cho report to Ana, Dee reports to Ben, Eli reports to Dee. Everyone who reports to Ana at any depth means Ben, Cho, Dee and Eli. In Cypher it is 2 lines, using REPORTS_TO with *1.. for one or more hops. In SQL it is a recursive common table expression of 7 lines where you write the loop yourself.">
    {frames.map((f) => (
      <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="6" class={`dmoc-frame ${f.kind ?? ''}`} />
    ))}
    {boxes.map((b) => {
      const n = Math.max(b.en.length, b.vi.length);
      const top = !!b.top;
      const cx = b.x + b.w / 2;
      const x0 = top ? cx : b.icon ? b.x + 46 : b.x + 14;
      const y0 = top ? b.y + (b.icon ? 56 : 24) : b.y + b.h / 2 - ((n - 1) * 17) / 2 + 4;
      return (
        <g class={`dmoc-box ${b.kind ?? ''}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
          {b.icon && <DiagramIcon name={b.icon} x={top ? cx : b.x + 24} y={top ? b.y + 24 : b.y + b.h / 2} size={b.is ?? 26} />}
          {Array.from({ length: n }).map((_, i) => (
            <text x={x0} y={y0 + i * 17} text-anchor={top ? 'middle' : 'start'} class={i === 0 && !b.flat ? 'dmoc-name' : 'dmoc-sub'}>
              <tspan data-lang-en>{b.en[i] ?? ''}</tspan>
              <tspan data-lang-vi>{b.vi[i] ?? ''}</tspan>
            </text>
          ))}
        </g>
      );
    })}
    {links.map((l) => {
      const a = arrow(l.pts);
      return (
        <g>
          <polyline points={l.plain ? l.pts.map((p) => p.join(',')).join(' ') : a.line} class={`dmoc-edge ${l.kind ?? ''}`} fill="none" />
          {!l.plain && <polygon points={a.head} class={`dmoc-head ${l.kind ?? ''}`} />}
        </g>
      );
    })}
    {labels.map((t) => (
      <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`dmoc-lab ${t.cls ?? ''}`}>
        <tspan data-lang-en>{t.en}</tspan>
        <tspan data-lang-vi>{t.vi ?? t.en}</tspan>
      </text>
    ))}
    {nums.map((n) => (
      <g class="dmoc-num">
        <circle cx={n.x} cy={n.y} r="11" />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.n}</text>
      </g>
    ))}
    <DiagramIcon name="network" x={410} y={32} size={24} />
    <DiagramIcon name="db" x={410} y={152} size={24} />
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The *1.. in Cypher means follow the edge one or more times. SQL has no such shortcut, so the loop is written out by hand.</span>
    <span data-lang-vi>Dấu *1.. trong Cypher nghĩa là đi theo cạnh một hoặc nhiều lần. SQL không có lối tắt đó nên vòng lặp phải tự viết ra.</span>
  </figcaption>
</figure>

<style>
  .dmoc { margin: 2em 0; width: 100%; }
  .dmoc-scroll { overflow-x: auto; }
  .dmoc svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dmoc text { font-size: 14px; fill: var(--text-body); }
  .dmoc .dmoc-name { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .dmoc .dmoc-sub { font-size: 12px; fill: var(--text-muted); }
  .dmoc .dmoc-lab { font-size: 13px; }
  .dmoc .dmoc-lab.h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dmoc .dmoc-lab.strong { font-weight: 700; fill: var(--text); }
  .dmoc .dmoc-lab.muted { fill: var(--text-muted); }
  .dmoc .dmoc-lab.bad { font-weight: 700; fill: var(--red); }
  .dmoc .dmoc-lab.good { font-weight: 700; fill: var(--text); }
  .dmoc .dmoc-lab.mono, .dmoc .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .dmoc-frame { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .dmoc-frame.bad { stroke: var(--red); }
  .dmoc-frame.good { stroke: var(--gold); }
  .dmoc-box rect { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmoc-box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dmoc-box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmoc-box.plain rect { fill: none; stroke: var(--border); }
  .dmoc-edge { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmoc-edge.bad { stroke: var(--red); }
  .dmoc-edge.good { stroke: var(--gold-icon); }
  .dmoc-head { fill: var(--text-muted); }
  .dmoc-head.bad { fill: var(--red); }
  .dmoc-head.good { fill: var(--gold-icon); }
  .dmoc-num circle { fill: var(--bg-alt); stroke: var(--text-muted); }
  .dmoc-num text { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dmoc figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
