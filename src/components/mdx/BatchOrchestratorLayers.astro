---
import BatchDiagram from './BatchDiagram.astro';
const boxes = [{"x": 20, "y": 46, "w": 240, "h": 64, "t": ["Spark job", "Job Spark"], "s": [["clean raw logs", "làm sạch log thô"]], "icon": "spark"}, {"x": 330, "y": 46, "w": 240, "h": 64, "t": ["Trino query", "Truy vấn Trino"], "s": [["join warehouse tables", "join bảng warehouse"]], "icon": "db"}, {"x": 640, "y": 46, "w": 240, "h": 64, "t": ["Python job", "Job Python"], "s": [["train embeddings", "huấn luyện embedding"]], "icon": "worker"}, {"x": 20, "y": 206, "w": 200, "h": 64, "t": ["Scheduler", "Scheduler"], "s": [["places tasks on nodes", "xếp task lên node"]], "icon": "server"}, {"x": 290, "y": 206, "w": 180, "h": 64, "t": ["Node 1", "Node 1"], "s": [["CPU and RAM caps", "giới hạn CPU, RAM"]], "icon": "server"}, {"x": 500, "y": 206, "w": 180, "h": 64, "t": ["Node 2", "Node 2"], "s": [["CPU and RAM caps", "giới hạn CPU, RAM"]], "icon": "server"}, {"x": 710, "y": 206, "w": 170, "h": 64, "t": ["Node 3", "Node 3"], "s": [["runs the tasks", "chạy các task"]], "icon": "server"}];
const arrows = [{"x1": 260, "y1": 78, "x2": 330, "y2": 78, "label": ["to S3", "lên S3"]}, {"x1": 570, "y1": 78, "x2": 640, "y2": 78, "label": ["to S3", "lên S3"]}, {"x1": 140, "y1": 110, "x2": 120, "y2": 206, "label": ["runs as tasks", "chạy thành task"], "kind": "dash", "lx": 190, "ly": 164}, {"x1": 220, "y1": 238, "x2": 290, "y2": 238}];
const texts = [{"x": 20, "y": 26, "cls": "h", "t": ["Workflow orchestrator (Airflow, Dagster, Prefect)", "Điều phối workflow (Airflow, Dagster, Prefect)"]}, {"x": 190, "y": 186, "cls": "h", "t": ["Cluster orchestrator (Kubernetes, YARN)", "Điều phối cụm (Kubernetes, YARN)"]}, {"x": 20, "y": 310, "cls": "foot", "t": ["The top layer knows the order of jobs; the bottom layer only sees tasks inside one job.", "Tầng trên biết thứ tự các job; tầng dưới chỉ thấy các task trong một job."]}];
---
<BatchDiagram
  w={900} h={340}
  aria="Two layers. A workflow orchestrator such as Airflow runs a DAG of jobs: Spark cleans logs, Trino joins tables, Python trains embeddings. Each job is run by a cluster orchestrator such as Kubernetes or YARN, whose scheduler places tasks on nodes."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any} rules={[150]} icons={[]}
  caption={["Two layers people mix up: one decides which job runs next, the other decides which machine runs each task.", "Hai tầng hay bị nhầm: một tầng quyết định job nào chạy tiếp, tầng kia quyết định máy nào chạy từng task."]}
/>
