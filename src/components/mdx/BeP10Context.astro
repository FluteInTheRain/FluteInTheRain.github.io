---
// The request id travels in a ContextVar: set once by the middleware, read by a
// logging filter on every record. A new threading.Thread or a separate process
// starts with an empty context on Python 3.13, so it logs "-". a6d3d33e is the
// id from the two-request capture in section 1.
const W = 900, H = 320, bh = 52;
const rows = [
  { y: 80, from: 'middleware', mid: 'ContextVar', out: 'request_id  a6d3d33e', red: false,
    l1: { en: 'sets it once', vi: 'đặt một lần' }, l2: { en: 'read per record', vi: 'đọc mỗi record' } },
  { y: 215, from: 'new Thread', mid: 'empty context', out: 'request_id  -', red: true,
    l1: { en: 'hand-off', vi: 'giao việc' }, l2: { en: 'read per record', vi: 'đọc mỗi record' } },
];
const arrow = (x1: number, x2: number, y: number) => `${x2 - 12},${y - 6} ${x2},${y} ${x2 - 12},${y + 6}`;
---
<figure class="bep10x">
  <div class="bep10x-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two rows. Top: the middleware sets the request id once in a ContextVar and the logging filter reads it on every record, so the line carries a6d3d33e. Bottom, in red: a new thread starts with an empty context, so the filter finds nothing and the line carries a dash.">
    {rows.map((r) => (
      <g>
        <rect x="40" y={r.y - bh / 2} width="150" height={bh} rx="8" class="box" />
        <text x="115" y={r.y + 5} text-anchor="middle" class="b"><tspan data-lang-en>{r.from}</tspan><tspan data-lang-vi>{r.from}</tspan></text>
        <line x1="190" y1={r.y} x2="290" y2={r.y} class="ln" />
        <polygon points={arrow(190, 302, r.y)} class="arrow" />
        <text x="246" y={r.y - 12} text-anchor="middle" class="m"><tspan data-lang-en>{r.l1.en}</tspan><tspan data-lang-vi>{r.l1.vi}</tspan></text>
        <rect x="302" y={r.y - bh / 2} width="170" height={bh} rx="8" class={r.red ? 'boxr' : 'box'} />
        <text x="387" y={r.y + 5} text-anchor="middle" class="b"><tspan data-lang-en>{r.mid}</tspan><tspan data-lang-vi>{r.mid}</tspan></text>
        <line x1="472" y1={r.y} x2="560" y2={r.y} class="ln" />
        <polygon points={arrow(472, 572, r.y)} class="arrow" />
        <text x="530" y={r.y - 12} text-anchor="middle" class="m"><tspan data-lang-en>{r.l2.en}</tspan><tspan data-lang-vi>{r.l2.vi}</tspan></text>
        <text x="590" y={r.y + 5} class={r.red ? 'r' : 'b'}><tspan data-lang-en>{r.out}</tspan><tspan data-lang-vi>{r.out}</tspan></text>
      </g>
    ))}
    <text x="40" y="145" class="m"><tspan data-lang-en>the service layer never receives a request argument just to log</tspan><tspan data-lang-vi>tầng service không cần nhận tham số request chỉ để log</tspan></text>
    <text x="40" y="285" class="m"><tspan data-lang-en>a separate process or a hand-made thread starts empty on Python 3.13</tspan><tspan data-lang-vi>process riêng hoặc thread tự tạo bắt đầu rỗng trên Python 3.13</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The id lives in the context of the running request, so deep code logs it for free. Code handed off to a new thread or process loses it and logs a dash.</span>
    <span data-lang-vi>Id nằm trong context của request đang chạy, nên code ở sâu bên trong log được mà không tốn gì. Code giao cho thread hoặc process mới thì mất id và log ra dấu gạch.</span>
  </figcaption>
</figure>

<style>
  .bep10x { margin: 2em 0; width: 100%; }
  .bep10x-scroll { overflow-x: auto; }
  .bep10x svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep10x text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep10x .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep10x .m { fill: var(--text-muted); font-size: 13px; }
  .bep10x .b { font-weight: 700; fill: var(--text); }
  .bep10x .r { fill: var(--red); font-weight: 700; }
  .bep10x .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep10x .boxr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .bep10x .ln { stroke: var(--text-faint); stroke-width: 1.4; }
  .bep10x .lnr { stroke: var(--red); stroke-width: 1.6; }
  .bep10x .axis { stroke: var(--border); stroke-width: 2; }
  .bep10x .arrow { fill: var(--text-faint); }
  .bep10x .arrowr { fill: var(--red); }
  .bep10x figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
