---
interface Props {
  author: string;
  role?: string;
  sourceTitle: string;
  sourceUrl?: string;
}
const { author, role, sourceTitle, sourceUrl } = Astro.props;
---
<figure class="quote-card">
  <blockquote class="quote-card-body">
    <slot />
  </blockquote>
  <figcaption class="quote-card-meta">
    &mdash; <b>{author}</b>{role && <span class="quote-card-role">, {role}</span>} <span class="quote-card-source">&middot; <cite>{sourceUrl ? <a href={sourceUrl} rel="noopener" target="_blank">{sourceTitle}</a> : sourceTitle}</cite></span>
  </figcaption>
</figure>