---
// The four window shapes drawn over the same events. Positions are illustrative.
import StreamBFigure from './StreamBFigure.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    r: [['Tumbling', 'fixed, no overlap'], ['Hopping', 'fixed, steps by a hop'], ['Sliding', 'events close within Δ'], ['Session', 'split by an idle gap']],
    gap: 'idle gap',
    alt: 'Four rows draw the same events on a time line. Tumbling windows are fixed and do not overlap. Hopping windows are fixed but start every hop, so they overlap. Sliding windows group events that are close to each other within an interval. Session windows wrap bursts of activity and are split by idle gaps.',
    cap: 'Same events, four ways to cut them. Only the window boundaries change.',
  },
  vi: {
    r: [['Tumbling', 'cố định, không chồng'], ['Hopping', 'cố định, bước nhảy nhỏ hơn'], ['Sliding', 'sự kiện cách nhau ≤ Δ'], ['Session', 'tách bởi khoảng nghỉ']],
    gap: 'khoảng nghỉ',
    alt: 'Bốn hàng vẽ cùng các sự kiện trên trục thời gian. Cửa sổ tumbling cố định và không chồng nhau. Cửa sổ hopping cố định nhưng bắt đầu sau mỗi bước nhảy nên chồng nhau. Cửa sổ sliding gom các sự kiện gần nhau trong một khoảng Δ. Cửa sổ session bao quanh các đợt hoạt động và bị tách bởi khoảng nghỉ.',
    cap: 'Cùng các sự kiện, bốn cách cắt khác nhau. Chỉ ranh giới cửa sổ thay đổi.',
  },
}[lang];
const ev = [255, 280, 305, 450, 470, 500, 660, 685, 720];
const ys = [62, 138, 214, 290];
const x0 = 240, size = 200;
---
<StreamBFigure h={340} alt={T.alt} cap={T.cap}>
  {T.r.map((r, i) => (
    <>
      <text x="20" y={ys[i] - 2} class="name">{r[0]}</text>
      <text x="20" y={ys[i] + 16} class="sub">{r[1]}</text>
      <line x1={x0 - 10} x2="880" y1={ys[i]} y2={ys[i]} class="ln" />
    </>
  ))}
  {[0, 1, 2].map((k) => <rect class="win" x={x0 + k * size + 1} y={ys[0] - 14} width={size - 2} height="28" rx="4" opacity="0.7" />)}
  {[0, 1, 2, 3].map((k) => <rect class="win" x={x0 + k * 100 + 1} y={ys[1] - 30 + (k % 2) * 16} width={size - 2} height="12" rx="3" opacity="0.8" />)}
  {[450, 470, 500].map((s, k) => <rect class="win" x={s} y={ys[2] - 32 + k * 11} width="90" height="9" rx="3" opacity="0.85" />)}
  <rect class="win" x="243" y={ys[3] - 15} width="75" height="30" rx="6" opacity="0.7" />
  <rect class="win" x="438" y={ys[3] - 15} width="75" height="30" rx="6" opacity="0.7" />
  <rect class="win" x="648" y={ys[3] - 15} width="85" height="30" rx="6" opacity="0.7" />
  <text x="378" y={ys[3] + 30} text-anchor="middle" class="sub">{T.gap}</text>
  <text x="585" y={ys[3] + 30} text-anchor="middle" class="sub">{T.gap}</text>
  {ys.map((y) => ev.map((e) => <circle cx={e} cy={y} r="4.5" class="dot" />))}
</StreamBFigure>
