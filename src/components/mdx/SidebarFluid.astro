---
// Chapter 3, "not all elements should be fluid": a 25% sidebar vs a fixed 240px sidebar,
// on a 640px and a 1600px screen. Drawn at one third of real size; the numbers are real widths.

const W = 900;
const H = 380;
const k = 1 / 3;
const screens = [640, 1600];
const rows = [
  { fixed: false, en: 'Sidebar = 25% (3 of 12 columns)', vi: 'Sidebar = 25% (3/12 cột)' },
  { fixed: true, en: 'Sidebar = fixed 240px, main area flexes', vi: 'Sidebar cố định 240px, vùng chính co giãn' },
];
const x0 = [20, 20 + 640 * k + 40];
const rowTop = [44, 214];
const fh = 110;
const sbWidth = (fixed: boolean, vw: number) => (fixed ? 240 : vw * 0.25);
const note = (fixed: boolean, vw: number) => {
  if (fixed) return { en: '', vi: '', bad: false };
  return vw < 1000
    ? { en: 'too narrow: labels wrap', vi: 'quá hẹp: chữ xuống dòng', bad: true }
    : { en: 'wider than its content needs', vi: 'rộng hơn nội dung cần', bad: true };
};
---
<figure class="sbf">
  <div class="sbf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four page layouts. With a 25 percent sidebar, the sidebar is 160 pixels on a 640 pixel screen, too narrow, and 400 pixels on a 1600 pixel screen, wider than needed. With a fixed 240 pixel sidebar, it stays 240 pixels on both and the main area takes the rest.">
      {screens.map((vw, c) => (
        <text x={x0[c]} y="22" class="sbf-col">
          <tspan data-lang-en>{vw}px screen</tspan>
          <tspan data-lang-vi>Màn hình {vw}px</tspan>
        </text>
      ))}
      {rows.map((r, ri) => (
        <g>
          {screens.map((vw, c) => {
            const fw = vw * k;
            const sw = sbWidth(r.fixed, vw) * k;
            const n = note(r.fixed, vw);
            const y = rowTop[ri];
            return (
              <g>
                <rect x={x0[c]} y={y} width={fw} height={fh} rx="6" class="sbf-frame" />
                <rect x={x0[c]} y={y} width={sw} height={fh} rx="6" class:list={['sbf-side', { 'is-bad': n.bad }]} />
                <text x={x0[c] + sw / 2} y={y + fh / 2 + 5} text-anchor="middle" class:list={['sbf-w', { 'is-bad': n.bad }]}>{Math.round(sbWidth(r.fixed, vw))}px</text>
                {[0, 1, 2].map((i) => (
                  <rect x={x0[c] + sw + 12} y={y + 18 + i * 16} width={Math.max(fw - sw - 26, 10) * (i === 2 ? 0.6 : 1)} height="6" rx="3" class="sbf-text" />
                ))}
                {n.bad && (
                  <text x={x0[c]} y={y + fh + 20} class="sbf-bad">
                    <tspan data-lang-en>{n.en}</tspan>
                    <tspan data-lang-vi>{n.vi}</tspan>
                  </text>
                )}
              </g>
            );
          })}
          <text x={x0[1] + 1600 * k + 0} y={rowTop[ri] - 8} text-anchor="end" class:list={['sbf-row', { 'is-good': r.fixed }]}>
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Drawn at one third of real size. A sidebar's content does not change with the screen, so its width should not either.</span>
    <span data-lang-vi>Vẽ bằng một phần ba kích thước thật. Nội dung sidebar không đổi theo màn hình, nên độ rộng của nó cũng không nên đổi.</span>
  </figcaption>
</figure>

<style>
  .sbf { margin: 2em 0; width: 100%; }
  .sbf-scroll { overflow-x: auto; }
  .sbf svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sbf text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .sbf text.sbf-col { font-size: 15px; font-weight: 700; fill: var(--text); }
  .sbf text.sbf-row { font-weight: 600; fill: var(--text); }
  .sbf text.sbf-row.is-good { fill: var(--red); }
  .sbf-frame { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .sbf-side { fill: var(--border); }
  .sbf-side.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
  .sbf text.sbf-w { font-weight: 700; fill: var(--text); }
  .sbf text.sbf-w.is-bad { fill: var(--red); }
  .sbf-text { fill: var(--text-faint); }
  .sbf text.sbf-bad { fill: var(--red); font-weight: 600; }
  .sbf figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
