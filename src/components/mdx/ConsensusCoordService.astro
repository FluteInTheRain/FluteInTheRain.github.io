---
// Where a coordination service sits: a tiny consensus group between workers and the shards that hold
// user data, offering four primitives. Static SVG, site tokens only.
import ConsensusFigure from './ConsensusFigure.astro';
import DiagramIcon from './DiagramIcon.astro';
import { head } from './consensus-fig';
interface Props { lang: 'en' | 'vi' }
const { lang } = Astro.props;

const T = {
  en: {
    aria: 'Architecture picture. On the left, workers that own shards. In the middle, a coordination service of 3 or 5 nodes running one consensus group, holding only small control data such as the shard map, leader records and config flags. On the right, the database shards that hold the user data. Arrow 1: workers take locks and leases from the service. Arrow 2: workers write to shards, attaching a fencing token. Arrow 3: workers keep a session alive with heartbeats. Arrow 4: the service pushes watch notifications back to workers. A legend below names the four primitives.',
    workers: 'Workers', workersSub: 'own shards, hold locks',
    svc: 'Coordination service', svcSub: '3 or 5 nodes, one consensus group', svcData: 'Small control data: shard map, leaders, config',
    shards: 'Database shards', shardsSub: 'terabytes of user data',
    a1: '1', a2: '2  writes carry a fencing token', a3: '3', a4: '4',
    legend: [
      { icon: 'lock', n: 'Lock or lease', s: 'atomic CAS: one owner' },
      { icon: 'key', n: 'Fencing token', s: 'ever-growing number' },
      { icon: 'stopwatch', n: 'Session heartbeat', s: 'crash frees the lock' },
      { icon: 'bell', n: 'Watch', s: 'pushed key changes' },
    ],
    cap: 'The service stays small and holds control data only; the heavy data lives in the shards it coordinates.',
  },
  vi: {
    aria: 'Hình kiến trúc. Bên trái, các worker sở hữu shard. Ở giữa, dịch vụ điều phối 3 hoặc 5 node chạy một nhóm đồng thuận, chỉ giữ dữ liệu điều khiển nhỏ như bản đồ shard, ghi nhận leader và cờ cấu hình. Bên phải, các shard database giữ dữ liệu người dùng. Mũi tên 1: worker lấy khoá và lease từ dịch vụ. Mũi tên 2: worker ghi vào shard kèm fencing token. Mũi tên 3: worker giữ phiên sống bằng heartbeat. Mũi tên 4: dịch vụ đẩy thông báo watch về worker. Chú giải bên dưới nêu bốn primitive.',
    workers: 'Worker', workersSub: 'sở hữu shard, giữ khoá',
    svc: 'Dịch vụ điều phối', svcSub: '3 hoặc 5 node, một nhóm đồng thuận', svcData: 'Dữ liệu nhỏ: bản đồ shard, leader, cấu hình',
    shards: 'Shard database', shardsSub: 'hàng terabyte dữ liệu người dùng',
    a1: '1', a2: '2  ghi kèm fencing token', a3: '3', a4: '4',
    legend: [
      { icon: 'lock', n: 'Khoá hoặc lease', s: 'CAS nguyên tử: một chủ' },
      { icon: 'key', n: 'Fencing token', s: 'số chỉ tăng' },
      { icon: 'stopwatch', n: 'Heartbeat phiên', s: 'sập là nhả khoá' },
      { icon: 'bell', n: 'Watch', s: 'đẩy thay đổi của key' },
    ],
    cap: 'Dịch vụ giữ nhỏ và chỉ chứa dữ liệu điều khiển; dữ liệu nặng nằm ở các shard mà nó điều phối.',
  },
}[lang];
const ys = [96, 126, 156]; // left arrows: 1 (to service), 3 (to service), 4 (back)
---
<ConsensusFigure aria={T.aria} cap={T.cap} w={900} h={380}>
  <rect x="10" y="80" width="190" height="96" rx="8" class="cfg-box" />
  <DiagramIcon name="worker" x={42} y={108} size={28} />
  <text x="70" y="104" class="cfg-n">{T.workers}</text>
  <text x="26" y="150" class="cfg-m">{T.workersSub}</text>

  <rect x="290" y="20" width="320" height="214" rx="10" class="cfg-box is-ok" />
  <text x="450" y="46" text-anchor="middle" class="cfg-n" style="font-size:14px">{T.svc}</text>
  <text x="450" y="64" text-anchor="middle" class="cfg-m">{T.svcSub}</text>
  {[0, 1, 2].map((k) => (
    <g>
      <rect x={314 + k * 98} y="82" width="84" height="64" rx="6" class="cfg-box" />
      <DiagramIcon name="server" x={356 + k * 98} y={106} size={26} />
      <text x={356 + k * 98} y="138" text-anchor="middle" class="cfg-m">node {k + 1}</text>
    </g>
  ))}
  <line x1="398" x2="412" y1="114" y2="114" class="cfg-line is-ok" />
  <line x1="496" x2="510" y1="114" y2="114" class="cfg-line is-ok" />
  <text x="450" y="182" text-anchor="middle" class="cfg-g" style="font-size:12px">{T.svcData}</text>

  <rect x="700" y="80" width="190" height="96" rx="8" class="cfg-box" />
  <DiagramIcon name="db" x={732} y={108} size={28} />
  <text x="760" y="104" class="cfg-n">{T.shards}</text>
  <text x="716" y="150" class="cfg-m" style="font-size:11.5px">{T.shardsSub}</text>

  {/* 1 and 3: workers -> service; 4: service -> workers */}
  <path d="M 200 100 L 282 100" class="cfg-arrow" /><polygon points={head(200, 100, 290, 100)} class="cfg-head" />
  <text x="245" y="92" text-anchor="middle" class="cfg-g">{T.a1}</text>
  <path d="M 200 126 L 282 126" class="cfg-arrow is-dash" /><polygon points={head(200, 126, 290, 126)} class="cfg-head" />
  <text x="245" y="118" text-anchor="middle" class="cfg-g">{T.a3}</text>
  <path d="M 290 156 L 208 156" class="cfg-arrow is-ok" /><polygon points={head(290, 156, 200, 156)} class="cfg-head is-ok" />
  <text x="245" y="174" text-anchor="middle" class="cfg-g">{T.a4}</text>
  {/* 2: workers -> shards, routed under the service */}
  <path d="M 105 176 L 105 266 L 795 266 L 795 184" class="cfg-arrow is-ok" />
  <polygon points={head(795, 230, 795, 176)} class="cfg-head is-ok" />
  <text x="450" y="258" text-anchor="middle" class="cfg-g">{T.a2}</text>

  {T.legend.map((l, i) => {
    const x = 10 + i * 223;
    return (
      <g>
        <rect x={x} y="290" width="210" height="52" rx="6" class="cfg-box" />
        <text x={x + 14} y="312" class="cfg-step" style="fill:var(--text)">{i + 1}</text>
        <DiagramIcon name={l.icon as any} x={x + 44} y={316} size={24} />
        <text x={x + 68} y="312" class="cfg-n" style="font-size:12.5px">{l.n}</text>
        <text x={x + 68} y="330" class="cfg-m" style="font-size:11.5px">{l.s}</text>
      </g>
    );
  })}
</ConsensusFigure>
