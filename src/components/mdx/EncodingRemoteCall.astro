---
import EncodingStepCards from './EncodingStepCards.astro';
const props = {
 "arrows": false,
 "title": {
  "en": "Three ways a network call goes quiet",
  "vi": "Ba cách một lệnh gọi qua mạng im bặt"
 },
 "alt": "Three ways a remote call can fail to answer: the request is lost and never runs; the server runs it but the reply is lost, so it ran once; the server is slow or crashed halfway, so it may or may not have run. In all three the client only sees a timeout.",
 "cards": [
  {
   "icon": "network",
   "head": {
    "en": [
     "Request lost"
    ],
    "vi": [
     "Request bị mất"
    ]
   },
   "lines": {
    "en": [
     "It never reached the",
     "server, so it did not run."
    ],
    "vi": [
     "Nó không tới được server,",
     "nên chưa hề chạy."
    ]
   },
   "tone": "plain"
  },
  {
   "icon": "server",
   "head": {
    "en": [
     "Reply lost"
    ],
    "vi": [
     "Reply bị mất"
    ]
   },
   "lines": {
    "en": [
     "The server ran it and",
     "replied, but the reply never",
     "arrived. It ran once."
    ],
    "vi": [
     "Server đã chạy và trả lời,",
     "nhưng reply không tới.",
     "Nó đã chạy một lần."
    ]
   },
   "tone": "plain"
  },
  {
   "icon": "stopwatch",
   "head": {
    "en": [
     "Server slow or down"
    ],
    "vi": [
     "Server chậm hoặc sập"
    ]
   },
   "lines": {
    "en": [
     "Still working, or crashed",
     "halfway. It may or may not",
     "have run."
    ],
    "vi": [
     "Vẫn đang làm, hoặc sập",
     "giữa chừng. Có thể đã",
     "chạy, có thể chưa."
    ]
   },
   "tone": "plain"
  }
 ],
 "note": {
  "en": "In all three the client just sees a timeout. Retrying may run it twice.",
  "vi": "Cả ba trường hợp client chỉ thấy timeout. Thử lại có thể chạy hai lần."
 },
 "caption": {
  "en": "A local function call never has this problem: it returns, throws, or the whole process is gone.",
  "vi": "Gọi hàm cục bộ không có vấn đề này: nó trả về, ném lỗi, hoặc cả process biến mất."
 }
};
---
<EncodingStepCards {...props} />
