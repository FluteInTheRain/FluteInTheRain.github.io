---
// Real data: cumulative growth of 100 in the Fama/French HML (value) factor, year-end 1962 to 2025.
// Source: Ken French data library, F-F_Research_Data_Factors (monthly, CRSP 202609 vintage).
// Python: compounded the monthly HML column from 196301; 1962 = 100. Value at 2006 year-end 1086.2, at 2020 year-end 479.9.
// Whole-sample figures from the same run: 2007-01..2020-12 cumulative -55.8%, max drawdown -57.8% (2006-12 to 2020-09).
const pts: [number, number][] = [[1962,100],[1963,113.8],[1964,124.0],[1965,131.7],[1966,129.8],[1967,124.3],[1968,143.0],[1969,127.3],[1970,155.3],[1971,141.7],[1972,144.2],[1973,177.9],[1974,196.7],[1975,211.0],[1976,254.5],[1977,273.3],[1978,270.3],[1979,266.2],[1980,217.2],[1981,271.8],[1982,296.6],[1983,343.6],[1984,408.8],[1985,406.6],[1986,439.4],[1987,423.1],[1988,475.9],[1989,458.6],[1990,404.7],[1991,361.6],[1992,442.3],[1993,510.2],[1994,504.3],[1995,524.5],[1996,557.0],[1997,636.2],[1998,571.2],[1999,442.8],[2000,639.9],[2001,739.8],[2002,819.1],[2003,846.3],[2004,903.7],[2005,984.6],[2006,1086.2],[2007,916.1],[2008,936.6],[2009,902.7],[2010,867.2],[2011,796.9],[2012,866.2],[2013,884.4],[2014,866.1],[2015,781.4],[2016,942.7],[2017,841.3],[2018,753.0],[2019,692.1],[2020,479.9],[2021,586.4],[2022,772.6],[2023,687.0],[2024,639.1],[2025,681.1]];
const L = 60, R = 870, T = 56, B = 330;
const x = (y: number) => L + (y - 1962) / (2025 - 1962) * (R - L);
const lg = (v: number) => Math.log(v);
const y = (v: number) => B - (lg(v) - lg(80)) / (lg(1400) - lg(80)) * (B - T);
const d = pts.map(([a, v], i) => `${i ? 'L' : 'M'}${x(a).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
const ticks = [100, 200, 500, 1000];
---
<figure class="p06c">
  <div class="p06c-scroll">
    <svg viewBox="0 0 900 380" role="img" aria-label="Line chart on a log scale of the value factor HML from 1962 to 2025, starting at 100. It rises to about 1,086 at the end of 2006, then falls to about 480 at the end of 2020, and recovers to about 680 at the end of 2025. The years 2007 to 2020 are shaded.">
      <text x="20" y="26" class="h"><tspan data-lang-en>The value factor, 1962 to 2025: growth of 100 (log scale)</tspan><tspan data-lang-vi>Factor value, 1962–2025: tăng trưởng của 100 (thang log)</tspan></text>
      <rect x={x(2006.99)} y={T - 6} width={x(2020.99) - x(2006.99)} height={B - T + 6} class="shade" />
      <text x={x(2014)} y={T + 8} class="m" text-anchor="middle"><tspan data-lang-en>2007–2020: −55.8%</tspan><tspan data-lang-vi>2007–2020: −55,8%</tspan></text>
      {ticks.map((t) => (<g><line x1={L} x2={R} y1={y(t)} y2={y(t)} class="grid" /><text x={L - 8} y={y(t) + 4} class="m" text-anchor="end">{t}</text></g>))}
      {[1970, 1980, 1990, 2000, 2010, 2020].map((a) => (<text x={x(a)} y={B + 20} class="m" text-anchor="middle">{a}</text>))}
      <line x1={x(1992)} x2={x(1992)} y1={T} y2={B} class="pub" />
      <text x={x(1992) + 6} y={B - 8} class="m"><tspan data-lang-en>1992: the value papers appear</tspan><tspan data-lang-vi>1992: các bài về value xuất hiện</tspan></text>
      <path d={d} class="line" />
      <circle cx={x(2006)} cy={y(1086.2)} r="4" class="dot" />
      <circle cx={x(2020)} cy={y(479.9)} r="4" class="dot red" />
      <text x={x(2006) - 8} y={y(1086.2) - 8} class="n" text-anchor="end">1,086</text>
      <text x={x(2020) + 2} y={y(479.9) + 22} class="n red" text-anchor="middle">480</text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Real data: monthly HML (high minus low book-to-market) from the Ken French data library, compounded year by year. The line peaked at the end of 2006 and then lost more than half its value by the end of 2020.</span>
    <span data-lang-vi>Số liệu thật: HML hằng tháng (book-to-market cao trừ thấp) từ thư viện dữ liệu của Ken French, cộng dồn theo từng năm. Đường này đạt đỉnh cuối 2006 rồi mất hơn một nửa giá trị tới cuối 2020.</span>
  </figcaption>
</figure>
<style>
  .p06c { margin: 2em 0; width: 100%; }
  .p06c-scroll { overflow-x: auto; }
  .p06c svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .p06c text { font-size: 12.5px; fill: var(--text-body); }
  .p06c .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p06c .m { fill: var(--text-muted); }
  .p06c .n { font-size: 13px; font-weight: 700; fill: var(--text); }
  .p06c .n.red { fill: var(--red); }
  .p06c .shade { fill: var(--red-tint-bg); }
  .p06c .grid { stroke: var(--border); stroke-width: 1; }
  .p06c .pub { stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .p06c .line { fill: none; stroke: var(--text); stroke-width: 2; stroke-linejoin: round; }
  .p06c .dot { fill: var(--text); }
  .p06c .dot.red { fill: var(--red); }
  .p06c figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
