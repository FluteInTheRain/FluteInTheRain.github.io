  .atp20-bestofn .redt { fill: var(--red); font-weight: 700; }
  .atp20-bestofn .goldt { fill: var(--gold-icon); font-weight: 700; }
  .atp20-bestofn .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .atp20-bestofn .okb { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .atp20-bestofn .badb { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .atp20-bestofn .node { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.5; }
  .atp20-bestofn .leaf { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .atp20-bestofn .nodeg { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 2; }
  .atp20-bestofn .noder { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 2; }
  .atp20-bestofn .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .atp20-bestofn .arrf { fill: var(--text-muted); }
