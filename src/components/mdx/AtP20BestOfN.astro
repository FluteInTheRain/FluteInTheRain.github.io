  .atp20-bestofn .mutl { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; fill: none; }
  .atp20-bestofn .redf { fill: var(--red); }
  .atp20-bestofn .goldf { fill: var(--gold); }
  .atp20-bestofn .mutf { fill: var(--text-faint); }
  .atp20-bestofn .tick { fill: var(--text-muted); font-size: 12px; }
  .atp20-bestofn figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>