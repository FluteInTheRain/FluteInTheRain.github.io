---
import DiagramIcon from './DiagramIcon.astro';
// Layers between a model's decision and the exchange, and what the SEC found at Knight for each (SEC 34-70694 paras 9, 21-27).
const W = 900;
const H = 416;
const rows = [
  { icon: 'receipt', en: 'Per-order check', vi: 'Kiểm tra từng lệnh', den: 'size, price within a band of the market', dvi: 'cỡ lệnh, giá nằm trong biên quanh thị trường', sen: 'Partly: 9.5% price cap, not for pre-open orders', svi: 'Một phần: giới hạn giá 9,5%, trừ lệnh trước giờ mở', st: 'part' },
  { icon: 'shield', en: 'Order flow check', vi: 'So lệnh ra với lệnh vào', den: 'compare orders leaving the router with those that entered', dvi: 'so lệnh rời router với lệnh đi vào', sen: 'Absent in SMARS', svi: 'Không có trong SMARS', st: 'bad' },
  { icon: 'scale', en: 'Exposure cap', vi: 'Hạn mức vị thế', den: 'firm-wide limit that blocks new orders automatically', dvi: 'hạn mức toàn công ty tự chặn lệnh mới', sen: 'Absent: the limit was not linked to order entry', svi: 'Không có: hạn mức không nối với việc đặt lệnh', st: 'bad' },
  { icon: 'stop', en: 'Kill switch', vi: 'Công tắc dừng', den: 'halts the system on its own odd behaviour', dvi: 'tự dừng hệ thống khi nó hành xử bất thường', sen: 'Absent: no procedure to halt SMARS', svi: 'Không có: không có quy trình dừng SMARS', st: 'bad' },
  { icon: 'user', en: 'Human with a runbook', vi: 'Người có sổ tay xử lý', den: 'knows what to do, and in what order', dvi: 'biết làm gì và theo thứ tự nào', sen: 'No incident procedure; a rollback made it worse', svi: 'Không có quy trình xử lý sự cố; rollback làm nặng thêm', st: 'bad' },
];
---
<figure class="atp13-co">
  <div class="atp13-co-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Five layers of protection between a model and the exchange: per-order check, order flow check, exposure cap, kill switch, human with a runbook. The SEC found Knight had only part of the first and none of the other four.">
      <text x="20" y="28" class="h">
        <tspan data-lang-en>Five layers between the model and the exchange</tspan>
        <tspan data-lang-vi>Năm lớp chắn giữa mô hình và sàn</tspan>
      </text>
      <text x="520" y="28" class="h">
        <tspan data-lang-en>What the SEC found at Knight</tspan>
        <tspan data-lang-vi>SEC thấy gì ở Knight</tspan>
      </text>
      {rows.map((r, i) => (
        <g>
          <rect x="20" y={46 + i * 66} width="470" height="56" rx="8" class="box" />
          <DiagramIcon name={r.icon} x={44} y={74 + i * 66} size={22} />
          <text x="68" y={68 + i * 66} class="lab">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
          <text x="68" y={88 + i * 66} class="sub">
            <tspan data-lang-en>{r.den}</tspan>
            <tspan data-lang-vi>{r.dvi}</tspan>
          </text>
          <line x1="490" x2="514" y1={74 + i * 66} y2={74 + i * 66} class="arrow" />
          <rect x="520" y={46 + i * 66} width="360" height="56" rx="8" class={r.st === 'bad' ? 'box hot' : 'box part'} />
          <text x="534" y={78 + i * 66} class={r.st === 'bad' ? 'sub hotl' : 'sub'}>
            <tspan data-lang-en>{r.sen}</tspan>
            <tspan data-lang-vi>{r.svi}</tspan>
          </text>
        </g>
      ))}
      <text x="20" y="404" class="note">
        <tspan data-lang-en>Layers one to four sit before the exchange; no later step can undo a fill.</tspan>
        <tspan data-lang-vi>Bốn lớp đầu nằm trước sàn; không bước nào sau đó gỡ được một lệnh đã khớp.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Source: SEC order against Knight Capital Americas LLC, Release 34-70694, paragraphs 21 to 27.</span>
    <span data-lang-vi>Nguồn: lệnh xử phạt của SEC đối với Knight Capital Americas LLC, Release 34-70694, đoạn 21 đến 27.</span>
  </figcaption>
</figure>

<style>
  .atp13-co { margin: 2em 0; width: 100%; }
  .atp13-co-scroll { overflow-x: auto; }
  .atp13-co svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp13-co .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .atp13-co .lab { font-size: 14px; font-weight: 700; fill: var(--text); }
  .atp13-co .sub { font-size: 12.5px; fill: var(--text-muted); }
  .atp13-co .hotl { fill: var(--red); }
  .atp13-co .note { font-size: 13px; fill: var(--text-body); }
  .atp13-co .arrow { stroke: var(--text-muted); stroke-width: 1.5; }
  .atp13-co .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .atp13-co .box.hot { fill: var(--red-tint-bg); stroke: var(--red); }
  .atp13-co .box.part { stroke: var(--text-muted); stroke-dasharray: 5 4; }
  .atp13-co figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
