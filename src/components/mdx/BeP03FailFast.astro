---
// Fail fast vs rot later: the same junk, two doors. The typed lane dies at
// the model (422, nothing to clean up); the untyped lane runs on the junk,
// stores it, and finally breaks someone else's nightly job.
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const p1 = [x2 - 9 * Math.cos(a - 0.45), y2 - 9 * Math.sin(a - 0.45)];
  const p2 = [x2 - 9 * Math.cos(a + 0.45), y2 - 9 * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const W = 900, H = 310;
const A = 94, B = 227;
const arrows = [arrow(190, A, 240, A), arrow(370, A, 420, A), arrow(190, B, 240, B), arrow(370, B, 420, B), arrow(550, B, 600, B)];
const boxesA = [
  { x: 60, w: 130, icon: 'envelope', title: 'request', sub: { en: 'the same junk', vi: 'cùng đống rác' }, red: false },
  { x: 240, w: 130, icon: 'detective', title: 'CaseCreate', sub: { en: 'checks at the door', vi: 'kiểm ngay tại cửa' }, red: false },
  { x: 420, w: 200, icon: 'envelope-arrow', title: '422', sub: { en: 'the story ends here', vi: 'kết thúc ngay tại đây' }, red: true },
];
const boxesB = [
  { x: 60, w: 130, icon: 'envelope', title: 'request', sub: { en: 'the same junk', vi: 'cùng đống rác' }, red: false },
  { x: 240, w: 130, icon: 'python', title: 'handler', sub: { en: 'runs on the junk', vi: 'chạy với đống rác' }, red: false },
  { x: 420, w: 130, icon: 'database', title: 'storage', sub: { en: 'junk gets stored', vi: 'rác vào kho dữ liệu' }, red: false },
  { x: 600, w: 170, icon: 'engine', title: '', sub: { en: '', vi: '' }, red: true },
];
---
<figure class="bep3b">
  <div class="bep3b-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two lanes: with a typed boundary the junk request dies at the model with a 422 and the handler never runs; with an untyped endpoint the junk runs through the handler, gets stored, and finally crashes the nightly job.">
    <text x="20" y="46" class="t"><tspan data-lang-en>the typed endpoint</tspan><tspan data-lang-vi>endpoint có model</tspan></text>
    {boxesA.map((bx) => (
      <g>
        <rect x={bx.x} y="52" width={bx.w} height="84" rx="8" class={bx.red ? 'boxr' : 'box'} />
        <image href={`/icons/flow/${bx.icon}.svg`} x={bx.x + bx.w / 2 - 13} y="62" width="26" height="26" class="icn" aria-hidden="true" />
        <text x={bx.x + bx.w / 2} y="112" text-anchor="middle" class={bx.red ? 't r' : 't'}>{bx.title}</text>
        <text x={bx.x + bx.w / 2} y="130" text-anchor="middle" class="m"><tspan data-lang-en>{bx.sub.en}</tspan><tspan data-lang-vi>{bx.sub.vi}</tspan></text>
      </g>
    ))}
    <text x="765" y="96" text-anchor="middle" class="gh"><tspan data-lang-en>your code never runs</tspan><tspan data-lang-vi>code bạn không chạy</tspan></text>
    <text x="765" y="116" text-anchor="middle" class="ghm"><tspan data-lang-en>nothing to clean up</tspan><tspan data-lang-vi>không gì phải dọn</tspan></text>
    <rect x="670" y="52" width="190" height="84" rx="8" class="ghost" />
    <text x="20" y="176" class="t"><tspan data-lang-en>the untyped endpoint</tspan><tspan data-lang-vi>endpoint nhận dict</tspan></text>
    {boxesB.map((bx, i) => (
      <g>
        <rect x={bx.x} y="186" width={bx.w} height="84" rx="8" class={bx.red ? 'boxr' : 'box'} />
        <image href={`/icons/flow/${bx.icon}.svg`} x={bx.x + bx.w / 2 - 13} y="196" width="26" height="26" class="icn" aria-hidden="true" />
        {i === 3 ? (
          <g>
            <text x={bx.x + bx.w / 2} y="246" text-anchor="middle" class="t r"><tspan data-lang-en>crash</tspan><tspan data-lang-vi>vỡ</tspan></text>
            <text x={bx.x + bx.w / 2} y="264" text-anchor="middle" class="m"><tspan data-lang-en>in the nightly job</tspan><tspan data-lang-vi>trong job chạy đêm</tspan></text>
          </g>
        ) : (
          <g>
            <text x={bx.x + bx.w / 2} y="246" text-anchor="middle" class="t">{bx.title}</text>
            <text x={bx.x + bx.w / 2} y="264" text-anchor="middle" class="m"><tspan data-lang-en>{bx.sub.en}</tspan><tspan data-lang-vi>{bx.sub.vi}</tspan></text>
          </g>
        )}
      </g>
    ))}
    {arrows.map((a) => (<g><path d={a.line} class="ln" /><polygon points={a.head} class="hd" /></g>))}
    <text x="20" y="302" class="rr"><tspan data-lang-en>the same junk, three boxes deeper — and someone else's pager</tspan><tspan data-lang-vi>cùng đống rác, sâu thêm ba tầng — và pager của người khác</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Fail fast at the boundary and the junk dies at the door; skip the check and it travels — through your handler, into storage, into someone else's nightly job.</span>
    <span data-lang-vi>Chặn ở cửa thì đống rác chết ngay tại đó; bỏ qua bước kiểm thì nó đi tiếp — qua handler của bạn, vào kho dữ liệu, vào job chạy đêm của người khác.</span>
  </figcaption>
</figure>

<style>
  .bep3b { margin: 2em 0; width: 100%; }
  .bep3b-scroll { overflow-x: auto; }
  .bep3b svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep3b text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep3b .t { font-weight: 700; fill: var(--text); }
  .bep3b .m { fill: var(--text-muted); font-size: 12.5px; }
  .bep3b .r { fill: var(--red); }
  .bep3b .rr { font-weight: 700; fill: var(--red); font-size: 13px; }
  .bep3b .gh { fill: var(--text-muted); font-size: 12.5px; }
  .bep3b .ghm { fill: var(--text-muted); font-size: 12px; }
  .bep3b .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .bep3b .boxr { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .bep3b .ghost { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .bep3b .ln { stroke: var(--text-muted); stroke-width: 1.5; fill: none; }
  .bep3b .hd { fill: var(--text-muted); }
  .bep3b figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
