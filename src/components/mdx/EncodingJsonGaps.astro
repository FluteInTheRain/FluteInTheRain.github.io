---
import EncodingStepCards from './EncodingStepCards.astro';
const props = {
 "arrows": false,
 "title": {
  "en": "Three quiet gaps in JSON",
  "vi": "Ba lỗ hổng âm thầm của JSON"
 },
 "alt": "Three gaps in JSON. Binary data has no type, so it is written as Base64 text and grows from 3,000 bytes to 4,000 characters. Schemas are optional and the default is an open content model with additionalProperties true, so unlisted fields are allowed. Every record repeats every field name, which MessagePack keeps.",
 "cards": [
  {
   "icon": "file",
   "head": {
    "en": [
     "Binary data"
    ],
    "vi": [
     "Dữ liệu nhị phân"
    ]
   },
   "lines": {
    "en": [
     "No type for raw bytes, so",
     "people write Base64 text:",
     "about a third larger."
    ],
    "vi": [
     "Không có kiểu cho byte",
     "thô, nên người ta viết",
     "Base64: to hơn một phần ba."
    ]
   },
   "tone": "plain",
   "mono": [
    "3,000 B -> 4,000 chars"
   ]
  },
  {
   "icon": "warning",
   "head": {
    "en": [
     "Open schema"
    ],
    "vi": [
     "Schema mở"
    ]
   },
   "lines": {
    "en": [
     "Fields not listed are",
     "allowed. The schema says",
     "what is forbidden,",
     "not what exists."
    ],
    "vi": [
     "Trường không liệt kê vẫn",
     "được phép. Schema nói",
     "cái gì bị cấm, chứ",
     "không nói cái gì có."
    ]
   },
   "tone": "plain",
   "mono": [
    "additionalProperties: true"
   ]
  },
  {
   "icon": "log",
   "head": {
    "en": [
     "Names in every record"
    ],
    "vi": [
     "Tên trong mọi bản ghi"
    ]
   },
   "lines": {
    "en": [
     "Each record spells out",
     "every key. MessagePack",
     "keeps that, so it shrinks",
     "less than you hope."
    ],
    "vi": [
     "Mỗi bản ghi viết đủ mọi",
     "key. MessagePack vẫn giữ",
     "vậy, nên nó thu nhỏ",
     "ít hơn bạn mong."
    ]
   },
   "tone": "plain",
   "mono": [
    "{\"name\":..} {\"name\":..}"
   ]
  }
 ],
 "caption": {
  "en": "Each gap is silent: nothing fails, the data is just bigger, looser or longer than it needs to be.",
  "vi": "Lỗ hổng nào cũng âm thầm: không gì báo lỗi, dữ liệu chỉ to hơn, lỏng hơn hoặc dài hơn mức cần."
 }
};
---
<EncodingStepCards {...props} />
