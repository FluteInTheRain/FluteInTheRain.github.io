---
// Chapter 2, "balance weight and contrast": two dials that trade against each other.
// Row 1: a solid icon is heavy, so lowering its contrast lets the text lead.
// Row 2: a faint 1px border disappears, a dark one is harsh; a 2px light one is visible and soft.
// Plain inline SVG with site tokens, no ids.

const W = 900;
const H = 330;
const col = [20, 320, 620];

// A simple solid "bell" shape, drawn as a path (no icon font).
function bell(x: number, y: number) {
  return `M ${x + 12} ${y} C ${x + 4} ${y} ${x + 2} ${y + 7} ${x + 2} ${y + 13} L ${x + 2} ${y + 19} L ${x - 2} ${y + 23} L ${x + 26} ${y + 23} L ${x + 22} ${y + 19} L ${x + 22} ${y + 13} C ${x + 22} ${y + 7} ${x + 20} ${y} ${x + 12} ${y} Z M ${x + 8} ${y + 25} L ${x + 16} ${y + 25} C ${x + 16} ${y + 29} ${x + 8} ${y + 29} ${x + 8} ${y + 25} Z`;
}

const iconRow = [
  { soft: false, en: 'Solid dark icon: it leads, the text follows', vi: 'Icon đặc màu đậm: icon dẫn, chữ theo sau' },
  { soft: true, en: 'Same icon, softer colour: the text leads', vi: 'Cùng icon, màu nhạt hơn: chữ dẫn' },
];
const borderRow = [
  { w: 1, cls: 'is-faint', en: '1px, light: almost gone', vi: '1px, nhạt: gần như biến mất' },
  { w: 1, cls: 'is-harsh', en: '1px, dark: harsh', vi: '1px, đậm: gắt' },
  { w: 2, cls: 'is-faint', en: '2px, light: visible and soft', vi: '2px, nhạt: thấy rõ mà vẫn dịu', good: true },
];
---
<figure class="wct">
  <div class="wct-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top row: a dark solid bell icon next to the text Notifications overpowers it; the same icon in a softer grey lets the text lead. Bottom row: three input boxes with a light 1px border that almost disappears, a dark 1px border that looks harsh, and a light 2px border that is visible but soft.">
      <text x="20" y="24" class="wct-h">
        <tspan data-lang-en>Heavy things: lower the contrast</tspan>
        <tspan data-lang-vi>Thứ nặng: giảm độ tương phản</tspan>
      </text>
      {iconRow.map((r, i) => (
        <g>
          <path d={bell(col[i] + 6, 52)} class:list={['wct-icon', { 'is-soft': r.soft }]} />
          <text x={col[i] + 44} y="72" class="wct-item">
            <tspan data-lang-en>Notifications</tspan>
            <tspan data-lang-vi>Thông báo</tspan>
          </text>
          <text x={col[i]} y="112" class="wct-note">
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
        </g>
      ))}

      <line x1="20" y1="148" x2="880" y2="148" class="wct-rule" />

      <text x="20" y="184" class="wct-h">
        <tspan data-lang-en>Light things: add weight, not darkness</tspan>
        <tspan data-lang-vi>Thứ nhẹ: thêm độ dày, đừng thêm độ đậm màu</tspan>
      </text>
      {borderRow.map((r, i) => (
        <g>
          <rect x={col[i] + r.w / 2} y={206} width={250} height={46} rx="6" class:list={['wct-box', r.cls]} stroke-width={r.w} />
          <text x={col[i] + 16} y="235" class="wct-ph">name@example.com</text>
          <text x={col[i]} y="282" class:list={['wct-note', { 'is-good': r.good }]}>
            <tspan data-lang-en>{r.en}</tspan>
            <tspan data-lang-vi>{r.vi}</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Weight and contrast are two dials. When one is high, turn the other down.</span>
    <span data-lang-vi>Độ đậm (weight) và độ tương phản là hai núm vặn. Khi một núm đang cao, vặn núm kia xuống.</span>
  </figcaption>
</figure>

<style>
  .wct {
    margin: 2em 0;
    width: 100%;
  }
  .wct-scroll {
    overflow-x: auto;
  }
  .wct svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .wct text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .wct text.wct-h {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .wct text.wct-item {
    font-size: 18px;
    font-weight: 600;
    fill: var(--text);
  }
  .wct text.wct-note {
    fill: var(--text-muted);
  }
  .wct text.wct-note.is-good {
    fill: var(--red);
    font-weight: 600;
  }
  .wct text.wct-ph {
    font-size: 15px;
    fill: var(--text-muted);
  }
  .wct-icon {
    fill: var(--text);
  }
  .wct-icon.is-soft {
    fill: var(--text-faint);
  }
  .wct-rule {
    stroke: var(--border);
  }
  .wct-box {
    fill: var(--bg-alt);
  }
  .wct-box.is-faint {
    stroke: var(--border);
  }
  .wct-box.is-harsh {
    stroke: var(--text);
  }
  .wct figcaption {
    margin-top: 0.6em;
    text-align: center;
    font-size: 14px;
    color: var(--text-muted);
  }
</style>
