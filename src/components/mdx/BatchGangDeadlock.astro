---
import BatchDiagram from './BatchDiagram.astro';
const boxes = [{"x": 20, "y": 46, "w": 200, "h": 64, "t": ["Job A", "Job A"], "s": [["needs 64 GPUs", "cần 64 GPU"]], "icon": "model"}, {"x": 330, "y": 46, "w": 240, "h": 64, "t": ["Cluster: 64 GPUs", "Cụm: 64 GPU"], "s": [["A holds 32, B holds 32", "A giữ 32, B giữ 32"]], "icon": "server", "kind": "hot"}, {"x": 680, "y": 46, "w": 200, "h": 64, "t": ["Job B", "Job B"], "s": [["needs 64 GPUs", "cần 64 GPU"]], "icon": "model"}, {"x": 20, "y": 222, "w": 200, "h": 64, "t": ["Big job", "Job lớn"], "s": [["waits for 64 free", "chờ đủ 64 chỗ trống"]], "icon": "model", "kind": "hot"}, {"x": 330, "y": 222, "w": 240, "h": 64, "t": ["Freed slots", "Chỗ vừa trống"], "s": [["one or two at a time", "một hai chỗ mỗi lần"]], "icon": "hourglass"}, {"x": 680, "y": 222, "w": 200, "h": 64, "t": ["Small jobs", "Các job nhỏ"], "s": [["grab each freed slot", "chiếm từng chỗ trống"]], "icon": "worker"}];
const arrows = [{"x1": 220, "y1": 78, "x2": 330, "y2": 78, "label": ["wants 32 more", "cần thêm 32"], "kind": "hot"}, {"x1": 680, "y1": 78, "x2": 570, "y2": 78, "label": ["wants 32 more", "cần thêm 32"], "kind": "hot"}, {"x1": 680, "y1": 254, "x2": 570, "y2": 254}, {"x1": 330, "y1": 254, "x2": 220, "y2": 254, "label": ["short of 64", "chưa đủ 64"], "kind": "hot"}];
const texts = [{"x": 20, "y": 26, "cls": "h", "t": ["Reserve while waiting: deadlock", "Giữ chỗ trong lúc chờ: deadlock"]}, {"x": 20, "y": 130, "cls": "warn", "t": ["Neither job can start, and neither lets go.", "Không job nào chạy được, cũng không job nào nhả chỗ."]}, {"x": 20, "y": 202, "cls": "h", "t": ["Do not reserve: starvation", "Không giữ chỗ: bị bỏ đói"]}, {"x": 20, "y": 320, "cls": "warn", "t": ["The big job keeps waiting while small jobs run.", "Job lớn chờ mãi trong khi các job nhỏ chạy."]}];
---
<BatchDiagram
  w={900} h={340}
  aria="Top: two jobs that each need 64 GPUs each grab 32 and wait for the other 32, so neither starts. Bottom: a 64-GPU job waits for free slots while small jobs keep taking each one, so it starves."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any} rules={[168]} icons={[]}
  caption={["Gang scheduling means all 64 GPUs start together or none do. Both ways of waiting have a catch.", "Gang scheduling nghĩa là cả 64 GPU cùng bắt đầu hoặc không cái nào. Cả hai cách chờ đều có cái giá."]}
/>
