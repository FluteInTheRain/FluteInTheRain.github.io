---
// Salting trade-off: a write lands on one salted key, a read must ask every salted key and merge.
// Inline SVG, site tokens.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
const A = (x1: number, y1: number, x2: number, y2: number, c = '') => {
  const a = arrow(x1, y1, x2, y2);
  return { ...a, c };
};

const W = 900;
const H = 340;
const ys = [70, 125, 180, 235];
const labels = ['#00', '#01', '...', '#99'];
const writeA = A(140, 165, 230, 145, 'is-fix');
const readA = ys.map((y) => A(570, 165, 620, y + 20, 'is-hot'));
const mergeA = ys.map((y) => A(770, y + 20, 800, 165, 'is-hot'));
---
<figure class="shaa-sl">
  <div class="shaa-sl-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Key salting trade-off. A write to celebrity_key picks one random suffix, such as hash 01, and lands on just one of the 100 salted keys, so write load is divided by 100. A read has to query all 100 salted keys, #00 through #99, and merge the results.">
      <line x1="450" x2="450" y1="12" y2={H - 12} class="rule" />
      <text x="20" y="28" class="h"><tspan data-lang-en>Write: one salted key</tspan><tspan data-lang-vi>Ghi: chỉ một khoá phụ</tspan></text>
      <text x="475" y="28" class="h"><tspan data-lang-en>Read: all salted keys, then merge</tspan><tspan data-lang-vi>Đọc: hỏi mọi khoá phụ rồi ghép</tspan></text>

      <rect x="20" y="125" width="120" height="80" rx="6" class="box" />
      <DiagramIcon name="laptop" x={80} y={150} size={26} />
      <text x="80" y="188" text-anchor="middle" class="b"><tspan data-lang-en>1 write</tspan><tspan data-lang-vi>1 lệnh ghi</tspan></text>
      <path d={writeA.line} class="arrow is-fix" /><polygon points={writeA.head} class="head is-fix" />
      {ys.map((y, i) => (
        <g>
          <rect x="230" y={y} width="190" height="40" rx="5" class={i === 1 ? 'box is-fix' : 'box is-dim'} />
          <text x="325" y={y + 25} text-anchor="middle" class="b">{`celebrity_key${labels[i]}`}</text>
        </g>
      ))}

      <rect x="470" y="125" width="100" height="80" rx="6" class="box" />
      <DiagramIcon name="laptop" x={520} y={150} size={26} />
      <text x="520" y="188" text-anchor="middle" class="b"><tspan data-lang-en>1 read</tspan><tspan data-lang-vi>1 lệnh đọc</tspan></text>
      {readA.map((a) => (<g><path d={a.line} class="arrow is-hot" /><polygon points={a.head} class="head is-hot" /></g>))}
      {ys.map((y, i) => (
        <g>
          <rect x="620" y={y} width="150" height="40" rx="5" class="box is-hot" />
          <text x="695" y={y + 25} text-anchor="middle" class="b is-hot">{labels[i]}</text>
        </g>
      ))}
      {mergeA.map((a) => (<g><path d={a.line} class="arrow is-hot" /><polygon points={a.head} class="head is-hot" /></g>))}
      <rect x="800" y="140" width="80" height="50" rx="6" class="box" />
      <text x="840" y="170" text-anchor="middle" class="b"><tspan data-lang-en>merge</tspan><tspan data-lang-vi>ghép</tspan></text>

      <DiagramIcon name="ok" x={34} y={306} size={20} />
      <text x="58" y="311" class="b"><tspan data-lang-en>Write load divided by 100.</tspan><tspan data-lang-vi>Tải ghi giảm 100 lần.</tspan></text>
      <DiagramIcon name="warning" x={489} y={306} size={20} />
      <text x="513" y="311" class="s is-hot"><tspan data-lang-en>Every read now does 100 lookups.</tspan><tspan data-lang-vi>Mỗi lệnh đọc giờ phải tra 100 lần.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Salting moves the cost from writes to reads. Only salt the few keys that are actually hot.</span>
    <span data-lang-vi>Thêm muối chuyển chi phí từ ghi sang đọc. Chỉ thêm muối cho vài khoá thật sự nóng.</span>
  </figcaption>
</figure>

<style>
  .shaa-sl { margin: 2em 0; width: 100%; }
  .shaa-sl-scroll { overflow-x: auto; }
  .shaa-sl svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shaa-sl text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shaa-sl .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shaa-sl .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shaa-sl .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shaa-sl .b.is-hot { fill: var(--red); }
  .shaa-sl .s { font-size: 12px; fill: var(--text-body); }
  .shaa-sl .s.is-hot { fill: var(--red); font-weight: 600; }
  .shaa-sl .big { font-size: 18px; font-weight: 700; fill: var(--text); }
  .shaa-sl .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shaa-sl .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shaa-sl .box.is-fix { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-sl .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shaa-sl .box.is-dim { opacity: 0.45; }
  .shaa-sl .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shaa-sl .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shaa-sl .arrow.is-hot { stroke: var(--red); }
  .shaa-sl .arrow.is-fix { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shaa-sl .head { fill: var(--text-muted); }
  .shaa-sl .head.is-hot { fill: var(--red); }
  .shaa-sl .head.is-fix { fill: var(--gold-icon); }
  .shaa-sl figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
