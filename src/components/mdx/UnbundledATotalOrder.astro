---
// Four situations where one global line of events stops working.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 290;
type Tile = { l: string; r: string; mid: string; en: string; vi: string; l1: [string, string]; l2: [string, string]; ln: [string, string] };
const tiles: Tile[] = [
  { l: 'log', r: 'log', mid: '?', en: 'Sharded log', vi: 'Log chia shard', l1: ['writes outgrow one server', 'lượng ghi vượt một máy'], l2: ['no order between shards', 'không có thứ tự giữa shard'], ln: ['', ''] },
  { l: 'cloud', r: 'cloud', mid: 'stopwatch', en: 'Multiple regions', vi: 'Nhiều vùng địa lý', l1: ['round trip: tens to hundreds', 'một vòng: chục tới trăm ms,'], l2: ['of ms, so one leader each', 'nên mỗi vùng một leader'], ln: ['', ''] },
  { l: 'server', r: 'server', mid: '?', en: 'Microservices', vi: 'Microservices', l1: ['each service owns its database', 'mỗi service giữ database riêng'], l2: ['no shared log between them', 'không chung log với nhau'], ln: ['', ''] },
  { l: 'phone', r: 'server', mid: 'hourglass', en: 'Offline clients', vi: 'Client chạy offline', l1: ['state updates on tap,', 'trạng thái đổi ngay khi bấm,'], l2: ['long before the server knows', 'rất lâu trước khi server biết'], ln: ['', ''] },
];
const tw = 200;
const gap = 20;
---
<figure class="ua-fig">
  <div class="ua-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Four reasons a single global order breaks down: sharded logs, multiple regions, microservices with separate databases, and offline clients. All of them need one leader to restore a total order, which cannot scale out.">
      <text x="20" y="24" class="ua-h"><tspan data-lang-en>Where one global line breaks</tspan><tspan data-lang-vi>Chỗ một hàng toàn cục bị vỡ</tspan></text>
      {tiles.map((t, i) => {
        const x = 20 + i * (tw + gap);
        const cx = x + tw / 2;
        return (
          <>
            <rect x={x} y="40" width={tw} height="170" rx="4" class="ua-box" />
            <text x={cx} y="66" text-anchor="middle" class="ua-b"><tspan data-lang-en>{t.en}</tspan><tspan data-lang-vi>{t.vi}</tspan></text>
            <DiagramIcon name={t.l as any} x={cx - 56} y={110} size={32} />
            <DiagramIcon name={t.r as any} x={cx + 56} y={110} size={32} />
            {t.mid === '?' ? <text x={cx} y={118} text-anchor="middle" class="ua-q">?</text> : <DiagramIcon name={t.mid as any} x={cx} y={110} size={26} />}
            <path d={`M${cx - 34},110 L${cx - 20},110 M${cx + 20},110 L${cx + 34},110`} class="ua-dashed is-hot" />
            <text x={cx} y="168" text-anchor="middle" class="ua-m"><tspan data-lang-en>{t.l1[0]}</tspan><tspan data-lang-vi>{t.l1[1]}</tspan></text>
            <text x={cx} y="186" text-anchor="middle" class="ua-m"><tspan data-lang-en>{t.l2[0]}</tspan><tspan data-lang-vi>{t.l2[1]}</tspan></text>
          </>
        );
      })}
      <rect x="20" y="226" width="860" height="46" rx="4" class="ua-box is-hot" />
      <DiagramIcon name="warning" x={54} y={249} size={26} />
      <text x="84" y="254" class="ua-b"><tspan data-lang-en>One agreed order needs one leader (total order broadcast, equal to consensus), so it cannot scale out.</tspan><tspan data-lang-vi>Một thứ tự chung cần một leader (total order broadcast, tương đương consensus), nên không mở rộng ngang được.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>In each case two events are created in different places, and nothing says which came first.</span>
    <span data-lang-vi>Ở cả bốn trường hợp, hai sự kiện sinh ra ở hai nơi khác nhau và không gì cho biết cái nào tới trước.</span>
  </figcaption>
</figure>

<style>
  .ua-fig { margin: 2em 0; width: 100%; }
  .ua-scroll { overflow-x: auto; }
  .ua-fig svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .ua-fig text { font-size: 13px; fill: var(--text-body); }
  .ua-fig .ua-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-ph { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-b { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-m { font-size: 12.5px; fill: var(--text-muted); }
  .ua-fig .ua-n { font-size: 12.5px; font-weight: 700; fill: var(--text-muted); }
  .ua-fig .ua-n.is-hot, .ua-fig .ua-b.is-hot, .ua-fig .ua-m.is-hot { fill: var(--red); }
  .ua-fig .ua-n.is-good, .ua-fig .ua-b.is-good, .ua-fig .ua-m.is-good { fill: var(--gold-icon); }
  .ua-fig .ua-q { font-size: 20px; font-weight: 700; fill: var(--red); }
  .ua-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .ua-box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .ua-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .ua-panel { fill: none; stroke: var(--border); stroke-width: 1.2; }
  .ua-life { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .ua-solid { fill: none; stroke: var(--text-muted); stroke-width: 1.8; }
  .ua-dashed { fill: none; stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .ua-head { fill: var(--text-muted); }
  .ua-solid.is-hot, .ua-dashed.is-hot { stroke: var(--red); stroke-width: 1.9; }
  .ua-head.is-hot { fill: var(--red); }
  .ua-solid.is-good { stroke: var(--gold-icon); stroke-width: 2; }
  .ua-head.is-good { fill: var(--gold-icon); }
  .ua-fig figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
