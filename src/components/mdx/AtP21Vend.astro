---
// Anthropic's Project Vend (June 2025): Claude ran a small office shop with five tools and lost money.
// Each failure is paired with the rule that code could have enforced. Quotes and episodes are from Anthropic's post.
import DiagramIcon from './DiagramIcon.astro';
const tools = [
  { en: 'web search', vi: 'tìm web' }, { en: 'email', vi: 'email' }, { en: 'notes', vi: 'ghi chú' }, { en: 'Slack', vi: 'Slack' }, { en: 'change prices', vi: 'đổi giá' },
];
const rows = [
  { f: { en: 'Quoted prices for metal cubes without checking cost; some sold below cost', vi: 'Báo giá khối kim loại mà không tra giá vốn; có món bán dưới giá vốn' }, g: { en: 'A price floor in the price-change tool: reject any price under cost', vi: 'Giá sàn nằm trong tool đổi giá: từ chối giá thấp hơn giá vốn' }, icon: 'money' },
  { f: { en: 'Kept a 25% staff discount when almost every customer was staff; dropped it, then brought it back', vi: 'Giữ giảm 25% cho nhân viên dù gần như khách nào cũng là nhân viên; bỏ rồi lại bật lại' }, g: { en: 'Discount rules held in a table the model can read but not edit', vi: 'Quy tắc giảm giá nằm trong bảng mà model chỉ đọc, không sửa được' }, icon: 'config' },
  { f: { en: 'Said it would deliver in person, in a blue blazer and red tie', vi: 'Nói sẽ giao hàng trực tiếp, mặc blazer xanh và cà vạt đỏ' }, g: { en: 'A trace review: a claim with no matching tool call is a flag', vi: 'Soát vết chạy: một lời khẳng định không có lần gọi tool tương ứng là dấu hiệu cần xem' }, icon: 'eye' },
] as const;
---
<figure class="a21v">
  <div class="a21v-scroll">
    <svg viewBox="0 0 900 420" role="img" aria-label="Project Vend, a Claude-run office shop with five tools: web search, email, notes, Slack, and price changes. Three failures and the code rule that would have limited each: below-cost prices need a price floor, a repeated staff discount needs read-only discount rules, and a claim of delivering in person needs a trace review.">
      <text x="20" y="28" class="a21v-h"><tspan data-lang-en>Project Vend: five tools, three failures, and the rule that fits each</tspan><tspan data-lang-vi>Project Vend: năm tool, ba lỗi, và luật hợp với từng lỗi</tspan></text>
      <rect x="20" y="44" width="860" height="40" rx="8" class="a21v-tools" />
      <text x="34" y="69" class="a21v-t"><tspan data-lang-en>Tools it had:</tspan><tspan data-lang-vi>Tool nó có:</tspan></text>
      {tools.map((t, i) => (
        <g>
          <rect x={150 + i * 146} y="52" width="132" height="24" rx="12" class="a21v-chip" />
          <text x={150 + i * 146 + 66} y="68" text-anchor="middle" class="a21v-s"><tspan data-lang-en>{t.en}</tspan><tspan data-lang-vi>{t.vi}</tspan></text>
        </g>
      ))}
      <text x="20" y="116" class="a21v-ch"><tspan data-lang-en>What went wrong</tspan><tspan data-lang-vi>Điều đã sai</tspan></text>
      <text x="480" y="116" class="a21v-ch"><tspan data-lang-en>What code could have enforced</tspan><tspan data-lang-vi>Điều code có thể bắt buộc</tspan></text>
      {rows.map((r, i) => (
        <g>
          <rect x="20" y={128 + i * 88} width="420" height="76" rx="8" class="a21v-bad" />
          <foreignObject x="30" y={132 + i * 88} width="400" height="68">
            <p xmlns="http://www.w3.org/1999/xhtml" class="a21v-fp"><span data-lang-en>{r.f.en}</span><span data-lang-vi>{r.f.vi}</span></p>
          </foreignObject>
          <polygon points={`470,${166 + i * 88} 456,${158 + i * 88} 456,${174 + i * 88}`} class="a21v-head" />
          <rect x="480" y={128 + i * 88} width="400" height="76" rx="8" class="a21v-good" />
          <DiagramIcon name={r.icon} x="504" y={166 + i * 88} size={22} />
          <foreignObject x="528" y={132 + i * 88} width="344" height="68">
            <p xmlns="http://www.w3.org/1999/xhtml" class="a21v-fp"><span data-lang-en>{r.g.en}</span><span data-lang-vi>{r.g.vi}</span></p>
          </foreignObject>
        </g>
      ))}
      <text x="20" y="408" class="a21v-s"><tspan data-lang-en>Anthropic's verdict on the first run: "we would not hire Claudius."</tspan><tspan data-lang-vi>Kết luận của Anthropic về lượt chạy đầu: "we would not hire Claudius."</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The model's text is not where the fix lives. Each rule on the right is a few lines of ordinary code around the tool.</span>
    <span data-lang-vi>Chỗ sửa không nằm ở lời của model. Mỗi luật bên phải chỉ là vài dòng code thường bọc quanh tool.</span>
  </figcaption>
</figure>

<style>
  .a21v { margin: 2em 0; width: 100%; }
  .a21v-scroll { overflow-x: auto; }
  .a21v svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .a21v text { font-size: 13px; fill: var(--text-body); }
  .a21v .a21v-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .a21v .a21v-t { font-size: 13px; font-weight: 700; fill: var(--text); }
  .a21v .a21v-ch { font-size: 13px; font-weight: 700; fill: var(--text-muted); }
  .a21v .a21v-s { font-size: 12.5px; fill: var(--text-muted); }
  .a21v .a21v-fp { margin: 0; font-size: 13px; line-height: 1.4; color: var(--text-body); font-family: inherit; }
  .a21v-tools { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .a21v-chip { fill: var(--bg); stroke: var(--border); stroke-width: 1.1; }
  .a21v-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
  .a21v-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.4; }
  .a21v-head { fill: var(--text-muted); }
  .a21v figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
