---
// A Lamport clock followed step by step on one causal pair. Counter values are illustrative.
// Static SVG, site tokens only.
import ConsensusFigure from './ConsensusFigure.astro';
import DiagramIcon from './DiagramIcon.astro';
import { head } from './consensus-fig';
interface Props { lang: 'en' | 'vi' }
const { lang } = Astro.props;

const T = {
  en: {
    aria: 'Three numbered steps on two nodes that both start with counter 0. 1: node acct ticks its counter from 0 to 1 and stamps the privacy change (1, acct). 2: acct sends a message that carries counter 1. 3: node photo receives it, sets its counter to max(0, 1) = 1, ticks to 2 and stamps the photo upload (2, photo). Result: (1, acct) is smaller than (2, photo), so causal order holds.',
    acct: 'acct', photo: 'photo',
    s1: ['1  Local event: tick', 'counter 0 → 1', '(1, acct)  privacy = private'],
    s2: '2  Message carries counter 1',
    s3: ['3  Receive, then tick', 'max(0, 1) = 1, then 1 → 2', '(2, photo)  photo upload'],
    res: '(1, acct) < (2, photo): the cause always gets the smaller stamp.',
    cap: 'The message is what moves the counter forward; that is why causal order survives.',
  },
  vi: {
    aria: 'Ba bước đánh số trên hai node cùng bắt đầu với bộ đếm 0. 1: node acct tăng bộ đếm từ 0 lên 1 và đóng dấu lần đổi chế độ riêng tư (1, acct). 2: acct gửi một thông điệp mang bộ đếm 1. 3: node photo nhận, đặt bộ đếm là max(0, 1) = 1, tăng lên 2 và đóng dấu lần đăng ảnh (2, photo). Kết quả: (1, acct) nhỏ hơn (2, photo), nên thứ tự nhân quả được giữ.',
    acct: 'acct', photo: 'photo',
    s1: ['1  Sự kiện cục bộ: tăng', 'bộ đếm 0 → 1', '(1, acct)  privacy = private'],
    s2: '2  Thông điệp mang bộ đếm 1',
    s3: ['3  Nhận rồi tăng', 'max(0, 1) = 1, rồi 1 → 2', '(2, photo)  đăng ảnh'],
    res: '(1, acct) < (2, photo): nguyên nhân luôn nhận dấu nhỏ hơn.',
    cap: 'Thông điệp là thứ đẩy bộ đếm tiến lên, nên thứ tự nhân quả được giữ.',
  },
}[lang];
const bw = 290, bh = 66;
---
<ConsensusFigure aria={T.aria} cap={T.cap} w={900} h={330}>
  <DiagramIcon name="laptop" x={34} y={92} size={26} />
  <text x="62" y="97" class="cfg-n">{T.acct}</text>
  <DiagramIcon name="phone" x={34} y={222} size={26} />
  <text x="62" y="227" class="cfg-n">{T.photo}</text>
  <line x1="140" x2="880" y1="92" y2="92" class="cfg-line is-dash" style="opacity:.5" />
  <line x1="140" x2="880" y1="222" y2="222" class="cfg-line is-dash" style="opacity:.5" />

  <rect x="150" y="59" width={bw} height={bh} rx="6" class="cfg-box" />
  <text x="164" y="80" class="cfg-n">{T.s1[0]}</text>
  <text x="164" y="97">{T.s1[1]}</text>
  <text x="164" y="115" class="cfg-code">{T.s1[2]}</text>

  <rect x="570" y="189" width={bw} height={bh} rx="6" class="cfg-box is-ok" />
  <text x="584" y="210" class="cfg-n">{T.s3[0]}</text>
  <text x="584" y="227">{T.s3[1]}</text>
  <text x="584" y="245" class="cfg-code">{T.s3[2]}</text>

  <path d="M 440 92 L 715 92 L 715 181" class="cfg-arrow" />
  <polygon points={head(715, 150, 715, 189)} class="cfg-head" />
  <text x="578" y="82" text-anchor="middle" class="cfg-g">{T.s2}</text>

  <rect x="20" y="282" width="860" height="40" rx="6" class="cfg-box is-ok" />
  <text x="450" y="307" text-anchor="middle" class="cfg-g cfg-code" style="font-size:13px">{T.res}</text>
</ConsensusFigure>
