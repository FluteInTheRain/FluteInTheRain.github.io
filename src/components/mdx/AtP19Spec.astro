---
// Writing the game: what a first draft of state/action/reward looks like, and what a HOSE-style market adds.
// Facts: HOSE normal price band +/-7%, round lot 100, tick 100 dong at prices >= 50,000 dong
// (HOSE "Quy dinh giao dich dang website HOSE", 26/04/2025).
const W = 900;
const H = 420;
const rows = [
  {
    k: ['State', 'State'], k2: ['what the agent sees', 'agent nhìn thấy gì'],
    a: ['Last 4 daily returns and the position held', '4 lợi suất ngày gần nhất và vị thế đang giữ'],
    b: ['Prices known at the close only. Yesterday’s fundamentals, not today’s restatement.', 'Chỉ giá đã biết lúc đóng cửa. Số liệu tài chính của hôm qua, không phải bản soát xét hôm nay.'],
  },
  {
    k: ['Action', 'Action'], k2: ['what it may do', 'nó được làm gì'],
    a: ['Long or flat', 'Mua hoặc đứng ngoài'],
    b: ['Multiples of 100 shares. Orders priced inside the ±7% band around the reference price, on the tick grid.', 'Bội số của 100 cổ. Lệnh có giá trong biên ±7% quanh giá tham chiếu, đúng bước giá.'],
  },
  {
    k: ['Reward', 'Reward'], k2: ['what it is paid', 'nó được trả gì'],
    a: ['Position × return, minus cost per change', 'Vị thế × lợi suất, trừ phí mỗi lần đổi'],
    b: ['Cost must be in the reward. Ask for profit alone and the agent trades constantly.', 'Phí phải nằm trong reward. Chỉ đòi lợi nhuận thì agent giao dịch liên tục.'],
  },
];
const ry = (i: number) => 96 + i * 104;
---
<figure class="p19-spec">
  <div class="p19-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A table of three rows: state, action and reward. For each row, the left column gives the first-draft version used in this post's simulation and the right column gives what a real HOSE-style market adds: knowing only what was known at the close, trading in lots of 100 shares inside a plus or minus 7 percent price band, and including costs in the reward.">
      <text x="30" y="28" class="h">
        <tspan data-lang-en>Writing the game before the agent plays it</tspan>
        <tspan data-lang-vi>Viết luật chơi trước khi agent chơi</tspan>
      </text>
      <text x="210" y="62" class="col">
        <tspan data-lang-en>First draft (this post's simulation)</tspan>
        <tspan data-lang-vi>Bản đầu (mô phỏng trong bài)</tspan>
      </text>
      <text x="560" y="62" class="col">
        <tspan data-lang-en>What a HOSE-style market adds</tspan>
        <tspan data-lang-vi>Thị trường kiểu HOSE thêm gì</tspan>
      </text>
      {rows.map((r, i) => (
        <g>
          <rect x="30" y={ry(i) - 14} width="150" height="86" rx="8" class="lab" />
          <text x="44" y={ry(i) + 14} class="t">
            <tspan data-lang-en>{r.k[0]}</tspan>
            <tspan data-lang-vi>{r.k[1]}</tspan>
          </text>
          <text x="44" y={ry(i) + 36} class="s">
            <tspan data-lang-en>{r.k2[0]}</tspan>
            <tspan data-lang-vi>{r.k2[1]}</tspan>
          </text>
          <rect x="196" y={ry(i) - 14} width="330" height="86" rx="8" class="cell" />
          <foreignObject x="206" y={ry(i) - 8} width="310" height="76">
            <div xmlns="http://www.w3.org/1999/xhtml" class="fo"><span data-lang-en>{r.a[0]}</span><span data-lang-vi>{r.a[1]}</span></div>
          </foreignObject>
          <rect x="540" y={ry(i) - 14} width="330" height="86" rx="8" class="cell hot" />
          <foreignObject x="550" y={ry(i) - 8} width="310" height="76">
            <div xmlns="http://www.w3.org/1999/xhtml" class="fo"><span data-lang-en>{r.b[0]}</span><span data-lang-vi>{r.b[1]}</span></div>
          </foreignObject>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Rules from the HOSE trading rules page: normal price band ±7% of the reference price, lot of 100 shares. Every one of them shrinks the set of actions the agent can use.</span>
    <span data-lang-vi>Quy tắc lấy từ văn bản quy định giao dịch của HOSE: biên độ thông thường ±7% so với giá tham chiếu, lô chẵn 100 cổ phiếu. Mỗi quy tắc đều thu hẹp tập hành động mà agent được dùng.</span>
  </figcaption>
</figure>

<style>
  .p19-spec { margin: 2em 0; width: 100%; }
  .p19-scroll { overflow-x: auto; }
  .p19-spec svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p19-spec text { font-size: 14px; fill: var(--text-body); }
  .p19-spec .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p19-spec .col { font-size: 13px; font-weight: 700; fill: var(--text-muted); }
  .p19-spec .t { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p19-spec .s { font-size: 12.5px; fill: var(--text-muted); }
  .p19-spec .lab { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p19-spec .cell { fill: var(--bg); stroke: var(--border); stroke-width: 1.2; }
  .p19-spec .cell.hot { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .p19-spec .fo { font-size: 13.5px; line-height: 1.4; color: var(--text); font-family: inherit; }
  .p19-spec figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
