---
// Animated flow for Go post 1: source -> go build -> one binary -> any machine of the same type.
// Works without JS (all four stages are visible); the script only adds the step highlight.
import T from '../T.astro';
---
<div class="gbb" data-gbb>
  <div class="gbb-row" role="list">
    <div class="gbb-stage" data-stage="0" role="listitem">
      <p class="gbb-n">1</p>
      <p class="gbb-h"><T en="Your source" vi="Mã nguồn của bạn" /></p>
      <ul class="gbb-files">
        <li>go.mod</li>
        <li>cmd/greeter/main.go</li>
        <li>internal/greet/greet.go</li>
      </ul>
      <p class="gbb-note"><T en="Plain text. Nothing else to install." vi="Toàn file chữ. Không cần cài thêm gì." /></p>
    </div>
    <div class="gbb-arrow" aria-hidden="true">&rarr;</div>
    <div class="gbb-stage" data-stage="1" role="listitem">
      <p class="gbb-n">2</p>
      <p class="gbb-h"><code>go build</code></p>
      <ul class="gbb-files">
        <li><T en="checks every type" vi="kiểm tra mọi kiểu" /></li>
        <li><T en="compiles to machine code" vi="biên dịch ra mã máy" /></li>
        <li><T en="links the Go runtime in" vi="gắn sẵn Go runtime vào" /></li>
      </ul>
      <p class="gbb-note"><T en="Compiled once, before you ship." vi="Biên dịch một lần, trước khi đem đi triển khai." /></p>
    </div>
    <div class="gbb-arrow" aria-hidden="true">&rarr;</div>
    <div class="gbb-stage" data-stage="2" role="listitem">
      <p class="gbb-n">3</p>
      <p class="gbb-h"><T en="One binary" vi="Một file thực thi" /></p>
      <ul class="gbb-files">
        <li><code>greeter</code> <span class="gbb-size">2.4 MB</span></li>
      </ul>
      <p class="gbb-note"><T en="Static: no libraries to find at run time." vi="Tĩnh: lúc chạy không phải đi tìm thư viện nào." /></p>
    </div>
    <div class="gbb-arrow" aria-hidden="true">&rarr;</div>
    <div class="gbb-stage gbb-final" data-stage="3" role="listitem">
      <p class="gbb-n">4</p>
      <p class="gbb-h"><T en="Any machine of the same type" vi="Máy bất kỳ cùng loại" /></p>
      <ul class="gbb-files">
        <li><code>./greeter</code></li>
        <li><T en="no JVM, no Python" vi="không JVM, không Python" /></li>
      </ul>
      <p class="gbb-note"><T en="Nothing to install first. It runs." vi="Không phải cài gì trước. Chạy luôn." /></p>
    </div>
  </div>
  <div class="gbb-bar">
    <button type="button" class="gbb-btn" data-gbb-play hidden><T en="Replay" vi="Chạy lại" /></button>
    <p class="gbb-status" data-gbb-status aria-live="polite"></p>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-gbb]');
  if (root) {
    const stages = Array.from(root.querySelectorAll<HTMLElement>('.gbb-stage'));
    const btn = root.querySelector<HTMLButtonElement>('[data-gbb-play]');
    const status = root.querySelector<HTMLElement>('[data-gbb-status]');
    const msgs = {
      en: ['Write the code.', 'Run go build.', 'Out comes one file.', 'Copy that one file to a machine of the same type and run it.'],
      vi: ['Viết code.', 'Chạy go build.', 'Ra đúng một file.', 'Chép đúng file đó sang máy cùng loại rồi chạy.'],
    };
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | undefined;
    const show = (i: number) => {
      stages.forEach((s, k) => s.classList.toggle('is-on', k === i));
      if (status) {
        status.replaceChildren();
        (['en', 'vi'] as const).forEach((l) => {
          const span = document.createElement('span');
          span.setAttribute(`data-lang-${l}`, '');
          span.textContent = msgs[l][i] ?? '';
          status.appendChild(span);
        });
      }
    };
    const play = () => {
      window.clearTimeout(timer);
      let i = 0;
      const tick = () => {
        show(i);
        i += 1;
        if (i < stages.length) timer = window.setTimeout(tick, 1200);
      };
      tick();
    };
    if (btn) {
      btn.hidden = false;
      btn.addEventListener('click', play);
    }
    if (reduce) {
      show(stages.length - 1);
    } else {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          play();
        }
      });
      io.observe(root);
    }
  }
</script>

<style>
  .gbb { width: 100%; }
  .gbb-row { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr; gap: 8px; align-items: stretch; }
  .gbb-stage {
    border: 1.5px solid var(--border); border-radius: 10px; background: var(--bg);
    padding: 10px 12px; min-width: 0;
  }
  .gbb-stage.is-on { border-color: var(--gold); background: var(--gold-tint-bg); }
  .gbb-n { margin: 0 0 2px; font-size: 11px; font-weight: 700; color: var(--text-muted); letter-spacing: 0.04em; }
  .gbb-h { margin: 0 0 6px; font-size: 14px; font-weight: 700; color: var(--text); }
  .gbb-files { margin: 0 0 8px; padding: 0; list-style: none; font-size: 12.5px; line-height: 1.5; color: var(--text-body); }
  .gbb-files li { overflow-wrap: anywhere; }
  .gbb code { font-family: var(--font-mono, ui-monospace, monospace); font-size: 12px; }
  .gbb-size { font-size: 12px; font-weight: 700; color: var(--text); }
  .gbb-note { margin: 0; font-size: 12.5px; line-height: 1.45; color: var(--text-muted); }
  .gbb-arrow { align-self: center; font-size: 18px; color: var(--text-muted); }
  .gbb-bar { display: flex; align-items: center; gap: 12px; margin-top: 12px; min-height: 30px; }
  .gbb-btn {
    padding: 4px 12px; font: inherit; font-size: 13px; font-weight: 600; color: var(--text-body);
    background: var(--card-bg); border: 1px solid var(--border); border-radius: 6px; cursor: pointer;
  }
  .gbb-status { margin: 0; font-size: 13.5px; color: var(--text-body); }
  @media (max-width: 760px) {
    .gbb-row { grid-template-columns: 1fr; }
    .gbb-arrow { transform: rotate(90deg); justify-self: center; line-height: 1; }
  }
</style>
