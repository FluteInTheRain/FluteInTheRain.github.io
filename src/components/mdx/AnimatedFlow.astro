---
import AnimatedFlowComponent from '../demos/AnimatedFlow.tsx';

interface Props {
  preset?: 'prime-video' | 'twitter-fanout';
  scenarioId?: string;
  title?: string;
  titleVi?: string;
}

const {
  preset = 'prime-video',
  scenarioId,
  title = 'Interactive Architecture Flow Simulator',
  titleVi = 'Mô phỏng Luồng Kiến trúc Động',
} = Astro.props;
---

<section class="demo-frame animated-flow-frame">
  <AnimatedFlowComponent
    client:visible
    preset={preset}
    scenarioId={scenarioId}
    title={title}
    titleVi={titleVi}
  />
</section>
