---
// Exact break-even math for 4,000 shares bought @ 25,000 VND (100M) with 0.15% commission + 0.1% sell tax.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 260;

const TICKS = [
  { p: '25,000', net: '99,750,000', pnl: '−400,000', en: 'Selling at entry price loses 0.40%', vi: 'Bán hòa giá vốn vẫn lỗ ngay 0,40%', ok: false },
  { p: '25,100', net: '100,149,000', pnl: '−1,000', en: 'One step short — still underwater', vi: 'Vẫn thiếu 1.000 đồng mới hòa vốn', ok: false },
  { p: '25,150', net: '100,348,500', pnl: '+198,500', en: 'First profitable HOSE tick (+0.6%)', vi: 'Bước giá HOSE đầu tiên có lãi thật', ok: true },
] as const;
---
<figure class="sbp4-be">
  <div class="sbp4-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Break-even ladder for 4,000 shares bought at 25,000 VND (total cost 100,150,000 VND): selling at 25,000 loses 400,000 VND; selling at 25,100 loses 1,000 VND; 25,150 VND is the first profitable HOSE tick (+198,500 VND net).">
      <text x="20" y="30" class="sbp4-title">
        <tspan data-lang-en>Buy 4,000 shares @ 25,000 VND (total paid: 100,150,000 VND) — where is true break-even?</tspan>
        <tspan data-lang-vi>Mua 4.000 CP @ 25.000 đồng (tổng chi 100.150.000 đ) — giá nào mới thật sự hòa vốn?</tspan>
      </text>

      {TICKS.map((t, i) => {
        const y = 56 + i * 64;
        return (
          <g>
            <rect x="20" y={y} width="860" height="52" rx="8" class={t.ok ? 'sbp4-row sbp4-row-ok' : 'sbp4-row'} />
            <DiagramIcon name={t.ok ? 'ok' : 'fail'} x={48} y={y + 26} size={22} />
            <text x="78" y={y + 31} class="sbp4-hdr">{t.p} đ</text>
            <text x="210" y={y + 31} class="sbp4-body">
              <tspan data-lang-en>Net back: {t.net}</tspan>
              <tspan data-lang-vi>Thu ròng: {t.net}</tspan>
            </text>
            <text x="450" y={y + 31} class={t.ok ? 'sbp4-hdr' : 'sbp4-hdr sbp4-red'}>{t.pnl} đ</text>
            <text x="580" y={y + 31} class="sbp4-sub">
              <tspan data-lang-en>{t.en}</tspan>
              <tspan data-lang-vi>{t.vi}</tspan>
            </text>
          </g>
        );
      })}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A stock sitting at your exact buy price is not break-even: at 0.15% commission each way plus 0.1% sell tax, 25,150 VND (+0.6%) is the very first HOSE tick that turns net positive.</span>
    <span data-lang-vi>Giá cổ phiếu quay về đúng giá vốn chưa phải hòa vốn: với phí 0,15% mỗi chiều cộng thuế bán 0,1%, phải lên tới 25.150 đồng (+0,6%) mới là bước giá HOSE đầu tiên cho lãi ròng.</span>
  </figcaption>
</figure>

<style>
  .sbp4-be { margin: 2em 0; width: 100%; }
  .sbp4-scroll { overflow-x: auto; }
  .sbp4-be svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sbp4-be text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .sbp4-title { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sbp4-row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.3; }
  .sbp4-row-ok { fill: var(--bg-alt); stroke: var(--act-2); stroke-width: 1.8; }
  .sbp4-hdr { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .sbp4-red { fill: var(--red); }
  .sbp4-body { font-size: 13px; fill: var(--text-body); }
  .sbp4-sub { font-size: 12.5px; fill: var(--text-muted); }
  .sbp4-be figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
