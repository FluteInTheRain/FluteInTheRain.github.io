---
// Real heap profile of the Todo service: alloc_space (everything allocated) vs inuse_space (still live).
const W = 900;
const H = 372;
const S = 3.6; // px per percent
const alloc = [
  ['slices.Grow', 29.69],
  ['main.(*store).list', 27.34],
  ['makeStructArshaler.func2', 25.86],
  ['strconv.AppendUint', 9.46],
];
const inuse = [
  ['runtime.mallocgc', 28.84],
  ['strconv.AppendUint', 16.89],
  ['main.(*store).add', 8.14],
  ['main.(*store).list', 8.02],
];
const f = (n: number) => n.toFixed(2) + '%';
---
<figure class="gp18e">
  <div class="gp18e-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: alloc_space, the top four functions by bytes allocated since the process started, out of 1.25 GB in total. Right: inuse_space, the top four functions by bytes still live after the last garbage collection, out of 7,112 kB in total. Bottom: the two totals drawn to the same scale, where the live total is a sliver next to the allocated total.">
    <text x="20" y="24" class="h">alloc_space</text>
    <text x="20" y="46" class="m">
      <tspan data-lang-en>every byte allocated since start: 1.25 GB</tspan>
      <tspan data-lang-vi>mọi byte đã cấp phát từ lúc chạy: 1,25 GB</tspan>
    </text>
    <text x="470" y="24" class="h">inuse_space</text>
    <text x="470" y="46" class="m">
      <tspan data-lang-en>bytes still live after the last GC: 7,112 kB</tspan>
      <tspan data-lang-vi>byte còn sống sau lần GC gần nhất: 7.112 kB</tspan>
    </text>

    {alloc.map((r, i) => (
      <g>
        <text x="20" y={84 + i * 34} class="body">{r[0]}</text>
        <rect x="210" y={68 + i * 34} width={Number(r[1]) * S} height="22" rx="3" class="bar" />
        <text x={210 + Number(r[1]) * S + 8} y={84 + i * 34} class="m num">{f(Number(r[1]))}</text>
      </g>
    ))}
    {inuse.map((r, i) => (
      <g>
        <text x="470" y={84 + i * 34} class="body">{r[0]}</text>
        <rect x="660" y={68 + i * 34} width={Number(r[1]) * S} height="22" rx="3" class="bar" />
        <text x={660 + Number(r[1]) * S + 8} y={84 + i * 34} class="m num">{f(Number(r[1]))}</text>
      </g>
    ))}

    <line x1="20" x2="880" y1="226" y2="226" class="rule" />
    <text x="20" y="254" class="h">
      <tspan data-lang-en>Same scale: churn is large, what stays alive is small</tspan>
      <tspan data-lang-vi>Cùng tỉ lệ: rác sinh ra rất nhiều, phần còn sống rất nhỏ</tspan>
    </text>

    <text x="20" y="290" class="body">alloc_space</text>
    <rect x="130" y="274" width="640" height="22" rx="3" class="bar" />
    <text x="780" y="290" class="m num">1.25 GB</text>

    <text x="20" y="326" class="body">inuse_space</text>
    <rect x="130" y="310" width="3.5" height="22" class="hot" />
    <text x="146" y="326" class="m num">7,112 kB</text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Real top rows from the heap profile of the Todo service under load (Go 1.27.1); percentages are each function's own (flat) share of its total. Function names are shortened in this picture; the full names are in the pprof output above. The lower bars use one scale, so 7,112 kB is about half a percent of 1.25 GB.</span>
    <span data-lang-vi>Các dòng đầu thật từ heap profile của Todo service khi chịu tải (Go 1.27.1); phần trăm là tỉ lệ flat của từng hàm trên tổng của loại đó. Tên hàm được rút gọn trong hình, tên đầy đủ nằm ở output pprof phía trên. Hai thanh dưới dùng chung một tỉ lệ, nên 7.112 kB chỉ khoảng nửa phần trăm của 1,25 GB.</span>
  </figcaption>
</figure>

<style>
  .gp18e { margin: 2em 0; width: 100%; }
  .gp18e-scroll { overflow-x: auto; }
  .gp18e svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .gp18e text { font-size: 14px; fill: var(--text-body); }
  .gp18e .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp18e .body { font-size: 13.5px; fill: var(--text-body); }
  .gp18e .m { font-size: 13px; fill: var(--text-muted); }
  .gp18e .num { font-variant-numeric: tabular-nums; }
  .gp18e .bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp18e .hot { fill: var(--gold); stroke: var(--gold); stroke-width: 1; }
  .gp18e .rule { stroke: var(--border); stroke-width: 1; }
  .gp18e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
