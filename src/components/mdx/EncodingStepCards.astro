---
// Generic row of icon cards for the encoding post: each card shows ONE step, case or finding.
// Data comes from the thin Encoding* wrappers. Plain inline SVG with site tokens; no ids.
// Text is wrapped by hand (arrays of lines) in both languages; the build warns when a line looks too wide.
import DiagramIcon from './DiagramIcon.astro';
import type { DiagramIconName } from '../../data/diagram-icons';

type L = { en: string[]; vi: string[] };
interface Card { icon: DiagramIconName; head: L; mono?: string[]; lines: L; tone?: 'bad' | 'good' | 'plain' }
interface Props {
  title: { en: string; vi: string };
  cards: Card[];
  arrows?: boolean;
  note?: { en: string; vi: string };
  caption: { en: string; vi: string };
  alt: string;
}
const { title, cards, arrows = true, note, caption, alt } = Astro.props as Props;

const W = 900;
const n = cards.length;
const gap = arrows ? 30 : 16;
const cw = (860 - (n - 1) * gap) / n;
const y0 = 52;
const LH = 17;
const headLines = Math.max(...cards.map((c) => Math.max(c.head.en.length, c.head.vi.length)));
const bodyLines = Math.max(...cards.map((c) => (c.mono?.length ?? 0) + Math.max(c.lines.en.length, c.lines.vi.length)));
const headY = y0 + 74;
const bodyY = headY + headLines * 18 + 6;
const ch = bodyY - y0 + bodyLines * LH + 2;
const noteY = y0 + ch + 30;
const H = note ? noteY + 28 : y0 + ch + 14;
const xs = cards.map((_, i) => 20 + i * (cw + gap));

for (const c of cards) {
  for (const lang of ['en', 'vi'] as const) {
    for (const t of c.lines[lang]) if (t.length * 6.5 > cw - 16) console.warn(`[EncodingStepCards] wide ${lang}: "${t}" (${Math.round(t.length * 6.5)} > ${Math.round(cw - 16)})`);
    for (const t of c.head[lang]) if (t.length * 8 > cw - 16) console.warn(`[EncodingStepCards] wide head ${lang}: "${t}" (${Math.round(t.length * 8)} > ${Math.round(cw - 16)})`);
  }
  for (const t of c.mono ?? []) if (t.length * 7.3 > cw - 16) console.warn(`[EncodingStepCards] wide mono: "${t}" (${Math.round(t.length * 7.3)} > ${Math.round(cw - 16)})`);
}
---
<figure class="sc">
  <div class="sc-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={alt}>
    <text x="20" y="26" class="sc-h">
      <tspan data-lang-en>{title.en}</tspan>
      <tspan data-lang-vi>{title.vi}</tspan>
    </text>
    {cards.map((c, i) => {
      const cx = xs[i] + cw / 2;
      const tone = c.tone ?? 'plain';
      return (
        <g>
          <rect x={xs[i]} y={y0} width={cw} height={ch} rx="5" class={`sc-box is-${tone}`} />
          <DiagramIcon name={c.icon} x={cx} y={y0 + 32} size={34} />
          {(['en', 'vi'] as const).map((lang) => (
            <g {...(lang === 'en' ? { 'data-lang-en': '' } : { 'data-lang-vi': '' })}>
              {c.head[lang].map((t, k) => (
                <text x={cx} y={headY + k * 18} text-anchor="middle" class={`sc-title is-${tone}`}>{t}</text>
              ))}
              {c.lines[lang].map((t, k) => (
                <text x={cx} y={bodyY + ((c.mono?.length ?? 0) + k) * LH} text-anchor="middle" class="sc-small">{t}</text>
              ))}
            </g>
          ))}
          {(c.mono ?? []).map((t, k) => (
            <text x={cx} y={bodyY + k * LH} text-anchor="middle" class="sc-mono">{t}</text>
          ))}
          {arrows && i > 0 && (
            <g>
              <path d={`M${xs[i] - gap + 5},${y0 + 32} L${xs[i] - 9},${y0 + 32}`} class="sc-arrow" />
              <polygon points={`${xs[i] - 10},${y0 + 27} ${xs[i] - 10},${y0 + 37} ${xs[i] - 2},${y0 + 32}`} class="sc-head" />
            </g>
          )}
        </g>
      );
    })}
    {note && (
      <text x="20" y={noteY} class="sc-note">
        <tspan data-lang-en>{note.en}</tspan>
        <tspan data-lang-vi>{note.vi}</tspan>
      </text>
    )}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>{caption.en}</span>
    <span data-lang-vi>{caption.vi}</span>
  </figcaption>
</figure>

<style>
  .sc { margin: 2em 0; width: 100%; }
  .sc-scroll { overflow-x: auto; }
  .sc svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .sc text { font-size: 12.5px; fill: var(--text-body); }
  .sc .sc-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sc .sc-title { font-size: 14px; font-weight: 700; fill: var(--text); }
  .sc .sc-title.is-bad { fill: var(--red); }
  .sc .sc-small { fill: var(--text-muted); }
  .sc .sc-mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; fill: var(--text); }
  .sc .sc-note { font-size: 14px; font-weight: 600; fill: var(--text); }
  .sc-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .sc-box.is-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .sc-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .sc-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .sc-head { fill: var(--text-muted); }
  .sc figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
