---
// Snowplow's three timestamps on two clocks (phone and server). Example values come from the post's table.
import StreamBFigure from './StreamBFigure.astro';
import StreamBArrow from './StreamBArrow.astro';
import DiagramIcon from './DiagramIcon.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    ph: 'Phone clock (5 min slow)', sv: 'Server clock',
    buf: 'buffered on the phone: 4 min 45 s',
    same: ['same moment on', 'both clocks: +5 min'],
    add: 'add the +5 min offset',
    truth: 'derived true time',
    alt: 'Two clock lines. On the phone clock, the user tapped at 10:00:40 (device_event) and the app synced at 10:05:25 (device_send), after 4 minutes 45 seconds offline. On the server clock, the batch arrived at 10:10:25 (server_receive), the same moment, so the server is 5 minutes ahead of the phone. Adding 5 minutes to the tap gives the derived true time 10:05:40.',
    cap: 'Same values as the table above. The sync moment is read on both clocks, which gives the offset; the offset corrects the tap time.',
  },
  vi: {
    ph: 'Đồng hồ điện thoại (chậm 5 phút)', sv: 'Đồng hồ server',
    buf: 'nằm đệm trên điện thoại: 4 phút 45 giây',
    same: ['cùng một lúc trên hai', 'đồng hồ: lệch +5 phút'],
    add: 'cộng thêm độ lệch +5 phút',
    truth: 'giờ thật suy ra được',
    alt: 'Hai đường đồng hồ. Trên đồng hồ điện thoại, người dùng chạm lúc 10:00:40 (device_event) và app đồng bộ lúc 10:05:25 (device_send), sau 4 phút 45 giây ngoại tuyến. Trên đồng hồ server, lô dữ liệu tới lúc 10:10:25 (server_receive), cùng khoảnh khắc đó, nên server nhanh hơn điện thoại 5 phút. Cộng 5 phút vào lúc chạm cho ra giờ thật 10:05:40.',
    cap: 'Cùng số liệu với bảng ở trên. Khoảnh khắc đồng bộ được đọc trên cả hai đồng hồ để ra độ lệch; độ lệch này sửa lại giờ chạm.',
  },
}[lang];
const yp = 120, ys = 250, xt = 250, xs = 640;
---
<StreamBFigure h={330} alt={T.alt} cap={T.cap}>
  <DiagramIcon name="phone" x={40} y={yp} size={30} />
  <text x="20" y={yp + 36} class="name">{T.ph.length > 20 ? T.ph.slice(0, T.ph.indexOf('(') - 1) : T.ph}</text>
  {T.ph.includes('(') && <text x="20" y={yp + 54} class="sub">{T.ph.slice(T.ph.indexOf('('))}</text>}
  <DiagramIcon name="server" x={40} y={ys} size={30} />
  <text x="20" y={ys + 36} class="name">{T.sv}</text>
  <line x1="170" x2="880" y1={yp} y2={yp} class="ln" />
  <line x1="170" x2="880" y1={ys} y2={ys} class="ln" />
  <circle cx={xt} cy={yp} r="6" class="dot" /><circle cx={xs} cy={yp} r="6" class="dot" /><circle cx={xs} cy={ys} r="6" class="dot" />
  <circle cx={xt} cy={ys} r="8" class="dot good" />
  <text x={xt} y={yp - 32} text-anchor="middle" class="mono">device_event</text>
  <text x={xt} y={yp - 14} text-anchor="middle" class="name">10:00:40</text>
  <text x={xs} y={yp - 32} text-anchor="middle" class="mono">device_send</text>
  <text x={xs} y={yp - 14} text-anchor="middle" class="name">10:05:25</text>
  <text x={(xt + xs) / 2} y={yp + 24} text-anchor="middle" class="sub">{T.buf}</text>
  <text x={xs} y={ys + 32} text-anchor="middle" class="mono">server_receive</text>
  <text x={xs} y={ys + 50} text-anchor="middle" class="name">10:10:25</text>
  <text x={xt} y={ys + 32} text-anchor="middle" class="name">{T.truth}</text>
  <text x={xt} y={ys + 50} text-anchor="middle" class="name">10:05:40</text>
  <line x1={xs} x2={xs} y1={yp + 8} y2={ys - 8} class="ln dash" />
  <text x={xs + 14} y={yp + 66} class="sub">{T.same[0]}</text>
  <text x={xs + 14} y={yp + 84} class="sub">{T.same[1]}</text>
  <StreamBArrow x1={xt} y1={yp + 8} x2={xt} y2={ys - 12} kind="good" />
  <text x={xt + 14} y={yp + 70} class="sub">{T.add}</text>
</StreamBFigure>
