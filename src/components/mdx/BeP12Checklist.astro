---
import DiagramIcon from './DiagramIcon.astro';
// The review habit for an AI-written deploy: five questions, each tied to a
// capture or manifest line in the post.
const W = 900, H = 380;
const rows = [
  { icon: 'config', q: { en: 'Does it boot from the environment, and stop if a value is missing?', vi: 'Có boot từ biến môi trường, và dừng nếu thiếu giá trị?' }, no: { en: 'if not: a wrong default reaches production', vi: 'nếu không: giá trị mặc định sai lên production' } },
  { icon: 'docker', q: { en: 'Is the image small, non-root, with exec-form CMD?', vi: 'Image có nhỏ, non-root, CMD dạng exec?' }, no: { en: 'if not: root process, SIGTERM never arrives', vi: 'nếu không: process chạy root, SIGTERM không tới nơi' } },
  { icon: 'stop', q: { en: 'On SIGTERM, does it stop accepting and finish in-flight work?', vi: 'Khi nhận SIGTERM, có ngừng nhận mới và xong việc đang làm?' }, no: { en: 'if not: users see resets mid-request', vi: 'nếu không: người dùng bị reset giữa request' } },
  { icon: 'ok', q: { en: 'Does /readyz tell the truth, and does /livez stay dumb?', vi: '/readyz có nói thật, và /livez có giữ đơn giản?' }, no: { en: 'if not: traffic to a pod that cannot answer', vi: 'nếu không: traffic vào pod chưa trả lời được' } },
  { icon: 'kubernetes', q: { en: 'Does the rollout keep every ready pod until a new one is ready?', vi: 'Rollout có giữ nguyên pod ready cho tới khi pod mới ready?' }, no: { en: 'if not: capacity drops during every deploy', vi: 'nếu không: mỗi lần deploy lại mất bớt công suất' } },
];
---
<figure class="bep12k">
  <div class="bep12k-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A five-row checklist for reviewing a deploy: environment config that stops on a missing value; a small non-root image with exec-form CMD; graceful handling of SIGTERM; honest readiness and dumb liveness; and a rolling update that keeps ready pods. Each row names what breaks if the answer is no.">
    {rows.map((r, i) => (
      <g>
        <rect x="40" y={20 + i * 68} width="820" height="56" rx="8" class="box" />
        <DiagramIcon name={r.icon} x="72" y={48 + i * 68} size={24} />
        <text x="108" y={44 + i * 68} class="t"><tspan data-lang-en>{r.q.en}</tspan><tspan data-lang-vi>{r.q.vi}</tspan></text>
        <text x="108" y={64 + i * 68} class="no"><tspan data-lang-en>{r.no.en}</tspan><tspan data-lang-vi>{r.no.vi}</tspan></text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Run down it before approving an AI-written Dockerfile or manifest. Every row is something this post measured.</span>
    <span data-lang-vi>Đi qua từng dòng trước khi duyệt Dockerfile hay manifest do AI viết. Mỗi dòng đều là thứ bài này đã đo.</span>
  </figcaption>
</figure>

<style>
  .bep12k { margin: 2em 0; width: 100%; }
  .bep12k-scroll { overflow-x: auto; }
  .bep12k svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .bep12k text { font-size: 14px; fill: var(--text-body); }
  .bep12k .t { font-weight: 700; fill: var(--text); }
  .bep12k .no { fill: var(--red); font-size: 13px; }
  .bep12k .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep12k figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
