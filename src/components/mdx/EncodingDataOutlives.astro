---
// One table, many encodings underneath: PostgreSQL keeps a constant default for an added column in
// metadata (from the PostgreSQL ALTER TABLE docs quoted in the post). Row values are illustrative.
import DiagramIcon from './DiagramIcon.astro';

const disk = [
  { id: '1', name: 'Rain jacket', price: '4999', cur: '', age: ['written years ago', 'ghi từ nhiều năm trước'] },
  { id: '2', name: 'Boots', price: '8999', cur: '', age: ['written years ago', 'ghi từ nhiều năm trước'] },
  { id: '3', name: 'Scarf', price: '1999', cur: 'EUR', age: ['written after the change', 'ghi sau khi đổi'] },
];
const cols = [32, 62, 170, 250, 316];
---
<figure class="do">
  <div class="do-scroll">
  <svg viewBox="0 0 900 300" role="img" aria-label="One table, many encodings underneath. On disk, two old rows were written before the currency column existed and have no value for it; a newer row stores EUR. PostgreSQL keeps the constant default USD for the new column in the table's metadata. A query sees a currency on every row: the old rows get USD from the metadata, the new row keeps its own value. ALTER TABLE did not rewrite the old rows.">
    <rect x="20" y="20" width="410" height="196" rx="5" class="do-box" />
    <DiagramIcon name="disk" x="46" y="48" size="26" />
    <text x="70" y="53" class="do-title">
      <tspan data-lang-en>On disk, as written</tspan>
      <tspan data-lang-vi>Trên đĩa, như lúc ghi</tspan>
    </text>
    <g>
      <text x={20 + cols[0]} y="86" class="do-small">id</text>
      <text x={20 + cols[1]} y="86" class="do-small">name</text>
      <text x={20 + cols[2]} y="86" class="do-small">price</text>
      <text x={20 + cols[3]} y="86" class="do-small">currency</text>
    </g>
    {disk.map((r, i) => (
      <g>
        <text x={20 + cols[0]} y={112 + i * 30} class="do-mono">{r.id}</text>
        <text x={20 + cols[1]} y={112 + i * 30} class="do-mono">{r.name}</text>
        <text x={20 + cols[2]} y={112 + i * 30} class="do-mono">{r.price}</text>
        <text x={20 + cols[3]} y={112 + i * 30} class={r.cur ? 'do-mono' : 'do-mono is-absent'}>{r.cur || '(absent)'}</text>
      </g>
    ))}
    <text x="40" y="200" class="do-small">
      <tspan data-lang-en>Rows 1 and 2 are never rewritten.</tspan>
      <tspan data-lang-vi>Dòng 1 và 2 không bao giờ bị ghi lại.</tspan>
    </text>

    <path d="M434,115 L458,115" class="do-arrow" />
    <polygon points="457,110 457,120 466,115" class="do-head" />

    <rect x="470" y="20" width="410" height="196" rx="5" class="do-box is-key" />
    <DiagramIcon name="postgres" x="496" y="48" size="26" />
    <text x="520" y="53" class="do-title">
      <tspan data-lang-en>What a query returns</tspan>
      <tspan data-lang-vi>Query trả về gì</tspan>
    </text>
    <g>
      <text x={470 + cols[0]} y="86" class="do-small">id</text>
      <text x={470 + cols[1]} y="86" class="do-small">name</text>
      <text x={470 + cols[2]} y="86" class="do-small">price</text>
      <text x={470 + cols[3]} y="86" class="do-small">currency</text>
    </g>
    {disk.map((r, i) => (
      <g>
        <text x={470 + cols[0]} y={112 + i * 30} class="do-mono">{r.id}</text>
        <text x={470 + cols[1]} y={112 + i * 30} class="do-mono">{r.name}</text>
        <text x={470 + cols[2]} y={112 + i * 30} class="do-mono">{r.price}</text>
        <text x={470 + cols[3]} y={112 + i * 30} class={r.cur ? 'do-mono' : 'do-mono is-fill'}>{r.cur || 'USD'}</text>
      </g>
    ))}
    <text x="490" y="200" class="do-small">
      <tspan data-lang-en>USD for rows 1 and 2 comes from metadata.</tspan>
      <tspan data-lang-vi>USD ở dòng 1 và 2 lấy từ metadata.</tspan>
    </text>

    <rect x="20" y="228" width="860" height="52" rx="5" class="do-result" />
    <text x="36" y="250" class="do-title">
      <tspan data-lang-en>ALTER TABLE ... ADD currency DEFAULT 'USD' stores the default in metadata only.</tspan>
      <tspan data-lang-vi>ALTER TABLE ... ADD currency DEFAULT 'USD' chỉ lưu default vào metadata.</tspan>
    </text>
    <text x="36" y="270" class="do-small">
      <tspan data-lang-en>The table looks like one schema; the files underneath hold more than one.</tspan>
      <tspan data-lang-vi>Bảng trông như có một schema; các file bên dưới chứa nhiều hơn một.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The metadata default is how PostgreSQL makes ALTER TABLE very fast on large tables.</span>
    <span data-lang-vi>Default lưu trong metadata là cách PostgreSQL làm ALTER TABLE rất nhanh trên bảng lớn.</span>
  </figcaption>
</figure>

<style>
  .do { margin: 2em 0; width: 100%; }
  .do-scroll { overflow-x: auto; }
  .do svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .do text { font-size: 13px; fill: var(--text-body); }
  .do .do-title { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .do .do-small { font-size: 12.5px; fill: var(--text-muted); }
  .do .do-mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; fill: var(--text); }
  .do .do-mono.is-absent { fill: var(--text-muted); font-style: italic; }
  .do .do-mono.is-fill { font-weight: 700; }
  .do-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .do-box.is-key { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.6; }
  .do-result { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .do-arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .do-head { fill: var(--text-muted); }
  .do figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
