---
// One connection and the four timeouts that run() sets. Values are the ones in the post's code.
// Icons: DiagramIcon (doc = headers, file = whole request, chan-out = response write, idle = waiting connection). Bar chart: icons only, no motion.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const x0 = 230;
const sc = 8; // px per second, 0..80 s
const X = (s: number) => x0 + s * sc;
const lanes = [
  { icon: 'doc', name: 'ReadHeaderTimeout', from: 0, to: 5, en: 'time to read the request headers', vi: 'thời gian đọc header của request' },
  { icon: 'file', name: 'ReadTimeout', from: 0, to: 10, en: 'time to read the whole request, body included', vi: 'thời gian đọc cả request, gồm cả body' },
  { icon: 'chan-out', name: 'WriteTimeout', from: 1, to: 11, en: 'time to write the response, counted from the end of reading the request headers', vi: 'thời gian ghi response, tính từ lúc đọc xong header của request' },
  { icon: 'idle', name: 'IdleTimeout', from: 4, to: 64, en: 'wait for the next request on the same connection', vi: 'thời gian chờ request kế tiếp trên cùng connection' },
];
const top = 52;
const rowH = 58;
const axisY = top + lanes.length * rowH + 8;
const H = axisY + 52;
---
<figure class="gp10t">
  <div class="gp10t-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Timeline of one connection: ReadHeaderTimeout 5 seconds, ReadTimeout 10 seconds, WriteTimeout 10 seconds starting after the headers, IdleTimeout 60 seconds starting after the response.">
    <text x="20" y="24" class="h">
      <tspan data-lang-en>Four clocks on one connection</tspan>
      <tspan data-lang-vi>Bốn đồng hồ trên một connection</tspan>
    </text>
    <line x1={x0} x2={X(80)} y1={axisY} y2={axisY} class="grid" style="stroke: var(--text-muted)" />
    {[0, 10, 20, 30, 40, 50, 60, 70, 80].map((s) => (
      <g>
        <line x1={X(s)} x2={X(s)} y1={axisY - 6} y2={axisY} class="grid" />
        <text x={X(s)} y={axisY + 20} text-anchor="middle" class="m num">{s}</text>
      </g>
    ))}
    {lanes.map((l, i) => {
      const y = top + i * rowH;
      return (
        <g>
          <DiagramIcon name={l.icon} x={32} y={y + 31} size={26} />
          <text x="54" y={y + 36} class="b">{l.name}</text>
          <text x={X(l.from)} y={y + 14} class="m">
            <tspan data-lang-en>{l.en}</tspan>
            <tspan data-lang-vi>{l.vi}</tspan>
          </text>
          <rect x={X(l.from)} y={y + 22} width={(l.to - l.from) * sc} height="16" rx="3" class="bar" />
          <text x={X(l.to) + 8} y={y + 35} class="b num">{l.to - l.from} <tspan data-lang-en>s</tspan><tspan data-lang-vi>giây</tspan></text>
        </g>
      );
    })}
    <text x={x0} y={axisY + 44} class="m">
      <tspan data-lang-en>Seconds since the connection opened</tspan>
      <tspan data-lang-vi>Số giây kể từ khi connection mở</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The four limits are the values set in <code>run</code>. Where the last two bars start (headers read at 1 s, response finished at 4 s) is illustrative: a real request decides that. Each bar is a limit, not a measurement.</span>
    <span data-lang-vi>Bốn giới hạn là các giá trị đặt trong <code>run</code>. Chỗ hai thanh cuối bắt đầu (đọc xong header ở giây thứ 1, ghi xong response ở giây thứ 4) chỉ là minh hoạ: request thật mới quyết định. Mỗi thanh là một giới hạn, không phải số đo.</span>
  </figcaption>
</figure>

<style>
  .gp10t { margin: 2em 0; width: 100%; }
  .gp10t-scroll { overflow-x: auto; }
  .gp10t svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp10t text { font-size: 14px; fill: var(--text-body); }
  .gp10t .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp10t .b { font-weight: 700; fill: var(--text); }
  .gp10t .m { fill: var(--text-muted); }
  .gp10t .r { fill: var(--red); font-weight: 700; }
  .gp10t .num { font-variant-numeric: tabular-nums; }
  .gp10t .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp10t .own { fill: none; stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .gp10t .bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.2; }
  .gp10t .bar { fill: var(--text-muted); }
  .gp10t .limit { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp10t .grid { stroke: var(--border); stroke-width: 1; }
  .gp10t .redline { stroke: var(--red); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .gp10t .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp10t .ln.dash { stroke-dasharray: 3 4; }
  .gp10t .ln.red { stroke: var(--red); }
  .gp10t .hd { fill: var(--text-muted); }
  .gp10t .hd.red { fill: var(--red); }
  .gp10t figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
