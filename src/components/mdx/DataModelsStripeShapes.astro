---
import DiagramIcon from './DiagramIcon.astro';
// How Stripe's subscriptions changed shape: a field in Customer, then an array, then their own table (Jacqueline Xu, 2017).
// Arrowheads are polygons: no SVG ids.
const W = 900;
const H = 408;
type Pt = [number, number];
function arrow(pts: Pt[], len = 10, half = 5) {
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const d = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / d;
  const uy = (y2 - y1) / d;
  const bx = x2 - ux * len;
  const by = y2 - uy * len;
  const line = [...pts.slice(0, -1), [bx, by]].map((p) => p.join(',')).join(' ');
  return { line, head: `${x2},${y2} ${bx - uy * half},${by + ux * half} ${bx + uy * half},${by - ux * half}` };
}
const frames: any[] = [];
const boxes: any[] = [];
const links: any[] = [];
const labels: any[] = [];
const nums: any[] = [];
const cards = [
  { t: ['1. One subscription', '1. Một subscription'], s: ['A field inside Customer', 'Một trường trong Customer'] },
  { t: ['2. An array', '2. Một mảng'], s: ['Several per customer', 'Nhiều cái cho mỗi customer'] },
  { t: ['3. Its own table', '3. Bảng riêng'], s: ['Linked by customer_id', 'Nối bằng customer_id'] },
];
cards.forEach((c, i) => {
  const x = 10 + i * 312;
  frames.push({ x, y: 10, w: 256, h: 300 });
  labels.push({ x: x + 16, y: 38, en: c.t[0], vi: c.t[1], cls: 'h' });
  labels.push({ x: x + 16, y: 58, en: c.s[0], vi: c.s[1], cls: 'muted' });
  if (i < 2) links.push({ pts: [[x + 260, 160], [x + 308, 160]] });
});
const sx = (i: number) => 10 + i * 312;
labels.push(
  { x: sx(0) + 16, y: 262, en: 'The first rule: one customer,', vi: 'Luật ban đầu: một customer,', cls: 'muted' },
  { x: sx(0) + 16, y: 280, en: 'at most one subscription.', vi: 'tối đa một subscription.', cls: 'muted' },
  { x: sx(1) + 16, y: 250, en: 'Any change rewrites the whole', vi: 'Mọi thay đổi phải ghi lại cả', cls: 'bad' },
  { x: sx(1) + 16, y: 268, en: 'Customer record; subscription', vi: 'bản ghi Customer; truy vấn', cls: 'bad' },
  { x: sx(1) + 16, y: 286, en: 'queries scan customers.', vi: 'subscription phải quét customer.', cls: 'bad' },
  { x: sx(2) + 16, y: 250, en: 'Each subscription is its own', vi: 'Mỗi subscription là một bản', cls: 'strong' },
  { x: sx(2) + 16, y: 268, en: 'record: change one, query', vi: 'ghi riêng: sửa một cái, truy', cls: 'strong' },
  { x: sx(2) + 16, y: 286, en: 'them without customers.', vi: 'vấn mà không cần customer.', cls: 'strong' },
  { x: 62, y: 349, en: 'Hundreds of millions of subscriptions to move. At one second per object,', vi: 'Hàng trăm triệu subscription phải chuyển. Với một giây cho mỗi object,', cls: 'strong' },
  { x: 62, y: 369, en: 'a hundred million one at a time would take over three years.', vi: 'một trăm triệu cái làm tuần tự sẽ mất hơn ba năm.', cls: 'strong' },
);
boxes.push(
  { x: sx(0) + 16, y: 84, w: 224, h: 110, flat: true, en: [''], vi: [''] },
  { x: sx(0) + 32, y: 126, w: 192, h: 34, flat: true, kind: 'plain', en: ['subscription: { … }'], vi: ['subscription: { … }'] },
  { x: sx(1) + 16, y: 84, w: 224, h: 110, flat: true, en: [''], vi: [''] },
  { x: sx(1) + 32, y: 126, w: 192, h: 34, flat: true, kind: 'bad', en: ['subscriptions: [ …, … ]'], vi: ['subscriptions: [ …, … ]'] },
  { x: sx(2) + 16, y: 92, w: 96, h: 50, flat: true, en: ['customers', 'id'], vi: ['customers', 'id'] },
  { x: sx(2) + 130, y: 92, w: 110, h: 90, flat: true, kind: 'good', en: ['subscriptions', 'id', 'customer_id', 'plan, status'], vi: ['subscriptions', 'id', 'customer_id', 'plan, status'] },
  { x: 10, y: 326, w: 880, h: 72, icon: 'stripe', kind: 'bad', flat: true, en: ['', ''], vi: ['', ''] },
);
links.push({ pts: [[sx(2) + 130, 117], [sx(2) + 112, 117]], kind: 'good' });
labels.push({ x: sx(0) + 30, y: 106, en: 'Customer', vi: 'Customer', cls: 'strong' }, { x: sx(1) + 30, y: 106, en: 'Customer', vi: 'Customer', cls: 'strong' });
---
<figure class="dmss">
  <div class="dmss-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three stages. 1: a Customer record with one subscription field. 2: the field becomes an array of subscriptions; any change rewrites the whole Customer record and queries about subscriptions scan customers. 3: subscriptions get their own table linked by customer_id. Stripe had hundreds of millions of them; at one second per object, moving a hundred million one at a time would take over three years.">
    {frames.map((f) => (
      <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="6" class={`dmss-frame ${f.kind ?? ''}`} />
    ))}
    {boxes.map((b) => {
      const n = Math.max(b.en.length, b.vi.length);
      const top = !!b.top;
      const cx = b.x + b.w / 2;
      const x0 = top ? cx : b.icon ? b.x + 46 : b.x + 14;
      const y0 = top ? b.y + (b.icon ? 56 : 24) : b.y + b.h / 2 - ((n - 1) * 17) / 2 + 4;
      return (
        <g class={`dmss-box ${b.kind ?? ''}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
          {b.icon && <DiagramIcon name={b.icon} x={top ? cx : b.x + 24} y={top ? b.y + 24 : b.y + b.h / 2} size={b.is ?? 26} />}
          {Array.from({ length: n }).map((_, i) => (
            <text x={x0} y={y0 + i * 17} text-anchor={top ? 'middle' : 'start'} class={i === 0 && !b.flat ? 'dmss-name' : 'dmss-sub'}>
              <tspan data-lang-en>{b.en[i] ?? ''}</tspan>
              <tspan data-lang-vi>{b.vi[i] ?? ''}</tspan>
            </text>
          ))}
        </g>
      );
    })}
    {links.map((l) => {
      const a = arrow(l.pts);
      return (
        <g>
          <polyline points={l.plain ? l.pts.map((p) => p.join(',')).join(' ') : a.line} class={`dmss-edge ${l.kind ?? ''}`} fill="none" />
          {!l.plain && <polygon points={a.head} class={`dmss-head ${l.kind ?? ''}`} />}
        </g>
      );
    })}
    {labels.map((t) => (
      <text x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} class={`dmss-lab ${t.cls ?? ''}`}>
        <tspan data-lang-en>{t.en}</tspan>
        <tspan data-lang-vi>{t.vi ?? t.en}</tspan>
      </text>
    ))}
    {nums.map((n) => (
      <g class="dmss-num">
        <circle cx={n.x} cy={n.y} r="11" />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.n}</text>
      </g>
    ))}

  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Each shape fixed the last one's problem and brought its own.</span>
    <span data-lang-vi>Mỗi hình dạng sửa vấn đề của cái trước và mang theo vấn đề riêng.</span>
  </figcaption>
</figure>

<style>
  .dmss { margin: 2em 0; width: 100%; }
  .dmss-scroll { overflow-x: auto; }
  .dmss svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dmss text { font-size: 14px; fill: var(--text-body); }
  .dmss .dmss-name { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .dmss .dmss-sub { font-size: 12px; fill: var(--text-muted); }
  .dmss .dmss-lab { font-size: 13px; }
  .dmss .dmss-lab.h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .dmss .dmss-lab.strong { font-weight: 700; fill: var(--text); }
  .dmss .dmss-lab.muted { fill: var(--text-muted); }
  .dmss .dmss-lab.bad { font-weight: 700; fill: var(--red); }
  .dmss .dmss-lab.good { font-weight: 700; fill: var(--text); }
  .dmss .dmss-lab.mono, .dmss .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .dmss-frame { fill: none; stroke: var(--text-faint); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .dmss-frame.bad { stroke: var(--red); }
  .dmss-frame.good { stroke: var(--gold); }
  .dmss-box rect { fill: var(--bg-alt); stroke: var(--text-faint); }
  .dmss-box.bad rect { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dmss-box.good rect { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.5; }
  .dmss-box.plain rect { fill: none; stroke: var(--border); }
  .dmss-edge { stroke: var(--text-muted); stroke-width: 1.4; }
  .dmss-edge.bad { stroke: var(--red); }
  .dmss-edge.good { stroke: var(--gold-icon); }
  .dmss-head { fill: var(--text-muted); }
  .dmss-head.bad { fill: var(--red); }
  .dmss-head.good { fill: var(--gold-icon); }
  .dmss-num circle { fill: var(--bg-alt); stroke: var(--text-muted); }
  .dmss-num text { font-size: 12px; font-weight: 700; fill: var(--text); }
  .dmss figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
