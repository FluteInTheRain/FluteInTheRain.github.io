---
// Showdown: Producer-side interface pollution vs Go's consumer-side implicit interfaces.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 370;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const aLeft = arrow(226, 200, 156, 146);
const aRight = arrow(570, 200, 570, 146);
const aMidRight = arrow(750, 200, 635, 146);
---
<figure class="gaci">
  <div class="gaci-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Comparison between producer-side oversized interfaces coupling implementations to callers versus consumer-side minimal interfaces where each caller defines only the methods it needs.">
      {/* Left panel: Producer-side pollution */}
      <rect x="14" y="14" width="426" height="338" rx="10" class="gaci-panel is-red" />
      <text x="30" y="42" class="gaci-h-red">
        <tspan data-lang-en>1. Producer-side interface (Java / OOP habit)</tspan>
        <tspan data-lang-vi>1. Interface đặt ở phía Producer (thói quen OOP)</tspan>
      </text>

      <rect x="28" y="64" width="256" height="80" rx="8" class="gaci-box is-red" />
      <DiagramIcon name="warning" x={40} y={84} size={20} />
      <text x="68" y="88" class="gaci-b-red">package store (producer)</text>
      <text x="40" y="110" class="gaci-code">type CustomerStorer interface {'{'}</text>
      <text x="40" y="130" class="gaci-code">  Create, Update, Get, Delete, List</text>

      <rect x="296" y="64" width="128" height="80" rx="8" class="gaci-box" />
      <text x="360" y="96" text-anchor="middle" class="gaci-b">store.New()</text>
      <text x="360" y="116" text-anchor="middle" class="gaci-sm">
        <tspan data-lang-en>returns interface</tspan>
        <tspan data-lang-vi>trả về interface</tspan>
      </text>
      <text x="360" y="134" text-anchor="middle" class="gaci-sm-red">
        <tspan data-lang-en>hides flexibility</tspan>
        <tspan data-lang-vi>bóp sự linh hoạt</tspan>
      </text>

      <rect x="28" y="200" width="396" height="130" rx="8" class="gaci-box" />
      <text x="44" y="226" class="gaci-b">
        <tspan data-lang-en>package billing (needs 1 method, forced to mock 5)</tspan>
        <tspan data-lang-vi>package billing (chỉ dùng 1 hàm, phải mock đủ cả 5)</tspan>
      </text>
      <text x="44" y="252" class="gaci-m">
        <tspan data-lang-en>• Tight dependency on producer interface</tspan>
        <tspan data-lang-vi>• Phụ thuộc chặt vào interface của package store</tspan>
      </text>
      <text x="44" y="274" class="gaci-m">
        <tspan data-lang-en>• Adding 1 method in store breaks all test mocks</tspan>
        <tspan data-lang-vi>• Thêm 1 hàm vào store làm gãy toàn bộ mock test</tspan>
      </text>
      <text x="44" y="296" class="gaci-m">
        <tspan data-lang-en>• Abstractions invented before a real second caller</tspan>
        <tspan data-lang-vi>• Tạo abstraction trước khi có nhu cầu thực tế</tspan>
      </text>

      <path d={aLeft.line} class="gaci-arrow is-red" /><polygon points={aLeft.head} class="gaci-head is-red" />

      {/* Right panel: Consumer-side Go idiom */}
      <rect x="460" y="14" width="426" height="338" rx="10" class="gaci-panel is-ok" />
      <text x="476" y="42" class="gaci-h-ok">
        <tspan data-lang-en>2. Consumer-side interface (idiomatic Go)</tspan>
        <tspan data-lang-vi>2. Interface đặt ở phía Consumer (chuẩn Go)</tspan>
      </text>

      <rect x="474" y="64" width="194" height="80" rx="8" class="gaci-box is-ok" />
      <DiagramIcon name="ok" x={486} y={84} size={20} />
      <text x="514" y="88" class="gaci-b-ok">package store</text>
      <text x="488" y="110" class="gaci-code">func New() *Store</text>
      <text x="488" y="130" class="gaci-sm">
        <tspan data-lang-en>returns concrete struct</tspan>
        <tspan data-lang-vi>trả về concrete struct</tspan>
      </text>

      <rect x="680" y="64" width="192" height="80" rx="8" class="gaci-box" />
      <text x="776" y="92" text-anchor="middle" class="gaci-b">io.Reader / fmt</text>
      <text x="776" y="112" text-anchor="middle" class="gaci-sm">
        <tspan data-lang-en>1–2 method contracts</tspan>
        <tspan data-lang-vi>hợp đồng 1–2 method</tspan>
      </text>
      <text x="776" y="132" text-anchor="middle" class="gaci-sm-ok">
        <tspan data-lang-en>satisfied implicitly</tspan>
        <tspan data-lang-vi>tự khớp ngầm định</tspan>
      </text>

      <rect x="474" y="200" width="192" height="130" rx="8" class="gaci-box" />
      <text x="488" y="226" class="gaci-b">package billing</text>
      <text x="488" y="250" class="gaci-code">type getter interface {'{'}</text>
      <text x="488" y="270" class="gaci-code">  Get(id) Customer</text>
      <text x="488" y="290" class="gaci-code">{'}'}</text>
      <text x="488" y="314" class="gaci-sm-ok">
        <tspan data-lang-en>zero store import in tests</tspan>
        <tspan data-lang-vi>test không cần import store</tspan>
      </text>

      <rect x="678" y="200" width="194" height="130" rx="8" class="gaci-box" />
      <text x="692" y="226" class="gaci-b">package audit</text>
      <text x="692" y="250" class="gaci-code">type lister interface {'{'}</text>
      <text x="692" y="270" class="gaci-code">  List() []Customer</text>
      <text x="692" y="290" class="gaci-code">{'}'}</text>
      <text x="692" y="314" class="gaci-sm-ok">
        <tspan data-lang-en>decoupled from billing</tspan>
        <tspan data-lang-vi>tách rời khỏi billing</tspan>
      </text>

      <path d={aRight.line} class="gaci-arrow is-ok" /><polygon points={aRight.head} class="gaci-head is-ok" />
      <path d={aMidRight.line} class="gaci-arrow is-ok" /><polygon points={aMidRight.head} class="gaci-head is-ok" />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Accept interfaces, return structs. Because Go interfaces are satisfied implicitly, keeping interface definitions small and on the consumer side removes mock boilerplate and decouples packages.</span>
    <span data-lang-vi>Nhận vào interface, trả về concrete struct. Vì Go khớp interface ngầm định không cần từ khóa implements, đặt interface nhỏ gọn ở phía consumer giúp bỏ mock thừa và tách rời các package.</span>
  </figcaption>
</figure>

<style>
  .gaci { margin: 2em 0; width: 100%; }
  .gaci-scroll { overflow-x: auto; }
  .gaci svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gaci text { font-size: 12px; fill: var(--text-body); }
  .gaci-panel { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.5; }
  .gaci-panel.is-red { fill: var(--red-tint-bg); stroke: var(--red); }
  .gaci-panel.is-ok { stroke: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gaci-panel.is-ok { stroke: rgb(74, 222, 128); }
  .gaci-box { fill: var(--bg); stroke: var(--border); stroke-width: 1.3; }
  .gaci-box.is-red { stroke: var(--red); }
  .gaci-box.is-ok { stroke: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gaci-box.is-ok { stroke: rgb(74, 222, 128); }
  .gaci-h-red { font-size: 14px; font-weight: 700; fill: var(--red); }
  .gaci-h-ok { font-size: 14px; font-weight: 700; fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gaci-h-ok { fill: rgb(74, 222, 128); }
  .gaci-b { font-weight: 700; fill: var(--text); }
  .gaci-b-red { font-weight: 700; fill: var(--red); }
  .gaci-b-ok { font-weight: 700; fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gaci-b-ok { fill: rgb(74, 222, 128); }
  .gaci-m { font-size: 11.5px; fill: var(--text-body); }
  .gaci-code { font-size: 11px; fill: var(--text-body); }
  .gaci-sm { font-size: 11px; fill: var(--text-muted); }
  .gaci-sm-red { font-size: 11px; font-weight: 700; fill: var(--red); }
  .gaci-sm-ok { font-size: 11px; font-weight: 700; fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gaci-sm-ok { fill: rgb(74, 222, 128); }
  .gaci-arrow { fill: none; stroke-width: 1.6; }
  .gaci-arrow.is-red { stroke: var(--red); }
  .gaci-arrow.is-ok { stroke: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gaci-arrow.is-ok { stroke: rgb(74, 222, 128); }
  .gaci-head.is-red { fill: var(--red); }
  .gaci-head.is-ok { fill: rgb(21, 128, 61); }
  :global(html[data-theme='dark']) .gaci-head.is-ok { fill: rgb(74, 222, 128); }
  .gaci figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
