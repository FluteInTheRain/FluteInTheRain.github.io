---
// Share of total risk contributed by each of three assets (volatility 10%, 20%, 40%, pairwise correlation 0.3).
// Equal weight: risk shares 9.5 / 23.8 / 66.7, portfolio volatility 18.1%. Inverse volatility (weights 57.1 / 28.6 / 14.3):
// 33.3 each, portfolio volatility 12.5%. Python: see quiz verifiedBy.
const assets = [
  { n: 'A', v: 10, eq: 9.5, iv: 33.3, we: 33.3, wi: 57.1 },
  { n: 'B', v: 20, eq: 23.8, iv: 33.3, we: 33.3, wi: 28.6 },
  { n: 'C', v: 40, eq: 66.7, iv: 33.3, we: 33.3, wi: 14.3 },
];
const W = 900, H = 360;
const sx = (v: number) => v * 3.6;
---
<figure class="p07e">
  <div class="p07e-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Two panels with three assets A, B, C of volatility 10, 20 and 40 percent. Left, equal weights of 33.3 percent each: risk shares of 9.5, 23.8 and 66.7 percent and portfolio volatility 18.1 percent. Right, inverse-volatility weights of 57.1, 28.6 and 14.3 percent: every asset contributes 33.3 percent of the risk and portfolio volatility is 12.5 percent.">
    <text x="20" y="26" class="h"><tspan data-lang-en>Equal money is not equal risk</tspan><tspan data-lang-vi>Chia đều tiền không phải chia đều rủi ro</tspan></text>
    {[
      { x: 20, k: 'eq', en: 'Equal weights: 33.3% each', vi: 'Trọng số đều: 33,3% mỗi mã', sub_en: 'portfolio volatility 18.1%', sub_vi: 'biến động danh mục 18,1%', c: 'redf' },
      { x: 480, k: 'iv', en: 'Weights 57.1 / 28.6 / 14.3%', vi: 'Trọng số 57,1 / 28,6 / 14,3%', sub_en: 'portfolio volatility 12.5%', sub_vi: 'biến động danh mục 12,5%', c: 'gold' },
    ].map((p) => (
      <g>
        <rect x={p.x} y="44" width="400" height="290" rx="8" class="box" />
        <text x={p.x + 16} y="72" class="bt"><tspan data-lang-en>{p.en}</tspan><tspan data-lang-vi>{p.vi}</tspan></text>
        <text x={p.x + 16} y="92" class="m"><tspan data-lang-en>{p.sub_en}. Share of total risk:</tspan><tspan data-lang-vi>{p.sub_vi}. Tỷ trọng trong tổng rủi ro:</tspan></text>
        {assets.map((a, i) => (
          <g>
            <text x={p.x + 16} y={140 + i * 62} class="lab">{a.n}</text>
            <text x={p.x + 16} y={156 + i * 62} class="m">{a.v}%</text>
            <rect x={p.x + 56} y={124 + i * 62} width={sx(a[p.k])} height="26" rx="3" class={p.c} />
            <text x={p.x + 56 + sx(a[p.k]) + 8} y={143 + i * 62} class="num">{a[p.k]}%</text>
          </g>
        ))}
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Say asset C swings four times as much as A. With equal money it supplies two thirds of the portfolio's risk. Giving each asset money in proportion to 1 over its volatility evens the shares out.</span>
    <span data-lang-vi>Giả sử tài sản C dao động gấp bốn lần A. Chia đều tiền thì C gánh hai phần ba rủi ro của danh mục. Chia tiền theo 1 trên độ biến động thì các phần rủi ro đều nhau.</span>
  </figcaption>
</figure>

<style>

  .p07e { margin: 2em 0; width: 100%; }
  .p07e-scroll { overflow-x: auto; }
  .p07e svg { display: block; width: 100%; min-width: 600px; height: auto; font-variant-numeric: tabular-nums; }
  .p07e text { font-size: 14px; fill: var(--text-body); }
  .p07e .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p07e .sub { font-size: 12.5px; fill: var(--text-muted); }
  .p07e .m { font-size: 12.5px; fill: var(--text-muted); }
  .p07e .lab { font-size: 13px; font-weight: 600; fill: var(--text); }
  .p07e .bt { font-size: 14px; font-weight: 700; fill: var(--text); }
  .p07e .num { font-size: 13px; font-weight: 700; fill: var(--text); }
  .p07e .num.red { fill: var(--red); }
  .p07e .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p07e .boxred { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .p07e .grid { stroke: var(--border); stroke-width: 1; }
  .p07e .arrow { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.3; }
  .p07e .gold { fill: var(--gold); }
  .p07e .grey { fill: var(--text-muted); opacity: 0.55; }
  .p07e .redf { fill: var(--red); }
  .p07e .line-gold { stroke: var(--gold); stroke-width: 2.5; fill: none; }
  .p07e .line-red { stroke: var(--red); stroke-width: 2.5; fill: none; }
  .p07e .dash { stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 5 4; fill: none; }
  .p07e .dashred { stroke: var(--red); stroke-width: 1.8; stroke-dasharray: 5 4; fill: none; }
  .p07e figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
