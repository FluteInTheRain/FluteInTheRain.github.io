---
import EncodingStepCards from './EncodingStepCards.astro';
const props = {
 "arrows": true,
 "title": {
  "en": "Reusing tag 2: old bytes get a new meaning",
  "vi": "Dùng lại tag 2: byte cũ mang nghĩa mới"
 },
 "alt": "Old data on disk has tag 2 holding 4999, written when tag 2 meant the price. A new schema reuses number 2 for discount_percent. A new reader decoding the old data reports discount_percent equal to 4999, with no error.",
 "cards": [
  {
   "icon": "file",
   "head": {
    "en": [
     "Old data on disk"
    ],
    "vi": [
     "Dữ liệu cũ trên đĩa"
    ]
   },
   "lines": {
    "en": [
     "Written when tag 2",
     "meant the price."
    ],
    "vi": [
     "Ghi khi tag 2",
     "còn là giá tiền."
    ]
   },
   "tone": "plain",
   "mono": [
    "tag 2 = 4999"
   ]
  },
  {
   "icon": "key",
   "head": {
    "en": [
     "New schema"
    ],
    "vi": [
     "Schema mới"
    ]
   },
   "lines": {
    "en": [
     "Someone reuses number 2",
     "for a different field."
    ],
    "vi": [
     "Ai đó dùng lại số 2",
     "cho một trường khác."
    ]
   },
   "tone": "plain",
   "mono": [
    "tag 2 = discount_percent"
   ]
  },
  {
   "icon": "fail",
   "head": {
    "en": [
     "New reader, old data"
    ],
    "vi": [
     "Reader mới, data cũ"
    ]
   },
   "lines": {
    "en": [
     "No error, wrong value.",
     "The same mistake as",
     "Knight's reused flag."
    ],
    "vi": [
     "Không lỗi, sai giá trị.",
     "Cùng kiểu sai với cờ",
     "bị dùng lại của Knight."
    ]
   },
   "tone": "bad",
   "mono": [
    "discount_percent = 4999"
   ]
  }
 ],
 "note": {
  "en": "The fix: delete the field and write reserved 2; so nobody reuses it.",
  "vi": "Cách chữa: xoá trường và ghi reserved 2; để không ai dùng lại."
 },
 "caption": {
  "en": "This is the \"proto reused tag 2\" line of the terminal output, drawn as three steps.",
  "vi": "Đây là dòng \"proto reused tag 2\" của kết quả terminal, vẽ thành ba bước."
 }
};
---
<EncodingStepCards {...props} />
