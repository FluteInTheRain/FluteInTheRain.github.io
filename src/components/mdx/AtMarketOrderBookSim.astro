---
// A snapshot order-book simulator for one imaginary HOSE stock (tick 50 VND).
// Static by default (state 0 renders without JavaScript); a tiny script toggles
// one "walk the book" step. All numbers are illustrative. No ids: the figure
// renders twice on the page (EN + VI copies), so state groups are keyed by class.
const W = 900;
const H = 400;

// prices are illustrative; en/vi thousand separators differ
const en = (n: number) => n.toLocaleString('en-US');
const vi = (n: number) => n.toLocaleString('vi-VN');

const ROW_H = 38;
const TOP = 96;

const BIDS = [
  { p: 24500, s: 1200 },
  { p: 24450, s: 2300 },
  { p: 24400, s: 800 },
  { p: 24350, s: 1500 },
  { p: 24300, s: 900 },
];

const ASKS_0 = [
  { p: 24550, s: 600 },
  { p: 24600, s: 1100 },
  { p: 24650, s: 1700 },
  { p: 24700, s: 400 },
  { p: 24750, s: 950 },
];

// after a buy of 900 at limit 24,600: 600 filled at 24,550, 300 at 24,600
const ASKS_1 = [
  { p: 24550, s: 0 },
  { p: 24600, s: 800 },
  { p: 24650, s: 1700 },
  { p: 24700, s: 400 },
  { p: 24750, s: 950 },
];

const MAXS = 2300;
const barW = (s: number) => Math.round((s / MAXS) * 240);
const rowY = (i: number) => TOP + i * ROW_H;
---
<figure class="atm-book">
  <div class="atm-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="An order-book ladder for one imaginary stock: five buy prices on the left, five sell prices on the right, a 50-dong spread between the best bid and the best ask. Pressing match sends a 900-share buy that fills 600 shares at 24,550 and 300 shares at 24,600, moving the best ask up one step.">
      <text x="20" y="32" class="atm-b-title">
        <tspan data-lang-en>One stock's order book, mid-session</tspan>
        <tspan data-lang-vi>Sổ lệnh của một cổ phiếu, giữa phiên</tspan>
      </text>

      <text x="250" y="66" text-anchor="middle" class="atm-b-side atm-b-side-bid">
        <tspan data-lang-en>Buy orders (bids)</tspan>
        <tspan data-lang-vi>Lệnh mua (bid)</tspan>
      </text>
      <text x="650" y="66" text-anchor="middle" class="atm-b-side atm-b-side-ask">
        <tspan data-lang-en>Sell orders (asks)</tspan>
        <tspan data-lang-vi>Lệnh bán (ask)</tspan>
      </text>
      <text x="450" y="66" text-anchor="middle" class="atm-b-sub">
        <tspan data-lang-en>spread: 50 đ (one step)</tspan>
        <tspan data-lang-vi>chênh lệch giá: 50 đ (một bước)</tspan>
      </text>

      {/* best rows highlighted */}
      <rect x="60" y={rowY(0)} width="380" height={ROW_H - 6} rx="3" class="atm-b-hl-bid" />
      <rect x="460" y={rowY(0)} width="380" height={ROW_H - 6} rx="3" class="atm-b-hl-ask" />

      {/* bids: price, bar, size (static through all steps) */}
      {BIDS.map((b, i) => (
        <g>
          <text x="140" y={rowY(i) + 20} text-anchor="end" class="atm-b-price"><tspan data-lang-en>{en(b.p)}</tspan><tspan data-lang-vi>{vi(b.p)}</tspan></text>
          <rect x="150" y={rowY(i) + 6} width={barW(b.s)} height={ROW_H - 18} rx="2" class="atm-b-bar-bid" />
          <text x={150 + barW(b.s) + 8} y={rowY(i) + 20} class="atm-b-size"><tspan data-lang-en>{en(b.s)}</tspan><tspan data-lang-vi>{vi(b.s)}</tspan></text>
        </g>
      ))}

      {/* centre divider */}
      <line x1="450" y1="80" x2="450" y2={TOP + 5 * ROW_H - 6} class="atm-b-divider" />

      {/* asks: mirrored; two alternative states keyed by class */}
      {[ASKS_0, ASKS_1].map((asks, si) => (
        <g class={`atm-asks atm-asks-${si}`}>
          {asks.map((a, i) => (
            <g>
              <text x="760" y={rowY(i) + 20} class="atm-b-price">
                {a.s === 0 ? <tspan class="atm-b-empty">—</tspan> : <><tspan data-lang-en>{en(a.p)}</tspan><tspan data-lang-vi>{vi(a.p)}</tspan></>}
              </text>
              {a.s > 0 && <rect x={750 - barW(a.s)} y={rowY(i) + 6} width={barW(a.s)} height={ROW_H - 18} rx="2" class="atm-b-bar-ask" />}
              {a.s > 0 && <text x={750 - barW(a.s) - 8} y={rowY(i) + 20} text-anchor="end" class="atm-b-size"><tspan data-lang-en>{en(a.s)}</tspan><tspan data-lang-vi>{vi(a.s)}</tspan></text>}
              {a.s === 0 && <text x="700" y={rowY(i) + 20} text-anchor="end" class="atm-b-sub"><tspan data-lang-en>all matched</tspan><tspan data-lang-vi>đã khớp hết</tspan></text>}
            </g>
          ))}
        </g>
      ))}

      {/* status lines: two alternative states */}
      <g class="atm-status atm-status-0">
        <text x="450" y="330" text-anchor="middle" class="atm-b-status">
          <tspan data-lang-en>As it stands: best bid 24,500, best ask 24,550.</tspan>
          <tspan data-lang-vi>Tình trạng hiện tại: bid tốt nhất 24.500, ask tốt nhất 24.550.</tspan>
        </text>
      </g>
      <g class="atm-status atm-status-1">
        <text x="450" y="330" text-anchor="middle" class="atm-b-status">
          <tspan data-lang-en>A buy of 900 shares, limit 24,600: 600 filled at 24,550, then 300 at 24,600.</tspan>
          <tspan data-lang-vi>Lệnh mua 900 cp, giá tối đa 24.600: khớp 600 cp tại 24.550, rồi 300 cp tại 24.600.</tspan>
        </text>
        <text x="450" y="352" text-anchor="middle" class="atm-b-status">
          <tspan data-lang-en>The whole order filled; the best ask is now 24,600 and the spread is 100 đ.</tspan>
          <tspan data-lang-vi>Lệnh khớp hết; ask tốt nhất giờ là 24.600 và chênh lệch giá là 100 đ.</tspan>
        </text>
      </g>
    </svg>
  </div>
  <div class="atm-controls">
    <button type="button" class="atm-btn" data-atm-action="match">
      <span data-lang-en>Match an order</span>
      <span data-lang-vi>Cho một lệnh khớp</span>
    </button>
    <button type="button" class="atm-btn" data-atm-action="reset">
      <span data-lang-en>Reset</span>
      <span data-lang-vi>Đặt lại</span>
    </button>
  </div>
  <figcaption>
    <span data-lang-en>Simulated ladder for one imaginary stock (price range 10,000–49,950 đ, so one step is 50 đ). Illustrative numbers, not real market data. Press "match an order" to walk a 900-share buy through the book; the page works fully without it.</span>
    <span data-lang-vi>Sổ lệnh mô phỏng cho một cổ phiếu tưởng tượng (vùng giá 10.000–49.950 đ, nên một bước giá là 50 đ). Số liệu minh họa, không phải dữ liệu thật. Bấm "cho một lệnh khớp" để đi một lệnh mua 900 cp xuyên qua sổ lệnh; không bấm thì trang vẫn đầy đủ nội dung.</span>
  </figcaption>
</figure>

<script>
  document.querySelectorAll('.atm-book').forEach((fig) => {
    const match = fig.querySelector('[data-atm-action="match"]');
    const reset = fig.querySelector('[data-atm-action="reset"]');
    match?.addEventListener('click', () => fig.setAttribute('data-step', '1'));
    reset?.addEventListener('click', () => fig.removeAttribute('data-step'));
  });
</script>

<style>
  .atm-book {
    margin: 2em 0;
    width: 100%;
  }
  .atm-scroll {
    overflow-x: auto;
  }
  .atm-book svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .atm-book text {
    font-size: 14px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .atm-b-title {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .atm-b-side {
    font-weight: 700;
  }
  .atm-b-side-bid {
    fill: var(--gold-icon);
  }
  .atm-b-side-ask {
    fill: var(--red);
  }
  .atm-b-price {
    font-weight: 700;
    fill: var(--text);
  }
  .atm-b-size,
  .atm-b-sub {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .atm-b-empty {
    fill: var(--text-faint);
  }
  .atm-b-divider {
    stroke: var(--border);
    stroke-dasharray: 4 4;
  }
  .atm-b-hl-bid {
    fill: var(--gold-tint-bg);
  }
  .atm-b-hl-ask {
    fill: var(--red-tint-bg);
  }
  .atm-b-bar-bid {
    fill: var(--gold-icon);
    opacity: 0.55;
  }
  .atm-b-bar-ask {
    fill: var(--red);
    opacity: 0.55;
  }
  .atm-b-status {
    font-size: 14px;
    fill: var(--text);
  }
  .atm-controls {
    margin-top: 8px;
    display: flex;
    gap: 10px;
    justify-content: center;
  }
  .atm-btn {
    font: inherit;
    font-size: 14px;
    padding: 4px 14px;
    border-radius: 4px;
    border: 1px solid var(--border);
    background: var(--bg-alt);
    color: var(--text);
    cursor: pointer;
  }
  .atm-btn:hover {
    border-color: var(--red);
    color: var(--red);
  }
  .atm-book figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }

  /* step states: default shows state 0; data-step="1" shows state 1 */
  .atm-book .atm-asks-1,
  .atm-book .atm-status-1 {
    visibility: hidden;
  }
  .atm-book[data-step='1'] .atm-asks-0,
  .atm-book[data-step='1'] .atm-status-0 {
    display: none;
  }
  .atm-book[data-step='1'] .atm-asks-1,
  .atm-book[data-step='1'] .atm-status-1 {
    visibility: visible;
  }
</style>
