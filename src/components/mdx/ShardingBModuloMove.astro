---
// Why hash(key) % N fails: the same 12 keys under 3 nodes and under 4 nodes. Illustrative values.
import DiagramIcon from './DiagramIcon.astro';
function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${(x2 - 6 * Math.cos(a)).toFixed(1)} ${(y2 - 6 * Math.sin(a)).toFixed(1)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}
type Lbl = { x: number; y: number; c: string; en: string[]; vi: string[]; a?: string; lh?: number };
const W = 900;
const H = 300;
const keys = Array.from({ length: 12 }, (_, i) => i);
const cx = (i: number) => 205 + i * 56;
const letter = (n: number) => 'ABCD'[n];
const moved = keys.filter((k) => k % 3 !== k % 4).length;
const labels: Lbl[] = [
  { x: 62, y: 40, c: 'b', a: 'start', en: ['Keys'], vi: ['Khoá'] },
  { x: 62, y: 112, c: 'b', a: 'start', en: ['3 nodes', 'key % 3'], vi: ['3 máy', 'key % 3'], lh: 15 },
  { x: 62, y: 182, c: 'b', a: 'start', en: ['4 nodes', 'key % 4'], vi: ['4 máy', 'key % 4'], lh: 15 },
  { x: 450, y: 238, c: 'note is-hot', en: [`${moved} of 12 keys land on a different node (75%)`], vi: [`${moved} trên 12 khoá phải sang node khác (75%)`] },
  { x: 450, y: 258, c: 'sub', en: ['Only keys 0, 1 and 2 stay where they were'], vi: ['Chỉ khoá 0, 1 và 2 ở yên chỗ cũ'] },
  { x: 450, y: 284, c: 'sub', en: ['12 keys. The benchmark above measures 74.6% on 10,000 keys.'], vi: ['12 khoá. Phép đo ở trên cho 74,6% trên 10.000 khoá.'] },
];
---
<figure class="shbm">
  <div class="shbm-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Twelve keys, 0 to 11, placed on nodes A to C with key mod 3, then on nodes A to D with key mod 4. Keys 0, 1 and 2 keep their node; the other nine move, which is 75 percent.">
      <DiagramIcon name="key" x={36} y={46} size={24} />
      <DiagramIcon name="server" x={36} y={112} size={24} />
      <DiagramIcon name="server" x={36} y={182} size={24} />
      {keys.map((k) => (
        <g>
          <rect x={cx(k) - 22} y="28" width="44" height="36" rx="6" class="box" />
          <text x={cx(k)} y="51" text-anchor="middle" class="b">{k}</text>
          <rect x={cx(k) - 22} y="94" width="44" height="36" rx="6" class="box" />
          <text x={cx(k)} y="117" text-anchor="middle" class="s">{letter(k % 3)}</text>
          <rect x={cx(k) - 22} y="164" width="44" height="36" rx="6" class={k % 3 !== k % 4 ? 'box is-hot' : 'box'} />
          <text x={cx(k)} y="187" text-anchor="middle" class={k % 3 !== k % 4 ? 'b is-hot' : 's'}>{letter(k % 4)}</text>
        </g>
      ))}
      {labels.map((l) => (
        <>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-en>{l.en.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
          <text x={l.x} y={l.y} text-anchor={l.a ?? 'middle'} class={l.c} data-lang-vi>{l.vi.map((t, i) => <tspan x={l.x} dy={i === 0 ? 0 : (l.lh ?? 15)}>{t}</tspan>)}</text>
        </>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The same keys before and after adding a fourth node. Red cells changed owner, and they are most of the row. This is why plain modulo hashing is a trap.</span>
    <span data-lang-vi>Cùng các khoá đó trước và sau khi thêm node thứ tư. Ô đỏ là khoá đổi chủ, và chúng chiếm gần hết hàng. Vì thế chia dư thuần tuý là cái bẫy.</span>
  </figcaption>
</figure>

<style>
  .shbm { margin: 2em 0; width: 100%; }
  .shbm-scroll { overflow-x: auto; }
  .shbm svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .shbm text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .shbm .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .shbm .h.is-hot { fill: var(--red); }
  .shbm .h.is-gold { fill: var(--gold-icon); }
  .shbm .sub { font-size: 12.5px; fill: var(--text-muted); }
  .shbm .sub.is-gold { fill: var(--gold-icon); font-weight: 600; }
  .shbm .b { font-size: 13px; font-weight: 700; fill: var(--text); }
  .shbm .b.is-hot { fill: var(--red); }
  .shbm .s { font-size: 12px; fill: var(--text-body); }
  .shbm .s.is-hot { fill: var(--red); font-weight: 600; }
  .shbm .note { font-size: 13px; font-weight: 600; fill: var(--text); }
  .shbm .note.is-hot { fill: var(--red); }
  .shbm .note.is-gold { fill: var(--gold-icon); }
  .shbm .num { font-size: 11px; font-weight: 700; fill: var(--text); }
  .shbm .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbm .box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .shbm .box.is-gold { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .shbm .box.is-active { stroke: var(--text); stroke-width: 1.7; }
  .shbm .box.is-dim { opacity: 0.5; }
  .shbm .circ { fill: var(--bg); stroke: var(--text-muted); stroke-width: 1.2; }
  .shbm .rule { stroke: var(--border); stroke-dasharray: 5 5; fill: none; }
  .shbm .arrow { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .shbm .arrow.is-hot { stroke: var(--red); }
  .shbm .arrow.is-gold { stroke: var(--gold-icon); stroke-width: 1.7; }
  .shbm .arrow.is-strong { stroke: var(--text); stroke-width: 1.7; }
  .shbm .arrow.is-dash { stroke-dasharray: 5 4; }
  .shbm .head { fill: var(--text-muted); }
  .shbm .head.is-hot { fill: var(--red); }
  .shbm .head.is-gold { fill: var(--gold-icon); }
  .shbm .head.is-strong { fill: var(--text); }
  .shbm figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>

