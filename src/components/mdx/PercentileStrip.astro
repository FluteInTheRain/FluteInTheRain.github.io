---
// Strip plot of 1,000 simulated request latencies on a log axis, drawn at build time.
// Shows how the mean sits among the fast requests and hides the slow tail.
// Data is generated from a fixed seed, so every build draws the same picture.

interface Props {
  seed?: number;
}
const { seed = 7 } = Astro.props;

// mulberry32: tiny deterministic PRNG
function rng(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(seed);
const gauss = () => Math.sqrt(-2 * Math.log(1 - rand())) * Math.cos(2 * Math.PI * rand());

// 98% healthy requests around 10 ms, 1.6% hit queueing/retries, 0.4% hit a GC pause or disk stall.
const N = 1000;
const samples: number[] = [];
for (let i = 0; i < N; i++) {
  const r = rand();
  if (r < 0.98) samples.push(10 * Math.exp(0.3 * gauss()));
  else if (r < 0.996) samples.push(40 + rand() * 160);
  else samples.push(400 + rand() * 800);
}
const sorted = [...samples].sort((a, b) => a - b);
const pct = (p: number) => sorted[Math.min(N - 1, Math.ceil((p / 100) * N) - 1)];
const mean = samples.reduce((s, v) => s + v, 0) / N;
const p50 = pct(50);
const p99 = pct(99);
const p999 = pct(99.9);
const fmt = (ms: number) => (ms >= 100 ? Math.round(ms).toLocaleString('en-US') : ms.toFixed(1));

// Geometry (SVG user units)
const W = 900;
const H = 272;
const left = 24;
const right = W - 24;
const bandTop = 70;
const bandBottom = 170;
const axisY = 190;
const minMs = 2;
const maxMs = 2000;
const x = (ms: number) =>
  left + ((Math.log10(ms) - Math.log10(minMs)) / (Math.log10(maxMs) - Math.log10(minMs))) * (right - left);
const ticks = [2, 5, 10, 20, 50, 100, 200, 500, 1000, 2000];

const dots = samples.map((ms) => ({
  cx: x(ms),
  cy: bandTop + rand() * (bandBottom - bandTop),
  slow: ms > p99,
}));
const slowCount = dots.filter((d) => d.slow).length;

const markers = [
  { ms: p50, label: 'p50' },
  { ms: p99, label: 'p99' },
  { ms: p999, label: 'p99.9' },
];
---
<figure class="pstrip">
  <div class="pstrip-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Strip plot of ${N} request latencies. Mean ${fmt(mean)} ms, median ${fmt(p50)} ms, p99 ${fmt(p99)} ms, p99.9 ${fmt(p999)} ms.`}>
    {/* percentile guide lines with labels above the dots */}
    {markers.map((m) => (
      <g class="pstrip-marker">
        <line x1={x(m.ms)} x2={x(m.ms)} y1={40} y2={axisY} />
        <text x={x(m.ms)} y={32} text-anchor="middle">
          <tspan class="pstrip-key">{m.label}</tspan>
          <tspan class="pstrip-num" dx="4">{fmt(m.ms)} ms</tspan>
        </text>
      </g>
    ))}

    {/* one dot per request */}
    <g>
      {dots.map((d) => <circle cx={d.cx.toFixed(1)} cy={d.cy.toFixed(1)} r="2.2" class={d.slow ? 'pstrip-dot is-slow' : 'pstrip-dot'} />)}
    </g>

    {/* the mean, drawn heavier and labelled below the axis */}
    <g class="pstrip-mean">
      <line x1={x(mean)} x2={x(mean)} y1={bandTop - 8} y2={axisY + 22} />
      <text x={x(mean) + 6} y={axisY + 40}>
        <tspan data-lang-en>mean {fmt(mean)} ms looks fine</tspan>
        <tspan data-lang-vi>mean {fmt(mean)} ms trông vẫn ổn</tspan>
      </text>
    </g>

    {/* log axis */}
    <g class="pstrip-axis">
      <line x1={left} x2={right} y1={axisY} y2={axisY} />
      {ticks.map((t) => (
        <g>
          <line x1={x(t)} x2={x(t)} y1={axisY} y2={axisY + 5} />
          <text x={x(t)} y={axisY + 17} text-anchor="middle">{t >= 1000 ? `${t / 1000}s` : t}</text>
        </g>
      ))}
    </g>

    {/* callout for the slow tail, below the axis on the right so it never meets a label */}
    <text class="pstrip-note" x={right} y={axisY + 66} text-anchor="end">
      <tspan data-lang-en>red: the {slowCount} slowest, the tail</tspan>
      <tspan data-lang-vi>đỏ: {slowCount} request chậm nhất, phần đuôi</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>
      Each dot is one request: {N.toLocaleString('en-US')} simulated requests, latency on a log scale (ms). Most finish near 10 ms, so the
      mean barely moves, but 1 request in 1,000 still waits around {fmt(p999)} ms.
    </span>
    <span data-lang-vi>
      Mỗi chấm là một request: {N.toLocaleString('vi-VN')} request mô phỏng, độ trễ theo thang log (ms). Đa số xong quanh 10 ms nên
      mean gần như không nhúc nhích, nhưng cứ 1.000 request vẫn có 1 request phải chờ khoảng {Math.round(p999).toLocaleString('vi-VN')} ms.
    </span>
  </figcaption>
</figure>

<style>
  .pstrip {
    margin: 2em 0;
    width: 100%;
  }
  /* On phones keep the chart readable and let it scroll sideways inside its own box */
  .pstrip-scroll {
    overflow-x: auto;
  }
  .pstrip svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .pstrip-dot {
    fill: var(--text-faint);
    fill-opacity: 0.35;
  }
  .pstrip-dot.is-slow {
    fill: var(--red);
    fill-opacity: 0.95;
  }
  .pstrip-marker line {
    stroke: var(--text-muted);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .pstrip-marker text,
  .pstrip-axis text {
    font-size: 14px;
    fill: var(--text-muted);
  }
  .pstrip-key {
    font-weight: 700;
    fill: var(--text);
  }
  .pstrip-num {
    font-variant-numeric: tabular-nums;
  }
  .pstrip-mean line {
    stroke: var(--text);
    stroke-width: 2;
  }
  .pstrip-mean text {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .pstrip-axis line {
    stroke: var(--text-muted);
    stroke-width: 1;
  }
  .pstrip-axis text {
    font-variant-numeric: tabular-nums;
  }
  .pstrip-note {
    font-size: 15px;
    fill: var(--red);
    font-weight: 600;
  }
  .pstrip figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
