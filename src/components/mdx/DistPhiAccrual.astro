---
import DiagramIcon from './DiagramIcon.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const L = (en: string, vi: string) => (lang === 'vi' ? vi : en);
const W = 900;
const H = 334;
---
<figure class="dph">
  <div class="dph-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L("Two timelines of heartbeats. A fixed timeout raises a false alarm on both slow gaps. An adaptive detector raises it once, then widens its wait so the second slow gap passes quietly.", "Hai dòng thời gian heartbeat. Timeout cố định báo nhầm ở cả hai khoảng trễ dài. Bộ phát hiện thích nghi chỉ báo nhầm một lần rồi nới thời gian chờ nên khoảng trễ dài thứ hai qua êm.")}>
<text x="20" y="24" class="t-h">{L("A fixed timeout vs one that learns the recent gaps (illustrative)","Timeout cố định so với timeout học theo khoảng trễ gần đây (minh họa)")}</text>
<DiagramIcon name="stopwatch" x={38} y={84} size={26} />
<text x="58" y="80" class="t-b">{L("Fixed","Timeout")}</text>
<text x="58" y="96" class="t-m">{L("timeout","cố định")}</text>
<line x1="150" x2="880" y1="132" y2="132" class="ln-gr" />
<line x1="170" x2="170" y1="72" y2="150" class="ln-gr" /><circle cx="170" cy="72" r="5" class="dot-g" />
<line x1="250" x2="250" y1="72" y2="150" class="ln-gr" /><circle cx="250" cy="72" r="5" class="dot-g" />
<line x1="330" x2="330" y1="72" y2="150" class="ln-gr" /><circle cx="330" cy="72" r="5" class="dot-g" />
<line x1="410" x2="410" y1="72" y2="150" class="ln-gr" /><circle cx="410" cy="72" r="5" class="dot-g" />
<line x1="560" x2="560" y1="72" y2="150" class="ln-gr" /><circle cx="560" cy="72" r="5" class="dot-g" />
<line x1="720" x2="720" y1="72" y2="150" class="ln-gr" /><circle cx="720" cy="72" r="5" class="dot-g" />
<rect x="170" y="102" width="80" height="16" rx="3" class="box-g" />
<rect x="250" y="102" width="80" height="16" rx="3" class="box-g" />
<rect x="330" y="102" width="80" height="16" rx="3" class="box-g" />
<rect x="410" y="102" width="80" height="16" rx="3" class="box" />
<path d="M 483 103 L 497 117 M 483 117 L 497 103" class="ln-r" />
<text x="490" y="142" class="t-r" text-anchor="middle">{L("false alarm","báo nhầm")}</text>
<rect x="560" y="102" width="80" height="16" rx="3" class="box" />
<path d="M 633 103 L 647 117 M 633 117 L 647 103" class="ln-r" />
<text x="640" y="142" class="t-r" text-anchor="middle">{L("false alarm","báo nhầm")}</text>
<DiagramIcon name="stopwatch" x={38} y={194} size={26} />
<text x="58" y="190" class="t-b">{L("Adaptive","Timeout")}</text>
<text x="58" y="206" class="t-m">{L("timeout","thích nghi")}</text>
<line x1="150" x2="880" y1="242" y2="242" class="ln-gr" />
<line x1="170" x2="170" y1="182" y2="260" class="ln-gr" /><circle cx="170" cy="182" r="5" class="dot-g" />
<line x1="250" x2="250" y1="182" y2="260" class="ln-gr" /><circle cx="250" cy="182" r="5" class="dot-g" />
<line x1="330" x2="330" y1="182" y2="260" class="ln-gr" /><circle cx="330" cy="182" r="5" class="dot-g" />
<line x1="410" x2="410" y1="182" y2="260" class="ln-gr" /><circle cx="410" cy="182" r="5" class="dot-g" />
<line x1="560" x2="560" y1="182" y2="260" class="ln-gr" /><circle cx="560" cy="182" r="5" class="dot-g" />
<line x1="720" x2="720" y1="182" y2="260" class="ln-gr" /><circle cx="720" cy="182" r="5" class="dot-g" />
<rect x="170" y="212" width="80" height="16" rx="3" class="box-g" />
<rect x="250" y="212" width="80" height="16" rx="3" class="box-g" />
<rect x="330" y="212" width="80" height="16" rx="3" class="box-g" />
<rect x="410" y="212" width="100" height="16" rx="3" class="box" />
<path d="M 503 213 L 517 227 M 503 227 L 517 213" class="ln-r" />
<text x="510" y="252" class="t-r" text-anchor="middle">{L("false alarm","báo nhầm")}</text>
<rect x="560" y="212" width="160" height="16" rx="3" class="box-g" />
<text x="20" y="296" class="t-m">{L("Bar = how long we wait after a heartbeat before suspecting the node. Gold dots are heartbeats arriving.","Thanh = thời gian chờ sau một heartbeat trước khi nghi node có vấn đề. Chấm vàng là heartbeat tới nơi.")}</text>
<text x="20" y="314" class="t-m">{L("After seeing a slow gap, the adaptive bar grows and the next slow gap raises no alarm. Units are arbitrary.","Sau khi thấy một khoảng trễ dài, thanh thích nghi dài ra và lần trễ sau không còn báo động. Đơn vị là tùy ý.")}</text>
    </svg>
  </div>
  <figcaption>{L("This is the idea behind the Phi Accrual detector: suspicion follows the observed heartbeat gaps instead of a constant.", "Đây là ý tưởng của Phi Accrual detector: mức nghi ngờ bám theo khoảng cách heartbeat quan sát được thay vì một hằng số.")}</figcaption>
</figure>

<style>
  .dph { margin: 2em 0; width: 100%; }
  .dph-scroll { overflow-x: auto; }
  .dph svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dph text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .dph .t-h { font-size: 15.5px; font-weight: 700; fill: var(--text); }
  .dph .t-b { font-weight: 700; fill: var(--text); }
  .dph .t-r { font-weight: 700; fill: var(--red); }
  .dph .t-m { fill: var(--text-muted); font-size: 12.5px; }
  .dph .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .dph .box-r { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dph .box-g { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.5; }
  .dph .box-d { fill: transparent; stroke: var(--border); stroke-dasharray: 5 4; stroke-width: 1.2; }
  .dph .box-gd { fill: transparent; stroke: var(--gold-icon); stroke-dasharray: 5 4; stroke-width: 1.4; }
  .dph .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .dph .ln-r { fill: none; stroke: var(--red); stroke-width: 2; }
  .dph .ln-g { fill: none; stroke: var(--gold-icon); stroke-width: 2; }
  .dph .ln-d { fill: none; stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .dph .ln-rd { fill: none; stroke: var(--red); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .dph .ln-gr { fill: none; stroke: var(--border); stroke-dasharray: 2 4; }
  .dph .hd { fill: var(--text-muted); }
  .dph .hd-r { fill: var(--red); }
  .dph .hd-g { fill: var(--gold-icon); }
  .dph .dot-g { fill: var(--gold-icon); }
  .dph figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
