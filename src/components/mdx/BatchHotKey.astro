---
import BatchDiagram from './BatchDiagram.astro';
const boxes = [{"x": 170, "y": 50, "w": 80, "h": 32, "t": ["", ""]}, {"x": 170, "y": 102, "w": 80, "h": 32, "t": ["", ""]}, {"x": 170, "y": 154, "w": 80, "h": 32, "t": ["", ""]}, {"x": 170, "y": 206, "w": 560, "h": 32, "t": ["", ""], "kind": "hot"}];
const arrows = [];
const texts = [{"x": 20, "y": 26, "cls": "h", "t": ["Four reducers, one celebrity key (illustrative)", "Bốn reducer, một khoá nổi tiếng (minh họa)"]}, {"x": 58, "y": 71, "cls": "foot", "t": ["Reducer 1", "Reducer 1"]}, {"x": 260, "y": 71, "cls": "note", "t": ["10% of records", "10% số bản ghi"], "anchor": "start"}, {"x": 58, "y": 123, "cls": "foot", "t": ["Reducer 2", "Reducer 2"]}, {"x": 260, "y": 123, "cls": "note", "t": ["10% of records", "10% số bản ghi"], "anchor": "start"}, {"x": 58, "y": 175, "cls": "foot", "t": ["Reducer 3", "Reducer 3"]}, {"x": 260, "y": 175, "cls": "note", "t": ["10% of records", "10% số bản ghi"], "anchor": "start"}, {"x": 58, "y": 227, "cls": "foot", "t": ["Reducer 4", "Reducer 4"]}, {"x": 740, "y": 227, "cls": "warn", "t": ["70% of records", "70% số bản ghi"], "anchor": "start"}, {"x": 20, "y": 284, "cls": "foot", "t": ["Same hash, same reducer: hash(\"@star\") always lands on Reducer 4.", "Cùng hash, cùng reducer: hash(\"@star\") luôn rơi vào Reducer 4."]}, {"x": 20, "y": 308, "cls": "warn", "t": ["Three reducers finish quickly; the whole stage waits for the fourth, or it runs out of memory.", "Ba reducer xong nhanh; cả stage phải chờ reducer thứ tư, hoặc nó hết RAM."]}];
---
<BatchDiagram
  w={900} h={325}
  aria="Bar chart of four reducers. Reducers 1 to 3 each get about 10 percent of the records. Reducer 4 gets 70 percent because one celebrity key hashes to it. Illustrative numbers."
  boxes={boxes as any} arrows={arrows as any} texts={texts as any} rules={[]} icons={[{"name": "server", "x": 34, "y": 66, "size": 24}, {"name": "server", "x": 34, "y": 118, "size": 24}, {"name": "server", "x": 34, "y": 170, "size": 24}, {"name": "server", "x": 34, "y": 222, "size": 24}]}
  caption={["Hot key in one picture: work is split by key, so one very popular key cannot be split across machines.", "Hot key trong một hình: việc chia theo khoá, nên một khoá quá đông không thể chia cho nhiều máy."]}
/>
