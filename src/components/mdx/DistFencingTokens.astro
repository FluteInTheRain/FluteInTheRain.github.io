---
import DiagramIcon from './DiagramIcon.astro';
// Direct showdown: Lease-only locking vs Monotonic Fencing Tokens.
// Storage sits in the middle lane so Client 1 arrows come from above and Client 2 arrows
// come from below — zero crossing lines.
// Plain inline SVG with site tokens; arrowheads are polygons (no duplicate marker ids).

const W = 900;
const H = 474;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

// Top panel lanes: Client 1 (y=68), Storage (y=124), Client 2 (y=180)
const topC2Write = arrow(530, 174, 530, 146);
const topC1Write = arrow(735, 92, 735, 118);

// Bottom panel lanes: Client 1 (y=302), Storage (y=358), Client 2 (y=414)
const botC2Write = arrow(530, 408, 530, 380);
const botC1Write = arrow(735, 326, 735, 352);
---
<figure class="dft">
  <div class="dft-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Comparison of distributed locking without and with fencing tokens. Top: Client 1 pauses during GC while its lease expires; Client 2 gets the lease and writes v2; Client 1 wakes up and overwrites storage with stale v1. Bottom: the lock service assigns token 33 to Client 1 and token 34 to Client 2; storage remembers token 34 and rejects Client 1's stale write with token 33.">
      {/* ---------- Panel 1: Without fencing tokens ---------- */}
      <text x="20" y="24" class="dft-h">
        <tspan data-lang-en>1. Lease only: a paused zombie overwrites the newer write</tspan>
        <tspan data-lang-vi>1. Chỉ dùng lease: zombie tỉnh dậy ghi đè lên dữ liệu mới</tspan>
      </text>

      {/* Actor labels left */}
      <DiagramIcon name="laptop" x={94} y={71} size={22} />
      <text x="20" y="76" class="dft-lane">Client 1</text>
      <DiagramIcon name="db" x={94} y={127} size={22} />
      <text x="20" y="132" class="dft-lane">Storage</text>
      <DiagramIcon name="laptop" x={94} y={183} size={22} />
      <text x="20" y="188" class="dft-lane">Client 2</text>

      {/* Lane guide lines */}
      <line x1="115" x2={W - 20} y1="72" y2="72" class="dft-guide" />
      <line x1="115" x2={W - 20} y1="128" y2="128" class="dft-guide" />
      <line x1="115" x2={W - 20} y1="184" y2="184" class="dft-guide" />

      {/* Client 1 events */}
      <rect x="120" y="52" width="136" height="36" rx="5" class="dft-box" />
      <text x="188" y="74" text-anchor="middle" class="dft-m">
        <tspan data-lang-en>acquires lease</tspan>
        <tspan data-lang-vi>lấy được lease</tspan>
      </text>
      <rect x="270" y="52" width="330" height="36" rx="5" class="dft-pause" />
      <text x="435" y="74" text-anchor="middle" class="dft-m-muted">
        <tspan data-lang-en>paused 15 s (GC / VM stall) — lease expires</tspan>
        <tspan data-lang-vi>khựng 15 giây (GC / treo VM) — lease hết hạn</tspan>
      </text>
      <rect x="614" y="52" width="260" height="38" rx="5" class="dft-box is-red" />
      <text x="744" y="75" text-anchor="middle" class="dft-b-red">
        <tspan data-lang-en>wakes up, writes v1 (stale lease)</tspan>
        <tspan data-lang-vi>tỉnh dậy, ghi v1 (tưởng còn lease)</tspan>
      </text>

      {/* Client 2 events */}
      <rect x="415" y="166" width="215" height="36" rx="5" class="dft-box" />
      <text x="522" y="188" text-anchor="middle" class="dft-m">
        <tspan data-lang-en>gets new lease, writes v2</tspan>
        <tspan data-lang-vi>lấy lease mới, ghi v2</tspan>
      </text>

      {/* Storage states */}
      <rect x="462" y="110" width="136" height="34" rx="5" class="dft-box" />
      <text x="530" y="131" text-anchor="middle" class="dft-b">
        <tspan data-lang-en>stores v2</tspan>
        <tspan data-lang-vi>lưu v2</tspan>
      </text>
      <rect x="614" y="110" width="260" height="34" rx="5" class="dft-box is-red" />
      <text x="744" y="131" text-anchor="middle" class="dft-b-red">
        <tspan data-lang-en>v1 overwrites v2 — corrupted</tspan>
        <tspan data-lang-vi>v1 ghi đè v2 — hỏng dữ liệu</tspan>
      </text>

      <path d={topC2Write.line} class="dft-arrow" /><polygon points={topC2Write.head} class="dft-head" />
      <path d={topC1Write.line} class="dft-arrow is-red" /><polygon points={topC1Write.head} class="dft-head is-red" />

      {/* ---------- Divider ---------- */}
      <line x1="20" x2={W - 20} y1="226" y2="226" class="dft-rule" />

      {/* ---------- Panel 2: With monotonic fencing tokens ---------- */}
      <text x="20" y="256" class="dft-h">
        <tspan data-lang-en>2. Monotonic fencing tokens: storage rejects stale token 33</tspan>
        <tspan data-lang-vi>2. Fencing token tăng đơn điệu: storage từ chối token 33 cũ</tspan>
      </text>

      <DiagramIcon name="laptop" x={94} y={305} size={22} />
      <text x="20" y="310" class="dft-lane">Client 1</text>
      <DiagramIcon name="db" x={94} y={361} size={22} />
      <text x="20" y="366" class="dft-lane">Storage</text>
      <DiagramIcon name="laptop" x={94} y={417} size={22} />
      <text x="20" y="422" class="dft-lane">Client 2</text>

      <line x1="115" x2={W - 20} y1="306" y2="306" class="dft-guide" />
      <line x1="115" x2={W - 20} y1="362" y2="362" class="dft-guide" />
      <line x1="115" x2={W - 20} y1="418" y2="418" class="dft-guide" />

      {/* Client 1 events */}
      <rect x="120" y="286" width="136" height="36" rx="5" class="dft-box" />
      <text x="188" y="308" text-anchor="middle" class="dft-b">
        <tspan data-lang-en>gets token 33</tspan>
        <tspan data-lang-vi>nhận token 33</tspan>
      </text>
      <rect x="270" y="286" width="330" height="36" rx="5" class="dft-pause" />
      <text x="435" y="308" text-anchor="middle" class="dft-m-muted">
        <tspan data-lang-en>paused 15 s (or packet stalled in network)</tspan>
        <tspan data-lang-vi>khựng 15 giây (hoặc gói tin kẹt trên mạng)</tspan>
      </text>
      <rect x="614" y="286" width="260" height="38" rx="5" class="dft-box" />
      <text x="744" y="309" text-anchor="middle" class="dft-m">
        <tspan data-lang-en>sends write(v1, token = 33)</tspan>
        <tspan data-lang-vi>gửi lệnh ghi(v1, token = 33)</tspan>
      </text>

      {/* Client 2 events */}
      <rect x="415" y="400" width="215" height="36" rx="5" class="dft-box is-ok" />
      <text x="522" y="422" text-anchor="middle" class="dft-b-ok">
        <tspan data-lang-en>gets token 34, writes v2</tspan>
        <tspan data-lang-vi>nhận token 34, ghi v2</tspan>
      </text>

      {/* Storage states */}
      <rect x="454" y="344" width="146" height="34" rx="5" class="dft-box is-ok" />
      <text x="527" y="365" text-anchor="middle" class="dft-b-ok">
        <tspan data-lang-en>v2 · maxTok = 34</tspan>
        <tspan data-lang-vi>v2 · maxTok = 34</tspan>
      </text>
      <rect x="614" y="344" width="260" height="34" rx="5" class="dft-box is-ok" />
      <text x="744" y="365" text-anchor="middle" class="dft-b-ok">
        <tspan data-lang-en>33 &lt; 34: rejected · v2 safe</tspan>
        <tspan data-lang-vi>33 &lt; 34: từ chối · v2 an toàn</tspan>
      </text>

      <path d={botC2Write.line} class="dft-arrow is-ok" /><polygon points={botC2Write.head} class="dft-head is-ok" />
      <path d={botC1Write.line} class="dft-arrow is-cut" /><polygon points={botC1Write.head} class="dft-head" />

      <text x={W - 20} y="460" text-anchor="end" class="dft-foot">
        <tspan data-lang-en>Real examples: ZooKeeper zxid, etcd revision, Kafka epoch numbers, S3 conditional writes (If-Match).</tspan>
        <tspan data-lang-vi>Ví dụ thực tế: ZooKeeper zxid, etcd revision, số epoch của Kafka, ghi có điều kiện của S3 (If-Match).</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A lock service alone cannot stop a zombie client or an old delayed packet. Safety only holds when the storage layer itself checks a monotonic fencing token (or an atomic compare-and-set precondition) on every write.</span>
    <span data-lang-vi>Riêng lock service không thể chặn một zombie client hay một gói tin đến muộn. Tính an toàn chỉ được bảo đảm khi chính tầng lưu trữ kiểm tra fencing token tăng đơn điệu (hoặc điều kiện ghi nguyên tử kiểu CAS) ở mọi lệnh ghi.</span>
  </figcaption>
</figure>

<style>
  .dft {
    margin: 2em 0;
    width: 100%;
  }
  .dft-scroll {
    overflow-x: auto;
  }
  .dft svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .dft text {
    font-size: 13px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .dft .dft-h {
    font-size: 15.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .dft .dft-lane {
    font-size: 13.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .dft-guide {
    stroke: var(--border);
    stroke-dasharray: 2 4;
  }
  .dft-rule {
    stroke: var(--border);
  }
  .dft-box {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .dft-box.is-red {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.5;
  }
  .dft-box.is-ok {
    fill: var(--bg-alt);
    stroke: #15803d;
    stroke-width: 1.5;
  }
  :global(html[data-theme='dark']) .dft-box.is-ok {
    stroke: #4ade80;
  }
  .dft-pause {
    fill: transparent;
    stroke: var(--border);
    stroke-dasharray: 5 4;
    stroke-width: 1.2;
  }
  .dft .dft-b {
    font-weight: 700;
    fill: var(--text);
  }
  .dft .dft-b-red {
    font-weight: 700;
    fill: var(--red);
  }
  .dft .dft-b-ok {
    font-weight: 700;
    fill: #15803d;
  }
  :global(html[data-theme='dark']) .dft .dft-b-ok {
    fill: #4ade80;
  }
  .dft .dft-m {
    fill: var(--text-body);
  }
  .dft .dft-m-muted {
    fill: var(--text-muted);
    font-size: 12.5px;
  }
  .dft-arrow {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .dft-arrow.is-red {
    stroke: var(--red);
  }
  .dft-arrow.is-ok {
    stroke: #15803d;
  }
  :global(html[data-theme='dark']) .dft-arrow.is-ok {
    stroke: #4ade80;
  }
  .dft-arrow.is-cut {
    stroke-dasharray: 3 3;
  }
  .dft-head {
    fill: var(--text-muted);
  }
  .dft-head.is-red {
    fill: var(--red);
  }
  .dft-head.is-ok {
    fill: #15803d;
  }
  :global(html[data-theme='dark']) .dft-head.is-ok {
    fill: #4ade80;
  }
  .dft .dft-foot {
    font-size: 12.5px;
    fill: var(--text-muted);
  }
  .dft figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
