---
// Go post 10: a request walks inward through nested middleware, reaches the handler,
// and the response walks back out. Works without JS (every layer is visible and labelled);
// the script only adds the step highlight and a "handler panics" variant.
import T from '../T.astro';
---
<div class="rp" data-rp>
  <div class="rp-layer" data-layer="1">
    <p class="rp-h"><code>requestID</code> <span class="rp-s"><T en="gives the request an ID, sets X-Request-ID" vi="gắn ID cho request, đặt header X-Request-ID" /></span></p>
    <div class="rp-layer" data-layer="2">
      <p class="rp-h"><code>logging</code> <span class="rp-s"><T en="starts a timer; logs one line when everything inside returns" vi="bấm giờ; ghi một dòng log khi mọi thứ bên trong đã trả về" /></span></p>
      <div class="rp-layer" data-layer="3">
        <p class="rp-h"><code>recoverPanic</code> <span class="rp-s"><T en="defer + recover: turns a panic into a 500" vi="defer + recover: biến panic thành lỗi 500" /></span></p>
        <div class="rp-layer rp-core" data-layer="4">
          <p class="rp-h"><code>mux</code> &rarr; <code>createTodo</code> <span class="rp-s"><T en="matches POST /todos, decodes JSON, validates, stores" vi="khớp POST /todos, giải mã JSON, kiểm tra, lưu" /></span></p>
        </div>
      </div>
    </div>
  </div>
  <div class="rp-bar">
    <button type="button" class="rp-btn" data-rp-run="ok" hidden><T en="Normal request" vi="Request bình thường" /></button>
    <button type="button" class="rp-btn" data-rp-run="panic" hidden><T en="Handler panics" vi="Handler bị panic" /></button>
    <p class="rp-status" data-rp-status aria-live="polite"></p>
  </div>
</div>

<script>
  // The page holds an EN copy and a VI copy of this demo, so wire every instance.
  document.querySelectorAll<HTMLElement>('[data-rp]').forEach((root) => {
    const layers = Array.from(root.querySelectorAll<HTMLElement>('[data-layer]'));
    const status = root.querySelector<HTMLElement>('[data-rp-status]');
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-rp-run]'));
    type Step = { layer: number; en: string; vi: string; bad?: boolean };
    const flows: Record<string, Step[]> = {
      ok: [
        { layer: 1, en: 'In: requestID makes an ID and stores it in the request context.', vi: 'Vào: requestID tạo ID và để vào context của request.' },
        { layer: 2, en: 'In: logging notes the start time.', vi: 'Vào: logging ghi lại giờ bắt đầu.' },
        { layer: 3, en: 'In: recoverPanic sets up its deferred recover, then calls on.', vi: 'Vào: recoverPanic đặt sẵn recover trong defer rồi gọi tiếp.' },
        { layer: 4, en: 'Handler: decodes the JSON, validates it, stores the todo, writes 201.', vi: 'Handler: giải mã JSON, kiểm tra, lưu todo, trả 201.' },
        { layer: 3, en: 'Out: nothing panicked, so recoverPanic does nothing.', vi: 'Ra: không có panic, recoverPanic không làm gì.' },
        { layer: 2, en: 'Out: logging prints method, path, status 201 and the duration.', vi: 'Ra: logging in method, path, status 201 và thời gian xử lý.' },
        { layer: 1, en: 'Out: the response leaves with the X-Request-ID header.', vi: 'Ra: response đi ra cùng header X-Request-ID.' },
      ],
      panic: [
        { layer: 1, en: 'In: requestID makes an ID.', vi: 'Vào: requestID tạo ID.' },
        { layer: 2, en: 'In: logging notes the start time.', vi: 'Vào: logging ghi lại giờ bắt đầu.' },
        { layer: 3, en: 'In: recoverPanic sets up its deferred recover.', vi: 'Vào: recoverPanic đặt sẵn recover trong defer.' },
        { layer: 4, en: 'Handler: panics (say, a nil pointer).', vi: 'Handler: bị panic (ví dụ nil pointer).', bad: true },
        { layer: 3, en: 'recoverPanic: recover() catches it, logs it, writes a 500 JSON error.', vi: 'recoverPanic: recover() bắt được, ghi log, trả lỗi JSON 500.' },
        { layer: 2, en: 'Out: logging still runs and prints status 500.', vi: 'Ra: logging vẫn chạy và in status 500.' },
        { layer: 1, en: 'Out: the client gets a 500, and the server is still alive.', vi: 'Ra: client nhận 500, server vẫn sống.' },
      ],
    };
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | undefined;
    const show = (flow: Step[], i: number) => {
      const s = flow[i];
      layers.forEach((el) => {
        const n = Number(el.dataset.layer);
        el.classList.toggle('is-on', n === s.layer);
        el.classList.toggle('is-bad', n === s.layer && !!s.bad);
      });
      if (status) {
        status.replaceChildren();
        (['en', 'vi'] as const).forEach((l) => {
          const span = document.createElement('span');
          span.setAttribute(`data-lang-${l}`, '');
          span.textContent = s[l];
          status.appendChild(span);
        });
      }
    };
    const play = (name: string) => {
      window.clearTimeout(timer);
      const flow = flows[name];
      if (reduce) { show(flow, flow.length - 1); return; }
      let i = 0;
      const tick = () => {
        show(flow, i);
        i += 1;
        if (i < flow.length) timer = window.setTimeout(tick, 1300);
      };
      tick();
    };
    buttons.forEach((b) => {
      b.hidden = false;
      b.addEventListener('click', () => play(b.dataset.rpRun ?? 'ok'));
    });
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); play('ok'); }
    });
    io.observe(root);
  });
</script>

<style>
  .rp { width: 100%; }
  .rp-layer {
    border: 1.5px solid var(--border); border-radius: 10px; background: var(--bg);
    padding: 8px 10px 10px; min-width: 0;
  }
  .rp-layer + .rp-layer, .rp-layer > .rp-layer { margin-top: 6px; }
  .rp-layer.is-on { border-color: var(--gold); background: var(--gold-tint-bg); }
  .rp-layer.is-bad { border-color: var(--text); }
  .rp-core { background: var(--card-bg); }
  .rp-h { margin: 0; font-size: 13.5px; line-height: 1.45; color: var(--text-body); }
  .rp-h code { font-family: var(--font-mono, ui-monospace, monospace); font-size: 12.5px; font-weight: 700; color: var(--text); }
  .rp-s { display: block; font-size: 12.5px; color: var(--text-muted); }
  .rp-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-top: 12px; min-height: 30px; }
  .rp-btn {
    padding: 4px 12px; font: inherit; font-size: 13px; font-weight: 600; color: var(--text-body);
    background: var(--card-bg); border: 1px solid var(--border); border-radius: 6px; cursor: pointer;
  }
  .rp-status { margin: 0; flex: 1 1 220px; font-size: 13.5px; color: var(--text-body); }
</style>
