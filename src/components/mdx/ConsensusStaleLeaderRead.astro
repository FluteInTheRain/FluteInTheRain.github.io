---
// The etcd 0.4.1 stale-read path (Jepsen 2014/2020): a partitioned old leader answers reads locally,
// versus a leader that first confirms with a majority. Static SVG, site tokens only.
import DiagramIcon from './DiagramIcon.astro';
interface Props { lang: 'en' | 'vi' }
const { lang } = Astro.props;

const T = {
  en: {
    aria: 'Two rows. Top: a network partition cuts old leader N1 off from N2 and N3, which already committed x = 2 under a new leader. Client Y reads x from N1, and N1 answers from its local copy, x = 1, which is stale. Bottom: N1 first tries to confirm it is still leader, cannot reach a majority, and refuses to answer, so Y retries on the new leader and reads x = 2.',
    topT: 'Leader reads locally (etcd 0.4.1 default)',
    topS: 'N1 never checks whether a newer leader exists.',
    botT: 'Leader confirms with a majority first (etcd 3 default)',
    botS: 'No majority, no answer: a stale leader cannot serve reads.',
    oldLeader: 'old leader',
    newLeader: 'new leader',
    follower: 'follower',
    holds1: 'still holds x = 1',
    holds2: 'holds x = 2',
    part: 'partition',
    read: 'read x',
    reply1: 'reply: x = 1',
    write: 'write x = 2: committed',
    still: ['still', 'leader?'],
    clientY: 'Client Y',
    clientX: 'Client X',
    cap: 'A partitioned old leader that answers reads from its own copy serves stale data; asking a majority first closes the gap.',
    topRes: ['Y reads x = 1: stale, although', 'x = 2 was already committed.'],
    botRes: ['N1 cannot reach a majority and', 'refuses. Y retries on N2 and', 'reads x = 2.'],
  },
  vi: {
    aria: 'Hai hàng. Trên: đứt mạng cô lập leader cũ N1 khỏi N2 và N3, hai node này đã commit x = 2 dưới leader mới. Client Y đọc x từ N1, N1 trả lời từ bản cục bộ x = 1, tức dữ liệu cũ. Dưới: N1 thử xác nhận mình còn là leader, không gom được đa số nên từ chối trả lời, Y thử lại trên leader mới và đọc được x = 2.',
    topT: 'Leader đọc cục bộ (mặc định etcd 0.4.1)',
    topS: 'N1 không kiểm tra xem đã có leader mới hơn chưa.',
    botT: 'Leader xác nhận với đa số trước (mặc định etcd 3)',
    botS: 'Không có đa số thì không trả lời: leader cũ không được phục vụ đọc.',
    oldLeader: 'leader cũ',
    newLeader: 'leader mới',
    follower: 'follower',
    holds1: 'vẫn giữ x = 1',
    holds2: 'giữ x = 2',
    part: 'đứt mạng',
    read: 'đọc x',
    reply1: 'trả về: x = 1',
    write: 'ghi x = 2: đã commit',
    still: ['còn là', 'leader?'],
    clientY: 'Client Y',
    clientX: 'Client X',
    cap: 'Leader cũ bị cô lập mà trả lời đọc từ bản của mình sẽ trả dữ liệu cũ; hỏi đa số trước thì hết lỗ hổng đó.',
    topRes: ['Y đọc được x = 1: dữ liệu cũ, dù', 'x = 2 đã được commit.'],
    botRes: ['N1 không gom được đa số nên', 'từ chối. Y thử lại trên N2 và', 'đọc được x = 2.'],
  },
}[lang];

const W = 900;
const H = 420;

function head(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const l = 8;
  const p1 = [x2 - l * Math.cos(a - 0.45), y2 - l * Math.sin(a - 0.45)];
  const p2 = [x2 - l * Math.cos(a + 0.45), y2 - l * Math.sin(a + 0.45)];
  return `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
}

const rows = [
  { oy: 0, title: T.topT, sub: T.topS, res: T.topRes, bad: true },
  { oy: 215, title: T.botT, sub: T.botS, res: T.botRes, bad: false },
];
const nw = 140;
const nh = 54;
---
<figure class="csl">
  <div class="csl-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={T.aria}>
      {rows.map((r, i) => {
        const ny = r.oy + 62;       // node top
        const cy = r.oy + 150;      // client top
        return (
          <g>
            {i === 1 && <line x1="20" x2={W - 20} y1="205" y2="205" class="csl-rule" />}
            <text x="20" y={r.oy + 26} class="csl-h">{r.title}</text>
            <text x="20" y={r.oy + 46} class="csl-sub">{r.sub}</text>

            {/* partition wall */}
            <line x1="270" x2="270" y1={ny - 6} y2={ny + nh + 54} class="csl-part" />
            <text x="270" y={ny + nh + 72} text-anchor="middle" class="csl-partlbl">{T.part}</text>

            {/* nodes */}
            <rect x="40" y={ny} width={nw} height={nh} rx="6" class="csl-node is-stale" />
            <DiagramIcon name="server" x={40 + 20} y={ny + nh / 2} size={20} />

            <text x={40 + nw / 2 + 12} y={ny + 22} text-anchor="middle" class="csl-name" style="font-size:13px">N1 · {T.oldLeader}</text>
            <text x={40 + nw / 2 + 12} y={ny + 40} text-anchor="middle" class="csl-nsub is-red">{T.holds1}</text>

            <rect x="320" y={ny} width={nw} height={nh} rx="6" class="csl-node is-leader" />
            <DiagramIcon name="server" x={320 + 20} y={ny + nh / 2} size={20} />

            <text x={320 + nw / 2 + 12} y={ny + 22} text-anchor="middle" class="csl-name" style="font-size:13px">N2 · {T.newLeader}</text>
            <text x={320 + nw / 2 + 12} y={ny + 40} text-anchor="middle" class="csl-nsub">{T.holds2}</text>

            <rect x="490" y={ny} width={nw} height={nh} rx="6" class="csl-node" />
            <DiagramIcon name="server" x={490 + 20} y={ny + nh / 2} size={20} />

            <text x={490 + nw / 2 + 12} y={ny + 22} text-anchor="middle" class="csl-name" style="font-size:13px">N3 · {T.follower}</text>
            <text x={490 + nw / 2 + 12} y={ny + 40} text-anchor="middle" class="csl-nsub">{T.holds2}</text>

            {/* clients */}
            <rect x="40" y={cy} width={nw} height="34" rx="6" class="csl-client" />
            <text x={40 + nw / 2} y={cy + 22} text-anchor="middle" class="csl-name">{T.clientY}</text>
            <rect x="320" y={cy} width={nw} height="34" rx="6" class="csl-client" />
            <text x={320 + nw / 2} y={cy + 22} text-anchor="middle" class="csl-name">{T.clientX}</text>

            {/* Y reads from N1 */}
            <path d={`M 85 ${cy} L 85 ${ny + nh + 6}`} class="csl-arrow" />
            <polygon points={head(85, cy, 85, ny + nh)} class="csl-head" />
            <text x="79" y={cy - 18} text-anchor="end" class="csl-edge">{T.read}</text>
            {r.bad ? (
              <g>
                <path d={`M 135 ${ny + nh} L 135 ${cy - 6}`} class="csl-arrow is-bad" />
                <polygon points={head(135, ny + nh, 135, cy)} class="csl-head is-bad" />
                <text x="145" y={cy - 18} class="csl-edge is-bad">{T.reply1}</text>
              </g>
            ) : (
              <g>
                <path d={`M 182 ${ny + 20} L ${270 - 8} ${ny + 20}`} class="csl-arrow is-bad" />
                <polygon points={head(182, ny + 20, 270, ny + 20)} class="csl-head is-bad" />
                <text x="226" y={ny + 38} text-anchor="middle" class="csl-edge is-bad"><tspan x="226">{T.still[0]}</tspan><tspan x="226" dy="15">{T.still[1]}</tspan></text>
              </g>
            )}

            {/* X writes to N2 */}
            <path d={`M 390 ${cy} L 390 ${ny + nh + 6}`} class="csl-arrow" />
            <polygon points={head(390, cy, 390, ny + nh)} class="csl-head" />
            <text x="400" y={cy - 18} class="csl-edge">{T.write}</text>

            {/* result */}
            <rect x="650" y={r.oy + 62} width="240" height={r.bad ? 74 : 92} rx="6" class={`csl-res ${r.bad ? 'is-bad' : 'is-ok'}`} />
            {r.res.map((line, k) => (
              <text x="662" y={r.oy + 84 + k * 18} class="csl-restxt">{line}</text>
            ))}
          </g>
        );
      })}
    </svg>
  </div>
  <figcaption>{T.cap}</figcaption>
</figure>
<style>
  .csl { margin: 2em 0; width: 100%; }
  .csl-scroll { overflow-x: auto; }
  .csl svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .csl text { font-size: 14px; fill: var(--text-body); }
  .csl .csl-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .csl .csl-sub { font-size: 12.5px; fill: var(--text-muted); }
  .csl-rule { stroke: var(--border); }
  .csl-part { stroke: var(--red); stroke-width: 1.8; stroke-dasharray: 6 4; }
  .csl .csl-partlbl { font-size: 12.5px; font-weight: 700; fill: var(--red); }
  .csl-node { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .csl-node.is-leader { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.8; }
  .csl-node.is-stale { fill: var(--red-tint-bg); stroke: var(--red); stroke-dasharray: 4 3; stroke-width: 1.4; }
  .csl-client { fill: none; stroke: var(--border); stroke-width: 1.3; }
  .csl .csl-name { font-size: 13px; font-weight: 700; fill: var(--text); }
  .csl .csl-nsub { font-size: 12px; fill: var(--text-muted); }
  .csl .csl-nsub.is-red { fill: var(--red); font-weight: 600; }
  .csl .csl-edge { font-size: 12px; font-weight: 600; fill: var(--text); }
  .csl .csl-edge.is-bad { fill: var(--red); }
  .csl-arrow { fill: none; stroke: var(--text); stroke-width: 1.5; }
  .csl-head { fill: var(--text); }
  .csl-arrow.is-bad { stroke: var(--red); stroke-dasharray: 4 3; }
  .csl-head.is-bad { fill: var(--red); }
  .csl-res { stroke-width: 1.5; }
  .csl-res.is-bad { fill: var(--red-tint-bg); stroke: var(--red); }
  .csl-res.is-ok { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .csl .csl-restxt { font-size: 13px; font-weight: 600; fill: var(--text); }
  .csl figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
