---
interface Props {
  command: string;
  label?: string;
  caption?: string;
}
const { command, label = 'Benchmark / Terminal', caption } = Astro.props;
---
<figure class="figure term-out">
  <div class="term-head">
    <span class="term-cmd"><code>$ {command}</code></span>
    <span class="term-label">{label}</span>
  </div>
  <div class="term-body">
    <slot />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>