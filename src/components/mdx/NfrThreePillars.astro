---
// The three goals the post builds on, one card each.
import DiagramIcon from './DiagramIcon.astro';
import NfrText from './NfrText.astro';
import './nfr-fig.css';
const W = 900;
const H = 170;
const cards = [
  { x: 20, icon: 'shield', en: 'Reliability', vi: 'Độ tin cậy', qen: ['Keeps working correctly', 'when parts break or people slip.'], qvi: ['Vẫn chạy đúng khi linh kiện hỏng', 'hoặc con người thao tác sai.'] },
  { x: 320, icon: 'chart', en: 'Scalability', vi: 'Khả năng mở rộng', qen: ['Stays fast as traffic', 'multiplies.'], qvi: ['Vẫn nhanh khi lưu lượng', 'tăng gấp nhiều lần.'] },
  { x: 620, icon: 'worker', en: 'Maintainability', vi: 'Khả năng bảo trì', qen: ['New engineers can change it', 'without breaking old behaviour.'], qvi: ['Kỹ sư mới sửa được mà', 'không làm hỏng hành vi cũ.'] },
] as const;
---
<figure class="nf">
  <div class="nf-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three goals of a data system: reliability, scalability and maintainability, each with a one-line meaning.">
      {cards.map((c) => (
        <g>
          <rect x={c.x} y="12" width="260" height="140" rx="8" class="box" />
          <DiagramIcon name={c.icon} x={c.x + 34} y={50} size={32} />
          <NfrText x={c.x + 66} y={56} cls="h" en={c.en} vi={c.vi} />
          <NfrText x={c.x + 20} y={100} lh={18} en={c.qen as unknown as string[]} vi={c.qvi as unknown as string[]} />
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The rest of the post takes these three in turn.</span>
    <span data-lang-vi>Phần còn lại của bài lần lượt đi qua ba mục tiêu này.</span>
  </figcaption>
</figure>
