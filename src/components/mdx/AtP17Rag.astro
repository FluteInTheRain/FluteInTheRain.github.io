---
// Retrieval-augmented generation over a filing, plus the FinanceBench result for GPT-4-Turbo with retrieval
// (Islam et al. 2023): it "incorrectly answered or refused to answer 81% of questions".
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 380;
const steps = [
  { icon: 'doc', en: 'Annual report', vi: 'Báo cáo thường niên', sEn: 'hundreds of pages', sVi: 'hàng trăm trang' },
  { icon: 'file', en: 'Chunks', vi: 'Đoạn nhỏ', sEn: 'a page or less each', sVi: 'mỗi đoạn tối đa một trang' },
  { icon: 'index', en: 'Vector index', vi: 'Chỉ mục vector', sEn: 'one vector per chunk', sVi: 'mỗi đoạn một vector' },
  { icon: 'search', en: 'Top matches', vi: 'Đoạn khớp nhất', sEn: 'closest to the question', sVi: 'gần câu hỏi nhất' },
  { icon: 'model', en: 'Model answers', vi: 'Mô hình trả lời', sEn: 'from those chunks only', sVi: 'chỉ từ các đoạn đó' },
] as const;
const bx = (i: number) => 20 + i * 176;
const BX = 40;
const BW = 820;
const wrong = 81;
const split = BX + (BW * wrong) / 100;
---
<figure class="p17h">
  <div class="p17h-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A retrieval pipeline over an annual report: the report is cut into chunks, each chunk becomes a vector in an index, the question is matched against the index, the closest chunks go to the model, and the model answers from those chunks. Below, a bar from the FinanceBench benchmark: GPT-4-Turbo with retrieval answered incorrectly or refused to answer 81 percent of questions, and answered correctly 19 percent.">
    <text x="20" y="28" class="p17h-h">
      <tspan data-lang-en>Retrieval first, then the model reads only what was retrieved</tspan>
      <tspan data-lang-vi>Truy xuất trước, rồi mô hình chỉ đọc phần đã truy xuất</tspan>
    </text>
    {steps.map((s, i) => (
      <g>
        <rect x={bx(i)} y="48" width="156" height="118" rx="8" class="p17h-box" />
        <DiagramIcon name={s.icon} x={bx(i) + 78} y={80} size={28} />
        <text x={bx(i) + 78} y="118" text-anchor="middle" class="p17h-t">
          <tspan data-lang-en>{s.en}</tspan>
          <tspan data-lang-vi>{s.vi}</tspan>
        </text>
        <text x={bx(i) + 78} y="144" text-anchor="middle" class="p17h-s">
          <tspan data-lang-en>{s.sEn}</tspan>
          <tspan data-lang-vi>{s.sVi}</tspan>
        </text>
      </g>
    ))}
    {[0, 1, 2, 3].map((i) => (
      <g>
        <line x1={bx(i) + 158} y1="107" x2={bx(i + 1) - 4} y2="107" class="p17h-arrow" />
        <polygon points={`${bx(i + 1) - 2},107 ${bx(i + 1) - 9},102 ${bx(i + 1) - 9},112`} class="p17h-head" />
      </g>
    ))}
    <text x="20" y="204" class="p17h-lab">
      <tspan data-lang-en>FinanceBench: GPT-4-Turbo with retrieval, questions about real company filings</tspan>
      <tspan data-lang-vi>FinanceBench: GPT-4-Turbo kèm truy xuất, câu hỏi về hồ sơ công ty thật</tspan>
    </text>
    <rect x={BX} y="220" width={split - BX} height="48" class="p17h-bad" />
    <rect x={split} y="220" width={BX + BW - split} height="48" class="p17h-ok" />
    <text x={BX + (split - BX) / 2} y="252" text-anchor="middle" class="p17h-big">
      <tspan data-lang-en>81% wrong or refused</tspan>
      <tspan data-lang-vi>81% sai hoặc từ chối</tspan>
    </text>
    <text x={split + 10} y="290" class="p17h-s">
      <tspan data-lang-en>19% correct</tspan>
      <tspan data-lang-vi>19% đúng</tspan>
    </text>
    <text x="20" y="344" class="p17h-note">
      <tspan data-lang-en>Retrieval can fetch the wrong page, or the right page without the table the number sits in. Check the cited chunk, not only the answer.</tspan>
      <tspan data-lang-vi>Truy xuất có thể lấy nhầm trang, hoặc đúng trang mà thiếu cái bảng chứa con số. Hãy kiểm tra đoạn được trích, đừng chỉ nhìn câu trả lời.</tspan>
    </text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>FinanceBench (Islam et al., 2023) tested 16 model setups on a 150-question sample; the 81% is the abstract's figure for GPT-4-Turbo with a retrieval system.</span>
    <span data-lang-vi>FinanceBench (Islam và cộng sự, 2023) thử 16 cấu hình mô hình trên mẫu 150 câu hỏi; 81% là con số trong phần tóm tắt cho GPT-4-Turbo kèm hệ thống truy xuất.</span>
  </figcaption>
</figure>

<style>
  .p17h { margin: 2em 0; width: 100%; }
  .p17h-scroll { overflow-x: auto; }
  .p17h svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .p17h text { font-size: 14px; fill: var(--text-body); }
  .p17h .p17h-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .p17h .p17h-t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .p17h .p17h-s { font-size: 12px; fill: var(--text-muted); }
  .p17h .p17h-lab { font-size: 13.5px; font-weight: 600; fill: var(--text); }
  .p17h .p17h-big { font-size: 16px; font-weight: 700; fill: var(--red); }
  .p17h .p17h-note { font-size: 12.5px; fill: var(--text-muted); }
  .p17h-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .p17h-arrow { stroke: var(--text-muted); stroke-width: 1.6; }
  .p17h-head { fill: var(--text-muted); }
  .p17h-bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .p17h-ok { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.4; }
  .p17h figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
