---
// Icons: DiagramIcon from diagram-icons.ts. Motion: fig-motion.css classes (fm-*).
// The 10-byte buffer example in the post: input "12\n345\n6789\n10\n", Sum6Reader with make([]byte, 10).
// The sum 7156 is the real output of that run. The 10-byte size is only for the picture; real code uses 8 KiB.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const cw = 52;
const ch = 40;
const x0 = 20;
const top = 56;
const rowH = 130;
const rows = [
  {
    icon: 'stream',
    title: 'Read 1 fills the buffer',
    titleVi: 'Read lần 1 làm đầy buffer',
    cells: ['1', '2', '\\n', '3', '4', '5', '\\n', '6', '7', '8'],
    groups: [
      { from: 0, to: 7, tone: 'ok', en: 'lines 12 and 345 are complete', vi: 'dòng 12 và 345 đã đủ' },
      { from: 7, to: 10, tone: 'keep', en: '678: no newline yet', vi: '678: chưa đủ' },
    ],
    note: 'last = 7, n = 10, so offset = n - last = 3',
    noteVi: 'last = 7, n = 10, nên offset = n - last = 3',
  },
  {
    icon: 'sync',
    title: 'copy(buf, buf[last:n]) moves the tail to the front',
    titleVi: 'copy(buf, buf[last:n]) dời phần đuôi lên đầu',
    cells: ['6', '7', '8', '', '', '', '', '', '', ''],
    groups: [{ from: 0, to: 3, tone: 'keep', en: 'tail kept', vi: 'phần đuôi giữ lại' }],
    note: 'the next Read writes into buf[offset:], right behind the tail',
    noteVi: 'lần Read kế ghi vào buf[offset:], ngay sau phần đuôi',
  },
  {
    icon: 'ok',
    title: 'Read 2 adds the rest, and the number is whole',
    titleVi: 'Read lần 2 thêm phần còn lại, số đã đủ',
    cells: ['6', '7', '8', '9', '\\n', '1', '0', '\\n', '', ''],
    groups: [
      { from: 0, to: 5, tone: 'ok', en: '6789 is complete', vi: '6789 đã đủ' },
      { from: 5, to: 8, tone: 'ok', en: '10 is complete', vi: '10 đã đủ' },
    ],
    note: '12 + 345 + 6789 + 10 = 7156',
    noteVi: '12 + 345 + 6789 + 10 = 7156',
  },
];
const H = top + rows.length * rowH + 4;
---
<figure class="gp19c">
  <div class="gp19c-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A 10-byte buffer reading the text 12, 345, 6789, 10 one line each. After the first read the last three bytes 678 have no newline, so they are copied to the front of the buffer. The second read adds the rest and the sum is 7156.">
    <text x="20" y="24" class="h">
      <tspan data-lang-en>One number split across two reads (10-byte buffer, for the picture)</tspan>
      <tspan data-lang-vi>Một số bị cắt giữa hai lần đọc (buffer 10 byte)</tspan>
    </text>
    {rows.map((r, i) => {
      const y = top + i * rowH;
      return (
        <g>
          <DiagramIcon name={r.icon} x={x0 + 12} y={y - 5} size={26} />
          <text x={x0 + 34} y={y} class="b">
            <tspan data-lang-en>{r.title}</tspan>
            <tspan data-lang-vi>{r.titleVi}</tspan>
          </text>
          {r.groups.map((g) => (
            <g>
              <rect x={x0 + g.from * cw} y={y + 12} width={(g.to - g.from) * cw} height="22" rx="4" class={'grp ' + g.tone + (i === 1 && g.tone === 'keep' ? ' fm-pulse' : '')} />
              <text x={x0 + g.from * cw + 8} y={y + 28} class="gt">
                <tspan data-lang-en>{g.en}</tspan>
                <tspan data-lang-vi>{g.vi}</tspan>
              </text>
            </g>
          ))}
          {r.cells.map((c, j) => (
            <g>
              <rect x={x0 + j * cw} y={y + 40} width={cw} height={ch} class={c === '' ? 'cell empty' : 'cell'} />
              {c !== '' && <text x={x0 + j * cw + cw / 2} y={y + 40 + 26} text-anchor="middle" class="cv num">{c}</text>}
            </g>
          ))}
          <text x={x0} y={y + 40 + ch + 24} class="m num">
            <tspan data-lang-en>{r.note}</tspan>
            <tspan data-lang-vi>{r.noteVi}</tspan>
          </text>
        </g>
      );
    })}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The 10-byte size and the digits are chosen to fit on the page; <code>Sum6Reader</code> runs the same steps with its 8 KiB buffer. The sum 7156 is what the code prints for this input.</span>
    <span data-lang-vi>Cỡ 10 byte và các chữ số là tự chọn cho vừa trang; <code>Sum6Reader</code> chạy đúng các bước này với buffer 8 KiB. Tổng 7156 là kết quả code in ra với đầu vào này.</span>
  </figcaption>
</figure>

<style>
  .gp19c { margin: 2em 0; width: 100%; }
  .gp19c-scroll { overflow-x: auto; }
  .gp19c svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp19c text { font-size: 14px; fill: var(--text-body); }
  .gp19c .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp19c .b { font-weight: 700; fill: var(--text); }
  .gp19c .m { fill: var(--text-muted); }
  .gp19c .gt { fill: var(--text-body); }
  .gp19c .cv { font-weight: 700; fill: var(--text); font-size: 16px; }
  .gp19c .num { font-variant-numeric: tabular-nums; }
  .gp19c .cell { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp19c .cell.empty { fill: var(--bg); stroke: var(--border); stroke-dasharray: 4 3; }
  .gp19c .grp { stroke-width: 1.2; }
  .gp19c .grp.ok { fill: var(--bg-alt); stroke: var(--border); }
  .gp19c .grp.keep { fill: var(--gold-tint-bg); stroke: var(--gold); }
  .gp19c figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
