---
// Three ways to run Python code "at the same time". The red lines are the one
// weak point of the first panel: the catch the rest of the post is about.
const W = 900, H = 420;
const px = [10, 310, 610];
const panels = [
  { name: { en: 'event loop', vi: 'event loop' }, sub: { en: 'one thread, many tasks', vi: 'một thread, nhiều task' } },
  { name: { en: 'threads', vi: 'thread' }, sub: { en: 'one interpreter, many threads', vi: 'một interpreter, nhiều thread' } },
  { name: { en: 'processes', vi: 'process' }, sub: { en: 'many interpreters', vi: 'nhiều interpreter' } },
];
const loopSegs: [number, string][] = [[34, 'A'], [30, 'B'], [38, 'C'], [34, 'A'], [30, 'B'], [38, 'C']];
const threadLanes = [
  { y: 100, runs: [[0, 40], [120, 30]] },
  { y: 124, runs: [[50, 40], [160, 30]] },
  { y: 148, runs: [[100, 40], [30, 20]] },
];
const L = (en: string, vi: string) => ({ en, vi });
const good = [
  [L('thousands of connections', 'hàng nghìn kết nối'), L('that mostly wait', 'phần lớn là đang chờ')],
  [L('blocking libraries', 'thư viện chặn'), L('(a sync driver, requests)', '(driver sync, requests)')],
  [L('CPU-heavy work', 'việc nặng CPU'), L('a crash stays contained', 'một process chết không kéo cả hệ')],
];
const catchLines = [
  [L('one call that never awaits', 'một lời gọi không bao giờ await'), L('stalls every other task', 'làm mọi task khác đứng chờ')],
  [L('CPU work gets no faster', 'việc nặng CPU không nhanh hơn'), L('and the pool caps at 40', 'và pool chỉ có 40 thread')],
  [L('no shared variables', 'không chia sẻ biến'), L('more memory per copy', 'mỗi bản tốn thêm RAM')],
];
---
<figure class="bep6a">
  <div class="bep6a-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three panels. Event loop: one lane of work in which tasks A, B and C take turns. Threads: three lanes that mostly wait and take turns running because of the GIL. Processes: three boxes, each with its own memory. Under each, what it is good for and what it costs.">
    {panels.map((p, i) => (
      <g>
        <rect x={px[i]} y="10" width="280" height="400" rx="10" class="box" />
        <text x={px[i] + 140} y="42" text-anchor="middle" class="h"><tspan data-lang-en>{p.name.en}</tspan><tspan data-lang-vi>{p.name.vi}</tspan></text>
        <text x={px[i] + 140} y="62" text-anchor="middle" class="s"><tspan data-lang-en>{p.sub.en}</tspan><tspan data-lang-vi>{p.sub.vi}</tspan></text>
        <text x={px[i] + 24} y="244" class="k"><tspan data-lang-en>good for</tspan><tspan data-lang-vi>hợp với</tspan></text>
        {good[i].map((g, j) => (
          <text x={px[i] + 24} y={266 + j * 20} class="b"><tspan data-lang-en>{g.en}</tspan><tspan data-lang-vi>{g.vi}</tspan></text>
        ))}
        <text x={px[i] + 24} y="326" class="k"><tspan data-lang-en>the catch</tspan><tspan data-lang-vi>cái giá</tspan></text>
        {catchLines[i].map((g, j) => (
          <text x={px[i] + 24} y={348 + j * 20} class={i === 0 ? 'bad' : 'b'}><tspan data-lang-en>{g.en}</tspan><tspan data-lang-vi>{g.vi}</tspan></text>
        ))}
      </g>
    ))}

    <rect x="30" y="104" width="240" height="32" rx="4" class="lane" />
    {(() => {
      let cx = 34;
      return loopSegs.map(([w, l]) => {
        const x = cx; cx += w + 2;
        return (
          <g>
            <rect x={x} y="108" width={w} height="24" rx="3" class="run" />
            <text x={x + w / 2} y="125" text-anchor="middle" class="seg">{l}</text>
          </g>
        );
      });
    })()}
    <text x="150" y="168" text-anchor="middle" class="s"><tspan data-lang-en>tasks take turns, switching at await</tspan><tspan data-lang-vi>các task thay phiên, đổi lượt ở await</tspan></text>

    {threadLanes.map((t) => (
      <g>
        <rect x="330" y={t.y} width="240" height="20" rx="4" class="lane" />
        {t.runs.map(([off, w]) => <rect x={334 + off} y={t.y + 3} width={w} height="14" rx="3" class="run" />)}
      </g>
    ))}
    <text x="450" y="190" text-anchor="middle" class="s"><tspan data-lang-en>waits overlap; the GIL lets one</tspan><tspan data-lang-vi>chờ thì chồng lên nhau; GIL chỉ cho</tspan></text>
    <text x="450" y="208" text-anchor="middle" class="s"><tspan data-lang-en>thread run Python at a time</tspan><tspan data-lang-vi>một thread chạy Python tại một thời điểm</tspan></text>

    {[625, 705, 785].map((bx) => (
      <g>
        <rect x={bx} y="100" width="70" height="60" rx="6" class="proc" />
        <text x={bx + 35} y="124" text-anchor="middle" class="seg">py</text>
        <text x={bx + 35} y="148" text-anchor="middle" class="tiny"><tspan data-lang-en>memory</tspan><tspan data-lang-vi>bộ nhớ</tspan></text>
      </g>
    ))}
    <text x="750" y="190" text-anchor="middle" class="s"><tspan data-lang-en>nothing shared;</tspan><tspan data-lang-vi>không chia sẻ gì;</tspan></text>
    <text x="750" y="208" text-anchor="middle" class="s"><tspan data-lang-en>CPUs really run in parallel</tspan><tspan data-lang-vi>các CPU chạy song song thật</tspan></text>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>Three ways to do more than one thing. Pick by what the work spends its time on: waiting, or computing.</span>
    <span data-lang-vi>Ba cách làm nhiều việc một lúc. Chọn theo việc đó tốn thời gian vào đâu: chờ hay tính toán.</span>
  </figcaption>
</figure>

<style>
  .bep6a { margin: 2em 0; width: 100%; }
  .bep6a-scroll { overflow-x: auto; }
  .bep6a svg { display: block; width: 100%; min-width: 700px; height: auto; }
  .bep6a text { font-size: 13.5px; fill: var(--text-body); }
  .bep6a .h { font-weight: 700; fill: var(--text); font-size: 17px; }
  .bep6a .s { fill: var(--text-muted); font-size: 12.5px; }
  .bep6a .k { fill: var(--text-muted); font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  .bep6a .b { fill: var(--text-body); }
  .bep6a .bad { fill: var(--red); font-weight: 600; }
  .bep6a .seg { font-weight: 700; fill: var(--text); font-size: 13px; }
  .bep6a .tiny { fill: var(--text-muted); font-size: 11.5px; }
  .bep6a .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep6a .lane { fill: none; stroke: var(--border); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .bep6a .run { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.3; }
  .bep6a .proc { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.4; }
  .bep6a figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
