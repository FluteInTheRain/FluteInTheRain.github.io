---
// Range loop value copy in Go 1.22+: &c gives distinct addresses, but each points to a loop copy rather than customers[i].
// Matches prog_range output: slice[0]={1 10}, map["1"]={1 110} vs index &customers[i] updating slice[0]={1 110}.
// Icons: DiagramIcon (user = customer record, backup = loop copy, link = pointer). Motion: fm-flow-slow on the red and gold pointer arrows.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 374;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const aTopCopy1 = arrow(622, 75, 512, 75);
const aTopCopy2 = arrow(622, 136, 512, 136);
const aBotElem1 = arrow(622, 267, 250, 267);
const aBotElem2 = arrow(622, 327, 250, 327);
---
<figure class="gp11rc">
  <div class="gp11rc-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: in Go 1.22+, for _, c := range customers gives distinct copies per step, so byCopy['1'] points to a copy {1 110} while slice[0] stays {1 10}. Bottom: for i := range customers takes &customers[i], so mutating through byElem['1'] updates slice[0] to {1 110}.">
      {/* Panel 1 */}
      <text x="16" y="26" class="h">
        <tspan data-lang-en>1. for _, c := range customers (Go 1.22+): distinct addresses, still pointing to copies</tspan>
        <tspan data-lang-vi>1. for _, c := range customers (Go 1.22+): khác địa chỉ nhau, nhưng vẫn trỏ vào bản sao</tspan>
      </text>

      <rect x="16" y="48" width="232" height="54" rx="6" class="box" />
      <DiagramIcon name="user" x={226} y={66} size={24} />
      <text x="28" y="70" class="b num">customers[0]</text>
      <text x="28" y="90" class="m num">ID: "1" · Balance: 10 (unchanged)</text>

      <rect x="16" y="110" width="232" height="54" rx="6" class="box" />
      <DiagramIcon name="user" x={226} y={128} size={24} />
      <text x="28" y="132" class="b num">customers[1]</text>
      <text x="28" y="152" class="m num">ID: "2" · Balance: 20</text>

      <rect x="308" y="48" width="202" height="54" rx="6" class="box bad" />
      <DiagramIcon name="backup" x={484} y={66} size={24} />
      <text x="320" y="70" class="r">c (iter 0 copy)</text>
      <text x="320" y="90" class="r num">ID: "1" · Balance: 110</text>

      <rect x="308" y="110" width="202" height="54" rx="6" class="box" />
      <DiagramIcon name="backup" x={484} y={128} size={24} />
      <text x="320" y="132" class="b">c (iter 1 copy)</text>
      <text x="320" y="152" class="m num">ID: "2" · Balance: 20</text>

      <rect x="624" y="48" width="258" height="54" rx="6" class="box bad" />
      <DiagramIcon name="link" x={641} y={75} size={24} />
      <text x="662" y="70" class="b">byCopy["1"] = &amp;c</text>
      <text x="662" y="90" class="r">
        <tspan data-lang-en>points to copy, not slice[0]</tspan>
        <tspan data-lang-vi>trỏ bản sao, không phải slice[0]</tspan>
      </text>

      <rect x="624" y="110" width="258" height="54" rx="6" class="box" />
      <DiagramIcon name="link" x={641} y={137} size={24} />
      <text x="662" y="132" class="b">byCopy["2"] = &amp;c</text>
      <text x="662" y="152" class="m">
        <tspan data-lang-en>distinct address in Go 1.22+</tspan>
        <tspan data-lang-vi>địa chỉ riêng từ Go 1.22+</tspan>
      </text>

      <path d={aTopCopy1.line} class="ln red fm-flow-slow" /><polygon points={aTopCopy1.head} class="hd red" />
      <path d={aTopCopy2.line} class="ln" /><polygon points={aTopCopy2.head} class="hd" />

      <line x1="16" x2={W - 16} y1="186" y2="186" class="rule" />

      {/* Panel 2 */}
      <text x="16" y="218" class="h">
        <tspan data-lang-en>2. for i := range customers: pointer aims straight at the slice element</tspan>
        <tspan data-lang-vi>2. for i := range customers: con trỏ trỏ thẳng vào ô nhớ trong slice gốc</tspan>
      </text>

      <rect x="16" y="240" width="232" height="54" rx="6" class="box gold" />
      <DiagramIcon name="user" x={226} y={258} size={24} />
      <text x="28" y="262" class="b num">customers[0]</text>
      <text x="28" y="282" class="g num">ID: "1" · Balance: 110 (updated)</text>

      <rect x="16" y="302" width="232" height="54" rx="6" class="box" />
      <DiagramIcon name="user" x={226} y={320} size={24} />
      <text x="28" y="324" class="b num">customers[1]</text>
      <text x="28" y="344" class="m num">ID: "2" · Balance: 20</text>

      <rect x="624" y="240" width="258" height="54" rx="6" class="box gold" />
      <DiagramIcon name="link" x={641} y={267} size={24} />
      <text x="662" y="262" class="b">byElem["1"] = &amp;customers[0]</text>
      <text x="662" y="282" class="g">
        <tspan data-lang-en>mutates slice[0] directly</tspan>
        <tspan data-lang-vi>sửa thẳng vào slice[0]</tspan>
      </text>

      <rect x="624" y="302" width="258" height="54" rx="6" class="box" />
      <DiagramIcon name="link" x={641} y={329} size={24} />
      <text x="662" y="324" class="b">byElem["2"] = &amp;customers[1]</text>
      <text x="662" y="344" class="m">
        <tspan data-lang-en>watch out if slice grows later</tspan>
        <tspan data-lang-vi>cẩn thận nếu slice đổi mảng nền</tspan>
      </text>

      <path d={aBotElem1.line} class="ln gold fm-flow-slow" /><polygon points={aBotElem1.head} class="hd gold" />
      <path d={aBotElem2.line} class="ln" /><polygon points={aBotElem2.head} class="hd" />
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Since Go 1.22, each loop step gets its own <code>c</code> variable, fixing the old "all entries share one address" trap. Yet <code>range</code> still assigns a copy of the struct into <code>c</code>: only <code>&amp;customers[i]</code> points back into the slice itself.</span>
    <span data-lang-vi>Từ Go 1.22, mỗi vòng lặp tạo một biến <code>c</code> riêng, hết lỗi cả map cùng trỏ vào một địa chỉ. Nhưng <code>range</code> vẫn chép giá trị struct sang <code>c</code>: chỉ <code>&amp;customers[i]</code> mới trỏ thẳng vào phần tử trong slice gốc.</span>
  </figcaption>
</figure>

<style>
  .gp11rc { margin: 2em 0; width: 100%; }
  .gp11rc-scroll { overflow-x: auto; }
  .gp11rc svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .gp11rc text { font-size: 14px; fill: var(--text-body); }
  .gp11rc .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .gp11rc .b { font-weight: 700; fill: var(--text); }
  .gp11rc .m { fill: var(--text-muted); }
  .gp11rc .r { fill: var(--red); font-weight: 700; }
  .gp11rc .g { fill: var(--gold-icon); font-weight: 700; }
  .gp11rc .num { font-variant-numeric: tabular-nums; }
  .gp11rc .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .gp11rc .box.bad { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.3; }
  .gp11rc .box.gold { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 1.3; }
  .gp11rc .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .gp11rc .ln.red { stroke: var(--red); }
  .gp11rc .ln.gold { stroke: var(--gold-icon); }
  .gp11rc .hd { fill: var(--text-muted); }
  .gp11rc .hd.red { fill: var(--red); }
  .gp11rc .hd.gold { fill: var(--gold-icon); }
  .gp11rc .rule { stroke: var(--border); stroke-width: 1; }
  .gp11rc figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
