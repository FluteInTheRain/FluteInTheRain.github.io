---
// Picture first: three user-visible failures, one shared cause, one direction for the fix.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 262;
type Card = { icons: string[]; en: string; vi: string; sen: string; svi: string };
const cards: Card[] = [
  { icons: ['card', 'retry', 'money'], en: 'Billed twice', vi: 'Bị trừ tiền hai lần', sen: 'a bad subway ride, then a retry', svi: 'rớt mạng trên tàu điện, rồi retry' },
  { icons: ['user', 'mail', 'user'], en: 'Ex-partner notified', vi: 'Người cũ vẫn nhận thông báo', sen: 'post written after unfriending', svi: 'bài viết sau khi đã hủy kết bạn' },
  { icons: ['db', 'lock', 'hourglass'], en: 'Checkout stalls', vi: 'Thanh toán đứng hình', sen: 'one warehouse shard slows down', svi: 'một shard kho hàng chậm lại' },
];
const cw = 270;
const gap = 25;
const x0 = 20;
const heads = (x2: number, y: number) => `${x2 - 7},${y - 4} ${x2 - 7},${y + 4} ${x2},${y}`;
---
<figure class="ua-fig">
  <div class="ua-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Three failures, billed twice, an ex-partner notified and a stalled checkout, share one cause: a monolithic database at the centre. The direction of the fix is an immutable event log with explicit dataflow.">
      <text x="20" y="24" class="ua-h"><tspan data-lang-en>Three failures, one shared cause</tspan><tspan data-lang-vi>Ba lỗi, chung một nguyên nhân</tspan></text>
      {cards.map((c, i) => {
        const x = x0 + i * (cw + gap);
        const cx = x + cw / 2;
        return (
          <>
            <rect x={x} y="40" width={cw} height="114" rx="4" class="ua-box is-hot" />
            {c.icons.map((n, k) => <DiagramIcon name={n as any} x={cx - 66 + k * 66} y={72} size={30} />)}
            {[0, 1].map((k) => (
              <>
                <path d={`M${cx - 66 + k * 66 + 22},72 L${cx - 66 + (k + 1) * 66 - 24},72`} class="ua-solid is-hot" />
                <polygon points={heads(cx - 66 + (k + 1) * 66 - 17, 72)} class="ua-head is-hot" />
              </>
            ))}
            <text x={cx} y="124" text-anchor="middle" class="ua-b"><tspan data-lang-en>{c.en}</tspan><tspan data-lang-vi>{c.vi}</tspan></text>
            <text x={cx} y="143" text-anchor="middle" class="ua-m"><tspan data-lang-en>{c.sen}</tspan><tspan data-lang-vi>{c.svi}</tspan></text>
          </>
        );
      })}
      <path d="M155,154 V168 M450,154 V168 M745,154 V168 M155,168 H745 M210,168 V180" class="ua-solid is-hot" />
      <rect x="20" y="180" width="380" height="66" rx="4" class="ua-box is-hot" />
      <DiagramIcon name="db" x={56} y={213} size={32} />
      <text x="88" y="208" class="ua-b is-hot"><tspan data-lang-en>One monolithic database</tspan><tspan data-lang-vi>Một database nguyên khối</tspan></text>
      <text x="88" y="228" class="ua-m"><tspan data-lang-en>at the centre of the design</tspan><tspan data-lang-vi>đặt ở trung tâm thiết kế</tspan></text>
      <path d="M400,213 L493,213" class="ua-solid is-good" />
      <polygon points={heads(500, 213)} class="ua-head is-good" />
      <text x="450" y="204" text-anchor="middle" class="ua-n is-good"><tspan data-lang-en>swap for</tspan><tspan data-lang-vi>thay bằng</tspan></text>
      <rect x="500" y="180" width="380" height="66" rx="4" class="ua-box is-good" />
      <DiagramIcon name="log" x={536} y={213} size={32} />
      <text x="568" y="208" class="ua-b"><tspan data-lang-en>An immutable event log</tspan><tspan data-lang-vi>Một log sự kiện bất biến</tspan></text>
      <text x="568" y="228" class="ua-m"><tspan data-lang-en>plus explicit dataflow</tspan><tspan data-lang-vi>cùng luồng dữ liệu tường minh</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>All three failures trace back to the same place. The rest of the post swaps the center for a log.</span>
    <span data-lang-vi>Cả ba lỗi cùng quy về một chỗ. Phần còn lại của bài thay trung tâm đó bằng một log.</span>
  </figcaption>
</figure>

<style>
  .ua-fig { margin: 2em 0; width: 100%; }
  .ua-scroll { overflow-x: auto; }
  .ua-fig svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .ua-fig text { font-size: 13px; fill: var(--text-body); }
  .ua-fig .ua-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-ph { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-b { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .ua-fig .ua-m { font-size: 12.5px; fill: var(--text-muted); }
  .ua-fig .ua-n { font-size: 12.5px; font-weight: 700; fill: var(--text-muted); }
  .ua-fig .ua-n.is-hot, .ua-fig .ua-b.is-hot, .ua-fig .ua-m.is-hot { fill: var(--red); }
  .ua-fig .ua-n.is-good, .ua-fig .ua-b.is-good, .ua-fig .ua-m.is-good { fill: var(--gold-icon); }
  .ua-fig .ua-q { font-size: 20px; font-weight: 700; fill: var(--red); }
  .ua-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .ua-box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .ua-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .ua-panel { fill: none; stroke: var(--border); stroke-width: 1.2; }
  .ua-life { stroke: var(--border); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .ua-solid { fill: none; stroke: var(--text-muted); stroke-width: 1.8; }
  .ua-dashed { fill: none; stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .ua-head { fill: var(--text-muted); }
  .ua-solid.is-hot, .ua-dashed.is-hot { stroke: var(--red); stroke-width: 1.9; }
  .ua-head.is-hot { fill: var(--red); }
  .ua-solid.is-good { stroke: var(--gold-icon); stroke-width: 2; }
  .ua-head.is-good { fill: var(--gold-icon); }
  .ua-fig figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
