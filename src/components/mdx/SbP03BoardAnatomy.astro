---
// Anatomy of one row on a Vietnamese electric price board (Bảng điện):
// Reference / Ceiling / Floor | Top 3 Bids | Last Match | Top 3 Asks | Foreign flow.
import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 310;

const COLS = [
  { x: 20, w: 96, en: 'Ticker', vi: 'Mã', val: 'ACB', subEn: 'HOSE', subVi: 'HOSE', hi: false },
  { x: 122, w: 174, en: 'Ceil / Ref / Floor', vi: 'Trần / TC / Sàn', val: '26.75 · 25.00 · 23.25', subEn: '±7% band', subVi: 'biên ±7%', hi: false },
  { x: 302, w: 190, en: 'Top 3 Bids (Buy)', vi: 'Bên Mua (Giá 1–3)', val: '24.95 × 12,400', subEn: 'waiting buyers', subVi: 'người chờ mua', hi: false },
  { x: 498, w: 132, en: 'Matched', vi: 'Khớp lệnh', val: '25.00 × 800', subEn: 'last trade', subVi: 'lần khớp cuối', hi: true },
  { x: 636, w: 190, en: 'Top 3 Asks (Sell)', vi: 'Bên Bán (Giá 1–3)', val: '25.05 × 9,200', subEn: 'waiting sellers', subVi: 'người chờ bán', hi: false },
  { x: 832, w: 48, en: 'NN', vi: 'NN', val: '12k', subEn: 'foreign', subVi: 'ngoại', hi: false },
] as const;
---
<figure class="sbp3-board">
  <div class="sbp3-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Anatomy of a Vietnamese price board row: ticker, ceiling/reference/floor prices, top 3 bids, last matched price and volume, top 3 asks, and foreign buy/sell volume.">
      <text x="20" y="30" class="sbp3-title">
        <tspan data-lang-en>Reading one row on the Vietnamese price board (prices in thousands of VND)</tspan>
        <tspan data-lang-vi>Đọc một dòng trên bảng điện chứng khoán Việt (giá tính theo nghìn đồng)</tspan>
      </text>

      {COLS.map((c) => (
        <g>
          <rect
            x={c.x}
            y="54"
            width={c.w}
            height="128"
            rx="8"
            class={c.hi ? 'sbp3-box sbp3-box-red' : 'sbp3-box'}
          />
          <text x={c.x + c.w / 2} y="82" text-anchor="middle" class={c.hi ? 'sbp3-hdr sbp3-red' : 'sbp3-hdr'}>
            <tspan data-lang-en>{c.en}</tspan>
            <tspan data-lang-vi>{c.vi}</tspan>
          </text>
          <line x1={c.x + 8} y1="96" x2={c.x + c.w - 8} y2="96" class="sbp3-sep" />
          <text x={c.x + c.w / 2} y="128" text-anchor="middle" class="sbp3-val">{c.val}</text>
          <text x={c.x + c.w / 2} y="158" text-anchor="middle" class="sbp3-sub">
            <tspan data-lang-en>{c.subEn}</tspan>
            <tspan data-lang-vi>{c.subVi}</tspan>
          </text>
        </g>
      ))}

      {/* Hidden depth note below Top 3 Bid / Ask */}
      <rect x="20" y="204" width="860" height="82" rx="10" class="sbp3-box" />
      <DiagramIcon name="eye" x={48} y={245} size={26} />
      <text x="76" y="236" class="sbp3-hdr">
        <tspan data-lang-en>Why only three price levels show on your screen</tspan>
        <tspan data-lang-vi>Vì sao màn hình chỉ hiện 3 mức giá Mua – Bán tốt nhất</tspan>
      </text>
      <text x="76" y="264" class="sbp3-sub">
        <tspan data-lang-en>Hundreds of deeper limit orders sit behind Bid 3 and Ask 3 inside HOSE's matching engine — hidden until the top 3 levels fill or cancel.</tspan>
        <tspan data-lang-vi>Hàng trăm lệnh giới hạn giá xa hơn vẫn đang xếp sau Giá 3 bên Mua và Bán trong máy chủ HOSE — chỉ hiện lên khi 3 bậc đầu khớp hết hoặc bị hủy.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A Vietnamese price board compresses thousands of live orders into one row: the daily band on the left, the 3 best bids and 3 best asks around the last match, and foreign flow on the right.</span>
    <span data-lang-vi>Bảng điện nén hàng nghìn lệnh đang chờ vào một dòng: trần/tham chiếu/sàn bên trái, 3 giá mua và 3 giá bán tốt nhất kẹp quanh cột khớp lệnh ở giữa, và giao dịch khối ngoại bên phải.</span>
  </figcaption>
</figure>

<style>
  .sbp3-board { margin: 2em 0; width: 100%; }
  .sbp3-scroll { overflow-x: auto; }
  .sbp3-board svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .sbp3-board text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .sbp3-title { font-size: 16px; font-weight: 700; fill: var(--text); }
  .sbp3-box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .sbp3-box-red { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.8; }
  .sbp3-hdr { font-size: 13px; font-weight: 700; fill: var(--text); }
  .sbp3-red { fill: var(--red); }
  .sbp3-val { font-size: 13.5px; font-weight: 700; fill: var(--text); }
  .sbp3-sub { font-size: 12px; fill: var(--text-muted); }
  .sbp3-sep { stroke: var(--border); stroke-width: 1; }
  .sbp3-board figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
