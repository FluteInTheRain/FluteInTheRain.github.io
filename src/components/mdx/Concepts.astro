---
// Small glossary box placed at the end of a section: explains the new terms
// that section introduced, in plain words, for readers who have never seen them.
// Body is a Markdown list: "- **Term**: plain explanation".
interface Props { title?: string }
const { title = 'New concepts in this section' } = Astro.props;
---
<aside class="concepts">
  <p class="concepts-title">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z" />
      <path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z" />
    </svg>
    {title}
  </p>
  <div class="concepts-body"><slot /></div>
</aside>
