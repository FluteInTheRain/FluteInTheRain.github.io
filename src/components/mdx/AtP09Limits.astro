---
// What an attribution number says, and what it does not. Sources: Kumar et al. 2020 (ICML), Slack et al. 2020,
// Rudin 2019; the other rows come from the simulated runs in this post.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 440;
const rows = [
  {
    icon: 'eye',
    sayEn: ['How far this feature moved this', 'model\'s score for this stock.'],
    sayVi: ['Feature này kéo điểm của mô hình', 'cho cổ phiếu này đi bao xa.'],
    notEn: ['That the stock\'s return would change if', 'the feature changed. It is not causal.'],
    notVi: ['Rằng lợi suất sẽ đổi nếu feature đổi.', 'Nó không phải quan hệ nhân quả.'],
  },
  {
    icon: 'scale',
    sayEn: ['The split of credit against one', 'chosen baseline.'],
    sayVi: ['Cách chia công so với một mốc', 'so sánh đã chọn.'],
    notEn: ['A baseline-free truth. Change the', 'comparison group and the split moves.'],
    notVi: ['Một sự thật không cần mốc so sánh. Đổi', 'nhóm đối chứng là cách chia đổi theo.'],
  },
  {
    icon: 'model',
    sayEn: ['What the model did with its inputs.', ''],
    sayVi: ['Mô hình đã làm gì với đầu vào.', ''],
    notEn: ['That the model is right, or that its', 'inputs were legitimate (the leak).'],
    notVi: ['Rằng mô hình đúng, hay đầu vào hợp lệ', '(chuyện rò rỉ).'],
  },
  {
    icon: 'link',
    sayEn: ['Credit shared between correlated twins.', ''],
    sayVi: ['Phần công chia giữa các feature song sinh.', ''],
    notEn: ['That the smaller twin is useless.', ''],
    notVi: ['Rằng feature song sinh nhỏ hơn vô dụng.', ''],
  },
  {
    icon: 'shield',
    sayEn: ['A tidy-looking explanation from LIME or SHAP.', ''],
    sayVi: ['Một lời giải thích trông gọn gàng từ LIME hay SHAP.', ''],
    notEn: ['Proof there is no bias. Slack et al. built', 'classifiers that fool both methods.'],
    notVi: ['Bằng chứng không có thiên lệch. Slack và cộng sự', 'dựng bộ phân loại đánh lừa được cả hai.'],
  },
];
---
<figure class="atp09-li">
  <div class="atp09-li-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Five rows, each contrasting what an attribution number says with what it does not say: it is not causal, it depends on the baseline, it does not show the model is right, it splits credit between correlated twins, and it can be fooled.">
      <text x="20" y="26" class="h">
        <tspan data-lang-en>One attribution bar: what it says, and what it does not</tspan>
        <tspan data-lang-vi>Một thanh attribution: nó nói gì, và không nói gì</tspan>
      </text>
      <text x="64" y="58" class="col is-say">
        <tspan data-lang-en>It says</tspan>
        <tspan data-lang-vi>Nó nói</tspan>
      </text>
      <text x="480" y="58" class="col is-not">
        <tspan data-lang-en>It does not say</tspan>
        <tspan data-lang-vi>Nó không nói</tspan>
      </text>
      {rows.map((r, i) => {
        const y = 70 + i * 72;
        return (
          <g>
            <rect x="20" y={y} width="860" height="62" rx="8" class="row" />
            <DiagramIcon name={r.icon as any} x={44} y={y + 31} size={24} />
            <text x="70" y={y + 27} class="s">
              <tspan data-lang-en>{r.sayEn[0]}</tspan>
              <tspan data-lang-vi>{r.sayVi[0]}</tspan>
            </text>
            <text x="70" y={y + 47} class="s">
              <tspan data-lang-en>{r.sayEn[1]}</tspan>
              <tspan data-lang-vi>{r.sayVi[1]}</tspan>
            </text>
            <line x1="462" x2="462" y1={y + 8} y2={y + 54} class="sep" />
            <text x="480" y={y + 27} class="s is-not">
              <tspan data-lang-en>{r.notEn[0]}</tspan>
              <tspan data-lang-vi>{r.notVi[0]}</tspan>
            </text>
            <text x="480" y={y + 47} class="s is-not">
              <tspan data-lang-en>{r.notEn[1]}</tspan>
              <tspan data-lang-vi>{r.notVi[1]}</tspan>
            </text>
          </g>
        );
      })}
    </svg>
  </div>
</figure>

<style>
  .atp09-li { margin: 2em 0; width: 100%; }
  .atp09-li-scroll { overflow-x: auto; }
  .atp09-li svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp09-li text { fill: var(--text-body); font-size: 13.5px; }
  .atp09-li .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp09-li .col { font-size: 13px; font-weight: 700; letter-spacing: 0.04em; }
  .atp09-li .col.is-say { fill: var(--gold-icon); }
  .atp09-li .col.is-not { fill: var(--red); }
  .atp09-li .s { fill: var(--text); }
  .atp09-li .s.is-not { fill: var(--text-body); }
  .atp09-li .row { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.2; }
  .atp09-li .sep { stroke: var(--border); stroke-width: 1.2; }
</style>
