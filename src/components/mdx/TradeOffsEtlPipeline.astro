---
// An example ETL pipeline: several systems of record feed a batch job that
// extracts, transforms and loads into a warehouse (derived data), which the
// dashboards read. The systems named are examples, not a recommendation.
// Plain inline SVG with site tokens; arrowheads are polygons, so no ids.

import DiagramIcon from './DiagramIcon.astro';

const W = 900;
const H = 300;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

const srcX = 20;
const srcW = 200;
const srcH = 56;
const sources = [
  { icon: 'postgres', y: 44, name: 'PostgreSQL', nameVi: 'PostgreSQL', subEn: 'orders, customers', subVi: 'đơn hàng, khách hàng' },
  { icon: 'stripe', y: 116, name: 'Stripe', nameVi: 'Stripe', subEn: 'payments', subVi: 'giao dịch thanh toán' },
  { icon: 'log', y: 188, name: 'App event logs', nameVi: 'Log sự kiện app', subEn: 'clicks, page views', subVi: 'click, lượt xem trang' },
];

const etl = { x: 260, y: 44, w: 340, h: 200 };
const stepX = etl.x + 16;
const stepW = etl.w - 32;
const stepH = 46;
const steps = [
  { icon: 'file', y: 58, nameEn: 'Extract', nameVi: 'Extract (trích xuất)', descEn: 'copy new and changed rows out', descVi: 'chép dòng mới hoặc vừa sửa ra ngoài' },
  { icon: 'worker', y: 122, nameEn: 'Transform', nameVi: 'Transform (biến đổi)', descEn: 'clean, join tables, use one currency', descVi: 'làm sạch, ghép bảng, quy đổi tiền tệ' },
  { icon: 'db', y: 186, nameEn: 'Load', nameVi: 'Load (nạp vào kho)', descEn: 'write the result into warehouse tables', descVi: 'ghi kết quả vào các bảng trong kho' },
];

const wh = { x: 650, y: 108, w: 230, h: 72 };
const dash = { x: 650, y: 228, w: 230, h: 56 };
---
<figure class="toetl">
  <div class="toetl-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Example ETL pipeline: PostgreSQL orders, Stripe payments and app event logs flow into a nightly job that extracts, transforms and loads them into a data warehouse such as Snowflake or ClickHouse, which dashboards like Metabase read.">
    <text x={srcX} y="26" class="toetl-h">
      <tspan data-lang-en>Systems of record</tspan>
      <tspan data-lang-vi>Hệ thống gốc</tspan>
    </text>
    <text x={etl.x} y="26" class="toetl-h">
      <tspan data-lang-en>ETL job, e.g. once a night</tspan>
      <tspan data-lang-vi>Job ETL, ví dụ chạy mỗi đêm</tspan>
    </text>
    <text x={wh.x} y="26" class="toetl-h">
      <tspan data-lang-en>Derived data</tspan>
      <tspan data-lang-vi>Dữ liệu phái sinh</tspan>
    </text>

    {sources.map((s) => {
      const a = arrow(srcX + srcW, s.y + srcH / 2, etl.x, s.y + srcH / 2);
      return (
        <g>
          <g class="toetl-box">
            <rect x={srcX} y={s.y} width={srcW} height={srcH} rx="8" />
            <DiagramIcon name={s.icon as any} x={srcX + 28} y={s.y + srcH / 2} size={28} />
            <text x={srcX + 54} y={s.y + 23} class="toetl-name">
              <tspan data-lang-en>{s.name}</tspan>
              <tspan data-lang-vi>{s.nameVi}</tspan>
            </text>
            <text x={srcX + 54} y={s.y + 43} class="toetl-small">
              <tspan data-lang-en>{s.subEn}</tspan>
              <tspan data-lang-vi>{s.subVi}</tspan>
            </text>
          </g>
          <g class="toetl-arrow"><path d={a.line} /><polygon points={a.head} /></g>
        </g>
      );
    })}

    <rect x={etl.x} y={etl.y} width={etl.w} height={etl.h} rx="10" class="toetl-frame" />
    {steps.map((s, i) => (
      <g>
        <g class="toetl-step">
          <rect x={stepX} y={s.y} width={stepW} height={stepH} rx="6" />
          <DiagramIcon name={s.icon as any} x={stepX + 24} y={s.y + stepH / 2} size={24} />
          <text x={stepX + 46} y={s.y + 19} class="toetl-name">
            <tspan data-lang-en>{i + 1}. {s.nameEn}</tspan>
            <tspan data-lang-vi>{i + 1}. {s.nameVi}</tspan>
          </text>
          <text x={stepX + 46} y={s.y + 37} class="toetl-small">
            <tspan data-lang-en>{s.descEn}</tspan>
            <tspan data-lang-vi>{s.descVi}</tspan>
          </text>
        </g>
        {i < steps.length - 1 && (() => {
          const a = arrow(etl.x + etl.w / 2, s.y + stepH, etl.x + etl.w / 2, steps[i + 1].y);
          return <g class="toetl-arrow"><path d={a.line} /><polygon points={a.head} /></g>;
        })()}
      </g>
    ))}

    {(() => { const a = arrow(etl.x + etl.w, wh.y + wh.h / 2, wh.x, wh.y + wh.h / 2); return <g class="toetl-arrow"><path d={a.line} /><polygon points={a.head} /></g>; })()}

    <g class="toetl-box is-key">
      <rect x={wh.x} y={wh.y} width={wh.w} height={wh.h} rx="8" />
      <DiagramIcon name="db" x={wh.x + 28} y={wh.y + wh.h / 2} size={28} />
      <text x={wh.x + 54} y={wh.y + 30} class="toetl-name">
        <tspan data-lang-en>Data warehouse</tspan>
        <tspan data-lang-vi>Kho dữ liệu</tspan>
      </text>
      <text x={wh.x + 54} y={wh.y + 52} class="toetl-small">
        <tspan data-lang-en>Snowflake or ClickHouse</tspan>
        <tspan data-lang-vi>Snowflake hoặc ClickHouse</tspan>
      </text>
    </g>

    {(() => { const a = arrow(wh.x + wh.w / 2, wh.y + wh.h, dash.x + dash.w / 2, dash.y); return <g class="toetl-arrow"><path d={a.line} /><polygon points={a.head} /></g>; })()}

    <g class="toetl-box">
      <rect x={dash.x} y={dash.y} width={dash.w} height={dash.h} rx="8" />
      <DiagramIcon name="chart" x={dash.x + 28} y={dash.y + dash.h / 2} size={28} />
      <text x={dash.x + 54} y={dash.y + 23} class="toetl-name">
        <tspan data-lang-en>Dashboards</tspan>
        <tspan data-lang-vi>Dashboard báo cáo</tspan>
      </text>
      <text x={dash.x + 54} y={dash.y + 43} class="toetl-small">
        <tspan data-lang-en>Metabase, Tableau</tspan>
        <tspan data-lang-vi>Metabase, Tableau</tspan>
      </text>
    </g>
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>An example ETL pipeline. Checkout keeps writing to PostgreSQL while reports read the warehouse. The warehouse is derived data: lose it, run the job again over the sources, and it comes back.</span>
    <span data-lang-vi>Một pipeline ETL ví dụ. Trang thanh toán vẫn ghi vào PostgreSQL, còn báo cáo thì đọc từ kho. Kho là dữ liệu phái sinh: lỡ mất thì chạy lại job trên các nguồn là có lại.</span>
  </figcaption>
</figure>

<style>
  .toetl {
    margin: 2em 0;
    width: 100%;
  }
  .toetl-scroll {
    overflow-x: auto;
  }
  .toetl svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .toetl text {
    font-size: 14px;
    fill: var(--text-body);
  }
  .toetl .toetl-h {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text-muted);
  }
  .toetl .toetl-name {
    font-weight: 700;
    fill: var(--text);
  }
  .toetl .toetl-small {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .toetl-box rect {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .toetl-box.is-key rect {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.5;
  }
  .toetl-frame {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.2;
    stroke-dasharray: 5 4;
  }
  .toetl-step rect {
    fill: var(--bg-alt);
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .toetl-arrow path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .toetl-arrow polygon {
    fill: var(--text-muted);
  }
  .toetl figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
