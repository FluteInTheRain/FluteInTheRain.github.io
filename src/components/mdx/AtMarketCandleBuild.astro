---
// How a day of matches folds into one candle: a simulated session of ticks on
// the left, the resulting OHLC candle (+ volume) on the right. Deterministic
// hand-built illustrative series; numbers are labelled illustrative in the
// caption. No ids (the figure renders twice on the page).
const W = 900;
const H = 360;

const en = (n: number) => n.toLocaleString('en-US');
const vi = (n: number) => n.toLocaleString('vi-VN');

// simulated session ticks: [t in 0..100, price]
const TICKS: Array<[number, number]> = [
  [0, 24500], [5, 24550], [10, 24450], [15, 24600], [20, 24650],
  [25, 24400], [30, 24300], [35, 24250], [40, 24350], [45, 24400],
  [50, 24250], [55, 24200], [60, 24350], [65, 24500], [70, 24700],
  [75, 25000], [80, 24700], [85, 24600], [90, 24750], [95, 24700],
  [100, 24800],
];

const OPEN = 24500;
const CLOSE = 24800;
const HIGH = 25000;
const LOW = 24200;
const VOL = 12400000;

// plot geometry
const PX = 70, PW = 360; // x origin, width
const PY = 70, PH = 230; // y origin, height
const PMIN = 24100, PMAX = 25080;

const x = (t: number) => PX + (t / 100) * PW;
const y = (p: number) => PY + (1 - (p - PMIN) / (PMAX - PMIN)) * PH;

// candle panel
const CX = 640; // candle centre x
const CY = y(HIGH);
const CB = y(LOW);
const BODY_TOP = y(CLOSE);
const BODY_BOT = y(OPEN);

const GRID = [24500, 24700, 24900].map((p) => ({ p, y: y(p) }));
const ticksPath = TICKS.map((tk, i) => `${i === 0 ? 'M' : 'L'}${x(tk[0]).toFixed(1)} ${y(tk[1]).toFixed(1)}`).join(' ');
const openPt = TICKS[0];
const closePt = TICKS[TICKS.length - 1];
const highPt = TICKS.find((t) => t[1] === HIGH)!;
const lowPt = TICKS.find((t) => t[1] === LOW)!;
---
<figure class="atm-candle">
  <div class="atm-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A simulated session of price ticks on the left folds into one candlestick on the right: open 24,500, high 25,000, low 24,200, close 24,800, with the day's volume drawn under the candle.">
      <text x="20" y="30" class="atm-c-title">
        <tspan data-lang-en>One day of matches becomes one candle</tspan>
        <tspan data-lang-vi>Cả một phiên khớp lệnh gói lại thành một nến</tspan>
      </text>

      {/* left panel title */}
      <text x={PX} y="58" class="atm-c-sub">
        <tspan data-lang-en>the ticks (each = one match)</tspan>
        <tspan data-lang-vi>từng lần khớp (mỗi chấm = một lệnh khớp)</tspan>
      </text>

      {/* gridlines + price axis */}
      {GRID.map((g) => (
        <g>
          <line x1={PX} y1={g.y} x2={PX + PW} y2={g.y} class="atm-c-grid" />
          <text x={PX - 8} y={g.y + 4} text-anchor="end" class="atm-c-axis">
            <tspan data-lang-en>{en(g.p)}</tspan>
            <tspan data-lang-vi>{vi(g.p)}</tspan>
          </text>
        </g>
      ))}
      <line x1={PX} y1={PY} x2={PX} y2={PY + PH} class="atm-c-axisline" />
      <line x1={PX} y1={PY + PH} x2={PX + PW} y2={PY + PH} class="atm-c-axisline" />
      <text x={PX + PW / 2} y={PY + PH + 24} text-anchor="middle" class="atm-c-sub">
        <tspan data-lang-en>time through the session →</tspan>
        <tspan data-lang-vi>thời gian trong phiên →</tspan>
      </text>

      {/* tick polyline */}
      <path d={ticksPath} class="atm-c-ticks" fill="none" />

      {/* markers: open, high, low, close */}
      <circle cx={x(openPt[0])} cy={y(openPt[1])} r="4" class="atm-c-dot-red" />
      <circle cx={x(closePt[0])} cy={y(closePt[1])} r="4" class="atm-c-dot-red" />
      <circle cx={x(highPt[0])} cy={y(highPt[1])} r="4" class="atm-c-dot" />
      <circle cx={x(lowPt[0])} cy={y(lowPt[1])} r="4" class="atm-c-dot" />

      {/* fold arrow */}
      <line x1="450" y1="185" x2="498" y2="185" class="atm-j-arrow atm-c-arrow" />
      <polygon points="506,180 506,190 496,185" class="atm-c-head" />
      <text x="452" y="172" class="atm-c-sub">
        <tspan data-lang-en>folds into</tspan>
        <tspan data-lang-vi>gói lại thành</tspan>
      </text>

      {/* right panel title */}
      <text x={CX - 40} y="58" class="atm-c-sub">
        <tspan data-lang-en>one candle (OHLC)</tspan>
        <tspan data-lang-vi>một nến (OHLC)</tspan>
      </text>

      {/* leader lines from markers to the candle */}
      <line x1={x(openPt[0]) + 6} y1={y(OPEN)} x2={CX - 44} y2={BODY_BOT} class="atm-c-lead" />
      <line x1={x(closePt[0]) - 6} y1={y(CLOSE)} x2={CX + 44} y2={BODY_TOP} class="atm-c-lead" />
      <line x1={x(highPt[0]) + 6} y1={y(HIGH)} x2={CX} y2={CY - 2} class="atm-c-lead" />
      <line x1={x(lowPt[0]) + 6} y1={y(LOW)} x2={CX} y2={CB + 2} class="atm-c-lead" />

      {/* candle */}
      <line x1={CX} y1={CY} x2={CX} y2={CB} class="atm-c-wick" />
      <rect x={CX - 40} y={BODY_TOP} width="80" height={BODY_BOT - BODY_TOP} rx="2" class="atm-c-body" />

      {/* candle labels, right side */}
      <text x={CX + 52} y={CY + 4} class="atm-c-lab">
        <tspan data-lang-en>high {en(HIGH)}</tspan>
        <tspan data-lang-vi>đỉnh {vi(HIGH)}</tspan>
      </text>
      <text x={CX + 52} y={BODY_TOP + 4} class="atm-c-lab">
        <tspan data-lang-en>close {en(CLOSE)}</tspan>
        <tspan data-lang-vi>đóng cửa {vi(CLOSE)}</tspan>
      </text>
      <text x={CX + 52} y={BODY_BOT + 4} class="atm-c-lab">
        <tspan data-lang-en>open {en(OPEN)}</tspan>
        <tspan data-lang-vi>mở cửa {vi(OPEN)}</tspan>
      </text>
      <text x={CX + 52} y={CB + 4} class="atm-c-lab">
        <tspan data-lang-en>low {en(LOW)}</tspan>
        <tspan data-lang-vi>đáy {vi(LOW)}</tspan>
      </text>

      {/* volume */}
      <rect x={CX - 40} y="308" width="80" height="24" rx="2" class="atm-c-vol" />
      <text x={CX - 52} y="325" text-anchor="end" class="atm-c-sub">
        <tspan data-lang-en>the day's volume: 12.4M shares</tspan>
        <tspan data-lang-vi>khối lượng cả ngày: 12,4 triệu cp</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>A session for one stock. The first match sets the open (24,500), the last sets the close (24,800); the extremes are the high (25,000) and low (24,200). The day's volume (12.4 million shares) sits under the candle.</span>
    <span data-lang-vi>Một phiên của một cổ phiếu. Lệnh khớp đầu tiên cho giá mở cửa (24.500), lệnh cuối cho giá đóng cửa (24.800); hai cực trị là đỉnh (25.000) và đáy (24.200). Khối lượng cả ngày (12,4 triệu cổ phiếu) vẽ dưới nến.</span>
  </figcaption>
</figure>

<style>
  .atm-candle {
    margin: 2em 0;
    width: 100%;
  }
  .atm-scroll {
    overflow-x: auto;
  }
  .atm-candle svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .atm-candle text {
    font-size: 14px;
    fill: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .atm-c-title {
    font-size: 16px;
    font-weight: 700;
    fill: var(--text);
  }
  .atm-c-sub {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .atm-c-grid {
    stroke: var(--border);
  }
  .atm-c-axisline {
    stroke: var(--text-muted);
    stroke-width: 1;
  }
  .atm-c-axis {
    font-size: 12px;
    fill: var(--text-muted);
  }
  .atm-c-ticks {
    stroke: var(--text-muted);
    stroke-width: 1.6;
  }
  .atm-c-dot {
    fill: var(--text-muted);
  }
  .atm-c-dot-red {
    fill: var(--red);
  }
  .atm-c-arrow {
    stroke: var(--text-muted);
    stroke-width: 1.4;
  }
  .atm-c-head {
    fill: var(--text-muted);
  }
  .atm-c-lead {
    stroke: var(--border);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .atm-c-wick {
    stroke: var(--text-muted);
    stroke-width: 2;
  }
  .atm-c-body {
    fill: var(--gold-tint-bg);
    stroke: var(--gold-icon);
    stroke-width: 1.4;
  }
  .atm-c-lab {
    font-size: 13px;
    fill: var(--text);
  }
  .atm-c-vol {
    fill: var(--text-faint);
    opacity: 0.45;
  }
  .atm-candle figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
