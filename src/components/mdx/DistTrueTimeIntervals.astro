---
import DiagramIcon from './DiagramIcon.astro';
// Two contrasts on distributed clocks:
//  1. Point-in-time wall clocks with slight skew cause Last-Write-Wins (LWW) to drop a causally later write.
//  2. Confidence intervals [earliest, latest] (Google Spanner TrueTime / AWS ClockBound) let nodes wait out uncertainty.
// Plain inline SVG with site tokens; arrowheads are polygons (no duplicate marker ids).

const W = 900;
const H = 438;

function arrow(x1: number, y1: number, x2: number, y2: number) {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const len = 8;
  const p1 = [x2 - len * Math.cos(a - 0.45), y2 - len * Math.sin(a - 0.45)];
  const p2 = [x2 - len * Math.cos(a + 0.45), y2 - len * Math.sin(a + 0.45)];
  return {
    line: `M ${x1} ${y1} L ${x2 - 6 * Math.cos(a)} ${y2 - 6 * Math.sin(a)}`,
    head: `${x2},${y2} ${p1[0].toFixed(1)},${p1[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`,
  };
}

// Bottom interval timeline: 0 to 28 ms
const axisL = 220;
const axisR = 640;
const MAX_T = 28;
const ix = (ms: number) => axisL + (ms / MAX_T) * (axisR - axisL);

const causalArrow = arrow(235, 102, 312, 134);
const repArrow1 = arrow(290, 82, 608, 96);
const repArrow2 = arrow(564, 144, 608, 128);
---
<figure class="dtti">
  <div class="dtti-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Top: Last-Write-Wins using point timestamps drops a causally later write because Node B's clock lags Node A's by 5 ms. Bottom: TrueTime and AWS ClockBound expose confidence intervals [earliest, latest]; waiting out the uncertainty window guarantees non-overlapping intervals and causal ordering.">
      {/* ---------- Section 1: Point timestamps ---------- */}
      <text x="20" y="24" class="dtti-h">
        <tspan data-lang-en>1. Point timestamps let skewed clocks drop newer writes</tspan>
        <tspan data-lang-vi>1. Timestamp một điểm làm lệch đồng hồ vứt nhầm lệnh ghi mới hơn</tspan>
      </text>

      {/* Node A write */}
      <rect x="20" y="52" width="270" height="52" rx="6" class="dtti-box" />
      <DiagramIcon name="db" x={42} y={78} size={24} />
      <text x="64" y="74" class="dtti-b">
        <tspan data-lang-en>First (t = 100 ms): write x = 1</tspan>
        <tspan data-lang-vi>Trước (t = 100 ms): ghi x = 1</tspan>
      </text>
      <text x="64" y="94" class="dtti-m">
        <tspan data-lang-en>Node 1 clock (+2 ms): 42.004 s</tspan>
        <tspan data-lang-vi>Đồng hồ Node 1 (+2 ms): 42,004 s</tspan>
      </text>

      {/* Causal link from A to B */}
      <path d={causalArrow.line} class="dtti-arrow" /><polygon points={causalArrow.head} class="dtti-head" />
      <text x="155" y="136" text-anchor="middle" class="dtti-sub">
        <tspan data-lang-en>reads x = 1, then increments</tspan>
        <tspan data-lang-vi>đọc x = 1, rồi tăng lên</tspan>
      </text>

      {/* Node B write */}
      <rect x="314" y="114" width="250" height="54" rx="6" class="dtti-box" />
      <DiagramIcon name="db" x={336} y={141} size={24} />
      <text x="358" y="136" class="dtti-b">
        <tspan data-lang-en>Later (t = 104 ms): x = 2</tspan>
        <tspan data-lang-vi>Sau (t = 104 ms): ghi x = 2</tspan>
      </text>
      <text x="358" y="156" class="dtti-m">
        <tspan data-lang-en>Node 3 clock (-3 ms): 42.003 s</tspan>
        <tspan data-lang-vi>Đồng hồ Node 3 (-3 ms): 42,003 s</tspan>
      </text>

      {/* Arrows to Replica 2 */}
      <path d={repArrow1.line} class="dtti-arrow" /><polygon points={repArrow1.head} class="dtti-head" />
      <path d={repArrow2.line} class="dtti-arrow" /><polygon points={repArrow2.head} class="dtti-head" />

      {/* Target replica drops x = 2 */}
      <rect x="610" y="68" width="270" height="84" rx="6" class="dtti-box is-bad" />
      <DiagramIcon name="db" x={632} y={110} size={24} />
      <text x="650" y="92" class="dtti-b-red">
        <tspan data-lang-en>Replica compares 42.004 &gt; 42.003</tspan>
        <tspan data-lang-vi>Replica so sánh 42,004 &gt; 42,003</tspan>
      </text>
      <text x="650" y="116" class="dtti-b">
        <tspan data-lang-en>Keeps x = 1, discards x = 2</tspan>
        <tspan data-lang-vi>Giữ x = 1, âm thầm vứt x = 2</tspan>
      </text>
      <text x="650" y="138" class="dtti-m">
        <tspan data-lang-en>Silent data loss under LWW</tspan>
        <tspan data-lang-vi>Mất dữ liệu âm thầm dưới LWW</tspan>
      </text>

      {/* ---------- Section 2: Confidence intervals ---------- */}
      <line x1="20" x2={W - 20} y1="192" y2="192" class="dtti-rule" />
      <text x="20" y="220" class="dtti-h">
        <tspan data-lang-en>2. Confidence intervals [earliest, latest] make uncertainty explicit</tspan>
        <tspan data-lang-vi>2. Khoảng tin cậy [earliest, latest] phơi bày sai số đồng hồ</tspan>
      </text>
      <text x="20" y="240" class="dtti-sub">
        <tspan data-lang-en>TrueTime (Spanner) and AWS ClockBound return a range, not a point. Order is certain only when ranges do not overlap.</tspan>
        <tspan data-lang-vi>TrueTime (Spanner) và AWS ClockBound trả về một khoảng thay vì một điểm. Chỉ chắc chắn thứ tự khi hai khoảng tách rời.</tspan>
      </text>

      {/* Subcase A: Overlapping intervals */}
      <text x="20" y="278" class="dtti-b">
        <tspan data-lang-en>No commit-wait</tspan>
        <tspan data-lang-vi>Không chờ xác nhận</tspan>
      </text>
      <text x="20" y="296" class="dtti-m">
        <tspan data-lang-en>uncertainty ±3.5 ms</tspan>
        <tspan data-lang-vi>sai số ±3,5 ms</tspan>
      </text>

      {/* Overlap shading */}
      <rect x={ix(11.5)} y="256" width={ix(14.5) - ix(11.5)} height="54" class="dtti-overlap" />
      {/* Interval A1 */}
      <line x1={ix(7.5)} x2={ix(14.5)} y1="268" y2="268" class="dtti-iv-line" />
      <circle cx={ix(11)} cy="268" r="4" class="dtti-iv-mid" />
      <line x1={ix(7.5)} x2={ix(7.5)} y1="262" y2="274" class="dtti-iv-cap" />
      <line x1={ix(14.5)} x2={ix(14.5)} y1="262" y2="274" class="dtti-iv-cap" />
      <text x={ix(7.5) - 8} y="272" text-anchor="end" class="dtti-tag">A</text>
      {/* Interval B1 */}
      <line x1={ix(11.5)} x2={ix(18.5)} y1="296" y2="296" class="dtti-iv-line is-red" />
      <circle cx={ix(15)} cy="296" r="4" class="dtti-iv-mid is-red" />
      <line x1={ix(11.5)} x2={ix(11.5)} y1="290" y2="302" class="dtti-iv-cap is-red" />
      <line x1={ix(18.5)} x2={ix(18.5)} y1="290" y2="302" class="dtti-iv-cap is-red" />
      <text x={ix(11.5) - 8} y="300" text-anchor="end" class="dtti-tag-red">B</text>

      <text x="658" y="278" class="dtti-b-red">
        <tspan data-lang-en>Intervals overlap (11.5..14.5)</tspan>
        <tspan data-lang-vi>Chồng lên nhau (11,5..14,5)</tspan>
      </text>
      <text x="658" y="298" class="dtti-m">
        <tspan data-lang-en>Cannot tell if A happened first</tspan>
        <tspan data-lang-vi>Không chắc A có xảy ra trước không</tspan>
      </text>

      {/* Subcase B: Wait 2*epsilon before commit */}
      <text x="20" y="346" class="dtti-b">
        <tspan data-lang-en>Commit-wait (2ε)</tspan>
        <tspan data-lang-vi>Chờ xác nhận (2ε)</tspan>
      </text>
      <text x="20" y="364" class="dtti-m">
        <tspan data-lang-en>wait ~7 ms before reply</tspan>
        <tspan data-lang-vi>chờ ~7 ms trước khi trả về</tspan>
      </text>

      {/* Interval A2 */}
      <line x1={ix(7.5)} x2={ix(14.5)} y1="336" y2="336" class="dtti-iv-line" />
      <circle cx={ix(11)} cy="336" r="4" class="dtti-iv-mid" />
      <line x1={ix(7.5)} x2={ix(7.5)} y1="330" y2="342" class="dtti-iv-cap" />
      <line x1={ix(14.5)} x2={ix(14.5)} y1="330" y2="342" class="dtti-iv-cap" />
      <text x={ix(7.5) - 8} y="340" text-anchor="end" class="dtti-tag">A</text>

      {/* Wait bracket */}
      <line x1={ix(14.5)} x2={ix(14.5)} y1="322" y2="376" class="dtti-wait-guide" />
      <line x1={ix(14.5)} x2={ix(18.0)} y1="348" y2="348" class="dtti-wait-bar" />
      <text x={ix(16.25)} y="343" text-anchor="middle" class="dtti-wait-txt">
        <tspan data-lang-en>wait</tspan>
        <tspan data-lang-vi>chờ</tspan>
      </text>

      {/* Interval B2 */}
      <line x1={ix(18.0)} x2={ix(25.0)} y1="364" y2="364" class="dtti-iv-line is-ok" />
      <circle cx={ix(21.5)} cy="364" r="4" class="dtti-iv-mid is-ok" />
      <line x1={ix(18.0)} x2={ix(18.0)} y1="358" y2="370" class="dtti-iv-cap is-ok" />
      <line x1={ix(25.0)} x2={ix(25.0)} y1="358" y2="370" class="dtti-iv-cap is-ok" />
      <text x={ix(18.0) - 8} y="368" text-anchor="end" class="dtti-tag-ok">B</text>

      <text x="658" y="346" class="dtti-b-ok">
        <tspan data-lang-en>A.latest &lt; B.earliest</tspan>
        <tspan data-lang-vi>A.latest &lt; B.earliest</tspan>
      </text>
      <text x="658" y="366" class="dtti-m">
        <tspan data-lang-en>Disjoint: A strictly precedes B</tspan>
        <tspan data-lang-vi>Tách rời: A chắc chắn trước B</tspan>
      </text>

      {/* Time axis */}
      <line x1={axisL} x2={axisR} y1="398" y2="398" class="dtti-axis" />
      {[0, 7, 14, 21, 28].map((ms) => (
        <g>
          <line x1={ix(ms)} x2={ix(ms)} y1="394" y2="402" class="dtti-axis" />
          <text x={ix(ms)} y="418" text-anchor="middle" class="dtti-tick">{ms} ms</text>
        </g>
      ))}
      <text x={axisR + 14} y="418" class="dtti-m">
        <tspan data-lang-en>true time →</tspan>
        <tspan data-lang-vi>thời gian thực →</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Even a 5 ms clock skew breaks Last-Write-Wins when timestamps look like exact points. Exposing uncertainty as [earliest, latest] lets databases like Google Spanner (within ~7 ms via GPS and atomic clocks) or AWS ClockBound wait out the window until intervals cannot overlap.</span>
    <span data-lang-vi>Chỉ lệch đồng hồ 5 ms cũng đủ khiến Last-Write-Wins vứt nhầm lệnh ghi mới. Khi phơi bày sai số thành khoảng [earliest, latest], các database như Google Spanner (giữ sai số ~7 ms nhờ GPS và đồng hồ nguyên tử) hay AWS ClockBound chỉ cần chờ qua ngưỡng bất định để hai khoảng không còn giao nhau.</span>
  </figcaption>
</figure>

<style>
  .dtti {
    margin: 2em 0;
    width: 100%;
  }
  .dtti-scroll {
    overflow-x: auto;
  }
  .dtti svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .dtti text {
    font-size: 13.5px;
    fill: var(--text-body);
  }
  .dtti .dtti-h {
    font-size: 15.5px;
    font-weight: 700;
    fill: var(--text);
  }
  .dtti .dtti-sub {
    font-size: 13px;
    fill: var(--text-muted);
  }
  .dtti-box {
    fill: var(--bg-alt);
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .dtti-box.is-bad {
    fill: var(--red-tint-bg);
    stroke: var(--red);
    stroke-width: 1.5;
  }
  .dtti .dtti-b {
    font-weight: 700;
    fill: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .dtti .dtti-b-red {
    font-weight: 700;
    fill: var(--red);
    font-variant-numeric: tabular-nums;
  }
  .dtti .dtti-b-ok {
    font-weight: 700;
    fill: #15803d;
    font-variant-numeric: tabular-nums;
  }
  :global(html[data-theme='dark']) .dtti .dtti-b-ok {
    fill: #4ade80;
  }
  .dtti .dtti-m {
    font-size: 12.5px;
    fill: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .dtti-arrow {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.4;
  }
  .dtti-head {
    fill: var(--text-muted);
  }
  .dtti-rule {
    stroke: var(--border);
  }
  .dtti-overlap {
    fill: var(--red-tint-bg);
    opacity: 0.85;
  }
  .dtti-iv-line {
    stroke: var(--text);
    stroke-width: 2.2;
  }
  .dtti-iv-cap {
    stroke: var(--text);
    stroke-width: 2;
  }
  .dtti-iv-mid {
    fill: var(--text);
  }
  .dtti-iv-line.is-red,
  .dtti-iv-cap.is-red {
    stroke: var(--red);
  }
  .dtti-iv-mid.is-red {
    fill: var(--red);
  }
  .dtti-iv-line.is-ok,
  .dtti-iv-cap.is-ok {
    stroke: #15803d;
  }
  .dtti-iv-mid.is-ok {
    fill: #15803d;
  }
  :global(html[data-theme='dark']) .dtti-iv-line.is-ok,
  :global(html[data-theme='dark']) .dtti-iv-cap.is-ok {
    stroke: #4ade80;
  }
  :global(html[data-theme='dark']) .dtti-iv-mid.is-ok {
    fill: #4ade80;
  }
  .dtti .dtti-tag {
    font-size: 13px;
    font-weight: 700;
    fill: var(--text);
  }
  .dtti .dtti-tag-red {
    font-size: 13px;
    font-weight: 700;
    fill: var(--red);
  }
  .dtti .dtti-tag-ok {
    font-size: 13px;
    font-weight: 700;
    fill: #15803d;
  }
  :global(html[data-theme='dark']) .dtti .dtti-tag-ok {
    fill: #4ade80;
  }
  .dtti-wait-guide {
    stroke: var(--border);
    stroke-dasharray: 3 3;
  }
  .dtti-wait-bar {
    stroke: var(--text-muted);
    stroke-width: 1.5;
    stroke-dasharray: 2 2;
  }
  .dtti .dtti-wait-txt {
    font-size: 11.5px;
    fill: var(--text-muted);
  }
  .dtti-axis {
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .dtti .dtti-tick {
    font-size: 12px;
    fill: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .dtti figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
</style>
