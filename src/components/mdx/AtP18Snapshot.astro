---
import DiagramIcon from './DiagramIcon.astro';
// Timeline of Feng et al. (2019), section 4: prices 2013-01-02 .. 2017-12-08, split into train (756 days),
// validation (252) and test (237); the Wikidata dump the Wiki relations come from is dated 01/05/2018,
// after the test period. The paper writes dates month/day/year.
const W = 900;
const H = 322;
const X0 = 40;
const X1 = 860;
const T0 = 2013.0;
const T1 = 2018.3;
const gx = (t: number) => X0 + ((t - T0) / (T1 - T0)) * (X1 - X0);
---
<figure class="atp18-snap">
  <div class="atp18-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Timeline from 2013 to 2018. Training prices run 2013 to 2015 with 756 days, validation covers 2016 with 252 days, and testing covers 2017 up to 8 December with 237 days. The company relations come from a Wikidata dump dated 5 January 2018, after the test period ends.">
      <text x="20" y="24" class="h">
        <tspan data-lang-en>The graph was drawn after the test period ended</tspan>
        <tspan data-lang-vi>Graph được vẽ sau khi giai đoạn test đã kết thúc</tspan>
      </text>
      <rect x={gx(2013.0)} y="70" width={gx(2016.0) - gx(2013.0)} height="40" rx="4" class="seg tr" />
      <rect x={gx(2016.0)} y="70" width={gx(2017.0) - gx(2016.0)} height="40" rx="4" class="seg va" />
      <rect x={gx(2017.0)} y="70" width={gx(2017.93) - gx(2017.0)} height="40" rx="4" class="seg te" />
      <text x={(gx(2013.0) + gx(2016.0)) / 2} y="94" text-anchor="middle" class="lab">
        <tspan data-lang-en>train, 756 days</tspan>
        <tspan data-lang-vi>train, 756 ngày</tspan>
      </text>
      <text x={(gx(2016.0) + gx(2017.0)) / 2} y="94" text-anchor="middle" class="lab">
        <tspan data-lang-en>validate, 252</tspan>
        <tspan data-lang-vi>validate, 252</tspan>
      </text>
      <text x={(gx(2017.0) + gx(2017.93)) / 2} y="94" text-anchor="middle" class="lab">
        <tspan data-lang-en>test, 237</tspan>
        <tspan data-lang-vi>test, 237</tspan>
      </text>
      <line x1={X0} x2={X1} y1="132" y2="132" class="axis" />
      {[2013, 2014, 2015, 2016, 2017, 2018].map((yr) => (
        <g>
          <line x1={gx(yr)} x2={gx(yr)} y1="128" y2="136" class="axis" />
          <text x={gx(yr)} y="152" text-anchor="middle" class="tick">{yr}</text>
        </g>
      ))}
      <line x1={gx(2018.01)} x2={gx(2018.01)} y1="60" y2="132" class="dump" />
      <DiagramIcon name="warning" x={gx(2018.01)} y="52" size="20" />
      <text x={gx(2018.01) - 12} y="196" text-anchor="end" class="warn">
        <tspan data-lang-en>Wikidata dump of 5 Jan 2018</tspan>
        <tspan data-lang-vi>Bản dump Wikidata ngày 5/1/2018</tspan>
      </text>
      <text x={gx(2018.01) - 12} y="216" text-anchor="end" class="sm">
        <tspan data-lang-en>source of the 42 and 32 Wiki relation types</tspan>
        <tspan data-lang-vi>nguồn của 42 và 32 loại quan hệ Wiki</tspan>
      </text>
      <text x="40" y="196" class="sm">
        <tspan data-lang-en>Prices: 2 Jan 2013 to 8 Dec 2017</tspan>
        <tspan data-lang-vi>Giá: 2/1/2013 đến 8/12/2017</tspan>
      </text>
      <text x="40" y="216" class="sm muted">
        <tspan data-lang-en>Split by time, in order, as it should be.</tspan>
        <tspan data-lang-vi>Chia theo thời gian, đúng thứ tự, như phải làm.</tspan>
      </text>
      <rect x="20" y="238" width="860" height="68" rx="8" class="panel" />
      <text x="36" y="258" class="sm">
        <tspan data-lang-en>The prices are split in time order, but the edges are a later snapshot.</tspan>
        <tspan data-lang-vi>Giá được chia đúng thứ tự thời gian, còn các cạnh là một ảnh chụp muộn hơn.</tspan>
      </text>
      <text x="36" y="277" class="sm">
        <tspan data-lang-en>A supplier link that did not exist in 2014 can still shape a 2014 prediction.</tspan>
        <tspan data-lang-vi>Một quan hệ nhà cung cấp chưa có năm 2014 vẫn có thể ảnh hưởng dự đoán năm 2014.</tspan>
      </text>
      <text x="36" y="296" class="sm muted">
        <tspan data-lang-en>Its data section does not say how the relations changed over the five years.</tspan>
        <tspan data-lang-vi>Mục dữ liệu của nó không nói các quan hệ đã đổi thế nào trong năm năm đó.</tspan>
      </text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Dates and day counts from section 4 of Feng et al. (2019). The paper writes dates as month/day/year; the Wikidata dump is the one it calls 01/05/2018.</span>
    <span data-lang-vi>Ngày và số ngày lấy từ mục 4 của Feng và cộng sự (2019). Bài báo viết ngày theo kiểu tháng/ngày/năm; bản dump Wikidata là bản nó ghi 01/05/2018.</span>
  </figcaption>
</figure>

<style>
  .atp18-snap { margin: 2em 0; width: 100%; }
  .atp18-scroll { overflow-x: auto; }
  .atp18-snap svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .atp18-snap .h { font-size: 15px; font-weight: 700; fill: var(--text); }
  .atp18-snap .lab { font-size: 12.5px; font-weight: 700; fill: var(--text); }
  .atp18-snap .tick { font-size: 11.5px; fill: var(--text-muted); }
  .atp18-snap .sm { font-size: 12.5px; fill: var(--text-body); }
  .atp18-snap .sm.muted { fill: var(--text-muted); font-size: 12px; }
  .atp18-snap .warn { font-size: 13px; font-weight: 700; fill: var(--red); }
  .atp18-snap .axis { stroke: var(--text-faint); stroke-width: 1.2; }
  .atp18-snap .seg { stroke: var(--border); }
  .atp18-snap .seg.tr { fill: var(--bg-alt); }
  .atp18-snap .seg.va { fill: var(--gold-tint-bg); }
  .atp18-snap .seg.te { fill: var(--gold-tint-bg); stroke: var(--gold); stroke-width: 2; }
  .atp18-snap .dump { stroke: var(--red); stroke-width: 2.4; stroke-dasharray: 5 4; }
  .atp18-snap .panel { fill: var(--bg-alt); stroke: var(--border); }
  .atp18-snap figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
