---
import DiagramIcon from './DiagramIcon.astro';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const L = (en: string, vi: string) => (lang === 'vi' ? vi : en);
const W = 900;
const H = 326;
---
<figure class="dic">
  <div class="dic-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L("Three incidents side by side. Cloudflare: a leap second stepped the clock back, a duration went negative, and DNS failed. GitHub: a 43 second link cut led to a failover and 24 hours 11 minutes of recovery. HBase: a garbage-collection pause let a lease lapse and two clients wrote at once.", "Ba sự cố cạnh nhau. Cloudflare: giây nhuận làm đồng hồ nhảy lùi, thời lượng âm, DNS lỗi. GitHub: đường truyền đứt 43 giây dẫn tới failover và 24 giờ 11 phút khắc phục. HBase: GC pause làm lease hết hạn và hai client cùng ghi.")}>
<text x="20" y="24" class="t-h">{L("Three real incidents, one pattern: something assumed impossible happened","Ba sự cố có thật, một mô-típ: thứ tưởng không thể xảy ra đã xảy ra")}</text>
<rect x="20" y="44" width="280" height="262" rx="8" class="box-d" />
<DiagramIcon name="cloudflare" x={54} y={80} size={32} />
<text x="82" y="78" class="t-b">{L("Cloudflare","Cloudflare")}</text>
<text x="82" y="96" class="t-m">{L("1 January 2017","1/1/2017")}</text>
<rect x="34" y="116" width="252" height="46" rx="6" class="box" />
<text x="46" y="136" class="t-b">{L("A leap second steps","Giây nhuận làm đồng hồ")}</text>
<text x="46" y="153" class="t-m">{L("the wall clock back","giờ thực nhảy lùi")}</text>
<path d="M 160 162 L 160.0 172.0" class="ln" /><polygon points="160,178 156.5,170.8 163.5,170.8" class="hd" />
<rect x="34" y="178" width="252" height="46" rx="6" class="box" />
<text x="46" y="198" class="t-b">{L("time.Now() minus start","time.Now() trừ start")}</text>
<text x="46" y="215" class="t-m">{L("gives a negative duration","ra thời lượng âm")}</text>
<path d="M 160 224 L 160.0 234.0" class="ln" /><polygon points="160,240 156.5,232.8 163.5,232.8" class="hd" />
<rect x="34" y="240" width="252" height="46" rx="6" class="box-r" />
<text x="46" y="260" class="t-r">{L("rand.Int63n() panics; DNS","rand.Int63n() panic; DNS lỗi")}</text>
<text x="46" y="277" class="t-r">{L("fails in part of 102 sites","ở một phần của 102 site")}</text>
<rect x="310" y="44" width="280" height="262" rx="8" class="box-d" />
<DiagramIcon name="github" x={344} y={80} size={32} />
<text x="372" y="78" class="t-b">{L("GitHub","GitHub")}</text>
<text x="372" y="96" class="t-m">{L("21 October 2018","21/10/2018")}</text>
<rect x="324" y="116" width="252" height="46" rx="6" class="box" />
<text x="336" y="136" class="t-b">{L("Optical link cut","Đường quang bị cắt")}</text>
<text x="336" y="153" class="t-m">{L("for 43 seconds","đúng 43 giây")}</text>
<path d="M 450 162 L 450.0 172.0" class="ln" /><polygon points="450,178 446.5,170.8 453.5,170.8" class="hd" />
<rect x="324" y="178" width="252" height="46" rx="6" class="box" />
<text x="336" y="198" class="t-b">{L("Failover promotes MySQL","Failover nâng primary MySQL")}</text>
<text x="336" y="215" class="t-m">{L("primaries on the West Coast","ở bờ Tây lên")}</text>
<path d="M 450 224 L 450.0 234.0" class="ln" /><polygon points="450,240 446.5,232.8 453.5,232.8" class="hd" />
<rect x="324" y="240" width="252" height="46" rx="6" class="box-r" />
<text x="336" y="260" class="t-r">{L("24 h 11 min to recover;","24 giờ 11 phút khắc phục;")}</text>
<text x="336" y="277" class="t-r">{L("East and West diverged","East và West lệch dữ liệu")}</text>
<rect x="600" y="44" width="280" height="262" rx="8" class="box-d" />
<DiagramIcon name="server" x={634} y={80} size={32} />
<text x="662" y="78" class="t-b">{L("HBase","HBase")}</text>
<text x="662" y="96" class="t-m">{L("Java garbage-collection pause","GC pause của Java")}</text>
<rect x="614" y="116" width="252" height="46" rx="6" class="box" />
<text x="626" y="136" class="t-b">{L("A GC pause freezes","GC pause đóng băng")}</text>
<text x="626" y="153" class="t-m">{L("the lease holder","máy giữ lease")}</text>
<path d="M 740 162 L 740.0 172.0" class="ln" /><polygon points="740,178 736.5,170.8 743.5,170.8" class="hd" />
<rect x="614" y="178" width="252" height="46" rx="6" class="box" />
<text x="626" y="198" class="t-b">{L("Its lease lapses; another","Lease hết hạn, client")}</text>
<text x="626" y="215" class="t-m">{L("client takes over","khác nhảy vào thế chỗ")}</text>
<path d="M 740 224 L 740.0 234.0" class="ln" /><polygon points="740,240 736.5,232.8 743.5,232.8" class="hd" />
<rect x="614" y="240" width="252" height="46" rx="6" class="box-r" />
<text x="626" y="260" class="t-r">{L("Both write: split-brain","Cả hai cùng ghi: hỏng dữ")}</text>
<text x="626" y="277" class="t-r">{L("corruption","liệu kiểu split-brain")}</text>
    </svg>
  </div>
  <figcaption>{L("Each case runs the same way: a small physical or timing event, an automatic reaction, then damage nobody planned for.", "Cả ba đều diễn ra cùng một kiểu: một biến cố nhỏ về vật lý hoặc thời gian, một phản ứng tự động, rồi thiệt hại không ai lường trước.")}</figcaption>
</figure>

<style>
  .dic { margin: 2em 0; width: 100%; }
  .dic-scroll { overflow-x: auto; }
  .dic svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dic text { font-size: 13px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .dic .t-h { font-size: 15.5px; font-weight: 700; fill: var(--text); }
  .dic .t-b { font-weight: 700; fill: var(--text); }
  .dic .t-r { font-weight: 700; fill: var(--red); }
  .dic .t-m { fill: var(--text-muted); font-size: 12.5px; }
  .dic .box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .dic .box-r { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .dic .box-g { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.5; }
  .dic .box-d { fill: transparent; stroke: var(--border); stroke-dasharray: 5 4; stroke-width: 1.2; }
  .dic .box-gd { fill: transparent; stroke: var(--gold-icon); stroke-dasharray: 5 4; stroke-width: 1.4; }
  .dic .ln { fill: none; stroke: var(--text-muted); stroke-width: 1.5; }
  .dic .ln-r { fill: none; stroke: var(--red); stroke-width: 2; }
  .dic .ln-g { fill: none; stroke: var(--gold-icon); stroke-width: 2; }
  .dic .ln-d { fill: none; stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .dic .ln-rd { fill: none; stroke: var(--red); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .dic .ln-gr { fill: none; stroke: var(--border); stroke-dasharray: 2 4; }
  .dic .hd { fill: var(--text-muted); }
  .dic .hd-r { fill: var(--red); }
  .dic .hd-g { fill: var(--gold-icon); }
  .dic .dot-g { fill: var(--gold-icon); }
  .dic figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
