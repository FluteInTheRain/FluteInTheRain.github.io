---
// Picture-first overview: the four ways derived copies drift apart, and the one shared fix.
// Facts come from the post text (Shopify Longboat polling, AMQP redelivery, restart backlog).
import DiagramIcon from './DiagramIcon.astro';
import StreamAFrame from './StreamAFrame.astro';
import { arrow } from './StreamAHelpers';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    h: 'One database, four ways its copies drift apart',
    cards: [
      { icon: 'elasticsearch', n: 'Dual write', s: ['App writes to PostgreSQL,', 'then to Elasticsearch.'], b: ['Updates swap order:', 'search shows stale data'] },
      { icon: 'clock', n: 'Hourly polling', s: ['Longboat polls 100+ MySQL', 'shards once an hour.'], b: ['Hard deletes vanish,', 'data is 1+ hour old'] },
      { icon: 'rabbitmq', n: 'Queue retries', s: ['A worker crashes and', 'the broker redelivers.'], b: ['Messages are processed', 'out of order'] },
      { icon: 'bell', n: 'Restart backlog', s: ['A consumer restarts for', 'a 60-second deploy.'], b: ['Backlog drains at once:', 'a fake traffic spike'] },
    ],
    fix: 'One fix for all four: every copy reads one ordered, durable event log',
    fixs: 'The sections below show how that log works, step by step.',
    alt: 'Four cards, each a failure: dual writes to PostgreSQL and Elasticsearch swap order; hourly polling of 100+ MySQL shards loses hard deletes; AMQP queue retries reorder messages; a restarted consumer drains a backlog and shows a fake traffic spike. Arrows lead from all four to one fix: an ordered, durable event log.',
    cap: 'The four failures in the list above, side by side. They share one cure: stop copying data by hand and read from an ordered log.',
  },
  vi: {
    h: 'Một database, bốn cách các bản sao lệch nhau',
    cards: [
      { icon: 'elasticsearch', n: 'Dual write', s: ['App ghi vào PostgreSQL,', 'rồi ghi sang Elasticsearch.'], b: ['Hai lệnh ghi đảo thứ tự:', 'search hiện dữ liệu cũ'] },
      { icon: 'clock', n: 'Polling theo giờ', s: ['Longboat quét 100+ shard', 'MySQL mỗi giờ một lần.'], b: ['Lệnh xoá cứng biến mất,', 'dữ liệu trễ 1 giờ trở lên'] },
      { icon: 'rabbitmq', n: 'Queue gửi lại', s: ['Worker sập và broker', 'gửi lại tin nhắn.'], b: ['Tin nhắn bị xử lý', 'sai thứ tự'] },
      { icon: 'bell', n: 'Backlog dồn lại', s: ['Consumer khởi động lại', 'vì deploy 60 giây.'], b: ['Backlog xả cùng lúc:', 'đỉnh traffic giả'] },
    ],
    fix: 'Một cách chữa cho cả bốn: mọi bản sao đọc từ một event log có thứ tự, bền vững',
    fixs: 'Các mục dưới đây cho thấy log đó chạy ra sao, từng bước.',
    alt: 'Bốn thẻ, mỗi thẻ một lỗi: dual write vào PostgreSQL và Elasticsearch đảo thứ tự; polling hằng giờ trên 100+ shard MySQL mất lệnh xoá cứng; queue AMQP gửi lại làm đảo thứ tự tin nhắn; consumer khởi động lại xả backlog và tạo đỉnh traffic giả. Mũi tên từ cả bốn dẫn tới một cách chữa: event log có thứ tự và bền vững.',
    cap: 'Bốn lỗi trong danh sách ở trên, đặt cạnh nhau. Cả bốn có chung một cách chữa: thôi sao chép dữ liệu thủ công, hãy đọc từ một log có thứ tự.',
  },
}[lang];
const cw = 205, y = 44, ch = 170;
const xs = [0, 1, 2, 3].map((i) => 16 + i * 221);
---
<StreamAFrame h={330} alt={T.alt} cap={T.cap} title={T.h}>
  {T.cards.map((c, i) => (
    <g>
      <g class="box"><rect x={xs[i]} y={y} width={cw} height={ch} rx="7" /></g>
      <DiagramIcon name={c.icon as any} x={xs[i] + 28} y={y + 30} size={28} />
      <text x={xs[i] + 54} y={y + 35} class="name">{c.n}</text>
      <text x={xs[i] + 14} y={y + 76} class="sub">{c.s[0]}</text>
      <text x={xs[i] + 14} y={y + 94} class="sub">{c.s[1]}</text>
      <line x1={xs[i] + 14} x2={xs[i] + cw - 14} y1={y + 112} y2={y + 112} class="rule" />
      <text x={xs[i] + 14} y={y + 138} class="bad">{c.b[0]}</text>
      <text x={xs[i] + 14} y={y + 156} class="bad">{c.b[1]}</text>
    </g>
  ))}
  {xs.map((x) => {
    const a = arrow(x + cw / 2, y + ch, x + cw / 2, 252);
    return <g class="arr good"><path d={a.line} /><polygon points={a.head} /></g>;
  })}
  <g class="box good"><rect x="16" y="254" width="868" height="62" rx="7" /></g>
  <DiagramIcon name="log" x={52} y={285} size={30} />
  <text x="84" y="280" class="name">{T.fix}</text>
  <text x="84" y="300" class="sub">{T.fixs}</text>
</StreamAFrame>
