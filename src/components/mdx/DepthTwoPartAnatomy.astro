---
// Decomposes a two-part CSS box-shadow into its two physical layers:
// 1) Direct light shadow (large offset, soft blur)
// 2) Ambient occlusion shadow (tight, darker near the contact edge, fading as z rises)
const uid = Math.random().toString(36).slice(2, 8);
const W = 900;
const H = 310;
---
<figure class="dta">
  <div class="dta-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Diagram breaking a two-part shadow into two layers: a large soft direct-light shadow plus a tight dark ambient-occlusion shadow near the edge, combining into a grounded elevation shadow. Below, a scale shows ambient shadow opacity fading as height increases.">
      <defs>
        <filter id={`dta-direct-${uid}`} x="-35%" y="-35%" width="170%" height="190%">
          <feDropShadow dx="0" dy="12" stdDeviation="9" flood-color="#262421" flood-opacity="0.16" />
        </filter>
        <filter id={`dta-ambient-${uid}`} x="-35%" y="-35%" width="170%" height="190%">
          <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#262421" flood-opacity="0.22" />
        </filter>
        <filter id={`dta-both-${uid}`} x="-35%" y="-35%" width="170%" height="190%">
          <feDropShadow dx="0" dy="12" stdDeviation="9" flood-color="#262421" flood-opacity="0.15" />
          <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#262421" flood-opacity="0.20" />
        </filter>
      </defs>

      <!-- Card 1: Direct shadow -->
      <rect x="34" y="24" width="240" height="156" rx="10" class="dta-stage" />
      <text x="154" y="50" text-anchor="middle" class="dta-h">
        <tspan data-lang-en>1. Direct light shadow</tspan>
        <tspan data-lang-vi>1. Bóng ánh sáng trực tiếp</tspan>
      </text>
      <rect x="84" y="74" width="140" height="58" rx="8" class="dta-card" filter={`url(#dta-direct-${uid})`} />
      <text x="154" y="108" text-anchor="middle" class="dta-card-lbl">
        <tspan data-lang-en>Wide, soft</tspan>
        <tspan data-lang-vi>Rộng, mềm</tspan>
      </text>
      <text x="154" y="166" text-anchor="middle" class="dta-sub">
        <tspan data-lang-en>Signals height above canvas</tspan>
        <tspan data-lang-vi>Báo độ cao khỏi nền</tspan>
      </text>

      <!-- Plus sign -->
      <text x="302" y="110" text-anchor="middle" class="dta-op">+</text>

      <!-- Card 2: Ambient occlusion -->
      <rect x="330" y="24" width="240" height="156" rx="10" class="dta-stage" />
      <text x="450" y="50" text-anchor="middle" class="dta-h">
        <tspan data-lang-en>2. Ambient occlusion</tspan>
        <tspan data-lang-vi>2. Bóng tiếp xúc (ambient)</tspan>
      </text>
      <rect x="380" y="74" width="140" height="58" rx="8" class="dta-card" filter={`url(#dta-ambient-${uid})`} />
      <text x="450" y="108" text-anchor="middle" class="dta-card-lbl">
        <tspan data-lang-en>Tight, dark</tspan>
        <tspan data-lang-vi>Gọn, đậm</tspan>
      </text>
      <text x="450" y="166" text-anchor="middle" class="dta-sub">
        <tspan data-lang-en>Anchors edge near surface</tspan>
        <tspan data-lang-vi>Giữ mép thẻ sắc nét gần nền</tspan>
      </text>

      <!-- Equals sign -->
      <text x="598" y="110" text-anchor="middle" class="dta-op">=</text>

      <!-- Card 3: Combined -->
      <rect x="626" y="24" width="240" height="156" rx="10" class="dta-stage is-accent" />
      <text x="746" y="50" text-anchor="middle" class="dta-h is-accent">
        <tspan data-lang-en>Two-part shadow</tspan>
        <tspan data-lang-vi>Bóng đổ hai lớp</tspan>
      </text>
      <rect x="676" y="74" width="140" height="58" rx="8" class="dta-card" filter={`url(#dta-both-${uid})`} />
      <text x="746" y="108" text-anchor="middle" class="dta-card-lbl">
        <tspan data-lang-en>Crisp + airy</tspan>
        <tspan data-lang-vi>Rõ mép + thoáng</tspan>
      </text>
      <text x="746" y="166" text-anchor="middle" class="dta-sub">
        <tspan data-lang-en>Natural depth, never muddy</tspan>
        <tspan data-lang-vi>Chiều sâu tự nhiên, không đục</tspan>
      </text>

      <!-- Bottom rule: ambient fades as height rises -->
      <line x1="34" y1="210" x2="866" y2="210" class="dta-div" />
      <text x="34" y="236" class="dta-rule-title">
        <tspan data-lang-en>How the tight ambient layer fades as elevation increases</tspan>
        <tspan data-lang-vi>Lớp bóng tiếp xúc mờ dần khi độ cao tăng lên</tspan>
      </text>

      <!-- 5 opacity bars -->
      {[
        { x: 34, en: 'L1 Button', vi: 'Bậc 1 Nút', pct: '100%', op: 0.90 },
        { x: 204, en: 'L2 Card', vi: 'Bậc 2 Thẻ', pct: '75%', op: 0.68 },
        { x: 374, en: 'L3 Dropdown', vi: 'Bậc 3 Menu', pct: '50%', op: 0.45 },
        { x: 544, en: 'L4 Popover', vi: 'Bậc 4 Popover', pct: '25%', op: 0.24 },
        { x: 714, en: 'L5 Modal', vi: 'Bậc 5 Modal', pct: '~0%', op: 0.08 },
      ].map((b) => (
        <g>
          <rect x={b.x} y="250" width="152" height="16" rx="4" class="dta-bar-bg" />
          <rect x={b.x} y="250" width="152" height="16" rx="4" class="dta-bar-fill" style={`opacity: ${b.op};`} />
          <text x={b.x} y="286" class="dta-bar-lbl">
            <tspan data-lang-en>{b.en}</tspan>
            <tspan data-lang-vi>{b.vi}</tspan>
          </text>
          <text x={b.x + 152} y="286" text-anchor="end" class="dta-bar-pct">{b.pct}</text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>Two CSS shadows separate height from contact sharpness. At modal height, ambient light wraps underneath, so the tight shadow nearly disappears.</span>
    <span data-lang-vi>Hai lớp box-shadow tách riêng độ cao và độ sắc ở mép. Khi vật nâng cao như modal, ánh sáng môi trường lọt qua dưới đáy nên bóng tiếp xúc gần như biến mất.</span>
  </figcaption>
</figure>

<style>
  .dta { margin: 2em 0; width: 100%; }
  .dta-scroll { overflow-x: auto; }
  .dta svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .dta text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .dta-stage { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .dta-stage.is-accent { stroke: var(--red); stroke-width: 1.5; }
  .dta text.dta-h { font-size: 14px; font-weight: 700; fill: var(--text); }
  .dta text.dta-h.is-accent { fill: var(--red); }
  .dta-card { fill: var(--card-bg); stroke: var(--border); stroke-width: 0.8; }
  .dta text.dta-card-lbl { font-size: 13px; font-weight: 600; fill: var(--text); }
  .dta text.dta-sub { font-size: 12.5px; fill: var(--text-muted); }
  .dta text.dta-op { font-size: 24px; font-weight: 700; fill: var(--text-muted); }
  .dta-div { stroke: var(--border); stroke-width: 1; }
  .dta text.dta-rule-title { font-size: 14px; font-weight: 700; fill: var(--text); }
  .dta-bar-bg { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .dta-bar-fill { fill: var(--red); }
  .dta text.dta-bar-lbl { font-size: 12.5px; fill: var(--text-muted); }
  .dta text.dta-bar-pct { font-size: 12.5px; font-weight: 600; fill: var(--text); }
  .dta figcaption { margin-top: 0.6em; text-align: center; font-size: 14px; color: var(--text-muted); }
</style>
