---
// Out-of-sample monthly R2 of the models in Gu, Kelly & Xiu (2020), Review of
// Financial Studies 33(5): about 30,000 US stocks, 1957-2016, trained on the
// first 18 years, tuned on 12, tested on 1987-2016. Values are the ones the
// paper's text reports; OLS on all 900+ predictors is reported only as
// "negative territory", so it is drawn as a marker below zero with no number.
import DiagramIcon from './DiagramIcon.astro';
const W = 900;
const H = 420;
const X0 = 300;       // zero line
const SCALE = 1000;   // px per 1.00 (percentage points): 0.40 -> 400
const rows = [
  { en: 'Linear, 3 predictors', vi: 'Tuyến tính, 3 predictor', v: 0.16, k: 'base' },
  { en: 'Linear, all 900+ predictors', vi: 'Tuyến tính, cả 900+ predictor', v: null, k: 'bad' },
  { en: 'Elastic net, 900+ predictors', vi: 'Elastic net, 900+ predictor', v: 0.11, k: 'base' },
  { en: 'PCR (principal components)', vi: 'PCR (thành phần chính)', v: 0.26, k: 'base' },
  { en: 'PLS (partial least squares)', vi: 'PLS (bình phương tối thiểu từng phần)', v: 0.27, k: 'base' },
  { en: 'Random forest', vi: 'Random forest', v: 0.33, k: 'tree' },
  { en: 'Boosted trees', vi: 'Boosted tree', v: 0.34, k: 'tree' },
  { en: 'Neural net, 3 layers', vi: 'Neural net, 3 tầng', v: 0.40, k: 'nn' },
];
const RH = 38;
const Y0 = 78;
---
<figure class="atp08-gk">
  <div class="atp08-gk-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Bar chart of monthly out-of-sample R-squared on about 30,000 US stocks, 1987 to 2016. Linear with 3 predictors 0.16 percent; linear with all 900-plus predictors is below zero; elastic net 0.11; PCR 0.26; PLS 0.27; random forest 0.33; boosted trees 0.34; three-layer neural net 0.40 percent.">
      <DiagramIcon name="chart" x={22} y={22} size={22} />
      <text x="44" y="28" class="h">
        <tspan data-lang-en>The best models explain well under half a percent</tspan>
        <tspan data-lang-vi>Mô hình tốt nhất cũng chỉ giải thích chưa tới nửa phần trăm</tspan>
      </text>
      <text x="20" y="54" class="sub">
        <tspan data-lang-en>Monthly out-of-sample R², 1987–2016, individual US stocks</tspan>
        <tspan data-lang-vi>R² ngoài mẫu theo tháng, 1987–2016, cổ phiếu Mỹ riêng lẻ</tspan>
      </text>
      {[0, 0.1, 0.2, 0.3, 0.4].map((t) => (
        <g>
          <line x1={X0 + t * SCALE} y1={Y0 - 6} x2={X0 + t * SCALE} y2={Y0 + rows.length * RH} class={t === 0 ? 'axis' : 'grid'} />
          <text x={X0 + t * SCALE} y={Y0 + rows.length * RH + 20} text-anchor="middle" class="tick">{t.toFixed(1)}%</text>
        </g>
      ))}
      {rows.map((r, i) => {
        const y = Y0 + i * RH;
        return (
          <g>
            <text x={X0 - (r.v === null ? 32 : 12)} y={y + 22} text-anchor="end" class="lab">
              <tspan data-lang-en>{r.en}</tspan>
              <tspan data-lang-vi>{r.vi}</tspan>
            </text>
            {r.v === null ? (
              <g>
                <polygon points={`${X0 - 8},${y + 10} ${X0 - 8},${y + 26} ${X0 - 22},${y + 18}`} class="neg" />
                <text x={X0 + 10} y={y + 23} class="neglab">
                  <tspan data-lang-en>below zero: worse than guessing 0</tspan>
                  <tspan data-lang-vi>dưới 0: tệ hơn đoán số 0</tspan>
                </text>
              </g>
            ) : (
              <g>
                <rect x={X0} y={y + 6} width={r.v * SCALE} height="24" rx="3" class={`bar ${r.k}`} />
                <text x={X0 + r.v * SCALE + 8} y={y + 23} class="val">{r.v.toFixed(2)}%</text>
              </g>
            )}
          </g>
        );
      })}
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>From Gu, Kelly and Xiu (2020). Piling 900+ predictors into one linear regression fails; trees and neural nets, which can find interactions, score highest. All of them are small in absolute terms.</span>
    <span data-lang-vi>Theo Gu, Kelly và Xiu (2020). Nhồi 900+ predictor vào một hồi quy tuyến tính thì hỏng; tree và neural net, vốn tìm được tương tác giữa các predictor, đạt cao nhất. Tuy vậy mọi con số đều nhỏ.</span>
  </figcaption>
</figure>

<style>
  .atp08-gk { margin: 2em 0; width: 100%; }
  .atp08-gk-scroll { overflow-x: auto; }
  .atp08-gk svg { display: block; width: 100%; min-width: 640px; height: auto; font-variant-numeric: tabular-nums; }
  .atp08-gk text { font-size: 14px; fill: var(--text-body); }
  .atp08-gk .h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .atp08-gk .sub { fill: var(--text-muted); }
  .atp08-gk .tick { font-size: 12px; fill: var(--text-muted); }
  .atp08-gk .lab { fill: var(--text); }
  .atp08-gk .val { font-weight: 700; fill: var(--text); }
  .atp08-gk .grid { stroke: var(--border); stroke-width: 1; }
  .atp08-gk .axis { stroke: var(--text-muted); stroke-width: 1.4; }
  .atp08-gk .bar { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.3; }
  .atp08-gk .bar.tree { fill: var(--gold-tint-bg); stroke: var(--gold-icon); }
  .atp08-gk .bar.nn { fill: var(--bg-alt); stroke: var(--text); stroke-width: 1.8; }
  .atp08-gk .neg { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.5; }
  .atp08-gk .neglab { fill: var(--red); font-weight: 600; font-size: 13px; }
  .atp08-gk figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
