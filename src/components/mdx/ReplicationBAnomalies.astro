---
// The three lag anomalies from the table, one small panel each. Illustrative.
import Frame from './ReplicationBFrame.astro';
import Node from './ReplicationBNode.astro';
import Arrow from './ReplicationBArrow.astro';
import Bi from './ReplicationBBi.astro';

const panels = [
  { th: 'Your own write vanishes', thv: 'Lần ghi của bạn biến mất',
    a: ['Alice posts a comment', 'Alice đăng bình luận', 'goes to the leader', 'đi tới leader'],
    b: ['She refreshes', 'Cô ấy tải lại', 'the comment is missing', 'bình luận biến mất'] },
  { th: 'Time goes backwards', thv: 'Thời gian chạy ngược',
    a: ['Refresh 1', 'Tải lại lần 1', 'replica A: 3 comments', 'replica A: 3 bình luận'],
    b: ['Refresh 2', 'Tải lại lần 2', 'replica B: 2 comments', 'replica B: 2 bình luận'] },
  { th: 'Answer before question', thv: 'Trả lời trước câu hỏi',
    a: ['Reader sees a reply', 'Người đọc thấy câu trả lời', 'before its question', 'trước cả câu hỏi'],
    b: ['The question arrives', 'Câu hỏi tới sau', 'later, from a slower replica', 'từ replica chậm hơn'] },
];
---
<Frame h={290}
  label="Three kinds of strange behaviour caused by replication lag. One: a user posts a comment, refreshes and it is missing. Two: a user refreshes twice, hits two replicas, and sees three comments then two. Three: a reader sees a reply before the question it answers."
  cap="Each panel is one reader's two moments in time. The second moment is the bad one."
  capVi="Mỗi khung là hai thời điểm của một người đọc. Thời điểm thứ hai là lúc thấy lỗi.">
  {panels.map((p, k) => {
    const x = 10 + k * 300;
    return (
      <g>
        <rect x={x} y={10} width={280} height={270} rx="8" class="rb-panel" />
        <text x={x + 140} y={40} text-anchor="middle" class="rb-h"><Bi en={p.th} vi={p.thv} /></text>
        <Node x={x + 14} y={64} w={252} h={64} icon="laptop" t={p.a[0]} tv={p.a[1]} s={p.a[2]} sv={p.a[3]} />
        <Arrow x1={x + 140} y1={128} x2={x + 140} y2={176} />
        <Node x={x + 14} y={176} w={252} h={64} icon="warning" t={p.b[0]} tv={p.b[1]} s={p.b[2]} sv={p.b[3]} cls="red" />
        <text x={x + 150} y={158} class="rb-n"><Bi en="a moment later" vi="một lúc sau" /></text>
      </g>
    );
  })}
</Frame>
