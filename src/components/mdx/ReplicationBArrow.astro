---
// Straight arrow with a polygon head (no marker ids, so it is safe to render twice on a page).
interface Props { x1: number; y1: number; x2: number; y2: number; cls?: string }
const { x1, y1, x2, y2, cls = '' } = Astro.props;
const a = Math.atan2(y2 - y1, x2 - x1);
const len = 9;
const bx = x2 - len * Math.cos(a), by = y2 - len * Math.sin(a);
const head = `${x2},${y2} ${bx + 4.5 * Math.sin(a)},${by - 4.5 * Math.cos(a)} ${bx - 4.5 * Math.sin(a)},${by + 4.5 * Math.cos(a)}`;
---
<line x1={x1} y1={y1} x2={bx} y2={by} class={`rb-edge ${cls}`} /><polygon points={head} class={`rb-head ${cls}`} />
