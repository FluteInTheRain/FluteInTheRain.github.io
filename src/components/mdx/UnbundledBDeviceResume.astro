---
// A phone loses signal and later resumes from its last log offset. Offsets are illustrative.
// Plain inline SVG with site CSS tokens; polygon arrowheads avoid duplicate marker ids.
import DiagramIcon from './DiagramIcon.astro';
---
<figure class="unb-fig">
  <div class="unb-scroll">
    <svg viewBox="0 0 900 356" role="img" aria-label="Server log with offsets 40 to 45 and a phone that holds offsets 40 to 42. After reconnecting, the phone asks for everything after offset 42 and receives 43, 44 and 45.">
      <text x="20" y="26" class="unb-h"><tspan data-lang-en>A phone catches up from its last log offset</tspan><tspan data-lang-vi>Điện thoại bắt kịp log từ offset cuối cùng</tspan></text>
      <text x="230" y="56" text-anchor="start" class="unb-lane-sub"><tspan data-lang-en>Log offsets</tspan><tspan data-lang-vi>Offset của log</tspan></text>
      <rect x="20" y="70" width="180" height="52" rx="4" class="unb-box" />
      <DiagramIcon name="log" x={45} y={96} size={26} />
      <text x="134" y="92" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>Server log</tspan><tspan data-lang-vi>Log trên server</tspan></text>
      <text x="134" y="109" text-anchor="middle" class="unb-in-m"><tspan data-lang-en>newest entry: 45</tspan><tspan data-lang-vi>mới nhất: 45</tspan></text>
      <rect x="20" y="190" width="180" height="52" rx="4" class="unb-box" />
      <DiagramIcon name="phone" x={45} y={216} size={26} />
      <text x="134" y="212" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>Phone</tspan><tspan data-lang-vi>Điện thoại</tspan></text>
      <text x="134" y="229" text-anchor="middle" class="unb-in-m"><tspan data-lang-en>local copy</tspan><tspan data-lang-vi>bản sao cục bộ</tspan></text>
      <rect x="230" y="76" width="96" height="40" rx="4" class="unb-box" />
      <text x="278" y="100.5" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>offset 40</tspan><tspan data-lang-vi>offset 40</tspan></text>
      <rect x="230" y="196" width="96" height="40" rx="4" class="unb-box" />
      <text x="278" y="220.5" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>offset 40</tspan><tspan data-lang-vi>offset 40</tspan></text>
      <rect x="334" y="76" width="96" height="40" rx="4" class="unb-box" />
      <text x="382" y="100.5" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>offset 41</tspan><tspan data-lang-vi>offset 41</tspan></text>
      <rect x="334" y="196" width="96" height="40" rx="4" class="unb-box" />
      <text x="382" y="220.5" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>offset 41</tspan><tspan data-lang-vi>offset 41</tspan></text>
      <rect x="438" y="76" width="96" height="40" rx="4" class="unb-box" />
      <text x="486" y="100.5" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>offset 42</tspan><tspan data-lang-vi>offset 42</tspan></text>
      <rect x="438" y="196" width="96" height="40" rx="4" class="unb-box" />
      <text x="486" y="220.5" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>offset 42</tspan><tspan data-lang-vi>offset 42</tspan></text>
      <rect x="542" y="76" width="96" height="40" rx="4" class="unb-box is-good" />
      <text x="590" y="100.5" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>offset 43</tspan><tspan data-lang-vi>offset 43</tspan></text>
      <rect x="542" y="196" width="96" height="40" rx="4" class="unb-box is-good is-dash" />
      <text x="590" y="220.5" text-anchor="middle" class="unb-in-m"><tspan data-lang-en>offset 43</tspan><tspan data-lang-vi>offset 43</tspan></text>
      <rect x="646" y="76" width="96" height="40" rx="4" class="unb-box is-good" />
      <text x="694" y="100.5" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>offset 44</tspan><tspan data-lang-vi>offset 44</tspan></text>
      <rect x="646" y="196" width="96" height="40" rx="4" class="unb-box is-good is-dash" />
      <text x="694" y="220.5" text-anchor="middle" class="unb-in-m"><tspan data-lang-en>offset 44</tspan><tspan data-lang-vi>offset 44</tspan></text>
      <rect x="750" y="76" width="96" height="40" rx="4" class="unb-box is-good" />
      <text x="798" y="100.5" text-anchor="middle" class="unb-in-b"><tspan data-lang-en>offset 45</tspan><tspan data-lang-vi>offset 45</tspan></text>
      <rect x="750" y="196" width="96" height="40" rx="4" class="unb-box is-good is-dash" />
      <text x="798" y="220.5" text-anchor="middle" class="unb-in-m"><tspan data-lang-en>offset 45</tspan><tspan data-lang-vi>offset 45</tspan></text>
      <path d="M590,116 L590,189" class="unb-dashed is-good" /><polygon points="585.5,188 594.5,188 590,196" class="unb-head is-good" />
      <path d="M694,116 L694,189" class="unb-dashed is-good" /><polygon points="689.5,188 698.5,188 694,196" class="unb-head is-good" />
      <path d="M798,116 L798,189" class="unb-dashed is-good" /><polygon points="793.5,188 802.5,188 798,196" class="unb-head is-good" />
      <text x="230" y="162" text-anchor="start" class="unb-note is-good"><tspan data-lang-en>reconnect: send what comes after 42</tspan><tspan data-lang-vi>kết nối lại: gửi phần sau offset 42</tspan></text>
      <circle cx="31" cy="296" r="11" class="unb-step" /><text x="31" y="300.5" text-anchor="middle" class="unb-step-n">1</text>
      <text x="52" y="292" text-anchor="start" class="unb-note"><tspan data-lang-en>Online: the phone keeps up</tspan><tspan data-lang-vi>Có mạng: điện thoại theo kịp</tspan></text>
      <text x="52" y="311" text-anchor="start" class="unb-note"><tspan data-lang-en>with the log, up to offset 42.</tspan><tspan data-lang-vi>log tới offset 42.</tspan></text>
      <circle cx="331" cy="296" r="11" class="unb-step is-hot" /><text x="331" y="300.5" text-anchor="middle" class="unb-step-n is-hot">2</text>
      <text x="352" y="292" text-anchor="start" class="unb-note"><tspan data-lang-en>Signal lost: the log grows to 45,</tspan><tspan data-lang-vi>Mất sóng: log tăng tới 45,</tspan></text>
      <text x="352" y="311" text-anchor="start" class="unb-note"><tspan data-lang-en>the UI still works offline.</tspan><tspan data-lang-vi>UI vẫn chạy offline được.</tspan></text>
      <circle cx="631" cy="296" r="11" class="unb-step is-good" /><text x="631" y="300.5" text-anchor="middle" class="unb-step-n is-good">3</text>
      <text x="652" y="292" text-anchor="start" class="unb-note"><tspan data-lang-en>Online again: asks for everything</tspan><tspan data-lang-vi>Có mạng lại: xin mọi thứ sau 42,</tspan></text>
      <text x="652" y="311" text-anchor="start" class="unb-note"><tspan data-lang-en>after 42, gets 43, 44 and 45.</tspan><tspan data-lang-vi>nhận 43, 44 và 45.</tspan></text>
    </svg>
  </div>
  <figcaption>
    <span data-lang-en>The device only remembers one number, its last offset. That is enough to resume without re-downloading everything.</span>
    <span data-lang-vi>Thiết bị chỉ cần nhớ một con số là offset cuối. Thế là đủ để tiếp tục mà không phải tải lại tất cả.</span>
  </figcaption>
</figure>

<style>
  .unb-fig { margin: 2em 0; width: 100%; }
  .unb-scroll { overflow-x: auto; }
  .unb-fig svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .unb-fig text { font-size: 14px; fill: var(--text-body); }
  .unb-fig .unb-h { font-size: 16px; font-weight: 700; fill: var(--text); }
  .unb-fig .unb-lane-h { font-size: 14.5px; font-weight: 700; fill: var(--text); }
  .unb-fig .unb-lane-sub { font-size: 13px; fill: var(--text-muted); }
  .unb-fig .unb-in-b { font-weight: 700; fill: var(--text); font-size: 13.5px; }
  .unb-fig .unb-in-m { font-size: 12.5px; fill: var(--text-muted); }
  .unb-fig .unb-note { font-size: 13px; fill: var(--text-muted); }
  .unb-fig .unb-note.is-hot { fill: var(--red); font-weight: 700; }
  .unb-fig .unb-note.is-good { fill: var(--gold-icon); font-weight: 700; }
  .unb-fig .unb-mono { font-size: 12.5px; fill: var(--text-body); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .unb-fig .unb-tick { font-size: 12.5px; fill: var(--text-muted); }
  .unb-panel { fill: none; stroke: var(--border); stroke-width: 1; }
  .unb-panel.is-fill { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1; }
  .unb-panel.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.4; }
  .unb-panel.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.4; }
  .unb-box { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.2; }
  .unb-box.is-hot { fill: var(--red-tint-bg); stroke: var(--red); stroke-width: 1.6; }
  .unb-box.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); stroke-width: 1.6; }
  .unb-box.is-dash { stroke-dasharray: 5 4; fill: none; }
  .unb-box.is-dash.is-good { fill: none; }
  .unb-box.is-dash.is-hot { fill: none; }
  .unb-solid { fill: none; stroke: var(--text-muted); stroke-width: 1.8; }
  .unb-solid.is-hot { stroke: var(--red); stroke-width: 2; }
  .unb-solid.is-good { stroke: var(--gold-icon); stroke-width: 2; }
  .unb-solid.is-dashedline { stroke-dasharray: 5 4; stroke-width: 1.2; }
  .unb-dashed { fill: none; stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .unb-dashed.is-hot { stroke: var(--red); stroke-width: 1.8; }
  .unb-dashed.is-good { stroke: var(--gold-icon); stroke-width: 1.8; }
  .unb-head { fill: var(--text-muted); }
  .unb-head.is-hot { fill: var(--red); }
  .unb-head.is-good { fill: var(--gold-icon); }
  .unb-step { fill: var(--bg-alt); stroke: var(--text-muted); stroke-width: 1.4; }
  .unb-step.is-hot { fill: var(--red-tint-bg); stroke: var(--red); }
  .unb-step.is-good { fill: var(--gold-tint-bg); stroke: var(--gold-icon); }
  .unb-fig .unb-step-n { font-size: 12.5px; font-weight: 700; fill: var(--text); }
  .unb-fig figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
