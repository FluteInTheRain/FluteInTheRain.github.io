---
// The dependency rule: web → service → data, and nothing else. The red
// X marks are this figure's one accent — each is a direction that rots
// the app the first time it is imported.
const W = 900, H = 330;
const ladder = [
  { y: 40, icon: 'fastapi', iconW: 56, iconH: 10.4, disc: false, name: { en: 'web', vi: 'web' } },
  { y: 140, icon: 'engine', iconW: 22, iconH: 22, disc: false, name: { en: 'service', vi: 'service' } },
  { y: 240, icon: 'database', iconW: 22, iconH: 22, disc: true, name: { en: 'data', vi: 'data' } },
];
const forbidden = [
  {
    y: 88,
    en: 'the router opens the database itself',
    vi: 'router tự mở database',
    why: { en: 'rules get skipped', vi: 'luật bị đi tắt' },
  },
  {
    y: 175,
    en: 'the storage layer invents rules',
    vi: 'tầng lưu trữ tự đặt ra luật',
    why: { en: 'rules scatter', vi: 'luật tản mát' },
  },
  {
    y: 262,
    en: 'the service answers with status codes',
    vi: 'service trả lời bằng status code',
    why: { en: 'rules tied to the web', vi: 'luật bị trói vào web' },
  },
];
---
<figure class="bep4c">
  <div class="bep4c-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Left: three stacked boxes web, service, data with downward arrows between neighbours. Right: three dashed red arrows, each crossed out with a red X, labelled router opens the database, storage invents rules, service answers with status codes.">
    <text x="200" y="26" text-anchor="middle" class="h">
      <tspan data-lang-en>dependencies point one way</tspan>
      <tspan data-lang-vi>phụ thuộc chỉ đi một chiều</tspan>
    </text>
    <text x="665" y="26" text-anchor="middle" class="h">
      <tspan data-lang-en>every other arrow is a bug</tspan>
      <tspan data-lang-vi>mọi mũi tên khác đều là bug</tspan>
    </text>

    {ladder.map((l, i) => (
      <g>
        <rect x="80" y={l.y} width="240" height="58" rx="10" class="box" />
        {l.disc && <circle cx="122" cy={l.y + 29} r="15" class="disc" />}
        <image href={`/icons/flow/${l.icon}.svg`} x={122 - l.iconW / 2} y={l.y + 29 - l.iconH / 2} width={l.iconW} height={l.iconH} aria-hidden="true" />
        <text x="168" y={l.y + 34} class="nm">
          <tspan data-lang-en>{l.name.en}</tspan><tspan data-lang-vi>{l.name.vi}</tspan>
        </text>
        {i < 2 && (
          <g>
            <line x1="200" y1={l.y + 58} x2="200" y2={ladder[i + 1].y - 10} class="ln" />
            <polygon points={`200,${ladder[i + 1].y} 195,${ladder[i + 1].y - 10} 205,${ladder[i + 1].y - 10}`} class="hd" />
          </g>
        )}
      </g>
    ))}

    {forbidden.map((f) => (
      <g>
        <line x1="430" y1={f.y} x2="560" y2={f.y} class="bad" />
        <polygon points={`568,${f.y} 556,${f.y - 5} 556,${f.y + 5}`} class="badhd" />
        <line x1="486" y1={f.y - 8} x2="504" y2={f.y + 8} class="x" />
        <line x1="486" y1={f.y + 8} x2="504" y2={f.y - 8} class="x" />
        <text x="586" y={f.y - 2} class="bl">
          <tspan data-lang-en>{f.en}</tspan><tspan data-lang-vi>{f.vi}</tspan>
        </text>
        <text x="586" y={f.y + 18} class="bs">
          <tspan data-lang-en>{f.why.en}</tspan><tspan data-lang-vi>{f.why.vi}</tspan>
        </text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>
    <span data-lang-en>The direction is the architecture: a layer may call the layer below it, and nothing else. Each red X is a real code review comment — an import that puts a rule where it cannot be tested, or ties the workflow to HTTP.</span>
    <span data-lang-vi>Chiều phụ thuộc chính là kiến trúc: một tầng chỉ được gọi tầng ngay dưới nó, không hơn. Mỗi dấu X đỏ là một nhận xét code review có thật — một dòng import đặt luật vào chỗ không test được, hoặc trói luồng nghiệp vụ vào HTTP.</span>
  </figcaption>
</figure>

<style>
  .bep4c { margin: 2em 0; width: 100%; }
  .bep4c-scroll { overflow-x: auto; }
  .bep4c svg { display: block; width: 100%; min-width: 640px; height: auto; }
  .bep4c text { font-size: 14px; fill: var(--text-body); font-variant-numeric: tabular-nums; }
  .bep4c .h { font-weight: 700; fill: var(--text); font-size: 15px; }
  .bep4c .nm { font-weight: 700; fill: var(--text); font-size: 16px; }
  .bep4c .bl { fill: var(--text-body); font-size: 13.5px; }
  .bep4c .bs { fill: var(--text-muted); font-size: 12.5px; }
  .bep4c .box { fill: var(--bg-alt); stroke: var(--border); stroke-width: 1.4; }
  .bep4c .ln { stroke: var(--text-muted); stroke-width: 1.6; }
  .bep4c .hd { fill: var(--text-muted); }
  .bep4c .bad { stroke: var(--red); stroke-width: 1.6; stroke-dasharray: 5 4; fill: none; }
  .bep4c .badhd { fill: var(--red); }
  .bep4c .x { stroke: var(--red); stroke-width: 2.4; }
  .bep4c .disc { fill: none; }
  :global([data-theme='dark']) .bep4c .disc { fill: rgba(255, 255, 255, 0.88); }
  .bep4c figcaption { margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.55; text-align: center; }
</style>
