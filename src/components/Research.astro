---
import content from '../data/content';
const r: any = (content as any).research;
---
{r && (
  <section class="section research-band" id="research">
    <div class="container">
      <p class="eyebrow">{r.eyebrow}</p>
      <h2 class="section-title">{r.heading}</h2>
      <p class="section-sub">{r.subheading}</p>
      <div class="pub-grid">
        {r.publications.map((pub: any) => (
          <div class="card pub-card">
            <a class="pub-title" href={pub.href} target="_blank" rel="noopener">{pub.title}</a>
            <div class="pub-meta">{pub.venue} · {pub.year}</div>
          </div>
        ))}
      </div>
      <a class="btn btn-outline-band" href={r.scholarLink} target="_blank" rel="noopener">View All On Google Scholar →</a>
    </div>
  </section>
)}
