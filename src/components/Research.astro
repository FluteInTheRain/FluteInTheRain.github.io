---
import content, { contentVi, ui } from '../data/content';
import T from './T.astro';
const r: any = (content as any).research;
const rVi: any = (contentVi as any).research;
---
{r && (
  <section class="section research-band" id="research">
    <div class="container">
      <p class="eyebrow"><T en={r.eyebrow} vi={rVi?.eyebrow} /></p>
      <h2 class="section-title"><T en={r.heading} vi={rVi?.heading} /></h2>
      <p class="section-sub"><T en={r.subheading} vi={rVi?.subheading} /></p>
      <div class="pub-grid">
        {r.publications.map((pub: any, pi: number) => (
          <div class="card pub-card">
            <a class="pub-title" href={pub.href} target="_blank" rel="noopener">
              <T en={pub.title} vi={rVi?.publications?.[pi]?.title} />
            </a>
            <div class="pub-meta">{pub.venue} · {pub.year}</div>
          </div>
        ))}
      </div>
      <a class="btn btn-outline-band" href={r.scholarLink} target="_blank" rel="noopener">
        <T en={ui.scholarBtn.en} vi={ui.scholarBtn.vi} />
      </a>
    </div>
  </section>
)}
