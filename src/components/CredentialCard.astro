---
import Icon from './Icon.astro';
const { item } = Astro.props as { item: any };
const meta = item.school
  ? `${item.school} · ${item.years}`
  : [item.issuer, item.year].filter(Boolean).join(' · ');
const notes = [item.gpa ? `GPA ${item.gpa}` : null, item.note].filter(Boolean);
const title = item.degree || item.title;
---
<div class="card credential-card">
  <div class="credential-icon"><Icon name="award" size={21} /></div>
  <div class="credential-body">
    <div class="credential-title">{title}</div>
    <div class="credential-meta">{meta}</div>
    {notes.map((n) => <div class="credential-extra">{n}</div>)}
    {item.url && <a class="credential-link" href={item.url} target="_blank" rel="noopener">View →</a>}
  </div>
</div>
