---
import { ui } from '../data/content';
import Icon from './Icon.astro';
import T from './T.astro';
const { item, itemVi } = Astro.props as { item: any; itemVi?: any };
const meta = item.school
  ? `${item.school} · ${item.years}`
  : [item.issuer, item.year].filter(Boolean).join(' · ');
const metaVi = itemVi
  ? (itemVi.school ? `${itemVi.school} · ${itemVi.years}` : [itemVi.issuer, itemVi.year].filter(Boolean).join(' · '))
  : undefined;
const notes = [item.gpa ? `GPA ${item.gpa}` : null, item.note].filter(Boolean);
const notesVi = itemVi ? [itemVi.gpa ? `GPA ${itemVi.gpa}` : null, itemVi.note].filter(Boolean) : [];
const title = item.degree || item.title;
const titleVi = itemVi ? (itemVi.degree || itemVi.title) : undefined;
---
<div class="card credential-card">
  <div class="credential-icon"><Icon name="award" size={21} /></div>
  <div class="credential-body">
    <div class="credential-title"><T en={title} vi={titleVi} /></div>
    <div class="credential-meta"><T en={meta} vi={metaVi} /></div>
    {notes.map((n, ni) => <div class="credential-extra"><T en={n} vi={notesVi[ni]} /></div>)}
    {item.url && (
      <a class="credential-link" href={item.url} target="_blank" rel="noopener">
        <T en={ui.viewCredential.en} vi={ui.viewCredential.vi} />
      </a>
    )}
  </div>
</div>
