---
import { getPublishedPosts } from '../utils/blog';
import PostCard from './PostCard.astro';
const posts = (await getPublishedPosts()).slice(0, 3);
---
{posts.length > 0 && (
  <section class="section alt-bg" id="blog">
    <div class="container">
      <p class="eyebrow">Writing</p>
      <h2 class="section-title">Latest from the blog</h2>
      <p class="section-sub">Notes on the engineering problems I run into and how I solve them.</p>
      <div class="post-grid">{posts.map((p) => <PostCard post={p} />)}</div>
      <a class="btn btn-outline" href="/blog/">All posts &rarr;</a>
    </div>
  </section>
)}
