---
import { getPublishedPosts } from '../utils/blog';
import { ui } from '../data/content';
import PostCard from './PostCard.astro';
import T from './T.astro';
const posts = (await getPublishedPosts()).slice(0, 3);
const featured = posts.length === 1;
---
{posts.length > 0 && (
  <section class="section alt-bg" id="blog">
    <div class="container">
      <p class="eyebrow"><T en={ui.writingEyebrow.en} vi={ui.writingEyebrow.vi} /></p>
      <h2 class="section-title"><T en={ui.latestHeading.en} vi={ui.latestHeading.vi} /></h2>
      <p class="section-sub"><T en={ui.latestSub.en} vi={ui.latestSub.vi} /></p>
      <div class={featured ? 'post-grid post-grid--featured' : 'post-grid'}>{posts.map((p) => <PostCard post={p} featured={featured} />)}</div>
      <a class="btn btn-outline" href="/blog/"><T en={ui.allPosts.en} vi={ui.allPosts.vi} /></a>
    </div>
  </section>
)}
