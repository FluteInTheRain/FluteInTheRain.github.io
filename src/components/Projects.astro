---
import content from '../data/content';
import ProjectCard from './ProjectCard.astro';
const p: any = content.projects;
const hasPersonal = !!(p.personal && p.personal.items && p.personal.items.length);
const hasCompany = !!(p.company && p.company.items && p.company.items.length);
---
<section class="section" id="projects">
  <div class="container">
    <p class="eyebrow">{p.eyebrow}</p>
    <h2 class="section-title">{p.heading}</h2>
    <p class="section-sub">{p.subheading}</p>
    {hasCompany && (
      <>
        <p class="sub-label">{p.company.label}</p>
        <div class="projects-grid" style={hasPersonal ? 'margin-bottom: 44px;' : undefined}>
          {p.company.items.map((item: any) => <ProjectCard p={item} />)}
        </div>
      </>
    )}
    {hasPersonal && (
      <>
        <p class="sub-label">{p.personal.label}</p>
        <div class="projects-grid">
          {p.personal.items.map((item: any) => <ProjectCard p={item} />)}
        </div>
      </>
    )}
  </div>
</section>
