---
import content, { contentVi } from '../data/content';
import ProjectCard from './ProjectCard.astro';
import T from './T.astro';
const p: any = content.projects;
const pVi: any = contentVi.projects;
const groups: any[] = ['company', 'personal']
  .filter((key) => p[key] && p[key].items && p[key].items.length)
  .map((key) => {
    const items: any[] = p[key].items;
    const itemsVi: any[] = pVi[key]?.items || [];
    const entries = items.map((item: any, i: number) => ({
      item,
      itemVi: itemsVi[i] || null,
      i,
      heading: key === 'company' && (i === 0 || item.org !== items[i - 1].org) ? item.org : null,
      headingVi: key === 'company' && (i === 0 || item.org !== items[i - 1].org) ? (itemsVi[i]?.org || null) : null,
    }));
    const rows = items.length + entries.filter((e) => e.heading).length;
    return { key, label: p[key].label, labelVi: pVi[key]?.label, items, entries, rows };
  });
const showTabs = groups.length > 1;
---
<section class="section projects" id="projects" data-projects>
  <div class="container">
    <p class="eyebrow"><T en={p.eyebrow} vi={pVi.eyebrow} /></p>
    <h2 class="section-title" id="projects-heading"><T en={p.heading} vi={pVi.heading} /></h2>
    <p class="section-sub"><T en={p.subheading} vi={pVi.subheading} /></p>
    {showTabs && (
      <div class="proj-tabs" role="tablist" aria-labelledby="projects-heading">
        {groups.map((g, gi) => (
          <button
            type="button"
            class="proj-tab"
            role="tab"
            id={`proj-tab-${g.key}`}
            aria-controls={`proj-panel-${g.key}`}
            aria-selected={gi === 0 ? 'true' : 'false'}
            tabindex={gi === 0 ? '0' : '-1'}
          ><T en={g.label} vi={g.labelVi} /> · {g.items.length}</button>
        ))}
      </div>
    )}
    {groups.map((g) => (
      <div
        class="proj-panel"
        id={`proj-panel-${g.key}`}
        role={showTabs ? 'tabpanel' : undefined}
        aria-labelledby={showTabs ? `proj-tab-${g.key}` : undefined}
      >
        <p class="proj-group-label"><T en={g.label} vi={g.labelVi} /></p>
        <div class="proj-grid" style={`--rows: ${g.rows}`}>
          {g.entries.map((e: any) => (
            <>
              {e.heading && <p class="proj-org-heading"><T en={e.heading} vi={e.headingVi} /></p>}
              <button
                type="button"
                class="proj-item"
                id={`proj-item-${g.key}-${e.i}`}
                aria-controls={`proj-detail-${g.key}-${e.i}`}
                aria-expanded={e.i === 0 ? 'true' : 'false'}
              >
                <span class="proj-item-title" id={`proj-item-title-${g.key}-${e.i}`}>
                  <T en={e.item.title} vi={e.itemVi?.title} />
                </span>
                <span class="proj-item-meta">{(e.item.tags || []).slice(0, 3).join(' · ')}</span>
              </button>
              <div
                class="proj-detail-panel"
                id={`proj-detail-${g.key}-${e.i}`}
                role="region"
                aria-labelledby={`proj-item-title-${g.key}-${e.i}`}
              >
                <ProjectCard p={e.item} pVi={e.itemVi} />
              </div>
            </>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
