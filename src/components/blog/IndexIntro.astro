---
// Eyebrow, h1 and lede on the left; optional stats on the right (below the lede on narrow screens).
import { ui } from '../../data/content';
import T from '../T.astro';
interface Props {
  title: { en: string; vi?: string };
  stats?: { value: string; label: { en: string; vi: string } }[];
  lede?: boolean;
}
const { title, stats = [], lede = true } = Astro.props;
---
<header class="index-intro">
  <div class="index-intro-text">
    <p class="eyebrow"><T en={ui.blogEyebrow.en} vi={ui.blogEyebrow.vi} /></p>
    <h1 class="section-title"><T en={title.en} vi={title.vi} /></h1>
    {lede && <p class="section-sub"><T en={ui.latestSub.en} vi={ui.latestSub.vi} /></p>}
  </div>
  {stats.length > 0 && (
    <dl class="index-stats">
      {stats.map((s) => (
        <div class="index-stat">
          <dt><T en={s.label.en} vi={s.label.vi} /></dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>
  )}
</header>
