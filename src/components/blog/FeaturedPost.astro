---
// The lead post on /blog/: wide card, cover left, text right.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, formatDateVi, readingTime } from '../../utils/blog';
import { CATEGORY_LABELS, CATEGORY_LABELS_VI, type CategoryId } from '../../data/categories';
import { ui } from '../../data/content';
import T from '../T.astro';
interface Props { post: CollectionEntry<'blog'>; part?: { n: number; m: number } | null }
const { post, part = null } = Astro.props;
const { title, title_vi, description, description_vi, date, category, cover, cover_alt } = post.data;
const cat = category as CategoryId;
const mins = readingTime(post.body);
const href = `/blog/${post.id}/`;
---
<article class="featured">
  <div class:list={['featured-media', { 'is-empty': !cover }]}>
    {cover
      ? <Image src={cover} alt={cover_alt ?? ''} widths={[480, 800, 1100]} sizes="(min-width: 1024px) 460px, (min-width: 640px) 90vw, 100vw" loading="eager" />
      : <span class="post-card-media-label"><T en={CATEGORY_LABELS[cat]} vi={CATEGORY_LABELS_VI[cat]} /></span>}
  </div>
  <div class="featured-body">
    <p class="post-card-kicker">
      <T en={ui.latest.en} vi={ui.latest.vi} /> · <T en={CATEGORY_LABELS[cat]} vi={CATEGORY_LABELS_VI[cat]} />
    </p>
    <h2 class="featured-title"><a href={href}><T en={title} vi={title_vi} /></a></h2>
    <p class="featured-desc"><T en={description} vi={description_vi} /></p>
    <p class="featured-meta">
      <time datetime={date.toISOString()}><T en={formatDate(date)} vi={formatDateVi(date)} /></time> · {mins}{' '}
      <T en={ui.minRead.en} vi={ui.minRead.vi} />
      {part && <> · <T en={ui.partOf.en.replace('{n}', String(part.n)).replace('{m}', String(part.m))} vi={ui.partOf.vi.replace('{n}', String(part.n)).replace('{m}', String(part.m))} /></>}
    </p>
    <a class="btn btn-primary featured-btn" href={href}><T en={ui.readThePost.en} vi={ui.readThePost.vi} /></a>
  </div>
</article>
