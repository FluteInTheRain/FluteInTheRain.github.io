---
// One category on /blog/: heading with count and a link to the category page, then three cards.
import type { CollectionEntry } from 'astro:content';
import { categoryUrl } from '../../utils/blog';
import { CATEGORY_LABELS, CATEGORY_LABELS_VI, type CategoryId } from '../../data/categories';
import { ui } from '../../data/content';
import PostCard from '../PostCard.astro';
import T from '../T.astro';
interface Props { category: CategoryId; total: number; posts: CollectionEntry<'blog'>[] }
const { category, total, posts } = Astro.props;
---
<section class="topic" aria-labelledby={`topic-${category}`}>
  <div class="index-head">
    <h2 id={`topic-${category}`} class="index-head-title"><T en={CATEGORY_LABELS[category]} vi={CATEGORY_LABELS_VI[category]} /></h2>
    <span class="index-head-hint">{total} <T en={ui.postsCount.en} vi={ui.postsCount.vi} /></span>
    <a class="index-head-link" href={categoryUrl(category)}><T en={ui.viewAll.en} vi={ui.viewAll.vi} /></a>
  </div>
  <div class="post-grid">{posts.map((p) => <PostCard post={p} />)}</div>
</section>
