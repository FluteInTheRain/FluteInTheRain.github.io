---
// Every post as a compact row. All rows are in the HTML; rows from `initial` on carry data-extra,
// and the script collapses them (so without JS every row stays visible).
import type { CollectionEntry } from 'astro:content';
import { formatDate, formatDateVi } from '../../utils/blog';
import { normalizeSearch } from '../../utils/blog-index';
import { CATEGORY_LABELS, CATEGORY_LABELS_VI, type CategoryId } from '../../data/categories';
import { ui } from '../../data/content';
import T from '../T.astro';
interface Props { posts: CollectionEntry<'blog'>[]; initial?: number }
const { posts, initial = 8 } = Astro.props;
---
<section class="archive" id="archive" aria-labelledby="archive-title" data-initial={initial}>
  <div class="index-head">
    <h2 id="archive-title" class="index-head-title"><T en={ui.archive.en} vi={ui.archive.vi} /></h2>
    <span class="index-head-hint"><T en={ui.archiveHint.en} vi={ui.archiveHint.vi} /></span>
  </div>
  <ul class="archive-list">
    {posts.map((p, i) => {
      const { title, title_vi, description, description_vi, date, tags, category } = p.data;
      const cat = category as CategoryId;
      const search = normalizeSearch([title, title_vi, description, description_vi, ...tags].filter(Boolean).join(' '));
      return (
        <li class="archive-row" data-search={search} data-extra={i >= initial ? '' : undefined}>
          <time class="archive-date" datetime={date.toISOString()}><T en={formatDate(date)} vi={formatDateVi(date)} /></time>
          <span class="archive-cat"><T en={CATEGORY_LABELS[cat]} vi={CATEGORY_LABELS_VI[cat]} /></span>
          <a class="archive-title" href={`/blog/${p.id}/`}><T en={title} vi={title_vi} /></a>
        </li>
      );
    })}
  </ul>
  <button type="button" class="archive-more" hidden>
    <T en={`${ui.showAll.en} ${posts.length} →`} vi={`${ui.showAll.vi} ${posts.length} →`} />
  </button>
  <p class="archive-empty" role="status" hidden><T en={ui.noMatch.en} vi={ui.noMatch.vi} /></p>
</section>
