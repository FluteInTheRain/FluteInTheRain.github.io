---
import content, { contentVi, ui } from '../data/content';
import CredentialCard from './CredentialCard.astro';
import T from './T.astro';
const ed = content.education;
const edVi = contentVi.education;
---
<section class="section" id="education">
  <div class="container">
    <p class="eyebrow"><T en={ed.eyebrow} vi={edVi.eyebrow} /></p>
    <h2 class="section-title"><T en={ed.heading} vi={edVi.heading} /></h2>
    <p class="section-sub"><T en={ed.subheading} vi={edVi.subheading} /></p>
    <div>
      <p class="sub-label"><T en={ui.educationSub.en} vi={ui.educationSub.vi} /></p>
      <div class="credential-list" style="margin-bottom: 44px;">
        {ed.degrees.map((item: any, i: number) => <CredentialCard item={item} itemVi={edVi.degrees[i]} />)}
      </div>
    </div>
    <div>
      <p class="sub-label"><T en={ui.certificatesSub.en} vi={ui.certificatesSub.vi} /></p>
      <div class="credential-list">
        {ed.certificates.map((item: any, i: number) => <CredentialCard item={item} itemVi={edVi.certificates[i]} />)}
      </div>
    </div>
  </div>
</section>
