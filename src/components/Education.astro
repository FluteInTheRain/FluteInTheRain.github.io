---
import content from '../data/content';
import CredentialCard from './CredentialCard.astro';
const ed = content.education;
---
<section class="section" id="education">
  <div class="container">
    <p class="eyebrow">{ed.eyebrow}</p>
    <h2 class="section-title">{ed.heading}</h2>
    <p class="section-sub">{ed.subheading}</p>
    <div>
      <p class="sub-label">Education</p>
      <div class="credential-list" style="margin-bottom: 44px;">
        {ed.degrees.map((item: any) => <CredentialCard item={item} />)}
      </div>
    </div>
    <div>
      <p class="sub-label">Certificates</p>
      <div class="credential-list">
        {ed.certificates.map((item: any) => <CredentialCard item={item} />)}
      </div>
    </div>
  </div>
</section>
