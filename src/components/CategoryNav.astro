---
import { categoryUrl } from '../utils/blog';
import { ui } from '../data/content';
import T from './T.astro';
interface Props { categories: { id: any; label: string; labelVi?: string }[]; active?: string; counts?: Record<string, number> }
const { categories, active, counts } = Astro.props;
---
{categories.length > 0 && (
  <nav class="chips" aria-label="Blog categories">
    <a class:list={['chip', { 'is-active': !active }]} href="/blog/">
      <T en={ui.allCategory.en} vi={ui.allCategory.vi} />
    </a>
    {categories.map((c) => (
      <a class:list={['chip', { 'is-active': active === c.id }]} href={categoryUrl(c.id)}>
        <T en={c.label} vi={c.labelVi} />{counts?.[c.id] != null && ` · ${counts[c.id]}`}
      </a>
    ))}
  </nav>
)}
