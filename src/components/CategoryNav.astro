---
import { categoryUrl } from '../utils/blog';
interface Props { categories: { id: any; label: string }[]; active?: string }
const { categories, active } = Astro.props;
---
{categories.length > 0 && (
  <nav class="chips" aria-label="Blog categories">
    <a class:list={['chip', { 'is-active': !active }]} href="/blog/">All</a>
    {categories.map((c) => (
      <a class:list={['chip', { 'is-active': active === c.id }]} href={categoryUrl(c.id)}>{c.label}</a>
    ))}
  </nav>
)}
