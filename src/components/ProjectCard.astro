---
import T from './T.astro';
const { p, pVi } = Astro.props as { p: any; pVi?: any };
const links = p.links || [];
const linksVi = pVi?.links || [];
const video = p.video || null;
const videoVi = pVi?.video || null;
const image = p.image || null;
const siteHref = links[0]?.href;
const bullets = p.bullets && p.bullets.length ? p.bullets : null;
const bulletsVi = pVi?.bullets || [];
---
<div class="project-detail">
  <h3 class="project-title"><T en={p.title} vi={pVi?.title} /></h3>
  <span class="project-org"><T en={p.org} vi={pVi?.org} /></span>
  {p.desc && <p class="project-desc"><T en={p.desc} vi={pVi?.desc} /></p>}
  {image && (
    <figure class="project-shot">
      {siteHref ? (
        <a href={siteHref} target="_blank" rel="noopener" aria-label={`Open ${p.title} website`}>
          <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
        </a>
      ) : (
        <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
      )}
    </figure>
  )}
  {video && (
    <figure class="project-video">
      <video controls preload="none" playsinline poster={video.poster} aria-label={video.caption}>
        <source src={video.src} type="video/mp4" />
      </video>
      {video.caption && <figcaption><T en={video.caption} vi={videoVi?.caption} /></figcaption>}
    </figure>
  )}
  {bullets && (
    <ul class="project-bullets">
      {bullets.map((b: any, bi: number) => {
        const bVi = bulletsVi[bi];
        return b.label ? (
          <li>
            <strong><T en={b.label} vi={bVi?.label} />:</strong>{' '}
            <T en={b.text} vi={bVi?.text} />
          </li>
        ) : (
          <li><T en={b.text || b} vi={bVi?.text || bVi} /></li>
        );
      })}
    </ul>
  )}
  <div class="project-tags">{p.tags.map((t: string) => <span class="tag">{t}</span>)}</div>
  {links.length > 0 && (
    <div class="project-links">
      {links.map((l: any, li: number) => (
        <a class="project-link" href={l.href} target="_blank" rel="noopener">
          <T en={l.label} vi={linksVi[li]?.label} /> →
        </a>
      ))}
    </div>
  )}
</div>
