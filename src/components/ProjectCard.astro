---
const { p } = Astro.props as { p: any };
const links = p.links || [];
const bullets = p.bullets && p.bullets.length ? p.bullets : null;
---
<div class="card project-card">
  <h3 class="project-title">{p.title}</h3>
  <span class="project-org">{p.org}</span>
  {p.desc && <p class="project-desc">{p.desc}</p>}
  {bullets && (
    <ul class="project-bullets">
      {bullets.map((b: any) => (
        b.label
          ? <li><strong>{b.label}:</strong> {b.text}</li>
          : <li>{b.text || b}</li>
      ))}
    </ul>
  )}
  <div class="project-tags">{p.tags.map((t: string) => <span class="tag">{t}</span>)}</div>
  {links.length > 0 && (
    <div class="project-links">
      {links.map((l: any) => <a class="project-link" href={l.href} target="_blank" rel="noopener">{l.label} →</a>)}
    </div>
  )}
</div>
